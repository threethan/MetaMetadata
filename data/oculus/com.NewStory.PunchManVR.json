lA&oe=6A18652F"}, {"file_name": "D.png", "id": "1591405678145690", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569471_1591405681479023_93209049922791638_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hgqIRy4GoAQ7kNvwFHMZtx&_nc_oc=Adrl7g1dYm9iw72UbnqGza0gjbFKag_KMX5FajMe7sUCoeu-3eirsml0kjW048GW02o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w9KdYnXS0mW81g7yhEEDbTvF-ObO9_5SC9BJwJsKI9A&oe=6A186982"}, {"file_name": "G.png", "id": "558516763491922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974859_558516766825255_7563524487422045670_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0f6POFTAi8Q7kNvwEfah1Q&_nc_oc=Adq-NqFjAkZ6AwHb-uwpOglE4EAqK4dwAo1Inq4YpO9_HMyKX3pOjWkakPAUiFZkRNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EwH7af-4Ha0hRskmFJkotFV7fpiqRWeFHMVkiDpc2Og&oe=6A183DC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "904113788550762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210885_904113791884095_8787361767416465739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39xbkA-257oQ7kNvwFeYCS3&_nc_oc=AdoMCSfPCszbzLxHiK2yo8QiRP95M_b3aa6-L8ohNdVyeVm0yhB0sa8x9JmfOn-7N5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af579cl4hMHzLspd31IQ-6CGmviohKC6XMitBs3xYy6HnA&oe=6A185DB6"}, "display_name": "Blast Smash", "keywords": ["punch", "action", "knock", "simulator", "adventure"], "long_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! You'll smash bizarre characters with various weapons, aiming to beat your personal best for distance. Earn rewards based on how far you launch them, and use those rewards to upgrade your weapons or unlock new ones, allowing you to achieve even greater distances! But be careful not to overdo it \u2013 things can get pretty wild with those faces!\n\nWhat You Can Do:\n-Smash humans with a variety of unique weapons!: Master a range of weapons such as bats, squeaky hammers, golf clubs, and spiked bats to deliver the ultimate smash!\n-Send quirky characters flying!: A diverse cast of unique human characters await! Experiment with different weapons and smashes based on their characteristics!\n-Collect rewards and upgrade your weapons!: Earn rewards for launching humans! Use these rewards to increase the power and size of your weapons!\n-Enhance your skills and beat your records!: Upgrade various skills such as weapon power and attack area to launch humans even farther!\n", "short_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8895127967270081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974892_616839927463237_4336679162718266100_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_SMomgNSdAQ7kNvwEgo6Zk&_nc_oc=Adp_CD5d-rsFGMfqsxtRf-6cdEXsAMM_OepPNiejklTPB3PqRkJXOHzNBjg5mmu2NfQ&_nc_zt=3&_nc_ht=scon
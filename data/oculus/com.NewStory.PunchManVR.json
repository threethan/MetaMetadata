91638_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJDUaAnnif8Q7kNvwEIXmTV&_nc_oc=AdrXmwzJSBLVJ2PyQdSqEc-A8_9sVbAd7Dfs6-Svafcwua3Yy4ajID-FBbe-bnHEz1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5N4ccgf-_I-0YpCAE17Yr7rDKzvWqpcwoQbOGpYClPw&oe=6A50E1C2"}, {"file_name": "G.png", "id": "558516763491922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974859_558516766825255_7563524487422045670_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKFGhO0Ga24Q7kNvwH0soLo&_nc_oc=AdpfBC3MBM_kyKO3INpHeho1DjkFSEnL5_bQ2yjQUw36xo50AKDZAYHeV1_CUZkbuLs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBif0PSkx8h9GH9dxj78UTqlcipGmb26prVMRnGC0PLTg&oe=6A50EE48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "904113788550762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210885_904113791884095_8787361767416465739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIay4e6-Gl4Q7kNvwEUv5qQ&_nc_oc=AdrDDu7dG-JQHSaXEVfhkDzmfItIMvNgFszq9inwPV3mnk_N1xjsGifqv8YgoqodsKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqJ8TTAa7LlSsWj13_vdPnUdIWd74tejbmP-U4nIsZPQ&oe=6A510E36"}, "display_name": "Blast Smash", "keywords": ["punch", "action", "knock", "simulator", "adventure"], "long_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! You'll smash bizarre characters with various weapons, aiming to beat your personal best for distance. Earn rewards based on how far you launch them, and use those rewards to upgrade your weapons or unlock new ones, allowing you to achieve even greater distances! But be careful not to overdo it \u2013 things can get pretty wild with those faces!\n\nWhat You Can Do:\n-Smash humans with a variety of unique weapons!: Master a range of weapons such as bats, squeaky hammers, golf clubs, and spiked bats to deliver the ultimate smash!\n-Send quirky characters flying!: A diverse cast of unique human characters await! Experiment with different weapons and smashes based on their characteristics!\n-Collect rewards and upgrade your weapons!: Earn rewards for launching humans! Use these rewards to increase the power and size of your weapons!\n-Enhance your skills and beat your records!: Upgrade various skills such as weapon power and attack area to launch humans even farther!\n", "short_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8895127967270081"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2423196738059817"}, {"status": "PUBLISHED", "id": "682106797521074"}, {"status": "PUBLISHED", "id": "1320862282255313"}]}, "baseline_offer": {"id": "1320862282255313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "2423196738059817"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "891959
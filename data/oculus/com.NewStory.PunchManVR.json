rA&oe=6A1B082F"}, {"file_name": "D.png", "id": "1591405678145690", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569471_1591405681479023_93209049922791638_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hgqIRy4GoAQ7kNvwEOkljv&_nc_oc=AdoSwPvcKhTIBUmA0hy2GvtkaUFis-TT7aJMVLGpKMTIxP4-tWf018vjKUPufPRJeaY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ch-OjD07KJdI_xj0Qd_4C4K29HOOab32UWfRjGN8koA&oe=6A1AD442"}, {"file_name": "G.png", "id": "558516763491922", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974859_558516766825255_7563524487422045670_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0f6POFTAi8Q7kNvwFuLX8B&_nc_oc=AdrS4FdD0qhyjJEkj9UMMYV8maE47FO1ZtN4Wkd42u9iXl79FRoAuo74ziVXDmiVEFw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af437I927ELspBSn08gYAR2Djx6AG3ZmzF4nYHPahZmWFA&oe=6A1AE0C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "904113788550762", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210885_904113791884095_8787361767416465739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39xbkA-257oQ7kNvwEM8FN8&_nc_oc=Adrhu6t-p7XMrACjrrD9sPvGCTPenzLLh4vYU2i_JNfNxg6XEyubfBlfUt2Ns6WaXLk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mU9B27q-Uf9ctATNGsUNbk1agaOpPG5OVKAeJ7xGWqw&oe=6A1B00B6"}, "display_name": "Blast Smash", "keywords": ["punch", "action", "knock", "simulator", "adventure"], "long_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! You'll smash bizarre characters with various weapons, aiming to beat your personal best for distance. Earn rewards based on how far you launch them, and use those rewards to upgrade your weapons or unlock new ones, allowing you to achieve even greater distances! But be careful not to overdo it \u2013 things can get pretty wild with those faces!\n\nWhat You Can Do:\n-Smash humans with a variety of unique weapons!: Master a range of weapons such as bats, squeaky hammers, golf clubs, and spiked bats to deliver the ultimate smash!\n-Send quirky characters flying!: A diverse cast of unique human characters await! Experiment with different weapons and smashes based on their characteristics!\n-Collect rewards and upgrade your weapons!: Earn rewards for launching humans! Use these rewards to increase the power and size of your weapons!\n-Enhance your skills and beat your records!: Upgrade various skills such as weapon power and attack area to launch humans even farther!\n", "short_description": "\"Blast Smash\" is an exhilarating human-launching action game set in a chaotic VR space! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8895127967270081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974892_616839927463237_4336679162718266100_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMAyO8OejmIQ7kNvwHNvIZ2&_nc_oc=AdrGQDDesgROt_W63YBEGSTcKvwocoR6jveJ3Jq-Y00IcEuxwAY2XeoUV9WFozn_4dQ&_nc_zt=3&_nc_ht=scon
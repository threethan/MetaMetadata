bqMQ7kNvwGvLtm1&_nc_oc=AdpBtkb84avoA9KmTxFDL_GhKpX9sWeSJJ82vyjTu0BF1T1al_Gv5lXOIEobfyvVIcQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7jNsbesOJ4XI-ugILEnHE_q3EeVubQUKWP2QOWuob9A&oe=6AE0B0C6"}, {"file_name": "screenshot_05_2560x1440.png", "id": "1424720756306781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_1424720759640114_1392259784942414607_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XHaEUlSOjgQ7kNvwFi4mN9&_nc_oc=AdpiTG0cmruiy5cCOpE26KS44TLQRuUHrRPW_Kei6TyS4W531b8_rSiHQkzR32hX1XA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuBgeeAxye73VdX-JE_2Am5eAOJUu_fH4U9LmtSzYksw&oe=6AE0C608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "uno.png", "id": "1253198089537750", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_1253198096204416_796246098067425217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbo5OzlCV0AQ7kNvwFik1tB&_nc_oc=AdoL4JTpMtExSRpbr4T_5AwrRtEhqf0s2uglavMhy2D02y5KRk15XHSAkBpIi7QidK0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmuz0WpYT-0F7oKOO752C-TMaPy_0PaLotxP9i68ujcw&oe=6AE0B361"}, "display_name": "Puzzlegram", "keywords": [], "long_description": "Turn your space \u2014 and your memories \u2014 into a three-dimensional puzzle.\n\nNEW: Photo \u2192 Puzzle. Take a photo and watch Puzzlegram turn it into a 3D puzzle floating right in front of you. Your living room, your pet, a landscape, a friend: any picture becomes a unique level to rebuild, piece by piece.\n\nIn this Mixed Reality experience for Meta Quest, puzzles appear directly in your real environment. Use your hands to grab, rotate and combine cube blocks floating in space, building the correct structure one piece at a time.\n\nNo controllers, just natural hand tracking: interact with the blocks as if they were really in front of you.\n\nEvery level challenges your logic, precision and spatial awareness as the puzzle takes shape in the world around you.\n\n\ud83d\udcf8 NEW: turn your photos into puzzles\nImmersive 3D puzzles\nNatural hand interaction\nMixed Reality in your real environment\nLogic and building challenges\nYour space. Your photo. Your puzzle", "short_description": "A relaxing puzzle in your real space where you build images with blocks.\nTurn your photos into puzzles!"}, {"images": {"nodes": [{"file_name": "screenshot_02_2560x1440.png", "id": "1099173066034091", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1099173072700757_4968478188640611342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmfJMa0yWMEQ7kNvwGAvVcG&_nc_oc=AdrJhY3rcqD-4C_9EYs22aTtGzoSePu6k6iBVR8El-v7IN6lDjZ-QEByjTdgnSjqxXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEzUgN5i5O40LHob-WjCH8Kun46HYq_TNPCrTZdjUE-Q&oe=6AE0CD7D"}]}, "id": "1085524834465091", "locale": "it_IT", "screenshots": [{"file_name": "screenshot_01_2560x1440.png", "id": "1664539795272762", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/795000614_1664539801939428_2313029945952218305_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu06pF06goUQ7kNvwGgUk2t&_nc_oc=AdqnJA6i3dvxySHJcn81BfIRgj5tr7eKGDxXCajTuXwR6Lhi1p4FY6AtKabZorAIX3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2Wr1n19nSNAN_642T2wUMGlRihH9XpsX3H6gKEbLjzw&oe=6AE0ABAF"}, {"file_name": "screenshot_02_2560x1440.png", "id": "1715278783451729", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604370996_1715278786785062_7917595797971445541_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSN3wXEzqUgQ7kNvwGGaCLN&_nc_oc=AdpyMvY-AMuQ1aGFSInBxwy8BCcBPdO7gIuNyktjBQJ6MWRgOi28ecsNiRXl0jSLyhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV_b_iS-VSUtEhhcDEu4mlhw9e9N9S9Ggie84TD6pYCg&oe=6AE0C6FB"}, {"file_name": "screenshot_03_2560x1440.png", "id": "1807588710479488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/767772105_1807588713812821_1560848009213837964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggnnL9TmY-EQ7kNvwHhPouB&_nc_oc=AdptiBcVWn5YJ15E-kJc95yzuxNUbBoGzFA9c4TcOFkNeokYSw4Xa-LL6C_CYXZUf2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFHQk3WmHXuVvmHLYiOi3_WiMz43VwXxy3SsRLhUH_fg&oe=6AE0BBEC"}, {"file_name": "screenshot_04_2560x1440.png", "id": "2383688095768794", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595129854_2383688099102127_6642077890210346176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTlLxRpfRY8Q7kNvwHYUhsk&_nc_oc=AdobBcxjzizehQm58xunGSMTbZy3zvFbPYS1WvCov7jNYI_bznKHp4ALSiDLT8IovDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRVsJCCwtkmnatFtWKhhq9AaL3jz57NFab3ULW3aterw&oe=6AE0BF5E"}, {"file_name": "screenshot_05_2560x1440.png", "id": "1087708997198905", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_1087709000532238_5286525463525263078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tnu7eIJ9cvQQ7kNvwEgemVl&_nc_oc=AdptJIbEXAh23qY8HwuDgNMQWry7evHthNsMeOccfAMfogB8Vb02h835-AHzmsYmI7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6pvOKIO8NoN4BKUg3Ncp5VEqANKWqB5v---YXkhKvyQ&oe=6AE0B2F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puzzlegram", "keywords": [], "long_description": "Trasforma il tuo spazio \u2014 e i tuoi ricordi \u2014 in un puzzle tridimensionale.\n\nNOVIT\u00c0: Foto \u2192 Puzzle. Scatta una foto e guarda Puzzlegram trasformarla in un puzzle 3D sospeso davanti a te. Il tuo salotto, il tuo animale domestico, un panorama, un amico: qualsiasi immagine diventa un livello unico da ricomporre pezzo dopo pezzo.\n\nIn questa esperienza di Realt\u00e0 Mista per Meta Quest, i puzzle appaiono direttamente nel tuo ambiente reale. Usa le tue mani per afferrare, ruotare e combinare blocchi cubici sospesi nello spazio, costruendo la struttura corretta pezzo dopo pezzo.\n\nSenza controller, solo hand tracking naturale: interagisci con i blocchi come se fossero davvero davanti a te.\n\nOgni livello mette alla prova la tua logica, precisione e percezione spaziale, mentre il puzzle prende forma nel mondo che ti circonda.\n\n\ud83d\udcf8 NUOVO: trasforma le tue foto in puzzle\nPuzzle 3D immersivi\nInterazione naturale con le mani\nMixed Reality nel tuo ambiente reale\nSfide di logica e costruzione\nIl tuo spazio. La tua foto. Il tuo puzzle.", "short_description": "Un puzzle rilassante nel tuo spazio reale dove costruisci immagini combinando blocchi.\nTrasforma le tue foto in puzzle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.1mmers1ve.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "1mmers1ve", "support_website_url": null, "website_url": "https://www.1mmers1ve.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28635588252766531"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499301053_1344160777741479_4067151853492315030_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-0o7ISY7LUQ7kNvwEPpYM0&_nc_oc=AdoN2AjWaj5TXrQcpQs36dIG3dRRUwW3gjknaLr6WJkQr5OjaqSuhTqNlFz-VhOCYJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkjnUhHMfV5pMx0TTkdI0_lLKK81dVTNm-FkWqNgASOQ&oe=6AE0B85E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
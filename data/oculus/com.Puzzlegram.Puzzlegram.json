QIKgt9rP49zC0p-2Sq1v4bGxqxTEbrxWkco6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ok0x0dRFCtN64w_1LjQK3Qe2n2tbFV5JrqtbjOMimBA&oe=6A2AE006"}, {"file_name": "due.png", "id": "971450642160470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820578_971450645493803_5538814751118299662_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcEaVDTyt1cQ7kNvwH08aB0&_nc_oc=Adqpx8DRnfdedS0YwSieX5K8xOD9mHHSFZBBnFcoMGs11soZzhgGuj6KB-Ht3zrF3lE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91gI1LdS9JwehSVYp3-CAl1xXSvja9TQcn6E24ppMO9Q&oe=6A2AC116"}, {"file_name": "quattro.png", "id": "3811052495856856", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_3811052502523522_8480076080778792842_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJW2N-JrK7kQ7kNvwHUSvkR&_nc_oc=AdqhKtP0bxA9T7YYDSpxfmIq2lzYjzLu7i655ZNnhboOq-MMRmv0G_stvO3NEKo-RNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QEp6sXflv1siLxUzhoPrlwuvggd2438mufrySg8ad1Q&oe=6A2AD03F"}, {"file_name": "cinque.png", "id": "1118374883748028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818849_1118374887081361_3413443544892680657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9B-1AGtkxMQ7kNvwGbx0Fi&_nc_oc=Ado9US1ldEeAVc8L-oifaSWsRQhZ7vJ3iOJkKkyeauwajYLNCGJypPgX3E75AvpJAR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E8fS76Qu_Ndoanzi4hma988EfFQMz7-57-Vf9Vhowdw&oe=6A2AD5D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "uno.png", "id": "1253198089537750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1253198096204416_796246098067425217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMSLVIsqq24Q7kNvwFTC1cx&_nc_oc=Adpk6voMa6E0GjHQejES1NjjtrkocmV-HwDcwHUh-trjeRT04O6kjS9_lSDPmPt97vQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PcFF1fYHXoFR2tGH_0S2vsCu0sESeYTrn3gmbgENDag&oe=6A2AC461"}, "display_name": "Puzzlegram", "keywords": [], "long_description": "A relaxing puzzle in your real space.\n\nTake a moment to slow down and enjoy a calming Mixed Reality puzzle experience. Cubic blocks appear in your environment and you can manipulate them directly with your hands, rotating and combining them to complete the correct shape.\n\nNo controllers and no pressure \u2014 just natural movements and the satisfying feeling of watching the puzzle come together in front of you.\n\nDesigned to be calm, intuitive, and relaxing, while gently challenging your spatial thinking.\n\n3D puzzles made of cubic blocks\nNatural hand tracking interaction\nMixed Reality in your real environment\nA calm and mindful puzzle experience\n\nSlow down, focus\u2026 and build the solution.", "short_description": "A relaxing puzzle in your real space where you build images with blocks"}, {"images": {"nodes": []}, "id": "795830493572101", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puzzlegram", "keywords": [], "long_description": "Trasforma il tuo spazio in un puzzle tridimensionale.\n\nIn questa esperienza di Realt\u00e0 Mista per Meta Quest, i puzzle appaiono direttamente nel tuo ambiente reale. Usa le tue mani per afferrare, ruotare e combinare blocchi cubici sospesi nello spazio, costruendo la struttura corretta pezzo dopo pezzo.\n\nSenza controller, solo hand tracking naturale: interagisci con i blocchi come se fossero davvero davanti a te.\n\nOgni livello mette alla prova la tua logica, precisione e percezione spaziale, mentre il puzzle prende forma nel mondo che ti circonda.\n\nPuzzle 3D immersivi\nInterazione naturale con le mani\nMixed Reality nel tuo ambiente reale\nSfide di logica e costruzione\n\nIl tuo spazio. Il tuo puzzle. La tua soluzione.", "short_description": "Un puzzle rilassante nel tuo spazio reale dove costruisci immagini combinando blocchi."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.1mmers1ve.com/privacy.html", "de
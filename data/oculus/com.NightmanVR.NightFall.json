19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur8yhfjwbyAQ7kNvwHOruN5&_nc_oc=AdrpCe5uvRUe2L-W-QZPntKSsa1PJJuSdaI4aGeTYE1Wat-SNCIIduVTKh50saHhTpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm8vwsFlTI2fDDKn0fFfUtot-vUarKhMbCX-iuSTt7fQ&oe=6ABE6817"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDbG9TeCL9sQ7kNvwHRqW3M&_nc_oc=AdpXufcWgLaOZokW6yWZ63iLkZeXGp9wage79se-Wc7U1ctpc4UNI9eN3FqjSvtCEk4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1AyZRf-de4nAQjUJuagfaRfZ7P16i99q03iIvMiN2Pg&oe=6ABE6614"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbtAJaOlr5sQ7kNvwHFVB81&_nc_oc=Adq2m5UcGCBpP-V8hzE7XPDY2trCZ8ZXch1-ytcFnGBLaLVYVYzPySwwNjiEHxvttSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdDROzGc3gowNXmC1S7PzcCzmgEfiGg98oxz_DHC6NAw&oe=6ABE6D87"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR0EPDuhnQMQ7kNvwF4SF8A&_nc_oc=AdqMwRYEjIyReijFT04KdB4p8BBHWsGFU-eMqfykpdNx6LUPOlNJ78cH3ngyeAGYO_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0hvkbf-aaT7o_kZv-9hmYAig9vKePUzc9bjr8cL1MIQ&oe=6ABE5E72"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96wzaZtoJAgQ7kNvwFzmDdZ&_nc_oc=AdrkKCMv_pP4RZ-pMfrUz4t2PUbA8pKwkFhYYeZvSEPzvI1LrZUs4n66BNFBWnsCAsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj8g3zR-B40DZiPsH4NrfvwW7_EUTw4iQQbGMgSt3YQw&oe=6ABE8132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjgZq339BmYQ7kNvwGfmuqd&_nc_oc=AdrEu2Wt6WZ1e_L0WUeTk7cFkjc9PN4Isug0nog6UuzHQ9R76lbGkVJS09tSNJ__Na0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ8OWUlVQ6GojKcHBTlc0gItUCW4OjqCAEI4QfFDgXxg&oe=6ABE6873"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
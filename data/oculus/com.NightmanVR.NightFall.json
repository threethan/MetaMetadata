": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y85k1UDMSnAQ7kNvwGC7pHw&_nc_oc=AdrSWiGZkclELhdtI4expjVkwtRV91g4BsMEMmIh3qCXsdqB4tUyY3iIeY5GuTEZvFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0_OVcYehTZOkyRDskHJIIELAqBKp_SOwNOFB8xO5Hww&oe=6B006C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFIKEoRy50EQ7kNvwEavYjX&_nc_oc=AdoCpGK1S9Vn1kIVa54mcGg7bGHwaHVOEK7nDZ3EOObnIhRjTId8Tn7wvRteOxiJKdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkSBeZtxFf3IYhdh2Lbv1lhlxavidv0TxweFOBF3QWhg&oe=6B005373"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/nightfallvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9397113730357338"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_1397705374937788_4178162908889158802_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJAPfcGdBVkQ7kNvwHVRvpD&_nc_oc=AdoVtgm1lEnm60NaUZURwDhH3J8JeIWzcmxKopmTJxcz20KYqjjXu1tRkPUUWORl5B8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqqa8MKhRAb6XdktRc4sWNia7niFEcqXopLc350uVaFQ&oe=6B00775D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Night Fall", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topi
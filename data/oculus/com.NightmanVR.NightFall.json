aPThFAQJBGIFzO-RsDYlq00tTBUdCpdqTzls48hpgox17giiOUyBj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1x7TEH-PGfMpWv6cNwPTrRLCMtgembsKdrhVctfckASg&oe=69F0BC14"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGrFkQiA1-8Q7kNvwHhlOfW&_nc_oc=Adrfgjqctl1a3GdXb2dqi1BhYGiteoX-7jUi-mgrkIMG6ZAH2iLVabB-zRprtUPmpO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2vEaZeND8Rw0t-7qp3nn_MKA1RLKfOLWl2Na9J13gUsA&oe=69F0C387"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpftLu_YhR4Q7kNvwFUUStW&_nc_oc=AdrykyZPKxcgc3qCQHvA-Hi82PxGa7mSUCE2XD-yWrO6eNPVQ5jOXtP7_eZhkg0vSG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0HcGHoaegHc_iRGSWECNlCYttog_BYhFRMz5Weh5RhiA&oe=69F0B472"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrMkFHu0GOcQ7kNvwG3R160&_nc_oc=AdrxRqkOQnm4QXJZzDZISQI1Uk0hde-uUzPf5TIONc1dV6Cysvwfwi6S4DD-HDzsdQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1NvMBNNeL_sPIitQ9UYDGzYZHL_POS2peNc7fb8L3bOQ&oe=69F09EF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47aWkdW7oPYQ7kNvwHPn6ts&_nc_oc=Adp6ZUj3eDyN0Rs-iV2TjZKxh1_1-uEnfDYPL9pJ9dpXR9XqlHGprDbMjeA-eElUMsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3CYenAWRfNhrZR4DwOnO1RUzwdia8HbjT3ZAKa0YX9mA&oe=69F0BE73"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/nightfallvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5MXVwASLnIQ7kNvwGsw4qJ&_nc_oc=AdqRC-SaK0i4LrPjbbhdzCJhQOsCXuCCKzByQNXXP9PzqUycv36b1olel5BuLcXoQgw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACAazy09icYlR5lQltLpCobTesB2I0AfFMIMBdgrqC8g&oe=6A58E497"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOncZUrVcqEQ7kNvwGU4h3Q&_nc_oc=AdonMAeJ0u6eftHK5RbrKO_LLCAFJ0Bv11WVgsqP06IIEOh_bD6DRZlozl6eGwzbIlE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3IlmFrDw-tSprsRBcytZB95mIL8j67_Hy7YGPXOPeBw&oe=6A58E294"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TR_-fpuiCYQ7kNvwE4p7Fv&_nc_oc=AdrMoN6eaF49WkniOq9a5lBiBGKHGa_mjlsouiz7PT2F5uVwn171PJl0xta_eK3fFmw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA4wKVvW7-cZKJgQnEYQWmKpNAgLsZAYG2zlCVpokRJw&oe=6A58EA07"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAturHLO6koQ7kNvwH2Bd9L&_nc_oc=AdqLxNW_E3f1_CbciHQCcycVck6kVi_c-V8-nC6aQDEawUaIsAq8JNc1YbGfTN8ZtfM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjRcLlOw4C8JeHTmyK5XczVBo-LBksqsz2g-0J9wHbIQ&oe=6A58DAF2"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXv7--1o5RMQ7kNvwG03CYl&_nc_oc=AdpViP2nSjIIQhA9CZnBatdGAQB5LsTS-e6ldppsRKaOBCdyjKWmul_QrKSKW0k020E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9JAgLwDuGdyt9fZLQSHesFjIHArwcDt8RnJV-psFr2A&oe=6A58C572"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoXUqnxScbYQ7kNvwGfa-LV&_nc_oc=Adr9tynAPS2PNZKBrZ1tc9YjPMhaq8FEobi-V9BWuCcUXH5is0eN7ecSqnJp9XLQmwo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4W8-YlQp4LlaEJ6eolD_cQyqn9iBQMVB2lEkGMWS3QQ&oe=6A58E4F3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
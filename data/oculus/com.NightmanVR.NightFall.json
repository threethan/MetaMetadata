19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur8yhfjwbyAQ7kNvwF4z5Ff&_nc_oc=AdrhCOozdCiKr1kngEVj-MFDbnhWTe0W2Yp4Ww4n7J6FzJFvHOMLsIQ3VNXWDXstW6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiI-Z3KtBdYpnXPfDV9X0gvGo5jQOQNHGGEDR5nrBB-Q&oe=6ABBC517"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq5-5GjxFQ4Q7kNvwGS7m5X&_nc_oc=AdrCgemj8ALvX6DGUYY4THlrJVGRrkG8RsNBI0uMgtXhoYe79gxUEQha7vq2K9ZGU1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE3kLk-c8EXT8d0WwolRrMYYLnqYJPQekOpJbU24UFdw&oe=6ABBC314"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbtAJaOlr5sQ7kNvwHSBMD6&_nc_oc=AdpWFlWM9DzOvgyLiI6M4mTx_FJGlEc7E6_B8Gd03ehMK0P3EuDNSPJHvxel41S-XG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-oESgNYv75eB7Gj4gd88rf3sed8RRAo13HrFonL_AyQ&oe=6ABBCA87"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR0EPDuhnQMQ7kNvwGtW-T5&_nc_oc=Adq7Zmc0ywzKBOZZpmGpFHwIAVnBB3qQJQvTlBPKHm_r9nowQHseGuQ_YeD4LFMjHN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL05V8AtHjQq2qjdDzh8qbBTVjYZOYTr8Y7Jzgk-g52g&oe=6ABBBB72"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96wzaZtoJAgQ7kNvwGe9QOh&_nc_oc=Adq23QOw6tcbdFjBdH14W7W6bMZu9bSTXXNik1l0niJAYE_UMFPlO240ziITpA2_pI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzfTpwaTtJgx1Go5ujFEJikWrg5CaQ3tlHrL-jFT-KcA&oe=6ABBDE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjgZq339BmYQ7kNvwFO5RR_&_nc_oc=AdqfWLriqbVwEb9J5FNXKJEYV1706KPRkXZiZoT0JGe7dkOSck7l0iWoGIlmxLA8WqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2dnUz6RMQ7heiYzVcM527K9aKMHjsj6A2ni1vnxz1YQ&oe=6ABBC573"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLTZlUr-qYEQ7kNvwHrLbaU&_nc_oc=Adp_WtvE_o2Z2p1PmylGaOk0J1tDnJiLdsO5JekywTNdo0HeRXZk8hO8d3HAbkYXMDo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAjMZrjZRHYE82K5MAY5y_90xl-5UC5jKCF49wkS1l7w&oe=6A4A6417"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuF7l4wMTa8Q7kNvwGwHjvG&_nc_oc=AdpYuLjeVyXmkm0GFvckAGMEAPoOVPZwKsB041bq_mIWPoNmYg7LLqa-MekCzLJIzpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASqKEo5Aejof-7YZ_4dMZNt1Z-e8pEH3WvTziPa0zqkQ&oe=6A4A6214"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHuJU0xHHQAQ7kNvwF37zK2&_nc_oc=Adq1KVmWwTlq-o9rAe4kfenZk8LAXdyBVW1_4JWUb2a9EElTqf7ICG6mdHSfbt2Qxf0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA4xMGl7EtDXoNdpa6djmocxZ-7_O8fudcy2pSATRqIA&oe=6A4A6987"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UpJJK4y9tsQ7kNvwFei0Ah&_nc_oc=Adr9x4Jn7mlBAgBzXlt7-8U-wR2beD4TFcFnhd_aEgzSc_TyK2M_MxjG4V1vXjfiaZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY1GvfAB-RGHiuKKtu4G0UmuSLdIX1tUV_guJ7yzkggw&oe=6A4A5A72"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRIQPH6sBjsQ7kNvwHGHv_5&_nc_oc=AdqHd11SFP3GDogqBuikwpDDgLZzqYTQB4wIXmSgyfihDKcCcagA9h_866GXZkK8T0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCamLu6Qdd6x7_VexAwAJoqpZYz3JXnsrjd9EBHIU5zUg&oe=6A4A7D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWiQA1eRpsgQ7kNvwGcLygJ&_nc_oc=AdoWF2tIVrPuqNUas-hjoF__y8dkO_yjysD09VDFgKPLqaA_crebpdeGYJmsIPWoumM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWDA_XRgqbjk_VvahiaCtQmRfGFJYstay9v08rpS3Mzw&oe=6A4A6473"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKOBns0XesYQ7kNvwEX5ti5&_nc_oc=AdqZdcwH3slZmpKUdRiR43Zz4IjT0c3zRmZICpJz7rWEO2Guy9JIQ7G1Ip2Jkcb4V9s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWRkfJ9SiOH9BNUw53jstC2EEd1n2N3RVDVUVq7Xtcdg&oe=6AEC8C97"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtoEWbsmza4Q7kNvwHCYuHR&_nc_oc=AdoFtjxIun0sf09Rj5zSkYgmNp__6tBdEZhF18pFfvZU91o7Pt0z0oNlqwHzZEEZ9zM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjC_MO-loCsjuTZljMMI7-HKYEXkGrZHPTMUmuQ0J2EA&oe=6AEC8A94"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8aX-4anl8AQ7kNvwGMfd7W&_nc_oc=AdqfE4WlU5P_V_PIWedFSb5Jxvt87SHkuDfGYyd_Q9DXlH0i3rkL_rvt3lDFaiaPH90&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsOE5FLiUHT10-iwmEawzTolLTWTgP-y2zjQ5ST2jF-Q&oe=6AEC9207"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hHYa5j6wtwQ7kNvwF1BROv&_nc_oc=AdrteHEw9mpfN2yEjssNtokPczf8gCqTCVjb-Fy20TmE9BNSbbdoP297kU4bEYA3VzQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRSLT1fdsS80FoGG3hc1Fgvq4nLNyQ3xCyv29bIjYytA&oe=6AEC82F2"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtVcRTDL-nYQ7kNvwG7MuAc&_nc_oc=Adqy9-0DscGpOOUjs0ufJYRL6VvusVbW5XMYByDQYXbtP8ldlQlBy3uYjUtVl9gKAVM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtSnHmfmoKFcMRN5RCTw5wBfZqv6s6fP6sR9rPhzSdSA&oe=6AECA5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dquNFQ94BzsQ7kNvwEhU4Jt&_nc_oc=Adpp5zjoEwZq7gOhiAS6eoSQujhPkCXI6ahgb6LrfR7YB0ltaOA4HZ79SRLSK9I4paQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAiSr8PU2Vl3AygaZdguPdHSyYZEHJm0rCGMHFpiw9zw&oe=6AEC8CF3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
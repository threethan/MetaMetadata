19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsC_ZXXckvcQ7kNvwF_RRKZ&_nc_oc=Adq56C-s6xt4vFxh4ileb9Xk8k0B_IyrMUHYwx9IrsFBKlKFnd9ZhAHxfHlL21Xbf9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mN5MZHvuKpDolovCdQ73i3cwyyB8eTg-jybNUt5wvog&oe=69F9F897"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C32fYo8GavcQ7kNvwFGGb3M&_nc_oc=Adp94RDMrtYjdqoOaQNUbCLl7H1_JNNQMvJ9-39htPcuXLtCHq64sUlC-53I240IkP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yeCvxj8kHdh4h2Zee6uOYeKwiFCUEOuhl-sdrffhg_A&oe=69F9F694"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysOZL0YfUe8Q7kNvwGkTVtr&_nc_oc=AdotYEfPLBmnVGr5dvp4ngLw5sEp6mrCrU2-pqgAPJ_VCNXXaozQ6CMaWzd61bhOCHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HtDQvT4Vr3qb1edeIB07AXAmr01axDPlc-eocTGIJ0w&oe=69F9FE07"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hptboxp0kekQ7kNvwFQ_WCl&_nc_oc=AdpY3Xk1m4YxSDp2sqb9DDv27jNzbILKh8GSJrslTfZN5IcwNQi-L6iT94Kbda-tryA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CCPjYs9Bqgs3BDvkIf51yKdG-4esqIXau_FyRderfWg&oe=69F9EEF2"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAI1HrSqqVUQ7kNvwFsi5_W&_nc_oc=Adp8hGMoknYGPS0kngB2FFLCu5ARKViM092exkN_apzSRs6fpCQjb7Ik_onqC3ZC_w4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UGlKM0whgWccan1WkzmMaw-okLZMr_L_5JSul5FKvag&oe=69FA11B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYmIxqRsfkAQ7kNvwFJgIRd&_nc_oc=AdqZFbnlCM-O-gKH7QYz-6cUjXCrgm4RTh78izocjf3hswZnXMHKgEXtwjEqgreyJ0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DtMALgCut_kzH-ebbzNofzYHvQO-eQs__m_qjF9yuOQ&oe=69F9F8F3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
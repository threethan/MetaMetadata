19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKfhSSwz6tsQ7kNvwE0_KMC&_nc_oc=AdpkHIzKHQNY6PhaeYmvJjKDQQecGE7ht0L_KzamS8X_q-5F3CAja0KL3mcV--kVAWc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UKn2CeGicdQ1S1o4n1c2fDzxYODp7j4OjIPW6Kf-8dA&oe=6A300617"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXLktibqL9kQ7kNvwF7ewSc&_nc_oc=Adpe6YNyHfEkXZbofSFi7ai9mja3tCZapYDLIe8UX92I8682q7p83Vu5fFQLrV8rEWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-3HJ11xOfiNZhU52NETJf4Rc4m5d1d5_5ET2mzi2BkA&oe=6A300414"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO6HFOWs7ecQ7kNvwEX-UVr&_nc_oc=AdoMSO4FPpkLVAC7bo3iYFA0XyNbkoOG2qF0_HhbFm0Pj3KuQvHoRSiOKMq0ZipkHOo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--PJRoWem7tHI-xgnTvlEJ5RVtcombqY5pRXqjrl4uEw&oe=6A300B87"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhgdQG-5LfYQ7kNvwFsgvh6&_nc_oc=Adq0p0-WScbal8vkTLYTWF4pFqq1Qslj8TJDePqZsSYieVOQR2LcGT7AmbN02uTkNIs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gPCIqObhwEf2w87cvQeK7Z6H-wktLz2IK9mTAfeLrkQ&oe=6A2FFC72"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAXabOaxjjMQ7kNvwHR1kO0&_nc_oc=Ado9J3Q_9yVWhp0Bezv5BDlkpAaesq_Zo-tJEyGORtIoQ0VdfeG7pyh1KQfoTb80GS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1p3qspUpgJIKw75nGV-kPfYSFYvqVwNxKtpCjVxeLiw&oe=6A301F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us9j3sGYo64Q7kNvwEMWh8x&_nc_oc=Adq491coe3l4LfJJK4B5PTbzS7mljaR-k_YsbrHvwJScKPVbGn2OKwmSz41VFCHs9S4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D5ty5Rp0GOD84C5Q2zQbl1eKZQm4Pn3oV-9KK6OEcNQ&oe=6A300673"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
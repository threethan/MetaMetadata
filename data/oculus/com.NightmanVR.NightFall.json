19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAizfr6eFQgQ7kNvwHojpyu&_nc_oc=AdomFKdtglui2RL_mMuXZq4ttGEGK342XGT2cG-e6KO3_TR0QwlPf_nfNZLyioFwG3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJRaOHHMhBBJ6Ype7EpDGTD4mohQmQ_aCqenv1sX0y1w&oe=6ABA7397"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq5-5GjxFQ4Q7kNvwHdS9F3&_nc_oc=AdpSv3U0MjwKW-hNi9vA_JR0bknd1qikkXBuH7sbAfGM2PHIXvp4GK7Om-6W0JrSv8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-MSDKdx1Q8I34HzqbLhCVTPEQEf3eTusRg6SbZHbSbA&oe=6ABA7194"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmVFXbNjwyAQ7kNvwGOYtJg&_nc_oc=AdqYDDeQ2WgOTkvsMrleOXbHSXR9XDevxTSq_uux1EVR_Fs3IDAM-a-1V0Nx1DNf65g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0gg4qW165ZSKjuduySJjafKXAOJH4FbBniFU96jh6Kw&oe=6ABA7907"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ojmaKA3e64Q7kNvwGiWDtG&_nc_oc=Adp1XU3BYABbD9fmOFwo_V-evAQYjpJRYceRc3z39dYzeyhIZiws3o3itce98zTgvNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxvPtBvIXBCR_vGv0mIIwJwA6DGojerTx6QGiGltXm2Q&oe=6ABA69F2"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjalQoJ2bHwQ7kNvwEKNIJR&_nc_oc=AdrvDqgHRnwe3icgGj9jptojQdGTZ8UN16xMU3FtA9nCcjTEb6L33kFLpBXxrFHtHSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEZ6GXngrP6iKu4u4l-PNXjCfhOOjyw2CYGSh5izwhDA&oe=6ABA8CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tnp5VJ5O0A8Q7kNvwEjMeKC&_nc_oc=AdoZ41fXO7yJlkIkNPe0nxeSC-k_bIlrdt5iNtVezorxRF-1c1fT_rFWUl39vdvuvsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQmw9ZyNU6mEBxD-QlvO6m4_D5frmebyBItXIR1O7Q3g&oe=6ABA73F3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5fT3cxB4zUQ7kNvwFecLUa&_nc_oc=AdpAJb_Mt0lV8SpxLoB3uPQSGtG_1yOEUki-dLxGxowwAuNW_-U6gdiZjlcHBHTnlDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqTyuNR3ztSbfPQfuXu3ItZcQVz3KP7xM056IBtbVwjg&oe=6AE9E997"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RQAd_dDMBoQ7kNvwF_WUSJ&_nc_oc=Adpttb3VztSgqaf_oOCwuxUJ1myJ4Q4Ao33PeQHUrgGhBD96c4yHGoAYviDd_bB8c2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz9FAucJe5iyMq75UXoB0RZb7wm9sNNoqKpF0I-JW7zg&oe=6AE9E794"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFx-enewTtYQ7kNvwExBBdC&_nc_oc=AdrppRs_Mj5Jd3YNebv4AcegMNeuYM86VRVl9jajfhuLoIUcgwc5E5wIOrzG4e1adq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR59NUJOllzK2eptVyrmYH7_Rs6SamQ2JvVUsM9Z-wVJA&oe=6AE9EF07"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kmmR_mz8_IQ7kNvwHqOxjU&_nc_oc=AdroifBgy5c26AO1nQ1ZKL_DtdwAAaDKwts82QGxdI-dR6cXjbKdXjeuxwWpiHCqQZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeXhE4IRi7sPI1giS57nALdddnOYHpZvJx6tJoviAjVA&oe=6AE9DFF2"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFRjp098iM4Q7kNvwEcCdlf&_nc_oc=AdpopXrapwWA0JuJKsMcA5mtgeL6nc5AzafUGwouhrj5VvAJ41Rw1HtZQo4ktltMBVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNt0rG4BIIuEMNeaesyz-j94cdNqtIK7hO_Fl_agyAJQ&oe=6AEA02B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5SGaS4pUSkQ7kNvwGOPn0u&_nc_oc=Adp6NLST0eSi9Yx7YjkkOcLR8BNn1GhwqCMTFv0Xj8lzoeWZZKYucKo_0bum80ZIZSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVj4ZLvy9TZ-6hdo2XNWFDXP22S3Gdb9_zq_HfYKR4ew&oe=6AE9E9F3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
EIDiucDTj0t32uOEFI_ATJTaWjPoRewx23c3qLT7573peYRnUW49xI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9QqQnuw2soR8xS92S0QVp5M8_aWMUCaMLvQeKTuUTVA&oe=69A2F394"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AhN37pAczYQ7kNvwH8svLB&_nc_oc=AdlDSFJR8FQp96lba-Tm0C6z3SCrU3140ZwJiEJJee95VKzc6zNyb-nS4kIR3u2pWw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsy8kXBr6b_fWY7OSV6Rf3mtqv_lEKynHmvyvzXQpqfoQ&oe=69A2FB07"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G12kOLTl6i0Q7kNvwEyR9KS&_nc_oc=AdlDBWCuLE-Fzch27-izK3cqIvNupBZByfrGyJoZHhrjZKb44dtU9zvc5t9yHASB4Ig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGt4UekMvGAMjNhIXY--2fXj-cZ84trb54tgZiPmJcgg&oe=69A2EBF2"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTjxDDZgm-YQ7kNvwGuYi69&_nc_oc=Adl8pFZ9mdPmFBJFIS96L_h0FpfKAXwDmrxvT8E_v76CspAa4XMVXAegCy8KxFXJv-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsC78SWeda9SQEPJBrtoZ_xeqQp5zmnbWp5t3bCdXfwHA&oe=69A2D672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHD-2ULQ0RYQ7kNvwHzRwSX&_nc_oc=Adnlt1NNfXzbclEueHVoPwHuqbN3uADinv6MlmwHwIuIeJr99WjJaPRfDagZ29xxDRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTDZN9tMzoLlGOvXDFS44-rBFXPLsBbaeIafclDQo85Q&oe=69A2F5F3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/nightfallvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
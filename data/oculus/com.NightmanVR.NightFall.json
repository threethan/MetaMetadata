8D32"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggmT6Bg0RIsQ7kNvwGdDrUk&_nc_oc=AdoZhjplR039I7W1OMoGNqtbklQthSyGWbigDzTtYRcjWOCQVwFBZBBlNNM69hDrGZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReUNi1Bcv0haQt9zhl7-eRsEVJOsUxSeJZ_0IcY3yFnQ&oe=6AFC77B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOSu6VdVhPAQ7kNvwGwAfPZ&_nc_oc=Adrh_V5gkFNpcq0r3WDJvrI5HXNDadvjt7z1O85roJQSS4CC4jhgSBUwBCj37MpM0ZM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY3JezLyUxHFtNUJQCGnGwuqno3DQuvv8e_BqxY7rrJA&oe=6AFC5EF3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/nightfallvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9397113730357338"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9573297669405609", "version": "2.7"}, "id": "641082161786059", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9279022402166472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9573297669405609"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_nam
19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX_YHQ58iBcQ7kNvwGbwWSm&_nc_oc=Adrwy13XkcZOvP6pjfmzktV-UkG82nPjn6mFQGI7ukpSaZwhcVz_mi0SWCyrAg3lSgE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSgpgycE2rJpoQyzrvlwiPUPilHGXdckCoZM9ry4yB4A&oe=6A915CD7"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76Mw-fFwMyUQ7kNvwEeWejz&_nc_oc=AdoYkZyjvmME0NRRlY3TYUfu1k8OeG1sDTnMZ4AWkzaxPBBS9bODbD9Ch_EmL-wGdQA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyfaB0AWDFGzkQdxhQiiHClZkealPNmGPXY8E33bCwsA&oe=6A919314"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr4INgRinTEQ7kNvwESAbiN&_nc_oc=AdoJS_r8McOaJ4LacDTQQ4cZ7v6IzTtfitDwalgDQCnAX8mXmx1OQG_PF3_igkr8vWU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbZM30ubU8_PAI94H-sQcB0S0dxaC8lXfJjJFWWO0OhA&oe=6A916247"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lfBQ8onpI4Q7kNvwEiJjTg&_nc_oc=Adquw-QNj8ZJUUGELLTS7uxstCngRYo9gRpCljqI7IV1EyIEicnR9Fcst9GeG-aNURY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5NUNuf3MyJEJOqIUefyV4JXzLVnftFI4VQ6-8yqcvbQ&oe=6A918B72"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXx2Q1LvLs4Q7kNvwE3JDOe&_nc_oc=AdoYMprDBWqbaqcXEJZoYVMdMJJap5TdgSN7gXZmgZu7LgZfBtsy-yNihS1Cds2QzzI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYj6EpRh7z2kIPb3Jgoim4nN-l9iQjFJ7-q1dfFN4-WA&oe=6A9175F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OebCpKEitVMQ7kNvwG-T3C3&_nc_oc=Adp0wySwuo3sJPmJtUMNuQh-rmYT-ll1KXj1k-PeDZFB02lSbXrfpJtOshc55cNxmPQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFdjziurA169lzt0bv8At1W-SUftn_9gCPRS5lnB6Q3Q&oe=6A915D33"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
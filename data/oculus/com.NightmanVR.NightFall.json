19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_SGF2kiZ2gQ7kNvwEanW3Z&_nc_oc=AdpfELU9oPhIHWuh33r-v3ie8kY10VHKya49_21d1ccy-U4jH8fcjIBYNeWDCDSvwm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l7Rony4UEirnYb0eNkQYYAu7bYcuTrhtxJ8pe413Evw&oe=6A281D17"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHRmL0k3uokQ7kNvwFN_JN_&_nc_oc=Adp7pQsSRNQLi-IiQLNs4bgkqzbsGuuSElS0kAI8QeSu7mD4IreheIrCuC_nfQE6o5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mqQdn4KksL783Fbh0D-d3G7M87_HjuNDSrItNsAU2TQ&oe=6A281B14"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXZL48nihmsQ7kNvwEYIwPb&_nc_oc=AdqRJ3Y3a7y3qcSJKtIvKAZb-UEnIo6pPZrkMWSU2AO6TuMjIPQGY8EwsAv4sSHXdrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zVya_Nm00F6cVfkmti3ZV_LroWSkP7W_GD8k0YTDYaA&oe=6A282287"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26Vfe5BwJu8Q7kNvwEvXrpS&_nc_oc=AdruzXxQalvn9WCf5AVdd978ifJ_8Bt1V1rAcSTgWlgBGhjCrnH8LCwFdf2iWWRrSTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D--SY3TFdbD6vPpEpblaOwTWbRVKMsOgbES2e3uHStA&oe=6A281372"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woDmy29uU6kQ7kNvwHScbxH&_nc_oc=AdogNMAi6SoC87z7YiEe9XH8_E-X-HYmCU7hAxd2konwill_vJf4M3fLt1GwugLK0BQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yj3FGviaEVEawpYBtJt6xjUlCTpIs-blW7OCbme0YFQ&oe=6A283632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLr6mRK3ZoAQ7kNvwGNjXD3&_nc_oc=Adr8SwQRyYVziOVOKFAP7ibp2Qjsy-SIZZBE8t6H-22uCwwXHo7alpucZLSt2FnKVkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mezFa7ntkUhof_Hv4FtEjwe_eFaCLPFRMhOJfzZi6nQ&oe=6A281D73"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
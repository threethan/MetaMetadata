19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNUEDY8iqPcQ7kNvwHhfZCJ&_nc_oc=Adr91xywLHt3DhY413OqGIc-WVsm9IcsJo9ke-7hEgSL-bOzq3TuCcpQjuPeV5MlaD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPhzGHug98e6X8bYeWl0JXalWhloMU7gsnTBdV4dE8jw&oe=6A539E97"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PC7FMapBdkQ7kNvwFPg6bJ&_nc_oc=AdqiB98tr1mKCQZQSsSy6xP--cykmCIcfyHovIf-9CyOd4ZbRLlFSy7A1QsWxpL_ais&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA3-FUG0TbANaTs4_KMA31T8OB6ZaY91EQDw_VM5eFMg&oe=6A539C94"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAoI0FTDnb4Q7kNvwGXKycL&_nc_oc=AdoORtgHEAbA7F4_1WreUtHWzTFkdi60SNcO5KGDIoyZqECBzHRGzVEc87vVJBNBPZU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArT3TPIut_7ktDBG3Orz92WwH9Ig1OL7Lpn11M0uunlw&oe=6A53A407"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PywlJ4iF1mYQ7kNvwFA-Jp2&_nc_oc=AdppyValxMrNjyiWP4LUe-pcEmDqRBJOb5Znv3FgcZk1paAAK1uw38OmZfjb8Ml-Ihs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ5aYYzLvJykEo2AZH3zO1R8HIuDWx3yzlK9lb6-K24g&oe=6A5394F2"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwMRiTQu1WcQ7kNvwGom7sn&_nc_oc=AdpzkUTBhMPEqMSHpk1QK9HY7Voi75OuLaDBmDcHIPsra0_6GdNcvJrTrNBGGedXAKU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC02VaIoxHEj3KogAkbRgSCLV6XSKWeoPpo-uFRMZtrQQ&oe=6A537F72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLF0jUyfueQQ7kNvwHqvJ-6&_nc_oc=AdqoBnDLLjhnUkgAs_ncWc_sURCdZBlNs6jQoZSu9TpOu4DRslzFXm6Z7Y-Unc8MGcg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAymX6SyxvotfQC8l3wFQeoA3my0yNk6UDn6J1IVUfTvQ&oe=6A539EF3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
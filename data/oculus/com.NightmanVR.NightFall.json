19_1000777178051709_3407541149665612132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAG8_ykAxegQ7kNvwHa6wga&_nc_oc=AdrnxA0jLb2Y5mysvaOX5yM1kkaB2NvQbpH-tEyO47_h7S6VZO1DVn8WLru1p3xCek4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWRHUdovtotBWLiO6YAkLCVoOkXm74-PY6_gUCR35JFw&oe=6A7B2B97"}, {"file_name": "New Project (6).png", "id": "615856657876805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_615856661210138_7688736952849757505_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xja_8FlBqlEQ7kNvwFruw3l&_nc_oc=Adp1TUxVCBY9m7lx1qxsUcIw63oDTbY2wqghQdE6Q7trr49UjwmahX66qYrgDCmavKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHrHZFeIrWMpwPmp1PMotIJJDcADsvUl2xkcGrv-HUUg&oe=6A7B2994"}, {"file_name": "New Project (4).png", "id": "1840008673506369", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391986_1840008676839702_5600409225120241310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R7WWdlCzkwQ7kNvwH5jRLa&_nc_oc=AdoV6_v98qSWHl8pXabYPmMEWr6KYfLT6ZQDy4ACUW1CgpLvklc43z-jmJJFU4ffA0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQE5SO95hdpcONK2GOt7sdtJKFcLIHCdHGaQX8PyoyuQ&oe=6A7B3107"}, {"file_name": "New Project (5).png", "id": "3018914604937775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_3018914608271108_5282391253151326620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2eifmVtpLgQ7kNvwHkXRGM&_nc_oc=AdrZExeZJfF8WCG-aR7B7x9fLGSkIs4g1K0gBw1S1zvfVskGaJYWjnHgXarkjzN4YbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaMFmnrlIRy58cDLdSsPHUR5IpnT4X4myZUBAIGl3naA&oe=6A7B21F2"}, {"file_name": "New Project (8).png", "id": "432468926585050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_432468929918383_5496379154094667343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR65088PWRQQ7kNvwHKUoiI&_nc_oc=Adr78OAOICbIe7Hjutq3Rij6RSgvblORWZsrF_hT73_DI97_731jZxeX9ArejRAD4Bg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF78EMwSEPTrdJYc849C7UDX0wkOv0-A60MdmF27YGfGw&oe=6A7B0C72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1024883829455204", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392019_1024883832788537_8706791247559462832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGVAuDQMcqIQ7kNvwFXpuCs&_nc_oc=AdqJ6DDp-b5DRLpDZ7YPKpCQPE0ykIZegTtfU7NgOb3pcdS8kY2mW2l8ZWlGN2HjsxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFByzfU-8WnbZ1kJ-0Wzvj358uUnJgyGCskVwahX4XQQ&oe=6A7B2BF3"}, "display_name": "Night Fall", "keywords": ["Monke", "Gorilla", "Monkey", "Multiplayer", "Cosmetics"], "long_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. There are different maps to choose from to explore and play around in. \n\nPARKOUR! There are currently a few levels of parkour with many more to come. Test your skills by avoiding moving objects, lava, acid, and slippery ice. \n\nTHE MALL! The mall is where you can deck out your gorilla outfit with many cosmetics to choose from. To get them you have to pay with in-game currency called Silver Coins. You get 100 every day.\n\nHORROR! Find out how to escape mazes, find puzzles, run from monsters, and much more in the horror game mode. \n\nMULTIPLAYER! Yes, you heard it, multiplayer! This game has multiplayer to allow to join friends in rooms and play together!\n\nFind it here in Night Fall!", "short_description": "Welcome to Night Fall! A game which uses a gorilla-like locomotion.\n\nEXPLORE! Is our main priority here in Night Fall. Well, besides having fun. There are different maps to choose from to explore and play around in.\n\nJoin Night Fall and see what it has to offer today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfallvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
BD4"}, {"file_name": "Boats 2026-10-05 22-42-24.00_03_50_23.Still005.png", "id": "1797899131240775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296057_1797899134574108_6025554616310313284_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-p2JYZb8eYQ7kNvwF6sV79&_nc_oc=AdrLrQUnoz_-3zX7KJ_4IOTx10WkIkov3WSb_Ir9U9ql9XaVJ1iJYU3unaM9QjIEbRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT12aAtEeJ2MvXAQ2-Sl-4Uw18apyl9Slww57OgD-bU3A&oe=6B0C779F"}, {"file_name": "Boats 2026-10-05 22-42-24.00_05_54_31.Still006.png", "id": "2929523657414427", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604293968_2929523660747760_8376940066321826004_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0lq-YBF29cQ7kNvwEWqN53&_nc_oc=AdqcHNErsIteeaoPpoLmK7DRuhszn1Ytrx2wvIYWubYPbmSAr2xlytPoCqewKalO65U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7EzVsVKY9XwjmjoASUC-Q8Y2zj3uHRngkc7Zmrs3IrQ&oe=6B0C69F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "REEL_cover_Landscape_2560x1440.png", "id": "3350658941789099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/753032404_3350658945122432_9204743909055786045_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0QHheu-OeUQ7kNvwHWSBES&_nc_oc=AdpaDD8PfBYnuOyrH-HuOvtHsqQ6te0779s-BfPSJpER1SeE5ULvUh6sQG_KkE846UA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYq0l4T5DoIk92xHYp61lBUYpEddbRFAmjbnVZWhwq5g&oe=6B0C6DAB"}, "display_name": "Reel", "keywords": ["fish", "fishing", "pets", "multiplayer", "adventure"], "long_description": "\ud83c\udfa3 **Catch crazy fish, ride creature boats and take on giant bosses with your friends,!**\n\nGrab your rod, jump on your boat and see what's biting!\n\n### \ud83d\udc1f Creatures that fight\nWhen the fish rests, **REEL IT IN!** When it fights, **SLOW DOWN!** Don't let it get away!\n{1143335128070810}\n\n### \ud83c\udf1f Catch them all\nEvery water has its own fish, from teeny tiny to crazy monsters. Fill your booklet and show off your biggest catch!\n{1045757075166259}\n\n### \ud83e\udd80 GIANT catches\nTeam up with your lobby to battle huge bosses. Hook their weak spots, knock off their armor and reel them in together!\n{1525474496015407}\n\n### \ud83c\udf0a Explore new waters\nSail to the 25 different areas in the world. \n{1131884519284406}\n\n### \u2728 Epic rods\nLevel up from a simple pole to rods that sparkle, glow and blaze. Every upgrade unlocks stronger rods that catch bigger fish!\n{918211451148000}\n\n### \ud83d\udc09 Ride creature boats\nSteer creature boats with, make them faster and bring friends aboard. Pick your favorite skin, saddle and reins. On land, your boat shrinks and follows you like a pet!\n{2910363825994606}\n\n**Grab your friends and let's go fishing!** \ud83c\udfa3", "short_description": "Grab your rod and your friends! Reel is a VR fishing adventure where every bite is a battle. \n\nCatch crazy fish from teeny tiny to crazy monsters, ride creature boats, and team up with your lobby to reel in giant bosses. \n\nExplore glowing reefs, stormy islands and the mysterious Outer Waters, level up epic rods that sparkle, and show off your biggest catches!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
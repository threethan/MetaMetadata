SqlSq1iXCWQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThK-NaBF1hM74zXxHrpqnaMotyI2rM42NJCLMpFFt6Kg&oe=6B083D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "REEL_cover_Landscape_2560x1440.png", "id": "3350658941789099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/753032404_3350658945122432_9204743909055786045_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kS2kHSoADwQ7kNvwGEEjAF&_nc_oc=AdrFb2ofC9bqFFLOmyP1jKDLAXZDGvxr9id1w5Z8IAVGNS9h1gkv8120scLujkjYOp0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGdakzNoFckCUXZZEEntLAiaMgYsYVv69vTqEeWCKetQ&oe=6B0840EB"}, "display_name": "Reel", "keywords": ["fish", "fishing", "pets", "multiplayer", "adventure"], "long_description": "\ud83c\udfa3 **Catch crazy fish, ride creature boats and take on giant bosses with your friends,!**\n\nGrab your rod, jump on your boat and see what's biting!\n\n### \ud83d\udc1f Creatures that fight\nWhen the fish rests, **REEL IT IN!** When it fights, **SLOW DOWN!** Don't let it get away!\n{1143335128070810}\n\n### \ud83c\udf1f Catch them all\nEvery water has its own fish, from teeny tiny to crazy monsters. Fill your booklet and show off your biggest catch!\n{1045757075166259}\n\n### \ud83e\udd80 GIANT catches\nTeam up with your lobby to battle huge bosses. Hook their weak spots, knock off their armor and reel them in together!\n{1525474496015407}\n\n### \ud83c\udf0a Explore new waters\nSail to the 25 different areas in the world. \n{1131884519284406}\n\n### \u2728 Epic rods\nLevel up from a simple pole to rods that sparkle, glow and blaze. Every upgrade unlocks stronger rods that catch bigger fish!\n{918211451148000}\n\n### \ud83d\udc09 Ride creature boats\nSteer creature boats with, make them faster and bring friends aboard. Pick your favorite skin, saddle and reins. On land, your boat shrinks and follows you like a pet!\n{2910363825994606}\n\n**Grab your friends and let's go fishing!** \ud83c\udfa3", "short_description": "Grab your rod and your friends! Reel is a VR fishing adventure where every bite is a battle. \n\nCatch crazy fish from teeny tiny to crazy monsters, ride creature boats, and team up with your lobby to reel in giant bosses. \n\nExplore glowing reefs, stormy islands and the mysterious Outer Waters, level up epic rods that sparkle, and show off your biggest catches!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "1389569624231785"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "28237456899286639"}]}, "baseline_offer": {"id": "28237456899286639"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791933180, "status": "PUBLISHED", "id": "28237456899286639"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1503205186201561", "version": "0.1.47"}, "id": "2252804025507353", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applic
 "id": "1486621723519253", "locale": "en_US", "screenshots": [{"file_name": "Boats 2026-10-05 22-42-24.00_23_45_11.Still008.png", "id": "1455713549761260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596068480_1455713553094593_6303003530216829035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SLHLDNVnvUQ7kNvwGYNp4s&_nc_oc=AdruwGyv8uz6XHSIl3-E_4-UFrK4cZedYcLSaWmeVbDA2IObzTBld1fxlsf_50aNr70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL8YJbCf1EwHXSWPvZELBevkhhVtunEyGrGJ148T7rHA&oe=6AF354B0"}, {"file_name": "Boats 2026-10-05 22-42-24.00_01_02_49.Still001.png", "id": "1417345020513356", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303707_1417345023846689_4648781567319234805_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhjnA_prGvQQ7kNvwFOD7_d&_nc_oc=Ado29ZsGOHMeVWlawDeUFUzRR9dMuhwq2g2_LfmWyxPvHttR8P6chw5t3qgbm4g2wyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsiKwRRv5b584taXHBTfsLRaPG70gIP6igYuhEydUUCg&oe=6AF358CE"}, {"file_name": "Boats 2026-10-05 22-42-24.00_23_45_11.Still007.png", "id": "29189020774038762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303707_29189020777372095_1550532080902181746_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJvl2AMjVWYQ7kNvwHQoCno&_nc_oc=AdqcL9Jy-wj0MNAgd93gHdXlPjdav-IkcVHS5XdFY-HNTAhoZn-xheE3XE26WPW1ylY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs02LSRilDQPUFE5hO3p7EHxLJucnI4jA0BLrVp_puEA&oe=6AF33714"}, {"file_name": "Boats 2026-10-05 22-42-24.00_03_50_23.Still005.png", "id": "1797899131240775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296057_1797899134574108_6025554616310313284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9T60ekbyecQ7kNvwEkKMB5&_nc_oc=AdprmRGcIU14DJOSrssRI5lktkyKaiZMYQLxIRFGbRj1iEvtW4y3hWNvnbCsVIFPYDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpL1L10NA3XDqXkT0G1huIl6hst40utCIsdp95r7lchQ&oe=6AF332DF"}, {"file_name": "Boats 2026-10-05 22-42-24.00_05_54_31.Still006.png", "id": "2929523657414427", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604293968_2929523660747760_8376940066321826004_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1QyMmm9EgAQ7kNvwHE_yun&_nc_oc=AdoFRkKwsj1sv8f_JoSCB_bvypGWVdnoZ3JwnxLisYbbX6FlxV5ppy4d8thwfqNTmq0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtvOktl5o3iVVWrp5cZzt62F8-HqIeEOr61uEGKN3hnw&oe=6AF32532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "REEL_cover_Landscape_2560x1440.png", "id": "3350658941789099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_3350658945122432_9204743909055786045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bi3JxWdnv4Q7kNvwEnGVV0&_nc_oc=AdpQKY9n1un1e5_qI5E7JJ1jUGkYSaw7Z6EDiD8IdfmrGtzcjzbBYius8wBrgWwOFsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSzPlFrP8DKL90PHpTMC80vI07EU0BzyoHwn6IhkU0cA&oe=6AF328EB"}, "display_name": "Reel", "keywords": ["fish", "fishing", "pets", "multiplayer", "adventure"], "long_description": "\ud83c\udfa3 **Catch crazy fish, ride creature boats and take on giant bosses with your friends,!**\n\nGrab your rod, jump on your boat and see what's biting!\n\n### \ud83d\udc1f Creatures that fight\nWhen the fish rests, **REEL IT IN!** When it fights, **SLOW DOWN!** Don't let it get away!\n{1143335128070810}\n\n### \ud83c\udf1f Catch them all\nEvery water has its own fish, from teeny tiny to crazy monsters. Fill your booklet and show off your biggest catch!\n{1045757075166259}\n\n### \ud83e\udd80 GIANT catches\nTeam up with your lobby to battle huge bosses. Hook their weak spots, knock off their armor and reel them in together!\n{1525474496015407}\n\n### \ud83c\udf0a Explore new waters\nSail to the 25 different areas in the world. \n{1131884519284406}\n\n### \u2728 Epic rods\nLevel up from a simple pole to rods that sparkle, glow and blaze. Every upgrade unlocks stronger rods that catch bigger fish!\n{918211451148000}\n\n### \ud83d\udc09 Ride creature boats\nSteer creature boats with, make them faster and bring friends aboard. Pick your favorite skin, saddle and reins. On land, your boat shrinks and follows you like a pet!\n{2910363825994606}\n\n**Grab your friends and let's go fishing!** \ud83c\udfa3", "short_description": "Grab your rod and your friends! Reel is a VR fishing adventure where every bite is a battle. \n\nCatch crazy fish from teeny tiny to crazy monsters, ride creature boats, and team up with your lobby to reel in giant bosses. \n\nExplore glowing reefs, stormy islands and the mysterious Outer Waters, level up epic rods that sparkle, and show off your biggest catches!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "1389569624231785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654975915_1348519741679062_4676373986661101401_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUgthKErv_oQ7kNvwGZWhjS&_nc_oc=Adp311ipgF4JaYpLNtmi_Bqn3HeEpavOPievSy4pLpKG25aU2w_xjojQLTBUv_bceqw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculusc
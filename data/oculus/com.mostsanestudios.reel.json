7&_nc_sid=6e7a0a&_nc_ohc=FJvl2AMjVWYQ7kNvwFw9vYH&_nc_oc=AdrW7yEN1yRRRxCWEYEa7UkNZKupVr0bQ1wdZk45Yrj1nsquZzER7y8zn6Go61S_jss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzIP9vtWa57ppbZ4db_m2hFtSvSv9YU-LNtxyIH7Khew&oe=6AF48894"}, {"file_name": "Boats 2026-10-05 22-42-24.00_03_50_23.Still005.png", "id": "1797899131240775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296057_1797899134574108_6025554616310313284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ji6Y1JjVhU8Q7kNvwFBH1zu&_nc_oc=AdrAIU0cNiaBdVwc18ClCv_dIIFY96DBCpyyDMf9JNXZXqksZX9bf0rqFekg4AF-2CQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoQsuQn-TGJIfoClg9pV8E3USHbcIO2b36SHWHz8rf0A&oe=6AF4845F"}, {"file_name": "Boats 2026-10-05 22-42-24.00_05_54_31.Still006.png", "id": "2929523657414427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604293968_2929523660747760_8376940066321826004_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1QyMmm9EgAQ7kNvwFCRmm0&_nc_oc=Adpv7wmbpOxZ3E8lwohA1e3fs9rRmnhpTr35dhfjlo5iVMxzMeN2bpJTsJi3kpag5wY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSroDOTOqh4ZqhIUJwrXp7Nx0rIEcEWPXjl8pfSvRPnog&oe=6AF476B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "REEL_cover_Landscape_2560x1440.png", "id": "3350658941789099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_3350658945122432_9204743909055786045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bi3JxWdnv4Q7kNvwE8soqk&_nc_oc=AdopqYa5BwbkRgpFJ0x-jCohz_6kOpLrBKlS2QgpGhzxrw0BMqtyHvE_ODEiKU9SUfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_kAxEE-8VDiFMLgg8IBnnSUnE3TcgUnpyjzx6hBjiLQ&oe=6AF47A6B"}, "display_name": "Reel", "keywords": ["fish", "fishing", "pets", "multiplayer", "adventure"], "long_description": "\ud83c\udfa3 **Catch crazy fish, ride creature boats and take on giant bosses with your friends,!**\n\nGrab your rod, jump on your boat and see what's biting!\n\n### \ud83d\udc1f Creatures that fight\nWhen the fish rests, **REEL IT IN!** When it fights, **SLOW DOWN!** Don't let it get away!\n{1143335128070810}\n\n### \ud83c\udf1f Catch them all\nEvery water has its own fish, from teeny tiny to crazy monsters. Fill your booklet and show off your biggest catch!\n{1045757075166259}\n\n### \ud83e\udd80 GIANT catches\nTeam up with your lobby to battle huge bosses. Hook their weak spots, knock off their armor and reel them in together!\n{1525474496015407}\n\n### \ud83c\udf0a Explore new waters\nSail to the 25 different areas in the world. \n{1131884519284406}\n\n### \u2728 Epic rods\nLevel up from a simple pole to rods that sparkle, glow and blaze. Every upgrade unlocks stronger rods that catch bigger fish!\n{918211451148000}\n\n### \ud83d\udc09 Ride creature boats\nSteer creature boats with, make them faster and bring friends aboard. Pick your favorite skin, saddle and reins. On land, your boat shrinks and follows you like a pet!\n{2910363825994606}\n\n**Grab your friends and let's go fishing!** \ud83c\udfa3", "short_description": "Grab your rod and your friends! Reel is a VR fishing adventure where every bite is a battle. \n\nCatch crazy fish from teeny tiny to crazy monsters, ride creature boats, and team up with your lobby to reel in giant bosses. \n\nExplore glowing reefs, stormy islands and the mysterious Outer Waters, level up epic rods that sparkle, and show off your biggest catches!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
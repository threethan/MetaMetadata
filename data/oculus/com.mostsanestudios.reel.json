7&_nc_sid=6e7a0a&_nc_ohc=KK9EePy_T-IQ7kNvwGX_9QA&_nc_oc=Adp4LRZGKryVaL_-Z-93IGiM3UF5KfaUB1czg31gPFGsDYHweXrJXoObnuwKIh29CbE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzG_nhTNauG8GmyQMsENTXljl8r1Xmg3HrKefRkTbIGw&oe=6AF9CE94"}, {"file_name": "Boats 2026-10-05 22-42-24.00_03_50_23.Still005.png", "id": "1797899131240775", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296057_1797899134574108_6025554616310313284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT9HrZ8gDkQQ7kNvwHCfkLq&_nc_oc=AdqHbzck-LTx_hsbCn3R1pG8nt1cYrucGoT7UyBTezYcjuZyaMg-afkezclhSBqZj78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxZXIGG916sa5O-5olm_Ae41F-hZ_IgpCj7yWxutDyPQ&oe=6AF9CA5F"}, {"file_name": "Boats 2026-10-05 22-42-24.00_05_54_31.Still006.png", "id": "2929523657414427", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604293968_2929523660747760_8376940066321826004_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13CWT1LwtHEQ7kNvwEMs3uL&_nc_oc=Adr8n-Cpvy6m6z-E3FO_-Fe5KWOUVm4euA17xouTKpOHWIcYXR83bhVoRjNIHVK-PpM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyyb6h1b5T8N9YV7oDBRqUZA6vOGyzPRmhSrWBccTcoA&oe=6AF9BCB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "REEL_cover_Landscape_2560x1440.png", "id": "3350658941789099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/753032404_3350658945122432_9204743909055786045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkKKudFRTsEQ7kNvwHo58lG&_nc_oc=AdqVJwXBcjQze2fk0L6xwpc5b3Id7VhUE47RDQYXYVH31Llyy-4aFe1DfvORPMIuqk0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqcQzDV-Q1FSwX3kS-OJ_otWnNdVLojAn3XeTBjluObQ&oe=6AF9C06B"}, "display_name": "Reel", "keywords": ["fish", "fishing", "pets", "multiplayer", "adventure"], "long_description": "\ud83c\udfa3 **Catch crazy fish, ride creature boats and take on giant bosses with your friends,!**\n\nGrab your rod, jump on your boat and see what's biting!\n\n### \ud83d\udc1f Creatures that fight\nWhen the fish rests, **REEL IT IN!** When it fights, **SLOW DOWN!** Don't let it get away!\n{1143335128070810}\n\n### \ud83c\udf1f Catch them all\nEvery water has its own fish, from teeny tiny to crazy monsters. Fill your booklet and show off your biggest catch!\n{1045757075166259}\n\n### \ud83e\udd80 GIANT catches\nTeam up with your lobby to battle huge bosses. Hook their weak spots, knock off their armor and reel them in together!\n{1525474496015407}\n\n### \ud83c\udf0a Explore new waters\nSail to the 25 different areas in the world. \n{1131884519284406}\n\n### \u2728 Epic rods\nLevel up from a simple pole to rods that sparkle, glow and blaze. Every upgrade unlocks stronger rods that catch bigger fish!\n{918211451148000}\n\n### \ud83d\udc09 Ride creature boats\nSteer creature boats with, make them faster and bring friends aboard. Pick your favorite skin, saddle and reins. On land, your boat shrinks and follows you like a pet!\n{2910363825994606}\n\n**Grab your friends and let's go fishing!** \ud83c\udfa3", "short_description": "Grab your rod and your friends! Reel is a VR fishing adventure where every bite is a battle. \n\nCatch crazy fish from teeny tiny to crazy monsters, ride creature boats, and team up with your lobby to reel in giant bosses. \n\nExplore glowing reefs, stormy islands and the mysterious Outer Waters, level up epic rods that sparkle, and show off your biggest catches!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
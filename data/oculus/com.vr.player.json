ss=7f20f&oh=00_AQLuuO5mvHd_yPuk4aIA4R0JFKrXi-6m92eJBcWsHbvamw&oe=6AABDC49"}, {"file_name": "2.png", "id": "1379690224166239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_1379690227499572_8369152166503235029_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQi6PuTslQcQ7kNvwHzzh1j&_nc_oc=Adp9BJwwZydauU-YSjknqqohvX3ex7LzJDfGJa1zjemyO46Ms8aYbEfTOJHa_1PrcUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiOt6X3j6_TMzZGtokxQdDBynbmT4vT-FxHQ_--0ZOyg&oe=6AABEDC0"}, {"file_name": "3.png", "id": "1361023465959928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311585_1361023469293261_1206350505642553492_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m1EhR1xLy0Q7kNvwH_4i5G&_nc_oc=AdrnBu8UeJUFRUhn3-VDuR-ZtCt6eLYW61Hngx5XzpH9wHtWb7qruC7NtptAZfsyYgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInYoeZeAYsiwhohFGbRaGC43nbSo4mhmdK5Vu780dg4A&oe=6AAC0FD1"}, {"file_name": "4.png", "id": "1419441870023360", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1419441873356693_1211799693030602685_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_7k2d7nZCEQ7kNvwFbgpoU&_nc_oc=AdpCjXFxPHlpX83Ik59pyCEWWHjL3b33-KS-ttKqDE26VbZJvNSjR4QLZCTlgGIiLg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnPiFhBUmNslFgq2LkBtfEXkYRzyUNyXC61G16wGGXVw&oe=6AAC01C7"}, {"file_name": "5.png", "id": "1056275750057940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1056275753391273_6255677838839533353_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n726jkt-UxMQ7kNvwF-7bcu&_nc_oc=Adrx3T5CAYjvmjEGMmNAt2leW9WNLouz21MxlxH8XLWONpBDLTcegRegqg_Ls-S7yaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx69F7oYR3-JTrZOWOrXkPrQG6rwMojv3jEqZxeTNexw&oe=6AABF4CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": ["cinema", "immersive", "player", "video", "VR180"], "long_description": "Vertex VR Video Player \u2014 a powerful VR video player for Meta Quest.\n\nProjection: Flat (cinema-style, adjustable curvature), 180\u00b0/360\u00b0 sphere, EAC (YouTube 360)\nStereo: SBS, Top-Bottom, Mono, SBS Fisheye\n\nKey features:\n- 2D\u21923D Converter (BETA) \u2014 turn flat films into side-by-side 3D on-device, resumable, saved locally\n- HDR \u2014 automatic HDR10 / HLG tone-mapping to SDR\n- Play Multiple \u2014 up to 3 videos at once (flat stacked or 180\u00b0+Flat mixed, gaze-based audio)\n- Network (SMB) streaming \u2014 play straight from a NAS/PC; credentials stored encrypted on-device\n- Subtitles \u2014 embedded + external .srt/.vtt, adjustable size/position, head-locked in 180\u00b0/360\u00b0\n- Spatial audio \u2014 head-tracked ambisonic (FOA/SOA/TOA) to binaural, multichannel Opus\n- 9 color profiles: Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D, Mono, Cinema, SC\n- Auto refresh-rate match to video fps (judder-free)\n- Adjustable sharpness, clarity, brightness, contrast, saturation, gamma, warmth, depth\n- 4K/8K decoding, smooth buffered playback\n- Internal storage, USB OTG (NTFS), and SMB network playback\n- Auto-detects video type; VR menu with drag-to-pan and thumbstick zoom\n\nNo account required. Play offline from local storage/USB, or stream from your own network shares.\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n\ud83c\udfac JOIN OUR DISCORD \u2014 report bugs, request features, share feedback, chat with users:\n\ud83d\udc49 https://discord.gg/fT6vcTHXkG\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501", "short_description": "Vertex VR Video Player \u2014 high-quality VR player for Meta Quest. 2D\u21923D Converter (BETA): turn flat films into side-by-side 3D on-device. Plays 180\u00b0/360\u00b0 SBS/TB, flat & curved screen, EAC. Automatic HDR10/HLG tone-mapping. Play Multiple \u2014 up to 3 videos at once. Stream over your network (SMB) from a NAS/PC, plus internal storage & USB OTG (NTFS). Subtitles (embedded + .srt/.vtt, head-locked) and head-tracked spatial audio. 9 color profiles + auto refresh-rate match. Auto-detects video type."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28621114874155561"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_748684454786515_6217511722531383750_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11rNP2fo5BgQ7kNvwHI7RYE&_nc_oc=AdoUxBsgbLx_qgje1KLGWI4kYFi0PKMsO5MkAbpjVah9g8kuzCNiL0BuLFDNFEyeaI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBlmAFH0aysJzucXgxvTdPU66RTPZglFG7h4zkTWdwUQ&oe=6AABECC2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vertex VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1772909220, "lastRevision": {"nodes": [{"id": "2712529253040
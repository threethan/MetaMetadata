.com&_nc_ss=7f20f&oh=00_AQEdmsKryTwtxIBFI4BFz7w6bCg2-ELej0zS-VVTUasoVA&oe=6A881ECC"}, {"file_name": "vertex_hero_1008x1440.png", "id": "1213789760906481", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491831056_1213789764239814_6615265619450538653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX0F5ZKYV7IQ7kNvwHEAN_I&_nc_oc=AdrMHCa3oz1kbAojN-UZvs_0AzpMhvwP0ZuctcmvJd_kFwABUMHeqQKAE2VgSco_r34&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFdCJMQVZ5IkJ7AbuaWvpXUcGSoXOJE0Hq0Coj3dlhQw&oe=6A883899"}, {"file_name": "vertex_icon_512x512.png", "id": "892652083394328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821115_892652086727661_8471766470727081124_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXDAGlefxF0Q7kNvwEhNER6&_nc_oc=AdoxZ5bdJfQMOtJ7xZxAodhC7Yw-r1mVaZTx031Qk-c44pdI3MaCd3C2c5Z8EXVXOsM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg_uLuBBYBPryrwthw0QoQLA-4IXFa2rwQxbkU9ap10Q&oe=6A881EC4"}, {"file_name": "vertex_hero_1440x1440.png", "id": "748684451453182", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818849_748684454786515_6217511722531383750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02BV1NyrXQcQ7kNvwHSviCf&_nc_oc=AdpEXdaEszKkHtGUOuNewsHKtNFrtw-75JX1ROJ9GIYR4HWq4wycgW-9Vk6WIESWGK4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTiskRPcSavnP5WjoyV0T35XUAf3l1_gHzVA3W_co4YA&oe=6A881C02"}]}, "id": "26770367615883374", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1658145475543201", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823259_1658145482209867_195055074849590638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCD-gI0v9j4Q7kNvwE_5QvS&_nc_oc=Adqp1ua-XEqzYetK6nY9TPRP6QwvzJlsMNR0Zr77ZlfO-PZdWWxqhxenF0HkKJWpKc4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI-bnVO3RwxjVYvJtV3aePp6NlkiSo-14Zx-KlC4FS8A&oe=6A882CD3"}, {"file_name": "3.png", "id": "2429594607542192", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823286_2429594610875525_7380236625496725701_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtsXPdOxOLAQ7kNvwHuaotL&_nc_oc=AdrZds_f2MHgXFXjRSpZrBJLWGly1zjcX1XxgBOO1rjQOPKSHnclOf0sACKYdQiVfjw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNMZQoEOh8_hC0cGmZOmy6U4tuY-cPrFygDeMv6y3gkg&oe=6A88419E"}, {"file_name": "4.png", "id": "877756725089612", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818860_877756728422945_305704471306386766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHaqZUYDe3MQ7kNvwGar5Vx&_nc_oc=AdrCrOvnkMQkJDWiPEiI-JfOTcxBo4omfSzrJvK5BVxwcXi6ttG6Sm61VagqR5oFPSU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx4Awr_iTB-wF6y560ISMs0r05LwHbJJCclGscWJUB9A&oe=6A884459"}, {"file_name": "5.png", "id": "862412696831084", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821725_862412700164417_4630813560218885361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72FMFhaDaHoQ7kNvwETsMmA&_nc_oc=AdqlZ4uNq9xK3ARfk3b1Rcd7FQm7RDlil5kQ7C7jSZ9h-Xky33xB6AtSXsfLEZ6ohBY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh3h9tMmpMKbv8JCEQyy-on-ZVsCf_uB7vvDmlhGnMdg&oe=6A884D4E"}, {"file_name": "6.png", "id": "923637530158794", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820855_923637533492127_5988481766482833666_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkxzWkd0aqQQ7kNvwGlmaxs&_nc_oc=AdqNXmxOj2R1mMYbM9P1k9tz0VQCuvx5rzImhkZcFPHOMJM2TwPTP3gfVgLNG0sqF_Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWvJ-12LC3xkHNNsqumBTWkie2JYJwn9BAHF3YxvB8ug&oe=6A881E39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": " Vertex VR Video Player is a lightweight yet powerful VR video player designed for Meta Quest. It supports a wide range of video formats and projection types, including:\n\n  Projection modes:\n  - Flat screen (cinema-style virtual screen)\n  - 180\u00b0 and 360\u00b0 sphere projection\n  - Equi-Angular Cubemap (EAC) \u2014 compatible with videos downloaded from YouTube\n\n  Stereo formats:\n  - Side-by-Side (SBS) \u2014 half and full width\n  - Top-Bottom (TB) \u2014 half and full height\n  - Mono\n  - SBS Fisheye (equidistant projection)\n\n  Key features:\n  - High-quality rendering with bicubic upscaling, sRGB-correct color pipeline, and anti-banding dithering\n  - Multiple color profiles (Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D)\n  - Adjustable video enhancement settings: sharpness, clarity, brightness, contrast, saturation, gamma, warmth, and depth effect\n  - Smooth playback mode with optimized buffering for stutter-free viewing\n  - Support for 4K and 8K video decoding\n  - Playback from internal storage and USB OTG devices (flash drives, microSD card readers, external HDDs via NTFS)\n  - Automatic detection of video type (180\u00b0/360\u00b0, SBS/TB) based on filename and resolution\n  - Intuitive VR menu with controller interaction \u2014 drag to pan, thumbstick to zoom\n  - Mirror mode, eye swap, and IPD offset adjustments\n\n  The app focuses on delivering the best possible video quality and smoothness while keeping the interface simple and easy to use. No account required, no internet connection needed \u2014 just load your videos and play.\n{1677380656960522}\n{1881898025800384}\n{1286088660090195}\n{1510923663604622}\n{2300424457109437}\n{1308594671284908}", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features bicubic upscaling, sRGB-correct colors, adjustable sharpness, clarity, contrast, saturation, and multiple color\n  profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27125292510404479"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "790545066825215"}]}, "baseline_offer": {"id": "790545066825215"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772909220, "status": "PUBLISHED", "id": "790545066825215"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29038113449122366", "version": "3.9.6"}, "id": "1252765963588051", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038113449122366"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "- New GRID mode in Multi\n- The browser can now show films as a list or a compact list instead of the thumbnail grid\n- Recent now covers every source\n- Recent has a Clear button\n- Manual HDR handling on the right panel\n- Passthrough has proper sliders on the left panel\n- The joystick seek step is adjustable in the right panel\n- Height now works with Wrap-around\n- Side panels sit on the sphere\n- Multi starts its films one at a time instead of all at once\n- A film that fails to start no longer keeps the whole wall waiting on it\n- The converter header is a single line again with a square button that opens the rest of the notice on demand", "created_date": 1786044261, "id": "29038113449122366", "version": "3.9.6", "version_code": 60, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038113449122366"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "- 3 x Mode: flat multi-view arranged in columns of three, with a picker for 6, 9, 12 or 15 films\n- Compact pick strip and a \"picked x / y\" counter for counts above three, so fifteen slots fit the panel\n- Four wall layouts for multi: Standard, Fit to sphere, Curvature and Surround, switchable from the right panel\n- The wall layout heading blinks a few times whenever the menu opens, so the section is noticed\n- Player UI scaling from 25 to 150 percent, adjustable panel opacity, and a choice between the full menu and the bar alone, with two buttons on the bar to open the side panels\n- Reset button on every slider in the side panels\n- The bottom-bar seek slider can be grabbed with the trigger and steered with the joystick, like the other sliders\n- Grip plus trigger moves the whole player UI, and it stays where you put it for the session\n- Joystick modes: Standard, and Extended where the stick alone only seeks and zoom or height need the stick pressed in\n- Passthrough button redesigned: the eye icon is shown in both states and crossed out when passthrough is on, replacing a dot that said nothing\n- Holding the passthrough button turns it into a brightness control, with the pill filling to show the level\n- Passthrough brightness range widened well beyond what layer opacity alone can reach\n- Multi-mode audio follows the film you are looking at for any film count; it was hand-written for two and three films, so every larger wall stayed stuck on the first film\n- Sorting by type and length fixed on USB drives and network shares, where the film type could not be read at all and flat and 3D came out mixed\n- Sorting is live: the list re-orders as information arrives, with no waiting and no message\n- Films whose type or length is not yet known sort last in both directions instead of masquerading as flat, and folders always stay on top\n- grabbing the seek dot\n- The same fixed UI everywhere: one position and one size for every single film, 2D or 3D, flat or 180/360, and for the multi wall as well, with zoom no longer moving or resizing it\n- The bottom bar sits lower than the side panels\n- Bar tilt is derived from where the bar actually ended up rather than from how far something was dragged, removing both the dead zone at the start of a drag and the weak tilt down low\n- A parked menu tilts by its own angle, so dragging it up or down turns it toward you\n- Height slider disabled for 3D and spherical video, where shifting the scene vertically is meaningless, and the offset is zeroed for those films\n- Wrap-around disabled in multi mode\n- Fit to sphere is now the default wall, with the former Standard still available as \"Old\"\n- Fixed: tiles overlapped when films had different aspect ratios, because spacing was sized from the first film instead of the widest and tallest\n- Fixed: tiles overlapped after switching wall modes and back, because a tile whose parameters happened to match kept the previous mode's geometry\n- The multi film grid shows flat films only, with a small toggle beside the thumbnails to show everything\n- A picked set can be saved as a playlist, which reopens as a wall with the same films and layout\n- Multi picks are cleared when the source changes, instead of carrying films over from the previous source\n- Fixed: advancing to the next group repeated films that were already on screen\n- The 3 x Mode button lights up in a different colour so it is not confused with the filter beside it\n- Folder listings and film information are cached per folder for USB and for every network protocol, so a folder opened before comes up instantly and sorting answers immediately\n- The cache is verified against the drive or the server by name and size, anything changed is read again, and information about unchanged files is carried over\n- Sorting by type and length now works while browsing folders, not only in the all-films view\n- Fixed: a failed read was remembered, so one bad read made that file unreadable for the rest of the session\n- Fixed: the cache write rode on the same task as the read, so any interruption threw away everything just read\n- Live progress on the sort button and on the multi counter while film information is being read\n- Reading is prioritised for what is on screen and continues underneath while you are not scrolling\n- Changing the sort always jumps back to the top of the list\n- Thumbnails pre-warm in the background for every source, not only USB\n- Thumbnails are taken from 60 seconds into the film instead of 20, so intros and loading screens are skipped\n- The converter's flat-only list works immediately instead of only after a detour through sorting\n- The Network dialog is split into SAVED and NETWORK, so a saved connection is not mistaken for another menu entry\n- Settings sections reordered\n- New maintenance section with Clear cache, covering thumbnails and saved listings for every source, and Restore default set\n- Fixed: exiting with the Exit button could leave you watching the system home environment load\n- Fixed: pressing Back within the first moment of playback left the immersive session alive and dropped you into the system home environment instead of the app", "created_date": 1785876085, "id": "29012461231687588", "version": "3.9.5", "version_code": 59, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038113449122366"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785782288, "id": "28998753863058325", "version": "3.9.1", "version_code": 58, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038113449122366"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785777270, "id": "28998041156462929", "version": "3.9.0", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038113449122366"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "3.8.0: full network parity \u2014 convert, multi-play and playlists now work from WebDAV/FTP/SFTP/DLNA; WebDAV playback fixed on servers that don't report file size; thumbnails no longer stall halfway; each saved server keeps its own connection; saved servers can be edited/renamed", "created_date": 1784931000, "id": "28883897994543913", "version": "3.8.0", "version_code": 56, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
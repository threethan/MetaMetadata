DDlLNdGrkXjXGV1xEKQ&oe=6A5F8693"}, {"file_name": "3.png", "id": "2429594607542192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_2429594610875525_7380236625496725701_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhHsgW5v_mYQ7kNvwEA9IgX&_nc_oc=AdphybBTuZbSs7ZFNpn5gdKCzf_DwT6pOLPhuHvJmE-HKjfTyfZiITv2XjnQ5UaeU6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0ZqPyQNSWVgh1KF1GKVHiso7umfcy--YPL3_JTpFtAw&oe=6A5F631E"}, {"file_name": "4.png", "id": "877756725089612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_877756728422945_305704471306386766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziWU-AWzywgQ7kNvwHxDRTF&_nc_oc=AdpUhI4UPa9F2p_yOxj8Bqg8Vm3PQzspaK76rQ1XxIbIochYnhGgPAaBjbM4Ta-JKxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8xpHEAwCQ0FPrq31zF6ErEtGbf98jmO3HX3Pn_dmQUg&oe=6A5F65D9"}, {"file_name": "5.png", "id": "862412696831084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821725_862412700164417_4630813560218885361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBsssgkG6WkQ7kNvwFNMOd2&_nc_oc=Adr5k6R_y7ZzUPwtVG_thmyShmGW5FGXsGg0i9zvjO5SQFbxulzpBKTqC5IVDffmSbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk9iwqXghI2tuFv8oJcz89s7FuQV1mldbqzwu-hI-4IQ&oe=6A5F6ECE"}, {"file_name": "6.png", "id": "923637530158794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_923637533492127_5988481766482833666_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfyTvNHqsTMQ7kNvwF_EYBH&_nc_oc=AdoBVP-NURFVr-3efwAfZGne7shXhTgsbYLbSOy2LEDkc22yEyPxdUOYxUuQwyDe1iQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACHBI32drlZ57M2fSbC0MD2XIikqdWGB_-sTbnIOzICw&oe=6A5F77F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": " Vertex VR Video Player is a lightweight yet powerful VR video player designed for Meta Quest. It supports a wide range of video formats and projection types, including:\n\n  Projection modes:\n  - Flat screen (cinema-style virtual screen)\n  - 180\u00b0 and 360\u00b0 sphere projection\n  - Equi-Angular Cubemap (EAC) \u2014 compatible with videos downloaded from YouTube\n\n  Stereo formats:\n  - Side-by-Side (SBS) \u2014 half and full width\n  - Top-Bottom (TB) \u2014 half and full height\n  - Mono\n  - SBS Fisheye (equidistant projection)\n\n  Key features:\n  - High-quality rendering with bicubic upscaling, sRGB-correct color pipeline, and anti-banding dithering\n  - Multiple color profiles (Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D)\n  - Adjustable video enhancement settings: sharpness, clarity, brightness, contrast, saturation, gamma, warmth, and depth effect\n  - Smooth playback mode with optimized buffering for stutter-free viewing\n  - Support for 4K and 8K video decoding\n  - Playback from internal storage and USB OTG devices (flash drives, microSD card readers, external HDDs via NTFS)\n  - Automatic detection of video type (180\u00b0/360\u00b0, SBS/TB) based on filename and resolution\n  - Intuitive VR menu with controller interaction \u2014 drag to pan, thumbstick to zoom\n  - Mirror mode, eye swap, and IPD offset adjustments\n\n  The app focuses on delivering the best possible video quality and smoothness while keeping the interface simple and easy to use. No account required, no internet connection needed \u2014 just load your videos and play.\n{1677380656960522}\n{1881898025800384}\n{1286088660090195}\n{1510923663604622}\n{2300424457109437}\n{1308594671284908}", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features bicubic upscaling, sRGB-correct colors, adjustable sharpness, clarity, contrast, saturation, and multiple color\n  profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27125292510404479"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "790545066825215"}]}, "baseline_offer": {"id": "790545066825215"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772909220, "status": "PUBLISHED", "id": "790545066825215"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28790674927199554", "version": "3.5.8"}, "id": "1252765963588051", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28790674927199554"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "Video list now appears while it scans: no per-file metadata read and no sort before the first film is shown. Sorting is on demand (no default) and reorders what is already on screen instead of re-scanning.", "created_date": 1784252902, "id": "28790674927199554", "version": "3.5.8", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28790674927199554"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "VR180 fisheye videos are now detected automatically. Fisheye and equirectangular VR180 are packed exactly the same way, so the video's shape cannot tell them apart, and many libraries have neither a helpful filename nor any VR metadata. Vertex now looks at the picture itself: a fisheye lens leaves the corners of each eye empty, which is unmistakable. Such videos are recognised as 180 FE and rendered with the correct geometry instead of being stretched as equirectangular. A filename that already says what the video is still takes priority, and ordinary videos are unaffected. Returning from a video to the library should also be a little quicker.", "created_date": 1784247291, "id": "28790011890599191", "version": "3.5.7", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28790674927199554"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784245683, "id": "28789817930618587", "version": "3.5.6", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28790674927199554"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784244122, "id": "28789653303968383", "version": "3.5.5", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28790674927199554"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784240198, "id": "28789228857344161", "version": "3.5.4", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
mPCUPI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Nx7hxjrhq4boBhK_PZw9Zz66_36QMFxlskT07uxmPaA&oe=6A3AB9D9"}, {"file_name": "3.png", "id": "872813219112175", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_872813225778841_3661472932447963999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BomoinMnTCsQ7kNvwFpOrT8&_nc_oc=AdovmbEcDhy_jfHuEI1oRfHn3P0vT4Fe40gheUPzG5rkaZ3uVEG5x5G_arBmHBQEAvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lqa4JubADEahSG5uOdr7bhcmQ_2vVshrT7zWcOSwdPQ&oe=6A3AB630"}, {"file_name": "4.png", "id": "1648504833067981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491826562_1648504836401314_4031288925258440272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpdmgrlEx00Q7kNvwFqH0Xz&_nc_oc=AdpArMlw0AZQnjMe6jvkIR96d727hhow8kNpDCUdrMnFI7ShvdAX5DL-yzbmtgo_ueg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90UGkdkUHbZ1s69aZNsrYGsGQrKdkeU1JM6-GolOx3Bg&oe=6A3AAC2C"}, {"file_name": "5.png", "id": "1998057247770557", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_1998057251103890_6734443308877946811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZT0IAoDZWkQ7kNvwExEPUR&_nc_oc=Ado0K9J8HgcK1TJlqOp5607o-w4nr4dYzJnmHefgW6caZQMR5HxcwfSxwMGWhIatFyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G-uyXQ4Rtq25ch1SCg1AVPTxaaUfc675wgmzS7-i-0w&oe=6A3A8F41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": "Vertex VR Video Player \u2014 a powerful VR video player for Meta Quest.\n\n  Projection modes:\n  - Flat screen (cinema-style)\n  - 180\u00b0 and 360\u00b0 sphere\n  - EAC (YouTube 360)\n\n  Stereo: SBS, Top-Bottom, Mono, SBS Fisheye\n\n  Key features:\n  - Play Multiple \u2014 watch up to 3 videos simultaneously. Flat stacked mode or 180\u00b0+Flat mixed mode with gaze-based audio switching\n  - CAS (Contrast Adaptive Sharpening) with sRGB-correct color pipeline\n  - 6 color profiles: Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D\n  - Adjustable sharpness, clarity, brightness, contrast, saturation, gamma, warmth, depth effect\n  - Smooth playback with optimized buffering\n  - 4K and 8K video decoding\n  - Internal storage and USB OTG (NTFS) playback\n  - Auto-detection of video type from filename and resolution\n  - VR menu with drag to pan, thumbstick to zoom\n  - Synchronized multi-video controls\n  - Mirror mode, eye swap, passthrough background\n\n  No account required, no internet needed \u2014 just load and play.\n  \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n  \ud83c\udfac JOIN OUR DISCORD COMMUNITY\n\n  \u2022 Report bugs\n  \u2022 Request features\n  \u2022 Share feedback\n  \u2022 Chat with other users\n\n  \ud83d\udc49 https://discord.gg/fT6vcTHXkG\n\n  \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features Play Multiple \u2014 watch up to 3 videos simultaneously. CAS adaptive sharpening, sRGB-correct colors, adjustable\n  sharpness, clarity, contrast, saturation, and multiple color profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MO
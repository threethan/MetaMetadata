2", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_748684454786515_6217511722531383750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_COoBaDpIIQ7kNvwExlYbW&_nc_oc=Adrc3j4JOff5LK2PMcsyg8odztPngrfKDn_b7aFjEcw2JpfRpb7R8ZsKxyra8-SLFWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fh_KDt9q8lMwu_8LQQXKg0NPyWpLTEFLL1pYP-p8HwA&oe=6A05CFC2"}]}, "id": "26770367615883374", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1658145475543201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1658145482209867_195055074849590638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubqxjqsbvEUQ7kNvwFh9Rmu&_nc_oc=AdpJEzO4-5X2XICaS-W_4OEy9oY0FLWKNS1BIzKqV-zrIeCvXhS7XQ5K9kvwuG7pnnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af594BfWuuXBHm8k7msBM5ofTezlB9SVwj4D59f0m54UTw&oe=6A05E093"}, {"file_name": "3.png", "id": "2429594607542192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_2429594610875525_7380236625496725701_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPd6z7K6czoQ7kNvwHgK2wK&_nc_oc=AdrEVwe_95Y2ctt9xmgDx_LdobIJyi020fU50ecsMte7cwtz8LLhVki5ViNvFfB7mNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eDycJzz6ABkjKoY5IqcP3w203ZC9TffqPrW9iOz2ZLA&oe=6A05BD1E"}, {"file_name": "4.png", "id": "877756725089612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_877756728422945_305704471306386766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI9nrAhgw2gQ7kNvwFYQcQo&_nc_oc=AdpsuxH_FMdI1TI1SpHkQ222Dp_2QuiBOmmDJtCEZ8B9yc83pPL5b4aBVV9si-UOg4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I05NUNoMCpwaKLt3RjEAALXJT3DzwQZR8FG1D8MkCNQ&oe=6A05BFD9"}, {"file_name": "5.png", "id": "862412696831084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_862412700164417_4630813560218885361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_bx7wwyqWoQ7kNvwHT9iHC&_nc_oc=AdqLKvY1F8nf1efHn6c0R1ORGvhRHWlc8ZEZPA0Qlc1kCBsUq0cNgqVm_Fya2Qc2ADs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pb6V81NFVlJ1qdE5h3jABiq42qzJ-uyyjO4ZiDSYrjg&oe=6A05C8CE"}, {"file_name": "6.png", "id": "923637530158794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_923637533492127_5988481766482833666_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACp4ePd08D8Q7kNvwESTHKW&_nc_oc=AdpL5bpufVqd1TG0R-fHBx6ObztzMcqqlCkt7uEkc2PejnvDWaXx6trQbMbxx0Ww38A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OZMCq7xUjVfYn9gHnlH5xB2ZR8gSRBiKvu-pxXh8kMw&oe=6A05D1F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": " Vertex VR Video Player is a lightweight yet powerful VR video player designed for Meta Quest. It supports a wide range of video formats and projection types, including:\n\n  Projection modes:\n  - Flat screen (cinema-style virtual screen)\n  - 180\u00b0 and 360\u00b0 sphere projection\n  - Equi-Angular Cubemap (EAC) \u2014 compatible with videos downloaded from YouTube\n\n  Stereo formats:\n  - Side-by-Side (SBS) \u2014 half and full width\n  - Top-Bottom (TB) \u2014 half and full height\n  - Mono\n  - SBS Fisheye (equidistant projection)\n\n  Key features:\n  - High-quality rendering with bicubic upscaling, sRGB-correct color pipeline, and anti-banding dithering\n  - Multiple color profiles (Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D)\n  - Adjustable video enhancement settings: sharpness, clarity, brightness, contrast, saturation, gamma, warmth, and depth effect\n  - Smooth playback mode with optimized buffering for stutter-free viewing\n  - Support for 4K and 8K video decoding\n  - Playback from internal storage and USB OTG devices (flash drives, microSD card readers, external HDDs via NTFS)\n  - Automatic detection of video type (180\u00b0/360\u00b0, SBS/TB) based on filename and resolution\n  - Intuitive VR menu with controller interaction \u2014 drag to pan, thumbstick to zoom\n  - Mirror mode, eye swap, and IPD offset adjustments\n\n  The app focuses on delivering the best possible video quality and smoothness while keeping the interface simple and easy to use. No account required, no internet connection needed \u2014 just load your videos and play.\n{1677380656960522}\n{1881898025800384}\n{1286088660090195}\n{1510923663604622}\n{2300424457109437}\n{1308594671284908}", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features bicubic upscaling, sRGB-correct colors, adjustable sharpness, clarity, contrast, saturation, and multiple color\n  profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27125292510404479"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "790545066825215"}]}, "baseline_offer": {"id": "790545066825215"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772909220, "status": "PUBLISHED", "id": "790545066825215"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27935347749398947", "version": "2.3"}, "id": "1252765963588051", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27935347749398947"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "What's New in 2.3\n\nImage Quality\n- Mirror mode fixed for 3D SBS content - eyes are now properly swapped, so stereo depth is no longer inverted when mirroring\n\nPerformance\n- Multi-video mode: optimized buffer allocation - the primary 3D SBS video gets a larger buffer, the two flat videos get smaller buffers. Less heap pressure overall and the SBS stream no longer stutters\n\nFixes\n- Exiting Settings: tabs and sort buttons now properly restore when switching directly from Settings to Internal Memory or USB OTG\n\nPreviously in 2.2\n\nImage Quality\n- Adaptive video filtering: Catmull-Rom bicubic for upscaling, multi-tap box filter for downscaling - noticeably sharper 4K SBS, less aliasing on 8K SBS\n- 16x anisotropic filtering for crisp 180/360 sphere edges\n- 2x MSAA anti-aliasing on geometry and menu edges\n\nRefresh Rate\n- New Refresh Rate setting (72/80/90/120 Hz) - options adapt to your Quest device\n- Default is now 120 Hz on supported devices\n- Live refresh rate indicator shown in the bottom bar\n\nSettings\n- Player settings (CAS, color, mirror, swap eyes, smooth, etc.) now persist between videos and sessions\n- New 'Remember Settings' Yes/No toggle\n- Cleaner Settings view - tabs/sort/search hidden while adjusting preferences\n\nFixes\n- Thumbnails resume loading after returning from playback\n- No more false 'No USB device detected' message when quickly switching sources\n- Refresh rate no longer resets to 72 Hz after session start", "created_date": 1778270840, "id": "27935347749398947", "version": "2.3", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27935347749398947"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "What's New in 2.2\n\nImage Quality\n- Adaptive video filtering: Catmull-Rom bicubic for upscaling, multi-tap box filter for downscaling - noticeably sharper 4K SBS, less aliasing on 8K SBS\n- 16x anisotropic filtering for crisp 180/360 sphere edges\n- 2x MSAA anti-aliasing on geometry and menu edges\n\nRefresh Rate\n- New Refresh Rate setting (72/80/90/120 Hz) - options adapt to your Quest device\n- Default is now 120 Hz on supported devices\n- Live refresh rate indicator shown in the bottom bar\n\nSettings\n- Player settings (CAS, color, mirror, swap eyes, smooth, etc.) now persist between videos and sessions\n- New 'Remember Settings' Yes/No toggle\n- Cleaner Settings view - tabs/sort/search hidden while adjusting preferences\n\nFixes\n- Thumbnails resume loading after returning from playback\n- No more false 'No USB device detected' message when quickly switching sources\n- Refresh rate no longer resets to 72 Hz after session start", "created_date": 1778268724, "id": "279350453
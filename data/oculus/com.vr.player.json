2", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818849_748684454786515_6217511722531383750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8EtsbH7iN4Q7kNvwH4E3bU&_nc_oc=Adr859zLXvBN_XzqIqD7MMXDfGHYZBxPW_Hi_2CegHAjJbJ_vpMdRBLnkJH3LWPPdiw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3C77OKgdEAbvk3ZZTgPI_8SQK_J-dLmpRI-ZYiL2aRow&oe=69DCF142"}]}, "id": "26770367615883374", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1658145475543201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1658145482209867_195055074849590638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxAVMk7tnNYQ7kNvwHXeEQT&_nc_oc=AdrsigsEdE-CE2e45yH0FxHhqtjaflH4VtllfjS-OPaZrVuj9cfMrCaVB6Zd-93DLLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PHJs50ZizsfPoF3WuJFcDHR99E88Yl801m-2YtlU3ig&oe=69DD0213"}, {"file_name": "3.png", "id": "2429594607542192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_2429594610875525_7380236625496725701_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq3I5Ya30owQ7kNvwGAdK8r&_nc_oc=AdrZ587B4fP5DWnL6l_fqRY_9gl5tefzyDeOEVwW4bOLSG4yhWyvnrqS28uMx_g03fE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LmBLPQ-ooS-lmSEGsv0GKNagyOJsPWmwxRDIxWaqtKg&oe=69DCDE9E"}, {"file_name": "4.png", "id": "877756725089612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_877756728422945_305704471306386766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtD-5U_Yu7gQ7kNvwHyIyd6&_nc_oc=AdoayGjnasfj5AUiMqrKHS-s3V7TpnDApOsOJJwnbOEoEWNY3NpXjHGGq-3vth1sc9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KeWG2uNm9tlK6ISfPCGhgVztE6hmmPhYe6WjZGlKw0A&oe=69DCE159"}, {"file_name": "5.png", "id": "862412696831084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821725_862412700164417_4630813560218885361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYHFX_Fm_qgQ7kNvwGQcfPa&_nc_oc=AdpYH7kI4MNpN7yDSmHbJIQ8gOFGqW3UNKBu7zzdbIF5GVQBlMQY6-GK2fl7YmQhSJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33ET5Wz0uduChnmTTdEZ9H9QfV_qATWhXC698jnaP8xA&oe=69DCEA4E"}, {"file_name": "6.png", "id": "923637530158794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_923637533492127_5988481766482833666_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCoI69T77_4Q7kNvwHkbrxa&_nc_oc=Adox9XtAzGhIinIlngMmu6hMHH08c0N08o2mHTqxRE5_G6nJh4KN8PYQDscu8A-Q1eM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YRWs80c4Xt0XyZiE9yMlGu4fU9kcIbWKp2Vrlwz9bkg&oe=69DCF379"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": " Vertex VR Video Player is a lightweight yet powerful VR video player designed for Meta Quest. It supports a wide range of video formats and projection types, including:\n\n  Projection modes:\n  - Flat screen (cinema-style virtual screen)\n  - 180\u00b0 and 360\u00b0 sphere projection\n  - Equi-Angular Cubemap (EAC) \u2014 compatible with videos downloaded from YouTube\n\n  Stereo formats:\n  - Side-by-Side (SBS) \u2014 half and full width\n  - Top-Bottom (TB) \u2014 half and full height\n  - Mono\n  - SBS Fisheye (equidistant projection)\n\n  Key features:\n  - High-quality rendering with bicubic upscaling, sRGB-correct color pipeline, and anti-banding dithering\n  - Multiple color profiles (Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D)\n  - Adjustable video enhancement settings: sharpness, clarity, brightness, contrast, saturation, gamma, warmth, and depth effect\n  - Smooth playback mode with optimized buffering for stutter-free viewing\n  - Support for 4K and 8K video decoding\n  - Playback from internal storage and USB OTG devices (flash drives, microSD card readers, external HDDs via NTFS)\n  - Automatic detection of video type (180\u00b0/360\u00b0, SBS/TB) based on filename and resolution\n  - Intuitive VR menu with controller interaction \u2014 drag to pan, thumbstick to zoom\n  - Mirror mode, eye swap, and IPD offset adjustments\n\n  The app focuses on delivering the best possible video quality and smoothness while keeping the interface simple and easy to use. No account required, no internet connection needed \u2014 just load your videos and play.\n{1677380656960522}\n{1881898025800384}\n{1286088660090195}\n{1510923663604622}\n{2300424457109437}\n{1308594671284908}", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features bicubic upscaling, sRGB-correct colors, adjustable sharpness, clarity, contrast, saturation, and multiple color\n  profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27125292510404479"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "790545066825215"}]}, "baseline_offer": 
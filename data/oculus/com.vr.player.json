m&_nc_ss=7f20f&oh=00_AQSZBvp8waPgXLb1_sy-fngMitmDvKE0lUr4wdGpt3OJhg&oe=6AEB34C2"}]}, "id": "1912376586795990", "locale": "en_US", "screenshots": [{"file_name": "browser_grid.png", "id": "977704557913941", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_977704561247274_5806311477141532168_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOmzI_2RJM8Q7kNvwEtAW5e&_nc_oc=Adq88iJy-xgkuCBPVVOAo3FjbnVrmd2lXaNshpalo0KjOCjqgPF1o1PP9blgQnBWsoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ74MtRofUTAf_Bz4wL3FkU1o_jaE5RzVMvoa28afgDPQ&oe=6AEB5817"}, {"file_name": "2.png", "id": "1130237529434855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823910_1130237532768188_8193537585256718830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXBrAPDLuQQQ7kNvwEZYuoe&_nc_oc=AdrsZGu5_XOmT6IHSTghHk4trNVlM3g8wNWOFGwaMyjCQGp_GIu769Osibk5nUeypNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_0po_U3k9RVFvFsMgZypW6lwls9nhLBYxyI0RxGuI1w&oe=6AEB55C8"}, {"file_name": "3_enhance.png", "id": "3152867271578473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_3152867274911806_3776317159425741564_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze7m26qZiB8Q7kNvwHi-wFK&_nc_oc=AdoKtTiDlabSvL8wHcxd9QTgAAQbDwSlndNBenXcuKVnwWB9VZSir6eMNzRwA3hfAqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIYgeo_JejIFL9qIXrN3DAWmPPpdFHyOUHYGh-kljBXA&oe=6AEB30AF"}, {"file_name": "4_projection.png", "id": "1102957108761882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1102957112095215_5167187870890967925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npkYKSzcTDoQ7kNvwHrCnwx&_nc_oc=Adpo0uvqSccIG469eMvoiiO5jhOTCst8eB_vnhUdD2yfHk0Kcc6qmyvlzK47JLohWis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMLgrO9n_YVFxLYuiOkrIBQGehmkz_zLz3NU3qpwF_OQ&oe=6AEB5C83"}, {"file_name": "5.png", "id": "1056275750057940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1056275753391273_6255677838839533353_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXT3Sj84OFsQ7kNvwH21K4d&_nc_oc=Adr8jJp_AyWsfRiLmqIOp_WltglslUeX669kpFXwz_3d833qOiYMPlKH8eOOLf1qDtQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0LoDkbQhrlq4qno67Ol5E9mchP95hAxtIscNh1G-k-w&oe=6AEB3CCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": ["video", "player", "media", "USB", "360"], "long_description": "Vertex VR Video Player \u2014 a powerful VR video player for Meta Quest.\n\nProjection: Flat (curved, resizable, aspect ratios, wrap-around), 180\u00b0/360\u00b0 sphere\nStereo: Mono, SBS, Top-Bottom, Fisheye, EAC (YouTube 360) \u2014 format detected automatically\n\nKey features:\n- Play Multi \u2014 up to 15 videos at once on Quest 3; flat wall, 180\u00b0+Flat or grid; mix films from storage, USB and network; gaze-based audio\n- 2D\u21923D Converter (BETA) \u2014 turn flat films into side-by-side 3D on-device; resume unfinished conversions\n- Network streaming \u2014 SMB, WebDAV, FTP, SFTP and DLNA; credentials encrypted on-device\n- HDR10 / HLG \u2014 automatic tone-mapping with manual override\n- Subtitles \u2014 embedded + external .srt/.vtt/.ass, adjustable size and position, head-locked in 180\u00b0/360\u00b0\n- Spatial audio \u2014 head-tracked ambisonic (FOA/SOA/TOA) to binaural, multichannel Opus\n- 9 color profiles; saturation, gamma, clarity, brightness, sharpness, 3D depth\n- Refresh rate up to 207 Hz on Quest 3\n- 4K/8K decoding, Blu-ray .m2ts, playlists, resume where you left off\n- Passthrough, scene opacity, mirror and swap eyes\n- Internal storage, USB OTG (including NTFS) and network playback\n- Drag video or UI, thumbstick zoom and seek\n\nNo account required. Play offline from local storage/USB, or stream from your own network shares.\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n\ud83c\udfac JOIN OUR DISCORD \u2014 report bugs, request features, share feedback, chat with users:\n\ud83d\udc49 https://discord.gg/fT6vcTHXkG\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n", "short_description": "Vertex VR Video Player \u2014 high-quality VR player for Meta Quest. Plays flat, 180\u00b0 and 360\u00b0 video: SBS, Top-Bottom, Fisheye, EAC, with the format detected automatically. Play Multi: up to 15 videos at once on Quest 3. 2D\u21923D Converter (BETA) turns flat films into 3D on-device. Stream from your NAS/PC over SMB, WebDAV, FTP, SFTP or DLNA, or play from internal storage and USB (incl. NTFS). HDR10/HLG tone-mapping, subtitles, head-tracked spatial audio, 9 color profiles, up to 207 Hz on Quest 3.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": "https://discord.gg/QuA3ne55F", "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30000737002860001"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_748684454786515_6217511722531383750_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_
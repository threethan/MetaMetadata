ng", "id": "1213789760906481", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831056_1213789764239814_6615265619450538653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbw7apiS5p0Q7kNvwHoczA5&_nc_oc=AdrNtwBmSeA4JVmZME47VVsRBuVx5Fg07uETN6wIOLjsX-bCfHvGeOr2MBPeR8PL2CY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-EAA5747K0Lt0CFz7JE7v7Imu1-CKM6he1FEtCb_LWA&oe=6A577119"}, {"file_name": "vertex_icon_512x512.png", "id": "892652083394328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_892652086727661_8471766470727081124_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rY4p-XUDSjoQ7kNvwEndZk6&_nc_oc=AdqOCioYGNqs-S86ASnyKZcM1Zm_s2-p8JhCeqemM0-A2BKTr9t5A-xuIN-vRNPvimo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvc08-Qt22HFCb-mHEQa44JAeNeK_g-WIkdApmd8FvOQ&oe=6A578F84"}, {"file_name": "vertex_hero_1440x1440.png", "id": "748684451453182", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_748684454786515_6217511722531383750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC51Oywi9U8Q7kNvwFvWzwB&_nc_oc=AdoLKJCebd04QGW_r0QOXIt-QWXPNyfoi3Zo-ffmWvsk-YBuwmMZ1wRmhUbnUXmRGlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWXQRc--7awqG6YgHesK4_zU3lyBn8KPEyGqfW0_wa7g&oe=6A578CC2"}]}, "id": "26770367615883374", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1658145475543201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1658145482209867_195055074849590638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg8WX9HLDM8Q7kNvwEzf82M&_nc_oc=AdrTj7Z2po7riRSYDaYnjkucr0aciUYM9iMWCUReZxUk-IIHRGQ_oi7UqCa60dGzJgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQD3IuawntZ6vIp_i8pqvw5UiBfBes2Fzz5MpOtx75gg&oe=6A579D93"}, {"file_name": "3.png", "id": "2429594607542192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_2429594610875525_7380236625496725701_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1DByVRFo6wQ7kNvwE7kVK8&_nc_oc=AdqrjeYTHLQLMOyBzOtIvKoIx3aqQTp30jgSxJHrnsOTYu527iLkshQNd1Sv-0bmDnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo4_Y123DTrvYjBQfxF8XGPY004OXb2pjfjovkDM8hhw&oe=6A577A1E"}, {"file_name": "4.png", "id": "877756725089612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_877756728422945_305704471306386766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEtlpXMjOE0Q7kNvwH7gPIN&_nc_oc=Adr-fmX_mtz9_LkwQ_bxqzoGP_t3FQ4FLfUIGgTVSX8D85IzJno-VRxyMc1X3K4RlZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvAPDz7pRurQvyybR4K5ArMhcnBVYbhmAyQCU1N4pCRw&oe=6A577CD9"}, {"file_name": "5.png", "id": "862412696831084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_862412700164417_4630813560218885361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2ewHgSfgrcQ7kNvwGb1wUo&_nc_oc=AdqEEw02T-mJJgCmDUmU7V5Fn5YFbVtWNXk8-j10RqO1ZnWW2ppEm9mzYnyxeXjSQVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPUTIAZyqurVRvdUOtgOb4iDs5D6E_cuqfEa882KRi7g&oe=6A5785CE"}, {"file_name": "6.png", "id": "923637530158794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_923637533492127_5988481766482833666_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6THF4aVo35gQ7kNvwGNoj2G&_nc_oc=Adr6fmmwcDoTR_0P9LD1yGVW4ckOI08ny5Gpk_wP0XYmVGihP19Nwn1PWrrKG7GuMh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM9ej2VsJHogSQPra-I71KCcbVScHyeM11X9Q7iSU1YA&oe=6A578EF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": " Vertex VR Video Player is a lightweight yet powerful VR video player designed for Meta Quest. It supports a wide range of video formats and projection types, including:\n\n  Projection modes:\n  - Flat screen (cinema-style virtual screen)\n  - 180\u00b0 and 360\u00b0 sphere projection\n  - Equi-Angular Cubemap (EAC) \u2014 compatible with videos downloaded from YouTube\n\n  Stereo formats:\n  - Side-by-Side (SBS) \u2014 half and full width\n  - Top-Bottom (TB) \u2014 half and full height\n  - Mono\n  - SBS Fisheye (equidistant projection)\n\n  Key features:\n  - High-quality rendering with bicubic upscaling, sRGB-correct color pipeline, and anti-banding dithering\n  - Multiple color profiles (Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D)\n  - Adjustable video enhancement settings: sharpness, clarity, brightness, contrast, saturation, gamma, warmth, and depth effect\n  - Smooth playback mode with optimized buffering for stutter-free viewing\n  - Support for 4K and 8K video decoding\n  - Playback from internal storage and USB OTG devices (flash drives, microSD card readers, external HDDs via NTFS)\n  - Automatic detection of video type (180\u00b0/360\u00b0, SBS/TB) based on filename and resolution\n  - Intuitive VR menu with controller interaction \u2014 drag to pan, thumbstick to zoom\n  - Mirror mode, eye swap, and IPD offset adjustments\n\n  The app focuses on delivering the best possible video quality and smoothness while keeping the interface simple and easy to use. No account required, no internet connection needed \u2014 just load your videos and play.\n{1677380656960522}\n{1881898025800384}\n{1286088660090195}\n{1510923663604622}\n{2300424457109437}\n{1308594671284908}", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features bicubic upscaling, sRGB-correct colors, adjustable sharpness, clarity, contrast, saturation, and multiple color\n  profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27125292510404479"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "790545066825215"}]}, "baseline_offer": {"id": "790545066825215"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772909220, "status": "PUBLISHED", "id": "790545066825215"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28632350966365285", "version": "3.4.4"}, "id": "1252765963588051", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28632350966365285"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "addon in app purchase adjusted; $6.99", "created_date": 1783007590, "id": "28632350966365285", "version": "3.4.4", "version_code": 41, "release_status": "RELEASED", "status": 
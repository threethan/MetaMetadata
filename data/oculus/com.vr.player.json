-1.oculuscdn.com&_nc_ss=8&oh=00_Afzegug5RrDU4r5MpAkFBpmPGV3--d9mviVSBX3D00xQqQ&oe=69BD3A9E"}, {"file_name": "4.png", "id": "877756725089612", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818860_877756728422945_305704471306386766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVMI2hBxj3sQ7kNvwHjw868&_nc_oc=AdkJraOVrfChHYrxRFGdhr0mN-me6raLZfCk6Sxg6pOmkhSIx7aca0fEWpkTBPUrqvs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuWE8a0kOpoiubh7nqP12k_8eLQCKZR1SAdlxPXv2Lqg&oe=69BD3D59"}, {"file_name": "5.png", "id": "862412696831084", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821725_862412700164417_4630813560218885361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETE-svy5_9EQ7kNvwH2oCMt&_nc_oc=Adm0tgfJNk4jEAZXAAuBSw4K2UslYFMwcFwavwOWAlGYfZzNBXjuhHAh4flB2ImL30Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3ucjlkutTOWn5PPR-vfY3p5j2tbsFktyjo5czUALfKg&oe=69BD464E"}, {"file_name": "6.png", "id": "923637530158794", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820855_923637533492127_5988481766482833666_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDQNu_Eu6hYQ7kNvwEzwa0H&_nc_oc=AdmVaQuF23I64Js2e1AtdwRgxcwJ0p0guUmkxg6akoOWixW8WPOwpaaL0Y2WxWaxUm8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPtaTdWOp8Uuqu60Af7JVhy8dBb3vkEkPtMy6nM0RcYA&oe=69BD4F79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": " Vertex VR Video Player is a lightweight yet powerful VR video player designed for Meta Quest. It supports a wide range of video formats and projection types, including:\n\n  Projection modes:\n  - Flat screen (cinema-style virtual screen)\n  - 180\u00b0 and 360\u00b0 sphere projection\n  - Equi-Angular Cubemap (EAC) \u2014 compatible with videos downloaded from YouTube\n\n  Stereo formats:\n  - Side-by-Side (SBS) \u2014 half and full width\n  - Top-Bottom (TB) \u2014 half and full height\n  - Mono\n  - SBS Fisheye (equidistant projection)\n\n  Key features:\n  - High-quality rendering with bicubic upscaling, sRGB-correct color pipeline, and anti-banding dithering\n  - Multiple color profiles (Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D)\n  - Adjustable video enhancement settings: sharpness, clarity, brightness, contrast, saturation, gamma, warmth, and depth effect\n  - Smooth playback mode with optimized buffering for stutter-free viewing\n  - Support for 4K and 8K video decoding\n  - Playback from internal storage and USB OTG devices (flash drives, microSD card readers, external HDDs via NTFS)\n  - Automatic detection of video type (180\u00b0/360\u00b0, SBS/TB) based on filename and resolution\n  - Intuitive VR menu with controller interaction \u2014 drag to pan, thumbstick to zoom\n  - Mirror mode, eye swap, and IPD offset adjustments\n\n  The app focuses on delivering the best possible video quality and smoothness while keeping the interface simple and easy to use. No account required, no internet connection needed \u2014 just load your videos and play.\n{1677380656960522}\n{1881898025800384}\n{1286088660090195}\n{1510923663604622}\n{2300424457109437}\n{1308594671284908}", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features bicubic upscaling, sRGB-correct colors, adjustable sharpness, clarity, contrast, saturation, and multiple color\n  profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": []
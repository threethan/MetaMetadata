ypename": "AndroidBinary", "id": "27474180268849033"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774213007, "id": "27401233289477065", "version": "1.8", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27474180268849033"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "v1.7 (includes v1.6 changes):\n\nPerformance & Stability:\n- Fix OOM crashes: reduced ExoPlayer buffers (saves ~250MB heap)\n- Fix ANR on MediaMetadataRetriever (moved to IO thread)\n- Fix updateTexImage crash (race condition with onDestroy)\n- Optimized GPU rendering: native resolution (no supersampling overhead)\n- Reduced ASW reprojection artifacts\n\nVideo Quality:\n- NEW: CAS (Contrast Adaptive Sharpening) replaces bicubic \u2014 adaptive edge enhancement without artifacts\n- 3x stronger sharpness effect\n- Fix pixel grain/noise (disabled linear-space dithering)\n- Fix sphere zoom: now works both in and out with theta clamping\n\nPlayer Features:\n- 72Hz optimized display refresh rate\n- Smooth mode: remove ghosting + frame rate hints\n- Version number displayed in sidebar\n\nPurchase & Trial:\n- Fix BUY NOW button (opens addon store page directly)\n- Added Activate Purchase button for manual activation\n- Trial persists across reinstall (hidden backup)\n\nOther:\n- Fix V letter in app icon\n- Improved OpenXR session recovery (LOSS_PENDING handling)\n- Comprehensive session state logging", "created_date": 1774198320, "id": "2739
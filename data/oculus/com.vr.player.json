n.com/v/t64.5771-25/491823286_2429594610875525_7380236625496725701_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1DByVRFo6wQ7kNvwGwTxZ8&_nc_oc=Adq5S3YTILC7GjybRIXJT_ROxerQrGqoqx4Lf-G0pD5Z_hI8gBtnLXNcTTMb3fsVS4s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaYnUIUsDAKKWI29vnwatUBSajGSBvwQIdx3xh9dyvpQ&oe=6A58CB9E"}, {"file_name": "4.png", "id": "877756725089612", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818860_877756728422945_305704471306386766_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEtlpXMjOE0Q7kNvwGVt_8t&_nc_oc=Adq7c85fHsaLKfTJQLd0GXDNj5LMbeKWlVnz7RdeG4nlB79dTHLTgV6LasEEdyDHNkg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX9IitcaJB0CpF0y6RzX3FqfPtnL5YgJO13mUHVCnLXA&oe=6A58CE59"}, {"file_name": "5.png", "id": "862412696831084", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821725_862412700164417_4630813560218885361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPUutMVFgLMQ7kNvwGhJKDc&_nc_oc=AdrYaRGUhcNRy_9Hwdv7437_ntqZv7IaqrMwF69-_yxMedccO-HUNY6qxjCCYv1XeXk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNImSJFRcPxdsrU8MdTmXVAw_PJ7XKkM-0OLkSF0rRgA&oe=6A58D74E"}, {"file_name": "6.png", "id": "923637530158794", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820855_923637533492127_5988481766482833666_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kVXLBkdJNAQ7kNvwElDOqF&_nc_oc=Adr7uibErujituEYpLBoH35xgGjNuc9c4TlLjS7S1gPsE8-OB8L-7bOiHegQXORnm5M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw2RHvEN49B8FPk-_56CM2B1kO1prTumWNB7RJz9mrDQ&oe=6A58E079"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": " Vertex VR Video Player is a lightweight yet powerful VR video player designed for Meta Quest. It supports a wide range of video formats and projection types, including:\n\n  Projection modes:\n  - Flat screen (cinema-style virtual screen)\n  - 180\u00b0 and 360\u00b0 sphere projection\n  - Equi-Angular Cubemap (EAC) \u2014 compatible with videos downloaded from YouTube\n\n  Stereo formats:\n  - Side-by-Side (SBS) \u2014 half and full width\n  - Top-Bottom (TB) \u2014 half and full height\n  - Mono\n  - SBS Fisheye (equidistant projection)\n\n  Key features:\n  - High-quality rendering with bicubic upscaling, sRGB-correct color pipeline, and anti-banding dithering\n  - Multiple color profiles (Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D)\n  - Adjustable video enhancement settings: sharpness, clarity, brightness, contrast, saturation, gamma, warmth, and depth effect\n  - Smooth playback mode with optimized buffering for stutter-free viewing\n  - Support for 4K and 8K video decoding\n  - Playback from internal storage and USB OTG devices (flash drives, microSD card readers, external HDDs via NTFS)\n  - Automatic detection of video type (180\u00b0/360\u00b0, SBS/TB) based on filename and resolution\n  - Intuitive VR menu with controller interaction \u2014 drag to pan, thumbstick to zoom\n  - Mirror mode, eye swap, and IPD offset adjustments\n\n  The app focuses on delivering the best possible video quality and smoothness while keeping the interface simple and easy to use. No account required, no internet connection needed \u2014 just load your videos and play.\n{1677380656960522}\n{1881898025800384}\n{1286088660090195}\n{1510923663604622}\n{2300424457109437}\n{1308594671284908}", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features bicubic upscaling, sRGB-correct colors, adjustable sharpness, clarity, contrast, saturation, and multiple color\n  profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27125292510404479"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "790545066825215"}]}, "baseline_offer": {"id": "790545066825215"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772909220, "status": "PUBLISHED", "id": "790545066825215"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28632350966365285", "version": "3.4.4"}, "id": "1252765963588051", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27125292497071147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28632350966365285"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1252765963588051"}]}, "change_log": "addon in app purchase adjusted; $6.99", "created_date": 1783007590, "id": "28632350966365285", "version": "3.4.4", "version_code": 41, "release_status": "RELEASED", "status": 
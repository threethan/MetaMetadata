5C599"}, {"file_name": "3.png", "id": "872813219112175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819323_872813225778841_3661472932447963999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVPN4ablKi0Q7kNvwH-Eg9U&_nc_oc=AdrKUk0BfJX6GTS6iRzTaWlHQbYPT7Z1OqtMwhHDSrl_pZTWoTk3E0Q5ab10Y090F_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XeibyFvn62CY2GHomAjU03lzir1db5VaYuGLB-eRSfQ&oe=6A05C1F0"}, {"file_name": "4.png", "id": "1648504833067981", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491826562_1648504836401314_4031288925258440272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnNqX03AI3YQ7kNvwEVcbkd&_nc_oc=Adrd-GzilxpBlwuWYoLbIYTytjmQUmpYJMQxctJKlSELk2DXhEXgXMvqhrfG9-1RXIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54uOB8J1EgahDA2uwHh_tLmtVslt38wrKGPnXKPp3K5w&oe=6A05B7EC"}, {"file_name": "5.png", "id": "1998057247770557", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_1998057251103890_6734443308877946811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIFzU5oXnGYQ7kNvwEFF0mu&_nc_oc=Adrm6Yodx1SIm6l1hM-vcu1yy6Qr6nY5z8sKBWLTXgXOZc8YVlKRyQ-JrZwYrQRbq3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b-EjZVvK0BGeKai3aw8g5pIiaJiME58wlhkafQymq2w&oe=6A05D341"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": "Vertex VR Video Player \u2014 a powerful VR video player for Meta Quest.\n\n  Projection modes:\n  - Flat screen (cinema-style)\n  - 180\u00b0 and 360\u00b0 sphere\n  - EAC (YouTube 360)\n\n  Stereo: SBS, Top-Bottom, Mono, SBS Fisheye\n\n  Key features:\n  - Play Multiple \u2014 watch up to 3 videos simultaneously. Flat stacked mode or 180\u00b0+Flat mixed mode with gaze-based audio switching\n  - CAS (Contrast Adaptive Sharpening) with sRGB-correct color pipeline\n  - 6 color profiles: Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D\n  - Adjustable sharpness, clarity, brightness, contrast, saturation, gamma, warmth, depth effect\n  - Smooth playback with optimized buffering\n  - 4K and 8K video decoding\n  - Internal storage and USB OTG (NTFS) playback\n  - Auto-detection of video type from filename and resolution\n  - VR menu with drag to pan, thumbstick to zoom\n  - Synchronized multi-video controls\n  - Mirror mode, eye swap, passthrough background\n\n  No account required, no internet needed \u2014 just load and play.", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features Play Multiple \u2014 watch up to 3 videos simultaneously. CAS adaptive sharpening, sRGB-correct colors, adjustable\n  sharpness, clarity, contrast, saturation, and multiple color profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27474333795500347"}, "review_messages": []}]}, "cover_square_image": {"uri":
w&oe=6A22FED9"}, {"file_name": "3.png", "id": "872813219112175", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819323_872813225778841_3661472932447963999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9HHCv2qzooQ7kNvwFMFKiZ&_nc_oc=Adp1faXFYgwh-5gfv5ZV2l0kYAymuZMe61XWleko7-xazd4-G7lib9IQGD6MicYmBYo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b7Axbzq0oofE5vEs1WHOjzhV3IgDSQWu0xWrVGzYEjg&oe=6A22FB30"}, {"file_name": "4.png", "id": "1648504833067981", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491826562_1648504836401314_4031288925258440272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m81qOxCPXlwQ7kNvwEHtaYa&_nc_oc=AdrLQFTbFQR0rybwOB1xfL3mza9uRdBNke3yF82QAOHJaXXg2dB9hia2nUmFMwSF66I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t74cOTY8oxohXLSLDgsXyLj4BGbqaF_U8j-4R_KXU3A&oe=6A22F12C"}, {"file_name": "5.png", "id": "1998057247770557", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823270_1998057251103890_6734443308877946811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D19oIp75xRMQ7kNvwHo4Vqi&_nc_oc=Ado4PRAERlEnLwbFr7qn_c5mQXqgZEmbfCeWoO_nGl4axaFAObsSXyrNjsFWJNY0U70&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MoQHnObbsADyJERGN4hAQNhfvgpgjZeOk05fQwgVxfg&oe=6A22D441"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": "Vertex VR Video Player \u2014 a powerful VR video player for Meta Quest.\n\n  Projection modes:\n  - Flat screen (cinema-style)\n  - 180\u00b0 and 360\u00b0 sphere\n  - EAC (YouTube 360)\n\n  Stereo: SBS, Top-Bottom, Mono, SBS Fisheye\n\n  Key features:\n  - Play Multiple \u2014 watch up to 3 videos simultaneously. Flat stacked mode or 180\u00b0+Flat mixed mode with gaze-based audio switching\n  - CAS (Contrast Adaptive Sharpening) with sRGB-correct color pipeline\n  - 6 color profiles: Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D\n  - Adjustable sharpness, clarity, brightness, contrast, saturation, gamma, warmth, depth effect\n  - Smooth playback with optimized buffering\n  - 4K and 8K video decoding\n  - Internal storage and USB OTG (NTFS) playback\n  - Auto-detection of video type from filename and resolution\n  - VR menu with drag to pan, thumbstick to zoom\n  - Synchronized multi-video controls\n  - Mirror mode, eye swap, passthrough background\n\n  No account required, no internet needed \u2014 just load and play.\n  \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n  \ud83c\udfac JOIN OUR DISCORD COMMUNITY\n\n  \u2022 Report bugs\n  \u2022 Request features\n  \u2022 Share feedback\n  \u2022 Chat with other users\n\n  \ud83d\udc49 https://discord.gg/fT6vcTHXkG\n\n  \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501", "short_description": "Vertex VR Video Player \u2014 a high-quality VR video player for Meta Quest. Supports 180\u00b0 and 360\u00b0 SBS/TB videos, flat screen mode, and EAC (YouTube 360). Features Play Multiple \u2014 watch up to 3 videos simultaneously. CAS adaptive sharpening, sRGB-correct colors, adjustable\n  sharpness, clarity, contrast, saturation, and multiple color profiles. Plays from internal storage and USB OTG (NTFS). Auto-detects video type. Simple interface, maximum quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/vertex-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28142740991992954"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491818849_748684454786515_6217511722531383750_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm7Ew6v8aYMQ7kNvwG-aRw1&_nc_oc=AdqlR15j4tQqjrvuYyagsZzOFzxsdi_J3soeU5iV7suejrai4F41l9Ml6Y9AtI0ipfE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ExOqNjXRPX-W38NDhlgh5AJmZbgfL4U4TbFjaSWI0bg&oe=6A22D0C2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vertex VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1772909220, "lastRevision": {"nodes": [{"id": "27125292530404477", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27125292497071147", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1582024686358979"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "6.png", "id": "2300424457109437", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820923_2300424460442770_6921834298281752360_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIlEDl4ynucQ7kNvwGNxf4R&_nc
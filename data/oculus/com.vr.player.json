XEp2B8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0Ckgz9IfSIo7op2nzAQ_TjP35hlzXjRoucCenXSbvBA&oe=6A4A622C"}, {"file_name": "3.png", "id": "1024203123345998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824322_1024203126679331_558497195947594210_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPTgSDt12r0Q7kNvwGR7eNb&_nc_oc=AdrcwmPrBoHbcn8ZeSzgA9TkcuR81Lb7C0IBq5IdtAeB5yuhkPTx9eWL9TwIyCk0c0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwvB3gkLfwAWGUTv1dcZbijfhCZ3B7AfJhlif5guwEWw&oe=6A4A51AE"}, {"file_name": "4.png", "id": "1445345490730410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1445345494063743_8554308488088497875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8aG0KisSmoQ7kNvwEcMXQP&_nc_oc=Ado3LVKc7r74ytNviLYkTlJxKgiam0jFjnwMh4GQoaeoZWQ3hKhFIl6rW5FinNuGSp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNrCvafM44gC3LJ86p6q4Hy_tDKHqmI3f7MOZHbqNieg&oe=6A4A78FD"}, {"file_name": "5.png", "id": "1708798963485008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823910_1708798970151674_6998823572773085015_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qwaeUcEYbwQ7kNvwGGkvjQ&_nc_oc=Adpd8C8LMDzqd8ZYa7VsDS-vh6Isez9hYuTmmKJZlXYWF_llXgcdHVvQrYv5VyZM48s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdPVBSPK_Aemxth3S_wmqciOgXo-Uk1jEze3Uzy46-rw&oe=6A4A5A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertex VR Video Player", "keywords": [], "long_description": "Vertex VR Video Player \u2014 a powerful VR video player for Meta Quest.\n\n  Projection: Flat (cinema-style, adjustable curvature), 180\u00b0/360\u00b0 sphere, EAC (YouTube 360)\n  Stereo: SBS, Top-Bottom, Mono, SBS Fisheye\n\n  Key features:\n  - Play Multiple \u2014 up to 3 videos at once (flat stacked or 180\u00b0+Flat mixed, gaze-based audio switching)\n  - Network (SMB) streaming \u2014 play straight from a NAS or PC on your network; scan, pick a share; credentials stored encrypted on-device\n  - Subtitles \u2014 embedded + external .srt/.vtt (local or over network), adjustable size/position, head-locked in 180\u00b0/360\u00b0\n  - Spatial audio \u2014 head-tracked ambisonic (FOA/SOA/TOA) to binaural, live toggle, multichannel Opus\n  - CAS sharpening with sRGB-correct color pipeline\n  - 6 color profiles: Realism, Vivid, Teal & Orange, Vintage, PhotoReal, 3D\n  - Adjustable sharpness, clarity, brightness, contrast, saturation, gamma, warmth, depth\n  - 4K/8K decoding, smooth playback with optimized buffering\n  - Internal storage, USB OTG (NTFS), and SMB network playback\n  - Auto-detects video type; VR menu with drag-to-pan and thumbstick zoom\n  - Synchronized multi-video controls; mirror mode, eye swap, passthrough background\n\n  No account required. Play offline from local storage/USB, or stream from your own network shares.\n\n  \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n  \ud83c\udfac JOIN OUR DISCORD \u2014 report bugs, request features, share feedback, chat with users:\n  \ud83d\udc49 https://discord.gg/fT6vcTHXkG\n\n  \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501", "short_description": " Vertex VR Video Player \u2014 high-quality VR player for Meta Quest. Plays 180\u00b0/360\u00b0 SBS/TB, flat & curved screen, EAC (YouTube 360). Play Multiple \u2014 up to 3 videos at once. Stream over your network (SMB) from a NAS/PC, plus internal storage and USB OTG (NTFS). Subtitles (embedded + .srt/.vtt, head-locked) and head-tracked spatial audio. CAS sharpening, sRGB colors, adjustable sharpness/clarity/contrast/saturation, color profiles. Auto-detects video type."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/vertex-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null
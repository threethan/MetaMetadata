3-3.oculuscdn.com/v/t64.5771-25/39003241_564917744725333_4056351617362916788_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzdYhoexdFAQ7kNvwFwkDiU&_nc_oc=Adpj8W0rkzZ8YWla1RYb0a-iIH1WbY4Srato4HfU6mAB7jpYVReeMwzFepvvsk5bZwY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IcA0wjElNnT9eonLRf20kNhRxiRz7bzknHJfN52RtAw&oe=6A13129B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2021-09-30-14h18m22s895.png", "id": "542150013515956", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974538_542150016849289_6899304713325427452_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgyphPKiMTEQ7kNvwHxfVry&_nc_oc=AdpG1SZaCgIdAjMC9DFOoB77CQNTllbgyTsVL5R-EDATAbdtuf86Y0bwBHV_NWkYhrE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68jrijIXGNDkgTHxMpd_RtMXGwmP-d8UI-5fEGdEJ8Qg&oe=6A13182E"}, "display_name": "Whirligig Media Player", "keywords": [], "long_description": "Whirligig is a VR media player for the playback and viewing of video and images. It support a wide range of projection types, video support and visual options to make watching your media as enjoyable as possible. \n\nMain Features\nA wide range of projection types including fisheye 90 to 360 degrees, equirectangular, cinema, and custom formats for more unusual projection types including  cubemaps, camera specific projection and many more. All viewable in stereo over under and side by side.\n3 render paths to choose from to offer the widest possible video support.\nA selection of backgrounds to choose.\nGive your media an outer glow.\nSubtitle support with accompanying srt files or internal using the Video Lan video path.\n16 Save/Load slots to save your position in files and bookmark them for later.\nSave media settings into presets to easily switch between projection types.\nBookmark your media so you can easily return to them later.\n\n\n", "short_description": "Whirligig is a VR media player for the playback and viewing of video and images on your device. It support a wide range of projection types, video support and visual options to make watching your media as enjoyable as possible. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whirligig.xyz/whirligig-privacy-policy", "developer_terms_of_service_url": "http://www.whirligig.xyz/terms-of-service-and-privacy-policy/", "publisher_name": "Whirligig Production", "support_website_url": "http://www.whirligig.xyz/contact/", "website_url": "http://www.whirligig.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2440672139405776"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "955121573900049"}, {"status": "PUBLISHED", "id": "1055603073077323"}, {"status": "PUBLISHED", "id": "881071266931579"}, {"status": "PUBLISHED", "id": "390578792945943"}]}, "baseline_offer": {"id": "955121573900049"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777492140, "status": "PUBLISHED", "id": "955121573900049"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26240814132262823", "version": "5.79343"}, "id": "316348809835488", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26240814132262823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "316348809835488"}]}, "change_log": "What's New\n\nThis release focuses on bugs, performance, and building a foundation for future updates.\n\nPERFORMANCE\n\n- Vulkan rendering: Whirligig now runs on Vulkan for improved stability, better performance, and future-proofing on Android.\n- VLC overhaul: Reliability and performance improvements across the VLC pipeline.\n- Native thumbnail generation: Video thumbnails now use a native process, vastly improving capture speed.\n- Script optimization: All scripts have been reworked to remove bottlenecks.\n- Updated dependencies: All plugins, APIs, and SDKs are up to date.\n\nBUG FIXES\n\nNumerous fixes throughout the codebase as a result of the script overhaul.\n\nA NOTE FROM THE DEVELOPER\n\nThis is a major update with significant changes under the hood. I've done my best to remove bugs without introducing new ones, but if you spot any issues please let me know at phileday@yahoo.co.uk \u2014 your reports are the best way for me to catch what I miss.\n\nIf you're enjoying Whirligig, a positive review really helps. And as always, suggestions for future releases are welcome.\n\nThanks for your continued support.\n\nHappy watching,\nPhil", "created_date": 1779045863, "id": "26240814132262823", "version": "5.79343", "version_code": 167, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26240814132262823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779036879, "id": "26239450389065864", "version": "5.79342", "version_code": 166, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26240814132262823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778955591, "id": "26228018420209061", "version": "5.7934", "version_code": 165, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26240814132262823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "316348809835488"}]}, "change_log": "What's New\n\nThis release focuses on bugs, performance, and building a foundation for future updates.\n\nPERFORMANCE\n\n- Vulkan rendering: Whirligig now runs on Vulkan for improved stability, better performance, and future-proofing on Android.\n- VLC overhaul: Reliability and performance improvements across the VLC pipeline.\n- Native thumbnail generation: Video thumbnails now use a native process, vastly improving capture speed.\n- Script optimization: All scripts have been reworked to remove bottlenecks.\n- Updated dependencies: All plugins, APIs, and SDKs are up to date.\n\nBUG FIXES\n\nNumerous fixes throughout the codebase as a result of the script overhaul.\n\nA NOTE FROM THE DEVELOPER\n\nThis is a major update with significant changes under the hood. I've done my best to remove bugs without introducing new ones, but if you spot any issues please let me know at phileday@yahoo.co.uk \u2014 your reports are the best way for me to catch what I miss.\n\nIf you're enjoying Whirligig, a positive review really helps. And as always, suggestions for future releases are welcome.\n\nThanks for your continued support.\n\nHappy watching,\nPhil", "created_date": 1777836312, "id": "26071532995857605", "version": "5.7933", "version_code": 164, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26240814132262823"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "316348809835488"}]}, "change_log": "What's New\n\nThis release focuses on bugs, performance, and building a foundation for future updates.\n\nPERFORMANCE\n\n- Vulkan rendering: Whirligig now runs on Vulkan for improved stability, better performance, and future-proofing on Android.\n- VLC overhaul: Reliability and performance improvements across the VLC pipeline.\n- Native thumbnail generation: Video thumbnails now use a native process, vastly improving capture speed.\n- Script optimization: All scripts have been reworked to remove bottlenecks.\n- Updated dependencies: All plugins, APIs, and SDKs are up to date.\n\nBUG FIXES\n\nNumerous fixes throughout the codebase as a result of the script overhaul.\n\nA NOTE FROM THE DEVELOPER\n\nThis is a major update with significant changes under the hood. I've done my best to remove bugs without introducing new ones, but if you spot any issues please let me know at phileday@yahoo.co.uk \u2014 your reports are the best way for me to catch what I miss.\n\nIf you're enjoying Whirligig, a positive review really helps. And as always, suggestions for future releases are welcome.\n\nThanks for your continued support.\n\nHappy watching,\nPhil", "created_date": 1777659629, "id": "26050351454642426", "version": "5.7931", "version_code": 163, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
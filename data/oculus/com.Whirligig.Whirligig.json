kj3S1ptm4TWCOQTw6rXVg&oe=6AB3E6F6"}, {"file_name": "vlcsnap-2024-01-28-18h10m44s344.png", "id": "371660285460962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982453_371660288794295_8731593603321107433_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KTLaLNavyQQ7kNvwGMMcQV&_nc_oc=AdpAMyl4len6hYFG-C9kfxKzNbSfGJisK-zyPj4hgozh1e2RLg3lo5IMay8-u4o7VHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnD6Ph7aUofiwRfo4GkWdHVEllI4LQXwJyU1JQBr1Ruw&oe=6AB3C881"}, {"file_name": "vlcsnap-2024-01-28-18h11m35s749.png", "id": "372228892093996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982686_372228895427329_7942825373663529409_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAMkuh860wkQ7kNvwEbFsjf&_nc_oc=AdrIf2BE39GI5mgTFRM1agi_JTNCY-oZU2DiqBynIPz1Wj5bvMroglTgBWH_rp0CNVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ26a8q7nibzwr8Jvnc26AOsSJxyyYmNciEqRGg-1h6yw&oe=6AB3D11A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-01-28-18h05m21s235.png", "id": "269834619286513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984461_269834622619846_4256969541506722880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ASD7tuPBVAQ7kNvwF2kpKl&_nc_oc=Adqah5jqTn28vj2IUa0l1deNJKwSQJSC7LbqrYNkzn4kF1s8E2k2lVBgwlIh67Ih08c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKczmldeJ4Paeuel5nbNLs1fKrsSxpkpPhu-jcuYPTikQ&oe=6AB3DC40"}, "display_name": "Whirligig Media Player", "keywords": ["180Video", "Stereoscopic", "8K", "MoviePlayer", "Passthrough"], "long_description": "Whirligig is the ultimate VR media player for users who want fully immersive media in the best possible way. Watch 2D, 3D, and 360\u00b0 content on your Quest headset, with a fully customizable viewing experience.\n\nKey Features\n\nImmersive VR Playback\nPurpose-built for VR \u2014 perfect for 360\u00b0 immersive and stereoscopic media, with passthrough support for mixed-reality viewing.\n\nMedia Server & Network Streaming\nConnect to your Plex or Jellyfin server to stream your personal movie library, with smart local, remote, and relay connection handling. Browse network shares (SMB) on your local network.\n\nComprehensive 3D Support\nSide-by-Side and Over/Under 3D support. Adjustable 3D depth and convergence, and 180\u00b0/360\u00b0 3D video.\n\nAdvanced Playback\nMultiple projection modes \u2014 Cinema, Fisheye, Equirectangular/Barrel, cubemap, and more.\n\nCustomization & Control\nTwo decoding methods (ExoPlayer, libVLC) for maximum compatibility. Save/load presets per media type, full 5.1 surround sound with positional audio, and subtitle support with external and internal tracks.", "short_description": "Whirligig is a powerful media player for VR, supporting 2D, 3D, and 360\u00b0 content. Compatible with OpenXR-based Quest headsets, it offers adjustable 3D depth, multiple projection modes like Cinema and Fisheye, surround sound, and subtitle support. Stream from your Plex or Jellyfin server, browse network shares, or play local files, with decoding via ExoPlayer or libVLC for a flexible, immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whirligig.xyz/whirligig-privacy-policy", "developer_terms_of_service_url": "https://www.whirligig.xyz/terms-of-service-and-privacy-policy/", "publisher_name": "Whirligig Production", "support_website_url": "https://www.whirligig.xyz/contact/", "website_url": "https://www.whirligig.xyz/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
00457359961975710_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilz2IfXz-IAQ7kNvwGfVCQ6&_nc_oc=AdqXyLNk0nDVC7SMw7tnFRiTZVL1A2FFdY59nsVKERIOtuvMEsKRP_VmefN1hV3srxA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIEcCbF0MQdaasedRaIoEoPCzmnXl1KAbebWYx3Z53iA&oe=6AB3E1E0"}, {"file_name": "01 - Screenshot.png", "id": "389495942660694", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035406_389495945994027_7467869491837528573_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZfXgzpTDzQQ7kNvwFBgvth&_nc_oc=Adp3yqrlFLcGMcnbtjkv9z3sViQoqS-nQCxmkt9Arrprfy428ixwioaEorm8YHslOrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Fi_1M48Id46ZOVlQVcGCt7JSh_zwamp3FMg4a8FTxQ&oe=6AB3CF04"}, {"file_name": "05 - Screenshot.png", "id": "564917741392000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003241_564917744725333_4056351617362916788_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfcFp-v88BwQ7kNvwEnvNyz&_nc_oc=Adrpa08n0MENwuUhmRcTVZdeju0mMtOpWskTRrwIO0LfCweS65FVi6I-YdMt7niOgNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0v7V7_oDichlbu1JpQFoDIe7Z8S6zOcLugLsA02Z2zg&oe=6AB3E99B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2021-09-30-14h18m22s895.png", "id": "542150013515956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_542150016849289_6899304713325427452_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmDFKB1fuv8Q7kNvwEcyPrn&_nc_oc=AdrE4ueK5wuPSn2PZur-2zTUXlmWttdRFEXybA4Qw6e6y6eYcVZn7_DcYYB9CpyMBNE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwD3qjHA_MILQhAMZDN0SDQ049bSIk85LIVnOF76Q4yQ&oe=6AB3EF2E"}, "display_name": "Whirligig Media Player", "keywords": [], "long_description": "Whirligig is a VR media player for the playback and viewing of video and images. It support a wide range of projection types, video support and visual options to make watching your media as enjoyable as possible. \n\nMain Features\nA wide range of projection types including fisheye 90 to 360 degrees, equirectangular, cinema, and custom formats for more unusual projection types including  cubemaps, camera specific projection and many more. All viewable in stereo over under and side by side.\n3 render paths to choose from to offer the widest possible video support.\nA selection of backgrounds to choose.\nGive your media an outer glow.\nSubtitle support with accompanying srt files or internal using the Video Lan video path.\n16 Save/Load slots to save your position in files and bookmark them for later.\nSave media settings into presets to easily switch between projection types.\nBookmark your media so you can easily return to them later.\n\n\n", "short_description": "Whirligig is a VR media player for the playback and viewing of video and images on your device. It support a wide range of projection types, video support and visual options to make watching your media as enjoyable as possible. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whirligig.xyz/whirligig-privacy-policy", "developer_terms_of_service_url": "http://www.whirligig.xyz/terms-of-service-and-privacy-policy/", "publisher_name": "Whirligig Production", "support_website_url": "http://www.whirligig.xyz/contact/", "website_url": "http://www.whirligig.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2440672139405776"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "955121573900049"}, {"status": "PUBLISHED", "id": "1055603073077323"}, {"status": "PUBLISHED", "id": "881071266931579"}, {"status": "PUBLISHED", "id": "390578792945943"}]}, "baseline_offer": {"id": "955121573900049"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777492140, "status": "PUBLISHED", "id": "955121573900049"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27042038045473757", "version": "5.79402"}, "id": "316348809835488", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27042038045473757"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "316348809835488"}]}, "change_log": "Whirligig Media Player \u2014 What's New\n\nNEW FEATURES\n- Network media browsing: Plex (including remote play), Jellyfin, Emby, SMB and DLNA, with automatic detection of local servers and shares.\n- 3D environment fades: the environment now dims during playback in 3D environments (previously 2D only) for better comfort.\n- Colour gamut options: new controls in the Quality menu for improved colour reproduction across headsets and videos.\n- Player settings presets: save and restore your own Player settings presets, plus three ready-made presets \u2014 Default, Desktop VR, and Desktop.\n\nBUG FIXES\n- Fixed the Subtitles on/off control not toggling subtitles when bound to an input.\n- Fixed crashes when browsing DLNA and SMB network shares.\n- Fixed the laser pointer being blocked by backdrop colliders.\n- Fixed file explorer issues (menu sizing and opening).\n- Fixed the video progress bar when using presets.\n\nNOTE\nThis is a large update. If a new feature doesn't appear after updating, reinstalling will pull everything in \u2014 but note that a reinstall resets Player settings to defaults, so save any custom presets first.", "created_date": 1784993133, "id": "27042038045473757", "version": "5.79402", "version_code": 168, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27042038045473757"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "316348809835488"}]}, "change_log": "What's New\n\nThis release focuses on bugs, performance, and building a foundation for future updates.\n\nPERFORMANCE\n\n- Vulkan rendering: Whirligig now runs on Vulkan for improved stability, better performance, and future-proofing on Android.\n- VLC overhaul: Reliability and performance improvements across the VLC pipeline.\n- Native thumbnail generation: Video thumbnails now use a native process, vastly improving capture speed.\n- Script optimization: All scripts have been reworked to remove bottlenecks.\n- Updated dependencies: All plugins, APIs, and SDKs are up to date.\n\nBUG FIXES\n\nNumerous fixes throughout the codebase as a result of the script overhaul.\n\nA NOTE FROM THE DEVELOPER\n\nThis is a major update with significant changes under the hood. I've done my best to remove bugs without introducing new ones, but if you spot any issues please let me know at phileday@yahoo.co.uk \u2014 your reports are the best way for me to catch what I miss.\n\nIf you're enjoying Whirligig, a positive review really helps. And as always, suggestions for future releases are welcome.\n\nThanks for your continued support.\n\nHappy watching,\nPhil", "created_date": 1779045863, "id": "26240814132262823", "version": "5.79343", "version_code": 167, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27042038045473757"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779036879, "id": "26239450389065864", "version": "5.79342", "version_code": 166, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27042038045473757"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778955591, "id": "26228018420209061", "version": "5.7934", "version_code": 165, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3581543561949869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27042038045473757"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "316348809835488"}]}, "change_log": "What's New\n\nThis release focuses on bugs, performance, and building a foundation for future updates.\n\nPERFORMANCE\n\n- Vulkan rendering: Whirligig now runs on Vulkan for improved stability, better performance, and future-proofing on Android.\n- VLC overhaul: Reliability and performance improvements across the VLC pipeline.\n- Native thumbnail generation: Video thumbnails now use a native process, vastly improving capture speed.\n- Script optimization: All scripts have been reworked to remove bottlenecks.\n- Updated dependencies: All plugins, APIs, and SDKs are up to date.\n\nBUG FIXES\n\nNumerous fixes throughout the codebase as a result of the script overhaul.\n\nA NOTE FROM THE DEVELOPER\n\nThis is a major update with significant changes under the hood. I've done my best to remove bugs without introducing new ones, but if you spot any issues please let me know at phileday@yahoo.co.uk \u2014 your reports are the best way for me to catch what I miss.\n\nIf you're enjoying Whirligig, a positive review really helps. And as always, suggestions for future releases are welcome.\n\nThanks for your continued support.\n\nHappy watching,\nPhil", "created_date": 1777836312, "id": "26071532995857605", "version": "5.7933", "version_code": 164, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
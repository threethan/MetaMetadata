6-1.oculuscdn.com/v/t64.5771-25/39003241_564917744725333_4056351617362916788_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSsBFO3QhvkQ7kNvwEnmWkb&_nc_oc=Adq3awvGkwnuCjw_lbl233zJLY8YnXpAELGQSwnYirBrbuSHgtGWU9SWs4Wgtn3oT6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1q6yqqnfFp6W_SCjb3vL5ftmXdvZ124JJMTR9GOdualA&oe=69F8B49B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2021-09-30-14h18m22s895.png", "id": "542150013515956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_542150016849289_6899304713325427452_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC1od7qry5gQ7kNvwHg2JpD&_nc_oc=AdrzJLXxL0SWI_d62ji0Wfj6i-vVztbflVFXlYNjIntZPmIzj3mBpQHQM3fLQeRNvv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qOo67ZFqEK6f3n0axHbVV0Ivy_3fDgT5sK1Kzhgu6lA&oe=69F8BA2E"}, "display_name": "Whirligig Media Player", "keywords": [], "long_description": "Whirligig is a VR media player for the playback and viewing of video and images. It support a wide range of projection types, video support and visual options to make watching your media as enjoyable as possible. \n\nMain Features\nA wide range of projection types including fisheye 90 to 360 degrees, equirectangular, cinema, and custom formats for more unusual projection types including  cubemaps, camera specific projection and many more. All viewable in stereo over under and side by side.\n3 render paths to choose from to offer the widest possible video support.\nA selection of backgrounds to choose.\nGive your media an outer glow.\nSubtitle support with accompanying srt files or internal using the Video Lan video path.\n16 Save/Load slots to save your position in files and bookmark them for later.\nSave media settings into presets to easily switch between projection types.\nBookmark your media so you can easily return to them later.\n\n\n", "short_description": "Whirligig is a VR media player for the playback and viewing of video and images on your device. It support a wide range of projection types, video support and visual options to make watching your media as enjoyable as possible. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whirligig.xyz/whirligig-privacy-policy", "developer_terms_of_service_url": "http://www.whirligig.xyz/terms-of-service-and-privacy-policy/", "publisher_name": "Whirligig Production", "support_website_url": "http://www.whirligig.xyz/contact/", "website_url": "http://www.whirligig.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2440672139405776"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "955121573900049"}, {"status": "PUBLISHED", "id": "1055603073077323"}, {"status": "PUBLISHED", "id": "881071266931579"}, {"status": "PUBLISHED", "id": "390578792945943"}]}, "baseline_offer": {"id": "955121573900049"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777492140, "status": "PUBLISHED", "id": "955121573900049"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26027792563564982", "version": "5.7930"}, "id": "316348809835488", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applic
tJLpefgo7gvL3KmDzDCyA&oe=6A2ACAF6"}, {"file_name": "vlcsnap-2024-01-28-18h10m44s344.png", "id": "371660285460962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982453_371660288794295_8731593603321107433_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upZrptWKGg0Q7kNvwFM2IVM&_nc_oc=AdqEKA-jv57e0M2IN9keWDZ2g0_5MrKQfumQB04tNi8pmN7i2cKF4_75_Eh7Rd3x1vo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vfw3KmOWgjUWugwPgri5Gm0asq9j3ORCIa6Izt3GXNQ&oe=6A2AAC81"}, {"file_name": "vlcsnap-2024-01-28-18h11m35s749.png", "id": "372228892093996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982686_372228895427329_7942825373663529409_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkCeQZZmNHAQ7kNvwEAl_RS&_nc_oc=Adr1evKksrZpLjB0Ky1PBykCR8OQd2Azrt4-z5HaJvjjq8LIvhVNwNeM5G_onn3xriU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dLRv763ingb2GRfpgCHWh7HCkjgDsciqifDaibLJnBw&oe=6A2AB51A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-01-28-18h05m21s235.png", "id": "269834619286513", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984461_269834622619846_4256969541506722880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9Z5VrZTmT4Q7kNvwFIMAJr&_nc_oc=Adoz3BKXb0E_9Np28nNP_R0WsTjPDvPfbxBasCQJ_oH172St387xYqRXVNP0fMD7KVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FGq_vySnnVDWcGMrLYXY5AzBi-JVUxWBj9S897zyCyg&oe=6A2AC040"}, "display_name": "Whirligig Media Player", "keywords": ["180Video", "Stereoscopic", "8K", "MoviePlayer", "Passthrough"], "long_description": "Whirligig is a versatile and powerful VR media player and video player, built for immersive playback of movies, videos, and images. Designed for viewers who want precision and control, Whirligig supports a wide range of projection types, including fisheye (90\u00b0\u2013360\u00b0), equirectangular, cinema, dome, cubemap, planar, and fully customizable layouts. All can be viewed in stereo, with full stereoscopic support for over-under and side-by-side 3D, including footage up to 8K depending on your headset's hardware.\n\nWhirligig offers deep customization that sets it apart from other VR video players. Adjust screen geometry, curvature, and glow effects, choose from multiple environments, save presets for specific media types, and bookmark content for fast access. Passthrough mode adds mixed-reality viewing, with optional chroma-key support for green-screen footage.\n\nAccessing your media is flexible. Browse local files, network locations, or connect directly to your local Plex server to view your personal movie and video library inside VR. Subtitle support includes external .srt files and internal tracks when using VLC, and you can save your position with up to 16 bookmark slots.\n\nWhether you're watching 180\u00b0 and 360\u00b0 immersive video, stereoscopic 3D movies, or your own Plex collection, Whirligig delivers a customizable, immersive experience designed to match the way you want to watch.", "short_description": "Whirligig is a versatile VR media player and video player for 2D, 3D, 180\u00b0, and 360\u00b0 videos and movies, with multiple projection types and extensive customization. View your media from local files or your local Plex server, and use passthrough to blend videos with your real-world environment for a flexible, immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whirligig.xyz/whirligig-privacy-policy", "developer_terms_of_service_url": "https://www.whirligig.xyz/terms-of-service-and-privacy-policy/", "publisher_name": "Whirligig Production", "support_website_url": "https://www.whirligig.xyz/contact/", "website_url": "https://www.whirligig.xyz/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26319118374432398"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825094_1400877731067940_7251451966260469780_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWeF9299to0Q7kNvwHRtSlO&_nc_oc=Adp20KgFOyuUMLykieF8JdkLMQumSCUKpb4z6xs1DQvaT5DT5Gck8erT6Ejz92CGras&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T1Jr8Ap_Dvj88Qe154GTDBP06YWMtup6hWKs6Llsnew&oe=6A2ACE9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Whirligig Media Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1651702177, "lastRevision": {"nodes": [{"id": "3899224100191417", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3581543561949869", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "302179221475914"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "11162707_1884549788427790_3582999702737518592_n.png", "id": "2537864563186405", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974613_2537864566519738_375428531766989437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy38iGO4YO0Q7kNvwH-Z_Ai&_nc_oc=AdqgweLUdj7wQ_3PfuFMxqMbPgWMe
rZn4Za0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27D9yB1ok92EqHP0i9Cowrts6SsDF5tKdhoiDxIu4Ujg&oe=69E23D92"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1tb52NGjVcQ7kNvwF19jdI&_nc_oc=AdpKZrP9qiTFl8oHOzLDFqymK4PmlWgwn9wdAWYatTtQOXeBWS2l8hx2JH1qcmvMIJs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X7XlpNP2xtfpjKHcZGwCi-x9cakdkjfd9zjdpCPzmxw&oe=69E21C21"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGQbcumdWHEQ7kNvwEsYjW-&_nc_oc=AdqiLCfyRkZxmr36jcg0N05GKr6w3_vI85-R7pH5UR-NNXt5ZsLX1V_Jm4trOjQ9dbE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31x3puWD-uKXpIUslW1clRw0hvDP5ihPL43jQIGc_8yg&oe=69E24EB2"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WrGPDmagScQ7kNvwHZwZwd&_nc_oc=AdqaBgrAiHIU2koX2KkimhrR6TS7GkKJh0fKEQreiMM9Jbi00q9js0Xj0Kc3vYgAfDQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OcxFiBlzG94gfqMu-I8UUcpiboztMKO1e0mKOta1isw&oe=69E236E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PHhaLHkXVUQ7kNvwFayhI_&_nc_oc=AdqhXF0iBD3BCpYPkhbWjJCKzksA_xLkEcTJuQRJBEe-1ADPX2dbWL0bJTCv0WMZ4_4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A1NaqnqoipslpWc-A__DxsHPz47cYiQ_3DH5TWv7xpg&oe=69E235CD"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
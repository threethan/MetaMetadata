qXOTB2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIpbLhJqv7KEWC4NCtF7Q313itR1NScmxrl7mdoj0gSg&oe=6ADF5D92"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZiGnPEMp9MQ7kNvwEgIbRa&_nc_oc=AdoBpMOWY3q3gzubvgMPL7IIru5zAvwA2oJXGmXjLj4APnzBlBCc_8nYO5qxYZXs_LM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6ZKjcaNdqSWPNvGa7fv_pB26UhNakXsCuXTXsxIlsIQ&oe=6ADF7461"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjQEZzB4TPEQ7kNvwEPrnsO&_nc_oc=AdqBSytMe3-QnV09DOn4qxVzDfgFswvx4jVyg_P_xX9kowkj7ecAcFo_XTrCreAx37M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtSI8TkwJSG_fKvaYMuUPnLwzMlQY2ZVaRQd-wmtCuPw&oe=6ADF6EB2"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9a9qugN4N0Q7kNvwFUsKIX&_nc_oc=Adp7GQyZLJrNMZPS-OZTYfHOa-yg6DIMLxjQu68atHrsjShYFuitsWjIn7EIrd1rk0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxOpKuJhpJ7r2kM7GgeZ-UzccqZHuMPkuJXgtq-2NcMA&oe=6ADF56E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3zX2jjql34Q7kNvwE3T1lk&_nc_oc=AdporUtTplweRfkYjUegKI8P_O9RwrKqrAn6cFF0sxp27roOTCZ7zBwf_NlA8VeJ5Dg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWhvOFX6JgowSAAV2cwWnvqEAnGgZCLHpMRSIf0q4EcQ&oe=6ADF55CD"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
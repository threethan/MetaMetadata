2"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umVQFT9k8RcQ7kNvwFjR2Py&_nc_oc=AdnVMBu2NUPpMoBUCHrt3FsXcNGrjHrXmCRitOO86gNf6YbXmlAnAYPryqUi-9tBniw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftH4Ukhj1DNsJy-AXLjsSmOPgD-1eA5I8Nz3_2hL_vaUQ&oe=699EDFA1"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0_BiRhUxB8Q7kNvwHTwS9i&_nc_oc=Adk5NNBEYEW7K14Zz7B0EJI4opz0GCZJKtdHwQJnTwBWWnpU_RmkEGGdx6GHpZl9wbU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3pSx2ppdLZDDPLbiw14hxgubLGJmQpM1WSida0yNnrw&oe=699ED9F2"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um-6LgIDlusQ7kNvwFQ1rl3&_nc_oc=Adnxo4fEMyNAFaQD2FjRTRtKLI-U6XB44UuTgD4znZ02Cu9SRlqLD7lw9kRzxxAsK68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftac1cHP8VxwVZJU7B9W7q3ypY7XkdXRNod9s4aWWN-jw&oe=699EFA65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZTFdgw5avgQ7kNvwEavm4a&_nc_oc=AdnySCu3g7_KmTHMRDY9hWYMpzgkrypvK3W3enIGFHRikakNcUKM6Uk41rJEzztSbYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsCINFuKs79AoXGDx1pjkLJhCkXZf4Xz_SvJBBVGH_sBw&oe=699EF94D"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": 
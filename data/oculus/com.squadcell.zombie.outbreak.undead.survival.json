3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyZPRoJKVLio-WisSKFvvrketzAaubJmScE2KWSr2ZQw&oe=69BAB092"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGNGoi8aZaIQ7kNvwECKHCA&_nc_oc=AdkcuvZh4AD4BLXAugNp7MiDgi3-8XsDBLXa9Ylc7zdubqDy03DX8sO5L2HcGHzfjgw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfygCgxiekmxpp0m-pD4kRb4OakmL3ORFXnPPKs6YnWuCw&oe=69BA8F21"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hk7TExfmI8Q7kNvwFMixZR&_nc_oc=AdkL2gGtl5sM9bfYj76Xs37Xp1Fodo7tZgNGjIeM08z1LTyqL1eikDlCsbGjvrZoP_Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3nT44sW2LjS9dL0Uq4oN5-JGAnPQda74qPMu-bKf_Jw&oe=69BA8972"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGHjnqbAtpcQ7kNvwEtoKRr&_nc_oc=AdkuwdrxffI5NbrPQMhm7iDd0rpRuRF3PgEsj7-_Js8rgNQG5b0HPFgzLTo6lw_S5Fc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDDnRIE9pGJCrQpi1Y1cAuwFcIn9h_BFsFnP9DMUQsXw&oe=69BAA9E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH13OS9zjDoQ7kNvwF-srCL&_nc_oc=Admjj1-eLk2BAXnKH4whDn4FvBjCcm2jnc18tAW73bPqSwFgoDRQspvAEV2UsyO6E-s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfytHWd_213YDWMB0jehzpd5bxd8kofDif1G2HyFxhSiFA&oe=69BAA8CD"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
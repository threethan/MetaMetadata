zQqL2Gk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BUGb_GcuHY714ey7qtRWNSd7ITZsHECkX0YeJCQrKLw&oe=6A2C1192"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR-X16-vl_4Q7kNvwHVfdAp&_nc_oc=Adqb9hOfUFyVIVhSBIRnaNqK6-qn_dxiXBodjjk7MG_rAyi-cZ5bCnqoj1M0SHI5wCg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TYnVxFJb2WTKp19WjI86zttE5XShLyAJH_4LpR6Jjlg&oe=6A2C2861"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuOUdr_rHLQQ7kNvwG8CO15&_nc_oc=Adq50zwhSwq-Cdyb3hyMJPYghQZIliHTTuP0vo0ww1tP7mT9ZPmtVXjS5yHWXqgr8iI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u6Tf5iunWQR6H1oQCJxOTa5V-ALT-Wci6WLfuspN6Uw&oe=6A2C22B2"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF09jOCfp74Q7kNvwFUK82n&_nc_oc=AdoJ_M4b8yFRVfwD76y5suzGL3sIa3akvj6YSBjJpo-_UDOZIJPMzcze6rU3er1ytYo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6OxTuaidrls3yCOVWXq0jtsWdiGy7fxCsIdLL2R4MiA&oe=6A2C0AE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv9fykFvGOcQ7kNvwGxjMMx&_nc_oc=Adomo_K297y-MnnINIp0LGjlEuEgcp-PSCJWailH38k8jYLFxfEKY_pddAbOjlP1bI4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZS1LLJdmU-sJOcxTnnPdenRp9MFspIoxxf3Tt64S8jw&oe=6A2C09CD"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
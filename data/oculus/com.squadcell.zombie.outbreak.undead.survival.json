2"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25IgG5MS3gkQ7kNvwEl1alF&_nc_oc=Adk1fxpaAlJkF4mj24qN-Ec_bR4v_JatfWcNFaf1jl46g11PMnuc616g74AFkPAc2UE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs0BT0wbu15W2eMXw76kxaA1CO-YfFF6ueUuxu_7dbQcQ&oe=699AEB21"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9t28JsRPCtQQ7kNvwGMlXot&_nc_oc=Adkmq_lp_t-A0azXweqLbQuF9VtnpKOTfaukzO4VFir5NS68Y91w3Zv2AX36yyL_l3Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuSXmDCv8MAt9hHiPrE7DJih4vQ2_PaAj4jYw41txpieA&oe=699AE572"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP8Svgr2ebIQ7kNvwFnWL9r&_nc_oc=Adn4aRuSiD_4x2CJ5XYaCeANxF-b8ibvck10MQ-toQ6Edq-XzL0tlktvZuOsGX3DBHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsAqF3hjw-2WjEelGZkPT5nQLsoVzBRVYd-rnpn-Lkowg&oe=699B05E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kol9HYqIPSgQ7kNvwEuMgJJ&_nc_oc=AdlMFKdXEKDOz9LX6XtvjjuOFXWosUGjDL_DQLZsW1e_WeyJi2_mQK63GGmNi-fpugc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfumPFsBOsVlwcK6NEY24x-QvFlHUSxbHSzaKRNk2dtezA&oe=699B04CD"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": 
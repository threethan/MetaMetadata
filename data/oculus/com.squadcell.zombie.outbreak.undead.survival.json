dRJPbLc2W3_Zw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn-JaQRFxpnoyJp1ycI_kifPqpX33lbsis52LZnPqThw&oe=6AA40A12"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqkea_yi29UQ7kNvwGqrjT1&_nc_oc=AdrunmhnLBq8Mmx-cmchi7lXCVORrBcsiO2N2udgtX8mWKt_47m9L-FIFuMXmVOY9I0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8qFxF7ZxFqADKp2soUU-BeS4qRNCgiYCVpeAbv6sSIg&oe=6AA420E1"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzwINiIvfGoQ7kNvwHoX4TZ&_nc_oc=AdqVP3nX5nkcixmKWhDE8vx4c8KO_WVJtEH2LtuxdIoXEEOgCSaRa40irjoCUGz7XmE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQYY4Vq774vJAPtqT3XLls5e2FAbllEhDQTQ5eK-zyCQ&oe=6AA41B32"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAXNw5DfzhYQ7kNvwEOtZfp&_nc_oc=AdoMT_w5--Iuvs1cQslO1lilfPjDsejHvjT3SW3JY7m3dTuNbA3g6AAeA70EA2hmF9w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNRiey1DpUourkukBx8TmfrC05B_Bq9sRG_KAFXR72NA&oe=6AA40365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AyY3pDBvU8Q7kNvwHM6wyW&_nc_oc=AdqSox507Htvwls-zqnILVo_rr6NEjlwEsj5dagMui4UbRE32UTTPeosR2daTBOfZw4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOR5xvZxQDj3McHkHwxBLRnuHToDVJtLuDBeSwYLCXoQ&oe=6AA4024D"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category":
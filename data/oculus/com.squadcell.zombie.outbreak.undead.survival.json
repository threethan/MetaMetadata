GEjr7CY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpniDZZo8BHl56CiONk1U9j0fS0J9l4fUC2LN-r3wBAA&oe=6A6DFC92"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_YGi_OB91QQ7kNvwGAqakU&_nc_oc=AdpBaYWWjBvX0uXxrshcrcmWDaLKN0KjTN_zLJtx36N5UZkhd5t_0TYSxelJK-Ovx2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABwJ040xZcIHodX0wYXX5tU8LcUAZXzjhc4sEEd41aRA&oe=6A6DDB21"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=995LDti-O8QQ7kNvwFU3iG3&_nc_oc=Adrv4pBSGdXbNrLnGsnrET5MLx6UhnscYTfXYoPNsmiGC8eDS7Ionha-dqrelHus_DE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLOTMdUEted1MQU7J-mPaoMn6-D7Q7Wvlks3yitKfkiQ&oe=6A6DD572"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVC12P-YasEQ7kNvwHdKL7C&_nc_oc=AdoHV6FgKQiqoxa8IMn-4dnZNcIuZPvX3_TmZLAJtHjZW7UcCfjEMjDd_qsBl18p3Aw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHiAS4oFBWbmEWRUHGNaUnXDC9ZGfMWGQ_gMYH_cf8Nw&oe=6A6DF5E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xldGhtMLnwQ7kNvwFWIvry&_nc_oc=AdqR5JRL0sOALITxL8YeopXjEtiS56PRmchGeXhLvkS2oYcF-mVPDxPiZeIoYUfyU0c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuplnPUWzmUMxCem8AmZYQY1lC9cJb-DwS6_eK8lHr6g&oe=6A6DF4CD"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
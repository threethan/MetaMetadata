OONZeOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0Yn-lep5YdC66ZHjmEkX8CVHEpydjfrrNrNNoxrSfkg&oe=6A2AC012"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR-X16-vl_4Q7kNvwGL6F3D&_nc_oc=AdrZ2-HrHYLmNTwo1pFMW8MwRlqvIJmgRDj9lrR75wqth3KohBuvIkNKkiOIy4tqkcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LH5H6N72fyAMWw5OWjvW-3Ia18EED4lnaAa_K4bNymA&oe=6A2AD6E1"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuOUdr_rHLQQ7kNvwGwjUly&_nc_oc=AdpSHVpdl7W3dwtlVp82Tt24BdAZ9gP5sQMHgdoiW8XNsZ7ERP8eOcWiBH27-wICbdw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O8r3X159PiSRe5TKq7kSVCiNEGMCy1JEADfwHUJxUWg&oe=6A2AD132"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF09jOCfp74Q7kNvwGMadwQ&_nc_oc=Adp5JIN1wqZ4vahoBmulNBuSeuLPrzUUhD2ypc7yrPJ129kA3RYfZEmq8i4J1G7MPVI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VfSJC_bCfmicDcbkC1MI7iFS9sDVjTDL9NGTp85XHnw&oe=6A2AB965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltIQWWnNus0Q7kNvwEyQBBS&_nc_oc=AdrR3svq6PWcuMOR7xvo0k0x1E32UX12tDP4Oh50yNuRY1zDDBD5sMJL7ZwsdZYGprc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fp9slDIXepjvkACD-9fy4GO-ilg0Xm7cEzrV52bQpkA&oe=6A2AB84D"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
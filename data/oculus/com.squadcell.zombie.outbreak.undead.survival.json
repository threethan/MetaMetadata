TLYY0Co&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeMxIdosdF-LF9erC1cC43GETehg9SsSZ2gpf-nbBGmQ&oe=6A882252"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoyoS-J04i0Q7kNvwFVL1zb&_nc_oc=AdrEPlcCrJ_kgVGnnQorKVXyx6tFU8GSEj04e-QYsAf1h4D-YyWQliDFAhTYiEy6LqQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuRdPp1VmMsQpPTK16bsS48CNM40FLySybA2V9mhuaFw&oe=6A883921"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T8WcZYqossQ7kNvwEef7Op&_nc_oc=Ado3arT5aGpyjtpBnDmojUjX6xtw9qLJK_YYqZvx-MhAHaBZVSqNDVqUUhWYpNwqfUQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNX4lXO0hpZ1ry-kxFJRDrDjwkzTF_0J8lOO7kF8LUHA&oe=6A883372"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D54Iwd_SNaMQ7kNvwFgy-Gn&_nc_oc=AdqIUVLeBALkPsXVYsVyJGMVvHqntTVG8g-z38ayd-EZl_1dKi9TzIsiN8OW3JxxDzs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh8eB91UwBDvrJFWhudQntV5pEDAQUleyGeDzlRaK5Aw&oe=6A8853E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjEEJZeJnzgQ7kNvwHgg_LW&_nc_oc=AdpGQ2fK4qQ7pGpJ1Pb3VmV8Vx4WnDBeaAPB9F2hdtIqWwGt1puVQgZr046FElDRlKg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbLX_hj76P8xrphC7e3DfGnhIGO5wZPQOuz1sc-sZREw&oe=6A8852CD"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499326822_734858292211142_8178388118447165205_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImUEQk7qoIAQ7kNvwFJEHTq&_nc_oc=Ado8w1DVfwNpoykUknY4ptk7Ey0dXJwBxb893C305eS0N-VST-XL7mj8sJNIZwZZ1UQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWBZ4-JvbxZN4A-jJw3WjjR5h0D-RqVxJFdDUG68TXAA&oe=6B047FD2"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-QJONdrp6kQ7kNvwG-3dv8&_nc_oc=AdpxaLXUNB0QCmevx__01mlqLyVMG4rZa4iJ_cZiguX4Uv_i3Z7e3lhhtQ9Ys8vOJb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4G8YW9gqOvPMQTegeClB-u0rFGlSWDWNMOyjqhMr-vw&oe=6B045E61"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlXTfjlsMb4Q7kNvwFAjrJ2&_nc_oc=AdqAZlB2ZTih7GKk-C241BCqucV_nSJNkyJWXGMS8pBe8ut0ByAIRqM1ouVbSNaVTUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOjlLwoBZKjyNZFcqNaqupIk82KnHTqVfRui8DGYLJ3w&oe=6B0458B2"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2pAiHb7gjsQ7kNvwGup6n3&_nc_oc=AdrPdrke9XzekhruRmexMtbZglP2ZfvZ8O7fcrM1pwg4j_Cut-OkwGR12cwcw26ax0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBt6kWZHrfJJDElumCaLbp_uN-OxUb0gLnJu5kz3X7xg&oe=6B047925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBbzhbpqldcQ7kNvwHhdWEf&_nc_oc=AdpSJ9ox8hPj6ow_wyew2l_h5UN0EawWfYes81vXkuMj10T3MbtwGaRlpvJtdf85GbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCWwXwTyx7RtZqjhTJB6UC0LclDIzGr1td0zlHc8rj5w&oe=6B04780D"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9292047437566724"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2134095923857720"}, {"status": "PUBLISHED", "id": "1363050735813967"}, {"status": "PUBLISHED", "id": "1064432649312376"}, {"status": "PUBLISHED", "id": "1042938968068273"}, {"status": "PUBLISHED", "id": "1368892811280159"}, {"status": "PUBLISHED", "id": "1353920963181325"}, {"status": "PUBLISHED", "id": "4242492772693703"}, {"status": "PUBLISHED", "id": "783974494048835"}, {"status": "PUBLISHED", "id": "1374034943684723"}, {"status": "PENDING", "id": "1065395252167661"}]}, "baseline_offer": {"id": "1374034943684723"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2134095923857720"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24737117792633105", "version": "2.0"}, "id": "30266299246301991", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary
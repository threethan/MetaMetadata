2"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GK9pCr7IAHEQ7kNvwEpxkH9&_nc_oc=AdkBAJh0MsEpaqRgyk9F3_e0VqCG0UvWgmIFi8FXv1leZkQvLGqpe9w10k3By0JIN9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJBm0QHNlOTzp98Ap1NjJzh9DEScqSmIMNDWxwPGiNVQ&oe=69A425A1"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQilj-FR3GIQ7kNvwHVH4Po&_nc_oc=Adlih4SReScHEmLIHADkCP3c7cuUjqBGSAAYBd4LTxcRfmUhbN_BfevvxQZ8K5Jo9pw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftVdxuNgD42z3QpinHvxD4C83MBBZvigGO6mgSk3aqJ2g&oe=69A41FF2"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C484K6x1Q1wQ7kNvwGcZCiB&_nc_oc=AdmMDkdH9CCNHc-1K3_JF4i0gSHpBXH0-ITWbhuF0u9ytIF1XZ2ySn1yvyU3oikQkbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuU2RKHH7kAXq5c7Y_LILO8cgG1SKTfVXG6TrcujpXHhw&oe=69A44065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt_SdTdjhQoQ7kNvwHzVU4q&_nc_oc=Adnpkxa4-DFLQQkezm98HbXirX7X0R3FHkP9kl2Z240oFr2Z0ruTwIe73ifDEa0HdHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvroQ2nskAeoPsaGfU-uN5NYNUCwLtTht2DiFOWeiagBw&oe=69A43F4D"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": 
ihtS1Kk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnGCHsKo0Q808njYxRbEpahurJvq8G0lh72GelbJ5c8Q&oe=6A71F112"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDgsXxx403YQ7kNvwHNdN1k&_nc_oc=AdqO-qLY7NaTmA1UlEVuSrakw-RMWFcV0e5BnOM--smOZdggOn3i1w6MCVj-XSq6FGM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGynVnV5Ha_t-YIzuLkUlqrYxrz8yiTWpvJVoqJSX2ceg&oe=6A71CFA1"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN0HDdwCMicQ7kNvwHbqTX5&_nc_oc=AdqmSeYqcxOUXFyICe1foVYp11RVl55H4MjvIuSRpEDU8fqJAha4iy5JwRN2aC3UQK8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIWPWeV_F665BxFCSGspM2MmDOMczJAU6C_aojBvCrBQ&oe=6A720232"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa_6-O5H7qoQ7kNvwFIzUcx&_nc_oc=Adq5FyfrxrcHC5GMTjL4-t45CwrkWRMOJCoLriKbCbik9DM8kRWtN-gaGQZcF08k6sE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnZeKOKx_1-ZwNRIETM_P01De0qe0bYuVkP1-tATTpig&oe=6A71EA65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-W91JmncRH0Q7kNvwG9qLoF&_nc_oc=AdqEaX2v666ZJOv7yM-IjtuXykQXvb6bf904KBYsxBoJC0_lVwnoIYUp_9m0vK6PGpw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7_4lznqXYxLMHHV2b7eGCmLUvrhyzD23Y_AIsY3u0Jg&oe=6A71E94D"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
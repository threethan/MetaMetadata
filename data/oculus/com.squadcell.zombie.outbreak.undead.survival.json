VEEzukw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afych2tjZeygBcAzPDyUaBWCyFLpxwTw42XhDk-S0W7PvA&oe=69C3EB12"}, {"file_name": "SS3_2560x1440.png", "id": "9883125508389729", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823291_9883125525056394_1263366162982901307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm20MU6zTUgQ7kNvwFIBzoy&_nc_oc=Adrb31fb1a6MvgWXT4YNoR8S-IyCFa2Z78BAUwSUaq7LpdEusR3617DhOqEr9Wti798&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5PHif04Xb0Il2LJe58IjY9sYAEaEptaJX97SDqx2nNw&oe=69C3C9A1"}, {"file_name": "SS4_2560x1440.png", "id": "1037693144544149", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499332540_1037693147877482_7052862078783752896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXP7WPOqzRIQ7kNvwFLBcgx&_nc_oc=Adqmr10k-65k5wrixwBEdxfrNPGfFAw_9ZNIl-mUPRzubu4cmiFN-k8Vs5nv9f5zays&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkgrlyrIDrOfJ4YsM6ogNKsO8t6Zx_O4QrdBuCqYrQsw&oe=69C3C3F2"}, {"file_name": "SS5_2560x1440.png", "id": "3928519540742726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827626_3928519544076059_25229743000280715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvrBCejp46YQ7kNvwEV26-q&_nc_oc=AdoUdGjRiEkmPZJQPwLDtD51EYbg7-J85aRHV6b7_Iv1q5tVmjl3PID2a1vk9t2KP20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJAKAC9x4CaZINbQDiVIfe2uh5aVjLki7hXaJMy_O-uw&oe=69C3E465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_04.png", "id": "883602167287724", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499326194_883602170621057_7928068393048340603_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHaNaYz2imAQ7kNvwEQx6z7&_nc_oc=Adpj_OnG0yD7uPzYWxDo6z4oVcgTNQHtAmAAoG74oKlSk3MdUR229YnJ06rjBYhEni8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvaF5xPzyLjD02jTKH-KwsunGLGiawwQWWiErDMMtWnQ&oe=69C3E34D"}, "display_name": "Zombie Outbreak: Undead Survival", "keywords": ["Headshot", "Apocalypse", "Gun", "Infected", "Shooting"], "long_description": "Enter a terrifying VR nightmare in Zombie Outbreak: Undead Survival, a fast-paced FPS shooter that throws you into a brutal apocalypse. The undead are rising in waves, and only the strongest survivor can hold the line. Armed with powerful guns like the pistol, rifle, and shotgun, you'll enter a deadly arena filled with evil, rage-fueled mutants on a mindless rampage.\n\nPrepare for intense combat as each wave brings a new surge of danger. You'll fire off endless bullets, land clean headshots, and fight to survive overwhelming hordes in the blood-soaked dead zone. This is not just a shooter\u2014it\u2019s a battle for humanity.\n\nThe horror is real, the enemies are fast, and the pressure never ends. Experience scary ambushes, horrifying close calls, and an ongoing blitz of attacks as you try to escape the infection. Every second is a test of your reflexes, and every deadshot is the difference between life and death.\n\nSurvive the rush and become the last survivor in a world consumed by the undead. Can you fight back, conquer the outbreak, and live through the zombie nightmare", "short_description": "Get ready for an intense and immersive VR zombie shooting experience. Grab your guns, load up your weapons, and prepare to face wave after wave of bloodthirsty undead. With realistic reloading, heart-pounding action, and terrifying horror elements, every moment keeps you on edge. Hunt down zombies in dark, dangerous environments where quick reflexes and steady aim are your only hope. Survive the nightmare\u2014if you can."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squadcell.com/privacy-zombiebreakout/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
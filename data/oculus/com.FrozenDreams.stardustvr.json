pD900JtDmHDo17_mCueXzkfhLYvEsLsCew&oe=69C7D818"}, {"file_name": "migrated_image.png", "id": "640687753418054", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982456_446245599452244_4197401049377538048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHNNwa1xlUsQ7kNvwGKBars&_nc_oc=AdoRXavbKapAdYA5eT9clEJxptgd2X20mb80vrx9XS5tSzivdCKxQkEXxCgIq4510Ro&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2irz9q3zVzQ4bERQcNBz4MihvXV0NuM8xqZ2Sh27qoQ&oe=69C7E56E"}, {"file_name": "migrated_image.png", "id": "2303722323063826", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974488_304158150238531_2142390877643866112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlE7fsSroPMQ7kNvwG7CzMI&_nc_oc=AdpFJNE62CfQ6hWP2kdhpxvUPbAixktkPLm-CJ9ql8Ow-XmwdAFb0q0sLY9aRK4Nd5c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXTHmMvaYeKblRFQM-UDV7ZbwgdzbM56VwihhpupJRrQ&oe=69C7C874"}, {"file_name": "migrated_image.png", "id": "2591981187796317", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974695_223776775159195_4083746396430139392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUfXVC3Uf30Q7kNvwHXqFQ7&_nc_oc=Adqaoq8xXSdpDGtHd3iln-_1iePhEtjBs7WMlYbxd6mSw7L_2ufGgULpsfMFp8gllVI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbU5ZUxgsBH4HzVYAq99wpJL8dILI45dUv1HR9S7TasA&oe=69C7DECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/EubP8V", "id": "2087366838055638", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982503_2087366841388971_5104657159161905152_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFM7wVWOHrAQ7kNvwEh4jkG&_nc_oc=Adp-cEuOLvh8EgcRAlZlIJTNYq3hTCfjP3TLBhXzksXF2CoJhrtWhBo-oKjZcwwWyaQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWHdqGliuqKey1FeNCPAYhajWlJIffOPh1yoaewZBhsg&oe=69C7D3C7"}, "display_name": "Stardust  VR", "keywords": ["stardustvr", "stardust", "invaders", "hunt", "space"], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://stardustvr.blogspot.com/", "publisher_name": "Frozen Dreams", "support_website_url": null, "website_url": "https://www.facebook.com/FrozenDreamsStudio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPACE_UNIVERSE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "suppor
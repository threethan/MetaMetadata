4", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031316_276878853981747_3341884811692824159_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEhdFBtkAtIQ7kNvwFHGxNn&_nc_oc=AdpySJXlixXYjINMPrmokEjhgMcaJmAQ0QN-lpKF61S_nRB_SrnixVuajhN-wfSpwJM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlsR3bY9f0Z00-MyD_q_SFENY626r-wR4Ps2Yt2LAH2Q&oe=6AD0F20D"}, {"file_name": "1.png", "id": "901185103949252", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974483_901185107282585_50090715938871000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u968C06iNUMQ7kNvwFTXS_j&_nc_oc=AdqFe7hJurTxISQhigWqMQYpawYSn9a1Dy3gDTtny83FY8i4FfO40t1ZbzrVYHU_b-E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3_E9MniV_Fidl1Z9dvyPi93BqMXp2Cjgf87Th4geLpA&oe=6AD0FDE9"}, {"file_name": "4.png", "id": "798973210970182", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031316_798973214303515_8055699543229581816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAXATa3nvLgQ7kNvwFThx1y&_nc_oc=AdonqYjq98lLiSI1sjjYkfYZyE49FrJDi6iMerhndz1FgOQ6kW1Agx7nMRN97XsM6PQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgdjh2PGgQvCN6JAtzLBTJye6tsxGY6NCqHNjCvPNiYg&oe=6AD0FCFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sc5.png", "id": "837554776972266", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566688_837554780305599_3304335037390196041_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0qH7QJ74G0Q7kNvwEKw3i_&_nc_oc=Ado2muv1yHM7-zgaRvFxwiMYxct49YOCwqEPZPr-0MxiqKYgRSNUXkO_H-j9O8PK7yU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn6g6VwG5dZsTM4hC4qFSPEL_K6Y5_oOrnm1mKQP8xWg&oe=6AD0D3B5"}, "display_name": "Stardust VR", "keywords": [], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade, set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": "http://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "http://frozen-dreams.com/contact/", "website_url": "http://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RELAXATION_MEDITATION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
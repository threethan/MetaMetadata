03q7Ge7PaJPsQLvGjCST79Ca2jgu7bbzhA&oe=6A50F418"}, {"file_name": "migrated_image.png", "id": "640687753418054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982456_446245599452244_4197401049377538048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp4q5OnSjEEQ7kNvwE7jIVt&_nc_oc=Adp0eIXkMZEIfA-tF39qkxNY-WycFrVrqcPJi7FXN4yqAjqPhMOBsecC2pJEMrcU7h0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5xsFjDyMJ3uYz-eVa3EV2eSXIcL37FAqpRSFcQ-YcbQ&oe=6A51016E"}, {"file_name": "migrated_image.png", "id": "2303722323063826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974488_304158150238531_2142390877643866112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s9kzFD6x2oQ7kNvwFBxTkR&_nc_oc=Ado2ZmPc6fg7dlfZTKqE-4NZjN0M-IcqP8IfXsvWqX5foy6VtkLgg111GWGvA0bSOuE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnWy_G4Mt5emm416uLzB3szlB-xY2XnbCulTnnu4qMzw&oe=6A50E474"}, {"file_name": "migrated_image.png", "id": "2591981187796317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974695_223776775159195_4083746396430139392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDKXrOfHNE4Q7kNvwEghHct&_nc_oc=AdoN4-yHoirjP1lt57V8ozQJCVXxPaIG92H597VbenkEOukL1-_eGL5Ps7R3vUFqd84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0vGFpr4iwzkZevKF7tW1HlHjf0ZZfz5x8hRHIj1Dc0g&oe=6A50FACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/EubP8V", "id": "2087366838055638", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982503_2087366841388971_5104657159161905152_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQVhPM8a4NMQ7kNvwHDVLkc&_nc_oc=AdoXEvLm72Uj1Umhgc9QBUo5DRNUSBp_-Y68TpinDYm_lo9FyiOQtaspPuqjHmB3D7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuUJswis9i4ZRJBUW42um6Z_R2_C7n7azcIfnXc_hQGA&oe=6A50EFC7"}, "display_name": "Stardust  VR", "keywords": ["stardustvr", "stardust", "invaders", "hunt", "space"], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://stardustvr.blogspot.com/", "publisher_name": "Frozen Dreams", "support_website_url": null, "website_url": "https://www.facebook.com/FrozenDreamsStudio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPACE_UNIVERSE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "suppor
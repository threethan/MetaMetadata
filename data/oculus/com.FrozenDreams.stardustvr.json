c_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kg9a5tZFG__A-4g4Wv9z-Zz-RYKix5Xr1pLbpGq00UQ&oe=6A0DD587"}, {"file_name": "3.png", "id": "276878850648414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_276878853981747_3341884811692824159_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxajnJn4-j4Q7kNvwGf2tGQ&_nc_oc=AdqNhEbKyHwWKDYSYhPVnpDSG05RgYAiIEqx7Q19AoaA94DSir9iLDT8jb7ql1bc6II&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YE7QaHEgPve8wF29TK4ELmn28DnYGg7DtmxP5efnIsQ&oe=6A0DD40D"}, {"file_name": "1.png", "id": "901185103949252", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974483_901185107282585_50090715938871000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIz7LudPT7EQ7kNvwFrPGlr&_nc_oc=AdopZ7l6VBqldkY_LGMN27zn9Kh1ttPMo6DY5iSqJ6VHtB9BZiW12lFkRhR9vd86WpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7txWxdYW-fnpJC1r6UclvQr3gQxHr-usWzVmorhncK7g&oe=6A0DA7A9"}, {"file_name": "4.png", "id": "798973210970182", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_798973214303515_8055699543229581816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAGnr6j9kzsQ7kNvwGAAIfw&_nc_oc=Adqt4LWcNtD3hqWGaN8daTEMD0dcdDGRTfr5cVJ2h5pTzSeiQGDV8qYalAq7c9KFypQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YU7IhamggQIdHY-cun0AHOpvg5uVt7OBezb82AYLBLA&oe=6A0DA6BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sc5.png", "id": "837554776972266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566688_837554780305599_3304335037390196041_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4JSKMORGWMQ7kNvwFM9HYj&_nc_oc=AdrrLH45fp1E0GMn33YDXfZ026lJJyJoQ7VVI_OPStMRkJEnMqstWkCXNsfWR_t7uXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ICREKuL3Exnu_x4yNYYELZcFQ-1Mb6IP9qfWTb8q6Mw&oe=6A0DB5B5"}, "display_name": "Stardust VR", "keywords": ["stardustvr", "stardust", "space", "invaders", "arcade"], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade, set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": "https://frozen-dreams.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RELAXATION_MEDITATION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
4", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031316_276878853981747_3341884811692824159_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEhdFBtkAtIQ7kNvwF0sxb_&_nc_oc=Adr48RUMZCVtSmJCr4i4T32p5hZdxK_OXJUm6WSFyH-2mj1y8nJGaCbFOz_UnjIH91Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXf-tWYkVJaKcAa7DnwSOjnCniWWdtMHgPruZFWVF9VQ&oe=6AD3950D"}, {"file_name": "1.png", "id": "901185103949252", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974483_901185107282585_50090715938871000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCKb5BsN4pIQ7kNvwELtIOP&_nc_oc=AdrDR053jwFgfCNhdf96QNDFyh-Z3QpWwLk8l2P17OfzjVjML7SOFl9gvaJwPnhXMaw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBBF9w4eG7pRoKiEoI-yAL_Ofhn-Px1txFk32WVx9wtA&oe=6AD3A0E9"}, {"file_name": "4.png", "id": "798973210970182", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031316_798973214303515_8055699543229581816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpZ99gcwb6sQ7kNvwEHRQ0-&_nc_oc=Adrn4LFFhDIMuiR2mM7vGFtZOLjQKuCwa8ZV9MgGXS7LwvQzxPtBtonta9qGN6M9CsQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNWTX7egiU6l5wxkbl6vrSgjzJcgM4NSNbuqrYBetk9g&oe=6AD39FFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sc5.png", "id": "837554776972266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566688_837554780305599_3304335037390196041_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a03HPvpe8MsQ7kNvwEG7Tpx&_nc_oc=Ado_mOSMUH538MtxEAFuK9o-tMY6bPDsqXFJL8bn1C37EhlsKfFZALcZmeWko0QIE60&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgKhkkMKyxbbLY_BYnqRfwADh2fBigEJgyLS3sYxbo8Q&oe=6AD3AEF5"}, "display_name": "Stardust VR", "keywords": [], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade, set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": "http://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "http://frozen-dreams.com/contact/", "website_url": "http://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RELAXATION_MEDITATION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
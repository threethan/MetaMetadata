cCylX6OL2kmIZHPagqVNqpwh4fUw8helCw&oe=6A047D18"}, {"file_name": "migrated_image.png", "id": "640687753418054", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_446245599452244_4197401049377538048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oto07k0RQZIQ7kNvwFubTid&_nc_oc=Adrut3sGEnCKGwSsZ5FIg90n8HyZNat4pV-G5gfh6d6PfO3JDzaiq74ybBk6pW1RUYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50_52Zvb96FuZEmAMn6W34a2dwxphJObXDLMF_UM7pKw&oe=6A048A6E"}, {"file_name": "migrated_image.png", "id": "2303722323063826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974488_304158150238531_2142390877643866112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIEKAAhYKCQQ7kNvwGogwJQ&_nc_oc=AdqPEMGNca8XQuE02z0xtZmgFpP5ryvxblO3a9OtMjF4aqoNUlIa4qi8oKMS09FPaCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PDs5qlnTmqwuhBxziqAJbQ131Ywyds2_vNZhpEzfwoQ&oe=6A046D74"}, {"file_name": "migrated_image.png", "id": "2591981187796317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_223776775159195_4083746396430139392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-ipdwHHMP8Q7kNvwFKgE9m&_nc_oc=Adp7i40iH64vSX3M_dUo23hbet8TWHaDxU2a1h0-3PyKASWpdDqmO2TH91_8WXH2CFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nQXcGK5ABgtstgy5mSkVwHtZPfpyIyYVz2OTeRKhsRA&oe=6A0483CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/EubP8V", "id": "2087366838055638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982503_2087366841388971_5104657159161905152_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS8DXaq_ZF8Q7kNvwGBmmYp&_nc_oc=AdrGZefJQBiPYXxHgJ1u1dBrLwal8Xn6H8lodZxkTSeZtZsWQJLpxseVpVydvscEbsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SZmoHCZpUcd1q-oSDsUYCkMZLgWui1gJJsceOoEuCBQ&oe=6A0478C7"}, "display_name": "Stardust  VR", "keywords": ["stardustvr", "stardust", "invaders", "hunt", "space"], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://stardustvr.blogspot.com/", "publisher_name": "Frozen Dreams", "support_website_url": null, "website_url": "https://www.facebook.com/FrozenDreamsStudio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPACE_UNIVERSE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "suppor
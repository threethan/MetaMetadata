4", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031316_276878853981747_3341884811692824159_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKKc-i4zr8IQ7kNvwGvEQU8&_nc_oc=Adr49jCoHvmZdNx2NPJItnvbMrKW_CVtzHKiUG0SirJvO4cEyRnK20wddayF9EvbcYg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEnUrfZgHaqGmJ2CG6xyn0CHKKMl4TMMoUytr-uzR4Lw&oe=6A58F98D"}, {"file_name": "1.png", "id": "901185103949252", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974483_901185107282585_50090715938871000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZugBr4UP3FEQ7kNvwFEFOcQ&_nc_oc=AdozgzXgG3nFqMMggTwe2iQaEBVrVf3axW9_wK8IP7PlQjNavUqeXkm3W19LNzbMYs4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkga0pJBa5WIHZSREtNFVcOEq6hRBbeESbIGJ0fQcOBw&oe=6A58CD29"}, {"file_name": "4.png", "id": "798973210970182", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031316_798973214303515_8055699543229581816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4JKgGaOB2sQ7kNvwEUy8gK&_nc_oc=AdoV_BAK6pZb2TVwW9OFSYZU_YryQucersAwHRGOxKqVnORh_XySsYYld2Tv7tXyfVk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6wNZhVA6iaL-T8DiJpvSlSkw1-kic4TUbB5q97AvuGQ&oe=6A58CC3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sc5.png", "id": "837554776972266", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566688_837554780305599_3304335037390196041_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp99w2enQo0Q7kNvwHkXOKt&_nc_oc=AdoRllujy7DkcHkR9fdr2-Mn8FstZMkIfwBc5hgHedRH9QDSTULglSAz-YShqpUmbs4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9KdG2yDGFYR5-a4DWuILxSWwBOKZAm1qabzZmeVOuRA&oe=6A58DB35"}, "display_name": "Stardust VR", "keywords": [], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade, set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": "http://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "http://frozen-dreams.com/contact/", "website_url": "http://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RELAXATION_MEDITATION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
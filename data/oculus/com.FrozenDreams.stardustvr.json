H-5zxeRm2pR3MlNh7YUFKhH1vGi_pB3IzA&oe=69D8FB98"}, {"file_name": "migrated_image.png", "id": "640687753418054", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982456_446245599452244_4197401049377538048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0cixg5tc1oQ7kNvwH1B4Ac&_nc_oc=Adr_dQW6MN3w_tU_GZLAqjovAL33DC11r89h4dlh4AE8y3OQ7hXvjPjMK7ty706ae5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DMXQmhJ9jpue30iD07Mi8pM3TVostz2DVdrfApMvsKw&oe=69D908EE"}, {"file_name": "migrated_image.png", "id": "2303722323063826", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974488_304158150238531_2142390877643866112_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gwm_Hu5IT0Q7kNvwEBkY2m&_nc_oc=AdqcwKpbNXE81yT1EAo_-kj0cssONM4PNe5ox4TLJoC7KdUec2v4e4OxruowTc0ZdJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c9qWUCg68L-L2JHtO7rb1BST8ZQbZP0ORhX2i-eXVJQ&oe=69D8EBF4"}, {"file_name": "migrated_image.png", "id": "2591981187796317", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974695_223776775159195_4083746396430139392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-xlbBvUDk8Q7kNvwFyeueT&_nc_oc=AdrUaBVb2Qo5EHw81nndWwqObfm5P2sxf1v38d6tYrBOk17fzjb3kIv2asDf9Mon30I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eS7VYGiyTZtNqZ9kLjqZDTXhOS7VMAKSdRWH425hfCg&oe=69D9024C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/EubP8V", "id": "2087366838055638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982503_2087366841388971_5104657159161905152_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWEpiG9Ei8cQ7kNvwGwI-EF&_nc_oc=AdqKCYHrbkGgoDmnivnjbpkw25-cDAE6F3-YzEOro-N16wyZQOQNwqWuryDGU_P8qgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Uj37kyD0YJ6OsX_3U1p4uOpz3kMOcM31v1NKGF4FCsQ&oe=69D8F747"}, "display_name": "Stardust  VR", "keywords": ["stardustvr", "stardust", "invaders", "hunt", "space"], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://stardustvr.blogspot.com/", "publisher_name": "Frozen Dreams", "support_website_url": null, "website_url": "https://www.facebook.com/FrozenDreamsStudio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPACE_UNIVERSE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "suppor
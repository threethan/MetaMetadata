pe.png", "id": "874252664334141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_874252671000807_5225512976023718740_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=6QQKtcocAawQ7kNvwFlHH46&_nc_oc=Adr1-2SeLWxhMILNh91BMivizMztRGcccT7wTVusVGFbz96TX14vBvhV6XIYsi5sDug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19QZ4bT7AuS4JCkqRhh06O5IJCkOvXxL67ddCllg4M5Q&oe=69D3943B"}, "display_name": "Stardust  VR", "keywords": ["stardustvr", "stardust", "invaders", "hunt", "space"], "long_description": "Stardust VR is an action game inspired by the classic Space Invaders arcade. set in a relaxing and charming world.\n\nYou can play in solo, co-op, or versus modes with a friend in this competitive shoot-em-up.\n\nThe game is set on a beautiful floating island where you prepare to shoot and dodge furiously as you blast enemies into space dust!\n\nStardust VR features three main gameplay modes where you can either play solo or co-op with your friend against waves of enemies in a bid to climb the world leaderboard. Or you can play versus mode where both players spawn enemy waves against each other!\nKey Features :\n-Binaural 3d sound.\n-Physics gameplay based mechanic gives the game unique AI behavior.\n-Defend against, and spawn your own, waves of creatures to defeat your opponent.\n-Tactical elements where you decide when to gather resources in your bid to defeat the enemy!\n-Interactive visual based on the BG Soundtrack!", "short_description": "Stardust is a VR action-relaxation game inspired by the classic Space Invaders arcade set in a relaxing and charming world. Play solo, co-op, or PvP with a friend as you shoot, dodge, and create black-holes along your way to the top of the world leaderboard."}]}, "developer_name": "LastnOni", "developer_privacy_policy_url": "https://frozen-dreams.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": null, "website_url": "https://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ARCADE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8143764755721863"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982589_2259681444350663_8271037664023543808_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQsvbetowhsQ7kNvwH22D3I&_nc_oc=AdoQDvuONpuPxu_bEQoCAWz0PbJ5mnzXo-yPO86YSOLs5Zeryaojz1e5JS9APJSjBE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KZa3QEx1XlfNHIeHAo-R14HgokTEWLCTVn15pAuFi1g&oe=69D3ABF6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stardust  VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1555002000, "lastRevision": {"nodes": [{"id": "2227497620863617", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1864040280361040", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "229878757911861"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "3106474149404894", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974885_1029459353913128_291635172820910080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_
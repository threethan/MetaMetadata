U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MXbgZYXsadVGpzQryS0nNLtm1zDR9YflujA_70mv8zg&oe=6A11B963"}, {"file_name": "Meineke Screenshot.png", "id": "2435019233612653", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618442_2435019236945986_5404048424603962895_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhIetdEUBl0Q7kNvwEIlFrt&_nc_oc=Adrm0u-Jl6Emzahxe6FvUidZTR2Cek6qG7Nwnt1RGCeq2uvjVCGGKwxoRwUEFN9KCxc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af496az-C7KBRcerAguldSGEQJVyr2XZxk4TsRoj459_3Q&oe=6A11CA57"}, {"file_name": "95fde190-abab-40b2-92a6-af379e201095.png", "id": "26419675210971840", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499617850_26419675214305173_4525107205694305381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TdIjGh_sNEQ7kNvwHVfbW6&_nc_oc=Adpni6yw0tVWaLOvfchugQ014HbdoB7XFIYAIHImCQtvLhrMZ14vzQhUfJdusOYANcM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m7kqlNz3VBSnDRhW_aqvfBBHUJgMt1QbnYIduCXF28g&oe=6A119B16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Customer XR Showcase", "keywords": ["Business", "showcase", "retail", "fire", "customization"], "long_description": "**Included Experiences:**\n\n\ud83d\udd39 **Kitchen Saver \u2013 Kitchen Customization Experience**  \nStep into a stylish kitchen environment and choose your ideal cabinets, countertops, and color combinations. \n\n\ud83d\udd39 **Bath Fitter \u2013 Bathroom Customization Experience**  \nExplore a modular bathroom setup and choose tub styles, fixtures, and finishes in a free-form environment.\n\n\ud83d\udd39 **Egress Pros \u2013 Fire Escape Simulation**  \nUsers experience what it\u2019s like to navigate a fire escape scenario using the Egress Pros Fire Escape Window. \n\n\ud83d\udd39 **Meineke - Oil Change Experience**  \nThis experience puts the user inside a Meineke Garage where they are able to learn the fundamentals of changing the oil on their vehicle.\n\n\ud83d\udd39 **Pepper Lunch - QSR Hot Plate Training**  \nCreated to showcase the power of immersive technology in QSR training. Step into the Pepper Lunch Kitchen and prepare a signature hot plate dish!\n\n\ud83d\udd39 **Koala Garden \u2013 Front of House QSR Training**  \nDesigned as a proof of concept, this interactive training module showcases customer service interactions with a real-time Artificial Intelligence powered person. ", "short_description": "This showcase brings together our most impactful and innovative XR experiences across a range of industries\u2014all in one easy-to-navigate VR app.\n\nDesigned for professionals, clients, and curious explorers alike, the Customer XR Showcase lets you dive into powerful simulations that demonstrate how immersive technology is revolutionizing the way companies connect with their audiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.customerxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Customer XR", "support_website_url": null, "website_url": "https://www.customerxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25471666415793787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391901_1875753276608993_3372820865344412800_n.png?stp=dst-p
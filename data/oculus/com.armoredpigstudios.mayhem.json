0"}, {"file_name": "S3.png", "id": "1825703161806088", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622195_1825703165139421_972285996073161253_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJwx-VzPTukQ7kNvwEJiqSw&_nc_oc=AdrGxvPIFlpqA8M4REn0nn_-9C94Un8nMQwWEYY0_0KLZcJ6aOXvDF4IsKQa0RPdX20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcsYh2EmxP0IyhFR8yZVfUrVOYXW2wQDa0m2Hp_Ftaeg&oe=6B0B21CC"}, {"file_name": "S5.png", "id": "2326101271488346", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623131_2326101274821679_1100299904389205392_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDiYhLxfHFsQ7kNvwEtxDpN&_nc_oc=AdpBMrWncHuJExYi95WKbhcIYaNiBhXBKcE2-koDXN14Epj2bU1M9bTR_deb4ong-es&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRg9VTZQ9M28IkCNOjojXq16dyHBwu5bWPD1__ufeYouQ&oe=6B0B2804"}, {"file_name": "S2.png", "id": "1104772535251286", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624583_1104772538584619_9103691565650066295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOCX2btWHrgQ7kNvwG85yOx&_nc_oc=AdpQTJpT5OCYWuPWxyiJFxc-pQogFOttjyd8PTjndNdLnV_L15NVJYe-7S_PCUmfhSg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwBfFqd9J2gHr5j58nhPxdenTAQf1T4r-ENwcYu4SaXg&oe=6B0B1B1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DevastationCover.png", "id": "1661810402624222", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624395_1661810405957555_3846391497172594379_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExCoqD2DlOwQ7kNvwF_SBGi&_nc_oc=AdqLOaPMQZEOje3G1IUTqUEu5vJTew8GgdhITld2Q4YNu9G0rSqOksLVrXocbuGWslQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8ROKTprb4EMBjNSokgTp2BDubBa-fFl__r7tvQQflVg&oe=6B0B1205"}, "display_name": "DEVASTATION : Physics Sandbox", "keywords": ["destruction", "sandbox", "destroy", "plane", "physics"], "long_description": "**Shoot out the supports. Watch the tower fall.**\n\nDEVASTATION VR is a destruction sandbox. Everything built breaks into chunks, buildings collapse when their supports go, towers topple whole and fire spreads.\n\n{1870440010621626}\n\n**BRING IT DOWN**\n\n- The Annihilator laser cuts through buildings\n- Railgun, tesla gun, black-hole launcher, scoped sniper\n- C4, napalm, cluster bombs, airstrikes and a nuke\n\n{1115862900840160}\n\n**START A WAR**\n\n- Red vs Blue: about a hundred soldiers in squads, with tanks and jets\n- Cops vs criminals vs the mafia\n- Join a side, or let them fight each other and you\n\n{1140646251981536}\n\n**15 MONSTERS** that fight everyone: Gorgonzola, King Chonk, Cthulhu, Mothzarella, a T-Rex and more.\n\n{1265734195738551}\n\n**17 VEHICLES:** a tank, a mech, a jet bomber, a wrecking crane, a bulldozer that plows through houses and the Fatcycle, a bat-bike that flies.\n\n**12 BIG MAPS:** an Airport full of airliners, a Theme Park, a villain's volcano, Prison Island in a storm, a Moon Base in low gravity and more.\n\nPlay solo, or in private co-op by room code with voice chat. Late-90s console looks, on purpose, and an original breakbeat soundtrack.\n\n{1077130995150913}", "short_description": "Shoot out the supports and watch the tower fall. DEVASTATION VR is a destruction sandbox where everything built breaks into chunks, buildings collapse and fire spreads. Cut through walls with a laser, drive a tank, fly a jet bomber, then set off a nuke. Set two armies at war, turn Gorgonzola or King Chonk loose, and wreck 12 big maps, from an airport to a Moon Base. Solo or private co-op with friends, in retro late-90s console style."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathr
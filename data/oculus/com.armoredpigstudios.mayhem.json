g?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6qTPkPHzi4Q7kNvwGr137T&_nc_oc=AdqehmB6B3A1xTPAjVjzXK9WLsi5TqkbAuNygAWDrQlfP7rmObc-iDiawQWhFxrN_xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQFg4d9uGD419QcazLQZmDrejIxKzA4XPqGdJ-FfUlTA&oe=6B0DB4F0"}, {"file_name": "S3.png", "id": "1825703161806088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622195_1825703165139421_972285996073161253_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4XfW4hLtecQ7kNvwFZF-8f&_nc_oc=AdqCzfe-mRYcPryH1euFA8hUtERA5IQZ1dzmGh2Javak0w6hOt6KqqXvLjOyADtv9KU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUgHy1qCbhNsrQYvDE1Dil7dHrfJcB-FxIzeXf_ErZVg&oe=6B0DC4CC"}, {"file_name": "S5.png", "id": "2326101271488346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623131_2326101274821679_1100299904389205392_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDiYhLxfHFsQ7kNvwEsAwGJ&_nc_oc=AdpaD1Nv18-Tol2qGegX5IqDGZwRH0m-JaUXEX5psEnrWvmuOoQM8JJfjFeUhQvSMec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwIDRpBTvszdJ5DgsAR7vJALsntldnUmWK8RjKChte0A&oe=6B0DCB04"}, {"file_name": "S2.png", "id": "1104772535251286", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624583_1104772538584619_9103691565650066295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOCX2btWHrgQ7kNvwE9Aq3l&_nc_oc=AdqHfJrgmTsmcwjsDtzvU6OcijeoO-Ml3zTtbc8wD2uSFu13o2M4MOyyZdbqYacyM64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDldxfifvztcMzCv5PHZqME0sqon0-9SlpAzzOlM6zqg&oe=6B0DBE1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DevastationCover.png", "id": "1661810402624222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624395_1661810405957555_3846391497172594379_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNX84rDzYIIQ7kNvwE68Q92&_nc_oc=Ado6eYFRCFlX40OCxu3BoQau3h2xQ8wdTPrCbRMwcKrjpRXSMCbFZIWv8bAsQKcRrpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREcBR0vycafoz5IwZkMD0FGySaj5p_JVVZut8HuTjWCA&oe=6B0DB505"}, "display_name": "DEVASTATION : Physics Sandbox", "keywords": ["destruction", "sandbox", "destroy", "plane", "physics"], "long_description": "**Shoot out the supports. Watch the tower fall.**\n\nDEVASTATION VR is a destruction sandbox. Everything built breaks into chunks, buildings collapse when their supports go, towers topple whole and fire spreads.\n\n{1870440010621626}\n\n**BRING IT DOWN**\n\n- The Annihilator laser cuts through buildings\n- Railgun, tesla gun, black-hole launcher, scoped sniper\n- C4, napalm, cluster bombs, airstrikes and a nuke\n\n{1115862900840160}\n\n**START A WAR**\n\n- Red vs Blue: about a hundred soldiers in squads, with tanks and jets\n- Cops vs criminals vs the mafia\n- Join a side, or let them fight each other and you\n\n{1140646251981536}\n\n**15 MONSTERS** that fight everyone: Gorgonzola, King Chonk, Cthulhu, Mothzarella, a T-Rex and more.\n\n{1265734195738551}\n\n**17 VEHICLES:** a tank, a mech, a jet bomber, a wrecking crane, a bulldozer that plows through houses and the Fatcycle, a bat-bike that flies.\n\n**12 BIG MAPS:** an Airport full of airliners, a Theme Park, a villain's volcano, Prison Island in a storm, a Moon Base in low gravity and more.\n\nPlay solo, or in private co-op by room code with voice chat. Late-90s console looks, on purpose, and an original breakbeat soundtrack.\n\n{1077130995150913}", "short_description": "Shoot out the supports and watch the tower fall. DEVASTATION VR is a destruction sandbox where everything built breaks into chunks, buildings collapse and fire spreads. Cut through walls with a laser, drive a tank, fly a jet bomber, then set off a nuke. Set two armies at war, turn Gorgonzola or King Chonk loose, and wreck 12 big maps, from an airport to a Moon Base. Solo or private co-op with friends, in retro late-90s console style."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1457728102529886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771264_1188339890376712_3874022034479529365_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRoYPl-I61oQ7kNvwEyiV1a&_nc_oc=AdrbMW6Tia_9xOsxXLiVonYA2kwJeG55CeY873dyrk1b41yBQM0iRZiW4YqNA2Cjsto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6yxD9KVYFcVN22wXeltRKeTbYsyrRZ5KW7RVeiJ6WRw&oe=6B0DC5D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DEVASTATION : Physics Sandbox", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting",
0"}, {"file_name": "S3.png", "id": "1825703161806088", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622195_1825703165139421_972285996073161253_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4XfW4hLtecQ7kNvwFA98wl&_nc_oc=AdqNUoNOLfhyutv98P2OsZ68Q91gyd11UKXGGvRKM7wLHsCva8hFSQMRkYVLuxaDnj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXU3G08D8SPzJy2lUQSaN5HVyyYgQkWhKb-OSw1O75qUg&oe=6B0F164C"}, {"file_name": "S5.png", "id": "2326101271488346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623131_2326101274821679_1100299904389205392_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX-T589o7v8Q7kNvwGJgLJI&_nc_oc=AdrEBJ0de3YtoiAlARH0Hv2gRakbzJQEs0C9nDaV9gL853feRbzR10b2gsxzb_ob4gg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_9xn2F0VnPzANZSxAwqW5bd_fhvMlinOeyk9ZZsQY7g&oe=6B0F1C84"}, {"file_name": "S2.png", "id": "1104772535251286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624583_1104772538584619_9103691565650066295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd_MuxpAOLQQ7kNvwFBZnkR&_nc_oc=AdpXjX2SMykTuLG6YvuDVNUvk1FJbLLYEMim5bRSrwF7Lggh3mAzTMCp4JYpwOcb9Q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWBSt7A_LquWXN5AElo4Bwag1v6huUTTaVvv_7SKo1RXw&oe=6B0F0F9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DevastationCover.png", "id": "1661810402624222", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624395_1661810405957555_3846391497172594379_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNX84rDzYIIQ7kNvwGgNsTy&_nc_oc=AdpVwOddfF0UNxCIvFfm8V_gnEIZwDI-HXaIGYDVNjU4DtB-QInfKYNsZ9Fs6rGGWS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXinIIRz3H59Z7pNrbDGWre2Hl0ALePm7V6h5WjyZl0EA&oe=6B0F0685"}, "display_name": "DEVASTATION : Physics Sandbox", "keywords": ["destruction", "sandbox", "destroy", "plane", "physics"], "long_description": "**Shoot out the supports. Watch the tower fall.**\n\nDEVASTATION VR is a destruction sandbox. Everything built breaks into chunks, buildings collapse when their supports go, towers topple whole and fire spreads.\n\n{1870440010621626}\n\n**BRING IT DOWN**\n\n- The Annihilator laser cuts through buildings\n- Railgun, tesla gun, black-hole launcher, scoped sniper\n- C4, napalm, cluster bombs, airstrikes and a nuke\n\n{1115862900840160}\n\n**START A WAR**\n\n- Red vs Blue: about a hundred soldiers in squads, with tanks and jets\n- Cops vs criminals vs the mafia\n- Join a side, or let them fight each other and you\n\n{1140646251981536}\n\n**15 MONSTERS** that fight everyone: Gorgonzola, King Chonk, Cthulhu, Mothzarella, a T-Rex and more.\n\n{1265734195738551}\n\n**17 VEHICLES:** a tank, a mech, a jet bomber, a wrecking crane, a bulldozer that plows through houses and the Fatcycle, a bat-bike that flies.\n\n**12 BIG MAPS:** an Airport full of airliners, a Theme Park, a villain's volcano, Prison Island in a storm, a Moon Base in low gravity and more.\n\nPlay solo, or in private co-op by room code with voice chat. Late-90s console looks, on purpose, and an original breakbeat soundtrack.\n\n{1077130995150913}", "short_description": "Shoot out the supports and watch the tower fall. DEVASTATION VR is a destruction sandbox where everything built breaks into chunks, buildings collapse and fire spreads. Cut through walls with a laser, drive a tank, fly a jet bomber, then set off a nuke. Set two armies at war, turn Gorgonzola or King Chonk loose, and wreck 12 big maps, from an airport to a Moon Base. Solo or private co-op with friends, in retro late-90s console style."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1426245009011529"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1693982285676641"}, {"status": "PUBLISHED", "id": "1827771331983777"}, {"status": "PUBLISHED", "id": "1593450472467857"}, {"status": "PUBLISHED", "id": "1765012014558958"}]}, "baseline_offer": {"id": "1693982285676641"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794574560, "status": "PUBLISHED", "id": "1693982285676641"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1461791305456899", "version": "17"}, "id": "3287754514758736", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1426245005678196", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1461791305456899"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3287754514758736"}]}, "change_log": null, "created_date": 1795678862, "id": "1461791305456899", "version": "17", "version_code": 17, "re
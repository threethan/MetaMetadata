-lga3-3.oculuscdn.com/v/t64.5771-25/491821194_1172496414717418_1019889730660413869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCXctclWbYcQ7kNvwHgPK94&_nc_oc=AdqJW4S6Ff2QyBe078iVLceZz6AgLxzDTEodpKNHKRh809ASHQhAtVTcfroDaOGAf98&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClVghIiC59ur2DqtAIqPhRSIQ1r_hlINPXPCM2HKAEMg&oe=6A4E69F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 HORROR DRIVE WIDE POSTER.png", "id": "1533927714266926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820559_1533927717600259_7571811738388714825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKeS2qdL8ZEQ7kNvwHZfUN5&_nc_oc=AdovBUjaZbtsgQoaHic5orSyQnmDAORognbw5fb9JJw8fBq2cUtNhdDrWCQfAejZymc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHW4IOzdsG-W3Nvi2uJcwc9Mxrqb7cagAUIvi3X07TnQ&oe=6A4E43EC"}, "display_name": "1 HORROR DRIVE", "keywords": ["HORROR", "DRIVING", "SCARY", "HANDS", "XR"], "long_description": "Use your hands to grab the wheel and drive and shift in this controller free adventure.   Tune through your presets (rock, horror, comedy and more) while cruising through dangerous, dark roads.   Take a peek at your rearview mirror to look out for the stalker.  And shift into high gear to  avoid dangers like speeding freight trains and out of control tanker trucks.  But don't speed to long cause the law could be watching.  Can you  reach your destination or will this drive be your last?\n", "short_description": "A late night drive.  The law is watching.\nYou are being followed through dangerous, dark roads on a horrifying drive... to hell.\n\nController-free gameplay, use your hands to steer, shift and change the  radio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalportalgames.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DIGITAL PORTAL GAMES", "support_website_url": null, "website_url": "https://digitalportalgames.godaddysites.
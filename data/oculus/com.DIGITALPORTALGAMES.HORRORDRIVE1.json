-atl3-3.oculuscdn.com/v/t64.5771-25/491821194_1172496414717418_1019889730660413869_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LdLJR4rrC8Q7kNvwF37K1s&_nc_oc=AdpadiTKHF7I22N1lS6kYWSNZJwV6huI1StCdMVu2bV3UfkZONW3G_PlB_LBl0x0JJI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-EdzAoV5Lu5D7k762RXswDhtA5r608KRy1h97q5rvlg&oe=6A301771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 HORROR DRIVE WIDE POSTER.png", "id": "1533927714266926", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820559_1533927717600259_7571811738388714825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG9VSI0x2UQQ7kNvwGldh9Z&_nc_oc=AdoLNcUT4xR1I8Rjj67g2dKTWs9c_VPhSjgtLZN2xR4XN2tmRfhWwVTBIbGcRnazJd8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e2m6Vcn7Kq0dCbYQPEHagJFQ5DbR75CkShuKOzVDyVg&oe=6A2FF16C"}, "display_name": "1 HORROR DRIVE", "keywords": ["HORROR", "DRIVING", "SCARY", "HANDS", "XR"], "long_description": "Use your hands to grab the wheel and drive and shift in this controller free adventure.   Tune through your presets (rock, horror, comedy and more) while cruising through dangerous, dark roads.   Take a peek at your rearview mirror to look out for the stalker.  And shift into high gear to  avoid dangers like speeding freight trains and out of control tanker trucks.  But don't speed to long cause the law could be watching.  Can you  reach your destination or will this drive be your last?\n", "short_description": "A late night drive.  The law is watching.\nYou are being followed through dangerous, dark roads on a horrifying drive... to hell.\n\nController-free gameplay, use your hands to steer, shift and change the  radio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalportalgames.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DIGITAL PORTAL GAMES", "support_website_url": null, "website_url": "https://digitalportalgames.godaddysites.
_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ithya_MuwkMQ7kNvwHNse1P&_nc_oc=Adqd5GxX90Mk7uYn4RCvNWZ0Jo8bbou_7yD7MQlLcVikv4pfWQJq0A8vhxQSuqQK7Nw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJzNNP6gK_gay8gtO9_6FiS-0vaWHnK5bxDP70-HStYg&oe=6B070180"}, {"file_name": "3.png", "id": "1263762394888174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391976_1263762398221507_4706483341884928518_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDqfNg18oB0Q7kNvwG_V1yY&_nc_oc=AdoYVygApGqOWvnZ_iiLS0qFgXO6zSqCCJE0iToXi25sycSK3cfp-4JKrKuuCS6O0VY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmnxCwDKUSvUdvufwXmFp0WR63gAkkGxoFjQEeYuc-iA&oe=6B07155E"}, {"file_name": "4.png", "id": "3199702763530223", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391913_3199702766863556_4454836746514012505_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SA_liHuSw8Q7kNvwHOdrdd&_nc_oc=Adq5aSNIQxIuz4TAePqXjZwt_9MrRKp9rWKqNh-GK0cRle1eQVvfPXxka4J1km_GuSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToXCaOrGMf5kVIR3WJxmsSTRkK2it6GLri59G0DY_Qww&oe=6B071E15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_2560x1440.png", "id": "9210481205732638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391960_9210481212399304_5422732958436135907_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc0oQ8fxfy0Q7kNvwEU2u8G&_nc_oc=AdrRGhdaWo1Youh7TibTWR5dPpPpS1QMnYvfjDkO6RJT2Nt2NmZK5z6rjDZlOQHvlXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5edMA1_sHLQwNojGWJ-RjSBi2qiDMIkZfTlTn3jkYmw&oe=6B07031D"}, "display_name": "The Sword in the Stone", "keywords": ["Sword", "HandTracking", "MR", "Arthurian", "Hero"], "long_description": "Step into the realm of Arthurian legend with **The Sword in the Stone**, where you\u2019ll confront the legendary sword that grants royal power to anyone strong and patient enough to pull it free. Thanks to the precision of Quest VR hand tracking, every motion\u2014every tilt, tug, and angle\u2014feels incredibly lifelike, immersing you in the thrill of the challenge.\n\n{549666068108187}\n\nIn this interactive adventure, each time a player around the globe succeeds in drawing the sword, it magically grows in length and weight, raising the stakes for everyone else. Only those with unwavering focus and determination can overcome the sword\u2019s ever-increasing burden. When you finally liberate the blade, you\u2019ll unlock a special achievement and receive a royal coronation, proving once and for all that you\u2019re more than just a mere bystander.\n\nWhether you\u2019re a seasoned VR enthusiast or brand-new to virtual reality, **The Sword in the Stone** offers an accessible yet increasingly demanding test of skill and tenacity. Put on your Quest headset, wrap your hands around the hilt, and see if you can earn the crown in this epic quest for virtual supremacy.", "short_description": "Pull the sword from the stone and be crowned the true king! In The Sword in the Stone, experience the most immersive sword-pulling challenge powered by Quest VR hand tracking. Each successful attempt by players worldwide makes the blade longer and heavier, pushing your determination to the limit. Do you have what it takes to claim the ultimate glory?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_250k.html", "developer_terms_of_service_url": null, "publisher_name": "250k LLC.", "support_website_url": null, "website_url": "https://bbape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inte
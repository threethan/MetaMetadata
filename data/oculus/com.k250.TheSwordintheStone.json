_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve2iuhkZTEIQ7kNvwHm7f5k&_nc_oc=AdqkGro6eATjBYLvwmn9ZxsGuNNz2ohnDXWmrPJ_JNevgvpbwDKfvxH18g8TAWyTV6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTztE8pMIE_FxEe2ZLsJhIhT4v9a_IlIBoQpwNcX4qpug&oe=6B030D00"}, {"file_name": "3.png", "id": "1263762394888174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391976_1263762398221507_4706483341884928518_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NzaG4V_g8oQ7kNvwECXGyj&_nc_oc=AdooZM9FoYYMcb1edyGHUXXEgIY2TCBfFInBS7N8OpiESZEWc1noAa76vwWZxjqVrPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoU9sqnhrvwK1s__ZnlfdTaBzQlOs0ae50ZMD7lOw8kg&oe=6B0320DE"}, {"file_name": "4.png", "id": "3199702763530223", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391913_3199702766863556_4454836746514012505_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqt6Gov_iZ4Q7kNvwEVqN8g&_nc_oc=AdqR4Qm6vMgwf6IMnnA7v3DYOWONmMBX3JiOklh2NAsbtkgZnLeUNjnU6cQ2dZIQ0Go&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV3jEUKCscqRNfkg6AyobK1Sf3t6irPT7ZPWLvvqc0eA&oe=6B032995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_2560x1440.png", "id": "9210481205732638", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391960_9210481212399304_5422732958436135907_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bq8VLMZnLFoQ7kNvwG5GX02&_nc_oc=Adq6vR8qJ2oOXhH2VYDjJt2BWXaybNZ6Hx3im6nB8ePZIPicqZQn1cfcreHK8Fxpnvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwjYSFTUgDpjUKSqiksJ8cd_GgY3UZIQr7zG73S1zL5A&oe=6B030E9D"}, "display_name": "The Sword in the Stone", "keywords": ["Sword", "HandTracking", "MR", "Arthurian", "Hero"], "long_description": "Step into the realm of Arthurian legend with **The Sword in the Stone**, where you\u2019ll confront the legendary sword that grants royal power to anyone strong and patient enough to pull it free. Thanks to the precision of Quest VR hand tracking, every motion\u2014every tilt, tug, and angle\u2014feels incredibly lifelike, immersing you in the thrill of the challenge.\n\n{549666068108187}\n\nIn this interactive adventure, each time a player around the globe succeeds in drawing the sword, it magically grows in length and weight, raising the stakes for everyone else. Only those with unwavering focus and determination can overcome the sword\u2019s ever-increasing burden. When you finally liberate the blade, you\u2019ll unlock a special achievement and receive a royal coronation, proving once and for all that you\u2019re more than just a mere bystander.\n\nWhether you\u2019re a seasoned VR enthusiast or brand-new to virtual reality, **The Sword in the Stone** offers an accessible yet increasingly demanding test of skill and tenacity. Put on your Quest headset, wrap your hands around the hilt, and see if you can earn the crown in this epic quest for virtual supremacy.", "short_description": "Pull the sword from the stone and be crowned the true king! In The Sword in the Stone, experience the most immersive sword-pulling challenge powered by Quest VR hand tracking. Each successful attempt by players worldwide makes the blade longer and heavier, pushing your determination to the limit. Do you have what it takes to claim the ultimate glory?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_250k.html", "developer_terms_of_service_url": null, "publisher_name": "250k LLC.", "support_website_url": null, "website_url": "https://bbape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inte
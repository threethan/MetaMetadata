3-3.oculuscdn.com/v/t64.5771-25/473391976_1263762398221507_4706483341884928518_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15lJSpQifCQQ7kNvwHkmywa&_nc_oc=AdlyNlgqP__dHla8Ls6EXI3zMF8deFp-yDaRssz6pHsTLttZcSTc-NIGT3-MDgmYzxQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7kmmPeeQ6HAaZOwdWCY4n4hHIma_UCd6AfITgY40DHA&oe=69BAA31E"}, {"file_name": "4.png", "id": "3199702763530223", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391913_3199702766863556_4454836746514012505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz09A4MdaycQ7kNvwEYoJ8E&_nc_oc=Adms3MS-1jqK8vxMHhWynbZcpgy4MG_V5touu-T7jXF_5OvC_cxp8myA_nGYSvWrnmc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxoi9yqn3eK9ZjjA5u1rF18DYl9y7_-G6BUUoO0trO7OA&oe=69BAABD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_2560x1440.png", "id": "9210481205732638", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391960_9210481212399304_5422732958436135907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKanJfVzvX0Q7kNvwGrgf3W&_nc_oc=AdlMVNEoCexJKigu91vNl-mQzLAvl4D7CsDx-zCpaemDPVp9xvgFqBtNXWO1XE5LHDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMLr163ujhyOEC_zHaw8xQyRtUcLtiEeTSyRXPhc99GQ&oe=69BA90DD"}, "display_name": "The Sword in the Stone", "keywords": ["Sword", "HandTracking", "MR", "Arthurian", "Hero"], "long_description": "Step into the realm of Arthurian legend with **The Sword in the Stone**, where you\u2019ll confront the legendary sword that grants royal power to anyone strong and patient enough to pull it free. Thanks to the precision of Quest VR hand tracking, every motion\u2014every tilt, tug, and angle\u2014feels incredibly lifelike, immersing you in the thrill of the challenge.\n\n{549666068108187}\n\nIn this interactive adventure, each time a player around the globe succeeds in drawing the sword, it magically grows in length and weight, raising the stakes for everyone else. Only those with unwavering focus and determination can overcome the sword\u2019s ever-increasing burden. When you finally liberate the blade, you\u2019ll unlock a special achievement and receive a royal coronation, proving once and for all that you\u2019re more than just a mere bystander.\n\nWhether you\u2019re a seasoned VR enthusiast or brand-new to virtual reality, **The Sword in the Stone** offers an accessible yet increasingly demanding test of skill and tenacity. Put on your Quest headset, wrap your hands around the hilt, and see if you can earn the crown in this epic quest for virtual supremacy.", "short_description": "Pull the sword from the stone and be crowned the true king! In The Sword in the Stone, experience the most immersive sword-pulling challenge powered by Quest VR hand tracking. Each successful attempt by players worldwide makes the blade longer and heavier, pushing your determination to the limit. Do you have what it takes to claim the ultimate glory?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bbape.com/privacypolicy_250k.html", "developer_terms_of_service_url": null, "publisher_name": "250k LLC.", "support_website_url": null, "website_url": "https://bbape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9894356887259788"}}]}, "scheduled_offers": {"count": 12,
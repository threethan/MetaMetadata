jXTwwQ&oe=69E75F81"}, {"file_name": "bulldozer - screenshot5.png", "id": "935067931670355", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75297584_935067935003688_3667610640423365558_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMO1sTz0azMQ7kNvwGQgWZW&_nc_oc=Adq0bYjbtCwwolqYPx3xvBDArrjSCbBVnIWKdjSIHHvwONifJik6OpfkPGXi_rEnGZ4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EqKnlSLaTGHaVeQ9YbYOIaraQ6JVtKN_HMYFhWEvmLw&oe=69E77217"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bull dozer - trailer cover.png", "id": "924358212404479", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982583_924358215737812_1777973836380986538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfnGqFpQuaIQ7kNvwFoLgct&_nc_oc=AdqzkTunOSE4pV0VGERNnHM09_cAFHHg83eJ5czaNkwue2Fk7rxWigmEd5brnCt6uHQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35qbNA26yVtDk8WzjvMKlposCUWQr-D-Zz20Ix4tEkrg&oe=69E76166"}, "display_name": "Bull Dozer Safety and Operation", "keywords": [], "long_description": "Bulldozers are considered essential in construction and earthmoving projects. They are used for road building, mining, quarrying, on farms, and in heavy industry factories. They consist of a large, motorized machine equipped with a metal blade to the front for pushing material: soil, sand, snow, rubble, or rock. They usually travel on continuous tracks, providing superior traction on most surfaces. Participants will operate a bulldozer and complete various tasks on an active worksite as part of this engaging simulation. \n\n\nOverview & Activities: \nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. They are then asked to perform a single task to become familiar with operating the vehicle in a VR environment. Embedded learning outcomes are designed to help individuals remember, understand, and apply acquired knowledge. \n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a dump truck in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a walk-around inspection of the vehicle. ", "short_description": "Bulldozers are considered essential in construction and earthmoving projects. They are used for road building, mining, quarrying, on farms, and in heavy industry factories. They consist of a large, motorized machine equipped with a metal blade to the front for pushing material: soil, sand, snow, rubble, or rock. They usually travel on continuous tracks, providing superior traction on most surfaces. Participants will operate a bulldozer and complete various tasks on an active worksite as part of "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7083071641770588"}}]}, "sched
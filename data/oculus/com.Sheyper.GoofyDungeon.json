ord5-2.oculuscdn.com/v/t64.5771-25/491823279_2455275978295496_7513389875162341460_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_VUhINBDDMQ7kNvwEsier5&_nc_oc=AdqmH_6XROWTFHjqlSsIJVmKdKThWm65f9PyD_OQjSzzXvKFOtCOwGwUNuDzL_UgjRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRQac7fRtD-CfhFgqY4fNW5IAT-QgOshsKqD03pnW9Uw&oe=6AF4729E"}, {"file_name": "Screen_4.png", "id": "1740666007157962", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1740666010491295_5538150947331207170_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-hyyg_j45kQ7kNvwHQFudu&_nc_oc=AdpYYAxYNjLRVtcCxsO17L4uE6Y6PO99b6vrfLaRu8F2PugEwCVydNagR38VqDaBKtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnGKzu0CqkB1F7kOS9kRA0uVtap8TE29DIZveyhJ5jsw&oe=6AF470A0"}, {"file_name": "Screen_5.png", "id": "1356508473234655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1356508479901321_5044430936205154332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2f_8D-HkiEQ7kNvwHUIKVl&_nc_oc=AdqO7OYb0quTm9Rin56-LuG0zeu4o3tLMj6qn0FdPAb_G4fRpEfVC_IRveT-ikfeXOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkdkLhWceNKD9ubvcUW3u7LdGgexLZBcuzludU4-KVrw&oe=6AF47F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capsule_2560x1440.png", "id": "1647467920424043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1647467923757376_4797024844978606748_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbD3KetrXlgQ7kNvwF4b_HC&_nc_oc=AdqFa9922hhKJoyS8_5rK2bhIoi4o-hO71LU0a2mNSDe3Pgszjv20aMvuiRTbNkYBlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9lZtcngCXU_yA-aC0vIkzkXQjH3Zeg6ArfVM1sUkLmw&oe=6AF476D1"}, "display_name": "Goofy Dungeon", "keywords": ["escape", "room", "fun", "physics", "puzzle"], "long_description": "Goofy Dungeon is a short light-hearted puzzle game built from the ground up for VR. Explore, interact with objects and the environment, solve puzzles, complete your quest and earn your trophy!\n\nWelcome to the **Goofy Dungeon** cartridge shop! \ud83d\udc38\n\nIt\u2019s your first day, but there\u2019s no time to waste, a customer has broken the magic portal! \n\nAll the cartridges seem to have been wiped... except for one! \n\nCheck if this one works and set off on an adventure!\n\n\u26a0\ufe0f **Please note that the game is short (~1 hour)** \u26a0\ufe0f\n\n# Interact with objects and the environment!\n{1224149736551190}\n# Solve puzzles\n{990143007419036}\n# Complete your quest and earn your trophy!\n{2848011142231270}", "short_description": "Goofy Dungeon is a short light-hearted puzzle game built from the ground up for VR. Explore, interact with objects and the environment, solve puzzles, complete your quest and earn your trophy!"}, {"images": {"nodes": []}, "id": "2167110947210903", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goofy Dungeon", "keywords": ["escape", "room", "fun", "physique", "puzzle"], "long_description": "Goofy Dungeon est un jeu de puzzle court mais amusant con\u00e7u pour la r\u00e9alit\u00e9 virtuelle. Explore, interagis avec les objets et l'environnement, r\u00e9sous des \u00e9nigmes, accomplis ta qu\u00eate et r\u00e9cup\u00e8re ton troph\u00e9e !\n\nBienvenue \u00e0 la boutique de cartouches **Goofy Dungeon !** \ud83d\udc38\n\nC'est ton premier jour mais pas de temps \u00e0 perdre, un client a cass\u00e9 le portail magique!\n\nToutes les cartouches semblent avoir \u00e9t\u00e9 effac\u00e9es... sauf une !\n\nV\u00e9rifie si celle-ci fonctionne et pars \u00e0 l'aventure!\n\n\u26a0\ufe0f **Attention le jeu est court (~1h)** \u26a0\ufe0f\n\n# Interagis avec les objets et l'environnement !\n{28200442699607309}\n# R\u00e9sous les \u00e9nigmes\n{1067026852575166}\n# Accomplis ton qu\u00eate et r\u00e9cup\u00e8re ton troph\u00e9e !\n{973180089129326}", "short_description": "Goofy Dungeon est un jeu de puzzle court mais amusant con\u00e7u pour la r\u00e9alit\u00e9 virtuelle. Explore, interagis avec les objets et l'environnement, r\u00e9sous des \u00e9nigmes, accomplis ta qu\u00eate et r\u00e9cup\u00e8re ton troph\u00e9e !"}, {"images": {"nodes": []}, "id": "1752929169321682", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goofy Dungeon", "keywords": ["sala", "escape", "divertido", "f\u00edsica", "rompecabezas"], "long_description": "Goofy Dungeon es un breve y desenfadado juego de puzles , creado desde cero para realidad virtual. \u00a1Explora, interact\u00faa con objetos y el entorno, resuelve acertijos, completa tu misi\u00f3n, hasta conseguir tu trofeo!\n\n\u00a1Bienvenido a la tienda de cartuchos de **Goofy Dungeon**! \ud83d\udc38\n\nTu primer d\u00eda y no hay tiempo que perder: \u00a1un cliente ha roto el portal m\u00e1gico!\n\nParece que se han borrado todos los cartuchos... \u00a1excepto uno!\n\n\u00a1Comprueba si funciona y l\u00e1nzate a la aventura!\n\n\u26a0\ufe0f **Ten en cuenta que el juego es breve (de 40 minutos a 1 hora, aproximadamente)** \u26a0\ufe0f\n\n# \u00a1Interact\u00faa con objetos y el entorno!\n{1629318002062337}\n# Resuelve acertijos\n{1100451055728862}\n# \u00a1Consigue tu trofeo!\n{1748109909784726}\n", "short_description": "Goofy Dungeon es un breve y desenfadado juego de puzles , creado desde cero para realidad virtual. \u00a1Explora, interact\u00faa con objetos y el entorno, resuelve acertijos, completa tu misi\u00f3n, hasta conseguir tu trofeo!"}, {"images": {"nodes": []}, "id": "927857450195319", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goofy Dungeon", "keywords": ["\u043a\u0432\u0435\u0441\u0442", "\u043a\u043e\u043c\u043d\u0430\u0442\u0430", "\u0432\u0435\u0441\u0435\u043b\u044c\u0435", "\u0424\u0438\u0437\u0438\u043a\u0430", "\u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430"], "long_description": "Goofy Dungeon \u2014 \u044d\u0442\u043e \u043a\u043e\u0440\u043e\u0442\u043a\u0430\u044f \u0438 \u0432\u0435\u0441\u0435\u043b\u0430\u044f \u0438\u0433\u0440\u0430-\u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0430\u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0434\u043b\u044f VR. \u0418\u0441\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u043c\u0438\u0440, \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0441 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438 \u0438 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c, \u0440\u0435\u0448\u0430\u0439\u0442\u0435 \u0437\u0430\u0433\u0430\u0434\u043a\u0438, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0441\u0432\u043e\u0439 \u0442\u0440\u043e\u0444\u0435\u0439!\n\n\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u043a\u0430\u0440\u0442\u0440\u0438\u0434\u0436\u0435\u0439 **Goofy Dungeon !** \ud83d\udc38\n\n\u042d\u0442\u043e \u0432\u0430\u0448 \u043f\u0435\u0440\u0432\u044b\u0439 \u0440\u0430\u0431\u043e\u0447\u0438\u0439 \u0434\u0435\u043d\u044c, \u043d\u043e \u043c\u0435\u0434\u043b\u0438\u0442\u044c \u043d\u0435\u043b\u044c\u0437\u044f: \u043a\u043b\u0438\u0435\u043d\u0442 \u0441\u043b\u043e\u043c\u0430\u043b \u0432\u043e\u043b\u0448\u0435\u0431\u043d\u044b\u0439 \u043f\u043e\u0440\u0442\u0430\u043b!\n\n\u041f\u043e\u0445\u043e\u0436\u0435, \u0434\u0430\u043d\u043d\u044b\u0435 \u043d\u0430 \u0432\u0441\u0435\u0445 \u043a\u0430\u0440\u0442\u0440\u0438\u0434\u0436\u0430\u0445 \u0441\u0442\u0435\u0440\u043b\u0438\u0441\u044c... \u043a\u0440\u043e\u043c\u0435 \u043e\u0434\u043d\u043e\u0433\u043e!\n\n\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435, \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043b\u0438 \u043e\u043d, \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435\u0441\u044c \u043d\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f\u043c!\n\n\u26a0\ufe0f **\u041e\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435: \u0438\u0433\u0440\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0430\u044f (\u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u043e\u0442 40 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e 1 \u0447\u0430\u0441\u0430)** \u26a0\ufe0f\n\n# \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0441 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438 \u0438 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c!\n{2132011364057596}\n# \u0440\u0435\u0448\u0430\u0439\u0442\u0435 \u0437\u0430\u0433\u0430\u0434\u043a\u0438\n{4695105694112082}\n# \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0441\u0432\u043e\u0439 \u0442\u0440\u043e\u0444\u0435\u0439!\n{1415954030661400}", "short_description": "Goofy Dungeon \u2014 \u044d\u0442\u043e \u043a\u043e\u0440\u043e\u0442\u043a\u0430\u044f \u0438 \u0432\u0435\u0441\u0435\u043b\u0430\u044f \u0438\u0433\u0440\u0430-\u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u0430\u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0434\u043b\u044f VR. \u0418\u0441\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u043c\u0438\u0440, \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0441 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438 \u0438 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u
"msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon512.png", "id": "2945815902437397", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_2945815909104063_5975108352042201183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ffMG_vvm4UQ7kNvwG-XVU-&_nc_oc=Adon0T3tsVEQUffN_EY-lLCYIwlGVWhbWAUZeH1nAoGXeGWbmtL-7YES6KwD25XXMJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0H3XQ_tRNGfjPjFNCh1wWVEWZ7ewlHcPa2pRGNGNJOg&oe=6AF356F1"}, {"file_name": "Capsule_LibraryHero_3000x900.png", "id": "2153258338565225", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_2153258341898558_2031731481102274754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vMKEmQACeEQ7kNvwHZwSJz&_nc_oc=AdqROAJ3rSyGL5RBCcY8h1FEmjImXnxHBpygfS4jxKHEe915q6SyfJfqarD8cZF6hF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ3G-pNTMGBG3cvpU3KsFK6u5DPM_xIZ1U9w7XbyEYcw&oe=6AF34EC1"}, {"file_name": "capsule_2560x1440.png", "id": "2055828121968020", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825470_2055828125301353_6036014847406498406_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOYw13N6xUQQ7kNvwEv9rJi&_nc_oc=AdoLr_8PQshHqXV6zgDCbp_0AOR0jdyiFcoSO7-prphGBiHalQ-3Xx0KcM307e9canU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkf633D0wvCNysYqn2e8eRIOjcvNcesmUIgCMhzYQT7A&oe=6AF346BD"}, {"file_name": "GoofyDungeon_Logo_1024x256 X2.png", "id": "1518179723684888", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1518179727018221_3247520606823285409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv8o5t9QJ8QQ7kNvwEM03z0&_nc_oc=AdohWCXJE9CkoOZZk0zRPUIXcF9mcNomEnDfbAt5LZw7tQLszkXtYKphHx9LFQHqU3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgHUZtS0KGjrtTs8arkBgIQDKF57dSDYs81167LW77YQ&oe=6AF32
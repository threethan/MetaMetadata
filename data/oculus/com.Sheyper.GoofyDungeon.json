"msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon512.png", "id": "2945815902437397", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_2945815909104063_5975108352042201183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ffMG_vvm4UQ7kNvwEScIoO&_nc_oc=AdpURuHYNDp44dD2zdTRczd0o6NJBVU3jIq18TuHbf9Vaf3veWLDPfRpsUMgVI-FDrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYAdQ_jFUeEAEs1lR5vCNdh41nUj9gohBWYhGNZl57AQ&oe=6AF47031"}, {"file_name": "Capsule_LibraryHero_3000x900.png", "id": "2153258338565225", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824328_2153258341898558_2031731481102274754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vMKEmQACeEQ7kNvwHQnkAA&_nc_oc=Adr6esqO_dFIeLcFznuWNprlxctKgMsmdBga6Xl6FV3PN7GavNp3cBw9hhx3I2EBkAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRds2KQPd4tYv7zFTmp7yXhRGLGWJZ_AH1aD_YX2eTVAg&oe=6AF4A041"}, {"file_name": "capsule_2560x1440.png", "id": "2055828121968020", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_2055828125301353_6036014847406498406_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeFUb22762sQ7kNvwF3MiQx&_nc_oc=AdqVirD3PS4_vGKrS6VmyOMN5xCl1SQaf0ojYrZUOy0GYxaXEAwG5secZownxFsw8tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRdSq9CtCKSOG0ujAEWrwZ3A_e7saG3ko1cCYWLTXyLw&oe=6AF4983D"}, {"file_name": "GoofyDungeon_Logo_1024x256 X2.png", "id": "1518179723684888", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_1518179727018221_3247520606823285409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ncwDnQ_UtMQ7kNvwFYr4oQ&_nc_oc=Adqa0V_sj9j0VHuvpHK5dZAwCsNDI548Ta8zwFBMYLP4z22qg5lBAVKSHVkEHqvWJog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJW2p8MeIUC4MjN-RJ6B13IMsvgJHpz_mTrP2-q6vePw&oe=6AF47
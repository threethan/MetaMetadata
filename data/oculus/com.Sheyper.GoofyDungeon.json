"msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon512.png", "id": "2945815902437397", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_2945815909104063_5975108352042201183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzXE0ZbU5PEQ7kNvwFzzYGQ&_nc_oc=AdqGmVnPokNCM2taE93u0ZTisvu1rMenIpp3teGQ3_vwR2XD2L0nnnFSE_iWYSY1gG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ5pnBHArbebuUSBdFzltJn4wURNN8njyKJOKUoorhGQ&oe=6AF71331"}, {"file_name": "Capsule_LibraryHero_3000x900.png", "id": "2153258338565225", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824328_2153258341898558_2031731481102274754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xqbAQsx_CYQ7kNvwEofdN7&_nc_oc=AdpPxfO0Tc5p_tvZbyLIykx1Z8GgCm-QjrixyHap9HuurDylle07SgbhCnAv9lUMSuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToXRHHyIcK9Zx2FxQQ6Dp3JJdSM4RcYWw0-RwlM5YS5g&oe=6AF74341"}, {"file_name": "capsule_2560x1440.png", "id": "2055828121968020", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_2055828125301353_6036014847406498406_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeFUb22762sQ7kNvwFuqrvd&_nc_oc=AdodBP1WNsh4GwfaeBoBneWudwG40AOMJfoRByOK62vM2zbkBa6vys23xbJM6kywj2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQenvHU7z4JeifAGE7zx4EtgSe1JaoGDo14nXFIlZ7rMw&oe=6AF73B3D"}, {"file_name": "GoofyDungeon_Logo_1024x256 X2.png", "id": "1518179723684888", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_1518179727018221_3247520606823285409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ncwDnQ_UtMQ7kNvwHUEzjO&_nc_oc=AdpqcJpittsGbTKUXjFmL24LZlGxe4iHRpSdjiy1646hSqy_6KalvHnfblojLbIQoCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUqD4RaA9LIeUDywPpunbS-ShXt8tB7asE71cH6UpQww&oe=6AF72
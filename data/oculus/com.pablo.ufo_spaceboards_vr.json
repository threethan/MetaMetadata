scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3GDlorOtwaJQ-Zb6yStRUSzQotPtiXDjhScbA8-Vw3A&oe=6A974A0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2314b8a5fff94610a795c430e2aaf9fc.png", "id": "1460112509453169", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/585741071_1460112516119835_8547357466152554528_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqWC-5iRdxAQ7kNvwFe1IZ9&_nc_oc=AdosbUxDF2Gfb7n7sARGARDCAtx18eyHGvzHnXTldcyRfvV9QduGbDe8A3lGo-_r-vc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdN6sS1p6dhj9I6GmKoeqeVvrBbe-M4LuxfbYITXazDw&oe=6A971E01"}, "display_name": "UFO Spaceboards VR", "keywords": ["shooter", "skate", "portal", "platform"], "long_description": "UFO Spaceboards VR is a high\u2011velocity VR action game that blends arcade skateboarding, portal puzzles, and dynamic level generation into a single, relentless run through open space. You begin every session suspended above a giant, dark roadway that cuts through a cosmic void. A distant planet rotates beneath you, a reminder of scale and speed as you drop into motion. From the first second, the game asks you to balance momentum, precision, and creativity. It is not a static course; it is a living system that assembles the track in front of you and clears it behind, shaping a continuous ride that feels fresh every time.\n", "short_description": "UFO Spaceboards VR is a fast, arcade\u2011style VR action game built around skating a futuristic spaceboard across floating ramp courses in open space. You drop into a run high above a massive planetary roadway and immediately feel the speed, scale, and vertigo. The core loop is simple and addictive: stay on the ramps, build momentum, and chain your way through a shifting sequence of levels while using VR body motion, jumps, and special tools to survive. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://politrons.github.io/UfoSpaceboardsVRSite/privacy.html", "developer_terms_o
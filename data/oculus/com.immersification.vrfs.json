ktBFA&oe=6A1C4368"}]}, "id": "565148722321142", "locale": "en_US", "screenshots": [{"file_name": "bn2.png", "id": "723206489317459", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75367591_723206492650792_7836788807916181930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHY0rfMW3_YQ7kNvwGi9b_0&_nc_oc=AdqcTH80sGGpmkEQ4MI5Wczewf2gbDCrO4opLiIeUVQkeLIEtuwiNmTrgNjRlgF4Ah8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ztHi-LY0DJBNy0UA0ASqNn26EFSCCP8jcmHuiG3HvFw&oe=6A1C4DF3"}, {"file_name": "Screenshot 2023-01-30 at 02.29 2.png", "id": "565789808551133", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974892_565789811884466_6526345203447617269_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVXEXjO_oGwQ7kNvwFt20Q7&_nc_oc=AdqJFlJeoPuD4HGh7pseP02p6pqngL-kOux8X7G0vWNU1u1i3I7LB4JesFBWfsfvS-g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CfKr9HDi5AQkQZTHO0-QB_jqwVCXc0aR2aSgD3jzMug&oe=6A1C51B0"}, {"file_name": "bn1.png", "id": "703831071324154", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392880_703831077990820_4260937339645075700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT_zFDXmn6MQ7kNvwFo2E-v&_nc_oc=AdrCAwLRyCM8JFc7DoFLSgmjqJ6TItHc7PmepBPSnQJpSjvOHZUfiKf0O4YvilbVuko&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xVWL9ONbQi8kBJfQaa61O9G351Lg6MXTDU-hcx7w-qQ&oe=6A1C41D2"}, {"file_name": "Screenshot 2023-01-30 at 02.33 2.png", "id": "5437349666365786", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75371511_5437349673032452_5749519266546188894_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3Zg1g3bFQIQ7kNvwEwAm7w&_nc_oc=AdqvOtf5LO9Ek8nXaGj-DG7ydNsOTIjMYH1VIrHgMcZ2PTxatU7XMtTVyoiF26mHAbk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gNB2Z5t04X3Z_irWQ5o-yWu4Kpd3eNt4JmlbB8sEA1w&oe=6A1C2B6C"}, {"file_name": "Screenshot 2023-01-30 at 02.32.png", "id": "972095697532669", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031515_972095700866002_1006233267072909900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B9hJOKbCzQQ7kNvwGmcavO&_nc_oc=Adqbfl0G5-RY9f9j7xkIXndbrgDniFo_eZEBi266JEqmoDGjO-Xux4q4C_6UlTAikPU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U-zGenwVJCjvBmFPVqqj9pjT2thZVzgIDDFWnqX0qvg&oe=6A1C4F6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-prod-2560-1440.png", "id": "1765829837121763", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57566679_1765829840455096_3553248497618459432_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IJWUk1ncqEQ7kNvwER778q&_nc_oc=AdoZHnXdvDn65AmqzfoBCWKN1k6hHXo3yk32-KAOC_TwDwT9hmBjmmLSTw6G6ZL0ARY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gpPVPuIgPVyPzecVyeRpoIMQ2S_qxzeCIUipvo8894Q&oe=6A1C4081"}, "display_name": "VRFS - Football (soccer) simulator", "keywords": [], "long_description": "VRFS is a community-driven football simulator with focus on realistic physics and competitive online multiplayer.\n\nHere are the main features of VRFS:\n\nFOOTBALL PHYSICS SIMULATION: A player can perform almost any trick from balancing the ball on the tip of the foot to executing curved power shots and long passes. The ball's trajectory is solely determined by physics engine. \n\nCOMPETITIVE ONLINE MODE: The multiplayer architecture allows for an immediate response when a player touches the ball. For example, it is possible to finish a powerful cross at the same speed as in real football, even if the connection is not perfect.\n\nCOMFORT: Players move around using thumbsticks and can play in a seated or standing position. No intense hand movement is required.\n\nNO PAY-TO-WIN in VRFS: only skills matter. No one can buy \"stronger kicks\" or \"faster boots.\" Keep practicing, and you'll feel how you improve.\n\nFREE FOR ALL: Players have full access to the game with no need to purchase anything. However, if you wish, you will be able to buy cool equipment in the store, thus supporting the further development of this project (paid equipment coming soon)\n\nPlease, bear in mind that VRFS is still in development, including upcoming upgrades to the physics and scenery. We'd appreciate your suggestions regarding any enhancements.", "short_description": "VRFS is a community-driven football simulator with focus on realistic physics and competitive online multiplayer.\n\nHere are the main features of VRFS:\n- Realistic football physics\n- Competitive online mode\n- Comfortable controls\n- No pay-to-win mechanics\n- Free for all\n\nPlease, bear in mind that VRFS is still in development, including upcoming upgrades to the physics and scenery. We'd appreciate your suggestions regarding any enhancements."}]}, "developer_name": "0BS3SS10N Co.", "developer_privacy_policy_url": "https://vrfs.gg/en/docs/privacy/", "developer_terms_of_service_url": "https://vrfs.gg/en/docs/terms/", "publisher_name": "Immersification", "support_website_url": "https://vrfs.gg/contacts/", "website_url": "https://vrfs.gg/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1378871059538951"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "524845919632663"}]}, "baseline_offer": {"id": "524845919632663"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1675454400, "status": "PUBLISHED", "id": "524845919632663"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35815284854752640", "version": "0.1"}, "id": "4132387000218482", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8464137310294097", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35815284854752640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4132387000218482"}]}, "change_log": "# \ud83d\udea9 Referee Update\n\nLet\u2019s honor the invisible work of those who help the game flow while taking both love and hate at the same time. The Referee Kit is here \u2014 featuring special gloves that can spawn various referee tools.\n\nReferees in private lobbies can now issue yellow and red cards in Freeze Mode (`A+X`).\n\n# More in the update:\n\n\ud83d\udd04 Private lobby ownership is now automatically transferred to the next player when the current owner leaves\n\n\ud83c\udf96\ufe0f Players with more than one badge can now switch between them in the profile\n\n\ud83c\udfc6 10+ winnable items and various other fixes and improvements\n\n\ud83c\udf81 Free collectible cap in the main store\n\nThank you for playing VRFS! \n", "created_date": 1779465387, "id": "35815284854752640", "version": "0.1", "version_code": 531, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8464137310294097", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35815284854752640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4132387000218482"}]}, "change_log": "# \ud83d\udea9 Referee Update\n\nLet\u2019s honor the invisible work of those who help the game flow while taking both love and hate at the same time. The Referee Kit is here \u2014 featuring special gloves that can spawn various referee tools.\n\nReferees in private lobbies can now issue yellow and red cards in Freeze Mode (`A+X`).\n\n# More in the update:\n\n\ud83d\udd04 Private lobby ownership is now automatically transferred to the next player when the current owner leaves\n\n\ud83c\udf96\ufe0f Players with more than one badge can now switch between them in the profile\n\n\ud83c\udfc6 10+ winnable items and various other fixes and improvements\n\n\ud83c\udf81 Free collectible cap in the main store\n\nThank you for playing VRFS! \n", "created_date": 1779464373, "id": "35815011444779981", "version": "0.1", "version_code": 530, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8464137310294097", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35815284854752640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4132387000218482"}]}, "change_log": null, "created_date": 1778940119, "id": "35674578948823232", "version": "0.1", "version_code": 529, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8464137310294097", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35815284854752640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4132387000218482"}]}, "change_log": null, "created_date": 1778938203, "id": "35673972758883851", "version": "0.1", "version_code": 528, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8464137310294097", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35815284854752640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4132387000218482"}]}, "change_log": "# \ud83e\udd1d Community Integrity Update\nYou have created one of the largest and most vibrant communities in today\u2019s VR. This update is a foundational step toward helping it thrive for years to come!\n\nWe all miss open goals or pass straight to the opponent from time to time. But if you look at major real-world sports, teammates pick each other up. No moderation system can build a friendly atmosphere on its own \u2014 it ultimately comes down to us simply treating each other with respect. \n\nAt the same time, toxicity requires real preventive action and that\u2019s something we\u2019ve heavily worked on behind the scenes.\n\n# \ud83d\udee1\ufe0f Community Against Toxicity\nThe voice chat moderation system got a significant upgrade: perfect precision, 10x increased capacity, and lightning-fast enforcement in seconds, not minutes.\n\nOne thing the system needs to make a real impact is being pointed in the right direction. That\u2019s why we created a new quick-report tool putting moderation directly into the hands of players.\n\nHold `A`+`X` on your controllers to activate it. Once triggered, all players in the lobby freeze for you and a report button appears when tapping avatars. Every player can now directly help protect the community, so let\u2019s make VRFS toxicity-free starting today!\n\nA couple of important points:\n- When voice chat is set to `Friends`, voice moderation is always disabled  \n- There is no such thing as \u201cspam reports\u201d  \n- The big update is coming on May 28th!\n\n# More in the update:\n\ud83e\uddd8 In-game Menu Zen Mode setting \u2014 hide players while the in-game menu is open\n\ud83d\udd12 Voice chat moderation can now be enabled in private lobbies\n\u2699\ufe0f Various minor fixes and enhancements", "created_date": 1778867226, "id": "35653817467566047", "version": "0.1", "version_code": 527, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
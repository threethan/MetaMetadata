", "id": "723206489317459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367591_723206492650792_7836788807916181930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shRDGVncwA4Q7kNvwGLfhYK&_nc_oc=AdkCCEcUdmB6ImOn-BbboXJ5H9m1tLl_0Gglc7RRhj9PG26_IBUkJgSCbhMB4ErGL_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDBPUDCw4vJpo0Cl3E9muzwVhExDElVdzklqwIWS1vkQ&oe=699D85B3"}, {"file_name": "Screenshot 2023-01-30 at 02.29 2.png", "id": "565789808551133", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_565789811884466_6526345203447617269_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arJVGuZeXn4Q7kNvwGna4sB&_nc_oc=Adk3YQz1OV1E2y5-k22DUHncbfaEgKdisRO5i60HMlPrnY5W5Iezt9QjKjieQA-PyPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkEQulGJjwZWr_5XmpgQ-D7do-McnQ3aqlTOPiz1DQEA&oe=699D8970"}, {"file_name": "bn1.png", "id": "703831071324154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75392880_703831077990820_4260937339645075700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC_b7cIb6s0Q7kNvwFsk9P5&_nc_oc=AdmFqEzaDDZmZnJhnCht7uboR7UdKkU3HPzTrjh83apksVxdQhVwZhAKEzhYMsHYW3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJ766S5n1XxKR6tycZTiYjlBhWI9X7vhbIgu6M_PtBpA&oe=699DB1D2"}, {"file_name": "Screenshot 2023-01-30 at 02.33 2.png", "id": "5437349666365786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75371511_5437349673032452_5749519266546188894_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcW1To8N_gMQ7kNvwHht-zf&_nc_oc=AdnwVOb_VjYwM1OiqQF_1QPZGkeHv0rbSNARtjtwulMlG7oEOcHYiZynUTkf9ROhDRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZsRPywNsbKr7NU8v6aJ9YxMPb0aqa07Zw3ViobjOxqQ&oe=699D9B6C"}, {"file_name": "Screenshot 2023-01-30 at 02.32.png", "id": "972095697532669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031515_972095700866002_1006233267072909900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uOMBGbX70wQ7kNvwFevLZk&_nc_oc=AdmFm3pyaqHIhJ0-zeZDT_faEBfPLTLRxeqC9MeRjkeX7xQUfr0uNEBnU4aAxqtPvgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftR-EElAgtusQzx5PTsO9jw_7b5Cu4D2nqqM3S0ancVWw&oe=699D872E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-prod-2560-1440.png", "id": "1765829837121763", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566679_1765829840455096_3553248497618459432_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6PIU5PS9UUQ7kNvwEbwPep&_nc_oc=Adm9Ln_ZNZhIOLUk788JB8yJyQhRax42giR9zPHcdyqLgbSG0ebY36TReVkWDbpQEX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftkg3yr4C4Bis8Hod4GMJPy3R8ioQ2BkVf8XE0VWqDYsg&oe=699DB081"}, "display_name": "VRFS - Football (soccer) simulator", "keywords": [], "long_description": "VRFS is a community-driven football simulator with focus on realistic physics and competitive online multiplayer.\n\nHere are the main features of VRFS:\n\nFOOTBALL PHYSICS SIMULATION: A player can perform almost any trick from balancing the ball on the tip of the foot to executing curved power shots and long passes. The ball's trajectory is solely determined by physics engine. \n\nCOMPETITIVE ONLINE MODE: The multiplayer architecture allows for an immediate response when a player touches the ball. For example, it is possible to finish a powerful cross at the same speed as in real football, even if the connection is not perfect.\n\nCOMFORT: Players move around using thumbsticks and can play in a seated or standing position. No intense hand movement is required.\n\nNO PAY-TO-WIN in VRFS: only skills matter. No one can buy \"stronger kicks\" or \"faster boots.\" Keep practicing, and you'll feel how you improve.\n\nFREE FOR ALL: Players have full access to the game with no need to purchase anything. However, if you wish, you will be able to buy cool equipment in the store, thus supporting the further development of this project (paid equipment coming soon)\n\nPlease, bear in mind that VRFS is still in development, including upcoming upgrades to the physics and scenery. We'd appreciate your suggestions regarding any enhancements.", "short_description": "VRFS is a community-driven football simulator with focus on realistic physics and competitive online multiplayer.\n\nHere are the main features of VRFS:\n- Realistic football physics\n- Competitive online mode\n- Comfortable controls\n- No pay-to-win mechanics\n- Free for all\n\nPlease, bear in mind that VRFS is still in development, including upcoming upgrades to the physics and scenery. We'd appreciate your suggestions regarding any enhancements."}]}, "developer_name": "0BS3SS10N Co.", "developer_privacy_policy_url": "https://vrfs.gg/en/docs/privacy/", "developer_terms_of_service_url": "https://vrfs.gg/en/docs/terms/", "publisher_name": "Immersification", "support_website_url": "https://vrfs.gg/contacts/", "website_url": "https://vrfs.gg/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1378871059538951"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "524845919632663"}]}, "baseline_offer": {"id": "524845919632663"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1675454400, "status": "PUBLISHED", "id": "524845919632663"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3385396046755176
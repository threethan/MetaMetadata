"id": "333911948937328", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302220_333911952270661_693404555226828054_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KNaRusgqXsQ7kNvwFr1bfR&_nc_oc=AdmNMNjDeakPcnDXNAeN2C3-RSxqXjHarpQgHOYOshiY965mDGKyrEB00P79GwvCr6M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu7X5soB0q_YL0i2kuC2u7BssG8kUA6moxtWXVLMwfm1g&oe=69A58659"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1655861528141445", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001703_1655861534808111_468555271150108197_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfaAalNyB2oQ7kNvwEAFJKe&_nc_oc=AdnoyuVG_tlCNouHmJwGZgC0rjSEBGowA6oHoXVAN8s43zdz5liZoDOz70kGY7PEHk8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftW1g-uIFvzf_QQ7q9IhbgSCm7yDFu8Mvip4VPkcPx6zA&oe=69A593B0"}, "display_name": "Time Titans VR", "keywords": [], "long_description": "Time Titans VR is a singleplayer action shooter that allows the user to manually slow down time to get an advantage in combat. Shoot, punch and slice through enemies while slowing down time to unleash mayhem or dodge counter attacks. \n\nSlow time at the push of a button while you move freely to wreak havoc on the opposition. \n\nGun down enemies during the slow motion bliss. \n\nBash your enemies to pieces with maces, battleaxes, sais, swords and an assortment of other melee weapons.\n\nTest your moral compass as you're put through simulated ethical dilemmas to see if you're worthy of joining \"The Corporation\" to work as a mercenary. Your decisions will impact the story and determine if  you get the job after the grueling interview process. \n\nAre you the right fit for the job? Find out. \n", "short_description": "Time Titans VR is a Singleplayer action shooter that allows the user to manually slow down time to get an advantage in combat. Shoot, punch and slice through enemies while slowing down time to unleash mayhem or dodge counter attacks. "}]}, "developer_name": "Phocore Inc.", "developer_privacy_policy_url": "https://www.phocoregames.com/privacy-policy", "developer_terms_of_service_url": "https://www.phocoregames.com/privacy-policy", "publisher_name": "Phocore Inc.", "support_website_url": null, "website_url": "https://www.phocoregames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1085785358587291"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1683776405906839"}, {"status": "PUBLISHED", "id": "1176641729600043"}]}, "baseline_offer": {"id": "1683776405906839"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736601540, "status": "PUBLISHED", "id": "1683776405906839"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6397749587008140", "version": "1.1"}, "id": "855481695627351", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5458248330958275", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6397749587008140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name":
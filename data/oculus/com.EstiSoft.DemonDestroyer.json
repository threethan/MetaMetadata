er_thumbnail": {"file_name": "1.png", "id": "1743556836432553", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035315_1743556839765886_9055991401346500149_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASpYbIB9EmsQ7kNvwHjarqs&_nc_oc=AdqGT99v9XYutANu3y1IyD-8XHrpzGt70CLHIPvQRC_eypo4CPsUJSf4eACYDQuqfhQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dyVHKHVxB1MY48cXz5s2IlS3WUdFqJe5TsPVkb05J1Q&oe=69FDE567"}, "display_name": "Demon Destroyer", "keywords": ["RunnerGame", "ActionPacked", "Apocalyptic", "DemonSlayer", "FastPacedGameplay"], "long_description": "Dive into the heart-pounding action of Demon Destroy, a high-octane runner game that combines relentless challenges with a fiery apocalyptic setting. Play as a fearless hero tasked with navigating treacherous landscapes filled with molten lava, crumbling ruins, and demonic foes. Use your skills to dodge, dash, and obliterate enemies standing in your way as you strive to escape the chaos.\n\nDemon Destroy features intuitive controls and lightning-fast gameplay that will test your reflexes and keep you coming back for more. With procedurally generated levels, no two runs are ever the same, providing endless replayability. Customize your character with unlockable skins and power-ups to gain the edge you need against increasingly difficult challenges.\n\nExperience stunning graphics and immersive soundscapes that bring the fiery underworld to life. Whether you're a casual gamer looking for a quick adrenaline rush or a hardcore player aiming to master every level, Demon Destroy offers an exciting challenge for all.\n\nWill you rise as the ultimate destroyer or fall to the infernal depths? The battle begins now!", "short_description": "Embark on a thrilling journey in Demon Destroy, an action-packed runner game where chaos meets destruction. Dodge fiery obstacles, crush demonic enemies, and unleash your power as you navigate through apocalyptic landscapes. With fast-paced gameplay, stunning visuals, and immersive sound design, every run is a battle for survival. Perfect for fans of adrenaline-filled challenges, Demon Destroy will keep you on the edge of your seat. Are you ready to conquer the inferno?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/demon-destroy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1023770785722696"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9108146875875774"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "855050427141232"}, {"status": "PUBLISHED", "id": "3995712990740210"}, {"status": "PUBLISHED", "id": "1073153745005771"}, {"status": "PUBLISHED", "id": "1338388867442111"}, {"status": "PUBLISHED", "id": "977228107458256"}, {"status": "PUBLISHED", "id": "940656761353554"}, {"status": "PUBLISHED", "id": "1059725099171796"}]}, "baseline_offer": {"id": "977228107458256"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771185600, "status": "PUBLISHED", "id": "855050427141232"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, 
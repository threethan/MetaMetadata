nQik6MRMFIkmRWmws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rs2kIqW2eejXMD4x-G1wvmkxAgdIrVtNR-AF_C9iS5A&oe=6A05C0E0"}, {"file_name": "Background_20.png", "id": "24119719027652505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_24119719037652504_458498491943732053_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QUCkEjhL_IQ7kNvwH4g1Xe&_nc_oc=AdqBd10fSRUHjWi3xRril_gr64iFhg0HL0zQPwaoDnY4SJdQvCIexmxwNfGAlo9ay7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bf65GnTl9zhr62DbHLTacKLpmtBcEkrSqcngK-CydmQ&oe=6A05DAB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1026102413027222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_1026102416360555_9098727519444918748_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3TueUraqlwQ7kNvwF6sObq&_nc_oc=AdqHWedmNPY4cGT_Arm2iYDjykXhxz6WIkjT38WIheJr8b9Cs0wn6XG4Na0p-0dJXn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iFN9tqkBIgKVg7UXfte7JrFOd0ikM6e2FWooccYkPng&oe=6A05C90A"}, "display_name": "Coaster Loco", "keywords": ["Rollercoaster", "Train"], "long_description": "# Defending 100s of tons of steam train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?\n\nFeatures :\n\n- Surprisingly comfortable to play - every effort has been made to reduce motion sickness in-game, including the option to play less curvy Tracks\n\n- **MILLIONS** of Tracks meaning ENDLESS replayability\n\n- Master a single Track perfectly or just keep skipping from Track to Track, exploring the gorgeous low poly landscapes\n\n- Great generic cardio exercise - playing can get your heart thumping! \n\n- High speed, chaotic action or just ride the rails, you choose\n\n- Family friendly, suitable for most ages\n\n\n# Author's Early Access note:\n\nDeveloping this game has been a hobby and a labour of love. So much is planned for its future, but I'd like to get an idea of how the public feels so far, hence the Early Access release.\n\nIt's not perfect, but it's a SERIOUS amount of fun when you get into it! Make it up to Volcano Country and call me a liar :D So play and enjoy - it's free for now! Tell me what you think, and if you want more, let me know by purchasing Coins in the game :D\n\n~QuirkyFB\n{1476478550488418}\n{1682544943125264}", "short_description": "Defending 100s of tons of Steam Train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coasterloco.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "QuirkyFishBiscuit", "support_website_url": null, "website_url": "https://www.facebook.com/CoasterLoco", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34177606018497418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831968_1247859913735245_924870562219054518_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93KAzkltSAUQ7kNvwH5sS0I&_nc_oc=AdoYwuLS8FjIbnUCBOSSuyURoF5zv8M-ubwKlqZfi0TEmjfXCu1mp7tZDbEgUBG4ZZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aQVH3UCP0DrvpAF0JZdmkbcGMN9ZYDOjpqSze0O-Sxg&oe=6A05EAF5"}, "is_concept": false, "is_test": false, "is_trial_off
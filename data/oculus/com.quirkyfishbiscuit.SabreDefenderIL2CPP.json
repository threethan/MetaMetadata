xocumZREF02oCYpWBnQccZ0DmOoWID0VJ1-qKwEg&oe=69E21D6F"}, {"file_name": "Background.png", "id": "1272443531599928", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491819356_1272443534933261_5851516677721876905_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCizdzMgyNoQ7kNvwG_1bqJ&_nc_oc=AdpbWs1KV47H2qgZw6ecKj8hlZpr4E7KXe9_mlvbRp9GDlm2r7DfInCmsjDw0TRNeoA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PPumhbrRJcRRhXfaq_xgmxARwq-fjgGjE4jxj3OBy8A&oe=69E2501F"}, {"file_name": "slice107.png", "id": "2674904206211701", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821782_2674904216211700_5887090414911222439_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrLU4Nwf1RIQ7kNvwG8XvMF&_nc_oc=AdpmgI9KGcSVD19GW61HO_0aFUsbBNztzBFQFTml-5bakTFrcjUS5GPiRRLQ_4W-1Zc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vg4GzxeMHT0y5BnYi9wWI-MJ3eVHnfv68sI0QyXzNKA&oe=69E22860"}, {"file_name": "Background_20.png", "id": "24119719027652505", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491825039_24119719037652504_458498491943732053_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_Oj0X7X9bwQ7kNvwF6i1nQ&_nc_oc=AdqbmSIM9nm5WHyipD9wS7LEHYX6s7p_yQC0xM7-si_tiGqXolsz-N0jDS3Xnor3Ba8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RghD02kskwAFkNTiP-dZWuv5jmS1zkOJnb2m_jtK_ww&oe=69E24238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1026102413027222", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827277_1026102416360555_9098727519444918748_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCBd9wAxr-UQ7kNvwFkTnny&_nc_oc=AdokmfqwJ3cs-t0VQB-jVRmISRa_5Dciw_45RAy9Q2cwnXm63DkkWn6SaOYe4mAaAnc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_P5YHBv3R5-U1sRwZR_y-_adpCLrIB_HJ7uo5-KmnsQ&oe=69E2308A"}, "display_name": "Coaster Loco", "keywords": ["Rollercoaster", "Train"], "long_description": "# Defending 100s of tons of steam train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?\n\nFeatures :\n\n- Surprisingly comfortable to play - every effort has been made to reduce motion sickness in-game, including the option to play less curvy Tracks\n\n- **MILLIONS** of Tracks meaning ENDLESS replayability\n\n- Master a single Track perfectly or just keep skipping from Track to Track, exploring the gorgeous low poly landscapes\n\n- Great generic cardio exercise - playing can get your heart thumping! \n\n- High speed, chaotic action or just ride the rails, you choose\n\n- Family friendly, suitable for most ages\n\n\n# Author's Early Access note:\n\nDeveloping this game has been a hobby and a labour of love. So much is planned for its future, but I'd like to get an idea of how the public feels so far, hence the Early Access release.\n\nIt's not perfect, but it's a SERIOUS amount of fun when you get into it! Make it up to Volcano Country and call me a liar :D So play and enjoy - it's free for now! Tell me what you think, and if you want more, let me know by purchasing Coins in the game :D\n\n~QuirkyFB\n{1476478550488418}\n{1682544943125264}", "short_description": "Defending 100s of tons of Steam Train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coasterloco.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "QuirkyFishBiscuit", "support_website_url": null, "website_url": "https://www.facebook.com/CoasterLoco", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
abhK5GAad98rhGs4R7rQQlZDOoldhqEdFiWAIr3w&oe=69F886EF"}, {"file_name": "Background.png", "id": "1272443531599928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1272443534933261_5851516677721876905_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euCBWiRvFikQ7kNvwHpOyaq&_nc_oc=Ado5LxcoO7jlCSGIfCh_w7NPXRi7tmkZaQRaVE7fUbVA5lSpUyqRSmQJdwDT0P7nh7o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ymyi3tBJqUlBvUAyd2EAzXnIjpQGdXD1iQs0C9zP0dg&oe=69F8B99F"}, {"file_name": "slice107.png", "id": "2674904206211701", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821782_2674904216211700_5887090414911222439_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5jJ6WRc7I0Q7kNvwES0JE6&_nc_oc=AdpKiWU53RdwzMTfessxkQWmza2wMMQsnYhNQ2vqYw72e0z3lR48G8_aKQ5pzimEXvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OuzzgGXUmCSoid8dQaXaDeM8SzVd9NKXp_4alnLJJiA&oe=69F891E0"}, {"file_name": "Background_20.png", "id": "24119719027652505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825039_24119719037652504_458498491943732053_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhuFqN_XU50Q7kNvwFaCLO2&_nc_oc=Ado6rs4abKdwAqFCi6on6iXCtBDqvvWsml9BbeZe3PtoZUv6CRkFNTDgaJELpM15gog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Fp4jhTu4CTVxNMxNtbietgP2B4Ey1ivOeBhNJDLdBDA&oe=69F8ABB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1026102413027222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827277_1026102416360555_9098727519444918748_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9aPBAUdFc4Q7kNvwHWuTqn&_nc_oc=AdqYEpF4Ujy3wI0XIshLf93NuMsmNYSzZfeT-YtHJ85wSDeWomIHRyuIPMOmZfUB_wU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VFV1v06rwLyol3XU9XFUiMMz5zKuF1aeZBBuC6mxJ7A&oe=69F89A0A"}, "display_name": "Coaster Loco", "keywords": ["Rollercoaster", "Train"], "long_description": "# Defending 100s of tons of steam train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?\n\nFeatures :\n\n- Surprisingly comfortable to play - every effort has been made to reduce motion sickness in-game, including the option to play less curvy Tracks\n\n- **MILLIONS** of Tracks meaning ENDLESS replayability\n\n- Master a single Track perfectly or just keep skipping from Track to Track, exploring the gorgeous low poly landscapes\n\n- Great generic cardio exercise - playing can get your heart thumping! \n\n- High speed, chaotic action or just ride the rails, you choose\n\n- Family friendly, suitable for most ages\n\n\n# Author's Early Access note:\n\nDeveloping this game has been a hobby and a labour of love. So much is planned for its future, but I'd like to get an idea of how the public feels so far, hence the Early Access release.\n\nIt's not perfect, but it's a SERIOUS amount of fun when you get into it! Make it up to Volcano Country and call me a liar :D So play and enjoy - it's free for now! Tell me what you think, and if you want more, let me know by purchasing Coins in the game :D\n\n~QuirkyFB\n{1476478550488418}\n{1682544943125264}", "short_description": "Defending 100s of tons of Steam Train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coasterloco.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "QuirkyFishBiscuit", "support_website_url": null, "website_url": "https://www.facebook.com/CoasterLoco", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
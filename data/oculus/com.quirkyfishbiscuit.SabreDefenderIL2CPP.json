fpOremnFd4sfe_vX4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RskV-YvAeD5rKHjUPHHxPwMZpe91ZIMTuFK-Ei-DJtg&oe=6A031DE0"}, {"file_name": "Background_20.png", "id": "24119719027652505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825039_24119719037652504_458498491943732053_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjhb6W_Du14Q7kNvwGLVR9k&_nc_oc=AdrLFJQpn5RTbAAmiayTCVKpw25t4AFdMg8816kZvsU0Dd7JWluHFT0-HgaFElO0fP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XEvGHw4mCvUeElKBCV27jHs1I_YEkXVFyl0GKlgLWQg&oe=6A0337B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1026102413027222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827277_1026102416360555_9098727519444918748_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aov5ZaAcyuIQ7kNvwFKBqau&_nc_oc=AdoDWGjZDYwHY77eeJU9v3QUNfMYLg0UcHdaJE_NVYhQY7KF6C8XeRUx6K_cGpocVVo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s-GBds1vII4943jWNj4_WHhVOryZ_ER0hmJp8K999lg&oe=6A03260A"}, "display_name": "Coaster Loco", "keywords": ["Rollercoaster", "Train"], "long_description": "# Defending 100s of tons of steam train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?\n\nFeatures :\n\n- Surprisingly comfortable to play - every effort has been made to reduce motion sickness in-game, including the option to play less curvy Tracks\n\n- **MILLIONS** of Tracks meaning ENDLESS replayability\n\n- Master a single Track perfectly or just keep skipping from Track to Track, exploring the gorgeous low poly landscapes\n\n- Great generic cardio exercise - playing can get your heart thumping! \n\n- High speed, chaotic action or just ride the rails, you choose\n\n- Family friendly, suitable for most ages\n\n\n# Author's Early Access note:\n\nDeveloping this game has been a hobby and a labour of love. So much is planned for its future, but I'd like to get an idea of how the public feels so far, hence the Early Access release.\n\nIt's not perfect, but it's a SERIOUS amount of fun when you get into it! Make it up to Volcano Country and call me a liar :D So play and enjoy - it's free for now! Tell me what you think, and if you want more, let me know by purchasing Coins in the game :D\n\n~QuirkyFB\n{1476478550488418}\n{1682544943125264}", "short_description": "Defending 100s of tons of Steam Train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coasterloco.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "QuirkyFishBiscuit", "support_website_url": null, "website_url": "https://www.facebook.com/CoasterLoco", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34177606018497418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831968_1247859913735245_924870562219054518_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuxrUFgIi24Q7kNvwG8nVDW&_nc_oc=AdrUlLt2OFpx0Xokgv_ol3YojpBpjSkZxVxgyHJTjBnf2bomM7nslcTbxOb_m_ND_wk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65az8oSJSnq-6D-z1NGV_Ri0kQZwk4q3q3g99PlspKlw&oe=6A0347F5"}, "is_concept": false, "is_test": false, "is_trial_off
JmvrFDh7Yb3nXxnd1Ebx5W84KA03IlV_ARo3CXRQ&oe=6A1EFAAF"}, {"file_name": "Background.png", "id": "1272443531599928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_1272443534933261_5851516677721876905_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll8T553hX7sQ7kNvwGYNuzW&_nc_oc=Adp0CTzvv7gylSkR5YZIP3pwLI-PUGpewBKYDH_2_67E-tnXNaSg5vwXwICKz_kGAhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mT367BJTqkeffj728fcrat9NMthcUDc1IfpH-SanzCw&oe=6A1EF51F"}, {"file_name": "slice107.png", "id": "2674904206211701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_2674904216211700_5887090414911222439_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbRpuv_lBEEQ7kNvwFzOHJe&_nc_oc=AdoZhH34R0VeW7FR3HqqiM-wuafbFFfIWZDGu3cT7221rlaFhK5lkum6pCwl1CEZtb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54Dp7UCwFbLfY6q8kV86wdRXA2aIGQfZ9En7P4rE8sqg&oe=6A1ECD60"}, {"file_name": "Background_20.png", "id": "24119719027652505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_24119719037652504_458498491943732053_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QOiFWOjBYAQ7kNvwFqEf3F&_nc_oc=Adopay9cnV0bStTQ6m5PCBNSG1HT0tQCbJ5xVBZMdfMwcoAQrKWbXMnNZBj__8HcwW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ss0Dso1Q6qF-z6AqyToUulPsFhzbZuvV0xH3mnPSsSw&oe=6A1EE738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1026102413027222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827277_1026102416360555_9098727519444918748_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPH6jCdwH2IQ7kNvwEoM64t&_nc_oc=Adq-rWMm90g4ToBS2GxT6agZpKY1CPFixp5YiVI6_C0rXeWMK8-YXsa3wWgXsvxvqN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75RzSPXUA-5wZqXcSLcAvgkWiDvzSB6AwZbAh8Fo7n_w&oe=6A1ED58A"}, "display_name": "Coaster Loco", "keywords": ["Rollercoaster", "Train"], "long_description": "# Defending 100s of tons of steam train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?\n\nFeatures :\n\n- Surprisingly comfortable to play - every effort has been made to reduce motion sickness in-game, including the option to play less curvy Tracks\n\n- **MILLIONS** of Tracks meaning ENDLESS replayability\n\n- Master a single Track perfectly or just keep skipping from Track to Track, exploring the gorgeous low poly landscapes\n\n- Great generic cardio exercise - playing can get your heart thumping! \n\n- High speed, chaotic action or just ride the rails, you choose\n\n- Family friendly, suitable for most ages\n\n\n# Author's Early Access note:\n\nDeveloping this game has been a hobby and a labour of love. So much is planned for its future, but I'd like to get an idea of how the public feels so far, hence the Early Access release.\n\nIt's not perfect, but it's a SERIOUS amount of fun when you get into it! Make it up to Volcano Country and call me a liar :D So play and enjoy - it's free for now! Tell me what you think, and if you want more, let me know by purchasing Coins in the game :D\n\n~QuirkyFB\n{1476478550488418}\n{1682544943125264}", "short_description": "Defending 100s of tons of Steam Train on a Roller Coaster from track-hogging alien shapeshifters - what could go possibly wrong?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coasterloco.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "QuirkyFishBiscuit", "support_website_url": null, "website_url": "https://www.facebook.com/CoasterLoco", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
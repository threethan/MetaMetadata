2-1.oculuscdn.com/v/t64.5771-25/75458093_937863470397648_8551699357845483224_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsWD7Hk_ODYQ7kNvwEZx-wD&_nc_oc=Adp8TKfEB3HO87YhV5aoR8VekdFxgJc4XWMt53yNqYehGO1FILUlknOT9d1Q1ER0zUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCleXoDw3EimZoO7I24KdD7LoUBaMF_BCchUp34Oj5WA&oe=6A50E696"}, {"file_name": "SC4.png", "id": "877167056208314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035387_877167062874980_5030204420721877470_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wR9xE5CsqhEQ7kNvwH4zWfl&_nc_oc=AdrkEkBC3yv_UyEzOgnM4dh5uZfLmLjHJsdf2Ty3SZpBrXmBuuX-OlITSg6szCO4Zz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD93qtXzMQXdxOeBTDbMO2W_5Ptg639YaWRUEYVvUeACQ&oe=6A51121F"}, {"file_name": "SC5.png", "id": "330266375380947", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297583_330266378714280_2169586506143080293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faeeT3LuBXkQ7kNvwEuOL2c&_nc_oc=AdoVIf7ssClgT3gO-KqBjfP4oQ8jguagHncC5t83df4snmuMh7Ug_b05XMmUWK2e0lE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2N9aDw0VIpUOYsKa4RS0lMDru8hr-Gb5V8axZEryKtA&oe=6A50FD30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverHorizontal.png", "id": "174747777965659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610706_174747781298992_3265066533625714073_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp-xNkwPs9QQ7kNvwGmP-LN&_nc_oc=AdrpfhI3tvZgAZe_tVW-uwCkIS2GpIU7G68lRNTX0bW988q7rPADbG_CNxXvSt4hPK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtoeJE4-k3K4wX_LRWUrXf7B1n_GwfxqArvFakSvVJnA&oe=6A510D87"}, "display_name": "BlackCarbon", "keywords": [], "long_description": "An ecological catastrophe. Everything is black carbon. Is that all? There it is, a single plant fights and survives successfully \u2026 Which plant is it? How did it survive? Let\u2019s see here, let\u2019s get closer to it \u2026 However, it runs away \u2026 Runs away from me, away from the human, runs away to survive\u2026 Will it? Or maybe the plant that resists, that flees, is a symbol of life? The elixir of life? Hope for the future? Demonstration of the power of nature, survival \u2026 I am a being that has also survived the ecological catastrophe, which tries to attract the eluding tree, I am \u00dcbermensch, above death, above every devastation and catastrophe. Can we work together to rebuild the world which technology has destroyed? I try to approach the tree that is distrustfully fleeing, to cultivate and make our common future better.", "short_description": "An ecological catastrophe. Everything is black carbon. Is that all? There it is, a single plant fights and survives successfully \u2026 Which plant is it? How did it survive? Let\u2019s see here, let\u2019s get closer to it \u2026 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VirutalUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8703594499761287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75289919_408961153
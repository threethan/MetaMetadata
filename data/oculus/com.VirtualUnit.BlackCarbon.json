6-1.oculuscdn.com/v/t64.5771-25/75458093_937863470397648_8551699357845483224_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T54NugHv9S8Q7kNvwGEn5oA&_nc_oc=AdqwZWuHG9kmkJt8b2pPHWCg82fZe99-cMbb3tRseyoPyFLUf8KhNGTtB4X9EgUws5U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8YYDUpfVpR6TevASQULBEjzMvFWKYwegy8ezSTspqAQ&oe=6A8AE896"}, {"file_name": "SC4.png", "id": "877167056208314", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035387_877167062874980_5030204420721877470_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AzIPFQ51awQ7kNvwFHUZeK&_nc_oc=AdqTPv5rp2i-cuTBpd9cN69SP4YTBAshopG6MvjFxOsGWBVxIvGaUE1_yEP8Mglm2k8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5Np_euA2RXCLnQyFHJWQ8HowY9FhAJg4Su8_9HjYOuQ&oe=6A8ADBDF"}, {"file_name": "SC5.png", "id": "330266375380947", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75297583_330266378714280_2169586506143080293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzp0pQt4Qn0Q7kNvwGyBkL_&_nc_oc=AdrdxPIHzOG8oPzkNML_Nx3kchf1RslOF2X8nTFmHC28gekVxu3PQWVHGBW64YDhd0M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9K-_TGlZCA-LFU1e5ZstCjGjIuHfNe74qSRp7Lmc3WQ&oe=6A8AC6F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverHorizontal.png", "id": "174747777965659", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610706_174747781298992_3265066533625714073_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D8NVxJ3EqAQ7kNvwG4UlTc&_nc_oc=AdpthYIkT5fvbIjOYX-YSsLGAcZlwYNlQkoyzx0D0jSlh5oMFBzTItSwvZ_h9f2S_Ko&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2FNlsoFSb7OJ7WyTBbcHC2mGXeTotoRDkwAX8Z_NC6w&oe=6A8AD747"}, "display_name": "BlackCarbon", "keywords": [], "long_description": "An ecological catastrophe. Everything is black carbon. Is that all? There it is, a single plant fights and survives successfully \u2026 Which plant is it? How did it survive? Let\u2019s see here, let\u2019s get closer to it \u2026 However, it runs away \u2026 Runs away from me, away from the human, runs away to survive\u2026 Will it? Or maybe the plant that resists, that flees, is a symbol of life? The elixir of life? Hope for the future? Demonstration of the power of nature, survival \u2026 I am a being that has also survived the ecological catastrophe, which tries to attract the eluding tree, I am \u00dcbermensch, above death, above every devastation and catastrophe. Can we work together to rebuild the world which technology has destroyed? I try to approach the tree that is distrustfully fleeing, to cultivate and make our common future better.", "short_description": "An ecological catastrophe. Everything is black carbon. Is that all? There it is, a single plant fights and survives successfully \u2026 Which plant is it? How did it survive? Let\u2019s see here, let\u2019s get closer to it \u2026 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VirutalUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8703594499761287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75289919_408961153
2-1.oculuscdn.com/v/t64.5771-25/75458093_937863470397648_8551699357845483224_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Yh0T2Q5cZsQ7kNvwGiI1jt&_nc_oc=AdpQf_KFOabZ0ltMQnYcXBkqci0xSkmzMb-f6dFjmE5PQLH2ZVzJ_4B0Eua-pnunYJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wMjQdGf1zAyEr5YsbyG4q03Ii5R11irQRHZEyjEdD7Q&oe=69DE3416"}, {"file_name": "SC4.png", "id": "877167056208314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035387_877167062874980_5030204420721877470_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CODwKTocBZsQ7kNvwFUhaId&_nc_oc=Ado4u13EsQK-fKxgX-yrBmUgJjNEuW1ey4RS1RetR85jhNU2DBVp6kP996fu9J4J6qI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ft71TrvD8DxnMb__rbF_B_qcniP55JAd6mqNjGVDuWw&oe=69DE275F"}, {"file_name": "SC5.png", "id": "330266375380947", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297583_330266378714280_2169586506143080293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceeT5N9L0ZkQ7kNvwFHj5O5&_nc_oc=AdrcvvpDJFwwqDETgUr4gK7-yjIYfR3FfmOZwdY0aOWozDi6KY9H07eAieLj9IR1U-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bQMTA_YN7C4RDrC2vUGx5J592PLZAdhF0A_hl-UcGcg&oe=69DE4AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverHorizontal.png", "id": "174747777965659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610706_174747781298992_3265066533625714073_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrX4nweKJFMQ7kNvwFcjaF3&_nc_oc=AdomMMsOGTWPVwVijBVhnHBysIJ224GSqlIjCA-o1PH5lZ0Qfy_-FnloZy9lUkVz418&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jI7Qjsh7bvMnX6pAztgvqlOOYURlDxzZsilFcJdQrRQ&oe=69DE22C7"}, "display_name": "BlackCarbon", "keywords": [], "long_description": "An ecological catastrophe. Everything is black carbon. Is that all? There it is, a single plant fights and survives successfully \u2026 Which plant is it? How did it survive? Let\u2019s see here, let\u2019s get closer to it \u2026 However, it runs away \u2026 Runs away from me, away from the human, runs away to survive\u2026 Will it? Or maybe the plant that resists, that flees, is a symbol of life? The elixir of life? Hope for the future? Demonstration of the power of nature, survival \u2026 I am a being that has also survived the ecological catastrophe, which tries to attract the eluding tree, I am \u00dcbermensch, above death, above every devastation and catastrophe. Can we work together to rebuild the world which technology has destroyed? I try to approach the tree that is distrustfully fleeing, to cultivate and make our common future better.", "short_description": "An ecological catastrophe. Everything is black carbon. Is that all? There it is, a single plant fights and survives successfully \u2026 Which plant is it? How did it survive? Let\u2019s see here, let\u2019s get closer to it \u2026 "}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualunit.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VirutalUnit", "support_website_url": null, "website_url": "https://virtualunit.org/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8703594499761287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75289919_408961153
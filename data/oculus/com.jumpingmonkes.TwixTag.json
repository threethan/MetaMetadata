2rrGeDqq0i26N1M00k1FXTQ&oe=6AFC69D0"}, {"file_name": "Screenshot4FIX.png", "id": "1637570723565766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818938_1637570726899099_583045228254797815_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK8Yy8xH7yIQ7kNvwFRc5gJ&_nc_oc=AdodKRG-ZJVMG8AwFqhhtGMvKdEz9ir0ZWuQcXvpPjdJjMKUVcfapLhFDp2J3QrnQrE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyeJ95GNWs_C8G054JOh2X3Hq6Jwh5LnSMOf3jVnQ7fA&oe=6AFC752A"}, {"file_name": "Screenshot2FIX.png", "id": "738937155147026", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824169_738937158480359_3408973034352276542_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de8A09OKSRUQ7kNvwGCm-zn&_nc_oc=AdpAy49PFqxUabSr8Qw-mm32ilT0BzQZGuYp6bY1DUaACzg6uHcvoYSVlQvqWv6xEN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQehkn59vLtIGPWw3nA6BJmuYzTN2Z94yE-Rfj3N3q9uw&oe=6AFC6EC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Twix Tag", "keywords": ["taggers", "tag", "taggering", "twix", "Taggers"], "long_description": "Set in a series of beautifully crafted landscapes ranging from dense jungles to urban playgrounds, players must navigate obstacles, hide behind structures, and utilize their surroundings to outsmart opponents. The game encourages players to think strategically about their movements while providing the freedom to express their physicality. \n\nWith easy-to-learn controls, players can leap, swing, and sprint, creating an adrenaline-pumping experience that feels as if they\u2019re truly in the game. Multiplayer modes enable friends to team up or compete against each other, adding layers of excitement and camaraderie. Players can customize their characters and unlock unique abilities, enhancing their gameplay and offering a personal touch to their tagger persona.\n\nWhether you\u2019re strategizing with teammates or plotting your next move as the tagger, **Twix Tag* combines the thrill of physical competition with the immersive power of virtual reality, making every session a unique adventure. Get ready to dive into a world where movement is your greatest weapon, and the chase is just the beginning!", "short_description": "Twix Tag is A fun game that uses a custom locomotion for you to enjoy"}]}, "developer_name": "jumpingmonkes", "developer_privacy_policy_url": "https://html.cafe/x3c069989", "developer_terms_of_service_url": null, "publisher_name": "jumpingmonkes", "support_website_url": null, "website_url": "https://html.cafe/x74cfb970", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23888514287457650"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1060994578777709"}]}, "baseline_offer": {"id": "1060994578777709"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750604760, "status": "PUBLISHED", "id": "1060994578777709"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23934766646165747", "version": "1.1.45"}, "id": "1247018717006410", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
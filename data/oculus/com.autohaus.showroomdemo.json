491823812_1399619445540130_5142020422862867305_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QliIbx2VnIQ7kNvwEKywET&_nc_oc=AdoA0nEFceGCS5S8f8roFxK5Qq-c-ibI3DJcAUbX7JvqFeTh4y__xrIqjqNTYZxHNpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnyjUjMgbZxJ0WTKu2ykSBHKtN255oFphvrRnorHIYyA&oe=6A63587D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title_graphic_2560x1440.png", "id": "2024677438140330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819859_2024677441473663_8761791460001799964_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aclZeDnqbcQ7kNvwGrxVrP&_nc_oc=Adrsa2oLkKy0ZtBQtBNlI5GQLz2KQvpA42Q8HE7bRDNweQGHOSur0TiM8wjcmm4BD8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD94Ng7DfHq0rTwRLCduxSnjfnp2N62trvyj5dkesQWAQ&oe=6A6357ED"}, "display_name": "Autohaus Showroom VR", "keywords": [], "long_description": "Autohaus Showroom VR is a native Meta Quest showroom demo for automotive service conversations. Customers can inspect a vehicle in VR while a service advisor highlights repair points, sensors, bodywork, lighting and inspection areas directly on the model. The demo supports Touch Controllers and hand tracking, runs offline, and is built for dealership presentations, internal training and B2B sales meetings. This public Store version uses a generic, brand-neutral demo vehicle with fictional repair data. Real OEM vehicles, logos, customer data or CAD assets are not included unless separately licensed.", "short_description": "Native Quest showroom demo for automotive service advisors: inspect a vehicle, explain repair points and present work clearly in VR."}]}, "developer_name": "mySebbe", "developer_privacy_policy_url": "https://myseb.be/showroom-vr/privacy.html", "developer_terms_of_service_url": "https://myseb.be/showroom-vr/terms.html", "publisher_name": "mySebbe", "support_website_url": "https://myseb.be/showroom-vr/support.html", "website_url": "https://myseb.be/showroom-vr/", "
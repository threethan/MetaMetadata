ufsgespraeche, interne Vorfuehrungen und Werkstattkommunikation gedacht. Die aktuelle Version nutzt ein generisches Demo-Fahrzeug und beispielhafte Reparaturpunkte. Marken, Logos und reale OEM-Assets sind nicht Bestandteil dieses Store-Listings, solange keine separaten Rechte vorliegen.", "short_description": "Eine immersive Autohaus-Service-Demo, in der Kunden ein Fahrzeug frei betrachten und Reparaturpunkte nachvollziehbar erklaert bekommen."}]}, "developer_name": "mySebbe", "developer_privacy_policy_url": "https://github.com/mySebbe/autohaus-showroom-vr-meta/blob/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "mySebbe", "support_website_url": null, "website_url": "https://github.com/mySebbe/autohaus-showroom-vr-meta", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26795545493472203"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1494572152114021"}]}, "baseline_offer": {"id": "1494572152114021"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778766060, "status": "PUBLISHED", "id": "1494572152114021"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26837020809324671", "version": "0.3.25"}, "id": "846624538520576", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bi
ng", "id": "1126331361310193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031397_1126331364643526_6289353851064734775_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-akFnbUwojIQ7kNvwHG-LiE&_nc_oc=Ado1LgoeCBjZ1Zicy-sKV-Y-cBz_1hyo00rj_1pbkG_vMGDx6TE1tTipSwJt_VjIQHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4KInlxxE2vLJsYr3jGgCfNmlOcWpFUdmMeYR1-gAzVA&oe=6B032208"}, {"file_name": "ScreenShot.png", "id": "1115503085714586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570288_1115503089047919_6582591289835709932_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3JEiYLhGC4Q7kNvwHDv78P&_nc_oc=AdoRaWPLTg_A9wW3P2p41-4uKxuHhtuipEnfWvQgiq21zI8T7woGwh0XEkfeiJ-7g_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWPlh0QS5xYfdQETbToGhaltTTga6mzgd1hNcKxm4jew&oe=6B0311A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "5678342925531938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974897_5678342928865271_3266511836018651528_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4Rjukj7PTIQ7kNvwF9CoLc&_nc_oc=AdpkRSdY6Z9MvBWcNv_jKNf_5DFD5GUeLJZmCdK1z2ehB550AULL5LwXaDQid6vvRY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSGcgXqnJMzoD8JBUfUthgSf2jaWOSVfnuFwVTsJUMvw&oe=6B031378"}, "display_name": "Hit Contracts VR - Free Demo", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "This is a free demo version of Hit Contracts VR. It is a action filled first person shooter that lets players take the role of a assassin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolici.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net/HitContracts", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1109699263277094"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5122692114506244", "version": "1.4"}, "id": "646937426337450", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5019306564844800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5122692114506244"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "646937426337450"}]}, "change_log": null, "c
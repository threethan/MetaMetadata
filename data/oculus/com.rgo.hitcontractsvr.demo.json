938", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974897_5678342928865271_3266511836018651528_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs58eExX4F4Q7kNvwEpIE8Y&_nc_oc=Adm39j_Zmkm22v7eTgFx7hhWF2swO3brXpJWL2c1RLmt-coUtx55ybUYnqVPfwjKM8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afui4qSRqMuefdtAcKeJiuWRhVHlTk2IM6qS_oz1t7Njxg&oe=699D94B8"}, "display_name": "Hit Contracts VR - Free Demo", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "This is a free demo version of Hit Contracts VR. It is a action filled first person shooter that lets players take the role of a assassin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolici.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net/HitContracts", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
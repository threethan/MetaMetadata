EsOr8jJi8WCbSQoD9HVe5ghiV0XMsh0oP3Nageg&oe=6A733549"}, {"file_name": "Screenshots--Lotus-UFO-2560x1440.png", "id": "1248457520061769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499292712_1248457523395102_6700646816675550900_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOY3ZuJiE0sQ7kNvwHkv5F7&_nc_oc=AdqI3yTxgvXQ74JU_SVSBfbIg_6OI-dymhP7qfUYRZPAlY8tCjR8AQj_EtYjDHipREA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtWaAVl2vI3xR-q_dxPZnWZC2HpAAiED1KX0AwORt9dA&oe=6A73405B"}, {"file_name": "Screenshot-UFO-2560x1440.png", "id": "753210610941822", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296057_753210614275155_7268024804258720525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N38YT2actjwQ7kNvwFxox9l&_nc_oc=Adp0dXJSEC3_VKJ0XPvKK6_1fYUg8qD9Flxj0C5PAGz_zJpGQ9Mxvl8lI9grAeJVgyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4deau2a5GJTcVSYepUWiEaUlL2DbB7MCF2YkGxvoFxQ&oe=6A733E24"}, {"file_name": "screenshot-fish-2560x1440px.png", "id": "1236711851770080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830812_1236711855103413_2301596970810082025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIpXaEnj6UQQ7kNvwEHuKqp&_nc_oc=Adpm4CpG-lu5vOoQoIEXT0KTf3N8ebaUiyObeyYxEZ89cEcDe-RIucDwRahsO7b2-lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkVLlrRgurycDAUkZgLfBeqMBSyc_Wky3ragNi3bFdzA&oe=6A73479E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neo Art Space Lightship Ride", "keywords": ["Cinematic", "Relaxing", "Experience", "Ambient", "Art"], "long_description": "Neo Art Space Lightship Ride is an award-winning cinematic VR art experience that transports you on a breathtaking 13-minute journey into a universe of radiant light, color, and sound.\n\nThis 13-minute guided experience runs automatically\u2014simply sit back and enjoy the ride as the Lightship moves smoothly forward through more than 30 seamlessly orchestrated scenes. Glide past, and sometimes through, glowing planets, swirling galaxies, mysterious UFOs, luminous butterflies, flying fish, shimmering fireflies, a rising firebird, and spectacular fireworks that surround you in every direction.\n\nCreated by multimedia artist Philip Noyed, Lightship Ride blends monumental geometric light environments with gorgeous, ethereal music composed by Emmy Award\u2013winning musician Jim Oliver. Together, image and sound unfold like a living, breathing work of immersive art.\n\nNo gameplay. No menus. No stress.\n\nA seamless guided voyage through immersive art\u2014perfect for relaxing, meditating, or showcasing the power of VR to friends and family.\n\nSit back. Glide forward. Experience Neo Art Space.", "short_description": "Neo Art Space Lightship Ride is an award-winning immersive VR art experience. This 13-minute cinematic journey runs automatically, transporting you through dazzling moving light art, galaxies, UFOs, a glowing butterfly, flying fish, fireflies, a radiant firebird, and spectacular fireworks. Over 30 beautifully orchestrated scenes and a gorgeous musical score create a wow-inspiring voyage unlike anything you\u2019ve experienced before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.neoartspace.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Neo Art Lab", "support_website_url": null, "website_url": "https://www.neoartspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
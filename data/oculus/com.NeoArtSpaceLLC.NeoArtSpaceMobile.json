0646816675550900_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOY3ZuJiE0sQ7kNvwHkv5F7&_nc_oc=AdqI3yTxgvXQ74JU_SVSBfbIg_6OI-dymhP7qfUYRZPAlY8tCjR8AQj_EtYjDHipREA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtWaAVl2vI3xR-q_dxPZnWZC2HpAAiED1KX0AwORt9dA&oe=6A73405B"}, {"file_name": "Screenshot-UFO-2560x1440.png", "id": "753210610941822", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296057_753210614275155_7268024804258720525_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N38YT2actjwQ7kNvwFxox9l&_nc_oc=Adp0dXJSEC3_VKJ0XPvKK6_1fYUg8qD9Flxj0C5PAGz_zJpGQ9Mxvl8lI9grAeJVgyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4deau2a5GJTcVSYepUWiEaUlL2DbB7MCF2YkGxvoFxQ&oe=6A733E24"}, {"file_name": "screenshot-fish-2560x1440px.png", "id": "1236711851770080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830812_1236711855103413_2301596970810082025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIpXaEnj6UQQ7kNvwEHuKqp&_nc_oc=Adpm4CpG-lu5vOoQoIEXT0KTf3N8ebaUiyObeyYxEZ89cEcDe-RIucDwRahsO7b2-lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkVLlrRgurycDAUkZgLfBeqMBSyc_Wky3ragNi3bFdzA&oe=6A73479E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-03-31-21h28m54s054.png", "id": "1571913787368024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1571913790701357_6890105925909826413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhxUfCyXK-AQ7kNvwGL1fr-&_nc_oc=Adqbao7LgVd7Z-ffsJqCDJmYpXL3VDVOFHDJrjxO5nBQ9oAHxpTmD28qtighiX4kjrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFRSAjjJ6K6MVogjqo3npNUnkrEZt3e0Ll7iiHI1t9yg&oe=6A7355C7"}, "display_name": "Neo Art Space Lightship Ride", "keywords": ["Cinematic", "Relaxing", "Experience", "Ambient", "Art"], "long_description": "# Neo Art Space Lightship Ride\n\n**Neo Art Space Lightship Ride is an award-winning immersive VR art experience\u2014not a game, but a cinematic journey through a galaxy of radiant light, color, and sound.**  \n\nThis 13-minute guided experience runs automatically\u2014simply sit back and enjoy the ride as the Lightship moves smoothly forward through more than 30 seamlessly orchestrated scenes. Glide past glowing planets, swirling galaxies, mysterious UFOs, shimmering fireflies, flying fish, a rising firebird, a luminous butterfly, and spectacular fireworks.\n\nCreated by multimedia artist Philip Noyed, Lightship Ride blends monumental geometric light environments with gorgeous, ethereal music composed by Emmy Award\u2013winning musician Jim Oliver. Together, image and sound merge into a living, shimmering work of immersive art designed to evoke relaxation, joy, and awe.\n\n**No gameplay. No menus. No stress.**\n\n**A Guided Journey**\n\nEnjoy a seamless guided voyage through immersive art\u2014perfect for relaxing, meditating, or showcasing the magic of VR to friends and family.\n\n**Sit Back and Experience** \n\nSit back. Glide forward. Experience Neo Art Space.\n\n**Usage & Licensing**\n\nThis experience is licensed for personal, non-commercial use only.\n\nIt may not be exhibited, shared, or used in public or commercial environments, including ticketed events or installations.\n\nFor licensing and venue inquiries:\nPhilipNoyed@gmail.com\n\n\u00a9 2025 Neo Art Lab, LLC\n\n{1577511250022179}\n{1324158216208883}\n{26975545948719139}\n{1466040415264598}", "short_description": "Neo Art Space Lightship Ride is an award-winning immersive VR art experience\u2014not a game, but a cinematic journey through a galaxy of light. This 13-minute guided experience runs automatically, transporting you through galaxies, UFOs, a glowing butterfly, flying fish, fireflies, a radiant firebird, and spectacular fireworks. Over 30 beautifully orchestrated scenes and a gorgeous musical score create a breathtaking voyage unlike anything you\u2019ve experienced before."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
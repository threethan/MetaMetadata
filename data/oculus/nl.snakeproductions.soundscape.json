79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l34jzkoJX_EQ7kNvwEJ1jMf&_nc_oc=AdrvU2euBwRYMDvTeNd9E7C8dP3bxCcnAps79AlB3186vD_mhKzhIjrUJcimPxP6bFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa6vqYGWBKBELOc3FNKCNmE4n3krzUTG-1CTqqKp1liA&oe=6A75D06A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PYkSVTC6a8Q7kNvwHkw4On&_nc_oc=AdrO-cO7yf6uHQUyIhId3sba5wiZeP1w0tq_834wcodJsEp4G48HyUIcJ5Ec5e-B29U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsg0jiXPNQoChc_YYgpFwyPTxxHBBedQIdCYxZ0MvnTg&oe=6A75F022"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a332wmTlMh8Q7kNvwF8iGKX&_nc_oc=AdqQvEopWk18FIitWcVtPE0kXk2vAsABu6NpOLERvcA23yOQDDqf8Gc9BRmdo95CUkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKQwMISnf5kEzSQNX2FfFVGn_0eMpwMFyBN6vb-c9_mQ&oe=6A75CD4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO2wcLA6LbkQ7kNvwFxoMgz&_nc_oc=AdrJ9M0j9IExB1vPpAwL3FDF8CTFGEOZl3IgMHBwGnpA7ql0usn3T0xCYXZfNuooEXc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39IZUpwz7QK0b1hHwaRBlQR26Ux7wTbJjwxS1gJdwCbA&oe=69E76E6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El2cktesrVcQ7kNvwE-1Byp&_nc_oc=Ado6br3rlBE7ddnPGFVqfDx2VNA3rSezctTpaXfjO3Mnd8hAlqdPP306pup336Y2o3o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cVA-NEcu2one-uXwVXUJWYdRNG3JlCHEy7R6V3rQ7lA&oe=69E78E22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ7SOuYbf0oQ7kNvwF2RxgT&_nc_oc=AdphXZkVz_ODwdBKRTqoEMgLm-W-vrqhGgvsdkgZlSl60uZojIN7kFsHs1gPkXTjceU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O-9i_6ehzht7Eqcs2iiYYK6kyJxE4gqovQmR1AXEPNw&oe=69E76B4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bL7UpzsoH1QQ7kNvwEAaV4m&_nc_oc=Ado0tDbXE9hF4ksvMvmkYctoywdcioO3RDm-cmm7up4tJ9A8I8t-95afhNkAOOldvwQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4id3_G7ZrQPVMqtkKn2YXv-pvCPzmg3YKC-_-4Nk-PJg&oe=69FDD7EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDLRrOm7gMUQ7kNvwG_jPuS&_nc_oc=AdqmxdNGpd-5p_6UtQkpVzwm19SlujFfQ3RvLpteXxvucZNvJt8aqdbqPDSt7LBdDhw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5USwYFlk1TtTnvfIRir_UzAuRFEfWfHklVyriRPULZNQ&oe=69FDF7A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XqQWy0VD2YQ7kNvwG5RUbq&_nc_oc=AdpAm-j6In40V2KFQgByP2LVNHz0KLBdm5kJDZ_QTIBDZPGgMjzG4yofulBov_hdPQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ectcdNPNfMwuIDrmmNhcrpnRlHHuW3s2_r97D3kvOiw&oe=69FDD4CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
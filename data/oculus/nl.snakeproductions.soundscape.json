79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEJcvFQn5fsQ7kNvwHdcMwh&_nc_oc=AdpxWZh5PTOHCe1Ow-eoD0Ac8-W9wYSSq2AiGVYNzuncwrHFJ_wvhMH_cfgn5GM3674&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDaj3D63j_M73IFyKMJdxOTak9dJHcXQO8JmwDwKyOcg&oe=6A5F66EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0zOxOxiV1UQ7kNvwEa7Aj2&_nc_oc=AdrhZBOJxIQUCj7SnVLgh7sd20GOk30LGMwzSbMy7sl1dFdNjDct3FvtzOYyNoOFtFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzzyQhgppwL8BiO2XLLsF6NuZHt-2_HqdC3bBjn-Ozhw&oe=6A5F86A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTRtnXueBYcQ7kNvwGlEQpK&_nc_oc=AdpiYAHYS3-CNepJcvdEJKoNzwTaF5_1yx4OYe24DMrY5sPuMwDu66WkZnxK9_Np9LM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3_pUFAvqwLvkePpMeGK4MQ418oFh9XWxQuM_o5fj3dA&oe=6A5F63CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
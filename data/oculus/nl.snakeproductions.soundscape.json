79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhJuGdUJ2bkQ7kNvwGLwITL&_nc_oc=AdpLM7_HYYeqkFD4QdhH0fZvJMcme9t4KsANhENWPj4Cm5U1khTyqq6hGdV33f40_Vo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GU7f2I5cjEFWRzMj2lYIQuT5R6HCN3EM_rJEHsPW9-g&oe=6A38122A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CqPvq7AmKgQ7kNvwEFMb_D&_nc_oc=Adr0nS45IlIvUiHIqIw1pcK4nXZJ6MIdqvbqZtFWJXF7t59-gLHgxKbYLntNDUEdAWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P3VBG7S9fUhpEixff37e6y5Cl1l43Hu78hD5AyQ9S3A&oe=6A37F9A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYfTIbxHyk4Q7kNvwHLvINl&_nc_oc=AdoWkDKKGi5cpBovbUKRbkPWAVuH80RRIMaLD97DPYF0zxxHRFVDwxOdbU8bU1411bQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bJrDY-mAjBD01lypyeJh4uVV1GgF2VOGHG9S82PWE_w&oe=6A380F0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
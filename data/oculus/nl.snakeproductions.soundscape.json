79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DimL4tBStEQ7kNvwGmxQ2b&_nc_oc=Adp1GNVc4WrHl33Ieri5fbWecIV0hKFgip62pAZG9Kf6NIUhDPU7Xpx0PWmCqCcal9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeb7ZLqmmBvzd19L0cM_d1VgoVdUn6XHtFY1YmqUceaw&oe=6ABFDCAA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUsvN6HwkJwQ7kNvwG-gwpl&_nc_oc=Adpk4MDSrTwGvZ7dcaiC2crnhZ4-hWlNqyZKAvYHahqHk7BSF_1BLWso5JTt0UfUXf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYK4nP3rNTvI5BASsaEMc8wJWqTSc8ZFp_K1__aj4b_A&oe=6ABFC422"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzir2Yo6pVoQ7kNvwED0uzK&_nc_oc=AdpgFWsG7Kp7wFqp1gjH8BRc-szIIIKJ8NtjBvCG_ChtDiAlZABDPAmgGJjejjpbt78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHid8d1gO1fE8qkTCfAHdO0CxfJsn_Evfp-yPMqnTWGg&oe=6ABFD98F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
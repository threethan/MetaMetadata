79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGAJdibA4yUQ7kNvwEKcwuD&_nc_oc=AdpHxUTai-i-PPVSLPdSKSGL_MrAwa0WKmDZNoVyt_qfTct0sEtIANkHGRhFCpqvAqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVwwz89KVbtWMQ2k8_qySoYDvUy7WiXCXJau2xI5tsig&oe=6A50E66A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaySygsyuD4Q7kNvwE08h_I&_nc_oc=Adr4Ffzz0MycdAwIoy9_k0GFEKEsIUtbNhhAu2mdZTgTzcfHQQtpwt6AAhkJoZ-bAqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAykOlm6dFwHNOaFRPHSTw_nQSUOem-9x3LkNzYIRd3ww&oe=6A510622"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYR3mDP7ylYQ7kNvwFBLjQT&_nc_oc=AdqEvpoQ4_h0DNRh8eziK_O0df8tGqHEjSCwB24cnfsdIPH_KV77i4YfruBZqfR3HJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBURXZPVuuTgolnHjZOGKXTIyXjGz9BiQK-B7aQBoI-pQ&oe=6A50E34F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
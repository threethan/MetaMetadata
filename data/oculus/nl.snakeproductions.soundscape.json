79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95Jqz6YXsdcQ7kNvwH9tXgA&_nc_oc=AdrrF56cYYHeTQX_toAzex3VVJJF0Howr4keMGAiqee3XvnNCK5hg0kZXEonZIJzEYg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ay6ca_dnQMikyhHI078pRfJ75pNX3TXPtTMZxQSANfg&oe=6A0C586A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6hVzYONvgEQ7kNvwHSQQDf&_nc_oc=Adp8JgABm7Y51gqR5BNKhVi_1B4_cBNKealQGWZqTNDVTekULO8shid_U0wjJXck6VM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZpF4Hq_xzAMxZKKJ_4IreLrvZ-SHSPjhgcPmZ23dtpQ&oe=6A0C7822"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3YVPyFQ4YQQ7kNvwHbLzLD&_nc_oc=AdrLALJY0DJrZtvGlDO1EsRux_0psRSqv3oFrfbIRPrQme26cmr7yU0Mkt9elGzm91g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cDzkrKFjE97ZTiO-4bTALPFRM9qG9KALv2xqC7Rly3A&oe=6A0C554F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
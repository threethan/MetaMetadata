79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA0eYg-HxvAQ7kNvwF-9Ece&_nc_oc=AdqUW86aRaqT619KlmrqIZzV-Mg80TrUyPYK0VJPtCyG1H_9ZvVivFVjAcF8bTg4vWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SQIrcCylk-53fEQ4JTcgK3TtahySEicuG6R6gko9-ZQ&oe=69D2566A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XViJYczaowQ7kNvwHEnzXn&_nc_oc=Ado7K_yjk104KMMpL_d3eAdn1ti08R7gAJ72q6fEE9wNxZl5iIdWRpU4W5Juc77UsPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af105ldIOzYtM9vw3b_W5Ra4PiLn_mWmrCabDfzevGRTxw&oe=69D27622"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_m2WYKo7qEQ7kNvwGkipfl&_nc_oc=AdqQQa3UNpWXlbFavCbOLxiz6ioa8LZZOMoSXmJrz8d4Pmm0jhjJpoKsebQF032y_b8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05XdKw1p9XIE7Dwy0Qw03oJ1tX_fD0V5JU5Odbx1WKlQ&oe=69D2534F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
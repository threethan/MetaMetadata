79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFBpRwAKDd8Q7kNvwG4GJYp&_nc_oc=AdqhB7Pia4l6QR5QiMecwgjfHrXH-HksnuDLuix4uksFSr6qTrpKhJP5XDvEAhd6av8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6HmoYDetYCIk5-1v915NaiO0cnlHHMQjn6Y-Mb5ch7g&oe=6AF498AA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snav_rxCYgYQ7kNvwHKBL42&_nc_oc=AdpTkNUQ8yBnfoNEY0thy9ADap8BVDNcO-8R5J9ZilGNEIEAjifU5m4ldpOtZGSnYgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWdlMKlNw_JtDRC-dAT9EEuRHcXzTFbzbpN7tEeZbJSg&oe=6AF48022"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcz2BezRZL4Q7kNvwEOev2_&_nc_oc=AdqGN6uw-PPaShj95xc96jmMp4h8xt3KqpZoe9NLUnGQMfNP_ghHHzZxoJBTKiw60hk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8hZQdMu61UDI1XhHjky1nE8cXXVmpNFKFI-0weXSg6Q&oe=6AF4958F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
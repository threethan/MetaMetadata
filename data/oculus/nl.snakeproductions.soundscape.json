79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sVon83HBu4Q7kNvwFU8pDt&_nc_oc=AdqFT32WFxgO0gy1YCXqYSUvcHjj-6EBnzDj06DwbMk3igVBnqgKi3-QAspcxowkv1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBroHOZ8tQWZL4iVSEBtL4YDz9OdMMihMbwNEVAdkgrnQ&oe=6A6C95EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shS604B8zZAQ7kNvwFm4NBw&_nc_oc=AdpuF-96nOrKd4lXKvQJoPbYR6g2cmtRhkJMe6RTVCXh9V-xbmba3h7M2IYcxvlXK6s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdfuZd0YJu0_YtXCmtOdZkl52BIT-f75vz-a8HXQazIQ&oe=6A6CB5A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C8NDPE8pX0Q7kNvwEqEiIG&_nc_oc=AdpVGS5e0lCWR5dLC1MWFcR4NJPq8xzPHVvkuC7HdSMGbjbsMTGJGRCMCn5QZ1xJiVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6PTfRzKalVJvV-BogEd6S2PsEQf-v6LsQBATpEP23Uw&oe=6A6C92CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
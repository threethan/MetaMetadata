79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UyHD57cY18Q7kNvwG0o5fR&_nc_oc=AdpwgyVcU1X6P_Y7WTt-VcOWIh5-NBmkwxcpVew1aroJQWdgwzwuW-x7r2QPW_Fkyuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDwbkHVtRRuCF15x9N24mgu6A5n0cMUTroTEQBjPvWsQ&oe=6AF88D2A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx7Hu1QBl0gQ7kNvwEaQdLE&_nc_oc=Adp6-xRhdyOSgM-KcVs7CsQBm--TbEQLZec6RRaPnWDyQP0BEmPP7Skz12cclfKQPm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpJM3_znbSoG1HENdTs-AG8uu3iIQm1uQ-VR4ho94q8A&oe=6AF8ACE2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx8mbjVk2vEQ7kNvwE7jA1C&_nc_oc=AdoLGU6FW4SRY__d9rNNcH7Q-XW_CJie64HGHaF_rpis4BNXjxUMa5_RIpYyl9gkZ58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT75LcYMR9YxOtxYcttJx8akssuJlMJ1hxEue_dGbKPBQ&oe=6AF88A0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
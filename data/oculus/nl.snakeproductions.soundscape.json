79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOo2196I3WYQ7kNvwEL_pcY&_nc_oc=AdpsFaQseO7Hi7TU9MQUnQTc4CGVo9Myuy5Q827fz53jlMik3OvVBWFuhMFLFKc3fjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGafp-1o9j8mFDLSPoTpICMCQ7-gQuyswuoXtiYyW0BFg&oe=6A92D16A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9rnKiOG88sQ7kNvwFD5j63&_nc_oc=Adqa0PVPUoHBsV2nvssJ_MbeDCnyBjL-cMHLbmEekYG3yp-CzrNn4WkLEeRc5458aZk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKKcEI3e3BOnXqwLbGS5DTWpCFhUz6wN9XbHY3aXiEPg&oe=6A92B8E2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v9SlCVyoEUQ7kNvwH1ODiw&_nc_oc=AdrDm4dkckQwQfTcFjUiJ00kEsZuQKurYBE5aZRMrqw5JwYS1a4uJlyTbxiaDiRf9yg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSEH-v0S6v7BReyNRVzZTobtysUpurfZ1iuCIsYmNP1w&oe=6A92CE4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
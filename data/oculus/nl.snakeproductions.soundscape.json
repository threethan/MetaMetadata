79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzs29AgvrVcQ7kNvwFcmPQo&_nc_oc=AdohiNNiduqwwRL3FaSOCtU-EmuYNH9aYSqcqxv7u1vFyrvQJV5aevQY02ORluu-VsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETRAgrIXYMREX4Ip64ZumMNaY7zRGORkj4cIbYyB_oSQ&oe=6A747EEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PYkSVTC6a8Q7kNvwEaDS4d&_nc_oc=AdrIwDii6IvLvU_n2k8pk094HK6P98_a6slgnqIuXY25EoRlrIy_-lHK30BZSIgUDs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzCrR7cGi76LqqecEfpG2VGEWW8fvLwpgMdOOfbkOe7A&oe=6A749EA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a332wmTlMh8Q7kNvwGT2REM&_nc_oc=Adpkjc4Bejih45DfmPN8GRJo21HLNOZ5YUGh6OnlOgpiTlYgyQAbii7WhqFkx0nBFPU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECbu0lI_Uu7xCoyPhsMRWlH04BJr2nOGhtfxILwLNAbw&oe=6A747BCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
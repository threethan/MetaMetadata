79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlG-gaeNJFQQ7kNvwGRf1_q&_nc_oc=AdrVb_p3NW5tT2EfUIbCKPV0TpS0NEcc0Nof-MhffKRTSfidKgu2uwtvzuq4OajrfHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kidTRG392dFg7yJENBcSu0TN5v4EATf0tEiUbqqUe5A&oe=6A31426A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaPyc7m7V3MQ7kNvwGmJWXI&_nc_oc=AdonRUBL5mrqXCa6hgQ4AklaT-xx6fNS_7qksufoBetEa6rdWb9Lcf_ffbwY5sTn7Fg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pwcbR7yUtB6C4H_ZWoFAZb__uPpiw7Unbno0NqP11Qw&oe=6A316222"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEF9n-pJ3UoQ7kNvwGPFraY&_nc_oc=AdpXXD8u0xAnYGgZSg-hldl5r4PvDr1mBeLi2yfNJfTuGkQCW7dSRjsWrA7nUqF0OfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UkgB-8mLSOs80KSyUn8ElkBkVeuqZcP76UCIwxD-SbA&oe=6A31778F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
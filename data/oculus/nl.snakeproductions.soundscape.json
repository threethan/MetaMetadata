71-25/12602079_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zObEcS3oQu8Q7kNvwGA1TSa&_nc_oc=Adptgv-Tj-72Y1FwfIdMALvkEAsSh3AXkEiT9mddg0OJU4taWK-gQAWU8HePry_3XVg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMmsAR9domKfHQK8Xyaio9FOFQ6_RipjuxvC1W9uVsDQ&oe=6A8EDCEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Dabtjfjaj4Q7kNvwG09_se&_nc_oc=AdptEPiZ5-pBipNyvl_3F59nzXx9paR8lH23oIunuElR8mMH5RwDD5q0Ww4V5HOMJSc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELbncu-3r9qYPImHI15z2En6Su1UxyrlO7IndmpkdslQ&oe=6A8EC462"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOJzPH8NcnsQ7kNvwFj-_an&_nc_oc=AdreSkOs_dCsu8dGqz3_kfXgTuRaR-wEuXn9vhr-P2N2LPA9LmW7qWwOdanH78iF_dM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSwIPCcY685jyZ4ImsxbtXMBswol_P6k7S38CWR01DiQ&oe=6A8ED9CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.snakeproductions.nl/", "developer_terms_of_service_url": "http://www.snakeproductions.nl/", "publisher_name": "SNAKE Productions", "support_website_url": null, "website_url": "http://www.snakeproductions.nl/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "258480259629308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12482310_2080002415558541_241539614_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-rnzzqOd7MQ7kNvwHD6QUX&_nc_oc=AdrVYzKmL4Ve1k8sYh0e-fx1c5oCUT5dyhJyaSX2BXY-xddx5nhSrfDWrbmdeEJ-Q9c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENceL7OHJ37RrATWLyM5gj3iqysKA6qU8a4V0C7h7u8A&oe=6A8EE460"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soundscape", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "991773164253343", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1073687572742391", "is_first_party": false, "enables_in_app_ads": false
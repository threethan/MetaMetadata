79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtLbmL821hYQ7kNvwFh1uaw&_nc_oc=Adoi00IXXm48_C4pJlII4y2et_CktTpi6XQbEIxDQ2exvj5vZAVHCDhPAX_QcobcnpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkKPwLb62ZJfp74MSIABN9WR-tZWsbB8dpdSeBNp5xmQ&oe=6ACBBA2A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaMX9DRkMvQQ7kNvwEmxj9V&_nc_oc=AdoJ1XUAtEDjXpHbZ4awSz6jKjk4JskAyYTCOwR4dv887h0saLq-1TJl1rXURe3mEvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlyFkTPm58PMuFcGrbrjfJ3jNuAN1jN-PdfrAPoGcmbQ&oe=6ACBA1A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWGewgLtc04Q7kNvwEWs4sU&_nc_oc=AdpcvzrZxSX4bRAChM8Ju5oltv065D9G0bRr5Yn-iuQ3fcSOS7SYAS2TIP2ckfBBM-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ2j4QO5AQAbRgH_yiOrZpJ_3hEvVpvTRzGKViuF2iJA&oe=6ACBB70F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
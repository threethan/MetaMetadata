79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8wckAuZlU8Q7kNvwFQtE9-&_nc_oc=Adq-CFNLYadEhgJJu4L_PSPMhhzzT4mwsGGOWW3s-0KyWhHZEOzwAPoVl0YaNj0jr_I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCMCHhkot2-CHs8BOlyDw__z3qg_6ao9PF4wGLSA_mvA&oe=6AD3A32A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esE3mTwkVkkQ7kNvwH44roW&_nc_oc=AdopZt9pN7mk-9NmIrUoyKgqbbXipwb_PGWbiuqiB8Be0GHnHJKdiC2PcV2ZBiJpgpc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHIZhFxmljyUOWziDyN3cJVd-UdvVvqACzLWnMef4c4g&oe=6AD38AA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyAIXOA0oesQ7kNvwHJCUVu&_nc_oc=AdoPHJ1KgVM-fS8tjJ5yJiCcLQaq4dw718xOvffXAtGAuHi_12x8oo3WGq68LZOGjcQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-yLlF07_a5wTSwuyXd_nbCLXn8XZzDt1O_zour6OpzA&oe=6AD3A00F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
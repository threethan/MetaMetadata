71-25/12602079_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wTbaFGli6wQ7kNvwExUXZW&_nc_oc=AdqQSvuylHnb_t9-Yzq165pN0GKGBBeHzYWbMP1KWaVPz4d2V9nXz3APeokZ9IpTsng&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG187yYnBIOKr5bchFr95_tpFX0HJIYul1tT0f9pQjK_Q&oe=6A85A26A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJeMVGyz0fYQ7kNvwHevGPn&_nc_oc=AdqVmtO6hGzh_0FOsJ1loTDKKSOZvsK8LliHrAebKAHGHHmcub-dcJhcJHmzCLUaOEc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOcW-Yj_NCPkFgO9T10DgFH0jMdaW_QW8k7qItfbb51w&oe=6A8589E2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsdZNjIB36oQ7kNvwF-mQ9H&_nc_oc=AdoVHY7EJ1b17PugIgTM8TV7V6PuIakBJAYW0iaLAhcPbOHq18p8ytQrlW_DjUv1cDw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdKMbojJ1bZlv1WIGIQaFrPpBy3cOlOj7N4H-A7zOoTA&oe=6A859F4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environmen
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDf2FJeCBBIQ7kNvwFvaLlD&_nc_oc=Ado_SswNCsN1hZkcu91dCXqe3SoeYODjqRL8S1Sk_3Dq23JSJ-5xG9ksWjWBR_x1hAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lcrQ6TEn1o6RZCD97Du6T8PD1SU3Cu79iZ7WCRyHl_w&oe=6A43B76A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vi1XdqOZuMQ7kNvwGDy5YQ&_nc_oc=Adr5K9iAzpedK57Vc23fVZEMo-VauuFBwcvmkUV_yLzuF7yBoMOX5kPBDwErX_yHkYA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nj-dWy0E7fQs1gh5pYwxGOG6kZyKHV8Vvk4fKN3YwCw&oe=6A43D722"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r9CsaYM5KwQ7kNvwENYBDH&_nc_oc=Adrsqu9_cOdIU26PhZANjT6xBSwksRcHLNcW1q_R1JrwrDvhi5ii6BIkVkgO_hXFxok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_qzgv1zPxBzJlLuzo6Xp8m7ZwjI2b0udA9r3Wjytl5w&oe=6A43EC8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
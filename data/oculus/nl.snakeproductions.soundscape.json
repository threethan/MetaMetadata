79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KXjOEQq3YgQ7kNvwGc6JEB&_nc_oc=AdrwJkaYpbGPBXqEOqveKkZuaeDesz-HAZFTeeAr6PPwpjODkRlQt52IJi7kgoAw8KM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3c0bSFuSYU9s3sZGN7k9vGMyvE8M87WuahvOy60MpUA&oe=69C2846A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nN7xsch5gUQ7kNvwH3W93D&_nc_oc=Adr_qyuDKF1ipBf2Sj6qycJGmxyvHsk-GRNFssUkUcz-6fYfaNdqXA6MdkCMDahwJhk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIpuzjbOHs-jMMzl5-LzMsZ-2v7iv4Xh9UX28h2MR1AA&oe=69C26BE2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkdKTaoKA48Q7kNvwG_3lGx&_nc_oc=AdrsDds9Pf6SQTD_eWIbAhTTvgdsyQE_wTcwI_IYvvMhb9GhlShrNQAmgReznf2E9nw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSwHpUVkOQX2CXVLQDLkVh-JZynYSrs-8XMlSQDH-saQ&oe=69C2814F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
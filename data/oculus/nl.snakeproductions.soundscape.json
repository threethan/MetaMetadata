79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJVWbMTRzZcQ7kNvwEYVJ9w&_nc_oc=AdrS_iye0d14CxW5lWf6w2ZSwZt4C3J8n0vj6kBCDQBLyRBEnv6AiGFsdNKY8sJyVX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EFw-cfnpJaiP2c1sYHQ80Xb8KqXcoSSZfjP10G-YyAg&oe=69D64AEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPkyLzHOqP8Q7kNvwES4TYk&_nc_oc=Adr8-sOvpKZ6l-HP9hlTWWBBYmg-g4-nMY5h4FFMfP48uOTBCBcJUi_g2Wdwl7SuBHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o7TeR9w9-UBcGT3sfiW3H5Czwf0hnJgphFbBbhs9Yow&oe=69D63262"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dULbnmW6zwQ7kNvwGdNYEq&_nc_oc=AdrTKphMfcefzwod0qFoAkNuDTafxdJaSCzBXnd0wFWud3yu_I0wLKB5q73djlD783A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NJI3FFCyqfhxQ0jrOs7Pg31rYnWPpubnQq9Zy06G2Lw&oe=69D647CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z55i7dwijkQ7kNvwEXVwq4&_nc_oc=AdphgVwUHRHyJYFqdooh0GJPz6pixC5ZoaOs-bOtSVLR062hnUdzX1To8LL3TbEds2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTKmDF6r2Jr9tCxtEU4huQev5EQ1Uc2uqWMS6G8VuSFg&oe=6AB669EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51z8KzlThFgQ7kNvwGKkuqu&_nc_oc=AdrjTM6pdFtz04BRTCZpYbdpQ46QrbdRx6lyZba077op19ILoharf0B9ATQDS5GHqq8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8So4940PSpRpUp_DXeC1zMJlYvjvLcz9atD1__IIYqQ&oe=6AB689A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9hZxtADxkMQ7kNvwGajqjO&_nc_oc=AdosdIRnfxQknaX5JW5fMriMQfuU5kAGgDIpyKMvi9g1_l8VlcKF_JstkVcOqV6lFsU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILYl075dlXnHa7_xAvfB8qIrSLAjb74l-sshy_rHLlfg&oe=6AB666CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
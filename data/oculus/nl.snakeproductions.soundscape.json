79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kDD4eElr6IQ7kNvwEOH5u2&_nc_oc=AdqQmCL81HrhsA0nLA3zaGyRa76wTIjMV_CHaR3rjivKHOcdm7CKtEU7k_KYNgjP2co&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34PuzzE2EppResBf6aeMK7gcvgKjK2g-BjJPfltx_0yA&oe=69EF576A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aYY1YQdtNgQ7kNvwG3Aai4&_nc_oc=AdoaD_IiofPpCkfC_y7QaGVooBEDj5zQwDmItHGTtQrrktYorygMOS2woG8-lMkFO3A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lwNb-ac66lpFCZ2mgeF_fWQjgWZsEuS3akegCnJ8wgQ&oe=69EF7722"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giXCoW3qeqIQ7kNvwEgWtIL&_nc_oc=Ado4IMZiFEPCDvrz7aG5188pqqF93fJJQYvgwMEOAsO8oopo3lfc6zmnTd_4Tr2TeXk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-Kb4tZsNgl-UDhKYbFmbwm2Lc7xDgj3IsxpCpQZ4gBA&oe=69EF544F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
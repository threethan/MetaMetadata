ith 2 other randomly selected people."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.snakeproductions.nl/", "developer_terms_of_service_url": "http://www.snakeproductions.nl/", "publisher_name": "SNAKE Productions", "support_website_url": null, "website_url": "http://www.snakeproductions.nl/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "258480259629308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12482310_2080002415558541_241539614_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5QiW1cvX_sQ7kNvwFMX2Fl&_nc_oc=AdnVV_DCovGSVoMAlMR5FuwfABhqBQ_kYdC3l5lZGkoealZkfDrq_49n424V3LkTD-o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuXmHLSrH3QVyJqdqeYsKuJmnq37iEFUWal4CcGgbIQ8Q&oe=69A19660"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soundscape", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "991773164253343", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1073687572742391", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", 
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l34jzkoJX_EQ7kNvwEMeUAv&_nc_oc=Adp6-xs5aHbKqhsse77VZYkTKWflmgNFDEtAimKMgv9AWU4uJ_sqvd9JyThH3WlALaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA6pyIHyxxqrgGSCNfumdR003yP22CCyXFhETI5Z74nQ&oe=6A78736A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mpseTyjS-0Q7kNvwEpZnzL&_nc_oc=Ado3itHnGKCiZGDC1gbpgcafxvE0hfF_0iENoQZbGRihQU41vNb_TiupjCDJzN9nCFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoqngB4vOBlkiVGovZYZMnq1qpW_5vYBUcvr4ly3sOzA&oe=6A789322"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4_M7u2FV5kQ7kNvwFuIzHg&_nc_oc=AdrSJKru7VkLPAvG63M11305st0_slLdL8bOdCh4aOpM5bpfAQrhIihX6w7MUlN1Wy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcSHSguXWTqYiihrZoK830uGQ3UeMna56ppHRuHpMO_Q&oe=6A78704F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
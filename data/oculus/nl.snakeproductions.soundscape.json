79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEkpzekMWXkQ7kNvwEK6VSw&_nc_oc=AdpGWEgFEJOMWx7Uhe_NnuF8HsaHUwFasdqs-gRTdk3Tq0G81XAjoEfQYgtIwllh4bA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3Y8Q0kb6FzReGG1lXBDsgkavRvxh0cssG1jTM_pUYOA&oe=6AB2756A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PLLqbM9kmYQ7kNvwHZHFTW&_nc_oc=Adrj6OlTolI0xp956VLz4Xzx3Hnp2OG7qIpoxgtI7pORdSyVeWWsPpdTTcEIjD7ZaPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeosuXl8PYlDdQyKcKAOqVhBfvidKyVaotAo7v0es66Q&oe=6AB29522"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74JbKMyO_LcQ7kNvwHuZTl3&_nc_oc=AdpLrvcol9y-Rol8KlddkCcGEHLDA-oOpUrxdEKN4SyakyoOYi6LdVl8C-lYTFuebXk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGIDdcfteBBrj27ARskvFCQ5WUxtTHr_Wsn3Q3JSzpQw&oe=6AB2724F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOBug-Dgdd0Q7kNvwFuhxvm&_nc_oc=AdqdGOxa7oxYSwFzBnkAfYLicU1LLXgQ8nvgh3Aqd5o_IdstzSl5SOEpWzEv5yuvblU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmu-vRlQIJJEddynaEZqtbhG6RKg8_pIyXRN3ZMVkLUg&oe=6A7B166A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEC_WRu0z3MQ7kNvwGZlEW4&_nc_oc=Adqalmxx2nJ-a2brDkGe-eTtnhTgrEJm3V5BoN6DDLiMheW6cXbFbcAySrmabE0cOOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE5KL28EkzPMWP5TqcRSYiTx4TF6cb3087RPrspvxtFA&oe=6A7B3622"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4_M7u2FV5kQ7kNvwFFJQ6u&_nc_oc=Adp2FRpkf0yFG4sOJAUBGfP0_7egLB3jnBP3nNuqeF5l2q241CXKhEthRfvAEAVv4zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAxQd3oqP1Iw7ZoENazeHZJUh38yGYH2CByT4b1jDsIw&oe=6A7B134F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
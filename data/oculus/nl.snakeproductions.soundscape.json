79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhuBvWjOnocQ7kNvwH9Lwou&_nc_oc=AdobTELsP4q40qd1Bly-SNsrnpUUBrjdyIX4WZGKxsee2CJ4LSqZjJh35wNmZ1YSnWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk2IhRFf2nOpKkczhTh0EbRuKgPybUmdcI-wjXKpBO4g&oe=6A984FAA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQE1hk1c5y0Q7kNvwGGcsQm&_nc_oc=Adph531ZeHHTkv3PxA4sPG_7TNuYu4z1rReGcPcVRAyVCMDUQ4V-tUWCSAhFcc3TGQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSFqTC6694CQdXgTNOEB0XsEaEniUfgLpuk-8cKAxx6g&oe=6A983722"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab_15fQOO58Q7kNvwEIkxa7&_nc_oc=AdoC14mgp8VMKTELAb-RzGfb2O_9oEXBZXpWq0mE2rY5KIAwznu4Ipk91vnKwsaq7UU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSZyHSwqEUDq-Tfxsl7yDOs9kSbqIezDf1tI_7TX4LRw&oe=6A984C8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
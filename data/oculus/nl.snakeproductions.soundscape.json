79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkfhUSXb90cQ7kNvwF0VVLx&_nc_oc=AdoZWLsYBvoT5houhGv_f4_zsOSo5SLKyjZouGbr6hhPikV3L_IDsoNr56jfsjtgjMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gP2YYE2tbMQfeQFlSEo05Ec8iPTOAtDmelFAuCghsZw&oe=6A19876A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzN57C8fVr0Q7kNvwH442Gz&_nc_oc=AdoA584TOVt3vPdbFlmN3gw58gAr1krPb_uF7Qw_ckFd17SPCcBydPxaFhnFbptEPgI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bOfU3sXT28nGwTV7bHtwChbMOJqCC3Y9ACdgy3YHXMg&oe=6A19A722"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixSYmumaB7AQ7kNvwE9jDZW&_nc_oc=AdqbzLxi44WS-7hLjR4zvfWc2ukQifvyAz3czvQxOL03P94wWCR5fuY7RQDfsFH31OE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gMVb3BICRKll7a39zUvtvyTuCLhhRbIjeD1mX_Ac0kA&oe=6A19844F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
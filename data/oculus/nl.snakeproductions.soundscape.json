79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGhyfT2GTVYQ7kNvwGGzfay&_nc_oc=AdqoDdPEUBDid9nep3df2y9rXsW-P1mA3Tf23qZvLUuQHW3RVyNR9-R3uCTR559JiDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af641WWJZ88v95dgt6twi27Lv38Sreej4iUBEZ57OSY4Ag&oe=6A07126A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOJOszLnlvAQ7kNvwGbYl5_&_nc_oc=AdoQPcAa2xJ_Cgk7L1YmvxUlOzpy26iENcBQDtY-gOIheoEEyj_NteI4GQh2M1kkpQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SE0Vh7B_KhHW2xKTSbxMpDgo4BZG85wqSYlLJ2--RHg&oe=6A073222"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6ekyw62SzAQ7kNvwG39vux&_nc_oc=AdpS77OdLfJsPgEBqFQ6pVqvswGPzCSLb6zyZEzqp5wN51IOChxS4vtCqDSNoZQBqPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kUxZNolVyCNrBjCKfQAxrgsrE6iOKG5vmyVWp9hmWUg&oe=6A070F4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
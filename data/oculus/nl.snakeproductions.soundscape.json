79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hM1S5UuNi88Q7kNvwHz8ctv&_nc_oc=AdpQ0bUO8AuyFeL9RIrjmwyoFCpwIIgAUaf7z-q6CiYsh5N7VVwa16cwOx6CuKK64z0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSzpEOq6qen8mdoh0Zg_txXK5lVC4k0BDTweb0X5lQZQ&oe=6ADF486A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSKxthBP2rQQ7kNvwEszwhb&_nc_oc=AdoHhG8lR1Z9Q3kCPdUgwzPsUnWhl6Y5Buei5GXPQWe8UTIKVozeWKSDKU1dFRaX_tU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPt0pNcGYcP9Ua4gKEzMzn_-PUoCV2mlXXGUOZ9BT7qA&oe=6ADF6822"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t17rkJMcyr8Q7kNvwF-G7Nw&_nc_oc=AdqnttewIGcX1H_4uJNjc1z0WntwnkrJGHJompg_O1uVleEN5BnNVAiCfc565zqEJf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYugJLChWtwZdSLP7ayugVoqmKdf4B9VXgp55jaHYMlw&oe=6ADF454F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJVWbMTRzZcQ7kNvwFkl3wA&_nc_oc=Adpr4FTz8AI0_viaq3do3KKZ7aN5m9IVSXu7cRIdQPlSRDIN6f6Mg6eMnVLYeT7dxo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RkF36gwnW0g7zFVk7gXMzGt-M-eTyDX5WG6r9xm6xAg&oe=69D3A7EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XViJYczaowQ7kNvwHsGzt2&_nc_oc=Adq4Yb2Wv8I33r01lTF5fBSIMVNGcBOmmLR0J80JYjlBFAgoqxhuAmE1gUavEnlqazA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ypjlZA6ibz57eYyPfvDforn_n6wbe9n8wCPuoY_Am4g&oe=69D3C7A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_m2WYKo7qEQ7kNvwH2Djol&_nc_oc=AdodKyY-efRjz3JwERkvh8-EStCgubcFbO2N2hKPTUhHxzmlB5Xi1S6Ia6GWcCtHZ50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29wBdhFnnvFmY4v6Jxr-KIyiCa56o6brqymb37mtXB9A&oe=69D3A4CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
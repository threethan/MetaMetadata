79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DimL4tBStEQ7kNvwHDCKaG&_nc_oc=Ado79p03p-_sg5Bs4mgblyXP8H3COY7nIDXAxRL5uX_U0nPdbXWnD9AkWfFSQrgszKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5QnAogDL4yic2EEHcJqXTltIQ3o6Ttzwh1v3vK15Azg&oe=6ABE8B2A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUsvN6HwkJwQ7kNvwHz7zFo&_nc_oc=AdprfiCFWo8eo6BChd0Djos5XbWBOm7QZNDvVRDjnY5dBO8DZYBZN3A0-HlJDRic6ig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvVw5cOtkWMNE3U2tPCEsPXxUmwFyfw3bwFBBkggt6aw&oe=6ABE72A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1HMj5b6FdEQ7kNvwGf28zc&_nc_oc=AdoYixwMAMgCXTz4m7ftKT5rCkdL20cgoq9AVsQmF8jLY9d-gPyvtI0QoWRY9E4Lxzg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIb79otR1CW1BqJ7Gpa_rJI-cD-TLhKNZnK9mtdcsrag&oe=6ABE880F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
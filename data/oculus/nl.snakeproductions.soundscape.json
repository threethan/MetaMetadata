79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwL9RAJEkAIQ7kNvwGSShJH&_nc_oc=Adr2xe1Bor4EQGVR8SLf80hMUvN8PSe2dKKWwW-OaBYWU0W163QmwZewbcUKP3ZJsKg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W2SsD92I7K88rtMNee2DuuehS0GKV-2k3meq-Q1MWZg&oe=6A24136A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa4YlUgvn_IQ7kNvwFBwPuS&_nc_oc=AdoWZZM3wHQL1S5geQDDF0lPlZRcN3Yg0QJyONQLFAbEaVWHsqZvymX5ed4Y8KIaOPU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OyJtKOYt3_PfrrvUBeVhTaOipVNNIvWjDhGqI1an40w&oe=6A243322"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBiQalru_dYQ7kNvwG9b8j8&_nc_oc=Adpz5BmPG0g2Js6tyY-T9DTcK1Ju1Zwqz0YbVMbaYJynym5CsZ94vwWIJ0JrTBDpCrc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sHljJOF5wQDi-m7LkEjVkT-poKVUDwUJhxbzDqC92xQ&oe=6A24488F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
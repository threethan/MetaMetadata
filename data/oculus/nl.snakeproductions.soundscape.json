79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8wckAuZlU8Q7kNvwFYNa_O&_nc_oc=Adp4GvigvVB38mPTp8PPMnfk3wHgnoYadvzKBRfpQFkTaFU5AbhNRNuKE3f2WOo0iFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsTYjGwxULDPQEl9RPpts4Cp8cNb6HXXFwaokpClyDsQ&oe=6AD251AA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esE3mTwkVkkQ7kNvwHtaXFX&_nc_oc=AdpGv0McCg2-vtskHjo-r7AkgNtATWPJD6NKVKxXeqqat2iOlZU7s2UZN6a8CbDxGPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFRz8r3H9mlaPukPZSh1QDD9vLAiTRRxhoSA-Je6JC0w&oe=6AD23922"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7N8ZLMgENQQ7kNvwFyfOl7&_nc_oc=AdqRs00_WVA0L4O7mLq12fbPIkz5evn3hpA7WZV55-zWjZ3hvGvxx70KhdCNskRzN0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMkJtAraII10hxaUOP2I54pHzE6zmUl1yTXYoeUzeKAQ&oe=6AD24E8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
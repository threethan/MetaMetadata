79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlG9kNO4fnAQ7kNvwGaAr9H&_nc_oc=AdqUkv-VQhIhCUPfqpbVvZhnTL0IRurU-sBqGqgke1RYyKjryc1QRu1LMm2UycJp9S8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FAwRZPWb0RzIxMFa7eVnyk63RGqDbW0Lkebmt3_4J_g&oe=6A21706A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IskC3M1VCDsQ7kNvwEXCqVd&_nc_oc=AdrV2IA7bp0d1Z1iP2_G2r49A2IaNRaIM78bO-SkhFuE4z-HcRfV1IbSf2_QTM4MRnU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZKdyK801bwDWOQPXmeJfSf3WjSmSI-lYv4ocHdz3C-g&oe=6A219022"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBiQalru_dYQ7kNvwHGihbY&_nc_oc=AdqWs5w3PjeuZv1W96EW8Nc5jPVERgfluGy4M38t1Ayav_qn9qeGiHM6cF8wEIHJOMI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ut3gmFrTmqI7uf8sMgW1G1e4RHOf3lurs2tZYo4neQg&oe=6A21A58F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
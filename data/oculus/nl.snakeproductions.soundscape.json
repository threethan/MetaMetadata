79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zunTII3GUikQ7kNvwFsTdHa&_nc_oc=AdpTh_v-ca0VJTcmk1Tcr6fFPzcEiY4vARGdG_0gxZSEL5vgHa6XkzW0gfQkHd6Qv6U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsoNitGMWgylEprYySyUV7SNf27YitPmMIoKTeA1dIEQ&oe=6A58CF6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRrEInC8iLIQ7kNvwEAkRYu&_nc_oc=Ado3GqMf3HQEkFgdLzlBkzWDhkQhTmwtZ05zqauK42OGCZJ7UTHjk0YgsCVB8JC9ZNE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg0oXtMwl7h2nwpcVQEdcYC-MT9I7mzOXXSRjLCCCVtw&oe=6A58EF22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR8KPkDAaD0Q7kNvwHF53u5&_nc_oc=Ado19oNLkyBDgMF4uhPgW5I4r5Ol8sgvoJT_zZ5bXkaYJv7ccMcXTvwP3MDdNgF_4gg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu1pgDBsj5qccRo7o2CS2e-S6n5CtfhEBPtCSGXdfyzQ&oe=6A58CC4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
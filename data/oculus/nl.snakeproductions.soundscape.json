79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO2wcLA6LbkQ7kNvwEiccT1&_nc_oc=Adoz23AOhCO9B-PDlIXHa-JBoJ-NYfibqlp7VMBPEzn780SKmelRZjnHHkE9_lNjADk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PFxPt8EwLMmeJGiWEpEqAX1gtGsjV0QQb87ZZq2hDYQ&oe=69EA116A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7XcJW4eKIMQ7kNvwG7re0K&_nc_oc=Ado1d2fvoiZ_SHQB07maE5XrRH_gVw_uBRRXC8xOvhgviM_q3E0wA5D10u25Z_95JSI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2asOuSvDNIypKBHzQNUNNhqA2g368ixkiKaVFenslAHA&oe=69EA3122"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCOtwBm1LqUQ7kNvwEZtui2&_nc_oc=AdpW0B6Z9w6ssEwae3vbt9Ap_QE1Mmkassu_Cw5EUteo8ynxj2Oo4Ln805ays5qDNWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pkIpHHMa3WFrNrZOjAGcybNdrX3Bg849YCGB5l_xQ0g&oe=69EA0E4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
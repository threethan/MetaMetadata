79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdHv7R3EgjMQ7kNvwFdZ8Zd&_nc_oc=Adq8ky7k-RkutP_0SsoHHWCZVgr5mwbDB0VsebOs1tWzpKv_qSa2Eo1DfVwqIRwc8wY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7sJtL0oJKGSHovj69r97wuOxVlDqP7Emo4ljABhmrXw&oe=69C5276A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIYOgkt6xiUQ7kNvwHX5P3s&_nc_oc=Adp-yT5K4SxT76oFJiTcMzwI4zZ0sGP69fKVvc8sLX36t4uMk3R614zksoxzxu_O2HA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3-8bye1TNnuXy3io2b8IPdgNxeHYETEKjwEIJtOFfMA&oe=69C50EE2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkdKTaoKA48Q7kNvwECeZaZ&_nc_oc=Ado0Q_258Z1vFqivG5asN8v5meDZ7oIwSFSYZ800xuhhEIfuuaMObVSSJJxQRSrOM9o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaDEWYTwl5-ogoGk1zx4QG201wR_PDynoxvXdKanBqbQ&oe=69C5244F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDf2FJeCBBIQ7kNvwEu5SsT&_nc_oc=AdoBQnensntsCIRSJBAWrly3gX17qtbZHD-2WoWqBK7ePc2u8aReF57dtqL_iidcpbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vglEQVnYyEYmB_hZKPzptZp_TXFBHnkSzAL9Ephdiag&oe=6A4265EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMKRsIi3VJwQ7kNvwHABDmT&_nc_oc=AdqHZnqdsIsjDkmZPeFOgpQDMPmepMflBG5AD8ZoAzFW9iuU0WhHq-ULelNqr6Em4d4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PL_bPxLfhtJ_S6yRkpLRdQMGVTLU0wpotOUrBv8QBAA&oe=6A4285A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r9CsaYM5KwQ7kNvwG1DH6G&_nc_oc=AdqSZ1D8nfKPOsGrOZpmd0IU5xbVGItLhWi4jljmVCV9QFYmbvZQJ9EqHDS0TowNNzc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W2nwoBn1Kk-ia-uEION0TDr0xrAp_NYhfVTaGLpj4vg&oe=6A4262CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
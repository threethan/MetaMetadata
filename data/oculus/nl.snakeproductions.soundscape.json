79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ6iAJ1-6zsQ7kNvwEjQxHv&_nc_oc=AdqORjXWnQOGvE0cyZNGHFWkD1IdWYbX-so8_Zn8-AVpdLs1bbiTO1kkZ1h22RZB-C0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIXFeUvHF9RaUa2Gq8UXqxqmG-8H4-VBxxlAysCh_zuw&oe=6AEB5E2A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=excFU5pgZeUQ7kNvwHdg0_a&_nc_oc=AdrTV58ROjatvncAOpfJpqvfk9NW6W5ArO-Luw9-Ajpz9eNExFjeEwJao2ANvi2GV4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNbu5RDi9sxJJKiXUwTSs19DJv9mmEKZnzC6uGTVGDlw&oe=6AEB45A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXgu9QQgv_EQ7kNvwFoeU8T&_nc_oc=Ado9reCBOinA-cVXHvg4DxPRbx5NNnFMljSLkZ9kV9mNXbTtsIJGuTYLUaky7CCknkg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRExQb9GvZz5N1uQ49AckXsdqx4dN8MuzZis_L4RdErog&oe=6AEB5B0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
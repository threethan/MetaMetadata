79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtLbmL821hYQ7kNvwH4Y9-Q&_nc_oc=Adqb0LMKDiONTkB7XoFxnIrB3wYAB3Tk86QiQ6JNb-pr3AmDRnPJYrMth4R0Pa0IFCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkeg7XcA6vIY2cVzGxL3UtmaBGk5DER4JRrR6KBNabxw&oe=6ACA68AA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaMX9DRkMvQQ7kNvwFCAps4&_nc_oc=AdoVb_Q6mRd5rdwjhAvsBrH_SQHLZzVTq-1vTY3hpAUBqiXFMPmxyeFN83YufFsYZ7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0iGCFeAw779O1q0uXp7x48bCq_zWx-NNQoafVpHlnZg&oe=6ACA5022"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Pj__uHCMagQ7kNvwEWy69S&_nc_oc=Adp8eb6ym8hMJfnmikitOLcnvutf-wqCPRxFDZiHvlmSp8z68iElFJwDFEHR0d0FfxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKRc5eOrUinhnQY2Me_D863pZ59mgggEYU8cXyKYxCcw&oe=6ACA658F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CJ-udjNmQAQ7kNvwGBru1-&_nc_oc=AdpO1uuy3MhJwhQN-6nONrOCxkNXUDBWNHuADAoWE676V8gdFQ78qTTyvAZoYU1sMCY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoR-QP2rYVy4_Q2Ko8Ct4QIbL0OVPtayevCDCNk_dIXw&oe=69C7CA6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIYOgkt6xiUQ7kNvwHnh7Z4&_nc_oc=Adrk6BkxMc9Zq3MmjQavpklKsGFhJdVDW3kgGLFi9MK2x2jIHB2mrscm_MGT0EazAog&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZeWkTgQ8N2rRkhziEFbUsNuAjHu0rmwZjSmV40yKO4g&oe=69C7B1E2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOQwy-z_NEQQ7kNvwGyNhLc&_nc_oc=Adq0Is3K9A4el8vr4e-n6NrbX4mzS8d0pYK8lA1y6KBq9uB78mEATbtEk00eciTZpU8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDrMmLF99G1z9eylok4ZQ1x8N-_WLX_nzzpo7LXmUQRA&oe=69C7C74F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
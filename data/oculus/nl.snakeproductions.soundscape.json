79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO2wcLA6LbkQ7kNvwE9bP7X&_nc_oc=Adq-xLokhpk-uXFxJkvCLE3odcH25ywa1Zeh1ZS50ZCNeOy-rBYjCSSHZYvt2k6-h2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xBO4Q1vLs4s4SA93j-HJadU2zWnMF_FWzFZ3UXvZLFw&oe=69E8BFEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7XcJW4eKIMQ7kNvwFojXEx&_nc_oc=AdpwFdyDhydZ1evsc5S3EUwe2uwNCIWYbszawxJV-8Oz40XlQ6WPSH-jLM_-3NsxoyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RxRjE3HU_D0QOhTO4GCYM_H8kqz7VGZzGeNwHSOcywA&oe=69E8DFA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ7SOuYbf0oQ7kNvwH4BgqE&_nc_oc=AdqmNaSLLXYBiUjmK-lOUxK-F3SQr5FEyih_AmdFAD80nNGIFTVWV1OIy9ivPBezurI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LTiQ0dYNwh6Uj-7TwSVmPTTe_Wj-tUZ0czPrFMRL1rw&oe=69E8BCCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
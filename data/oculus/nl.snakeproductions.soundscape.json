79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr2MEmf7ZAgQ7kNvwG1H7n3&_nc_oc=Ado1yc4Dv49sv4qCnCn8rtF1r2AVXQDsQM4YkHSFDlwLOXZDLjC0ww7Okh3Rb5eNtkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xYRyzGw4RkUJQsJ197gz_USa56KaUvQu6w4MuL16BWQ&oe=6A47ABEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrtxF0VDFuQQ7kNvwFjbb1I&_nc_oc=Adowpjg3yNfSEs-24np70-RpfGFKPTI-vx-S9MiW1QPB03ie6GrFeh7i3OYIr_GIFwo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BWYUxqxBUHSML0nzBGDbQ10T2xfi7IcyI48jeldtYZw&oe=6A47CBA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8tQAhY_hH0Q7kNvwHWW0PB&_nc_oc=AdqFD-_Jy0WfOo_f1vQk-nfodr96eaBAI6q6eE0ATKXv437QDuxXR53gmvuQjm-9Wm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T58IZWgJ3PsTP_Opk9JiVvTcV6qsywihy28HOFnnqaw&oe=6A47E10F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owD1tDBhvcAQ7kNvwFvsdUH&_nc_oc=AdoD-aATqHgaCKjFMfxQ9CpOYq2fPO2p1Qkzu7uZVAnI2eaOJaQzmgDWZ9cL9uRad1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZEBI1NKaJhijoTeMdA_6cM-3FMOCViKE2MFvgWEPlhg&oe=6AA5466A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IXYtYVCIQwQ7kNvwGY8bBc&_nc_oc=AdrPBIVKckx4RzEqFzELjixf7RlVZH1G1crqFac90NmkEcT2Ga87LeviWpKQJ13jEAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIy3_yUK8ifiwV3WwZtDywhyzVdjRf2dY21ZmKX0og-Q&oe=6AA56622"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S17vMQkvJ8EQ7kNvwGtm7Bx&_nc_oc=Adqs3_sQsDNH4JvWr-OYkpdmm4vh4zdoWDfJJcEHodA4totVpvU3--8omH0h7RCN_V4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKoeTxdc8UmS5VZv5sTIrfxp3U-lQ2PI_WpOpOKJrQwQ&oe=6AA5434F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
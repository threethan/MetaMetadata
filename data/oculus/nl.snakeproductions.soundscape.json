79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfEI5fCRxpwQ7kNvwE5R53q&_nc_oc=AdqoQcy27IUjAuAePnqM8YMxZuY2_O8N1q3OO9PrbDnF9PtIalvKv6IjtwzF__TLLAg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX2dkGPbKcLhrpisAw0JmhQJ-1_OFMqn7elGfmY-ifnw&oe=6A8AE86A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oimZohHpn4sQ7kNvwEZF1Dq&_nc_oc=AdqLxxNe52u8mr5iuwOiMgkMd74b0EqH9P1r7IJp36meajERcIOXgJlAmTQgroTf5G4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCzw4jk-aNEjTNiSqhsHdEsr4m7LHTypJQ8p0ZQS5xjw&oe=6A8ACFE2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdY5N8FyquoQ7kNvwE7TMF3&_nc_oc=AdoKMEElNd4M6c2dOsoDfgdbp-WHKt8dxoK2iErX7jhuEwWUbqS7eCFEHy65DSACHOU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwfnPVCFSpYbyDF_1rp8ILHBICGIbmzzScOS-cZoqq8g&oe=6A8AE54F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.snakeproductions.nl/", "developer_terms_of_service_url": "http://www.snakeproductions.nl/", "publisher_name": "SNAKE Productions", "support_website_url": null, "website_url": "http://www.snakeproductions.nl/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "258480259629308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482310_2080002415558541_241539614_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dR6XCoN8PYQ7kNvwFyToq4&_nc_oc=AdrJltsg3JqjN7yh3DnzVzzcOHfb2XJdwjDCKf3tBMu0M2SInqIHQ53EqZQ5ki3cE8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAvEjN6j92me8-b7kFVDXBpU_H_ozVUWAMNtHZG0qhSA&oe=6A8AEFE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soundscape", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "991773164253343", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1073687572742391", "is_first_party": false, "enables_in_app_ads": false, "is_concept": 
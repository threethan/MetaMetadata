79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEJcvFQn5fsQ7kNvwEdLWdR&_nc_oc=AdqBk2Z9KkA5NzQEyZ01RvTWLfJqCO8o5ibr1ttPIit1l3XILS_4r1zLzrCSXZfzRkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw_rgXlYGTsir5TGyo323b_O83BRnB2g3KOJMn9UtRNQ&oe=6A60B86A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0zOxOxiV1UQ7kNvwFRi2uM&_nc_oc=Adp3i0ElzEtwgq6rFjqwp5llF2a84GEmTeB3y7IpSE6kpMmE11m3u8zipColFiB1F-o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApIk66QaP1u6_wWsCr-k_PPn0s_YxYLBO8jrtXcVNLSA&oe=6A60D822"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWDwZXWg6ScQ7kNvwEus_zG&_nc_oc=AdqrrXMcEXcMeoqrrMor9hG-NeRqVCN7ZkTfZLLCec5iBf_To_eVt8WahFADHL_2xj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3jDs7uXc8yvD6CQH8zn5aLel4KaYvTRiWxJayB5j3pg&oe=6A60B54F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
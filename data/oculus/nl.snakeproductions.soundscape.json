79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z55i7dwijkQ7kNvwEp3ACS&_nc_oc=AdqZ1yv4CWJdvY02W4FPlCPE2q0DSbXwZwwK3XLmaFopTwWpxir_9cL5afc3SwI75Co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2WkWnP0ylHCSYGao_UOu0FDZddW6YZztUga6ZM0tsAw&oe=6AB5186A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PLLqbM9kmYQ7kNvwHCMGYC&_nc_oc=AdqJtvwVmMzWc_p05UIExrto3feGL88wa2yXHSp-Be7uLsoXtahdxERupUmBL55jCBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt4gu9rK-4nrLcT_4aBuLCC-27nTMuRC4fDqTkgW3ifg&oe=6AB53822"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9hZxtADxkMQ7kNvwGte3qe&_nc_oc=AdplqxOgRBvXdBQqOXyOmGhcFNL7aksBj6zJP8X2YnBWO6fIem32LvowFX-ZrCCUiTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMKroVQX8ywFF5213Z1JbsrG8sGEoCkClcmCmXeIEVBQ&oe=6AB54D8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
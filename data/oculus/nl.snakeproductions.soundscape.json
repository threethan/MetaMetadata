79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOo2196I3WYQ7kNvwFiIoGt&_nc_oc=Adq9QS3l5b2RHbeHh2Dr7Ci852yuuxB3NS0nbI6xam63U0zJKYp3lKnCEFPtN_545ks&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnOC2mDVcsZyVH7wly9srpdBMZ-ODOpKeYrF8TA013fQ&oe=6A9422EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9rnKiOG88sQ7kNvwGCyB0M&_nc_oc=AdpDHIjKjx3oSOznl5-wKYYqaS8ObEkxy3Yus2uhlnl069TCbtcbZey--ucPd2Y7trE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpm87Ems8xn29-GIzN8og952wXJwrDuSz7YgLqYW5XsA&oe=6A940A62"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08wpkTTCJwkQ7kNvwFRnkC1&_nc_oc=AdoGnrlL68oqFtip-jj7HwfRzJEeoK9L8jKGHJE_HVP7bOfOpAoY1cWIen02HUasXoc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbIIAzudxrO-7AK10vHh2yPdm0wPLiKYXDksG-jA7aZw&oe=6A941FCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
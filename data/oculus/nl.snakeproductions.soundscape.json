79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXHQP0CCsFgQ7kNvwHUr4xg&_nc_oc=Adq542h0NqNA2zOjA_1VH4tfNsw-AA4-haVd_OIIlY-XlppnbOBLOc9MZULvWixeUnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCQsGo-oKhfx1Qx82yHawB0C2qJs_MkUqhSri3cfjtNw&oe=6A6209EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0zOxOxiV1UQ7kNvwHdtJoq&_nc_oc=AdqqURFMWVErE0bdXfGg7XrWg2UWWJi6sF0KSiZ8DEYSVG2b0LFIpn-R0SBb_02OKMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhtPbbSxrrD0Q5bMECVvAXAafmfSKpQh-0bKfdUk2OBA&oe=6A6229A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWDwZXWg6ScQ7kNvwH5IOA_&_nc_oc=Adpz8WsVqgon51v4mKLkh6TM-gET_Az_6u3lh4XfzgojAyfPufZSDlBP5oPpQptN8jI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIplEZ3fkc6PqGfmq9xPj7_F-8M6zlUIJlch5i53ozXg&oe=6A6206CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
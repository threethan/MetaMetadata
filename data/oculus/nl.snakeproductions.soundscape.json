79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RX27XrWE5HcQ7kNvwH_xQzW&_nc_oc=AdoLiGedPbgJshUlSt_LuWRonsVL49DoTIIksGSc8lPSoNzv6upMDQkZDuHBiKXF6iY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBk0sZe5H942y4_yFR0qDlp0ZEhzGbalANs-h03jecgQ&oe=6AA2A36A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IXYtYVCIQwQ7kNvwG3XHxk&_nc_oc=Adph9r3Ml_j3waJboBtOERz4QVshrRa10PY4eS_lTY5DgzFukvHqhsDhM93Kjp7yrjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6mnR35VWbdNj_jjkUQbCEijHQPhTen51VJUev7jOSEw&oe=6AA2C322"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZB_idnbjbQQ7kNvwFr6Ynp&_nc_oc=AdrlacE0DRdjVyk6iJFOvVS8ztv-ixOu-s302_Ty2sCWZA180CfUrvdV7kWqmafoSdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjLELNo6f1bEvDsO3SEF5w4pNecfJSXmUjotMtm2Q2xA&oe=6AA2A04F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
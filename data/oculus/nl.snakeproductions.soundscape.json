79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzs29AgvrVcQ7kNvwF_h_9A&_nc_oc=AdquDzyIIuTuEZAYID6xpNDPOopXBXaDHLjrb-ukouExqZw8EWijMSTjCbfUw57s1Rc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWqgjVPTUAB9a4ilpvpu2Qp7DnIiDDM8dPJFdLC8j2VA&oe=6A732D6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PYkSVTC6a8Q7kNvwFhxL_C&_nc_oc=Ado9Tpm1EYCSdlMesArh0AWZyQdw7J-TN6l3xl9Fc6alwa7ah0fXfos51nOsfA9EL-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIYX-iYoO0yRgcUNXI27DtEUnza48edsHixCrOyOH_oQ&oe=6A734D22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GMqKQ4e6x4Q7kNvwGiDDzg&_nc_oc=AdrNrS0rxSiX5wQTklmai6sYUDVlYZ9YcIBm8QZ4VpBDcA8a-fXhigXagaLF35d2ZB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrmehxPXMmXbIq1isUG38K7EmRu6MNwlpF1EabFgICVg&oe=6A732A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
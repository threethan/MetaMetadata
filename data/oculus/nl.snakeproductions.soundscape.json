79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecwQTEn5VIMQ7kNvwErQzSt&_nc_oc=AdrcbGm_TFzHOjdQWBGJlBEwiqEhoX0eU1Tiab28neyP8lziac8NvSVsiANfaR4Vsfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrE-Q19Otv8o9H-X4f30MdAHN15AGcJ-RoXNbCc7QDhQ&oe=6A99A12A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQE1hk1c5y0Q7kNvwF5LUpC&_nc_oc=AdrMpjuOpWJc9Qvxoz55ZhiaP508IWMTKJk1AXSR9vwqbsUeudLMGt86KGRMqiNctLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfiYLpkcPDqpmKGP5bflAIEP6vkmGsTHht1zi5aBWXiQ&oe=6A9988A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab_15fQOO58Q7kNvwG3RapN&_nc_oc=Ado2hkxNTaZZgLvHIpTahJUuIXB86COdHF7GDexHChZNkyQQB_kRGNwqXYx44Dg0aIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRSsMD8VYm-IXu9cgHUUP4lpQi0anJlBMRr6CionGslg&oe=6A999E0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
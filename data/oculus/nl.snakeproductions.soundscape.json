79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc194XYCDpEQ7kNvwHmPcnN&_nc_oc=AdorQc3V2tnofhSdFPIRs-GKPmpmBNkVr_LetRd1z7croS0k6F7JgON8Cqy6x4fLQ14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOfsQ1udDoTJFGnmAnJhSi5V1Igaqk2gDi9mrQNlM0hw&oe=6A5237EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaySygsyuD4Q7kNvwGBFl_F&_nc_oc=AdoV5JzaneXUf470cVa3NBgAcdQhlJDB5mcvBqAVAIjUEq6EMyCMoNcCVtwW0gxJa0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqN8p1PKeXuJI7YGqqLeWFiQENucNzFD7C1XyCPY-NyQ&oe=6A5257A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYR3mDP7ylYQ7kNvwFZDL4D&_nc_oc=AdpqxexryI832F3vmdCpK-5wRLz0etB9fcy-IvhkButQd1qOeWQNJ_ouBV8ZkxnL2zU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIzsYTETPGUYbX4xjCumWoDZC_YIhmH4yuO2DMU1Frhw&oe=6A5234CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Pr5roqp_YQ7kNvwH_CF3Y&_nc_oc=AdoBnW968RupIbR9uXh6QjL4Pzfgrc4AiMGmQQPDIJf6y_NytotnC5ZjrbqhKX0HYqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA10mdMMiFcZKf8Hb_-yYXnFO53mG6xpJB9vfQGJAIcQ&oe=6AC6742A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4iLZutjE80Q7kNvwG4wlcl&_nc_oc=AdoLk0RauQPKj7_SnEkv3PSANHePldZkC2XRzIxI9zXVjm-zRduwphQ6kLpNvfWuEhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtKqRLijnbujtQ9mwlaAR8YYr1onZ12eT4heFGhyTFeA&oe=6AC65BA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh_j82X-8b4Q7kNvwF0Y4Ih&_nc_oc=Adp3KbmL6pxrgJs1T6HWuVm2aHo8slN5_gjWaZl9hfRfK2JWsYy1Nig2GT8BUUhoQpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvrt8iq4_InRL_AxA-E56QVHvVuxIUJFFTIsZsZRAX9g&oe=6AC6710F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
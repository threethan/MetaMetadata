79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58zXxaeFpZIQ7kNvwEAzhac&_nc_oc=AdpH5VomvU67o5l7T-WA7bjl5iDzFnAGh5xggvgGRqdIkqaPeu-rkZI6522kvk54B7E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51Mjd0AcF-tUDlw8GrgGQ70T6agLQp63X4SokXr3JXNA&oe=6A12EFEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pzqlb_RrJsQ7kNvwGXC-dj&_nc_oc=AdqgnpiCs9tiuX89hIiOOPRrFXPJgq7o5EkF2Wyo3YeAIrxQ0UN8NH5boTguGofBjKk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b5onxSCIh9eFte0zvEWJzRvFFQZZrRJv8ifWthZFRNQ&oe=6A130FA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S7fj6UiCAoQ7kNvwGsbqbN&_nc_oc=Adpvv_vGceNbyo5Ng6D5rLF9vtISpWNMiwC7gIgeP4hXxCCYRUh0-R4wMrWnROUEKFI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kwwNKJMy71w-tUznNHnNih7kCg7KEud7EksJlbYtoFw&oe=6A13250F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
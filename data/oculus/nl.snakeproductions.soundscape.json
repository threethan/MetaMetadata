79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7uqfbUaO9kQ7kNvwFV_j1O&_nc_oc=AdpyHMQR8-xCbd9FslfCYa6H-Dk9FsyvXZB2pQB650_uW9agSiQNbrdjoBAqkHv1JuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaJ8rkRpSH938Ef0l12KnRwfRTh5_UvHj7T5h9y3jM8A&oe=6A4A4EEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrtxF0VDFuQQ7kNvwGrDSS1&_nc_oc=AdpVqp6vh4eaE7xb4SAi_tV2LKOComoaS-zy0MHJi8Q0pm8CgOWvYEQIGurThDz6-aY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjP318IttNEfZMNrsFFVPJEV-u_DaHc-JN46QSvfKg5Q&oe=6A4A6EA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqIGXnpJbt4Q7kNvwGtZGyl&_nc_oc=AdoL0b4Xrmw8VMinrSCxKwkUd43rkKzXa2OyRBhCsE86uO8GBNKMVnGP4CEZzjXd4PM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjEGj-L0eB5ku2RqjykS2suCmRKJOIWq-iltt5TSXiYQ&oe=6A4A840F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
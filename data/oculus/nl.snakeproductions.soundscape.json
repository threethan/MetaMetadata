79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga8vBk8VUIwQ7kNvwEy7c7E&_nc_oc=Ador_m8EqHgBcuH71uWdTCiG7b_2epYMQYFz5HAezPEbbSTbcF1U2Qeb8GTr4iOmWGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuSMZS9jvwgdibezFkPIN4T6CzOAwfU8mgPHwxI8utdw&oe=6AB90CEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51z8KzlThFgQ7kNvwEZUDUv&_nc_oc=AdoKBYjoX9Tgp7ncH_7nwbFAoyT6N9is10GiMDCGhR1pTMd5eDS_2FuEG55gHO4XLUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzdm6b_QfmHt3eevGbr3OoooYvwbDALkG6YUL1-ujSUA&oe=6AB92CA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Scwf4OQ9HOcQ7kNvwHpwWEU&_nc_oc=AdqbCgG_Pkt24wPjPF56P5CW4ZmEhCsfstlVELnjf6TrTIhbR3Z4gLd6QWwzeoiEty4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQtYnKJ5md6d9EJZ_WoxZdOd5L_pJCoXGikNhzkelxOA&oe=6AB909CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga8vBk8VUIwQ7kNvwHqExDY&_nc_oc=AdqNMjqm8tLqoje-kCaO1B5KGrWrhV3eiDoyT-P9rl2iuZDvYu57Mea3SyQqSJJbaOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTdPJfkdgRZthzXE3i-jmstaJtjuaYF6r8V61i9iBX7g&oe=6ABBAFEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOLc7xkAmvwQ7kNvwF_mUl2&_nc_oc=AdqRBdqnnrpqpICa3IKqSfFkAS3G-MEnToqYnlCUiiWiIlQi8YJ44shv9BKOJ8_JijM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAHxfuVePM6ui7xRVihnqwtR9WVUbmvZRH5TKlfECaGg&oe=6ABBCFA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1HMj5b6FdEQ7kNvwFa1PJ4&_nc_oc=AdoJsIoGyyhiGIcbooJZ2cl1DDQrknsL2Owkr-x8E1ONj_vDab4E4rPNWyFhaQw1ZIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWp7mChoetKO1CyCvSEWgTVebBPhR8Mz2bW2245eobew&oe=6ABBE50F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXQWtt8Ue6YQ7kNvwFQfzp1&_nc_oc=AdrbnH_41AKu1tcic_lvQdm8NLqVaukOlz4fywjA_AtY8wlg7k-4j1epC450yRZT7Hw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3SjZBh9e9RZH51aL8o7HOv9t4gsU9evDb5InUTXBlpQ&oe=6A41146A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMKRsIi3VJwQ7kNvwF6g0Pq&_nc_oc=AdqSaK73S3IJEphuI4A7OL-h3gT-L454jO6YFvg1S5xgu6l3oZygRZMPYiwVyYiAamk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pvS1jMt5nFhg6W4mkhuVOXxFqp5nBR6IbjSzbB19ZZA&oe=6A413422"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r9CsaYM5KwQ7kNvwEhiD_2&_nc_oc=Adq3h6xl9jp5MCiYuksylr-YSPsyF4cbhRu5vfoD4UuYxfxzHH0yhgVpTLwS6zve1LI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bVeaKX6D5DvPxQ_fm6tZ2UKg_tm3SibqIZ9zDbGamRg&oe=6A41114F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
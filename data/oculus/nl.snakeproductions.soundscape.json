79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOBug-Dgdd0Q7kNvwHwu0ij&_nc_oc=AdqyqrU4acl_KTh044vegSs0JGXuFeKJFV_kKxTWoGeJAsz2ZEdMKNiCdI6NfhqWgsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJkn00Nsn10HVGo4rHM2M7EI-5kSe5gL283GICUglhfg&oe=6A79C4EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mpseTyjS-0Q7kNvwEqV5ub&_nc_oc=AdpTy0SCvSsZOQaZLSrGrxanV0oGsGO83tS2G_JUm78wVg40H5c8Q4TROWYnCRZm-Jk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-_XmiLL2AyKc7LLrzo1PCx6pFJI6is6eNb3VppKagyA&oe=6A79E4A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4_M7u2FV5kQ7kNvwEUY883&_nc_oc=AdqC1TNU4BH7Mmx-EhcGUqRP4O27BHosn2c68GT-0icum_lPodBOVUGhazFk7goKj9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP81-zLplPiM0nugH8-fr7QWewf5wM7y5TMIsd68NX8A&oe=6A79C1CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3iN0S9If4wQ7kNvwECc682&_nc_oc=AdpQ5--cDCdLIe8IZVu8npVWTRfvKjlLeH6OJdbVM_B85jPLErlZ56gdwv7gxze3PNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q5W6G2pg-xhhf-XJPXBoXCjaRyheB4FrGO694X9oL2w&oe=69EE05EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aYY1YQdtNgQ7kNvwFKLphi&_nc_oc=Adq-NtStbE0WLwAyAk2IOQcoi97fES1RDayIV0wEV_5Zr-ANRX8b97W1imr0Gp1uvYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kiJI71YjPO0OjKQQ5fizy2S8gsaI8bYkpfL66ZWO3Xw&oe=69EE25A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giXCoW3qeqIQ7kNvwHkMGZ9&_nc_oc=AdoruEMkkf56hoyRbQUkSPT1a0yrsXSzta0z-hvwUG1O0JPPXRYUY89QWdL1O9yfYx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30__8D6f5vf1BVpmBCYcYgVtzC2lIvWR00dWKMwbm6nA&oe=69EE02CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5umOga7NCIQ7kNvwHbgK4X&_nc_oc=AdrA5W6Yb3qwX-RSiFdgKEWxMMKJsJKBF4LRxUcytOkeJKUgT0V0AP3gJSgI05pR8s4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxq9km-62VTVUvi8c_N7pJQYzQHfFLrY4ayb8kkcktGg&oe=6ACD0BAA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaMX9DRkMvQQ7kNvwHOIHBJ&_nc_oc=AdoTX4ZOrLW0-5IsJDSZwTrkNq190skTonXVJg_ZmfCN-tSlLavlVERf3f_YnjQCZvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDckrda0gv0O31wRo1-YJDAzaUvqFm_84uEmS4R4SoDw&oe=6ACCF322"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWGewgLtc04Q7kNvwFwOh8J&_nc_oc=AdqgQQyokdMv-L3Z9wRI6kl14uNJFNRmD-ld6EQw_ZOSjvdJab0YKRouw-QdbLvANWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjuldWsURI_ial3nCzzV7kNQFSqICKqNOOyOqsR3fX_w&oe=6ACD088F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
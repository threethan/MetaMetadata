79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCA437eYOWAQ7kNvwFxBB2G&_nc_oc=Adr7zzRZWPnHzriP9EgTf0SB6aMRuVsvkSEim8nBN6jhMWDDUiJ74N_JB1oJ6Yh_yBI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MtofNXVeFgVrSH9cIKVPBoWob39gxuAMV5W5juu3bJQ&oe=6A104CEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pzqlb_RrJsQ7kNvwGIU79J&_nc_oc=AdqnCSd2Ke4ukz9Als7ZtA_EFol18RKBe421N63P9ZIKHcgnPZvCY9k1qQnvX0NQtNw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ENLEmKlF6jpwe69LGz7IQ6DfDmMPNgeXUqlr4x502xw&oe=6A106CA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aenD8KGXe3kQ7kNvwELDuEg&_nc_oc=AdqA1nlaFUzCi3YD6dcEIaNpxt2o_3WgkS6T6bfOqtTdgT1M5YQlL71BWkfj_GBEqMI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4npCDUDboaLSUW6TotJBOAuvBCjQKL1kxB90pPZ6ZksQ&oe=6A1049CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEJs8YCE7esQ7kNvwEKb7gL&_nc_oc=AdqUedHy7R9onuY8Z586FxjWXJ-qWbYPM0DU4QWglWUW2d6HcDCQ0XTvQms4QSf3_a0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQkHFJdxznICDPsn-cAgQ9GrM2mqu4kto6bxRjtKiwcw&oe=6AE1EB6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6Dy6L_eKwUQ7kNvwHi8IlQ&_nc_oc=Adq29u63m9QWeTGCZmGsZk3pP1LNlPkcAgBYJFQnW0NlhdPiis9r54aNQCkA3iQVMcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRqBMpWYxg5YcH-t469-OFgtmP_rTyluih3qIU4actfA&oe=6AE20B22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t17rkJMcyr8Q7kNvwGox3K-&_nc_oc=AdoyAfIDzgH6RKfcJvU2-vOivlWd4vNmDBYfzcgbi1oGE4re5ZciYQczXa7IScQifWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhcAw6wOe0XH1o88iDZb9S1avXD2XRwuWx63LvNfpK4g&oe=6AE1E84F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA0eYg-HxvAQ7kNvwEdMvRC&_nc_oc=Adql-rR_5j26UYrhXb2INGvKfr_VOqdXeo11z_A712tD7aboc54_w11jBUgS2pFBJXA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-eNaUppR_KwoaCwOVzuIkm3UCxCwnyV2QNmFj5pRf-A&oe=69CFB36A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pg-ooJiDBYQ7kNvwHsjJ8i&_nc_oc=AdoDm4oczT0pR24h_hryyLlKv9q7rMoNvigW-rA64c1zCWlYN_T_nNAIgANSpC-moks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgG1fH-u-19u96iAfK354jYk6s-IkRA24e6d8bB8EOPw&oe=69CFD322"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTeT_LppAP4Q7kNvwEAFY_L&_nc_oc=AdoKMTY_WDzo-VGDWsUQCTRqz_hED_XNofMwtnRZfjW24kBl5JmKj7s_UcCaX9z6RVk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsXQzmFR1V-cz4FjbOWkTMUVZFdWuNkqFQRc6jDAY7Hg&oe=69CFB04F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
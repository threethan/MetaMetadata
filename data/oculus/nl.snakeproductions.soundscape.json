79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV9YR8umWccQ7kNvwFCPTz_&_nc_oc=AdqdMH6dL6h8rdtSDVBRVsKg0K4eT-b5gn63-wKQ3xaGBySaJddeNBZ8e-TaZs2HtEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuE2MxlYy00CW62Whz1mdzN1WJ7oyAJsVV9E9O1nSjaw&oe=6AE5DFEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjjCePbvkjMQ7kNvwETbLmj&_nc_oc=AdqAXTD_HulHCrlH0vtplzj8ETFsY3goKftnZw3bVKtaTpg8nD2DStTbp1DHXN19-x0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZAuEM2hCwcpuIlFuF0E05GvHX196sjj9slhatZdilwA&oe=6AE5FFA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gudjn8vzoNsQ7kNvwHIBaAk&_nc_oc=AdrbM1kaXdTC1fxzgRLbMPN_HCmOEJocMgLRul6i8x6i_baO1cBVwpf99sTCtHZur4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORFvQ_tkJ-1nE3WVkriNEvLf-rCt2dgNCGFjsb_z493A&oe=6AE6150F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
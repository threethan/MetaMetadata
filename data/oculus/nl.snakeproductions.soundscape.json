79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yERB6aGZNYQ7kNvwECgqkA&_nc_oc=AdpPSzgxqkM2SO8Q4lKOgGk-mtRLnGlWVlHSbjKDxfnnEOZpmHsvidIiuoR7LHUcFlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Of1fzdSzuVgbWerAe-x7B0mGUZZGRIB8SmmJq9o7lfw&oe=69DCE26A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cNf2hOPKloQ7kNvwEEbb9m&_nc_oc=AdqJdPUiwRgBpxwtBqxx4sL55cKCj4Q0bTDbXoNvBTVEIS_MMTaL6P-7XBnXSAJg8s8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32FuM0aXLHjb-4hqRFJrG_PHQk9S8y_nqaNlT5RG_FWw&oe=69DD0222"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-mHTz0D-DEQ7kNvwGMym1s&_nc_oc=AdqNpYDG2Y2OJSatg5zuKrVylNRnm_w5Jm_Ic24Nbu_ZPyOjUgZE0ln9ZhO9aq_qPd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NUPqDpFwrkmWctMsxwEZMMwqU2Q43dBKEUU0SYy2sKg&oe=69DCDF4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
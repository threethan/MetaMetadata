79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDf2FJeCBBIQ7kNvwG7srZ1&_nc_oc=Adp7HKzGEPCk6c9rkB1CWJ4vmgWYSFTrCQ61VOAfe82QMVSJMDvV6DZ_u_MqqiNeBrw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wIWSfxZPn3uwK8hUP2mp0f2uSrHi0LV60pN30g_7ykA&oe=6A4508EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vi1XdqOZuMQ7kNvwH74dwj&_nc_oc=AdpRXderBHzdxGJkzjWZBiEpn5eyf_JA-o_ibxfpHbOTtt8cpRU4z7Du-AtJ0Gryn5E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b3slsg4515WRO8vYOGydjIlhl1-BmhvOF9HijJcHv3Q&oe=6A4528A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8tQAhY_hH0Q7kNvwFPM9wS&_nc_oc=AdpJgBMrDizYx1cSY5lOOABW05cFQkThQEJs8l2lfNypNSt4u241rQ2YTgeFGd3O6Uw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uZnKoldrAMrpAquAzpCsn5eQBAJhrkHP_zyqsghgF2A&oe=6A4505CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nc6hI0K6a7QQ7kNvwFkmAZn&_nc_oc=Adoak5e7zyWgAA6mlFkuJwhNwAR9JCofLQZanq2rBlUyZkUj4P-yPWWDYwGyV2G7Pak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyegop9OuuT8U5-u_8Eow4fXPToyTaBtcqSZywDI43kAQ&oe=69CBBEEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlGxReNRAmEQ7kNvwHsBFlR&_nc_oc=AdrTfiTTTJvqokT6Z9oUo52t4_dCTLjQYSb9uQ3ZnsMZNELwyy8TiX_3fPBwNauFr6c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiKMVcLAzV41ab1xFEp7uuNSCwx9CjFO7JToqzGHtA-A&oe=69CBDEA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-7eGmmQAHYQ7kNvwF9I9oA&_nc_oc=AdrtbFsB4lgpg8s32YN0Tm81HdcnCzbVpe_U6Slt-nD_zJS5id1HlRVzoFQRFzy6tyY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKwVSaOp9mDK2Q9pq_SwKGbapRzmbSH7nsWtk0J7Xdtw&oe=69CBBBCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
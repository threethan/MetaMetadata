79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7olm54PN8UQ7kNvwHvxaEq&_nc_oc=Adr5XgtRTRpqtxXy2Ut8rJAi8KZXD6kTQvGXm7dBbU60F9rd8K3SxQbHNnNunK2HjC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QblGP00BrnbydtB3idf3vgX7BNUiyFEVFtSw36ScYrg&oe=6A2AE32A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIwniLuxoTsQ7kNvwG_YI3E&_nc_oc=AdrGn3QJsIwIJ-XKTgF7igNx9MGTCDCUyOhel-Y4XJPZ20hCVK98QS00gfRzvo2n2mM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CLTOjHrbwgN1yMidSxE5gA0tHqfL30vVY5RfZAizWaQ&oe=6A2ACAA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnhNjWgdeaYQ7kNvwF4Dot7&_nc_oc=AdrmLeafoRLrZ3PpIY5g2_a8brYccNPhE_wQrH1VDQN8zjbwKNIQigNhjxGFB9BcI2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ez4LrB9mrZmn1YxMKi5m5-d3c6D5U8d0APgl2Q9CLw&oe=6A2AE00F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
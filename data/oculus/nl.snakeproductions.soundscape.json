79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS5wzUgVCPkQ7kNvwGXliCy&_nc_oc=AdoX3vTmcY913lyeUauIh2MrmtxG-Q55N2wF2TM7fRroyaBTUP38dXMyvhP3ILy7XuY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pcAUWdfWwYQX_OBk9HOD7NtK2m4XNgeMK9BC9HuDQ_g&oe=69FF296A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDLRrOm7gMUQ7kNvwGGfcgk&_nc_oc=AdozRwa44n1K_Kg8fQFts7vDt_sQPSOW8mGPKaDy1QZL7CsRh87U6lWu5woKlxyq0Vs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ox_TUenYB_a8R1fD0pe-OqektOf_y0vVK0ukL4qOimg&oe=69FF4922"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XqQWy0VD2YQ7kNvwHaMPF6&_nc_oc=AdrGqc6ci9VZJovNl_OUWzjIfHZc0fnUztimhvQOYDbQ4b3x2PNULrUOV2_u1SXQHUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A2O-p7CuAej2l_VmNd9xwc4X_tPoH2RK06PZOGRojog&oe=69FF264F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
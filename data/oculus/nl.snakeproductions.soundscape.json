79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z55i7dwijkQ7kNvwGBUOJc&_nc_oc=AdqkQKRP5tB5Pmw9moVO8pbTtt3y6cw3ngNcuhVaWu3-Qhvl90qfYlidJvTO8mziT8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFE9fpyXJLVqLzo4r0wFvD_GcGDPPyHNx-kAKRnTbeig&oe=6AB7BB6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51z8KzlThFgQ7kNvwFzFj1n&_nc_oc=AdpYnonPeyC-qR527JXkJ8XCCaX5ZRR2jpDETOa9-I9SYXkCHsDd3BLZ1lr7XqPA500&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXiezvQ5ezU4qVqkrtxVKcV1yDksP9GNsg0QUVP_Y3tA&oe=6AB7DB22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Scwf4OQ9HOcQ7kNvwFdm5lm&_nc_oc=AdodqmVA2qV9UBHt1DDp-Fe6RcnZ_6up--BPDSzYfBxAoZNGxppMlNVgIULyXfO0QZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQcoW5eA6QUioNNiIRynH3M7QBGapZXWzvpIT6LU_GsA&oe=6AB7B84F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
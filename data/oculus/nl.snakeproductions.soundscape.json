79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mH1cQ8XHy0Q7kNvwHVFKjU&_nc_oc=AdppAMZNlXspg_8v0qzonyctMw6D4t7M1wpSOhoHMjdaCFlFejO62PZ-zP6UFi6SMLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UURWTefXxpnjZlSWjznJYitHaliQ7bVSBUmuu1LzMjQ&oe=6A031DEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK928M9HR6kQ7kNvwFChlaU&_nc_oc=Adqo4zQ-6Tx5JMhCzPYVSpAVYF2r4ZuREBi10XjPvhpU2s4zHMgD-qD7lOWz00gU3Vw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fpwdv5TSyiP8ZpAKpMtrysPArrUkIAxCGDPBXpX6oWQ&oe=6A033DA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SU3THCHCXXAQ7kNvwElZ2Re&_nc_oc=Adpw8SyZ697iCHQz_y0FHeWBuZc9jf-Gbfrntbw7MwOWPys2IoelHHYQankVyQ5dFU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z1wmK6hjh9S0-JXfOSQvSIz6UO0yIgiwkci5RFcpQqQ&oe=6A031ACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
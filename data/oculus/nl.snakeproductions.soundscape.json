79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXQWtt8Ue6YQ7kNvwEsofqE&_nc_oc=AdoHUBUpcIqhxra0q0TqCTzVePu4PN9wW0AsGpWkOgJZFseC9J6M_Mg5TQFVaIBVrGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HJ-Kg45xL5yf2r5ij7gJvHaeN8h4s6VjzbBJX5ObPZQ&oe=6A3FC2EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMKRsIi3VJwQ7kNvwGhfacW&_nc_oc=Ado6RwC1hOb67fr1-uMSi0-ivI-GFUg9aUp2ABUxPPGGG4xjTfe_4UopIbPCoEqYXvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S0B1J8U_D7aQvx_lz83vYLsS1VrA8UmcpBgq4Vin6jA&oe=6A3FE2A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vls86qzqTRwQ7kNvwGPR4Ls&_nc_oc=AdoddHfVt_F5kDQOYpQ-p8Jam-0Gj5O3dKXOxyamn13QsA4FEj-34IaHIIN2iyHyPpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s45iaGsBVjLLAoqYCEahfqWZULOexmIpP-bPNmt3AdQ&oe=6A3FBFCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
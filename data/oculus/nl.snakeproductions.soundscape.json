79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58zXxaeFpZIQ7kNvwFeBMsN&_nc_oc=AdpffYo3pDwhqJkTvxaYx-t4cs7H6rMjfXcqN7m_-YwhV64GmLekUcnCMKnXktvZalI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m9vR5mPMQ5Bg9-znjWhewLcfae60QDJKO34-AANqceQ&oe=6A1592EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_skc_xV8KIQ7kNvwFNBb_q&_nc_oc=Adrr3Js2YFHuNBhR9WXJCiHgXNTT-vW3x0vEF_l4BACkei7RoX9bHxhTfFRlZIXWeP0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BPxy9SoAi9MPFFLXKrfcO26JVh9mSHTb5Oukt1wHevg&oe=6A15B2A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sT7aIPe5t7wQ7kNvwFocxlA&_nc_oc=AdqMpkHMVETG19L8TKviqhWjlpPhvZa7Wh8v4hcz6ilb-SaKfmrrsLSrdpQ9T9ZPGKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kk3fWP3CEKwmzPDWPj5gP1-_HzEOeLH5jN916UqbqXQ&oe=6A158FCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r5_5OGFTBUQ7kNvwGHP93Q&_nc_oc=AdquasEIeDCKVrBswo-TV-CZomghYB_U1E10tDTfEtoTwljOvjhycHzJXrSDaRUDamU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDdS8tgp-mKm4NLS0pNULwYVO-x8eabHGPVwLKimViYg&oe=6A82FF6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJeMVGyz0fYQ7kNvwG5zsMc&_nc_oc=Adpt7zU8T7ZghflI0AAGAsw0rDeuR2Y-y7VLcjJnETL9iPwWLV3I8sR9xbQtgkQH99s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoY_P6XZYmpe9b30PYhhzWlyskppLMSNDa39m7rsh8Yg&oe=6A82E6E2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-6aWOwhbWMQ7kNvwHZ7qwy&_nc_oc=AdpQeD_9h0ye-fGSU_qNIY-k7rwinzZvabTfnrop2yewtrqdZLP_AzbSUD0xMAl8zk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMcPO0ssPAUVRRhZFu87_w8kG5kfi7iSzIx_uWki0-1Q&oe=6A82FC4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
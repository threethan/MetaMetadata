79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEJs8YCE7esQ7kNvwFlCrqk&_nc_oc=AdqshhRRHe1VqIBnPifOanA2LL-6kLpDRVAU8YNd8HozzTADr8pW0OM_S5G-erokevo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT1l2XxqenhVmN3MgfBYKsCc-PrSNFXBJQ9BvhFIpmqA&oe=6AE099EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSKxthBP2rQQ7kNvwGikDtN&_nc_oc=Adp-lxjgVCiH77qYASp8PMnp_XlapDjHYksv5Hxxi5N8LUXARXeKo8sAHw_f21OjdtE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3Bu0jnAgnsh9W-01LJOt6AmEovIUlM7DIHIHBqxMaVg&oe=6AE0B9A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t17rkJMcyr8Q7kNvwEVWAiq&_nc_oc=AdrJwKDMDNo9lGD6Jva6G4nZUSkt8ItyjICdzJyLIL0zG5cEZWEUPg_reyDgR8GH2bY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-ysFnUCxgMItuBAnwD8IDPLS0WMueR5kPLHXWt-UA9w&oe=6AE096CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOGReDVvgP4Q7kNvwE6yfeF&_nc_oc=Adq38w42l9PR0Fgy1L6_6R9N9UGMYSWeEw5jFrNY42BiK8u7q-nN1PAqhj4lHCQfO1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VdFHOyq2VJQYPZtMEKPylOmxy25zmyb-WIenxQla7bQ&oe=69F891EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvMyscInMLoQ7kNvwGMYZmU&_nc_oc=Adr-QuEmLSD-Ydhjv4Y6eDtDwv8qs8fGkd04KvutvxiGq7X_GqOJNWi9MsqCMP0vjwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-R7KBKxH7rprUQ6BovaGl-nazCv1qoHPDQCt9TdM2Iw&oe=69F8B1A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85qtmx9ESzQQ7kNvwGiYcfu&_nc_oc=Adoe0s_ys0nDzxu_LRagmOOvkM8EaWkFQVBWUtLZoZVNhHxsxcLgC4dF87IlhnELrUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ci5APN6ZtFrAzCLlYFRR1nc54va6YhESnbr82bYTgHQ&oe=69F88ECF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
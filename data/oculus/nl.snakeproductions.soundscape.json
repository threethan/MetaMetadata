79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNK8vbfj9vkQ7kNvwFpLBLS&_nc_oc=AdrlFup3y9plKq3zcW41qQMIxAL187nTpidgmJ8lENm7AtubmnAWO8Pk6YrRLs7PwTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tc1LORumSiJjoZbxVfB5j1CQnN4vcu4LayVg8XlvnaQ&oe=6A2807EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIwniLuxoTsQ7kNvwFhFunq&_nc_oc=AdqfcuVSLPmprZ6hq39OsPjI3ivtgNpHc8DQMbUM0b0DhQLMz3yanzumq11rJay5h0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8J3IifZVhjogVA8l8VTtaDu9b6m-fFgeOPHMwWsfI6w&oe=6A2827A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73jyaYAnx9IQ7kNvwEkScGL&_nc_oc=AdqPGJrP_DC9imimzYt5vZZwzfB2vergUwJ2EJRE_tr41f6vA3WKI6lVZzFWhPaWZ10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3XA_TvOH9wbw2h2NXGk-nNAzn6Xva6p5cGSAw-pH_uw&oe=6A283D0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
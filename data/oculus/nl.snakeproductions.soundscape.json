79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P9gar35EDQQ7kNvwFkGfV0&_nc_oc=AdpLVnw9kZpogzYcn1BTuvof929bmZ6zsxSByHFbLVuQHhoYC9XCO27TrOvwUUeVrHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BG-CPA81Byd60qDvz4yvnYWlqdyxGC4lusxIHpZ6J4w&oe=69DA3F6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eBtvjySeREQ7kNvwEC-WR9&_nc_oc=AdpnVNxfQC_FA4nke6BE7XULrjbH3-roREmdsI57mXgh8zQAeoq6w-M2eh4Wn763bG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hGRVS59PfV_aypsrju4AydNbqivC-CS8rAegipzrUnw&oe=69DA5F22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-mHTz0D-DEQ7kNvwEjP2HZ&_nc_oc=AdoOEM6iPc1IUZxDcPMPL_M-keOsZar8CDZspl8F6T51RM_4RgCiS8ajzGs2KuEq_zE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af279VDLe85mrKLNsvAORog953fG5UXDO06OIphXsCWijQ&oe=69DA3C4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS5wzUgVCPkQ7kNvwGKJfP3&_nc_oc=AdofsszDRvPOHJwD8qRUoa81mbfFgmm9gaubsCGm_5ER1J5piiDylq97azptADmVrKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LGkz5-QUiNbhJpDlm5pOeG3-t50pTW5FpKDZ9K4eduA&oe=6A01CC6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK928M9HR6kQ7kNvwH3dHsx&_nc_oc=AdoEO96dQCgUs5zje61JvNiSs-KT538QKsFEbxd_lxVSKcqD7ce-GQLBuRDxeuCom1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-xeBWfycbQqClRo-UH0p6yJAVfRbdEGgpy9QJDJlh9Q&oe=6A01EC22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SU3THCHCXXAQ7kNvwGR9jgs&_nc_oc=AdrOpd0htn2SDF4pn5uB0V8u19OM2Glj8xe07STup5NeDCsS4O9pN0bNQrachT5w_Tk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A7xwW26VOF2sxFQadMzZgxAMM8eew4yhTb0z2anp_PA&oe=6A01C94F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
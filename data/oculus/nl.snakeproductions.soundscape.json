79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDGb3aUs2MoQ7kNvwGPD9uA&_nc_oc=Adp86IsVEi2E4DRy7IaWew_cgcb12HUWchqX7BfVJc1nXi1UgacLE-4wWFw9zQokwls&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwvFd6dzro4kPxCwC2G70BfN2LvoGyDi269aVIxOAo8A&oe=6AECAFAA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=excFU5pgZeUQ7kNvwG1MEZn&_nc_oc=AdowFU3wt-eFdWQCjlMMvaNx-vi7z4m0czJZr_MxCHNzQcMtlXYuCZIFcjErw1FztA4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlGF0_b4It2dM3QiJ7gPXqJ_YyQkPUojVyDsnK5TZcdg&oe=6AEC9722"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXgu9QQgv_EQ7kNvwEEtL1k&_nc_oc=AdolUqvqNA_CNrN1AmHHuqVK_oEO9K9rruv9Hv3CJ0yjnwBLjN2ayAYdxGuJTBnSslg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrE5IQX91JZbEHNREfk2E9rf1DWS6yyXmffkWku_P3vw&oe=6AECAC8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obnfYa-sXw4Q7kNvwE_Nnr6&_nc_oc=Adpoz2nXf2c_jGISCaTk5LChKqsLarZPJxh344tVgGWjYfxti2DHizWv2G4rmNpynuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_60xmBptdXEBIw0_MTymF3xNqQz75HbeTDiaba4JOssw&oe=6A3BCE6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSFwGOz6ghYQ7kNvwFoCezS&_nc_oc=AdoaKl3pxsPZpUIrERShIuwQyln1wa1bykEUq6xq-b-lXw_Sp-ULS-OgeM2R6gjaeY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aOLhdz0SPyprwwy7ZqS5bgn5bYODjteMbGhlBFVi8Mw&oe=6A3BEE22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV0mCKmR55EQ7kNvwFd6ufU&_nc_oc=AdqzqHvmAKMX9CFYmTCNW-ChkIhFECt2DCztf3lQIz-nPm7r7cVo_eNnZcG0y1CnZtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZbgRDi82a34--JczU2fyNRFF123xZphuXQLYa8-HIQA&oe=6A3C038F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
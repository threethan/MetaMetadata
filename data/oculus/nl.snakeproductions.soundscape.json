79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5umOga7NCIQ7kNvwFhx-ZS&_nc_oc=AdrdBB2S133P7pBjD3AiY3XqJRQsAn0Ox4tG_PZpGXMsmk-F2UZ7yxyTXwyg50x8oQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZrWvCemtoEJsjLeXhF9l918EAFG3CJ3znjcGxrpo6Fw&oe=6ACFAEAA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Slv_gOw4PwQ7kNvwGrmODC&_nc_oc=AdrIdSV8fHJirX0Xjme6Tlm2eZbgFNTejVn3-7-jbwa-oe0rce0py3EsSLmRMMaJAEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj7Tu8r52UaqKkzYmYWyZYUAVwvUyzSQld5nL6X42Lmg&oe=6ACF9622"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7N8ZLMgENQQ7kNvwGL3UtL&_nc_oc=Adq3IA-WCksX-MxtkHbN1T9UjXy0RZHL-6cnm-XS6tN0XA5HHngVIs2Sq2UFswPBpJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt7oYN10qEn3gYv3wj1CNc_yl7Uze1OyJp9K-uUlZ4IQ&oe=6ACFAB8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
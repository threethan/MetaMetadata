79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3iN0S9If4wQ7kNvwEP6ZH2&_nc_oc=AdpnYGPYWM0wsCBpPRmexQCPWHhQdiBL2LS58FNViSEULTm_kELqFkfeZEyu8z0AipA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25Kmy_XjS2r5r1dcbDGqQvS5JcggmYdMnBwqzBZrLbGw&oe=69ECB46A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aYY1YQdtNgQ7kNvwFTx-Si&_nc_oc=AdoknNQ3xzvEmraaTssLzzFHA-kShO6dB5_vrGXm3tYWG3Z7mnVTWAx0_vozZnhCqic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DzngRpl4B5AxnWGI6aMFIincUI2RjB1AEa4gSPRtLzg&oe=69ECD422"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCOtwBm1LqUQ7kNvwGuMSZc&_nc_oc=AdpGA8WfiNyv35WGJXCx3F8bbpd97w7Fw0Iyf5hxj1HMpvNXxSKCgz0nRQ-jhDa8Wzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AXVqP94XQpRGOHpctIgEy9XAf8vXInT37bi0GxPZN-A&oe=69ECB14F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
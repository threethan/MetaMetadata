79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOGReDVvgP4Q7kNvwHDzqOx&_nc_oc=AdpoIu5wdhZ3cM95TLyUP8cVrp3YJMv6ja1z7C_EE02HOHVC6F665hoN2C0D2ZOJCOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1S8hP1Tzyj3TEd_QFX9af0_a1USDP71dMtYzlwmUFnfQ&oe=69F7406A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9WfQDS-B1gQ7kNvwE49vzu&_nc_oc=AdpnCo7bFuST94Ya0jWsXOzuOKhkGIpcWvFv32kTQDvje62DSj-YUvMZOy7c_QG95xY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oCgqUDs087UKL6M3984H77SuKa95o_RJ4DdbbKhasjQ&oe=69F76022"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85qtmx9ESzQQ7kNvwFwE4AF&_nc_oc=Adp35nUXuJaBkYdRCr2vzaKSOi5CrfEcVgvrc_c8PFS6y63XZ7awp8WJCUdxBMhGqJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2M0OVY9aSZKoIMGml-H_ms2qMcyS6H-T8vm_xkcwxWpg&oe=69F73D4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
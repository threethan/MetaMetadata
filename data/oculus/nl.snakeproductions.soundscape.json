79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJVWbMTRzZcQ7kNvwFkQH3J&_nc_oc=AdqMQS3yGkx_T4h4hCYln0hh0o2gUcZALMIZirGKdZurI0wDpSLwLmx3Uc7HyHlbVh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3C7W0Y6tpymbur6-H3s73CmSzoQwqXmhBVegsGhTgCuw&oe=69D4F96A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPkyLzHOqP8Q7kNvwG9Nwkp&_nc_oc=AdoMpsPKW4usfqHWWGFXA7wjZCa_PiWT_lcz7UOZMOBfq7o_SGwV3GRrjsoYAAKpuYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HGEWVeatRpBh0T4B_ARQq9Ch8sm_BRXr_cPeiOqFQ_Q&oe=69D51922"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_m2WYKo7qEQ7kNvwGkE33a&_nc_oc=AdpBw5y2MAAFKEFxikf5JNF3mc5-WV6UuXdxXsVPKqM5u1dO7bs1u9HPJHJIDtbu-_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VnNN3h-EcQqOa67jXM_ugSKPaNizYEcx2pDIDTByuUw&oe=69D4F64F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
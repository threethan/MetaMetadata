79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0MH7AB0CWAQ7kNvwGyFn3c&_nc_oc=AdpAC9SJmb_36PdO4He4uGE0B5xeEPUGilaI8vSDUxtY6W-gm4vHfD4Sl-ll3F-pwZ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh96P7gQrIt7ccep27Y_gn0zK7H8UwF40AuOCCs4ArEQ&oe=6A68A16A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkpmxKTBG78Q7kNvwEvUvkJ&_nc_oc=Adr5hh1fuPXLx40l_lmf65yVGJV337RuPu8Otn6xempzAWVj9vUr_JJ0HnrarMWjorA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_8msPVffP8QC7q7P5UaXGW0jfGRWtwg_U3JmRa1vG2g&oe=6A68C122"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOagRxL792QQ7kNvwFEB9tQ&_nc_oc=AdqoM5ONXgq5BJt2TTEId1ISo5UacsuCnyeCGbn8jVaowRWhWUFgza6HIoGhTFptpYw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwXCgJVDIVnMQ7OiEn4Xg7DT-u53OLFThBAoSLzUGpJA&oe=6A689E4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS5wzUgVCPkQ7kNvwFeDeDY&_nc_oc=Adol0sBFS900wdt4dJ9qr3BpDZUBIQvbiiBGqlmW6xHUT06Sjx6bvnLoSeA3c5DFZa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GNXg1vHgf-gYZiSRJ7o1jR21qjp85nobQDjakHQ25ag&oe=6A007AEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK928M9HR6kQ7kNvwFpIyy2&_nc_oc=Adr7TreKffHXfNdvqoC6IUsvjh4wiDqE0sQCp6dGsYwV4jdgG8HmNgHud42NjoI0GjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SWZwSqkH3M9NuaIdetMQtPhHfckZ2l00BitSX52bE3A&oe=6A009AA2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XqQWy0VD2YQ7kNvwGFwgs8&_nc_oc=Adq15rwPjB0nG74bSv92M2BCsmDmaCr1lGdxvoiYBKGvV57NeAtXVwbcEyeT_VIL0FI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sC2LOZy7T21yTm-OcXL-KjnsZi3U-kgTKhpoUa0q4BA&oe=6A0077CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
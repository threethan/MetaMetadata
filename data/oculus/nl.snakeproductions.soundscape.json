79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCA437eYOWAQ7kNvwHt8Ilu&_nc_oc=AdqMO-a2-tsm__1RF_KN4FmEhYGmIVpoXg4OqMWCAQJXlgvHtFhN4cnJDDlPVBfxGV8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q4cX4izjALwMPDCj0N7kPaqSecC35mhIwYv-JCMikug&oe=6A0EFB6A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6hVzYONvgEQ7kNvwGh8nrt&_nc_oc=AdrrvDGWIRtemRovVMdECqM0NHjIaXwZkHog1TZ5DgIbFNGCkyuJNp6M3NGpFtxXb5E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sVKo-XYHk_VkGcmHCrTLeyBnWV2CKX7hIsdXBKiVOgg&oe=6A0F1B22"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aenD8KGXe3kQ7kNvwFuxEaQ&_nc_oc=AdpDoILImVnlW9YPFNGzbRl4m7crsFevvplG9uEWOqisImVzIyQLpWHRiJCatuL-i7E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u8j_QVXkROYGIT1q3iQGLcnLZQS7nlmIwS6KUjpKQWA&oe=6A0EF84F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV9YR8umWccQ7kNvwFOpIdc&_nc_oc=AdqEdEnSuNnuKiUMfR03T2fuKtutf5IdcQ0IRGchJIkkkGPkDhE6umf74_xoXLHSHCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsUlkdLTM9yesT1Xp1UhxDfm6VHSwNcqjDTCZCMQio-A&oe=6AE769AA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjjCePbvkjMQ7kNvwHHiEuy&_nc_oc=AdrL1--7qsgG9c_Ab1BgbG3U0Tnbdc1t4oVta4bse3LkRVB0GmB_Xtei5MuTbVk0u0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs9h6IRj_515IQ6a4g_Mm29ztajjoL52Nc3w4Kr-f0iw&oe=6AE75122"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDswF8LIB-QQ7kNvwFg6Ap-&_nc_oc=AdoH_Z8VJHEda4nrSkVRPQjVs28byWvidulDOgZuTvvL2JVRaHUMHP0BjlAue-J3ywc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp4PJB9TT3-Be0NnG1iVaEC-FDKZkbuB_0XTXzSk1R6w&oe=6AE7668F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
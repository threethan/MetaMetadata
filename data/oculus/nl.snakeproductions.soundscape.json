79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVPCU1YeM68Q7kNvwGc9Bcv&_nc_oc=Adps0lMrFF9iIWHmlbSnkStDZjQ2oGWTZxFm400ShkGm4mv0uwpMzN95x3MJ7hVLbzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy5-cvrztUlrwSk8m11A1ZiuJAJI6vV2_rc68miwFdMA&oe=6AC3D12A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC07zX63N64Q7kNvwHrc-m7&_nc_oc=AdogRFcoQcxGTJxwHZiU552Xsv8sGOkEFD7I5sMPGtYuOZIfqd5P-ABsTqPcsc4GSl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbptQO91GanQxfd0Yj5xVGg6NnAV8kqZlkLL7UcqstKA&oe=6AC3B8A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh_j82X-8b4Q7kNvwELeSj_&_nc_oc=Adrd93n-0ugiYm3UVGERNCJQjAuYljKArijmQu2PXNMnqpi3HVsg7ULQtHZYemWkZW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO--ud3kD2jTH1D4puSnJsl2AoCeMDIwZGFO2MLnMTt9g&oe=6AC3CE0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hM1S5UuNi88Q7kNvwFBphT1&_nc_oc=Adqh-WDi7e5hya3AErFgfMQBQplO-EZIHFffKHHHOGJErAo8rhH26HoYX9SdLnbFCHU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkhCdaVm0TQB3r9hrIMIFj4KQPq8zXVlq1covYKrnLFQ&oe=6ADCA56A"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnwQc35SOpIQ7kNvwFXtQL0&_nc_oc=AdqowOXAzdkapoFeifYZY1zokMxfycHbEzRffQaZ2kebt4BzI7LGuwsrCvAvP4Pi2Pc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXPy0cU1Et3w92oFVJ8GVa-3QYJHR3YlehId1pI6RZ4g&oe=6ADCC522"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fif6DRyVWzUQ7kNvwGGoQjQ&_nc_oc=AdpCgjCFXwEOQZEUKUKy0q5zHORbQL0uKBGBiul51wCi-FZB90okmIE6ka3nQ1TXSyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO43uFLofSnf3yxJySTiWaqCgORSfrbUPqBuHzGMa-QzQ&oe=6ADCDA8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
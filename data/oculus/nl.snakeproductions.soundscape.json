79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwKst8cXhMcQ7kNvwHaCsIO&_nc_oc=Adq6bHpCHHD00JTiR_XR8h64nUVFrK1Topuuf5Grmn9we-orgHyMLcc46roEmq39VIo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JcCSqlqe3oxvf0NjUmFHMKyD5z4esB5y18jH2siPbKQ&oe=6A1AD8EA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzN57C8fVr0Q7kNvwFl9TdM&_nc_oc=AdpINaDaZiWelp7MpXfNF7NsA8-AWqPsklZylrfrMeVuqqRry5STVV1IpfJfVJVbrYE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5btzdbWlbZiD9LcoLjBYljlrTW6JCrLbJl5IeF7pBtiw&oe=6A1AF8A2"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixSYmumaB7AQ7kNvwF2nHY7&_nc_oc=Adrz76rAf5smlzLsAGmGePCiGxz-Koo6I2OwNYuKkBhnfnrMgJoODIZY1613cFg7qrY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43NsLalfsYbNCdc2fbKU2WpxO6PdKBk2irwj97l3CzsA&oe=6A1AD5CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOo2196I3WYQ7kNvwFCgGgI&_nc_oc=AdrhRTyPejxBXy59x4tjkxvN2AaJkGMFz3bECQHqDOfv5DmEVpaSns1tvNn0sKxUma0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcpiVfQN_UmhYjDEpDV2s6qBrUfhn4gVcfSDZTcxCJSw&oe=6A917FEA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Dabtjfjaj4Q7kNvwG2bkYj&_nc_oc=AdqdM3fsWP5GnW34_rMy3gOv93SX-nF_5KFBM7DmXq66t-z4lO5AYz0_aE1W8mK66GI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHFq-QDpTQN5Ct_-ZpEJSM0cmw6QaOqIzdhTi_H02bQw&oe=6A916762"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v9SlCVyoEUQ7kNvwFhEFSJ&_nc_oc=AdpD0bSl-IqYQZoE2_Dj6erO3Qm4FRHbCoQRAMKNyZ2GVkb_AKsBLP_PptISgLCKYcw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB6kgsfcADKiiSBA_nWBR9TJpljQ-3ATACcdj_zrQ3fA&oe=6A917CCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
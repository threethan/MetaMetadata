79_962804100494998_118750452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UyHD57cY18Q7kNvwHxx2kq&_nc_oc=AdqkrKDfiQ9Wjq4SGZ7TiueIOUhAKUP7vLgMik5GPN4YMRBfVtRTJi6uW0YMkd4pQJ0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiXljvrK8V3xcTJnAkO_-2DlYQih_zQKjIVyQ1luIb6A&oe=6AF9DEAA"}, {"file_name": "migrated_image.png", "id": "205908677390327", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12410469_2075164742708153_991892082_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AThdFkB0jlMQ7kNvwFH93Dv&_nc_oc=Adrpbcl3gdKIZPLphsoXwUZ4KjD0OkQl0w6OA6xgXQeza0KQabyMyCctNDktGLqJ8Vk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0zzuPJj736yF5-x6d9oMq0rpHVtvbUMz7pH50NHFNig&oe=6AF9C622"}, {"file_name": "migrated_image.png", "id": "165993377745437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386392_1776191742664229_72110469_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx8mbjVk2vEQ7kNvwGbim7c&_nc_oc=Adr2KWQDnzkvI1lWDHUlyVlHbDjsk78alZzZnrrwIw1wUVFbCFc_TpbrRXw4rVSBLJg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsoaSPbVZJO0qyrF8IQia93PBQZq9ya98zGH1-1-ToWA&oe=6AF9DB8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soundscape", "keywords": ["soundscape", "music", "social"], "long_description": "Soundscape lets you create electronic music in a futuristic environment. On huge screens you can add musical notes, change effects and influence the characteristics of one of three instruments. You can choose to do this alone or jam along with 2 other randomly selected people. The notes are based on a pentatonic scale which means whatever notes are selected it will always sound good (well, most of the time). There is a handy tutorial mode for people who start the experience for the first time. Soundscape is meant for those who enjoy playing with music. Jam along!", "short_description": "Soundscape lets you create electronic music in a futuristic environment. On huge scr
SXIIgD7twnBgkPW8woXrwGCHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6O5DOUwxM5VzHgtenMBbRHpbnWOST4nAvi8-2wMTQLg&oe=6AA2B78F"}]}, "id": "1304149691089479", "locale": "en_US", "screenshots": [{"file_name": "com.NEKR_VR.EduVR (7).png", "id": "1119879959572013", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_1119879962905346_3257633798623217793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj6QEUwfNjAQ7kNvwHTzRCH&_nc_oc=Adq0H6IlcUKKVrkZwNW2vlWK7QZ1zvUhM5YKrHxgl9T70gU0IpDM8MKQZNsontT5rms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOlz4zDssKFZfFW2sEXrW3-d5VB4n9mkcNRnGJShi4JQ&oe=6AA2B3A8"}, {"file_name": "com.NEKR_VR.EduVR (9).png", "id": "600769042344423", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75367595_600769045677756_4184331693265155160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqp9zPc19OcQ7kNvwEUzv1C&_nc_oc=AdonMwVd_lQJh-bGIlLrtOrHR476oyVLBk6yMnz4oej_z_GBNsR8IVtwSliddhfvLG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvLg0TUVklCSn08RdxXHMxgXCa68byiLUq6o6ljydy0A&oe=6AA2C42F"}, {"file_name": "com.NEKR_VR.EduVR (5).png", "id": "511803525221127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031608_511803535221126_6449582359268280911_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C71K7KZ92l4Q7kNvwGTrkOo&_nc_oc=Adp3fV1jX5oW_oxgjooin3_lz1xWKoi8EpKiIkMVWwADFlffw2xoL2woFs1s19Xx_tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVV443yKAeZ6E0vfZMSdNPtb5HOd87X_2EBSWVUj0Zog&oe=6AA2C898"}, {"file_name": "com.NEKR_VR.EduVR (6).png", "id": "1380952959552847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003258_1380952966219513_7539545808247244132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UZ2qpnl7m0Q7kNvwFNXCtF&_nc_oc=AdqSMuKPDlE9xYhrJUzflJrFXKW8bCZE1CgPc6r4kMDZcbwvgzGDZkeEe_02WteIITw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPwqKioBOuwwBHxLQc56fVQH0FpPaeFJQvaPwYfOTr8A&oe=6AA29DBC"}, {"file_name": "com.NEKR_VR.EduVR (10).png", "id": "2014764132301448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451776_2014764135634781_3715488626808879103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRSWoNMW6RoQ7kNvwEBjHmM&_nc_oc=AdqKL-6Hcukn76hfRCFqTdRQG3BnyQJ-yTcHB4bHy-haDpNz62xCiM9Ra0AVnZVS8yY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCb_qheFIX0NSwO6OUimkSHfIHYdoBteTtMwa1ckUwGQ&oe=6AA2A82B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "593570069731482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974502_593570076398148_755855805457355311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_O7MxfKMh8Q7kNvwGm2ILU&_nc_oc=AdpVNpSGnmvipQdcs130nldvwKq2jSpKJ541qYscoYMZ_6SkaTq__KXde2M8GSx-92A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUCcuKtsQbfPUZ1Mw7P4OZVoRRohOHCUwS7GogZOHLbw&oe=6AA2CF90"}, "display_name": "EduVR", "keywords": ["education", "school", "workshop", "modern"], "long_description": "## Revolutionizing Education with Virtual Reality  \n\n**EduVR** is a modular educational VR application designed for schools, offering a new way to engage students in learning. Teachers and students become part of realistic simulations and practical tasks that promote active learning, safe experimentation, and a better understanding of complex topics.  \n\n---\n\n## **Key Features**  \n\n- **Modular System:** Covers a wide range of subjects and disciplines, with new modules regularly added.  \n- **Easy to Use:** No need for a powerful PC \u2013 EduVR runs directly on Meta Quest.  \n- **Safe Learning:** Simulate situations that can't be safely performed in traditional classrooms (e.g., safety training).  \n- **Interactive:** 5\u201310 minute tasks and simulations, ideal for integration into regular lessons.  \n- **Progress Tracking:** Teachers can monitor students\u2019 progress and provide personalized feedback.  \n\n---\n\n## **Benefits for Schools**  \n\n- **Engaging Lessons:** Virtual reality increases students\u2019 interest in learning and enhances their skills.  \n- **Cost Savings:** Vocational schools can simulate working with expensive materials and equipment.  \n- **Flexibility:** Adaptable to different subjects and age groups.  \n- **Practical Applications:** Prepares students for real-life scenarios in a safe and efficient way.  \n\n---\n\n## **Try it for Free**  \n\nDownload the free version of EduVR and access a new module every 14 days. Discover how EduVR can transform education at your school and get started today!  ", "short_description": "Transform your classroom with EduVR, the modular educational VR app designed for schools! Engage students in interactive lessons across various subjects with realistic simulations, hands-on tasks, and detailed feedback. No PC required\u2014run it directly on your Meta Quest. Discover a new way to learn, save resources, and spark interest in every student!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c798cbdb-09be-4657-9222-0179dc129c86", "developer_terms_of_service_url": null, "publisher_name": "NEKR VR", "support_website_url": null, "website_url": "https://eduvr.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24436333162660346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203616_505967072475232_5858564473722909804_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5k_2VUBnxDAQ7kNvwHLY1jt&_nc_oc=AdodEwapj-vhksTOmIP3Uv-1HgBdfU-Qrtmu6c8_XHM4DM_6z2-vylc9BHM0SHNPU5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIovjBrvoUqEK-b_8s46rqjxcKCKGDFF3-eohDBFoOImA&oe=6AA2A241"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EduVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1787858820, "lastRevision": {"nodes": [{"id": "8651560748230841", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8651560711564178", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3983563258569599"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2601587930195008", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduVR", "keywords": ["vzd\u011bl\u00e1n\u00ed", "\u0161kola", "d\u00edlny", "modern\u00ed"], "long_description": "## Revoluce ve vzd\u011bl\u00e1v\u00e1n\u00ed prost\u0159ednictv\u00edm virtu\u00e1ln\u00ed reality  \n\n**EduVR** je modul\u00e1rn\u00ed eduka\u010dn\u00ed VR aplikace navr\u017een\u00e1 pro \u0161koly, kter\u00e1 p\u0159in\u00e1\u0161\u00ed nov\u00fd zp\u016fsob, jak zapojit studenty do v\u00fduky. U\u010ditel\u00e9 i \u017e\u00e1ci se stanou sou\u010d\u00e1st\u00ed realistick\u00fdch simulac\u00ed a praktick\u00fdch \u00fakol\u016f, kter\u00e9 podporuj\u00ed aktivn\u00ed u\u010den\u00ed, bezpe\u010dn\u00e9 experimentov\u00e1n\u00ed a snadn\u011bj\u0161\u00ed pochopen\u00ed slo\u017eit\u00fdch t\u00e9mat.  \n\n---\n\n## **Kl\u00ed\u010dov\u00e9 vlastnosti**  \n\n- **Modul\u00e1rn\u00ed syst\u00e9m:** Pokr\u00fdv\u00e1 \u0161irokou \u0161k\u00e1lu p\u0159edm\u011bt\u016f a obor\u016f, s neust\u00e1le p\u0159ib\u00fdvaj\u00edc\u00edmi nov\u00fdmi moduly.  \n- **Snadn\u00e9 pou\u017eit\u00ed:** Nen\u00ed pot\u0159eba v\u00fdkonn\u00fd po\u010d\u00edta\u010d \u2013 EduVR b\u011b\u017e\u00ed p\u0159\u00edmo na Meta Quest.  \n- **Bezpe\u010dn\u00e9 u\u010den\u00ed:** Simulace situac\u00ed, kter\u00e9 nelze bezpe\u010dn\u011b prov\u00e9st v re\u00e1ln\u00e9 v\u00fduce (nap\u0159. BOZP).  \n- **Interaktivita:** \u00dakoly a simulace na 5\u201310 minut, ide\u00e1ln\u00ed pro za\u010dlen\u011bn\u00ed do b\u011b\u017en\u00e9 v\u00fduky.  \n- **Statistiky:** U\u010ditel\u00e9 mohou sledovat pokrok student\u016f a poskytovat zp\u011btnou vazbu.  \n\n---\n\n## **V\u00fdhody pro \u0161koly**  \n\n- **Atraktivn\u00ed forma v\u00fduky:** Virtu\u00e1ln\u00ed realita zvy\u0161uje z\u00e1jem \u017e\u00e1k\u016f o vzd\u011bl\u00e1n\u00ed a rozv\u00edj\u00ed jejich dovednosti.  \n- **\u00daspora n\u00e1klad\u016f:** Pro odborn\u00e9 \u0161koly mo\u017enost simulovat pr\u00e1ci s drah\u00fdmi materi\u00e1ly a p\u0159\u00edstroji.  \n- **Flexibilita:** P\u0159izp\u016fsobiteln\u00e9 pro r\u016fzn\u00e9 p\u0159edm\u011bty i v\u011bkov\u00e9 skupiny.  \n- **Praktick\u00e9 pou\u017eit\u00ed:** P\u0159\u00edprava student\u016f na re\u00e1ln\u00e9 situace bezpe\u010dn\u00fdm a efektivn\u00edm zp\u016fsobem.  \n\n---\n\n## **Vyzkou\u0161ejte zdarma**  \n\nSt\u00e1hn\u011bte si bezplatnou verzi EduVR, kter\u00e1 ka\u017ed\u00fdch 14 dn\u00ed zp\u0159\u00edstupn\u00ed nov\u00fd modul na vyzkou\u0161en\u00ed. Objevte, jak m\u016f\u017ee EduVR obohatit vzd\u011bl\u00e1v\u00e1n\u00ed na va\u0161\u00ed \u0161kole, a za\u010dn\u011bte je\u0161t\u011b dnes!  ", "short_description": "P\u0159ive\u010fte do sv\u00e9 t\u0159\u00eddy revoluci s EduVR, modul\u00e1rn\u00ed eduka\u010dn\u00ed VR aplikac\u00ed navr\u017eenou pro \u0161koly! Zapojte studenty do interaktivn\u00edch lekc\u00ed nap\u0159\u00ed\u010d r\u016fzn\u00fdmi p\u0159edm\u011bty s realistick\u00fdmi simulacemi, praktick\u00fdmi \u00fakoly a podrobnou zp\u011btnou vazbou. Nen\u00ed pot\u0159eba PC\u2014v\u0161e b\u011b\u017e\u00ed p\u0159\u00edmo na Meta Quest. Objevte nov\u00fd zp\u016fsob u\u010den\u00ed, \u0161et\u0159ete zdroje a probu\u010fte z\u00e1jem v ka\u017ed\u00e9m studentovi!"}, {"images": {"nodes": [{"file_name": "hero_cover.png", "id": "1285614156052820", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_1285614159386153_9193819593370860177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLJZ_7uevFsQ7kNvwGcLp9f&_nc_oc=AdozcAeaCGgtgkyzvpKHaLO5U8BvQ-6alT1KpcDKQw00VibnvaCMQYTunDOvldd8lbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6zTbY0zAoECkg5vSWpnR9tNNwwVjr-c1CxoyMOvnT9Q&oe=6AA2C677"}, {"file_name": "cover_1008x1440.png", "id": "596824689538812", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462204_596824696205478_7016241178100153526_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvhvgWrple4Q7kNvwErGmCp&_nc_oc=AdqGq47BJ87oaT1jbS87O-cLxOfpU1BRC-5V31Hijr12xPEDuRItT5Ezv_ynDsGYNs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkQAkhiF5t8q_Y_MrKGOkiPPPSUsbYpF05STLRaauCwQ&oe=6AA2B933"}, {"file_name": "cover_2560x1440.png", "id": "595654806353944", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035329_595654816353943_6790892723316702241_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfd5rYNAq_AQ7kNvwG3Dn_U&_nc_oc=AdqoTqkzJaOl7oQYvGcdB8mTBYVZlGqN-g6SHKqchmWLo_l7yOTDEw192WvfpVKC-MI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJATV8kyEk1mT1_CgDTOgilaa6btdgmY-kGkO9z1vkIzw&o
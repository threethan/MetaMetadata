IvcZPFwa1n-DoLmbmkioRHAKY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUrNdHq6ejV4BbvKQcWlYPqBDkOMhTvi2_NAIqj76QBA&oe=6AE8970F"}]}, "id": "1304149691089479", "locale": "en_US", "screenshots": [{"file_name": "com.NEKR_VR.EduVR (7).png", "id": "1119879959572013", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982557_1119879962905346_3257633798623217793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGl_04uq0e8Q7kNvwFis4cj&_nc_oc=AdrZiCyNCjVIHWHtDn99VUR0TQbbRkR8PDKLluZYq8obRlWrI3So61Xhg-ig6W9Ns1A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROyb0JQKDKWM9la9EbiKgaDM-dMM2lkMWvRG15LNlsrA&oe=6AE89328"}, {"file_name": "com.NEKR_VR.EduVR (9).png", "id": "600769042344423", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75367595_600769045677756_4184331693265155160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdYoxKm6U6cQ7kNvwFFUiE8&_nc_oc=AdqCn81KXHuAsl9Un6PiSTC7envB3ZI4VAwRbtUDGT0cJSpDpbRgjqzl1Bd14OwdBwI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaozFXxzW9iSxCWKeMt9gYZWTaHps0qrNesmF5D3WLJw&oe=6AE8A3AF"}, {"file_name": "com.NEKR_VR.EduVR (5).png", "id": "511803525221127", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031608_511803535221126_6449582359268280911_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4juFCEiPO7MQ7kNvwFkx-z4&_nc_oc=Adrh6Jy0KmwkO8TxKzSw8aW7bgGnvqTuwDMc2GF-nOFpYBw2y6UY8tJeecD0Jlzkl20&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh69ITJzK6VPGigo5wM0ozDfEXLD5cnPvyPCeaf3DQQg&oe=6AE8A818"}, {"file_name": "com.NEKR_VR.EduVR (6).png", "id": "1380952959552847", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003258_1380952966219513_7539545808247244132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWFc-NV03pMQ7kNvwGDsnB9&_nc_oc=Adqqt3NnoKFAjHzuvGw1or8sgzEc_Po5A2hrUUASfr264fD2cegqfHr3WRhOnq8TeII&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSudwumPrCMwqEPlbcycifwEPAsbcBSCsYK-cEbGJMMUQ&oe=6AE8B57C"}, {"file_name": "com.NEKR_VR.EduVR (10).png", "id": "2014764132301448", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75451776_2014764135634781_3715488626808879103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luhRNOk14jwQ7kNvwGj9KzF&_nc_oc=Adqz-WAGFj7kplw_0ILQ4URMh6aQeDbxT-Rab4GAPV1kyA4V_Ma5ww2VltjwI6Peopo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwB3BBO_Ebj1EBzDg1akIBYdpNHWuv3kbEJDr2k9CjYQ&oe=6AE8BFEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "593570069731482", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974502_593570076398148_755855805457355311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y0KACah7AkQ7kNvwFo-LOe&_nc_oc=AdqtJLNbxde8Y56fotZTCjyNUwguBvTRq72fr9wTNbIgvn_h9sQR-GvRNUZjo_vNs28&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1rTJS4JnH4AVwhQHqSP5nnEtH71L_v2pC2pvXZxJHYA&oe=6AE8AF10"}, "display_name": "EduVR", "keywords": ["education", "school", "workshop", "modern"], "long_description": "## Revolutionizing Education with Virtual Reality  \n\n**EduVR** is a modular educational VR application designed for schools, offering a new way to engage students in learning. Teachers and students become part of realistic simulations and practical tasks that promote active learning, safe experimentation, and a better understanding of complex topics.  \n\n---\n\n## **Key Features**  \n\n- **Modular System:** Covers a wide range of subjects and disciplines, with new modules regularly added.  \n- **Easy to Use:** No need for a powerful PC \u2013 EduVR runs directly on Meta Quest.  \n- **Safe Learning:** Simulate situations that can't be safely performed in traditional classrooms (e.g., safety training).  \n- **Interactive:** 5\u201310 minute tasks and simulations, ideal for integration into regular lessons.  \n- **Progress Tracking:** Teachers can monitor students\u2019 progress and provide personalized feedback.  \n\n---\n\n## **Benefits for Schools**  \n\n- **Engaging Lessons:** Virtual reality increases students\u2019 interest in learning and enhances their skills.  \n- **Cost Savings:** Vocational schools can simulate working with expensive materials and equipment.  \n- **Flexibility:** Adaptable to different subjects and age groups.  \n- **Practical Applications:** Prepares students for real-life scenarios in a safe and efficient way.  \n\n---\n\n## **Try it for Free**  \n\nDownload the free version of EduVR and access a new module every 14 days. Discover how EduVR can transform education at your school and get started today!  ", "short_description": "Transform your classroom with EduVR, the modular educational VR app designed for schools! Engage students in interactive lessons across various subjects with realistic simulations, hands-on tasks, and detailed feedback. No PC required\u2014run it directly on your Meta Quest. Discover a new way to learn, save resources, and spark interest in every student!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c798cbdb-09be-4657-9222-0179dc129c86", "developer_terms_of_service_url": null, "publisher_name": "NEKR VR", "support_website_url": null, "website_url": "https://eduvr.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24436333162660346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203616_505967072475232_5858564473722909804_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K6ix2cN6S0Q7kNvwEw0F3k&_nc_oc=AdqpNhPctScuT5if61QLxtrC76ygzqP39AU0fLDEf8-asz6_QSvWMLS4tMDjvuV5F6U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe7McEtu46cB1PBayFaoLSu4hkfzXPufan_YBBEF0oVA&oe=6AE8BA01"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EduVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1787858820, "lastRevision": {"nodes": [{"id": "8651560748230841", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8651560711564178", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3983563258569599"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2601587930195008", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EduVR", "keywords": ["vzd\u011bl\u00e1n\u00ed", "\u0161kola", "d\u00edlny", "modern\u00ed"], "long_description": "## Revoluce ve vzd\u011bl\u00e1v\u00e1n\u00ed prost\u0159ednictv\u00edm virtu\u00e1ln\u00ed reality  \n\n**EduVR** je modul\u00e1rn\u00ed eduka\u010dn\u00ed VR aplikace navr\u017een\u00e1 pro \u0161koly, kter\u00e1 p\u0159in\u00e1\u0161\u00ed nov\u00fd zp\u016fsob, jak zapojit studenty do v\u00fduky. U\u010ditel\u00e9 i \u017e\u00e1ci se stanou sou\u010d\u00e1st\u00ed realistick\u00fdch simulac\u00ed a praktick\u00fdch \u00fakol\u016f, kter\u00e9 podporuj\u00ed aktivn\u00ed u\u010den\u00ed, bezpe\u010dn\u00e9 experimentov\u00e1n\u00ed a snadn\u011bj\u0161\u00ed pochopen\u00ed slo\u017eit\u00fdch t\u00e9mat.  \n\n---\n\n## **Kl\u00ed\u010dov\u00e9 vlastnosti**  \n\n- **Modul\u00e1rn\u00ed syst\u00e9m:** Pokr\u00fdv\u00e1 \u0161irokou \u0161k\u00e1lu p\u0159edm\u011bt\u016f a obor\u016f, s neust\u00e1le p\u0159ib\u00fdvaj\u00edc\u00edmi nov\u00fdmi moduly.  \n- **Snadn\u00e9 pou\u017eit\u00ed:** Nen\u00ed pot\u0159eba v\u00fdkonn\u00fd po\u010d\u00edta\u010d \u2013 EduVR b\u011b\u017e\u00ed p\u0159\u00edmo na Meta Quest.  \n- **Bezpe\u010dn\u00e9 u\u010den\u00ed:** Simulace situac\u00ed, kter\u00e9 nelze bezpe\u010dn\u011b prov\u00e9st v re\u00e1ln\u00e9 v\u00fduce (nap\u0159. BOZP).  \n- **Interaktivita:** \u00dakoly a simulace na 5\u201310 minut, ide\u00e1ln\u00ed pro za\u010dlen\u011bn\u00ed do b\u011b\u017en\u00e9 v\u00fduky.  \n- **Statistiky:** U\u010ditel\u00e9 mohou sledovat pokrok student\u016f a poskytovat zp\u011btnou vazbu.  \n\n---\n\n## **V\u00fdhody pro \u0161koly**  \n\n- **Atraktivn\u00ed forma v\u00fduky:** Virtu\u00e1ln\u00ed realita zvy\u0161uje z\u00e1jem \u017e\u00e1k\u016f o vzd\u011bl\u00e1n\u00ed a rozv\u00edj\u00ed jejich dovednosti.  \n- **\u00daspora n\u00e1klad\u016f:** Pro odborn\u00e9 \u0161koly mo\u017enost simulovat pr\u00e1ci s drah\u00fdmi materi\u00e1ly a p\u0159\u00edstroji.  \n- **Flexibilita:** P\u0159izp\u016fsobiteln\u00e9 pro r\u016fzn\u00e9 p\u0159edm\u011bty i v\u011bkov\u00e9 skupiny.  \n- **Praktick\u00e9 pou\u017eit\u00ed:** P\u0159\u00edprava student\u016f na re\u00e1ln\u00e9 situace bezpe\u010dn\u00fdm a efektivn\u00edm zp\u016fsobem.  \n\n---\n\n## **Vyzkou\u0161ejte zdarma**  \n\nSt\u00e1hn\u011bte si bezplatnou verzi EduVR, kter\u00e1 ka\u017ed\u00fdch 14 dn\u00ed zp\u0159\u00edstupn\u00ed nov\u00fd modul na vyzkou\u0161en\u00ed. Objevte, jak m\u016f\u017ee EduVR obohatit vzd\u011bl\u00e1v\u00e1n\u00ed na va\u0161\u00ed \u0161kole, a za\u010dn\u011bte je\u0161t\u011b dnes!  ", "short_description": "P\u0159ive\u010fte do sv\u00e9 t\u0159\u00eddy revoluci s EduVR, modul\u00e1rn\u00ed eduka\u010dn\u00ed VR aplikac\u00ed navr\u017eenou pro \u0161koly! Zapojte studenty do interaktivn\u00edch lekc\u00ed nap\u0159\u00ed\u010d r\u016fzn\u00fdmi p\u0159edm\u011bty s realistick\u00fdmi simulacemi, praktick\u00fdmi \u00fakoly a podrobnou zp\u011btnou vazbou. Nen\u00ed pot\u0159eba PC\u2014v\u0161e b\u011b\u017e\u00ed p\u0159\u00edmo na Meta Quest. Objevte nov\u00fd zp\u016fsob u\u010den\u00ed, \u0161et\u0159ete zdroje a probu\u010fte z\u00e1jem v ka\u017ed\u00e9m studentovi!"}, {"images": {"nodes": [{"file_name": "hero_cover.png", "id": "1285614156052820", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982619_1285614159386153_9193819593370860177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DaHBPtjtN8Q7kNvwFfoG0O&_nc_oc=Adohgl9BYuN39mn6rusMghWU8JPk9p1ecrN2mwESDuoutw6e-ctS_9MyUr0t3N9l4tE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuM_2gxRn6AO4mRssfrzMmvdBoUAa9ur_BrdMRNkv1kg&oe=6AE8A5F7"}, {"file_name": "cover_1008x1440.png", "id": "596824689538812", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75462204_596824696205478_7016241178100153526_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ixPtYs6jocQ7kNvwGshWGW&_nc_oc=AdrOiSK1WQlwJXc3qt0zdH9ePopF7lgXc2fnCK9fnGO16ka5-vrk004urT6cjDgBGU8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXZnmXLGMwO1tQmrs5QEzFuokYHXUMSUc5_njJYyTL6A&oe=6AE898B3"}, {"file_name": "cover_2560x1440.png", "id": "595654806353944", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035329_595654816353943_6790892723316702241_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R40dQc5KQoQ7kNvwESjAkD&_nc_oc=AdogG0AnBXKDeM8tR8GvycDC7vodsK3amUqXeq9TvryXohR2vsWWo6v2ckbgRS0FLnE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjvnIrEAkbNO83jR1Y6A3OzZ8j7QZDNaekOLyCu71BbQ&o
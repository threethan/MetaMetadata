d": "600769042344423", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367595_600769045677756_4184331693265155160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krWrdcElxeUQ7kNvwGhYsfg&_nc_oc=AdrdpQdulpK6nSIcwoY4wsB-ZB_KqtJOeJ7wq1_vLLdb6yr21BaYgXvCw2yfkNoQfFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuq6xDWmuJYTa_8Gtd9P3f-dNdWo0F-s1Yzqe7K3WCDA&oe=6AB2962F"}, {"file_name": "com.NEKR_VR.EduVR (5).png", "id": "511803525221127", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031608_511803535221126_6449582359268280911_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWLGxsbVUekQ7kNvwGLkioA&_nc_oc=AdqvJG4tCSrjxVw_J66ogiEvR0xy1PzFthh6tq8K0mihh0pg9xXOCCOMAYBWp3sQn6c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICd6eio9vx1DFgBfudOsp8O7eqv_sIRgiy6ptTaI0MbA&oe=6AB29A98"}, {"file_name": "com.NEKR_VR.EduVR (6).png", "id": "1380952959552847", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003258_1380952966219513_7539545808247244132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpr8wjSZEK4Q7kNvwHEdvbs&_nc_oc=AdrVX_eR998iqovQWcAZ99lwu5RnU__q1DYODqtsKnc60UG9VDFH51h6lO-7tVJk-18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqbQB12jjXjvJ-aqsZcSdFVYl-2_e0TWzmCAxVPElcSQ&oe=6AB2A7FC"}, {"file_name": "com.NEKR_VR.EduVR (10).png", "id": "2014764132301448", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75451776_2014764135634781_3715488626808879103_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaKEAnB0KoIQ7kNvwG0lCQf&_nc_oc=AdqBh6Ty4JvdsMkr1qnwWve4gx6NMuwVjmhdQ7bPfEm1prM4l8snmC0ulBQp5QkpsMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINtZ-7XFUBtAS5UdOdbR00-jUY91rNC0vxz85CypuVVQ&oe=6AB27A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "593570069731482", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974502_593570076398148_755855805457355311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3Y32B2kSRQQ7kNvwHoE6T8&_nc_oc=Adoqw2MaqqdSfNn4DPXfSU8IALf_BPDTh09AFAWD311k_SXaGN5fCKK69WiGeI_T_fA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA0lSM5srcvfOL-SuTTOuNrs2G0-Xz3P6fnPJLpaqfug&oe=6AB2A190"}, "display_name": "EduVR", "keywords": ["education", "school", "workshop", "modern"], "long_description": "## Revolutionizing Education with Virtual Reality  \n\n**EduVR** is a modular educational VR application designed for schools, offering a new way to engage students in learning. Teachers and students become part of realistic simulations and practical tasks that promote active learning, safe experimentation, and a better understanding of complex topics.  \n\n---\n\n## **Key Features**  \n\n- **Modular System:** Covers a wide range of subjects and disciplines, with new modules regularly added.  \n- **Easy to Use:** No need for a powerful PC \u2013 EduVR runs directly on Meta Quest.  \n- **Safe Learning:** Simulate situations that can't be safely performed in traditional classrooms (e.g., safety training).  \n- **Interactive:** 5\u201310 minute tasks and simulations, ideal for integration into regular lessons.  \n- **Progress Tracking:** Teachers can monitor students\u2019 progress and provide personalized feedback.  \n\n---\n\n## **Benefits for Schools**  \n\n- **Engaging Lessons:** Virtual reality increases students\u2019 interest in learning and enhances their skills.  \n- **Cost Savings:** Vocational schools can simulate working with expensive materials and equipment.  \n- **Flexibility:** Adaptable to different subjects and age groups.  \n- **Practical Applications:** Prepares students for real-life scenarios in a safe and efficient way.  \n\n---\n\n## **Try it for Free**  \n\nDownload the free version of EduVR and access a new module every 14 days. Discover how EduVR can transform education at your school and get started today!  ", "short_description": "Transform your classroom with EduVR, the modular educational VR app designed for schools! Engage students in interactive lessons across various subjects with realistic simulations, hands-on tasks, and detailed feedback. No PC required\u2014run it directly on your Meta Quest. Discover a new way to learn, save resources, and spark interest in every student!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c798cbdb-09be-4657-9222-0179dc129c86", "developer_terms_of_service_url": null, "publisher_name": "NEKR VR", "support_website_url": null, "website_url": "https://eduvr.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24436333162660346"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1535848197049009"}]}, "baseline_offer": {"id": "1535848197049009"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787858820, "status": "PUBLISHED", "id": "1535848197049009"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27852171557743139", "version": "1.11"}, "id": "1470145710340083", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8651560711564178", "is_concept": false, "l
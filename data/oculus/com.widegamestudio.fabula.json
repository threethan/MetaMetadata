ntent-ord5-2.oculuscdn.com/v/t64.5771-25/499623601_873282058417906_3519589824809826573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex_rr5EB_5oQ7kNvwFYEAAu&_nc_oc=Adq-E9Pr_6mhNEJpTEUBzw7U6tr2xEaWSMIzYrQz0aSJ_5RrmlrdhQvU_i0ipKh_A_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNg6SJyO8zJ0J4PyFu3o_f_0lakDkF3qjO1ralAhk2IQ&oe=6A95DB57"}, {"file_name": "ss1..png", "id": "2923519001321780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507838217_2923519004655113_4847522626348651623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aGTRg2d2RkQ7kNvwF0htIf&_nc_oc=AdqhUiGvCx3sRkhf0TFB3TGMWrK7mbyRZn-wvRWvJ9PLHULyEAjzipQOdaev6FjJJtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPMjHvsvccjTIxeIQwuyhT7yYVPK3l7aRVBQHjQhJ2fA&oe=6A95E3B6"}, {"file_name": "ss6.png", "id": "971246942320610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620532_971246945653943_7363676018560733823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT6-oPTfbs8Q7kNvwGsX5a0&_nc_oc=AdqkxS3rDA7ly6simDZNsKkbGPK6wj7WUckzJAzWFkTH482gnRbK8fi6XAKZtFbCmn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhB6oM_DTlbuzKEwAX5LPcEe-CDCoAxq9wxggy1KeD6g&oe=6A95B63A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "---------------------------------- **LIMITED ACCESS** -----------------------------\n\n**(Opens only on weekends)**\n\nYou're a tiny bearlet. You're inside a fairytale village. You've got 10 minutes to swallow every magical artifact in sight and flush yourself out before another critter steals your haul. This is Fabula. \n\nA **free** VR extraction adventure for Quest 2 & 3 \u2014 mischievous fairy-tale critters, storybook raids, and the funniest inventory system in VR.\n\n# \ud83c\udf5d EAT THE TALE \nYour belly IS your inventory. Swallow loot to carry it. Overeat and you gag. Die and your haul bursts out for everyone to grab. Find an extraction toilet, flush yourself out, and turn every artifact into Fame.\n\n# \ud83c\udfaf HIGH-STAKES RAIDS\n\nBoss-guarded artifacts. Up to 10 players competing for the same loot. Every run escalates.\n\n# \u2694\ufe0f PvPvE COOPETITIVE \n10 players every raid. Co-op with your party. Compete with everyone else. Every artifact is contested. Pure chaos!\n# \u2728 GROW YOUR LEGEND \nExtracted loot becomes Fame. Fame levels your Tale. Unlock new gear, relics, and powers. Hit Tale Level 60, go Legacy, start over stronger.\n\n**Find the toilet. Flush the magic. Become a legend.**\n\n", "short_description": "Be the good wolf in the storybook. The piggy who eats the wolf. The bearlet who robs the Princess. Fabula is a VR extraction adventure where every fairy-tale rule is yours to break \u2014 and every magical artifact is yours to swallow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "2679810702654844
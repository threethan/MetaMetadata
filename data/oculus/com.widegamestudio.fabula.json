yn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEKL4Ov3gZzk0nnq-cpq0emQ8K9akiWfE_bHVLHt49nQ&oe=6A689E9F"}, {"file_name": "Screenshot2026-06-18-17-38-49-2.png", "id": "2049674408980676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624983_2049674412314009_5796090158364440725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2ruxeF_hdcQ7kNvwE_Sz5G&_nc_oc=Adrk7DcZYzx3zQTLddt4KlrPKqM4memIOl-VU_P2zf3zVL7Md704CHGOzCW6vbiHaSw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCProxOtOhHSmao_oOFC6__k0EVmdqrW8vHfKcSnyNPGA&oe=6A68BD6A"}, {"file_name": "Screenshot2026-06-18-12-57-50.png", "id": "2204903010255527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_2204903016922193_5057111604070029824_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiqbf3rchRQQ7kNvwGtdZAz&_nc_oc=AdrIBprLjZJ4YU6BMAwLzS1hfRiOTZKPj2MzVXx8qm-L0E6d_rJgch-Coj_fuG_0bg0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAzzHwjYaE9O9jQ-htig4n7ogW2BSXiUlWInZ9z1exwA&oe=6A68C4D5"}, {"file_name": "ss5.png", "id": "1284321793898582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311582_1284321797231915_7423688044320443547_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfXXTmTqRxQQ7kNvwGSW8y7&_nc_oc=AdrXwm5wk7ezxFCS4Njvhntl8WlP7Q5qOmQq2xVbu8_sbb0hX_pz5bikk-IW1F4dcuo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPXbkbmq0RV5IS9jDtDDO5IEkheUpAx7NocWSoCVuT2w&oe=6A6893CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscapeDark.png", "id": "1556191603184749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654886437_1556191606518082_4111882578767064083_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utKzn84ZFr0Q7kNvwEszH76&_nc_oc=AdrqbM0DqYcYcEm1kqvJ5BvRPLKl6WnKZaIPjz0-RXH6RWkpRrm4h55RYTueNMnQAro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmnxsQrchRLWZgI7sS6IvyTACum36u0C2xx1ooBWy4iA&oe=6A6890EC"}, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "You're a tiny bear.\n\nThis is a fairy tale.\n\nAll is chaos.\n\nExplore magical worlds packed with weird creatures, giant bosses, hidden treasures, and way too many things you probably shouldn't eat.\n\n# \ud83c\udf57 EAT THE LOOT\nEvery magical Tink you find is food. Beat monsters, raid bosses, and stuff your belly with as much loot as you can carry.\n\n# \ud83d\udebd FULL? FIND A TOILET!\nExtraction works a little differently around here. Sprint to an extraction toilet, flush yourself to safety, and cash out your haul before someone else takes it.\n\n# \ud83e\udd1d SQUAD UP... OR SELL OUT \nPlay with friends or jump into a raid with other players. Share the loot, help each other survive... or decide that legendary treasure is worth losing a few friendships.\n\n# \u2728 EVERY RUN IS DIFFERENT\nFind crazy weapons, magical relics, funny cosmetics, powerful upgrades, and unexpected surprises hiding around every corner.\n\nOnly the smartest (or hungriest) bears make it home.\n\n**Eat. Loot. Flush. Repeat.**\n\n**https://discord.gg/fabulavr**\n", "short_description": "You're a tiny bear with a huge appetite and zero self-control. Eat magical Tinks, raid giant bosses, grab legendary loot, then race to an extraction toilet before another player steals your snack. Team up, betray your friends, and become the most famous bear in the fairy tale.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968
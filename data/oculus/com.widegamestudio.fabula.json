c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW-6hoMK3HNkQm_mcGiy_1EX_KmwVdWb8c_aplnhywjg&oe=6A69F01F"}, {"file_name": "Screenshot2026-06-18-17-38-49-2.png", "id": "2049674408980676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_2049674412314009_5796090158364440725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2ruxeF_hdcQ7kNvwFbqeBr&_nc_oc=AdpgfFYUy99at1c2Uq-gtbey3zwjgq9VdLMKyQw5A7MY3PyjAvJmRCkVil4usr6PHIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPZh8CSgnC3pHOFhzn1jUH3yh95DDjE03oc018c2INMA&oe=6A6A0EEA"}, {"file_name": "Screenshot2026-06-18-12-57-50.png", "id": "2204903010255527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_2204903016922193_5057111604070029824_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJoDR_M0a6EQ7kNvwH4pTiX&_nc_oc=Adq7IVvFvMdt9TQ_YDfh3r991ZNRQw8G_LJpx4DXgT4Cezy59cTOOrVaKI2V091GVM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDplqgPvH2URfTw7fLXidsXBzdPAu13aYq-kRfzx1qLZg&oe=6A6A1655"}, {"file_name": "ss5.png", "id": "1284321793898582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311582_1284321797231915_7423688044320443547_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31qM5QATRTcQ7kNvwHg6EPc&_nc_oc=AdqhNjVJl9G4-Ju3z__rGKthaLEhh7nmDtTnxZab0TU6xXV99LTaKwj4tGGa7ar63-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY8dGxi6-Sc0z1u16OSRZZ-r8Ru2MJMjGuNdG9YDD0_A&oe=6A69E54D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscapeDark.png", "id": "1556191603184749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654886437_1556191606518082_4111882578767064083_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utKzn84ZFr0Q7kNvwFa3sVS&_nc_oc=AdoRj53HNhq0KHF9qy2r6QRh8alaJPHQJ7vw8AP-4ZxdynCt-1VfvZ0DCgOArT8C_7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyjg8nA9qkvuGaPrdMhIfVrVb_ks6sQuIoeq-vllDcCw&oe=6A69E26C"}, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "You're a tiny bear.\n\nThis is a fairy tale.\n\nAll is chaos.\n\nExplore magical worlds packed with weird creatures, giant bosses, hidden treasures, and way too many things you probably shouldn't eat.\n\n# \ud83c\udf57 EAT THE LOOT\nEvery magical Tink you find is food. Beat monsters, raid bosses, and stuff your belly with as much loot as you can carry.\n\n# \ud83d\udebd FULL? FIND A TOILET!\nExtraction works a little differently around here. Sprint to an extraction toilet, flush yourself to safety, and cash out your haul before someone else takes it.\n\n# \ud83e\udd1d SQUAD UP... OR SELL OUT \nPlay with friends or jump into a raid with other players. Share the loot, help each other survive... or decide that legendary treasure is worth losing a few friendships.\n\n# \u2728 EVERY RUN IS DIFFERENT\nFind crazy weapons, magical relics, funny cosmetics, powerful upgrades, and unexpected surprises hiding around every corner.\n\nOnly the smartest (or hungriest) bears make it home.\n\n**Eat. Loot. Flush. Repeat.**\n\n**https://discord.gg/fabulavr**\n", "short_description": "You're a tiny bear with a huge appetite and zero self-control. Eat magical Tinks, raid giant bosses, grab legendary loot, then race to an extraction toilet before another player steals your snack. Team up, betray your friends, and become the most famous bear in the fairy tale.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "45978150496848
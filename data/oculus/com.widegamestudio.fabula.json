-1.oculuscdn.com/v/t64.5771-25/499311582_1284321797231915_7423688044320443547_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0ZcdEffwCYQ7kNvwENYPP6&_nc_oc=AdqXJHHRPL2-3n7xAxJuFOafW5l77apTc6rQnxW4yRox6ANi3T1ND-dniIxRl6OBRik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkOXDTr3XcRI1CTGgwLVZUOX5xIcXYGQuSDWVAR9djbg&oe=6A6DD9CD"}, {"file_name": "ss4.png", "id": "1744426186545565", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622214_1744426193212231_4016676166521901647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9tmEAPLqhQQ7kNvwGYhynH&_nc_oc=AdqsiVMNsTowlX4yb3MV4ziRgIpPQCOH2d9-SGNnCzXJxEFHgIKDi5vrGH3X9mGjip8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ-MaTVJSGuMLNpiX7bcQ98jnsZ75YvvZbqy7R7Gn2Pg&oe=6A6DF813"}, {"file_name": "ss3.2.png", "id": "873282055084573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623601_873282058417906_3519589824809826573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La5asNgTgZYQ7kNvwEB-yZU&_nc_oc=AdqmEe2OeI_bYKkW875CgmtU6BqmoGvkNcZsimsD2FSSpEigR4NhuROA9CyG55DMED8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4o2QnNTiUUiuwjlwgUDVLFDJR9z-5WKcm9OlCsVa_Bw&oe=6A6DDDD7"}, {"file_name": "ss1..png", "id": "2923519001321780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507838217_2923519004655113_4847522626348651623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0_QIGis8g4Q7kNvwFOmvjP&_nc_oc=AdowcvMwCIrJxJrBEJffeeDV4XKGGegQIr5u8oaScIy_GTqkfTs62Vo0JpTuRDmawbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJW_kuZZQFjiggF7IbYDjGSKqM2eSNfZ9y_jNmwRMxEw&oe=6A6DE636"}, {"file_name": "ss6.png", "id": "971246942320610", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620532_971246945653943_7363676018560733823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--JXpb4mV5QQ7kNvwHzwjum&_nc_oc=Adr9vyYX9RUPZhN8EFnZCv8bTg_jJfq21yEODtzUubniHLBxNa6zFOqq_KdV_r8LdvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAgNgMnR0u1CTTNQcRcGKMWUOp7yn1Nm5raDedC7focw&oe=6A6DF0FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "---------------------------------- **LIMITED ACCESS** -----------------------------\n\n**(Opens only on weekends)**\n\nYou're a tiny bearlet. You're inside a fairytale village. You've got 10 minutes to swallow every magical artifact in sight and flush yourself out before another critter steals your haul. This is Fabula. \n\nA **free** VR extraction adventure for Quest 2 & 3 \u2014 mischievous fairy-tale critters, storybook raids, and the funniest inventory system in VR.\n\n# \ud83c\udf5d EAT THE TALE \nYour belly IS your inventory. Swallow loot to carry it. Overeat and you gag. Die and your haul bursts out for everyone to grab. Find an extraction toilet, flush yourself out, and turn every artifact into Fame.\n\n# \ud83c\udfaf HIGH-STAKES RAIDS\n\nBoss-guarded artifacts. Up to 10 players competing for the same loot. Every run escalates.\n\n# \u2694\ufe0f PvPvE COOPETITIVE \n10 players every raid. Co-op with your party. Compete with everyone else. Every artifact is contested. Pure chaos!\n# \u2728 GROW YOUR LEGEND \nExtracted loot becomes Fame. Fame levels your Tale. Unlock new gear, relics, and powers. Hit Tale Level 60, go Legacy, start over stronger.\n\n**Find the toilet. Flush the magic. Become a legend.**\n\n", "short_description": "Be the good wolf in the storybook. The piggy who eats the wolf. The bearlet who robs the Princess. Fabula is a VR extraction adventure where every fairy-tale rule is yours to break \u2014 and every magical artifact is yours to swallow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "we
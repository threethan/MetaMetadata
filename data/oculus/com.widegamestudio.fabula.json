3-1.oculuscdn.com/v/t64.5771-25/499311582_1284321797231915_7423688044320443547_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0ZcdEffwCYQ7kNvwG8TLQX&_nc_oc=AdoWRovCwB8u13anD_FBCp6g8NZLP7vIbIk8nNZwSufmRYNmwSIGM54kr9RPew-oKkE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO-I2SFCYqh4D6t81EZb0n9EKVrIETqOKaq61L9uUUZg&oe=6A6F2B4D"}, {"file_name": "ss4.png", "id": "1744426186545565", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622214_1744426193212231_4016676166521901647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAbwvGMoh4oQ7kNvwHrZQ1T&_nc_oc=AdoFgb1-22BhAYJBGZKauR9WUg53_FrOGNgISDRvseTwLLBpxp2YGK-Dks3R3YVY35E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOoGrqi2jhlj6NAdR6dMX4OGv3xQfQZO66bWBy9vcA5w&oe=6A6F4993"}, {"file_name": "ss3.2.png", "id": "873282055084573", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623601_873282058417906_3519589824809826573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCCEETkPjegQ7kNvwGvrl5a&_nc_oc=AdrSvUzLBGrbnhnlCy9tInhUIYvIBLAGCPsDCYTW6f5ZLca2qHo28qPXU3fRiv_4Fck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxTN_crbBXKqWLpqYgNXj9uvhbCmiYl1nuSDX0A4J7Tg&oe=6A6F2F57"}, {"file_name": "ss1..png", "id": "2923519001321780", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507838217_2923519004655113_4847522626348651623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0_QIGis8g4Q7kNvwEqkWuZ&_nc_oc=AdqOqf56ae828MeiVgd_OsOLnUDKZxdMj-n8S_8139YLM03JH3Q9vaiUOyAXWl9ytR4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBduGBdgpQmGGd3g1LCmlrcwjxBmkFmOQfIVIRzc_wAQg&oe=6A6F37B6"}, {"file_name": "ss6.png", "id": "971246942320610", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620532_971246945653943_7363676018560733823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--JXpb4mV5QQ7kNvwEdk9XJ&_nc_oc=AdoX6Sf0V8kF3zw4L_ZM_Hyoy4dPKw3AlB63Juh9dFEdL-r4w64fZF1Up4GeT6oR3Sc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEJeyW_JzA9SxReZeLZ8juwKjPGzpV7JBbIngN4Q07KA&oe=6A6F427A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "---------------------------------- **LIMITED ACCESS** -----------------------------\n\n**(Opens only on weekends)**\n\nYou're a tiny bearlet. You're inside a fairytale village. You've got 10 minutes to swallow every magical artifact in sight and flush yourself out before another critter steals your haul. This is Fabula. \n\nA **free** VR extraction adventure for Quest 2 & 3 \u2014 mischievous fairy-tale critters, storybook raids, and the funniest inventory system in VR.\n\n# \ud83c\udf5d EAT THE TALE \nYour belly IS your inventory. Swallow loot to carry it. Overeat and you gag. Die and your haul bursts out for everyone to grab. Find an extraction toilet, flush yourself out, and turn every artifact into Fame.\n\n# \ud83c\udfaf HIGH-STAKES RAIDS\n\nBoss-guarded artifacts. Up to 10 players competing for the same loot. Every run escalates.\n\n# \u2694\ufe0f PvPvE COOPETITIVE \n10 players every raid. Co-op with your party. Compete with everyone else. Every artifact is contested. Pure chaos!\n# \u2728 GROW YOUR LEGEND \nExtracted loot becomes Fame. Fame levels your Tale. Unlock new gear, relics, and powers. Hit Tale Level 60, go Legacy, start over stronger.\n\n**Find the toilet. Flush the magic. Become a legend.**\n\n", "short_description": "Be the good wolf in the storybook. The piggy who eats the wolf. The bearlet who robs the Princess. Fabula is a VR extraction adventure where every fairy-tale rule is yours to break \u2014 and every magical artifact is yours to swallow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "w
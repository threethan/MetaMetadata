rSYf5pHmuHznKoCZek9_wCKbumm5FYdK-C4WMx-4b2u8_6BOxkkW_xccgz8RKQIho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg1Aeclo5L15oIpacQelUNHt8dArKI87-5JHAsEe0CsQ&oe=6B07000D"}, {"file_name": "ss4.png", "id": "1744426186545565", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_1744426193212231_4016676166521901647_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_rOR5TR_OEQ7kNvwHgM-7u&_nc_oc=AdrnAi7yacA390fJDzd6C7DEEfVkcI_Y0tpcDfFhwDwvs_dr8MXctam2Q6gfLtbnMXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4-rO8XbsnR-WLjsnijO5_CxCay-QU-MgxFuJpG27CtQ&oe=6B071E53"}, {"file_name": "ss3.2.png", "id": "873282055084573", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623601_873282058417906_3519589824809826573_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCb-OECS6RcQ7kNvwFeQXWJ&_nc_oc=AdqL6TQ16zzW1UaIrpYvc2dW15VQqC7XfCYC2lVyVSUufW_7MdWwhBYqX1c2iRP_SqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuXbY2oHRVC0-o5tcQFHk3stXqg7HnyLa_3GzO-jcvTA&oe=6B070417"}, {"file_name": "ss1..png", "id": "2923519001321780", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507838217_2923519004655113_4847522626348651623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avAGRWxAkS8Q7kNvwFHp9sY&_nc_oc=AdrYjeIH5u42pHm_abj4xxKQWLjt1EjjU4elJl9bYoxLE3mVtmccq_zgDInPtXTmcNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbh2g_r1tVm1A9Qx7vRl2MDtACMRiGdTgS3b-EDo0YRQ&oe=6B070C76"}, {"file_name": "ss6.png", "id": "971246942320610", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620532_971246945653943_7363676018560733823_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P25gy4peTr8Q7kNvwEq-14r&_nc_oc=AdqqHS4oZXYZ6-j5rCZ7vy5UbamtHyMZr2nSjV5wmiKohdIbV_LZvYqG_zqcNCCIaQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMKM9HAMtolkTfR_abWJLyWZe7DtAo9fHDEXHC9tqf7A&oe=6B07173A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "---------------------------------- **LIMITED ACCESS** -----------------------------\n\n**(Opens only on weekends)**\n\nYou're a tiny bearlet. You're inside a fairytale village. You've got 10 minutes to swallow every magical artifact in sight and flush yourself out before another critter steals your haul. This is Fabula. \n\nA **free** VR extraction adventure for Quest 2 & 3 \u2014 mischievous fairy-tale critters, storybook raids, and the funniest inventory system in VR.\n\n# \ud83c\udf5d EAT THE TALE \nYour belly IS your inventory. Swallow loot to carry it. Overeat and you gag. Die and your haul bursts out for everyone to grab. Find an extraction toilet, flush yourself out, and turn every artifact into Fame.\n\n# \ud83c\udfaf HIGH-STAKES RAIDS\n\nBoss-guarded artifacts. Up to 10 players competing for the same loot. Every run escalates.\n\n# \u2694\ufe0f PvPvE COOPETITIVE \n10 players every raid. Co-op with your party. Compete with everyone else. Every artifact is contested. Pure chaos!\n# \u2728 GROW YOUR LEGEND \nExtracted loot becomes Fame. Fame levels your Tale. Unlock new gear, relics, and powers. Hit Tale Level 60, go Legacy, start over stronger.\n\n**Find the toilet. Flush the magic. Become a legend.**\n\n", "short_description": "Be the good wolf in the storybook. The piggy who eats the wolf. The bearlet who robs the Princess. Fabula is a VR extraction adventure where every fairy-tale rule is yours to break \u2014 and every magical artifact is yours to swallow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": n
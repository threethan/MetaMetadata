_ss=7f20f&oh=00_AQArBo00qRZc_fL5tonWcQ0ud-QDHqpABnkd7KY_dtWhig&oe=6A4E409F"}, {"file_name": "Screenshot2026-06-18-17-38-49-2.png", "id": "2049674408980676", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624983_2049674412314009_5796090158364440725_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHGa46oIvjMQ7kNvwFg413f&_nc_oc=AdrQTvLnzwohf2GfDi7RTYhvLYzx0ew7bnojGE40Rlc5phgSKbpf7jWGmrh7o-HLU38&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4N9QqKNAa0otUwwfTeijIBAIcBREIqw9yG-Xkpqi2Ow&oe=6A4E5F6A"}, {"file_name": "Screenshot2026-06-18-12-57-50.png", "id": "2204903010255527", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823949_2204903016922193_5057111604070029824_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSG3vHTtpTUQ7kNvwE_PFtx&_nc_oc=AdqiMR3PXzL_Dufizu8hvd0ReTFFuNeWsKqNVf54_2N_DJCZ1_6NYCqCSnmQ0S2sKXk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwr-kawey-c9E1yaxZoTUKEE1893pzCSMZBJ5emcE0dw&oe=6A4E66D5"}, {"file_name": "ss5.png", "id": "1284321793898582", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499311582_1284321797231915_7423688044320443547_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8serIpzPfo8Q7kNvwFF0R0J&_nc_oc=AdqBLIwuTWdIbq8WSQSPqw5KzloO2558AbOIxW_ATzIvxN0PDu13H_DFxVIrFobHKNo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5Y989ZwHTgDciP_BT-Ptj7K1_M7DrZtere3sKLwObfQ&oe=6A4E6E0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "---------------------------------- **LIMITED ACCESS** ---------------------------\n\n**(Opens only on weekends)**\n\nYou're a tiny bear. This is a fairy tale. Nothing is normal here.\n\nStep into storybook worlds as a mischievous little beast on a mission: swallow every magical tink you can find, outrun your rivals, and flush yourself to glory. This is Fabula!\n\n# \ud83c\udf56 LOOT = FOOD\n\nEvery tink you steal is a snack. Every boss you rob is a meal. Stuff your belly, grow your greed, and whatever you do \u2014 don't stop eating.\n\n# \ud83d\udebd FEELING FULL? LOOK FOR A TOILET!\n\nHunt down the nearest extraction toilet, flush yourself through, and cash out your haul as Fame. Hang around too long and you'll lose it all.\n\n# \u2694\ufe0f FRENEMIES\n\nTeam up, share the spoils, then think twice before you do. Up to 10 players share one world \u2014 and your best friend is one legendary artifact away from becoming your worst enemy.\n\n# \ud83c\udfa1 SPIN THE WHEEL\n\nSpin the wheel and let luck decide! Bonus loot, wild relics, weapons, or an amusing cosmetic. Fortune favors the greedy. Usually.", "short_description": "You're a tiny bear with a big appetite and zero regrets. Fabula is a multiplayer VR extraction adventure. Swallow every magical tink in sight, outrun rival critters, and flush yourself to glory. Team up for boss raids or betray your party for the loot \u2014 in a fairy tale this chaotic, there are no heroes. Eat. Extract. Become legend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
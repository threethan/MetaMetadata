7_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_CwY-LlxIAQ7kNvwG9MNwh&_nc_oc=AdoOehFhEEqffKn_CRFbaN3U-k1pj2FcJuKRz0nBJDLgPUCOXZdQY_Bpg8AmkvLDMm0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzkThoO4nnhHdGp0ak1KK4OP4Z60kyRvSndvJTi7Z5Uw&oe=6A77144D"}, {"file_name": "ss4.png", "id": "1744426186545565", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622214_1744426193212231_4016676166521901647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYndpjKDET0Q7kNvwElkg8C&_nc_oc=AdoPNXDjtTd49O7b5xkO24jcEf3EIjBJS6wGlGAjzcXbATk4C3oYSlGTiE4aonfHZyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOD9pMmUUG1fd1ei4-d1nNw4XqAqleF8PjDofR1I5h7g&oe=6A773293"}, {"file_name": "ss3.2.png", "id": "873282055084573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623601_873282058417906_3519589824809826573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WT2seY5FHiMQ7kNvwHlhTKl&_nc_oc=Adqw6bZjn44BFqpgfO8fa2ugQ7WqBebkDeZD9xlT_PcXfoeZT2TlgVBvMYAl3GW20PY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_jEqZr-mRZsBC_af2iC-zfaHDUb5dyRdhHP0QxM7Jjg&oe=6A771857"}, {"file_name": "ss1..png", "id": "2923519001321780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507838217_2923519004655113_4847522626348651623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoHfkdpZgu8Q7kNvwG4MW5N&_nc_oc=AdqFY7Ctp6j7xxCkz9df-rtAF3UxeHRG1HYgTccHGuv9ZkY57tz2yVEIiKZgCgXLpMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_WrEKnxrQ3wpsX6K8pJsHJsRp8OM7ykdg9ofh9nNNPg&oe=6A7720B6"}, {"file_name": "ss6.png", "id": "971246942320610", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620532_971246945653943_7363676018560733823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sirUwUANIGMQ7kNvwGsA5ME&_nc_oc=AdrAM9obinzoAMFg71lIKQO6gJLWVvBussr2RRdOHCwo9LoTTPRxGGyp3Sn_t3tZPuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKmZRDBw8R4mV5uGKqWywez5dv0f0WLFwQpB18DfqS9w&oe=6A772B7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "---------------------------------- **LIMITED ACCESS** -----------------------------\n\n**(Opens only on weekends)**\n\nYou're a tiny bearlet. You're inside a fairytale village. You've got 10 minutes to swallow every magical artifact in sight and flush yourself out before another critter steals your haul. This is Fabula. \n\nA **free** VR extraction adventure for Quest 2 & 3 \u2014 mischievous fairy-tale critters, storybook raids, and the funniest inventory system in VR.\n\n# \ud83c\udf5d EAT THE TALE \nYour belly IS your inventory. Swallow loot to carry it. Overeat and you gag. Die and your haul bursts out for everyone to grab. Find an extraction toilet, flush yourself out, and turn every artifact into Fame.\n\n# \ud83c\udfaf HIGH-STAKES RAIDS\n\nBoss-guarded artifacts. Up to 10 players competing for the same loot. Every run escalates.\n\n# \u2694\ufe0f PvPvE COOPETITIVE \n10 players every raid. Co-op with your party. Compete with everyone else. Every artifact is contested. Pure chaos!\n# \u2728 GROW YOUR LEGEND \nExtracted loot becomes Fame. Fame levels your Tale. Unlock new gear, relics, and powers. Hit Tale Level 60, go Legacy, start over stronger.\n\n**Find the toilet. Flush the magic. Become a legend.**\n\n", "short_description": "Be the good wolf in the storybook. The piggy who eats the wolf. The bearlet who robs the Princess. Fabula is a VR extraction adventure where every fairy-tale rule is yours to break \u2014 and every magical artifact is yours to swallow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating
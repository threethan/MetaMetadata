d3-2.oculuscdn.com/v/t64.5771-25/499311582_1284321797231915_7423688044320443547_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0ZcdEffwCYQ7kNvwH4B1t2&_nc_oc=Adr3ptDKAHoDb8hOwZQlH4cTUstV_tpTuI_jkt0OCo9VXGmdhe3seRpwRIR-KXUDtjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBzHpt3VR1QyWcxP9dGDISX5AuTYerENQ0DNDpu195CQ&oe=6A707CCD"}, {"file_name": "ss4.png", "id": "1744426186545565", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_1744426193212231_4016676166521901647_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAbwvGMoh4oQ7kNvwH-nLLl&_nc_oc=AdroF9XXuBfgfu0lvboFj6y0apBvNq53rw5D4dzRM3kOzwNCgbSeYRQN4uPChDGmSdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdq4CSSl2OSZDzLqEsdIUqEkttYjFczHXgCUc9U_bxog&oe=6A709B13"}, {"file_name": "ss3.2.png", "id": "873282055084573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623601_873282058417906_3519589824809826573_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCCEETkPjegQ7kNvwFxDvxW&_nc_oc=AdrgHqicbpCribag07xgKCichfEFi2KkrNiWayWoU8qIWOKXiUyeNn9QdnVpW1SlPJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJZIprS05jUAnQj7e9U_bvpuC6uYZ6-3-gWoOTINlI3A&oe=6A7080D7"}, {"file_name": "ss1..png", "id": "2923519001321780", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507838217_2923519004655113_4847522626348651623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3wXgfiv8h0Q7kNvwHgcbW2&_nc_oc=Adr0Lnoejj-gedRo3vP8BDpkXvXBaVxmkmpPgQsYCURdbc7qh5ffWFXdwXL_jLsSbxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsZ4B62050afnQTYMvivCTpXqpO6ADOrfadInXSndy6g&oe=6A708936"}, {"file_name": "ss6.png", "id": "971246942320610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620532_971246945653943_7363676018560733823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--JXpb4mV5QQ7kNvwGOXf4u&_nc_oc=AdqIXu68Q7QCSt0hr6NTmjxKJQIR_g29NhFrBgLq0Ld5f4NkYTO77hRO_nemXiIRywo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1ANbVBPDm0N5v_-zYvUOJpj-YjMXtaa68qKDBPyBksw&oe=6A7093FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fabula", "keywords": ["adventure", "action", "magic", "fairytale", "extraction"], "long_description": "---------------------------------- **LIMITED ACCESS** -----------------------------\n\n**(Opens only on weekends)**\n\nYou're a tiny bearlet. You're inside a fairytale village. You've got 10 minutes to swallow every magical artifact in sight and flush yourself out before another critter steals your haul. This is Fabula. \n\nA **free** VR extraction adventure for Quest 2 & 3 \u2014 mischievous fairy-tale critters, storybook raids, and the funniest inventory system in VR.\n\n# \ud83c\udf5d EAT THE TALE \nYour belly IS your inventory. Swallow loot to carry it. Overeat and you gag. Die and your haul bursts out for everyone to grab. Find an extraction toilet, flush yourself out, and turn every artifact into Fame.\n\n# \ud83c\udfaf HIGH-STAKES RAIDS\n\nBoss-guarded artifacts. Up to 10 players competing for the same loot. Every run escalates.\n\n# \u2694\ufe0f PvPvE COOPETITIVE \n10 players every raid. Co-op with your party. Compete with everyone else. Every artifact is contested. Pure chaos!\n# \u2728 GROW YOUR LEGEND \nExtracted loot becomes Fame. Fame levels your Tale. Unlock new gear, relics, and powers. Hit Tale Level 60, go Legacy, start over stronger.\n\n**Find the toilet. Flush the magic. Become a legend.**\n\n", "short_description": "Be the good wolf in the storybook. The piggy who eats the wolf. The bearlet who robs the Princess. Fabula is a VR extraction adventure where every fairy-tale rule is yours to break \u2014 and every magical artifact is yours to swallow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fabula-privacy-policy/fabula", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "
B3HCedbG3UM0l01lwTCC62Y5hadNg5NZ8TcqA&oe=6A22E6F5"}, {"file_name": "migrated_image.png", "id": "641683849924704", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12448837_1475192455853935_2225824023277731840_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UsWnXi5LfYQ7kNvwGfZiMd&_nc_oc=AdqQoZSBcJWTQiPSfieZHQv6aqqmao0cS10ypZSJ4_4-g4pqR4IwJNu-PRW4ZTVlCsw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pTk-id6FjivkQcRwlZxw_UF19kNYQf2KkVJMQFL3lDA&oe=6A22E668"}, {"file_name": "migrated_image.png", "id": "895817480856393", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162823_194525884368558_6576043217387520000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B75bJOV240Q7kNvwEXE863&_nc_oc=Adol_hnEYmDu_HKu3AMh5K2RgG94KEAiINtlmJRGt98juDp1PFLovb-y6rRbwxqDqZ0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cRgH4qWoB21wxLxJ6menQTyIYx8tyQX-D7j2S12GYHw&oe=6A22E895"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Thumbnail.png", "id": "151586515363912", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12504696_151586522030578_3859920601070174208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVHYLPbpdA4Q7kNvwFE6wjf&_nc_oc=Ado6lGPW5NzGeWQ_YM4A6mrW95CUddXmECxseUGIe231hbrLSN2awjyIFofjza95efg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a9xekWVDrXVoCQVEAWysZvgmiOUqXKzTQ1NxH6CYewQ&oe=6A22FF8D"}, "display_name": "Ping Pong", "keywords": ["Ping", "Pong", "Sport", "\u0421ompetition", "Multiplayer"], "long_description": "An awesome Ping Pong game for mobile has arrived! Pick up your racket and challenge your friends. Play Ping Pong on any device you have: a smartphone, TV, mobile VR. Any kind of multiplayer is possible, it feels like playing a real table tennis game. Add your avatar and customize the racket to achieve the individual look so that every opponent would know who he\u2019s dealing with!\n\nYou can play this game using VicoVR Full Body Motion Controller if you want fully immersive experience. You can also play it on your smartphone or like any other cardboard game in any virtual reality headset you like. \n\nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Play Ping Pong with VicoVR sensor!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "SPORTS", "SIMULATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "515432619911801"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2485108374841653", "version": "1.4.17"}, "id": "1643317315977528", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1459163684102799", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2485108374841653"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1643317315977528"}]}, "change_log": "Improved physics\nImproved Hero mode", "created_date": 1560168861, "id": "2485108374841653", "version": "1.4.17", "version_code": 1491372, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1459163684102799", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2485108374841653"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1643317315977528"}]}, "change_log": "Updated multiplayer menu", "created_date": 1555670557, "id": "2396685933683898", "version": "1.4.16", "version_code": 1491370, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1459163684102799", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2485108374841653"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1643317315977528"}]}, "change_log": "Having heard your feedback, in this update we have radically redesigned the management. \nMode \"FULL MOVEMENT\" is suitable for fans of RacketFury, this mode provides full control over the racket, but can cause dizziness.\nThe \"DYNAMIC RACKET\" mode is very intuitive and simple, but does not cause dizziness. This mode allows you to feel like a real tennis player.\n\nIn the next updates we will continue to improve the management of the racket, add spins and improve the opponent.", "created_date": 1550578020, "id": "2308963822456110", "version": "1.4.16", "version_code": 1491350, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1459163684102799", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2485108374841653"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1550214325, "id": "2301851883167304", "version": "1.4.16", "version_code": 1491348, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1459163684102799", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2485108374841653"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1643317315977528"}]}, "change_log": "In this update, we have improved the physics of the ball, added sets with the system of rules of table tennis, including the first serve on his half of the table. \nWe also fixed a problem with the network code and control of the racket. \n\nIn the next updates we will continue to improve the physics in the game so that you can get the best experience from playing table tennis.", "created_date": 1548157065, "id": "2265519143467245", "version": "1.4.15", "version_code": 1491345, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
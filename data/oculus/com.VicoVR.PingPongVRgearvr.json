50", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602128_1926730980879584_210559629225099264_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh6Gq47nIowQ7kNvwE1hbDY&_nc_oc=AdkWmuIxWu9E7L0RNtMrYaSg1uAIDm0s-wynAv58Fa7ukLSEGlkwecqdrYoXCRWV4ks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvR8p0j51ZixHfDUtZGzpri1eE11XGydFYlb9EKnH7_QA&oe=69A569AB"}, {"file_name": "migrated_image.png", "id": "684701519032458", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12522276_274195606337520_1030146020454957056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTfl9aMqmBIQ7kNvwHHfgBp&_nc_oc=AdlXigIC8e2XOwXpmPhF82dZFXjlKIaqniHsj9i7MTnF5DRPWfIznhrDGM_svKjllts&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfudF4xT8zB2azvtHh4MXlPJ9aIbalqJV73u1-IEQ_b-bg&oe=69A57035"}, {"file_name": "migrated_image.png", "id": "959520817778688", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12448837_1475192455853935_2225824023277731840_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU-Ekg0sRpcQ7kNvwG468R3&_nc_oc=AdmwVtgLAIZ_j2wrMwWOrleLGmwuN6NioOuMnrDi5iLR9v93R_CqKBwy_SC7vQaXivk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftozosnt66KgbS2E2Z8oJbeKwuNpV2f2daE1giV095QSQ&oe=69A56FA8"}, {"file_name": "migrated_image.png", "id": "501361227225918", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162823_194525884368558_6576043217387520000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAnNGc8cXyoQ7kNvwEerDO-&_nc_oc=Adl5OTJytjKR1N1TzHtauvY-kIKq-H-tioO4ZNd3wO49489NAy8_1_Bh9WnDXw9cdQw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftVnbnMc_RRtZhFcGEOSG-OkCKUO3FUpwjULUMcZ7ofIQ&oe=69A571D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Thumbnail.png", "id": "215967282499857", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138999_215967285833190_2096672904988065792_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDJIEez3_7oQ7kNvwFl-_wv&_nc_oc=Adl55QeiNIAGtbtdsfnJY112hbXopCinrAmEADTneUUYVcgldRJ5dp_tbsvEUf2zETQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvZDxalDDVOIJO-YoD6V-niDndqPUqEi0dfN5agP0-yPw&oe=69A5776B"}, "display_name": "Ping Pong", "keywords": ["Ping", "Pong", "Sport", "\u0421ompetition", "Multiplayer"], "long_description": "An awesome Ping Pong game for mobile has arrived! Pick up your racket and challenge your friends. Play Ping Pong on any device you have: a smartphone, TV, mobile VR. Any kind of multiplayer is possible, it feels like playing a real table tennis game. Add your avatar and customize the racket to achieve the individual look so that every opponent would know who he\u2019s dealing with!\n\nYou can play this game using VicoVR Full Body Motion Controller if you want fully immersive experience. You can also play it on your smartphone or like any other cardboard game in any virtual reality headset you like. \n\nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Play Ping Pong with VicoVR sensor!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YCFj21EwKV2JvF2dLFYzRrzYrE619BY5/edit?usp=sharing&ouid=112505687344397944982&rtpof=true&sd=true", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER",
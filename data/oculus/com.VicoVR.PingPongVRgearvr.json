&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3zzPjK-6foQ7kNvwGJGg0n&_nc_oc=AdmD4KraA-GBnmp3ZhIlD1Qt7jeGGAXhtk1BwLagLfGNuQW2EHKCRHuSt0Zr80kHd0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwT-pBX2P9eouD8nw7Flh5atcnIZ7guyVA_4g857TAWBQ&oe=69B7EC6B"}, "display_name": "Ping Pong", "keywords": ["Ping", "Pong", "Sport", "\u0421ompetition", "Multiplayer"], "long_description": "An awesome Ping Pong game for mobile has arrived! Pick up your racket and challenge your friends. Play Ping Pong on any device you have: a smartphone, TV, mobile VR. Any kind of multiplayer is possible, it feels like playing a real table tennis game. Add your avatar and customize the racket to achieve the individual look so that every opponent would know who he\u2019s dealing with!\n\nYou can play this game using VicoVR Full Body Motion Controller if you want fully immersive experience. You can also play it on your smartphone or like any other cardboard game in any virtual reality headset you like. \n\nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "Play Ping Pong with VicoVR sensor!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YCFj21EwKV2JvF2dLFYzRrzYrE619BY5/edit?usp=sharing&ouid=112505687344397944982&rtpof=true&sd=true", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR
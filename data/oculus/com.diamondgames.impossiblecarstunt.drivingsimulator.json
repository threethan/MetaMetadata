oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ09HdHTdXhiRbgbSov2XsA9RQEiH76t8cnAsB4ubXUA&oe=6AA0140F"}, {"file_name": "4.png", "id": "1622388806069418", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507823854_1622388809402751_8476127461081207109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf40EJNcNmsQ7kNvwEflphF&_nc_oc=AdpBWikYbeQovvVXRYDEMKdk6leblKv45aR300dzIDQmdJLHn1bAmBVrpTrwAlOLW-A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwjfTq_uPyBYH6csOfeW-do0IDc3pinlCqiowwuPt0Ig&oe=6AA010AE"}, {"file_name": "5.png", "id": "2307015473440439", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507823984_2307015476773772_2893557543348885830_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBehT9uxCk8Q7kNvwGSxI8N&_nc_oc=AdrZMTj2gPxuo9GkCsolU_4MQLJJzY8Q_Pl95aKXhN0F8iCxGiQvDd97Jf21AP7YV0k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBdEqOm1m98v22otCpij8J52vzr74xBzrGrB9vvICtjA&oe=6AA02FB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Impossible Car Stunt: Driving Simulator", "keywords": ["carstunt", "drivingsimulator", "stuntdriving", "magaramp", "impossibletracks"], "long_description": "Impossible Car Stunt: Driving Simulator puts you behind the wheel for the ultimate VR stunt driving adventure. Race across impossible sky-high tracks, conquer massive mega ramps, and perform spectacular stunts while testing your driving skills on challenging obstacle courses.\n\nEvery level is designed to push your precision, timing, and control to the limit. Accelerate across giant ramps, soar through the air, avoid deadly obstacles, and land perfectly to complete increasingly difficult stunt challenges. Whether you're chasing the fastest time or simply enjoying incredible jumps, every track offers an exciting new experience.\n\nExperience responsive vehicle controls and realistic driving physics that make every jump, drift, and landing feel satisfying. Unlock new challenges as you progress through a variety of impossible tracks featuring loops, narrow roads, steep ramps, moving obstacles, and breathtaking heights.\n\nFeatures\n\ud83d\ude97 Drive powerful stunt cars.\n\ud83c\udf09 Conquer impossible sky-high tracks.\n\ud83d\udee3\ufe0f Race across massive mega ramps.\n\ud83c\udfaf Complete challenging stunt missions.\n\u26a1 Realistic driving physics and responsive controls.\n\ud83c\udfc6 Test your precision driving skills.\n\nCan you master every impossible track and become the ultimate stunt driver? Jump into Impossible Car Stunt: Driving Simulator and prove your skills on the world's most extreme stunt courses.", "short_description": "Take on impossible mega ramps, perform daring stunts, and master precision driving in Impossible Car Stunt: Driving Simulator. Test your skills across challenging tracks with realistic vehicle physics and thrilling obstacle courses built for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/diamondgamesstudio/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "DiamondGamesStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/diamondgamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1209994488874789"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.c
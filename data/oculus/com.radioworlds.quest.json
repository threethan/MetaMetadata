CrxBoEtENhWN8PbgGmQx6EA8OFwX8ouQ&oe=6AF5F01A"}, {"file_name": "05-More-Argentina-Stations.png", "id": "1876799497004457", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_1876799500337790_2883179922672749508_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaNdHKNjkLcQ7kNvwECmR6L&_nc_oc=AdqU_xo0kxhy_eQRRRYyRLi0RQns77I-aJxbPBh5JIXZ-9v2JzZnefkti6x506REhjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVR3DZIpieSmP3brgx5xmKB8w7oxMUxZMfro4eHxNKxw&oe=6AF5F4E7"}, {"file_name": "04-Station-Search.png", "id": "1276055284695468", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1276055288028801_4054084834684447888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whZCKl3Y5wIQ7kNvwHFW9HT&_nc_oc=AdoFeFwatgTiIhW2K2vm9yi0SQm2KHZ9bNYJvkJw-5F0HSWnuy_M8miy_f_or4afSCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8_yGkUe2_OE8pzh0TVLSPFQ0tUznl2VUfDik-Rdh8UA&oe=6AF5F194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Radio World", "keywords": [], "long_description": "Tune in to the world with Radio Worlds.\n\nDiscover radio stations from different countries in your own immersive listening lounge. Explore music, news, talk, and broadcasts from around the globe\u2014all from your Meta Quest.\n\nFIND YOUR NEXT FAVORITE\nBrowse stations by country, discover something new, and save your favorites for easy listening.\n\nSET THE MOOD\nChoose from Nightwave, Aurora, and Golden Hour environments. Enjoy audio-reactive visuals or turn on calm visuals for a more relaxed experience.\n\nKEEP LISTENING\nSwitch to the compact player and keep your station playing while you use other apps. Return to the immersive lounge whenever you like.\n\nWhether you\u2019re reconnecting with broadcasts from home or exploring sounds from somewhere new, Radio Worlds brings the world closer\u2014one station at a time.\n\nAn internet connection is required for live radio. Station availability and programming depend on the broadcaster. Some streams may include broadcaster-provided advertisements.", "short_description": "Explore radio stations worldwide in a relaxing VR lounge with immersive, audio-reactive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://radioworld.totalviewmedia360.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Totalview Media", "support_website_url": null, "website_url": "https://radioworld.totalviewmedia360.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "361620458439488"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1348800998321933"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1151199174245336"}]}, "baseline_offer": {"id": "1151199174245336"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793283300, "status": "PUBLISHED", "id": "1151199174245336"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1351617778040255", "version": "0.2.5"}, "id": "2114829139137785", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1348800978321935", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
/t64.5771-25/908835888_1445169183850348_4029546530945602455_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RYqAQsYkdcQ7kNvwENLXo-&_nc_oc=AdqFwCt2kOyOAGKrjqBsCd2f04CDDiIY9BJ4tRDOiwBY5-zmJxZlPBSJddbcc8MydrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxrUyoOytoJckVPyzeWS2OequNqoa2fKau2Vi5uCrjkQ&oe=6B1063DA"}, {"file_name": "55.png", "id": "1435445688234682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835876_1435445691568015_7896397147528708308_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BI-ZdAxtv0Q7kNvwGcXG3s&_nc_oc=AdrpOU2gLLZTe-SnJS2gRnb5kIjBFXYCXGKpcRqM8QRjlGdOasG8NrWOgryvHFCMt7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXIJ6U-WA0kGsjxw3FL0VPaHSD4K7ufa3Xx96GoTLNzg&oe=6B1064A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Safari : Wild Adventure", "keywords": ["SafariDriving", "JungleSafari", "SafariCar", "OffroadDriving", "WildAnimals"], "long_description": "Jungle Safari: Wild Adventure\n\nGet ready to explore the wild side of nature in Jungle Safari: Wild Adventure!\n\nJump behind the wheel and experience an exciting jungle safari driving adventure. Explore beautiful wilderness environments, drive powerful safari vehicles and discover the thrill of off-road exploration in an immersive VR world.\n\nNavigate through challenging jungle paths, explore the surroundings and experience the excitement of a wild safari adventure. Every journey brings new places to discover and new driving challenges to overcome.\nGAME FEATURES\n\n    Jungle Safari Adventure: Explore exciting wilderness environments.\n\n    Safari Vehicle Driving: Take control of powerful safari vehicles.\n\n    Off-Road Exploration: Navigate through challenging jungle paths and rough terrain.\n\n    Wildlife Environment: Experience the atmosphere of a natural safari world.\n\n    Immersive VR Experience: Explore the adventure from a first-person VR perspective.\n\n    Exciting Driving Challenges: Test your driving skills across different environments.\n\nEXPLORE THE WILD!\n\nGet behind the wheel, discover the jungle and experience an unforgettable safari adventure.\n\nExplore. Drive. Discover the Wild!", "short_description": "Explore the wild jungle, drive powerful safari vehicles and experience thrilling off-road adventures in an immersive VR safari world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://actionsimulationsgames.blogspot.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Games", "support_website_url": null, "website_url": "https://actionsimulationsgames.blogspot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1378892421984895"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619374_1115494234430422_2825634446682695634_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asPLMuGFk04Q7kNvwEmRzgV&_nc_oc=AdpDCJuV-e8S-PboRkq_a7YYnfxFpuDtcuO-uqyb5MbywOnzHnB746HWl0IHQ4Qa9Y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW93e8257FCYtxjoXif7m_yluPyZ9NVQYP5S-uiwu-Kbw&oe=6B104918"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "J
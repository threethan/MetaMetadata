31127_6990334998751484031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBAKyRk15FUQ7kNvwHZLGG0&_nc_oc=Adr-fxn6bDOWb0JsQaRC02igw-LhlyeXy8Ooy2XZWWmTzQP-V0sEYQ0e13gckmD3c8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5YS4HdDKhE7AQBl5-cjBDSs6CtQmnYkPOFDtkl7NMFg&oe=6A7745FE"}, {"file_name": "screenshot 3.png", "id": "620525676521081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974818_620525679854414_133201505342904352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQzwjXQJRmQQ7kNvwG2wpEA&_nc_oc=AdrtCRtF8f4TthSt8TsNBA3KYdUePLawUhggyiEbHGWcrYBqdDEiwY3Pz_2Tn9K7HI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4CK8_0UUnuTN6iCsMVn5u8ASo7AZBzMhRqivNeSlA6A&oe=6A771634"}, {"file_name": "screenshot 4.png", "id": "1523493328118681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86625134_1523493331452014_8446483183196446663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1-YX_oDbZQQ7kNvwG4UNFY&_nc_oc=AdpGw43QdVwuXjLA5OvIQ3J433VcWhj0aK4rlKtGCi8-9yQex1Ene61rTlNEXTQfNZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw2HW9jhqh6LVc9V4ihR7Du1wCflgjuk1dTDnBQoXHrg&oe=6A772B8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wah video cover.png", "id": "819237009166014", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_819237012499347_1147210738431341811_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlXm_YvhEd8Q7kNvwHNjpE8&_nc_oc=AdrJu89PeAXhRcMC5J61WYb8v8tdMP4UgTAMligFnaffoiNov-OgZJOtWtilSUWnm0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuVHB7dv9q1vBC1CJJQ2CUHCoRETHlo9HIgpL7cA0KgQ&oe=6A772E69"}, "display_name": "Work at Height", "keywords": [], "long_description": "Provide safe, efficient, and accessible work at height training anywhere. The Work at Height -Scissor Lift training application provides a simulation of real world training with all the advantages VR has to offer. Learn how to ensure a safe work space, choose and inspect the proper equipment, and take in important information in a safe, easy, and practical way. Experience the real world scenario anytime, anywhere. The guidance is so easy no VR experience is necessary, just pick up a controller and get started with a few clicks. If you make a mistake, you can review your results and try again. Our guidance system will ensure no two attempts are quite the same! Try the demo today or visit www.vobling.com and subscribe to the license for full access to all this and more to come.", "short_description": "The Work at Height - Scissor Lift training application provides training and guidance through everything you need to learn to safely complete work at height, according to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vobling.com/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": null, "website_url": "http://www.vobling.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25130301113265302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036646_1360383064708914_5851238720542066782_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcbyuU81r0wQ7kNvwEMH30r&_nc_oc=AdoH-_LgpbFUFmhO4gjxc7faR6Oven3dKZYjzPX
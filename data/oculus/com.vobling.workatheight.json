7431127_6990334998751484031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5-45uiQEWUQ7kNvwGtCtON&_nc_oc=AdrpyOsnr64T4mb-HeOzBxJUI_3R2kjcNpGN8tzC5AKDhBOHOHMwI2MadDMeIthyJ9c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x2fJ1Y5REZxV71pG2751g3xNygzfS_U7rakbqqir_tg&oe=6A467E7E"}, {"file_name": "screenshot 3.png", "id": "620525676521081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974818_620525679854414_133201505342904352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW4QgQc2h_4Q7kNvwHVSB6p&_nc_oc=AdpqgnCpypF-x5INdHE6_9oLKVA3LqQ68QYSWZOMHjOorPAIfYESE-XTAvhIsR4kCq4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tyNAex1w-SEmax2YcbiOL7GSDXEqwJ-K3SgzKxxDSQg&oe=6A4686F4"}, {"file_name": "screenshot 4.png", "id": "1523493328118681", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86625134_1523493331452014_8446483183196446663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-otX75LlfwQ7kNvwFUk6I2&_nc_oc=Adr5vu0uEJXf4mdH8Ly5IqYDBs_8orBb1fqtT1bDAAXmne_wb1JPWr1tOpIWEDEVTtE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JeKKc8u_tL5zEA3sxDFwi9gCrHPMZim6TU7NgmxLVXA&oe=6A46640B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wah video cover.png", "id": "819237009166014", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974538_819237012499347_1147210738431341811_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtu8w6x-I-8Q7kNvwHtIthN&_nc_oc=AdogiznBhk4_3FfI27b1NVnyv2LsQtdZ7dbXD9ftyeqkaxL7pXlcOn47ES4r33RRl3Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xo2hGpebX6dxsKgQXQjA6h3UrX3C7wx0Bj3gJS-mqgA&oe=6A4666E9"}, "display_name": "Work at Height", "keywords": [], "long_description": "Provide safe, efficient, and accessible work at height training anywhere. The Work at Height -Scissor Lift training application provides a simulation of real world training with all the advantages VR has to offer. Learn how to ensure a safe work space, choose and inspect the proper equipment, and take in important information in a safe, easy, and practical way. Experience the real world scenario anytime, anywhere. The guidance is so easy no VR experience is necessary, just pick up a controller and get started with a few clicks. If you make a mistake, you can review your results and try again. Our guidance system will ensure no two attempts are quite the same! Try the demo today or visit www.vobling.com and subscribe to the license for full access to all this and more to come.", "short_description": "The Work at Height - Scissor Lift training application provides training and guidance through everything you need to learn to safely complete work at height, according to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vobling.com/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": null, "website_url": "http://www.vobling.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25130301113265302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036646_1360383064708914_5851238720542066782_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiN4i0PNkAQQ7kNvwEc47Zn&_nc_oc=AdpnjXp0coUVVDiD-UWRla0W9_0--eu9-
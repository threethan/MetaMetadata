31127_6990334998751484031_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X60IjDHwl9AQ7kNvwFc9g7N&_nc_oc=Adp8wjT-1PoYklLMKaAw3xyEvGZXT-iAmCmba6LE3Rbr-qj3eRDou-6UjOp0PBIIFUk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWiJzlBqY0k__HNTsIee3_thD2DuoxPZ5mepBar4PuDA&oe=6ADCC97E"}, {"file_name": "screenshot 3.png", "id": "620525676521081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974818_620525679854414_133201505342904352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqUrP0AwpsAQ7kNvwG57FHp&_nc_oc=AdqJfOXapSXkXqCOHllTV6yIIpCv4IfXa0hdcDlFACOqUsY3KzBwg7ilg3zIT_3VMvM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXUDiJnAxvDaj8Jxo_fA_s4l8nsC7uLDv83drI2AOgXA&oe=6ADCD1F4"}, {"file_name": "screenshot 4.png", "id": "1523493328118681", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86625134_1523493331452014_8446483183196446663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqKAN2VFJeEQ7kNvwFgaF0x&_nc_oc=AdpL6QAFGnB0zNmkD3rO0HbTrz7QzA56jL0DiOMScgALNGY8sXFXxrIr68kQJRCJa_U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6MisS7xRKfbdpVY4vfS96kOul64Vm4861q6XoKVrOqg&oe=6ADCAF0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wah video cover.png", "id": "819237009166014", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974538_819237012499347_1147210738431341811_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPm1q9mMgQoQ7kNvwFuY3T2&_nc_oc=Adr55fQgMf4Z9FRJK4Q6wYMTwr51tblkHjBP8De0BmKjelh5pWSx2ig_1g79PPwudD0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6szvx4Kf2mTzVBEWtjhEc2jcA7chGHVW0ZWIlBJO1fA&oe=6ADCB1E9"}, "display_name": "Work at Height", "keywords": [], "long_description": "Provide safe, efficient, and accessible work at height training anywhere. The Work at Height -Scissor Lift training application provides a simulation of real world training with all the advantages VR has to offer. Learn how to ensure a safe work space, choose and inspect the proper equipment, and take in important information in a safe, easy, and practical way. Experience the real world scenario anytime, anywhere. The guidance is so easy no VR experience is necessary, just pick up a controller and get started with a few clicks. If you make a mistake, you can review your results and try again. Our guidance system will ensure no two attempts are quite the same! Try the demo today or visit www.vobling.com and subscribe to the license for full access to all this and more to come.", "short_description": "The Work at Height - Scissor Lift training application provides training and guidance through everything you need to learn to safely complete work at height, according to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vobling.com/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": null, "website_url": "http://www.vobling.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25130301113265302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036646_1360383064708914_5851238720542066782_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTPynJL-ILwQ7kNvwGN19Kz&_nc_oc=AdpKkvoQZrvb5omN2EKMASSV1xORdwPAmDNxJj-
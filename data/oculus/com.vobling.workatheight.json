.com&_nc_ss=7f20f&oh=00_AQGX9Vs8y58jT5V41gKVYBDJon4Re3bSKbHgdP4ax126OA&oe=6A7EFF34"}, {"file_name": "screenshot 4.png", "id": "1523493328118681", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625134_1523493331452014_8446483183196446663_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED8o374TBr0Q7kNvwF9M50q&_nc_oc=AdqVxfy38CBTx_xxg2174QoOvdbQ2CNRz7wdJ7imCPodfk5zwq21HnOQUVRISBBjw34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsiBbQ5YLkIBHLVJBhyuakbSu6B7AWA6Ox3Re8DsRByw&oe=6A7F148B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wah video cover.png", "id": "819237009166014", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974538_819237012499347_1147210738431341811_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WAnPRzVL9MQ7kNvwEJE-rE&_nc_oc=Adqx0BaTxRU1AZmcTgCemixD8t7cVTphYKIGAR7AUygGGbumRBmH_Bc7TG8FKDVL1ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxGui6VUcoy41eQikqyB-eVmf_XVNDw4wS5fhAff3nbw&oe=6A7F1769"}, "display_name": "Work at Height", "keywords": [], "long_description": "Provide safe, efficient, and accessible work at height training anywhere. The Work at Height -Scissor Lift training application provides a simulation of real world training with all the advantages VR has to offer. Learn how to ensure a safe work space, choose and inspect the proper equipment, and take in important information in a safe, easy, and practical way. Experience the real world scenario anytime, anywhere. The guidance is so easy no VR experience is necessary, just pick up a controller and get started with a few clicks. If you make a mistake, you can review your results and try again. Our guidance system will ensure no two attempts are quite the same! Try the demo today or visit www.vobling.com and subscribe to the license for full access to all this and more to come.", "short_description": "The Work at Height - Scissor Lift training application provides training and guidance through everything you need to learn to safely complete work at height, according to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vobling.com/privacy-policy-workatheight/", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": null, "website_url": "http://www.vobling.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690523032489719"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "5180464615388300"}]}, "baseline_offer": {"id": "5180464615388300"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1674201600, "status": "PUBLISHED", "id": "5180464615388300"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5564716833583688", "version": "0.0.25"}, "id": "1979217455617224", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5496800040375368", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5564716833583688"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1979217455617224"}]}, "change_log":
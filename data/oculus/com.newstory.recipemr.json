_LzNmTaYcQ7kNvwFTUBop&_nc_oc=AdpJ8oTD3kt1OVRD9n9tB7iXuLte8LWU83Mv6hupIgwfI1sssaJJ0y2-xTndj8lB5gU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xkowIyq-wmWqCbtKxPnRsKg2Ju44FHxCykx_ud77qWw&oe=6A4519FB"}, {"file_name": "2.png", "id": "1816312912581959", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617729_1816312915915292_8158137996576691076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wL7g2fK1AxkQ7kNvwHpDLSz&_nc_oc=AdoI8fCzJTopctzQg_lSJvowNtsf56SFtRTCXtTJjoUcsHAifPLmvHnqah1ksid3dNU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QV1ym0fRbMSbdPnm7SzHdfzyb_QBGrJExloJioV2CdA&oe=6A450CB8"}, {"file_name": "1.png", "id": "1873358583293132", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499304212_1873358586626465_1892075117937186035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Bql2QxCUfgQ7kNvwEXu_LT&_nc_oc=Adqqy23kLtzPylNw5Ar0S1CCBGIML1T2EnlPJ1XA0zSvk1LTcATUlyDKl4q7v5gF4GE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yQm_PJP0IjTXmO5hxyc8Fl7nBEFhlp5-JM1vPTqCo9g&oe=6A450FB3"}, {"file_name": "4.png", "id": "841272885524079", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499304938_841272888857412_3181645542867245669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_Fuytm-Na0Q7kNvwE7gd_e&_nc_oc=AdqKrPCzJHCTbWAG7HzvDtqC0fYmiXXVrYuxrPZwUkHhDRgVpggSL0tgG3fjpMCEe9M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RUdsafunLBXsRr0dx7fAdKNUrZzSrnDGgR6aKWC2-KQ&oe=6A45066D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple Timer MR", "keywords": ["Stopwatch", "Clock", "Alarm", "Countdown", "Study"], "long_description": "Simple Timer MR fundamentally changes how you manage time by seamlessly integrating powerful timer functionality directly into your real-world environment.\n# Key Features \n- **True Mixed Reality (MR) Integration**: Don't just view a timer\u2014place it on any surface in your room: your wall, your desk, your whiteboard. Once placed, it stays there until you move it.\n- **Intuitive Hand Tracking**: No controllers needed. Create and position timers with simple, natural gestures.\n- **Multiple Timers, Endless Possibilities**: Run as many timers as you need simultaneously. Track your focus time, break time, and board game turns\u2014all at once, all at a glance.\n\n- **Minimalist, Unobtrusive Design**: A clean, elegant interface that gives you the information you need without cluttering your space. Stay focused on your task, not the tool.\n", "short_description": "Bring time into your world. Place, pinch, and manage multiple timers with just your hands. The perfect minimalist utility for productivity, fitness, cooking, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25099243173005614"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4319204705022108"}]}, "baseline_offer": {"id": "4319204705022108"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761875340, "status": "PUBLISHED", "id": "4319204705022108"}]}, "liv
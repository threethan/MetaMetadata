XR4pMQ7kNvwF_z-jo&_nc_oc=AdrtE_wjKW0zqA-fCRstPMUgQgJmsbRmrAN_okNDRY9oxK0N3bvrX9tRfSZhoLISNL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMSmUfW00ZBijZyvSRhBtZmUBsB2Md3o4jafmO-BI9qA&oe=6AEE07F3"}, {"file_name": "4.png", "id": "841272885524079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_841272888857412_3181645542867245669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OR6pY4Na5IQ7kNvwEyFWYI&_nc_oc=AdoZ4qkehcz6MeFOJ8cSjZEeQ0C0wMJGzfPK-a1kwvC_mfdEVwwqFR1X1YATWKLBHLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXJNUN_LUU17wBKqJ1T36qbIlW8zLubvXCYwa2ENuJsw&oe=6AEDFEAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple Timer MR", "keywords": ["Stopwatch", "Clock", "Alarm", "Countdown", "Study"], "long_description": "Simple Timer MR fundamentally changes how you manage time by seamlessly integrating powerful timer functionality directly into your real-world environment.\n# Key Features \n- **True Mixed Reality (MR) Integration**: Don't just view a timer\u2014place it on any surface in your room: your wall, your desk, your whiteboard. Once placed, it stays there until you move it.\n- **Intuitive Hand Tracking**: No controllers needed. Create and position timers with simple, natural gestures.\n- **Multiple Timers, Endless Possibilities**: Run as many timers as you need simultaneously. Track your focus time, break time, and board game turns\u2014all at once, all at a glance.\n\n- **Minimalist, Unobtrusive Design**: A clean, elegant interface that gives you the information you need without cluttering your space. Stay focused on your task, not the tool.\n", "short_description": "Bring time into your world. Place, pinch, and manage multiple timers with just your hands. The perfect minimalist utility for productivity, fitness, cooking, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_servic
 "1816312912581959", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617729_1816312915915292_8158137996576691076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvmK7GsBlfEQ7kNvwFr4YQn&_nc_oc=AdqjYg_3M5pgMdnowcPlTgb5LV1qDNY22wt6fZnGW51mPNGSLtK92imyWG19va3HWZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3R8_fali1XOG9Wq9Q7GZsnTfqAbzsB-qDcxCfy0wwFVQ&oe=69F4A138"}, {"file_name": "1.png", "id": "1873358583293132", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304212_1873358586626465_1892075117937186035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xix5n6KGiQ0Q7kNvwHovI3Z&_nc_oc=AdqUBZ8Y5dbRvfLBrv2KgSy3nwpzBKzqcW-5QF_-srCCwRGPpynR5twfjwzVaEj7CzM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2belFSShKgrVZ1GTx33LyNk3_V6xyl_C7J-yV6Y6i5Wg&oe=69F4A433"}, {"file_name": "4.png", "id": "841272885524079", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304938_841272888857412_3181645542867245669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGWy077nmGcQ7kNvwGqwqP0&_nc_oc=AdrWW05D6BgP5K4XEkQCk6Ls2VG5326_IniJxlp2u-fnK3fTfHuvBY4G8Z09_x50vI4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oS0-HCcLW3lSEFDFhwLZJLCfHUe0Oe_qsCYiCxjjJWQ&oe=69F49AED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple Timer MR", "keywords": ["Stopwatch", "Clock", "Alarm", "Countdown", "Study"], "long_description": "Simple Timer MR fundamentally changes how you manage time by seamlessly integrating powerful timer functionality directly into your real-world environment.\n# Key Features \n- **True Mixed Reality (MR) Integration**: Don't just view a timer\u2014place it on any surface in your room: your wall, your desk, your whiteboard. Once placed, it stays there until you move it.\n- **Intuitive Hand Tracking**: No controllers needed. Create and position timers with simple, natural gestures.\n- **Multiple Timers, Endless Possibilities**: Run as many timers as you need simultaneously. Track your focus time, break time, and board game turns\u2014all at once, all at a glance.\n\n- **Minimalist, Unobtrusive Design**: A clean, elegant interface that gives you the information you need without cluttering your space. Stay focused on your task, not the tool.\n", "short_description": "Bring time into your world. Place, pinch, and manage multiple timers with just your hands. The perfect minimalist utility for productivity, fitness, cooking, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25099243173005614"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4319204705022108"}]}, "baseline_offer": {"id": "4319204705022108"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761875340, "status": "PUBLISHED", "id": "4319204705022108"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25354822907447638", "version": "0.0.2"}, "id": "1330010351394127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fals
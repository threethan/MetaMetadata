wxZsUQ7kNvwF6-jfN&_nc_oc=AdrO0ccALBgCABHMwGAsdgukz2yRGvejaCqWFifn3nGkmkeR7uiVxDoEwPK96HlgaoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjPF4A__fQQIvp5lmDfCOmbAWOuzGHIWjdE8uZQz1Y5A&oe=6AB51F33"}, {"file_name": "4.png", "id": "841272885524079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_841272888857412_3181645542867245669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5AObQvP8JgQ7kNvwGo80Fw&_nc_oc=AdqndTRJF2ADonKofi2UuSKKipZ-279LBTzke_AKLNUGgAUG7pnPrPfpx3dwGQj1ZzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSHAfcUHld2r8h56YiD-T-pAUIJDr6KMPXy0bw6yV1fw&oe=6AB54E2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple Timer MR", "keywords": ["Stopwatch", "Clock", "Alarm", "Countdown", "Study"], "long_description": "Simple Timer MR fundamentally changes how you manage time by seamlessly integrating powerful timer functionality directly into your real-world environment.\n# Key Features \n- **True Mixed Reality (MR) Integration**: Don't just view a timer\u2014place it on any surface in your room: your wall, your desk, your whiteboard. Once placed, it stays there until you move it.\n- **Intuitive Hand Tracking**: No controllers needed. Create and position timers with simple, natural gestures.\n- **Multiple Timers, Endless Possibilities**: Run as many timers as you need simultaneously. Track your focus time, break time, and board game turns\u2014all at once, all at a glance.\n\n- **Minimalist, Unobtrusive Design**: A clean, elegant interface that gives you the information you need without cluttering your space. Stay focused on your task, not the tool.\n", "short_description": "Bring time into your world. Place, pinch, and manage multiple timers with just your hands. The perfect minimalist utility for productivity, fitness, cooking, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_servic
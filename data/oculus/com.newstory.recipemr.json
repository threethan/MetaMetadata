6ulypVVOYQ7kNvwHte2wW&_nc_oc=AdqsemNQuq8k0Q88C_RQUfuJhR9Cy7sBjcg-yjxsx6TJYbSNDLCFsjcLwesvnVlNRUM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kxSZwSM_s1sxki-dBYBhALQn9aaIyMI-W7RBMIgkSWQ&oe=6A3D30FB"}, {"file_name": "2.png", "id": "1816312912581959", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617729_1816312915915292_8158137996576691076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zmv5dASVvNwQ7kNvwFBcOxf&_nc_oc=Adqbr7dwkWUqaxCb7TsK7L2pHZm-9X5LpbtqCLZdrTZXTPOJ5HVwkakeyvzo5SWhHKU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nt1PWP_clqqUZd8rN0NLri9JKiNkOsmDSZLoCSjYNNw&oe=6A3D5BF8"}, {"file_name": "1.png", "id": "1873358583293132", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304212_1873358586626465_1892075117937186035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFo2PYM7V-UQ7kNvwGYsOkP&_nc_oc=AdraOQSUjqyXjBkGqW8tmBMYmqiKKb_SfhrRgFm7ZhLksM35XhpshEbHhA8Sh3ioDDE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YwI_pieWEzxS0AECAaWM71SPOptOj6mdwbQUSWmbexA&oe=6A3D26B3"}, {"file_name": "4.png", "id": "841272885524079", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304938_841272888857412_3181645542867245669_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFVsYXOvGJcQ7kNvwEWzHpN&_nc_oc=AdqKuWh8sL53SyN3g3ZT3gOxR2cIbzKpv5ZFNAmmD3shyZCinGV0l0RAZD9cp4Qw-oY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eGHb3vWGX7fyEvHmD0ka0QVFwMbnYnRDHss-CZcp1sw&oe=6A3D55AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple Timer MR", "keywords": ["Stopwatch", "Clock", "Alarm", "Countdown", "Study"], "long_description": "Simple Timer MR fundamentally changes how you manage time by seamlessly integrating powerful timer functionality directly into your real-world environment.\n# Key Features \n- **True Mixed Reality (MR) Integration**: Don't just view a timer\u2014place it on any surface in your room: your wall, your desk, your whiteboard. Once placed, it stays there until you move it.\n- **Intuitive Hand Tracking**: No controllers needed. Create and position timers with simple, natural gestures.\n- **Multiple Timers, Endless Possibilities**: Run as many timers as you need simultaneously. Track your focus time, break time, and board game turns\u2014all at once, all at a glance.\n\n- **Minimalist, Unobtrusive Design**: A clean, elegant interface that gives you the information you need without cluttering your space. Stay focused on your task, not the tool.\n", "short_description": "Bring time into your world. Place, pinch, and manage multiple timers with just your hands. The perfect minimalist utility for productivity, fitness, cooking, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25099243173005614"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4319204705022108"}]}, "baseline_offer": {"id": "4319204705022108"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761875340, "status": "PUBLISHED", "id": "4319204705022108"}]}, "liv
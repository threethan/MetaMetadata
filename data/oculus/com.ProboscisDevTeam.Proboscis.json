&_nc_sid=6e7a0a&_nc_ohc=fDoFWbB2BY4Q7kNvwElEens&_nc_oc=AdpIRyJHOGYaC9NqufRl8mMULXQe6Y9XKwaNB7UiJ_7RmsAeGel9q1xqzUZUTESbojQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DQhawIChTc5YuAndvhkt6vIie5hv6Pvy-boCfWQ2-Vw&oe=6A19B01C"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-46-48.png", "id": "1486495065830982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_1486495069164315_6263216236266793350_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6O3OAwB_E4Q7kNvwGiS8qa&_nc_oc=Adr3KBZMaG8Yzn4V8qcBjMECtnoNlbsexZLnwKNBkOvti2rN5xG2b2cHlI1oG3vC-Kk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af424lG5OxCv4fmZT-CVxoaBJdhJlMJWUkEJ_KOLwxAoOw&oe=6A19AC9E"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-49-50.png", "id": "2233371637159848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820058_2233371640493181_5127558325547283089_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdK5VjM06LoQ7kNvwE6fLMq&_nc_oc=AdrvC8pVvYpkenAQQ05fODjnJaJCRTeg_9slqnluakJrCAEmIVktOANouI6TEuUWPes&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40I1-rgTSKqqiCMr77PjA1Fa-mTYOAeHvUf4_wPTDetQ&oe=6A19AFB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project (21).png", "id": "815631544040440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361354_815631547373773_1561692875513617642_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ONOF6LhFrUQ7kNvwELwGdZ&_nc_oc=AdoME9TCYSOl7Z5ZvkHr81_8dLY7_CSFqPtKeRaR7_P1ZVG2dseB0DT-1-wgoGoVkFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HufOn30vgB5kii1YpJa68LewtvnIvMc347lTQlwqERg&oe=6A19AB25"}, "display_name": "Proboscis!", "keywords": [], "long_description": "Proboscis! is a chaotic, action-packed VR experience inspired by Gorilla Tag \u2014 but with its own weird and wonderful twist. Climb, swing, and bounce your way through a growing world filled with unique maps, crazy game modes, and a bustling social hub where anything can happen.\n\nWhether you're a competitive tag pro or just here to vibe, Proboscis! has something for everyone. Challenge your friends in a variety of modes, from classic tag to custom minigames, or explore the mall \u2014 a central hangout spot where you can shop, chill, and meet other players.\n\nKey Features:\n\n\ud83e\udd8d Physics-based movement \u2013 no buttons, just pure arm-powered fun\n\n\ud83c\udfc3\u200d\u2642\ufe0f Tons of game modes \u2013 from fast-paced tag to wild, experimental minigames\n\n\ud83d\udecd\ufe0f A fully explorable mall packed with surprises\n\n\ud83c\udfae Frequent updates, seasonal events, and community-driven content\n\n\ud83e\udde2 Cosmetic items and customization so you can express your inner Proboscis\n\nProboscis! is more than a game \u2014 it\u2019s a growing world powered by the community. Join the chaos, make new friends, and see what\u2019s around the next corner... or rooftop.\n\nAre you ready to swing into the madness?", "short_description": "Proboscis! is a fast-paced VR climbing and tag game inspired by Gorilla Tag. Explore a vibrant world full of unique game modes, hang out with friends at the mall, Proboscis! offers nonstop action and goofy fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/proboscisvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TIMMEH And Friends", "support_website_url": null, "website_url": "https://sites.google.com/view/proboscisvr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25094932503433625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_780001761474621_1935625622929169713_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkBOF5O_NOgQ7kNvwEfdeUc&_nc_oc=AdorFwXPc6N37WTUpkdhtNMWbzm3OefKgLzDsqm79QPpRS9jW2RxCzmzGCjRKsfbeN4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ozZC7cNGs-jd3TDt65YEbmX-JqHYKQs2G3oqOndAfJw&oe=6A199B20"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Proboscis!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1700667756, "lastRevision": {"nodes": [{"id": "6952996454720507", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6952996438053842", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "363350606057627"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Untitled Project (25).png", "id": "3563763313859143", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031600_3563763317192476_1721340622071185758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZLOdnV3l10Q7kNvwH4FLCF&_nc_oc=AdrVZblRF-RhroDfWwNF7dy8j82PeSBwvmth8BO8bPp3SYLLl9NRuiiQ5FtiUeGALXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aaquIkXorxrEkAlV-CIHVLmuDS4SN0IF80c-d7PxBFg&oe=6A19918D"}, {"file_name": "Untitle
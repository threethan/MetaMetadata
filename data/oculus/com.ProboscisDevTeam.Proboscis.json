scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFgpZAvccYuAegQKuZx_nyV_dXyyXDSu0Qa8CyjUVN1A&oe=6B0723B5"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-46-40.png", "id": "810124648220557", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311572_810124651553890_2296006744429770299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFEW9JdRhgEQ7kNvwG3duHe&_nc_oc=AdqwpfEuII3K069BvAq2SN47EMyeIJDOH_ctCFtMdmwW7n8njKGdJMtdJnBnsx1YLDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlhEQC38l4t9uYvbIUCz46yF6MkAFzOQoIIfEP4NPLBA&oe=6B06FE1C"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-46-48.png", "id": "1486495065830982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618484_1486495069164315_6263216236266793350_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hk2R9xuo0QQ7kNvwFIwfA7&_nc_oc=AdoJknPj1nEWybfAfTefVMMtY09is1dvBvUlAGgimJ74gmKVEbVtLh0vrIQ0mJqhuSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrvvKNclKlLzkdYSioqwP5I4H7ctvdItgrHWXeDbBLjA&oe=6B06FA9E"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-49-50.png", "id": "2233371637159848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820058_2233371640493181_5127558325547283089_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd_M-wG9hScQ7kNvwEZh8Qt&_nc_oc=AdrTdJyzy6k28xbI8apWl2S2D2SthCxOVTiZ-1gR8Zgkjn9mix-AYNBlTZzb8Pp7hZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3C4FyTLzHXAaMwCprys4JQxs4hm3ufdJRAvlocfq80Q&oe=6B06FDB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project (21).png", "id": "815631544040440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75361354_815631547373773_1561692875513617642_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQdMDXgBv_IQ7kNvwFKLLeZ&_nc_oc=AdoGN5dKlkW1ayRBZ7-kCenXnnlmfXumdu-MoSSzo4jsnFktn8I9i5yynRMqqRd89K4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2h51OdRJMeMwVtgNYnQfB4oHCZr1WQkkRmgd6ziTcAQ&oe=6B06F925"}, "display_name": "Proboscis!", "keywords": [], "long_description": "Proboscis! is a chaotic, action-packed VR experience inspired by Gorilla Tag \u2014 but with its own weird and wonderful twist. Climb, swing, and bounce your way through a growing world filled with unique maps, crazy game modes, and a bustling social hub where anything can happen.\n\nWhether you're a competitive tag pro or just here to vibe, Proboscis! has something for everyone. Challenge your friends in a variety of modes, from classic tag to custom minigames, or explore the mall \u2014 a central hangout spot where you can shop, chill, and meet other players.\n\nKey Features:\n\n\ud83e\udd8d Physics-based movement \u2013 no buttons, just pure arm-powered fun\n\n\ud83c\udfc3\u200d\u2642\ufe0f Tons of game modes \u2013 from fast-paced tag to wild, experimental minigames\n\n\ud83d\udecd\ufe0f A fully explorable mall packed with surprises\n\n\ud83c\udfae Frequent updates, seasonal events, and community-driven content\n\n\ud83e\udde2 Cosmetic items and customization so you can express your inner Proboscis\n\nProboscis! is more than a game \u2014 it\u2019s a growing world powered by the community. Join the chaos, make new friends, and see what\u2019s around the next corner... or rooftop.\n\nAre you ready to swing into the madness?", "short_description": "Proboscis! is a fast-paced VR climbing and tag game inspired by Gorilla Tag. Explore a vibrant world full of unique game modes, hang out with friends at the mall, Proboscis! offers nonstop action and goofy fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/proboscisvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TIMMEH And Friends", "support_website_url": null, "website_url": "https://sites.google.com/view/proboscisvr/home?authuser=0", "category":
scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJB0uNtBQbDE3BUQHQTvrNIDfuB6RRJig143OXDiAJXA&oe=6AFDB0F5"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-46-40.png", "id": "810124648220557", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311572_810124651553890_2296006744429770299_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjSyymgxTnYQ7kNvwFCO98E&_nc_oc=Adr6214gdBEPwchvpjd5CF_rvIuKrwNK2gCcbDOa4r9QmcEGrusUXQi0akdX2zqwTdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTUUjnLCsSeQCeSNIFMJHvrnPY1lywzRPjfXbOA3YsgQ&oe=6AFDC39C"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-46-48.png", "id": "1486495065830982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618484_1486495069164315_6263216236266793350_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5egqEThTSMQ7kNvwGzofEV&_nc_oc=AdpmvlKTeV7aCS_FFPs1-0EbWQ2vATaPlLqLC_iM5E1AXsgZe3AdyhbJO2hepZgbBvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaFqEwCnuwIMjyLjyVZAUbiBkdALwLxorur2uUDPTuUw&oe=6AFDC01E"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-49-50.png", "id": "2233371637159848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_2233371640493181_5127558325547283089_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SEvub7tv-wQ7kNvwHfx0YQ&_nc_oc=Adp-HIbU5fBocHeQ1AKSAKTf9LVAelZiSbD_oxQyECqNkTjKNyeTB8QoHtVnL50r7Po&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1ARGVyD5shv6qB_OnIzki0Oc1GMPUYljsydY9X51DLw&oe=6AFDC330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project (21).png", "id": "815631544040440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361354_815631547373773_1561692875513617642_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tus1QUWRUFQQ7kNvwFQ0-DW&_nc_oc=AdrqFm1rXTCgfBwo_9VNxaHLmlKN3kHn1EqaxF-9NH0OsFBszBCllQLOyX5CmswWDY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmQjeSizT3zGtqlsHl-l8YiDX2S5VdT4ZTEb7keucI7w&oe=6AFDBEA5"}, "display_name": "Proboscis!", "keywords": [], "long_description": "Proboscis! is a chaotic, action-packed VR experience inspired by Gorilla Tag \u2014 but with its own weird and wonderful twist. Climb, swing, and bounce your way through a growing world filled with unique maps, crazy game modes, and a bustling social hub where anything can happen.\n\nWhether you're a competitive tag pro or just here to vibe, Proboscis! has something for everyone. Challenge your friends in a variety of modes, from classic tag to custom minigames, or explore the mall \u2014 a central hangout spot where you can shop, chill, and meet other players.\n\nKey Features:\n\n\ud83e\udd8d Physics-based movement \u2013 no buttons, just pure arm-powered fun\n\n\ud83c\udfc3\u200d\u2642\ufe0f Tons of game modes \u2013 from fast-paced tag to wild, experimental minigames\n\n\ud83d\udecd\ufe0f A fully explorable mall packed with surprises\n\n\ud83c\udfae Frequent updates, seasonal events, and community-driven content\n\n\ud83e\udde2 Cosmetic items and customization so you can express your inner Proboscis\n\nProboscis! is more than a game \u2014 it\u2019s a growing world powered by the community. Join the chaos, make new friends, and see what\u2019s around the next corner... or rooftop.\n\nAre you ready to swing into the madness?", "short_description": "Proboscis! is a fast-paced VR climbing and tag game inspired by Gorilla Tag. Explore a vibrant world full of unique game modes, hang out with friends at the mall, Proboscis! offers nonstop action and goofy fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/proboscisvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TIMMEH And Friends", "support_website_url": null, "website_url": "https://sites.google.com/view/proboscisvr/home?authuser=0", "category":
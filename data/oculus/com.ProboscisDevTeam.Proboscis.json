&_nc_sid=6e7a0a&_nc_ohc=1Wzm1a2-TRQQ7kNvwEtD41o&_nc_oc=Adpq4asUn188unqPiT45S9ANLbGKVBD7iKowUAwp6SqmqgR7hreFmV-bmDrS9wzKRO4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNHAG_evlr5-Seag1pI7NhEmdWdB2D3N9nwMG7fRhU9g&oe=69C3C65C"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-46-48.png", "id": "1486495065830982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618484_1486495069164315_6263216236266793350_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzIFmx2OjqoQ7kNvwFm8qsU&_nc_oc=Adodv_9eDeiytJoljsJxk5VmrEa2E4RPxsCivEnJsKfNuwJ4UfPUKpObZNTL9p8Ncco&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdyQzGnB3y-ydxWKKBWRqDfS92Zio5Z9naGbJgEk7wfw&oe=69C3C2DE"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-49-50.png", "id": "2233371637159848", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820058_2233371640493181_5127558325547283089_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjNo5WobausQ7kNvwEHlMkz&_nc_oc=AdpRwxq9A84Ab7QX09q7jEHb84EH4gdRwqRFT4i-1lGxnQ4FvF3ZGVUYtZIAhrkaw3o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnnuCwBWYToRHKZ0zbDZ2ItG_mQuXL3Cdij1Fzfw6-hQ&oe=69C3C5F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project (21).png", "id": "815631544040440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75361354_815631547373773_1561692875513617642_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ito2if3njo4Q7kNvwG5KjoL&_nc_oc=Adp9z7Iv7hSmGkuFu0KUm5_kkd2AECduVe3wjI3BWAibmjspr9eacMfTLiHUMFN96mQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCA7IMG0_85ToTAV_Mi5pKsuU1MV1ik-1hkVeS3WGjqw&oe=69C3C165"}, "display_name": "Proboscis!", "keywords": [], "long_description": "Proboscis! is a chaotic, action-packed VR experience inspired by Gorilla Tag \u2014 but with its own weird and wonderful twist. Climb, swing, and bounce your way through a growing world filled with unique maps, crazy game modes, and a bustling social hub where anything can happen.\n\nWhether you're a competitive tag pro or just here to vibe, Proboscis! has something for everyone. Challenge your friends in a variety of modes, from classic tag to custom minigames, or explore the mall \u2014 a central hangout spot where you can shop, chill, and meet other players.\n\nKey Features:\n\n\ud83e\udd8d Physics-based movement \u2013 no buttons, just pure arm-powered fun\n\n\ud83c\udfc3\u200d\u2642\ufe0f Tons of game modes \u2013 from fast-paced tag to wild, experimental minigames\n\n\ud83d\udecd\ufe0f A fully explorable mall packed with surprises\n\n\ud83c\udfae Frequent updates, seasonal events, and community-driven content\n\n\ud83e\udde2 Cosmetic items and customization so you can express your inner Proboscis\n\nProboscis! is more than a game \u2014 it\u2019s a growing world powered by the community. Join the chaos, make new friends, and see what\u2019s around the next corner... or rooftop.\n\nAre you ready to swing into the madness?", "short_description": "Proboscis! is a fast-paced VR climbing and tag game inspired by Gorilla Tag. Explore a vibrant world full of unique game modes, hang out with friends at the mall, Proboscis! offers nonstop action and goofy fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/proboscisvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TIMMEH And Friends", "support_website_url": null, "website_url": "https://sites.google.com/view/proboscisvr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25094932503433625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619680_780001761474621_1935625622929169713_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4lnt5VbtasQ7kNvwEAVIud&_nc_oc=AdqACozqdTQWGzBV-SSMmmY_0m78b4aRWZAnowkTPc4Bpk6V4Foqag2-iHMx1iUXuqU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5dWs5SFatM1on357xUcee4KfzHra8bMLvZJ9mpr4D-A&oe=69C3E9A0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Proboscis!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1700667756, "lastRevision": {"nodes": [{"id": "6952996454720507", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6952996438053842", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "363350606057627"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Untitled Project (25).png", "id": "3563763313859143", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031600_3563763317192476_1721340622071185758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcQ-Xj9OGPYQ7kNvwF6xhRs&_nc_oc=AdqVCR8wwYvHmZYaO7OEAXB_BWa4Q_nx0gy8hVp1IZk996J3S-etwGZUxpAO0o7hetU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTi7rlWpDe02RrJPCCsyjIvU5WrAuld5bMqdsq8DndQQ&oe=69C3E00D"}, {"file_name": "Untitle
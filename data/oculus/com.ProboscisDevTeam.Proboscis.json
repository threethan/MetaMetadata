nJcMRhemII4L41LGfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfssjuT7-LrtaW8w8R_by-Oj8FCFqm8TuhllFGmxoSP4aQ&oe=699AE7DC"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-46-48.png", "id": "1486495065830982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618484_1486495069164315_6263216236266793350_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLSlAe2gx1UQ7kNvwEchqUL&_nc_oc=Adm9MUuR2G-i6Cf8QrmMsFp0K1w3zIN1Zbjq1cH1TpUG5DcGc1G1-VadSzHuB9cIrGw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft8e8-9O6kW1xeOjmSCHaJN6aGFXlGPAwWLAf3xJugmpQ&oe=699AE45E"}, {"file_name": "probosciscrazy_Custom..._30.09.2025_15-49-50.png", "id": "2233371637159848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820058_2233371640493181_5127558325547283089_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzOfAAdJqKUQ7kNvwEtCZzz&_nc_oc=AdkuHFaRw9OhXA1fo7lvh07YTqJ9uY8TI2-9jVt5uRjliFuxa7uh4UV6xoSuCIwIsM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTZs8qS488iJ9wWTuXmnpivXO9Fb4ObfLNgUAJRAR3MQ&oe=699AE770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project (21).png", "id": "815631544040440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75361354_815631547373773_1561692875513617642_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9POCPzN9vwQ7kNvwHokX-C&_nc_oc=AdkOaUd1knEVPyBifFV1glT2zQikc7Qcs7CgESDzzub6H-UFU_zjsPkI_kG5PHaCoUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvPDiQjh9laEbRZfNZxHulkMJWecfj0juxF1n81fvSAyw&oe=699AE2E5"}, "display_name": "Proboscis!", "keywords": [], "long_description": "Proboscis! is a chaotic, action-packed VR experience inspired by Gorilla Tag \u2014 but with its own weird and wonderful twist. Climb, swing, and bounce your way through a growing world filled with unique maps, crazy game modes, and a bustling social hub where anything can happen.\n\nWhether you're a competitive tag pro or just here to vibe, Proboscis! has something for everyone. Challenge your friends in a variety of modes, from classic tag to custom minigames, or explore the mall \u2014 a central hangout spot where you can shop, chill, and meet other players.\n\nKey Features:\n\n\ud83e\udd8d Physics-based movement \u2013 no buttons, just pure arm-powered fun\n\n\ud83c\udfc3\u200d\u2642\ufe0f Tons of game modes \u2013 from fast-paced tag to wild, experimental minigames\n\n\ud83d\udecd\ufe0f A fully explorable mall packed with surprises\n\n\ud83c\udfae Frequent updates, seasonal events, and community-driven content\n\n\ud83e\udde2 Cosmetic items and customization so you can express your inner Proboscis\n\nProboscis! is more than a game \u2014 it\u2019s a growing world powered by the community. Join the chaos, make new friends, and see what\u2019s around the next corner... or rooftop.\n\nAre you ready to swing into the madness?", "short_description": "Proboscis! is a fast-paced VR climbing and tag game inspired by Gorilla Tag. Explore a vibrant world full of unique game modes, hang out with friends at the mall, Proboscis! offers nonstop action and goofy fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/proboscisvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TIMMEH And Friends", "support_website_url": null, "website_url": "https://sites.google.com/view/proboscisvr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tra
uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_2085963432251998_8346316548457302917_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXhsNJoC4y8Q7kNvwFJjTc3&_nc_oc=Adq6NIDg21eHe_mIPPADl_1dBghS07ejSuCWlhvALYQw_j8RatuISE0SCiZ98ztzgCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ENoP1ROvghQbRXkguxWATH7QVbkJjOblxAlOLeBTLXA&oe=6A43DB05"}, {"file_name": "5.png", "id": "1250352093422901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1250352096756234_5621876815973219801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjTZZkLsi6EQ7kNvwG7i705&_nc_oc=AdpgAE-UhnMe1DEzj1rUapfl8CiGf3p5pSjLK_MFHfBWPM1-9DjHfC4HAqVe6RM_U-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QleAx5Rsp7EkKXIIE3cuLzw8R3k7nchcrYQOc0UIOjQ&oe=6A43B9D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Blast", "keywords": ["Puzzle", "blockblast", "spatialpuzzle", "Casual", "block"], "long_description": "Block Blast!\nBLOCK BLAST VR \u2013 THE NEXT DIMENSION OF PUZZLE SOLVING\n\nStep into a world where puzzles come to life! If you loved the classic block-matching gameplay on mobile, Block Blast! VR takes that passion to a whole new dimension. Forget tapping a screen\u2014now you can reach out, grab, and master the board with your own hands.\n\nKey Features:\nTactile Physics Interaction: Use your Touch Controllers (or Hand Tracking) to pick up, rotate, and snap blocks into the 8x8 grid with satisfying precision.\n\nImmersive Environments: Solve puzzles in stunning 360\u00b0 environments, from minimalist zen lofts to breathtaking cosmic vistas designed to help you focus and relax.\n\nExplosive Combo Mechanics: Clear multiple rows and columns to trigger spectacular visual effects and spatial audio cues right in front of your eyes.\n\nInfinite & Adventure Modes: Push your limits in the endless Classic mode or journey through hundreds of unique levels in the Adventure quest.\n\nBrain Training & Relaxation: The perfect blend of mental stimulation and stress relief, built specifically for the VR experience.\n\nAre you ready to shatter your high score in a world without limits?\nDownload now and start blasting!", "short_description": "Block Blast\nExperience the ultimate block puzzle classic, reimagined for immersive VR!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26526308153630939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_25555567687450300_4579204272718901678_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACRF3IFbSGkQ7kNvwGOXQWX&_nc_oc=AdrmK-teo375eRn4IAQaEt1BndC8u8SeoRaVgqjDzDe-HhDpkYAv-cAbQIzSeGMzBYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5LKUORFNr4wtfOtlUku4MDb4aiDlnroCVE5FZrtgB4g&oe=6A43E4AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Block Blast", "platform"
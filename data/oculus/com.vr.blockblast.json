=1-7&_nc_sid=6e7a0a&_nc_ohc=jhL-0a-Sb_YQ7kNvwH9ZWE1&_nc_oc=Adp4VN1bW16kVIzStfPCq-Hs5hy3ji5__Fxp9TcTwXV8w4zvr8AuweFpfzRaJ_G3CIM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2f36wcjRNm23jyOoRrVUoel0LmR5eC4W4eVUdD8QuGBQ&oe=69F1FB8E"}, {"file_name": "4.png", "id": "2085963428918665", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824307_2085963432251998_8346316548457302917_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAwioFLlkxkQ7kNvwH6cgDp&_nc_oc=Ado_12ulE379Yy2L3Xy-vn_LrOdsaTWUSFhtAMCe97dAdRCpFSvrBWaTsCJPKYQJyug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2v2TV9ABFdfhdoDuUy1Z-f0qm1ingYdMkVKUgywW82NQ&oe=69F1E5C5"}, {"file_name": "5.png", "id": "1250352093422901", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823310_1250352096756234_5621876815973219801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_axUrwGeG0QQ7kNvwFk9ge4&_nc_oc=Adq7HOGpWBoLquS1GUDnhYyRjrduMy6UoWYV2FHjOgwHAcNX7Zps_V4kWWZXEPxKrKM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1xvN6doEKvP057-h9MU3QHXNJxOHPF290z0fjBTV8HeQ&oe=69F1FCD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Blast", "keywords": ["Puzzle", "blockblast", "spatialpuzzle", "Casual", "block"], "long_description": "Block Blast!\nBLOCK BLAST VR \u2013 THE NEXT DIMENSION OF PUZZLE SOLVING\n\nStep into a world where puzzles come to life! If you loved the classic block-matching gameplay on mobile, Block Blast! VR takes that passion to a whole new dimension. Forget tapping a screen\u2014now you can reach out, grab, and master the board with your own hands.\n\nKey Features:\nTactile Physics Interaction: Use your Touch Controllers (or Hand Tracking) to pick up, rotate, and snap blocks into the 8x8 grid with satisfying precision.\n\nImmersive Environments: Solve puzzles in stunning 360\u00b0 environments, from minimalist zen lofts to breathtaking cosmic vistas designed to help you focus and relax.\n\nExplosive Combo Mechanics: Clear multiple rows and columns to trigger spectacular visual effects and spatial audio cues right in front of your eyes.\n\nInfinite & Adventure Modes: Push your limits in the endless Classic mode or journey through hundreds of unique levels in the Adventure quest.\n\nBrain Training & Relaxation: The perfect blend of mental stimulation and stress relief, built specifically for the VR experience.\n\nAre you ready to shatter your high score in a world without limits?\nDownload now and start blasting!", "short_description": "Block Blast\nExperience the ultimate block puzzle classic, reimagined for immersive VR!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26526308153630939"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1269800985330754"}]}, "baseline_offer": {"id": "1269800985330754"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774058580, "status": "PUBLISHED", "id": "1269800985330754"}]}, "liveChannel": {
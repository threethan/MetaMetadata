DCA68E"}, {"file_name": "4.png", "id": "2085963428918665", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824307_2085963432251998_8346316548457302917_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lug1TJnXWukQ7kNvwFEYOgB&_nc_oc=AdqHinwV31JRuV_1Nf0vL4cbh3M3TjEEEbGXWSBSlpsH30LxmpdRNZ_Ih1ieNx2AOYc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKSM7LSPyD2iP9pMuPQ2wQfAL42T26v-MC_tTNol6V9w&oe=6ADCC905"}, {"file_name": "com.vr.blockblast-20260803-160447 copy.png", "id": "1639033911563605", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622334_1639033914896938_2348653904721117002_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3daGWRQz7n8Q7kNvwEt9Sn1&_nc_oc=AdoPaCSfl8BLQzrLtTqgr4wU7KWyyUP2iuc1KOyhX6jsN0FKIakhnplmtg3CKSPqDF8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYW9bDlvu19yIezlahv_2BkIEt4LXq8aRdAxWYyXHl-g&oe=6ADCB41A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blasting Block", "keywords": ["Puzzle", "blockblast", "spatialpuzzle", "Casual", "block"], "long_description": "Blasting Block!\nBlasting Block VR \u2013 THE NEXT DIMENSION OF PUZZLE SOLVING\n\nStep into a world where puzzles come to life! If you loved the classic block-matching gameplay on mobile, Blasting Block VR takes that passion to a whole new dimension. Forget tapping a screen\u2014now you can reach out, grab, and master the board with your own hands.\n\nKey Features:\nTactile Physics Interaction: Use your Touch Controllers (or Hand Tracking) to pick up, rotate, and snap blocks into the 8x8 grid with satisfying precision.\n\nImmersive Environments: Solve puzzles in stunning 360\u00b0 environments, from minimalist zen lofts to breathtaking cosmic vistas designed to help you focus and relax.\n\nExplosive Combo Mechanics: Clear multiple rows and columns to trigger spectacular visual effects and spatial audio cues right in front of your eyes.\n\nInfinite & Adventure Modes: Push your limits in the endless Classic mode or journey through hundreds of unique levels in the Adventure quest.\n\nBrain Training & Relaxation: The perfect blend of mental stimulation and stress relief, built specifically for the VR experience.\n\nAre you ready to shatter your high score in a world without limits?\nDownload now and start blasting!", "short_description": "Blasting Block\nExperience the ultimate block puzzle classic, reimagined for immersive VR!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28118474627747609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619704_4413227308925824_3887299620794245446_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xE0cb79ueNUQ7kNvwFNV6Q-&_nc_oc=Adq7aJ_6294KqoK_iLxIxEJaQshezLMKkwr48RAAq6kqwnDcFgGyzsAZvTCTw2pmnm0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQbE2Bj8G2JrV5jpFOLxpb4vIODOEGn8TfEk44scDbEg&oe=6ADCD111"}, "
YZ9v0cTl1qSsvDQA2QtRe2x42ZJdO8DrQWhH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObXrBNsH7nKbAJlnpxuGD_ByadlCwNujMZGDktYFdvKw&oe=6ACCF9EB"}, {"file_name": "3.png", "id": "1498445288580516", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821674_1498445291913849_1819890965978527943_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spR-jh6QXzcQ7kNvwH24Yt8&_nc_oc=AdoCamuoRdP0amDilvBwEwuIydTi3VQwl_b-mnRsOh8SAAgbRgz3iFgDLZki05cPtPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZBhecOu67G-6d5ZBcti8vaQMgYcEo8fy4aE7OiYOZ7A&oe=6ACD0CCE"}, {"file_name": "4.png", "id": "2085963428918665", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_2085963432251998_8346316548457302917_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcAJpv5qx00Q7kNvwFOC8q_&_nc_oc=Adp0fuyvhB3PtBueSouuIkJ6lKP8Ds1hC1Br3fSvvERKLzNAFjutJN855kKYSbGuUJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmENSbNpbkJ6ulcRiz81YbF7znXmWWwqFrU4nt4x6kjw&oe=6ACCF705"}, {"file_name": "5.png", "id": "1250352093422901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_1250352096756234_5621876815973219801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAR3Ec6zU2EQ7kNvwHvDHV8&_nc_oc=AdpjcUqgqTf7Og7rgkquF5QgIaaiBY74AB1jNfPPhGQiy5D9we8QFqWPX_G5bQn09LA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqccyIZymaHwdnwOECIXXqBjRnUNfCEjISXosDxcRgbQ&oe=6ACD0E10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Blast", "keywords": ["Puzzle", "blockblast", "spatialpuzzle", "Casual", "block"], "long_description": "Block Blast!\nBLOCK BLAST VR \u2013 THE NEXT DIMENSION OF PUZZLE SOLVING\n\nStep into a world where puzzles come to life! If you loved the classic block-matching gameplay on mobile, Block Blast! VR takes that passion to a whole new dimension. Forget tapping a screen\u2014now you can reach out, grab, and master the board with your own hands.\n\nKey Features:\nTactile Physics Interaction: Use your Touch Controllers (or Hand Tracking) to pick up, rotate, and snap blocks into the 8x8 grid with satisfying precision.\n\nImmersive Environments: Solve puzzles in stunning 360\u00b0 environments, from minimalist zen lofts to breathtaking cosmic vistas designed to help you focus and relax.\n\nExplosive Combo Mechanics: Clear multiple rows and columns to trigger spectacular visual effects and spatial audio cues right in front of your eyes.\n\nInfinite & Adventure Modes: Push your limits in the endless Classic mode or journey through hundreds of unique levels in the Adventure quest.\n\nBrain Training & Relaxation: The perfect blend of mental stimulation and stress relief, built specifically for the VR experience.\n\nAre you ready to shatter your high score in a world without limits?\nDownload now and start blasting!", "short_description": "Block Blast\nExperience the ultimate block puzzle classic, reimagined for immersive VR!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_m
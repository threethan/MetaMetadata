CD0CCE"}, {"file_name": "4.png", "id": "2085963428918665", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_2085963432251998_8346316548457302917_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcAJpv5qx00Q7kNvwFOC8q_&_nc_oc=Adp0fuyvhB3PtBueSouuIkJ6lKP8Ds1hC1Br3fSvvERKLzNAFjutJN855kKYSbGuUJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmENSbNpbkJ6ulcRiz81YbF7znXmWWwqFrU4nt4x6kjw&oe=6ACCF705"}, {"file_name": "com.vr.blockblast-20260803-160447 copy.png", "id": "1639033911563605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622334_1639033914896938_2348653904721117002_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_8HVUbboQwQ7kNvwEM1t4F&_nc_oc=AdqsWHlt651-Ye444OgVITYH4GbUlYcl4hSr2J5DTy-MSUFPxTFm6aMSY8TEd1icS5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSeDCeK-V6mlQA-eMbH-mMdOar2NroleaB__JjeFLlVg&oe=6ACCE21A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blasting Block", "keywords": ["Puzzle", "blockblast", "spatialpuzzle", "Casual", "block"], "long_description": "Blasting Block!\nBlasting Block VR \u2013 THE NEXT DIMENSION OF PUZZLE SOLVING\n\nStep into a world where puzzles come to life! If you loved the classic block-matching gameplay on mobile, Blasting Block VR takes that passion to a whole new dimension. Forget tapping a screen\u2014now you can reach out, grab, and master the board with your own hands.\n\nKey Features:\nTactile Physics Interaction: Use your Touch Controllers (or Hand Tracking) to pick up, rotate, and snap blocks into the 8x8 grid with satisfying precision.\n\nImmersive Environments: Solve puzzles in stunning 360\u00b0 environments, from minimalist zen lofts to breathtaking cosmic vistas designed to help you focus and relax.\n\nExplosive Combo Mechanics: Clear multiple rows and columns to trigger spectacular visual effects and spatial audio cues right in front of your eyes.\n\nInfinite & Adventure Modes: Push your limits in the endless Classic mode or journey through hundreds of unique levels in the Adventure quest.\n\nBrain Training & Relaxation: The perfect blend of mental stimulation and stress relief, built specifically for the VR experience.\n\nAre you ready to shatter your high score in a world without limits?\nDownload now and start blasting!", "short_description": "Blasting Block\nExperience the ultimate block puzzle classic, reimagined for immersive VR!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28118474627747609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619704_4413227308925824_3887299620794245446_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT-89JZwbWoQ7kNvwG6pmjt&_nc_oc=AdqgTxuzrhuWR05gF9wTT_r73LjkP-vVxxqayRF8drRQSFDxRp3MutyeHFWsWgiqVrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLWOoyQawaO0lLVgjGrYrZqUugbF9zO5I5x2_76UJM4g&oe=6ACCFF11"}, "
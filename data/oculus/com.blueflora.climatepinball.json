-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47hj9DBYAB4EqX09dVvAcGLmWKVYLvn0wPrSO_63p8-w&oe=6A031761"}, {"file_name": "ss5.png", "id": "301219274783944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974454_301219278117277_7520306523217438192_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI_0nEI7l4MQ7kNvwFBzjhe&_nc_oc=Adpm6JKhTpIDog0a9_wOwUJvUkjlN7UzltqgzehYpEypuKveC63oGQ-xmq7QsEO6GyE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wmzqqEwjB2F8wT2i0L9j-sNFTa-Kz0qzBjZoRDJ3J0w&oe=6A033F74"}, {"file_name": "ss3.png", "id": "790514064936453", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86659754_790514068269786_2883384394146080420_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqphDNa3M2wQ7kNvwFQ_Lmy&_nc_oc=Adp6Hilt-9OSOqVOLq4TVnWlnwI3eg0Nsq9wPQ8qHfT60cZ4Hrp7T72c3zvi98HE3DQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l24hjaE3kElFBloQPjCkUdc-T3Qh2EPzwnb58GFS6dQ&oe=6A03388B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "151071746987392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974626_151071750320725_2809090754734155107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePNzTDbiq1YQ7kNvwG8M69z&_nc_oc=AdpFb_vyf1rcKEhe8eUF0ErJ7khyWN6eH18k02H0FPgj5EwZCUfcpC9yUXN2SwGsKF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q0o1j40RmnQQYvdbzczRkvJglzV85og-5lhey-QVzfw&oe=6A0336BA"}, "display_name": "Climate Change Pinball", "keywords": [], "long_description": "Climate Pinball is a pinball game about climate adaptation and resilience. You play the game to save the planet, and the goal of the experience is to encourage behavior change and climate education in a fun and interactive manner. The overall message of the experience is that positive change and to help remind us that climate change is not a lost cause. This is not the first crisis humans have encountered, and it won't be the last. If everyone does their part to push for good habits, reduce consumption, and demand policy change we can turn this around. And remember, don't drop the ball on Climate Change!\n", "short_description": "Climate Pinball is a pinball game about climate adaptation and resilience. You play the game to save the planet, and the goal of the experience is to encourage behavior change and climate education in a fun and interactive manner. This is not the first crisis humans have encountered, and it won't be the last. If everyone does their part to push for good habits, reduce consumption, and demand policy change we can turn this around. And remember, don't drop the ball on Climate Change!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://climatechangepinball.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blue Flora", "support_website_url": null, "website_url": "http://climatechangepinball.org/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EDUCATIONAL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "320323333377422"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6196407843764712", "version": "v01.31"}, "id": "4146344955396812", "ch
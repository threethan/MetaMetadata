s2-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R_OQ_CzIsoQ7kNvwE9z8Q-&_nc_oc=Adqu62KBNnFnpI4LvAC3nzoYsu89DFEwBgmgNr9LirwRM7VsGBAxQ0PXpnQgdzMBsOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PwP8FtxLckP6OFo4U-6yxKKz4o-CJGtzcEavmX6jg1g&oe=6A315D5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-3kqlCpnHUQ7kNvwH9LD76&_nc_oc=Adq6vE2rx6zKWPM57I31ORhOLt4DbTYFjSoqQFAxAXYjrMweTl6lxSbkgYh_z448r34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8hOnetxgD-SKlYeor1k2gK7jcsUGhNmUJQ3bbEg0pUA&oe=6A3173E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmcvjWCmoRwQ7kNvwHu4Y_K&_nc_oc=AdrfKE_Gm38e2H_boDILyUbqLm9o33BgKTh2LnGA8cgGIMAeQ4lgJ4Ve8PjlMwE3L6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FV9MJmIheQm0IIPylF5icNlCjQYAi1GoXOWe4mhXzyw&oe=6A316486"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGZjr1JZtbsQ7kNvwEGv3a0&_nc_oc=AdqYjE7AYfiA4pmIj62XLay-yT-F3EhO6KhW8MHzkqoq6BRW5W4s6eb_2l2zFrel2zw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m_uFhIRwS6tSYZJqa-NCy4jYsxNZL1JrM-I5-uN1h7g&oe=6A316070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2CpzhbUEMcQ7kNvwEmRLiW&_nc_oc=AdqMNuWDtHPgWIR2xkZ5nQCpF6ujgxbqd2VzLFgCyeqNYFSmGe0hN3R7ewIfBrpaaFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ESg-8-iul-YuUP8_opMeSjTY32awlZ3s0PB1oFm_IoQ&oe=6A3153C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
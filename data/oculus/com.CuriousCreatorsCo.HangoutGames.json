l3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8J1T6LOKpxgQ7kNvwEh5IRe&_nc_oc=AdoSylMF0S8RSUBJ0Wk4da3kqhKQ1gLlwh4PI_r_Vm7pMt0joKh7wvTDdJp5zlKKdhc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyRR8EnRwDnrLcssJqNhv5Q1qpITtvwet0aey5fKF-tA&oe=6AAD4A5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGpvqv1vjKcQ7kNvwED_1Ff&_nc_oc=AdpyV0YpWwEwLr00_zpmyvYysm9Tdbj0EJKWay1m3BM3S-YnD8DAnWZkrJAkvRigFs8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeZTivjRN7ojajJMkQ4MFe5CrSU-_K6gUYn8MPK03vZA&oe=6AAD60E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5x6s8H67aEQ7kNvwFHexCc&_nc_oc=AdqWVFw_AftntrrFzEajhmdqEq3NC1etze0c7OOyl3QTsMNVqTCSkyjjOGqrn2XBtag&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJel30uchwgzD5eBruukDFA7IHg9Zsi-Ta8Ykc_3OXz9g&oe=6AAD5186"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItLCku4NZlEQ7kNvwGR9geY&_nc_oc=Adqcva8r_gIQ8Nf1fQr7V91yzY3FswDNKglM1CvK_WPdlXYRuOcErgFk3rNWeB0dLw0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqaviEjEG8nLX2buDbDR0_gHvDJXOHzNcgjMzSK2cMfg&oe=6AAD4D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr8ffISR1tUQ7kNvwHwWX_V&_nc_oc=AdrB81gTZeex4CbEHet7Oo9Zgv_mAxSLZBWE4R3li_qQhWUP-REhQqSzvuEFivurVTY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILYtKcSLoTglZwck4Q0kQzz0YOOFNo9VadpUsFNBSrDA&oe=6AAD40C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
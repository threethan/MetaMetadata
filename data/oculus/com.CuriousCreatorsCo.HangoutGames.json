3181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNlc7JjYo4cQ7kNvwF2oa-D&_nc_oc=Adq9WAkVtLEgre_llRrgHdl-BQOZH0Wd3cVz5L8QgTthd5HSNN9M03ZX-IWnKxj98K4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfIx4-jnKih5h5mDZnYKJuUM8lWA0Tk0KOVQUko03LDw&oe=6AAE93A1"}, {"file_name": "39031433_5170499593043967_5647460791535147534_n.png", "id": "573769781100075", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75630185_573769784433408_4874436914141267503_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg4AkaUFIJMQ7kNvwEu3KPc&_nc_oc=AdqAxK_LEsYZsENQrQmyqpgHHwrKpusN_9SDJrZMD_jdW6Tvgmv1Nz_e6bDE72gM7nY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVQqiuHc0-PJq9OI0UIjYX6mftujQhJDpyzp-udtMtpQ&oe=6AAEA155"}, {"file_name": "com.CuriousCreatorsCo.Formation-20220712-110717.png", "id": "3325514594359241", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974738_3325514597692574_7713797041680217542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1O3O6FMDUMQ7kNvwHrNaWn&_nc_oc=AdpnjvRjwLSXnLomT7Ho0x14rdMp1iurZ8i9rmgT1sfisLpns2FRL8bnJXnIDPWJsPU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNRmt1R99KSn50079SFtuwikefjg6XCYDMrnzAgd6OWg&oe=6AAEABEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hangout Games", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copycat, take turns drawing and guessing each other's creations. \n\nCodewords is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nFormation is a game of luck and strategy. Make a sequence of 5 cards in either direction or diagonally. First team to two sequences wins!\n\n", "short_description": "A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": n
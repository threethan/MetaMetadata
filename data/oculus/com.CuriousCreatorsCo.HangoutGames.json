l3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3NQx5_c5ZQQ7kNvwHZqgCk&_nc_oc=AdqiI0nvO5D9kr-fEozTRy9wnyiXz4XlgnahE1vo-xM984bWrUCSVR7wbMUCZoo9CxQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-8PN1q0Xg0DaH74QYKISC4HXjPvlVZlMQz6bRzWnDBA&oe=6A6F53DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzBnjPaffVkQ7kNvwERqwPt&_nc_oc=AdrsdqxllrufL6fywHFVKSfLGCFA9PhWL4MZvQM6yRvV_QUtP6YbAEmm_JX2o1BUV2E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzB4SM6yUzOFG5sKLXJgD_-rkkNoKN7ojPhs4U9i7vaw&oe=6A6F3220"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG9Nr6ZdHVcQ7kNvwH4J-Lw&_nc_oc=Adre9EYaaJ1K-lHORJjaQLxQ-KAYJaISA8L4yBGvJ268YGdQk2cqAUegFdPFaKG8XWU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY8EB4SPJXiNuBN16KiocTaNI3d8oZjmaF5iSQ7WUceA&oe=6A6F5B06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI50MP1KsKkQ7kNvwHl0OxE&_nc_oc=AdrgK3EHvlzcFHSyoHLQ7phgPgDgCNX4fhp3dSapp-uPBbXjqPV_Ahu1RdRgMmS9uZA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe6L0tXLpi3xR9NJTQD6_wJ6iO-NVf400040dPX_VTxg&oe=6A6F56F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Xmd9-Zk7AQ7kNvwE1ynUa&_nc_oc=AdrAwkIjaLqDAGXk5pvww5Oh7qXJAssC03ZWjkHHeKCkg5avy6mscGJtjSHtu4rcBXU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX31xRmLP_Yi-XNAIzXax_OazD5WiS5M2tmz4dln_U8g&oe=6A6F4A44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
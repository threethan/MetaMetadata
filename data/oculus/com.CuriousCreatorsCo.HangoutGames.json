content-sin11-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWP7Vy9AfGIQ7kNvwEplDsc&_nc_oc=Adoyft-gjziBSvNwP-mk77t77WauqM3OC3yMX3qnO7DY6t7W9HHPRQ9F7wV-MnyouKE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NFWZ0fnGYk9taOlEdJEimBmv5Tw3OL7rNMkH7t2xdEg&oe=6A36A35D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZGEy9-goKIQ7kNvwF9Lihq&_nc_oc=AdrnblvaK9Up9f8XWLJPlPmd0tJ5iYNYRDj7yRyRGxzmWkKScLjXesxvBrUriDVKYR8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CgRY8d3eDMZTjwZsZjqOq9fDFcZhnN5z40siXOPGHrA&oe=6A36B9E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Uxy4WWNTM8Q7kNvwEAPXsr&_nc_oc=AdrHT7rbRgxra4ydJwBDu89woUffuFfvICu7lsaQ61kFDO6lJW7KrNOQFb97q4ABRxM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e7jsK6TFSEAgyW04HoS3zyRQrMHXUQK4vTUXtFDuxUw&oe=6A36AA86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozi3vkrtwyQQ7kNvwEyAlsz&_nc_oc=AdoLiQ6IQh_mibdgxM-TbzS6QLaEQtnZ22KAJKy37CoI1LRq3pXTv-infUmlUnDNVb0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b-4qWetcBZK83RJ6bNZQUjyAIolWmeyFqJCSnl6eNZg&oe=6A36A670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgD7OmW5u7oQ7kNvwEnzmYa&_nc_oc=AdrZ36Z8X7vi2XtSCVCUMh6-4qYvts53h-cdzDHBcEJXl5ZJOcCmwT8itdSidsoc5FU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kLQC1btXZEqj5NunAmy6relu5SZXXdXBvFSRwj43_ng&oe=6A3699C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A47npcLyErgQ7kNvwE5Keg3&_nc_oc=AdpLYPWMMf-QPUKD_1GRdESVMbMLVCZVmPqyn5IV17SVEGN7TJcWCDyVhGRMPFo5vX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGHpKYNk2N8alDrSeSsjXILya9RJgIdwj7a2M3hkMcng&oe=6A788E5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEIDgyyGVHMQ7kNvwFPd2h2&_nc_oc=Adrz1egu9Q5cpcazCqc0IFkFff6WA4VuvnL82mwDXl-CjeTPQ-o77BYE8TycWrkZRqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6P-8oquBZRW22PCO-sqWEexx80OWGDYs9e7q9Yu3pUQ&oe=6A786CA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFnlUEdH7asQ7kNvwHgFsFi&_nc_oc=AdorqYlWn98zdlzVUwH8kPlZhyJ8y0LL958G4mtXI6TmtBtnsrxcBeggvAdZvc63jD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAuv6TknB0t1Nz-NagSIv-dkSw0E20SOTppkFcw4imbw&oe=6A789586"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IouWXmOVg4Q7kNvwFlTXAo&_nc_oc=AdoPPB4mRmVSe3YkQ8bmg_hc624Bry1yXdl2qk0U430D5-JNDPoItvjlf6mMSXm5_bo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd_XkBV1ihAZPOTDj2zf-OCz7lIK1v_CtdcGUzP-UPZg&oe=6A789170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIHc5UJIqCIQ7kNvwFU2Hle&_nc_oc=AdpZANJCVRQjyz44AI1uSNjryo6zzwi362Z_K1mC8HCWxXIOuuH65cm3D5yZcSSTpkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBHGWxjh0Fe2wvmtD7bKof1kJ9kVPzDTu1d9gs3oUoIQ&oe=6A7884C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
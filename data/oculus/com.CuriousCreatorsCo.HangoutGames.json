a5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tptZseXPv8Q7kNvwHJIg2B&_nc_oc=AdrA2zfWzzvQc2YsHbItUBQS9uP61baTINUWger7SFYMB47lawm5DslgtnbdgTXF9Wc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzADbJK6PoFOEK8ToLylor_ymA7VasKml5o_SpU8KTAQ&oe=6A68BC5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96AFHVRqf_YQ7kNvwHHN7v3&_nc_oc=AdpiDRkVtmjFsBjuhbH9YNndipGdCkOYYo9IlK0Cq3jMIXh93OJw75dcUoDfrW-oitQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy3MlHG-jAZrqZah4i0FvtTKmSjrWGeiJ4ptadTWOJ4w&oe=6A689AA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E2nEWDf85YQ7kNvwEhwf2F&_nc_oc=AdqybDw_fK0vNwRT1TV3L2DIE7XCwRtrQF5WLkNtnMZDJFcBSYMwiNvWIa2hjcCEXkI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc7lhnwlXnhJqB9_uWMAYFDourKbngsEogk3Jo2NSH-Q&oe=6A68C386"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpj1ZNkV5qgQ7kNvwEH09xt&_nc_oc=Adqml3Gui4_WH3lMQfOK6TBblSQFt14qEylTfQZv26F_qK2yOVqc1T54b0srAfJnj9k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmn1k9oJyl0O2z2V15wdlQ7eXDbta4Vavkg-ESqlvc-w&oe=6A68BF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpUXb1NBztgQ7kNvwG_1cGe&_nc_oc=Adpi2kK5hKavVZKDjOTnMIFkQRkDJS-6qbPViDDKU0vbE03DDJW6wTUPcbkX_yjYxfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWddTfZDGy9I2UiMuarR7JODp29pwSWBjYDvkWPpcQRg&oe=6A68B2C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
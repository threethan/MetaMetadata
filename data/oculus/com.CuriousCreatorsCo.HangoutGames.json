a5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6_rVBfjNHYQ7kNvwEcLkeM&_nc_oc=AdpUid-1nGhnMfBI9VqmZvdUjLnqo2I7OQHQtl4Job1KQNzxdsTCUvtdPVPlOf4pf2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QpvWFUFfIwpP4hk3ElpqelhYHGO8Nh0BSoxo61XniTQ&oe=6A4523DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-83hXAV690AQ7kNvwGsYwmc&_nc_oc=AdrVKoDhsWCPh-84rKzoNSj39rHe8cwG--KOyUIUG4g7PbuFsoWiKu77LJas0XmpC9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5KmDmO8wxetiiGEUpxL5fVyRj1ernIXbIJjzEIqRd6Q&oe=6A450220"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLry_u14IGoQ7kNvwF35BFR&_nc_oc=Adrn1nERG-0bkZmtdbrmF-5O4DuYE7rXr5oXRDYG-Kcch_Pg6CDW_-jyPiRHcFF6ltQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TiFamTp2KsYjTnDW4-PwWuvV_7JHOJc0cbeGz-YLcog&oe=6A452B06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-37Xb843NgQ7kNvwEYvB6f&_nc_oc=AdrOubVx5FyrBV_gwQhWjWdT0lze7J6REupc9btNwomokGFX8y1BeJFHyBghLTMdSjE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gj4mYX9IS8xBvxthMFi4a4VibMhHYuwGuuFNvsKYnKw&oe=6A4526F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqOoGvKa9qUQ7kNvwFr6PgQ&_nc_oc=AdqQZmBA5G1ezzMh34bMRBJVWaQfavpCT1YqFmKFHJqNbrqV-GRY91e-nKoFfIfcoiM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IxN67scWntJXUDAeQzQ4H66Jbb21Z_cuj-9Cj1uVzdQ&oe=6A451A44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
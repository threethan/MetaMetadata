3181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwlSgKVJFxAQ7kNvwH_jGoH&_nc_oc=Ado3WNeUfTk3rQt9AZ67x2hqzxgH2yBpe0iaNa9gwnn01XMHRGrAOgCynlc6MsvoHeQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXp8pBnD27rGblXY5pSCFJqshlwxEzzVAEnu3s410ZzA&oe=6A7DCC21"}, {"file_name": "39031433_5170499593043967_5647460791535147534_n.png", "id": "573769781100075", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75630185_573769784433408_4874436914141267503_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfMaRgDbwWkQ7kNvwF9Xjf2&_nc_oc=Ado6oXz9AQ8hL6ZUq8GpHlRollFAtznYv-Q_fXRHR9XR1kpJWE3Z9qOyjTI8DnHLR_M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW1ErObrlemr-pxvm0YhYY029Bl2WYLkcCajqd_L3E8g&oe=6A7DA195"}, {"file_name": "com.CuriousCreatorsCo.Formation-20220712-110717.png", "id": "3325514594359241", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974738_3325514597692574_7713797041680217542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyAbqcyd1RgQ7kNvwHpj3NL&_nc_oc=AdpTDh3TZjWJhC3CXp9aJGeHlVo8YeW5aEY_lfVokeEOSrdZtJARDfsi7cyQNGtf4Ps&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh12YIgd8OO2M2o6Z8Wz4CclAPIyGvITpsF_9-xvHfYw&oe=6A7DAC2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hangout Games", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copycat, take turns drawing and guessing each other's creations. \n\nCodewords is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nFormation is a game of luck and strategy. Make a sequence of 5 cards in either direction or diagonally. First team to two sequences wins!\n\n", "short_description": "A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": n
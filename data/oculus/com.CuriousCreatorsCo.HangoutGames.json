c3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP61KGtiPIsQ7kNvwEg7UZ7&_nc_oc=AdpSoAMuEORHN6Yg4KDyCifOf16eAM-2oOH3VTbeKQyVlpwWtJg80pTWjmCrwAoB5uQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh-i1X-JKNIWs9SDyXI3nX-yvvvY4kQbST8OVzHl6gqQ&oe=6AA5615D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpBk4CrzFzcQ7kNvwE0gtK_&_nc_oc=AdpufjsUifRWPsal6Z8iLOCgdDFgFUWfykTEDhXXjfcz6hwGMFCxWbQfi6ZZ_eTfxp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK101aqUsxDR-CsURXnNYkD9f_cC1hxt58jo4Yl5T4jug&oe=6AA577E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6keDSYpTbLkQ7kNvwHiOgm_&_nc_oc=AdoZeUWJ4yENrlEFrABBw9tMCCq10axzgQsFtH8HRZwlkU16LBXJ97zMvPgKluYQWn4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhwKQ_0-HP4YWrcyYnl5YHCfQ-BidqqE6rU4cT4N9-eg&oe=6AA56886"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcyLTmy2IdAQ7kNvwF4OPGL&_nc_oc=AdrEZIGf1zj1-TBA1T4Zg1H44BkpV5c2XWLtgp5Uc3rqRllqhCNbqi-TbADzh0Nt_Zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQeGVqnoSgs3_wlocWU1FR0a6aRq4fXdOHc5NZ4bAWCQ&oe=6AA56470"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUA66o6CY5wQ7kNvwHFFrdM&_nc_oc=Adoud2axAA3p8pH_bzI2u5Ec9EWXMe5JNwSEC0l50AkfWZch9sGGjCOm-wD656eRTl8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqxyy5L10Iru3aylVzIJzIO1SVOqHo8_CAdmBdxYA25g&oe=6AA557C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
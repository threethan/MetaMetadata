/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeMot-lchAUQ7kNvwHDIUPp&_nc_oc=Adm826n4HQbxX2XSZaQdh2kEAqxk8pacfyGR5b32nGN7OTzxvz_wyVw2kRnUHXerRtk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzH-2tWHYSQMmIMzwyaH7ValnVkEmyAEH-PmtW-S70IPA&oe=69BC07DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NotI1qiAnjUQ7kNvwGUnTUO&_nc_oc=AdmEEHDENHv1VLCEypZsWOEQLQj4xhmRRNpcKJhnjolyuiNUiEay_LZI26eJfNDwM3w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxx_Y2mUPcCMKlCeKyKgPhCrUFO6Mc7SHnZk23Yigy-UA&oe=69BBE620"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvJxjf2ZdAcQ7kNvwH0N-Kv&_nc_oc=AdnFz_wQ4-kA_iArnDDZjKffZkcaMSoxUm9cnbgoWd0N1ecr-qHC4wfrNdwn-u3LSU0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQ1gfsPz-uRAlb3CmCp-7YArKs5hoySPlBJZc_xT1pIA&oe=69BC0F06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQuXzto5sC0Q7kNvwFs4P6j&_nc_oc=Adn8OwlqxfEGLbqhyxqN-_p-kRvyhGDUjJSnZHG6vmGYPWyFL0Tp62jS95RP91tbRIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx361C70q4W0cCKpcOpO22mcFjyZBm4v-tJ_qFVOWFp0g&oe=69BC0AF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuIyD7__xBUQ7kNvwFAVQfv&_nc_oc=AdmA7vN52lRRot_IF4MeqgRUPo5U9v-Yx3LSdBxio9Wbe_XZOd3WDXVg1W1xuTkUh5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXADPcpECfhhR7iFsMcUF5HRbTlPGnZGhmxfkZn7MjXg&oe=69BBFE44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
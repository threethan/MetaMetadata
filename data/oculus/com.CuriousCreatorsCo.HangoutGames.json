/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c62KnTnxBzEQ7kNvwHHGfRJ&_nc_oc=AdkgTflsC5jAvoIokH3BSWQrGaRZ_87WNtHwm6TSMQx3jjpELEebLEe2DbEdeS03utU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5B-CIrGyuFsSymxRLzKSFx8XKOAiIpaf_N5f2D6uE9A&oe=69A8091D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvCyZ7TGuHUQ7kNvwHPbRyv&_nc_oc=Adn5MWHQvu3NZZjz8JqPr8p4Wgtf4lcSgqea5PIAWPsO4dwZnmmpKREPF_wwey48Eqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvLZsZouK86KFjRHPb1cmz2NhL6o6YDptL3vvjJC5g_Kg&oe=69A81FA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iRDz7rC4SUQ7kNvwEobgB8&_nc_oc=AdlpmVwJDVStzon5e02A3kUvbT-n_wvloZx1SwwWYcSQdCsj_DE9x0zz8MAzgOG-Wk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsuxkQTwuTpX4G0I7_0A9aNYZ4B7qs37pLrzsTKRJiJvA&oe=69A81046"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZglBmamI6jwQ7kNvwHubYoY&_nc_oc=Adk49BsdyvrKBXvS_zasMh-rZYaM48Kpu4qmT94p3_8VansGHn8NvyvOZr179WRMc_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftMKhPQL2BCicnLx-92sb2Sq6gcnWX2N6DehZY7zd2FGA&oe=69A80C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6p70wdbPFwQ7kNvwH5Hwx9&_nc_oc=AdkTtkJRZclFnFMBoN5RtzppieHi8zxzbxKgu0q5NZYmwW0ANaQIyRp_hWkdSslQ5gE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqT4gQK-SzxwP9vUpm6ipvJR3FcvZlVxoGaopuZ36DaA&oe=69A837C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
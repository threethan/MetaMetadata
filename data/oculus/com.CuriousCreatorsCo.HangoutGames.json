a5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiVoj7LlrsAQ7kNvwGkNlLe&_nc_oc=Adqo29lLJzfJevze3TrgHD4K9holpCHAkxuQprxgFsxD6-2kG6u6rYiQ8KfAZX0tBqw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyk3vs-V0EbICRq-0H3MYbeFAX7nF7s51uawKQkueMV3w&oe=69C29F5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSy3grhYMWEQ7kNvwFsRAnB&_nc_oc=Ado2a0kpL6ZAZluYYHYE29M-MFT9Ptd_Px09wdxTPieFKsjXZ2E8Pa4LtGPP7D8gVkE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCxkTfGnHaLqKUiVMQ72eh41Q6vTo7M6V6yzk8KOpZfA&oe=69C27DA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axXBSc10mlMQ7kNvwGw4Vo9&_nc_oc=AdqodIhkotrwGNMut5oNj8Jde4JyvV2Kd8EDq9fj9l8v_jyLArV36PhwuGxkhEsq32Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2WiXxHePpQOG1Yfq6DCl3mYliTj8gt1iLq4eznIJ-bA&oe=69C26E46"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOnYOKpZGd0Q7kNvwHWdiI4&_nc_oc=AdrJodRuaSuYdOznN5Px2fZoJRO5okJYVAuD05xVAj6cRhk0lFL20ed3JM4QV2cEY0w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8Td3Y77uv6jddYZI5JEnzMicD9-skgQfdNJ4N47IxpA&oe=69C26A30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6DNoC_o3WQQ7kNvwH5hnhz&_nc_oc=AdpOCIMPS9ArvDjk0wwHwoy1xI_ITRT4OrjlgPB1VABPoXoE9LkXRcCBsUKALgWX-Is&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH1EN-lvSiQSrhbuuny6J7vxVp_orcobzubgL5kAsUUw&oe=69C295C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
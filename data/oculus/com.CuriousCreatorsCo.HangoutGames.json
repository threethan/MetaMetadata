s2-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLzIkK1ULOMQ7kNvwG82ZqT&_nc_oc=AdpEZvK3XS_nmgseHumEczwGEJAPtyFAV29Urd7ZF_hXg46sKLenFC9rlIGrA1TN7zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hBpcCbrPj34X7jOqWWiww9PirXtWNfwrDFX20sOZM-A&oe=6A29745D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzF5qaVaIJoQ7kNvwFkb3b_&_nc_oc=AdrkD8_E_ttsP0kPqLz4v4Nu43QJN_Lv0RTSk8erQWQ5rbm14MrR1oVRqiiCJYRzvZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J_0j4Ydxp7Xys048CNq0gpFx8h0wfvrCVY4y8_c6d3g&oe=6A2952A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx3rKK8uyXEQ7kNvwEwC1HU&_nc_oc=Adp5sgffrZN_A0l-p2lWQ5vOJ6sv8AnynU5da0Th-C_CbbEj-zkPL8WRPkxEFByD4UA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EsJVciL6Fl4p9ICSy3nO6xADoh7Bdz_jAG6NOyAaAuQ&oe=6A297B86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3NLnB1vyEIQ7kNvwHZZps_&_nc_oc=AdruuhS8Gf3nz42afzLQwChu3if4nPyPqTd2MLtztSH7t2DgONCQZVu0b00NW0sfYN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j6mFIo7oVss41-Gf-PUfSMCzXtF_4YKBSnX-sPywW3Q&oe=6A297770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gy-3JBf666cQ7kNvwETlHwe&_nc_oc=AdoCPxmPf3P4pC9Q4uCPiOe8iQdtaJyfNZ-S_RmulGA1_wGedezQStyDx080Q7s2_cE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o2Jk5ZfXX8l7mSps5Hb1jC9xG8-VObBJWg_Mbh2ZLGA&oe=6A296AC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
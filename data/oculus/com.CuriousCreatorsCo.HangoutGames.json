a5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVhJ0vwg_yAQ7kNvwGGhgnx&_nc_oc=Adp8eEfm16TQ-PjaYBeFS38E8age99h2YXoOaztNpgibphJd8Eu-xIazV1kw8Ai6mYA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZPq-UXD-ztZ7KzWa5Ryn7iohr821GV2XSmYSEybugPQ&oe=6A15ADDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaH0kHWMjbkQ7kNvwGOTtXH&_nc_oc=Adrh_trJj2G5QpyTRfKolsMKriOYVyr8XnvuqDzhzGWqA8m4UJw5m_jXf4N_5BKsTMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4thmTtMnmPnJ0avcHy5zXq4mhQDLTpE5T5zUlacUUnXQ&oe=6A15C460"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2xdNxin-IYQ7kNvwH3cFVl&_nc_oc=Ado1R-c2eH-e3fxffSsNmbUAqtKAgqhah5Gd9vpzPWT7Dvuns6rqbVLK2xfvRhOglcw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R7Q3ksa-ZbG2b8NgYXKCR0U2FQQ6wJWUuEnlWDCd98g&oe=6A15B506"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo9eKgcB9_wQ7kNvwECrKMu&_nc_oc=Adpo_gt2ekmn4JyokNyjRyn6SQRI_ANBoXSekbWCQ6-4d42SenFmQ1Ewp8pDr7k13SU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jY2tMyEO7Xu7ASACDKsjsC759crMfBXKVF4ATj6Difw&oe=6A15B0F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=citRyM206ZYQ7kNvwGGTMQD&_nc_oc=AdqLInwTe1inSVmYi3L9RTCcLz4LQ0iTT0Uclo-0oBMlhBv6Vd5zIFTwqYub68Jej10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W1ZfwT3MXNBi-uyS0kSt_wZymr22cOFja0oczJqtPKQ&oe=6A15A444"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
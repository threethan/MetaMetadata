w5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNKN43GFlvwQ7kNvwFheOSU&_nc_oc=AdqkA-biYn0t3hz5Pevmo5v8cdP5YOgM6nImyKhJWmiS_V41gXEBGCCa-siPHCGlgVM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYeYAri365AhjKQQPwcp734tnEcIc0kZ6EHQ1tzXVAGQ&oe=6A5A3BDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDHJq3nwdygQ7kNvwGWgxy-&_nc_oc=AdqOwuS4ph3rBNja5ndlfyH4sWyo2Y7jkfkbpQgY2SXn2OjYvVHKFyGJEBnKdMzQsms&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArXuprt5BIEFsEi_1J3Brrdj_X0XH_LDNqU9DdfokZAQ&oe=6A5A1A20"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8V7N_XozZ0Q7kNvwE-wuuS&_nc_oc=AdpDnIa81r3uxJvj-eSF-0AZUnnjGsGTYod_6gHy1Lcz9UOy7GKJcIpgmwRgFHqPYFk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-UYsge6nnfcxCWrRSDurx80dlycoGXS_-kkTPEJF41Q&oe=6A5A4306"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMXY8dzN83IQ7kNvwHrYdkq&_nc_oc=Adoj0aPhHgBGHfFZfPw6lFyQSpxJj-UT2fuT-w7cmPYgm7mpZ941mr1YiUiaanELNgw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNRNG54POvtpkb4HLAY3raFrs2X2Yc4jPOxoA90astmg&oe=6A5A3EF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htsNLFoknOUQ7kNvwHVYpr-&_nc_oc=AdoazT2uNfMtSceMSwfUCzUYkZ1MrCFWu1yRVTrygjG6aPdD7m8LY2ClMUsOt41K4G4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9LHiQaBlzxa1JcQ2DsLL_KfKjGudf3pOx0yN4ngolzQ&oe=6A5A3244"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
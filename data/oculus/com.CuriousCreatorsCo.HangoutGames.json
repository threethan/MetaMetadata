d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZK5eKLVUn8Q7kNvwELV-7N&_nc_oc=AdoBF_UtKGWlYRFmsLSI5g6yVv_zCD3Vg0CzlZ9MY8d2Cqt0CjZu_0ZBsjJ6Tdrty8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbMjdC7cE-qT6-UHp2oQhe6ScJ4jEF7P2rzHwDhTxv1Q&oe=6AE74C5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvW9zIBGmNgQ7kNvwFplGmy&_nc_oc=AdoDDAGUv_uirhNy1em8Eu2AL9aQXTeUmzTwj_qPX5i7cEhQomZGMbAv0o0Ff5Fcmx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn2CLbyOuq_TmhxobrLgxvlncHLoGwzeqvTywjclZyGQ&oe=6AE762E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXt5BcXUhfMQ7kNvwG3cRFv&_nc_oc=AdoZgMZSo611AwgeBg5GZHvLigMN9RnP8ZFP_zZf8N61GlbtzWJyN8NlksJMmP_lIO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU36NtK2xtlhKYpzRHm8YjyGooiRW0YZ3kK7tvQLRz9g&oe=6AE75386"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw0tNCMxB1gQ7kNvwGo3svO&_nc_oc=Adq-kLI7QY6Wwy7S-Dbmvlg8Q2ZdAEdXYXoM3q1WrukYIYoQMHo_mcsf_MqloeKuaKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ09HdVgJ3XlZ2Vh0GbJN-X1Sq8wMdWkm3nredgcu5I4Q&oe=6AE74F70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heO3cRqgjEYQ7kNvwGoBz7_&_nc_oc=Adoseu4RhLXnnFViBAj7vga6xvRt_OYJ57al-MeuodXQiwU7ZWrPA1Z8_ts-CkjOQYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNSyrkgfi7tJqJpqkdTDvqtb5kQGCn1p_n_xswP98vaw&oe=6AE742C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
a3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98lHzfIbjXMQ7kNvwHvJEn4&_nc_oc=Adr0T7boL_gyDGbIE_x80J1DC2aBKd_rTnasPJNzEOlWh7B9Lx4UWIY0BJ5zYdIa_3M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K6YtEEjjLPAXoHYRUiCQxmyKw7Bh90Q8BnnQBPp2E9g&oe=6A1AF3DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ELE-yoKRwsQ7kNvwFfWzwb&_nc_oc=AdqCzhJSHSlJUEZkSNNvs_qYTA5HC4FXKWQmkvECFiWecix5DRO2yKBEblx26k4xoP0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YXmDwk4e6HCH3hcKefz9_fPBvCyqcBQqUuXn8RnbY3g&oe=6A1B0A60"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnlSmVB443kQ7kNvwHYuVQC&_nc_oc=AdqbfT8Wyg_rL8Ku75570rZG3zFDMbePC-jUKnWWAeERCdOqfiH8mi10ikTXnokhjjs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jjZX_ex5YWBSsMyYZ0nLWC-CoidnlR8QhE7_4LWvwdg&oe=6A1AFB06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOB3TPUuJyMQ7kNvwGStqkg&_nc_oc=Adq43GOfWV-iiSi9ioai-5Sm7vsmqN9B_qq199GkgNN0vEYMPAVc-PW0g3kvVAmiUhQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_sos3XFQbHm0nvbpLVyfMOfVhAd-Fj9JZcCIBmoZhOg&oe=6A1AF6F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQS1nViIIucQ7kNvwF_lZ6E&_nc_oc=AdoCFRwTOtEfMqj8mXipDkHOimmp7YLFM9dxcGeAZTDY1jd58vo3mHKK5x2OWTu5BDU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P-J2LtYUXosytkUrpUZCjNnenp2n43eGcm_jm46awnw&oe=6A1AEA44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
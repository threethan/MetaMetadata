/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYKRkBd9eI8Q7kNvwGkjDGn&_nc_oc=AdkHyCtCrOJcCLVf3dnln4DbIqBgDkPwsHS_5_kI-YEloAtWgkrB5nz6J_GVS4LBDNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwA1jSIlobNNE3DqBOysY2GP5ol16m6PuDXRGK6as1Fyw&oe=69B2CD5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwyV-ts4cqMQ7kNvwGVbJ3I&_nc_oc=AdnzfO_wMGKaYy8Id2xBeO_GmoylbYRJMBdatu3uHb9OiC6ROylfb-cM0nIwti9s6nU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7nF2_gkH9EDv2EkVtCSTFMgV4Mzt8cy-t9rnRxz_tGw&oe=69B2ABA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eOzyF6AcgUQ7kNvwED7Ll6&_nc_oc=AdkhCtnJpYONIznuEwTWQ9lkBriCDXWpQ3qwx6IkVHrTywzbZ4CfSEmxToOiKeGynfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoNeIZ_Yl5bND3cPbbKGI6Dt8tySyW5n8izzpG7Do-zQ&oe=69B29C46"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsJ28hMJjbAQ7kNvwEPjFJv&_nc_oc=AdmJ8_tTZplSC_PzFFl3HtNUUz5deVedso4x8YjmOcLVuBRqw_QJQoKF-UyTj2IwQkY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKqjMcLyZWQwcehlKk1feiVfKAkrlO8caxTaDbei3DjA&oe=69B2D070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWoq6XdgLK8Q7kNvwFdk0QG&_nc_oc=Adm90ieEn2LMm1MjnhXdNFrb5dcDCP2w-Xvicu7QRQohLAVfdiPdGww81OTBt7Jy68Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNjKS6MUJCLu--dHShbgIshqPGIDxciqET3wSAQlFCkQ&oe=69B2C3C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
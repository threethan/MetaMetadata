d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cE14TbmOGgQ7kNvwHgtE69&_nc_oc=AdrRdk3d-T1LmZwEZNCdBow5e0R2hQQ4dzxqriFK70OFUSoaeBiJD0KNUzv4lnIlChk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gPkpHR4Jc4m7CMgLjrDfj6DPk_WQVJNjRB7rOGfFoYw&oe=69D3C2DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh_C5AX7REkQ7kNvwE4K7pF&_nc_oc=AdrEOhtrlZTh-cs8-X7b2ZBtQOEWDbXkT8uzDHSoAMfPoFCa5tYQ3J7adef6mqF0MJg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_dxJdcWyl5fbZCgvDYEwFzjdBL0ZCNxovRMlbmPwPZA&oe=69D3A120"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVJVf_d0jtUQ7kNvwEvPlti&_nc_oc=Adpt905bWHdfQTkNnjHQJLMNxeVJd1sEFLNhUKwMlLEzP7ANJNf8gIKdvcBQ_Js3Lsw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cnJgJFVX5djm7a_oI0wg8fa9GBtZpY9JTCcMY1MI6pw&oe=69D391C6"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuiRCR2Opt0Q7kNvwGeLV2-&_nc_oc=AdoW37Ld7OR6nBlM7uK-1hyrI8lAQZK2Phx7S9XvcnMB4Yeb4VhdD6ZjSl4mwMN05B8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nB-Tu0Ahya1X45UhhQa5mAHdCCrNBz8AoMGSz0CKZ6g&oe=69D3C5F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5Wlfb8bYC4Q7kNvwEQdzfs&_nc_oc=AdpTU5NDkZlp-3quGjOcGkT1xA1D2P53TtAaWRzAE3N8A_0mLm6rXlQ7rO6yKXWQnlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w0HJYCczAVJsKv2_ti70niYiRCbM15ijgQ4BnvYkpCg&oe=69D3B944"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
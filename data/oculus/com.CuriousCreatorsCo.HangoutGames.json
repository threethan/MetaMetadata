w5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pgYtAxrAuoQ7kNvwEJQ533&_nc_oc=Ado2DuiUVykI4HYEr5nLZofMnvCj3eEOL9WnHXRH5dqKRCUx_xJupWpS1f1sMgC0ivY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd11OddekQQZH6I8wcHxIb0Gcd_WoXSzo48xtqlq5lKg&oe=6AE357DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3r1IsnkYi8Q7kNvwGuKl1z&_nc_oc=AdoPEDThbAWP3nufu9efXGpQoRsL0VTaABtZzVJFXpSJHxpZXbDPaI393zWOaH7qFEU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_M2tGNyRqc7XzJomH2N02tuiEyZw9wKuEsCVPHC9-Sg&oe=6AE36E60"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pun_qkM9jf8Q7kNvwGx8IJZ&_nc_oc=AdpnNoyzitsbrZksMJxjx4O94J5anBXZv6TKGCAHh6qNrBC2qZvp9LI8Ya48WlsxRn8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRUvWjszpykQQSW94sTi-J7vCT8hRds0mdjVRCJ90l-g&oe=6AE35F06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvDTpPTlmScQ7kNvwE8x45n&_nc_oc=AdoRS5yiAksXHsxkQTaa5PpDTh-okuzoDgYKefZHuw-u9VQtzjY6H12E_XZ9Y8SKCBI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyI5sFAB5cNbeiy1OdNYV9-Tdx4utpuxfVOlSAJODjtg&oe=6AE35AF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SynPCyAE0t8Q7kNvwF_3pEq&_nc_oc=AdqfVb_OPDckzm8-rRsxWoSOmvflxPmMieg9MG_vMd1X3z0-zEkWG7xF89JfyOljwtw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaTnDNAGb32D0TiiF2kvH5_SPqF0svlCx6IiUco77bYg&oe=6AE34E44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
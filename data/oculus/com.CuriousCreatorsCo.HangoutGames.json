a3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0pvo22pFw8Q7kNvwEUVlqg&_nc_oc=AdoZ1fiPkxDjg4X0EvnG6TvhwfioDWxQe3MJM22BwgfIGqTPsZwxOXx2DOdPxOr5ZRY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYwl1885lZz_gwbmcGcDHWYMSFMfo31uXI-ObUI9y9ig&oe=6A81909D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo6_uXOxMvMQ7kNvwFR4GrZ&_nc_oc=AdqwuVDAk2cUTC91qJz1SCGk6Wq_ngRQ-q4HOOAphbMLkUluBgXXnDWE2BAIU9k6SZo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFqx9XcZZ7A3mxN8Q_RX01NRuC7HLqYoEN6Gxs9a1WQw&oe=6A81A720"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQcCm4xsEHIQ7kNvwFaceQI&_nc_oc=Adpj0cYMKEdteuGQF2zkTYeiG59uemKkUyPFFBpLENMv9yvIQvhco7SQD9N8uah92uI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGvkPDWKtPYauJ1MDYHu9mdt92UluwB3y_k6x-SxlTUA&oe=6A8197C6"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4YaTv9h05UQ7kNvwFk6vVX&_nc_oc=Adq5kgMRCYy9Vo8sUaR-5SKz-Gmv7EwAmptSeOgB79lCICSoJGtrAwkxQb0sK4bwgWg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv6SBrLXF38OfEq2zAyWsh3yJcsJU0RRecpS6SNRGyXw&oe=6A8193B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5GysFy1kgUQ7kNvwFaVbu-&_nc_oc=AdozKp0lOFrjYR1MvpKfYzqZbngBaCiJQN9Yj6u1HJUb-DKzVPvNot-Ww1PkSjh8ojU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuxitJIj2PKUlgM2HyEW24ExV5u5CQwAIcdW0ej-cskA&oe=6A81BF44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
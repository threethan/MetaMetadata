d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYZ5YiuCwM0Q7kNvwHwp3Mz&_nc_oc=AdoT7OGXt1Bhzaj_GWMYU5YhsLoPIfBeoeMpDbyBTIOKqa29vkRSNM8SYi0qNkF3_LA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBD3RiNEyLWlZmJ76ipXDLiBiJuBu_LrI30P0RSOCrHw&oe=69CA885D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frqJZZYuxu4Q7kNvwHivn8w&_nc_oc=AdrEeWypHgbBZG8W3KajyXybb2dM_Q-ainfopCpIRH0H1XLJibbvx86GCRNrXYhW7Bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZsdhk8s2qwqPsNnbwUCjtXG1mXIG_9DbGyBhOGwKymQ&oe=69CA66A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSFdkqAvOTkQ7kNvwHw7gn4&_nc_oc=Adq3KhYNjltO9ouGlGBFnF7e2BWM92NSeuM2SRBBCGFnMN-T6HTTVou8qNofHpC90dA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmpsibGyIF9zqId7PmR8YJbtGicKLaAcc8q8DBz8U9Gg&oe=69CA5746"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuq7bT4j-akQ7kNvwHx5kWw&_nc_oc=AdrMkzYjrVFWCtBYau9EnwLJ8P0lTT3GX4k2gJVf-itq4UIHTisH4e-CfvwS8tjT1to&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyzR3qzngC4JJ7QtOaNQAsWX0mW8UUbbv0W9ZH-z5b6A&oe=69CA8B70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91_NxCwEsloQ7kNvwEOf3ut&_nc_oc=AdpXrjFE5ItVGj9GdsM8U2_VozA_OZnfZm0UeQ1FsXGk2wbFgpZbdlEfhNCvGksatm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0I1xcKkaFXt2tmCprhTc_aDVRfaaE3Xo6A0O5lUEQ6Q&oe=69CA7EC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
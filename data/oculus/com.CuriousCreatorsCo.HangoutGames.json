content-sin11-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hcBwuyLI1AQ7kNvwGSMuga&_nc_oc=AdoJUFgJTQ4Rbd9vTJWRX2qZ84UfryY0Hv2EsTdj1jUL0uVt7ph6iRwddHNCwSaJPCQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgxWIETPdLysetT2zbB18_tRAqmD7TaMGlTyK8thYWIQ&oe=6AA955DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyQA_HkoWNkQ7kNvwEdaVQq&_nc_oc=AdpmV-ETBQ-bdtsKXeSFIGj0vWNVUysjNJ16O0EA_yszbjR6n_moj0cmi3qe96JN1ZE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSwNRPlsXMIPd8zk-AWsN5f5XGcBow68bizFQZJBsC_A&oe=6AA93420"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDGWNIaypeEQ7kNvwHEKMkf&_nc_oc=AdpCX6Xu_qCsQOKGzP4mcckrk5XMwmwTyOvyNXcxXUI7OrRSM1zQipFlqQnxod1iYco&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3pLW_J6oGwmEqLejNLnOy9O0Np2bOJFju6VImsex3Dg&oe=6AA95D06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVfsBTe3aX4Q7kNvwEw4pba&_nc_oc=AdpEHweH4LBl8S-Rg88px11szK8rEYcQHaoFak8pBIBO0CX1LtkCV_bRzW1f2nVm6y4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBVoRRrGVemL6NhehqpwMZzjKxOSSKCH3mOFGHfjMNQA&oe=6AA958F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldYqGg4ojkYQ7kNvwFEVcUz&_nc_oc=AdqS766hzA1inOPiAF0hdAAH2loIcys5gkrDMmBN1JO1igouO99aV5xZzDb5_TAwm1U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINC6mf_4S1fMsCtb2Ox1rme7mClOubQZsRqO6lvarV_A&oe=6AA94C44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
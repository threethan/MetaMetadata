/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYKRkBd9eI8Q7kNvwHagOHB&_nc_oc=Adnx5tpSfbdPcZSDrt_sg0YI4HInE7x3S-tEDHnC4ZAazeV6OF3R-2JyyVzqrApjvdM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyvwll14gn39ly-mNCMHnhB9U3L4wn15KQdNmrwVfrE9A&oe=69B02A5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYWOdow3BdAQ7kNvwH3-khq&_nc_oc=AdnyruxQxEO0k-vkSADWXt5_5qsJhlHk3UJ64IpM2mFvAs8j-dSdnYwD8QYtja42eeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0JOQcQsZ6A-TRLz6fjN8hFdDCXUX37-8XuHSWGA9WSg&oe=69B008A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cPfLiX-oKkQ7kNvwG_mJ2S&_nc_oc=Adn2UYz0Xshulo597xpMNgii__oHeO-G67pFxl72oG81mHgF2HIfnmQrYSRAsx8PeSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz4pI-2gFX-CNzOgLHM67aTCsaHwlZr7ssMNXCLuGwKQ&oe=69AFF946"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRGaHO2UDNEQ7kNvwGWIDIV&_nc_oc=AdnLOSzHTGbMa8Is9AbUbcaoUYG7exul_MUFYBi5tObZWs22rPs-RsqAmLCEpj9GgaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb8gBdUbddk5ZD3GeAi_JREWJvZe6UAgEFlwgjlo6tkg&oe=69B02D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4m0dp9lG4wQ7kNvwFtFBad&_nc_oc=Adk8GuE0_IQabGJmekV2AZB2r2P_A-HBmcgI5b1Vmv_3r1Ah3CFyo6WumpkR_eSjoaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvwK20NayxVqnvfD0bzI2RlcYsfnzFAashwOFLWisegw&oe=69B020C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
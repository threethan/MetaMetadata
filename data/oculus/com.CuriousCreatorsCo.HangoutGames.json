l3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phPVVsfRkf4Q7kNvwEOYy1g&_nc_oc=AdpOK2sdZoJuoXYqOVYXPKYeGYHznrl706D48zcfN32mSI05COrq9Lgg2TgfZtb3sks&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyLwErmkrvAdxkKOi4daAlZxocpN3HUyP0P9tVp_NEqA&oe=6ADCC05D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtfWtk_FJuoQ7kNvwE0Ajn8&_nc_oc=Adqqn3KiK5MO9ZM3OPXM12046sVs5qJ2UC6ma5UBw-1T-4E8J_i1SG_hZDo19b8l5lM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUU5HDBpOKtTSGUMS-ccneFCeTDj1E-4Z-Rb1t8gpn8g&oe=6ADCD6E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nutJirXFIJQQ7kNvwEKJt1O&_nc_oc=Ado6J1R4JPeUzG4o5ATkv0wFkM5HUxIMzMmBsaPUOfXwGaIjae85kqpAW7FG2935Fy8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX993ta14u1KrTCoz3wL2F2Jdv_jFJPmTd7A4uJawF3w&oe=6ADCC786"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGrjbiAAUMQQ7kNvwHD8GGj&_nc_oc=Adqz6oaM42_NV7cyrZD-6yWUR8POTxOZvUvU-fWo0QS6hbHUVTcgA4gbed4axFJCTY0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlXAN6CIq-B_V67jaP0ULwkPSTlMOvJPjE63hkx2ZBHw&oe=6ADCC370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KXU8xzpEPkQ7kNvwGG2NIS&_nc_oc=AdqpL_tblCRrX3K_774bIvbdVvh2KxK5U2uDG7jJVxAzyyHy5gVL1bsBwbvpJkVE608&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-c28hrqMgPygyrVQNF8HHYR4j-ggBTUs9kE7U7ZVS-A&oe=6ADCB6C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
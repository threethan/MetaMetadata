a3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYZ5YiuCwM0Q7kNvwFa_H_G&_nc_oc=AdrceYPcAyKQKcHn0FYsX7ePd2C_2KW4PcVwhe4sqaJUJP6ZJh7HohPPOGAwPDGi3gA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRxnIXPwx8aWhOmmAFC6hyPtCjcACdn8Us-0RyspRRmw&oe=69C7E55D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noe2f2Suu3sQ7kNvwGFp5wN&_nc_oc=Adq9QLl4_49nnryYp4uzYstYjRrxdAyDtO-cOYxSW7kM4Crp1YETMisw5OtYAiuH4bU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWqYK0ELSLqwS84lPGevwa9bBCkAMWc2cx0KvXdOe6EQ&oe=69C7C3A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZrNX7EpmCUQ7kNvwF8cldq&_nc_oc=AdqbtzDLpQdxrlsdchX7UpmT0UYY_1jVo03773CtUXe1Gu_1GIhdPci6lqXwrCO3Qco&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhuS8TA389jV3mKklnyT-_XENtQrrCAQnOUPorYBkw0w&oe=69C7B446"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbDCoSwyLJMQ7kNvwH1tcRW&_nc_oc=AdpryLrmyHuXZJ2HR9bO5bkg9Nr42t9FPZGTqUGuBQpUOTVoSdSPRTyR8-LHNwwr6A0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxVXKqgIV31swZrYfe0sogv8qfywzTI0QHJEhX0i-Y9A&oe=69C7B030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcRqj_XYGNkQ7kNvwHt6kYa&_nc_oc=Adr-XFoqsFmBw14770d1tfB2-5Fu41kjJCUhzLmIgYmNNEnA-DH4IZYP04koNYhMwi8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeaaVdqgpwc_lfWosMr4a_hZH3HT16qfpLhkJWAMGlTA&oe=69C7DBC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
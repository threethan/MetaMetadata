a3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZFJXxaNYIEQ7kNvwGvVSH2&_nc_oc=Adqtc1kEIjx2HFyvI1uQ5rEsYElmy51kq5-3dWEO3uHgC6wvSr1weBj7yUO3XQVWHkk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn2drmBiMJz7bm2PkcRCQuubVopfCrT9cSJc0sfhpa6A&oe=6A803F1D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo6_uXOxMvMQ7kNvwE6KzqI&_nc_oc=AdpT0KSZ4tNg-z887-nHmoVbnSp1lxm4QLUTpcbRvyUHvyAxMRp5_qInbwsAQDYWARA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9wNK207pzBjAZxOn3rS9HH6R5WivBjumFOocgVT8LgA&oe=6A8055A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQcCm4xsEHIQ7kNvwEaZRv6&_nc_oc=Adqys3jbGAhqN91sBDYTWe4m4wmhuhNoRJIJVz6v-JbN1MNV6cug9ppRe_HpS4FQyoA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX5LIzB5cuO5mC8NuETgtG6Z9nYJ5pMzfQPUOpDQPNRw&oe=6A804646"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4YaTv9h05UQ7kNvwFcrkRu&_nc_oc=Adp4TeYOK6h1ihvYBRUYnOQXXXW18lVTrwTVcGLNG7SXT403z2sQB8hBGu0LSw0wdDQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8-bunC7h6iFmSwdTj2i7CeAAFbiVodyzD_E_cjh6tpQ&oe=6A804230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5GysFy1kgUQ7kNvwGqPSDW&_nc_oc=AdoySxV4LbEfYkprHFrBMKr3Z2g91J0yjRPbtwZWEh-m85cvYFkrHGaclzJ8HEUe654&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEji0fhnceNoh8cQ3vXv3yLO8TUZY-Olng6d_Ed8R3OWg&oe=6A806DC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
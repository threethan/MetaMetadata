866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eruXKbuOjUoQ7kNvwHAdpyS&_nc_oc=Adq-RMA4sE29VE8qFSsIr3h7iwaMJOwr-646IEw3STGc_zGE-STG9an4UzIIgf9_cfc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0FbjNsGURMb6MlVHCzVWzaGf0cNg6pd2eHI6AZOy9GZg&oe=69F2155D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWCxXGtFQjYQ7kNvwGUrffL&_nc_oc=AdroEXJrtYGhA0wY1TL6XyA887eS3Iv7RpmQDx4ZgGl9cC6twtWIJRbcLYWQEIfU1ic&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2PMx7TUUK7IMIHAPOG8bU0lDd5KjtuGvnynB8_oZkTDg&oe=69F1F3A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKRWW9BqdQ4Q7kNvwFiqMzG&_nc_oc=AdoubdOBh6aEN6uS9cvWPBC85GKSif0OxGLZd1YEpc6Ypqy8n6QwR054j40IYXFHkvo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Rq3fgzhGC7PkNIULE-u6tujG5vEvKG9C3oswLOIQS3g&oe=69F1E446"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLaKTMXzl5cQ7kNvwHJvVI-&_nc_oc=AdoyZptIweLXLi16ULMSCDUXBaG188m7LSYD1HbA3FzWaXifr1LC6uthr4JQcQZi1ow&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0CVz0ERsDZywiozrVgj9GECchgaKl04pRSfTsLJasAzg&oe=69F21870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pk2afAV1TM8Q7kNvwGqGAg2&_nc_oc=Adq7GIZxIn9Fjtuyz9PK5derdAiJgJGA7prBaOY9cNCbhFHG7zZ4959_hqzE359_MgM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2b6eItAPRdJQcNWAbMU8yImvN25PKL2jIPadeT60PHWg&oe=69F20BC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP
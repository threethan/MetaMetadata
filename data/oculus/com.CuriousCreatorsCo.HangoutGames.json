a3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAjSU8-hw8EQ7kNvwFYJ4_1&_nc_oc=Ado-WJwWejgFK7W72kpqBYRL9SsHlSt0soJ2E7tIgdNRVZxK_-mzw_SS_vjMOM3YcDk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeQNTjSjXIxPpRcuVYeaeanei2-XIQsS1W4PxQgiE-4Q&oe=6A56475D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4LTmQ3ILgcQ7kNvwFLHqLO&_nc_oc=AdrsPqPuospmS5cZN2ftsBCb8i5-GQj2hVimJzEWw8AvBU5sifKTDYK66kKLGHIKUak&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnGdWccAHytrqVpwJjSRuDrB3k0yGUvNkB7zMdFLZESA&oe=6A5625A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMt9m2oIsxQQ7kNvwHwS4k0&_nc_oc=AdphUo9xnit9-VbyGhiyERz-IwDgWtdiui2VUeN9GdkDPmsXm7t6psBgmoDjp8GlSdo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7gm-K_monjVa_0F71nL-R3ln8oV3sg4IrVHrEYFvjmw&oe=6A564E86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJLW0roUnTMQ7kNvwGbipaO&_nc_oc=AdqW31QDWfVHNMnOZp8yJzwMqiw8bo7TcXysXyA3bB3Ek1rzk2ZTUAyYYeFLt8PkvBE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2jsslIF6ATHbW6GD6xnLdR68fj7Rd01OsmLOR8x4xYQ&oe=6A564A70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwWMhZJ4rY8Q7kNvwE7p0Az&_nc_oc=Adp4qyFXRrKKkFvkzm8s8PZswdcBHoH9SDFWJi7SCoBEdRb-OLq2_j7yg8X2Y8Tp4RU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbUac5YuHVijRpcQIjG2bW-knN9Kt0FOGifPsQTuDZ_w&oe=6A563DC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
c3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pgYtAxrAuoQ7kNvwG62oNo&_nc_oc=Adobz-ZC6NiPBtPO8MxvPIeLnFCi4Oa59HhIcxIaqgBd3VGloVTMdeKsjR06S8Vc7FY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPvDOoBQPKPDRpTzvo7iuhm9IvMPTxhQ8v6TE7Pbgjvg&oe=6AE0B4DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iW0gKynK3YQ7kNvwHdSlrp&_nc_oc=AdoKvvvERWRWaNNfggPOZ6AT1vVlSFTr_KUHKyLDapSW9Ioo3X0okh1wJjVUb8JJhDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUg0ee3pvRWY6Tu1G7U4VmCwvAdDJVG4VL3p00pzGHSA&oe=6AE0CB60"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skuW7yWuCOYQ7kNvwFphHM-&_nc_oc=Adoi2v0K_Ba4crq99VBS3pHCHk5zBr_5M0Uu_-msqCJOrvv3RqJ6jz1df33mvqJhhgU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmNp-Yd3BqogW5Djh2_-sEC9UvF6uRYdgmmADQRu-iBg&oe=6AE0BC06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvDTpPTlmScQ7kNvwHYm-ya&_nc_oc=AdolfMDbcBoej-8doefKJjRyxZ0_tkyyU4ahkrz23Jxigxg6WWh5A1HWzbTGHTDv-Y0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhAQHm8-2SAPbqgf0ls_DnPYHOa2qXc6YFCMe0okAgtQ&oe=6AE0B7F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoEvn2rmc78Q7kNvwGsZMU2&_nc_oc=Adpt91-RJ0snlIsBgNQmx3JxS9mcz4xJNkx_Fs9i8REcEP4RhP737rz8CeKj_PxIglQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkzA7gTH6a4kTWSVTdN7eukGtzy3XA6jyPHQc15IMUTw&oe=6AE0AB44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
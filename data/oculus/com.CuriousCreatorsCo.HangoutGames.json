s2-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPcdq2oDKjsQ7kNvwGClyY9&_nc_oc=AdqyIeVd2OdJUFkvKGMpmeJsJeIHY26KzXPgXfzDhyYQAze8j5tN5pkfzFs_HxS0qFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg5IOaX6IYvyKtVjzbSIbaIsNG6myBcreJfMpPxEDk5g&oe=6A9C26DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uNbXuinkYcQ7kNvwGmmxTq&_nc_oc=AdqGRkl-emEEhmgFycS8iBaPxS7E2QW_moQ_sTwPZzj-gbkSuMTlUMAaXuDRtuUPhO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpj4Fb2Ozq7IJ1stvksUEeowBHOrzWs6WNdziRY1xOHg&oe=6A9C3D60"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKIQhl7J-GIQ7kNvwFZpTqv&_nc_oc=Adq5gZaQzWTSwB4cJu_95hXlHSk_5_TMNMvKBvySsIVZKF7N6R1PVQVNNNiZhdFiDPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2XN5T-f78ZIgJ22-d73fGhV7EEFEmxtEeLIP8Bt660g&oe=6A9C2E06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp0G_Ku1ZfoQ7kNvwGqQoTn&_nc_oc=AdpGVpySdDzg-f_rhsdJSZffeKorZDjN5LzYNutlGWukMxvheT2i9wMmZ7PLfDQNJDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcsv6QpaQg0_nrGXDU13pRRUsRBBekCow-DSzCGaP8ng&oe=6A9C29F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cspKB8bbM0Q7kNvwFtZSgQ&_nc_oc=AdqgKP6l6nPnhiKwokhlSO-IMPji-1WNPHeMLpPPLv3z4iov0bPv9y-N7sKgwAQ17aY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYAtb_guC0Y2OQeWFoI8C-Yg6gNFRX6MzPPOngjzLykA&oe=6A9C1D44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
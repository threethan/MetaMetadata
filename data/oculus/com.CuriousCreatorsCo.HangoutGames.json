content-lhr6-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwSD_gjoYIwQ7kNvwFJ4WZc&_nc_oc=AdrTyB0zMc0_Tf5JVTc5KPgwYn4_c6znc_dQ6DYvHkyx6aBS4W7W0W0AfANyzmbBoI0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ_OB4oQVpddq23UoMvvnkDngw0aQDTBKss7tVXmwIuw&oe=6A8EF7DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3iIhYwFmWQQ7kNvwFmCtlt&_nc_oc=Adp_q1bkVlIG8Os5X0tjWGJhJ9pudAw-YjFOX_HNQGJz9L4MkeVIJgucfkkXelyCP0o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo1KRZzRnYEZR_JF92rtYLZmrswINiKAsuFHHOTLIh_w&oe=6A8ED620"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F82IW8Ti2lAQ7kNvwGYifi6&_nc_oc=AdpDftmiLaBa8XQMihuK7bE4a7E5_iJQLhvpj3PU3kgK6pmuRwpiFlVyvD6S2A52DLY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEms-sag--T-kRzr5m1eBhNXRV6Mx0rD6AKP6j1mSK2cA&oe=6A8EC6C6"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDXqCGfNZ7gQ7kNvwG6E3KC&_nc_oc=AdpBiSA2EtviSYU-hkYHbwzaqLZdqJTgOfsLqxHKCybElCEOSmCDKDX6cYBHHLvO5Jg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXMp4W07rlTnvFOMkI00xVlxgUKB0YTvrdjG5jlIs2YQ&oe=6A8EFAF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFYBqCNoZA0Q7kNvwGuNpL2&_nc_oc=AdoLU7F0iP73hT_SDZC148xJKbdnh3akUCgyS9ueo2DY-NdITQtwuMhTdcLwTbze5UQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkp0WviH7JTYfT5YMgxJYigHBW_K4Fww0aLzuMHf7fpQ&oe=6A8EEE44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
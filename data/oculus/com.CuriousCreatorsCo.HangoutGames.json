s2-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXi9bfRy90oQ7kNvwELAc-Q&_nc_oc=Ado1OLV0QZEE7fyWJPgVrVcjC1NRYHITK2x9X9PMKZ9Ir7My7ev-R6zIgxCZdcIdJrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cAJdA-6Czhv81II3P5Rmn10dU6rkuTZ6BonBF4zhsHQ&oe=69FB4FDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JY8Q4cLVeWoQ7kNvwHEQisZ&_nc_oc=Adqxw8GytBUWPCxM51HHYawAClKGrOxs0rLKws-GEqRFGy60cEgibm46llGTQsaGXP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dLXNtFqovW2jyEh8-OKMb-H_uICR9mypgPm0NpVrBIA&oe=69FB2E20"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7XrrsBjk_IQ7kNvwHtXPLG&_nc_oc=Adqp6tXM4uJowmYdSqg-t5gzdV6VXRXX_sYVAB9NTlOE89GUmlJAnSj3gVbbI4oP_hI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50J7xAuRAfDCmt3MSTwW-sugs3o2Mm1m8KKsfoosO3jA&oe=69FB5706"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y2kVqhCDNIQ7kNvwEo-DN-&_nc_oc=AdoKBkHWGjj3_p7hdrCo1x-s21Nn2JaEJYC0HSSNiu1sdtfu36dohb315vxGLM1jEwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qfK4SckcI7fWWUl2tM7UhhgUaUw4eDfcbBUIQPkgaWw&oe=69FB52F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClCJFjKBjh4Q7kNvwF2KFR9&_nc_oc=AdqO9-dRN1WoWqaBwcDgxKZYF3rOfauLKjmk3iZUuf81lYkijHZCXUy7zEpL7ww_Iho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iBjU9kQSEtUPVgLUA5K2KlbPEgZUPskmg1czuX-y2sg&oe=69FB4644"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
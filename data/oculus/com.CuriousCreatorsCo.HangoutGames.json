/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHYIc80-Y-0Q7kNvwHnQ_PH&_nc_oc=AdmNF6rsLlEk0aMAoDC7-0mH-HIrKwX5dLxiyYtZCjCsGMCfAVU43ymx3taGfiYWE0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKFJ4xWmnHAuOA_a1n7LNbHAEl_LRchPW81T1moZ3JZg&oe=69B8135D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwWXlSbpRegQ7kNvwF9m9f2&_nc_oc=Adm6CkvXuM9ak-rjR02rdkgQ9l5LeWP_QHGONXHybrdZhVH8H-xtblC_UuaKsHv3Z2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJt5VYDlqoYKuwa-IQszAxZxFweZmtYCqqwpslUKDzfg&oe=69B7F1A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjWZJy9OsosQ7kNvwFQeOtp&_nc_oc=AdnkS_aaA1yufMztqwK42aaga1cHTfUC4D5w2oNjEN6MRYFu5ujOkTuLzVTBb4ch0t4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZvH2h28ImXJRkRSsTAbgd8nTKHu0qHzDqj_wd9V5soA&oe=69B7E246"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TnuZMhGSz0Q7kNvwGJDBLX&_nc_oc=AdnDVbkjbUWZ7ykQ0R3yqyxa1ellULLp9Xgwq8x-N9UGnm2eRkhvGc_mf6XxW62gRFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyiujIyQrkKh1-ZvZ-TM8t_RtexaR_NDtMuAPzEtUaMMg&oe=69B7DE30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iegl2d64aI4Q7kNvwE7_Vkk&_nc_oc=AdkiPclShx-tQc7O_SPiq4bkmEe6rpFLvE0e8iAl91gdXjgEmTu7aYJw4OkT27noMBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwt-dK5VxcNYZ71EMN_hpX3XSd_jIRMeN80u1v1J2r4rw&oe=69B809C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
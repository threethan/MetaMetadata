d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVhJ0vwg_yAQ7kNvwGrtJ21&_nc_oc=Ado2VCX5Pn_x75I_uqHizurI5ROQn0L0Z223hVfds-NpAd9X4xmajy3hp4lqL_eRU_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KAP4M4m9WftWLlw7yflktEXqwevnTIBoyPusKG3Kg6g&oe=6A145C5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaH0kHWMjbkQ7kNvwG50YtX&_nc_oc=Adq0xvSxRvaUTo1VD_e0XfKF6o_vKePfyxsE7U9n319MAPVpmFaoOu9ZUKfJqfU1XiU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ekxsYUxaJnlQIGIN2sqcUI2TlqbX8GwkbZqLNEoCKXA&oe=6A1472E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2xdNxin-IYQ7kNvwEhQLmy&_nc_oc=AdqEam6pan-ZO_L-9AGYBJIIF2aLx11uR-aN0a7eqn3zYS7DbFYPOWxlocO4ryVao9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61-jvCX0CgYiTynHFufkzFuK32ghB959A8yAWXAxkAuA&oe=6A146386"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo9eKgcB9_wQ7kNvwGWVjA5&_nc_oc=AdplnroWY4Nk86hvzrzo31vs7UMiiwY1xsbmYh1MJpG00ilveWmgHf1YI_JRk7yhReg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UOJhUOC6eqLfqwuT9OC2beFyTHkViVc5CCX1697ZVbw&oe=6A145F70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d32IJ2YmCPkQ7kNvwHPhr_M&_nc_oc=Adq0FvN5MA0nUVpPnzYxOD3qY-PZNDWJu8qVzt4DFmcy43OHs-Q1VQzo53_xq5-Z9eE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H1-XRhvRB9R0ShOeBy0HjYrZ-8P0qxE_Umi5fIQx45w&oe=6A1452C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
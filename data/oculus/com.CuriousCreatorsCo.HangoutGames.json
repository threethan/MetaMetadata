d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tptZseXPv8Q7kNvwH7KYuO&_nc_oc=Adoc9fdgUhL91jnqetHfrBQwVJK9tf9e6zj_yV0VvmzrUiMFzAxpeE4CB--4f38Mt7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByZNbvUS_jZxW05Yy8g_3rVSCiOjna9ZKvuxJcGZJoNQ&oe=6A676ADD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96AFHVRqf_YQ7kNvwGG0ymK&_nc_oc=Adpvj-Eeumm_gvWKCXCCEkbmHQGeTmw92GOteG61zJ-3XSLr6D7W9Wko11SiQxeSXsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoBiq4TCpDW5YwAfnLPnjjhQF2_ErvHtAi-OwQq8XTQA&oe=6A674920"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E2nEWDf85YQ7kNvwFv6Ver&_nc_oc=Adp2XM7vfGJTYtA5p1rvXSYM_90a5mq2qP93rX5XCo7u4h1DGf5mGnz3Et6HNg1wV1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4hJ1Bpxl7Ld5fthTET92mVevCMS4deOJ08Eo9KpErjg&oe=6A677206"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpj1ZNkV5qgQ7kNvwGJMw-O&_nc_oc=AdrahPviqpkUlU3FJJGm_Yv4dq6xpZxnXTNoNAS0MMX3gRq4qkBp8KJgxkuyT9L3oBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9tFjAnzLvXniAC4xrtzLpXg9IiREai6tiJ5jBfmtndA&oe=6A676DF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07kU_D97cPMQ7kNvwGyBQ7U&_nc_oc=Adr8MgAUsQvnY_tV3h10_NQTdRVDwCcXK00vGVfp7VXHRYEBemrwhVVJ4Pz7h8oquMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDxvOD2HS4rY5pbYtSTFRUXKSNCZT_UyyR5-hTVBjnwQ&oe=6A676144"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
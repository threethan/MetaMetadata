a3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQwSTeky3NgQ7kNvwFL6zdb&_nc_oc=AdoibBzTC7xgguPmUcCAhCSg4P0jpMkKsmnSY1o2EjYr63e-PevWKCFNU1P2fnXkZOo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-au7it-ozLKKWgskA3N9fl1QkiJDnMy1tJj6ZVv7TLew&oe=6A32AEDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-3kqlCpnHUQ7kNvwG4Na4g&_nc_oc=AdrYoRt4TpGd_hy22bvqWjgdI2t7dvmoJkaQ-QzA447tvY0A-TYmOkcYjrVQvYfXiqg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FcBUuYLTwu_f9fNzVfZFp1DcJojN3SNvNR4d1H88RrQ&oe=6A32C560"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmcvjWCmoRwQ7kNvwHXYYTw&_nc_oc=AdpDU7nsFjOM-HfcpDXAj7DKkujPI9aAl4yz5Y3FH7G5MyDplSKrZHHOjHcc7bVlxsU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_xY8B1SBO8Pfh8XuJ_t_QDa1ZoE_j_gJm3tyRgKMW9w&oe=6A32B606"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CkIsRugAysQ7kNvwFULq1t&_nc_oc=Adrrq-2IkUfYB4Dcd7O1iUo6EVKhkb8RtZRj0MEWQrf2TUgHF50sA-F1JnEXU4gPqRY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91uQr2r2tIZq3SV6mnZGLqRmZLn4hgLysYPoHVvTFO4Q&oe=6A32B1F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2CpzhbUEMcQ7kNvwHe3e80&_nc_oc=Ado0zcewse0ZcZEjsowpuagSeDopN8FrafPy9jpP4aytH_2BbIaoJWulgJ2hxoVZ5ZU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BN0V-wRH2yGSWg92TqLEGaOqg9t8-1Rkrs21J-_7RGg&oe=6A32A544"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzEa_3WutNYQ7kNvwHbd6aI&_nc_oc=AdqCp8-E2-zhB0x5IesTqiIDziOFnJaH3uov4nwcQgF2jnIgkcJkYx4GoWxHmPdKKQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvDHkIiJSJmmtlelrwdAJZEf5nhTmgqGvrpRXoVXsraw&oe=6ACB9CDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRYC6OiNf1gQ7kNvwEtfbqL&_nc_oc=Adp2Ti7uFbYX9wCKMe45OpoxEJ1ypCWi5UXVgtlLrW4UIYugIsOXzwaWp8FNI8-6FM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQlyEvnui1vd36rIACrwcfc-_h93RFrCA_xxp6oKhA9A&oe=6ACBB360"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UKLW60enlYQ7kNvwFo4OjE&_nc_oc=AdpH8xbMfgL88qRM9ja9N7h4RSphNFusiIoMNTSEwcUC7HAhWW9E4Am3HokCuwEUVXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc3SIlvJ8NscdBm_yIE8Q_cH3YahtFesxXYbFP7osdFA&oe=6ACBA406"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmgCfoh_Li8Q7kNvwHUxK4w&_nc_oc=AdqyuInV4HowBmrDrNVNeL5TFt4aT0zU-IKE9f2kS-VDGeZqFzPrJp6hSYg2U1YHTVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk7Hgxp3A76VAGF4NR7MoxI8AyH-y0d4P0S5PHyMcrhw&oe=6ACB9FF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C2z61sUrb4Q7kNvwEEqght&_nc_oc=AdoUzZfAs4Z4v3JtqAqWt3z-FF8zwN_C8TqDUnsCPjc1vPcPGsGf78Kiapkqhaxai8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyhbvmSQFrrbJ5BN0r6B0-JlnslUKbgbrQZ62wvtowfg&oe=6ACB9344"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
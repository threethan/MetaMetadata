a3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F86QpAa_j70Q7kNvwFTDaZ5&_nc_oc=Adp50OJOMdYwN81tz3mjNeRRTUTBegwl8yboEedfUn61qS4I3LkY2lTlqS1VrfR32nQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSP60g0HjPWJDTfRG5StQ-LeId7nyW1DdDMxWA5iiwyw&oe=6AC7A85D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-HBW6FxaUoQ7kNvwHsp5HU&_nc_oc=Adr_jxJBUUyEe6gvK2-fkyjwjzxVdtdpvMd0MvNN7HdUdc0I_8xHpHQvKnHqWrCOTP0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK0xfgHXvnFUe4K-RrEdXrF8EScTrIxk-CMQj6aMR6ug&oe=6AC7BEE0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxA9QvxEVp0Q7kNvwH4_9V0&_nc_oc=Adr1ZwEianc1QqVo1rumH2XSoH0Ey7dJS3DDrBwKDi7NTe8h_4PcGXmVU_n6TUCgYMU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyDXybebWqSR4P1q1suVWq8cb6jvMNIOMXtEPge09GnA&oe=6AC7AF86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEJJkCo5k1UQ7kNvwEwfJyi&_nc_oc=AdqFkWUJLsDDpqxAjUncaSMO_casrJsTxpnfow7vvB7OLhJjewvNfHK4iObwqJyDBpE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx47lRMwmFvJslq4_zTUzoMVRjNkLNpASXH2KRAjc_4A&oe=6AC7AB70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqm1iZLxkOIQ7kNvwHVNA9t&_nc_oc=AdowmKvzuhNHQnGi0jSQMHj8VctYyHLyOnOxzng6FdnrpjLyyDDBzjWKEFPD_TxE8C0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK4yTyeYg5fGuq7A0xdS3Pz9OQwrPj7Ew1CHryZm9ExQ&oe=6AC79EC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
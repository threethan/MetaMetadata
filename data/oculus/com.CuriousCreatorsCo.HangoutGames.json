c3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O-fYs0JH_YQ7kNvwHmQTAv&_nc_oc=AdrXmey7cOVGStgRAMx4GtUJRIx7Si4Iziaorbe8zTGVSvaVTlgSPk2TwYanAZ1TUao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bFKxF16MaFIQiVYQeodP7UzAyQM5BnsjCUMJMmwUhVA&oe=69FF445D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg2amx-xmUYQ7kNvwFLyHN8&_nc_oc=AdrX4wGo0DvaZ6SWTlFRTSznwlpsIEfHD198JzMaZAxVdzCr9KmKgZ-GRuvPvM5cjh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5345886LS0QAxfZK_oSa4DW7rQ_-Mahss3yc2l6jcx9Q&oe=69FF22A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbUIoD2MUpwQ7kNvwFGV3Y1&_nc_oc=AdrLTh1Ld4fEApKSeQFY-yPPC14JHK5QDrTzlbqLBzTa3eLX_omy96dl1AWXROdX11k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67u6UTidjhGBl37b35BDt-8P9UcQgEk0GUscICQy1_Rg&oe=69FF4B86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geIR1relo5YQ7kNvwE_EDoM&_nc_oc=AdrYDJ9Vy2w-ug4IVw5a7HAO6V4oixrQtskTg33_OKTLsBZkLisvQLFeQpWV0jVRlvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48AdZj-OpwZ-1Xpc6G2nFWBHEs5UBrV2hFV5D2iVGTvg&oe=69FF4770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WvjxpYep5AQ7kNvwErwvZd&_nc_oc=Adrlwh3Puw_LiYWo59E7Zc7PhH9qvCQICGjrhYVfeXGdsdysEBSon6LKIk5-q9wPLDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K-MA7TMw5qX6vtbzR_ufkMRbXELCPlbwPzcL2vJa1yA&oe=69FF3AC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
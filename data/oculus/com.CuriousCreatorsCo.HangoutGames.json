791535147534_n.png", "id": "573769781100075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630185_573769784433408_4874436914141267503_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGYyf2u-j0Q7kNvwG9MwGg&_nc_oc=AdlqoyRu4EeTseBV1XK-8gCsl8dIm2HKzuZ1ZHafd3nwdEwd5ncsBNksiDWuFLqF5Ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvV9Um7Pnl34ZZUbJpB4IZ2lZP-KRwkbOsaUZAPuGnFBg&oe=699ED415"}, {"file_name": "com.CuriousCreatorsCo.Formation-20220712-110717.png", "id": "3325514594359241", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_3325514597692574_7713797041680217542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tN10nyijNqMQ7kNvwEbIuHr&_nc_oc=AdlhkvNn0HYROdDLrbNpy6B46W0LHxuUOPKcExId0yJFAYAlOwkofPsQJeQUxbNvPKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsn1NAhr_u4xVEra3lPGBgFJUQkpNUgQGbwBlpSX7Oxmw&oe=699EDEAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hangout Games", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copycat, take turns drawing and guessing each other's creations. \n\nCodewords is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nFormation is a game of luck and strategy. Make a sequence of 5 cards in either direction or diagonally. First team to two sequences wins!\n\n", "short_description": "A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id"
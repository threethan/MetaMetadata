a3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVhJ0vwg_yAQ7kNvwEf3e_3&_nc_oc=AdqJg-Wzn17F7iTrUSuCYFNTkql1_Qtk-vVeMGB1zKMnZ4Nh0BoM-ixk809Fm_UKj1E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51FjAvlNkve2hpvQekElriK_e0rKKV3kQ_31PutdpmcQ&oe=6A130ADD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9W4IdZzTmF0Q7kNvwH5_m-K&_nc_oc=AdqW-LQkBDV3vpSef9qfGLZKyUSiHeS524ecF8F28h_23_hp7DfAOk5s5oBeYXZCf9A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FzKAtEFYd0CI_M4hrkIMd0QYd-84N15iONaOSIQfV4A&oe=6A132160"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaUVaVCW2s4Q7kNvwEDZUPS&_nc_oc=Adp4qe4YvLGKvS60VmcJ9tlVT9dxX_7_M-1m1edmApCb4wUYJbreC7h54jkm3290mXQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ABsSjlbJPJk44ks7fzdhF6Rsgr1ZwfaSFoiQ7g6Hn8g&oe=6A131206"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo9eKgcB9_wQ7kNvwFjwIY0&_nc_oc=AdqLZfagLYxDrw0YCtfGJYr8NoEhig5VEv2G8l5wFW9Wmv77IIzTShg8n-s0O1rSaDM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_13PG2nsh1A3nahax44qfSkajzHZJlAhClTCKfgg8iw&oe=6A130DF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d32IJ2YmCPkQ7kNvwH94P4N&_nc_oc=AdofVzMp7pKfdtOVi0Lkwu8Qq-vsLKZ8thwHPCYm3Pd0uNrkz4gVGegXweHZs9UJtE0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mGvu-zB7rqUOnCyOwEBzdmUJR41WZm4vUhhNP0Em41Q&oe=6A130144"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
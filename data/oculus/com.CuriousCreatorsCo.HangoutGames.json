3181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9wa9B_S0koQ7kNvwHQiQaV&_nc_oc=AdqSsPwChmI2Pco0MP9zFD4zxtCZOsHf_XCPkvA6Wtn-Ra8eehsMQrPoIVOFvclMmJg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aUoNH_DU_3o9RbimTy8SU9UEFt9kNc5Qw5Fh5yLldcg&oe=6A11B121"}, {"file_name": "39031433_5170499593043967_5647460791535147534_n.png", "id": "573769781100075", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75630185_573769784433408_4874436914141267503_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLBGC9f6CpQQ7kNvwF27BS1&_nc_oc=AdpJvF6saSs0cRLsGJHg4S4E5V64t-5RB8emO6I2E-Q-nseAmXg6fiAGbTn6B6B_gCY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rmdrCp5QDP8L5WtFd_7PwO3ycQCZSNhNAAX_abQtt3g&oe=6A11BED5"}, {"file_name": "com.CuriousCreatorsCo.Formation-20220712-110717.png", "id": "3325514594359241", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974738_3325514597692574_7713797041680217542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzJrgG2bdrkQ7kNvwFf_hvm&_nc_oc=Ado9x58qpDAs8pZ3waCpgPJdp-JsXsWHo7vDWf9fO8y2yrMJYeapt1LmnscuSRHOcv0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SGDAcINw6QiG-w_qg0miXymn67WDP0i4IF7qR5jhL5w&oe=6A11C96F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hangout Games", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copycat, take turns drawing and guessing each other's creations. \n\nCodewords is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nFormation is a game of luck and strategy. Make a sequence of 5 cards in either direction or diagonally. First team to two sequences wins!\n\n", "short_description": "A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": n
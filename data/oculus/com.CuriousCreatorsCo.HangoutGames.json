content-sin11-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWP7Vy9AfGIQ7kNvwFoXiK4&_nc_oc=Adr-t-gLoNLsum4yjFbGEwhw6eKNKMJWO4lXSC4mBWl2DBX5_y93OS3HyqwsrXNN_Uo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i4ZrIupCPgLn_hW0BpJl6GPaRtgQOACvYAEBEK-y-lg&oe=6A39465D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQDIvNwaJtQQ7kNvwEqsFF4&_nc_oc=Adomi6WxK6Rj7oYQNk9e3xB-8zLstjd-ycPmXfW8Yj3SblrDYTrOCkEh_SqUAgWnbkA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nwQ8MLg-tgcIyqGZ0AFnNTQpAauQ0fRunG0bb9lTRZg&oe=6A395CE0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdC6FyOZhfAQ7kNvwESOeSt&_nc_oc=AdpDUtooLYYC_0Q127t_lM7wQpn5BigFgKaRUoyOspsdAZ-rwIVFk_aOz8EtX-UXllM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yLVhXKcn1vuyyzMoQJX-U6QA8jZ1CeYQa1_9_KAzWmQ&oe=6A394D86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozi3vkrtwyQQ7kNvwEnXq6O&_nc_oc=AdpX_h7C9Nvdq_P1P5Ub1ZY6kQanTX8lbZUWcmWBvklFCJyz-ReGwJmJCH1Q9BQJHxw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pd4BGp_vO9HoaaluMbhPgFjBVPgBlioSusqZC3ywhtw&oe=6A394970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB5Yjr6iFdMQ7kNvwGUouOS&_nc_oc=AdqCdUr-Km3qtCW8DcGro1WiBV0ucbe_AxH2-6JXlbbxcrVrUN2bg2cE6Tn2KbpcetY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xU69cXQP7sAzDamFcJ00DcUpVXmU-CSyMHh8JIMHqIw&oe=6A393CC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
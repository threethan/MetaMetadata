/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYKRkBd9eI8Q7kNvwGBY2sa&_nc_oc=AdlpBTs__dFhTKKhbgk19YJpZh0zCcqf0RkXA4t0mn9DIVfZd6t2iD3RCRLUjo9MOjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRd514ZoELm8tW8GptTmLLefp_oN17PTecMQ_Dlg7-2g&oe=69B17BDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwyV-ts4cqMQ7kNvwGbYeW8&_nc_oc=AdkkYIY8sQwoSbzYtH6EbOLLWSwXIUL-m4lgh_w7kkdyaSUiz0sf5WCndSVvA2ZiWXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcQHlRqGrzYM1aOv-rS_qvfVwNGYOv0hBx5qy9MX_7IA&oe=69B15A20"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eOzyF6AcgUQ7kNvwEqA-tk&_nc_oc=AdmmCtR4Roaa3aXhb39dTe-r3SKnGjpV8eNHlGrKIdoY2tajIQRHD0ey9Y8Bn-z9pDI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRczLHjBQRsVl9mlL92z7N8UsLcRFhwZwId_qGMztRBA&oe=69B14AC6"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsJ28hMJjbAQ7kNvwEm-kjO&_nc_oc=AdmGAoHyakBE1TJXO9Hoe2ChED3mOhmudEpjW5NdvpaVj6GgjPQH6Km0nWezTrqBNVA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxmmDOuUKlbX-U7D2WAXJhJMLb9PqBNcfv-S1_EzK79w&oe=69B146B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4m0dp9lG4wQ7kNvwG72Bpd&_nc_oc=AdkLME03lda0B7TCPW21LAagqZbmMT2sYB6fb_fbOTWzuoHcy9Jqt3M9wEmHoQy0i38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxDNEqDHyX2yZPogRqUT3knE21ikDrt-f9L2RhLxijGA&oe=69B17244"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
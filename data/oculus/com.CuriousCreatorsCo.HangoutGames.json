d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jrEDNZIJtMQ7kNvwELgNXt&_nc_oc=AdpHq3GZAKSxmSBsP9huT9ibCuedBcNdU52W7QInGmVpTnbvhPcNr1oDG9QykEZO2yo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnsRqpvbPyrBu8trQAT_U5R09qk6Y48k2Xl8YFF95Nyg&oe=6AF71E5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I30wlk0mB7QQ7kNvwG3-Axs&_nc_oc=AdrieACYaB2AKjCjgEUFt-g_Q_Bv51am4PgfzxiIzVjkIXEOo0uBhZNFJtpFwaH277k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7ctHCOoxsp7osy4M8lrJ5yYeSuFyWiJVAMPhGR2HA6A&oe=6AF734E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc9GtK4potQQ7kNvwH_KdKv&_nc_oc=AdrcsFkwimy0zILhp5MhHYhQjZtisAEapJVH_LHVVsbyIQSp-pklBaqSZxwCcfmdr7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq-YmBu7qD-RKHS9bCmN3xSjwjSozCPW5pJm4jkDyK7g&oe=6AF72586"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAWs370c1mUQ7kNvwHOo77j&_nc_oc=AdpVzw4m-ZJyfJP0NAKZrcsMDJ5V4HDUJpeeEFsS4rlPXZ8AMO-Anno6YodXTdB6iHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4SdtRvxI_abDdOh_T816AlpQU7ojEnQ9DMDZoej9eTg&oe=6AF72170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZxXtvoHghEQ7kNvwEGHqWU&_nc_oc=AdrwpeyreCZodmCO5aUwrvaxpc7nUI9w8Sew0yJYkXIu0TSfxaEylRl580Ju0BGuRlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPsYHb5Wqpj9aa-FnN2ri4xTUUQGsMeDNQok8ZloxpGw&oe=6AF714C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yBaw0hYDnMQ7kNvwEpnthb&_nc_oc=Ado3wX6KgVq6LjoBnPQULHIz0G4NzDVsWZdUsp4hlQAte22fBD8ICvmkXCTLWHsmmHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af037EBOjbzvy1vOBRxOtrkXKI8Y-z2xKaAEWvgHC0u4yQ&oe=69F75B5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI8JtecIl6EQ7kNvwFG-yLp&_nc_oc=AdrtVVNqHzD5VdOXlRUtwOjyRjLaZ2QdZkJvCwFBH0wKVq75SyQ2CV88cfZRN9YvQH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oYXzH6SuvnI5Uz7rokO7-g2PrIHT1-VBVJRC3xcxZ6Q&oe=69F739A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnCcCcJ6laAQ7kNvwGuD6j5&_nc_oc=Ado7aKia-kk_6CTUm1HrlKTWXSjt1uvX7qcOfmJCYJRqaG9zj-w-Z6PtAwOk8ynx3lY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2l1H-U5UJX8U0mgZ7qK7NZrSylAiMLRIHeHb00Dr1XIA&oe=69F76286"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEGi_YxUCDEQ7kNvwGak3y-&_nc_oc=Ado5pExSBvePlUggwO2MmL5v777DTFGmYmwlP2XCLBFE2Ep0sSV8CBxsv_K9zSHNUJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dXoiAwFMB5d_1KNh8iAYoZ7O2DP0sKhlmEYsmkM4Waw&oe=69F75E70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gphdh74_EogQ7kNvwFzD2BK&_nc_oc=Adq2TgjXPQ3J3kldq3AhO8xJDdTtOew37iUiDHs5kRG_KY0F2By2fYkOivGuL-DBzkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hkr7obNxuO2yhh9C9TEosjXuRAWzDFQKYuXYZbh0OEQ&oe=69F751C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
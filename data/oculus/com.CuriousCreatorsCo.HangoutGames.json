r6-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98lHzfIbjXMQ7kNvwF02ePu&_nc_oc=AdpnDLMHmSeA7sipLOEaJs3w3syjyvZxA2IWuwFr5FTh4CDbUjjQJg5nGlKmwZCGA4s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T-hnQ-LGUJCemJlAXMY1kXZjR8wIQqdGGPzlAvJD1Aw&oe=6A1C455D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzQcE_sMI8cQ7kNvwHvdgWG&_nc_oc=AdoRQihuqPqp3rvGkv15_wRRmVdJAdYuccTfDZo3kZqauctULfxXl-f6HBhBMG2Fpiw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CTx9LbDeZrzOS3c2q2un6g8BhySS2lw-_SI21WCFwtw&oe=6A1C5BE0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRctCyxyjhIQ7kNvwFEKXzH&_nc_oc=Adr2BFXSqaP_-_qEzbss9xLtcQr6FMqs2YfwvBvv9hl5u27HtSzPs1_OE3fWUbVQCyg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c36owdwufU9561mjFNq1b4uZaQdZj9eWdPsKqWRQ4UA&oe=6A1C4C86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOB3TPUuJyMQ7kNvwEmVraV&_nc_oc=AdrzsfPHOzowBlem2nFzYWvQ9NWpwPgkqX1_5mc6nqv1wtSrCmoOC10afumZb_YFvMg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OBnjTLEC-H-M7mKnfdDtWjUY0NH1_AHLSlreZiXAiOg&oe=6A1C4870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQS1nViIIucQ7kNvwFzKXpm&_nc_oc=AdpMXTR8RmLBzTwIbsPl-5YDvE_m_jSYFz98zpLlbMKKMJCpdoVj0BY-zU11O7IXWs8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-lPh6CH4u-lYrWAGpwzphaiIlTJ38P0AB99VogP8Z0w&oe=6A1C3BC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
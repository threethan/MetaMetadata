content-lhr6-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwSD_gjoYIwQ7kNvwFVu8WF&_nc_oc=AdrnRF4R3e3TrMxrTBBNVn79hoHfG_cbKU2aw7QgIjY7TM-IfRckbhWGUrYuXo3JweU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg_gZ8h0cg-jYEPn4QPrC61NlmMHQmxSNbKDPDx_k73Q&oe=6A8D6E1D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTXiXLF_bzEQ7kNvwH3CUG9&_nc_oc=AdpavvRsGr_pTWP89xVgyJQ85tij02zW3tsmFdH6lvICp-CN-QrzEcWw1YGrmFZVTkk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM_IHPlCGqnJME6wPQ5X9HyDXV4UMCF6cko4044ARroQ&oe=6A8D84A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tMmV9YlmuoQ7kNvwHc0mbB&_nc_oc=Adp37tqoS6JTfJ3E4pXXCzjl5sHMgqMs9CnWPheQ2QzQPjfMuOgG4jHFGC9_murerAE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs_taZhpuN0iJU236lGIUxPe2thsbmphAsnU0VVe3zBg&oe=6A8D7546"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGMlCyOep1wQ7kNvwF3OIed&_nc_oc=AdoZ1mRL847dsKfuSzHciL6r9wTDck40aY4VlWqcDuioGJVz4XWF170Nb8symQ21Uro&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFWPcBZvC-g3x4FmrnI6zvAs_N62AkWagYGAWYm6Zm4w&oe=6A8D7130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFYBqCNoZA0Q7kNvwElwXM6&_nc_oc=AdrLlfH9dz2cxIUKC_gJpppdTH-jsOOQRXxgYy-Hdzf2zLSUzNKz1GasjclnFA0a-4g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf4AheqKdbwncd6Vktto_xMq59bjRNUGyb9JgRrJcKJA&oe=6A8D6484"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
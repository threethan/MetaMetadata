/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHYIc80-Y-0Q7kNvwHziCn9&_nc_oc=Admv4lpklDlGD53lcy7JIKzVE-3pKw6hkDGbmRMN280X9qeXMJbvsaMV-K0nuCfPnAc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlpK2Ew-NX1g1zhOvx9RdKzOc0XM5c8S0GcVf6U8ax7w&oe=69BAB65D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NotI1qiAnjUQ7kNvwEwZ5i7&_nc_oc=Admn0wBoCgIOO6rMMmcvlA73o-vK778dTrJ-5WEeJ6Zn0tp8Ds7pjm4bHLVeq00Qa48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzX4rsJMAsNn6USQNABTnTpx9XhhbbG7pTAkMv9jh4P-w&oe=69BA94A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvJxjf2ZdAcQ7kNvwF2-PHQ&_nc_oc=AdlLbJU9ce04ChdY75MoaddOHWF7xPiYSFnmAt9X3fMGT5cGgbFNhrVVPDI06Ff7138&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkPyfvr922wLpdQGq1DAVBZ7nYf5apLMzjqkqJaKBrOw&oe=69BA8546"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9izPpgJDCb4Q7kNvwGX101y&_nc_oc=AdmAZ696S-wm9MQqQVcfTDZ3clhKWe11pckCNhNtkKsWaLKcUQtKhbDsyfRk3gxAMCw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7Aj78kD29pWVYmyNMmRufkoq9tWHk0Zo7I3RLPDgsmw&oe=69BAB970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuIyD7__xBUQ7kNvwGXy6Yj&_nc_oc=AdlEge9N0Cj-8frx6nnAf85-MFVyA7-VKsFBHaRArsOGNjTjXkODENk0OZ-i1kQG_xc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1GK0CuIGFylgSXxjHlOfIXsQibxHTVx6PBaL2m9LJMw&oe=69BAACC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
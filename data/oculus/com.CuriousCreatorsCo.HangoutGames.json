791535147534_n.png", "id": "573769781100075", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75630185_573769784433408_4874436914141267503_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjHl2owMfz8Q7kNvwFOgpTP&_nc_oc=AdlPZKRbTmFAVAZw2oWeD-dUr-HMjn9BqHtwWfTHjukimFZlHELD2SIYbsNr991Klus&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftIoXLM6M2MZKJGJAH0iPv1b91Uy-BdH1Gktzb2gk1D2w&oe=699C3115"}, {"file_name": "com.CuriousCreatorsCo.Formation-20220712-110717.png", "id": "3325514594359241", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974738_3325514597692574_7713797041680217542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b7DjQ4ZP-YQ7kNvwFrZQZj&_nc_oc=Adk5F6ebloAOGIn-ctp825BXZh5k48-yAodhFEzrQYZVEj_ceqxVX3m5RsHFxH6NIB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftLFgr3lDF2H2-9uaXah8fFos64NKOPucIErlAtaL2UoA&oe=699C3BAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hangout Games", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copycat, take turns drawing and guessing each other's creations. \n\nCodewords is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nFormation is a game of luck and strategy. Make a sequence of 5 cards in either direction or diagonally. First team to two sequences wins!\n\n", "short_description": "A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id"
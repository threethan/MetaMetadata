d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3NQx5_c5ZQQ7kNvwGNzZy8&_nc_oc=AdoLib_SIzEMPzms1qDDUY56AFaBRUtmTIQ7XMjs4KZDv0CQSs_Ki426MRHua6sCpzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu2aCpQ95VG5CIp_9QjCRNG5wGnV3qEt_NE5cndc3GzQ&oe=6A70A55D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzBnjPaffVkQ7kNvwHGU7Jk&_nc_oc=AdrX9HOWvuig9Fq7eKUpw_n4uHZRFk8XyoSBwhWTQKuCwNFvFVi0ImMvcb33gxuRMrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7DdSApY4Q9cOa4SK0qUr_6_Y5T0Mj3kdJvbaLNGjClA&oe=6A7083A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG9Nr6ZdHVcQ7kNvwGDonRx&_nc_oc=AdqeGmUtehCm4kw0Fv8gJcI4VLIg5ieFVarDYjc1TrtyfILUZv-Q8e38FYtZ5Ku1aY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGztCxvo8_ljmTqrmXs6_D6aAqIlSvhF7yRwVLduUg-iQ&oe=6A707446"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI50MP1KsKkQ7kNvwFIhgu2&_nc_oc=Adrn80RILrHQziQdmsgkkAixcS7Vhl10OgIvXM4RwSHueUhu9uYs72CAyUHzOPbu_LA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdfTKC_2vMnyJvhng4jSiwXvuy_LJp7Vh3VTG0VEmAow&oe=6A70A870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfCZ1RDVZEMQ7kNvwGnGgXI&_nc_oc=AdoHI6ZDiKkNQO6HTkRoaJVLo9VuKuEhw2_spkb4e6kMsLimKpa2xjj3R-CbhukCNqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGszA6gMbTGF-1nVpMVv-YA7Yn-QRLRkLwt9_N9scm1Ng&oe=6A709BC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
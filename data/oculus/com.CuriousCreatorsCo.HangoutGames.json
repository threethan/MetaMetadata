d6-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz_Z5-knF_8Q7kNvwESAucT&_nc_oc=Adqf7KQ2ytCE9XTjjlnbUsEOBGIptLHxktkpchE1IYffwxTOHeYXlgDdiHNp-TQ3Ag8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_YUhL2a1cTvWnCPrGRzMJjEm6CbTpJTVmz24KEhNnpA&oe=6A257FDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgmA2QeEPsgQ7kNvwFiUc-F&_nc_oc=AdqkAU7brLefemV_mCxHQJUqYYgj1U-NZIHY_lR7laZiNBu1hywbyrODpy5WL_CwRAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AXD3xLHuNoOjP83UGcqcv00sxci4W1VflfA1sGnOIqA&oe=6A259660"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIHSdjQUPqYQ7kNvwFj5HSY&_nc_oc=AdoSRZT92X217coePidECXMhbQ-x_qb1r4OJwdjZkQX8TVLRoriMJcdBoYJ8nMtFV4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uCo3yUPkHvuewYGaGmRPjoKPoXhgsNQ24JL3eVMFd-w&oe=6A258706"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT-p8atwJD8Q7kNvwH3aWCq&_nc_oc=Ado-obM3weRNpwRV6mFCwlQmvNTl-LG_0HwFQ9JnnL00w8nyXBAgZSCi0K2Q2Hpe4Y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V1kA4LFCXTXoTT1TKb9OdUelJXRtYdgwBEpirXOFZNA&oe=6A2582F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VOnx0pHcdQQ7kNvwGusbnb&_nc_oc=Adp-KAhJ1rMe4n_vglUrBJRbPFo95PnFz2x7bLNBSHEuYrwxumrapXsbhLn0Z36KM8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nxTSLiHLbGzJQTcWdpP4gn2BFxR3A2VQ_LHg4VgbAdw&oe=6A257644"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
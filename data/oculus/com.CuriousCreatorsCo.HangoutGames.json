content-sin11-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZFJXxaNYIEQ7kNvwEnXNxv&_nc_oc=AdoqNwoCW0ie-4fexEVxufgbGlidUTKRKAUoPiSWHlVS9BB_Ga1XW8_cfpbPY9j8u4s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_0Rl7B0FD1MWEdrIyTTr1XL6qzBEqjNgC4lhAdv1C1A&oe=6A7D9C1D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzJjhmul56AQ7kNvwH81E4e&_nc_oc=AdrA4IR_PzAgn53FUqGsn7rmtvnvl_iu9fC50zNeaJUmS4GRoY9jCRYG0etchuFnDTw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY49iEiox0U-QtVga6kGmurSJQ9qNxGCziqKl6IJ_OQA&oe=6A7DB2A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIoqi1Iq0ZYQ7kNvwGPU7Ki&_nc_oc=Ado6nsmc-wme7ZAd3I29MqC0JRUtIKcBLb_qMu15uAT3sLp5djhQm27At6RZJPERTng&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7DcP1Z97_Ayqq4fo4xihxIevY4q-HVYX9F9CCj9t3_A&oe=6A7DA346"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6crjk1fK2oQ7kNvwGT-Jb2&_nc_oc=AdqRqTuoGFPe6z3i88W07qs1ZQuHO9Zd90goKcM5wBly6LYClo33Tz5FQdaIzx4M6F4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmq2511ZCpSJrFvxHmqFQ04sMDEJ9nysPBzB-bnLOXBg&oe=6A7D9F30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0tpa8myCWMQ7kNvwGvikgR&_nc_oc=Ado7LDm4WEMfIX4mHYBqNU2_znJ3GptqtUbzI-iM68tywGMfKVArh-qfsrV-wAXtoU0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGu1zS-PVOLNI1MPZNpltjEiSyZm8ATehegfqkmEAaFw&oe=6A7DCAC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
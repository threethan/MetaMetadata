d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_-uOE6-fqYQ7kNvwFePdVr&_nc_oc=AdpcN7ZVrQYL4trB8liY-JlXppXhgeDFM94tu82zX90Fp8KPDMg5mmqpfERBXbgG_OA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuDDEU9f7XVgvJ88ih3r_FYKHEtGxnVYxSldcgptAO2g&oe=6AB3E1DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sjG7dLHMvkQ7kNvwGDzUhs&_nc_oc=Adokf_f0LaEM40X3_-vSW9qj-EcJDbP_sGJmZUy-EBEaZa8bl9pCVhWHP4qTkiRrtAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIalC2Xm-hP4-8bE1bDwsnipxikwkA56927o1X_HcmwPQ&oe=6AB3F860"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPEijPZ5DecQ7kNvwGG9g7b&_nc_oc=AdokoLKRG02c9ggZTQqUtvDmH-woqrNFGNtbUGMVidyy0JBf6o82pUjHS0JFwSXyTXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxMbG1yofIP-bIvmQlxePZXCl7vpSCY_PJMfHmMnUhAA&oe=6AB3E906"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkKOfBlNDFUQ7kNvwEMfimE&_nc_oc=Ado1TUNlqRvpldsNxbxjLfSy24ltc8YJejlwB38m6vEs1ujLAYwTPkKwoJNP-tAriJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2XwKD7wK50HvrlefLYp8dTGBEw5xOMdzth3Npm5V9lQ&oe=6AB3E4F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xovHNEOiluMQ7kNvwHA0NTn&_nc_oc=Ado7EJ7eX6ZTreSmeTP6iS639u3fckPh6qJQOhj5sez6JR5WLYsLuHjWW91C9U5Sl5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoP6VCyU-6BOgeo_Vyuy6XtqEu5MoTzSEEVvY7gcnl1Q&oe=6AB3D844"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
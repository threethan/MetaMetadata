d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8J1T6LOKpxgQ7kNvwG2mtYO&_nc_oc=AdpP0zOQlJwiCgSkTobo1nl6gVe1zupQvVg0tyJr2fR2lqEKjai1MNMg-fxTQ2WbR0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm0-p5hXSAvgaK7-wFu9pus7df4JOCfxbXjmY_6Tq35A&oe=6AAFED5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BaImB9CCycQ7kNvwEMMZtE&_nc_oc=AdqSF8PP7kYMZrHNAkdc-8svAsqVtRGL7b6oYhENMSTUSMWw4byGKKhA4hRWCcugGtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGn7rBb4iZBOkM-2itZMUN1wvfcokynqzDNeLGC7vDGg&oe=6AB003E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuMjIhvk-aIQ7kNvwELkNfE&_nc_oc=AdrjicNealP-KC9P2SbNshBpYhUtWsw4tkS0yXq6-MaiFd4WjqnUWX0demuD8EqwKtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjtwActFq3lPBzkDYrRTYXFqCZiA_GS9KGUrKywTYiiQ&oe=6AAFF486"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItLCku4NZlEQ7kNvwGsI84S&_nc_oc=AdqwcgzE7DWZGGRFSNqQsg9FRWk4CXMtsdG_XvYhR7cZePlM-CPDTYo7oUwbDThC5Mg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYHP-8gVqEIJAG6Xf84agWHOiakhkpHHizacPTS4tq7w&oe=6AAFF070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp5VSpbYRg4Q7kNvwG1_h8y&_nc_oc=Adppx7eJphCKzV3Q03TPwyiFeeauHRPW5c7hDkNWsWxdSrYY_WZcI5q_0Wa6PQ5c5gU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9hQeKxIQqYQGpDuHYUHEd6J3uGBlJdgzKxmOk1HrlXQ&oe=6AAFE3C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWn0OtkPPLgQ7kNvwH3XmBx&_nc_oc=AdozglBQ0VqpLo77ukf2lAek09k__AUvN_obWknbJBixIyBXPhW7RqUn5btbQaaaFA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FzYwi_XNkGQ0UkmsMhwnwhWjtfgIc_kJX7Xo_yQlFcQ&oe=69EE20DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiOQ_rTMbWQQ7kNvwFL1JDF&_nc_oc=Ado4-iGBlmP1asBcokey1Gyi08XIoxy6FYqjuC5WI-nhBGV3AejXD_7vDKsDkfOryl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W539_986dJHGPURsgr-vBUihyP2dYp8z3gYHR4PuT2A&oe=69EDFF20"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FptwuhqnmIAQ7kNvwFR7EaL&_nc_oc=AdqZduSds13Cd8z_QR2IaWkmZ7a2USf6vYzkbs-HwVBrP_ixADrJTVuycX7LEFArn8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20h3U-Qw7MEnDFYOBY8vkixMdwS9KYc-q1xyyTO0LFaw&oe=69EE2806"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp4DB-DfZzkQ7kNvwFDzgUa&_nc_oc=AdoROwccHgIGqikmlDdqWPopqEkbBK5dMLg98h5z8uTphy7wfav8Lgny3TTL24Qw2e8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DBDbRN5R6KRRXwM7tOo_m6M79Yj_uXQFdh9-jrvHwvg&oe=69EE23F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kujIyxsBZ4Q7kNvwGJ82mk&_nc_oc=Adr5wpF1cVOXEHp2PytvUM5wEpSwF3IIqRGAVO-qK-Xs1VyUE3hWQNxPoBBjsaiAk18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CCZtJibFjxvn8skLYA_7Mo4BN3F4JoGnsPVUOuGDY0Q&oe=69EE1744"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c62KnTnxBzEQ7kNvwEMFrdR&_nc_oc=AdlWhZVc7bqW5CUYh_ua3Nvcqz0WvhsfKhAkizUwRqoDme5d8XSN_C_xoCECZrvsprY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-LLSdLE40LLTlZ-92q5MAzQkBG8zVtJ12QTmfB6j5Fg&oe=69AAE45D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f11s0t26-08Q7kNvwFqlD4Y&_nc_oc=Adm5NFHoINLL7U150rBpRmaQRT8iNPePG33LzpXkkuMsFK7izkd-Rxo8-QCnF1iO78U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGSeHqMPfP3oBPpMd5GHpxGMdUF9BOMJr5FrkdHvTgiw&oe=69AAC2A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eVZInman3IQ7kNvwHPcBwd&_nc_oc=AdlALU8jjPhhW4aRs5VcbRqLHii-e53dEEQSFBWZAJAWB53hkzqjZOXSReS9__e2BLk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afx-wBLGP05A1B4Pe_L914CgL7mpZwwWg72HG_-R_IVQ_A&oe=69AAB346"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO1O1b9_cCYQ7kNvwGd9xCn&_nc_oc=AdmwVhn9qzjjKCa3q3w2R0xN8wiTs0XepxE2__wnLKf2jMPMCUm2TyEsekZVi8REICM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk0A9vqZlPZgcUof0WPsmvOlKma9hkesUs5itAM6SLkA&oe=69AAE770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6HuhF6mxKUQ7kNvwF5oHmg&_nc_oc=Adl5Lh4AhiaMv5-xEi7GenMkR_rWA2SDPzYju4J7slC267kHQMGzHIn9Yzy09kTN5fc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afzo4L-k5j62NkMnm82OeHbChuKF-7T9VYWplyEQtPjGvA&oe=69AADAC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "s
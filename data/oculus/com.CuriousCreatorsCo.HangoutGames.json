l3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByG7pedauJ8Q7kNvwHlCtb2&_nc_oc=AdrUGTzQVfqvC4q2eAjMlNbhAvrv3YCAepdd9i_506Nl1IFoN8s_FUasHqQsYOgWa_c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8bZlS-zCfHVA4h31JRA9QKKF70eoqAmr-PcD_TBtBtw&oe=69CFCE5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QjgGY13EyYQ7kNvwG9ayHc&_nc_oc=Adrk2U5nMZBQ7pl-9uvqXzvDeJU2H2eCYpPa3lhkGnCWOzfGVtVpzujK7aSyLgVKFrE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDslGPq2JQS0w7mLuenz4RhryreR7T2jNcDDucqX39iQ&oe=69CFACA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jYPGDcbaGQQ7kNvwGb0a4i&_nc_oc=AdoEmcOIGS05sMdJvf5yl8cOHQtjQfLdAMEA3bCBiQeR5CP81U8Zj8oTCE12Z5Z6Knw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3EmqRCD0c6QyegsAIdJ5K1NNvBgrzSRIacdP0m0FJ9w&oe=69CF9D46"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iH2fCll3RkQ7kNvwEUi5Uw&_nc_oc=Adp7OGNAS1zLG0IrtrCz-2rR5MogOlG1en_tCPHRkmhToigEgowZhCOrmd4wpjT5rN0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyL3zWN5mzL12SFftjSM2GGDy3KGMg73dDa-__Ssh8g8Q&oe=69CFD170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtKHY3MBiS0Q7kNvwF5OFvL&_nc_oc=AdrYSliwl6uKUbGKi5Cc43fsHRUmPiZll7pzPQb3JYnwLTKmmxwzUTsflPto4cYvjJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymATubaR_6kMKaenmKlS8MyMp-Hk2Wx42MUVlMuc0W3A&oe=69CFC4C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
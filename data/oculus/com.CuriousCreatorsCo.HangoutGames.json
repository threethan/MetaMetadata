w5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWpuaDkeUb4Q7kNvwGipWUh&_nc_oc=Adr_SB4IwxXp-IbABifihSJmrrFoh8MLi7kkuBH_oeQg2zinlyi9s2sqHdNf78xMokw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ztvnx3CDZNLz911d7W1P3SXMqIug0ezj3cHyV7kbaFg&oe=6A0F165D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9YPfH50QzUQ7kNvwFJ7yhP&_nc_oc=Adquf1GtcqaDLgnf3JNegtUcKGzHTxs2_GDAEL_rK1PC9G92DMB-OIiFC_XODE8Lt7A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sPndbUARa13U_RgTRGsENimdU2LaDyXzrZFQHbthjbQ&oe=6A0EF4A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NhWgWVYxloQ7kNvwEZ6TJO&_nc_oc=AdrX-AAVFiHTscQ0Z1V3MRhrRHsp1P_qQa4qMkMpGUyf3EbKZ_8jbXh9lm47lbruPkk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GhvFu7e7H_yhOGCHHmC69Fj1xsvTwC7Zqysda00pf1g&oe=6A0F1D86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvZCjPY5BtAQ7kNvwG0fgy8&_nc_oc=AdozvB1XjhTh9ZqlIwCX08DH0kpaavAXqWtf5_I8rDHQX529Oh1Zm9enFMhLmoqLTx8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xExgrZYytVihWPz9foih7Pae-pGGS73ENBQTxnTO5Ew&oe=6A0F1970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN2Pz2ysVvsQ7kNvwGa2CVC&_nc_oc=AdpJJWp126ZD9b90FeNzRUE4NO4UWET_NTfasFOIolfgpU_-wN5KCWBk7ShghhXyYPY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IZtMpFiNdrEZyOsuBqFJza0Egoe-5x72IWot9F1yrAQ&oe=6A0F0CC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVR9FCHQRhwQ7kNvwECCrdK&_nc_oc=AdrHgqGWFJfa82iHpdDa3ZFM-H8ITYiaYWmpx8OpT33RRoikYhFFY7CNv1bVzRZ8GP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiZMUqw1McuuFEph6F6RphGlvvBnXM2koNAYT_cDTjaA&oe=6AF8A81D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I30wlk0mB7QQ7kNvwH6gEBB&_nc_oc=Adr5dS2RenZrFSWbDqN9LBRKly2a-YUZPJCR4PGUEAlw8NlRIybErTDE66cdF-oF3ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSocAEpIvNlsOHZUaCVNAZS7Ghpq2Q_Cxho9iXxqf2Aig&oe=6AF88660"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc9GtK4potQQ7kNvwEkgfFx&_nc_oc=Adre6YJFN1bf6xuU_Apb7HK4DtuvWLxgeHBymseHtoHvsFw7OFjgPHWUvPLAoqz5Ang&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEsVK6WnACyIQHMZXFoOi6BsWa5GPPCvkkiIC0y5ol1Q&oe=6AF8AF46"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zGgsjJBaOwQ7kNvwFZ8UFy&_nc_oc=AdroscES1i9Q4UA4b9XaDpK1NgI6NVQT3485qeJKq1FxUqwVT0kcKFp-7-rZVtEMXgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvfkfl4Wjp9StUNa9R9dc1nk1t9geTMyAAKWZ1OauPVA&oe=6AF8AB30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZxXtvoHghEQ7kNvwHrRea2&_nc_oc=Adqa0TZFd_KM98o2nGXkXbRmH7DTWAEF6ijj9rBzlnDULHGugAeFXbOxOB6_OGEnVjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNzDf4srGPV-cvzjjvCGAhcLTJLNucIrBXxA24ya65Zg&oe=6AF89E84"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
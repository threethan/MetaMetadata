w5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVR9FCHQRhwQ7kNvwHzEMDp&_nc_oc=AdrNDlmxE2reJ_EHzyFC-tVY2e8I0rZjpWBNJCfacOLEBeZqTcouJYJUp3znY4vSRI8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJEyIkjdEvV9vmISdNP_ll70sl6LVLqZOjNjMPe_gWMQ&oe=6AF9C15D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-UhKQnC8tYQ7kNvwF519i5&_nc_oc=AdrkldSL68TA7zY1wj79YiVwkd8vpxgEwxlhbWQYwbOUjSIiLQJ9eHQ-ZFDgN8z82hg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBhYLLJavGfyQb8tbqrCld1_zrZ8iu7fYJFdKPxcSetA&oe=6AF9D7E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dICQxJuwIccQ7kNvwFDSd60&_nc_oc=AdrjBBa1NMIrCKsQVrpX5NB6hmAq_l59dcLIivn-KcmAp9iptMzMzEQNraDEVlaMRng&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkM7RNt0mh2LYxJLU85KoTjAVGbvg4YdPKvAoMvWwMXg&oe=6AF9C886"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zGgsjJBaOwQ7kNvwHtsC5m&_nc_oc=AdqfYzjNvNknROnQ7QKtTJ_MYdWduM-7u8k6zE9SsUKG6D0junWaZvqwB6_2zKPL668&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSetVAOSkvy4vmQNLI1iu8aYii-fjAIq7vhht6ZcwAZ8A&oe=6AF9C470"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZxXtvoHghEQ7kNvwEAhTXE&_nc_oc=Adr-QPmIJlRPQCd3A3cYYZESqOGCMl8uUZuw92ZWUuZbBVVN1yYnZ2V6T-1XvEDy5Mo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYS799SrD--DwtNzQ3lLKHBzRboCA6lUA1piOWxsoI3g&oe=6AF9B7C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
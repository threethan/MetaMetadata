a3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1Sfo0Zqk8QQ7kNvwGFFU12&_nc_oc=AdrcUBdRCjSbiZDDmCPPVdSy7LUF2O4o7qLZjTa3zFLb8kp3QOvm1pjooxy59jLFsLY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EV1ZxDOSqovy5qVYTeihT9vFSsjbt-btSUhFshsqEgw&oe=6A2C175D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxS4vCHGBXwQ7kNvwEDFg8g&_nc_oc=AdohJUpWh8mm-4B3WRhc2ZTedQq7crnVgmlMYwc0fO14PdAIihsaEmqApbjv8djEppQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VB1DTGBG3-S75-7DlE9qbKsUywJmYxLb20wVypVeKYQ&oe=6A2C2DE0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdfRDyaR-48Q7kNvwHTuUDY&_nc_oc=AdpCSAoOMd7bjZasZNtCT5VzbqkxMkCFZWqZp1Qttl6RlzdFnwZevM2y30-4SCUY_Es&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UgHUcFOwTXv1WWdQf1ObEN-ntYbv1XQMFWEuYZwNAKw&oe=6A2C1E86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXCB3vZuZS4Q7kNvwGYeRn5&_nc_oc=AdrAp1ufpd4vmY0KPulSAXgcRxx5zJ4ta7EsWrw4grNK8Vj4Mc4594I9IPLO4gmCuH0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BkVPTYhTNDJGOEy_kO1Ci2Us_grW4yiYav1LkclofYw&oe=6A2C1A70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gy-3JBf666cQ7kNvwH67Vgl&_nc_oc=AdqHVckwxh1kLyz_ZnUYp6qtOI0SRYeqNynkR5f0mfEzffnOpnN_0_id_ghUJd6ftnE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8plEoiBWm9IFpZTMe9JB3tgvu6zMJ2ViOBMh8iFNvNPQ&oe=6A2C0DC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiVoj7LlrsAQ7kNvwEKZqLT&_nc_oc=AdkSgSoEMC7hBR_IwlY9xkKBZTrZYCpZx7ugp8nO9A5staV46GWIsIwhD8Q79cGc6aI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYgpFVuHpD1ZN0t00wlt-G7AlDzrQarfZI1C5JhVjGiw&oe=69BFFC5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHn_oesyTekQ7kNvwFmq4W3&_nc_oc=AdlV5vxtjQJ2n_wozHvAy52q6-ZKcYQ084F9kU7r53lzG7NdxduiX_QEy6IoYrWRQ74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYp_c5bysVXK2RnyfnrFV_bzKf-ODRy1Hb8AkoCVWtvw&oe=69BFDAA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okVq-_xFmpMQ7kNvwHyG7PH&_nc_oc=AdmPLItxB84HVm2bs9jVbkDraij6gPdzRj_xCSuh-i22dSERJiUMjuNMOexGDd681yA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNichFUTjvqLgb6KDKBQ712A2PCEwLGHo81p0crPuG1A&oe=69BFCB46"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQuXzto5sC0Q7kNvwHreKqw&_nc_oc=AdlkvK5ZGuwQqOHcTmyqZDvIutShsCU1ZKHeb864QUZUlFyeOeYHWnbgiAerrkqQes0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3wku8pAW5SGgkbawYWCxgi8VG38vC3AhKvqCI9AGUrA&oe=69BFFF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRlkjdJLrH8Q7kNvwEd8tgh&_nc_oc=AdmQY4ywaOUnyrWfUz8oFxCwK5vBjVN7ydIm0KQ7O0ATg_GHvIbqjTxPuI1SAWtGP9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxB7SBfZzPpDhcIdS86kmq_qJQcjox7H2ghFKrZoAc9OA&oe=69BFF2C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
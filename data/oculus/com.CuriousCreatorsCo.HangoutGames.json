content-sin11-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz_Z5-knF_8Q7kNvwF9KbRU&_nc_oc=AdrkKk8Prhuu1-hktZTypLPzVy0qdiU7RUOarlMwvtRylysj7BM1cck3cr4nNL2yMYA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fhAvreHKN6A8O2TVAYMQDicnxw6_8QqRuzRrlOnkz4A&oe=6A22DCDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjzY8N8TstoQ7kNvwHwV3yu&_nc_oc=AdoX9kwl4O9mTAoSDzLzISncpyvTCOjeYsWnlh4jHg6L74hd_dGxQB3HfnsTeTZ1c9Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98qvSv3cI9zxYKLjVW8oDjZmbtUM-J7hpUwmiu-_9tWw&oe=6A22F360"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9uxrHXKXUoQ7kNvwGZyxR7&_nc_oc=AdqRy0mK5LL7ZDHaL0Rm4DSF_sxU0kfJViZwtGQ5ourb7Ma-V90eT3eZ1o9BX9k-rXU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Tijd8LeNaOwtq6yuJ-C6e9acauC3Joy3CEP4IuPKiQ&oe=6A22E406"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT-p8atwJD8Q7kNvwEctTwi&_nc_oc=AdpfBmqjN2N9PppJPVf2LUcCFp1cqrAEPcGnSDpETpmfdxRtByCHvTbddF4_Ta1uKfQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94wTtc_Vk78I9PqbWdTKL5zOPSK3WMchsIX-w1JqVcCw&oe=6A22DFF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntCgF8Qj-8sQ7kNvwEfk_2r&_nc_oc=Adre0S-tWI-c7bqaWK99EBp2U-h81-Brk67KX7YYD_xYSYqFFoug-eblfUSCsrBTFEw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mwmcU6PHFDCP9UG6_1KPOkdU3jAruaBOpq5njJNf16Q&oe=6A22D344"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
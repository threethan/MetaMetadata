o1-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gy8ickMh60Q7kNvwEM3g61&_nc_oc=AdpD22vnOb60kdCgYZhtL-tSp4uXhieMaG-LySQtB9nIK3ZlBQkiLTUsomUm8gJKrHU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlKnURy2dqj_4b0gEmJaQPZMBoxVULs0pHYrtFDEoNaQ&oe=6A97515D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JayLT-F2qx0Q7kNvwExjK5O&_nc_oc=Adqu45CNjlC0DDSl4b_vjtuY7gAdqbDmzTv9Oki2ZW6jVebMS4aREsxXJDBZpnlxHCM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt2EhRKLoMzR11tVWiFlnDHrMzbkZ2Dvu0LO7un-BMVA&oe=6A972FA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3GUqqwbLzsQ7kNvwF9drHi&_nc_oc=AdooRYCFivz-5SYfdxFVhyMAQQl5uNfw_Ehc5EtQSOPM-Iti-9-QYB4_Lv7uLAvUH0U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE13fgFMwOeawtS1hhX0PoKAfsZx_xQVDFeXaegzi3joQ&oe=6A972046"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn7NKfnwBHgQ7kNvwF2VOkb&_nc_oc=AdpDU69IJphsYB4oxjPM3rgfXmBRHEH5G8JIWKLt7xYzJtXCQYfrdIPpqXOBfmEHQKI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGua_b2J1CptXqHKIplVEpVRAB9YXmCrYErRyFjuFlMew&oe=6A971C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBlX_shC3FQQ7kNvwHKIRY6&_nc_oc=AdoL_SAIRMsBTs6K-iYarVQOAtcnMjsIPo5BY5WmV_suHUzVJywI-Fmwy0pU0xwzasM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEogvJ4nu96W0Kozt2sKohA0tZSR2nYdV91o-V0Nca5Nw&oe=6A9747C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
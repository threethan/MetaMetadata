d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFDyF0L-g9gQ7kNvwFicQ_F&_nc_oc=AdpCRQwt2DeFLO-EgS-y7HnP-RUZL7AqgLblML-OxFxZ3OVEc2cJEJzwGlX5wUoZ3JI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DMkFYaZ6ziicEthlAXpm3yY38fql_0z6e0fwGJb7COg&oe=6A19A25D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ELE-yoKRwsQ7kNvwGSuAdX&_nc_oc=Adpk--IDNDHl_g3sSDHcWXs_6--iCA-cPp1DoT5B-txA8bK4HaK89RJPAogm2D6kDv4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v5rUXFlc_SYEL4NeZ1n7nMQl9AEh0dYfF5UbrYJJjZw&oe=6A19B8E0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnlSmVB443kQ7kNvwFG8BDT&_nc_oc=AdqEAYTbBE7IbqhGSbAa9U9MPJiokVgpzRagJDrHtB7hjSSbWy_SyY-cdXUoCoXUNWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5el_XFJX2eusuNdbSWTSUgm12xzv6QBbHyeAaiZyGgpQ&oe=6A19A986"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQgEHFfXjDgQ7kNvwGPZJXs&_nc_oc=AdplYx9dG-W_u0ayevV_eiv3tRxOPQDt7-Pix1Wdbw75ej1zDPTyvZ_jvCWsFXcSIGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kfc3p9_W68c1vXB6FbgGxGZ1JKPTuVJOcsmcOfChUag&oe=6A19A570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQS1nViIIucQ7kNvwGzWxCr&_nc_oc=Adpwl6qS82rogjjqKB3W5wPEm5m4tYheXMSYNgltIQibUgLTLS9fM1FyxIMa1u6mrNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pYx7X8oOeYEEAW5yVolwhBEADFlpEQa0t27IiB1sJfw&oe=6A1998C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
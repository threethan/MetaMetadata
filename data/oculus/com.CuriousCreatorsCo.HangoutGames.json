a3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-soYC-jOawAQ7kNvwHqwuwL&_nc_oc=Adoon_ak9__YojMXkMYPv5s4MWeXht9BoGvvnUCQj7MG9FSxJc6u2Rsl8tTAWoTXz8w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nwQVZkWUl9E551gAsJrB1s6_Re76A9q-6Viy9GdC0sA&oe=69E7895D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buHOAhyQug0Q7kNvwEwGc87&_nc_oc=AdpRkALJN6Vt1hba17pLnbanVdLcvwWWqGKmVMCylB0Fouwl9lY5T8v9QS3w41c0QLM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19C3ZJrn5txi2t5-Qndk1bYXu3qhv305rLPelD5G0iWw&oe=69E767A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dU8B_oEx2XAQ7kNvwHnzivn&_nc_oc=Adq-1xINlDzBLpzMnWZhpxCqBN7DEYAnvtFKksxDR03ylRNNaPTVJygx3JmhSjkEV6E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22PQT51tnIbTsxBa81Vcdq7NQUSjkfZ1C8kQOvCcSkRw&oe=69E79086"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ6sNxo-G9AQ7kNvwF3iJH6&_nc_oc=AdqVISsD7p8KOFvTeLYc4LroK7uhNzxOAwe516y95qEZlijgpB_-cu9ndv8JSGXQGMY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30yiYSdOR962L6Ix38bWYIGDQ7qeynnumYifN89flHnA&oe=69E78C70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVM9i-xc8PcQ7kNvwHkGpoJ&_nc_oc=AdqEIjfEPzDHGmKE_pIlUzS0EYZjhWEekINXV80O8oIFkEH7slzG49_FpbXpaCb_-vI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af220K0dbgNzMdakcPmCvjWb710TgzdSTT9YBXdwL8ky7Q&oe=69E77FC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
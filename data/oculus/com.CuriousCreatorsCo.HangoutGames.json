d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7bN-W6mjUkQ7kNvwEU5BQB&_nc_oc=AdoNJYofLr4pJfvygnUw62-Qi5kdx2ItNapsk-uLOuHuOi8Vdk1Ktxjye-3ItUbIx0g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjyvtO4p1YIcNXBmUODn8qw50TMbociSXdcjYPKCnqfw&oe=6A9EC9DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kDHy4ZdrHUQ7kNvwGVII12&_nc_oc=AdocsYF2RyB7THc8QoH13lHkl-Y98yRDhNR9GfjWL12-GVkQkPb2G5G7C8OyoXqpswI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaY8ywPGnX0Ld8g9BlxRoacymKZ-aM_0S7SSqJgoaj6g&oe=6A9EE060"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPN8BGL3-Z4Q7kNvwELv79q&_nc_oc=Adp8NJoMDpnf9kG67rHy5KBBJnocu_S9AnQj-I_MtmlQD5pPr-X1ZPc1ux5-w7y2i70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOaf1m2cX1MEPCxtw1ajwLub7YSsGFQOBvyhvxIgZutw&oe=6A9ED106"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqdfYYOG784Q7kNvwExmY0u&_nc_oc=Ado1TwzbOQQPlo-fZi450VKQE1hJ5rIpYCpNJzXJ-ZlksPB-4zSaR74TGL-YaWCEEQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSMfkUhZJ5Z7UNec_fBMkMRlR1P6T7vggD2juUV41ojQ&oe=6A9ECCF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cspKB8bbM0Q7kNvwF-uYeE&_nc_oc=AdqOZBmGICIe3Da_jl7SHmHu-_pLCjTCSznKWWk0MmrMf_IUMgeknZBKVjiSGVl9Tt0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqB4C_ZnVzNnMf9UwzYH7-05DNFTXOPKn_aXT1fYlj_A&oe=6A9EC044"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
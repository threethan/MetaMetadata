d5-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP61KGtiPIsQ7kNvwHqZTUy&_nc_oc=AdqrKGpq9mveWJqhGYzJHvcXSDb4LZoi9i1OjmOs-IKIo2fz5eFX-KqGOKNQtGfbD1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLANptOEsmgrGB5Jg_2B8SQTc2EwyYNmu_qdAL6TVJ8_w&oe=6AA6B2DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyQA_HkoWNkQ7kNvwEYJ-g1&_nc_oc=AdqFYqu5ZGB0YaRIEZPC2f25mVhIhkjZ9C68VKn2Akv5PU6kr_M9MrRnnKWyVWY3PnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDfdtEN-7DrGCUdFgRwhGeSCHiTBpnAq9d7lYr_cVg0A&oe=6AA69120"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDGWNIaypeEQ7kNvwFRNdKb&_nc_oc=AdoBD4rhjI-ZePxg8TwaIfqYu0HI-XoqYrmH_noOoj0jClqbdI_WE-22aA_Kj09y8S0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnFGLDy8byHgcuR-0Y25bYJj4Az6jKivisbDXW6eCFuA&oe=6AA6BA06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcyLTmy2IdAQ7kNvwGw9LxZ&_nc_oc=AdrDUFQdqk_C1yF-FtuUZuzTp2HobmoDtxzzE8TQyWbkfk4OYsCIo-a3slLIrY_BQXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6x8xaJGCCoirSf1AQLrIdI_mu7ZSEiYMgztVxxicTsQ&oe=6AA6B5F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUA66o6CY5wQ7kNvwHrYacJ&_nc_oc=Adri2_VPGf2pa5gFVTeXZNhicZnKbdpWFFDLVlyksqTjDRJMfLmNWsAxDlibRU44mvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp7uhN0bsXCbDbt65pLYPnKewXcutkojX9a3EAXRZuNg&oe=6AA6A944"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
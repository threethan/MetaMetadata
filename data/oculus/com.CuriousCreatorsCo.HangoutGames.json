d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppVgyzqHrccQ7kNvwELbffa&_nc_oc=Adr5arlG-HgXtpyrpXREVwyrmdGXzRMgOzSErn8eeZDwjWt6Q2G8KxFys85Lx80lw3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z_C4qQf3oBLVj9aE374uDJLRL_m7r-MRtLeC4QScxXQ&oe=6A087EDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXFULUR9c6wQ7kNvwGMQg5y&_nc_oc=AdqXikGr1_hTn7fo9Jw_323tvNkQFd58UrlODZRG6C9i6AfVpEL_WzvgOOpCMGhO1n8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52_T2oPHXk-x6neGcSlS45mxQLB3mQuT1KFEIUcuEIsg&oe=6A085D20"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQK0Gd21p6sQ7kNvwHJR5iX&_nc_oc=AdoH8xCV7QzB0fBanCMMgw9nRdWpGgS6aljy5MRwLiNxbysotqi7ap_W1Wd-NsOcJfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jEvwehRDJhfyetZfxyMJBnUftDP5enB40ZhBvkBYhCQ&oe=6A088606"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw-B5MNcpQoQ7kNvwE1-F9v&_nc_oc=AdoTXi8IazcM8btIoAoLUa3gQ0gxGHruy5dhW2KcHC6ghRHU8euZydkNzlkHLLJ4Exk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WgJ46omIf8wSbHhQHUaggMkqlX5MGjbmxWyfrCYrBhQ&oe=6A0881F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkPCkQJud3EQ7kNvwF6BRnZ&_nc_oc=Adq3tBhMG0gmTrmmzhQqcMVJBr-NL5TkbMvpAt2iILVhVZecBhIY9jrhiZhJV-4jVH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53qn1CxeAiiy3954hBBkdk8pioRqTz5dPCXeTMCo0BOg&oe=6A087544"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHaBVmtUTAQQ7kNvwGfg5LV&_nc_oc=Adpyl0cI4LbQ37BTSlhmx8T3q-YH0gUsPFrMyhgyYgAEbQH9uZUy9nkOwNpk1rjAT08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-2iy-GSU1wDFf_IUzZif8dKRQXyjSdLV8iEkf9QEmgQ&oe=6AB7D65D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mby3WpIcgBgQ7kNvwFajU1A&_nc_oc=AdrarMDt9hoaPdyGnawHsI2x6-7JF9Mu9gxW8Fke_B1byG0lS02DpNrKLW4MUL1O1JI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi09H4qe9Ix8FS2Cs0r8TgQnBmBFnzQOlFhrMuPvDMJg&oe=6AB7ECE0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cfzjkN7t2wQ7kNvwFFJHOo&_nc_oc=AdoafaVL-w71Xsy_644sWXoiNUPrm6dMlb6mjEQadWjFN2cGOut1rU5W8P8VLtpViKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuK1JVAouYzaKB5LJy0xJd7lePeFra58xgHvqEOR5i_g&oe=6AB7DD86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3at9ub06hsQ7kNvwF5C1e3&_nc_oc=Adr8X7mD25I5bVMpQEdejFcZkwCTIEegHWglIc1I9g-y8uV2FSy435_uoUZdz8t_mME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCgjIdlOPn8m6jHcM7h8TQr2-JLOQZzgIlXqRRoZd97Q&oe=6AB7D970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvyM3422GS8Q7kNvwEC3R1U&_nc_oc=AdqkxSRZJ2bKU14Bk1UScjMSmg43n9g_yHe3uyAPVNSJDNK0BafyyMZLpAkCmh2MZ2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIkbU9f56SHaEfLWW1hZ_j-zvrwGYYglAHUHBe4VeuQQ&oe=6AB7CCC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
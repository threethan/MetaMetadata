g1-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gJk0gdxQV8Q7kNvwH3h5ha&_nc_oc=AdpkVBIS76LgZaAfje55Lxaeje6o5qiqtNqKMpsGQONB27LJy2eGxF4kcx3cuCNiqsQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMGfg-BEQLDNKTnCop7m9Zbx7wYsp9aBhF_VlQnyKMsw&oe=6A91629D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3iIhYwFmWQQ7kNvwE6YOEo&_nc_oc=Adq4fLSFjrYGn9PzQ9ALI3F5AQ2a6-p3XbVCvpw857LOsiRHWAiD7UVw4IiMr0zwLvY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJg_79K-9-LvHyn4ZTWHMRciejot36luos_fSHAd4DsQ&oe=6A917920"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F82IW8Ti2lAQ7kNvwE2O7U_&_nc_oc=AdrgMznuWV-WCw-Us14kRtlWBOoXLoRVxdWc6qD5VXL1sld1p2IwiVIuPBBpIs55w1c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrt7TUtjOPSokQBMXbz6trOejEJM4ACr-Ar1Y-KYxz-Q&oe=6A9169C6"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDXqCGfNZ7gQ7kNvwEozuf5&_nc_oc=AdrQyX7OmgW_kRYBJseo6LqAKRvLgUsZdPmST5zcHuNAQebD5Zf9acU3GNxxgSAQVTs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOem7KaxbltGuFACYvw5uEUzviZq7qMkIvPUei2eh-_A&oe=6A9165B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UcYbshRvTQQ7kNvwFJLcLd&_nc_oc=Adq-yAqS04vCr9v2fWqHwV7cc6zgEJeibKcyTBae6QD734QXW2keg28dC0ud3aTPu8U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUnZrkwYmwPkbnVRge5c7-ilw3OqomO7l0rVEuhScvvw&oe=6A915904"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
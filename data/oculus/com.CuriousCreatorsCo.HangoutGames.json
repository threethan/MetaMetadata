a3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAjSU8-hw8EQ7kNvwHAQ0Bu&_nc_oc=AdoYH1OFlMtFk9YnetRKYJKguY_QF_1AMFkY0sdheyM1qojtBUM03sZTnltKX_CnzWw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9K81qnZBCA2OcZoUhj5GwHFpzA9P7_Kh0XrRRRrHROg&oe=6A58EA5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDHJq3nwdygQ7kNvwGSjx4Q&_nc_oc=AdohPf8cK0HAXXNi2v7kgajxWqCmNC4CCkHgDd0Hj7fM3o7A0kizqNl-tzTSMhMhFVo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtua40_Dg0RBsSG0Au8cPn5j3tznh14kNN9mNY4LUIRw&oe=6A58C8A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8V7N_XozZ0Q7kNvwEvgmPo&_nc_oc=AdoWql_RH3g2Z9nKJQjTlHP0ZqCKLgDgl84tTiVAxG40lXRFERQAn1BQWNU6K1hsYC0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAkxLUorB4JtdTQwgRCv1x1c6T9mT5RNu3KhGEXx29wA&oe=6A58F186"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJLW0roUnTMQ7kNvwFZfKIj&_nc_oc=AdqdYnIi19xICo8Lq9w3m2KEbl4iTWiosvRWpd5QHPR5EicxL4nth-ULEX9iU8-ao8A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkwUhPzyTCSnvT-5lZBAD5bTmyxD9V5EfVKx4s0qjFFA&oe=6A58ED70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htsNLFoknOUQ7kNvwFKFKo1&_nc_oc=AdrSWY2ZYjvIoIyqN8WKLe-ISNlnXVYTh-SWzNz-YayS6BIqqAQHN_xOoT6U8He_T1s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmUiT9NyvfxhXYVdtlUn2811tP2SiXMYOPmApdNJ42bQ&oe=6A58E0C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
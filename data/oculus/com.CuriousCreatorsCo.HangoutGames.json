d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQ1FIO227I8Q7kNvwGHy7P-&_nc_oc=AdplZQvqTSmH-3HdG4o6e9_0TXiCOAmi0KTZIvr91wrp2TZjfKWK8QSocJsWo8iaVyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjCLhAMZlZp3ivZGBwXj36SifexJCMr9ShPI8HoiOh7w&oe=6A7C4A9D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzJjhmul56AQ7kNvwG_ndE8&_nc_oc=Adr8LavS0Yi1MQ-w_Sf2ObDtFtrV_Sd1qLxpkWAwAOVAjRtLzBkpzHAMmc4zclcvw88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6NHZckjpY6HudmUhUiWjYDhPSyE_U1JYfLNN2cPOUzQ&oe=6A7C6120"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIoqi1Iq0ZYQ7kNvwHOEgPV&_nc_oc=Adqthn-WcN6Z73s73IQoZjzi871LdiHTitZP8EOJ-dlt1AEraD24wA22262lk3xHj_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBQIgv6v7qJMHTViklIebgfZjzI1IsY-qAhcijUb7mew&oe=6A7C51C6"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6crjk1fK2oQ7kNvwGPb2Ur&_nc_oc=Adq7-EeehbvyoKY5AqbOUXTWoQxS1O1FvUcufxffEMebff3iSO6-bY70eiqC5ABmdaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRVsdP1Aoyeijjc8Ji2suFQ7KDWy_lfnUFB3eXQDP-Rw&oe=6A7C4DB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0tpa8myCWMQ7kNvwH9C-mj&_nc_oc=AdoHwFiE2CBocbvlWuUwl_9wHjo3ze9UX8aQyhXpJQcB5wK7uwglpQcPrPjpOREZczg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr5uqrG2d-aTDUkeVe_bLU5ZIuEkpMmUWmOU3YcjAZWQ&oe=6A7C7944"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
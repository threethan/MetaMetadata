c3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGfGY2d24acQ7kNvwGwx387&_nc_oc=AdrWFTq05uDWPNBlL8VlAe9tS2CkumirIGUku7QMoZaUzimsEF0BKoT0E4q1H-3X9w8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6uJASkBHqSxPtZyF4-6qV9HQZgWIZOguBLSNeU67xew&oe=6A6CB0DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0SgCvivFegQ7kNvwGYoNNm&_nc_oc=Adq-dt0duLLtHDMKdKtD6I2NwInjf5MIr2Xsh6cldeFiTmzc1g7pKI2FwtRuLV0c90I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA7i8pvB1ZqB6K4qdaDHq4pMoyjHRxhIBi76SQSVXa2w&oe=6A6C8F20"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_1HuB-cgcUQ7kNvwEpPNQM&_nc_oc=AdowoOrjnwX3Q2veYWT9Bcf11G9Eqb2TlwC3hhkv7EaFjmnxKhA26D5skhLKmDmOBcc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhuU2gSdtIE1ZcUDAdjmIclEjDevxcWMZCkDhDTITORg&oe=6A6CB806"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjG71XtJDcMQ7kNvwHx8lZw&_nc_oc=Adr48f1dFPNM540khfwiLWhLHGWz6uJAygO43NC3IUHbRuHeHbpCHfuEJkJfzX4J1Bk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMkAeVQSOgo0gT-CKhoOJZYTRtUgii2ob_qIBK1953vA&oe=6A6CB3F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Xmd9-Zk7AQ7kNvwHWXYiY&_nc_oc=AdoPGwp23hnYXmhfKzkNeOiL_eYnhrMUVkHTQTiNliaT2Y0-caKfI6tkRn6s8fsV-MQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlYbYUHmuVe0VDPZ1rSWUQKpSRgnnxWXJmM1jPtrxdFA&oe=6A6CA744"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
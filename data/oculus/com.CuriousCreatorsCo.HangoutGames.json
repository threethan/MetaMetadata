3181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfm5ecax_rwQ7kNvwG7pZrC&_nc_oc=Adqi4zgtxLqTCnY8kusmyTwimVHM8_cH5BISUfPeWHpdUOPijBJqogufCltr0z9ld1o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H2SPg5vl7beKCi5kQGXLXfji7qyrNgHmFsxomAjabMQ&oe=6A369B21"}, {"file_name": "39031433_5170499593043967_5647460791535147534_n.png", "id": "573769781100075", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75630185_573769784433408_4874436914141267503_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zdqgk92BYZkQ7kNvwGbZU5b&_nc_oc=AdpWYufe7KKCaSUeYhEl7YSRmPwk2o1777JKRJo3RJAZOECpkHiqUFa0l8_lEeZznk4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AhQ8Kek6A18Z6spcv55YUu2E6s1I8BrIBvNtgNiz8LQ&oe=6A36A8D5"}, {"file_name": "com.CuriousCreatorsCo.Formation-20220712-110717.png", "id": "3325514594359241", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974738_3325514597692574_7713797041680217542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZy7yla02lIQ7kNvwGnYqfv&_nc_oc=AdpQu9OIve1vN4wCXx4aMRJM2ZJrm5tkEDL8yeeMa9gTOiEobcicrRyHzIXueEEUonE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I6Fdd8H0RM7OFpNfv421EbmpmPaHkpFqxJwphlHIdaQ&oe=6A36B36F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hangout Games", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copycat, take turns drawing and guessing each other's creations. \n\nCodewords is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nFormation is a game of luck and strategy. Make a sequence of 5 cards in either direction or diagonally. First team to two sequences wins!\n\n", "short_description": "A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": n
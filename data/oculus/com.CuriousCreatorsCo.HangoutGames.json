content-sin11-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWpuaDkeUb4Q7kNvwGIdgQG&_nc_oc=AdpVPgWGTsNPyttWCiyw2SNR1Lhcpf3c1lxp88GQ7_Fp5YsWe9ihTgt3Ku7FFh2BAKs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eNNO_HlKmRNYpGuCotQS9tU6iKpQlCzDFrde3WgLiYQ&oe=6A11B95D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9W4IdZzTmF0Q7kNvwGB84uZ&_nc_oc=Ado3dg_KWzAOmrKZeGuOyHMS9HFTzjcQMjmHwrbZFF3St_E9NrMZt-Mlnokg64RjCsE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-n0SCjT4taV93iMbfa-vUiD04iwZzILuX0Zdfit35hA&oe=6A11CFE0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaUVaVCW2s4Q7kNvwHSoqEm&_nc_oc=AdpNlbY2OQB1p9ium2gB33YZGhZpWrr-0ITh3AS1EFXsTntmMEkcCXvzTiRCwApgZKM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71oenI4BUkSMvZpHzet8F9RQAcCAvFE5Ot9iEOBwH4wg&oe=6A11C086"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvZCjPY5BtAQ7kNvwHougLM&_nc_oc=AdrqoL08JhXrbyYobZa7rsTdFOKou-yQa8xOMl8d3P2AoWd2bWLm_3Z_snkvprkUo_w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48QGdW48q_mQFcRdDuqSQyE3Ll3AIbCY4jrOoRKoLpKQ&oe=6A11BC70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d32IJ2YmCPkQ7kNvwFXHXUj&_nc_oc=AdoXe6kwa6nk99tHXMelDp3qu8IceMAhpIslQJnXP9aUUzc158aajo9fTaUiZzHjrF4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jym0DQO1eV1OL4nGLaTj95TNtS_wOVR586Y9CfSs8xg&oe=6A11AFC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
w5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg4Hn-JadOwQ7kNvwG51ppI&_nc_oc=AdpZ9xd-iGp9A57bjFemmxcShwUEXAbVPvrbI06wpC_Ho7LUs343Lrw5EmNqtnKsyXo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HU1IlMUjqv8v21WyxWUTh1o-NLtDzFRqQG9HtpBLbhA&oe=69E637DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buHOAhyQug0Q7kNvwFO0lle&_nc_oc=AdpGmVzhoCFTAysOsD2ldgw-e5lMhGhVYG2f__ZKyH6XLRc6gcvkAdlqfoONL9nZcrk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FQehZdXK0c9FY9jP14r6jPepIo56sI_RuJSZEx9_1-w&oe=69E61620"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dU8B_oEx2XAQ7kNvwEFC1_k&_nc_oc=AdpNw2MndIG2GdPDKhJOkJfH0bCXKnhdw1TeGeua5hisWfLeTTn7qJxJjxAYxcPmTts&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xGM2D_6uQcSCYUxVMjxfo6xJ_4LXlBAjU3WmzXJ7HMg&oe=69E63F06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ6sNxo-G9AQ7kNvwGfgTG7&_nc_oc=Adp7wuYp-ClEbwNxUZ5dyjZFiUblzFyetDQzaJZotpgX3KqyaiqK5b1d1MJDkDLjN0A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b3frevkbscmVbua8Y2UCgTtV8mTFW4MN_tQQY-4xFgA&oe=69E63AF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVM9i-xc8PcQ7kNvwEktQOV&_nc_oc=AdoYkn3xz9kYC2gyENzm3k-zSVw7Kii9nH06CIoLVSm5Wk7Tgw-SzTnTDQcL-bLGd1A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rw53aql_Fm5Qg116NRTnwoOGbq_aMfcvQ5aWI35AmfA&oe=69E62E44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
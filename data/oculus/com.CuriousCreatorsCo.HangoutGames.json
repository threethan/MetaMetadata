d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2WG67GdDIcQ7kNvwEE61rG&_nc_oc=AdqC-t6y_XRaEPnckY8lMBCCtedzOOe-ELyYhnsexAyJBk4FfpbTERDfqyp0Tfzf2SA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOe6A2tWKKLky2OLdJzvsOX9ACtCJena3aR5Rmatru4A&oe=6A5E305D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xLosSTrAbQQ7kNvwHzCpRJ&_nc_oc=AdrrSnUjPr38-VZL4Ne1LTsJOLxmW7Xs6qXh6oJMSVyCayzU5eF56-dyVJB-Q06MVPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0GQszOvavT2J2u0_xV_un4rchUjA4EIAyNVDZiNSIjg&oe=6A5E0EA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUTgNkhLEb8Q7kNvwHcpTWu&_nc_oc=Ado1xcDnh8QjIi3OQ3LNwMmIQ2-_fbeTD9f__kRIwCZQBrAOcVlcIKQupOfBYVc860o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTrjyS8CtDlNRrOVooK_ezmVyKgCdr0z-0ePwQNhlF0g&oe=6A5E3786"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMXY8dzN83IQ7kNvwE0vAh6&_nc_oc=AdrI3SuW1C3u6Nwy1k29kHrlN828fCnHAZGkk3hiN5dpDjc9fCbUeAi2ri2AhKZC0KA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTEVTySkZDR3kpklHLeDFTqEDJvYp5P6ksmAkHinkc5w&oe=6A5E3370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCAiT9oj3qwQ7kNvwGhxLWa&_nc_oc=Adpwe8kt2i-vJ98xVCjVyu2bOO7freVpxLGZVWdmbV5WS_zQbQV4BMT6ITXoi6sUKvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1zMZnIu0m7rgn1WzT-d3wzs3ayCtte-Fbun7MuSSQrA&oe=6A5E26C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
r6-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Fed9wrh3HcQ7kNvwHJ-wa8&_nc_oc=AdpCkS4J-qqqLFD7f21ZGjz27rYVN0B6vNofruiPC8AceqMh3kuunTUyJ8W1AoKstgY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j8QNFbjTSeFzFrzFp2QX_h4Sp560AVA48wsd5SMJTZw&oe=69E2435D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmC53dRY1_4Q7kNvwGAog11&_nc_oc=Adp5MiMiwl5qBeaiZfCX3V7XTSnHeXb6cJP6nV9cpaqrCbDqKffLJHEwAXtsMk25KUA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32fZ0f48KEJT86Q4x6hoM2TnZP3ZIwFP8i2lZRwBNPQA&oe=69E221A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQgS8TqsiGoQ7kNvwF-c0R2&_nc_oc=Adpp-jRHdbIkK6bI6oFtw6y9XFsD8RwMfkw2QpxLbr8e8ZyZnwEYZ_j4wSV7oHJ_Sh4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tbozgVZ9DeqY4vbNamJ7dPKDnWfrcyKhxzfTT7k2FZg&oe=69E24A86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLXO7GZTeQQQ7kNvwEg_DRp&_nc_oc=AdqjA2Glcnh9oeDxiQoLrpTuD8Kj2VfeYfFKDuOhemYTHFXFBiYOzgwEcghWfiMJsxQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iaPicYBuKI_EGvq55gtWiUk3abrCJ1vnWM7XcHEJGiw&oe=69E24670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWxTS91GfSkQ7kNvwFeMk1r&_nc_oc=Ado4MMx88WJy1jK4-48St7LiSF2ySCuvOu1G5VQemPEwNunfkUUgIHhmh4QJhZfdanI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3avYVxKgX285jPEVJd4zuzzNzC07WTLbmoUK1Tjg25kw&oe=69E239C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
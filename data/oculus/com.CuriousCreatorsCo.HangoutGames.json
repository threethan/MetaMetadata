a5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwSD_gjoYIwQ7kNvwG_a21Q&_nc_oc=Ado-1Yd2nAV8thtoKbMhajFqQAz8VezpqpGL1NeIGq7W48fezCgs60CpuekOYN7uOqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtRDu2Y3en3fRlt2w_VZAc8Qq01FOCNWPiwiQBNRinRw&oe=6A90111D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3iIhYwFmWQQ7kNvwFryp2N&_nc_oc=AdoDBdxsqrKWpSjP22Dy7BN5OvtEnhVRwoDE3eazrqdG8oHUbAY-LxSOIn-XfVMyfTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoIAGcxXN5fPQQUfGRQNG8-2NOPopcm0v4WvIoxWJrTQ&oe=6A9027A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F82IW8Ti2lAQ7kNvwFKTQCz&_nc_oc=Adrs3WSkY6miZ0OXyFnz-rPvjqomVMBaP56B8CckGt2r8PZTV1XJ2SicbwrLQsls4dA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERWg6a3omZDnwrA-aryr4nMzGJ-Of3Rta9U4HbOSscMw&oe=6A901846"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDXqCGfNZ7gQ7kNvwHNdX4i&_nc_oc=Adr4oxSIwpJJ0YLy_yKuv-Caop3xdYjXIquiDL6sPXmd2Q0pmbf1BehIk5eTdXuHBsc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMxwFvkhsvY_uI7IrW-B7CUNsu7rvcIruE4fQ0JFcL0Q&oe=6A901430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UcYbshRvTQQ7kNvwHdzxyO&_nc_oc=AdrUgnV8N0oZ9EGFO33iZ3aMVy8-PLBZ5uKGNYf08RurMBqmCZGgeu4WNCf-QIWR-e8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmxRTLrwIB5buV2Hn6kxZRiHz6EktuNTrK90pwwStN4w&oe=6A903FC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
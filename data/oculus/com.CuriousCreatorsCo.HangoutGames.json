l3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSm1YkrPZOwQ7kNvwF_gBoK&_nc_oc=AdoXk0V0q1dhUDn_-eHJdPP3-QUWbnCjUXmgwpzTrXfecHssWEoWLjen8y6ZOoRjaJY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zdt6tPQJTSHgcbiCsPznbuerBcpj4UoDBIC0IPoPRnA&oe=6A3D3ADD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UM-jW6J7rUQ7kNvwGdJaJ5&_nc_oc=AdoFZDl81rjTCFgm5BTZFAV8uzs-5aOKvMrsdvyqKUcx_oTNsDdIFbvljYsHMujJc6A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XRNSYTSPI9oC3mjUTQOcOUqgSYws8YFna--CBQJgAng&oe=6A3D5160"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yYD0RJQqeMQ7kNvwFKaWmy&_nc_oc=AdrL_oO1Z9ZsXDVwrXWup-KwRFQEk1MfJiE9eFUqX8Zu7Quz9j4E8T0jSNj-xlNzIh0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EdgUwm4FzhJwqZRAOZJ4GU_F23NkGMALnfiNNl1t12g&oe=6A3D4206"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhOBRH5f6loQ7kNvwHctzGk&_nc_oc=AdoWaDZpuKvVEC7Z_5i-kG5032N1yvJNIwI7QF-Cc84VV-5Mpdi8qD76nH179qjSnpI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LgzrxLsQXnAhPd9BEKj-MJ735-F8WsPX31vRwUpGRDw&oe=6A3D3DF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n07hpqeUjLEQ7kNvwEdTBCN&_nc_oc=AdoWFhOLhDFLM6aCYysXselJS5uLNaNPiGb8TD3VStrlBS4NwSU9uq_AXvui-lIEIHA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UQOs8FPgk4keEO3x7qDEkfr5DUlYrB0IwHMaOZlAz3g&oe=6A3D3144"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
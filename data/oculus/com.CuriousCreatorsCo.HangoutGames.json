a3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKW0Ynds6XQQ7kNvwEmUnJx&_nc_oc=Adr7pbDoRzOqOG-bToB1VyW0E9b2jMkUrEVuwfuRoJKj4m51d9cIpUEW36l7m5gPaXQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7BFSH7xQTR87O4_RMU9aFVqqjpkgAeh41w5wkuydbqQ&oe=6A88281D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLc1h1sMDi8Q7kNvwHzP_zD&_nc_oc=AdoUU1RjVSXeoyQDQPdj2I4jaSvd9oLMAPzOBKLA1G_PYZiw8jP0KqUfCG9aKxj1Ov8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr_lKZSyG4Omqr7fHqxnifhzwBchMIOYrbGy010UyWSg&oe=6A883EA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HniXlM1HghQQ7kNvwF7VobE&_nc_oc=AdqkNjzc-JUCuSx4TRPgvamJjRaASss018SExgidSZawcaPu6GJthsGNhX6WzhFD6N0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgUb2m2TNZiqHZXOwRHDLbP4Ab4Ml9Ck1tEWyG-YLPGg&oe=6A882F46"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZN7GA14r-4Q7kNvwEwWI2e&_nc_oc=Adp-jeiucuIx8g7zgcJ3JXmQ9Zvfn-X0TdVo-BuyCvqc9hdbZpuot5-qcu8YrtP3zxo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqnnNMRLx4nQ7hNnuN86CR9rlONCJQGjn6m-HYf-atSA&oe=6A882B30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHRdDIa2yIoQ7kNvwG6iWoy&_nc_oc=AdpxSnb-Wc2Sm3GbI8vnSBMpQQpmkrGp3fXoD89XTB0crHueB3hpsI8Y61oLd__YsEk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtjCly0MiTnbaAyrFnimkEq-TBLEPZaMrDQHlSIj5f7Q&oe=6A881E84"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
w5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXi9bfRy90oQ7kNvwEqv2Gt&_nc_oc=AdqgAzzC-w58ZEqC0kOTqtuxpguvQ0Juz9EOrtHUsFZNM18qWiOhsRhTSdXFngJrt_w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R3XncEepEq0B954CVrY6szT4-g_yWtYeVQIQ9Uj_xXg&oe=69FDF2DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg2amx-xmUYQ7kNvwHOleAy&_nc_oc=AdoWECzLeufLHRDRgeBqL06rhwO4imDBwVorkILJPDyKjzn7llXwVt2DL8ZkLNIwfbo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FMHvfFwiYV_eNe8xvCRDp11Cymsbc-PBaSudRtZCZAQ&oe=69FDD120"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbUIoD2MUpwQ7kNvwHoghUg&_nc_oc=AdpkVl8mlyWONXOnernoVp1XcysmvGbGHew4VuVi4OKPV8d5Qc3ij25zZ8aPtyEQHNg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eXMxWxUVM3RJW-Uk9DUrrYFNHW3PQz7iouVi92s-UbQ&oe=69FDFA06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y2kVqhCDNIQ7kNvwGWxqmC&_nc_oc=Adr8wFxqlRcTMEFmbYaLaJuxW-5iVZ0jz7HecXDk0FcD-MWdmJuY8vxbuy39yIvSD9A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41y94n3_CmUNCLJECTq_0R-t0hzi7wIhBwmQ2VzokuNg&oe=69FDF5F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WvjxpYep5AQ7kNvwE4gzK0&_nc_oc=AdoNDT6Lo-fuCX3AYas6XS7XmvSDzUnS-Qzm1xGbetBSxxA51F45J-U1z0tRzEAQTns&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D3CiyssHoaSttEu0U4evvOCVoO2b4e-HJP1uaffzKYw&oe=69FDE944"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
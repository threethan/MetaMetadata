d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTeoCCxgwiUQ7kNvwHcXSC4&_nc_oc=AdqG8nhbz2VV-mLAgpL38QObE59kZcgIYLFYlu9fF_IQJ8IUsQ6iLcrv1hFgZ0AjK7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlQQLb6CdbGSDAgnWOGrHLymRl3Stg4b9EfG0kaCzD5g&oe=6AC3B3DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6clIn5-XDYQ7kNvwFUtBSh&_nc_oc=AdpOFyuMs2KCVI3Xo2aya3fb5WdEJFZyjHAlIc5U5BcUqHeuK-UFsTXq3BU0XiQo6y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2clPdtvlSEw_jXBlqf77xD9znBSrbvyFF-T6UR0lF0A&oe=6AC3CA60"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYfvG5dY1VsQ7kNvwGXQmPZ&_nc_oc=Adq9Ul4vZqXSJJnfuW1fkeVV5XxOHY1F0iAhObFa3ky__PPuzIKi-5hJpmEi-05Su1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1zPmB7BgpJUm0idqFQck7DVY7eUQuLjs4CMu4V-iY0g&oe=6AC3BB06"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KWGCzUFPE0Q7kNvwFkkfCM&_nc_oc=Adr90MOXD0JNNIdsI4k9LLNW2Hy-Ci6eqncK54ppKR5cVpHLndGfMrU182KFk37fc3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRDfL3SHipwZ5-qhjo_EmcDTFGZnOuKvqQk7UQeYh9sw&oe=6AC3B6F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXTOwsYxp2QQ7kNvwHgfAfi&_nc_oc=AdpSggAcytiP4y8V8k7yKW7fUwCOyMFcATvlMzqCp9WLvW7deU2PXqcm6iqFcK9LhNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_HwTJuj238E3Scbb5PKlgk0i-WoNXNsa7t4OedjQ0MQ&oe=6AC3AA44"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
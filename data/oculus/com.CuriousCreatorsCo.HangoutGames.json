content-lhr6-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKW0Ynds6XQQ7kNvwGQLTT8&_nc_oc=AdrPznsGa2T1adtNktaBuU7sUlAzoNbcXQP1QuAFXEXP7I60qwUkPs-tnCaJq9QNcCw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH64zSw-I_pUJCzE-7Y2koWARK3t3AWCNZfGkXdukDsoA&oe=6A85851D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o33AmiIhILUQ7kNvwHACMLW&_nc_oc=AdqwLs-Mwltntil5irqdD9gtezCy6o4mwojGYfXUfobMHQ_kbOfvAL0B88owbf7k4q0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHljuYXMEukbcs6NYV8Ls7MQEtTnw1NVMlb1Va_0DL1TQ&oe=6A859BA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiTTHWKk-KgQ7kNvwEqu6te&_nc_oc=AdoTqSLKgOOTADqSs98iI7aR8oGpJ9WUPIPA-dRBYNoUt21cszwFOX0_k2FNMMh5PTg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOOgAPVTOc8Evfoq6ErIf1SQBF7oYV3Ym54i1rYA5C-g&oe=6A858C46"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVH6FQ-cQkUQ7kNvwH0KGhW&_nc_oc=AdpWE_Ta7o8ROTmwcorODrMIRoUtR9x8bzh8Mhv6-DvFxJgzAd75zmZciesvX60bSx0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuiEoEX49fxa59yb0LxkulLoj78Yd8Om6OFeeBCj-MZQ&oe=6A858830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X9XIvhp790Q7kNvwFsd8qG&_nc_oc=Adoo6vEgt8Jofl6x27SsYNko0Y3K56AdFgY6FPfniYqkeKSv9E9lkBXZts_NN0_DbcY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPzyvb_0FkbWEDXEP-gc6ExM3J28RB-TeSUG0u1jt5pw&oe=6A857B84"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
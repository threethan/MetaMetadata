l3-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFDyF0L-g9gQ7kNvwHvf85e&_nc_oc=AdoiHR-98XbstHnEZHrROGbBPdAp4MJTDrSgrffy_XCYUTFWOi_-5EeO7FikhW_WoP4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NhMZF5CVWck0nGQR8k8HuVx_Ss6gY9IwBAPPS4PNJHQ&oe=6A16FF5D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaH0kHWMjbkQ7kNvwGC9W2x&_nc_oc=Adr_gApHs5yopl7IzaITckgruU4NoB5Yn_CCD4tBsr8FtkrkeIJmFgFAdhcsuLexpxk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z8UAGfIQ4mzvQHcb_bvhVEa6yWvuL7OD5F_Um43NLkg&oe=6A16DDA0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2xdNxin-IYQ7kNvwGdzbMI&_nc_oc=AdqUtK567_wgFMMdiLtJNMQ4XXkl7En75DUyrINALX9kBYuiT4fBFwLiSbAB7piCeVU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fLi3H_oMuWbfRLnb6U6oUVf1mEsIIyrlSkwVqS1mhNw&oe=6A170686"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQgEHFfXjDgQ7kNvwF0947m&_nc_oc=AdrOSFF6EZOaJTw8bmA4jIxGYIILOtxhUhtHksuyaz1dr0L-E4eYoOPLXv1VYFLfZ3Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HsaVcmerLaI-rwYbaYcwCp62y7BEZsl1f-5htOdviZg&oe=6A170270"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=citRyM206ZYQ7kNvwHF7KyC&_nc_oc=AdqMChjem8AbOqX33j2ajyZzllkNfeWb0Lxp7As94hG37byHRz-S2vHsDtHC45WT9oI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71Xynoa3mej5yb6OLPbNEGSbDGnVmG1jXnJPKq9fjc8Q&oe=6A16F5C4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeMot-lchAUQ7kNvwHDPzhr&_nc_oc=Adlulm0LMAgRq1ugfA5AAntNjW71QWvBibYoU5fYyu70YgHHh6PcvzbWPhVnrd1qYVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwd6_dTxImWDJFNaATTxOnGDzBtCZiE2sUq938wOF1Bpg&oe=69BEAADD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHn_oesyTekQ7kNvwEDbvzw&_nc_oc=AdkiEazLj2liSmheHpjDSEjftUoKPbbnQc57z8h6CZ0DrzLfqhUYqTBqirAhqaRq-x0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXFo7CpAO1EQFFBxozx_dLAMMlMydqZ-HFQC-iyf5O2A&oe=69BE8920"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okVq-_xFmpMQ7kNvwHtxXTy&_nc_oc=AdkO6t1Z0KZUVR9RtwW1mbl5dJd_XPwmHw19Cw4ueXPJJo1NaSKhefrpNDQ-M0FTct4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjabFehptFGI3LeWULC64MIPk-XnmYHmmOqFQTWz4uVw&oe=69BE79C6"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQuXzto5sC0Q7kNvwEhHkNP&_nc_oc=Adkf1Z-vCpWBTv7d_EuUKg_WGr0AoWaMy6ojBENOFfJFHKLo4-9Qzho8mnZTUHHO9Gs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3aMW4Tt8s5Y8VSTNQ-4iMYvWK-s6WcSXMg_uDoVl8yg&oe=69BEADF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRlkjdJLrH8Q7kNvwFJbs7D&_nc_oc=AdkeS-fFC8m3VUTVCXrPrSq-Ams-OWDf2q0O56tpHzIyL0mAu4-Wa6-wc-ll1nJr2A0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBfyxMXUEgxGWE7QlVdkm9dwzB-ewr401d9wudnRp3mw&oe=69BEA144"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tra
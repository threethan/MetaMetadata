d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSXgCjCnFiQQ7kNvwGlSmQ1&_nc_oc=AdqX7qs_2-YJywEEudr1hwaTGwIP5GFJ0n4CySuMcQr1MqT8cqOg33gAxQJqU-E0rp4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnuoObZaVnuh2c3a5-lLBk6f6goljdmWgHgGWc4zxDeQ&oe=6AEB40DD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgUAwYNh_GIQ7kNvwEgxBHn&_nc_oc=AdrkUKj7A2bcvhSwKmChUNPWft1AO5FAP9lsUZCL1prto3W2TrrOvj1MOzf-lEBm-3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0qGQcCQZ8BkrULNHXiB_3jHYyrKPqwv5Lv21FLNWPIQ&oe=6AEB5760"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2ClBssTDRIQ7kNvwEvXzFY&_nc_oc=AdqxoZlJSUPKvRC3uX9mlOIT3z1-2KT9UUJgdhoaK2cMKDjinkhGciZHk5RjzeF2Yn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD6kVrmnqYMafvN8HPHmsmai44pQxVTDjd_2NGGISe3w&oe=6AEB4806"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjA3N0VQs94Q7kNvwG_VMwp&_nc_oc=Adqepnfhh9Gt1Yph5z2C3jljjU6ZAtrJDTZkBoQmlCt2chAhsnRCbY7lcSp6mCD5LN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJUjvfvK-nIZMD1KBJe_w6ev326O9xkQRsI3tQGY_EpQ&oe=6AEB43F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su81GQQ8DwcQ7kNvwGEX8Uw&_nc_oc=Ado5WwShaUJje704HiMyPiwtxwBZhPb0bw23O4JEYN6TqOGZygJAVCF6hmnu5icKRdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzGNNttfnLWHE2oOjWZJEI45DnbVKcl5w7BHb4xBolAg&oe=6AEB3744"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
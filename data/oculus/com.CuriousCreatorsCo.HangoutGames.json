w5-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo1MkxG1g7EQ7kNvwFC6dKj&_nc_oc=AdqmVifb4K8qgi7YUvIo-88yXX4ldr0r6YTonydYQmmwCbrc9T-Qvzx4yAQJrypQ-Jc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9IE0xs_A-C9-EjfjbKWHXP__6djSXlW6KoR0n96QA6g&oe=6A8ACB1D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTXiXLF_bzEQ7kNvwGs20Sc&_nc_oc=Adr_VBDVdnMNajDdr8_5Wd5Zl1nmZQbD2_7AiRQ5oAWTGQCKIe6h0UOaf7yfuinJFi0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF34OglAN_PfJEOJgNQ9cyGrgaVUr9yNvqQJI4MePxEhA&oe=6A8AE1A0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tMmV9YlmuoQ7kNvwF7WXz_&_nc_oc=AdrwTbX8siP52K0Gx5JM7teVG4l1g1qhA6tdag7urXI3Lrs1IRBrO4kOOk8YeY5mdSc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv8FPcGGtGV1MAA_d89iWQvFvit4zvmEd0CT2nSCjkJw&oe=6A8AD246"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGMlCyOep1wQ7kNvwGXpOea&_nc_oc=Adr5a9ItDRdPZzMLoiIawxhdP6YynFiwJkFMK6c9FzMSrzll_PnyoYYCCdXANbQDuKo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPDiy_Gbnvw2pCogHAz3AG2T9aAD3-w8BC9qoqnkCUVw&oe=6A8ACE30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHRdDIa2yIoQ7kNvwHrplFt&_nc_oc=Adpbmp_bpUfTjLiSb26opJdY-M9XEt4ylrFdJQikBSI9G4DadKMl5DbYnP1j8SQciCI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm695S6zYlVxsWnj2Q7AjkMvNwhpJU8JYrsY-j56_DbA&oe=6A8AC184"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
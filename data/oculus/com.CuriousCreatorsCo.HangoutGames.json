content-sin11-1.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-XuuLLh_8UQ7kNvwHNyaO1&_nc_oc=AdqhM4JnePtQ7g3Qt5EHN90zlgd0JCqx0vTrfu0bAbEz89br-ulYn_9GmVKAI32Xx8Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjsJJTIBaKbP0XT86rmhdSvQ7SPf0PzuDVDksrMCMlCQ&oe=6AA40FDD"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpBk4CrzFzcQ7kNvwGyPXZ8&_nc_oc=Adqpyw2QWx1dB55kBqxmOJMgCMQs80umXEUPeFhn_pUCDhdT-lc_a0wiPAffNvZcPf0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGKpnvKjMsOlDVxU5y35QY4ME2ybP-z-iTkml0lF7EWQ&oe=6AA3EE20"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6keDSYpTbLkQ7kNvwFWkIrv&_nc_oc=Ado_ZTrPm-v1tPaWkNHK9ct-1ohpyTnNftOBC1i2zjdI89BaBOTRiGgqQI7x7ys7Wo4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8_LlpIMYO8dR2A3UoXe1FWzFKTHDvHtFd2bHZfQaZaw&oe=6AA41706"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-V0aa0dZ7wQ7kNvwGbgI7i&_nc_oc=AdpsSvkqrKkBG24aHfBpY2fahydP6Z4nSzMvys7lUkTnjo28Ur-0nK2HzSer1J68x-M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGxRUVtKzCPc_f1egHZLhrNIqhN372eWLb9qbuaejWpg&oe=6AA412F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUA66o6CY5wQ7kNvwEULKxr&_nc_oc=AdoKPgKaqLuHRHpIL7RHi8Ud9ggUQVCUO3ATDj-RQDsCKJN48xonT50J5xRLTimND84&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-VBkYinpQAiKQBLSGiLByfgLm_o490trfI-d8NnSz-g&oe=6AA40644"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "
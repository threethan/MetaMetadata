d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzSpJfp0mHcQ7kNvwFKB_on&_nc_oc=AdrDGS2BBlQUFmCGXVt6NlRw3bnRjHp89MbikZwTGiV_Fc3Y8hLOaxDEFICxsm4uH7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G9atoCdjB-KHcFrXxFB2FT9eBT7FKKh2LF4SBTR9TjQ&oe=6A1EE85D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzQcE_sMI8cQ7kNvwHSq-GM&_nc_oc=AdpoXsalzPYivYpArqwiCM32VqcTtkyOuA1C0EM0mOz6e-4_S5kA1m0PviHNcA5n0PA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y8org4zri717stJ3akXbdxw-EidIq1kXiYZysnbwQSw&oe=6A1EFEE0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRctCyxyjhIQ7kNvwF7oYI4&_nc_oc=Ado_MnPUwFAl31YDnmdKe2IPO0p-tawAAcoqx2HKpSBN5emBvyYs3lxEgdmqKKhulAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XkABb0v3q1T7Axb7d4K5d5WqSBXLPZ3fT0rbOzSgvsQ&oe=6A1EEF86"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dUfVzcLPYoQ7kNvwG-CVqZ&_nc_oc=AdqEs9aDXCQAcoRhqZydjLxD_n8C3GTald9W9Adc3FOPZ5_oLPi8UwzSSEP5N52Uo40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60JLNiO35M_voQBbUKSrW06-26HZ6r6IZQC_91llkoVA&oe=6A1EEB70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JZfWO-O0nsQ7kNvwGraZsA&_nc_oc=AdoaN0apvN7GZl2AG8LtIILSJmBmJfasGTHm2G8mDG6NUHoVmM7DmMSJL6gAD7x0bIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z8CnVgDPAm5-nN9UoR_afCS1cWEXX1lbKUF-4SkgcaQ&oe=6A1EDEC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
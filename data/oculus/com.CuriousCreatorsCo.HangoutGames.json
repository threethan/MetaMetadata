d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo1MkxG1g7EQ7kNvwFwAHcK&_nc_oc=Ado3mSOcylmqBy-DUc3SLV4NOM_uk5ze2XEhnsmylbyHJX-vQMk6_Qv2CT1BAjRXUhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoHHdI5IUL9vBf2QB5OKdKI3T_WfEkfSdx3yQaGnX-Jw&oe=6A8C1C9D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTXiXLF_bzEQ7kNvwGXBZT9&_nc_oc=AdrjRjBmq-JU5ADHHqY7uoh3X9Od3VQAWKnzHHqqbHULxwjvl8y-QKptAKWqRensXMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbqXD7oVBKAmnvekyJBgAZryI_tE5FHfu92NC9j_-5iA&oe=6A8C3320"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tMmV9YlmuoQ7kNvwHUv5vp&_nc_oc=Ado9M-WaSXtCvUhvPlSsdKTERkUj-CMVHsz9JaSD9omESoMCy_zpC1ZB7K4Cmqet6BU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuFhL___WhlE8I0n1wpqOtHKne2RkO-q7car2Cwlrd_w&oe=6A8C23C6"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGMlCyOep1wQ7kNvwEg8Uy0&_nc_oc=AdrRM-jRNXMXbwiZ7qmOfLQhRQQ63nVDbnEQk8U0zFc5Wb8gPcQU23a3oydmiwDzjSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED5ZUxKStiWJ7etM-kxpCpqfqbJUD5CzLTvlo7E951iw&oe=6A8C1FB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFYBqCNoZA0Q7kNvwEihgFJ&_nc_oc=AdrZWWWornA4U-kyHL6l429SXSY8zOMge_GN9-6JbMCwWWbKPIp5cm3MnXUdPKP1WbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9sxDat7zUy1OCQ7fxaMSFHh-UFtUmg7yemctOYfowBg&oe=6A8C1304"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
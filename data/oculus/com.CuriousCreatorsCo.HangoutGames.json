d3-2.oculuscdn.com/v/t64.5771-25/38982505_714949873659818_1592779866705386389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSm1YkrPZOwQ7kNvwHXep8f&_nc_oc=Ado6QIBuuSJnpgFKuaUeMb4y90q9tI8VdLahpVM-HgGLlwOWqg8aTU1mxwsoFWyup7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f4GWoHTQRJTMDDJPWHCETqfs1MgkM7_qgClW_XVeYPQ&oe=6A3BE95D"}, {"file_name": "Screenshots_hangoutGames_02.png", "id": "3207572509496279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556801_3207572516162945_1578815845573831921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UM-jW6J7rUQ7kNvwESK0Jl&_nc_oc=Adok441Gn42Oa5LzDDJtdd3Nrj7w9SQeMOz0pLhy6tnsDXMqaMUlP4AT4QwMCpqcu_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fJUcZ5ivkqcXY2nSv2rbAviQF94GTLjGfcGIAZ2ou2w&oe=6A3BFFE0"}, {"file_name": "Screenshots_hangoutGames_TriviaGame.png", "id": "1370521567095083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568674_1370521570428416_6683341558105669118_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yYD0RJQqeMQ7kNvwEbtMbe&_nc_oc=AdprDXbJ8n9YLcru8dKPsA0oYEI9naGSLa2gc9_dv3jtEqQOImJaKsVF-zH4LPRIs9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_crawbDiQWluFZFZWNVy5a4Sh6Sh-fz2h7vUSjPY3vpA&oe=6A3BF086"}, {"file_name": "Screenshots_hangoutGames_05.png", "id": "5593006924095285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035433_5593006927428618_5014745775662241398_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhOBRH5f6loQ7kNvwGfbDwn&_nc_oc=AdrzMQSWV3Hx_UbSXp_0JJDDNOXhzKyDete5GCVSBY9HYEMIg1veeJjTjte-2ft_sCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h5fqbid6l40hDDSNiUULVNWJWNhr4MCToBY9lnQII3Q&oe=6A3BEC70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spark_VRUNOUpdate_CoverLandscape.png", "id": "180227841416099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982627_180227844749432_7870967784300522440_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB5Yjr6iFdMQ7kNvwG0d-gd&_nc_oc=Adq7kWYeH_eDuaM2o-MuMW9FZ7-Ij92DUaw_OtrYJPC87neF3gPJD0zaaLPeWLh9xaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xIxMhfr5lb6OGlUE4hDtbLQbnJIw-Wc6wXx5lU7mxEA&oe=6A3BDFC4"}, "display_name": "Spark", "keywords": [], "long_description": "Supports up to 8 players in each lobby. \n\nIn Copy Cat, take turns drawing and guessing each other's creations. \n\nVRUNO is your favorite family card game, with a disco dance twist. Try it out, and try to out dance your competition!\n\nIn High Roller, test your trivia knowledge and bet your way to success against the competition.\n\nClue Cove is a fantastically fun word clue guessing game on a beautiful beach! Two teams attempt to guess words given by their spy masters. Be the first to guess all of your teams words without selecting the other team's words, or even worse, the bomb!\n\nAlso, listen to music with your friends together with our shared room radio.\n", "short_description": "Formerly Hangout Games, free and fun social party games for multiplayer. A chill, fun place to socialize with friends and like-minded game enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co.", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
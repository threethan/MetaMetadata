_name": "HyperTunnel_512x512.png", "id": "582275383322950", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031308_582275386656283_6803128145636186478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9XZJlamskcQ7kNvwEdhG5P&_nc_oc=Adq7QtUDhWMRNXkVpBdjuP0OSvCF7ZsUZzOwsoWQcVplgG_Xr6I5kxgy6EMygug4v8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7PPFMgF4yfaRz2wr5xF8GaJa4EAbVsLVxh5w5m8k1jA&oe=6AA6AFC9"}]}, "id": "1687851092502135", "locale": "en_US", "screenshots": [{"file_name": "avatar_scan.png", "id": "450365491476415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_450365494809748_6813377696520861437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqkGl1bxIMIQ7kNvwHG8jyh&_nc_oc=AdpHc0PdtJhbD6GcxuWeedKCaX3ZaEtxCl7qOC_c5Qs5pml-nmbZSHB24GYiEWiEzNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqiJO_nmIatWmzgTNRhmioBfSXIOblCQCmky73JpJehQ&oe=6AA6AD8B"}, {"file_name": "arrow_lift_AR.png", "id": "1975822209610348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_dl7nlvxiIQ7kNvwFIOXd0&_nc_oc=AdrtiZa-3TsydoJzHIeuALgoGn2XnUo82Zqu-S1vA2J8jCbDOZOPvjGBHxPe5Ndz_RE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILjQ1Ve2puPESGS4HLqGEt14ZHZlE85VMSagXAqabu4A&oe=6AA698BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dERQQzrnqDAQ7kNvwHT_V_v&_nc_oc=Adom8Zq6ijmn26bM-MhEMIM6n9_ARRdfPMJdk-pUlBrkc0ktbgw7d53gL_FWBEWN7gU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcAcSEbvpMwH6gp0EgEXuTb6UoxB4f0K19vjnAUob72A&oe=6AA6BF26"}, {"file_name": "3D_scan_vr_3.png", "id": "27448402331518336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_27448402338185002_7065044147261452068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R0AZ1JwhzgQ7kNvwEEsa38&_nc_oc=AdpzP2VVLSQurSL-nou2OwfiIqrlB9bLAud5rS5WHEKjUxBeDL-fekzAW7pndCxTIJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2WPN_B_ewhyDL3f9PPXkfmFld__X95bGfZYJO5zJGMQ&oe=6AA6A6D7"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcqZphZf3VQQ7kNvwFLgtXk&_nc_oc=AdqePOtWuM3kkSZKzWum5hL-czkF78anEHFrkLxicNoiuZBIbVac8z7-Q5ZTR_TyC1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZG5z7faiEEfDFP3-7qJapIwjNCQZO5ZgzikeAVVjsaA&oe=6AA6A3EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsfXM0oTuIoQ7kNvwFFihON&_nc_oc=AdpiCGFg9BdTZd3uIOWyq9UgUSR3fFVz39sF2JxotRgONtHLRW9JXbWBhGcLky6xLkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLtuYhLtuy9QTy7x9ddsk49ayK_Pu1T6MoZ6MWl10PdQ&oe=6AA6931B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37376580118599849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393737_1082682977234026_1836846954551857411_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBq8Oc8JYAIQ7kNvwGj4V6m&_nc_oc=AdprCrQ0N
7065044147261452068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_miZXGpoIwQ7kNvwHVoj0V&_nc_oc=AdqbrR0mj6kTeXlsCag3VwtubnvOkrVB343qeOHVzawgkdGPIoybawn1b5c_mFkE4_s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7Rp_wvzWRsmZEF9ywCjLjz2mSOOgY4QbO5gbezwuwgg&oe=6AA160D7"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAsea9ZYYJIQ7kNvwHziUQy&_nc_oc=AdooWipYdIySeuKoaHgJztt4aMGQi3OlNgKw1IqmFN__ieiuKhiVCdcKwACbgPpVC5I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7wnUaRZCWxtWghgrjuMtqcdNYIO8d74acQt24a4Gm-w&oe=6AA15DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okOsmY3ShpYQ7kNvwGpmXm9&_nc_oc=AdpjtYhX6LVrfBqkoLhVjh13HvwP3YmPAUk5KBWS3pwBnBwWEksHutiDGOK1BesRllw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcHcwCxjmVDQ7j5Kz_HS6m9b46w8VjGyKy8yZBKHu5dA&oe=6AA14D1B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37376580118599849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393737_1082682977234026_1836846954551857411_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYfp3sHPSNwQ7kNvwFh5fFk&_nc_oc=AdofAcj3m
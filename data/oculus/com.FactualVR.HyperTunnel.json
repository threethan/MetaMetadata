ga3-2.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7IZAXQ_FVoQ7kNvwEL0J8N&_nc_oc=Adpqgwqo-Lhn11mC4CYgT-HIdHwqjJaOR4_0hBoFlnjQLKw7mjYjurNFy1oR9K8ECvM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UXtCdycW-xNv5YyA3gB5-1JRVV_lOXkKzBu1edItrIw&oe=6A0C593D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7eaIV4JO94Q7kNvwEEooyd&_nc_oc=Adp6PN3MaJ_MsGY_cZ_8_FlkJ3K5Bb5NOVmH-Fz2iY8nNK87Gwf5ekybTWvMQZhrUZQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77IKCn5b857nkUGYgq31BvRH_OIBZOGJlh24fBEOVFJg&oe=6A0C7FA6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsDReCBFx80Q7kNvwE_kwsb&_nc_oc=Ado_ohLNYyYc_8FLbL54Sr4m8rZ_Jf3dTZQN87UMXDqNKGM3T4e6xtU6rvJ3XulDd64&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yIbKJs9ihWp84Lqyx9uzdStMqKGLxrdZn1n6rqvzxRA&oe=6A0C646B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvauh-P2MQIQ7kNvwGkb_SQ&_nc_oc=AdrL_AGm_od0fDqv3cgVhxemYUfVJkob2JKVnYwQrZeFqk9KgePuVqPpMdfGusGWabM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vq2XUjsU7KqZ6X9jwbIljTH97nAlxVL8_fodwlvO0Rg&oe=6A0C539B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
rd5-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68tzgrnpF48Q7kNvwHMa0sP&_nc_oc=AdrurDlOHXB0-AP9657j2VRLhafwQzFbni6e3S3uI1Z9A3Jf1MIhUQoOyhh0UAapug0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tv3dZqEi-kYSqMSv1pRFjbIuFmWM35oWCpnQPkKZWyQ&oe=6A031EBD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7AiVAXVMKwQ7kNvwERTKnQ&_nc_oc=AdrZ-GeatzGeSNEIFK7HD7uW7Kb3zho6sI4CZZiEUoB6Qf4UpwM7aGrHK7foYD_4irw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z6tZWDbb85x4AosCBnoOOL3u3kV34G2aNtbtoZqCGng&oe=6A034526"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtN0Q-iAdJwQ7kNvwF5eQP2&_nc_oc=AdrGTxlH2F4bHfNtwoUA6BmCUeXQRm8kwMcVM-JHEJyKOJ91c6xEgncUJcVLqCj4snk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p38GPLhNYBrUhOlrQRj71IBMAzm2C0bgQY7RcGbgEuQ&oe=6A0329EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF8dz8ILG2wQ7kNvwHxV11Y&_nc_oc=AdpgNBXe1nEqmqYKuE1lrk2mBRnudzqSuRwfaZi3t-JzzVLAv9vXSmf-AgVjPveI6_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JIi2P-i3XKO0zvi0riqXrudXOCCRA6_MDHHRBXliUgQ&oe=6A03191B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
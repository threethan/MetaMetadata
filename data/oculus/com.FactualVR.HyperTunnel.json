fw6-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iYKJk9ZdY0Q7kNvwGk5DiS&_nc_oc=AdoVibdSf1otz3kF739SyIOKr9FYnkKxKdy8NcHXVs8kfukFKnOWiR7zKUC-8eyaElY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tTe4Q4zSEzHkDbMCAZ9A_z3yVavNElXvBdwkFtp36_g&oe=6A26EF7D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT3ntwwO5k4Q7kNvwGJ_Uha&_nc_oc=AdoNklsmalBKsq145h3TmkBDuPh6FL1qGSGzTwiC28oUb-ZosbOCY8uTeC4ThozelJo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--2V1B8lGUASlpEupdC8Al_DnMhhd16RSKMIWG7Yr4gA&oe=6A26DDA6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7YQUlp0tqIQ7kNvwFeJTO0&_nc_oc=AdruQ1UwzJTsvXVG9C_R5ZFtq4BXPoyTDBFgCf-G433PfNb8WhwY2GYj6xphMk-7_rM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_u1cOcCntKB1bLxfdNpu_Grr9_iazJwt7XJ5u5GlU7A&oe=6A26C26B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TECVMzzB7WsQ7kNvwEwQE5x&_nc_oc=Adq3LLzSZ7lva1oqGWMrGQOtpjiyhKFucivepFb-9XaAYx0gCxSkQErXlVzxnyIZbEg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C6ONFNR1V-GEdxt663PtjbLTPKjIB6-ZrZAPgNTPZkA&oe=6A26E9DB"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
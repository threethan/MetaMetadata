ad3-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE-TvboXO9EQ7kNvwG5cab7&_nc_oc=AdoUO41aE9ruSi2TV1NS9G66ZJTB6jExw6z2BEgn_k8-CZyGOw6GXPJGnYdhHjVt35A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WuGj_P4zPRbXoFCQTkrrLCAeyPd-kV68Nz3BMqiYKSg&oe=6A2D4EBD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLr2Cv8nDNoQ7kNvwGFWsu3&_nc_oc=AdrLHj1oRZ1ak_AByq1IiJDABFlS5E_C_5kB5Yajw97YBQmoQZ0kjSoD3FXDmKq8urI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RrQwWm9Qh6gvT27jXv8rHuIJ__JNXB3dRODqFfY1TWw&oe=6A2D7526"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rKgdKzUsyUQ7kNvwEEQuaK&_nc_oc=Adqgu1mrtHHkt_WExuo7rfe_6Qr-VfyFPm1vsIzVwImXLhj8Y8x6nKw28cuDyYZ-kNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F6hUDEe3seaYuRZleCGCHWbvE0OvtFn4JIpqTQY58-g&oe=6A2D59EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuRmh2RVM0YQ7kNvwH8YBBa&_nc_oc=AdrOsOcbjYxk96J8d6QfCsDo8XWtvBu69gZmc1MUwvKOR1ZdFSn2W5fGvloQr0C7D3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s4UoqAIoOGRIcLfOsrL4X2R8r1udL1nja8bP7w0Y0Bw&oe=6A2D491B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ea1-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la1orKg6MnAQ7kNvwEwZ9v6&_nc_oc=AdpEaPfIXEmKA1LC5k5SotqYC1PPT-2UlOz8MhzKe6zQlUCylVIrs-w24uTJkBc2PWg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M69GsokFO0a3c2G43WVgHpK06GQMPVLbzqyf-F-G5Xg&oe=6A4509BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Meb2o62Sip4Q7kNvwFfff2Q&_nc_oc=Adr1PoFe0S9k8lBcLoqLmIW1qyF_seDC6uMcPGKypcFz_5Wd_2nY62lxGMw9mQowyFY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_whmwd4l_bBLDbcPtu6EFW8Lg0w9s0rrDybveui92YYw&oe=6A453026"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQaKjoOGYKwQ7kNvwG7hMLE&_nc_oc=Adrq4vV-1pQZtmUKTcLxytTttOwoP_7NiU0dViDj_axmGda0dsgTNahl68aIrCcAWFE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZPp_W4t8l7CXQ584iP729-CXh2DlXEV_nlGvGeSf6bw&oe=6A4514EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpwX6xodqJIQ7kNvwHtZ-pG&_nc_oc=AdrgX5Zyvs-9UDhjpb3khqCMpKLIUjU3BjzH-5lP7E49DEBvOULk7eEDeRnk10dYFOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PJj3u-zbVCcKzF8lNBFFqlLBP014hdJTlOKo3f9mItw&oe=6A45041B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
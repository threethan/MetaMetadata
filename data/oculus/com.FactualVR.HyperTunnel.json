7a0a&_nc_ohc=tnB830UBfEcQ7kNvwHUg4H6&_nc_oc=AdmZVBVAguX-H8NDzvL41xAgqpMp2TvV--12SQrblMcSAwT_eayuMCMT7Q1mvTz0epg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsj_RXxUWzd8uYKqHmoMKn18gLfisoz6BXlPJWkBC-k-Q&oe=699C49BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlEP9qVq9cEQ7kNvwGKM0dT&_nc_oc=Adk2WJrXKyYb6rNEQVM1DK19X89ebpS4U5LLTiYTn2taJhPiIY7x2yjVOai1VLarOzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftLyHbq8T9ScM2Ieh_azaCiepqXgzOKJuvqiLsCZu6jjw&oe=699C37E6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD4eD70Psy0Q7kNvwGE79V2&_nc_oc=AdnEJXOvPhs8mtPMXnIgT8Q6nEvmaSTu47WW7GjHEZNluoyE5HP9OUWgwnTp6xVSpu0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft22oIprnJcsoFLLv4Psj3H5w3svAkaIuvQsptSwwKhDQ&oe=699C54EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjv6bb--ZuwQ7kNvwFgpavh&_nc_oc=AdnY5ZfRE6QHDmK439lpb54oSr31I_9p1stofwb0iNC82mX7a-HzwZWRoyx9qiTWa7E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvxsJtJQKYG3Cdq2vs6rG-NWSBPP_N1vL5WxiEOJ-iZmg&oe=699C441B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "sup
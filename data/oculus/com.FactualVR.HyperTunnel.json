_name": "HyperTunnel_512x512.png", "id": "582275383322950", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031308_582275386656283_6803128145636186478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt5J9eqa390Q7kNvwGkjSs-&_nc_oc=AdquCqOEX3MrjTdc5SHcIah2VHHsecmpG-4ZFGWi_7209juDsAq-JWCFUTARIAAkdUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEbVpxFh3wCF5fjB3EKFz_gwZBybHx31OBYG7ws1XqJg&oe=6A6CADC9"}]}, "id": "1687851092502135", "locale": "en_US", "screenshots": [{"file_name": "avatar_scan.png", "id": "450365491476415", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_450365494809748_6813377696520861437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoLmPHt-OosQ7kNvwFpZ9Hn&_nc_oc=Adrxop1qCfRnnS0PIYpPI80rJEDNyCpvj15Xd5flYL97evGqNEhBFSvbOFzW_i32RnQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJdxbj7gmcu-hfq_YwrjSB31M6PZ-r5RnN2DiVSrhbqg&oe=6A6CAB8B"}, {"file_name": "arrow_lift_AR.png", "id": "1975822209610348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E76KbiAdZDsQ7kNvwFiKk4r&_nc_oc=Adpz-ii247IUDSHrvQZK0pgXqG_TLxpOriQgs4rJnfgUzEl-AhWYbhaOR7CR1TrHgKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO88IwUZmrktHlHnn6nhL9BWKb2XOg_zR4O6H6XIUPnw&oe=6A6C96BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFlyPWvTc50Q7kNvwHZ0Pgq&_nc_oc=AdrK6J89uJfo1mVey337mDpKmQHhmfccHvBfBsg8bcj08--X8NZ7wU7xwSYrDCj1ZEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUuHWEPF5ivj7qTFbJVZgL-vQXkvVBPKD5gsXSPmkU4A&oe=6A6CBD26"}, {"file_name": "3D_scan_vr_3.png", "id": "27448402331518336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_27448402338185002_7065044147261452068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yDemnJ8Cd8Q7kNvwFViZRV&_nc_oc=Adr33oXg0pCYpB2g6fL9SnM9h_lilhRfxwgzzQhBi-tpH1r0HR29-824CpE34qcmehs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC986GStavckOsH53wzTvYFQ9F7PFDD66vUAzCMBiZy-w&oe=6A6CA4D7"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kySaedRalesQ7kNvwEH54Nf&_nc_oc=AdrnQABlQY80TF_RxcDDy9zeO5yuhDyi0sw_EPivycFFDFOjB5I4oWPapxjTcG5QWMg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPMASu3E3I--DEncDstPSNdm2NSagXB7kbBhXJfMKznA&oe=6A6CA1EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPAoZiVo-HoQ7kNvwElBq-N&_nc_oc=AdrdkfHIDeFHwkrRyCDUyAj4RQ0pTN5NZz1Ey6B6Gs_IxunpF6adjOF_Q9Bu4GSCWlM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuBbe5UGLmZqY8dn_uL4iabrUEFBcjq78Iv3FNjDc4-w&oe=6A6C911B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37376580118599849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393737_1082682977234026_1836846954551857411_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ3GAhDlWhUQ7kNvwEu31kn&_nc_oc=Ado2D9iVK
ad3-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPu7hHEB8SEQ7kNvwE5y7hV&_nc_oc=AdqtmYU4-JOa4INocP4FDNK-VeR_zA8K7uOXYyP3p3VZoaGDzTisomnaKox2pV42eFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c9HDpEM5AK3y7OZg9WAjLLiVB-dmkbuleQk1oXmtNyQ&oe=69FC873D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMqodL4lwLcQ7kNvwHZ6feK&_nc_oc=AdpjQH5wmfkjAgeKBWmmvhJQ8Oll8SUcZE2tXKeGh3Oh3NnR5dCPia1xxZX_8NZ_0QE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79STyO0rRDAeXVKUFSl_lmhdiKAD00W1PJDgejRGzHuQ&oe=69FCADA6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P34HdLkkSt8Q7kNvwEA0_Cy&_nc_oc=AdqxXH5NgK9G4Dl61kpD4Rn6oCzF5mITznaIxVinuQ7B_DyHJj-rGTBL3Fx2uMhwIo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TF2lIvdMHmeQHgQ3WTdV0lVKNTbNe_79FJ0y2QEpoLA&oe=69FC926B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pC3cqg3ovUQ7kNvwGTk70B&_nc_oc=AdpA__mAbHaKdiGHCtdlx48lcHYn3wArz5R_D44mgsm8rkBNkG_w6ustY17k0FK6D2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DSSI5q1U3yXL4pgXTy992fUacVRFsHt9aAWPzHrYmLQ&oe=69FC819B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
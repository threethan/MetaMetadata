ea1-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZsJUM_GGdUQ7kNvwFuSpF9&_nc_oc=AdoGqTM36fZE9dolIo5g397dGpJgXcKpIVNbOBowoHX9kpfKw90QZLvFWHZgQ9vlxHs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb7PweuYX0JPapXA2Bakz1zE9AjTZRiG6DsAVQDPtsaQ&oe=6A538A3D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuhH9mlf-rMQ7kNvwGFYaGx&_nc_oc=AdpgKEp04t50hhFYeHqIuWpbn42591mGC5C4buI5bkNPKKctIVAdpBI5y5FJ0DsSH7c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY-Oia5g5XqMSZvJFxR9aI7eO3KeqWK2mjz3TcGEIGWw&oe=6A53B0A6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6V02KvBDb8Q7kNvwHhhN22&_nc_oc=AdoO7eCM0_Ef7QX85sMKm9_BKVvDMM5xpOigtIyHnPDdPmeeqGwny3-0kRRW4IbkSEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnlemrG6JjowCfZ5O5vToICq4wh8qkrmHf3DqLvG8vMA&oe=6A53956B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o35DU0HhxMQ7kNvwGaBy9-&_nc_oc=AdotHdCEKuMTGQmq0CN3Oe94DqjrbKchGl90xAlYnaVr5unJsRNXbzSA6TuxeE1CW_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGtHuMfvKUzJT1S4pX1pfZlYIHK5B_iUrHOWf1qlmNrQ&oe=6A53849B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
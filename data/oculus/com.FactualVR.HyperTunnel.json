ad3-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COFo-eEuJHUQ7kNvwERdFaG&_nc_oc=AdqCgacpfxTPLIm0LzgIREtLTAggTAyC-rdfXrTAWj_cwyhcqdDV_Yv7XOWUvCVDS0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKLmhV_5h_xCEUSml2ayDJpGldNrRWFArOob5psCYTAg&oe=6A4F95BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGyKxKrxXKAQ7kNvwES3pFL&_nc_oc=AdreU4gEuRqPeq_r7V3h74wswJUbwpgckVSP1KRfGvwNGwonqI0HaXqiSy4rwXod2CM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8tfSUUmOzvBofHfVkaIVviRcGmKJi-4MX3dlHky0Z0w&oe=6A4FBC26"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKX1RqoDQ8oQ7kNvwEUexp3&_nc_oc=AdpUIM-ENp3yyfU-IGIeLAPR38RBuT8T-Ua4jyUmvgCyc7tREGRGK0GJgJ2Neap4kxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXK_y-mJbftLgH4pQgh_4iaT1mSxiVoKn6jUoBmmw0YQ&oe=6A4FA0EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDVrvuPIgUEQ7kNvwGflgci&_nc_oc=AdqqCoDoRbo6I3IlYcDatGGUEhpzRN7k4utMchbnJJOwzkAauIzNLR_vzxr0n0Zl_7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm-uKBmsaCfffBiRX1VrLQLttO5H0inv90iBtI7NA9PA&oe=6A4F901B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
54_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUPOre--tCIQ7kNvwFM86vj&_nc_oc=AdphB03gUXN1UL0cFEjvUyd9V7RU3l0p9g82se1AMUZ6R4YtWXiO2zFSbilA_xgbyiU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-auhSYvqtSTxeQztmNak_yXrie9icvhnqS7LL1hM1Cg&oe=69F1FB3D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5znmub4kJLoQ7kNvwH3VOJP&_nc_oc=AdpQHHCRPhSpqAsJArfY6-a5_f-jXKaGpbtVeCqnlk-tp88ARgLUqp0tAtbjMAIAq7w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af01QYmqkPQfEIiW5o4B2hWfjTYL2INTJKVBb5L8nEdLfg&oe=69F1E966"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3uJTE6l1cwQ7kNvwFtuwAg&_nc_oc=AdrErrxguyumQLHoCVbalSzSbsNviEttxRB5THHAS9jR97-3cciMrn_jm0fb0pRsihU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XbXxUsh1FjEZ31AX2wex5uTcd3QZK6IHBHtuU9IL3Mw&oe=69F2066B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRGgpKLr0BUQ7kNvwEqAwtF&_nc_oc=AdpAFom103gtcYlFvQ6SycBwNpKuiP4Rqw_QrAXguLzoMON9EX31Mo7BmywT6ly-ovA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09Xj24vVzMnd_ly2Acyg3bGiQIwnswHHrDkwe40Xp4ww&oe=69F1F59B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRA
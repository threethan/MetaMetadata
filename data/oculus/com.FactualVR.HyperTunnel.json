jc6-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vntw81A1K_wQ7kNvwFSFd5S&_nc_oc=Adqu-0nmGYuHN_9aSqpiQjh80kuWucn-J_wxvodxBW24VmkQPeo8LY7RlImjnXpQnsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p-IdwjRUH2RHplygBNbiV8-J1MXTCeNzxOHdTfA_lyA&oe=6A2AABBD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLr2Cv8nDNoQ7kNvwEU20BF&_nc_oc=Adok_eMsR9q8RQaSZuurTRSOwTpQcTe3lQvRy0B33aHybgb7nUOBG0Wt6g-X14XOBSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hiBeH5hyPYoGCesH0YPBfoy5j1h6TkvviRqZJagt22w&oe=6A2AD226"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rKgdKzUsyUQ7kNvwGZxhL3&_nc_oc=AdoYhDCpnXBpEeQMXN957abRDDoPcjYQWxAz8TYKBBPHIqvlq8hc37It91LKJ0dlwfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LuqIa1-8El2kyZzSOGQ9vCMrhuoY24tX8aN6ttrVzqg&oe=6A2AB6EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQfxUXMRdecQ7kNvwFa3B7W&_nc_oc=AdqSZ2fAqxnr5oGLsNYkqO1r31YgEGm8hU9x83BdFxs0mel0UVHkb0dNLgCkpYiT4fM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BcXMsc1sm3AfzNdetELZaB_CwtGKzA7nyCuh5ELJeSg&oe=6A2ADE5B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
_name": "HyperTunnel_512x512.png", "id": "582275383322950", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031308_582275386656283_6803128145636186478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7dwZhvcsD8Q7kNvwE0iEub&_nc_oc=AdrucekIFfx_rEp8pRnewlOCsKisYG7gXR-cphkEt-A8LPZ0xB4_ciZ2apqF2sU0QTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGRUIvVGxDCXFuH_TCbhZnOO6vFSQs3U-a6CaGxrVD-w&oe=6A7F22C9"}]}, "id": "1687851092502135", "locale": "en_US", "screenshots": [{"file_name": "avatar_scan.png", "id": "450365491476415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391911_450365494809748_6813377696520861437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fbt13tt1bukQ7kNvwHFNUV8&_nc_oc=Adq1cw9DpgkehsPeMRS8B1Gk4oMyeG1-Med9ZnqgmOmPzE-R4TUzILy8Sp-EM94eTSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIOtOvP_J2G86cramGhTvAFoab5ZwbpZ6wBcmzFeCjHQ&oe=6A7F208B"}, {"file_name": "arrow_lift_AR.png", "id": "1975822209610348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHLnbim7tVEQ7kNvwHtvhBK&_nc_oc=AdpG_1WOfI1T0zk8OozFP3SDKjtYITb6qGCXwRs2IpMHt3FIHCe9zMjyLWIeIx3g4zw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkstUsVz0_AChZAqNJWowawVWOBbkbKR9fS8hqQCG6hg&oe=6A7F0BBD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzPHNe2A9xgQ7kNvwFXYgU5&_nc_oc=Ado2jdGNQsv_p3HjqMoEP8dVpYOXVTiP4JsUMGDgFjwtlsU1M5hLHDaw1ufCOEjions&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkUKwmEyLxCTi12TR3sbV6TZrkKrZT_Kc5qb7yeKrqrA&oe=6A7EF9E6"}, {"file_name": "3D_scan_vr_3.png", "id": "27448402331518336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_27448402338185002_7065044147261452068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvGEM0fg5E8Q7kNvwG0fXxX&_nc_oc=AdqdRTykf9drlHMo36hDE_hKCz9j1GEW_fGHlmy79XJ8ra72GW3Jmi0zKElqzqnx9LY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzhgfV2Bj4ksb0IaqqhOxjdmU7129AopOROkPWenqnhw&oe=6A7F19D7"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmXm2GZBrRIQ7kNvwH6Ba92&_nc_oc=Adq78KtD4WLtczyrijRAV1YxRwy5sgl61vkqVUfHdYY0s53jbkMI130UR6YFp-mLY68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7kxa2p5_azhayGpJLwzWYe-x19SuuRhumJ6qg68AKUg&oe=6A7F16EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5IMdP82orYQ7kNvwHq7UlM&_nc_oc=AdryfcB-K1JTDfo1YjwWr90T1MGYToA5RNs1W3ZR-EXbfhCxIIGER4ZV54XLFGrxKEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQb3CsYTsjc72bNKrFsr3qpv7dM0luanZJgpLK8fFC_w&oe=6A7F061B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37376580118599849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393737_1082682977234026_1836846954551857411_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeSC8SxYMXcQ7kNvwG6QRt9&_nc_oc=Adpwb46kK
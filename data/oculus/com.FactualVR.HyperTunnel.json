7a0a&_nc_ohc=qI3wecNVWJIQ7kNvwEhw8MY&_nc_oc=AdlaStutIqgmDHe9KQ-5aScxldCqz0HGiRJD-o-id2J6TpDaPa8y2Zr7UY3Jujs5zBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOo8NYmnah2cl26MowS2XWtjGd5Kl4KxD1zXlLm76w9w&oe=69A03E3D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSfxEM8cK4wQ7kNvwHmWR0l&_nc_oc=Adk52yktpQM6nKVhAYsBXjbZwAatjqbFAd7xToVgWABSE-XPLTXOSq0z7N18IKBhm-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWE3NjswX9BL6w8rASZ7MgxQ6kaQ11T9WZGU8GEQMn8g&oe=69A02C66"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhblhEC68UEQ7kNvwELYah3&_nc_oc=Adm5YY3sBK2dU8Gjp54mQCVJ0bj5sc5z7SVWabeYTfZRkTfjQNqEh6FvUthDkUJMJLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslqdZIpBxJx1XDamTZ-AUyggJTQaVcz2Z6T1McCMvAkA&oe=69A0496B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur8bSh7J6kMQ7kNvwEkrwXh&_nc_oc=AdmNGW6dSeVyRig1k8nyqfmO3plzDGf_751haR3GU_5k_DJgcA4ONGAaSXK4UNy-z74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvshu7WIhGE6kXfyJ-gMVWfiY8y474HN8E_7tUAXck7gw&oe=69A0389B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "sup
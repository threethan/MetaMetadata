ms2-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhWp93A3MmQQ7kNvwEsg8U4&_nc_oc=AdqwrNW89x999GfJXIntPtlecGbtBNLSkHand54SdgXPt2YXnfQ1OeTbz3GVZgEoeV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06WpVw8Uv5JWksjSkKbnm6pNdyTSzuVwQZw1T8icKDhg&oe=69DE34BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXgjFbo9kCwQ7kNvwG5e7tm&_nc_oc=AdrMdiQLuc8gx7rdCDxn8tiGzZF6Q2PE8rHzCwefdOMO0anLy2sAjIGxp-F1bfQimyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OikFO-gG3YPr8thA4rHBrbRhWL9thwdoN30XOfxk7IQ&oe=69DE22E6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Qvvd0a0GFQQ7kNvwEOfClt&_nc_oc=AdqVQvMtl8TnmxkEMDO8gsZEPA-XqFIp2MhLNfgWzESZ1JDAwX5bjoGAFncunv5EcMA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2psCA-SmPHPgb_afJ8Z9TXGqL11yyBteRxwbAGeWHz4w&oe=69DE3FEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KBetVgzHGkQ7kNvwGGEufM&_nc_oc=AdouarAdHx1zFYlDlovoEQfkABvkMonN8MJj1MC5ILnSWGCqXCcSAKMi-YMbXvsBEoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cPQimR1M5k8OOEtnTyvkGqhQ62-UlVgOTZXQukB0VUA&oe=69DE2F1B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
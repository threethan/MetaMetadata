ms2-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vntw81A1K_wQ7kNvwGN68KU&_nc_oc=AdohVES3S9gxlr4S-l9pa2k71mQgnRqg0X3OjEUdFR1ABYvA2zoRlYOdlNsk78o3Yfg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1YQnCbuTbjSruGkL5i0eSlRRjH36p5tqfgRFNu2-ZVw&oe=6A295A3D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT3ntwwO5k4Q7kNvwGFc8Nj&_nc_oc=AdpV_kMhuGNN1BIc6FpFrvEOAkSHP_KTJLymM817IyKbNIR_mmpHeCf8hR1W1_PH9CI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ns9-TBxUOJ77RbP-QCAALMID_MGXNW71BeJI2c4PUqQ&oe=6A2980A6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7YQUlp0tqIQ7kNvwFusiui&_nc_oc=AdrJayZ5pMCSm93IDXKqJ1FJb8xC1IUGg720_lwADQN48kypnPoiUNhS1St0wfJa8nM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SVAk3dhzUmKoFT5nhlppWvrjip2LmuGuSLJdQFTyH7Q&oe=6A29656B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQfxUXMRdecQ7kNvwGqU9us&_nc_oc=AdrOgFbEkd8Rlw9Ifsfm6WK1H7DmLC_8_Qz8Mp69usXSPZoa7iY4qZSMVEtUHkLGKJw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sSDnIf0XINlZki75h9b0v8PtV0zhu60H0uyo1wC2yZw&oe=6A29549B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
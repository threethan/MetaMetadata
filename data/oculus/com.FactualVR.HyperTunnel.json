_name": "HyperTunnel_512x512.png", "id": "582275383322950", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031308_582275386656283_6803128145636186478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG_EzjckuA0Q7kNvwGR5qT4&_nc_oc=AdqGERMtVYLyPqDwpgwe5TeEWGDcQisXeQtghDUtX6EAouaoaaUrfiOR04JwiBYGj5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCd873yk77-ddbf7v169KzRyVAIEZdcB3v7qYOUdFzmw&oe=6A60D049"}]}, "id": "1687851092502135", "locale": "en_US", "screenshots": [{"file_name": "avatar_scan.png", "id": "450365491476415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_450365494809748_6813377696520861437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM3wZUjTLFMQ7kNvwF5s359&_nc_oc=Adpn3MfVVSOUwuI7AXSnPmNX72mlKFTi-J2p_tKCeM6QeDcGo1CjdaTASbEg3wHAGyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNWp6yeDy4fHH3WpRLWviI4VPiJTcQHO362EG5xw69mg&oe=6A60CE0B"}, {"file_name": "arrow_lift_AR.png", "id": "1975822209610348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq28WDPlf4EQ7kNvwH_ezZx&_nc_oc=Ado8ELU8xqALLFwDy0TWd52s2tXoaiaraQoU5jEMesfwGFLM0S-vzr5JJVPkttwTs4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwrYEFGVzHYoNFfyWJYhoy8yybS1VfaoHpXxpeNbUiyA&oe=6A60B93D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouvraKv7GecQ7kNvwFKHKnJ&_nc_oc=AdrYlaV3_yVinAfsdR-k-c1B7pJT5CEEG_Pe8cmauEusF_CZXoJk9rIGeqh-1V5yQSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMrqhh-PvThWSHp9VT9NfIIPIlsYScpFTuMnG1bJEhBg&oe=6A60A766"}, {"file_name": "3D_scan_vr_3.png", "id": "27448402331518336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_27448402338185002_7065044147261452068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NOx9ka9CBUQ7kNvwFdR0UR&_nc_oc=AdpZRrU_eGUAzEiQ8_-jpmQNNRw81EW3VXgT02XbUqypM9BB4uvixokiLFNL0_CvGO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWnAtkL98LNeVp7E1HPiW0uqHTZ6e346ylESJOXY5eCg&oe=6A60C757"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fTul11LlCAQ7kNvwFDjy2N&_nc_oc=AdrR7WywBby0dXH2QQiuEh32wDfc2iG08bnelSh1aY0aNNlhLZ1KC7btvlukZMOh40w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmPuAN1FrbvlVZxFJbIIDFN3ebE6EJana7Li672gl5hQ&oe=6A60C46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CrU_J3Re0gQ7kNvwFIz-rA&_nc_oc=AdotTY7MZjcoCBXfN_1DxARn2WqwDMBBh4mQvINFEk-kklP66zysbaPnGIiTwnpnB6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiHoj-vcfAK4h4U3bQpNlyuTqxN-QpNpXYi85PSnQ7hg&oe=6A60B39B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37376580118599849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393737_1082682977234026_1836846954551857411_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dy4YRCyBjicQ7kNvwEGj2cP&_nc_oc=Adq8SN-Cq
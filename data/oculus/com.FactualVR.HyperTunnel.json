ra3-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDQhk_EvVHkQ7kNvwGmc5DB&_nc_oc=AdpBChFj2iydwHSUAh-V2Da0fHEEyX22Jh5M_Ie0tB2HBWRZOTZljQ9XrZoC-RCIm-0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yB3AsWZ99blCHJl8Q65vV7FwPaPmbznnPs0fu7W2hEQ&oe=6A1AD9BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4xYBrfEzhAQ7kNvwHUVkp7&_nc_oc=AdrNpe3z9uIt63cHVp_1eN8zqqFC1xrTHukfGKDt7ws_xrmVtwsgkfgpnw_SWPliloo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72iyLUamK0sNVcJeTxJHqXHmSn2Yay7sxBCY-NWd5UbA&oe=6A1B0026"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lM3R4Nmp_YMQ7kNvwGbpnoR&_nc_oc=Adqnl8QBX7NHu5ljYnF3C4EqYowZ099XrnvFncRT4QOFX7DDEXMLquhRh2HglvMb1sY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af420BAxictoHMl_6TLnSzWW93d9By8lgWuqQLqlMQg-dw&oe=6A1AE4EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb4-BBVQW0wQ7kNvwEHgZWX&_nc_oc=Adp97W3oGKSmbFsP5vS2wy7-PZ1zpUNI1dZLeZBVZgJV7PgJS8uh4XwwcGS2FCtergU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gg5_1eml7a0y1yEixkFMS-LzrUlESrhlJxYq475gUQQ&oe=6A1AD41B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
ms2-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-8Y1JcgEZcQ7kNvwHwdwdK&_nc_oc=Adri_5ASE2RnM05QOxtqcgXIxJeTwYNK0do4uNobLYlRNfVj-G5k4xVU5Nu-5fjtDAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKXFgjF64NrqE-7WeOoVlFvwCGDvl6OmFhO4L8bofm6Q&oe=69D105BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UBdvojLXSIQ7kNvwGJNX3z&_nc_oc=AdrRMcag6Z_EQuBJqzn_S69j9h6un0vF4rQ4h3U437qeCfbMbK2dmbYhAcxBWwH-4zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzfp4W-clIZerYmqj2NE5WFxrkCJPwcuHz9CSJBJpXMGA&oe=69D0F3E6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ne1bKlhOTcQ7kNvwGIDatK&_nc_oc=AdrgCMEsBjJgohiZTShL_0us3dBvA-FR0-4eUxYEY28N81tpBECBi6aBnDtCEbIk99s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOVil56FQzSqTMLVg8y8XR_pfFVOsrcIiWztl_KpZUaw&oe=69D110EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdYM1TvcCRQQ7kNvwFfiY_E&_nc_oc=AdqFzoHQIEiYbpGpU5A4pzBjcqnsuDri7W1VFuBWVxiOu51t9Ms-4DlnwJg63JezyQo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkHPCbBRjypMDlAicYZEWqwWnTliu7LsDqogfmHEDi5Q&oe=69D1001B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
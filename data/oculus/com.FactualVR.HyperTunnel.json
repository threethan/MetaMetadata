7a0a&_nc_ohc=ThDEayxl0pkQ7kNvwFbIyg_&_nc_oc=AdkNVRL46o1EDJ3H4j_8NACiu_lf6u2rhyFkUjMffr5LhHEp4hqFE_LoL8mj7LEpB68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft629uvl1jm6sM78z1NKrTK-I-Q0S1ajZ41-12eo16wCg&oe=69A2E13D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSfxEM8cK4wQ7kNvwGmyr8s&_nc_oc=AdkA58ADgbQzJqOmp2Mcuboc1aF_-pKEwktevkEAdrM5Wxx9kuOx61ExAv3E9yp5blA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftX1nnUeZ2luZOt4-QcnGSLbDmJ1tOHwry0xbwLFlmp3w&oe=69A2CF66"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gESj5dbmPe8Q7kNvwHhcxVG&_nc_oc=AdnnpxwhkC5IWVBh1SmmEeh0LhgBufWZr5Jb0s0hOIHS-9Hg1E1s3zX8T9VXcHmzut4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuaVl_um-ibKphrm1GSCbOMHv0zto-di_E6JnoKiBbMcw&oe=69A2EC6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxwk67ktk1IQ7kNvwFhDnpc&_nc_oc=Adm7FTEmtN1V-a4gL-HmlJfPZTJRPJSv_J-wz7sHxg6xH9HZ8lvc-ANpNRwmgHyVRgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnbfQLRzNz7bWIuwGUBy9ELLBjkG_G0fSf-2ICAZ6V6g&oe=69A2DB9B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "sup
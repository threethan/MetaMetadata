7a0a&_nc_ohc=qI3wecNVWJIQ7kNvwHZslzM&_nc_oc=AdmUiug0bhV7f40Rhx5R8y2t4k12NJYpXnGtsJd-cKmMkgyLD9Ky855diwExiplu16U&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afux3wbFS3AtmqU6P1E9WLCyAD363ldugzddCEWt462peg&oe=69A18FBD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSfxEM8cK4wQ7kNvwFjvqPH&_nc_oc=Adk3UgZefjTFjS_xHm4DIWJQbzhQGmM6NDiWDw9f1U8vsMmRcQqGGSUcK6W-2DXuK-s&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfukiwdAnXXDolDfVoxGZ2qubu37MlLaA0OItH1_P1I39w&oe=69A17DE6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gESj5dbmPe8Q7kNvwGj19fY&_nc_oc=AdnEeA1ZdgXEbuXW3Ry9e_ck9NSeSrM3Y8iXkmjuHbbOGBvKQ8Y2y6_GWHwhpxG_PAg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsVMa1PEYgt7MEqFm-4jMT4GBD9lOAa_QmOLhE0RLzbfA&oe=69A19AEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxwk67ktk1IQ7kNvwG-0h-H&_nc_oc=AdkQlPvdsLKm926VWOaFyLwVCO_fnI9jzJc2aiX61PjoNxfpDLA7OcnUW-Wbjd4zMBc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsPsTmYkJFwJc5foMSnNFbEStjEH9EvvBCh71Y7OXvclw&oe=69A18A1B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "sup
ms2-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPu7hHEB8SEQ7kNvwEzsqHI&_nc_oc=Adq5TxUs4a-euYfgov15hCfCCo4pvnoh6Eeyaln0VuufUkbG6VWnRDTBHZO5yR7OoH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CG5-b4xwYjiamu-Pw_keEgUz3p3DHUNqoUkwauttvxA&oe=69FB35BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMqodL4lwLcQ7kNvwGdYzdE&_nc_oc=Adr5t9huxNS6LpgSi3mP4ftYKYXXc2KLsG1KtXLYhqF8KwdotXSsla4hLHLRDR3nIdg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_yOXfxxdtXPiYGI5TZyB2yJWzV_PIM9ZebZOFFuxuog&oe=69FB5C26"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnBe5aA0lS8Q7kNvwGVz76b&_nc_oc=Adp-ngRzO8fS06MOgPU8adiBB8VsqcRdeOxfWx8YSa-ZYqMRJentbD2Ir6vxWOmJHmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NRFZncTD5l2pZKcy4Ibhxr5y4kIH71CxU65pFy05Mig&oe=69FB40EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZosVoRjzL4Q7kNvwHC57KK&_nc_oc=AdrRYw_2zG3adr9vORpGJdNIokCGc71z1SXucJRMSbOjXFke0xmmgDk5zDFKko7hnU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bqxGrsMfeixoyvxs-cypB5KIg4KmXWFqS2EEIdMFh1A&oe=69FB301B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
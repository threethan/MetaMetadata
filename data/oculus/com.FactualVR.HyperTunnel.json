ro1-2.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7IZAXQ_FVoQ7kNvwFsCK1e&_nc_oc=AdrjavKMI-NVonN9lS84ViBRd3yUywZS84XzKiahczWxR_wf-ZrM1_0AMLRE5X20H7A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SjdJT5YkaL8olySF0hItXfSDGVu-Wfrjl0TH7t_mCUg&oe=6A09B63D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLh0X9DgsjkQ7kNvwHpIhsc&_nc_oc=Adoq1yaGgaAiqcQxI1umWAzMJNOmlhHVGsg1-48QY-9ESOWTqZ-HqS4kyr_Z7T26V_U&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rhiVshpyd57Gh3qj3-z7eTHQfL1sKtRPbU8Z37XdPJw&oe=6A09DCA6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=didxfc7oG8YQ7kNvwEDhJVZ&_nc_oc=Adp-aih5Ffh4COD97MiJl2wPO03JlFsJV0Cihqv41u3YBQbdm5b2SOaGnQ5tvzU64xw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gHz-fphHZiSdCOHaGqeCbbvUPC0rL0cBuPHoere-rPQ&oe=6A09C16B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0ZOwDsAmwoQ7kNvwEuNXfR&_nc_oc=AdpREMoCi4P9EC-eXl1bPV65JujfZQXVbnySI2AUwta0b-zly4Xnd2tH7OfA07wMDcE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tHIO9kYJl0PK7FdKxqImxUs5FIV0CwBRXICQ9iftREg&oe=6A09B09B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
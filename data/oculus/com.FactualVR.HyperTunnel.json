fw6-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeLllojlcn0Q7kNvwGxyja2&_nc_oc=AdqeZmsGEHOzgsyY1pItPDo6HoJ-fOcxh79VNKiznVJ0hE8hBD38xGO7YkHrnvyozpg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eQGJuzUbSOQ3mHoEHx-iXaF2RuDq3lNtOt8cNBywjPw&oe=69E61DBD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQNUXxR266IQ7kNvwEGGFrc&_nc_oc=AdozIySHShZHW-6Q6bOI4wytPTJ9rc82WWHZKJadNOYIufJoq6_I27ahIKC4Lb4Q8nE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3egOqMGC5OluR31KBAPkE8foOAqt7_e44yXWVxmpDlXQ&oe=69E64426"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LGywK5uracQ7kNvwG7gfwd&_nc_oc=AdqJ_ecRG5UyM162u6IRMgqcZ6DrY9zujbROgKkHMRalg2Ib-Xoxc_UlW7teERL6XNE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RRym-GfE468djrYbHsgE4VR6-lmipzlAdrcYbvjpHCg&oe=69E628EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Fimt8EyrsUQ7kNvwFgEDw3&_nc_oc=AdpxCi_9aW-nJ-k-x0XyEaIW8somKzUKebD8YJWcgSHdtuNmh-XYA0UWGqTD-h09ifE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ovTY6SbXGQjnHkCZSr09i0q97KTFG_98Wcz7WX5jsRA&oe=69E6181B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
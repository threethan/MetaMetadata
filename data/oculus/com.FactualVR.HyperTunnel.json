7a0a&_nc_ohc=ThDEayxl0pkQ7kNvwFctwDt&_nc_oc=Adkjnqw_Sh8HvBEFl4IDExlgMNceQ91lJHkOu6tMk6vcS5qcbtKsjXVvx_AnS8xw-4E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftf1FbEm0lLk_mfbnfRc8HwLg7Sbszj0bGsW8Onx_sLSA&oe=69A5843D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHpf11GWKtEQ7kNvwFTLnys&_nc_oc=Adl_brrDTp26g3Ret1LolvmQ1w_ZOP5vl6gGAtI2sUPif0WIkEt4Bj1RuZB0YlnHoG8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvhYCdvM1pM1_ucRTQ5OHN8DyocZGJ6nh6u92wuxJfqmQ&oe=69A57266"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPkjbBjRVnMQ7kNvwG4MKCX&_nc_oc=Adm2TTTlrKHv6UsWXiIc3x6Bzhr6R7hrejAojahlXHKRkNPCr_kIfCLVvDLybcARpMI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvVdlZsbN2NWkGRIVXFn4aisSLQCsvaHfKxNqAWwZDmCA&oe=69A58F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IOLxkWza1IQ7kNvwGlmdgq&_nc_oc=Adl6GfrwUNO7ilEVEQeJcyN_iLl310nbeNMlvD0-pvk0xSGHwZ7JjaKFs_Bde68PSVo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuCHS7alSxsRk2q-1jqEElUaSdUKLGa0jszMkO_kSAksg&oe=69A57E9B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "sup
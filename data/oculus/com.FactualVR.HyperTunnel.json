ms2-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XJ-KtcRx4IQ7kNvwHTCKCq&_nc_oc=AdrJ1-JIofUtZBGSiQL6b_x7MOQjslnqvdm9JGOiLwlmgtgG-7KsSRnXTgG8JXl21Zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ma63seOlP6w-AEGRsnIcksEYqd0ha-cEO4w_uvnsGrw&oe=69D2573D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UBdvojLXSIQ7kNvwGsExOJ&_nc_oc=Adrx3fhw89wDyLX1ZK80HefFor6DPBPbu8rb8W_GgJFInfWp099RImoOmQxtqi8uLw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af267iKGTNaHiFgcH6neARFc7g30ZA7JK5R7JvUZeB_rfg&oe=69D24566"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ne1bKlhOTcQ7kNvwH28vLS&_nc_oc=AdrqrrpmoNsYIv6PNNt2hcgO0WFTDv0HvhJvk0bTMozPAN-QICM1cMNzmm93zxUYJ-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Rki9ATXSmfcL_7y9tI85uJavqHmAeICK4f0PpDlWVQA&oe=69D2626B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdYM1TvcCRQQ7kNvwHthnz5&_nc_oc=Adr8shxljCU4VnrrPTKsu8PbX-1CL28D0gxDozgOzwL_mXWDhMaTUi6s6hmIxWWfq3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05NtwLMhSavhKSPKMydr2y2Xus0gMFqI5_9ANFcp-vkA&oe=69D2519B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
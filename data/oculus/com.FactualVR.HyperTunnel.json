7a0a&_nc_ohc=ThDEayxl0pkQ7kNvwEiFs77&_nc_oc=AdkpbD-5CwMegP1txmyNz9Hr7UtvbzLwbukLC6ksXBLq0aQdhOaSpD497xbXv-jlKK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvcb-LZrtF8v2PywMclIji4Br6U0XUFIB1LNJh1wINAiA&oe=69A432BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHpf11GWKtEQ7kNvwHCO-T_&_nc_oc=Adl5w6V7-ecSNeTY8p7NrdvGstF8iEJKVGRdjn7qYao0ddF3Xa4OtwNA92Z2V5YWmZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs3T75sz2208NzkAWJfzy-baes9eoQGWsWRKv_MuEv7-A&oe=69A420E6"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gESj5dbmPe8Q7kNvwEurT00&_nc_oc=AdmwI4nytTCknitaVg0H84oiqqGblZTH8Ggp66NUFPG_g7Uxil9nDU-nFL0ORWSlnPc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvStfBMiVf7H3pKZzUqOPELLMxVTjjbqTQ-eR1NToZ1Sw&oe=69A43DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxwk67ktk1IQ7kNvwHN6LOm&_nc_oc=AdmVgB5RB3eeDrfsjD_plESuuX89ZJIGjkxArTqUwIvu3KFvPUOS4UUCBY7GRQPi4gI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfukafDl7zqH0mCLP7u1QrTS7OaMj_5QrCUjbW1R0yY-aQ&oe=69A42D1B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "sup
_name": "HyperTunnel_512x512.png", "id": "582275383322950", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031308_582275386656283_6803128145636186478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shvAQWF2JWsQ7kNvwFiZNKD&_nc_oc=AdrxzgJ2C_5UL94GGDRNkaYYGnEZ0FiT37M4fnlH2i34AcN5KDVabHV0OENIoUCq7aM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-XEWHUVCO9xUiybxhQdpR2yHz2smiHP51Q93dImYELw&oe=6A900E09"}]}, "id": "1687851092502135", "locale": "en_US", "screenshots": [{"file_name": "avatar_scan.png", "id": "450365491476415", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391911_450365494809748_6813377696520861437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s3inloaVc0Q7kNvwHGgUx5&_nc_oc=AdoBDiVcN_dusNAJAJcs01v7bFScvE_VZFUnIPxUEuv441DtuMXwy-V-WyeAxE_olqY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6pgIC_xF-nn0e6COYf4mXijQaNMSXjpYZx1Mw77BfcQ&oe=6A900BCB"}, {"file_name": "arrow_lift_AR.png", "id": "1975822209610348", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgLN6J3LW_kQ7kNvwHcGUrs&_nc_oc=AdporaW0Aazefolzk2kYmBDbRKsr-WHDsRyvtXoUHbS8bJj1DAA0PGHo7gPHa_zlioU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn3MXcV1N84Al79PEclWKECJ_3pLZFo-MlgOlCQ8zjKQ&oe=6A902F3D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qs-WkonEzYQ7kNvwF2cEdd&_nc_oc=AdqwZsq-YTsxQD95xRLwuFD5N69H9miaWzbfoWpfwq6GkbqxESzRMSwTXHzcr4W2zbA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFPb0kuar8qaT8eoDlr83GDomVhqXzaWB2UYqMUPE4dA&oe=6A901D66"}, {"file_name": "3D_scan_vr_3.png", "id": "27448402331518336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_27448402338185002_7065044147261452068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9QAmzbH5SoQ7kNvwHsGzWt&_nc_oc=Ado9V0NwalpLMpalFXt1xFkgcedr82EvhnKJ0QoaA9SRanNdvrdnPIrJNtIFuKosW8c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3zftV09z3010IWgDhsQDzA7OFrWO48p4zQBXAd6GuFA&oe=6A903D57"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzzblPE1cpcQ7kNvwFvy2M-&_nc_oc=AdpqwBt254kiZ7acAcTR48yHW0mJ7oL72BZpyeiP6gkXmreEBhux7ov96sB7Et8_Owg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7_n1Ejw_dJyeF9ab1fnKVddoJBC59vT88fhsUle5G2Q&oe=6A903A6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXR92SfmBSQQ7kNvwHu-M7G&_nc_oc=AdqIf8dWzKR7WBHcd6dNJMMJXbVU_zqOrZQDZZf5fvH-R3eCeaRXwukzJgLC1o-CXCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2SCMr-L_E1kUS_F7IVm5hIA7g5eRHNKbiNd7uiK_WYA&oe=6A90299B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37376580118599849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393737_1082682977234026_1836846954551857411_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaFH2AIKdqcQ7kNvwHz8Br-&_nc_oc=AdrDkLSGv
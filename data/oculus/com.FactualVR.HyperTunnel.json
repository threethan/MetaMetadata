_name": "HyperTunnel_512x512.png", "id": "582275383322950", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031308_582275386656283_6803128145636186478_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSUIl28SpOEQ7kNvwGZ1B33&_nc_oc=Ado5F05XlQgfQZ1hUtKl4LEY5zHp6IWVwWAZZV6t9v5mh1WJLwbTCu4qN1aCAN3JaCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB-hU9Fi1FL1LqFhd3vyaPzrAAUW4wu0urmNvca00xdw&oe=6A6A0AC9"}]}, "id": "1687851092502135", "locale": "en_US", "screenshots": [{"file_name": "avatar_scan.png", "id": "450365491476415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391911_450365494809748_6813377696520861437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knHcRCjB1SEQ7kNvwE_uIhQ&_nc_oc=AdrJH7etdNUEYgr9arQ9j0xpv0hlfG2-k06PCkf363ihKx9ezRGgkaOD7EaQdRq9gZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEjDLbG0bt8q-7P6CTnVUPlzQO1vvCeUa0wH_LtbNDQQ&oe=6A6A088B"}, {"file_name": "arrow_lift_AR.png", "id": "1975822209610348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_1975822212943681_2701265268583007454_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTDxd0-nCWkQ7kNvwGMEnjf&_nc_oc=Adp-_qRUrtPkkwXdX24RQ6Bel14cEi4HRAAufd502DLxnhJ77CGVDh5iBA5sknprZSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwVBY6er5pleptOwEKte8P9pE7cwq3XQAFmds1O5wRzQ&oe=6A69F3BD"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFlyPWvTc50Q7kNvwFIO9cN&_nc_oc=Adq4Rjzx1DsKlmbH5w_7EHEze7_R6A5Zlkr9vtciEXiJ4UwsSCsngTXIn4Qing-5VZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBphou7cz7sPFRjmbCjxfsCfIfdoem6b9g7Nw_uhTqTBg&oe=6A69E1E6"}, {"file_name": "3D_scan_vr_3.png", "id": "27448402331518336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_27448402338185002_7065044147261452068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yDemnJ8Cd8Q7kNvwF2_9As&_nc_oc=Adqs11ztT8MkmfdMGP2xQx27W_bsf07TxPSLaLRYBr0ihYyG8ukvB5HSLFLZ34P9YSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu-LE-fMmH2H-zX_4vBri-hQWLGWObu7qqesIU_YL4Qg&oe=6A6A01D7"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLujEAURBMUQ7kNvwGm6B4G&_nc_oc=Adrttt--1CxQiNUo3KOhaBzjLGl7wXmcIvsy7S_3zO99cIgls4Fnry-pcwF54f406Qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1BOCVXOAJgyfJRVlq_E94FSmIMoT-XSHhTukGpQY7tw&oe=6A69FEEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEG0s02Uc_4Q7kNvwERR0VA&_nc_oc=Adqbb5ic_fKAvETvwa3nvH70sTpZFwDehzm6Jgml4HCRyb2OrK9NFgd2bLFO-cnViEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvYHOTZDqJHiIlKnrDb35FLytgPD5vKAlDXcVgWTXoTQ&oe=6A69EE1B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37376580118599849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393737_1082682977234026_1836846954551857411_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mu3yn9bWbT8Q7kNvwHK4vtm&_nc_oc=AdoRshsNW
7a0a&_nc_ohc=tnB830UBfEcQ7kNvwH1Z41O&_nc_oc=AdlATEIJpO7m4WOnD9Dhb04DdwIZ0gg5y0GCzKn70fYDmcFSFK14nzKgoc3mgmmYgpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_vmw2VWmcPjm9Qy_-Yr4j6y27EYYqxu5I1fr56iPEdA&oe=699D9B3D"}, {"file_name": "scene_1.png", "id": "2509181076079578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_2509181082746244_742463170324691900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlEP9qVq9cEQ7kNvwHBj21E&_nc_oc=Adm2W0ziGM_qlW7W72uvO0P9IBYY5E6wj35j33Ei6-knMMWzg153v18vL1qQrLdUfYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu82JBzBXeZBHr8FwvQEOb5tXLBiOyxSySsjm6LXelrbw&oe=699D8966"}, {"file_name": "menu_hypernote.png", "id": "935447878779785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392162_935447882113118_1863237609928265712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhblhEC68UEQ7kNvwETRGkC&_nc_oc=Adk5D7nuMkfRkEX7lzH6wuSCtaMlkP_FF04pv9WObuguygtwjDtSisyVSqusBujyROY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs8T8rwstIR_6OTYG0UPi8OVfIFlKTT6iaZ0AWNAdv1tg&oe=699DA66B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_NEW.png", "id": "986489218729347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_986489225396013_2431188837476558669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur8bSh7J6kMQ7kNvwHVdlFr&_nc_oc=AdnLm-zGkBnpv7MWVbeWBCoodw7hpz48I-7bcNPWr84aLGM6QP9RR0qHLZNq5Ncui6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGK1XW6H55hfetTiyU9utczuYgyjvWBPq1YtfOiAXaiw&oe=699D959B"}, "display_name": "HyperTunnel\u00ae", "keywords": ["collaboration", "support", "xr", "vr"], "long_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side.\n\nUsing just a mobile device, frontline workers can quickly scan a worksite to create a 3D digital twin. The expert immerses in the digital twin using VR, allowing them to see and interact with the environment as if they were right there on site. \n\nThe worksite and the digital twin are synchronized, and digital annotations - such as photos, videos, arrows, etc. - created in one place will appear in the other place in the exact same location.\n\nThe expert and the frontline worker can collaborate in real-time using HyperCall. Or asynchronously, using HyperNote, where they can record and play back detailed 3D messages.", "short_description": "HyperTunnel\u00ae's mixed reality platform connects frontline workers with remote experts across space and time, eliminating travel costs and solving problems faster. Frontline workers can scan the worksite to create an immersive digital twin, allowing the remote expert to spatially collaborate in real-time (or asynchronously) as if they were side-by-side."}]}, "developer_name": "HyperTunnel", "developer_privacy_policy_url": "https://www.hypertunnel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HyperTunnel", "support_website_url": "https://hypertunnel.notion.site/", "website_url": "http://www.hypertunnel.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "sup
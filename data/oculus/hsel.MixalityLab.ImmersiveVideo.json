ce (in particular the creation of new projects with new videos) the connection to a web server running the paneoVR web application is neccessary.", "short_description": "Immersive video training tool prototype for creating and using non linear story based training scenarios. The ViRDiPA version corresponds to the final status of the research project of the same name."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixality.de/paneovr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MixalityLab Emden", "support_website_url": null, "website_url": "https://www.mixality.de/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "SIMULATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3399034090412028"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2117531155665290"}, {"status": "PUBLISHED", "id": "840285678989111"}, {"status": "PENDING", "id": "2396902277354518"}, {"status": "PUBLISHED", "id": "1544262692651869"}]}, "baseline_offer": {"id": "1544262692651869"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764692460, "status": "PUBLISHED", "id": "2117531155665290"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26379571608343871", "version": "2.0.2"}, "id": "1267014443760144", "channel_name": "LIVE"
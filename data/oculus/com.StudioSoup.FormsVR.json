tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iN0Ah6LxblIQ7kNvwFDcPx_&_nc_oc=Adpg6y1Al8JA9MtqysRUm59sCApw5FYaQAdwz97MCmtIrBkWcLWNaNMGJ8uDxPBBEYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXp4mqMqUodE7xdpxC_TKwbYsiTSv7DkDEIIbhdHRTMQ&oe=6B0C827B"}, {"file_name": "macro.png", "id": "722089122777137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569428_722089126110470_5392331220366001_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQs306Wy0AwQ7kNvwGPwRAd&_nc_oc=Adqz_qDFPnU-IB23eQ3vMBwQAuNwK4xFa0Tx8yg7wZMmPewq6u1BYPwDtw7CnEzAQrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT43QpuL3EsOMo7cCv5qcEpWZMPLxLyED2bg5oE1U9Acg&oe=6B0C525C"}, {"file_name": "2560x1440.png", "id": "219588154501395", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75330717_219588157834728_42949276436480455_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S65RPqgpXYIQ7kNvwE8Ic4K&_nc_oc=Adq4ai-TAB1z1U3TMTnwTAF4X8p5Edfom8wxh1YDa-U3G2mzHmGJrgJYCd7JD72_Ll8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbYnBpkuuitZQVw0CRijpk44Ddj1B2jYx8MTqRLGs4aw&oe=6B0C766B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-tweak.png", "id": "981310274888786", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_981310281555452_1117390059192121703_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtr50tDAzS0Q7kNvwFIelJ-&_nc_oc=Ado89upRQANZ3xHN0BH0ZVczkgsea8ABRUX04sVDr8o9FK4jRICIANG8KrBAAYgvd0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDSnJRpOIkM2bMmm6MUqMRdANcu_VkhwRSEp66Ox-eIg&oe=6B0C57E3"}, "display_name": "Forms", "keywords": ["relaxing", "confort", "yoga", "minduful"], "long_description": "Embark on a tranquil journey with Forms VR \u2013 not just an app, but a creation sanctuary in virtual reality. Picture a serene landscape where form-filling transforms into a therapeutic artistry. This is not just a data entry task; it's a meditative experience where your every input becomes a brushstroke in the canvas of your digital world.\n\nForms VR invites you to unwind and create, seamlessly blending the practicality of playing with geometric shapes with the soothing rhythms of relaxation. As you gracefully navigate through fields, each interaction is a moment of serene creation, turning the mundane into a tranquil masterpiece. So, let Forms VR be your escape \u2013 a haven where productivity meets peace, and every form filled is a step into the realm of digital zen.\n", "short_description": "It's an artistic and interactive experience where you create your own sculpture, graving and putting together basic geometric figures that turn around the user, changing the shape and texture of them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.studiosoup.tv/forms/Forms_PRIVACY_POLICY.pdf", "developer_terms_of_service_url": "https://www.studiosoup.tv/forms/Forms_Terms_of_Service.pdf", "publisher_name": "Studio Soup", "support_website_url": null, "website_url": "https://www.studiosoup.tv/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27398055946547822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314659_971391959233865_5930093678180846291_n.png?stp=dst-png_s360x
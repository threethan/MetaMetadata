zObK2nD_q4UTKOCzZHVYKYJfPITztyA&oe=6A26E53B"}, {"file_name": "macro.png", "id": "722089122777137", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569428_722089126110470_5392331220366001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ryhVk9awecQ7kNvwFoqtVA&_nc_oc=AdoBmXcq5vfBpeqjsYGRDURf0P2WoisLxlk4NU49coYIBmQpOg4TsRAu58a_kLhnKtQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GilWofDxUqKg8u-j5uuagUTtPAS67RNfbNR2W9F3Dcw&oe=6A26ED5C"}, {"file_name": "2560x1440.png", "id": "219588154501395", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75330717_219588157834728_42949276436480455_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5F7osUiASAQ7kNvwHynca_&_nc_oc=Adpcewx5HO0b6tnzNvUoaGCueM28RYXHTwul4SWden5I1M1FMVm0wlMAkXGA3bMVFUE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FITEaes356x7uuHBwJPps_EunLHe0a47qce4bTHGnQg&oe=6A26D92B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1423777151881140", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982613_1423777155214473_5949143696406167896_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CXJmZer_EwQ7kNvwFSW7gH&_nc_oc=Adr-9hq009iV2o0kYqZ7kcheHc7PmUKguappnReqpfchovuiwvfcsFuLhDbrl0ER3K8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LTjQi75Ns9-XpgDzEccUhl6QtLAy97f4RM5f1EJS6Og&oe=6A26E893"}, "display_name": "Forms", "keywords": ["zen", "relaxing", "confort", "mindfree"], "long_description": "Embark on a tranquil journey with Forms VR \u2013 not just an app, but a creation sanctuary in virtual reality. Picture a serene landscape where form-filling transforms into a therapeutic artistry. This is not just a data entry task; it's a meditative experience where your every input becomes a brushstroke in the canvas of your digital world.\n\nForms VR invites you to unwind and create, seamlessly blending the practicality of playing with geometric shapes with the soothing rhythms of relaxation. As you gracefully navigate through fields, each interaction is a moment of serene creation, turning the mundane into a tranquil masterpiece. So, let Forms VR be your escape \u2013 a haven where productivity meets peace, and every form filled is a step into the realm of digital zen.\n", "short_description": "It's an artistic and interactive experience where you create your own sculpture, graving and putting together basic geometric figures that turn around the user, changing the shape and texture of them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.studiosoup.tv/forms/Forms_PRIVACY_POLICY.pdf", "developer_terms_of_service_url": "https://www.studiosoup.tv/forms/Forms_Terms_of_Service.pdf", "publisher_name": "Studio Soup", "support_website_url": null, "website_url": "https://www.studiosoup.tv/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27383993807954036"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974868_354341003729886_3096768638034734233_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cu7zsXO6JLQQ7kNvwE6rzoY&_nc_oc=AdroCnNU1Ytv27jc5Wcsptm0oWhTyEzA7yGy1k6777QJYTsa-Ka-DxkVwkKKiWnzOsc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K6juSoEZZ-c1Veii-IPwR2un9AfqDMZ_vYkqfPk98wQ&oe=6A26EDB5"}, "is_concept": false, "is_tes
tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h77EasPet8IQ7kNvwEiBikK&_nc_oc=AdpA3oNmoP8CvgxYNItteqHdpOVSlBoY18fyc5uVSIhGnxtyGNjNuH-1gnXZcWssj_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLJktS3eKPx5rmPCWsPVqwsjWK3D1-Ov3r7MLEF8fcEQ&oe=6B0EED3B"}, {"file_name": "macro.png", "id": "722089122777137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569428_722089126110470_5392331220366001_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ghfa2NgCk9wQ7kNvwGIu2mm&_nc_oc=Adr8CMjB2lZVN3JXj8UlGW6oWHF7k1Dkpk8lRCg7kDRrDj_kdMPSKKl0HmT5Ogty0ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVhbxii3yJZhLZ4nJvTZUF6Sw7M3OJ4mDZVLXe3l_SQJw&oe=6B0EF55C"}, {"file_name": "2560x1440.png", "id": "219588154501395", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75330717_219588157834728_42949276436480455_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S65RPqgpXYIQ7kNvwG77bqo&_nc_oc=AdpC1rJaHqb1AaEPfXeMOVi7PuaKCblWUDpsPA15tM2YXCqXarIJy1ZIYf8Z8PVSAJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUOIqdSIZq9Vp2UihQ2-I8TH6Da3y8OEcSzA8hN9lrF4A&oe=6B0F196B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-tweak.png", "id": "981310274888786", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_981310281555452_1117390059192121703_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtr50tDAzS0Q7kNvwEc08LD&_nc_oc=AdrjNROOw-Yo4p3hTBYWyr-sdstEguFroTqKLXN3rOKp56NoLg9kVWsPuo1vcD2WWkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJWSsVKMQ5G8mo1If1zj1PBRZG3QaKUofnx248L4QiGg&oe=6B0EFAE3"}, "display_name": "Forms", "keywords": ["relaxing", "confort", "yoga", "minduful"], "long_description": "Embark on a tranquil journey with Forms VR \u2013 not just an app, but a creation sanctuary in virtual reality. Picture a serene landscape where form-filling transforms into a therapeutic artistry. This is not just a data entry task; it's a meditative experience where your every input becomes a brushstroke in the canvas of your digital world.\n\nForms VR invites you to unwind and create, seamlessly blending the practicality of playing with geometric shapes with the soothing rhythms of relaxation. As you gracefully navigate through fields, each interaction is a moment of serene creation, turning the mundane into a tranquil masterpiece. So, let Forms VR be your escape \u2013 a haven where productivity meets peace, and every form filled is a step into the realm of digital zen.\n", "short_description": "It's an artistic and interactive experience where you create your own sculpture, graving and putting together basic geometric figures that turn around the user, changing the shape and texture of them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.studiosoup.tv/forms/Forms_PRIVACY_POLICY.pdf", "developer_terms_of_service_url": "https://www.studiosoup.tv/forms/Forms_Terms_of_Service.pdf", "publisher_name": "Studio Soup", "support_website_url": null, "website_url": "https://www.studiosoup.tv/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27398055946547822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314659_971391959233865_5930093678180846291_n.png?stp=dst-png_s360x
tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3f6e2F4r-kQ7kNvwGsquQN&_nc_oc=Ado8SMMp31676PObE5q8R3y5klUQdpnuMq8595LN84u_OHAaOu0yO-eMaIKnKWa1b7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRU2lLBe7h_rHdiTzYsREdBZbvSsvWoL0ADNWwsqCi-w&oe=6B07043B"}, {"file_name": "macro.png", "id": "722089122777137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569428_722089126110470_5392331220366001_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0qxtsDzpR8Q7kNvwHGuA0n&_nc_oc=Adr8G9IR1uPRwayQNrxOkqVCo35iRB_9ADpdfQx0d-dy8dHmMKkHX4jUWO1_5YBzA10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHyr9C8fPYsIhlg3i9qcjhbJ2DFpWOWJUd50hXTCkmLA&oe=6B070C5C"}, {"file_name": "2560x1440.png", "id": "219588154501395", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75330717_219588157834728_42949276436480455_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPK1oR7eVvoQ7kNvwEEcY1d&_nc_oc=AdqqN1WEjxwLyBidl7r9_TJv0OCZ9dXErzptIpg16Z6WSrK9qae36dMR0PUc2lD2jvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHyvhnBjDP8KrJZetpjd9ZI3K-3tFUZWp4HeNbDlB1Iw&oe=6B06F82B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-tweak.png", "id": "981310274888786", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_981310281555452_1117390059192121703_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdScY_wNt4wQ7kNvwEgJOWa&_nc_oc=AdrYHtxgnju4NTTQhDM66YcvpDfW9fm_rWbb725Hy1nlURiS8XqyMbZF9y3Q9DelgGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5AgePyZy-XXY5vtjlGoXiK3x3HqMzFkF7AAfrQwVR_g&oe=6B0711E3"}, "display_name": "Forms", "keywords": ["relaxing", "confort", "yoga", "minduful"], "long_description": "Embark on a tranquil journey with Forms VR \u2013 not just an app, but a creation sanctuary in virtual reality. Picture a serene landscape where form-filling transforms into a therapeutic artistry. This is not just a data entry task; it's a meditative experience where your every input becomes a brushstroke in the canvas of your digital world.\n\nForms VR invites you to unwind and create, seamlessly blending the practicality of playing with geometric shapes with the soothing rhythms of relaxation. As you gracefully navigate through fields, each interaction is a moment of serene creation, turning the mundane into a tranquil masterpiece. So, let Forms VR be your escape \u2013 a haven where productivity meets peace, and every form filled is a step into the realm of digital zen.\n", "short_description": "It's an artistic and interactive experience where you create your own sculpture, graving and putting together basic geometric figures that turn around the user, changing the shape and texture of them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.studiosoup.tv/forms/Forms_PRIVACY_POLICY.pdf", "developer_terms_of_service_url": "https://www.studiosoup.tv/forms/Forms_Terms_of_Service.pdf", "publisher_name": "Studio Soup", "support_website_url": null, "website_url": "https://www.studiosoup.tv/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27398055946547822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314659_971391959233865_5930093678180846291_n.png?stp=dst-png_s360x
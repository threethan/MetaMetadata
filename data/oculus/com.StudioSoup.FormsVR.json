lMmW-jejJXlPQ&oe=6A5622FB"}, {"file_name": "macro.png", "id": "722089122777137", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569428_722089126110470_5392331220366001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kxxFyRbIv0Q7kNvwGa_Xh-&_nc_oc=AdrCJcphWnUM5HbVqvNJ1KZ6j_hoyJG911frDiI8HipnVf4PaHHQa6OttzanPw_OesQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDko0E0oo4lniuH70eUnR5pcegz_sYLXngx0GnJLq7jxg&oe=6A562B1C"}, {"file_name": "2560x1440.png", "id": "219588154501395", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75330717_219588157834728_42949276436480455_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUo1jN4UaAwQ7kNvwENFX-7&_nc_oc=AdpLk4MJYUmj8JrSezSPQ_59r16dKrqEjy5x7HmjKd8-9W4VbFMgPlrbubgPaaUASd4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwlOPsjHhqLZU4N0XV1pLSkzH8aH0reX9bsrt2ftgf9w&oe=6A564F2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-tweak.png", "id": "981310274888786", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823783_981310281555452_1117390059192121703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsGDEdvM78YQ7kNvwG82Ogy&_nc_oc=Adq7M18btByMWUalm4qnA7aXKsnT5PC3d-ooUoT2D7WU9j5-CMvymIvHx7SXD5L3ctw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdPa1qdgmY85rjlh08oU2oN-L45R68AWE6S90IeRs_Ig&oe=6A5630A3"}, "display_name": "Forms", "keywords": ["relaxing", "confort", "yoga", "minduful"], "long_description": "Embark on a tranquil journey with Forms VR \u2013 not just an app, but a creation sanctuary in virtual reality. Picture a serene landscape where form-filling transforms into a therapeutic artistry. This is not just a data entry task; it's a meditative experience where your every input becomes a brushstroke in the canvas of your digital world.\n\nForms VR invites you to unwind and create, seamlessly blending the practicality of playing with geometric shapes with the soothing rhythms of relaxation. As you gracefully navigate through fields, each interaction is a moment of serene creation, turning the mundane into a tranquil masterpiece. So, let Forms VR be your escape \u2013 a haven where productivity meets peace, and every form filled is a step into the realm of digital zen.\n", "short_description": "It's an artistic and interactive experience where you create your own sculpture, graving and putting together basic geometric figures that turn around the user, changing the shape and texture of them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.studiosoup.tv/forms/Forms_PRIVACY_POLICY.pdf", "developer_terms_of_service_url": "https://www.studiosoup.tv/forms/Forms_Terms_of_Service.pdf", "publisher_name": "Studio Soup", "support_website_url": null, "website_url": "https://www.studiosoup.tv/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27398055946547822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499314659_971391959233865_5930093678180846291_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S7GPQPISesQ7kNvwEpM7Of&_nc_oc=Adpr8GSi4h0ryuC2MAds_AlbrL_WokvoV4kAMFJDAiBfmWe5SJR7Yye22ReeVTtPUCA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCuKTz0UisB4G8GcJrxFkvr35KCvs7ADqT8E--jHF9sQ&oe=6A563053"}, "is_concept": false, "is_test": false, 
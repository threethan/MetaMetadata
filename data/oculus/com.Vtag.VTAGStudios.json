-3.oculuscdn.com/v/t64.5771-25/491823351_2686296758391537_8681392449040179568_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oxm9cF5fgIQ7kNvwFh_WYz&_nc_oc=AdrWq64uVnNfcuBdW4rD6B-pYyjSZEXOzWxyI7lTN5DhBiW1jnF8gniqKdxg6h7YwJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12lnX4JMOD6Bzf4PSWXaKEizevyXYt4LOL13hNn7s-Bw&oe=69D8F358"}, {"file_name": "GameModeHUB_2025-10-31_21-06-28.png", "id": "1317661799627817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_1317661802961150_1676879907550978964_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuexlAgb_cYQ7kNvwEoa1Vn&_nc_oc=AdpUDZsjTfBYzaXR-w0wQ9f4EKd0NoFQEla7jnqX9L0UPYmXld4RCQcPpmP3be6mOnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ny1WtXysDNQXiJOdDWhTHl4pnu6GnHeVevAndgQ6mDA&oe=69D90694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V TAG", "keywords": ["tag", "fangame", "vtag", "Gorilla", "Monkey"], "long_description": "Welcome to V Tag, the exhilarating fan game inspired by the beloved Gorilla Tag phenomenon! Get ready to swing, leap, and dodge your way through a series of thrilling maps designed to push your skills to the limit. With its unique blend of heart-pounding action and imaginative environments, V Tag offers an unforgettable gaming experience like no other.\n\nEmbark on your gorilla adventure in the \"Only Up\" map, where verticality is the name of the game. Climb towering skyscrapers, soar through the clouds, and outmaneuver your opponents in a race to the top. With every leap, you'll feel the adrenaline rush as you strive to claim the ultimate high ground.\n\nJoin the discord: https://discord.gg/vtag\n", "short_description": "Welcome to V Tag, the exhilarating fan game inspired by the beloved Gorilla Tag phenomenon! Get ready to swing, leap, and dodge your way through a series of thrilling maps designed to push your skills to the limit. With its unique blend of heart-pounding action and imaginative environments, V Tag offers an unforgettable gaming experience like no other.  Embark on your gorilla adventure in the \"Only Up\" map, where verticality is the name of the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vtag-policy", "developer_terms_of_service_url": null, "publisher_name": "vdb", "support_website_url": "https://discord.gg/vtag", "website_url": "https://sites.google.com/view/vtagofficialwebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25201456912804442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303840_1914775429044514_4435490851508572258_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3M3FfjqKnQQ7kNvwGjXOJl&_nc_oc=AdrNimFpWcEw4ondHo-owU8NR08tOD7NHqT8LIUaKO9gCs6YiaNc-VCa9pzLXYUQgqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jw2jC0py_Qwb2EDsyF5uUBK0CueL2KdeNuLhLfuG-Dw&oe=69D90174"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V TAG", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528
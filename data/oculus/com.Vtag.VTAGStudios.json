il": {"file_name": "mod menu soon.png", "id": "1056705145627396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_1056705148960729_3216936393383934221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Vjtnr7B3F8Q7kNvwEQqcc2&_nc_oc=AdnslSKnPtlK_A-FYU-piF0v6YrOvZwBfPBv3vIxSlZW9GPGin88vsp4k3ZOAacEBR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgH2pWAkEacu6L0y5aIRCP8qCJYp9K-DB5PwZoga-tGA&oe=69AD8459"}, "display_name": "V TAG", "keywords": [], "long_description": "Welcome to V Tag, the exhilarating fan game inspired by the beloved Gorilla Tag phenomenon! Get ready to swing, leap, and dodge your way through a series of thrilling maps designed to push your skills to the limit. With its unique blend of heart-pounding action and imaginative environments, V Tag offers an unforgettable gaming experience like no other.\n\nEmbark on your gorilla adventure in the \"Only Up\" map, where verticality is the name of the game. Climb towering skyscrapers, soar through the clouds, and outmaneuver your opponents in a race to the top. With every leap, you'll feel the adrenaline rush as you strive to claim the ultimate high ground.\n\nJoin the discord: https://discord.gg/sdSCCFAT9F\n", "short_description": "Welcome to V Tag, the exhilarating fan game inspired by the beloved Gorilla Tag phenomenon! Get ready to swing, leap, and dodge your way through a series of thrilling maps designed to push your skills to the limit. With its unique blend of heart-pounding action and imaginative environments, V Tag offers an unforgettable gaming experience like no other.  Embark on your gorilla adventure in the \"Only Up\" map, where verticality is the name of the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/official-vtag-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "vdb", "support_website_url": null, "website_url": "https://sites.google.com/view/vtagofficialwebsite/home", "category"
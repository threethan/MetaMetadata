8g&oe=6B0C8063"}, {"file_name": "migrated_image.png", "id": "195019658591381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449084_1602594509826814_4454213340327051264_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPiHLzl4yU0Q7kNvwHuFoJB&_nc_oc=AdrkA-3jvROydkHNMKRIM5PYHJVZ4i13fdJ2Dyt1HUs24fZWRF72Oss4vOR4_8DGZIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2WvOVr7jdPfXlnNsveYrTX_Cf3XrpNn4qVCoA7aeMfg&oe=6B0C6EB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Race for the Galaxy", "keywords": ["Race", "RftG", "boardgame", "card", "board"], "long_description": "Explore, Develop, Settle, Trade, Consume, or Produce? Which do you need most? Which of Earth's former colonies will be most successful at settling the galaxy, now that JumpDrive exists? Who will discover the secrets of the mysteriously vanished Alien Overlords? Your goal: to build the most prosperous and powerful space empire!\n\nBased on the acclaimed and best selling board game, Race for the Galaxy brings the galactic conquest to VR. \n\nGame Features\n- 2 \u2013 4 player with network multiplayer\n- Single player mode with advanced neural network AI\n- Five starting worlds and ninety settlement and development cards\n- Free promo pack included: New Worlds with six additional starting planets\n- Gathering Storm, Rebel Vs. Imperium and Brink of War expansions available", "short_description": "Explore, Settle, Develop, Trade, Consume, or Produce? Which do you need most? Which of Earth's former colonies will be most successful at settling the galaxy, now that JumpDrive exists? Who will discover the secrets of the mysteriously vanished Alien Overlords? Your goal: to build the most prosperous and powerful space empire!"}]}, "developer_name": "Temple Gates Games", "developer_privacy_policy_url": "https://www.templegatesgames.com/privacy.html", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_n
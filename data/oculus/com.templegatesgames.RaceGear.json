nUSD1f7VbAY52k5V4QUDEXinZLi6h0Tj-U7ULZm1t4DFHoS2krZO7JdMVYw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQAdYlB7dYPg0wAudYgc7X4RWb9jdFKvubvq750NSWpg&oe=6AAE9BF2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Race for the Galaxy", "keywords": ["Race", "RftG", "boardgame", "card", "board"], "long_description": "Explore, Develop, Settle, Trade, Consume, or Produce? Which do you need most? Which of Earth's former colonies will be most successful at settling the galaxy, now that JumpDrive exists? Who will discover the secrets of the mysteriously vanished Alien Overlords? Your goal: to build the most prosperous and powerful space empire!\n\nBased on the acclaimed and best selling board game, Race for the Galaxy brings the galactic conquest to VR. \n\nGame Features\n- 2 \u2013 4 player with network multiplayer\n- Single player mode with advanced neural network AI\n- Five starting worlds and ninety settlement and development cards\n- Free promo pack included: New Worlds with six additional starting planets\n- Gathering Storm, Rebel Vs. Imperium and Brink of War expansions available", "short_description": "Explore, Settle, Develop, Trade, Consume, or Produce? Which do you need most? Which of Earth's former colonies will be most successful at settling the galaxy, now that JumpDrive exists? Who will discover the secrets of the mysteriously vanished Alien Overlords? Your goal: to build the most prosperous and powerful space empire!"}]}, "developer_name": "Temple Gates Games", "developer_privacy_policy_url": "https://www.templegatesgames.com/privacy.html", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_name": "Temple Gates Games", "support_website_url": null, "website_url": "http://templegatesgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "ha
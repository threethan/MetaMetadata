6A&oe=6B030DA3"}, {"file_name": "migrated_image.png", "id": "195019658591381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12449084_1602594509826814_4454213340327051264_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9B6_TyxAvkQ7kNvwEqo181&_nc_oc=AdrLt2yoMBtIkJdiTDDsXrdKEUCl1RJD0hcZXC3-MPy--8MosWrQd3eR1HFdzMenAjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ7HBZprzMsC_0pl8G_wFSaqivzpt7wBU3YXfP53Yl0w&oe=6B033432"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Race for the Galaxy", "keywords": ["Race", "RftG", "boardgame", "card", "board"], "long_description": "Explore, Develop, Settle, Trade, Consume, or Produce? Which do you need most? Which of Earth's former colonies will be most successful at settling the galaxy, now that JumpDrive exists? Who will discover the secrets of the mysteriously vanished Alien Overlords? Your goal: to build the most prosperous and powerful space empire!\n\nBased on the acclaimed and best selling board game, Race for the Galaxy brings the galactic conquest to VR. \n\nGame Features\n- 2 \u2013 4 player with network multiplayer\n- Single player mode with advanced neural network AI\n- Five starting worlds and ninety settlement and development cards\n- Free promo pack included: New Worlds with six additional starting planets\n- Gathering Storm, Rebel Vs. Imperium and Brink of War expansions available", "short_description": "Explore, Settle, Develop, Trade, Consume, or Produce? Which do you need most? Which of Earth's former colonies will be most successful at settling the galaxy, now that JumpDrive exists? Who will discover the secrets of the mysteriously vanished Alien Overlords? Your goal: to build the most prosperous and powerful space empire!"}]}, "developer_name": "Temple Gates Games", "developer_privacy_policy_url": "https://www.templegatesgames.com/privacy.html", "developer_terms_of_service_url": "http://templegatesgames.com/", "publisher_n
5s0o9A6duaWJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvUOVnDdxy8Z-VJ1E2nGLzhvCt8o-N_wgL5fvbEVYgBw&oe=6ABFCDB6"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "740687990970688", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574716_740687994304021_2461158189349071575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpoJl2F9IEMQ7kNvwG8FYEU&_nc_oc=Adr-55399zv9PsHSOcG_j2xXHPPOp3ahbov_E6r6LAV2lde4zap47ZAGtjOmGJK9sr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3qLbtElkIh_bHiHtVt4SptAeeJf4qP34d-L2K_Brt7A&oe=6ABFBAC3"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "731029285183079", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307247_731029288516412_2568391399924917672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMBtaf4mivMQ7kNvwHBMo41&_nc_oc=AdqEcCxknfjSBZDzw1NsJzfiZovtSXxR8YhpqqMAzPEbWAPQ6BYPfWTqvU2gWalVWpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeOBUHzO--fpjqF1gp9LbOCkoWfe3XsNC7hjd5erEDfg&oe=6ABFB355"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "1414943245943812", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001657_1414943249277145_8605847966772087042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P_QaCXrAyoQ7kNvwEyzfYU&_nc_oc=AdqLO0j25aUfpoG1aGXI_gWki5MqWEXtIfX8_72Pcs8lr8W96KvtPDBAO31W_kqMj1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhmsWgYAWKmPi6dmRTL3vO6mMey74WD758D2gk6nDvNA&oe=6ABFCCC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kayak_Screenshot_01_2560X1440.png", "id": "689547289582259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974828_689547292915592_6839630466582860738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxX2PQ6PETsQ7kNvwHJ0w8j&_nc_oc=AdrRMIrf45mpF1_2YCjDg_cGGCDjGxwAAWyCpfzlZa50MrO40ioT-C4L5RtChSxA0F0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF3eTsmBpcw5Bo24F-5nfamlnEQ65NfzQv5-dq-2ravg&oe=6ABFAC3A"}, "display_name": "VR Kayak", "keywords": [], "long_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your kayak to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
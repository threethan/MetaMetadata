Dh9QX5G_N74Hj3mCDKLqtDYM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElKrhvwd1U0m3QLOfr0QcpA-Gv_WQKfbkBALI0pN3kag&oe=6A8ECDF6"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "740687990970688", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57574716_740687994304021_2461158189349071575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKeiVJnZOd8Q7kNvwHm5nMu&_nc_oc=AdqDv0WU5Z1nMN6_c04ThSwQRG2VV4Vh7orTo3gh_N3o9RZSqukBtpxm1G8zC-Nl5vs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkH9RgYvv3i1ks9ej-IDDOCc7D_s67dRC1bLni8b4OyQ&oe=6A8EF343"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "731029285183079", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75307247_731029288516412_2568391399924917672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hzt4GLINT0Q7kNvwFPTcmI&_nc_oc=AdqS35-Mn4SfV9fPnj1tI1ftl_tE-PSom1ApaRSiqpcWybWvQ0US5SWEVtdqmMRyRzU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKlWqkGApxNB8C8Y3uLmvohjpbbY1qZBuDqU1KnEnsLQ&oe=6A8EEBD5"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "1414943245943812", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001657_1414943249277145_8605847966772087042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFxZeGnDWl4Q7kNvwFA1UQ7&_nc_oc=Adr9Lc2bjjZNO-VasPL07cXFU6ouQba_iu4b8uSUy_VGOmxqU2c5d2L5gS7bynnz3vU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEVnNF-8pKpTchOcAVme5IOb6OVhj92wQFFKnIohBnAQ&oe=6A8ECD01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kayak_Screenshot_01_2560X1440.png", "id": "689547289582259", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974828_689547292915592_6839630466582860738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Irq4DWORz54Q7kNvwF4BK1D&_nc_oc=AdoAxDqTnfeHII676u8oy_TnemcHxJH5uHwwdIhtjxywV_xVF2moXvtEBplNYfKGqxs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgI6bTXZJ7v5cL0dkr_AXDXiD1kRrySCDudQN9ui0Ppw&oe=6A8EE4BA"}, "display_name": "VR Kayak", "keywords": [], "long_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your kayak to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQ
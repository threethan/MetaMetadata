paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5965482956868603"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1190723581586863"}, {"status": "PUBLISHED", "id": "590351216444273"}, {"status": "PUBLISHED", "id": "244979358012842"}]}, "baseline_offer": {"id": "244979358012842"}, "is_a
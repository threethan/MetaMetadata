ontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwV8ehuHPIGUzp7aUxrcPJThhnks30o_SUS5UuUcU8O-w&oe=69B151F6"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "740687990970688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574716_740687994304021_2461158189349071575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ5U5j4c2XYQ7kNvwFPXqsa&_nc_oc=AdlOolA5glW736e8eKod_GXDrS4IpMXOAcJh7miCJNdWN0CnfUD0PKb2x3PeGVVw9ww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp1K3_mW-eaUMlIAwGVQ9pLBA1Z-CMa3QtMcKPvOUkoQ&oe=69B17743"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "731029285183079", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307247_731029288516412_2568391399924917672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy_FEeweiEUQ7kNvwHYddTD&_nc_oc=AdmpCGIiFJJMyMPTM7L3tGwldb_l4TLGrV9cl0Z34Jy3bjfI1SidXFAzhqWsUDF0wpY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyUOoGURAUnpOEtj3f6zm_E2EY-J_v9iMrJI9qJ7ssNg&oe=69B16FD5"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "1414943245943812", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001657_1414943249277145_8605847966772087042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JblCtoENZ2YQ7kNvwFws-LS&_nc_oc=AdlbcNevTvRiLVnb6rBY50fZfcAlV5vly9JUy2aN81pH7-NbdJlpk2rIPTangbR8YQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSy3UlFTMpeGbT94oQMZamV7YBpy2PXjAWEy9xuSoUkQ&oe=69B15101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kayak_Screenshot_01_2560X1440.png", "id": "689547289582259", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974828_689547292915592_6839630466582860738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dKKbbxsPIAQ7kNvwFPT_m-&_nc_oc=AdnU_pILNvmHEDax3uRXl_AVxnTm_ijmaEGTrRUP4ok-xOCgzUYzGdTBDEMTd_-QGug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOM5A4Ld6k9eSn4jtxlmBJ8ceb1P8ravm-zoSKe3i8wA&oe=69B168BA"}, "display_name": "VR Kayak", "keywords": [], "long_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your kayak to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null
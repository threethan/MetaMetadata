u7XPk5EPdnA_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGljKxYbcQfdSNcvg0L3dSInBmEUzzO6f980me74RAzlQ&oe=6A7EFBF6"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "740687990970688", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574716_740687994304021_2461158189349071575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVDdAB7dqKAQ7kNvwEAU1A_&_nc_oc=AdpvwBbcJWbsHDtQmNbmk2V7J0Lm-XL2zAemOLvYLla8hVS8w6g_Q0IfHTEBMfkY08A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP7kVly-7M1vo_24Zp2l9wF8dehkezAepTBJghP70qdg&oe=6A7F2143"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "731029285183079", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307247_731029288516412_2568391399924917672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMxgGe2hvJUQ7kNvwG7hoXx&_nc_oc=Adp5HCza49TyMno14xovb6ZMb8bVpghmCByIou1Y00nJsStdXGws276_aDR42C6XNHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfULBHQJiTKUpv9ydRUwuy-ZDAQuRB0-hCYE9D68eeXw&oe=6A7F19D5"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "1414943245943812", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001657_1414943249277145_8605847966772087042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4S1RZ8bJS4Q7kNvwGXgjgf&_nc_oc=AdqL4qjzXsCLrQB3Ubrj0W-zFtIql1cm89ppShqw0dsMSS_8yJVT7tiveiIQ1qqEzmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV5nai91hlKsGIJwJZHibhhMtsGh-e8b34DBCHLj2mQA&oe=6A7EFB01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kayak_Screenshot_01_2560X1440.png", "id": "689547289582259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974828_689547292915592_6839630466582860738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgUlthd0GjkQ7kNvwFanyD8&_nc_oc=AdrtZmQpQQhEoWLQJAcTpXDkDcrefoo5sorSi-sGPWoqfpkUzIzC6X25OtE3s_6u68I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExm6VUR4s76UF4Fq1dM1HFMrvIBiB-eG9bWUJl0Sg7PA&oe=6A7F12BA"}, "display_name": "VR Kayak", "keywords": [], "long_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your kayak to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
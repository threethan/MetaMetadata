pNp9HUMJAYuQw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EHvObkz6UCHSRqu49yRrusyZsY4QpY2qdIKiZUXtS0g&oe=6A340EB6"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "740687990970688", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57574716_740687994304021_2461158189349071575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swrj2rjDDhYQ7kNvwEHxxm-&_nc_oc=Ado4bddUV49hIQSeHP99_2VsdrPgVVvxjGSpINWnSTws-bJDA065libXQOvKiZsqnTQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PF8ZMu2P7LOxi9AeQGP4IcQbhj5uiefJqj83l8IVfLQ&oe=6A33FBC3"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "731029285183079", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75307247_731029288516412_2568391399924917672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKee76sla2EQ7kNvwFTN5Ue&_nc_oc=Adr9OzZishhlJmQdON25eBfLLRom8jYlJQw4yo9x6RUcwx35XeBR60sRi6SAhdrmDyk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84_mXQuOTAJZ3__NpjoOC8dOHjzOcSW4S2053ud_Gr_A&oe=6A33F455"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "1414943245943812", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001657_1414943249277145_8605847966772087042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2mdFR74N8EQ7kNvwFjvBt5&_nc_oc=AdpesE3mURnshupfFPlUg3dPwHYvevLZwlY5c-NjwcW3cUkbj_t1d2N5DYwrVq49vSw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E_nychpDV3If7svftqY7akrSMFOMpZVY4wlzpeSILFg&oe=6A340DC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kayak_Screenshot_01_2560X1440.png", "id": "689547289582259", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974828_689547292915592_6839630466582860738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdYVbaWSbkkQ7kNvwEVpudO&_nc_oc=AdoqmQre0rGjt4TE1Xa5rGC5Ol8aypMkYZ8nQ01RaiJEY-YsTd_CjcagI2-UojedCrg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y1ZInsGj3zUMibUnJg-ak66Ytw30E0QbH-6vo57f8yw&oe=6A33ED3A"}, "display_name": "VR Kayak", "keywords": [], "long_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your kayak to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
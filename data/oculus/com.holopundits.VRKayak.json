gskQii2TmsObE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03Z8_zYoHe6yN2XKQJygyP7ERSwLjduaAX_4f3E_JMrA&oe=69D398F6"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "740687990970688", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57574716_740687994304021_2461158189349071575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndr2ReZr3_wQ7kNvwFl_yi8&_nc_oc=AdpMsvBTyGIMhmhANmCZy6mNigCtJZ089kTwfZhFJbJGM6YAemej_uYuacwnRTD9WMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wH5hqSxUKLxwO9RnR4y9DDBKkkyPdPth_72j64vWrbQ&oe=69D3BE43"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "731029285183079", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307247_731029288516412_2568391399924917672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJy_ucgQMYkQ7kNvwFJ5nR6&_nc_oc=AdrbkQhKZOhOmlp2j-C7HFuBWV8hpZX5e3QLtO8O6BxbSSJXoqohS4lLL2R3qiuJws8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QqWOLKdmIMf6bv5XZsQwIsnkynXBxBOcwoRf_-iMA8A&oe=69D3B6D5"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "1414943245943812", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001657_1414943249277145_8605847966772087042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI-lktjwU5kQ7kNvwFhwKjr&_nc_oc=AdpBZlZaLVXgXR_HLjN7yvtHmUKaR_dCQGRXTqhmJOgJ1tG-WLbgjGLBhlSuDeMV2Sc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PrzpjcHZnjig0IEs-FVkr9GWfMq8j5G2vDkiEU04KXg&oe=69D39801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kayak_Screenshot_01_2560X1440.png", "id": "689547289582259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974828_689547292915592_6839630466582860738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhOSTFUEz-AQ7kNvwGfhbvF&_nc_oc=AdouxiiKVqA4ORns8TJxUyQoVTOXcVHbpJNzjun0MZ4LG1kRCELVP3GgBauc6yG9-ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kLhfLUc2oKnizUNB-_LpuaR_56XMk803UALwkopdXcA&oe=69D3AFBA"}, "display_name": "VR Kayak", "keywords": [], "long_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your kayak to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
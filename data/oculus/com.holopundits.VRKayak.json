2fIIfW1g&oe=69A6C5F6"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "740687990970688", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574716_740687994304021_2461158189349071575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEye8sNUX7YQ7kNvwGeGsX1&_nc_oc=Adk0OylED-RQnvC-vw5_socRWPEu3QHI9VLUokoBo9Oz0nphXA_uusx0OYMaxGFh44k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvz_blEz-9ff691Uu8uSMCAEWORxdEEhzOykvvbP0JAwQ&oe=69A6EB43"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "731029285183079", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307247_731029288516412_2568391399924917672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP6pNIDjfVgQ7kNvwFIZKNN&_nc_oc=AdmVTUADj3CXbEHL8t-Dkod_kfacrQ7gOuxWrYSFe1IzygqfKOpFjMOEA6T-UpoWyGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftapcaW03rG0rlhLmqXAZvypTNaS-TVdd7_91-A_kll0Q&oe=69A6E3D5"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "1414943245943812", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001657_1414943249277145_8605847966772087042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reoY6O7JycsQ7kNvwFmrwWr&_nc_oc=AdkJJCID72wCV6ZMWCxTKesAIDHcbqGPmQ2uhB9CqHcCUu3ik_izkdjAmKt-2zNjHPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfxHe_1UZtXsjV0y_kSyuNzq9WgvJ3lQMW3gJu5EzrLQ&oe=69A6C501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kayak_Screenshot_01_2560X1440.png", "id": "689547289582259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974828_689547292915592_6839630466582860738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wjNHMhjFeIQ7kNvwF-2pSZ&_nc_oc=Adl4ruTvpJm-GpdCevyVodZwpnEFb_kf5QoDRoSCxV-sPu7q9VnUxJgUwdFElDU_ad8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvLO-QnssrNCW-v2CHejsLQhFiQGlWX9S_TlBHyL9HJIA&oe=69A6DCBA"}, "display_name": "VR Kayak", "keywords": [], "long_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your kayak to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
4H5KEgnbM1UiM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bM5zggfqFOqY9doeCIApZBAowp5L9yiRKetcOiNgDDA&oe=69E64636"}, {"file_name": "Screenshot_03_2560X1440.png", "id": "740687990970688", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57574716_740687994304021_2461158189349071575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi5501HETlsQ7kNvwG3fBa8&_nc_oc=AdqBjKmd6Gtm9AzOb2g74v6j-1ki-beYuI5WI3S7YEHRy9slyy-UkaLbgwn0buxIfaI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1va9s5-2KKtCzczl274HTBWNikjXZFbwL8BBJNGKL6lQ&oe=69E63343"}, {"file_name": "Screenshot_04_2560X1440.png", "id": "731029285183079", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75307247_731029288516412_2568391399924917672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3nEbJscHRYQ7kNvwH_hAJN&_nc_oc=AdqAqu5ZVwMVXIzizbC7OGDk6g_CQpS_gyt767oY4PqJfe-u8jxUdWNwt6_dHCRs7as&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iV8q3p_7kfpglTw8WxDYF5JGaqfFisPEs9K1qA7AfLA&oe=69E62BD5"}, {"file_name": "Screenshot_05_2560X1440.png", "id": "1414943245943812", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001657_1414943249277145_8605847966772087042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXtTl-s-EPkQ7kNvwEDFb_i&_nc_oc=AdrdYiwVA8qd5Yv3h8ep_4eu3i-MtYdhPw_LQqjTndcZSuqKwgM478lxBcvQM_ae5Kk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VMccOuQr6a43dd7hkRqhGQflUmr6FKOVeah2InZvPsw&oe=69E64541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kayak_Screenshot_01_2560X1440.png", "id": "689547289582259", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974828_689547292915592_6839630466582860738_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWGAWvaRW_UQ7kNvwFiVUQ2&_nc_oc=AdqbJ1dz1qhBbPbDqgO6k9dgZwgt0mP-Hd6_Ncz8MtOFAvliFVPqznr-Tp4BSsf6keA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H4DfLzt527x7bax-jSfL93RAiob49OJTSJrwQ8dRZcw&oe=69E624BA"}, "display_name": "VR Kayak", "keywords": [], "long_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake. Birds soar above as you explore your surroundings on a clear and warm day. Practice paddling forward and backwards while steering your kayak to the left and right, safely passing ducks and other watercraft along the way. Haptic feedback in each controller reminds you that your virtual paddle has interacted with the water, maximizing each stroke. This experience is ideal for anyone who loves kayaking or wants to try it for the first time. It also benefits anyone with phobias looking to face fears and build confidence in a safe, dry, controlled environment. \n\nDon\u2019t forget your personal floatation device (PFD)! \n\nBenefits include: \nRealistic watercraft, equipment and environments \nStabilization across the simulation, reducing kayak and wave motion to avoid motion sickness \nPaddling skills that can be transferred to real-world kayaking ", "short_description": "The Virtual Reality Kayak simulation provides a safe environment where anyone can succeed, from the first-time user to the most seasoned paddler. VR Kayak brings the watercraft experience to your headset as you paddle across a calm lake."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
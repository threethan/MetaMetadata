, {"file_name": "gala360_screenshot_2_hotspot_tour_arches.png", "id": "2345265052938953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_2345265056272286_7004065813329498609_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNkfrDGudX0Q7kNvwFYxrzk&_nc_oc=AdqlSe38X_5lTarh5BLK8tPtVpJQuM6qz21KaBj_6KpLuHqtVnqvyjTM-xD-maq4Cw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRZn0T3HHlTZgJbUO-rOFOfQYAser_LU-II45IvCpKZw&oe=6AEB4F61"}, {"file_name": "gala360_screenshot_3_scene_tray_abu_dhabi.png", "id": "1882711373100682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_1882711376434015_5093449232166758458_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxW7u_YESucQ7kNvwFzB2NH&_nc_oc=Adp5aGTUgYgLAHkAtRlKk6LIHDuLSfWi5Twm9pFPHFEe4MfuZrF8NuTAiL9dOmSywm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKsM6wsGSqx1OJssIYr-5ODaV6AhMD30862kqpKzn6lQ&oe=6AEB4975"}, {"file_name": "gala360_screenshot_5_home_shelf.png", "id": "1096020796603178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830576_1096020799936511_4542247317145945246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoBGlK6EOr8Q7kNvwHeyR3j&_nc_oc=Adq_Jev55D-nz_0kKz4laSbsmUc65g14JEszMK9g_aJtCsxl7b4g2ikRTtYyfawLvm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1lIAvLfwINJm9HBCIPi9EfLfyZXv5qkc_mYCod-Srrw&oe=6AEB2BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gala360_trailer_cover_2560x1440.png", "id": "2329133547845425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_2329133551178758_7225102749090868259_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq5Smzts5U0Q7kNvwGdS2nQ&_nc_oc=AdpILcsAe_sJbnwtgYE_x_ZG5Xlfy7HOF4ztpkS2roZdzUDfXor5uhuLFxFJ7Dw-U9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5mnd4IANdG8TR4cVt99OWGeFeI3MByN4WsowlxUqzZg&oe=6AEB357D"}, "display_name": "Gala360", "keywords": ["panorama", "travel", "gala360", "360", "tour"], "long_description": "Gala360 was a community for 360-degree photography. Between 2016 and 2022 its members shared panoramas of cities, coastlines, mountains, temples, festivals and the places they called home. This app brings that library back, rebuilt from the ground up for Meta Quest.\n\n- Browse albums of full-sphere panoramas and stand inside each scene.\n- Follow hotspot tours: aim at a marker and step to the next viewpoint.\n- Stereo 3D panoramas are shown in depth, one image per eye.\n- Comfortable by design: seated or standing, no artificial movement.\n- Touch controllers.\n\nMany albums are free. Gala360 Premium (annual subscription, 7-day free trial) opens the premium scenes in every album. Manage or cancel the subscription in your Meta account at any time.\n\nGala360 has no accounts of its own and no ads or analytics. Purchases are handled by Meta. Privacy policy: https://gala360.aicam.fun/privacy\n\nA new app, rebuilt for Meta Quest. Purchases from the earlier Gear VR / Go app do not carry over.", "short_description": "Gala360 brings back a library of 360-degree panoramas shared by photographers around the world between 2016 and 2022. Browse albums, look around every scene, and follow hotspot tours from place to place. Many albums are free to explore; Gala360 Premium opens the rest, with a 7-day free trial. A new app, rebuilt for Meta Quest. Purchases from the earlier Gear VR / Go app do not carry over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gala360.aicam.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "STW Software Limited", "support_website_url": "https://gala360.aicam.fun/support", "website_url": "https://gala360.aicam.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FO
_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj4CcaExGn4I19Vot1vQMoSOxKBMDkEqn4b8L5ojpfgw&oe=6AFF2A63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gala360_trailer_cover_2560x1440.png", "id": "2329133547845425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_2329133551178758_7225102749090868259_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsvfI9YiHFMQ7kNvwH-VyzZ&_nc_oc=AdprWVGnGI6udSVDQS6gGmV4I3YuKeoBnc0irQ-69OxPcHfcNs3zWdgkyNc_GVVbSAo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKHNcYFaCnrxgqXO1WlF07nbklf0pl-Vlh69aJTm359g&oe=6AFF343D"}, "display_name": "Gala360", "keywords": ["panorama", "travel", "gala360", "360", "tour"], "long_description": "Gala360 was a community for 360-degree photography. Between 2016 and 2022 its members shared panoramas of cities, coastlines, mountains, temples, festivals and the places they called home. This app brings that library back, rebuilt from the ground up for Meta Quest.\n\n- Browse albums of full-sphere panoramas and stand inside each scene.\n- Follow hotspot tours: aim at a marker and step to the next viewpoint.\n- Stereo 3D panoramas are shown in depth, one image per eye.\n- Comfortable by design: seated or standing, no artificial movement.\n- Touch controllers.\n\nMany albums are free. Gala360 Premium (annual subscription, 7-day free trial) opens the premium scenes in every album. Manage or cancel the subscription in your Meta account at any time.\n\nGala360 has no accounts of its own and no ads or analytics. Purchases are handled by Meta. Privacy policy: https://gala360.aicam.fun/privacy\n\nA new app, rebuilt for Meta Quest. Purchases from the earlier Gear VR / Go app do not carry over.", "short_description": "Gala360 brings back a library of 360-degree panoramas shared by photographers around the world between 2016 and 2022. Browse albums, look around every scene, and follow hotspot tours from place to place. Many albums are free to explore; Gala360 Premium opens the rest, with a 7-day free trial. A new app, rebuilt for Meta Quest. Purchases from the earlier Gear VR / Go app do not carry over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gala360.aicam.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "STW Software Limited", "support_website_url": "https://gala360.aicam.fun/support", "website_url": "https://gala360.aicam.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39255688980741835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1651121506739826_8513879638079666850_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwKPVoVSBLIQ7kNvwGoJquT&_nc_oc=Adq5HJPLQpCL-NNfAZX72wxCcjo6jWU15HnV-UhURAKJ2Iuf7Ou0J5r7R3QPQ8Swbus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgukx5v3q44QQG2F0Omf8L6IJbgRLHuap3A16VlH9CeA&oe=6AFF1C36"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gala360", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Travel & Exploration", "id": "72636858796180
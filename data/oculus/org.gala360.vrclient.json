, {"file_name": "gala360_screenshot_2_hotspot_tour_arches.png", "id": "2345265052938953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_2345265056272286_7004065813329498609_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7g7NsQi6IAYQ7kNvwHqReWc&_nc_oc=AdpKozpN5M3giz6ymkw1455NnoDVJX3EUWsOViE3B52SiRSl3dKiBtP1q8Z0oo9_WZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAtQN8DB2CXvMLnLt--5M4aROmQofbXCwNK7eVeajg2w&oe=6AEF43E1"}, {"file_name": "gala360_screenshot_3_scene_tray_abu_dhabi.png", "id": "1882711373100682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827585_1882711376434015_5093449232166758458_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6895t64pv4Q7kNvwG2zooe&_nc_oc=AdqablRRNSkqwVU1HTHzb8BdCCw7-forKNkKuJ7O1uiBlW6PdKoswIkDIbtPth-nmSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBSi1prsaKHflbo7ewaurOL6mas6nOLk_Gd-9mON24Qw&oe=6AEF3DF5"}, {"file_name": "gala360_screenshot_5_home_shelf.png", "id": "1096020796603178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_1096020799936511_4542247317145945246_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ro3wjIm7GhEQ7kNvwFm_UiF&_nc_oc=AdpbDSIv9EKs1-pphrMZSQ63T-kdwhcCSktinFPii0fcFualxBQkVfEbZu23f7NzRNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHKUn3npBqZApSMC4Tod3Dq8P7d7iubokOEXsWP9W1yQ&oe=6AEF5863"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gala360_trailer_cover_2560x1440.png", "id": "2329133547845425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_2329133551178758_7225102749090868259_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UhlQsIlagsQ7kNvwG0ls_E&_nc_oc=AdrIhHiN_xVIH1Ss0JSLomk8B_2a1PJkVqMAId4ZuDRd1Rqn2gaEnsYE8_HWxELBJhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3bWBBHNFhznpyIe7P6OgQexFKxgTSSiU7sscIIj6l6A&oe=6AEF623D"}, "display_name": "Gala360", "keywords": ["panorama", "travel", "gala360", "360", "tour"], "long_description": "Gala360 was a community for 360-degree photography. Between 2016 and 2022 its members shared panoramas of cities, coastlines, mountains, temples, festivals and the places they called home. This app brings that library back, rebuilt from the ground up for Meta Quest.\n\n- Browse albums of full-sphere panoramas and stand inside each scene.\n- Follow hotspot tours: aim at a marker and step to the next viewpoint.\n- Stereo 3D panoramas are shown in depth, one image per eye.\n- Comfortable by design: seated or standing, no artificial movement.\n- Touch controllers.\n\nMany albums are free. Gala360 Premium (annual subscription, 7-day free trial) opens the premium scenes in every album. Manage or cancel the subscription in your Meta account at any time.\n\nGala360 has no accounts of its own and no ads or analytics. Purchases are handled by Meta. Privacy policy: https://gala360.aicam.fun/privacy\n\nA new app, rebuilt for Meta Quest. Purchases from the earlier Gear VR / Go app do not carry over.", "short_description": "Gala360 brings back a library of 360-degree panoramas shared by photographers around the world between 2016 and 2022. Browse albums, look around every scene, and follow hotspot tours from place to place. Many albums are free to explore; Gala360 Premium opens the rest, with a 7-day free trial. A new app, rebuilt for Meta Quest. Purchases from the earlier Gear VR / Go app do not carry over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gala360.aicam.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "STW Software Limited", "support_website_url": "https://gala360.aicam.fun/support", "website_url": "https://gala360.aicam.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FO
9BOReeQkQ7kNvwGEI2pO&_nc_oc=AdoCAb4fGCbrmOJGNieNbZJM6kcMJMldZLj64pd3YerVgmRdWUyWDVeGErWNmmERIfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7ey3BB1hR_DdnNIrVZOrW8RriieKJSKkQoSbwhtbvAA&oe=6ABFD34C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvr4c1DI5ukQ7kNvwH2LH_Z&_nc_oc=AdqmkCC8m6aWi2P1wl6c9HNexgpBN2_p8_l71gZPaCd3aPE10qCUnVHUQKvtm8lT5a0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0dc-TGHWvbbyKUFOZmml0Ruf_55ZqK3tV1mTVb1XGHA&oe=6ABFC347"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPwnu-L0r8YQ7kNvwF9bmzl&_nc_oc=Adoq1cmBkGeX4i7F1vFH2NweF6bmTkaYdhVoLY0uYtqvrIp5XEYVyHEGJ-wDKUM4NoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtyclOWUl5-bpbUVfkv46gkNwinMsVBVeOgDWx3Ta-bw&oe=6ABFDB5C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7Rzs5krdE0Q7kNvwFUcuTV&_nc_oc=Adqvw84vK3SSPULwtaqZQYa9t862Bx5MsJXsHHMtkokjyVzD7jqSq4crW8lGG-wLA_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSiEHVoyQ2LxNtFfWnts9KUjX4sJyc6kBp6UV3_XhQrw&oe=6ABFB8BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPxIfupToUQQ7kNvwFDfnVf&_nc_oc=AdqjFuYRE01rPeFF5CC7HsFCIDNbzYtqzWphoP9sSLfXugdUK2gyok2nIiaFs9lxdLI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPslJx7Z2rKZS2zXPlc_yQI7fYk-zJcBmNlB8RdubTYCw&oe=6ABFAC34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
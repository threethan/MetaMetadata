mZ-JcXG8Q7kNvwHW2YE3&_nc_oc=AdqSaHgmTQPJ_wpU4aN60Ro0TNE2WdTaS6qix3js5n4YxFPDrj08ptHagPpkOlqeF2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTD5ZB7EVZffbkLzsYLiS8C8ELglyeZ8SUFC32fntlqQ&oe=6A898D8C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlBTLURAmR8Q7kNvwEbEH5k&_nc_oc=AdoKGA9sUrzLQ8F_ggmq_TowWlm-VKojKTJ7AvleNv1BkqklXHDvkzRXeLbsJMhX5AI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpEpPzJ3ZDSVrkM3JRky61_GFKrm8d1nrsUQ5drElZDQ&oe=6A897D87"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xczBR3il8qUQ7kNvwG4qTKY&_nc_oc=AdpcG1R0C2oRlHGZb3AuhIghN6Tp6H9sWiwKoJm8UHagvNbhc4C9TsZAu9f7FmRcrog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzFDK0lI4ieRbHlcNCnhu-8bS6QvzZOx0Xx7ZteWFb9w&oe=6A89959C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUHPEn6cErIQ7kNvwEsoYvn&_nc_oc=AdopJzUNtshWavOO1humYPSev4_1pnEZ45DqtEo22Ch2nby6sJA_W2ZxeHO5fFiUKp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqYQ97DG1DnQnkUw2njCYEloI8OeSBcPbTxCr306KKRw&oe=6A8972FE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grNW8P_5yJUQ7kNvwEURrjc&_nc_oc=AdqVx7KN9O16B-WervyHH7Q0rIc-fuyFpMNq7E4kJa4mWB6ZYyXLRRIkE9Ts3gxbEYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_-dfYkKraIqwpeolsJiAGWR4tswkj_DlouO10FHpRTA&oe=6A899EB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
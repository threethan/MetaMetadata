luscdn.com/v/t64.5771-25/499304236_702157059174946_8946897751560852824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPrymGoDRcYQ7kNvwFCd4yT&_nc_oc=Ado5KBbuvn-xsKn9H-JSa93KqbYehkRv5Eaj8z7GDpFxc2AEbWCTI6i956mNGnOZMsQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O3RVFDUHGL8YX4P5emP20N4l7C5-yiq580gdsR9nygg&oe=6A16DB0C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eO7BoRLxsgQQ7kNvwGq87Cn&_nc_oc=Adpjh2qX-s-0ny5oqKDXQr3m4wiL20ZkxWKOatcnXLw_JNLIv74cEPIepzbVF54ILEc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y252V4mn8RlM5RmMB-3p8_hIUWYBCWYJh63C6M1mLFg&oe=6A170347"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rCO_Xq7OikQ7kNvwFSd6P9&_nc_oc=Adrgm3ApoVcIpsWXuk3Kpyv61KXCUt-Ao398UR_CSC0AnhcpqfBQuhNePRix2CgJ4OA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c1k85Ddb7jLKmPBgZVMzk6w7-uEKo520JMEnxCw689Q&oe=6A16E31C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dZcD4kEr0MQ7kNvwE4RD7f&_nc_oc=AdoC6-iKe8l4Llo-hgos-DevE1dQ46KJboLqZk9FtPmoVaVsFc9tRFCrHC-KBAEsT6k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pS0OLwOJUz-qyyDH9q6EbboDHd3LeYlPH-qlJjJ8G5g&oe=6A16F8BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oR7dqwofmGQQ7kNvwFwVI70&_nc_oc=AdoS7UjdgrvtVm8WIoyc4fePj0v_0_3juIxA5g-zLSHTSZJCQ5H7yBsel3usHwLHTjk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VNdSxIYzLpvZDLGp7ISsq1SiKyjq84mV8RSv355Q2sQ&oe=6A16EC34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": nul
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgosig33w8oWD7v8Pn1tpn_1DS1pv_yI1F9bqqOhvRcg&oe=6A65F50C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8Kt4NyVeSwQ7kNvwEIhUSt&_nc_oc=Adq4ph-e9ylfVlplUd1GicVo4xUHmo_JpoPWXG_oBB6u5cLDe5HdfkkB8LhhjrPTNB0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCmiAiUw3LAb1FD9oecxBWZYWeaI2RUjGYZuaFdL2XkA&oe=6A661D47"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH1SYsce8agQ7kNvwEgJm8g&_nc_oc=Adrl_N3rEdXejVNwf3Rlqo0-ngXcbVzAiskMb8C7tZ3GC-oyUEPIvaro7yHlC_pGiBQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWAnQEt9WSv05iIuFF48U6uEbj1E9sAp1p-k1Ygi-IiQ&oe=6A65FD1C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYwCfqyU2FUQ7kNvwGhNjiu&_nc_oc=AdrBqACwNts1doyGrCOIbNxHvJ2SkuJ6RuVJ5HZDmWnkswZqvswscTK0MLAFS5nhOyI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABJY6H1_iQM8XcFjQbaIWSNmYXUEtveHLm7if9HP5O9A&oe=6A6612BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InlTk8EV9EQQ7kNvwGDALui&_nc_oc=AdrB4igpg9rH51ufUg4pQJTUKlMfyGSlg-FlJeujQoDmkOdn_5h0ZozJfJQm_Zau_RA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgq13xJ5q-yTHVmH3ycXsS7vAxCQP4D22x730_SEsq2A&oe=6A660634"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "com
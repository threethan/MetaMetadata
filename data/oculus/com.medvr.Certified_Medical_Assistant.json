Da7gx4HMQ7kNvwGsTpuy&_nc_oc=AdpOLOszlK2PQbM3_LwRAqzhkSaQI0MnifKudAOYL57u3DqSyHZiC6n8wP3B7_0Fcg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSqXebYT0pdTg__qoUezCWXPIMh1_Kln2xuUao9VdZRQ&oe=6AAABB4C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73QfSYJxQkUQ7kNvwFxExJE&_nc_oc=AdorwNiVVvr2r9MC9IFMNym3M88GEmVyWQYxjcVoqrKEve2Tmf1D2dnlpoY4jirUPrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYE2Otv2rR3a7dAMQtV6irUPT13-nwij-f1PLg4Dry_A&oe=6AAAAB47"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxWWa0xKg9gQ7kNvwGyWSXz&_nc_oc=AdrTdkr1rH3_wVMkJbdgfuXJfZsUeXzf-GbZb0LKPzUvnX0WUTIRZUEJVyhsyo4bbHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb9z-Ufp3vuGNhldZ4uOuz_nDGUrhm0NWDb6drvo3PQw&oe=6AAA8B1C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvalueAw_kUQ7kNvwEBQBpG&_nc_oc=Adrdtlas2iLJIOmKSKs_3mwtq6FhiLdRtZy8Ae9qmZXdUR2nUyAdz79u9BCY-BwbNnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ5VgRMYt2t8wJmPGcKVI-38_M-ctzqi-E-C2WaKt1Yg&oe=6AAAA0BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fVroGsYsoYQ7kNvwExvf8i&_nc_oc=AdoemMYeXzvZrk7SYylI6dd8z3_Jvifzl3dqwiwSMpGHREP7sXgL0OK3xljSSBcjOm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE_6NGNPINhkmBEBlqYga4d2aXJYgMqr3rdiyLRTKJFQ&oe=6AAA9434"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
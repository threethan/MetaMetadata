aN_M8Cv8Q7kNvwEhmIw3&_nc_oc=AdoriTdXkoo4mtaWNMSqrv2rodGd-8ALAJMfbDYs9sFlwUZpriynW9770fBv1vdnRQM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIObN8oJv16atNJC0KhT5woNmk-TXKq7xQNwOPLqWc9Hw&oe=6AB7EA4C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZIzh3SHn70Q7kNvwEiv2Ia&_nc_oc=Adpwg-4NwVlweCXmi00k4EFLipIkC6Ta2FzDjUTAMtZRSXfEASZXWWSKDfqTDtjc3tw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIZQvjPr_kex2zhFq5h9OthrxqILiArPbGlIKkibqQiQ&oe=6AB7DA47"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1optmdIWnpkQ7kNvwHd6fTs&_nc_oc=Adp-TYt4OVGI2vbsADkBwhXQyTERgWwkwzJdZWEUpZ2CEuC0_Te8Doh55aa73nBWexY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD1gib5mUITqWTrEoVqo5HU66dXvR36RSyt6kg8m2ryw&oe=6AB7BA1C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbYvWPLBcuMQ7kNvwFDt0TI&_nc_oc=AdpEQkUkb4AdFo0QURB-79QukAlI4q8t3gUOUd6tivEE7D5clKuh_QnlhqoR3AJmaAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIq3BBBpLpq3QDMKVX1A828xXZKJYrQCP1JERkOLkRgA&oe=6AB7CFBE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xXN35t3LjUQ7kNvwHqd8wu&_nc_oc=AdoYlXD49zoQyV0An2hN0_reiHcNamHGeZLJwEWIVFp5okZ4IbBrs3Uc1nMjo_w_zPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIbeJjefyrMg5eQaz-WDZO8BgKZoqNLNSPJLBEQDhFiA&oe=6AB7C334"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
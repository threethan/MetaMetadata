UIXqbtucQ7kNvwEAsLHl&_nc_oc=AdoZaTTgzmHhgMhNty8yvazhnKMyfhiNCjhvmB6vXX_To27RKz0YjeSN1TAwMVooYGs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_jYX4Eo219q5-OQBnjbPRMompEd5_-G3i1yg4ydCx_A&oe=6A9D8C4C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kRQy7lD2ecQ7kNvwFIPkOM&_nc_oc=AdrRF7na5fNX-dAirvcW8Yx9yefgRwaTD_zUVdLXc2rm4G87aNMU9hYYdr6bUZK37kQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItywg5eEtks2pEj4oWM32LkTVlwprmb-AvXR99kIeVKw&oe=6A9D7C47"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4XawurXEsIQ7kNvwHbGfe5&_nc_oc=Adrh8yHNDPyCgZR1HSUVogT2WlU17FzVjT9uBosn5ZHTx-H0sotu0Hz_1sUI8KR29XM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSYZ_8mahxWpGuxvytpOXz4D_9r5v3hN91kx2RK7a6rQ&oe=6A9D5C1C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdE4Sl0EyTkQ7kNvwGPaOd5&_nc_oc=Ado97vbmV_h0KE39O-BsYcI0UlvO-M9sGXsnPYQpj_Zuf9jrCRnpcGzKDlwCz_IqshY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm2Z2rK_y22QPru1F80ICysmgOiDkrjY2_Xbkz1jzUgA&oe=6A9D71BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN3Cqzmcn0sQ7kNvwF1rHIr&_nc_oc=Ado2U7M3bIAxQI-qPlQ1uf7Fr1Jx3YLbfA4sO4_NwUo0rFnSfivbURK32WOwCjOJqaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyif3Pm8-lTqtIlaRQpILt3ozXYSCHLIR5IO1gZl8Jew&oe=6A9D6534"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
.com&_nc_ss=7a30f&oh=00_Af0quhKRSQLDLNpBwlVGEMrhzuN50-3_MAt82wX9sdUb3w&oe=69D7B7F6"}, {"file_name": "image (1).png", "id": "729183236128361", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499316603_729183239461694_987177079573730916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEfBBG-5HI4Q7kNvwGdomf_&_nc_oc=Adrnx2MmXHwFgP6x3Z8yBXQtaly9Z1HMN8Z49LT3U9WLrmF-7_WE7fAIwGKLJrxl_qM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hIZLOCuZHVPPxd7dAgEPs1B15bo6w0VX4Few4NUWgJg&oe=69D7B414"}]}, "id": "796032369901119", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.vrshell-20250523-181540.png", "id": "702157055841613", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499304236_702157059174946_8946897751560852824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OheNJpeX5UQQ7kNvwFwQ1WF&_nc_oc=AdqalE9qCgNOUEI4huwArjQNkMKxgYJBLsVq5usmGbESynwqghQe-tuCCd_G6CT0iz8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ngpr_EgFS8RLe6nNO9RautV_-qOohnBC5w81P6yKT2A&oe=69D7930C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt6EifmbypEQ7kNvwEzXZyX&_nc_oc=AdpIitKjQeeWUsa0lAfU5xL1NtghVEWg0mOHIeKdaz9bfYW-CkWr2LoxY5p9SnR9FVc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07asu5BYUPrTPXvomrY2wmOn_iuVLi4kUCMcKgxtbUNQ&oe=69D7BB47"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng4p5CHlXmIQ7kNvwEdqDsO&_nc_oc=AdqingENQpMrp_nSt4kP8vv_9OsvZut-ry05Zl11cQs807s_p9xufKV6bozSd2Vr5XY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fZC2L8WCulDGm6yAKr0tKCejLVbS89k9aoeR8QfjADQ&oe=69D79B1C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3OKeGw5EqAQ7kNvwErc5Pj&_nc_oc=AdqtS2Tr74eAhDJL8se0hi4N_PMJBlLuPkg2FM1jPGSiRv9nQmVIYfK1TIcoTbLfu_E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19FtyZYS4DmO9ghur8NJm37fd0FzM2lA-JRWjzkJxKhw&oe=69D7B0BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrzoXhs8nHkQ7kNvwEkVQeM&_nc_oc=AdpZm6qzVFVKHSAHz_HcrApB3SSToWuoWrxOB1UdJtj5c6ndl7W-9H-2adLgR6MsJnU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zyi7FRwMTA9gF5fPjOvPClcOpI3KCpoJFmzt6U55v4Q&oe=69D7A434"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25017635254590659"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499617850_1076947337683046_1000364590982706284_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D5YEhAD04YQ7kNvwELQzwf&_nc_oc=AdpmeqDTTOiF5fS-2FKhtF0qJI_Ioy89rhBny3lCE1i3kwAYqAFEQhLNL7thxm5h1Sg
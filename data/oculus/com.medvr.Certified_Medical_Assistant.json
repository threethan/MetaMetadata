AVPrUvqIQ7kNvwEEg7uS&_nc_oc=AdpBsFymU5mKpI3fhsRB4cQMv9ai-OtJ2XPYAYmzIGiWUXWH8x8qhDqBkTAJXlF4tis&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8qmDiWkcH0I45GUINtQNz-EuIC-hIos7qW9Pa6hMQIg&oe=6AA1488C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVi2WtlmJesQ7kNvwHcCrz8&_nc_oc=AdpB_d0b7qCCSm3E4hkDPFhc_yZjzEcTGcXMkoWP-I2vFam9gtTVhsc-jwMYvkbw0Ik&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfLXMzQYKvZ-KKut5UD_fSg6f6eovGUDSe3Gw1jfWNNg&oe=6AA170C7"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sClU_K7BpuwQ7kNvwFReN7n&_nc_oc=AdqI-mQg9bhuVjwoRFl3HPXwrEbqcg4JyjXZgUV8DXMsXCa_xV3g7IKw0nG-KjiEsXY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy_XlEJ9nDhsCIEpB6vHvRdZ6_Fl4TvetWnnuI6tQeDQ&oe=6AA1509C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoGiQcQw8-QQ7kNvwFAeKSs&_nc_oc=Adr26O6S22J1XE7AOcHROdYY_QfCGHortCTCSz3WxpgbQrQkNR6EqENU_4EJJztBxCc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5Ue8KaDiNWFzL4zrWulnHS2xHfMrX0rcTMR61vnpi2w&oe=6AA1663E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUptzMmI8cQQ7kNvwFbgXiU&_nc_oc=AdpLFYV7zWnq_uCUr4MkiQwfrzmtHONvxmc9bqHZ2Ljjve2b058zpmYMxQKWJiTnUVk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkU2K1_C6kUtTYWF__elWfNHx4MAdBv61adHkXGdxP4w&oe=6AA159B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
mZ-JcXG8Q7kNvwEAOTfm&_nc_oc=AdrGyRBHXWURNbVOK4zvBQX2vSc0isBVgjn4765Fhkg4vWn89i7mBha8ryAWiSMdZTo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQiLbL6QzPeYLNKNSRjXECj3pSryvqEaF1yXU46bvu4w&oe=6A8ADF0C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlBTLURAmR8Q7kNvwEsNMB8&_nc_oc=AdoWt1tj4J_JH4sfz91bwDtRsKRGsDb_ZVyGoahjSHIOcQGC44sCIgWmXAeZvuY0BJ8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEhvNrjfenBH50pHJq8b09fYfcR3uK_MZLX_Pvkt-H_Q&oe=6A8ACF07"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtgKHpQxCdYQ7kNvwFhrkZ1&_nc_oc=Adogt1ur0TQbvubfs5Gqf-T1kjQfzxwf5ufhQiluoMM0QYXSAG8DExxSmf_WouXucdA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjiF7tWjQwcoawxb3fr9Etm3DvCWqdQgJU62MiuGc_yQ&oe=6A8AE71C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvnWcqNEx70Q7kNvwELqn-d&_nc_oc=AdpwQSPSz_gbfLr7BqAUxBFzD86Eq03u9cEs_b2amu-SNjneO6FwCJ6hES1fr_Li-6A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdsgDsQ326S63F6NybvVf-rVO-4UERj_cHFCk9p-ssNA&oe=6A8AC47E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grNW8P_5yJUQ7kNvwF9T70m&_nc_oc=AdpGreVGtMkYPGUBIjuxJ_GjOe80Pc8ztNmtqO5FrzO42Yqnxy9vOhQdGqSQPZbI5WY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbi_Bt7QgOBJykLwDFKyf3LW9ZXN_arhSrPLdD8tJahw&oe=6A8AF034"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
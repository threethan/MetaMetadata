aN_M8Cv8Q7kNvwEYiNUI&_nc_oc=AdokJHRx4WAFxKSM6FcE6l5OkHsyDzPjfGpmudr6ss9B-nMDzHDFpN7fY7ag9FA2QJs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEdbVNelDtmctPItKN4uMx8oxmtIconIkRwyXc-JzIqA&oe=6ABA8D4C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZIzh3SHn70Q7kNvwGhDaOy&_nc_oc=Adr32k_R5TBVDhMf9OQb7uGPlHX_ldWz7PpIyPcwb5IWDWPbh4SxMv86FDPgBInjzfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIACLYMosvrPx3rl7SXmBeDGiyQc7YCmjAvlXt0pnosMA&oe=6ABA7D47"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqIc3XPTTRMQ7kNvwFdOzHP&_nc_oc=Adofh9JABjOu_JIsRquYKMjKIPpV0eRCxYAx3pf88yKe_KRFGVrQLpgM7gVlGzfCJNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0J9EX-kDxYMHJUkxHn328wd_YQ5qVMGMT4N_ZFXT2-w&oe=6ABA5D1C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pj1yeW5lWQQ7kNvwH52IZu&_nc_oc=AdrcgF8hxNp-lh2xRdYEUCb2vc9HKDZIqmP6uCoJbN7zj8wUflmV8dJT0HF-95fjBP8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ064oJlIyu1-Lw7iUt06l0Jjb2IF6PSDVYqQlhT6rkRQ&oe=6ABA72BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xXN35t3LjUQ7kNvwE4Kx1O&_nc_oc=Adocz_CcvXArQghEiptXSyS8mRzsUmVxr17IZNgf6wse5v5bhRbYIafsNNJeHhKFGiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoptCfacw0LQaPNgLTwZtnG4kG88XYXf9AUgKE5E6tvw&oe=6ABA6634"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
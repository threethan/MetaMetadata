9BOReeQkQ7kNvwFO3YBS&_nc_oc=AdrNIBKyl_Db_6KHL00c_0rgtALAwMgrhQAWVUvLxKiB1QFbSYVpIZl1NMb1y-uIyVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5AFfIyscCBm3TnnfqCHt2l7FtloyngcdsiBEfiPCSOQ&oe=6AC124CC"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvr4c1DI5ukQ7kNvwHW5bKS&_nc_oc=AdrmrO-3o931-qIgSVosVYiEYaewBw7TG1iwX7isMuPGRkKt5bXomg6iUYak2vzizGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPayVixbLmmTQWZZl0WIolpbpPR7y-UlVD2Xj_wsLCWyg&oe=6AC114C7"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPwnu-L0r8YQ7kNvwEvLynY&_nc_oc=AdqZ8oQTQ4q8tHciqWChJSlRJ9jHwa2k5_1yTjESPmyRnKQZmDKYkubUtwkxO71kl1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHH0zEdVYdHFEpH01SfmtcZdfdImLYsLZFw1z-qHRAag&oe=6AC12CDC"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jKx2KuDQocQ7kNvwGYcglI&_nc_oc=Adq5_2XBB9d1sktGLrZRoPy00x2b1kwcoz6TXq0DkamD-Tf0wqU5GApiUDq988as0ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPuzk4eNfOToTtshvNcMKD6_IX6S67t-hHKCMY7Pkalg&oe=6AC10A3E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPxIfupToUQQ7kNvwEOdCZc&_nc_oc=AdqDYhg6R0a4etD2lRplbGMriDFRopBYbjs8jd0URSSxz_eCCrdWfz4vHQifbv-J7Lg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8ysFYI8MGuS7fQOusWqFXpbD9zm4H304QpGRg6F4Flw&oe=6AC135F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
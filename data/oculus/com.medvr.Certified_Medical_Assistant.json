, "CCMA"], "long_description": "Certified Clinical Medical Assistant is a virtual reality simulation app designed to train future healthcare professionals through realistic, hands-on experiences. This immersive training tool focuses on two essential modules: Infection Control and Communication in the Clinical Setting. Learners can safely practice key clinical tasks, improve patient interaction skills, and reinforce safety protocols in a controlled, interactive environment. Ideal for medical assistant students, training programs, or continuing education.", "short_description": "Certified Clinical Medical Assistant is an immersive VR training app that provides hands-on practice in Infection Control and Communication in the Clinical Setting. Build real-world clinical skills in a safe, interactive environment designed for healthcare students and professionals.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9895752250538873"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "547360691780946"}]}, "baseline_offer": {"id": "547360691780946"}, "is_approved": true, "fir
Vea587gwQ7kNvwGj016a&_nc_oc=AdqcsUUy9YuVVhD9S9s7Wy1JNHD18jbsxyGOsvSIlLUvyzetSEjoWtrBTf5Bge27Roo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX5V0g-ubJ-lP6IXcBkQkcn_F8M3SgcVYC43Lqz-X3QA&oe=6AB5474C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5Pvq0QpISsQ7kNvwFufEa6&_nc_oc=AdqBGY-ZV6pJtpk-lHTneulnYTODRq24GeAtq7k7H20__R9tAovtEjum6eRdi0arlzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkrga9vCROj5upwFk0W_u5-Rvb36V-MJVi99L5wezdNg&oe=6AB53747"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE4Rnc-OV7UQ7kNvwEULwCN&_nc_oc=AdriX2jzN4ffbnGnJnisN7vcjCHwZXJRFdSPY3nc415VAVHIFZ5x6FnjuDzROZggScE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBkIoPRx6kLfBCuXQWxnVM-NXaq6ma4mu68rwSaX2xBg&oe=6AB5171C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-qli4C_rVwQ7kNvwEPVCcF&_nc_oc=Adojiyvy5EDqWIUhLl9-ka6_kXJI4CYmvd5jIJcHsbYoDOhWopbf3WaAjl-VDx-4ES0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5zpD7uAxFTD0PDFaI-CY7lNf06_T6cKILU4KkICL_mQ&oe=6AB52CBE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgIU7xj9cEsQ7kNvwEmX8KE&_nc_oc=AdovjYsisLw_MxndakJ-D0IhAu5JDW_gzQfezr9obusjitKrGdrer-6vI9tIWqI-EaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7jfHdslwd3I8Lzd-xsqEsThql8MkdeNc98d8HrDP14A&oe=6AB52034"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
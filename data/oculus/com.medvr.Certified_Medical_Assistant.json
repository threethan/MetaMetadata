x81n1dSEQ7kNvwF-TpWr&_nc_oc=AdqbCKW8FdLLuJxxz4jz1nEaDYyz6p4oR-RsivXrhhWM6fSgBvFFTwkwU3gns8-rLwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLHaoQpU8AkLdJN8ZzUO9H5A4v4HjlYDREW3-h-MyyBQ&oe=6AB152CC"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvTTHJcKEI0Q7kNvwFz8YLF&_nc_oc=Adr_wwi0XvbkktwbvnKxpy1AK3DquygeB4IH1Oj01qjH4Ess5fwz_5YCNjz5hb9sKok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF76DwG_qcCFs9lK20Kpf1mUmcNsFDFo20Mmk3p7ta7Q&oe=6AB142C7"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMxMIiR6u40Q7kNvwE0fuUo&_nc_oc=Adp4BtkmfpGH8_RFyylUyb_GqgomPC-M_VdrB7rJOAGFKE7t7aqz2QiV9ed6iQGqw_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCR0hnsC3ugab8AUO3jzQbvFKtrXRxzD9Dsho4er1Oxg&oe=6AB1229C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naGnR_yqaSMQ7kNvwFn_mwg&_nc_oc=Adp3VOrKiKry_j9I6hkNQgy7ThqsQTL3M7WF--vjXmhrc0_8LdhMcbYNABQVtlQ2YXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhE0lOD8dUM3I2tO3dzR4wodklyZzESYrh_9wCXXvqXA&oe=6AB1383E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxinPIu860cQ7kNvwFycp5v&_nc_oc=AdqwLpSiXrtsMvGBVkkp3CVSI0ep2ZYeFW1xID5cRA7IJkWobwT2Vdh6qB-C21Sk8rY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxHQXF4wtHMps_bKax-6K4zQclw5WLBiZxVCt6eRn9Vg&oe=6AB12BB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
KUlLGGUkQ7kNvwEuQEKo&_nc_oc=AdqDDOisw6Rp8aJ328s5_hSBESIlTaQjMTHWMwBVSi-S7eeGn5DL1LTMuS7O5NTx75M&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJZh9P78bbvU-Ui2DhGqiY1OXocEhDr7VyEK4JrpcHaQ&oe=6A91768C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZCwWCJhG2gQ7kNvwErFMlf&_nc_oc=Adr1Vz4NYqX6p4XuVp38MJLfnQOCB6yWTWt1rIA4hgaQ-8WKchEJXc5fbLVdaRE6538&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh4GxGOEpMTHbWxU8kdmxKU0yvr95lRKud5aTprXjl2A&oe=6A916687"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nhZWVEKI_0Q7kNvwFBUR1q&_nc_oc=AdrnCbJyAFE2B9CG0G0YkOc96_GBq23zmjqw9HYOurG7OHxmrBWSwBP6khxACkn35qg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2TmUuopO2p8wTJJECklhYx4ZP0FAbcxy4uIg_cNae-w&oe=6A917E9C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x59uamDX54UQ7kNvwH6YkEa&_nc_oc=AdrZtjj7UmWxf9yo75-jBslu0T1ASsXQMJKft3lGmAF-6tQvBxbTz6SWRWtHUFf8SaY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuiGR0jH2ZzlINsivtt6AkC6GI7njLnkFFey1Uaq_a2w&oe=6A915BFE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tws9FPznZ1kQ7kNvwH8acMW&_nc_oc=AdqgxJTuvpMtTSaSr_p2RuANHA2a7FIuu5IKjkWGk1PUG6vulK83PpRNFDQ8gMOQaOg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGUrnMK77THobfahAKWlU-vEeKV4l0CQ2BZU-_i2aikw&oe=6A9187B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
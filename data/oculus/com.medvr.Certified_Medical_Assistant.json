-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQa0io4bzufMLGyCCWXHEnbL-9GmoC7Dlv9gpg1LttpQ&oe=6A5A178C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiCUPmYsvA4Q7kNvwH9hC1B&_nc_oc=Ado0uYSXOtN2q9kwTmgnZXA_6beujDHaatOZAxZX1oF4OAKxCc4-x-Cw2muKXwJY1pM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjfdXp34iwcBrCoPCIqLKDe2jTWDaj3l-QQoXbyMrOPw&oe=6A5A3FC7"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_8v-FwMffcQ7kNvwEmuYTB&_nc_oc=AdpcPAeVpwPTcJ9TjMoYA2_ViycozG9MfcEg2bYhBeWDEpuS3q4817E7YgUvb2DhoJA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmITI6D1K5Dq4WLQl2k4knRw9nuDrcDCPjbkWLp4hX1w&oe=6A5A1F9C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKnrgc_k-_kQ7kNvwETVwiU&_nc_oc=Adotk_z-LbBM2y9VDkxz2ejx88gkJ4pD2GOnQZJEqhnZr-83mrzvK0BZSI5_m0HBxMo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAafKCVh75CBur81F_CZ3rhSzLH7Ce5l6mPkzUdE6an7A&oe=6A5A353E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvPD6vjfFBEQ7kNvwHvb2_C&_nc_oc=Adq8z0UIiK3n1be00ck779NwjNkkKT97Em37d3-RYBrIZlX6ZhMfSzWW4ocxEwfmGUQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdjQ_MHACry_TZ_pKJGlwbzp8cQVTaq5ZeR1KmXOMg6g&oe=6A5A28B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "com
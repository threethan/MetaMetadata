4IFL_G-wQ7kNvwG5PA6-&_nc_oc=AdpOW96ni9klDlFPccMUWFLc10Mf3RjKmPZHdjDH7fDfCEPiXGEOeMmg5sdSyjQ3TdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJrOiCpucutYdFzpIec7dT7zsu9JBUiTfjYbsyjaIVJw&oe=6A98464C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct0B0HtGGj8Q7kNvwHt4LVo&_nc_oc=Adps9sMHhqpFvlZNWm3mCRft4HZ0vLb9YAXD4nccMv8bcz9xhUisGlirOFEg7v341T4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWnoxEAONdQyO6fmNYPs0P9sHFCgW8oHxTFU1xa3jtag&oe=6A983647"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLEMFYxxpssQ7kNvwGKHF5S&_nc_oc=AdpNo519cuSH6QExEtwE-1m0uH0zdRi4BoDAYHDv2ZaeC_lodA0MNxzHSO98kiJZasM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSiTqTyxgUczj6zxq-JCeNumvgW1KcA_pdnoc74MxdWA&oe=6A984E5C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Smns8QAhHkQ7kNvwETOBZy&_nc_oc=Adqyn-nsD8_rLbYkST0eGthdZgfuoF9uCTpzv6Cn3rgGQOIBpr-FpO2fiLVKC7hWKZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoDPMD6mF0zNO_-jFx3vV0Q0Vbf-IrmXD4hI0lspq6JQ&oe=6A9863FE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6WSw78vVUoQ7kNvwFkx0Yc&_nc_oc=AdpCTxmY4-luqjjBzMld8Uh2NHNYGv9KgalEMmKAtRUX9VgCstYSwk5bjBIjyMGSCh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnDgXlx2TzX0owa9tFOrwTImJbMna-21MH3VFuYA0dYg&oe=6A985774"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
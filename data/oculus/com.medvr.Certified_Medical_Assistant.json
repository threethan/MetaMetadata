-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFm2uEMEndqy37AXNgmnUa4iLVkrGYma4J16iC86R4cQ&oe=6A80530C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khgh96nF0gQQ7kNvwG8ID-x&_nc_oc=Adr1oc4Hta8vccQJEqkI1JZyGm60iVTG487YzFT_R16gsUefQg_VQ4fNcMQLgCyV-4w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRhW-4bt1IuaLavI_kLSOMuPWZn2U1Tgyk0ToZad51Lg&oe=6A804307"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAko7RVo8zsQ7kNvwEURDV3&_nc_oc=AdouUhFMKWlk1RMzEcaxAScdQNEZnUnJxpAK48DrK8tlMQuqPbUiU6YuV1gjk34WawY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4qBJXclJWR27ixIkFY3DdFKz8dqotIN4sG9JnDySsWg&oe=6A805B1C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxM0m4wRTxIQ7kNvwH5cZJH&_nc_oc=Adoj4PsOjm5ygTEyVt-O5OzZQJ8eamJrwBcqFUxKfa5umQBRB8KOqnisW_lBBqOC_ic&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTGl9mkBnnzvVoTOnrCZbMyk4HfMii45UpWs6kYGuGnQ&oe=6A8070BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toYrass8Wq4Q7kNvwGqY-aj&_nc_oc=Ado1JJlKp9Hxf8lS3B3cel93E7accgvDIQlBNvjvyOYbRMxUrLYbJ-45nZtc6EG5NiE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6RCwvq5RR-DfkoffLs9z1fucZND8vvykIUCG2Eiv9LQ&oe=6A806434"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "com
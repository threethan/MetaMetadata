culuscdn.com/v/t64.5771-25/499304236_702157059174946_8946897751560852824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-p8SidnnmcQ7kNvwHqOcGc&_nc_oc=AdpvxcqhDATmle8O54WROXcbLB6-DAv1QbSubdDG4PCAle52-HbY7VaPfvUfI7LhzwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhFqWl3wIIkLHjUQiXvwdl-8gStMmw1dxmLPgBrCIBxw&oe=6AC66ACC"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0zINfixZQkQ7kNvwGGHME6&_nc_oc=AdqpjZkTnwKik0e9kT4CTVxJg8l6kylx9WKJwXgcpbJf2OHtQIhLc-OKZl7gA3yiMVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAtiQs6FYFUAjeJ52z41kSQ7_lkgEVK6RGK5fkMnWEdQ&oe=6AC65AC7"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVjOT9QWiKYQ7kNvwFqXH-3&_nc_oc=AdoWvmvASVJjQy9Tw8hsVSEcH0dvU5FwjI95wQjsyflaplEsEcWYyeEC6fVemXxqTVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGmn4f_FhOvYckBk5PkPfKwBbEUHVcMg5hGo_I_xALTQ&oe=6AC672DC"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxCaVjD6S-AQ7kNvwHWa7rH&_nc_oc=AdoumTr8UggtoSe3OqEWrB40EaoIPrns04kLBhnCKV0YSmGFAmqOdRZb7sfl-rQolCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe6_-tJdhEmJRDe4P0m4C0SYzse6e_O80N3Vd1-t3skA&oe=6AC6503E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38_s4zJVMHgQ7kNvwHLFDov&_nc_oc=Adr-kAoim2X2T3aCMt_q6jtLFu0JLYOKrDURXY0US3umRYAMsIru-y4-H5v6GtDguKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6w2QfzJ0s9qd2oJtokaTuBLiyZrtZKQ8DoPbGj6G9Gw&oe=6AC643B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": n
-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpd5vPAcMF9XtvbgH19sDw7rdpWQ0qe3D02o6wAhU-9w&oe=6A883C0C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlBTLURAmR8Q7kNvwFfOkxU&_nc_oc=AdoDyV8PtQX8oLCQtWcooxZKJsUeVay6qHyY4Epw808b89tWQZKkCMi3Rjas0GFoEC8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYlN6bwHojZcX_96N_IdXinL3NWIGhpvFfLeN6b6x2eA&oe=6A882C07"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xczBR3il8qUQ7kNvwHFYdg1&_nc_oc=AdqjlzAPMUtqtsmjAKB1dbyFI_03UJ5ANWRhnOD18G8bSHtDZOYCpZO9SjPYDCVqt2I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1fEb1wi5Ex0w925u8HcuUZm4KYteqjWTeBtr8APFSyA&oe=6A88441C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUHPEn6cErIQ7kNvwFG0uzE&_nc_oc=Adr44G8Kd1Qh8HNuQ5aLCiVHvWz3iT2Ga_1BHaxYSkDHDqqbHgb0seISg4wOfazaY4g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAXPUu7WsCK5HNAmB9JmzC9IlyBFjwFOCPTPV2ryPhhA&oe=6A88217E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grNW8P_5yJUQ7kNvwG2uNf-&_nc_oc=AdpfOqCSyufF-0apnSDW6isuzhB6uJPqhaxM0iVE9U5mPW2Gw0xUDOgYuB8xHysosQQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe3fX5IHO15LTReRWt2CN1lD0eqyGPf1VgQzGMddK85w&oe=6A884D34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "com
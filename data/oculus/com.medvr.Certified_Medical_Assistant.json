7nmV-M98Q7kNvwHHV-09&_nc_oc=Adp7xp-6y7yW4xiPaai1kZoPaxtGdySEG-MBM5qphqUXEhw9ljoCfcEnN-XunRNIEkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmSsQXoKkj4ar7tUOxG4rdPb9RO3kWyjocCu79Pzb33A&oe=6A95DB8C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmIKf6znzBYQ7kNvwGGHL1n&_nc_oc=AdqRNumXyCmLX2hbncT4FKAj5vf8zN9MdC9Qs07zqXMK1ks8g_rbFe_OdxwwRJ7k-BU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErzonTwgpDB9tEtNTIzLbNTkTJGyyqdYhcEnrFIcTcNQ&oe=6A95CB87"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eIpwsc7nEAQ7kNvwF5TdlQ&_nc_oc=AdptfUhLci5Z9H3P2FksYdklUgTfjT9EB5ZD6IQiDFv9Yts-5QuT0BS_C8xKGlH-PX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOYAqjjlrGEeT9BJTLwb1fG8SWCP6p6P-nzscOVnKDWA&oe=6A95E39C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Smns8QAhHkQ7kNvwH3anuQ&_nc_oc=AdppPnmXPcNO3QqvAumluY-8osYGaeRvIYZppgd7xO7TplqmSP3C-9085vDpuJXstUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvGfD-ECiNHx_zPzo3AEUErsxQVEFBK12CkWYq1nIOPA&oe=6A95C0FE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5vKEctnmSwQ7kNvwF9BFY6&_nc_oc=AdrPOcMDQ6_VYhAHeunKFAncp1-nj0zck5_WwuwCUxonBUyzQbc0r1P9Dn_XPF_TzyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3lYd-Wy-KtYdSXYgIZ_2SIDNU0HqlhTHaAAQhU5Qn3Q&oe=6A95B474"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
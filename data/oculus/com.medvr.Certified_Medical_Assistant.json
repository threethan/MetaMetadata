luscdn.com/v/t64.5771-25/499304236_702157059174946_8946897751560852824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPrymGoDRcYQ7kNvwG2bZhg&_nc_oc=Adqgf82claKZyIYEyRBfIdRvtY_Hs1pS581pw_pLRJ_Vb3kJKdH9KJJsHI39ojPpxwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cob341rYwBSdmW9G714PjNogkdQYXH_QEnCjZ_XTILg&oe=6A1864CC"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eO7BoRLxsgQQ7kNvwGZtMHX&_nc_oc=AdodFvmdYyDCkFCMw-4g6xSqXt3zIde_OyAYSBwM7KBi7LIPpBQlAwq8U0mbB84RqZw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RUSvIeNuOIlOVY4Velj1YJu6KuUjPVMJC6LNyT4hlRg&oe=6A1854C7"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlQ74lwvcxQQ7kNvwGIqmgy&_nc_oc=Ado1zi5BCvTZjpgxUZgozdAw2QLdd8fN58mOu1fD-YWfiPnqaOXF-cj91fal6WK6vz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QWYOU-5DM8hMRB0CR2AzNWa1cSFiwLBI-2H6RSJjo6Q&oe=6A18349C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGAqc05nHPAQ7kNvwHda8Pc&_nc_oc=AdpuhQtTR7Zs6FyCCsJ0fdD_U4Q7agacXTDvfzwcnj6l9Q9nukU-wZYy9GghPxMaIOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zD3pIDUILa1uWWpHUvGUCDfp-MGmkCX2vbsHDahPAfA&oe=6A184A3E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oR7dqwofmGQQ7kNvwHUqpsB&_nc_oc=AdqjAqfBfI8q202dO-Vyjui3Bfc50idHG8lRXL_Hk105qLMoEcozH0mAkHEMsoW4PsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W6j90yAR-7Eu-XD4oEyElMqeb_TrROodmfyoeKcVgtg&oe=6A183DB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": nul
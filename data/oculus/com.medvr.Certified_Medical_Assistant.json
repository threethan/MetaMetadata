dn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAXkayQrKDcQ7kNvwHRP0SQ&_nc_oc=AdnASe1bw5oSejq-9JVYo56K4RuUd6PK0OK3I0pkhpqPiWPvEDWaejMLhasb2Uy2whI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftu3tm2AaCZOC_IyxGoUYBf48mwPww1t-LWiUEWkZDxFg&oe=69A82E34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "Certified Clinical Medical Assistant is a virtual reality simulation app designed to train future healthcare professionals through realistic, hands-on experiences. This immersive training tool focuses on two essential modules: Infection Control and Communication in the Clinical Setting. Learners can safely practice key clinical tasks, improve patient interaction skills, and reinforce safety protocols in a controlled, interactive environment. Ideal for medical assistant students, training programs, or continuing education.", "short_description": "Certified Clinical Medical Assistant is an immersive VR training app that provides hands-on practice in Infection Control and Communication in the Clinical Setting. Build real-world clinical skills in a safe, interactive environment designed for healthcare students and professionals.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "re
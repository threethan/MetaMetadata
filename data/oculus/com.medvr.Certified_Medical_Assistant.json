KUlLGGUkQ7kNvwHgUtSX&_nc_oc=AdqFuEw_9YXmZyh5CimeMEcpSDj8ZR4w-kLi_43oVtiOORisJoecJtdpLpabomXnX2A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAPewnpywFsO191jcsXu15q3az3uL8YHsyJ3cplFRS9g&oe=6A92C80C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZCwWCJhG2gQ7kNvwGelEXI&_nc_oc=Ado8kqdJbwfZtogEqUSNAGzNNu8Eohu5uTRL2Vwz_4Rxc9IOh8ZZr_BNtrfxveoXQMk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYULQXQXWs63K4P17QKeIEsrKotnYucvpoapEIDk75fw&oe=6A92B807"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eIpwsc7nEAQ7kNvwETFO5y&_nc_oc=AdrK2sPqXwiB84qAFtAVDC4pPPwQPoLJIHrJJQ0O1meCQy7K6QXcey678vLQXRk7ZVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsFNf8eVRw9WCnBrbzw3lvbq7HHAqrzciOeAvYbsj8nA&oe=6A92D01C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMG0bne6SkAQ7kNvwFs-1sE&_nc_oc=AdqYn9rd0Ivq1medehwp50sigcIG1nBMut3e6cWXcgFr1l2_jLyjtgAmXiQ7Trd7UcM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqj8duzk7LDbI_ZOYwOSEv0oAhqql-covDHjaxxECvAw&oe=6A92E5BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tws9FPznZ1kQ7kNvwHx4IEx&_nc_oc=AdqikPa04KcmPc58HsG1BaBwkxUFrDDmVsGBkVp4Wqwc1h-Yn3vX4bUlih8_wfbNYaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH197cl4hnnCQJDuf0rUI8-1HAgS9OWRnlECo1UvXdU2A&oe=6A92D934"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
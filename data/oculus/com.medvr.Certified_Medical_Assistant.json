culuscdn.com/v/t64.5771-25/499304236_702157059174946_8946897751560852824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-p8SidnnmcQ7kNvwHIumx2&_nc_oc=AdqsmjU_emPl3q1YUD5wlWm1-kgylvnqc2exPrt5zR1D_nWy5P00WyghiN68SgnWaVY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_LNU3hyOJl5Rbke7EoGS5nxk4Ocjtv6LwOdsusxuLdQ&oe=6AC5194C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0zINfixZQkQ7kNvwF1Jzuu&_nc_oc=AdowNNKRszPYJUOmG3TTFcP8GR5r0I-U4JWczVqIHlhpyBWAbwhKShc56iPz0gsoFjg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjzXJSsuV23OGyXKm5Rc1ivlqCYDcBxfsMlVi6r7yQJw&oe=6AC50947"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZOfMJpPu8IQ7kNvwHa6qI_&_nc_oc=AdrKbdnVi94D9hNpH4eD_uDfhsrW6aEmG8K76sxAZ6qSNuBKvrqyzo0lxwELniB-dCA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7iFxHwD7aBpFdePcn0QahVICnGzl_uYVcipGyGRu26g&oe=6AC5215C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jKx2KuDQocQ7kNvwGk92Zj&_nc_oc=Adq0DhIUDDyrHABului5PRkncU2fqTtr_aVA-Ek7quMFh5UFDVUs_6IRzBryTYF3jbE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4b4Ko0wW5oxq4hxi3YFx1ILbLOeLbixac35jZT_SbdA&oe=6AC4FEBE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38_s4zJVMHgQ7kNvwGhtZEn&_nc_oc=Adpt59XbY3WjP_9DwzEsoidRspiOVSnFk-eb2OKRrPgD-bt1OrkIcASuGH5tfpFewOc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyf-Pp5otsgc1sQH4h-eVICaEe0NQHMw2SmXbHR6wEfQ&oe=6AC4F234"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": n
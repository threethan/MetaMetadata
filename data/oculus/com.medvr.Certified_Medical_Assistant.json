AVPrUvqIQ7kNvwG0al3o&_nc_oc=AdoPQs9QdlAIiBxK0Dgw2jIZ7Lkwh4CC8iUHyv2YO5ucBd_nFWNAQLsCzok9T5cAI5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6IuVmy4ihk0nayr0baZLPgdiRqiaxzK-jkYvI99LQaQ&oe=6AA2D24C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVi2WtlmJesQ7kNvwG83mVE&_nc_oc=AdoxGS8lwoUlTK_P_iokPFVEN8Fo2yoDpjoGksX7jn01vJRDNPUu0WG1toMo4dLUnlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn4sO868BfFUhTNhbmB8jvNr1vcgoUyYlkbg8grFVVLg&oe=6AA2C247"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz43_ZvORnIQ7kNvwERSxH2&_nc_oc=AdqXtNIRRT8HaYzUq0m_b7i8_fiPS9NFOyYJyeororpX6gusOdPt2Y0Lv0aGfmaSxPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTFkWHU7RsgMdPHtygBPpLoNU-EsmYp4fDLeLOVsbQzw&oe=6AA2A21C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHlJK58VTR4Q7kNvwFS5ze1&_nc_oc=Adp0LCzZ6Gj6-vQuSX_MFxSN_Jo3Q22UNcW07LJ3rK-4kLv0qTkhbjDvpnyRFf-YMcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBe-73Dft4dj4mx48A6FOqD9jgZvPB7pPmDzZRjxAbBA&oe=6AA2B7BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUptzMmI8cQQ7kNvwFZQxsr&_nc_oc=Adr18I0eyAawUmTQM5ICggTr0Na74R0yqYYyv0tjK_c1JZAbeG11xrfnGI04ObTtq7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJKzNyyDIvzh5m4OSfKvyCstDtguM_1QGsvnoT0Rwy1Q&oe=6AA2AB34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
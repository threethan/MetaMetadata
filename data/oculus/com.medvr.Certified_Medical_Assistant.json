UIXqbtucQ7kNvwFmBmvq&_nc_oc=AdrK_hvpZblMm67XOEG3KZLAUhwNw-IL6OrxIClRVAKF3LC1XT1oaLtoUI5fYhlUgN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5wXbOL4-5crI7WmTYby7T2CQF7_CYqNRTmSo5OcBJUw&oe=6A9C3ACC"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kRQy7lD2ecQ7kNvwHAavfB&_nc_oc=AdokxZnmdBQF0eUfocG82gBhi9vWwHECWG2iL953xzanzfQbu9We9bDF5Qdi5pNCbT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRxLvEZ2tSiNrEPNYqdq24YkShSvGouMVQ4PTBrPiO3w&oe=6A9C2AC7"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4XawurXEsIQ7kNvwG8Og9x&_nc_oc=AdpFIs4CT3IjC6yLwG9VAKEJMTnGKzZvGyGu98rZc9G5gywUv2n4exfFulhxuN6Ts7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMEM3ddkmxwLiAOenFZDS9ef4JWPaDbFniwgLKxmujug&oe=6A9C0A9C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdE4Sl0EyTkQ7kNvwENb7c8&_nc_oc=Adqdktn8fsHz-k48ttOLzF67EUXoXUAhONjLx16MsfCT0mSpSNnseeOPV94Fzqbkx5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoY09GFap761pJjrlwbURMWsu_085q9useXZIhlYkTWg&oe=6A9C203E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN3Cqzmcn0sQ7kNvwE-W0Tg&_nc_oc=AdqQyxInaOfjGW9I5F2sZ0oxl0vV1r-6i6B1efZfqJ04pl2b_6UIm7JC4hIUffKiKZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwsvUAQifpGDJFSxG_0zbPrWhqC1iyNezCzVZOlptN2g&oe=6A9C13B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "pub
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbyr7_dOl2PZyWW8Wq1dcw8-PT2fYTdLmhR3B-P0EU6A&oe=6A68980C"}, {"file_name": "com.oculus.vrshell-2..._imresizer.png", "id": "1029636135474672", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304147_1029636138808005_8424990958430268230_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TKc5NC2v4kQ7kNvwFQ1TQU&_nc_oc=AdqMjlo6qN-e_TMNKdTiJZltStgROTzYpxD1Hd18UIjgo2osUolPFY_FdEYLVwe4qck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCAUeLex__cuTigH4PSLdX0OTIgyNSHzWIto3OrQkggg&oe=6A68C047"}, {"file_name": "com.oculus.vrshell-2..._imresizer (1).png", "id": "691854273806458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307470_691854277139791_4707489557780487213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLyyazFH1fYQ7kNvwGw3rUU&_nc_oc=AdpG_eV6y47rcSCSv2UMKnMHhflutH0YIBf2olzIZ3_sRNqINV7Vv80Gi2iEV1LXuLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqWrCgfPPSEULcqsjOhSGV8I50rZJcpSXYhIvFvcasmw&oe=6A68A01C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37CXZn4vnx8Q7kNvwHHhm0I&_nc_oc=AdrML2JEZ--ktCRAX_a4OiMWPFReiODy8awAZaeBrkEiGYpavvwXXXWcnhuVh4NuPMg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzLl2-dDooKrjm4aKkAjs52cZhplBFWtCr3_-qN5xOtg&oe=6A68B5BE"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHHRZuyo9msQ7kNvwHtApUo&_nc_oc=AdpNQ6d1L6G7SBpT25qi5FOsAnxRSaivzhxrw4J-a1F7LO0lfoSOO0jZAcLdYw5EPYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArLo4pZ-CqpDLBuUcnRVk9gnVDhmZ7_CxJE1fjV12-aA&oe=6A68A934"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "com
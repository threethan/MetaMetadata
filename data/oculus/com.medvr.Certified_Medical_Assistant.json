LMYh82wk48uP34&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rd_Gm0Gf29Fce-TajpBLRjC7PQWw6fwpSFSU74o4WOA&oe=69F34A9C"}, {"file_name": "com.oculus.vrshell-20250523-181650.png", "id": "1253448426377882", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499302457_1253448429711215_3404095699536525032_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31ykPCx9mPQQ7kNvwHOD_CR&_nc_oc=Adok_y6G8nzVe26ixEWDgHAvuIrKVe5suuBbllbTY9G4T9N6bBNg5DXLhsxR7OHhCus&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rH0LhPirodBNXqVChGVHvGijiCF-O7L6AqmxTxMmgDA&oe=69F3603E"}, {"file_name": "com.oculus.vrshell-20250523-181505.png", "id": "707716614965059", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312242_707716618298392_7298389395475402485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUzvNt6G8g0Q7kNvwEfgoBc&_nc_oc=AdoOHpjsN18WZgd7v0fkgRlhQdp2x0r8lREFK3LSnybMvd8WzQr5xm_ZOs58MWaUZz4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FTJa1dXlMle6E8kJ9P49eb9nV9xU-HuMBVDzQYl8XqQ&oe=69F353B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clinical Medical Assistant", "keywords": ["ImmerseLearn", "Training", "VR", "CCMA"], "long_description": "The Clinical Medical Assistant module is part of the Immerse Learn Clinical Medical Assistant Certification Program and is accessible exclusively to enrolled students.\n\nThis immersive Virtual Reality (VR) simulation delivers realistic, hands-on training through more than 200 clinical procedures covering essential areas such as:\n\n-Infection Control\n-Communication in the Clinical Setting\n-Vital Signs Measurement\n-Venipuncture and Capillary Collection\n-Electrocardiogram (EKG) Setup\n-Patient Intake and Documentation\n-Specimen Handling and Testing\n-Medication Administration and Safety Protocols\n\nLearners can safely practice key clinical tasks, strengthen patient communication and interaction skills, and master infection prevention protocols \u2014 all within a risk-free, interactive VR environment. Designed to meet national healthcare education standards, this simulation helps students build confidence, competency, and clinical readiness before entering real-world healthcare settings.\n\nAccess is restricted to students enrolled in the Immerse Learn Clinical Medical Assistant Certification Program.", "short_description": "The Clinical Medical Assistant VR Module offers immersive training in 200+ clinical procedures\u2014covering infection control, patient communication, vital signs, venipuncture, EKG setup, documentation, specimen handling, and medication safety. It builds real-world skills and confidence in a safe, interactive VR environment. \n\nAvailable exclusively to enrolled students in the Immerse Learn Clinical Medical Assistant Certification Program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25017635254590659"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617850_1076947337683046_1000364590982706284_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb
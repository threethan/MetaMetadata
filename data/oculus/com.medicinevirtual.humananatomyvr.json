Gbc5qpve1uQsHD7NnBUQw&oe=6AAAA42A"}, {"file_name": "Screen 7.png", "id": "4720360188062209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035421_4720360194728875_2997095896587010180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzXLpcYPQEMQ7kNvwEJnoMr&_nc_oc=AdqsghzX6FIm1a7NeTgvBuQR6eIILVQSV3eAMO3nBHlbNUb1fkc8AUXGg1F-QuBYX18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9mksgqlvnbZkI4NINKmQ_DTujtULjBAwZqwdumxlYLw&oe=6AAAAFFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Institutional Landscape.png", "id": "1546901692913170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_1546901696246503_8621646036558222711_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZDPk1m46JsQ7kNvwFIlxvu&_nc_oc=Adp5Fotz4yuFxmy_uX8B-XrFF5WBukj0Vl_Y8vlv8GTqkt65u4vXIY22WYzMdsBmSuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI83k8gMeYvFOGzS5WuFQxn1Bc2DCBnCb4a7YRktBpzVg&oe=6AAA9765"}, "display_name": "Human Anatomy VR for Institutions", "keywords": ["Anatomy", "Body", "Education", "Medicine", "Sport"], "long_description": "# Upgrade Your Institution with Human Anatomy VR\n\n**Why Choose Human Anatomy VR?** - Utilize a comprehensive and highly detailed anatomical XR tool, trusted and adopted by **top universities**, healthcare organizations, and professionals in over *180 countries*.\n\nThis application requires an **active subscription** to unlock features.\n\n**Subscription Levels:**\n- Personal\n- Professional\n- Institution\n\n**Key Features:**\n\n- **Interactive Learning:** Host multi-user, cross-platform sessions with up to 100 participants. \n{1022341832369269}\n\n- **Advanced DICOM Imaging:** Transform CT/MRI scans into 3D models with our VR DICOM module. \n{1058954758917488}\n\n- **Extensive Anatomy Library:** Explore 15 body systems and over 13,000 anatomical structures.\n{1418662452153040}\n\n- **Ant-Mode:** Allows you to shrink down in size up to 40x and observe the human body from a completely different perspective.\n{1409897293028158}\n\n**And much more!**\n\n- **3D Cadaver Images:** Access a vast collection for realistic study created in cooperation with Stanford University. \n- **Detailed Bone Mapping:** Includes 5000 bony features for in-depth study.\n- **Microanatomy Models:** 21 detailed models with explanatory information.\n- **Interactive Learning Tools:** In-app anatomy quizzes.\n- And much more!\n\n\n**Free Trial:** Experience full access to the application with our 7-day free trial.\n\n**Upgrade now** and bring an immersive, intuitive VR tool for anatomical visualization to your institution", "short_description": "Upgrade Your Institution with Human Anatomy VR\nWhy Choose Human Anatomy VR? - Utilize a comprehensive and highly detailed anatomical XR tool.\n\nTailor your experience to match your level of expertise by selecting either High School or University level content. \n\nDive into a world where learning meets innovation, and explore human anatomy like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.medicinevirtual.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medicine s.r.o", "support_website_url": null, "website_url": "https://medicinevirtual.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["MEDICINE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "it", "pt_BR", "cs", "sk", "fi", "pl", "ko", "zh_CN", "ja", "uk", "ru", "nl"], "supported_input_de
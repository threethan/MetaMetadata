: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/585799753_2239895743474210_2224508904022705000_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gF4TbpKJ_0Q7kNvwHBDhGm&_nc_oc=AdomP2CsTJZ24dclbrmtLBWiztALZCkrn1On3iF3T28_fnDZgA2KNsLPGr-UTF10OBk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyqKggbgf-gmdROGla3eUZZjlMsvPPkU6npE8UDaftjQ&oe=6B030C59"}, {"file_name": "New Project (3).png", "id": "1699902021104371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_1699902024437704_7736809235167424107_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWtxLronIz4Q7kNvwEElGCA&_nc_oc=AdpqQmjq9ALhFGZzsz3Ye2I_P74SbKeUi5PJlCHfWD5fjlUpNvBaKiPQ0rbOk9nc_Lg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdIrFA_BT-fuS0wI3Vmgb_vl5DN5vv6yFlptVwSjmf6g&oe=6B0326BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal ape Reworked", "keywords": ["Horror", "Free", "Multiplier", "Simulation", "Facility"], "long_description": "Lethal Ape Reworked is a fast-paced survival horror VR experience where you step into the role of a primate trapped inside a dark, abandoned facility. Using immersive gorilla-style movement, you must swing, climb, and navigate through pitch-black corridors and experimental zones while being hunted by a relentless, unknown creature.\n\nEvery sound matters. Every movement could give away your position. Whether you play solo or with friends, the goal is simple: survive the depths of the facility and escape before whatever is lurking in the shadows finds you.\n\nBuilt for full VR immersion, Lethal Ape VR combines tense exploration, unpredictable encounters, and physical locomotion to create a constant feeling of fear and urgency.", "short_description": "Lethal Ape Reworked is a fast-paced survival horror VR experience where you step into the role of a primate trapped inside a dark, abandoned facility. Using immersive gorilla-style movement, you must swing, climb, and navigate through pitch-black corridors and experimental zones while being hunted by a relentless, unknown creature."}]}, "developer_name": "XENA LLC", "developer_privacy_policy_url": "https://reworkedla.pages.dev/", "developer_terms_of_service_url": "https://reworkedla.pages.dev/", "publisher_name": "XENA", "support_website_url": null, "website_url": "https://reworkedla.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1293785350491707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604328314_4533822880198206_6485440163588034547_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sp7ngx3CAsQ7kNvwGpp-Fy&_nc_oc=Adqd1B_N62UJTX_9haoIjZRQ2A9kMa3L8L_yIXsKpfzZqW4ktgswT_4G_h4b_LDPtf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy0-2QBy8uOAC7sQRq7pYkQDmQsquDxMZBgDCrmwKP5Q&oe=6B03058E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lethal ape Reworked", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_nam
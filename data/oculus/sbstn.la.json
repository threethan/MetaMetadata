w Project (2).png", "id": "2239895740140877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585799753_2239895743474210_2224508904022705000_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9TrEBepLZkQ7kNvwEd_-W2&_nc_oc=AdoF5fB7S_dphDEkl7ht_vZWVH17atxJ_TeHDsz7iH_mnYyTt0N0gIgG5HGhILjR3Gs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqV4DoZ4b_6uDLmRS2XYNWXf3z3ULUMaLqv4pCiQzD5w&oe=6AA6C359"}, {"file_name": "New Project (3).png", "id": "1699902021104371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673558985_1699902024437704_7736809235167424107_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfYebZyNYtwQ7kNvwEYxEAU&_nc_oc=AdpBHADDF5Owb7ECit5G_4wa3zSGUen390Pn5iDnsjMAwcWs0YIpsy2BSYoS-WWOznY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_LeoNTw5pZ3Ha5MJ2DxC9N34y1bFUvT_L16LQSkxbZA&oe=6AA6A57A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal ape Reworked", "keywords": ["Horror", "Free", "Multiplier", "Simulation", "Facility"], "long_description": "Lethal Ape Reworked is a fast-paced survival horror VR experience where you step into the role of a primate trapped inside a dark, abandoned facility. Using immersive gorilla-style movement, you must swing, climb, and navigate through pitch-black corridors and experimental zones while being hunted by a relentless, unknown creature.\n\nEvery sound matters. Every movement could give away your position. Whether you play solo or with friends, the goal is simple: survive the depths of the facility and escape before whatever is lurking in the shadows finds you.\n\nBuilt for full VR immersion, Lethal Ape VR combines tense exploration, unpredictable encounters, and physical locomotion to create a constant feeling of fear and urgency.", "short_description": "Lethal Ape Reworked is a fast-paced survival horror VR experience where you step into the role of a primate trapped inside a dark, abandoned facility. Using immersive gorilla-style movement, you must swing, climb, and navigate through pitch-black corridors and experimental zones while being hunted by a relentless, unknown creature."}]}, "developer_name": "XENA LLC", "developer_privacy_policy_url": "https://sites.google.com/view/sbstn-ltd/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/sbstn-ltd/terms-of-service", "publisher_name": "XENA", "support_website_url": null, "website_url": "https://sites.google.com/view/sbstn-ltd/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1238389972697912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_4436105123321776_5010903807001472506_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GifO8GnFnJMQ7kNvwF_aO4a&_nc_oc=AdrwIbaU-X04YHRa51MW2YNxbkGALUGe1KylYC-AfW33fRz49DvnRRUbr1pTWSZq7CM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB-sQHeGcUznsrdvw74tokmC2krwn8neUk0nXiXWRU7A&oe=6AA6C075"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lethal ape Reworked", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival
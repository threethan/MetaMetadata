25/499303790_1396722735528877_6061043690900105757_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIV7GwrMAVcQ7kNvwEGWkg-&_nc_oc=AdqEG9vReL3O6Hb18iMyo1UQGKnWM_eTg6PNtRE9rckH1nR3fICKc2TNxzijWIAFJp8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUSkm8TRxLiV8SIGytvyH8zmxWE7M3MV4JeSjQbe3cQg&oe=6A9AE38F"}, {"file_name": "screenshot 4.png", "id": "1532317888311238", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296397_1532317891644571_4789586510888491297_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yin2pr_JenkQ7kNvwHneHUS&_nc_oc=AdoYO9-nQ5qY4EKvxYjkaCSbzjAn4aUozLFd6EPP7jq-_8GwIOJQ9BgSpR9wbL8clZU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1ddWxwsAs--fXP9pWagPHeJ5HNWNn_SKrgSdCbbBhPw&oe=6A9ADFF0"}, {"file_name": "screenshot3.png", "id": "985393430738305", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299051_985393434071638_6732719705414440422_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvIfGAAO6n0Q7kNvwHwkbsu&_nc_oc=Adp5h6HzCSX-TJ_RaIwk3sWaW4hap1m6QsvV7cdaprgbUKG3UPfOVYsObXctnC9jVWE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuzHFkcDnUVxFo6C6TZ4bccs0ZWs9SUBmToumXWMrkUg&oe=6A9AD41E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CCZ-2.png", "id": "1613527106392140", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298281_1613527113058806_4513978903023808485_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvOlAU-fbw8Q7kNvwFM9Tn_&_nc_oc=Ado3sm6OckwfENbRmnHmaLr9QPBeaah37TBHKvbNKKp0DH_Ct6E7bf-XizMOkGvjPr4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfy7X0CfeBPyv6Wugw9K7osIgmIAbs9DIUiL9_b1b8dg&oe=6A9AEA05"}, "display_name": "Tony's Creepy Crawly Zoo 2.0", "keywords": ["STEM", "Science", "Insects", "education", "nature"], "long_description": "Have you ever dreamed of shrinking down to explore a tarantula's lair, or share space with scorpions, snakes, and lizards without ever getting bitten? Tony's Creepy Crawly Zoo 2.0 makes that dream real.\n\nMacro 360\u00b0 VR exists only here. Come face-to-face with tarantulas in their burrows, dive beneath the surface of a Midwest pond, and explore the hidden world of insects and reptiles from inches away, filmed in real habitats with real animals. This isn't animation. This isn't simulation. This is a first-of-its-kind experience exclusive to Tony's Creepy Crawly Zoo 2.0.\n\nThen step into the legendary Dan Capps Exhibit, one of the world's most extraordinary insect collections, with Dan himself as your personal guide. Pick up and examine 100 breathtaking display cases holding thousands of specimens, and hear the fascinating stories behind this meticulously curated collection as the science comes vividly to life in your hands.\n\nOutside the exhibit, explore a virtual garden, learn how to find insects in your own backyard, and discover that science isn't just something you study\u2014it's a verb!\n\nPerfect for educators seeking immersive teaching tools, insect and reptile enthusiasts craving deeper access, or anyone who has ever looked at the natural world and wondered what it would be like to get closer. Science begins with curiosity, and it starts here.", "short_description": "Step inside actual terrariums with tarantulas, scorpions, snakes, lizards, and more in stunning macro 360\u00b0 VR\u2014filmed from just inches away. Tony's Creepy Crawly Zoo 2.0 shrinks you down to bug size with real bugs and real reptiles for an unforgettable science experience. Then join world-class entomologist Dan Capps for a guided tour of one of Earth's most extraordinary insect exhibits. Science begins with curiosity\u2014and it starts here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://creepycrawlyzoo.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "The Gateway Science Project, inc.", "support_website_url": "https://creepycrawlyzoo.com/", "website_url": "https://creepycrawlyzoo.com/home/creepycrawlyzo
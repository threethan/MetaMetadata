com/v/t64.5771-25/507823984_2287313905007039_7013806425743342487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp3V5w9bvYQQ7kNvwH86yn_&_nc_oc=Adrkey2CrkoLj6WYhP0lRhyJ4SzmzHDx8SSoSXe-gJxU9D182ZTV_YyygRF-7rpFwog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaNPrvIdp9oIR09lMdL9Wv1qSfGxP6t5lmXb-nNp-1yA&oe=6ABD1C45"}, {"file_name": "Screenshot_3_2560x1440.png", "id": "1631721651345416", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825034_1631721654678749_7008327033525427680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L88zkb0XnwIQ7kNvwGhb67q&_nc_oc=AdqKP_JFYomzwAGp2fzrhhC10MZvnXo9gfiRZx7C-YsA4pmzaK6Bi6lrobgfLfL5NbQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSmWtBB9473A9gqVBOofHylnYW3FUlOlPh-t9AWqbKFg&oe=6ABD35C1"}, {"file_name": "Screenshot_5_2560x1440.png", "id": "962617516429172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821674_962617519762505_9213358930173307911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PdEvWRTxEkQ7kNvwG8aPqN&_nc_oc=AdoZKdUUFqTDhz2ZWc-doKP8qSI1F5zCUIqS9dUB7MqfpjuBYDJzsKr4LKkKExjc15M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv2kqBKVa2cPveQRbIIc6FiUpHkzL8D_JLuYnf2E7uwg&oe=6ABD0641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 5.png", "id": "1376283924248619", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819982_1376283927581952_1918447233091910542_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YzBSFyIV0QQ7kNvwH-Uf4t&_nc_oc=AdrPoy5YPyVQ9oCjkQstWI2-l_uDAHKgXZh-y7RLjvL645YkTUlERkXrpABXyeMT1XY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjwP5yG3HsI4fPYr42Oj97CTPnH-JHqoXHLkCWrwmjoA&oe=6ABD0527"}, "display_name": "stay\u2022safe CAPD - VR Demo USA", "keywords": ["staysafe", "fresenius", "dialysis", "peritoneal", "capd"], "long_description": "This app is for United States only. \n\nThe stay\u2022safe\u00ae CAPD - Virtual Reality Demo is a digital learning tool that offers support to clinics and nephrologists in creating awareness of the Continuous Ambulatory Peritoneal Dialysis (CAPD) therapy. \n\nIncluding:\n\n- Virtual step-by-step demonstration of a stay\u2022safe\u00ae CAPD exchange.\n- An immersive 3D environment that supports learning by doing.\n- Support for different learning styles with a mix of visual, auditory, and interactive elements.\n\nLearning mode: Offers step-by-step guidance from preparation to set-up, connection and finally, disconnection.\n\nThe stay\u2022safe CAPD VR cannot replace hands-on patient training by a trained professional, and it is not intended to do so.\n\nDisclaimer: stay\u2022safe CAPD US VR and the VR glasses are not medical devices. They were created to support education on CAPD therapy with the use of the stay\u2022safe system. \n", "short_description": "This app is for United States only. \n\nThe stay\u2022safe\u00ae CAPD - Virtual Reality Demo USA is a digital learning tool that offers support to clinics and nephrologists in creating awareness of the CAPD therapy. \n\nIncluding:\n- Virtual step-by-step demonstration of a stay\u2022safe\u00ae CAPD exchange \n- An immersive 3D environment that supports learning by doing\n- Support for different learning styles with a mix of visual, auditory, and interactive elements"}]}, "developer_name": "Fresenius USA Marketing", "developer_privacy_policy_url": "https://freseniusmedicalcare.com/en-us/privacy-statement/", "developer_terms_of_service_url": "https://freseniusmedicalcare.com/content/dam/fmcna/live/support/documents/techical-documentation/staysafe/stay%E2%80%A2safe%20CAPD%20-%20VR%20Demo%20USA%20-%20Terms%20of%20use.pdf", "publisher_name": "Fresenius USA Marketing", "support_website_url": "https://privacyportal-de.onetrust.com/webform/da671b3c-7b20-4bd4-b140-c6cd08c8aa0f/a8157a6c-6a93-4c12-ab6c-b8a2aac2c98a", "website_url": "https://fmcna.com/products/home-dialysis-equipment/stay-safe-overview/", "category": null, "comfort_rating": "C
com/v/t64.5771-25/507823984_2287313905007039_7013806425743342487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L8sJl_9Kj8Q7kNvwGp-GXC&_nc_oc=Adq_xrPFugDkryci82x1wQcg553ogz1_bO0ec7Y4r8i5MJGDeVAKNiAiYUPznnMfEk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKiJr9KeQ-iMhqY_LOW5Cg2cgvsJ2e5DLINsVf1sPytg&oe=6AF71E45"}, {"file_name": "Screenshot_3_2560x1440.png", "id": "1631721651345416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825034_1631721654678749_7008327033525427680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBWSJeiK-dQQ7kNvwGAiAed&_nc_oc=AdptWU6kftSJ0ij2SFepE9Ho7IruIWVLGGDkBYtsQcvGMg-RIWcu0bHJQNiV9my7HWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOLnf0VCxMKzSre38gZb16Cje6ONlQKBeCuPU7X3msLw&oe=6AF737C1"}, {"file_name": "Screenshot_5_2560x1440.png", "id": "962617516429172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_962617519762505_9213358930173307911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThhsiJLJU_4Q7kNvwFqByfU&_nc_oc=Adq2uVsMHI7cqTnF8PQ7cJa8ADpYl1rZnRRMc0AajrtX7M8SNmP1o_JFpOnEBc8LCZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIbOiePmtnut8RHsVn8suvFLvaz1PRNdyhxx3DsP70qg&oe=6AF74081"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 5.png", "id": "1376283924248619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1376283927581952_1918447233091910542_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzKaOwk1344Q7kNvwHUYhUM&_nc_oc=AdrI6Pbr5gJhCP9-8TJHOUch0Yq8C2ToojWXrkGF9BTFFTLOxK1zkGyM8mXz1WuIKSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkrXrAgoc_At_B-uF6hi1pR6TUMAVzMj_HAXvVcRGfMQ&oe=6AF73F67"}, "display_name": "stay\u2022safe CAPD - VR Demo USA", "keywords": ["staysafe", "fresenius", "dialysis", "peritoneal", "capd"], "long_description": "This app is for United States only. \n\nThe stay\u2022safe\u00ae CAPD - Virtual Reality Demo is a digital learning tool that offers support to clinics and nephrologists in creating awareness of the Continuous Ambulatory Peritoneal Dialysis (CAPD) therapy. \n\nIncluding:\n\n- Virtual step-by-step demonstration of a stay\u2022safe\u00ae CAPD exchange.\n- An immersive 3D environment that supports learning by doing.\n- Support for different learning styles with a mix of visual, auditory, and interactive elements.\n\nLearning mode: Offers step-by-step guidance from preparation to set-up, connection and finally, disconnection.\n\nThe stay\u2022safe CAPD VR cannot replace hands-on patient training by a trained professional, and it is not intended to do so.\n\nDisclaimer: stay\u2022safe CAPD US VR and the VR glasses are not medical devices. They were created to support education on CAPD therapy with the use of the stay\u2022safe system. \n", "short_description": "This app is for United States only. \n\nThe stay\u2022safe\u00ae CAPD - Virtual Reality Demo USA is a digital learning tool that offers support to clinics and nephrologists in creating awareness of the CAPD therapy. \n\nIncluding:\n- Virtual step-by-step demonstration of a stay\u2022safe\u00ae CAPD exchange \n- An immersive 3D environment that supports learning by doing\n- Support for different learning styles with a mix of visual, auditory, and interactive elements"}]}, "developer_name": "Fresenius USA Marketing", "developer_privacy_policy_url": "https://freseniusmedicalcare.com/en-us/privacy-statement/", "developer_terms_of_service_url": "https://freseniusmedicalcare.com/content/dam/fmcna/live/support/documents/techical-documentation/staysafe/stay%E2%80%A2safe%20CAPD%20-%20VR%20Demo%20USA%20-%20Terms%20of%20use.pdf", "publisher_name": "Fresenius USA Marketing", "support_website_url": "https://privacyportal-de.onetrust.com/webform/da671b3c-7b20-4bd4-b140-c6cd08c8aa0f/a8157a6c-6a93-4c12-ab6c-b8a2aac2c98a", "website_url": "https://fmcna.com/products/home-dialysis-equipment/stay-safe-overview/", "category": null, "comfort_rating": "C
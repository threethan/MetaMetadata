1_W4bdWSeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1x0Z9VAW-UNRcf9BTaO9IOaqlwsxvQPBldZ6lSG48Cw&oe=6AAFF616"}, {"file_name": "vlcsnap-2021-03-01-15h23m34s811.png", "id": "774992679776878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982720_774992683110211_8478148152978643142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynxX65haEyEQ7kNvwEGyGeX&_nc_oc=AdppVjTF_GrjFAAts5oLQnkY1DTjBrkDHyMI41CaFPZV5RaLOoaYOs9y0QbRiZfMWXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI62l3s_m36mq-LAgxotvqL73pRiFBymL3d6HA-HahjLA&oe=6AAFFCE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SportModeLandscapeCover.png", "id": "1250535798673645", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_1250535802006978_4125075686671892505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL2ADSYCC3AQ7kNvwHEzYRx&_nc_oc=AdrrqxKkjxoljmX5ooeH1yWePnGYi5r3ajRtXjMxkghbL139VoUzsNslESCN5qX__f0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEQhnpSyKCuRXtJ7ujKsehWnN6Fmk57K0ZJBiORnnjYA&oe=6AB000AA"}, "display_name": "Sport Mode", "keywords": [], "long_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit.\n\nSport Mode is currently in Early Access with a Sandbox mode where you have access to Creator Mode, a button press away from spawning and manipulating a variety of weapons, NPCs, and props. Also available is an Arena mode where you fight off waves of enemies for the highest score.\n\nComing soon is a Puzzle mode where you have to solve physics-driven puzzles in the fastest time possible.\n\nLeaderboards will be coming later so you can compete with your friends.", "short_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
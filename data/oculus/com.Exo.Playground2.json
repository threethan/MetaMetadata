FXNJ0Z0frY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXqh9vUQi01ep6IDdZ1fnBnqL5-P3QKCfv-duF-rWtlw&oe=6AEC9B16"}, {"file_name": "vlcsnap-2021-03-01-15h23m34s811.png", "id": "774992679776878", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982720_774992683110211_8478148152978643142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbdWY6HrEaYQ7kNvwGrhm0c&_nc_oc=AdrE8OvldnpmPiTpiruh7KvRn2zvosQHd2U0yyNWtOWzB37JRAIIj0QlgRlAnedcy2A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnhEXYbvbI2Ij1VVmhRcgPBgsaeLHnowF7lSk7wN7big&oe=6AECA1E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SportModeLandscapeCover.png", "id": "1250535798673645", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974827_1250535802006978_4125075686671892505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8elpubxeCMQ7kNvwGdk3Eh&_nc_oc=AdoUxpVmDSCRJaI9t4i2gPuesuCbxywTZ6PMEu9XVhDBZoQk-heyACEPprVIEjD3A64&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu8q8LMvHB_TopjbnB87fLOEtz1i-PUKwVkRYyzCEs2g&oe=6AECA5AA"}, "display_name": "Sport Mode", "keywords": [], "long_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit.\n\nSport Mode is currently in Early Access with a Sandbox mode where you have access to Creator Mode, a button press away from spawning and manipulating a variety of weapons, NPCs, and props. Also available is an Arena mode where you fight off waves of enemies for the highest score.\n\nComing soon is a Puzzle mode where you have to solve physics-driven puzzles in the fastest time possible.\n\nLeaderboards will be coming later so you can compete with your friends.", "short_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
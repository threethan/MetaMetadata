G_wGv_ynrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPox8CzPMYdvtSz8_QZJye_VsR8NR7bNTwvnidVGeNUCg&oe=6AE0BD96"}, {"file_name": "vlcsnap-2021-03-01-15h23m34s811.png", "id": "774992679776878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_774992683110211_8478148152978643142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ8fAvDCsW0Q7kNvwG5yMyt&_nc_oc=AdrE-s6DU3TfTwFlSLPwcMuHUI_uiv3vQbm6ZEtn9tlrfduToM7OOew-tinWhatdgdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDBVJ9wMd4KhBW8-rKHYDN8NNnRRGFRFYYIMYHvnTz9Q&oe=6AE0C467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SportModeLandscapeCover.png", "id": "1250535798673645", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_1250535802006978_4125075686671892505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJ-noLzC7ukQ7kNvwHU59ua&_nc_oc=AdqaQ2YkfWJQ03ge5QxTIhRkFWljo4LKjzVi6wwLwrqFf2XIDT8LaSKGg7g5ud2Iubg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO38bIxASjyyLXMXa_esAaZLDz4CndXk99-FgKgzSP3Q&oe=6AE0C82A"}, "display_name": "Sport Mode", "keywords": [], "long_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit.\n\nSport Mode is currently in Early Access with a Sandbox mode where you have access to Creator Mode, a button press away from spawning and manipulating a variety of weapons, NPCs, and props. Also available is an Arena mode where you fight off waves of enemies for the highest score.\n\nComing soon is a Puzzle mode where you have to solve physics-driven puzzles in the fastest time possible.\n\nLeaderboards will be coming later so you can compete with your friends.", "short_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
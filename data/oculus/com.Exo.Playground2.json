0988483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exBM5r-0aRAQ7kNvwEoiFgH&_nc_oc=AdmU8FrsGZiDHgvi3Vzwr8p5W21iszFXLdVVihbI_yh1pL-jQWd0n8k5PkiVlguqkAg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIa3ZHCF0Gc18oXkROpnUIZWQPtDs1yHyqPjSB1mhLrg&oe=69AAC1A1"}, {"file_name": "PostUpdate3.png", "id": "1325649858268387", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57569480_1325649861601720_9085372146485967128_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLZqYiYfMoMQ7kNvwGx_zoq&_nc_oc=AdkRzZCR-evfpij9nNDzUHvLPHVlkfviZDs7fIkeMALNdfqyDMgys4M-FiJ0b5qm8Pk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_17VrYkpV4050xv06EVDgIHXp4MGyrUNtYw4vzbsw5g&oe=69AAB6D5"}, {"file_name": "PostUpdate2.png", "id": "948417932789742", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/43997709_948417936123075_8773380777805429200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgT0CcqiiksQ7kNvwFYHYqz&_nc_oc=AdkVXeWH5fv4ucjNee_Rn9x2ylTBSfo7Y6vAXJqtG7dEKsIFHpWfqTZ3SYOIHy1ssqk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2LXO6PxwSPamTJ1yWLRmVJt2JD-WVg8qJfiqBc3ZzNA&oe=69AAB413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscapePNG.png", "id": "654708479777123", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035446_654708483110456_7702099847216412787_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxIXuqBIJecQ7kNvwELRCaY&_nc_oc=AdlKQCWHRjdll07swrFaku2_hPeNjSmuhU2CCpzdII_HoOa51vDFO7PNYKFpoRzbuIk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afyg11ZEmn0DjIPGXZoLq2QOjcMmlNEAxVR8Wkbob6L5xA&oe=69AAE36D"}, "display_name": "Sport Mode", "keywords": [], "long_description": "Turn on Sport Mode to take it to the next level of VR physics interaction where your creativity is the limit.\n\nKEY FEATURES\nPhysics Driven - Realistic physics to create a visceral connection between you and the virtual world.\nArena Mode - Fight off waves of enemies for the highest score.\nSandbox Mode - A button press away from spawning and manipulating a variety of weapons, NPCs, and props.\nSandbox Modifiers - Customize the experience to your liking with customizable strength and speed, dismemberment, oil splatter, time stop, a jetpack, and much more.\nComing Soon - New levels, modes, weapons, tools, props, modifiers, and vehicles will be added over time.", "short_description": "Turn on Sport Mode to take it to the next level of VR physics interaction where your creativity is the limit, the successor to Physics Playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuaport.org/2022/01/13/sport-mode-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuaport", "support_website_url": null, "website_url": "https://virtuaport.org/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2001223896890143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568680_3031166627187367_3907998775803835338_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkNwibJHMRoQ7kNvwFmTW_C&_nc_oc=Adkqj3tKcwn-BeuGirbbmVx15JD1W8g78c7S276qC8-0Q8mHY4f_L8MwkROgbYITgOo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwivYagt_ShxAQaWyocnaMP8KVBLQYEmD_eGtDYpY1
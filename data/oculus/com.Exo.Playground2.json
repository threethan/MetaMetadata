F2HZRXUEYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFuIjeCbbn1WYtR6qGOvcWEKLTbtsEl_vbiuiTwfj1fQ&oe=6AAC0196"}, {"file_name": "vlcsnap-2021-03-01-15h23m34s811.png", "id": "774992679776878", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_774992683110211_8478148152978643142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrnNivvPMfIQ7kNvwF6OT27&_nc_oc=AdqZQR3ju-3KV9WcyB4Ve8GY-Ky5T10yNpmus627OcNUe6jfiFrOK1ZMKYxXohr9kuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIygQzfYswOfOdMT9Cy7X7A4wMRRcz-7hj78AG6QxzTjQ&oe=6AAC0867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SportModeLandscapeCover.png", "id": "1250535798673645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974827_1250535802006978_4125075686671892505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNZU4UYKPpcQ7kNvwG_1bXd&_nc_oc=AdqK7Egw3qkD1MUbp6DLNrbEFLWfwgxpH0wgPy8yhO110oS6trR9APRmisDktjoThOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT4vaq55qq7I-Gc5njA0lgZ1YJW5zFijc0uy7tDJgBWQ&oe=6AAC0C2A"}, "display_name": "Sport Mode", "keywords": [], "long_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit.\n\nSport Mode is currently in Early Access with a Sandbox mode where you have access to Creator Mode, a button press away from spawning and manipulating a variety of weapons, NPCs, and props. Also available is an Arena mode where you fight off waves of enemies for the highest score.\n\nComing soon is a Puzzle mode where you have to solve physics-driven puzzles in the fastest time possible.\n\nLeaderboards will be coming later so you can compete with your friends.", "short_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
1hnQ7lXZZ0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94yBU-aTv93BgGa-Jtmk4FRckhel8Vcnpsh4Yo5OIqiQ&oe=6A340916"}, {"file_name": "vlcsnap-2021-03-01-15h23m34s811.png", "id": "774992679776878", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_774992683110211_8478148152978643142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFcQRgEDdvAQ7kNvwFpJzZV&_nc_oc=AdryoYddcaEjf6-aiIsxFzTquNOk-S_65IZ82Pu5ANZrhKLr0oJQ8Zeu9C7M16sMEv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82ecBMfZEReE25Julg5VGPpF7iIfAmlXq6To7_Cly7QQ&oe=6A340FE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SportModeLandscapeCover.png", "id": "1250535798673645", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974827_1250535802006978_4125075686671892505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BQdBKsB_dUQ7kNvwEGDeiE&_nc_oc=AdqKegU-4q39Z-6oUD_X2fNvHoVVUED6GxkC6IE6A2wHk5NGkRiB3OQ7Wkss9-Wzlpg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V3qkimE6N6cgUb4_F3m7w96VhVM5stHN_ffImqrbPIw&oe=6A3413AA"}, "display_name": "Sport Mode", "keywords": [], "long_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit.\n\nSport Mode is currently in Early Access with a Sandbox mode where you have access to Creator Mode, a button press away from spawning and manipulating a variety of weapons, NPCs, and props. Also available is an Arena mode where you fight off waves of enemies for the highest score.\n\nComing soon is a Puzzle mode where you have to solve physics-driven puzzles in the fastest time possible.\n\nLeaderboards will be coming later so you can compete with your friends.", "short_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
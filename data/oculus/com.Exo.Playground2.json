FLvAqZaZ38&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42TkmXdswLABMebzjsQYqAwJwiqh9yuCsS_F4Xo1wuNA&oe=6A0F1F16"}, {"file_name": "vlcsnap-2021-03-01-15h23m34s811.png", "id": "774992679776878", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982720_774992683110211_8478148152978643142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3luwCcnc-QQ7kNvwGUiPDi&_nc_oc=AdpSpi_LV-hh3-B3JnRkWhSnxSK-4XDQhT07EwwYV0kdPkHP1JpcHpR9yYKSr0epK9A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V5kzEizo_wsuoqU8dUgiOkypHlaVFA3UGAfvZFJ7Efw&oe=6A0F25E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SportModeLandscapeCover.png", "id": "1250535798673645", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974827_1250535802006978_4125075686671892505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgpyVZRN0gEQ7kNvwHKhIZC&_nc_oc=AdpNNxLU7Y2enTbyx1HJ-V-RI2p4MdAYH0NSs6RjH3Sfk5kg0GJQ1QbTUMJoVarNL4I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kwYO20iQeH9W46kE2tBZCCedhJSX7sjaAsMJwQqOMrQ&oe=6A0F29AA"}, "display_name": "Sport Mode", "keywords": [], "long_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit.\n\nSport Mode is currently in Early Access with a Sandbox mode where you have access to Creator Mode, a button press away from spawning and manipulating a variety of weapons, NPCs, and props. Also available is an Arena mode where you fight off waves of enemies for the highest score.\n\nComing soon is a Puzzle mode where you have to solve physics-driven puzzles in the fastest time possible.\n\nLeaderboards will be coming later so you can compete with your friends.", "short_description": "Successor to the hugely popular Physics Playground, Sport Mode takes it to the next level in a game where your creativity is the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
BPa3CRUbC1WncCxxMThtWqgeZviZ8b2y6UWT2AubkLh2A1E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsmG1QM2s_rf5szxpcVAKMWGBOximr7UMcZiRp9ZUXNg&oe=6A86D732"}, {"file_name": "5.png", "id": "1049883949143458", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003280_1049883952476791_1397821982617140448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeZMq5PGVVQQ7kNvwEHUJhs&_nc_oc=AdrZNtk7TIEFau-UH9pYHCrYckjNelCmuPTuqZPkQyU2A2R8AdNdOdZHFUV2s9rD_ko&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO9OS1ZF2YbqYbn5uXrk4ebjEWzsiUd0P8wgLjnaKUYA&oe=6A86E0FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "595470604898250", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031463_595470611564916_2866895790321003534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8_0TyxjeKYQ7kNvwF2HEdx&_nc_oc=Adqccg838BQuZSQL6hBIJQ_5t9PUJopq6pO5JAxFdUedwN5F0ReiTrmD_IXvlIgWquQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg8hnbKheqUyQlOqk0TO0oBS1HMOV7XzwDHROj1udH9A&oe=6A86D1A0"}, "display_name": "Lost in Place", "keywords": [], "long_description": "Dear Volunteer,\nThanks for accepting our invitation to run through these challenging trials. We'll be testing your cognitive and motor functions as you pilot a little ship around a variety of environments. The ship is very touchy, quite expensive, and it will break on just about everything. Don't worry though, you'll only be graded on your performance! We've established strict metrics to stimulate your competitive spirit and get your blood pumping. You can even compare yourself to other volunteers to see how well you are doing. Just a little friendly competition, nothing nefarious on our end. On that note, please do your very best and try to have fun. ", "short_description": "Pilot a delicate little ship through a variety of environments.\nCollect the coins, compete with friends, and try not to crash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bright-corners-llc.web.app/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Bright Corners LLC", "support_website_url": null, "website_url": "https://bright-corners-llc.web.app/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27918651037767479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570290_438666961268364_5712786298412498837_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEnfS-jzZBoQ7kNvwFZoHKE&_nc_oc=AdpVbvDSry-dEClineKKJbKvKPL2e6KikMhfeu_VK61_gbBJQoWUA3hfgqG328NQ9iQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsaQdT4Y79-uPxsrJU_Wxjr5e3y-6jEsPWx4sqX6gYhQ&oe=6A86EBD3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lost in Place", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1643680373, "lastRevision": {"nodes": [{"id": "2512528092224526", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", 
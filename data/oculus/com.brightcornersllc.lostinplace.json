g", "id": "934435124134177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001703_934435127467510_1610283588092429329_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeP9NOOYHuYQ7kNvwH2HHF8&_nc_oc=AdrVoTSBl-04Fs5q8fXf7MCUObEVNlRwNL1S12TIQd85jshchHJ8Fuznhj7JK8QMBHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKwhuPEZ-tYvVYd_Cht64IVKeytFfXeHCzqvmR3Br4oA&oe=6B048632"}, {"file_name": "5.png", "id": "1049883949143458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003280_1049883952476791_1397821982617140448_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4C6EBV2-C8Q7kNvwF7IwUe&_nc_oc=AdraQNEUozIFwD1oe1TRblh1RKMfiER7wCR2hLQ__L4CUpcHk5avg9Pbx9mrlY_c9AA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRYnPvv8IcdkzXnj-NIdMaqVaXs8Zv2RJ248cANFIfvg&oe=6B0457BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "595470604898250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031463_595470611564916_2866895790321003534_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js39_t0kdEgQ7kNvwHrxkLz&_nc_oc=Ado-UbWw6dUAYZYdMmxAfnHVYgaPyXryeqwC-HbC1UU8Ie0zC2IUIfAj4c-CS23qI38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxQadg5RKYTXi3IV4v9ynrciO-t1X5qyBPOeOm2bRF9g&oe=6B0480A0"}, "display_name": "Lost in Place", "keywords": [], "long_description": "Dear Volunteer,\nThanks for accepting our invitation to run through these challenging trials. We'll be testing your cognitive and motor functions as you pilot a little ship around a variety of environments. The ship is very touchy, quite expensive, and it will break on just about everything. Don't worry though, you'll only be graded on your performance! We've established strict metrics to stimulate your competitive spirit and get your blood pumping. You can even compare yourself to other volunteers to see how well you are doing. Just a little friendly competition, nothing nefarious on our end. On that note, please do your very best and try to have fun. ", "short_description": "Pilot a delicate little ship through a variety of environments.\nCollect the coins, compete with friends, and try not to crash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bright-corners-llc.web.app/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Bright Corners LLC", "support_website_url": null, "website_url": "https://bright-corners-llc.web.app/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27918651037767479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570290_438666961268364_5712786298412498837_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_Eyr0gfULEQ7kNvwHtA2c7&_nc_oc=AdqL7pQcTgfwhKHYwISQ2W8zYHVzTWoGnjtaO4tz36TnzreTulaMCsDupELjoPvMb9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY1gzOLdKj09KQ-HPiorrmg1VxwWqjk0RvjWP2CfGGuw&oe=6B046293"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lost in Place", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925
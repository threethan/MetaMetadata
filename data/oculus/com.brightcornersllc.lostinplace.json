g", "id": "934435124134177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001703_934435127467510_1610283588092429329_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeP9NOOYHuYQ7kNvwG9c3PH&_nc_oc=AdqVIpESHUkiyUHkWAuWF_0l30y89VpzdO_IqyOjvc9gNNsjcz5-j7sfAxbrF8cj30g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg-kD9qhF3PrYeOK4UQ7pNs3QnlCmAkdAAvb1qtlecDg&oe=6B05D7B2"}, {"file_name": "5.png", "id": "1049883949143458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003280_1049883952476791_1397821982617140448_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTze9AQEnAQQ7kNvwGFRWUn&_nc_oc=AdqPF8spsSUhCX4gMB0UxO6VVEEjpQVyQqgoVbsOX-K-Gcx0C3SWxaRPiNHBN4F5q0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwV912wMVzM2VgHiA4bAVqVqGwlcr1JL8hz8zsbTi1vA&oe=6B05A93E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "595470604898250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031463_595470611564916_2866895790321003534_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js39_t0kdEgQ7kNvwGhJvcS&_nc_oc=AdrnZSWXJ9fjXrWD0OL2onyNDG-5HLlxKFiPtJrJEHiylgX245TzyVHcJMns5pd-Srk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_Xocl2tIuVCdxPrcBcYKtcRqO3P5l4FsrqnFW4z7lxw&oe=6B05D220"}, "display_name": "Lost in Place", "keywords": [], "long_description": "Dear Volunteer,\nThanks for accepting our invitation to run through these challenging trials. We'll be testing your cognitive and motor functions as you pilot a little ship around a variety of environments. The ship is very touchy, quite expensive, and it will break on just about everything. Don't worry though, you'll only be graded on your performance! We've established strict metrics to stimulate your competitive spirit and get your blood pumping. You can even compare yourself to other volunteers to see how well you are doing. Just a little friendly competition, nothing nefarious on our end. On that note, please do your very best and try to have fun. ", "short_description": "Pilot a delicate little ship through a variety of environments.\nCollect the coins, compete with friends, and try not to crash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bright-corners-llc.web.app/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Bright Corners LLC", "support_website_url": null, "website_url": "https://bright-corners-llc.web.app/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27918651037767479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570290_438666961268364_5712786298412498837_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_Eyr0gfULEQ7kNvwH9e0Gj&_nc_oc=AdrtIdaAofcCxe2l83mnxzUrZO8zWwFSOuNJN8uf5EPtjeXGy2NWwJLMU3rPjYP4ySg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD-SstjbD046yGDXQNAgxiaJNamovIZY01rlCWahkqiw&oe=6B05B413"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lost in Place", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925
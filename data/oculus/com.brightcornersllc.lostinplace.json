iZJn6A2c4mF7XiDx7EiOe9pjiw7vtLdp7ggSEIbbGprio890&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE-YXe80o0F2er7-2C-gdTT6PzQqW9AK4Vlgh_gqrVgQ&oe=69B17C72"}, {"file_name": "5.png", "id": "1049883949143458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_1049883952476791_1397821982617140448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffgF-evtkoIQ7kNvwGoDWFA&_nc_oc=AdnxSCELCxBh_DFLlap8bf-k1hAteBaahdT9boqpBttXnqQRBbfjzCTGL5iHQOTTCVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSNdETUM1omRL6wgXMOGGvrThfxfrfYU7xI3V_a9dGfw&oe=69B14DFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "595470604898250", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031463_595470611564916_2866895790321003534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9vSAiHmDREQ7kNvwFT8S5t&_nc_oc=AdmcPDT18XK3NMu-jIJRb2WhbkOjzyGoJYv-WlYtX949qsYmcjqJ6bgPaVnMllG0c-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9YxaGm0064QsKZ8HIWzV2Al2FdUr3k08N8wFUNc-zAg&oe=69B176E0"}, "display_name": "Lost in Place", "keywords": [], "long_description": "Dear Volunteer,\nThanks for accepting our invitation to run through these challenging trials. We'll be testing your cognitive and motor functions as you pilot a little ship around a variety of environments. The ship is very touchy, quite expensive, and it will break on just about everything. Don't worry though, you'll only be graded on your performance! We've established strict metrics to stimulate your competitive spirit and get your blood pumping. You can even compare yourself to other volunteers to see how well you are doing. Just a little friendly competition, nothing nefarious on our end. On that note, please do your very best and try to have fun. ", "short_description": "Pilot a delicate little ship through a variety of environments.\nCollect the coins, compete with friends, and try not to crash!"}]}, "developer_name": null, "
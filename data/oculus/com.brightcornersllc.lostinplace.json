vqTh4oeDtSzgaAX2Rld74LvoI-bE_chSaIGBKfcUpDBu3I0va6XFFII&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5UYlHfXwc0CqI25E5hPRKLDbD0-OnxczgZ6Wz9UheQw&oe=6AA95672"}, {"file_name": "5.png", "id": "1049883949143458", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003280_1049883952476791_1397821982617140448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzwinzrmMAwQ7kNvwEuhCFg&_nc_oc=AdrLIC0HsJyVwuEGzJS-0T_je9gvzYG1yletEVnVR5ZSSNxRMcATOdf4Wh1d-Exvwqw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe0gwHU1Z2TQQYPSfDFs5KhHXIsZBq2XGA8K0lZiybAQ&oe=6AA9603E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "595470604898250", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031463_595470611564916_2866895790321003534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s80KLIl1VN0Q7kNvwGxoMiU&_nc_oc=AdrhSUMkej-49hMmWHgofrSa-LieGY-RmA7kbHfpfChJmtMf3SAqWDKjoyj4OsohfrI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ9Re78vuwapfpt26S84ImHNvQMW24a9EGKvHd3uQTbw&oe=6AA950E0"}, "display_name": "Lost in Place", "keywords": [], "long_description": "Dear Volunteer,\nThanks for accepting our invitation to run through these challenging trials. We'll be testing your cognitive and motor functions as you pilot a little ship around a variety of environments. The ship is very touchy, quite expensive, and it will break on just about everything. Don't worry though, you'll only be graded on your performance! We've established strict metrics to stimulate your competitive spirit and get your blood pumping. You can even compare yourself to other volunteers to see how well you are doing. Just a little friendly competition, nothing nefarious on our end. On that note, please do your very best and try to have fun. ", "short_description": "Pilot a delicate little ship through a variety of environments.\nCollect the coins, compete with friends, and try not to crash!"}]}, "devel
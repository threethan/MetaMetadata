M_n1CSHmsKH59Lx_0VKH5StqUIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ_RGXuJv4w9Kt3KCr41mdPEMuXlENytjuddUR3-Cz1Q&oe=69BFCBC3"}, {"file_name": "4.png", "id": "2056838777802598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035393_2056838781135931_6340289459195896109_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfIVf1CmfhcQ7kNvwFRvzCj&_nc_oc=AdmUBHDtyiHxRCcZhyMy2Jdrj-95iBZpdsyJap17kfRGwW_OZsWhgGKBHDSssGHHLxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP8sS9RkkpHErVmjBcBhtjLBFbAM28EgH1Mr4EoFV02Q&oe=69BFF954"}, {"file_name": "3.png", "id": "934435124134177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001703_934435127467510_1610283588092429329_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHE77MI7ruEQ7kNvwE-XMvr&_nc_oc=AdkvAXR0WQpRsKFK10fkSjbEgT6AwPqOMYg8Dcxge1awYwtQtNSZQf2imPs_hMn2tnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFpk3N7QikLoQI0h_MeQLuGmzq5bJNRSbq9gd4cK7b8w&oe=69BFFCF2"}, {"file_name": "5.png", "id": "1049883949143458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_1049883952476791_1397821982617140448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyTukmeBh0AQ7kNvwGaRlnJ&_nc_oc=AdlwvIRKpo9tWG3kmJqg5oAdI0OKjNWu77jOIbHQAxqJPukXTSgqQGonahUJiCVRjas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyM-HUq-BlCbNi_JhfBdJCHqc5ci4EYzYdCW8PvN0IfHA&oe=69BFCE7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "595470604898250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031463_595470611564916_2866895790321003534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAuAdFXII04Q7kNvwFQS-vZ&_nc_oc=AdmraSBzbwqPSq91KwBeTSRg8jPh9jtkxXmUBN-W3O3rwxyRhfAVvgeQLGC-r73gwzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn7rX-9lNYWGWcmOnl6vqALw8ZSYzU0XU-rDplPWXt-A&oe=69BFF760"}, "display_name": "Lost in Place", "keywords": [], "long_description": "Dear Volunteer,\nThanks for accepting our invitation to run through these challenging trials. We'll be testing your cognitive and motor functions as you pilot a little ship around a variety of environments. The ship is very touchy, quite expensive, and it will break on just about everything. Don't worry though, you'll only be graded on your performance! We've established strict metrics to stimulate your competitive spirit and get your blood pumping. You can even compare yourself to other volunteers to see how well you are doing. Just a little friendly competition, nothing nefarious on our end. On that note, please do your very best and try to have fun. ", "short_description": "Pilot a delicate little ship through a variety of environments.\nCollect the coins, compete with friends, and try not to crash!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://llcbrightcorners.wixsite.com/bright-corners-llc/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bright Corners LLC", "support_website_url": null, "website_url": "https://llcbrightcorners.wixsite.com/bright-corners-llc", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "519497259310466"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570290_438666961268364_57
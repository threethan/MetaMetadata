dn.com&oh=00_AftaEDeoyKY06UGgnUSi_AkwMjtR6o3sYzoTAsJAqmYhUQ&oe=6999A5AE"}, {"file_name": "Meli_Screenshot_BackPerspective.png", "id": "1392787448105757", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_1392787451439090_4723039382532256662_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4O__1cNxXkQ7kNvwFJMu-a&_nc_oc=Adn4DS89IozE9-nOVWGM8-rxxhniA-VxzqdjAoEn6YfR-iCSelypAq-JEVla0s6-Zvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBYpuEOrbtHLMsvOo7HssHKWLwlrBAWmCb-nW6khB9eA&oe=6999A72F"}, {"file_name": "Meli_Screenshot_FrontalPerspective.png", "id": "819509666628502", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404233_819509673295168_6074526212070131606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8dVI2OnxEcQ7kNvwEaox5d&_nc_oc=AdkmrvLzNEFohYHoNlCEq19fa-FA7QdKi8amWIec18Uo4aJmzE0x8JdftUjsnbKVFqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftkFaEjESLdU7NYRCl8sscVMiS1x7pPFyOIWHj1Jk8qeA&oe=6999A23D"}, {"file_name": "Meli_Screenshot_BackShot2.png", "id": "1415903032361800", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003230_1415903035695133_4971914996047705199_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKTHyqoWacUQ7kNvwHMKCd1&_nc_oc=AdkzbijjHva1SwGfKOIuqUpE2-Po0zxCaqDI4csIDjcVbOp9YBAOUNPBX7wilgIrXZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftAQ-SQtqexZAdFUhdYNmXL2_9k4hB5WIC_wLhXiTkCTg&oe=6999A589"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "X-Meli-1440.png", "id": "1151210712450324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_1151210715783657_5044172265416352692_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6KQjOHE2VAQ7kNvwF1GjeI&_nc_oc=AdmScqsMR4MhQJTi_hMEQ_sV-6qcqHH5z49TQPDaXon2DIPiuAZ5pdK-5tE_gJzRqUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrwdcIoeOrbdifOXhgVm8JCUJaAqgJJb839W7zcjBdiw&oe=6999A02F"}, "display_name": "Meli", "keywords": ["conducting", "music", "rhythm", "classicalmusic", "mixedreality"], "long_description": "You're the **conductor**, and the spotlight's on you! Dive into the **musical** world of Meli, where every wave of your hand brings the rhythm to life. With awesome **hand-tracking** and **mixed reality** magic, you can wield your wand and watch as your living room transforms into an extravaganza of lights, colors and sound. Get ready to groove to all the classics, from the graceful *Swan Lake* to the buzzing *Flight of the Bumblebee*. The stage is yours, the wand's ready \u2014 **let's play some music!**", "short_description": "You're the conductor, and the spotlight's on you! Dive into the musical world of Meli, where every wave of your hand brings the rhythm to life. With awesome hand-tracking and mixed reality magic, you can wield your wand and watch as your living room transforms into an extravaganza of lights, colors and sound. Get ready to groove to all the classics, from the graceful 'Swan Lake' to the buzzing 'Flight of the Bumblebee.' The stage is yours, the wand's ready \u2014 let's PLAY some music!"}]}, "developer_name": "techToy Studio", "developer_privacy_policy_url": "https://techtoy.studio/meli-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "techToy Studio", "support_website_url": null, "website_url": "https://melimusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "85712
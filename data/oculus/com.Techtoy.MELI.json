dn.com&oh=00_AftSV2GAvjrPCWYKCHsOkh2NF_nqmOZBdUIui1LdVWdTgA&oe=69A5832E"}, {"file_name": "Meli_Screenshot_BackPerspective.png", "id": "1392787448105757", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_1392787451439090_4723039382532256662_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEvhBVytyX0Q7kNvwH1JtEt&_nc_oc=Adk9zl-QjRiTRfaZD2daX0fS8Ys673Y5aJ2cLOWlAhA3dQf5zsHjzGcWmSEAeIWFnc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvdWet7EvPOqwzPINBvHMGPxIYECg3I-oHNtozeNjczEw&oe=69A584AF"}, {"file_name": "Meli_Screenshot_FrontalPerspective.png", "id": "819509666628502", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75404233_819509673295168_6074526212070131606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ggT7hOS8J8Q7kNvwFwLVA9&_nc_oc=AdmeOz1ZoNkdJybb-MEu__CNLtJpwYOtNIw4TliXEq_7I7bGvAzGCfdv2_85P9je4Wg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftgagAm2TpO_vqEy_NTAtvIAnoGBLD9j0JMnsxso9SNlA&oe=69A57FBD"}, {"file_name": "Meli_Screenshot_BackShot2.png", "id": "1415903032361800", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003230_1415903035695133_4971914996047705199_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dxmHfmoOCUQ7kNvwHPQ5vA&_nc_oc=Adm19jfoUG_HsBrq8G_rqIM61R9Wl3hKTwnC65uwCJSoBoD1Xw-ZP2yRfkaxpMzvmNQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afvsc91lWxCFTKweygHAQ3SmJM4KZ-wz1kZuy9ENJxDx1g&oe=69A58309"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "X-Meli-1440.png", "id": "1151210712450324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982568_1151210715783657_5044172265416352692_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6We8cWm0V3IQ7kNvwG_2-zc&_nc_oc=AdkZJQLC-8Fdsust1yIDzofY8j2K8RdgfSpSfRzFOonmq1iZb2HyTAtiQxBESblt7nc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvO-Yf_g8Xu0yTanrZhTNS_f0RfbbAuUhdpjcAjQtlbYA&oe=69A57DAF"}, "display_name": "Meli", "keywords": ["conducting", "music", "rhythm", "classicalmusic", "mixedreality"], "long_description": "You're the **conductor**, and the spotlight's on you! Dive into the **musical** world of Meli, where every wave of your hand brings the rhythm to life. With awesome **hand-tracking** and **mixed reality** magic, you can wield your wand and watch as your living room transforms into an extravaganza of lights, colors and sound. Get ready to groove to all the classics, from the graceful *Swan Lake* to the buzzing *Flight of the Bumblebee*. The stage is yours, the wand's ready \u2014 **let's play some music!**", "short_description": "You're the conductor, and the spotlight's on you! Dive into the musical world of Meli, where every wave of your hand brings the rhythm to life. With awesome hand-tracking and mixed reality magic, you can wield your wand and watch as your living room transforms into an extravaganza of lights, colors and sound. Get ready to groove to all the classics, from the graceful 'Swan Lake' to the buzzing 'Flight of the Bumblebee.' The stage is yours, the wand's ready \u2014 let's PLAY some music!"}]}, "developer_name": "techToy Studio", "developer_privacy_policy_url": "https://techtoy.studio/meli-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "techToy Studio", "support_website_url": null, "website_url": "https://melimusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "85712
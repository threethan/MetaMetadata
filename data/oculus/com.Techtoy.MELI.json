dn.com&oh=00_AfvLUgtt-wsRmKNR8TyEtH0PC92jJYFgR_m6W-1nc_IKRw&oe=6998542E"}, {"file_name": "Meli_Screenshot_BackPerspective.png", "id": "1392787448105757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_1392787451439090_4723039382532256662_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4O__1cNxXkQ7kNvwF7zFu8&_nc_oc=AdnI2w7lvHt82Hug_Pobh5Ix3bT9UkIT6rKowbKnhKJltpoyH8bvhrrhkStBgaT5BJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuv2SG2QIjxQFCRyPHwXenp24vzB5QZKCjGs0XC0oIA7w&oe=699855AF"}, {"file_name": "Meli_Screenshot_FrontalPerspective.png", "id": "819509666628502", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75404233_819509673295168_6074526212070131606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8dVI2OnxEcQ7kNvwHFP5OK&_nc_oc=Adl7l_oOoY08o3Qk52I1OUNUx9Yvv_jATl305qdPYpzFgkpb76tZA_ttZyZNhAMRvS4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv-qhmWh9nI4vwIU3HuaA0R_xjhT-UMYadeXkXRsh40qA&oe=699850BD"}, {"file_name": "Meli_Screenshot_BackShot2.png", "id": "1415903032361800", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003230_1415903035695133_4971914996047705199_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKTHyqoWacUQ7kNvwGp8XU6&_nc_oc=AdmZDC_3KAgJ5SebBr2ekPR0cwfikYucaBU5nd6O6yVBeNH_MbRjfKsltjAxZoFyjnk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft_EwqBsBGwPrYe8g1NAR3Db4yGhpWVlZUYO-BaqMy1RQ&oe=69985409"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "X-Meli-1440.png", "id": "1151210712450324", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982568_1151210715783657_5044172265416352692_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6KQjOHE2VAQ7kNvwHxDJsd&_nc_oc=AdmJL6f_y4siGtJNngBvJd4tTat6V1XgchulKvzQEzMHKPn_8kQZi9E9mNHSBuR12ZU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfupBvlMH9KGD_qQHkDW2-Svzw1oNA876QAJ8YEqddJIlw&oe=69984EAF"}, "display_name": "Meli", "keywords": ["conducting", "music", "rhythm", "classicalmusic", "mixedreality"], "long_description": "You're the **conductor**, and the spotlight's on you! Dive into the **musical** world of Meli, where every wave of your hand brings the rhythm to life. With awesome **hand-tracking** and **mixed reality** magic, you can wield your wand and watch as your living room transforms into an extravaganza of lights, colors and sound. Get ready to groove to all the classics, from the graceful *Swan Lake* to the buzzing *Flight of the Bumblebee*. The stage is yours, the wand's ready \u2014 **let's play some music!**", "short_description": "You're the conductor, and the spotlight's on you! Dive into the musical world of Meli, where every wave of your hand brings the rhythm to life. With awesome hand-tracking and mixed reality magic, you can wield your wand and watch as your living room transforms into an extravaganza of lights, colors and sound. Get ready to groove to all the classics, from the graceful 'Swan Lake' to the buzzing 'Flight of the Bumblebee.' The stage is yours, the wand's ready \u2014 let's PLAY some music!"}]}, "developer_name": "techToy Studio", "developer_privacy_policy_url": "https://techtoy.studio/meli-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "techToy Studio", "support_website_url": null, "website_url": "https://melimusic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "85712
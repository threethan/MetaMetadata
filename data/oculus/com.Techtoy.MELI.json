1210715783657_5044172265416352692_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrUzguoFf3wQ7kNvwGCd52i&_nc_oc=AdrMXvb47uXU5TYWgS_mDiD2vQqhWLYTxCi5ALCTfZxKts0zjKiDd0N2V1VMY-bX-Kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRa1eO9_OK7Em2KVA5tsg1uZ35RR0gg7-ZwPStKbXXtpw&oe=6B0C4DEF"}, "display_name": "Meli", "keywords": [], "long_description": "You're the conductor, and the spotlight's on you! Dive into the musical world of Meli, where every wave of your hand brings the rhythm to life. With awesome hand-tracking and mixed reality magic, you can wield your wand and watch as your living room transforms into an extravaganza of lights, colors and sound. Get ready to groove to all the classics, from the graceful 'Swan Lake' to the buzzing 'Flight of the Bumblebee.' The stage is yours, the wand's ready \u2014 let's PLAY some music!\n\n**This is an early access demo, with regular updates to gameplay and content anticipated in the near future.**", "short_description": "You're the conductor, and the spotlight's on you! Dive into the musical world of Meli, where every wave of your hand brings the rhythm to life. With awesome hand-tracking and mixed reality magic, you can wield your wand and watch as your living room transforms into an extravaganza of lights, colors and sound. Get ready to groove to all the classics, from the graceful 'Swan Lake' to the buzzing 'Flight of the Bumblebee.' The stage is yours, the wand's ready \u2014 let's PLAY some music!"}]}, "developer_name": "techToy Studio", "developer_privacy_policy_url": "https://techtoy.studio/meli-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "techToy Studio", "support_website_url": null, "website_url": "https://melimusic.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_t
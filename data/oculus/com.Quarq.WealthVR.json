ue VR wellness experience.", "short_description": "Transform limiting beliefs into empowering ones through immersive VR wellness experience. Punch negative thoughts, embrace positive affirmations, and unlock your abundance mindset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wealthvr.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Quarq Studios", "support_website_url": null, "website_url": "https://wealthvr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25860415423594893"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "913695491087490"}, {"status": "PUBLISHED", "id": "1518992046049228"}]}, "baseline_offer": {"id": "913695491087490"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768833360, "status": "PUBLISHED", "id": "913695491087490"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25861795893456846", "version": "1.1"}, "id": "1446578357085871", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25860415400261562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25861795893456846"},
: "4175889905998237", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823837_4175889909331570_805187105100442661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGZiRVy6lnQQ7kNvwHXct7D&_nc_oc=AdpEMSp74u3jg8hsbXUdahHrym5h9hlmEBz9qZcor_ZD42ZxMu0Ho2QeSMNSDI6IYvo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPfgOsfTNWhtsEEDnnS7urBCrAwbc2t3Ubio_IaJJR2w&oe=6A8D744F"}, {"file_name": "5.png", "id": "901556069106972", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818852_901556072440305_8637581800247156860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwoKcjHuZ6IQ7kNvwEZwsCC&_nc_oc=AdpNDz-c_qc_vkHtKgHxgJflyJkyEc0hHB5abJkpNIBHQZzH4_xRANUt13_3rcnomqA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjAZaK-oCnHdxRIN3WIEk71hpUhA11iNAQoL4J8IJDvg&oe=6A8D64C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WealthVr", "keywords": ["wealthvr", "wealth", "wealthflowvr", "abundance", "prosperity"], "long_description": "\ud83d\uded1 APP MOVED \ud83d\uded1\n\nThis legacy version is no longer supported.\nFor the NEW, polished experience with Luxury Environments & Audio, please search for and download:\n\"WEALTHFLOWVR\"\nhttps://vr.meta.me/s/1RitDfbTEVyLrXw\n\u26a0\ufe0f IMPORTANT DISCLAIMERS:\n\n\ud83d\udd34 AGE RESTRICTION: 18+ ADULTS ONLY\nThis application is strictly for users 18 years or older.\n\n\ud83d\udd34 ENTERTAINMENT ONLY\nThis is NOT medical, psychological, financial, or the\n---\n\n\n\nWealthVR is a revolutionary VR wellness application that combines somatic therapy, chakra healing, and mindfulness practices to help you transform your relationship with money and abundance.\n\nFEATURES:\n- Chakra Profiling - Identify which energy centers hold your limiting beliefs about wealth\n- Somatic Gameplay - Use physical movements to release negative patterns\n- Punch Mechanics - Destroy limiting beliefs with powerful strikes\n- Embrace Mechanics - Accept positive affirmations into your being\n- EMDR-Inspired Design - Bilateral stimulation for deeper healing\n\nHOW IT WORKS:\n1. Start in the BeliefMirror to identify your blocked chakras\n2. Progress through levels fighting negative beliefs\n3. Embrace positive affirmations\n4. Complete your transformation journey\n\nBENEFITS:\n- Release money blocks and limiting beliefs\n- Build a positive wealth mindset\n- Experience therapeutic VR wellness\n- Combine fitness with mindfulness\n\nPerfect for anyone seeking personal growth, abundance coaching, or a unique VR wellness experience.", "short_description": "\ud83d\uded1 APP MOVED \ud83d\uded1\n\nThis legacy version is no longer supported.\nFor the NEW, polished experience with Luxury Environments & Audio, please search for and download:\n\"WEALTHFLOWVR\"\n\u26a0\ufe0f 18+ ONLY | NOT medical/financial advice | Consult doctor before use | Not for epilepsy/heart conditions/pregnancy\n\nhttps://vr.meta.me/s/1RitDfbTEVyLrXw\n\n\nSmash blocks. Stack abundance. WealthVR - Sweat into prosperity.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wealthvr.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Quarq Studios", "support_website_url": null, "website_url": "https://wealthvr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25940696385566796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
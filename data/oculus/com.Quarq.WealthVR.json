ttps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_4175889909331570_805187105100442661_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnaHKsQd5EQQ7kNvwE_aAZ_&_nc_oc=AdoGTpdNOOEXSuvpYNMh08-d-YvOMcdX8vBpvMHzz1ftPxoXdcDMVcl_0F-uDifwhls&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwc-FR2WKDIjIA-xKndC8XaeuAyDK38wjKJKFJoZCPRg&oe=6AFB190F"}, {"file_name": "5.png", "id": "901556069106972", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818852_901556072440305_8637581800247156860_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2PluJctKu0Q7kNvwGoX3Mw&_nc_oc=AdpEWSbP0f4N7gv82297I-YGH4httUaJ4sxj84KJ7OnTJWY_0u_vf3Fw59qLacK1lSo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfVmjfDLN0tIo0xyuqx_ENmsH_uhX956QIxR6W8HFinQ&oe=6AFB41C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WealthVr", "keywords": [], "long_description": "WealthVR is a revolutionary VR wellness application that combines somatic therapy, chakra healing, and mindfulness practices to help you transform your relationship with money and abundance.\n\nFEATURES:\n- Chakra Profiling - Identify which energy centers hold your limiting beliefs about wealth\n- Somatic Gameplay - Use physical movements to release negative patterns\n- Punch Mechanics - Destroy limiting beliefs with powerful strikes\n- Embrace Mechanics - Accept positive affirmations into your being\n- EMDR-Inspired Design - Bilateral stimulation for deeper healing\n\nHOW IT WORKS:\n1. Start in the BeliefMirror to identify your blocked chakras\n2. Progress through levels fighting negative beliefs\n3. Embrace positive affirmations\n4. Complete your transformation journey\n\nBENEFITS:\n- Release money blocks and limiting beliefs\n- Build a positive wealth mindset\n- Experience therapeutic VR wellness\n- Combine fitness with mindfulness\n\nPerfect for anyone seeking personal growth, abundance coaching, or a unique VR wellness experience.", "short_description": "Transform limiting beliefs into empowering ones through immersive VR wellness experience. Punch negative thoughts, embrace positive affirmations, and unlock your abundance mindset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wealthvr.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Quarq Studios", "support_website_url": null, "website_url": "https://wealthvr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25860415423594893"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "913695491087490"}, {"status": "PUBLISHED", "id": "1518992046049228"}]}, "baseline_offer": {"id": "913695491087490"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768833360, "status": "PUBLISHED", "id": "913695491087490"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25861795893456846", "version": "1.1"}, "id": "1446578357085871", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25860415400261562", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25861795893456846"},
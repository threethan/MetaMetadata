b=1-7&_nc_sid=6e7a0a&_nc_ohc=HwFsSGlbkwAQ7kNvwGT0JrI&_nc_oc=AdrdZXpoz_RxqlEZoy7lHTlPR_dwOoqJdla8LABpBKCtNq_HQJsjr7ewkU-2EviT2hY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7tCCXrLbRXse1I5lWnBuY6Ne-26mJpyM33kykSfF5Qg&oe=6A8C1347"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WealthVr", "keywords": [], "long_description": "WealthVR is a revolutionary VR wellness application that combines somatic therapy, chakra healing, and mindfulness practices to help you transform your relationship with money and abundance.\n\nFEATURES:\n- Chakra Profiling - Identify which energy centers hold your limiting beliefs about wealth\n- Somatic Gameplay - Use physical movements to release negative patterns\n- Punch Mechanics - Destroy limiting beliefs with powerful strikes\n- Embrace Mechanics - Accept positive affirmations into your being\n- EMDR-Inspired Design - Bilateral stimulation for deeper healing\n\nHOW IT WORKS:\n1. Start in the BeliefMirror to identify your blocked chakras\n2. Progress through levels fighting negative beliefs\n3. Embrace positive affirmations\n4. Complete your transformation journey\n\nBENEFITS:\n- Release money blocks and limiting beliefs\n- Build a positive wealth mindset\n- Experience therapeutic VR wellness\n- Combine fitness with mindfulness\n\nPerfect for anyone seeking personal growth, abundance coaching, or a unique VR wellness experience.", "short_description": "Transform limiting beliefs into empowering ones through immersive VR wellness experience. Punch negative thoughts, embrace positive affirmations, and unlock your abundance mindset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wealthvr.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Quarq Studios", "support_website_url": null, "website_url": "https://wealthvr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", 
bBDorqKOi8UE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRMsnNql7W4H8A5mnXcDsM-wR3DAIntMpPI7raOyuNGg&oe=69CBCC7C"}, {"file_name": "Clip5.png", "id": "1274341271379151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298291_1274341274712484_3931288755041598442_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kp4RzhWo6k4Q7kNvwEZmif9&_nc_oc=AdpzsLyfcR0rh89tXxozwF-_yY7cHHKlnD1wigDzwfveOgDl0Wvo8Z8Hst6vui7HShE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afziqm4ECMgtsZc7U2Lq-1L-ZvlIh_HHDsfOeBoBSwR1nQ&oe=69CBDF3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover image_ 2560 x1440.png", "id": "2074996509918155", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822723_2074996513251488_8847006516908403311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaMzyKQYZQMQ7kNvwH84wRs&_nc_oc=AdojJD6bA9SBAPXlgOTzNBeXg_QAOV3e0jQtorYsFZEB9PjmJdtm4y1igVX6W9K80js&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2NXqIpbuVr9fSRsojdYwchtG3F6xLD_1yJkrLch5ZGQ&oe=69CBC1EE"}, "display_name": "Multiverse Kaitenzushi: Learn Japanese Alphabet", "keywords": ["Cooking", "language", "education", "MR", "food"], "long_description": "# BECOME A SUSHI CHEF IN MULTIVERSE! \n\nStep into the deliciously chaotic world of Multiverse Kaitenzushi, a mixed reality experience where you become a sushi chef with a linguistic twist! In this unique language-learning adventure, you\u2019ll grab Japanese letters, assemble them into sushi orders, and serve multiverse-spanning customers!\n\n{2735090710015518}\n\nEach customer\u2019s order is a fun puzzle made of hiragana and katakana characters. Practice pronunciation, letter recognition, and memory as you race against time to serve the right sushi. \n\nWhether you're just starting your Japanese journey or want a fresh, exciting way to review, Multiverse Kaitenzushi makes learning unforgettable. Play, move, speak, and interact\u2014because in this multiverse, language is the secret ingredient.\n\nGrab the letters. Assemble the sushi. Serve the multiverse.\n\nAre you ready to become the ultimate multiverse sushi master?\n\n{679450421809907}\n\n\n", "short_description": "Enter Multiverse Kaitenzushi, a mixed reality game where you become a Japanese sushi chef! Grab, assemble, and serve sushi using hiragana and katakana to satisfy quirky customers from across the multiverse. Learn the Japanese alphabet through fast-paced, immersive fun!"}]}, "developer_name": "Kore Meta", "developer_privacy_policy_url": "https://drive.google.com/file/d/19akoI3-h-GLNrAP4jDb-aZxdk-VIuVNU/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kore Meta", "support_website_url": null, "website_url": "https://koremeta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24919325984429391"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823485_773080345394844_2137955796036685453_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsRhd-S4J5MQ7kNvwHy7FdE&_nc_oc=AdoaxEC7c0ye7nRsCzqFamc15JsKrdgeBZ-vBqAc5IkVxxenwnBJhNsKGJk9M0qRVGw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqNfocKPS7PV08nFY5-k92tXTJRN0iOker3WMY0eJjjw&oe=69CBB47D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
0927_169924330418548703_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz0u9ywVC8wQ7kNvwGnqmy1&_nc_oc=AdrrxhokB16RtPjO0yWzcvMuXVa6Dz6ExBSd4fXdgxtbu6eVKrBaLvcglH91ZiIlPP0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4M2_MaOuliNZgmEmcqyS_BywfGU47x8Ds3lR8Moj9_g&oe=6B05A2C2"}, {"file_name": "screenshot_4_kana_flashcards.png", "id": "2688326888231954", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831964_2688326891565287_3083453217977673320_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgBXD_xnhhkQ7kNvwGKXihg&_nc_oc=AdoiLZR9mZFYZtKm2cTspkXSJOOwTc5rythAeZR5j71uFXALOiWcjzdqPDXmP9oQuNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvsxceanuph928mX2KnyEUM-qC8jmGmrhsqbqaX_wS1g&oe=6B05B6AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440_FullLaunch_110526.png", "id": "1129266992907163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628016_1129266996240496_2831192394328263090_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFhsJ5UGpE4Q7kNvwHl9M5m&_nc_oc=AdrBFovOandfROvWDnSvwZDD1RmXY3sIWKrUm4-VllDNBdH6cnfLtnqflyjaiu18EQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOXakTnzmmzg0bdQ1rPgEJ7YPa2YUFkJZpxYfi8Ygfpg&oe=6B05D928"}, "display_name": "Multiverse Kaitenzushi: Learn Japanese with Sushi", "keywords": ["Japanese", "sushi", "language", "education", "cooking"], "long_description": "# \ud83c\udf63 Multiverse Kaitenzushi is fully launched. Play now!\n\n**Early Access players: thank you!** The full game is already yours!\nIf Levels are locked, press **Restore purchases** or email **contactkoremeta@gmail.com** with your Meta Horizon username. \n\n# Can you spell your way to a perfect service?\n\nEvery sushi order arrives in **Japanese**. Grab the right **hiragana** and **katakana** off the spinning belt, spell the dish with your own hands, and serve it before patience runs out!\n\n{1611595004025318}\n\n# Learn Japanese without noticing\n\n- Every letter **speaks its sound** as you grab it\n- Every order is a real word to spell\n- Review questions and a tap-to-hear kana chart\n\n{2309368679467391}\n\n# Your kitchen, anywhere\n\n- **Mixed reality:** the sushi bar appears in your room\n- **VR:** dreamlike worlds from Fujisan to Kyoto\n- **No controllers:** just your hands\n\n{1515889690585401}\n\n# Meet your regulars\n\nA samurai, a penguin conductor, a kabuki fox, a sumo wrestler, a geisha and a ninja, each with their own voice and very visible patience.\n\n{1831552254504475}\n\n# Free to try\n\nNew players: the tutorial and Level 1 are free. Unlock Levels 2\u20136 with one purchase. No subscription, no ads.\n\n**Your first customer just sat down. Ready to serve?**\n\n{3412214348965242}", "short_description": "\ud83c\udf63 Multiverse Kaitenzushi is fully launched. Play now! The belt is spinning, the customers are hungry, and every order is a word in Japanese. Grab the right kana, spell the dish, and serve it before patience runs out, in your own room or in dreamlike VR worlds.\n\nEarly Access owners: the full game is already yours, so there's no need to buy again. Levels locked? Tap Restore purchases or email contactkoremeta@gmail.com."}]}, "developer_name": "Kore Meta", "developer_privacy_policy_url": "https://drive.google.com/file/d/1Y0JfBUFAYAd_h9PW0EZybEjj_HIEb0Py/view?usp=drive_link", "developer_terms_of_service_url": null, "publisher_name": "Kore Meta", "support_website_url": "https://discord.gg/aeCXDcmwE", "website_url": "https://koremeta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area
uscdn.com&_nc_ss=7f30f&oh=00_AQX_ny6k8WpYQVSdFNEAxFwHDmKqdeUV52OVHJqLZOtRYQ&oe=6B1065E3"}, {"file_name": "screenshot_1_hands_place_kana.png", "id": "1889361465367594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308026_1889361468700927_169924330418548703_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYKGv72tTecQ7kNvwELwr9E&_nc_oc=AdqAahsYCIBR9pmvM7KHEJ1Qo4bbN1VRHa3D7dxP_LNYRECY0AZbdOl4jUKD0Rea2UI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWqfoj5P-49WjS3sQmP7eVwZ5PVcfyvZibL6LKYzNQlRw&oe=6B106702"}, {"file_name": "screenshot_4_kana_flashcards.png", "id": "2688326888231954", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831964_2688326891565287_3083453217977673320_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51TlSr6QXSAQ7kNvwEK-76V&_nc_oc=AdoWSuKbEOOxMB_fLPsAHbsVbh3b4HovbuMLTofQHLRfG9Sz5mM22dMENiPgwczioxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVKBvLybYeNUCdsbm6dJZJDYH37Wo8Guurcb9x6AHA-fg&oe=6B1042AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440_FullLaunch_110526.png", "id": "1129266992907163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628016_1129266996240496_2831192394328263090_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSbV94cURRUQ7kNvwGKVm01&_nc_oc=AdoNgw1Vh4VdEBWyPohOFQ2ziSDVpAfzwhSnNWOiTOeXg_9Dv7bmNv2B9gnhcCKwy4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPESazdFHqnWUXgqklfcoouzez8VrUJwmQpxBkwFLp4w&oe=6B106528"}, "display_name": "Multiverse Kaitenzushi: Learn Japanese with Sushi", "keywords": ["education", "cooking", "restaurant", "hiragana", "language"], "long_description": "# \ud83c\udf63 Multiverse Kaitenzushi is fully launched. Play now!\n\n**Early Access players: thank you!** The full game is already yours!\nIf Levels are locked, press **Restore purchases** or email **contactkoremeta@gmail.com** with your Meta Horizon username. \n\n# Can you spell your way to a perfect service?\n\nEvery sushi order arrives in **Japanese**. Grab the right **hiragana** and **katakana** off the spinning belt, spell the dish with your own hands, and serve it before patience runs out!\n\n{1611595004025318}\n\n# What's new in the full release\n\n- **Beautiful VR worlds** blending Japanese culture and the multiverse, from Fujisan to Kyoto\n- **A beautiful original soundtrack:** 12 relaxing tracks\n- **A new conveyor belt every level:** curving, arching, dropping and tunneling around you\n- **Review questions** after every level\n\n# Learn Japanese without noticing\n\n- Every letter **speaks its sound** as you grab it\n- Every order is a real word to spell\n- A tap-to-hear kana chart to practice anytime\n\n{2309368679467391}\n\n# Your kitchen, anywhere\n\n- **Mixed reality:** the sushi bar appears in your room\n- **VR:** four dreamlike worlds\n- **No controllers:** just your hands\n\n{1515889690585401}\n\n# Meet your regulars\n\nA samurai, a penguin conductor, a kabuki fox, a sumo wrestler, a geisha and a ninja, each with their own voice and very visible patience.\n\n{1831552254504475}\n\n# What's included\n\n- 6 levels and a grand finale\n- Play the tutorial and Level 1, then unlock Levels 2\u20136 with one purchase. No subscription, no ads.\n\n**Your first customer is at the door. Ready to serve?**", "short_description": "\ud83c\udf63 Multiverse Kaitenzushi is fully launched. Play now! The belt is spinning, the customers are hungry, and every order is a word in Japanese. Grab the right kana, spell the dish and serve it before patience runs out, in your own room or in beautiful VR worlds inspired by Japanese culture and the multiverse.\n\nEarly Access owners: the full game is already yours, so there's no need to buy again. Levels locked? Tap Restore purchases or email contactkoremeta@gmail.com."}]}, "developer_name": "Kore Meta", "developer_privacy_policy_url": "https://drive.google.com/file/d/1Y0JfBUFAYAd_h9PW0EZybEjj_HIEb0Py/view?usp=drive_link", "developer_terms_of_service_url": null, "publisher_name": "Kore Meta", "support_website_url": "https://discord.gg/aeCXDcmwE", "website_url": "https://koremeta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28861888053506478"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312306_2078909792770838_8052537937209544807_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IRopwjNEtcQ7kNvwF_kI8_&_nc_oc=Adpv6QWcTC-fWS8I3wxVhXdmsAli2tO5nBpQ0dmVSP4I3AgpvLhavn3VZY7kRRn7aNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUMfnMzMTENLVobUX_Sw38pnlsEwYS75WUeqtyUvVTIXA&oe=6B104B0A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Multiverse Kaitenzushi: Learn Japanese with Sushi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1766080800, "lastRevision": {"nodes": [{"id": "7270331466422115", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_
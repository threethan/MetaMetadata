8K4ycGRC7yYI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzGHcik6744dX10TzDLjgzDoKWiL6uTMWzw58iyJIalg&oe=69C534FC"}, {"file_name": "Clip5.png", "id": "1274341271379151", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298291_1274341274712484_3931288755041598442_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhjbqO3HgsQQ7kNvwEvI2RJ&_nc_oc=Adr1XEN8VHW4kE3n3fRcXwtkT1JytlGAgzjvoFTXJvJaox-z-9FlAAFgWnqTG5M2aME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyynhNrFs3oGDhKsukvMQkKpwou-uqBRDOcODx8ZCLGgA&oe=69C547BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover image_ 2560 x1440.png", "id": "2074996509918155", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822723_2074996513251488_8847006516908403311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX6cpbpCHukQ7kNvwFJhRAs&_nc_oc=Adr28bb-XzfdHfSYd_NfOhsSWx__eldACp4i_O864D5Jqltj0ww2PlufgHgrHzm6_sM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfweSq_N7xHymYp8VQIFzqjZHpsVHfaHJATGZl9jkWTSig&oe=69C52A6E"}, "display_name": "Multiverse Kaitenzushi: Learn Japanese Alphabet", "keywords": ["Cooking", "language", "education", "MR", "food"], "long_description": "# BECOME A SUSHI CHEF IN MULTIVERSE! \n\nStep into the deliciously chaotic world of Multiverse Kaitenzushi, a mixed reality experience where you become a sushi chef with a linguistic twist! In this unique language-learning adventure, you\u2019ll grab Japanese letters, assemble them into sushi orders, and serve multiverse-spanning customers!\n\n{2735090710015518}\n\nEach customer\u2019s order is a fun puzzle made of hiragana and katakana characters. Practice pronunciation, letter recognition, and memory as you race against time to serve the right sushi. \n\nWhether you're just starting your Japanese journey or want a fresh, exciting way to review, Multiverse Kaitenzushi makes learning unforgettable. Play, move, speak, and interact\u2014because in this multiverse, language is the secret ingredient.\n\nGrab the letters. Assemble the sushi. Serve the multiverse.\n\nAre you ready to become the ultimate multiverse sushi master?\n\n{679450421809907}\n\n\n", "short_description": "Enter Multiverse Kaitenzushi, a mixed reality game where you become a Japanese sushi chef! Grab, assemble, and serve sushi using hiragana and katakana to satisfy quirky customers from across the multiverse. Learn the Japanese alphabet through fast-paced, immersive fun!"}]}, "developer_name": "Kore Meta", "developer_privacy_policy_url": "https://drive.google.com/file/d/19akoI3-h-GLNrAP4jDb-aZxdk-VIuVNU/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kore Meta", "support_website_url": null, "website_url": "https://koremeta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24919325984429391"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823485_773080345394844_2137955796036685453_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9DEBGOwrvsQ7kNvwEgKFZT&_nc_oc=AdpW8JHrspRDzG1BUYA467GajndjgfDV2FIMnL8iHQUXg2ApGsJmLzJS_8PZipEsF4Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjKIlJ01ixAEzKBRp__y2yKh-BL480qOa_kbWnngOvvA&oe=69C51CFD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
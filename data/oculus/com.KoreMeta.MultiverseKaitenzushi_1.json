g?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9zZSQC72zgQ7kNvwEDNRLI&_nc_oc=AdrO0GGyyvHsZVZjuaPdm-1It-4JecglUjbYYUH_SX9C91bMUK90BRWy5XCQo_34vRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH6u8KuKWFsTUH_B14usjdUVrE0vlZOy6g4R-LSNQ8ew&oe=6AB7DF3F"}, {"file_name": "ScreenShot12.png", "id": "847199001201221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_847199004534554_816026349087404796_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z7ADUw4s4MQ7kNvwEWyXBV&_nc_oc=Ado_qC3X_D0hghht1jOXHYQZVyCA93ptxjrKGIJsXoseFSPPgE2zbiBIkg4IIClV9C0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1B_9tZ1nTFDXDumeUr2I0lFsns-u0Go0UIoz8_bDjyQ&oe=6AB7E822"}, {"file_name": "ScreenShot17.png", "id": "1533007627834628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_1533007631167961_4014209700938063474_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wxusL1wshgQ7kNvwGSsClO&_nc_oc=AdoKwNyfNBdTFxbxmUpW__kIorkedhovbB0CGCAfZN_NJAUMxHVsMYNc9XM31-YE9K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxZFhJej1m7sDrlVZ2yPaQR7nkFsJHUFfIKeFt1eo7UA&oe=6AB7DC6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover image_ 2560 x1440.png", "id": "2074996509918155", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_2074996513251488_8847006516908403311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7WN8GwI6TEQ7kNvwFivUYg&_nc_oc=AdqeS7rR4c99PIu0KYseh_gA7Ys4ZdpsGZseR2e6YzLzPRWCZSn12udnoLOs95oz_go&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqltc_VRyVWctVgpG2J1C5s0tyxm06YOvwRi22zDzVYA&oe=6AB7BE6E"}, "display_name": "Multiverse Kaitenzushi: Learn Japanese Alphabet", "keywords": ["Cooking", "language", "education", "MR", "food"], "long_description": "# BECOME A SUSHI CHEF IN MULTIVERSE! \n\nStep into the deliciously chaotic world of Multiverse Kaitenzushi, a mixed reality experience where you become a sushi chef with a linguistic twist! In this unique language-learning adventure, you\u2019ll grab Japanese letters, assemble them into sushi orders, and serve multiverse-spanning customers!\n\n{2735090710015518}\n\nEach customer\u2019s order is a fun puzzle made of hiragana and katakana characters. Practice pronunciation, letter recognition, and memory as you race against time to serve the right sushi. \n\nWhether you're just starting your Japanese journey or want a fresh, exciting way to review, Multiverse Kaitenzushi makes learning unforgettable. Play, move, speak, and interact\u2014because in this multiverse, language is the secret ingredient.\n\nGrab the letters. Assemble the sushi. Serve the multiverse.\n\nAre you ready to become the ultimate multiverse sushi master?\n\n{679450421809907}\n\n\n", "short_description": "Enter Multiverse Kaitenzushi, a mixed reality game where you become a Japanese sushi chef! Grab, assemble, and serve sushi using hiragana and katakana to satisfy quirky customers from across the multiverse. Learn the Japanese alphabet through fast-paced, immersive fun!"}]}, "developer_name": "Kore Meta", "developer_privacy_policy_url": "https://drive.google.com/file/d/19akoI3-h-GLNrAP4jDb-aZxdk-VIuVNU/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kore Meta", "support_website_url": null, "website_url": "https://koremeta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mod
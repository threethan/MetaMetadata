OaI_JSlfNWfRTpZUFwUrXZAaCUPUQ&oe=69C3CE52"}, {"file_name": "ScreenShot16.png", "id": "24927739833514721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620940_24927739840181387_3904957670299010717_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FdB7_60h6wQ7kNvwEPiFKn&_nc_oc=AdoNqTujJWdHNnM3NxSjcadCKOLxTHFl8D2_jPFmexvIGo7X5MEF1CYdRB1ZzzZDmj8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWObJZ3MCmAMPfsOGCTxM07xagMVcolDGshPlxdmvNXw&oe=69C3C17F"}, {"file_name": "ScreenShot12.png", "id": "847199001201221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619450_847199004534554_816026349087404796_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUmmPgp6n9IQ7kNvwHJsPRE&_nc_oc=AdpzOuLgCBqn54JrUIxK-nUPtB6E5rLpkcLkW8Xcma7PY6SPekjy9pMESVqEOintQA4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMFXHzTFHs92O65rPwEvxrcXVFM-b7p-lnSHnxsBJsTg&oe=69C3CA62"}, {"file_name": "ScreenShot17.png", "id": "1533007627834628", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619450_1533007631167961_4014209700938063474_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6WWPalIqq8Q7kNvwH9WOv7&_nc_oc=AdrhZN-gWQtoGpDNvQgScKCjLETmCIXdXIjL6ViSwBnfLNmLg7Pa2MyO4BenCZsW-rI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afze4ydps-5sgTbpXAncI0lX40sxcUVi46kq-l2YjXsVOQ&oe=69C3BEAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover image_ 2560 x1440.png", "id": "2074996509918155", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822723_2074996513251488_8847006516908403311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrgWSkcHQEAQ7kNvwE56_nZ&_nc_oc=AdoCdbJ4aUiInqZ4UETFndNHif7xK6mG0UeGV_zMSdz47PabVWi-2dhi7ITqgz844-I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwln7EXPOJEsHuNrgQTb88OSRYt8d_9YOAmtPQ0NWLkwA&oe=69C3D8EE"}, "display_name": "Multiverse Kaitenzushi: Learn Japanese Alphabet", "keywords": ["Cooking", "language", "education", "MR", "food"], "long_description": "# BECOME A SUSHI CHEF IN MULTIVERSE! \n\nStep into the deliciously chaotic world of Multiverse Kaitenzushi, a mixed reality experience where you become a sushi chef with a linguistic twist! In this unique language-learning adventure, you\u2019ll grab Japanese letters, assemble them into sushi orders, and serve multiverse-spanning customers!\n\n{2735090710015518}\n\nEach customer\u2019s order is a fun puzzle made of hiragana and katakana characters. Practice pronunciation, letter recognition, and memory as you race against time to serve the right sushi. \n\nWhether you're just starting your Japanese journey or want a fresh, exciting way to review, Multiverse Kaitenzushi makes learning unforgettable. Play, move, speak, and interact\u2014because in this multiverse, language is the secret ingredient.\n\nGrab the letters. Assemble the sushi. Serve the multiverse.\n\nAre you ready to become the ultimate multiverse sushi master?\n\n{679450421809907}\n\n\n", "short_description": "Enter Multiverse Kaitenzushi, a mixed reality game where you become a Japanese sushi chef! Grab, assemble, and serve sushi using hiragana and katakana to satisfy quirky customers from across the multiverse. Learn the Japanese alphabet through fast-paced, immersive fun!"}]}, "developer_name": "Kore Meta", "developer_privacy_policy_url": "https://drive.google.com/file/d/19akoI3-h-GLNrAP4jDb-aZxdk-VIuVNU/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kore Meta", "support_website_url": null, "website_url": "https://koremeta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
KsoIw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2tzfu8WkbP6Ssj-6otQ-IrIzfF8OuFYY_sy3EHHMgAg&oe=6AE3376E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "4710404545862419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312263_4710404549195752_1283424835337372283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oS4pkQMmRSoQ7kNvwEi1jTK&_nc_oc=AdrfZV0Ijn8J8If4v06UpdfjGCcAUWSetsQWI2olTPxANKXFx5WVRLeYzUbx1L_kykU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM4cdjSr98Immvm2zc9qWy9PkCevyLWpMFMzHs395JUg&oe=6AE3634C"}, "display_name": "Multiverse Kaitenzushi: Learn Japanese with Sushi", "keywords": ["Japanese", "sushi", "language", "education", "cooking"], "long_description": "# \ud83c\udf63 Early Access is open. Full launch coming soon!\n **Get in early and start serving today.**\n\n# Your Japanese adventure starts behind the sushi counter\n\nStep into **Multiverse Kaitenzushi**, a VR and mixed reality cooking game where every sushi order is a chance to practice Japanese. Grab kana from the conveyor belt, spell each order, and serve quirky customers from across the multiverse.\n\n{1611595004025318}\n\n# Learn through play\n\n- Every order is a word to spell in **hiragana** or **katakana**\n- Hear each character as you grab it\n- Review questions and a tap-to-hear kana chart after each level\n\n{2309368679467391}\n\n# Become the sushi chef\n\n- Reach, grab and place with your own hands, no controllers needed\n- Play in **mixed reality** right in your room\n- Or step into dreamlike **VR worlds** from Fujisan to Kyoto\n\n{1515889690585401}\n\n# Serve a multiverse of personalities\n\nA samurai, a train-conductor penguin, a kabuki fox, a sumo wrestler, a geisha and a ninja are all hungry. Keep them waiting too long and you'll see it on their faces!\n\n{1831552254504475}\n\n# Get in before opening day\n\nEarly players shape the full launch. Take your place behind the counter and start practicing your kana now.\n\n**Your first customers are hungry. Ready to serve?**\n\n{3412214348965242}", "short_description": "Hungry to learn Japanese? Become a sushi chef in VR and mixed reality! Grab the right hiragana and katakana off the conveyor belt, spell each order, and serve sushi to quirky customers from across the multiverse. Turn your first steps in Japanese into a fast-paced cooking adventure.  One order at a time! ;)"}]}, "developer_name": "Kore Meta", "developer_privacy_policy_url": "https://drive.google.com/file/d/1Y0JfBUFAYAd_h9PW0EZybEjj_HIEb0Py/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kore Meta", "support_website_url": "https://discord.gg/aeCXDcmwE", "website_url": "https://koremeta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28356036440758311"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312306_2078909792770838_8052537937209544807_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWcOIhUDJXAQ7kNvwFBl6Uj&_nc_oc=AdoslzTeR_tNz8RLCwKFYg_n3-IqPs505ikFMNsL-2gdsi60_TebybiFicQH6pgAPoQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGcW4f8Hun54gZ28aPgaaoYfwMHdl1eUQGFPdnAt9Qpg&oe=6AE33FCA"}, "is_concept": false, "is_test": false, "is_trial_offer
ideo_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover image_ 2560 x1440.png", "id": "2074996509918155", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822723_2074996513251488_8847006516908403311_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVw2_dYKIbQQ7kNvwF_0jVc&_nc_oc=Adrt4Nl17Foi04yxDvsDmFo8GL_ySTgVOWs3dBvP8iN6ScoxEaHehjamevLZ7zyajWg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI2R9X8G1-l3-LWH2dzudul6QBRmVLlfFqmYMjwrZyxw&oe=6AFB332E"}, "display_name": "Multiverse Kaitenzushi: Learn Japanese Alphabet", "keywords": ["Cooking", "language", "education", "MR", "food"], "long_description": "# BECOME A SUSHI CHEF IN MULTIVERSE! \n\nStep into the deliciously chaotic world of Multiverse Kaitenzushi, a mixed reality experience where you become a sushi chef with a linguistic twist! In this unique language-learning adventure, you\u2019ll grab Japanese letters, assemble them into sushi orders, and serve multiverse-spanning customers!\n\n{2735090710015518}\n\nEach customer\u2019s order is a fun puzzle made of hiragana and katakana characters. Practice pronunciation, letter recognition, and memory as you race against time to serve the right sushi. \n\nWhether you're just starting your Japanese journey or want a fresh, exciting way to review, Multiverse Kaitenzushi makes learning unforgettable. Play, move, speak, and interact\u2014because in this multiverse, language is the secret ingredient.\n\nGrab the letters. Assemble the sushi. Serve the multiverse.\n\nAre you ready to become the ultimate multiverse sushi master?\n\n{679450421809907}\n\n\n", "short_description": "Enter Multiverse Kaitenzushi, a mixed reality game where you become a Japanese sushi chef! Grab, assemble, and serve sushi using hiragana and katakana to satisfy quirky customers from across the multiverse. Learn the Japanese alphabet through fast-paced, immersive fun!"}]}, "developer_name": "Kore Meta", "developer_privacy_policy_url": "https://drive.google.com/file/d/19akoI3-h-GLNrAP4jDb-aZxdk-VIuVNU/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kore Meta", "support_website_url": null, "website_url": "https://koremeta.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24656608744034451"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1090249103880363"}, {"status": "PUBLISHED", "id": "1580173106645599"}, {"status": "PENDING", "id": "1205822034646571"}]}, "baseline_offer": {"id": "1580173106645599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795100400, "status": "PUBLISHED", "id": "1090249103880363"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24889744004054256", "version": "0.9.0"}, "id": "970808010866184", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7270331439755451", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24889744004054256"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "970808010866184"}]}, "change_log": "Fixed in build 20 (version code 20). Master volume, music volume, music on/off, selected track, MR/VR mix, environment and table height are now saved as they change and restored at launch. Tested on Quest 3S by changing the settings, quitting and relaunching; the settings were kept.", "created_date": 1793671856, "id": "28616195098075776", "version": "1.0.0", "version_code": 20, "release_status": "SCHEDULED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7270331439755451", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24889744004054256"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "970808010866184"}]}, "change_log": "Multiverse Kaitenzushi \u2013 Full Launch (v1.0.0)\n\nLevel 1 is now free to play! Unlock the full game with a one-time purchase.\nPromo codes: redeem codes from our events and social media.\nSmoother performance: fixed stutters at level start and when grabbing letters.\nFriendlier customers: happy customers now wave goodbye as they leave.\nGeneral polish and bug fixes.\n\nThank you to all our Early Access supporters for helping us get here! \nFor any issues, please email : contactkoremeta@gmail.com", "created_date": 1793307795, "id": "28558785147150105", "version": "1.0.0", "version_code": 19, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7270331439755451", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBi
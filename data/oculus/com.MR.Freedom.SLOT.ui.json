o enable Auto-Play (tap \u200cStop\u200c to end).\n\u200cPayout Formula\u200c:\nWild symbols: Bet Level \u00d7 Payout Rate (5 bet levels; min. bet = 500 credits).\n\u200cJackpot Note\u200c:\nIf multiple players trigger the Jackpot simultaneously, \u200conly the first player wins\u200c; others may receive 0.", "short_description": "Click the \u200cSpin\u200c button to start. Matching symbol combinations along active paylines earn rewards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pic.scienjoy.com/mobile/privacyPolicyMR-Golden-20250730.html", "developer_terms_of_service_url": null, "publisher_name": "meta", "support_website_url": null, "website_url": "https://www.goodameta.com/bluffPoker_en/#/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23964499793233140"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1626049521872207"}, {"status": "PUBLISHED", "id": "1311892790620570"}, {"status": "PUBLISHED", "id": "1705443496801224"}, {"status": "PUBLISHED", "id": "1071104755213751"}]}, "baseline_offer": {"id": "1071104755213751"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1626049521872207"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24101179759565142", "version": "1.0.
ss=7f20f&oh=00_AQPQOfXkCct8joH8SkJ8EEZPhsQ4GoOngvIF8x2-gygAwQ&oe=6AE612B2"}, {"file_name": "Tentacular 5.png", "id": "290149593247721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207238_290149599914387_4292785376516298710_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgYmqvGozhoQ7kNvwF6iC_X&_nc_oc=AdpwE1ug6NrIDfWtXM0Ux6TP8KygJc8vhjrcgu9Z-7-ADwHJt6ZV2_NzbltYXoZ1_jo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm6qpA1xgHu4f5TbES0AYWvniODtdU5lT_61qNKGd34Q&oe=6AE61029"}, {"file_name": "Tentacular 1.png", "id": "757174648594798", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572957_757174651928131_7414525875582666581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8wUz6KjV5MQ7kNvwEhkc6L&_nc_oc=AdrVh44XVH9-4qf9e_1GaFGb7aX9afHjaGFKcFpaspRtpDt20O29eDkNxUaJ-5ROBFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqtYefptWjoIFoGXCw4jAsOBJ7I_uRxwDmjWXG5rhsVg&oe=6AE5F009"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "392491582252880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334060_392491585586213_7902340650376875221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwhPdrETTMoQ7kNvwG1e5Bn&_nc_oc=AdrkjVODQ9dHifx2wcET7JAluNVNN8UqiZSw_Hr2ykluW9R8Sj8V89wIbtBsTcIbF98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb2Xl0dLPNHc6HlD5-ZCOwOqTYvBLKce1JyYQDvqXj_g&oe=6AE5EAFF"}, "display_name": "Tentacular", "keywords": ["Octopus", "Monster", "Puzzle", "Tentacle", "Construction"], "long_description": "Ever felt like a squid out of water? Tentacular plunges you into the ocean-dwelling hulk of a gigantic, kind-hearted tentacled beast trying to figure out its place in the world.\n\nRaised among humans on the bustling and eccentric island of La Kalma, the time has finally come to unravel the secrets of your mysterious origin while working as the world\u2019s strongest handyman. Help your human friends to research a strange and an incredibly powerful energy source through a colossal collection of action-based activities and constructions puzzles, using your titanic tentacles to aid your quest for answers and unlock elements for your playground.\n\nGet your suckers ready!\n\nTactile Tentacles!\nGet a grip on things with fully physics-based tentacles complete with Octo-grade suckers\n\nTitanic Tasks!\nApply lateral thinking and giant limbs to 50+ puzzle and action levels, building huge structures and contraptions\n\nColossal Constructions!\nCultivate your creative side in a constantly expanding Sandbox", "short_description": "Tentacular is a VR game about a gigantic but good-hearted tentacled beast trying to figure out its place in the world."}]}, "developer_name": "Firepunchd Games", "developer_privacy_policy_url": "https://legal.devolverdigital.com/privacy", "developer_terms_of_service_url": "https://legal.devolverdigital.com/terms", "publisher_name": "Devolver Digital", "support_website_url": "https://www.devolverdigital.com/", "website_url": "http://tentacular.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "458592492406387"}}]}, "scheduled_offers": {"count": 38, "nodes": [{"status": "PUBLISHED", "id": "1862700508147696"}, {"status": "PUBLISHED", "id": "844988438619084"}, {"status": "PUBLISHED", "id": "120314
m/v/t64.5771-25/86610704_1087659161966586_9204004686126630774_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iA3_X7TQzcQ7kNvwFcTOh1&_nc_oc=AdpVALvB13RBlDzqawOFwgPfDZpj0o7GZfchC3ILyBEwFQuuyjDzcJv6z9-ZnR_PiY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE9879VTd2uFAGU5Y5VKtkMijC3u2q14RI47imRNp7xw&oe=6B09AB32"}, {"file_name": "Tentacular 5.png", "id": "290149593247721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207238_290149599914387_4292785376516298710_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS69txBieToQ7kNvwEZjKNK&_nc_oc=AdpfPXJi7h_rgU42ZBG0_n97pBMj4ofgMuWmH_V-LvfUncQyUc3XOfmb9zwz3AkcroE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuxYXfXrFNwzPYjxPP24WTCvOQ_JmatR6PAOWbim0-ng&oe=6B09A8A9"}, {"file_name": "Tentacular 1.png", "id": "757174648594798", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57572957_757174651928131_7414525875582666581_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpACNN6h2AIQ7kNvwHldRzR&_nc_oc=Ado-Uk7N9CwfZuDSYPTZkGYyD-eYGJ_lPjFghmgGSUO_GFrVQAngTmPmQ1qi9_wiIlM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpa3epwF1wolgAUx9X2LlLcxlAtYvuFm4K2TwI08xxfw&oe=6B09C0C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "392491582252880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75334060_392491585586213_7902340650376875221_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNWwYOvScP0Q7kNvwEWF2z-&_nc_oc=AdoXNcFjgcAkzCJvhL4RU-yRobPSdqhmVJgEp8RvDMDt89GV6zKtUVJERji2zMR2rkA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOeJjQ_tDOhvX_3me74ysM_ucE0hnUHzviEiHS6VZSOQ&oe=6B09BBBF"}, "display_name": "Tentacular", "keywords": ["Octopus", "Monster", "Puzzle", "Tentacle", "Construction"], "long_description": "Ever felt like a squid out of water? Tentacular plunges you into the ocean-dwelling hulk of a gigantic, kind-hearted tentacled beast trying to figure out its place in the world.\n\nRaised among humans on the bustling and eccentric island of La Kalma, the time has finally come to unravel the secrets of your mysterious origin while working as the world\u2019s strongest handyman. Help your human friends to research a strange and an incredibly powerful energy source through a colossal collection of action-based activities and constructions puzzles, using your titanic tentacles to aid your quest for answers and unlock elements for your playground.\n\nGet your suckers ready!\n\nTactile Tentacles!\nGet a grip on things with fully physics-based tentacles complete with Octo-grade suckers\n\nTitanic Tasks!\nApply lateral thinking and giant limbs to 50+ puzzle and action levels, building huge structures and contraptions\n\nColossal Constructions!\nCultivate your creative side in a constantly expanding Sandbox", "short_description": "Tentacular is a VR game about a gigantic but good-hearted tentacled beast trying to figure out its place in the world."}]}, "developer_name": "Firepunchd Games", "developer_privacy_policy_url": "https://legal.devolverdigital.com/privacy", "developer_terms_of_service_url": "https://legal.devolverdigital.com/terms", "publisher_name": "Devolver Digital", "support_website_url": "https://www.devolverdigital.com/", "website_url": "http://tentacular.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCU
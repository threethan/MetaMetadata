ss=7f20f&oh=00_AQT-vM9t58NKGE70IWfl6HdA8Xs-Yx7RAbq-jWRUPeB-ZA&oe=6AF887B2"}, {"file_name": "Tentacular 5.png", "id": "290149593247721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207238_290149599914387_4292785376516298710_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkEGRrI0Uw4Q7kNvwG7PHlY&_nc_oc=AdquL5pVySfvkCM6eiCOXvL4noxhPbH889eUTYMz_R7QSF9Br3VuF7s_kNTlo8kN7Vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMeRy9-EXcZmIi0Ru-fqBWWh6oYCQpRHA-zJ92rwSiPw&oe=6AF88529"}, {"file_name": "Tentacular 1.png", "id": "757174648594798", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_757174651928131_7414525875582666581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiehlaRCPtQQ7kNvwHFaox6&_nc_oc=AdocH940k5lpi_R3GvSNBWoAFWxYgkcd-LLdW4jYwIq-UIypNq_UZx8X7wzIViCdfpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSay5VZVTVzavUe28nPVMrWPv77eWr16nzzaN3MAPSKHA&oe=6AF89D49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "392491582252880", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334060_392491585586213_7902340650376875221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=runMp3t-oikQ7kNvwGAwvI4&_nc_oc=Adou1j0v0qNIRGn8Yh2XWb5urgzxEvKM1BbJsVrkz_WgPS70RYUZefdgk2D8IU7lBTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_n2JWVjQ2Czb1VMydVthcahNJSrWXCyVPDTzMeM7Xdw&oe=6AF8983F"}, "display_name": "Tentacular", "keywords": ["Octopus", "Monster", "Puzzle", "Tentacle", "Construction"], "long_description": "Ever felt like a squid out of water? Tentacular plunges you into the ocean-dwelling hulk of a gigantic, kind-hearted tentacled beast trying to figure out its place in the world.\n\nRaised among humans on the bustling and eccentric island of La Kalma, the time has finally come to unravel the secrets of your mysterious origin while working as the world\u2019s strongest handyman. Help your human friends to research a strange and an incredibly powerful energy source through a colossal collection of action-based activities and constructions puzzles, using your titanic tentacles to aid your quest for answers and unlock elements for your playground.\n\nGet your suckers ready!\n\nTactile Tentacles!\nGet a grip on things with fully physics-based tentacles complete with Octo-grade suckers\n\nTitanic Tasks!\nApply lateral thinking and giant limbs to 50+ puzzle and action levels, building huge structures and contraptions\n\nColossal Constructions!\nCultivate your creative side in a constantly expanding Sandbox", "short_description": "Tentacular is a VR game about a gigantic but good-hearted tentacled beast trying to figure out its place in the world."}]}, "developer_name": "Firepunchd Games", "developer_privacy_policy_url": "https://legal.devolverdigital.com/privacy", "developer_terms_of_service_url": "https://legal.devolverdigital.com/terms", "publisher_name": "Devolver Digital", "support_website_url": "https://www.devolverdigital.com/", "website_url": "http://tentacular.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "458592492406387"}}]}, "scheduled_offers": {"count": 38, "nodes": [{"status": "PUBLISHED", "id": "1862700508147696"}, {"status": "PUBLISHED", "id": "844988438619084"}, {"status": "PUBLISHED", "id": "120314
m/v/t64.5771-25/86610704_1087659161966586_9204004686126630774_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri8Nxi5oeboQ7kNvwHasnwu&_nc_oc=AdryYGiz3IHAqNPnK2-2hTGaKfiO_wz9YCj2Rtic2kQ0-o5JZ5Lx-qjMqWiH9HXBD0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV-mvwzQurkgfDMN8p9M41aIz0UXrn2M1Di9UiOwEeBNA&oe=6B0EF132"}, {"file_name": "Tentacular 5.png", "id": "290149593247721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207238_290149599914387_4292785376516298710_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH4tyjMNpjIQ7kNvwF7F-Eo&_nc_oc=AdoXeKXvZdS4F0NYxB7PuNVkyR3xYYUb1qCiN2LHWz5kToYdyydrzzRMXes0V9Y5Oh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzAW-lwzOcF0-JiJ2R04Gv3mk4kZbw2CRTGhd0TnrQeQ&oe=6B0EEEA9"}, {"file_name": "Tentacular 1.png", "id": "757174648594798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_757174651928131_7414525875582666581_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwc0NTXQt4QQ7kNvwHEuqMD&_nc_oc=Adq_agGwWsWx7O1HtowocJgq2N4gnmBKTg6WAGwWzb-tW2TzXMkhPzXNJAx10JWih4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9M94mUp51WaG4jfb8LAtz1YtFY2zV4w50PxZkcJqhiQ&oe=6B0F06C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "392491582252880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334060_392491585586213_7902340650376875221_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzI1TT8Z0QYQ7kNvwFjgIBO&_nc_oc=Adpi9Bb-1aj-tEBQdh47Dgx3XFPIJ5cWwzbMRwwx1XCeU2Yhtm_oPyu2sWYy-yyBK3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVM3-osYAL0HIWk0IdhpYepBKlowsOWvMlIni6o64Ukdg&oe=6B0F01BF"}, "display_name": "Tentacular", "keywords": ["Octopus", "Monster", "Puzzle", "Tentacle", "Construction"], "long_description": "Ever felt like a squid out of water? Tentacular plunges you into the ocean-dwelling hulk of a gigantic, kind-hearted tentacled beast trying to figure out its place in the world.\n\nRaised among humans on the bustling and eccentric island of La Kalma, the time has finally come to unravel the secrets of your mysterious origin while working as the world\u2019s strongest handyman. Help your human friends to research a strange and an incredibly powerful energy source through a colossal collection of action-based activities and constructions puzzles, using your titanic tentacles to aid your quest for answers and unlock elements for your playground.\n\nGet your suckers ready!\n\nTactile Tentacles!\nGet a grip on things with fully physics-based tentacles complete with Octo-grade suckers\n\nTitanic Tasks!\nApply lateral thinking and giant limbs to 50+ puzzle and action levels, building huge structures and contraptions\n\nColossal Constructions!\nCultivate your creative side in a constantly expanding Sandbox", "short_description": "Tentacular is a VR game about a gigantic but good-hearted tentacled beast trying to figure out its place in the world."}]}, "developer_name": "Firepunchd Games", "developer_privacy_policy_url": "https://legal.devolverdigital.com/privacy", "developer_terms_of_service_url": "https://legal.devolverdigital.com/terms", "publisher_name": "Devolver Digital", "support_website_url": "https://www.devolverdigital.com/", "website_url": "http://tentacular.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCU
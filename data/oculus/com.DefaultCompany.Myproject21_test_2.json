jLasEwvomCWamDe_9KDe0Yxnx2k_jI_k4C9gayhp27-s4fnVJetOQtD2Go4ulXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwMLOUkGhhIRBZXVY-ird8r0xT7DbYkbDi0zKtFlD59g&oe=69B2A3D8"}, {"file_name": "plumbago_ss_05.png", "id": "1622315182134343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618284_1622315185467676_7656608008855535505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1tJDLfLNYMQ7kNvwHGugmx&_nc_oc=AdmW52rDass6R76AvFUNWwUgYbVhA6020BD2hT85qSF8qOIK6XTcUVWIoLNNHrEaoX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbUH6SQo9O64NpeSx6zIUHQg3mlG89bZ0t55Q1OWGeqg&oe=69B2A178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "plumbago_cover_2560x1440.png", "id": "887422144162244", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_887422147495577_5604553459353551497_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey18EX217B8Q7kNvwFg6mun&_nc_oc=AdlKZjueYSIh24M_UIxgeQ_QKwzmxRJbpXK18XlGC80LO8XEbFWW3S3nLQ9_FIvT1uI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6pZR2EtJPJGXH92-GZNFo7SpK-CX_l4y2sxL01B82RQ&oe=69B2ACFF"}, "display_name": "PLUMBAGO - Prototype", "keywords": [], "long_description": "PLUMBAGO \u2013 Prototype extends a body of sculptural work originally created from colored pencil cores.\n\nHistorically, pigment has been used to create images on flat surfaces. In this project, pigment-based forms are translated into three-dimensional objects and further transformed into digital 3D models, allowing them to exist as color and spatial information.\n\nThrough hand tracking, users interact directly with these forms. When touched, the objects activate 360-degree video and sound, creating a temporary transition between the surrounding physical environment and a virtual space.\n\nConceived as an installation component, this application is intended to be experienced alongside the original physical works.\n\nFor more information about related works:\nhttps://www.sketchpigments.com\n\nIf the experience does not appear centered when launched, please use the system recenter function to adjust your viewing position.", "short_description": "A VR installation based on sculptural forms originally created from colored pencil cores.\nThrough hand tracking, users touch 3D models placed in their physical space, triggering immersive video and sound that momentarily shifts perception between real and virtual environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sketchpigments.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tsukasa Kobayashi", "support_website_url": null, "website_url": "https://www.sketchpigments.com/works-detail_13.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24013240578373511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618102_25774268812244506_8677064297052971078_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WH2yqzMCkAQ7kNvwE_VPOZ&_nc_oc=AdmKvn58ai_VuhQDQ8a2avCWwv2-5S7FzRTnhUhbMaLh4a9R7KzvxY06qgZdpzEsI1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQV1Rx3ji6beGqIBHKo-A28FnDqjrcvzV8gdBVp5FQjw&oe=69B29BD8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PLUMBAGO - Prototype", "platfo
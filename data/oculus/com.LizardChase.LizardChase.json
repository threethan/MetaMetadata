4418600997_240031486956941961_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfPRfB05oYgQ7kNvwF7C1R9&_nc_oc=AdnqBO8c2nrmkD512eYmEn5rt4vesQYAR9c7zmQVAajuCi-TOHoI2WGe6xvdRWw_Qfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvURZ0dB8Io-qMrgposPnMW81Vo5AOxKXv3H2s3f79FRQ&oe=69A80D15"}, "display_name": "Lizard Chase ", "keywords": [], "long_description": "This game is a very sport game, it will keep you moving and also make you healthy, so download the game and get a glass of water and have LOADS of fun in this unique VR experience.\n\nWhats in this game?\nThere is many things to do some are listed in the short description! ", "short_description": "Reject humanity and become a LIZARD! Run, Play, talk with friends from all over the world.\nPick your own colours, names and cosmetics!\n\nThis is a unique locomotion so expect a few bugs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lizardchase/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/lizardchase/tos", "publisher_name": "Mazz VR", "support_website_url": null, "website_url": "https://sites.google.com/view/lizardchase/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "689179598845796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210893_103149
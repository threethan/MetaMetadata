luscdn.com&_nc_ss=7f20f&oh=00_AQS9qaH4xOaPamt3WywY-MpiTcT3gkMCJQjFIgpxkNPtBw&oe=6AFF2E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_53_VideoCover.png", "id": "1438005320092572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031464_1438005326759238_948919741924032107_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubgdn-tDpgUQ7kNvwGjHu0w&_nc_oc=AdoWVtkxaL4yk5zMYfBJSfnbmbuFqpe1Upca4m6z6aaIAGrbgBYNMStrClJzB9MCXWo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsZ4mI8lJMSxgJrvGZilYO5MYFsUIAu6Mg_ue47f-8ww&oe=6AFF0F94"}, "display_name": "PeekaSeeks Gem Mine: Search and Find in VR", "keywords": [], "long_description": "\"PeekaSeeks: Gem Mine\" is a thrilling VR game that takes you on an adventure through an old Western gem mine, using riddles to find hidden artifacts and treasures. Using your head to control a yellow dot, you'll explore immersive areas, solve clues, and collect artifacts to learn about their history and significance.\n\nThis game is an immersive experience that appeals to a wide range of users. It encourages problem-solving, critical thinking, and exploration, making it enjoyable for people of various backgrounds and interests.\n\nTo fully enjoy the experience, we recommend trying PeekaSeeks from a seated position, where you can fully immerse yourself in the adventure without worrying about standing or moving around.\n\nSo, jump into your trusty craft and explore the depths of the gem mine in search of hidden treasures. With stunning graphics and captivating gameplay, PeekaSeeks is a VR experience that you won't want to miss!\n", "short_description": "Jump in your trusty craft and explore an old, Western gem mine in search of artifacts and treasures galore. Use the dashboard to prompt new clues and riddles, then search the gem mine to find what you\u2019re looking for. But watch out! Trouble lies around some of these corners."}]}, "developer_name": null, "de
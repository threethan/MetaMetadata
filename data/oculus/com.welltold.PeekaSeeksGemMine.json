ail": {"file_name": "Screenshot_53_VideoCover.png", "id": "1438005320092572", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031464_1438005326759238_948919741924032107_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TkxMjrfcVAQ7kNvwH6v6kx&_nc_oc=AdrxaNeHU4ZuChtXeMG_VUNig2Md6ELR-OOZ7ZDJar3iSX99ZG5fQFmWvCjt85wHZ5w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQDVhwYZuHrkMg4hcGAzzizyZ8UL8_6icW8WPJeabHhQ&oe=6AFB1B14"}, "display_name": "PeekaSeeks Gem Mine: Search and Find in VR", "keywords": [], "long_description": "\"PeekaSeeks: Gem Mine\" is a thrilling VR game that takes you on an adventure through an old Western gem mine, using riddles to find hidden artifacts and treasures. Using your head to control a yellow dot, you'll explore immersive areas, solve clues, and collect artifacts to learn about their history and significance.\n\nThis game is an immersive experience that appeals to a wide range of users. It encourages problem-solving, critical thinking, and exploration, making it enjoyable for people of various backgrounds and interests.\n\nTo fully enjoy the experience, we recommend trying PeekaSeeks from a seated position, where you can fully immerse yourself in the adventure without worrying about standing or moving around.\n\nSo, jump into your trusty craft and explore the depths of the gem mine in search of hidden treasures. With stunning graphics and captivating gameplay, PeekaSeeks is a VR experience that you won't want to miss!\n", "short_description": "Jump in your trusty craft and explore an old, Western gem mine in search of artifacts and treasures galore. Use the dashboard to prompt new clues and riddles, then search the gem mine to find what you\u2019re looking for. But watch out! Trouble lies around some of these corners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.peekavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Peeka VR", "support_website_url": null, "website_url": "https://peekavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7782884421758666"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982518_346986234371687_4438703259825564381_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap4YI1Mg6LgQ7kNvwE1RvZC&_nc_oc=Adr1atJZGCT1YLvZiQaSaXzm1aksR4MrIBNQ94NtTmhIzgaxo0_N1NWEOCzDbh4cADA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHMEFO6uV2agAymWgDaNiZMqBwGZ-hzOuPyk-y61wgTQ&oe=6AFB434B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PeekaSeeks Gem Mine: Search and Find in VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1710445200, "lastRevision": {"nodes": [{"id": "7257012884345825", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7257012854345828", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "799024611954351"}, "iarc_email": 
Mcmm7dJ38ZyVcbyLNRSx5Y3LyBTpLk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFlA3t3uwM6eztXBfUrp_tpqJ3lsRetUi1n8NS10emGQ&oe=6A8D792F"}, {"file_name": "pic5.png", "id": "1265719325733670", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499625099_1265719329067003_7484851293391048340_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SL1nz9LYDQQ7kNvwEyJKCT&_nc_oc=AdpXSmfwPm_ffdBwGbL9Ogjr49RmvDa-9WPaRoFNpIoAI3GveqdB2hDqT2WITWuWo1w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhnWMNmfIFXTUUohZG2a9kfQ1UUjZlOR1_0F94UdDUrw&oe=6A8D6EDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoImg.png", "id": "2127657527993562", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619148_2127657531326895_1440954098047516002_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF4XZpnps5QQ7kNvwHISbv1&_nc_oc=Adr0oyH3jFbR_xBvQMHx38lstPrxEulx1tVPl2RmAIu_qqyEXElYi7Pt6gFWu6dpQFc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0iMcY0eqVoFFhBvnH-2wizE6uk4t0H8blKnvhDVQwCQ&oe=6A8D64C2"}, "display_name": "The Creator", "keywords": ["creative", "relaxing", "meditation", "building", "space"], "long_description": "The Creator is a meditative, relaxing journey through the wonders of the virtual world. You have unlimited power over creation which is limited only by your imagination and creativity.  Rules and boundaries don't apply to virtual reality and anything goes.\n\nRecreate memories onto a virtual world and take your personal journey of self exploration as each world you create comes to life you'll be able to interact with the creation.\n\nWhile you immerse yourself in this holistic and meditative world building game you'll find many libraries complete with different skies, ground and animals. Add fishes, animals, insects, flowers, plants, houses to your environment and watch them come to life.  A full suite of mechanical items challenges your creativity to make animate and add motion to objects in the world.\n\nBuild a utopian landscape complete with animals that walk around, fishes that swim in the ocean and fortresses that defy gravity.  Float around in space and other surreal environments while surrounded by calming music of your choice for a meditative and mesmerizing visual and audio experience.\n", "short_description": "The Creator is a meditative, relaxing journey through the wonders of the virtual world.  You have unlimited power over creation which is limited only by your imagination and creativity.  Rules and boundaries don't apply to virtual reality and anything goes.  Recreate memories onto a virtual world and take your personal journey of self exploration as each world you create comes to life you'll be able to interact with the creation.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thecreator.top/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Josef Tran", "support_website_url": null, "website_url": "https://www.thecreator.top/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34907135158930488"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622211_942275411506788_4753622574703053506_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUTRT
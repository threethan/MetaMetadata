y fun.\nBut Funny Monkeys doesn\u2019t stop at the basics. With a unique dashing mechanic, you can burst forward in short, high-speed bursts\u2014perfect for dodging tags, escaping tight corners, or pulling off slick mid-air maneuvers. It adds a layer of strategy and adrenaline to every chase.", "short_description": "Funny Monkeys is a Gorilla Tag fan game, with Tag, A community shop, interesting movement, etc."}]}, "developer_name": "Funny Monkeys", "developer_privacy_policy_url": "https://sites.google.com/view/funny-monkeys-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MaskedKitten", "support_website_url": null, "website_url": "https://sites.google.com/view/funny-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30277928528521510"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1799022824366120"}]}, "baseline_offer": {"id": "1799022824366120"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751560980, "status": "PUBLISHED", "id": "1799022824366120"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30548653554782338", "version": "0.21"}, "id": "647703216995680", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typena
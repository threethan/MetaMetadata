jor4s5xx_P1KpBI3i7-bByLBWhNKT6kFAUTedNFWdAimPbMXpCTDoSzKPAxCMI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9M0AdDBaMEHULxd6F6_aAoFQeG5KBSQQPSK_O5n8avg&oe=6A22E30A"}, {"file_name": "Untitled12_20250702144012.png", "id": "657074747349116", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308575_657074750682449_5191888676608945889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIdLPpAOtcMQ7kNvwFieh1J&_nc_oc=Adr0VaWp_uvzrMV55Qq-CPDP4lNKxrKWVujAQFHZ31r1iLV7Ib3j2M3pBb2SOqGMbLg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rE5-myJ466_TFQqiCMm_D83Pq-WKSEXuzGsj-dOIYWg&oe=6A22D384"}, {"file_name": "Untitled12_20250702144210.png", "id": "619455257840526", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499299928_619455261173859_7878960711366579172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGohs2PmNboQ7kNvwF-QPBm&_nc_oc=AdodnxhvfPx5CjJjEw1nZkWKja0pShLMlrS8-b4JKgTKL-shRbj66j82pvceeMb3S9I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LfaxZO_fwSoA-3vs41n4ODiEPhve2iA8O1vPTlVItRA&oe=6A22F38C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Funny Monkeys VR", "keywords": [], "long_description": "\ud83d\udc12 Funny Monkeys \u2013 A Fast-Paced Gorilla Tag Fan Game\nWelcome to Funny Monkeys, the ultimate VR playground where chaos, speed, and monkey business collide! Inspired by the iconic Gorilla Tag, this fan-made experience takes the core of physics-based locomotion and cranks it up with thrilling dashes, expansive maps, and a whole lot of fun.\n\ud83e\udd8d Movement That Feels Wild\nIn Funny Monkeys, you don\u2019t walk\u2014you launch, leap, and lunge. Using your arms to propel yourself through the environment, you\u2019ll master the art of gorilla-style movement. Whether you're climbing trees, bouncing off walls, or flinging yourself across gaps, every motion is powered by your own momentum and skill. It\u2019s fast, it\u2019s fluid, and it\u2019s hilariously fun.\nBut Funny Monkeys doesn\u2019t stop at the basics. With a unique dashing mechanic, you can burst forward in short, high-speed bursts\u2014perfect for dodging tags, escaping tight corners, or pulling off slick mid-air maneuvers. It adds a layer of strategy and adrenaline to every chase.", "short_description": "Funny Monkeys is a Gorilla Tag fan game, with Tag, A community shop, interesting movement, etc."}]}, "developer_name": "Funny Monkeys", "developer_privacy_policy_url": "https://sites.google.com/view/funny-monkeys-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MaskedKitten", "support_website_url": null, "website_url": "https://sites.google.com/view/funny-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30277928528521510"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1799022824366120"}]}, "baseline_offer": {"id": "1799022824366120"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751560980, "status": "PUBLISHED", "id": "1799022824366120"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35952235051090801", "version": "2.0"}, "id": "647703216995680", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__ty
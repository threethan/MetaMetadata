/499308578_2544182472601664_5823682747738088831_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BO7Vs-R_lzIQ7kNvwEfON_L&_nc_oc=AdrBFQ-9uT94tgchzR2F3u569WmY_xnuOs6LLq_DASNmYiPrOh6tE86Lt3o4W2bqcLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY--oBqUqzOUH7p138WZkq-U6kceSt7qiQb8c-4aHNUQ&oe=6AEDF8ED"}, {"file_name": "Untitled12_20250702143904.png", "id": "708736541902783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303471_708736545236116_7793874404234686870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH-X-3eKxp0Q7kNvwEJuOyS&_nc_oc=Adr_qUGXUGsQNEo7vMwh6d6IvFp9-uo363nOZy_Lql7AQX-6yFiuv-OH5GZ8IgC3j2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGm0Xf8fuS7uulIwgxJP3LLoAgm6FnJOg0T44ks5Qz0g&oe=6AEDEA0A"}, {"file_name": "Untitled12_20250702144012.png", "id": "657074747349116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308575_657074750682449_5191888676608945889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKB100vhgNgQ7kNvwHoL_CU&_nc_oc=AdphW-8lxx6Ram0zZhgsM60Eu_lO1xtfwzNoj7QaAPLLuR6f_AiKWhi2Zr_Lr_iRoCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrVHo8G6ghN-cXCOhD7S3LUJ7FbfPERucP4v-qZvbvMA&oe=6AEDDA84"}, {"file_name": "Untitled12_20250702144210.png", "id": "619455257840526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299928_619455261173859_7878960711366579172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYWD6bVnJ98Q7kNvwEUooSi&_nc_oc=Adqua3xRJ5BBhqz9GVPpwf_HCHApcjj9IxVIHif195wcpHXziLjd8RhPyUujfX2QsXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRry23jFSo3IFSK-4a8kSDF_OOmU4BGtWO1AWLZyaxCig&oe=6AEDFA8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Funny Monkeys VR", "keywords": [], "long_description": "\ud83d\udc12 Funny Monkeys \u2013 A Fast-Paced Gorilla Tag Fan Game\nWelcome to Funny Monkeys, the ultimate VR playground where chaos, speed, and monkey business collide! Inspired by the iconic Gorilla Tag, this fan-made experience takes the core of physics-based locomotion and cranks it up with thrilling dashes, expansive maps, and a whole lot of fun.\n\ud83e\udd8d Movement That Feels Wild\nIn Funny Monkeys, you don\u2019t walk\u2014you launch, leap, and lunge. Using your arms to propel yourself through the environment, you\u2019ll master the art of gorilla-style movement. Whether you're climbing trees, bouncing off walls, or flinging yourself across gaps, every motion is powered by your own momentum and skill. It\u2019s fast, it\u2019s fluid, and it\u2019s hilariously fun.\nBut Funny Monkeys doesn\u2019t stop at the basics. With a unique dashing mechanic, you can burst forward in short, high-speed bursts\u2014perfect for dodging tags, escaping tight corners, or pulling off slick mid-air maneuvers. It adds a layer of strategy and adrenaline to every chase.", "short_description": "Funny Monkeys is a Gorilla Tag fan game, with Tag, A community shop, interesting movement, etc."}]}, "developer_name": "Funny Monkeys", "developer_privacy_policy_url": "https://sites.google.com/view/funny-monkeys-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MaskedKitten", "support_website_url": null, "website_url": "https://sites.google.com/view/funny-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id":
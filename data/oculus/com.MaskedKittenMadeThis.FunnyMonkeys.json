wdWZnfCiq4QSYAXdxalJxbosGcoj62QciUaG08-n6hXCFgys&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u3eP7ReFaQh3zukUHyTTgB2_RnF3JeBIc8sp_H2aTvw&oe=6A32B50A"}, {"file_name": "Untitled12_20250702144012.png", "id": "657074747349116", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308575_657074750682449_5191888676608945889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fc43O1eHxoQ7kNvwEezOCk&_nc_oc=AdplzQ29YxECm6PMjj-tnWzfz5zf6g-UbtpQQSgeQT7npICke-No_m9yoiq1Gji9ODQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9soMKVPs58CRNH3q-DATRoH-fJwVhyX1GY4ECW7mbGIw&oe=6A32A584"}, {"file_name": "Untitled12_20250702144210.png", "id": "619455257840526", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499299928_619455261173859_7878960711366579172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhYpuXr0BNMQ7kNvwE5rOMy&_nc_oc=AdoVaf2DtU5w1_2ZTw_vWm6kpbzBAgOr25GfxWWbAra9GbPZs3E_7WhzSM7jpjGaoKw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SR_NA_7n_UbXk49r--QwDbZTGybblo7RAZ1XfR2XOpQ&oe=6A32C58C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Funny Monkeys VR", "keywords": [], "long_description": "\ud83d\udc12 Funny Monkeys \u2013 A Fast-Paced Gorilla Tag Fan Game\nWelcome to Funny Monkeys, the ultimate VR playground where chaos, speed, and monkey business collide! Inspired by the iconic Gorilla Tag, this fan-made experience takes the core of physics-based locomotion and cranks it up with thrilling dashes, expansive maps, and a whole lot of fun.\n\ud83e\udd8d Movement That Feels Wild\nIn Funny Monkeys, you don\u2019t walk\u2014you launch, leap, and lunge. Using your arms to propel yourself through the environment, you\u2019ll master the art of gorilla-style movement. Whether you're climbing trees, bouncing off walls, or flinging yourself across gaps, every motion is powered by your own momentum and skill. It\u2019s fast, it\u2019s fluid, and it\u2019s hilariously fun.\nBut Funny Monkeys doesn\u2019t stop at the basics. With a unique dashing mechanic, you can burst forward in short, high-speed bursts\u2014perfect for dodging tags, escaping tight corners, or pulling off slick mid-air maneuvers. It adds a layer of strategy and adrenaline to every chase.", "short_description": "Funny Monkeys is a Gorilla Tag fan game, with Tag, A community shop, interesting movement, etc."}]}, "developer_name": "Funny Monkeys", "developer_privacy_policy_url": "https://sites.google.com/view/funny-monkeys-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MaskedKitten", "support_website_url": null, "website_url": "https://sites.google.com/view/funny-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30277928528521510"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1799022824366120"}]}, "baseline_offer": {"id": "1799022824366120"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751560980, "status": "PUBLISHED", "id": "1799022824366120"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35952235051090801", "version": "2.0"}, "id": "647703216995680", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andr
0464132879_7692290817696378409_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZIOnxMXaSEQ7kNvwGlRvAL&_nc_oc=AdrRBkuCYy-yCWAZ2Djkl3ne0szV-brqD_ybgjysewmgWYPtVPMclIuRD4npIP1Kqgo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tJmEsayoaMaL5FPP1nvI268jZl9XztNb3pe8V_8SfCA&oe=6A30167B"}, {"file_name": "Untitled99_20260526214608.png", "id": "1003925058757582", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/585799753_1003925062090915_262611270721892164_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyTSEjoBlGAQ7kNvwF3F-1g&_nc_oc=AdqImCFJzjjfAq2TJt7A6P0XFAH0kFGTjPSH8c10kWWRzDQpAblyw-HNzO_QwAWm8Lc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9inKOyXu9r5jvFyIo0IBi5BbfoRKcHLwe7a_6Fqn9Tg&oe=6A2FF32A"}, {"file_name": "Untitled99_20260526214542.png", "id": "1463427765029163", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303377_1463427768362496_1865617553575959228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caLIjSHqS18Q7kNvwE2GVlv&_nc_oc=AdqRLxEL41B_ONQWpC4_9PtgiZKoM4WY2ugNoXipG6or0YETyQePsXFfQ_7QjrmnpUk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QUhCv0hdKQ3dOaLMnhcnwXSKTkNi-JV93bcFuRyPhbw&oe=6A301626"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Funny Monkeys VR", "keywords": ["Funny", "Monkeys", "VR", "Monkey"], "long_description": "Funny Monkeys VR is a unique Gorilla Tag Fangame, having abilities such as dash, counter, and more to be added. Funny Monkeys attempts to pave the ways for other fan games in the future, by adding unique ideas and stories. One of Funny Monkeys biggest upcoming features, is the Story mode, which I believe has never been done in this genre of games before. Story mode mixes themes of horror, fighting, chase, and puzzle solving. In the future, Funny Monkeys plans on producing more unique modes for players to play in.", "short_description": "Funny Monkeys VR is a game made by glacier, the game features a locomotion similar to Gorilla Tag, while still having unique features and ideas."}]}, "developer_name": "Venti", "developer_privacy_policy_url": "https://sites.google.com/view/fmvrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Venti", "support_website_url": null, "website_url": "https://sites.google.com/view/funnymonkeysvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "31427162026931482"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308998_976639185212677_7853606508534730510_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWSfuw7BHucQ7kNvwF6S3Lh&_nc_oc=AdrJmwuM25624DgQo4UOZ4R3JEJTYlSUuLUApA2jTgXcRTIImUs0eBtVpsaTkYkeqp4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cGeG181g_rrUJmYyCOvwI81-D8aac5FX5NZjcnff1FQ&oe=6A3028DF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Funny Monkeys VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1751560980, "lastRevision": {"nodes": [{"id": "9648257085248623", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata"
/499308578_2544182472601664_5823682747738088831_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBoQ3h-GbzAQ7kNvwHF72HI&_nc_oc=Adpk58vPelKnxfqtGQtu9XDnqpGKUTvFa5x0r4hMKt18S4mTGFKZUxSug1JNfsgfAGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnN_XTJ2E0tNn8k8FFmZHQ89yRxkHq_FuIftcxMr6R4g&oe=6A7C5FAD"}, {"file_name": "Untitled12_20250702143904.png", "id": "708736541902783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303471_708736545236116_7793874404234686870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fxk0srAACKkQ7kNvwHwUbSW&_nc_oc=AdpnT4ojV_CcKgwJKy-LTrmbZYjTbCEHTttJs47iDv5XMWaZIrT4DFa5Axg9AtZqW7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZreyU1wRBRjAvvq7fuwNfi_yDiWACWpxG4yKfMoM--w&oe=6A7C50CA"}, {"file_name": "Untitled12_20250702144012.png", "id": "657074747349116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308575_657074750682449_5191888676608945889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEPAWvhMgtEQ7kNvwG7TkLW&_nc_oc=AdoCVMIM7FarwNV33rADOIeDgj_Ue3ZF9qrkX_PIJONkL-x07CvYjbI1nJZ4dsfTkZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZQ5zIrrCApS8dIA_r8tPo9zhdWwtGCuEzPr6hikWR0w&oe=6A7C7984"}, {"file_name": "Untitled12_20250702144210.png", "id": "619455257840526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299928_619455261173859_7878960711366579172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1uc4E3Ce_YQ7kNvwFVumHi&_nc_oc=AdogznMDt5BWbWdKYdBqruhVBuhzSBdoPFAMZKRXB68bVuuYYBJAUaj5EW562NMz2pA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzBKsXNSrX96-JKF81iuGrc_0kq-Q-3GD4K7zYsq5skg&oe=6A7C614C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Funny Monkeys VR", "keywords": [], "long_description": "\ud83d\udc12 Funny Monkeys \u2013 A Fast-Paced Gorilla Tag Fan Game\nWelcome to Funny Monkeys, the ultimate VR playground where chaos, speed, and monkey business collide! Inspired by the iconic Gorilla Tag, this fan-made experience takes the core of physics-based locomotion and cranks it up with thrilling dashes, expansive maps, and a whole lot of fun.\n\ud83e\udd8d Movement That Feels Wild\nIn Funny Monkeys, you don\u2019t walk\u2014you launch, leap, and lunge. Using your arms to propel yourself through the environment, you\u2019ll master the art of gorilla-style movement. Whether you're climbing trees, bouncing off walls, or flinging yourself across gaps, every motion is powered by your own momentum and skill. It\u2019s fast, it\u2019s fluid, and it\u2019s hilariously fun.\nBut Funny Monkeys doesn\u2019t stop at the basics. With a unique dashing mechanic, you can burst forward in short, high-speed bursts\u2014perfect for dodging tags, escaping tight corners, or pulling off slick mid-air maneuvers. It adds a layer of strategy and adrenaline to every chase.", "short_description": "Funny Monkeys is a Gorilla Tag fan game, with Tag, A community shop, interesting movement, etc."}]}, "developer_name": "Funny Monkeys", "developer_privacy_policy_url": "https://sites.google.com/view/funny-monkeys-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MaskedKitten", "support_website_url": null, "website_url": "https://sites.google.com/view/funny-monkeys-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id":
20f&oh=00_AQSYCIwGsPxS7iI_R6vxaZHjo-XUK8dKsVG6QPDIzH5yog&oe=6B084758"}, {"file_name": "ss (1).png", "id": "2357749951705451", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491827960_2357749958372117_3865495703616327090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3v8ML31zb0Q7kNvwHFgeg_&_nc_oc=AdpxNjajgUBQhgXQoTgb9cfodEIf9oyyO0oPymD7vO9KiQkw-hzOwH3Ayl4vOjFXCFQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSt5NRwkLle_MtlPvRh1_93VucRkLz661iFZgAMnLACg&oe=6B085658"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1785006566117653", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824741_1785006576117652_20406677078781521_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vFpzeMbJq8Q7kNvwGF2JeU&_nc_oc=AdoUABVVRqkOl7mJU7s2Z_KnTxWwDPt9tWX3JPuLcra6bJwKzI8MAkfbqyXlzUF2mik&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJGkzNKJ6DUZZZ956OangIF0jXOAuBkms04_m-G5sz8A&oe=6B0869E7"}, "display_name": "AudioFloor", "keywords": ["visualizer", "music", "audio", "chill", "trippy"], "long_description": "Turn your music into a living 3D world. Start in a pitch black void, hit play, and watch the darkness explode with colors pulled straight from your album art.\n\n### Features\n\n* **Album Matched Colors:** The world dynamically changes its lighting to match your track artwork.\n* **Bass Shockwaves:** Heavy bass hits send bright glowing waves rippling across the floor.\n* **Reactive 3D Terrain:** High and low pitches sculpt the shifting voxel pillars beneath your feet.\n* **Living Starfield:** A massive sky full of stars pulses and reacts to the rhythm above you.\n* **Roam Anywhere:** Chill on the floating glass stage or drop straight onto the terrain for a close up look.\n* **Reactive Controllers:** Your hands pulse with the beat and fire interactive effects into the sky.\n* **Play Your Own Files:** Load local audio tracks directly from your headset via a sleek dark UI.", "short_description": "Step into a dynamic audio reactive world where your music sculpts 3D voxel terrain, floating pillars, and rhythmic visuals in pure VR."}]}, "developer_name": "Dexter Chock", "developer_privacy_policy_url": "https://telegra.ph/AudioFloor---Privacy-Policy-11-09", "developer_terms_of_service_url": null, "publisher_name": "Dexter Chock", "support_website_url": null, "website_url": "https://telegra.ph/AudioFloor---Privacy-Policy-11-09", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1822201435664817"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823837_1376665327692148_5104807079099626953_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHFoN5umr4IQ7kNvwFrGcrp&_nc_oc=AdpbCRi-m-2VQKbhbb-vYhIrIiqSpTU3lq1gaheor5c_sMRauLQB7CXt6J6oIrbqPmI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQll15MDIK66SbR2czWJjfajIub9ybWz-LByUrDHVD8kQ&oe=6B084BF5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AudioFloor", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"top
ur track artwork.\n* **Bass Shockwaves:** Heavy bass hits send bright glowing waves rippling across the floor.\n* **Reactive 3D Terrain:** High and low pitches sculpt the shifting voxel pillars beneath your feet.\n* **Living Starfield:** A massive sky full of stars pulses and reacts to the rhythm above you.\n* **Roam Anywhere:** Chill on the floating glass stage or drop straight onto the terrain for a close up look.\n* **Reactive Controllers:** Your hands pulse with the beat and fire interactive effects into the sky.\n* **Play Your Own Files:** Load local audio tracks directly from your headset via a sleek dark UI.", "short_description": "Step into a dynamic audio reactive world where your music sculpts 3D voxel terrain, floating pillars, and rhythmic visuals in pure VR."}]}, "developer_name": "Dexter Chock", "developer_privacy_policy_url": "https://telegra.ph/AudioFloor---Privacy-Policy-11-09", "developer_terms_of_service_url": null, "publisher_name": "Dexter Chock", "support_website_url": null, "website_url": "https://telegra.ph/AudioFloor---Privacy-Policy-11-09", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1822201435664817"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1025407909952697"}]}, "baseline_offer": {"id": "1025407909952697"}, "is_approved": true, "firstOffer
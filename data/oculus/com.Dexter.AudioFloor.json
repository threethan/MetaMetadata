f49cLhiHhIv_We-c5yDFmkUEsHVrnCGFRz4YCUAERe64WtGy-3EWW3OAJYNE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzEbWZ7IIDEGavD4Q8qxRwtS9NJ_ITcHrMoQ928OamOA&oe=6B0B3826"}, {"file_name": "ss (2).png", "id": "1779481763149714", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825470_1779481769816380_1220891895884846683_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubXa9ZXgvvEQ7kNvwGHi9gS&_nc_oc=AdripR4ijFaAqbSxvMiTkI-ZW2uEaEibHw3OXuZAXkHRLe-vr431FRXNTq5k9MCCSb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_KW7HGsMioerTnFLI8PZfawwJNnYW8UftTNTyXc5Zdw&oe=6B0B2298"}, {"file_name": "ss (1).png", "id": "2357749951705451", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827960_2357749958372117_3865495703616327090_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3v8ML31zb0Q7kNvwED1KWF&_nc_oc=AdpVhieWw7AOCBIH8QGrqqlG-MBMfc_Xv4WfhJxvE49NiazWqdW7-6iYfUNh7zXSLy8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1p8bX4Xvsaq9ihF0E-mTz_7lIt4rXwto7zkHYWzU6Ww&oe=6B0B3198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1785006566117653", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824741_1785006576117652_20406677078781521_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vFpzeMbJq8Q7kNvwE4cEs0&_nc_oc=AdoQ3JlmsnOOu7Q_0bQabXwbKLNI2b8IjdiH49b-LZ6J0lcAnQtHv5D8rgBcOIZeZ_c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXj7ZgqcClLrLh0jS277yAN8ovrUDYxqfGi7Mmdrxjnw&oe=6B0B4527"}, "display_name": "AudioFloor", "keywords": ["visualizer", "music", "audio", "chill", "trippy"], "long_description": "Turn your music into a living 3D world. Start in a pitch black void, hit play, and watch the darkness explode with colors pulled straight from your album art.\n\n### Features\n\n* **Album Matched Colors:** The world dynamically changes its lighting to match your track artwork.\n* **Bass Shockwaves:** Heavy bass hits send bright glowing waves rippling across the floor.\n* **Reactive 3D Terrain:** High and low pitches sculpt the shifting voxel pillars beneath your feet.\n* **Living Starfield:** A massive sky full of stars pulses and reacts to the rhythm above you.\n* **Roam Anywhere:** Chill on the floating glass stage or drop straight onto the terrain for a close up look.\n* **Reactive Controllers:** Your hands pulse with the beat and fire interactive effects into the sky.\n* **Play Your Own Files:** Load local audio tracks directly from your headset via a sleek dark UI.", "short_description": "Step into a dynamic audio reactive world where your music sculpts 3D voxel terrain, floating pillars, and rhythmic visuals in pure VR."}]}, "developer_name": "Dexter Chock", "developer_privacy_policy_url": "https://telegra.ph/AudioFloor---Privacy-Policy-11-09", "developer_terms_of_service_url": null, "publisher_name": "Dexter Chock", "support_website_url": null, "website_url": "https://telegra.ph/AudioFloor---Privacy-Policy-11-09", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1822201435664817"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1025407909952697"}]}, "baseline_offer": {"id": "1025407909952697"}, "is_approved": true, "firstOffer
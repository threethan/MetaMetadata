mOaW6Sr6DTQn_St3VItXuEAWanM9AipuVUgolMZxBl0HM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWz_5kU91zU9s16baUC20DX-L8BZ1cc89JHTING-4aJMg&oe=6B0F0C3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1785006566117653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_1785006576117652_20406677078781521_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHst3Gq8HPQQ7kNvwElfuwt&_nc_oc=AdpEGyRIBGyzYd4DhiB1FFMH55rNI7C8vhUXDD3_klw3cR3tzhXjoDICKllYgBS6aAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVs0peHemD0oBv75iaPh7S6IowDZLgSw4uEcgy77YANzQ&oe=6B0F0167"}, "display_name": "AudioFloor", "keywords": ["visualizer", "music", "audio", "chill", "trippy"], "long_description": "Turn your music into a living 3D world. Start in a pitch black void, hit play, and watch the darkness explode with colors pulled straight from your album art.\n\n### Features\n\n* **Album Matched Colors:** The world dynamically changes its lighting to match your track artwork.\n* **Bass Shockwaves:** Heavy bass hits send bright glowing waves rippling across the floor.\n* **Reactive 3D Terrain:** High and low pitches sculpt the shifting voxel pillars beneath your feet.\n* **Living Starfield:** A massive sky full of stars pulses and reacts to the rhythm above you.\n* **Roam Anywhere:** Chill on the floating glass stage or drop straight onto the terrain for a close up look.\n* **Reactive Controllers:** Your hands pulse with the beat and fire interactive effects into the sky.\n* **Play Your Own Files:** Load local audio tracks directly from your headset via a sleek dark UI.", "short_description": "Step into a dynamic audio reactive world where your music sculpts 3D voxel terrain, floating pillars, and rhythmic visuals in pure VR."}]}, "developer_name": "Dexter Chock", "developer_privacy_policy_url": "https://telegra.ph/AudioFloor---Privacy-Policy-11-09", "developer_terms_of_service_ur
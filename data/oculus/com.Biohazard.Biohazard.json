DEXquzAmu_fp0O05k_HsJAVAcyIo4XHJb6uTIyn_Gpbg&oe=6A677652"}, {"file_name": "Untitled330_20260323144545.png", "id": "1748212949889995", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821799_1748212953223328_792904966525567965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY54qoAxO3UQ7kNvwGx4UQk&_nc_oc=AdqUrjGW_bFooxi6IXHVLmmWQDJIv40pLUs4LTv4eJhR2TOk-LqiTcSzye8cnlr_MJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIJPtGeQ6BqEHNjtJaRyFsG86jiAEgMR9Yj5y21vbHZg&oe=6A676DA6"}, {"file_name": "Untitled330_20260323144433.png", "id": "1284441353593672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295566_1284441356927005_2396446622183005527_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhuaD8kM9z8Q7kNvwGh0u80&_nc_oc=AdpnEtpAOli1e9S3bleaFIV_ElEfytGVbKP4MfO3L4vMmawHJQL2oFc6XyXE3EGLh4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf6frbM0ITH2K68x2EVNSMxHOABW4x-qUbG6tSpj4uDA&oe=6A675CE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled331_20260323145538.png", "id": "2959830250874157", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293690_2959830254207490_3079250811033436981_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf3rb_1USdEQ7kNvwGhOOAw&_nc_oc=AdokzoyKESYgI8xGq3Csvc8HqCycGkNu_dwRs0gX4y5NsC2OD9LInxIfT5Z0ZN5UtYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbQKvXEGw77ztIsSnt2MKKMUgS0bWWnVR78AGGRoqYkQ&oe=6A6748E1"}, "display_name": "Biohazard", "keywords": ["SurvivalHorror", "VRMultiplayer", "MonsterChase", "ItemCollection", "BurnMechanic"], "long_description": "Biohazard is a multiplayer VR survival horror experience that plunges players into the heart of an abandoned, overgrown research facility consumed by a mysterious biological outbreak. Wearing full hazmat suits, players must work together\u2014or survive alone\u2014as they explore the rotting structure, gather essential gear, and face nightmarish creatures born from the failed containment of an unknown organic threat.\n\nAs the infection spreads through walls, floors, and air vents, players must locate tools to burn or contain the bio-growth before it overtakes critical areas. Every corner hides danger, and every sound could mean a monster is near\u2014some only move when you're not looking. Light sources like flashlights and lanterns are your lifeline, but they won't last forever.\n\nStrategic teamwork, quick thinking, and nerve are key. Whether you're trying to hold back the growth, avoid deadly traps, or hide from lurking horrors, every decision counts. With immersive VR mechanics, randomized monster behavior, and a dark, fleshy atmosphere, Biohazard delivers a relentless and terrifying experience where survival is anything but guaranteed.", "short_description": "Biohazard is a VR horror game set in a decaying, overgrown facility where players wear hazmat suits and must contain a spreading bio-growth while escaping terrifying, mutated monsters. Survive using limited tools, collect vital gear, and uncover the dark secrets hidden within the contaminated ruins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/biohazard-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Biohazard", "support_website_url": null, "website_url": "https://sites.google.com/view/biohazard-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
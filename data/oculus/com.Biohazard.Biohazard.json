nshots": [{"file_name": "Screenshot 2025-07-28 184037.png", "id": "1101800038468210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618883_1101800041801543_8397270424798026417_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp6vSe1BeQcQ7kNvwE2ifNj&_nc_oc=Adk3AOmnDYhzSIC-CymPw2ZJfVWHbEcx3hcRvXeDMEplLIFyvOdtSufW941qp1b562E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsrenzDuQk8JocX68-1fRB04OtXkoGen-EeQmIh6opMPw&oe=69A2DBCD"}, {"file_name": "Screenshot 2025-07-31 150310.png", "id": "1435634971081911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619124_1435634981081910_5096903216720842266_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJQP2n-ZcroQ7kNvwHp1EnS&_nc_oc=AdnWYnpyS4vFys-vLKGnPFAQaAGpP0-DL0wxSKPi40lZCnDJ8jTMD5cyrnoX8EY-ozg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuq90bdF3gyyLHFYLfOaLIAW62MSht_-EewSP4ErPtY3w&oe=69A2E134"}, {"file_name": "Screenshot_2025-07-31_150222_1_optimized.png", "id": "4081430362136988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822952_4081430365470321_3314860811249103907_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITi7-1zDGmMQ7kNvwH7y4vm&_nc_oc=AdmyepJyKt8iOuvJouxtUBSfzqnwpAxbnDxWDTOGN7LzNmNAzXfk4Rfg53kE45FGHVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTxehKGGsZBL2xSfjOdFM0nOHDnd5bcnG5eL26Jipo9A&oe=69A2FB64"}, {"file_name": "Screenshot_2025-07-31_150256_optimized.png", "id": "1098315728490394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818900_1098315731823727_8868534343081330502_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz7lQ_gKbXEQ7kNvwF-bwK3&_nc_oc=AdlagXaP-Q1g2PVMrLIk-V44FUaKzvR6VAH-GouCvYIC85QM2lCKWRjivBxIEb82w3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6Z1lYWMOz6xQBJpkzu9dygJiUIXDgd6SEX6xa79UolQ&oe=69A2F355"}, {"file_name": "Screenshot_2025-07-31_150206_optimized.png", "id": "1169221061684546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818900_1169221065017879_955866327723186153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LskefUTWOUcQ7kNvwFqLuFN&_nc_oc=AdmbuqI8mzC21vwaVkDPxmmO6uP-7RhhC_2TOxQK_M0t2aq4mbK8vTLxbCVKwFV9YJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhLmH16fGSuIJDaGPyjfFJLuNwDWmYpfWB9z1ttbWOWg&oe=69A2FBBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Biohazard", "keywords": ["SurvivalHorror", "VRMultiplayer", "MonsterChase", "ItemCollection", "BurnMechanic"], "long_description": "Biohazard is a multiplayer VR survival horror experience that plunges players into the heart of an abandoned, overgrown research facility consumed by a mysterious biological outbreak. Wearing full hazmat suits, players must work together\u2014or survive alone\u2014as they explore the rotting structure, gather essential gear, and face nightmarish creatures born from the failed containment of an unknown organic threat.\n\nAs the infection spreads through walls, floors, and air vents, players must locate tools to burn or contain the bio-growth before it overtakes critical areas. Every corner hides danger, and every sound could mean a monster is near\u2014some only move when you're not looking. Light sources like flashlights and lanterns are your lifeline, but they won't last forever.\n\nStrategic teamwork, quick thinking, and nerve are key. Whether you're trying to hold back the growth, avoid deadly traps, or hide from lurking horrors, every decision counts. With immersive VR mechanics, randomized monster behavior, and a dark, fleshy atmosphere, Biohazard delivers a relentless and terrifying experience where survival is anything but guaranteed.", "short_description": "Biohazard is a VR horror game set in a decaying, overgrown facility where players wear hazmat suits and must contain a spreading bio-growth while escaping terrifying, mutated monsters. Survive using limited tools, collect vital gear, and uncover the dark secrets hidden within the contaminated ruins."}]}, "developer_name": "Biohazard", "developer_privacy_policy_url": "https://sites.google.com/view/biohazard-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Biohazard", "support_website_url": null, "website_url": "https://sites.google.com/view/biohazard-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24515694948035270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1406135664020055"}]}, "baseline_offer": {"id": "1406135664020055"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754513160, "status": "PUBLISHED", "id": "1406135664020055"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25174353068836118", "version": "0.7.0"}, "id": "1422466665756954", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24450218154582950", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25174353068836118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1422466665756954"}]}, "change_log": null, "created_date": 1760851325, "id": "25174353068836118", 
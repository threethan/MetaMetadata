00_AfvshDeWKwblnJQ8-eNWsgG2kEIh8uZuffv3JoQC2T_PDg&oe=69A571C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MK_Cover - 2560x1440.png", "id": "1031977782020389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823802_1031977785353722_7774159051215887864_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOyxptfeU-8Q7kNvwGF9iEE&_nc_oc=AdkiHBATfEQeaK7_NoiBrmZJJHImSzUafaxmRosLAlSsnbDDc-JxieAn_17KLGeo3JQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsYdTt83qvTpnKl56OEhyvBa-gwvgRpVbR6UbVwAORosw&oe=69A59539"}, "display_name": "Mars Kitchen", "keywords": [], "long_description": "# \ud83d\udc7d Conquer Mars...with Food! \ud83c\udf55\n\n**Mars Kitchen** is a simulation sandbox game on Mars. Meet strange **aliens**, explore different kitchen styles and embark on an **amazing space food journey!**\n\nYou are the new chef in charge of all the kitchens: put on your apron and get to work!\n\n{1023210599584646}\n\n# \ud83c\udf69 Discover all the restaurants\nExplore a variety of restaurants and fulfill the weirdest requests from martians all day long: your shift just started!\n{700613606093660}\n\n# \ud83c\udf54 Multiple environments\n**Sushi, Pizzeria, Food Truck and Earthbucks**: the top Mars Kitchen restaurants are waiting for you, chef! \n\nStart from the Control Room and take a break at the Stadium: **6 different environments** ready to play\n\n{1475837643829644}\n\n# \ud83c\udf63 Quests, Recipes, a lot of work!\n*100+ unique quests* to complete with dozens of recipes and items to use: the only limit is your creativity!\n\n{740914088510984}\n\n# \ud83c\udfdf\ufe0f Meet the martians\nAliens are all over the place! Each of them with their own story and tastes. Will you be able to save them from the nefarious Fazar?\n\n{1692424174733904}", "short_description": "Get Ready to conquer Mars...with Food!\nMars Kitchen is a simulation sandbox game on Mars. Meet strange aliens, explore different kitchen styles and embark on an amazing food journey.\nYou are the new chef in charge of all the kitchens. Put on your apron and get to work!"}]}, "developer_name": "Taco Studios", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/60098033", "developer_terms_of_service_url": null, "publisher_name": "Taco Studios", "support_website_url": "https://discord.gg/qmsCtDjPg6", "website_url": "https://marskitchenvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8951497108264248"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "865318762952387"}, {"status": "PUBLISHED", "id": "851654847666322"}, {"status": "PUBLISHED", "id": "1202480288707251"}, {"status": "PUBLISHED", "id": "2647153238979306"}, {"status": "PUBLISHED", "id": "758245283478895"}, {"status": "PUBLISHED", "id": "1067773122150911"}, {"status": "PUBLISHED", "id": "1254971998884175"}]}, "baseline_offer": {"id": "1254971998884175"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "865318762952387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25771216122532416", "version": "1.6"}, "id": "1245327570064149", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "An
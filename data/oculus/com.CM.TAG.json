o_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUSTOM TAG", "keywords": [], "long_description": "Ready to go full monke?\n\nCUSTOM TAG throws you back to the chaotic, hilarious early days of VR. It's all about mastering that unique, hand-based , climbing, and flinging yourself off surfaces to rule the trees.\n\nBut this isn't just a solo climb. This is a social game. Hop into a loud public lobby or set up a private room with your crew. It\u2019s all about reliving that wild energy\u2014juking other monkes, screaming with your team, or just hanging out in the forest. It\u2019s pure, simple, social fun.", "short_description": "Welcome To CUSTOM TAG"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/custom-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CUSTOM TAG", "support_website_url": null, "website_url": "https://sites.google.com/view/customtag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "3179344335599603"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3195789163955120", "version": "1.1.101"}, "id": "2131089634483489", "channel_
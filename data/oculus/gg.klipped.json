c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv9cjAg5aisQ7kNvwHVKNnW&_nc_oc=Adqr3OHwon8Mh3jviXyyE0F3oIAWp605DGsqvwpl4epSMxC4BPaEOP3Mmz7KKvVsb4o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZus5xERnfMdPo888FjdoCNDXtN-u8MYH7YYt4Okfd3g&oe=6AFB2F7C"}, {"file_name": "03-editor.png", "id": "4455931938001825", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823905_4455931941335158_843368418550094334_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDSHcuJ8CWIQ7kNvwFl4vEt&_nc_oc=AdpSbUZDqm3vlfQsfIqPb-UbPF2Wc5ErELDeuhoaECLjajIs6VCNfi7IkkBB4JZqUYc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0uwyYfLdX3u-IvQCadh7Dv8jIYXFatVYyGyE8J-wmRg&oe=6AFB3957"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Klipped", "keywords": ["replay", "recorder", "clips", "highlights", "voice"], "long_description": "**Some moments need a replay.**\n\nThe winning shot. The last-second escape. The ridiculous thing your friend just did.\n\nKlipped helps you keep the VR moments you only realize you want to save after they happen.\n\n**Start before you play**\nEnable capture in Klipped before your session. It keeps a rolling buffer of recent gameplay, ready for the moment you want to keep.\n\n**Save what just happened**\nUse your voice or Manual Save to turn recent gameplay into a Klip. You don't need to plan a highlight in advance.\n\n**Keep your moments together**\nWatch saved Klips on your headset and organize your favorites. Relive a close finish, revisit a great play or keep something that made you laugh.\n\n**Choose what leaves your headset**\nYour Klips stay local unless you choose to upload them. Upload selected moments to your private web library to watch them on another device.\n\nLocal capture does not require an account. An account and internet connection are required for cloud features.", "short_description": "Save the gameplay that just happened. Start Klipped before you play on Meta Quest, then use your voice or Manual Save to keep your favourite moments. Watch your Klips on your headset and choose which ones to upload to your private library."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klipped.gg/privacy", "developer_terms_of_service_url": "https://klipped.gg/terms", "publisher_name": "Klipped", "support_website_url": "https://klipped.gg/help", "website_url": "https://klipped.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1316693558192849"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2567531747078573"}]}, "baseline_offer": {"id": "2567531747078573"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793995200, "status": "PUBLISHED", "id": "2567531747078573"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1394743317054539", "version": "0.1.9"}, "id": "966929206442951", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1316693544859517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1394743317
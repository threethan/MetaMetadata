ttps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1812477366545456_8951551743137949835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoHOJby6NjoQ7kNvwHfWopb&_nc_oc=AdqTLIXhKBP4YkhNRTUO5AcDRr6bLWxIQ9ELQLsgfk2lbbvDu_mBUGJH1DEe3abEcms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUyriZVGuI3Q9XjEP8brgFV483QjMFe1XWtMOoLXKLZA&oe=6AF7267E"}, {"file_name": "02-my-klips.png", "id": "1609597626770778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825497_1609597630104111_6777684100761914817_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRyn7hO_zgAQ7kNvwG9g5Ch&_nc_oc=AdoNoHKg3uGyEGsAn5UgaXil1Yk3kQNsEjxx0nJkMe03qYmW2OPIZYIfn6rj8Iy6Alo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_61NToStbCkBaYYoik-mG4zwkxyxnusAzpQwEujkXyQ&oe=6AF721C6"}, {"file_name": "05-cover-picker.png", "id": "1634094601425131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828104_1634094608091797_504799710116457620_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpdOKUGzOJsQ7kNvwFL2BiY&_nc_oc=AdqguY5ZqgMvRWVrkFbP_88dxyD9jz4FQ4kHrEcGsF6ZBTYGqxvkPfKwjgNUMECdah4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9JIDXbJDB0uFSQHM54m-plihQp-yMtoLZIn83wJyWYg&oe=6AF731DA"}, {"file_name": "04-capture-settings.png", "id": "946843444849703", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_946843448183036_5581344602430553778_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbM2RspN1iEQ7kNvwHV30fD&_nc_oc=AdqamiONBk2NKOE8bdjTqNCB3kJzH3fLyBQKmauJbpCIkIPMRsaUI3pBp5UzgfS-Qv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgExFhk79z2an9M-hrpRCAGqcP2D-LwGAjSOm2nqAlFw&oe=6AF73AFC"}, {"file_name": "03-editor.png", "id": "4455931938001825", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_4455931941335158_843368418550094334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3Xi3dQxecoQ7kNvwHHQP9C&_nc_oc=Adq-IweugwJArCWXr7dkUoWhaAruV738herO6ccM3Y6r4eB3E8uKvQsmiR4atQiljm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4WahV4JgDtEC0SlLGVLVppOyEJ7UHobWX5e0ProhBwA&oe=6AF744D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Klipped", "keywords": ["replay", "recorder", "clips", "highlights", "voice"], "long_description": "**Some moments need a replay.**\n\nThe winning shot. The last-second escape. The ridiculous thing your friend just did.\n\nKlipped helps you keep the VR moments you only realize you want to save after they happen.\n\n**Start before you play**\nEnable capture in Klipped before your session. It keeps a rolling buffer of recent gameplay, ready for the moment you want to keep.\n\n**Save what just happened**\nUse your voice or Manual Save to turn recent gameplay into a Klip. You don't need to plan a highlight in advance.\n\n**Keep your moments together**\nWatch saved Klips on your headset and organize your favorites. Relive a close finish, revisit a great play or keep something that made you laugh.\n\n**Choose what leaves your headset**\nYour Klips stay local unless you choose to upload them. Upload selected moments to your private web library to watch them on another device.\n\nLocal capture does not require an account. An account and internet connection are required for cloud features.", "short_description": "Save the gameplay that just happened. Start Klipped before you play on Meta Quest, then use your voice or Manual Save to keep your favourite moments. Watch your Klips on your headset and choose which ones to upload to your private library."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klipped.gg/privacy", "developer_terms_of_service_url": "https://klipped.gg/terms", "publisher_name": "Klipped", "support_website_url": "https://klipped.gg/help", "website_url": "https://klipped.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"
h_0pQaMn-iZZqclokctNJI37c8I9PwIMg&oe=6B0DC386"}, {"file_name": "05-cover-picker.png", "id": "1634094601425131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828104_1634094608091797_504799710116457620_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf_jNBFovzoQ7kNvwH7zjRe&_nc_oc=AdqzPcBAkGg0qDpYzRDAAXlxquGEu7gaTqxp1FF2ceWZj7wWzAPvg_0Ao1aQuUMLBzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDV7Iol8ijtbKtQiWO32PY2jbcjpd3ziPC3cijH-C-yw&oe=6B0D9B5A"}, {"file_name": "04-capture-settings.png", "id": "946843444849703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825497_946843448183036_5581344602430553778_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zV2vy_b58gQ7kNvwEwiM1d&_nc_oc=AdqnSnXiN5naelQMG04GbpiUiYOpt1Fu7L4ljvcQJuKPeyPX627oUtOGgtQV-nUo2Qs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuwJ6svVZdqvVrz3SdchafNmjd1r3_o9lTrN_VeN_o7Q&oe=6B0DA47C"}, {"file_name": "03-editor.png", "id": "4455931938001825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_4455931941335158_843368418550094334_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U7V1jJuaTEQ7kNvwFB_YRY&_nc_oc=AdpjvIUAcOEPGxkCfeBj_q0WHLk7yyie9mddtRnL2uO0LoFStz9OEo7IKODyHzY3jpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-wysSKKI5mzMDWeHJtLamADuow-WfxKcPIekfrrMNXw&oe=6B0DAE57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Klipped", "keywords": ["replay", "recorder", "clips", "highlights", "voice"], "long_description": "**Some moments need a replay.**\n\nThe winning shot. The last-second escape. The ridiculous thing your friend just did.\n\nKlipped helps you keep the VR moments you only realize you want to save after they happen.\n\n**Start before you play**\nEnable capture in Klipped before your session. It keeps a rolling buffer of recent gameplay, ready for the moment you want to keep.\n\n**Save what just happened**\nUse your voice or Manual Save to turn recent gameplay into a Klip. You don't need to plan a highlight in advance.\n\n**Keep your moments together**\nWatch saved Klips on your headset and organize your favorites. Relive a close finish, revisit a great play or keep something that made you laugh.\n\n**Choose what leaves your headset**\nYour Klips stay local unless you choose to upload them. Upload selected moments to your private web library to watch them on another device.\n\nLocal capture does not require an account. An account and internet connection are required for cloud features.", "short_description": "Save the gameplay that just happened. Start Klipped before you play on Meta Quest, then use your voice or Manual Save to keep your favourite moments. Watch your Klips on your headset and choose which ones to upload to your private library."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klipped.gg/privacy", "developer_terms_of_service_url": "https://klipped.gg/terms", "publisher_name": "Klipped", "support_website_url": "https://klipped.gg/help", "website_url": "https://klipped.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1316693558192849"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2567531747
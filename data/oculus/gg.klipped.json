NSuJUsDflqkZcnVX_NZ4iGhZ5WE732s7w&oe=6B106686"}, {"file_name": "05-cover-picker.png", "id": "1634094601425131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828104_1634094608091797_504799710116457620_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf_jNBFovzoQ7kNvwGaWHNp&_nc_oc=AdrYI1UiSA-ThCJiw81Uo5gS_0prsf73fug5pLs9Wnmo3pp4Pyy2fz9Rd53cNEtDQt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSQ7TJnyVhkI-azk8Iwm2aUT2hFG2yWiT5WEepvh4AaA&oe=6B103E5A"}, {"file_name": "04-capture-settings.png", "id": "946843444849703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_946843448183036_5581344602430553778_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieaDZv6Tna0Q7kNvwFVQSI4&_nc_oc=AdoU_JlhqO_ZAyUpDIOXhFATNgN0f9KvWSynfNJrbMPqc4u25prR7-i9_DR77sqqmxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUi80mD3gbLGEBcpRcNPqJU4JMjPl4j-VDRnzujsLu85g&oe=6B10477C"}, {"file_name": "03-editor.png", "id": "4455931938001825", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_4455931941335158_843368418550094334_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu3JsqxAX6oQ7kNvwH-cAsM&_nc_oc=AdqYshyGAkbnz_lmxAlcDvadYkCJ411o-pd6uvPwOszGlT6LL4uFBtaZ1UFtk1zcoEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVR4jR87uptxvTWSH44vFejDnPHmkhoKZh26Giy41PgjA&oe=6B105157"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Klipped", "keywords": ["replay", "recorder", "clips", "highlights", "voice"], "long_description": "**Some moments need a replay.**\n\nThe winning shot. The last-second escape. The ridiculous thing your friend just did.\n\nKlipped helps you keep the VR moments you only realize you want to save after they happen.\n\n**Start before you play**\nEnable capture in Klipped before your session. It keeps a rolling buffer of recent gameplay, ready for the moment you want to keep.\n\n**Save what just happened**\nUse your voice or Manual Save to turn recent gameplay into a Klip. You don't need to plan a highlight in advance.\n\n**Keep your moments together**\nWatch saved Klips on your headset and organize your favorites. Relive a close finish, revisit a great play or keep something that made you laugh.\n\n**Choose what leaves your headset**\nYour Klips stay local unless you choose to upload them. Upload selected moments to your private web library to watch them on another device.\n\nLocal capture does not require an account. An account and internet connection are required for cloud features.", "short_description": "Save the gameplay that just happened. Start Klipped before you play on Meta Quest, then use your voice or Manual Save to keep your favourite moments. Watch your Klips on your headset and choose which ones to upload to your private library."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klipped.gg/privacy", "developer_terms_of_service_url": "https://klipped.gg/terms", "publisher_name": "Klipped", "support_website_url": "https://klipped.gg/help", "website_url": "https://klipped.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1316693558192849"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2567531747
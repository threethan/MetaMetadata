 learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immersive mixed reality combat and explore the foundations of the world of GestureMancerKing.\n\nThis is an early version currently under development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gesturemancerking.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Hangzhou Magic Hand Technology Co., Ltd.", "support_website_url": null, "website_url": "https://gesturemancerking.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "25526211463675950"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1535075834668884"}]}, "baseline_offer": {"id": "1535075834668884"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781778480, "status": "PUBLIS
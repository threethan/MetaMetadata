RGRAup8W4Tk0gTEqYOU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL19C5s4VRkCgYBthKLdFTY2J9IO-R645ryqQFubT_L6g&oe=6AA403E7"}, {"file_name": "3.png", "id": "4348049612007991", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310731_4348049615341324_7403757451395784212_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPC2DKKdHVUQ7kNvwHdlZcQ&_nc_oc=AdohNLvn_fZK7Wwh_yT9GqgNW9lzYBD8RQgWlEW63U76wmTR0Dg1y9BpNBIQIXf76BU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ51Xs4F4wfYQV4I9HFMQP08hWEvTcxzw8RqHf7GR8AQg&oe=6AA4215C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u5411.png", "id": "1643574634443073", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823901_1643574641109739_8264575913598213489_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcDjMbHETrwQ7kNvwESAQKQ&_nc_oc=AdpJAlxuryJbt-e-s-ynbRsOnCQkBOpPyoMjsFtSmd0i1Co7YgTPnqp4SDmWqNbruDM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcX99OUxhKVkgaeE_-1QNG2AoP-GsaDBNJbxg1DcQBbw&oe=6AA4030F"}, "display_name": "GestureMancerKing", "keywords": ["Gesture", "magic", "xr", "Spellcasting", "HandTracking"], "long_description": "GestureMancerKing is a gesture-based XR magic game that brings spellcasting into mixed reality.\n\nPlayers use natural hand movements to gather energy and perform magical abilities. By combining different gestures, players can learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immers
PNQOrB2ZJdbjlvc4dJnHIBkG2lNJ0_-mAzkfrs5DIzCIewxyvIjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb6mBgU-Z7-lZvYVbMqv7UEjEUKRjxHiS2LUVEEvL1YQ&oe=6AEF324F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u5411.png", "id": "1643574634443073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1643574641109739_8264575913598213489_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WByhGts_ZiMQ7kNvwGxn5VR&_nc_oc=Adqc8ZGQddNh2yiutN-RvWz9IfhQV7IWAhwc2VqNoDQmYBarRbLUxfYRjyZ9rpqOuOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-4zi4WscmRCkL4kuK1svWisD_F1Qg0JU33BiuYYoQAg&oe=6AEF60CF"}, "display_name": "GestureMancerKing", "keywords": ["Gesture", "magic", "xr", "Spellcasting", "HandTracking"], "long_description": "GestureMancerKing is a gesture-based XR magic game that brings spellcasting into mixed reality.\n\nPlayers use natural hand movements to gather energy and perform magical abilities. By combining different gestures, players can learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immersive mixed reality combat and explore the foundations of the world of GestureMancerKing.\n\nThis is an early version currently under development."}]}, "developer_name": "junge", "developer_privacy_policy_url": "https://gesturemancerking.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Hangzhou Magic Hand Technology Co., Ltd.", "support_website_url": null, "website_url":
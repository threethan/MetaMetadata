vwSbwa0ROo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoIBQ8d1YNajuYQNkPxHx9jIMkQU75I2VQok8k2Og_dw&oe=6ABE61E7"}, {"file_name": "3.png", "id": "4348049612007991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_4348049615341324_7403757451395784212_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVaFi2OM68UQ7kNvwEhUwY7&_nc_oc=AdomrFdjWZDtWhiZZNooEYbOrbpmo-UlLWLFLjFKY7crcCyN-gwRG3kjO1OIskMMrSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpq8RSHIRt_5lpbLrKakx3wt6H6JbxA3kLlo7sk0ginw&oe=6ABE7F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u5411.png", "id": "1643574634443073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823901_1643574641109739_8264575913598213489_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjbAHufSaRMQ7kNvwEuHXDL&_nc_oc=AdqczNVdrQf0F-DhDHmD1IfSqYUt0m1851e0Ah2deZal6i0J64S2KO6PFQHvEbDajtw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKluRVsb-IF556wSqUhDRcZYGEK7uqiaa80HkUbszahlA&oe=6ABE610F"}, "display_name": "GestureMancerKing", "keywords": ["Gesture", "magic", "xr", "Spellcasting", "HandTracking"], "long_description": "GestureMancerKing is a gesture-based XR magic game that brings spellcasting into mixed reality.\n\nPlayers use natural hand movements to gather energy and perform magical abilities. By combining different gestures, players can learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immersive mixed real
4x0R2UZoSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvDvHIJ8ZIWOLvN2f3R3kgYAEGeV9yze632Rrv7gYIaA&oe=6AC3A7E7"}, {"file_name": "3.png", "id": "4348049612007991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_4348049615341324_7403757451395784212_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw8rPyMuNKYQ7kNvwHBCFj2&_nc_oc=Adqqg2OFF0IHCa4MFVpxwBX7ZCOQ8D6-LOfcbCc0hKcKhUfGuupxBwf3vOuKt_Jb03Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO362IySEiTByELR4bU1jzFOZyiwHF-g5tuHNEsWUf3Sw&oe=6AC3C55C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u5411.png", "id": "1643574634443073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1643574641109739_8264575913598213489_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaH9letErqkQ7kNvwEG9LCa&_nc_oc=AdqEBSr_0FHO0mSXLmNQtPtkp86eReOSKUo88mtq36g_e7srvg1TxOqDHTwUezwsYWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtgNX5ahh8hfHfB82BQxDTrNX23onuvbMX9bkOllNt7Q&oe=6AC3A70F"}, "display_name": "GestureMancerKing", "keywords": ["Gesture", "magic", "xr", "Spellcasting", "HandTracking"], "long_description": "GestureMancerKing is a gesture-based XR magic game that brings spellcasting into mixed reality.\n\nPlayers use natural hand movements to gather energy and perform magical abilities. By combining different gestures, players can learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immersive mixed real
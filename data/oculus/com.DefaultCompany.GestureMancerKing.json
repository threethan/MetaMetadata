W_QkPj9Ul8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGQuVEJaA5ZSYkBg0vyt4q3l39Jrl5VF-4QA7Arcth3g&oe=6A9431E7"}, {"file_name": "3.png", "id": "4348049612007991", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499310731_4348049615341324_7403757451395784212_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONVj6UC-ez8Q7kNvwExZj-j&_nc_oc=AdoGBfWHy-a-chfcL2GQy97ueldLIYT3VPDlVoSX9mW4e8NK5WqgnE3JuJHhY2uIGSU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ_PL7SuZF6tHP6B0xg_vgAUia9c27Ggi2ma3UbjRVvw&oe=6A94171C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u5411.png", "id": "1643574634443073", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823901_1643574641109739_8264575913598213489_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vDN14eDZegQ7kNvwF9Pq7n&_nc_oc=Ado6gaxcINygIsq_YeZNdG95l3FAgUj23BW3sLNHwFuWGp7eN5b2rYCPTESdStdkhxM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYstQCh0R9UNrcUTY9fnElZizg-KNMJ2rDNTxA_JczhQ&oe=6A94310F"}, "display_name": "GestureMancerKing", "keywords": ["Gesture", "magic", "xr", "Spellcasting", "HandTracking"], "long_description": "GestureMancerKing is a gesture-based XR magic game that brings spellcasting into mixed reality.\n\nPlayers use natural hand movements to gather energy and perform magical abilities. By combining different gestures, players can learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immersive mixed real
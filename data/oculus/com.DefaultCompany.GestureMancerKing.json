u622a\u56fe4.png", "id": "1636580938077224", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499620856_1636580941410557_6909170325005799300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7Ca4k2JQzsQ7kNvwEQCKjH&_nc_oc=Adpi175zYvbh_jXlXAgBMqkYQ9uFJ_ePl02YomE9ITmNaef6mNygmaXSmVxs0AA_7HI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6vzBxwJf9H0JK8BtDakeEbFf51L8fbgo3JmOFS6nQdw&oe=6AA9654F"}, {"file_name": "\u622a\u56fe7.png", "id": "1536185034558976", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620817_1536185037892309_221778998507008562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM2nzNDax2EQ7kNvwFTGgGr&_nc_oc=AdrNl56xIdTWeZJWMrOKzRh-DzlxewkCroVR-HhNojPiv7N3Ipwei7xlRwIZb-Rwfq8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqxefBNCtm9v_Chq2XHTKRjCz_rUHT5_hOS8mTDEhuOQ&oe=6AA93EC7"}, {"file_name": "\u622a\u56fe2.png", "id": "825214943745881", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491831569_825214950412547_1447669683052739955_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULwMzRuTxPYQ7kNvwECGI5K&_nc_oc=AdrmuYi4u6VdincO45Lq0aP9S1CMmz2onk7LvNx1k5wpB6KqyuKYzJw_4fHk38WNWWk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6QKdFFovBzE8QHyYToTvXVgLO0M_o6Ac3KqopBZQZew&oe=6AA93B53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GestureMancerKing", "keywords": ["Gesture", "magic", "xr", "Spellcasting", "HandTracking"], "long_description": "GestureMancerKing is a gesture-based XR magic game that brings spellcasting into mixed reality.\n\nPlayers use natural hand movements to gather energy and perform magical abilities. By combining different gestures, players can learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immersive mixed reality combat and explore the foundations of the world of GestureMancerKing.\n\nThis is an early version currently under development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gesturemancerking.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Hangzhou Magic Hand Technology Co., Ltd.", "support_website_url": null, "website_url": "https://gesturemancerking.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "25526211463675950"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1535075834668884"}]}, "baseline_offer": {"id": "1535075834668884"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781778480, "status": "PUBLISHED", "id": "1535075834668884"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28539029552394111", "version": "0.1.8"}, "id": "1903157233912978", "channel_name": "LIVE"}]}, "is_for_oculus_ke
Fj0-GvDGOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2lRBXyY5ADj9djWRviXpcl3E1kyDZOTNBfyx_-8kjOw&oe=6ABBBEE7"}, {"file_name": "3.png", "id": "4348049612007991", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_4348049615341324_7403757451395784212_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4Adx88sMlMQ7kNvwHqU-ou&_nc_oc=AdpewLwwCGkqSrzxMXj3MakDuNqXJffxP-ietszayOQ_gD55V2QVaYocHDW1j5O0PDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9gWc40cxszGOW-z80hgvEoNPJv2MsYl5YGhdkUcHxdg&oe=6ABBDC5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u5411.png", "id": "1643574634443073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1643574641109739_8264575913598213489_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjYk_LDXHOcQ7kNvwFeEGX0&_nc_oc=Adrw7MoB8NJ9ENRbCAkHg1hdphxogzNmGDEsX9E7lcgh-COQZJ5gYyJAj742EmyU0AE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqyNNuoq2gBZGKAoiEPlPfWOgSKQM5_8jveNLNSpKWHw&oe=6ABBBE0F"}, "display_name": "GestureMancerKing", "keywords": ["Gesture", "magic", "xr", "Spellcasting", "HandTracking"], "long_description": "GestureMancerKing is a gesture-based XR magic game that brings spellcasting into mixed reality.\n\nPlayers use natural hand movements to gather energy and perform magical abilities. By combining different gestures, players can learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immersive mixed real
f30f&oh=00_AQQQF6wS2-w40nrfIQXlrNyfKfaNKrs6yzLLiS6p-_3O3A&oe=6B0C8049"}, {"file_name": "\u521a\u8f9e\u53cc\u9f99.png", "id": "1646263100528962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839708_1646263103862295_609231741322000968_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DMaAt0isggQ7kNvwGVs0CR&_nc_oc=Ado5luGsUuJZbGmFkUzQb8KNrxmAs9JEL6P6lMKqthta0EnGGmBm8o1E4TedS9qWT1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBh3uj0oltWEmKB6o5pKizrko4KavAk7j3hWgzSjVSow&oe=6B0C6C55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u5411.png", "id": "1643574634443073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1643574641109739_8264575913598213489_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flf8z7Bfcv4Q7kNvwHpJ-Zu&_nc_oc=AdpRuCzH5Lku_sZCZFN_pjQVUBnyK_gZ__jlHruWPwatv-Mqbr_XO9-SxktwgL09sbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdG0w7OPf5OuSH2F7hK_7F9KZbx2Q66BkbBsOGws_xTA&oe=6B0C61CF"}, "display_name": "GestureMancerKing", "keywords": ["Gesture", "magic", "xr", "Spellcasting", "HandTracking"], "long_description": "GestureMancerKing is a gesture-based XR magic game that brings spellcasting into mixed reality.\n\nPlayers use natural hand movements to gather energy and perform magical abilities. By combining different gestures, players can learn the fundamentals of magical combat and experience immersive XR interactions.\n\nFeatures:\n\u2022 Gesture-based spellcasting\n\u2022 Energy gathering and magic release\n\u2022 Immersive mixed reality gameplay\n\u2022 Hand tracking interaction\n\u2022 Early access to the world of GestureMancerKing\n\nThis version is currently under active development. Content and features may change in future updates.", "short_description": "GestureMancerKing is a gesture-based XR magic game.\n\nUse hand gestures to gather energy and cast magical attacks. Experience immersive m
allations can take the form of intricate patterns.", "short_description": "Monke Tagging, A Gorilla Tag inspried game using their locomotion"}]}, "developer_name": "Fays", "developer_privacy_policy_url": "https://sites.google.com/view/monke-taggingg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fays", "support_website_url": null, "website_url": "https://sites.google.com/view/monke-taggingg", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9257664954309902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1097372912156817_4210225605319297156_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxd4EWUIqNsQ7kNvwGXU8oF&_nc_oc=Adq0czIYutdFXouol-0sDn-TXwKDR14n0e0pIxVKRHE9pZzp3kEZDTHU6fRsGat8RjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y0_fvTaqI-z_sAdKioSq70sn3W-VsqLlHVsexDKk0hA&oe=69D3C768"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monke Tagging", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "id": "1023770785722696"}], "release_
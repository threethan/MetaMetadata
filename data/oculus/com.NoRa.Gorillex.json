ploring jungles, scaling cliffs, or hanging out with friends, MonkeTag delivers the ultimate mix of freedom, fitness, and fun. The only rule? Don\u2019t get tagged.", "short_description": "MonkeTag Is a fun game!"}]}, "developer_name": "Zach", "developer_privacy_policy_url": "https://sites.google.com/view/monketagg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zach", "support_website_url": null, "website_url": "https://sites.google.com/view/monketagg/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9576994935758314"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9528387423952399", "version": "MonkeTag"}, "id": "852391803781892", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9357457614378715", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9528387423952399"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE",
31072_620655941471734_8386883373062160384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w22g6s7fHBkQ7kNvwGk7m4i&_nc_oc=Adq4gbqJMyjhLYlgnUDtSFosMC-eSI5Bv7BFPyjDC_OPoNEz2g9Y4flU2V6RDH0jz5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-HbHdbXmsn3nIoE4SPbIzu4BOT6d3Ks-I5h_g6mhJQg&oe=69DCCAF2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Perfect Burger", "keywords": ["burger", "perfect", "simulator", "cook", "fun"], "long_description": "Perfect Burger VR is a free virtual reality game.\n\nYou own a fast-food van. Many customers drop by to try your amazing burgers. Challenge your cooking skills, make the best burger in the world! There are many ingredients in front of you, be careful choosing the right staff you want to put in your burger. \n\nYou can play this VR game using VicoVR Controller if you want full body motion version of the game. Or you can play it like any other cardboard game in any virtual reality headset you like.\n\nWe recommend playing this game with VicoVR Controller to move your whole body in virtual worlds. More info here: http://vicovr.com", "short_description": "You own a fast-food van. Many customers drop by to try your amazing burgers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1gb6u80TLVKY6axRd0P-zD3tJz0VkGyrg/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "s
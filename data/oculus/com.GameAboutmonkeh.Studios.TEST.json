nc_sid=6e7a0a&_nc_ohc=R8ff5u2wIsUQ7kNvwE4qbRO&_nc_oc=Adr7m3SHCnAfDjQAFlp8KzeAL_dBNJP20qYrG_l0bkXkcfuXFxECDQHCQBUOp7omWnk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_1JxY0rMeSp0fIwvbNKLSk3Trf3rrnLUSRro1jcBw1A&oe=6A7C7A26"}, {"file_name": "TSGF 4.png", "id": "26081721884812301", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_26081721894812300_6310809267229459714_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ceP2RXeeb4Q7kNvwGExnlO&_nc_oc=AdrsW40lh2i3wpjoFtYGm61ua3jkTUv9Wvj6UAt2f4-x_1x7QTfgXfGR71WWs26aT-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF3SruRB72xmw0j4cZi4fj6X2J0aXXC6Pfk4wvIoIfsw&oe=6A7C6839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Copy of Game About monkehs.png", "id": "892495493572150", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_892495496905483_2662264978361586052_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG6sVkPGh88Q7kNvwEH7GOt&_nc_oc=Ado08tBeHaIP0T_Osx_uUWONjW1z9IABXdebCVVZ30NbzsOJwAujcor4vozDRN0UPHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWaKnjFxuTp1tVUDoqGPs1h0dGq-wsWAWYW6-Yp4IsdA&oe=6A7C6371"}, "display_name": "Game About monkehs", "keywords": [], "long_description": "Leap into a wild VR jungle as a playful monkey in Game About Monkehs! Swing through trees, climb cliffs, and explore vibrant, immersive environments packed with obstacles, secrets, and surprises.\n\nWhether you\u2019re playing solo or with friends, the game delivers fast-paced, chaotic multiplayer action. Race, dodge, and outsmart other monkeys in hilarious challenges that keep every session fresh.\n\nKey Features:\n\nImmersive VR Jungle \u2013 Stunning environments full of trees, cliffs, rivers, and hidden paths.\n\nPlayful Monkey Movement \u2013 Swing, climb, leap, and vault with intuitive VR controls.\n\nMultiplayer Chaos \u2013 Compete with friends in real-time, mischievous monkey battles.\n\nDynamic Challenges \u2013 Obstacles, puzzles, and surprises keep the gameplay exciting.\n\nFun for Everyone \u2013 Easy to pick up but full of depth for advanced VR players.\n\nWhether you want to explore, compete, or just go bananas with friends, Game About Monkehs delivers a unique, energetic VR experience you won\u2019t forget.", "short_description": "Become a playful monkey in VR! Explore, climb, and race friends through wild environments for hilarious multiplayer fun."}]}, "developer_name": "monkeh.Studios", "developer_privacy_policy_url": "https://dandofly.github.io/game-about-monkehs/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "monkeh.Studios", "support_website_url": null, "website_url": "https://dandofly.github.io/game-about-monkehs/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "34530749796571425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_2205687099962293_1106672142931492464_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-5kUZ714D0Q7kNvwHBV8LV&_nc_oc=AdplGLJpXxtF6v9irEA7p_7yF1INGwPaApPFEcpClHTNkFfnAReqqEpcm2BORgdvK98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHBNznO71QhqfFpMffKjK9O_g_itMBzgBs3zg-Efgzpg&oe=6A7C7172"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
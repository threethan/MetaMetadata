file_name": "4.png", "id": "1336519291953046", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827585_1336519295286379_7610522606019899134_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeErcIODAFgQ7kNvwGQudgx&_nc_oc=AdrUaNgospHncNybSLJVI4ggM6SVmqbp0eL1h0cA2cmG7eQaozMm5zUbxslj_btYyG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK8pmeA6JTuBoShLrQMkjMC9sDPN1h3UQ99g-Z1-WFog&oe=6AFDD9E3"}, {"file_name": "5.png", "id": "2104564173736443", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_2104564177069776_781910191940402849_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftnmyQqFk3sQ7kNvwFWycom&_nc_oc=Ado1EE79HvOh3-A2-GKole_g2_dgdhVZKIlD7Mhqpwm0ZGEERJISDB-KhgUpu4ZXS5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3cQViy3GoVosBp0mgE2y35kmilxna3xQ7oF_g3Q4yvg&oe=6AFDDBB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArtEX VR", "keywords": ["Art", "visual", "paiting", "museum"], "long_description": "This is a visual exposure\u2013based immersive art experience for VR, designed to be accessed through the ArtAICare platform.\n\nThe application places users in carefully curated virtual art environments, where controlled visual exploration encourages reflection, emotional awareness, and meaningful conversation within a guided creative context. The experience focuses on personalized visual journeys, supporting self-expression and introspection through immersive art and interactive environments.\n\nThe app is intended as a creative and experiential tool, not a medical or therapeutic application. It does not provide diagnosis, treatment, or clinical intervention, and it does not claim to function as a medical device.", "short_description": "This is a visual exposure\u2013based immersive experience in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/priva
file_name": "4.png", "id": "1336519291953046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_1336519295286379_7610522606019899134_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct0iGKPbalcQ7kNvwHxkDQ5&_nc_oc=AdryqCDQISbhW14BQ5bNn4uydMFDWMupWcCMYYoH0jWO_0kfaCzfZuoqRsbufKS9tdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlDCtyTsGfn4DLINkW-kLTgeXJdHbeepuZHyyI4sYifQ&oe=6B05C2E3"}, {"file_name": "5.png", "id": "2104564173736443", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_2104564177069776_781910191940402849_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHbShiOHxhYQ7kNvwG6kX9D&_nc_oc=AdpPTb-JDCV3Oz8QZJKkBpvl3tRl7Mq147W259uhPbfwHJzVrpNHId37SxqeG2VwPO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44e4nLGsyF8i3F-Bttw4wFt2O69lClW9DDLgBriL7XQ&oe=6B05C4B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArtEX VR", "keywords": ["Art", "visual", "paiting", "museum"], "long_description": "This is a visual exposure\u2013based immersive art experience for VR, designed to be accessed through the ArtAICare platform.\n\nThe application places users in carefully curated virtual art environments, where controlled visual exploration encourages reflection, emotional awareness, and meaningful conversation within a guided creative context. The experience focuses on personalized visual journeys, supporting self-expression and introspection through immersive art and interactive environments.\n\nThe app is intended as a creative and experiential tool, not a medical or therapeutic application. It does not provide diagnosis, treatment, or clinical intervention, and it does not claim to function as a medical device.", "short_description": "This is a visual exposure\u2013based immersive experience in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/priva
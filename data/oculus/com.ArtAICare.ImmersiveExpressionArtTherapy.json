file_name": "4.png", "id": "1336519291953046", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491827585_1336519295286379_7610522606019899134_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuy-LVJH5W4Q7kNvwEhJfub&_nc_oc=AdqpQBd56Ii3xswAAI92aByq48AS3MWePEuRFPMAfVXHW7ehXFxh45p1I3Y6ZNPid9g&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRE0jsp7irgVkC0brH2d8-o2Y8AqmfD-YnQdeT47fbSQ&oe=6B0865E3"}, {"file_name": "5.png", "id": "2104564173736443", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824322_2104564177069776_781910191940402849_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-DpGuhMMgMQ7kNvwGYU-iz&_nc_oc=Adr_zO-xkTO2l_IGAahaF4xphZ4MFESb8keUtxc80jruf0ypuf4zBqApiafTqNK27fg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUwH0_Sm68kcnHKMNa9MC2y6ZcAUr3UC6Mf__xOGpvaA&oe=6B0867B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArtEX VR", "keywords": ["Art", "visual", "paiting", "museum"], "long_description": "This is a visual exposure\u2013based immersive art experience for VR, designed to be accessed through the ArtAICare platform.\n\nThe application places users in carefully curated virtual art environments, where controlled visual exploration encourages reflection, emotional awareness, and meaningful conversation within a guided creative context. The experience focuses on personalized visual journeys, supporting self-expression and introspection through immersive art and interactive environments.\n\nThe app is intended as a creative and experiential tool, not a medical or therapeutic application. It does not provide diagnosis, treatment, or clinical intervention, and it does not claim to function as a medical device.", "short_description": "This is a visual exposure\u2013based immersive experience in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/priva
 in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ArtAICare", "support_website_url": null, "website_url": "https://www.artaicare.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ms", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28564078633244814"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_4596507863915953_3989702276673546605_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EwXoclh6jgQ7kNvwGA9_Ig&_nc_oc=Ado-HtJVlrTDmIi05AJqS4-ieZgHsNQOUU98MqMYTdUGKKWOFbnfMvmUrbFBi1cRemA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlVEI8Epz5vYSniqJdPgb1QAfvRzQ4JE0UybqQTvPH0Q&oe=6B0DB6FB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ArtEX VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1783325640, "lastRevision": {"nodes": [{"id": "25349044951414881", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25349044841414892", "is_first_party
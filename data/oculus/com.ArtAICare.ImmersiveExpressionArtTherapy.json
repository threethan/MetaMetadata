 exposure\u2013based immersive experience in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ArtAICare", "support_website_url": null, "website_url": "https://www.artaicare.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ms", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27410645435254812"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827585_1963511487684638_9030841542382916369_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhO1TAvZiT0Q7kNvwEsiMOV&_nc_oc=AdpU-CNZqGeOsKcw93M_sgd2J_CHtlsb6z6wKgqFmwG2gV1fUYxEikY5EE928vs4zPA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8UxM0mXkDhuPoGmGs6FL9H4EjPnhThtHb8dtVv1Q0aA&oe=6A941B7D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Immersive Exposure AT", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1783325640, "lastRevision": {"nodes": [{"id": "25349044951414881", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2534904
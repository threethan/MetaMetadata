file_name": "4.png", "id": "1336519291953046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_1336519295286379_7610522606019899134_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KhotI4OfpIQ7kNvwH896T1&_nc_oc=AdqVM9jU8ZBCtuq6POBVn3_V7njgcG5vDkLrmkK85-qss9FK9deEd3PlG9nA3n2bhu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhFlERcHR9pEa6tn6Zc157uVgRdP7YQSzZ6243ww_TyQ&oe=6B007CE3"}, {"file_name": "5.png", "id": "2104564173736443", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_2104564177069776_781910191940402849_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYdbCUT7geYQ7kNvwH375gn&_nc_oc=Adq1xJ0woKNeB8qIehZ_O2XAIk1ydB3s-OSz0qB7kRj8Dr2ZpITSdIuOG0CLP7moZro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtm8iAoZTsMC7rZOTw7c-n7TX-G7G-DTZvSjo9Fw65Ag&oe=6B007EB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArtEX VR", "keywords": ["Art", "visual", "paiting", "museum"], "long_description": "This is a visual exposure\u2013based immersive art experience for VR, designed to be accessed through the ArtAICare platform.\n\nThe application places users in carefully curated virtual art environments, where controlled visual exploration encourages reflection, emotional awareness, and meaningful conversation within a guided creative context. The experience focuses on personalized visual journeys, supporting self-expression and introspection through immersive art and interactive environments.\n\nThe app is intended as a creative and experiential tool, not a medical or therapeutic application. It does not provide diagnosis, treatment, or clinical intervention, and it does not claim to function as a medical device.", "short_description": "This is a visual exposure\u2013based immersive experience in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/priva
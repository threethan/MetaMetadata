file_name": "4.png", "id": "1336519291953046", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827585_1336519295286379_7610522606019899134_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YYO4VSZE-wQ7kNvwF_PLmR&_nc_oc=AdpNXhy6YJ-jHmg3t2nsOBE0x3Jk2OhbtBjqxOnCQAlDbSU2b_57wi-ozDCcNCA4vj4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8uAhxQpcZYfXBg0qOz8pnV5TsNHHObkrWoIgzDubl5g&oe=6B0B4123"}, {"file_name": "5.png", "id": "2104564173736443", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_2104564177069776_781910191940402849_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM77VnGeRZoQ7kNvwHbeM6c&_nc_oc=AdqDVWbWbkjE0zDcU5a30TqT2zcrMN_Xa63iVoYumLPkcYbn3DsEP5urWtHoapdu-_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTP5N1FBD0zKmXPCV26KwZ2h0g8PQRFTTQ_0qPHw-Q4ow&oe=6B0B42F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArtEX VR", "keywords": ["Art", "visual", "paiting", "museum"], "long_description": "This is a visual exposure\u2013based immersive art experience for VR, designed to be accessed through the ArtAICare platform.\n\nThe application places users in carefully curated virtual art environments, where controlled visual exploration encourages reflection, emotional awareness, and meaningful conversation within a guided creative context. The experience focuses on personalized visual journeys, supporting self-expression and introspection through immersive art and interactive environments.\n\nThe app is intended as a creative and experiential tool, not a medical or therapeutic application. It does not provide diagnosis, treatment, or clinical intervention, and it does not claim to function as a medical device.", "short_description": "This is a visual exposure\u2013based immersive experience in virtual museums for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therapy.artaicare.com/priva
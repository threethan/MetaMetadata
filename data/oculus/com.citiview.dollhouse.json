595209870614_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLsUsfwq0_IQ7kNvwGe4YjK&_nc_oc=AdpooxyEHEwI--qBJWtlkXNWbJXcth-ZI8Ve7iDDaa7Ce3XYC87ZrFlGfAVYbJSAeFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqFx28zijBT0CfYG8UI5RIOhf4RQexmN6CUJPk2zhU1w&oe=6AFDD487"}, {"file_name": "screenshot_3.png", "id": "1759658661986734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596068480_1759658665320067_1376020564261642969_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUfIfl9hb3YQ7kNvwFC0oMg&_nc_oc=AdpfOOW5JYtHSBu38E8EqsdCCBb857C5u5zmnphW04caiYZ2dMFSdWKguuu95XqLbEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkvQXIDqaJE6-s_FQQkieoztIAc-_njm58RaKmPdttsQ&oe=6AFDD07A"}, {"file_name": "screenshot_4.png", "id": "1751119689504164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_1751119692837497_5189833947987691770_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-lyUCxSz2oQ7kNvwHS9sbr&_nc_oc=AdrKCdicvCqJAYcVfMskTL1AhKXCehezYJfEGhisElaWEWup_tf49X4w68pgx3YQgkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4ujLHNiLEB8lT5r0oJJJGTHPOmC6npa8gR-sN2mdkZQ&oe=6AFDBD95"}, {"file_name": "screenshot_5.png", "id": "1508766944620892", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673759338_1508766947954225_1014456928341405067_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Irhh4kS7qxEQ7kNvwGJmUe9&_nc_oc=AdpdiCREo_rOlcOEulWk7JRuA3yfdpeBZhL9TDVCcu5HQTSQX8DDdnapK3551ASkXz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQznz1_d6BjRdTzGN2Rbxfxc6EMLAboRyepnwEdisDAZg&oe=6AFDE4B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1883504469288131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596068480_1883504472621464_2129249541593281658_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw0TmMJvijsQ7kNvwGhVdKH&_nc_oc=AdodwCeO6FNfgtI1CgwPPcHdhn6jv3akTyspHWTeFgTvRCAvaO-1QvYpgVedbuzv_Ys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDcASPekg6a61nb0NYKrxmpZJxzMeBjyPOtdXigEyOhw&oe=6AFDC291"}, "display_name": "Dollhouse", "keywords": ["dollhouse", "mansion", "family", "sandbox", "simulation"], "long_description": "The dream house. In your hands.\n\nA MANSION DOLLHOUSE\nA grand two-storey mansion on its own estate: an iron front gate, a round-about drive round a fountain, a columned porch and balcony, a pool, terrace and gardens. Look down on it like a giant, lift the roof off with one button, then lift the upstairs away and look straight in.\n\nTHE CIRCLE MENU\nPress Y and a circle menu opens with nine categories: People, Living, Kitchen, Bedroom, Bath, Fun, Outdoor, Cars and Decor. More than 70 pieces: sofas, a grand piano, a marble fireplace, a clawfoot tub, a pool table, an arcade cabinet, a hot tub, a trampoline, a fire pit and ten cars for the driveway. Point, pull the trigger and it is there. Grab anything to move or turn it.\n\nPEOPLE WHO LIVE THERE\nSixteen people to move in: a family of four, a butler, a chef, a gardener, friends and neighbours. They cook, sleep, swim, play the piano, dance, chat and climb the grand staircase to bed. Point at anyone to tell them what to do next, or pick them up and set them down anywhere.\n\nGO FOR A DRIVE\nSend someone out in a car: round the fountain, out through the swinging gate, and home again later.\n\nSTEP INSIDE\nPress A and you are standing in the mansion at life size. Walk the grand hall, sit by the fire, look out from the balcony, then tower over the estate again.\n\nDAY AND NIGHT\nThe sun crosses the sky and the lamps come on at dusk. Pause, play or speed up time from the menu. Your house saves itself.", "short_description": "Your own mansion dollhouse in VR. Stand over it as a giant, lift off the roof and fill every room from a circle menu of furniture, cars, toys and 16 people who move in and live their own lives. Place a hot tub, park a sports car on the drive, carry a guest up to the pool, then step inside at life size and walk the halls with them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/dollhouse/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/dollhouse/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345155178677345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_1395911879413721_6654113939524664466_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snnKGqTAmcMQ7kNvwHHx_2s&_nc_oc=AdonEHSy_h8RxMQM81HDRkHpnmLENEYADrHgYZP4WgDcs4w3FLDjBJJAMc_SwSWMhKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4_KHv4g9_RRC_OHrxdzmAb46d4mHkbcTGYEQM5UXkKA&oe=6AFDDCE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dollhouse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "19901040514
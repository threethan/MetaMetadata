&_nc_ohc=-OBSqwS9Yk4Q7kNvwFtP8g0&_nc_oc=Adq6B53OUDeOCiK1aDegmE9ivxD_HkXIpRYvUpe_8bY__u6ZoO0TgMoP20dPtBxeoSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmP6u0JeKwT28tHCSZY3QAHubLCCahyxAFiWh1d5mhtA&oe=6A996D71"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FivGLc8Y3nwQ7kNvwEeTi94&_nc_oc=AdocTwxUD4KfTRYiTNFdkofpEe4zRO9PgezvlFhcQ8zZ-WgPev5DLIDa0JUgW5mdz2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5Stw5u543le4XVOcImEmJKwEJpulKXO4A_LB57-4pcA&oe=6A997317"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-09fqE8PGwQ7kNvwHG4ixu&_nc_oc=AdrEG8ktqKlNCCQ1DEchQbBYayTvY-T8mlDRZZ8NM94hE3gzD8ndCN2Amrlkow6tGek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLft8VikWtl3H3Z0Lwniz7pBJNBmuri5EBVn5SyJpeutQ&oe=6A997DE6"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-HGiP0YD80Q7kNvwEA_w-B&_nc_oc=AdqB80-t6nPHSYCixjYGcyY3JBcXp8nUNrraTtZtCvZeStM9uKRUNUegFuPUt_KUfL0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaaDtihnAOGiJzedjN9fTrTPk7iNyUxktXbPkliJ0xpg&oe=6A99985A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDZt_rJpPtoQ7kNvwFVHAbC&_nc_oc=Adoln8oTpEcw50YVDt0PAGhRojnzfpI1c_oKtzlb7fb77K5ODfphA1zSohamzi2rpMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAa-G0aIyq099TKjaX-SAT8kbe5HzNxczOpPauyMcYKg&oe=6A9971F4"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "
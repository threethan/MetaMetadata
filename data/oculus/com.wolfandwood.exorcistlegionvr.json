&_nc_ohc=eYgDakCal5EQ7kNvwGUDk7p&_nc_oc=AdqpJ4o1tC95JrpXRgoUg3zzAb0HT06vpYBwY7suhkhEs8iuiY5CP8IGynq_9Ce5qWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmkhYSGyg693RV6avcjAk0PjwPLnOD9h_rMadbF9pndw&oe=6AA69C71"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkTellRR2Y8Q7kNvwF4HQc_&_nc_oc=AdoZdr3paY7SWlU55aT5YMh5FFucn-2xj7vKeJXBM36OSZ8KP2l97Zk19DCtLGIsDTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjiS3m8ROxO0UfXf8OKYhwrlPsbmZmmHROL7lixLkSWg&oe=6AA6A217"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPQ_PjOOtnQQ7kNvwEH1Vta&_nc_oc=AdoS4VeIYSgcORsgXchgt9sA76W8XuHdgYoIr7rrw_tx7mHJDwyXvwREPPpDO5qjMBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7YtFwuwLwyaEL188lQATQO7TqPH-krIg0F7QlL-MiQQ&oe=6AA6ACE6"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l4UtTKM3VgQ7kNvwE5Mika&_nc_oc=Adp-63N2xf2XQir1IOqJSYrm0UdZeGikQa6JkGbINZtCPDPHD1-Gl9yFTkJW3Aun8ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVmx7GY_Cjo1krxZx7m6ADXrUdA04ZvmX8Zj9SskAY4A&oe=6AA6C75A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoymtGCPMrUQ7kNvwGD_xuo&_nc_oc=Adp0MDLFgqb8fbtrPeEjaArxuvnphmB3IBS24_bh3sZlFshPOf5RX24akjl3q0dJIog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXedxYJjdQPR4o-21bvk8hdIdTtZn58jwb6FKXNRHiUw&oe=6AA6A0F4"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "
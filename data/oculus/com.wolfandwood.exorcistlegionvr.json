//scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303971_1542704200173966_6069929234334566004_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s-vfbDZKbMQ7kNvwEQDok9&_nc_oc=Adrc58D9Wg18jfkEjeCiqxJvBUvy-IKYlmU-LrV0Fl-MZDdXa1AnTtsBDJS9TuCO5PA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gOWxFcAxK8qkxwRDyltYdMcP1qVDIkVwD7J2XziTDJg&oe=6A1DA6C1"}, {"file_name": "EOTL-Meta-Screenshot-5-2560x1440.png", "id": "1778627759413270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823893_1778627762746603_7567165976082583616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGN7vePnl-cQ7kNvwGrlVpK&_nc_oc=AdqGIfhkRt-lufI5p96PihlPlDoY4D-jSf-LXIcKMJz-3HWCwWp3fYFDdDwsJyJniaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EV4I1ARSA8QZUOcBaDGC6XaSgcRRbjwKxLIPF5RssZw&oe=6A1DAC75"}, {"file_name": "EOTL-Meta-Screenshot-3-2560x1440.png", "id": "2212488402613289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507935159_2212488409279955_1152715862022481737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScManBtPfpoQ7kNvwFm8IST&_nc_oc=AdoeCY0iymOktlm2UntVYgHh0AqcncKVUh3i1T2b01T7GbCr-HaCdZUBCZugiAuOV3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LufQ-8inRb_4Mi69suqaGmILbKQOGr87SfHt_lp7cvw&oe=6A1D9379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EOTL Meta Trailer Cover 2560x1440.png", "id": "2860563464145636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298502_2860563467478969_5731237755906144137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU0_hB97ZqIQ7kNvwHxepYa&_nc_oc=Ado1RrB0JY8LXUOofr2JCCJ-m6reDI3SVQ3BF9aJFxPNt1NXjGOc8ijuUJHZ5ZmoDr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ujx0qV2iQKUojQ9NIl1Qd6L1TeDjU_SQPN-VIR0fh9A&oe=6A1D883F"}, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": ["Exorcist", "Horror", "Demon", "Scary", "TheExorcist"], "long_description": "Experience the game called one of the most terrifying experiences in VR. New name, new terror.  Now enhanced for Quest 3 and optimized for Quest 2 headsets. Described as one of the most disturbing experiences available for virtual reality, the game features connected stories and features a variety of demonic entities, exorcism tools, hidden artifacts and atmospheric locations. \n\n{534597808967949}\n\nThe Exorcisms epilogue update brings new content that extends the ending of this VR horror classic. Complete all five chapters first to access this new epilogue, if you can make it all the way through.\n\n{1463790964338165}\nDelve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\n{1568767000721557}\n{1072124544621378}\n\nThese exorcisms are part action, part mystery, part puzzle-solving... and ALL terror.\n\n{3783494471909456}\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of  LegionVR, LLC.  All Rights Reserved.  \u00a9 2026 Legion VR , LLC", "short_description": "Exorcisms of the Legion (Last Rites)  is an acclaimed horror game named the most terrifying game in VR.  Now enhanced for Quest 3 and 3s.  Delve deep into the heart of the supernatural as you learn the ancient trade of demonic exorcism and uncover a supernatural conspiracy. "}]}, "developer_name": "LegionVR, LLC", "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train, Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/exorcist", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "exter
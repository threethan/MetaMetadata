{"data": {"node": {"__typename": "Application", "id": "1947925211962268", "organization": {"id": "480274042320720", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "2265255760180455"}]}, "id": "1061889187354314"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1947925211962268"}]}, "id": "251215095548174"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1318587074930260"}]}, "id": "1632657750086789"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1137056446394476"}]}, "id": "354055318348412"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1947925211962268", "release_date": 1558458000, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 66}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25797473126580809"}, "id": "279038272817289"}]}}, "binary": null, "live_binary": null, "created_date": 1792604738, "id": "28722529590741800", "is_initial_release": false, "name_with_fallback": "v21", "pdp_metadata_with_fallback": {"version": 18, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "28728697956791630"}, "release_status": "RELEASED", "id": "1947925211962268"}, "id": "28728697956791630", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1947925211962268", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "219306551208577"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2571319109959579", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": [], "long_description": "Vive el juego considerado una de las experiencias m\u00e1s aterradoras en VR. Nuevo nombre, nuevo terror. Ahora mejorado para Quest 3 y optimizado para los visores Quest 2. Descrito como una de las experiencias m\u00e1s perturbadoras disponibles en realidad virtual, el juego presenta historias conectadas y una gran variedad de entidades demon\u00edacas, herramientas de exorcismo, artefactos ocultos y lugares llenos de atm\u00f3sfera.\n\nLa actualizaci\u00f3n del ep\u00edlogo de Exorcism trae contenido nuevo que ampl\u00eda el final de este cl\u00e1sico del horror en VR. Completa primero los cinco cap\u00edtulos para acceder a este nuevo ep\u00edlogo, si logras llegar hasta el final.\n\nAd\u00e9ntrate en el coraz\u00f3n de lo sobrenatural mientras aprendes el oficio del exorcismo demon\u00edaco y descubres secretos que te llevar\u00e1n a un enfrentamiento final con tus miedos m\u00e1s oscuros y ocultos. \u00bfTe atreves?\n\nEstos exorcismos son en parte acci\u00f3n, en parte misterio, en parte acertijos... y terror en estado puro.\n\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of LegionVR, LLC. All Rights Reserved. \u00a9 2026 Legion VR, LLC", "short_description": "Exorcism of the Legion (Last Rites) es un aclamado juego de horror, nombrado el juego m\u00e1s aterrador en VR. Ahora mejorado para Quest 3 y 3s. Ad\u00e9ntrate en el coraz\u00f3n de lo sobrenatural mientras aprendes el antiguo oficio del exorcismo demon\u00edaco y descubres una conspiraci\u00f3n sobrenatural."}, {"images": {"nodes": [{"file_name": "EOTL Hero Cover Update 3000x900.png", "id": "3203706450017543", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294643_3203706453350876_8056353075721022055_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOnxa5n0kZcQ7kNvwEde-vG&_nc_oc=AdrlkWVpW4-LtUKYq_eWHN-UNWn59VVO_fsP9mOV0PeCrj-e6_iJAVJIfCubdkCXwnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm5GQL093iZeFHBp3-Nt9DkGPyVVnhUl3mib2UiCfCpQ&oe=6AE9FF7F"}, {"file_name": "EOTL Square Update 1440x1440.png", "id": "2072008110019063", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499625099_2072008113352396_8114539448815894278_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWg-AXRdjz8Q7kNvwE6_k3D&_nc_oc=AdqeSEgEPjpSdEXhut_k9eZhvPca1GEDF8XAtpUu1WxiiZDALPG5Do90RnctnwlVUiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLhtjSeLO3Hm97_zsbGlr67tetJALNGvWwisnACAT5TQ&oe=6AE9E94F"}, {"file_name": "EOTL Icon 512x512.png", "id": "1654252322357957", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295481_1654252325691290_3990013577262995309_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vusLn2pJbT8Q7kNvwG8GcFP&_nc_oc=AdpnGv8i_7a7b5RFiKADGx-mNw1AHOQFrovgTa6bZnzl5vy80vnJFpZY1dDjdn9XwN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJXO8qidH9__ZUwdDJ4C95bnCR9n0KO7qMOxR9JNSk-g&oe=6AEA0B64"}, {"file_name": "EOTL New Keyart Meta 2560x1440.png", "id": "1646232846587261", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296125_1646232849920594_6470790150310220045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJZw1kr2jrYQ7kNvwEHqFIE&_nc_oc=AdoSht_sLanwnzUATdbXKYzlaQXIAbLPmZrb10UAW6dZayorXCv5fDqxvAPVBZD_9Yc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTk0Uj27N12TY0XD5uzufQdjuem-gfVNZ9BFbvFXc_VQ&oe=6AE9ECB9"}, {"file_name": "exorcist_400x700right copy.png", "id": "1421330141705800", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974567_1421330145039133_6159498768821136364_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_o
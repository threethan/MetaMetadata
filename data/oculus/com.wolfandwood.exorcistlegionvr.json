PMritvGl88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy02YfFNktC5sTf3WVOHqD-E6DvtnpDSLSdW8rRjLh6Mg&oe=69B559F1"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-1yPoLza1gQ7kNvwHBcHWW&_nc_oc=AdmttvT1yRXwQWjA0HkV6PxmH7A3HV2I5Y2iasowQqdTivZ7GFjMjQnkXRXODiV1M5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwECSvvEbmWkw-6m_GL1MGO_4gGELkTlALXI4cdLcJNGw&oe=69B55F97"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxO8DIJRGkEQ7kNvwFqjcn3&_nc_oc=Adm6FNO_nrDnleYDfa1l2fWongl55g6bq1LTDdbfA0eeLHTela-bBlLU6rlL1YAnRPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKuWoOA9CyTg-zqnes0tqafWEcaiSe51kJkCRBgsA-5g&oe=69B56A66"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzhFxktPRzIQ7kNvwH6IHlQ&_nc_oc=AdlopqaYfjkT-BnFMXA_01JipZ9dz4rP7n07orIyOPAj6GwETVQ1bGSi9fQHnwTfpn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfylIBXQiZpL3EufNXgBRR_gTX4OGnhjxIAFXFuLig3cJA&oe=69B54C9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V6nP9ukSV4Q7kNvwFVmDV6&_nc_oc=AdmsPbVAwB2cr516IPAnid0dhJeMJSwGRaF7SIfMVRgnTSbcTsfNIxifzofwUAL7iwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyhks88WFXDDl33mzKZulnFhxC6ubzjzWLWjrryDCdUfA&oe=69B55E74"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "26918901644604
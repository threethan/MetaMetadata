McGGk9A6CI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzpjF5xu10DLq89HtQSjOKkz9Gynk_TrEB3SqXvGdEEvg&oe=69B2B6F1"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-1yPoLza1gQ7kNvwHDq17b&_nc_oc=Adkr7ijEbvrBPrG5V7ohixiy2_AjbIQMzreYuygf9ZkntxE1_meOriewjKvJC2KJUaA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyW4BiRHvxjzCMhkqmZ8kJum7-uaxlBpAvAwZTzwiovcQ&oe=69B2BC97"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14s_sbD2wM4Q7kNvwHtLLG4&_nc_oc=AdlZb9D8xr8Rv475-KsjvsWSjtyLqF9TwTQD9yyZDI_YSx78tPrS_Fy33o5ly3fqoLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5N4zhYfvQ7epiYSGFL4_lKNBn4FsEAzi3OKPMQaSu8A&oe=69B2C766"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMB2FXeNW1gQ7kNvwFclBF6&_nc_oc=Adm_Xk2NCShbEAoZfwcGYMv8XE4Q4w-1CA2O8qqZoblDzexd619VVdwGCG4LE9Ue3oM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzF074mmZylW1Pb_VX_rOfixhgnWQQoR13qVLCBhgouiA&oe=69B2A99A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f14y5ZgvyewQ7kNvwGtOttF&_nc_oc=AdmxeSctx-T7qRr2CgudAfwJKnyQIFGbH2f1HfEcBVAv0-vWVqHta7TbCiVAGx6cRJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUqF-VzZq-ruU6CFuN7VRYlxvikD7y_BxFswbUE41Ihw&oe=69B2BB74"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "26918901644604
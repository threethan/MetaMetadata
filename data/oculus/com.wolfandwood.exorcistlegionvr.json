a0a&_nc_ohc=_sqJ5JbQH6oQ7kNvwHCSpoU&_nc_oc=AdpCaj3CtqBbO8BpwQgF8XMmRA_JpovVmf7mYy0OzzqYpB2p71pZriv0-cfnErMIHQQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1bi4dZivuQaWR2hrSObwU-1-7Qh7igKGeA-kfvuZToxA&oe=69F1ED01"}, {"file_name": "EOTL-Meta-Screenshot-5-2560x1440.png", "id": "1778627759413270", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823893_1778627762746603_7567165976082583616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td7YuxH0swQQ7kNvwFE5c4i&_nc_oc=AdoUs9yHwGldqLyFGjK82ofhETDCjIuvRU5aYLWp5gaieO2JWq2XLJuzlnrRRKJOY28&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0OmosU7gk0FK4TqNnrZDhrvu83FkBP6GlaF4QGpwiZIA&oe=69F1F2B5"}, {"file_name": "EOTL-Meta-Screenshot-3-2560x1440.png", "id": "2212488402613289", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507935159_2212488409279955_1152715862022481737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2XIQhFkNpMQ7kNvwGwcT5I&_nc_oc=Adq4ATnfIPmsIFV17CWgzAgyNTEolGDHWtd9kA3vtXhQsXljETGN4qObIjK9pPudPgw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3UjO_L-pbKe-Fz8uIC-d6bU5Fm_8k-vdFh1IpZ8WDRrg&oe=69F211F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EOTL Meta Trailer Cover 2560x1440.png", "id": "2860563464145636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_2860563467478969_5731237755906144137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrAVl2jy8x8Q7kNvwEzxCE0&_nc_oc=AdodCjSTb7rsAnxCWJxrosROnUeCRqyFzhD-CwLyAWr61MWYW7RdvbNPVpprqddZjyQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0y-eNAqn3590m8aMckmu3AXOMQ8wCVgkWLnlgoUKCVoA&oe=69F206BF"}, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": ["Exorcist", "Horror", "Demon", "Scary", "TheExorcist"], "long_description": "Experience the game called one of the most terrifying experiences in VR. New name, new terror.  Now enhanced for Quest 3 and optimized for Quest 2 headsets. Described as one of the most disturbing experiences available for virtual reality, the game features connected stories and features a variety of demonic entities, exorcism tools, hidden artifacts and atmospheric locations. \n\n{534597808967949}\n\nThe Exorcisms epilogue update brings new content that extends the ending of this VR horror classic. Complete all five chapters first to access this new epilogue, if you can make it all the way through.\n\n{1463790964338165}\nDelve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\n{1568767000721557}\n{1072124544621378}\n\nThese exorcisms are part action, part mystery, part puzzle-solving... and ALL terror.\n\n{3783494471909456}\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of  LegionVR, LLC.  All Rights Reserved.  \u00a9 2026 Legion VR , LLC", "short_description": "Exorcisms of the Legion (Last Rites)  is an acclaimed horror game named the most terrifying game in VR.  Now enhanced for Quest 3 and 3s.  Delve deep into the heart of the supernatural as you learn the ancient trade of demonic exorcism and uncover a supernatural conspiracy. "}]}, "developer_name": "LegionVR, LLC", "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train, Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/exorcist", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
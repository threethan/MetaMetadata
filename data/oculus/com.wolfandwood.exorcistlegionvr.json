me": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfE_PhELrGcQ7kNvwHtCTcR&_nc_oc=AdoiaLS9dMNc2d9dO_k0Vgx6w7LxbcuLw_gpIhbw4sCuOLU94iVGzviYjQG9hjwaB5Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3KnYsV_5epi9xjyk02CAVNRqeODhW1NPFm57igKmRqig&oe=69F20497"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mykx0ax7cAUQ7kNvwGH5ztO&_nc_oc=AdqAMseRagH9WfiEjqSay5uShF92pUuKC0gJDh1iDfw31W7wcnPTe_vkG7paELO3SVA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0wKk5tOQYPVjf2ySJsrp0SDPHkIvacJOndX0nMq58ntw&oe=69F20F66"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0av-2Z6WoIQ7kNvwHTVgMN&_nc_oc=AdoGviy7Jwq256P7-ojxyfMOAzFbGQPt_Clfyn4D4gOB2ge83aboXuZygfArnir0oOg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1iXulHBuzr8LwKG0w-_iOyDL1RToipIVYvdU3ThTG5sA&oe=69F1F19A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-OkSfQ6iwUQ7kNvwHRym4r&_nc_oc=AdpM4b94tf3xfRj53o8AfMqL6nsDPAoOUf_Cv8Hszr4aJZI4VJtWNrEHVxtieLCq5eM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CGj5PnKhQVDi3I98TJaZBYEWk1CtXU1fLMjikiePMZw&oe=69F20374"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "NARRATIVE", "ADVENTURE"], "has_in_ap
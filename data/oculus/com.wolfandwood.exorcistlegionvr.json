&_nc_ohc=gG22djZqULgQ7kNvwGUriY-&_nc_oc=Adrw_UpZUsLWu_8h_u3u6bKGWqqRh20vJPsYeH9yzOY7BQanwpLihZYzCIL4Rj9399Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg-yg2StRcFjZpDnno7tfe-acJnJQcUHeZmggwgacXhQ&oe=6ACE61B1"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rX6dP_Gn-mcQ7kNvwFtlDs2&_nc_oc=AdrvNCFs74G0LzDvgxHFI4-BVSThnSP8phMKZnoUa9EcqJJL1j7phxtuIy8B7259Ing&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu1BhYXvKShnd3EUPTOER8YRDi-zmeYZmHnLFM3qL1_g&oe=6ACE6757"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5u_Mf4TTEgQ7kNvwFft8L2&_nc_oc=Adqq-vQMiBV4UKUQpKVdirGPBbEjVsbnRHRBiZOVn7xjQ5QY5WKf6anfE7aJoirYWCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrFve8oRRxBYC7rP0mvq03gA9MZx5ZbBEUcdaKscbk0g&oe=6ACE39E6"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVEjFsfDnyUQ7kNvwG5ajl2&_nc_oc=AdpJflayMn_mZM6ZqPdsLXkLgYnzzDWa_tyAmhkcMHKutnapv3540gpr9MlvGOgnZOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHNCH3Xeb519qagg-gDgoq4eBM0JuuXwNVlTpCj7lw3Q&oe=6ACE545A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaRpMLAdcGQQ7kNvwH9GGHx&_nc_oc=AdoYVQVLHMnfyo6h4KnacEvvuQvELphJzbUEnz_RIrIT2n00duSGeU0tyOscSEV6Yj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7sWV2Dok51wFga5ws4Do91bRWGy4rUrB2c5tNpWB5YQ&oe=6ACE6634"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "
&_nc_ohc=ma0lAa_ZbUgQ7kNvwFo9l3k&_nc_oc=AdpdxbTgjhASjj66MGxtD_mjybqC0AX8iqaP1oczMHOUdU29PLGSmM4dwhmYUhDTo1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCNQZdCfn8yMVSM5eig3Gcw3kiyStfjSMuZEYTXm5w2g&oe=6A50EAF1"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fre4ytRdebkQ7kNvwF0-AG1&_nc_oc=AdpGlvx0zt4Szl8f1BDK3QFRBsneLhiPlg0QioSI_iCqP5u2ahamjKE3JFXJHUoAZmU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL7I1Oxho68u9QYwdrWhpBa52Gxzc7M_OZ3BcNW8VsLw&oe=6A50F097"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0OODS0nDwEQ7kNvwHlzkYO&_nc_oc=AdooMm2ft72QoNcQnX1UH3WRNCYSpuGoNOuSssV1kmAioYwgU3X0F8sz1mt5CFRtNQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_xLNrt1NR34mHo6VSxQTpM4Vi1zSuuGljBH0rzoOusA&oe=6A50FB66"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmPDqejpqeAQ7kNvwFFogVE&_nc_oc=AdqUE3xMc_0JJbY0OhDFSElvkAeftKrjVfisCSKg94SWLy2AOhqdiaHYq9XPlR8UZAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtK4hco89X2LapDbw_sOOskxSBEyNSWZ-W-FaijBMHww&oe=6A5115DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX0QGRTp-FoQ7kNvwHOWASR&_nc_oc=AdpFSloTIXT7keAjH7J2cAaN9-TRB-JntxOsyu78KONWGEAi4FNgi1A2NAvD5Aox9sQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoohFyt8JUkig1Kr-c44dbvsI-6_285hceKzpkx2xGWw&oe=6A50EF74"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "
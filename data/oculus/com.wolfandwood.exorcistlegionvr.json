_oc=Adqc3mp9cReG7ngUh0-lb_DD2aX8mV40LIf0xOLCvFHlaX-WmR8qumDXETjXJWovx2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9O16efV3S__AVjPNbbBKVvT0kHx4u62CYXamCfaGnMQ&oe=6AE9FF41"}, {"file_name": "EOTL-Meta-Screenshot-5-2560x1440.png", "id": "1778627759413270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823893_1778627762746603_7567165976082583616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZzIMGLiRUAQ7kNvwHjRYuh&_nc_oc=Adphc-AoacuDt1Q6D86GGU-dIerhxvOfiTuydEKcb-m16IKHL2W_EjJTySZqRXsnSzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScvluo_H3JuW6IOnZaVNCxBtRlSMPFqNaoeWebNIHYyA&oe=6AEA04F5"}, {"file_name": "EOTL-Meta-Screenshot-3-2560x1440.png", "id": "2212488402613289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507935159_2212488409279955_1152715862022481737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiHa-eGKOU4Q7kNvwFZGUN9&_nc_oc=AdpZDl6keif9r1cttFCdLUVyU4vSSonEK3VkE-fesLg53MeaMbAE232BcZ3iJXtfHdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFFbrWCV_ppDRLohnDUDv7yYIsR7ubMg95GED8P_dm0g&oe=6AE9EBF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EOTL New Keyart Meta 2560x1440.png", "id": "1736189871130654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299845_1736189874463987_6926299177228702882_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3XDUX7vc2kQ7kNvwG4OWaW&_nc_oc=AdrHP5vWflAcF8-hnlycmKUhsNKefPZA6uVH40NRTkEwqZDqBgffnxGBk7O7W9xa0-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV14P8iF00ZVtO1-NDDzKQoSWuQ_dwzmfdM7pt5NXtIQ&oe=6AE9F46E"}, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": ["Exorcist", "Horror", "Demon", "Scary", "TheExorcist"], "long_description": "Experience the game called one of the most terrifying experiences in VR. New name, new terror.  Now enhanced for Quest 3 and optimized for Quest 2 headsets. Described as one of the most disturbing experiences available for virtual reality, the game features connected stories and features a variety of demonic entities, exorcism tools, hidden artifacts and atmospheric locations. \n\n{534597808967949}\n\nThe Exorcisms epilogue update brings new content that extends the ending of this VR horror classic. Complete all five chapters first to access this new epilogue, if you can make it all the way through.\n\n{1463790964338165}\nDelve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\n{1568767000721557}\n{1072124544621378}\n\nThese exorcisms are part action, part mystery, part puzzle-solving... and ALL terror.\n\n{3783494471909456}\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of  LegionVR, LLC.  All Rights Reserved.  \u00a9 2026 Legion VR , LLC", "short_description": "Exorcisms of the Legion (Last Rites)  is an acclaimed horror game named the most terrifying game in VR.  Now enhanced for Quest 3 and 3s.  Delve deep into the heart of the supernatural as you learn the ancient trade of demonic exorcism and uncover a supernatural conspiracy. "}, {"images": {"nodes": []}, "id": "2189986518534454", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": [], "long_description": "Erleben Sie das Spiel, das als eines der furchterregendsten Erlebnisse in VR bezeichnet wurde. Neuer Name, neuer Terror. Jetzt verbessert f\u00fcr Quest 3 und optimiert f\u00fcr Quest 2. Als eines der verst\u00f6rendsten Erlebnisse in der virtuellen Realit\u00e4t beschrieben, bietet das Spiel miteinander verbundene Geschichten und eine Vielzahl d\u00e4monischer Wesen, Exorzismus-Werkzeuge, verborgene Artefakte und atmosph\u00e4rische Schaupl\u00e4tze.\n\nDas Epilog-Update bringt neue Inhalte, die das Ende dieses VR-Horror-Klassikers erweitern. Schlie\u00dfen Sie zuerst alle f\u00fcnf Kapitel ab, um Zugang zu diesem neuen Epilog zu erhalten \u2014 wenn Sie es bis zum Ende schaffen.\n\nTauchen Sie tief in das Herz des \u00dcbernat\u00fcrlichen ein, w\u00e4hrend Sie das Handwerk des d\u00e4monischen Exorzismus erlernen und Geheimnisse aufdecken, die Sie zu einer finalen Konfrontation mit Ihren dunkelsten, verborgensten \u00c4ngsten f\u00fchren. Sind Sie mutig genug?\n\nDiese Exorzismen sind teils Action, teils Mystery, teils R\u00e4tsel \u2014 und purer Terror.\n\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of LegionVR, LLC. All Rights Reserved. \u00a9 2026 Legion VR, LLC", "short_description": "Exorcism of the Legion (Last Rites) ist ein gefeiertes Horrorspiel, das als das furchterregendste Spiel in VR bezeichnet wurde. Jetzt verbessert f\u00fcr Quest 3 und 3s. Tauchen Sie tief in das Herz des \u00dcbernat\u00fcrlichen ein, w\u00e4hrend Sie das uralte Handwerk des d\u00e4monischen Exorzismus erlernen und eine \u00fcbernat\u00fcrliche Verschw\u00f6rung aufdecken."}, {"images": {"nodes": []}, "id": "1841038553461072", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": [], "long_description": "D\u00e9couvrez le jeu d\u00e9crit comme l'une des exp\u00e9riences les plus terrifiantes en VR. Nouveau nom, nouvelle terreur. D\u00e9sormais am\u00e9lior\u00e9 pour Quest 3 et optimis\u00e9 pour les casques Quest 2. D\u00e9crit comme l'une des exp\u00e9riences les plus troublantes disponibles en r\u00e9alit\u00e9 virtuelle, le jeu propose des histoires interconnect\u00e9es et une grande vari\u00e9t\u00e9 d'entit\u00e9s d\u00e9moniaques, d'outils d'exorcisme, d'artefacts cach\u00e9s et de lieux \u00e0 l'atmosph\u00e8re unique.\n\nLa mise \u00e0 jour \u00e9pilogue d'Exorcism apporte un contenu in\u00e9dit qui prolonge la fin de ce classique de l'horreur en VR. Terminez d'abord les cinq chapitres pour acc\u00e9der \u00e0 ce nouvel \u00e9pilogue, si vous parvenez \u00e0 aller jusqu'au bout.\n\nPlongez au c\u0153ur du surnaturel en apprenant le m\u00e9tier d'exorciste et en d\u00e9couvrant des secrets qui vous m\u00e8neront \u00e0 une confrontation finale avec vos peurs les plus sombres et les plus enfouies. Aurez-vous le courage ?\n\nCes exorcismes sont en partie action, en partie myst\u00e8re, en partie \u00e9nigmes... et terreur \u00e0 l'\u00e9tat pur.\n\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of LegionVR, LLC. All Rights Reserved. \u00a9 2026 Legion VR, LLC", "short_description": "Exorcism of the Legion (Last Rites) est un jeu d'horreur acclam\u00e9, d\u00e9sign\u00e9 comme le jeu le plus terrifiant en VR. D\u00e9sormais am\u00e9lior\u00e9 pour Quest 3 et 3s. Plongez au c\u0153ur du surnaturel en apprenant l'art ancestral de l'exorcisme d\u00e9moniaque et en d\u00e9voilant une conspiration surnaturelle."}, {"images": {"nodes": []}, "id": "1610567866664027", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": [], "long_description": "Vive el juego considerado una de las experiencias m\u00e1s aterradoras en VR. Nuevo nombre, nuevo terror. Ahora mejorado para Quest 3 y optimizado para los visores Quest 2. Descrito como una de las experiencias m\u00e1s perturbadoras disponibles en realidad virtual, el juego presenta historias conectadas y una gran variedad de entidades demon\u00edacas, herramientas de exorcismo, artefactos ocultos y lugares llenos de atm\u00f3sfera.\n\nLa actualizaci\u00f3n del ep\u00edlogo de Exorcism trae contenido nuevo que ampl\u00eda el final de este cl\u00e1sico del horror en VR. Completa primero los cinco cap\u00edtulos para acceder a este nuevo ep\u00edlogo, si consigues llegar hasta el final.\n\nAd\u00e9ntrate en el coraz\u00f3n de lo sobrenatural mientras aprendes el oficio del exorcismo demon\u00edaco y descubres secretos que te llevar\u00e1n a un enfrentamiento final con tus miedos m\u00e1s oscuros y ocultos. \u00bfTe atreves?\n\nEstos exorcismos son en parte acci\u00f3n, en parte misterio, en parte puzles... y terror en estado puro.\n\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of LegionVR, LLC. All Rights Reserved. \u00a9 2026 Legion VR, LLC", "short_description": "Exorcism of the Legion (Last Rites) es un aclamado juego de horror, nombrado el juego m\u00e1s aterrador en VR. Ahora mejorado para Quest 3 y 3s. Ad\u00e9ntrate en el coraz\u00f3n de lo sobrenatural mientras aprendes el antiguo oficio del exorcismo demon\u00edaco y descubres una conspiraci\u00f3n sobrenatural."}, {"images": {"nodes": []}, "id": "1129206762938822", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": [], "long_description": "Prova il gioco definito una delle esperienze pi\u00f9 terrificanti in VR. Nuovo nome, nuovo terrore. Ora migliorato per Quest 3 e ottimizzato per i visori Quest 2. Descritto come una delle esperienze pi\u00f9 inquietanti disponibili in realt\u00e0 virtuale, il gioco presenta storie interconnesse e un'ampia variet\u00e0 di entit\u00e0 demoniache, strumenti da esorcista, manufatti nascosti e ambientazioni ricche di atmosfera.\n\nL'aggiornamento epilogo di Exorcism porta nuovi contenuti che estendono il finale di questo classico horror in VR. Completa prima tutti e cinque i capitoli per accedere a questo nuovo epilogo, se riesci ad arrivare fino in fondo.\n\nImmergiti nel cuore del soprannaturale mentre impari il mestiere dell'esorcismo demoniaco e scopri segreti che ti condurranno a un confronto finale con le tue paure pi\u00f9 oscure e nascoste. Avrai abbastanza coraggio?\n\nQuesti esorcismi sono in parte azione, in parte mistero, in parte enigmi... e puro terrore.\n\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of LegionVR, LLC. All Rights Reserved. \u00a9 2026 Legion VR, LLC", "short_description": "Exorcism of the Legion (Last Rites) \u00e8 un acclamato gioco horror, definito il gioco pi\u00f9 terrificante in VR. Ora migliorato per Quest 3 e 3s. Immergiti nel cuore del soprannaturale mentre impari l'antico mestiere dell'esorcismo demoniaco e scopri una cospirazione soprannaturale."}, {"images": {"nodes": []}, "id": "958132373585978", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": [], "long_description": "Experimente o jogo chamado de uma das experi\u00eancias mais aterrorizantes em VR. Novo nome, novo terror. Agora aprimorado para Quest 3 e otimizado para os headsets Quest 2. Descrito como uma das experi\u00eancias mais perturbadoras dispon\u00edveis em realidade virtual, o jogo apresenta hist\u00f3rias conectadas e uma grande variedade de entidades demon\u00edacas, ferramentas de exorcismo, artefatos ocultos e locais cheios de atmosfera.\n\nA atualiza\u00e7\u00e3o do ep\u00edlogo de Exorcism traz conte\u00fado novo que prolonga o final deste cl\u00e1ssico do horror em VR. Conclua primeiro os cinco cap\u00edtulos para acessar esse novo ep\u00edlogo, se conseguir chegar at\u00e9 o fim.\n\nMergulhe no cora\u00e7\u00e3o do sobrenatural enquanto aprende o of\u00edcio do exorcismo demon\u00edaco e descobre segredos que o levar\u00e3o a um confronto final com seus medos mais sombrios e ocultos. Voc\u00ea \u00e9 corajoso o bastante?\n\nEsses exorcismos s\u00e3o parte a\u00e7\u00e3o, parte mist\u00e9rio, parte quebra-cabe\u00e7as... e puro terror.\n\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of LegionVR, LLC. All Rights Reserved. \u00a9 2026 Legion VR, LLC", "short_description": "Exorcism of the Legion (Last Rites) \u00e9 um aclamado jogo de horror, eleito o jogo mais aterrorizante em VR. Agora aprimorado para Quest 3 e 3s. Mergulhe fundo no cora\u00e7\u00e3o do sobrenatural enquanto aprende o antigo of\u00edcio do exorcismo demon\u00edaco e descobre uma conspira\u00e7\u00e3o sobrenatural."}]}, "developer_name": "LegionVR, LLC", "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train, Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/exorcist", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28728697956791630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499625099_2072008113352396_8114539448815894278_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWg-AXRdjz8Q7k
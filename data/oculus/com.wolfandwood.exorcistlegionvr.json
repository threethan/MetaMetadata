//scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303971_1542704200173966_6069929234334566004_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFqHg0ntrjUQ7kNvwFmH5Pi&_nc_oc=AdrgQWO5aIUeOCPvR7sqwE9s_Qjxg8HyLotwVVFRqIMsu2JiSmKn_1YyTqWJhotvszA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3gDd8EP_hTHyYfG8QrfQtGwn7jqHj2l3HXEUYlZFgdA&oe=6A5E0801"}, {"file_name": "EOTL-Meta-Screenshot-5-2560x1440.png", "id": "1778627759413270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823893_1778627762746603_7567165976082583616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9JQE172zEsQ7kNvwGlvcYS&_nc_oc=AdobrwdCl-As0TXlr3N5-d5WMDyBai2xpNjC-vVWRZtpGU1ifXfsTx1x8TQu3YMw36s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_MehPzhpn1mH_UJkU1Nzhzci3wNhyZG-AYXHilCqbaA&oe=6A5E0DB5"}, {"file_name": "EOTL-Meta-Screenshot-3-2560x1440.png", "id": "2212488402613289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507935159_2212488409279955_1152715862022481737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92N75XESy_EQ7kNvwETv3-Z&_nc_oc=AdpJ8yhSI3tskDWNL-c_4bmA3o1aItxvkPL9iPZr-1LdM7iSQLKchJzghb1tBcvP3Tk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBZFjR0UUdwpKcxInso_8tQ4d3Ee8FTbIl8vl29ohwKA&oe=6A5E2CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EOTL New Keyart Meta 2560x1440.png", "id": "1736189871130654", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1736189874463987_6926299177228702882_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ql5MUK6dCXkQ7kNvwEf-Cdt&_nc_oc=AdqILH4IlhZtTptOswuAkeHwYeS4P_GG1nfDlPgof79QAk2JPreB5uRUlO0Y5TGD4HI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpVV1DV8qCLCdp8HTA3STaEEu81HL00jLak-22keLgAA&oe=6A5E356E"}, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": ["Exorcist", "Horror", "Demon", "Scary", "TheExorcist"], "long_description": "Experience the game called one of the most terrifying experiences in VR. New name, new terror.  Now enhanced for Quest 3 and optimized for Quest 2 headsets. Described as one of the most disturbing experiences available for virtual reality, the game features connected stories and features a variety of demonic entities, exorcism tools, hidden artifacts and atmospheric locations. \n\n{534597808967949}\n\nThe Exorcisms epilogue update brings new content that extends the ending of this VR horror classic. Complete all five chapters first to access this new epilogue, if you can make it all the way through.\n\n{1463790964338165}\nDelve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\n{1568767000721557}\n{1072124544621378}\n\nThese exorcisms are part action, part mystery, part puzzle-solving... and ALL terror.\n\n{3783494471909456}\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of  LegionVR, LLC.  All Rights Reserved.  \u00a9 2026 Legion VR , LLC", "short_description": "Exorcisms of the Legion (Last Rites)  is an acclaimed horror game named the most terrifying game in VR.  Now enhanced for Quest 3 and 3s.  Delve deep into the heart of the supernatural as you learn the ancient trade of demonic exorcism and uncover a supernatural conspiracy. "}]}, "developer_name": "LegionVR, LLC", "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train, Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/exorcist", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external
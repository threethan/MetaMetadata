//scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303971_1542704200173966_6069929234334566004_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEybqY6OAt4Q7kNvwEKbWSH&_nc_oc=AdqReGoXt9ZUXA4IVQeOf8pWLhpC1Menq7-cUnO1FxbeapuF-ulB5DcNOyzn4Lk-0xQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQhD7zbJ6CNFdO4vMDpa5gMzOoH6rHHz4hqJcf51jIVQ&oe=6A898981"}, {"file_name": "EOTL-Meta-Screenshot-5-2560x1440.png", "id": "1778627759413270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823893_1778627762746603_7567165976082583616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpKv1Yu5y7UQ7kNvwHD1fkw&_nc_oc=AdoCbyj4Ovq6UBIPw-PLVtV4ufn8sdEuW-pFVzUzDwsC4C8iflsDQJ1vq0ghA6u7kuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK5uvad4gpvqaGCRpRRnu_w_p0VnfJ54PmLvNoCFyTCA&oe=6A898F35"}, {"file_name": "EOTL-Meta-Screenshot-3-2560x1440.png", "id": "2212488402613289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507935159_2212488409279955_1152715862022481737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JSkVBErDRoQ7kNvwGVSt3e&_nc_oc=AdpWFO3wnyFE-6phHVrvoMChIYegkOs0Hb_l0v0EE7ZJk0_CinOeaz42jBxUJt4DNvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyQ4upvgiGYeRAZl5cBtwP1je7s6kVNzqxfVzBdd3qoQ&oe=6A897639"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EOTL New Keyart Meta 2560x1440.png", "id": "1736189871130654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299845_1736189874463987_6926299177228702882_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APGEDq_C1bMQ7kNvwEVQID8&_nc_oc=Adq6ACnbCaW8HDWoESf2TpqzQ0a9Sbz7EhMRgVFNWw5Wm0mo8aJgROY9gRQHiqH1Alw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6cHlWOdJ2rIRrXNAKxApTngVYn9906NxZMd4UHC37dg&oe=6A897EAE"}, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": ["Exorcist", "Horror", "Demon", "Scary", "TheExorcist"], "long_description": "Experience the game called one of the most terrifying experiences in VR. New name, new terror.  Now enhanced for Quest 3 and optimized for Quest 2 headsets. Described as one of the most disturbing experiences available for virtual reality, the game features connected stories and features a variety of demonic entities, exorcism tools, hidden artifacts and atmospheric locations. \n\n{534597808967949}\n\nThe Exorcisms epilogue update brings new content that extends the ending of this VR horror classic. Complete all five chapters first to access this new epilogue, if you can make it all the way through.\n\n{1463790964338165}\nDelve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\n{1568767000721557}\n{1072124544621378}\n\nThese exorcisms are part action, part mystery, part puzzle-solving... and ALL terror.\n\n{3783494471909456}\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of  LegionVR, LLC.  All Rights Reserved.  \u00a9 2026 Legion VR , LLC", "short_description": "Exorcisms of the Legion (Last Rites)  is an acclaimed horror game named the most terrifying game in VR.  Now enhanced for Quest 3 and 3s.  Delve deep into the heart of the supernatural as you learn the ancient trade of demonic exorcism and uncover a supernatural conspiracy. "}]}, "developer_name": "LegionVR, LLC", "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train, Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/exorcist", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external
KYGqJJuO97p2fVzUCRUF9xXtwMIs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmifH06yWcW_O2spRXIjpCqMvUaUzzkUG2Os2DTKmbPg&oe=69AACDF1"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-DahEvLCh0Q7kNvwGBoBez&_nc_oc=Adl7ZSbfniulzL9M4RgE-p5V1irPdkXh61PLIX_cRRaPVoX3dUIq-cewGKhof-p1eck&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxN8VCq3OSJNGLAcBiAHNdTg-DUoBbySvWZhzesSiwTNw&oe=69AAD397"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1blvNMbqcEcQ7kNvwHf0vJL&_nc_oc=AdnV5cGTMtFO9CJJr1_7ztmyDA28N8S6BTrCm6ELeNpM5LLyauGipb4W1Teb8jdop8Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9vQzRR0Y_m7LznIUrGub5IiydQuuRsLUoFbw4dfyQSA&oe=69AADE66"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JVlQ1TsLbIQ7kNvwGJd33p&_nc_oc=Adk_uwyq_uJTuInk-56aRiGfCdxFKlYiuG6Lvxih9CPbw0OYUg_khfw8oNE9vL4YGOM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbVSGUImtX030TSXTXMOKCwrHVxSYWLZJsIgUXHfzwjA&oe=69AAC09A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wDSEhmWSF4Q7kNvwGvc-4C&_nc_oc=AdktQR9FuOhNRTQzcab8bauk67NpQMzXf1NYmeXKxalW_k12DeUewqcjHxgcijhkqjU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk_T9mBVDyAY2upyCRki6O45_5m69rlXVStAgi7SyiBQ&oe=69AAD274"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
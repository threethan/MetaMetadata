&_nc_ohc=fDiP6wmLk6wQ7kNvwEcnphh&_nc_oc=AdpbPml7mM5LH7TPLQM0PdMjWJNLlvnYnZsOGUAgjCIiqMn_kyTEeP6Ni_TEm-0NQfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwLZpD9wgaeK9Z_eRw3haZ-89MBXONeRcrPw9fDEE96w&oe=6A620E71"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APxsvZg9W0cQ7kNvwGn37-T&_nc_oc=AdoA2hYuGibJ1r2uRVNKsMLMF_ndRBGyrVQNsLHr9qU4eRm0IA9Xd_hhT-Pn-u3lp6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkWlSMBOl62rn2E6GHPsrkJ1TThedXpcjIp7GaOR33HQ&oe=6A621417"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M7g9c2k5rIQ7kNvwGH1w1d&_nc_oc=Adp7bGWLyHccCKaSEAgXsjzMmDUMS7n9c6NwOPq7eHjmtJ-CmnrWmyIeTyWyupG-w5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBXvUXtZFQllDjt4SWzTD0d0cq3Oh4zievKhEBEJpKQQ&oe=6A621EE6"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WfPlKUaA-kQ7kNvwE8qRR0&_nc_oc=AdqDnpglcbFPk8B3HJPaqRwfP6dGfjcb4_C9thuukvxfEWrsYVLAbPIBbv7af5GesEc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNWUqBlelurjDNv7kh70OnvkmQ9fH1zhZI7VJ5SBDwCA&oe=6A62011A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZYO5gmFQy8Q7kNvwHlDggJ&_nc_oc=AdoH3KOCk3K8LRpjLdHl2W6fGUhNO12ewR8qTTpi70CAaVVZlvT6diy5Cuda1uO_2so&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiJFB7g8togk2zIw7J1Lyd27ZO2TjJUzI4q-vFls14iw&oe=6A6212F4"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "
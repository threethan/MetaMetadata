//scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303971_1542704200173966_6069929234334566004_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y5pKhh0MF8Q7kNvwFW9qwr&_nc_oc=AdqCzrUREhcPQQlIwnuTNees07Kj4HiSIQAITpZbwO5b-hLveFbGNwtRyQFph_IVXxQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmIm-1HqGHiKJCwdrV6ERnC7wOb3_5GUME7MzC4y2oYA&oe=6AA02B41"}, {"file_name": "EOTL-Meta-Screenshot-5-2560x1440.png", "id": "1778627759413270", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823893_1778627762746603_7567165976082583616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRkCfVysiWIQ7kNvwGMFQCh&_nc_oc=AdpFctJ8Nnx6F7gUbsKuC14IeJBX-iS-Ceip594Zj1gU3Ip0BlGukLhdlQ1o-wnyjXM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL90hMJR7E2mS4Z13r4v9ZmSg_1moLIBNtsg8vp5MKPgQ&oe=6A9FF8B5"}, {"file_name": "EOTL-Meta-Screenshot-3-2560x1440.png", "id": "2212488402613289", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507935159_2212488409279955_1152715862022481737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-P3h8_H-VoQ7kNvwELYWpm&_nc_oc=AdrV1QwJpe4UbD8iahfftFfzg369bjToPXYdNkM0x64DPToXGS6UcIPZSp9IjfK7tLQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJADhp1_eMnsEgiDpuSXUxNo0lQtPVRHHD_yZX4jZFMEw&oe=6AA017F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EOTL New Keyart Meta 2560x1440.png", "id": "1736189871130654", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299845_1736189874463987_6926299177228702882_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rqgy3fqVmUQ7kNvwHnocUk&_nc_oc=AdohmfHkU49kZmqYeKnyIBuLTvTgyiE6f1DtiF86SzXVRkRAEQ6pkP3-LkMPDV3aZTM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPrX-FtTtnKnVaan32an_3BBPYbVXjuXEo8-jpCdX-jA&oe=6AA0206E"}, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": ["Exorcist", "Horror", "Demon", "Scary", "TheExorcist"], "long_description": "Experience the game called one of the most terrifying experiences in VR. New name, new terror.  Now enhanced for Quest 3 and optimized for Quest 2 headsets. Described as one of the most disturbing experiences available for virtual reality, the game features connected stories and features a variety of demonic entities, exorcism tools, hidden artifacts and atmospheric locations. \n\n{534597808967949}\n\nThe Exorcisms epilogue update brings new content that extends the ending of this VR horror classic. Complete all five chapters first to access this new epilogue, if you can make it all the way through.\n\n{1463790964338165}\nDelve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\n{1568767000721557}\n{1072124544621378}\n\nThese exorcisms are part action, part mystery, part puzzle-solving... and ALL terror.\n\n{3783494471909456}\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of  LegionVR, LLC.  All Rights Reserved.  \u00a9 2026 Legion VR , LLC", "short_description": "Exorcisms of the Legion (Last Rites)  is an acclaimed horror game named the most terrifying game in VR.  Now enhanced for Quest 3 and 3s.  Delve deep into the heart of the supernatural as you learn the ancient trade of demonic exorcism and uncover a supernatural conspiracy. "}]}, "developer_name": "LegionVR, LLC", "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train, Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/exorcist", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external
//scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303971_1542704200173966_6069929234334566004_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMDFXHlK8kcQ7kNvwHr87Sk&_nc_oc=AdpqOPOJFosipI_lWO1X_Xk2-dTqYBLItm9WP6TMv-4y_o_jN50uwEw2Qf3nND2TJoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tBQbRFWWf8YZTVpMExPECXl7AKiIIubC_t0UZgKc5Hw&oe=69EB5581"}, {"file_name": "EOTL-Meta-Screenshot-5-2560x1440.png", "id": "1778627759413270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823893_1778627762746603_7567165976082583616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI_IwBU64R4Q7kNvwGgpoPT&_nc_oc=AdokTOuds3RUKY18jMjivkVmiNRW7_lS2w-VAuJlQIWR75Vmsykqu-CL_1BOGanuLls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PxUEJAN4duQi5gRGQf1mtxSy5nS1Ezpd0Oa4uUwuHHQ&oe=69EB5B35"}, {"file_name": "EOTL-Meta-Screenshot-3-2560x1440.png", "id": "2212488402613289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507935159_2212488409279955_1152715862022481737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0FXb0hyLZAQ7kNvwFWp581&_nc_oc=AdrywCz6OBD1qfh6aCBIL4623aUvBJK22U1EQBjqqvPDxFXrXAy52b93rRX_ROVqZBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Eu71vwn0m7PEhd_5gN_ftlFujFBnIaWmegPxihbM2uQ&oe=69EB7A79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EOTL Meta Trailer Cover 2560x1440.png", "id": "2860563464145636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298502_2860563467478969_5731237755906144137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnX2eho8f7MQ7kNvwGWcFmV&_nc_oc=AdrrEn5nw6yYnocuYcn-B58M33LahZpr8iJndnjzrxr4f5mlhq72qtvdb-cHY_qFKpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RLJcgmnhrDL8jq7M6RVyy7P1YU8W9EnS-bFP6xpC9AQ&oe=69EB6F3F"}, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": ["Exorcist", "Horror", "Demon", "Scary", "TheExorcist"], "long_description": "Experience the game called one of the most terrifying experiences in VR. New name, new terror.  Now enhanced for Quest 3 and optimized for Quest 2 headsets. Described as one of the most disturbing experiences available for virtual reality, the game features connected stories and features a variety of demonic entities, exorcism tools, hidden artifacts and atmospheric locations. \n\n{534597808967949}\n\nThe Exorcisms epilogue update brings new content that extends the ending of this VR horror classic. Complete all five chapters first to access this new epilogue, if you can make it all the way through.\n\n{1463790964338165}\nDelve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\n{1568767000721557}\n{1072124544621378}\n\nThese exorcisms are part action, part mystery, part puzzle-solving... and ALL terror.\n\n{3783494471909456}\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of  LegionVR, LLC.  All Rights Reserved.  \u00a9 2026 Legion VR , LLC", "short_description": "Exorcisms of the Legion (Last Rites)  is an acclaimed horror game named the most terrifying game in VR.  Now enhanced for Quest 3 and 3s.  Delve deep into the heart of the supernatural as you learn the ancient trade of demonic exorcism and uncover a supernatural conspiracy. "}]}, "developer_name": "LegionVR, LLC", "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train, Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/exorcist", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "exter
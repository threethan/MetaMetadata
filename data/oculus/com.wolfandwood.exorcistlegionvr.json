//scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303971_1542704200173966_6069929234334566004_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsXlJQB4wnQQ7kNvwFpijID&_nc_oc=AdrHBJ6Hk_EFTyv29v3OAfLU0q4P1_HapJPYYuQ--ApIT8J4onwlvvjpZiyyTkJnF_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8esx9FFKTMcSiFm7LG4lYsD8M_naK_PtCbTGO9hSYbeg&oe=6A2AD5C1"}, {"file_name": "EOTL-Meta-Screenshot-5-2560x1440.png", "id": "1778627759413270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823893_1778627762746603_7567165976082583616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wps-h-NetUIQ7kNvwGbAhwQ&_nc_oc=AdoJemU2J26XrTM14Ow3M51wwVSv_vrebgDmC_1DcRBddMYCLUW6qIVcp5ObIuL9vT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iNKIST0Qv7BvOzdKqBiMocjTqy_rIlCV_qqv0KWvs0Q&oe=6A2ADB75"}, {"file_name": "EOTL-Meta-Screenshot-3-2560x1440.png", "id": "2212488402613289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507935159_2212488409279955_1152715862022481737_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AM4G3OUbZr8Q7kNvwHVtga3&_nc_oc=AdpJWaGZhCWbHM8oXiLrVDHV8s-RTzSVT6YchaZVORinrPEPVvTC5kjGPrd5S-iW2to&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rp408exei3rB0MjDYDgxDwJpcUL7uXJvjalT05NgUHw&oe=6A2AC279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EOTL Meta Trailer Cover 2560x1440.png", "id": "2860563464145636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_2860563467478969_5731237755906144137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngZAgol1FD0Q7kNvwGRoQiH&_nc_oc=AdrDSKU2nQSKa37c2cHa8D7TiB9p2FB35xzRO_75BBoh80qIPiDX8xFjHEJJXKnE4Tw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_38ucwvpsRrCCdOFy_YkKUOUPLKGNugQPAr5Wy9zP-hA&oe=6A2AB73F"}, "display_name": "Exorcism of the Legion (Last Rites)", "keywords": ["Exorcist", "Horror", "Demon", "Scary", "TheExorcist"], "long_description": "Experience the game called one of the most terrifying experiences in VR. New name, new terror.  Now enhanced for Quest 3 and optimized for Quest 2 headsets. Described as one of the most disturbing experiences available for virtual reality, the game features connected stories and features a variety of demonic entities, exorcism tools, hidden artifacts and atmospheric locations. \n\n{534597808967949}\n\nThe Exorcisms epilogue update brings new content that extends the ending of this VR horror classic. Complete all five chapters first to access this new epilogue, if you can make it all the way through.\n\n{1463790964338165}\nDelve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\n{1568767000721557}\n{1072124544621378}\n\nThese exorcisms are part action, part mystery, part puzzle-solving... and ALL terror.\n\n{3783494471909456}\n--------------------------------------------------\nExorcism of the Legion (Last Rites) and related characters and elements are trademarks of  LegionVR, LLC.  All Rights Reserved.  \u00a9 2026 Legion VR , LLC", "short_description": "Exorcisms of the Legion (Last Rites)  is an acclaimed horror game named the most terrifying game in VR.  Now enhanced for Quest 3 and 3s.  Delve deep into the heart of the supernatural as you learn the ancient trade of demonic exorcism and uncover a supernatural conspiracy. "}]}, "developer_name": "LegionVR, LLC", "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train, Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/exorcist", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "exter
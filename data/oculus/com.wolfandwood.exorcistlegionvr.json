jJPSXHi-7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAz0HdApEc-WFDk2-HWhO5Oh-SJQeeNpneywZQ8OUJaw&oe=69B16571"}, {"file_name": "migrated_image.png", "id": "275490830108295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974715_2348986035166055_8616935500906758144_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6K42mdADzcQ7kNvwHyAElU&_nc_oc=AdlOrokcTcNYZk81sIceMwQbyTLx5iBN0mzsvMosoR34mLBpOLnah8YDy3zWGsKERLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCUdCTD2z-dDfVDJlO2K4JAMBFovd7gWqRyXahj12LLg&oe=69B16B17"}, {"file_name": "migrated_image.png", "id": "492685264968925", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001662_289325478614142_2042323572780695552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14s_sbD2wM4Q7kNvwH24M0I&_nc_oc=AdkCix1PDSSti9cuEpb2fKZHTJhAesIiX471zGIg0jywR7gzlA7FTw4ORbhCjn6AdTM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB25otm438wdN4tKdeql7UcE52uDRSu3gMg2saBmv7JQ&oe=69B175E6"}, {"file_name": "migrated_image.png", "id": "250684022630962", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001698_432265547572690_7022988809973268480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMB2FXeNW1gQ7kNvwFi5L9G&_nc_oc=Adl2jjcDboMENrMVm55msn_MyiQ_4DsOOdyqsmMQ6lAE8jaYpm4sF-aH9H8SyBDI1Yc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxgj78zUzyy1En2MhI2ZORahjJxltAIPj_xcL5ZHk6MWQ&oe=69B1581A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/7NwD7u", "id": "2475056699213854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974599_2475056702547187_922204790702735360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f14y5ZgvyewQ7kNvwHLsq5t&_nc_oc=AdlxAhH0AtcVvbDDoQX8XEFr3yArsDsDrVKdyJDdA6SA8S_F8hS2UszF2WAffuSJYGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVbMmmri_rAVIguHMCrLq509dQ2hJPNm8J0c7sojRd3Q&oe=69B169F4"}, "display_name": "The Exorcist: Legion VR", "keywords": ["Exorcist", "Horror", "Movie", "Demon", "Scary"], "long_description": "The scariest story of all time is now yours to experience if you dare. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!\n\nThe Exorcist: Legion is a virtual reality adventure set in the Academy Award-winning world created by horror maestro William Peter Blatty. Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism and uncover secrets leading you towards a final confrontation with your darkest, most hidden fears. Are you brave enough?\n\nThe Exorcist: Legion features a variety of locomotion options allowing users to fully customize their adventure.\n\n* Multiple chapters, each featuring a different demonic entity. Replay each chapter for additional secrets and achievements and locate a variety of Easter eggs.\n* Various exorcism tools as well as hidden \u201cartifacts\u201d aid you on your adventure.\n* Return to your evidence room at any time during the game to see items you have collected.", "short_description": "One of VR's highest rated horror adventures is now on Oculus Quest! The Exorcist: Legion VR is an acclaimed virtual reality game set in the Academy Award-winning world created by horror maestro William Peter Blatty.  Delve deep into the heart of the supernatural as you learn the trade of demonic exorcism. For a limited time, buyers will also receive the Complete Series on Oculus Rift as a FREE bonus!"}]}, "developer_name": "Wolf & Wood, Ltd.", "developer_privacy_policy_url": "https://www.exorcistlegion.com/terms", "developer_terms_of_service_url": "https://www.exorcistlegion.com/terms", "publisher_name": "Fun Train, Inc.", "support_website_url": "http://exorcistvr.com/bugs", "website_url": "http://www.exorcistlegion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "26918901644604
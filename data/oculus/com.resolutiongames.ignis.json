g", "id": "689897648272280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615890_689897651605613_4910186383525843477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiMW8W2X1NAQ7kNvwELS0n3&_nc_oc=AdqhUpWmFDK42lan4VuQqICO57ogemz0a0zT8ppHWWiPIwwIhW9r_vHqiB-Fby5JbDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EJ0PIq18e8bmpBXUmXwbzxR-7rleIO1DFwk2d-n-AxQ&oe=6A25A1C0"}, {"file_name": "blaston_launch_screenshot_4.png", "id": "808593719909475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031326_808593729909474_939483056808173643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV5AMc_zw6kQ7kNvwHT-v-5&_nc_oc=AdqcLGFyF3pw-xJM7sfg4cceQ1FO_KonAc9Y5cpzWwyS9jQ55a1PHMVRD-LAK5AbzKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yy07SNOCTh1N_IlFPN8oYjTHQNM5CWKhGp8PTxKVSfA&oe=6A256F12"}, {"file_name": "blaston_launch_screenshot_5.png", "id": "307573680543193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568685_307573683876526_8698708594618779423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYUt9Q6J-pcQ7kNvwHcQGiL&_nc_oc=Adp5r2TngP0TxSYF9ERN6jwZOf4rGxIFqqrXAyzvodkwNFn7L5BjLfat4oUHWtACrK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xTX3fYD0aLpCGDUt6fB9IPhSFqwH6njvTdn2urE46gA&oe=6A2584D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus_blaston_landscape_2560x1440.png", "id": "312735680019469", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031311_312735683352802_5417240732074616004_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbyXOUCCfuAQ7kNvwHTisEI&_nc_oc=AdrF0_OR4g_xA0KwlNIWCpeMXc6PoW9gW9o0h5TYZ-6kO2gev70zYoBSpIBB6C1G9mI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b_2ba2bPmkMpAAHUuug9XOxuwwmnn2WaBgu-SoXQzHg&oe=6A259271"}, "display_name": "Blaston", "keywords": ["blast", "combat", "iron", "pvp", "duel"], "long_description": "Do you have what it takes to be the last champion standing in Resolution Games\u2019 fiercely competitive VR dueling game, launching on Oculus Quest October 8? \n\nWithin the slow motion bullet-hell of Blaston, you continuously dodge, duck and dive to evade incoming attacks from your opponent in this PvP combat game that combines skill, strategy and speed with an incredible arsenal of futuristic high-tech weapons. \n\nUnleash the same or more on your opponent while remaining hyper aware of the confines of your gladiator-like jousting platform just a stone\u2019s throw away from your opponent. Most importantly, Never. Stay. Still.", "short_description": "Do you have what it takes to be the last champion standing in Resolution Games\u2019 fiercely competitive VR dueling game, launching on Oculus Quest October 8? \n\nWithin the slow motion bullet-hell of Blaston, you continuously dodge, duck and dive to evade incoming attacks from your opponent in this PvP combat game that combines skill, strategy and speed with an incredible arsenal of futuristic high-tech weapons. \n\nMost importantly, Never. Stay. Still."}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://blaston.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SPORTS", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mod
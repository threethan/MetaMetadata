g", "id": "689897648272280", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615890_689897651605613_4910186383525843477_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26SBsUCfBLQQ7kNvwGGUrnn&_nc_oc=AdrVZWG1MllLjU3YRDdyyPw9cfQsf7K7K_93RI-kfYnxlIplbigSwJ723JeTXMTsrAI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3wpSFivEPIiD8Ysbjz_LAJRvnoyxog6oaL81dje2b_Q&oe=69C52C00"}, {"file_name": "blaston_launch_screenshot_4.png", "id": "808593719909475", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031326_808593729909474_939483056808173643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y9VCkORITAQ7kNvwHWCDNq&_nc_oc=AdrZJLdRE1Ic0Mg3OE7D5yHn_ESOq8erUHK8fzI8q8U85B_BPJnwC2UazJUntZ16qt8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZnAxB1IJ6wtc6fQjtyS6dCXuOVQM9amV4DdQ_5Stt7g&oe=69C53192"}, {"file_name": "blaston_launch_screenshot_5.png", "id": "307573680543193", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568685_307573683876526_8698708594618779423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwRFnN-eAPoQ7kNvwFhB_8y&_nc_oc=AdoU2M6LDrSjnCNYEp6tDhq4UDKa1oA82-ty6zD_5R3ci4ouMGwQe-Cyn4c2zQUwRKo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy0ycMl2Dn3jdfrGXU5F2fk-Z4pZ68B2Kg0emNJuDDVQ&oe=69C50F18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus_blaston_landscape_2560x1440.png", "id": "312735680019469", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031311_312735683352802_5417240732074616004_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StdaGUjJ6xUQ7kNvwE0hMhq&_nc_oc=AdpDcAw6x9ygIdY8Jf72ZcF_-IEqYF7vOjQCbQWQyIq8GYmlmt-M7b6_f8-3HmECxps&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzw_2xXNfP3Rrqi8HGeE03C9j3CydpU2YXvqNcQNdvsHw&oe=69C51CB1"}, "display_name": "Blaston", "keywords": ["blast", "combat", "iron", "pvp", "duel"], "long_description": "Do you have what it takes to be the last champion standing in Resolution Games\u2019 fiercely competitive VR dueling game, launching on Oculus Quest October 8? \n\nWithin the slow motion bullet-hell of Blaston, you continuously dodge, duck and dive to evade incoming attacks from your opponent in this PvP combat game that combines skill, strategy and speed with an incredible arsenal of futuristic high-tech weapons. \n\nUnleash the same or more on your opponent while remaining hyper aware of the confines of your gladiator-like jousting platform just a stone\u2019s throw away from your opponent. Most importantly, Never. Stay. Still.", "short_description": "Do you have what it takes to be the last champion standing in Resolution Games\u2019 fiercely competitive VR dueling game, launching on Oculus Quest October 8? \n\nWithin the slow motion bullet-hell of Blaston, you continuously dodge, duck and dive to evade incoming attacks from your opponent in this PvP combat game that combines skill, strategy and speed with an incredible arsenal of futuristic high-tech weapons. \n\nMost importantly, Never. Stay. Still."}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://blaston.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SPORTS", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mod
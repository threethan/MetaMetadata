FvocI82mjWWzYbe7ZnPfx2Xwc4n7iTlA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU_ZWVabyjt_Gptpc11SjuazLc7QSMB-FSOScJlvwO9Q&oe=6AE8B3DC"}, {"file_name": "s02.png", "id": "1733073644664645", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823930_1733073661331310_5629461049321258325_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffwATxN5Yj0Q7kNvwESR2E8&_nc_oc=AdrRfc4j2ixVEK3acq4obiL7ttIWa9bvQwWfFL0Gec_PHSp_Tr_Ydd5r21QtcAXBU_Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgkQrxGVx2fd0GSLjY4LY-3NG3eEkgnLwMyJFk0_MtTg&oe=6AE8A22B"}, {"file_name": "s03.png", "id": "1875467957141997", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823259_1875467960475330_1872312137828573140_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIkE5FrpeR8Q7kNvwHmWLMb&_nc_oc=AdolRacnTCm1Z0nRyNwI889ShYvqHyOdMk-rqMntghRSdFFFpNsD_X9UpzFLrlTcQhA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhWOQKwyY4hdmiPDhIFMbDeSzevdd72Qmo4umseufb_Q&oe=6AE89822"}, {"file_name": "s05.png", "id": "2480112452457438", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824328_2480112455790771_8140092662538143972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMgoUUFpokUQ7kNvwEp-fqt&_nc_oc=AdrAMby4TIkpVfhmKNQ3oNQOTbpgiRCg9OsAJ6hCdOlm25qUG5bciigwo8YQdWlwDUc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcau3DlimaLb2CFLsu56MaNueZFGldBUI-huriySk6vw&oe=6AE8A7D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art-2.png", "id": "1343471021008476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819854_1343471024341809_1635249537243616296_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIz7PmXDBEsQ7kNvwFvyMVu&_nc_oc=AdrzglU0RrwF4eiS5F2X4iDZeWzQe7pitXriJUbC8Q-6cCAy1JohWd3UkwsWcmJTeXg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Va0MGDTGa-bWYQi2kC-913jTx5BNm7SZotymVlKa7g&oe=6AE8A162"}, "display_name": "Omega Pilot Evolution", "keywords": ["racing", "futuristic", "speed", "antigravity", "Scifi"], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience. Take control of futuristic anti-gravity ships and master precision piloting across dynamic tracks built for extreme speed.\n\n**Career Mode**\n\nRace against recorded runs of real players, improve your skills, and progress through increasingly challenging tracks.\n{1074932615539098}\n\n**Series Mode**\n\nCompete against AI opponents in a series of races and fight for the top position.\n\n**Single Race Mode**\n\nChoose a track and race against AI opponents at your own pace.\n\n**Cross-Platform Multiplayer**\n\nRace against real players in real time and play with friends across different platforms. VR and non-VR players can race together in the same multiplayer sessions!\n\n**Combat Racing Mode**\n\nCollect weapons, use shields, and outmaneuver your opponents in high-speed races.\n\n{1099198279368277}\n\n**Combat Arena Mode**\n\nFly freely around the arena, collect weapons, and battle real players or AI opponents.\n\n**Customization & Upgrades**\n\nEarn in-game currency to upgrade your ship's speed, acceleration, handling, and braking. Unlock visual customizations to create your own style.\n\n{29482518374711634}\n\n**Asynchronous Rivals & Global Leaderboards**\n\nChallenge the recorded runs of other players, set your best times, and climb the global leaderboards.\n", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480
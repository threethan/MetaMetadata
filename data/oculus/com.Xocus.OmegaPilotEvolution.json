Nav0pGdiQpznWommmECIbVTVlRCflK1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNVmZJsk9S1vLhdkTnTdPDFj4rlENbe_g5Cl5nHXXfkQ&oe=6AF33FDC"}, {"file_name": "s02.png", "id": "1733073644664645", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823930_1733073661331310_5629461049321258325_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AA9aFZJTqgUQ7kNvwEusSez&_nc_oc=Adrw1s8UCbtbwv2FE8AJ7Gl1d4hY15KG4XN6A_Fxq8U8umjuKuD5b_afLoxKM6p52-o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKfLb0tq_ciYw2ZDFJd53i7CfdUMdv1cyHPDcflADWpQ&oe=6AF32E2B"}, {"file_name": "s03.png", "id": "1875467957141997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1875467960475330_1872312137828573140_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLjR7pbsUvIQ7kNvwF_3Dsb&_nc_oc=AdqFJS-nBxmVJrpLdiFhCdS5y5lfFjaW5tXEfYcIuW2STb-mA7IVuNTm1IEfivwELL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAM4i87OKgzYVXfdzNTXCs5gIi3_2NwHtJkABmMzuWsQ&oe=6AF32422"}, {"file_name": "s05.png", "id": "2480112452457438", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_2480112455790771_8140092662538143972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJcZBZAHfH4Q7kNvwHaR5wF&_nc_oc=AdoTzRgl9-CfcweipAYwMiCQkomcR9Wz8xX9elxpdA6nT0ADbTHU8s2-GCu3flRxAns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1TftxjnD_3AEwIVbrBq2NLEdQZDLdgBbwVA-lj3v_xA&oe=6AF333D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art-2.png", "id": "1343471021008476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_1343471024341809_1635249537243616296_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzRSSIGxqzoQ7kNvwF6sxV3&_nc_oc=AdqDjwdNnnxkA1vaKqTrJmqJndAF459BSKQ7Q3ugJJ78m-3FD81wg8QCNPJtlcDWI-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWktwmiVGO2UQylnRP0DINRezCQQdA6WO9J5ndKNOofQ&oe=6AF32D62"}, "display_name": "Omega Pilot Evolution", "keywords": ["racing", "futuristic", "speed", "antigravity", "Scifi"], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience. Take control of futuristic anti-gravity ships and master precision piloting across dynamic tracks built for extreme speed.\n\n**Career Mode**\n\nRace against recorded runs of real players, improve your skills, and progress through increasingly challenging tracks.\n{1074932615539098}\n\n**Series Mode**\n\nCompete against AI opponents in a series of races and fight for the top position.\n\n**Single Race Mode**\n\nChoose a track and race against AI opponents at your own pace.\n\n**Cross-Platform Multiplayer**\n\nRace against real players in real time and play with friends across different platforms. VR and non-VR players can race together in the same multiplayer sessions!\n\n**Combat Racing Mode**\n\nCollect weapons, use shields, and outmaneuver your opponents in high-speed races.\n\n{1099198279368277}\n\n**Combat Arena Mode**\n\nFly freely around the arena, collect weapons, and battle real players or AI opponents.\n\n**Customization & Upgrades**\n\nEarn in-game currency to upgrade your ship's speed, acceleration, handling, and braking. Unlock visual customizations to create your own style.\n\n{29482518374711634}\n\n**Asynchronous Rivals & Global Leaderboards**\n\nChallenge the recorded runs of other players, set your best times, and climb the global leaderboards.\n", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480
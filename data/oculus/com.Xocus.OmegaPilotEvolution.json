uxUc2yjggsrmC_ZAN0ADnO0aBA&oe=6AEA1278"}, {"file_name": "4-2.png", "id": "811191588543541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_811191595210207_6514090499369887462_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwUPcqX497sQ7kNvwE7pHvu&_nc_oc=AdpTlqPi0aoEmnqbKN4wLW3pIwcKPWCZ9lACTTCf28Vbo2WGTuH77P7MTjmERwR0hl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGEdI2aFONTjT_6IXcxnrzxrTNPpAiwKFufJvOiYNZ2g&oe=6AE9F4B9"}, {"file_name": "1-2.png", "id": "768876479545857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_768876482879190_6831620466123621875_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyJ34as4secQ7kNvwGmCfKx&_nc_oc=AdqJcwnYbJ7tDFhASLYRQrhNDBvCmH0PqI-0gOKWRCJ69p4lhZ1iJU68me3-H5ttsB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDIYCL5gd-L9rd_ES3OOZRovnti3ieg6hHUhMqTMjBCA&oe=6AE9E1CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omega Pilot Evolution", "keywords": [], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience that pushes the limits of futuristic flight. Take control of cutting-edge anti-gravity ships and master precision piloting across dynamic tracks designed for extreme speed and skill-based maneuvering.\nRace solo or compete against real players in asynchronous and real-time multiplayer modes. Customize your ship's design and performance, dominate leaderboards, and unlock your legacy in the evolution of high-tech racing.\n\nMultiplayer & Leaderboards\nChallenge real players in real-time or asynchronous modes. Climb global and friends-only leaderboards to prove you're the ultimate pilot.\n\nCombat Racing Mode\nPick up and deploy a wide arsenal of weapons - from energy blasters to EMPs - and use shields and tactics to outmaneuver and outgun your opponents.\n\nDeep Customization & Upgrades\nEarn in-game currency through races and victories. Spend it to upgrade your ship's speed, handling, and durability or unlock visual customizations to create a unique style for your ship.\n\nSmart Matchmaking & Asynchronous Rivals\nAlways race against opponents close to your skill level \u2014 even when offline. Your performance creates a ghost profile for others to challenge.\n\nSeasonal Events with Prize Pools\nJoin rotating events for exclusive gear and tournament glory. Climb seasonal ladders for high-stakes rewards.\n\n\nAdd to your wishlist and stay tuned for updates!", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25279828094954872"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1551805929403411"}, {"status": "PUBLISHED", "id": "1602954094622603"}, {"status": "PUBLISHED", "id": "2335452320592309"}, {"status": "PUBLISHED", "id": "1794515228231400"}, {"status": "PUBLISHED", "id": "1964172257535551"}, {"status": "PUBLISHED", "id": "2327339234741458"}, {"status": "PUBLISHED", "id": "815605534976427"}, {"status": 
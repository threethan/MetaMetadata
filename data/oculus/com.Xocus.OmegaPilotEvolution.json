GQQbdxvFKUj0svHd2f4bCDuKphLYcJeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-cPEdUlWX2r08w24b-NT35GRtRYrxXMg8aATbbC12Qw&oe=6AE4BF5C"}, {"file_name": "s02.png", "id": "1733073644664645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1733073661331310_5629461049321258325_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AK9jHwNSO0Q7kNvwEGF6rX&_nc_oc=AdpzAtFFV7whyX84c2eFbXxZOGxNFyE_YbZkSfxc5cz3_ltatX6vB3tvTkRTzz1KUPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5pRuDBJv5fdvx8Uppb6Avbl9D8BHXUWWuqJb9CUQ-Ew&oe=6AE4ADAB"}, {"file_name": "s03.png", "id": "1875467957141997", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1875467960475330_1872312137828573140_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diNzvTMTt3cQ7kNvwGhM9eU&_nc_oc=Adqu74xVjVNqVPxYH9jQYW41xJmMrEonI3EU4XAApY46tOlMVp1pIwPDEW6Ty4Y03jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB6CeFl0OsWSEhrpqvAUkAVACsqmTjQZ6zlIxcxahvpg&oe=6AE4A3A2"}, {"file_name": "s05.png", "id": "2480112452457438", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_2480112455790771_8140092662538143972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOzkxCS6bzMQ7kNvwGShw60&_nc_oc=AdpNN2OSI4_kAMvJwA4NoMYLIyg4GA1gwIFcEjrQGwZXHuhdZf9aiAYu26cXi9u_7Uc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh6qyn0Pg5x_-FXay4V7qSt4p_gwYYQSraPdtmUI2mmA&oe=6AE4B357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art-2.png", "id": "1343471021008476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_1343471024341809_1635249537243616296_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoFXG4PYEIYQ7kNvwHhHoEB&_nc_oc=AdrCx9N5ywawVTxuzhNETW6urPqONVaYqweuMNME4AqvX_R4PG1pRFGkhmlIknkFUdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxngFVQGute3VskhddnA-fZp-G-kfYevMGkVyurWr3lg&oe=6AE4ACE2"}, "display_name": "Omega Pilot Evolution", "keywords": ["racing", "futuristic", "speed", "antigravity", "Scifi"], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience. Take control of futuristic anti-gravity ships and master precision piloting across dynamic tracks built for extreme speed.\n\n**Career Mode**\n\nRace against recorded runs of real players, improve your skills, and progress through increasingly challenging tracks.\n{1074932615539098}\n\n**Series Mode**\n\nCompete against AI opponents in a series of races and fight for the top position.\n\n**Single Race Mode**\n\nChoose a track and race against AI opponents at your own pace.\n\n**Cross-Platform Multiplayer**\n\nRace against real players in real time and play with friends across different platforms. VR and non-VR players can race together in the same multiplayer sessions!\n\n**Combat Racing Mode**\n\nCollect weapons, use shields, and outmaneuver your opponents in high-speed races.\n\n{1099198279368277}\n\n**Combat Arena Mode**\n\nFly freely around the arena, collect weapons, and battle real players or AI opponents.\n\n**Customization & Upgrades**\n\nEarn in-game currency to upgrade your ship's speed, acceleration, handling, and braking. Unlock visual customizations to create your own style.\n\n{29482518374711634}\n\n**Asynchronous Rivals & Global Leaderboards**\n\nChallenge the recorded runs of other players, set your best times, and climb the global leaderboards.\n", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480
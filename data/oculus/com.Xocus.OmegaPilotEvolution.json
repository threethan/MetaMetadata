zlQz7ZD298DbB5xuWbbqkEbmD2UY8sys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUl7PRM77Z6zpSkHlkqmWAbFzm8ek6XimtToyW5xr5VA&oe=6AF885DC"}, {"file_name": "s02.png", "id": "1733073644664645", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_1733073661331310_5629461049321258325_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8veBb3zifWkQ7kNvwEmmyG0&_nc_oc=Adod4g7PrPufAI_Oix0gqyM4yiOa6IcAZT4Ss2cnzTvFO5jGthfPvJUMjqXbqMaPxwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS102LpFeNsfuWDWnJt5nmnz4oLotpzFt-Zp-TSkGYwcA&oe=6AF8AC6B"}, {"file_name": "s03.png", "id": "1875467957141997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1875467960475330_1872312137828573140_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEEBggqhZdgQ7kNvwF5Nhgo&_nc_oc=AdrC5zoZFxSWcTIcTgTbyBCk_6lQXJbA4eEGo-4QT_EsRcxwugzgqqkEbG1LBDZwkSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShRA1Jy0LEud8cWh3oz246sg2P2iH5lKQDSqYpZx7vQA&oe=6AF8A262"}, {"file_name": "s05.png", "id": "2480112452457438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_2480112455790771_8140092662538143972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jowf7tdJ7lsQ7kNvwETQEXV&_nc_oc=AdoRLQ0M9HyYzMgJcsXxoDoNT3JL3Qb4UX_Wtrrphe6fDRsOrNrFVfBh8f-_Pg5EqF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfLaCKyaYug8iUQkPB9Wii90vQM8FYwDFkQlbMCzTxNw&oe=6AF879D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art-2.png", "id": "1343471021008476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_1343471024341809_1635249537243616296_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Y0Cppm7zMQ7kNvwG8zuDJ&_nc_oc=AdqAZ_ggWgVUZ3v_iyVYnv4NKhyzHz3iFHIc-Q_dvjDducFPqIjAyKyj1sgPwjLOEZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnyNsO-q4B5NMmHRV1TL-_M9dsyemZYl6YB3xsoiie5w&oe=6AF8ABA2"}, "display_name": "Omega Pilot Evolution", "keywords": ["racing", "futuristic", "speed", "antigravity", "Scifi"], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience. Take control of futuristic anti-gravity ships and master precision piloting across dynamic tracks built for extreme speed.\n\n**Career Mode**\n\nRace against recorded runs of real players, improve your skills, and progress through increasingly challenging tracks.\n{1074932615539098}\n\n**Series Mode**\n\nCompete against AI opponents in a series of races and fight for the top position.\n\n**Single Race Mode**\n\nChoose a track and race against AI opponents at your own pace.\n\n**Cross-Platform Multiplayer**\n\nRace against real players in real time and play with friends across different platforms. VR and non-VR players can race together in the same multiplayer sessions!\n\n**Combat Racing Mode**\n\nCollect weapons, use shields, and outmaneuver your opponents in high-speed races.\n\n{1099198279368277}\n\n**Combat Arena Mode**\n\nFly freely around the arena, collect weapons, and battle real players or AI opponents.\n\n**Customization & Upgrades**\n\nEarn in-game currency to upgrade your ship's speed, acceleration, handling, and braking. Unlock visual customizations to create your own style.\n\n{29482518374711634}\n\n**Asynchronous Rivals & Global Leaderboards**\n\nChallenge the recorded runs of other players, set your best times, and climb the global leaderboards.\n", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "277654228600060
map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01pIyJChxboQ7kNvwFjADEI&_nc_oc=Adp3J0yJn8QYa0kGt2-Rlrx8gNQENA8EthNKrN78MzTTbdl6LIQLly6j9zGWb--HQec&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Zc7iHpfdcElGgBjGl_G_4NOJI2lZUTOiK-Qns2iCsQ&oe=6B085B95"}, {"file_name": "5-2.png", "id": "1737362146934794", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491821702_1737362150268127_101287221219393113_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cee-fcEfktsQ7kNvwG9rjLu&_nc_oc=AdrKHQ171T3icS6FNJdeS-8v2oY1Dk6kGGcgRkBumT5MsOJiKnnpJB6_Ogf9rwky-Bg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKKHWKKpEtxNQt1fmDPJ6pi_BWMkcJJbpuZ3EI28eA_Q&oe=6B0864F8"}, {"file_name": "4-2.png", "id": "811191588543541", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825257_811191595210207_6514090499369887462_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zsXt0xu9o4Q7kNvwFl3B4I&_nc_oc=AdrOtzfkNt8_EmOV1ukET0tKl5UQksu0RIP5Ny16qnn9EskTkXVvKGIYcoucJmqtyDA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaFw8XTeff-UnCQ-41Cl66GBMBxeLzDRFuewuHJu2myg&oe=6B084739"}, {"file_name": "1-2.png", "id": "768876479545857", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819845_768876482879190_6831620466123621875_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCOqaB27GwYQ7kNvwG2agAj&_nc_oc=Adqv7dq4EzoQgl7ftjLgy4Mq7Bjt_ErZajJbeRVyImzWLg2rOcfol_SOPud1U8WDqE0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYoceSv62GvkiGF_IqNRtHWI-JseVqh1u7UMojUmR8iA&oe=6B086C8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omega Pilot Evolution", "keywords": [], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience that pushes the limits of futuristic flight. Take control of cutting-edge anti-gravity ships and master precision piloting across dynamic tracks designed for extreme speed and skill-based maneuvering.\nRace solo or compete against real players in asynchronous and real-time multiplayer modes. Customize your ship's design and performance, dominate leaderboards, and unlock your legacy in the evolution of high-tech racing.\n\nMultiplayer & Leaderboards\nChallenge real players in real-time or asynchronous modes. Climb global and friends-only leaderboards to prove you're the ultimate pilot.\n\nCombat Racing Mode\nPick up and deploy a wide arsenal of weapons - from energy blasters to EMPs - and use shields and tactics to outmaneuver and outgun your opponents.\n\nDeep Customization & Upgrades\nEarn in-game currency through races and victories. Spend it to upgrade your ship's speed, handling, and durability or unlock visual customizations to create a unique style for your ship.\n\nSmart Matchmaking & Asynchronous Rivals\nAlways race against opponents close to your skill level \u2014 even when offline. Your performance creates a ghost profile for others to challenge.\n\nSeasonal Events with Prize Pools\nJoin rotating events for exclusive gear and tournament glory. Climb seasonal ladders for high-stakes rewards.\n\n\nAdd to your wishlist and stay tuned for updates!", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT"
map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJatigoAxBcQ7kNvwHNwz6F&_nc_oc=AdqedwmsKC1n87vXJ7ZIF5f7UeU1EuClY7QtRCwr3E7nGU8Oo1mqdH4_rPl2iPBvOlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxoUqwCiSc5NWjNFoWIOeDcDaXG9UU_wI_COQ9XbM9VQ&oe=6B0EF315"}, {"file_name": "5-2.png", "id": "1737362146934794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_1737362150268127_101287221219393113_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BovuK2GZ7NAQ7kNvwGS15OS&_nc_oc=AdoNPnzDzJxUgzXeP3ma9rzPuGJkNHvZGb7VL0S9PxYWu7lh5qG6fXKgf87PWIPtSWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVtBjoPo0oNlkv9uZLNPydT1YmFdcvmun6oNWcEc6GyRA&oe=6B0EFC78"}, {"file_name": "4-2.png", "id": "811191588543541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_811191595210207_6514090499369887462_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Dwa6lm00DAQ7kNvwGhJd_w&_nc_oc=Adp2QCHoxo2DGk6HxczqAo7F1QYWj_au3kJDEuorxfzu9SaLnBfMkjpSCyPw_f_KFZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBw3lVcVGoNgCTqK0MGRAmk8oZyAEgxq5KNCE2S--sgw&oe=6B0F16F9"}, {"file_name": "1-2.png", "id": "768876479545857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_768876482879190_6831620466123621875_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZlHM56CEyYQ7kNvwEt9Ou2&_nc_oc=AdqIn9_D7Et4JSwixvDuGaXN-UZsaV9anHSU3tgo2nBmTfSbMc5wRKrvd5VYngVxwZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKcn_FVF9e7d7edtsfhE1CJhJVgY6cCkstg_1lowN8Ig&oe=6B0F040A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omega Pilot Evolution", "keywords": [], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience that pushes the limits of futuristic flight. Take control of cutting-edge anti-gravity ships and master precision piloting across dynamic tracks designed for extreme speed and skill-based maneuvering.\nRace solo or compete against real players in asynchronous and real-time multiplayer modes. Customize your ship's design and performance, dominate leaderboards, and unlock your legacy in the evolution of high-tech racing.\n\nMultiplayer & Leaderboards\nChallenge real players in real-time or asynchronous modes. Climb global and friends-only leaderboards to prove you're the ultimate pilot.\n\nCombat Racing Mode\nPick up and deploy a wide arsenal of weapons - from energy blasters to EMPs - and use shields and tactics to outmaneuver and outgun your opponents.\n\nDeep Customization & Upgrades\nEarn in-game currency through races and victories. Spend it to upgrade your ship's speed, handling, and durability or unlock visual customizations to create a unique style for your ship.\n\nSmart Matchmaking & Asynchronous Rivals\nAlways race against opponents close to your skill level \u2014 even when offline. Your performance creates a ghost profile for others to challenge.\n\nSeasonal Events with Prize Pools\nJoin rotating events for exclusive gear and tournament glory. Climb seasonal ladders for high-stakes rewards.\n\n\nAdd to your wishlist and stay tuned for updates!", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT"
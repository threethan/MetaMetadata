map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dLJWfoTz-8Q7kNvwGWAy0t&_nc_oc=AdqMQ1Dz6rLjeDxHVtIcaNcbRMFnHdQCRA1Bny9Zdkx6tyU8PZaveBLkGnMOk4LseOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbuHXvsLP_Tcr0lt5b8q7O2_-fjjqyEjXflYEp8z3KBw&oe=6B01C415"}, {"file_name": "5-2.png", "id": "1737362146934794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_1737362150268127_101287221219393113_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNPHq-8spSsQ7kNvwFvDSJk&_nc_oc=AdrSuyN8zIpZ_8bBI-oBzsYGG7TnoW5LcvlWXAYCDR3o4HW4DkMXMp8AEIbs4yvBqiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9e8pPjnkwZpPz2ONxtUhJNFrwOQz4fJbdJ3mrB58jug&oe=6B01CD78"}, {"file_name": "4-2.png", "id": "811191588543541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_811191595210207_6514090499369887462_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiOAjn-VQtEQ7kNvwH_f5Av&_nc_oc=AdpwMoAqRl-Y_ZSEzDVPpYp_8xnTORLr9mViIsX92iTOA5P7OgdgN_BO4PZbm--IZts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGsIFyknbJ3n6SuztoZy85nNKhxPFbAjK1f8hosut9XQ&oe=6B01E7F9"}, {"file_name": "1-2.png", "id": "768876479545857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_768876482879190_6831620466123621875_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDJanmbkPrEQ7kNvwGd3W21&_nc_oc=AdoO5UHaT_oLjzaqQHq8pDp4vANintXxJ2LZ-bSsr-STKfXG0H5Qa60gjh73JxQOwUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTTNNnw2JBO4tqPID8dk_CeEMmmLFqBxAwxewqv1wjdA&oe=6B01D50A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omega Pilot Evolution", "keywords": [], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience that pushes the limits of futuristic flight. Take control of cutting-edge anti-gravity ships and master precision piloting across dynamic tracks designed for extreme speed and skill-based maneuvering.\nRace solo or compete against real players in asynchronous and real-time multiplayer modes. Customize your ship's design and performance, dominate leaderboards, and unlock your legacy in the evolution of high-tech racing.\n\nMultiplayer & Leaderboards\nChallenge real players in real-time or asynchronous modes. Climb global and friends-only leaderboards to prove you're the ultimate pilot.\n\nCombat Racing Mode\nPick up and deploy a wide arsenal of weapons - from energy blasters to EMPs - and use shields and tactics to outmaneuver and outgun your opponents.\n\nDeep Customization & Upgrades\nEarn in-game currency through races and victories. Spend it to upgrade your ship's speed, handling, and durability or unlock visual customizations to create a unique style for your ship.\n\nSmart Matchmaking & Asynchronous Rivals\nAlways race against opponents close to your skill level \u2014 even when offline. Your performance creates a ghost profile for others to challenge.\n\nSeasonal Events with Prize Pools\nJoin rotating events for exclusive gear and tournament glory. Climb seasonal ladders for high-stakes rewards.\n\n\nAdd to your wishlist and stay tuned for updates!", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT"
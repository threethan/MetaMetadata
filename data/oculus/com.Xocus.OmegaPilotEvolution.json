iP_BCgAEkcz7Qvnn4g&oe=6AF1EE5C"}, {"file_name": "s02.png", "id": "1733073644664645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1733073661331310_5629461049321258325_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNgLQPRk6qsQ7kNvwE1QK6-&_nc_oc=AdruKwi5GeXzRhLbZcwSiQvNES6LlIDrHUU-EacsrYyeJbvaXys7Ojr1fK7sZRPi9Co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLwET6OUK1JV2SM6zO4diGpP68ndQcBJPh0SWn3WWqmw&oe=6AF1DCAB"}, {"file_name": "s03.png", "id": "1875467957141997", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1875467960475330_1872312137828573140_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLjR7pbsUvIQ7kNvwE0T5QJ&_nc_oc=AdpvdxEszs-yW3mf5zmzCnHx9rIF-ubX1Mi1v6Epsh4XM6DLCTAGSlFE2-7-mKizYL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaASVQhkYnOsBG150URl2MLqQ4QZEo11Bk7o6Nm0hGGQ&oe=6AF20AE2"}, {"file_name": "s05.png", "id": "2480112452457438", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_2480112455790771_8140092662538143972_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJcZBZAHfH4Q7kNvwGxK_dA&_nc_oc=Adp03pHO9LBF19BinLvZOj27swOmoaJLFmdJ3DjfZGL5IydJxrtEuFquBkq_WNSU4Kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_GIN7aIXFxMKLpgAhihil-XaA6rYiqU8s7quDup9wEw&oe=6AF1E257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art-2.png", "id": "1343471021008476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_1343471024341809_1635249537243616296_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzRSSIGxqzoQ7kNvwFMVTuX&_nc_oc=Adqq0YbtZGXObWoMp88z3bSIFiUVZDfvQL9xyTYM3nqLfPY_rMTlG57pvcIu74Ec0n0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbMqk5iKtOID2Yz8RWlIRHQ1XzjOVt-lGxcbe8d9kcsw&oe=6AF1DBE2"}, "display_name": "Omega Pilot Evolution", "keywords": ["racing", "futuristic", "speed", "antigravity", "Scifi"], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience. Take control of futuristic anti-gravity ships and master precision piloting across dynamic tracks built for extreme speed.\n\n**Career Mode**\n\nRace against recorded runs of real players, improve your skills, and progress through increasingly challenging tracks.\n{1074932615539098}\n\n**Series Mode**\n\nCompete against AI opponents in a series of races and fight for the top position.\n\n**Single Race Mode**\n\nChoose a track and race against AI opponents at your own pace.\n\n**Cross-Platform Multiplayer**\n\nRace against real players in real time and play with friends across different platforms. VR and non-VR players can race together in the same multiplayer sessions!\n\n**Combat Racing Mode**\n\nCollect weapons, use shields, and outmaneuver your opponents in high-speed races.\n\n{1099198279368277}\n\n**Combat Arena Mode**\n\nFly freely around the arena, collect weapons, and battle real players or AI opponents.\n\n**Customization & Upgrades**\n\nEarn in-game currency to upgrade your ship's speed, acceleration, handling, and braking. Unlock visual customizations to create your own style.\n\n{29482518374711634}\n\n**Asynchronous Rivals & Global Leaderboards**\n\nChallenge the recorded runs of other players, set your best times, and climb the global leaderboards.\n", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Per3HtgtiH4Q7kNvwF1q4_K&_nc_oc=Adofn9C5Q-10y8m2JZ2ncZ0Y1y3EhUV2YZPl5JW06YNz3QTmk6IjokkP6JZxV-rLsHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxArn79aUPaUM14cmEIU6ZBe_xGjmf1do-k9B2z_Vugw&oe=6AFDCF95"}, {"file_name": "5-2.png", "id": "1737362146934794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821702_1737362150268127_101287221219393113_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VIXOtv0P5IQ7kNvwE4lON5&_nc_oc=AdpC_fd3GuJR2xEQJoxcINXp3HMde6acmmTTnLwebkNw5zdX0KpBh5gV3gxji1v0Hcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_hsWisCzcFhzlFbDbIRqrzjC3D5wEa1dGvAz8MXX3Gg&oe=6AFDD8F8"}, {"file_name": "4-2.png", "id": "811191588543541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_811191595210207_6514090499369887462_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C8QhLkPsYEQ7kNvwGfn5OP&_nc_oc=Adq5XV3jbNuASMHw0-A-xA8ohhQ_PVzOhKlk2F1-4Q6X1XZC57Bvgw-FGetg4-2bTxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEer1rNqzNNQG9FCquVHlTGzZCUC-5WoQPQRQW4av_Sw&oe=6AFDBB39"}, {"file_name": "1-2.png", "id": "768876479545857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_768876482879190_6831620466123621875_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMD1XLKatJsQ7kNvwGvQWxf&_nc_oc=Ado4HSTuQi7hD0MM6V7ZBhhBdQuNwSmiVU37J9HTNIPM9LoNPAuWTirFv-U4fw_WVYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5XDW0ITHIA-hw3zXTl64_31XFenoqUqKJYS2an7iFzA&oe=6AFDE08A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omega Pilot Evolution", "keywords": [], "long_description": "Omega Pilot Evolution is a high-speed first-person VR racing experience that pushes the limits of futuristic flight. Take control of cutting-edge anti-gravity ships and master precision piloting across dynamic tracks designed for extreme speed and skill-based maneuvering.\nRace solo or compete against real players in asynchronous and real-time multiplayer modes. Customize your ship's design and performance, dominate leaderboards, and unlock your legacy in the evolution of high-tech racing.\n\nMultiplayer & Leaderboards\nChallenge real players in real-time or asynchronous modes. Climb global and friends-only leaderboards to prove you're the ultimate pilot.\n\nCombat Racing Mode\nPick up and deploy a wide arsenal of weapons - from energy blasters to EMPs - and use shields and tactics to outmaneuver and outgun your opponents.\n\nDeep Customization & Upgrades\nEarn in-game currency through races and victories. Spend it to upgrade your ship's speed, handling, and durability or unlock visual customizations to create a unique style for your ship.\n\nSmart Matchmaking & Asynchronous Rivals\nAlways race against opponents close to your skill level \u2014 even when offline. Your performance creates a ghost profile for others to challenge.\n\nSeasonal Events with Prize Pools\nJoin rotating events for exclusive gear and tournament glory. Climb seasonal ladders for high-stakes rewards.\n\n\nAdd to your wishlist and stay tuned for updates!", "short_description": "High-speed first-person VR racing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT"
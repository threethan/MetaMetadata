g33w_KgEQiwLqV_2jKQ8_YtD3MlX72E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--6f2LMXXdXHg3hl-IxW_uPhRcGEeTJ6LaUn4tFoatAQ&oe=6A25A187"}, {"file_name": "scr_3.png", "id": "952515492567217", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001681_952515495900550_5787868593854302835_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io99YAnzGT8Q7kNvwGDTF5J&_nc_oc=AdoseoUqF56XdTrq1Nt-5egONxE_3RTMt-AZ7-AacPlOrUIHMUyiTDDuREVzV9BfBBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9spZzZxyMskSuT2JBVcsMuIR522k9KieNXMlKcuaUtpw&oe=6A2591D1"}, {"file_name": "scr_2.png", "id": "6806692849345709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458091_6806692852679042_4813211396796307904_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nXFcPahh9YQ7kNvwG_mOdp&_nc_oc=AdrVZPCmmWttx6_tb-FoTUv2S97XcjhPigem06wA1ndy43aBCZgzN5MERW-LIyr7RDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g6jakkoeGefoDFUOMHAcogQI8EC8KMPXmJhGy1SovNA&oe=6A25787B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rue", "keywords": [], "long_description": "Players are in love with The Rose. Make the right decisions, to beat the competition!\n\nIn Rue, one player has The Rose in front of them, while the other players are trying to take it back.\n\nCards can be used to move The Rose around, allow you to grab it, or plainly steal it from others. All players play their card at the same time,making the right decisions is the key to victory.\n\nThe game is played in rounds that last a couple of minutes each. Once a player has won ~3 rounds, they are the winner.", "short_description": "A game about decisions, love and regret."}, {"images": {"nodes": []}, "id": "682745457052397", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reue", "keywords": [], "long_description": "Konzept\n\nSpieler sind in Die Rose verliebt. Triff die richtigen Entscheidungen, um die Konkurrenz zu schlagen!\n\nIn Reue hat ein Spieler Die Rose vor sich, w\u00e4hrend die anderen Spieler versuchen, sie zur\u00fcckzunehmen.\n\nKarten k\u00f6nnen verwendet werden, um Die Rose zu bewegen, sie dir zu schnappen oder sie einfach von anderen zu stehlen. Alle Spieler spielen ihre Karte gleichzeitig aus. Die richtigen Entscheidungen zu treffen ist der Schl\u00fcssel zum Sieg.\n\nDas Spiel wird in Runden gespielt, die jeweils ein paar Minuten dauern. Sobald ein Spieler ~ 3 Runden gewonnen hat, ist er der Gewinner.\n\nOpen-Source-Lizenz\n\nEs steht unter der GNU v3.0-Lizenz, sodass du sehen kannst, wie es hinter den Kulissen funktioniert, und optional deine eigene Funktionalit\u00e4t hinzuf\u00fcgen kannst. Au\u00dferdem kannst du Fehler auch direkt auf dieser Seite melden, wenn du welche findest.", "short_description": "Ein Kartenspiel \u00fcber Entscheidungen, Liebe und Bedauern."}]}, "developer_name": null, "developer_privacy_policy_url": "https://afloof.dev/privacy_policy/games/", "developer_terms_of_service_url": null, "publisher_name": "Afloofdev", "support_website_url": null, "website_url": "https://afloof.dev/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1464299004326475"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_621354076682158_7419081892129944564_n.png?stp=dst-
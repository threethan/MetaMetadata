Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQNoFBC1gRmcM_oFNW2pWwpEGGsbdy4NxatWB0PWpLQQ&oe=6AFB370E"}, {"file_name": "screenshot_3_2560x1440.png", "id": "831072870063224", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622916_831072873396557_4661792855448920004_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1ccYOaDu-gQ7kNvwEnRIla&_nc_oc=Adpoxutw0QYoEj-b225xW0_KvcIdsK-Z0s6Q8sOJJQ3nMMgPK-ao6FHy2CcMMW59IMc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVLJxEQGJVeUYX91R_Mu7n3ckNbMX8STxuNVojpHqIWw&oe=6AFB27AE"}, {"file_name": "screenshot_4_2560x1440.png", "id": "2335436150602638", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624583_2335436153935971_3415187058986589606_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyg4IeeRagkQ7kNvwE0tM0l&_nc_oc=Adp2oOYhPjPGsS4eaQB84YaEKNqy70vj1l3jG0dUo56FOIq9ETXeeWD-3TQ1VUUrrlE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJR7q7gEfNlGCgxSxWDm9jOO3njS69muAbJbqJsYib2Q&oe=6AFB29C8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1077431885191685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619374_1077431888525018_5546060215165734102_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rTsTAnPXO0Q7kNvwEplo_k&_nc_oc=Adp6dnboiiLlG1-3VhMj7yZO6dWoxfFH3WuBPZTYlZj50vkitJUgzWna44u2v53rxes&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSim3AdSSeEoVEyz5SysthovZcPZzr2clnSBbIcQLpIaA&oe=6AFB3FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1474364561565215", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499628882_1474364564898548_3397338148403956543_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1erkYCFHQt8Q7kNvwGik_M8&_nc_oc=AdrOg8gokFeyL8yCVl7BeSyf9SSuBlgeMZgdFJIKHAY5H_AnEwgf88Cuxq6TeSTU-Jg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI6auBQoZqOtommQB2BjMzSbZwRRfhkV0s64TwYM_iiQ&oe=6AFB2F8E"}, "display_name": "Trains", "keywords": ["trains", "railway", "builder", "sandbox", "toys"], "long_description": "Your own train set, as big as you want it.\n\nBUILD\nPress Y to open the round build wheel. Pick a straight, a turn, an S-curve, a hill or a climbing curve and aim it at the end of your line - it snaps on perfectly. Build loops and mountain railways that climb up and come back down, and watch the track come together piece by piece.\n\nTRAINS AND WAGONS\n12 ready-to-run trains: green, red and blue steam engines that puff steam, a bullet train, city trains, a metro, a subway, a container train, a log hauler, a diesel and a tram. Aim a wagon at the back of a train and it couples on - coal, logs, tankers, containers and passenger coaches.\n\nDRIVE\nPoint at any train and take the controls. Squeeze the trigger to go, brake with the other hand and back up at the end of the line. Blow the whistle, pull into the station for ALL ABOARD, and keep count of your stops on your wrist. Take a tight turn too fast and your train comes off the rails.\n\nA LIVING RAILWAY\nThe other trains drive themselves: they slow down for curves, wait at stations and keep a safe gap from each other.\n\nTWO ROOMS IN ONE\nSwitch the whole room in an instant between a bright, colorful kids play room and a calm, stylish modern living room.\n\nAlso: stations, tunnels, signals, trees and a spinning windmill, three ready-made layouts, undo, auto-save, and music.", "short_description": "Build your own toy train set in a giant play room, then drive the trains around it. Snap together straights, turns, hills and climbing curves from a round build wheel, add stations, tunnels, signals and trees, and fill the rails with 12 trains - steam engines, bullet trains, city trains, freight and more. Drive any train yourself, stop at the station for ALL ABOARD, and switch the room between a colorful kids room and a stylish modern living room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-trains.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-trains.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1326134767246053"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619374_1121641880438467_4264986787855185621_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN6Y0Pk6qEsQ7kNvwGGRmPi&_nc_oc=AdrqNRwYJxgNdeblcWVhvcuBIIb3klLKIOOH5Cb-u4tV-pM4fzydCCxt4KKxzCHBTwI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_RuoTiva-nYBkLT7OPk9TNHrJc2KrEEClFAeLpdXDUQ&oe=6AFB2521"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trains", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1789737240, "lastRevision": {"nodes": [{"id": "1326134787246051", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_
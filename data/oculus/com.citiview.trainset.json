61792855448920004_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1ccYOaDu-gQ7kNvwEnRIla&_nc_oc=Adpoxutw0QYoEj-b225xW0_KvcIdsK-Z0s6Q8sOJJQ3nMMgPK-ao6FHy2CcMMW59IMc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVLJxEQGJVeUYX91R_Mu7n3ckNbMX8STxuNVojpHqIWw&oe=6AFB27AE"}, {"file_name": "screenshot_4_2560x1440.png", "id": "2335436150602638", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624583_2335436153935971_3415187058986589606_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyg4IeeRagkQ7kNvwE0tM0l&_nc_oc=Adp2oOYhPjPGsS4eaQB84YaEKNqy70vj1l3jG0dUo56FOIq9ETXeeWD-3TQ1VUUrrlE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJR7q7gEfNlGCgxSxWDm9jOO3njS69muAbJbqJsYib2Q&oe=6AFB29C8"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1077431885191685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619374_1077431888525018_5546060215165734102_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rTsTAnPXO0Q7kNvwEplo_k&_nc_oc=Adp6dnboiiLlG1-3VhMj7yZO6dWoxfFH3WuBPZTYlZj50vkitJUgzWna44u2v53rxes&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSim3AdSSeEoVEyz5SysthovZcPZzr2clnSBbIcQLpIaA&oe=6AFB3FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1474364561565215", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499628882_1474364564898548_3397338148403956543_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1erkYCFHQt8Q7kNvwGik_M8&_nc_oc=AdrOg8gokFeyL8yCVl7BeSyf9SSuBlgeMZgdFJIKHAY5H_AnEwgf88Cuxq6TeSTU-Jg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI6auBQoZqOtommQB2BjMzSbZwRRfhkV0s64TwYM_iiQ&oe=6AFB2F8E"}, "display_name": "Trains", "keywords": ["trains", "railway", "builder", "sandbox", "toys"], "long_description": "Your own train set, as big as you want it.\n\nBUILD\nPress Y to open the round build wheel. Pick a straight, a turn, an S-curve, a hill or a climbing curve and aim it at the end of your line - it snaps on perfectly. Build loops and mountain railways that climb up and come back down, and watch the track come together piece by piece.\n\nTRAINS AND WAGONS\n12 ready-to-run trains: green, red and blue steam engines that puff steam, a bullet train, city trains, a metro, a subway, a container train, a log hauler, a diesel and a tram. Aim a wagon at the back of a train and it couples on - coal, logs, tankers, containers and passenger coaches.\n\nDRIVE\nPoint at any train and take the controls. Squeeze the trigger to go, brake with the other hand and back up at the end of the line. Blow the whistle, pull into the station for ALL ABOARD, and keep count of your stops on your wrist. Take a tight turn too fast and your train comes off the rails.\n\nA LIVING RAILWAY\nThe other trains drive themselves: they slow down for curves, wait at stations and keep a safe gap from each other.\n\nTWO ROOMS IN ONE\nSwitch the whole room in an instant between a bright, colorful kids play room and a calm, stylish modern living room.\n\nAlso: stations, tunnels, signals, trees and a spinning windmill, three ready-made layouts, undo, auto-save, and music.", "short_description": "Build your own toy train set in a giant play room, then drive the trains around it. Snap together straights, turns, hills and climbing curves from a round build wheel, add stations, tunnels, signals and trees, and fill the rails with 12 trains - steam engines, bullet trains, city trains, freight and more. Drive any train yourself, stop at the station for ALL ABOARD, and switch the room between a colorful kids room and a stylish modern living room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-trains.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-trains.pages.d
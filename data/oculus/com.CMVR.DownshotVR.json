ome", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1583357388841672"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3484679081776740"}]}, "baseline_offer": {"id": "3484679081776740"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1684875593, "status": "PUBLISHED", "id": "3484679081776740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39345239415090903", "version": "0.809"}, "id": "547856043941822", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9166521666722742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39345239415090903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "547856043941822"}]}, "change_log": "v1.14 \n\nSpecial Mode:\n- Ghost in the Graveyard\n\nMaps:\n- Graveyard\n- Battlefield (sandbox variation of last man standing map)\n\nFree Items:\n- Jack O Lantern\n- New secret unlockable\n\nVisuals:\n- Halloween lighting and particles in init map\n- New and improved dust particle logic/visuals\n- Tweaks to flashlight range and falloff\n- Trajectory visualizer added to jump pads \n- Flashlight volumetric fog light scattering cone\n\nOther:\n- new music\n- team based damage filter support\n- modular scoreboard\n- team based scoreboard support\n- significant shader global complexity reduction\n- improvements to cpu load distribution per frame\n- far more optimized skeletal meshes\n- shader permutation reduction\n- increased teller parallelization\n- optimizations to dungeon\n- improvements to dungeon doors\n- fix to player collisions with some skeletal meshes\n- fix to some objects being invisible far from spawn\n- teller network optimizations\n- large player network optimizations\n- other player spawn performance improvement\n- performance stats tweaks\n- visual fixes to last man standing\n- optimizations to heavily populated levels like hq\n- memory optimizations\n- fix to possible stale teller render when moving\n- fix to rare invisible teller issue\n- fix to tellers sometimes sending info before local player booted\n- smoother mag insert physics and visuals\n- some fixes to gun mag insert\n- init tweaks\n- fix to show usernames false not always working\n- fix to player ragdoll stutter right before despawn\n- fix to items have collision when player die with them in inventory\n- fix to item collisions after player quickly take out of inventory\n- fix to rare crash with loading two mags at once\n- fix to attachable object ownership check\n- fix to npc walking stutter\n- fix to username culled visibility\n- fix to sometimes car stutter\n- relative ground performance increase\n- android mvl early work\n- pcvr mvl early work\n- hand tracker performance increase\n- hand tracker rare issue fix\n- fix to collisions sometimes not being enabled between placed items and vehicle interior\n- gun gun kills now count towards kill count\n- fix to gun gun damage in friendly mode\n- fix to healing staff getting stuck healing when player dies or slots it in inventory\n- parallelization improvem
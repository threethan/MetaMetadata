", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820594_720800293836043_2452347550101078325_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ys8idAYMw64Q7kNvwF3dpsA&_nc_oc=AdkMzBKVuN722yhBgPWh2VV4fyRSczQquUD3J2umNBfvcSKBdlDTicOwrOc4DSZ0mYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfooUCmrCGdrYrARxAzBuZcY2CkB7QLtL1RxKPgEjDDg&oe=69B55D01"}, {"file_name": "3.png", "id": "702839986043204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_702839989376537_5111422849815312984_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V5Pm2EBwzYQ7kNvwHhaOXw&_nc_oc=AdmPCHjXGIVWMXjNEdSyR65CIE-W6A5PYqtpkYbfbNnWvpqaBphOp2rHGLoG7mPeoWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx044s5cT_eDm2bJZ0iLngcGTcbLYWrAZDw5cGsR5TTPg&oe=69B556AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main17.png", "id": "1124671639620711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_1124671642954044_2985098334814475166_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmJYn1rJ-SYQ7kNvwGR4-rV&_nc_oc=AdmlryBCTshIg9QVcQ_TtuvOenQhLwmdsewadu9K6qOo1R5y4NTc4VJSoGA4KFkVZnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwacGGOmGETuCNkcBP41AWfohM7dp5-JWUG65uLfHp--g&oe=69B5569F"}, "display_name": "DOWNSHOT", "keywords": ["Sandbox", "Physics", "Multiplayer", "Guns", "Simulation"], "long_description": "# VR\u2019s Most Popular Multiplayer Physics Sandbox (with Mod Support!)\nLet your imagination run wild in our experimental physics playground of 200+ items and endless mod maps, all playable in multiplayer! Best part? It\u2019s FREE!\n\n# 200+ Spawnable Items Pushing the Boundaries of VR\nWeapons, Vehicles, Enemies, Props, Buildings, Superpowers, and More!\n\n{2604967803196130}\n\n# Mod Support for Unlimited Maps\nCreate your own maps and modes with no coding skills needed. 50 million mod downloads and counting!\n\n{735571592360704}\n\n# Non-Stop Content Additions\nNew gadgets, maps, and more keep the surprises coming and fun constantly evolving.\nJoin our Discord (dsc.gg/downshot)\n\n\n{1478480356572702}", "short_description": "VR\u2019s Most Popular Multiplayer Physics Sandbox (with Mod Support!). Let your imagination run wild in our experimental physics playground of 200+ items and endless mod maps, all playable in multiplayer! Best part? It\u2019s FREE!"}]}, "developer_name": "CMVR Game Studios LLC", "developer_privacy_policy_url": "https://www.downshotvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CMVR Game Studios LLC", "support_website_url": null, "website_url": "https://www.downshotvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34105404789074418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293144_1681452043021340_7780557687759827079_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTxfGCmh1i4Q7kNvwGGd8Hn&_nc_oc=AdmwP6g6kcsMc8SeeSh9gxlGB0ekzv4TCIhYU3EYCMEXPR11qzEnGI5ZFZI1Vu1VXj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzxnd93E9wcsqHpkeCwxgeh6I9-UAVyaQiCCdQg3KmUPw&oe=69B5470F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DOWNSHOT
", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820594_720800293836043_2452347550101078325_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqxlVtYliBwQ7kNvwG8Cdt4&_nc_oc=AdmWAknKV-cD6zMXSMoyy0alMGH2kFEglwZq1AKdgi-ZJ0gsd3XJ29hD9rdvZiFrdCc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAOT1-rP6xeJTfnSl2lwasG154miSIBeXSJ2OBtAKSdA&oe=69B16881"}, {"file_name": "3.png", "id": "702839986043204", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819511_702839989376537_5111422849815312984_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKWpArn3GoMQ7kNvwG2bfuY&_nc_oc=AdnNaQMdJB58wZxpLM593hvoRl9RbqrcSEIA8CebM-BOs0HmyL0YB6GsqUK0p_Aju4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzX4_0EbGSFnweATDoHi-cifNo0gqK7rBRnuPhmLQpJaw&oe=69B1622C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main17.png", "id": "1124671639620711", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822034_1124671642954044_2985098334814475166_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFGFKj2SMZwQ7kNvwENP99O&_nc_oc=AdnzY-8JtRMqyIyRJ9a9H2vWudMOiU2Td7b8exH4gGttqaicFG6wKb5tGgWErB41VSE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuluatW4HT5h2pfldr3iye1eoK0ebhEbltQPQpBcnWJA&oe=69B1621F"}, "display_name": "DOWNSHOT", "keywords": ["Sandbox", "Physics", "Multiplayer", "Guns", "Simulation"], "long_description": "# VR\u2019s Most Popular Multiplayer Physics Sandbox (with Mod Support!)\nLet your imagination run wild in our experimental physics playground of 200+ items and endless mod maps, all playable in multiplayer! Best part? It\u2019s FREE!\n\n# 200+ Spawnable Items Pushing the Boundaries of VR\nWeapons, Vehicles, Enemies, Props, Buildings, Superpowers, and More!\n\n{2604967803196130}\n\n# Mod Support for Unlimited Maps\nCreate your own maps and modes with no coding skills needed. 50 million mod downloads and counting!\n\n{735571592360704}\n\n# Non-Stop Content Additions\nNew gadgets, maps, and more keep the surprises coming and fun constantly evolving.\nJoin our Discord (dsc.gg/downshot)\n\n\n{1478480356572702}", "short_description": "VR\u2019s Most Popular Multiplayer Physics Sandbox (with Mod Support!). Let your imagination run wild in our experimental physics playground of 200+ items and endless mod maps, all playable in multiplayer! Best part? It\u2019s FREE!"}]}, "developer_name": "CMVR Game Studios LLC", "developer_privacy_policy_url": "https://www.downshotvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CMVR Game Studios LLC", "support_website_url": null, "website_url": "https://www.downshotvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34105404789074418"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499293144_1681452043021340_7780557687759827079_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob5L2pr4OywQ7kNvwE4H8NP&_nc_oc=AdksDHyUhy1185oC6QVAZPG2w9yU--3obGM96SAXYnqXzrJT4NuhG96bD4nCattkU48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIG0jYEaOI_40gVMOYEK07VgkET_zPPxoFDmv-q5ZuOg&oe=69B1528F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DOWNSHOT
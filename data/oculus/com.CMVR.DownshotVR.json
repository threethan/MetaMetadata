", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820594_720800293836043_2452347550101078325_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrfbtK1_HDwQ7kNvwHdOjwh&_nc_oc=Adn5MMr1ya00ifeclIailzcMuLZTLlwHJBxsxc6TCGPmfivIOXtJ_PuyImBo9YxaMPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuQDFzoiFhxQ3JyRbsecz7nK7F9wKhXxfSnBcnmqj4p3w&oe=69A97F81"}, {"file_name": "3.png", "id": "702839986043204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819511_702839989376537_5111422849815312984_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfT0zPREOcQQ7kNvwFwedgf&_nc_oc=Admd1WfOIQqdw6cuOg-LzCfK7Kf4cUdtrdDPkN6D5CjStOKGa6NdXSkU7Dpeziod5m0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsi5FJMOlb-eBOL3lVZ07jRlRAX-607mEtBVsFzZ8XWxw&oe=69A9792C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main17.png", "id": "1124671639620711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_1124671642954044_2985098334814475166_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07PUQAQFZVEQ7kNvwGpIfAE&_nc_oc=Adkb5cz-LW-_7z2LRDUSYE0M3hQWeX4VR2m3aKSbWyBToYrBVeLJfEV3VDogfMl1OV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftjQ1IyBZeitqsBGEzeic-QVonjVe8IFbJpegP6E_h78g&oe=69A9791F"}, "display_name": "DOWNSHOT", "keywords": ["Sandbox", "Physics", "Multiplayer", "Guns", "Simulation"], "long_description": "# VR\u2019s Most Popular Multiplayer Physics Sandbox (with Mod Support!)\nLet your imagination run wild in our experimental physics playground of 200+ items and endless mod maps, all playable in multiplayer! Best part? It\u2019s FREE!\n\n# 200+ Spawnable Items Pushing the Boundaries of VR\nWeapons, Vehicles, Enemies, Props, Buildings, Superpowers, and More!\n\n{2604967803196130}\n\n# Mod Support for Unlimited Maps\nCreate your own maps and modes with no coding skills needed. 50 million mod downloads and counting!\n\n{735571592360704}\n\n# Non-Stop Content Additions\nNew gadgets, maps, and more keep the surprises coming and fun constantly evolving.\nJoin our Discord (dsc.gg/downshot)\n\n\n{1478480356572702}", "short_description": "VR\u2019s Most Popular Multiplayer Physics Sandbox (with Mod Support!). Let your imagination run wild in our experimental physics playground of 200+ items and endless mod maps, all playable in multiplayer! Best part? It\u2019s FREE!"}]}, "developer_name": "CMVR Game Studios LLC", "developer_privacy_policy_url": "https://www.downshotvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CMVR Game Studios LLC", "support_website_url": null, "website_url": "https://www.downshotvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33621855684096000"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293144_1681452043021340_7780557687759827079_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmYhP5T-gp4Q7kNvwGnr2NW&_nc_oc=Adn3IN8_ZkaHxxvFt7INlZcscYmCwbG9eWyrvsk1SjCWdiidgmepr1jEgp2g4Ralp4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfumFDvFVaV2XMmhNBNo0M6yDwyr7bZHaBMGLBs_5UVoRw&oe=69A9698F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DOWNSHOT
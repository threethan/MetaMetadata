", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820594_720800293836043_2452347550101078325_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLvAtgzM-yEQ7kNvwHoJRg_&_nc_oc=Adn1R5AHpAdo8f5u8GVKfJq-bevukkAruX1yrnUDqZx3y0frcLNn-2XzDKJDqiP4zHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVv8hyhkxaNZ3Mur4ykUsmKa9KrdAGHbkAwI0Iyf60lQ&oe=69BBF481"}, {"file_name": "3.png", "id": "702839986043204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819511_702839989376537_5111422849815312984_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpwcMGTSgjkQ7kNvwHHiHg0&_nc_oc=AdkxQvYhbMguACQDkds5xI3bVszTgYBuyoQD4DKVqqJLCNnMnAajspNAHvSZdgjKK6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLNVoR77aksdLJQtDqYKetTXRxyOSfCjpHj-VSRfcXfw&oe=69BBEE2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main17.png", "id": "1124671639620711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1124671642954044_2985098334814475166_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwmrH9VFV1MQ7kNvwHgLWXa&_nc_oc=AdnXvNTLYDb_RuBxcvZ8W9FuAoL8K3WpeBkmepBfWdU7FxHGaQkDu3aAn2vUUoZs0KE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxyX4iUUfwsDZ2Lue-LM1AwQeco1Q4Se9OpE4AfmoCZOg&oe=69BBEE1F"}, "display_name": "DOWNSHOT", "keywords": ["Sandbox", "Physics", "Multiplayer", "Guns", "Simulation"], "long_description": "# VR\u2019s Most Popular Multiplayer Physics Sandbox (with Mod Support!)\nLet your imagination run wild in our experimental physics playground of 200+ items and endless mod maps, all playable in multiplayer! Best part? It\u2019s FREE!\n\n# 200+ Spawnable Items Pushing the Boundaries of VR\nWeapons, Vehicles, Enemies, Props, Buildings, Superpowers, and More!\n\n{2604967803196130}\n\n# Mod Support for Unlimited Maps\nCreate your own maps and modes with no coding skills needed. 50 million mod downloads and counting!\n\n{735571592360704}\n\n# Non-Stop Content Additions\nNew gadgets, maps, and more keep the surprises coming and fun constantly evolving.\nJoin our Discord (discord.gg/bEHN9PKgTa)\n\n\n{1478480356572702}", "short_description": "VR\u2019s Most Popular Multiplayer Physics Sandbox (with Mod Support!). Let your imagination run wild in our experimental physics playground of 200+ items and endless mod maps, all playable in multiplayer! Best part? It\u2019s FREE!"}]}, "developer_name": "CMVR Game Studios LLC", "developer_privacy_policy_url": "https://www.downshotvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "CMVR Game Studios LLC", "support_website_url": null, "website_url": "https://www.downshotvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34183554747926088"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499293144_1681452043021340_7780557687759827079_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PQbCeG2TZoQ7kNvwEW4xvB&_nc_oc=AdlhNHqtrNb6WHouYzt9HR-84XLK27TaL-1BNSYWBjeQ_weeHRuWPKRVD7bRrfF84sc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfytzdtbW7-k4w5ulYy8C5F5ybUgTF3Ph2LMdbhHoaAqsg&oe=69BBDE8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DO
22742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39345239415090903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793674093, "id": "39634375609510614", "version": "0.813", "version_code": 813, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9166521666722742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39345239415090903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793590344, "id": "39608483882099787", "version": "0.812", "version_code": 812, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9166521666722742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39345239415090903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793477183, "id": "39576929521921890", "version": "0.811", "version_code": 811, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9166521666722742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39345239415090903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "547856043941822"}]}, "change_log": "v1.14 \n\nSpecial Mode:\n- Ghost in the Graveyard\n\nMaps:\n- Graveyard\n- Battlefield (sandbox variation of last man standing map)\n\nFree Items:\n- Jack O Lantern\n- New secret unlockable\n\nVisuals:\n- Halloween lighting and particles in init map\n- New and improved dust particle logic/visuals\n- Tweaks to flashlight range and falloff\n- Trajectory visualizer added to jump pads \n- Flashlight volumetric fog light scattering cone\n\nOther:\n- new music\n- team based damage filter support\n- modular scoreboard\n- team based scoreboard support\n- significant shader global complexity reduction\n- improvements to cpu load distribution per frame\n- far more optimized skeletal meshes\n- shader permutation reduction\n- increased teller parallelization\n- optimizations to dungeon\n- improvements to dungeon doors\n- fix to player collisions with some skeletal meshes\n- fix to some objects being invisible far from spawn\n- teller network optimizations\n- large player network optimizations\n- other player spawn performance improvement\n- performance stats tweaks\n- visual fixes to last man standing\n- optimizations to heavily populated levels like hq\n- memory optimizations\n- fix to possible stale teller render when moving\n- fix to rare invisible teller issue\n- fix to tellers sometimes sending info before local player booted\n- smoother mag insert physics and visuals\n- some fixes to gun mag insert\n- init tweaks\n- fix to show usernames false not always working\n- fix to player ragdoll stutter right before despawn\n- fix to items have collision when player die with them in inventory\n- fix to item collisions after player quickly take out of inventory\n- fix to rare crash with loading two mags at once\n- fix to attachable object ownership check\n- fix to npc walking stutter\n- fix to username culled visibility\n- fix to sometimes car stutter\n- relative ground performance increase\n- android mvl early work\n- pcvr mvl early work\n- hand tracker performance increase\n- hand tracker rare issue fix\n- fix to collisions sometimes not being enabled between placed items and vehicle interior\n- gun gun kills now count towards kill count\n- fix to gun gun damage in friendly mode\n- fix to healing staff getting stuck healing when player dies or slots it in inventory\n- parallelization improvements to tellers and npcs\n- new force field item mesh", "created_date": 1792715354, "id": "39345239415090903", "version": "0.809", "version_code": 809, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
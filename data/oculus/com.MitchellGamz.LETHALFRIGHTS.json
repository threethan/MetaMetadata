n.com/v/t64.5771-25/473393491_1418410325993065_1570941219904467934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tq_wQn0HpMMQ7kNvwHZZ2dj&_nc_oc=AdpTK7NCVUnQEIMyy1gooxcQH6L9Cz6Hsyje37CH1UAx8KRaEeFjT4wwjnkiCvlJOzU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGX2YD9mzMOUwgpFaGeF781e41Sc5828ZyH9DGi-7-Nw&oe=6A941FA9"}, {"file_name": "1000009654.png", "id": "1028259762491286", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393320_1028259765824619_7136695030645941686_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjj6EIHkVW4Q7kNvwGbPfDn&_nc_oc=AdrpBx379GOaRdp_aCOekxJcbbjiYnIlIzlXl30_ng4fI7tYlqJ3YwNvNG66zA1Y4to&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHJtPee5XAR9ifHXOWq0AI5oc3bMGBORbgN0F4ZAo71A&oe=6A9407C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Frights", "keywords": [], "long_description": "Lethal Frights is a fast-paced, movement-based horror game that challenges your memory and awareness as you navigate eerie, escape-or-die environments. With minimal lighting and unsettling sound cues, every step heightens the tension, keeping you on edge. If you're looking for a game that truly delivers fear, Lethal Frights is the ultimate test of your nerve.", "short_description": "Lethal Frights is a fast-paced horror game that tests your memory and awareness as you fight to escape. With eerie sound cues and minimal lighting, every step keeps you on edge, making fear your greatest enemy."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/lethal-frights", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-frights", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id":
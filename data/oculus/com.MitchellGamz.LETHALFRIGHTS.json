n.com/v/t64.5771-25/473393491_1418410325993065_1570941219904467934_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiW-EM6KH1AQ7kNvwH2Z0TL&_nc_oc=AdpJN8FLPJBmoTDfoZbFt7Ib46Kk-9yj9Q0Cw9-iqretFAvZ8-rYKZxmkBICy3T-ySM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPge9CaD4_p2uwQ5GEokuxmgPwvwb9s9yyE87Q38kyBQQ&oe=6AE1E829"}, {"file_name": "1000009654.png", "id": "1028259762491286", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393320_1028259765824619_7136695030645941686_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9rLw56TRqEQ7kNvwH4b-4Z&_nc_oc=AdrG-uWwab6y0HHsE3OH6ArS71FzDIzkx4PkKdnwCek_FDGwoTDo_IFrbzntuHledKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc3D0hi1lJd1bSVTQ5do5mg1yzqCsTHQ6u2b8tCGssbg&oe=6AE20887"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Frights", "keywords": [], "long_description": "Lethal Frights is a fast-paced, movement-based horror game that challenges your memory and awareness as you navigate eerie, escape-or-die environments. With minimal lighting and unsettling sound cues, every step heightens the tension, keeping you on edge. If you're looking for a game that truly delivers fear, Lethal Frights is the ultimate test of your nerve.", "short_description": "Lethal Frights is a fast-paced horror game that tests your memory and awareness as you fight to escape. With eerie sound cues and minimal lighting, every step keeps you on edge, making fear your greatest enemy."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/lethal-frights", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-frights", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id":
286", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393320_1028259765824619_7136695030645941686_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Blp9SqCXW-sQ7kNvwELnqnf&_nc_oc=Adn2qB3XHS9btBAYrXH7ezstTl-rw6f5oHuYQbcKic77pb5RVuhd0J5swJNhIEHz_3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsjRxb3Gztv1ufPYj8mmIzPzbHKqqU3i1fDDvN4eIVAGw&oe=69A56847"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Frights", "keywords": [], "long_description": "Lethal Frights is a fast-paced, movement-based horror game that challenges your memory and awareness as you navigate eerie, escape-or-die environments. With minimal lighting and unsettling sound cues, every step heightens the tension, keeping you on edge. If you're looking for a game that truly delivers fear, Lethal Frights is the ultimate test of your nerve.", "short_description": "Lethal Frights is a fast-paced horror game that tests your memory and awareness as you fight to escape. With eerie sound cues and minimal lighting, every step keeps you on edge, making fear your greatest enemy."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/lethal-frights", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/lethal-frights", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_mod
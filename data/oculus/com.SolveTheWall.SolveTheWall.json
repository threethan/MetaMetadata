5_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbMDt0jZtakQ7kNvwGtSMFp&_nc_oc=AdpOO7EWxzS5QXk0FWe4VDNA90r72KE1_gIx2e24-UuUq5D5BBMzw7n808yeYArlsCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnznGMgtEtj3uAsM6GZvEuahr--cEvBuAGWL-CFkVocg&oe=6B05A6FA"}, "display_name": "Solve the Wall", "keywords": ["puzzle", "climb", "climbing", "solve"], "long_description": "Solve the Wall combines climbing and puzzle solving in virtual reality. Each wall has a unique layout of handholds, magnets, hooks, and elevators, with only ONE PATH to the top. There are many dead ends where you\u2019ll have no choice but to let go of the wall and restart the level. The goal is to find the right combination of moves that will get you to the top and solve the wall.", "short_description": "Solve the Wall combines climbing and puzzle solving in virtual reality. Each wall has a unique layout of handholds, magnets, hooks, and elevators, with only ONE PATH to the top. There are many dead ends where you\u2019ll have no choice but to let go of the wall and restart the level. The goal is to find the right combination of moves that will get you to the top and solve the wall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solvethewall.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Solve the Wall", "support_website_url": null, "website_url": "https://solvethewall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
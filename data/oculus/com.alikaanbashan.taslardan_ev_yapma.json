73849508259600451_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbYK9Av2w6QQ7kNvwFkAZ3U&_nc_oc=AdoK_ZkJ1jSppowLOIlQqPFGsUTENVxzA8RkL2IBtkRbC9fWUOf4-ASf44sCWMT3Q2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6tQDnCh6XFNDMbjSUNU3ObuIGoPoDcDZijUb7lQB0Fg&oe=6A733F2D"}, {"file_name": "2.png", "id": "975815914955764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824328_975815918289097_4331985240066759959_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1YotoMAWFMQ7kNvwG6d-an&_nc_oc=Adp0BbrWsYNEiIAsOMQ95NzZvSULrc_Dzs9yKoxHRJsWnkTaMk6kJUc1TP1KfRxcx6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5h595vpORj6exejrJ_hCJyoetsAvmAVLX4cLRjo6I-g&oe=6A732DD9"}, {"file_name": "5.png", "id": "1466621998255228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828038_1466622001588561_8620975528115782714_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWkNii4X7vUQ7kNvwEAW0J4&_nc_oc=Adq5K7QUzrw-hslnsp4H-BGeS9wwO4Jwg5Qklxd82lCAsSX44etiFpSg6MUb-MNEjhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUVbTzrKP6ANbldWykiWSTCw4cJhJIGKUr7PUU-I5SrQ&oe=6A73482A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v2.png", "id": "941160721839549", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_941160725172882_1621476474098091138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Law2dBmMon0Q7kNvwEZFtGg&_nc_oc=AdrbBFBRy7k5OWcE-WqQ0TiomJY9W3JSJ6kUc7NsrefTDCUbDZZ-TOLP4Cms8habHj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNh7_t3OGuI0K9Yu-6q85a_IrJ2JDX2hzKpP2jw-Ra1A&oe=6A734D50"}, "display_name": "Stone Builder VR", "keywords": ["building", "sandbox", "construction", "relaxing", "creative"], "long_description": "**Stone Builder VR** is a hands-on virtual reality building experience focused on creativity, freedom, and calm exploration.\n\nUsing natural hand interactions, you can grab, move, and stack stone blocks to construct walls, structures, and custom layouts. Each stone snaps smoothly into place, making building feel satisfying and intuitive. There are no rules, objectives, or time limits \u2014 just you and the space you create.\n\nMove freely around your construction using smooth teleportation and view your work from every angle. Whether you want to carefully plan a structure or simply experiment, Stone Builder VR encourages creativity at your own pace.\n\nDesigned for comfort and immersion, the experience features subtle visual and audio feedback that makes every interaction feel grounded and rewarding.\n\n**Key Features**\n\n- Hand-based stone grabbing and stacking\n- Smooth snap placement with tactile feedback\n- Teleport movement for easy exploration\n- Relaxing, open-ended building experience\n- No pressure, no goals \u2014 build freely\n\nStone Builder VR is perfect for players who enjoy sandbox creativity, calm VR experiences, and the simple satisfaction of building something with their own hands.\n\nBuild, explore, and shape your world in virtual reality.", "short_description": "Stone Builder VR is a relaxing, hands-on building experience where you grab, stack, and place stones to create your own structures. Move freely with teleportation, experiment without limits, and enjoy the simple joy of building at your own pace in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/5_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26555874197365615"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_770316399446575_3035625582964668128_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_7ktUl40I4Q7kNvwF2XCOR&_nc_oc=AdoF9qBnVyjEevI1H3PuFw-Hi6oNNwwNSPZxGG57kd7-6sx0Urx-gTE97VRPv7hTHTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQZgl1-tNaET8BJEZQlytkgYTdICHWrZh1BFSHZQLMKA&oe=6A732AEE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stone Builder VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "World Creation", "id": "1725996564472128"}], "release_date": 1770091200, "lastRevision": {"nodes": [{"id": "25836971769255865", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25836971682589207", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1216286846715508"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "logo_1024_2 - Kopya.png", "id": "2402327160187205", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_2402327163520538_658132715026322805_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGltrU6p3OsQ7kNvwEenSW5&_nc_oc=AdrwGcwacG_TrXJLJbg7p0566AcDy8jwQ5EiHj4120ReMAypGDmOVnq6nedU_X4vqz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK-g
on. Each lane offers a new level of intensity as you improve your aim, master spin control, and chase perfect games.\n\nPlay in beautifully designed VR environments that bring the atmosphere of real bowling alleys into virtual reality. Whether you are a casual player or a competitive bowler, the game offers smooth gameplay, engaging challenges, and endless replay value.\n\nBecome the ultimate strike champion in Bowling VR Club: Strike Arena and master the art of precision bowling in VR.", "short_description": "VR bowling game with 3D physics, realistic strike gameplay, and 3d bowling club competition in immersive strike arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fun-soft/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Fun Soft", "support_website_url": null, "website_url": "https://sites.google.com/view/fun-soft/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26706930785643914"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1571452704352356"}, {"status": "PUBLISHED", "id": "1349801610333284"}]}, "baseline_offer": {"id": "1349801610333284"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1571452704352356"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": 
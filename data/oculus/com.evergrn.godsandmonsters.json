17_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JA6MLZFneKgQ7kNvwGY2g_B&_nc_oc=AdrVQNPg5KiXkRQWBINObAZVjFl3BmnzQzYPkehM2PD8mMJj_g2jU1XVrg_gym4RP30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5z5cmLVhRAsVV7G1hPo1_A1FqBxpFqS1azcWm2JJEWw&oe=6B0D9B5D"}, "display_name": "Gods & Monsters: The Battle for Belief", "keywords": ["god", "strategy", "monsters", "sandbox", "multiplayer"], "long_description": "You are a god, and your worshippers are watching.\n\nYour villagers build, farm, fish, pray and grow from the Stone Age to the Iron Age. Every prayer becomes faith, and faith becomes power.\n\nSHAPE THE WORLD WITH YOUR HANDS: raise hills, flatten plains and rake passes through mountains with your claws. Scoop up the earth, pack it into boulders, fill them with your element and hurl them.\n\nCOMMAND THE HEAVENS: rain for your crops, lightning for your enemies, thunderstorms and floods when mercy runs out. Bless your people, raise temples, and choose spells from a glowing wheel of hieroglyphs on your wrist.\n\nUNLEASH YOUR MONSTER: transform a villager into your god's towering monster and watch it march on your rivals.\n\nFIVE GODS, THREE WAYS TO BATTLE: the Sun Lion, Ember Dragon, Smoke Genie, Tide Mother and Green Warden, each with a signature power and monster. 1 v 1, 2 v 2 and free-for-all against AI gods, plus local multiplayer with friends on the same Wi-Fi.\n\nEARLY ACCESS: an early, low-priced release. Multiplayer is local Wi-Fi only for now; online play and more are planned as the game grows.", "short_description": "A hands-on VR god game: shape the land with your own hands, command the weather, summon your god's monster, and out-believe rival gods for the worship of a living island."}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.evergrn.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Evergrn Games", "support_website_url": null, "website_url": "https://games.evergrn.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1440661519130604"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312439_1940932360210718_2969720357379056062_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wxK2mWq3g0Q7kNvwEwVNgZ&_nc_oc=AdoLlz2X6zv6KkgAsa_mUpgAPpyIaFN_p5219EXBoivcfwjhGDnyYZpT9T0eSAcTP_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRONsujUBQ-0ViHrGal2JhHvkQylrfMIek9qgZs5B4kiw&oe=6B0DA847"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gods & Monsters: The Battle for Belief", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1794328560, "lastRevision": {"nodes": [{"id": "1440661532463936", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1440661499130606", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1055874347508247"}, "iarc_email": null, "msrp": null, "translations": {"node
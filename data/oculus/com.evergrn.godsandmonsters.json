s=7f30f&oh=00_AQTntt_6HDJLBAdx49zgv88ExP2QtOH8BufWwbQDTCB0XA&oe=6B0DAF20"}, {"file_name": "06-rival-deity.png", "id": "2348295005945520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313072_2348295009278853_1852656109222056874_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV1bdf8OEOwQ7kNvwHi9pLc&_nc_oc=AdoOhgcKsf7gUGAfzsVkj-TVDbmzGwVDXacTadDDnmA1FMIY0avtbQCRFeeTnx9DJB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROo-PSQ5f8OKmRdyMjMmtQFZ5Xsdw8vMO6_TESMHaENQ&oe=6B0DB1F0"}, {"file_name": "03-kraken-summon.png", "id": "28989583370694042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_28989583374027375_9122369637856334489_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7_v_VFWw-MQ7kNvwEDqkPz&_nc_oc=AdpOEktnf6Uh4v0ITuXnIkaf0AHrcUVmuYHENSUqqGUqSrfbBk-ddg3gUmz6m0hyOW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6kgeq2Ch-9xVbLoZv9oyJUaqTCtgH62Bpog-HUMcShg&oe=6B0DBDFC"}, {"file_name": "02-call-down-lightning.png", "id": "1881489919523890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1881489926190556_3758804828691700890_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEfsp1OEsR4Q7kNvwFv9Xi_&_nc_oc=AdqrYjxcWSi3G4oJQbu0qPeghQH2_XOGFsPiPtzIrV8Xvdr52qvOz2yqsWe0c0ey2Ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwJ2xtsQtx8igSqaowFGN8HxYO1RWSXf8peUmIJSlIVg&oe=6B0DCFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "3061647117525709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_3061647120859042_7787415907603486617_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JA6MLZFneKgQ7kNvwGY2g_B&_nc_oc=AdrVQNPg5KiXkRQWBINObAZVjFl3BmnzQzYPkehM2PD8mMJj_g2jU1XVrg_gym4RP30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5z5cmLVhRAsVV7G1hPo1_A1FqBxpFqS1azcWm2JJEWw&oe=6B0D9B5D"}, "display_name": "Gods & Monsters: The Battle for Belief", "keywords": ["god", "strategy", "monsters", "sandbox", "multiplayer"], "long_description": "You are a god, and your worshippers are watching.\n\nYour villagers build, farm, fish, pray and grow from the Stone Age to the Iron Age. Every prayer becomes faith, and faith becomes power.\n\nSHAPE THE WORLD WITH YOUR HANDS: raise hills, flatten plains and rake passes through mountains with your claws. Scoop up the earth, pack it into boulders, fill them with your element and hurl them.\n\nCOMMAND THE HEAVENS: rain for your crops, lightning for your enemies, thunderstorms and floods when mercy runs out. Bless your people, raise temples, and choose spells from a glowing wheel of hieroglyphs on your wrist.\n\nUNLEASH YOUR MONSTER: transform a villager into your god's towering monster and watch it march on your rivals.\n\nFIVE GODS, THREE WAYS TO BATTLE: the Sun Lion, Ember Dragon, Smoke Genie, Tide Mother and Green Warden, each with a signature power and monster. 1 v 1, 2 v 2 and free-for-all against AI gods, plus local multiplayer with friends on the same Wi-Fi.\n\nEARLY ACCESS: an early, low-priced release. Multiplayer is local Wi-Fi only for now; online play and more are planned as the game grows.", "short_description": "A hands-on VR god game: shape the land with your own hands, command the weather, summon your god's monster, and out-believe rival gods for the worship of a living island."}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.evergrn.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Evergrn Games", "support_website_url": null, "website_url": "https://games.evergrn.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1440661519130604"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1644261343903162"}]}, "baseline_offer": {"id": "1644261343903162"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794328560, "status": "PUBLISHED", "id": "1644261343903162"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1470019806194775", "version": "0.7"}, "id": "3857512314386739", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1440661499130606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1470019806194775"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3857512314386739"}]}, "change_log": "New Evergrn Games studio intro at launch.", "created_date": 1795446692, "id": "1470019806194775", "version": "0.7", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1440661499130606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1470019806194775"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3857512314386739"}]}, "change_log": "0.6: Villagers now react to you! They adore your hand, cower from rival gods, gasp and scatter when one gets eaten, and wriggle when held. New ways to win: hold 70% of the world's people for 60 seconds, or set a 10 or 15 minute time limit. A Belief bar in the sky shows who's winning. Online Quick Match finds other players more reliably.", "created_date": 1794776591, "id": "1454772124386210", "version": "0.6", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1440661499130606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1470019806194775"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3857512314386739"}]}, "change_log": "You now always start facing the intro screen, and every match begins right beside your own village, wherever you're standing in your play area. Recentring your view keeps you in place.", "created_date": 1794412497, "id": "1446451531884936", "version": "0.5", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1440661499130606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1470019806194775"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3857512314386739"}]}, "change_log": "One-touch multiplayer: the tablet now has a single ONLINE QUICK MATCH button. It finds an open game online or on your Wi-Fi and joins it automatically, or starts one and waits for players. Online play also reconnects to the service by itself if it wasn't available when the game started.", "created_date": 1794408557, "id": "1446338885229534", "version": "0.4", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1440661499130606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1470019806194775"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3857512314386739"}]}, "change_log": "Online multiplayer is here! Host Game now lists your match online as well as on your Wi-Fi, and Join Game shows online games marked (online). Play 1 v 1, 2 v 2 or free-for-all with up to 4 gods anywhere. Smoother partner movement over the network.", "created_date": 1794407090, "id": "1446289885234434", "version": "0.3", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
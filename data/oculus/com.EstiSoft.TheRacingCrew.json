v/t64.5771-25/491823270_1257980772500297_8690490368912691982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU5SUKlaqokQ7kNvwHl4aVq&_nc_oc=AdqaydrXinMycEJmnR0SiFuFai02FZl6jmXKCc31EhFqiU1jH-MVAWZZ7I6fwhYMvjA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzBdMDcO6XSJf0brraY2fqV_dcmO9B7R7j2iZ_yuPojg&oe=6AA15718"}, {"file_name": "1.png", "id": "918564747763863", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823366_918564751097196_7477949949055949790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4qSjFoxFeUQ7kNvwHkuUiv&_nc_oc=Adqbz9WbNaZRZeR-_98HVhprS9zuuou6aGAw-8XAcfiklD3Xea5FpG3tDyDzlf4PniQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKDHEkmceoFxI6UC0a-IncI8YVjCoRIhxAdezAYOs9Kw&oe=6AA165D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "2242645579597292", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_2242645582930625_2052447338803975953_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TF_XbjzFlhoQ7kNvwHNxIgm&_nc_oc=AdrUO2aCXQ2X0q2sF0e-e5gGQqUxWL55weMNpD7ctTMtnjdJTx7u-8ZG5CsKe_b1jIA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkpshGJTqbP0T3OgAEASoRVmyf7TcZ1ibRcSIqqtCZNQ&oe=6AA15ACA"}, "display_name": "The Racing Crew", "keywords": ["Racing", "Drive", "Driving", "Drift", "Car"], "long_description": "Step into the ultimate adrenaline rush with this fast-paced arcade racer, bringing high-speed thrills and intense drifting action straight to your Meta Quest. Feel the raw power of your engine as you tear through stunning, diverse environments designed to push your driving skills to the absolute limit.\n\nWhether you are burning rubber on a sun-soaked coastal highway, kicking up sand in a vast desert, sliding across treacherous ice-covered mountain passes, or navigating the tight corners of an industrial shipping yard, every track is a unique adventure. The arcade driving mechanics make it easy to jump in, but mastering the art of the perfect drift takes true dedication. Chain your slides together, perfectly time your steering, and watch your drift multipliers skyrocket as you leave a trail of thick tire smoke in your wake.\n\nOff the track, your journey continues in the immersive VR garage. Here, you can admire your growing collection of vehicles and prepare for the next challenge. Earn your keep on the roads to unlock a diverse roster of cars, from sleek street racers to aggressive drift machines. Experiment with striking paint jobs and fresh styles to ensure your ride looks just as good as it handles. Every successful drift brings you one step closer to completing your ultimate car collection.\n\nImmerse yourself in a racing experience where speed meets style. Put the pedal to the metal, conquer every sharp turn, and prove you have what it takes to own the road!", "short_description": "Get ready to burn rubber in VR! Experience the thrill of arcade racing and drifting across diverse environments. Take control of powerful cars and master tight corners to rack up massive drift multipliers. From sun-drenched coastal highways and unforgiving desert roads to icy mountain passes and tight industrial zones, every track offers a new challenge. Head to the garage to unlock new vehicles and customize your ride's look. Step on the gas, perfect your drift, and claim the road!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24162578920051947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818916_1526227948785284_6977486365398800142_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KojW2WIqrx4Q7kNvwFfftkU&_nc_oc=AdpbJpbxJRoWut09JN9RW1Y7D6Jf0WbgbL2VYEWC7p-L8cDKgQIC8sE9-HPTgwoPhio&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP0LX1wersga1bfhmjdTXkhAvB9MS3_M_vR1mVKg2biQ&oe=6AA14A79"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Racing Crew", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Racing", "id": "673385183287495"}], "release_date": 1773685140, "lastRevision": {"nodes": [{"id": "24162578970051942", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24162578910051948", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "829239343518745"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Hero Art.png", "id": "2421098178271620", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295272_2421098181604953_4875607113618799380_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkuS7ybbkxsQ7kNvwEcLN_g&_nc_oc=Adp3cITU-4mGlRM_LC2U3DxJHpT4urY0ypKWFSngRWr8MJCtkXrCt7s4DzxAPXKWsKw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.c
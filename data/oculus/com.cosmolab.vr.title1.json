dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ0ix4NOoBQQ7kNvwEXg-bR&_nc_oc=AdoymMY8OlFHZhtmtNypPwhkV66IJ_WyBxRpWhx_EnJZbRe_4hLF-yovP3WKQJmojWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDuqSkMxuov8BlUx7KBaU77poKO1clCO4u_uK8YzE86Q&oe=6AEB3FA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNndnd-hZqEQ7kNvwFq0bdj&_nc_oc=AdqUF0E0mtN5_ydjWdx1IIpG0gEMK8IMehcaBtvx1wTBEoqtzVJf10s6GyA2efyOXnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkIG898GeGmjUCnMBe73oPxneEcrARwhZhPYYmrUSlUw&oe=6AEB3A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT0kvj9n35wQ7kNvwF9txt-&_nc_oc=Adrt4by644Cit3DByLV_AeGI5yXcCgtXFYxN8iQw8MiVdMIH7nfYZMxIRJZ7NEABQrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHndgfi21yGcnmAw69J0n-Ii_cDgwmzSOaDlApRewO0w&oe=6AEB3FE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
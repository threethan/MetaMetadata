dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0iCXkO-HUwQ7kNvwH-UM_1&_nc_oc=AdquXClyh27zsifsKA121A2l7kX6ebL9smDKOardUvplx_oug9H-FKwgoUn87TaCodk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j6CmR7FKOOWEQeBn9a23IeG1w5XF726AwIE9dsA0OpA&oe=69D51326"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIirsaottC4Q7kNvwEH1sdf&_nc_oc=AdrWBVd9XUbetdR_slT7rmnlKr1dA4TP40DHma-JpTSJpK9XETPryKHphknXXX5J_y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lkFbXoDwzlWfVnM46SnYnsKO1l3kY7V9Izys-JLSkjw&oe=69D50DF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXWHD9tT4o0Q7kNvwF1Bc9o&_nc_oc=Adpi640EROR8VEArCL3h0HdAgXTdq4lqCZ5FgcaHqHz-uD6n07eBwm32NpySb1oYokE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wQTBa803qfHK4YloF0geHAccdeghdIZy74IwegjA6_g&oe=69D51364"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0iCXkO-HUwQ7kNvwFdReMQ&_nc_oc=AdoiyterSFIeE2dMQFYd-xHUm_aqMOF89o3ZsBCyzHwObKS7bv1A04-1dWxZAvMKpao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X6kCQW4KgFV1r6n_xvi95BDbgUh_HAkO5z-gLea6mGw&oe=69D3C1A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIirsaottC4Q7kNvwH2eqEd&_nc_oc=AdpDyqdc2ifpaIWg88ONcQYGzRjiPL5geBlBxx2un-oLAepMWybOuQn6aokOn_QvAks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ezzBb-YxWLxZ8DmHtGKJTkWz41LeB7G5EnmBt_JOnOg&oe=69D3BC71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXWHD9tT4o0Q7kNvwGSIzLC&_nc_oc=Adq83tZ-FTCsObUL2tdIbjpFR2_h5gctTE1-cKhuforbs_jCT1tBe6xt4Dvjgr9sFLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2POAF96UolDPXq8ZB9ZFcWi4OffcZOMcu1TMSi1IGNfQ&oe=69D3C1E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNuFnSMQgtAQ7kNvwFbKJ07&_nc_oc=Adp4lVwh08jRv5fg5uf4gPjv1fBbkF-lp-UBC3tjKUsi8ecVsxM-mdfiiLrFDoIXIX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cHGI28xyhq9ap85g3eoEuk4PGb6qZ22F3BuZ_Ds85cg&oe=69D27026"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIirsaottC4Q7kNvwHrIFA3&_nc_oc=AdqP2fG4vf_WVVkX82o5Edj_rMKQ8RYalAiC8q5yN3Ai7_nT77FW8F6z4AoKpyKnhHE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MxSu-1KOITDBZbWhjRSCq1dXUTwKBop0kDWl5XKgzCQ&oe=69D26AF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFEsqBjVD54Q7kNvwEMIAbs&_nc_oc=Adrh4yX4oJNK1H1SlfasDVrW3ZVBH1jI8T2ygDpNjS0ypbxcSREZrsOz5EUm_lbpnJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28zVdB2Ejru65RLdLGqDvxHFwC7zAsMnNe0IpIxaTrKg&oe=69D27064"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2eAIINQ6UAQ7kNvwEnN-3O&_nc_oc=Adoyn3c4BiFDIWaUQxF3_gHBSsFAKQpISwJHs88yHF0EF_Bgk4cERmhtu1fKpHTiSj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKhxUT4XPJwhdeiOc5YisCuGZYMdcnFdo8lIoOUOVNmg&oe=6ACA4A26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22IHdW2w1XUQ7kNvwHVj6CC&_nc_oc=AdqMc86SYGGGoOYtj0Hkql6EAErPLm4w1Se3k8OmvPBbmJ3YRoiH9VxZf0WGvpmB76A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFDgwqSoEYkhHmzCXcmdew8r6c63ZEAj0po0plNNKlLA&oe=6ACA44F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqklCrHEi9AQ7kNvwEV785G&_nc_oc=AdotzXxjEwaZwwxBPJsc0ciQaGE3j5GnIoHmlSYxEIi3nQrn8-zg2OJbHt9DycRclak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh8GvvndD7i_DCTH3UI3TDMLwyfOATn6tng3JzzEV3OA&oe=6ACA4A64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
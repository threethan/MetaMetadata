dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKecvmrtwQsQ7kNvwGqfdOE&_nc_oc=Adr_1cj7dbS6UOYx1BOtGjRyd4rQyhMYxBzxQhH_xqqTgyZZoZ3uHN_wHXqoC1yn3tE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tmA3bUrFZ6i0mPrymjuMzarYX5vuzrzw-37UM76r5Ng&oe=6A1D95A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CU8uZfMzwcQ7kNvwESjAC1&_nc_oc=AdpNd4HlADUnaPcTqX9B8f-tM3GdXT2nGixhKGjEboEoyYvQqgi5hmvwticCAO_k4Vo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J0ixX5Bef_Ny_YWOxz9laiaomlyTJFAOnTs7P6p2-dw&oe=6A1D9071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrJCJv5gEDUQ7kNvwHffkAL&_nc_oc=AdoKL7_D3JWEb_k9PyT8ERyrBzFv00TQNv_r7HA3E25cIrz0GST_4tON_GSwdxSAlRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60eJBZ-hAEFZwC5et2kBca7jpSpzkUnPwYmAX1hu9Qpg&oe=6A1D95E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
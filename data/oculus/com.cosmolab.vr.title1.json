8015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_vpX6VL7A4Q7kNvwFNMju2&_nc_oc=AdllcL_0SvKcSVtrM4JPYfudAJHMGqSenJXJmJCXamYenlwSs353p_cmKxQgx7CEOvw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyh8AngddP-viCrDgrrNZrdEQbAUygmEbRwmurYokhfKw&oe=69AAE326"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9jFkoxoaYkQ7kNvwGOvBXB&_nc_oc=Adk-Mok9_PN3gkAXHOWnk8mkEFMlSya3fU5oAIgsi_hglN3UW_nGD1ctUvWFHnXU8DE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ82WRscfm0VUZ3YTM8rqAlk2tbk6yaKzUHts6tcuE5Q&oe=69AADDF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDoHQLT5UOoQ7kNvwGJXz-H&_nc_oc=AdnqdS-jE4RTtKlKP4WS-N1Z-xh7Rt2KktDyluWT3Cy29DfCQqS3NRxi-qEigC3sZ3E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx94iKNQk4w0m7SqlrwGWTtiWh3uXRa7A4-aSt7oBvVRg&oe=69AAE364"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted variou
.oculuscdn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPKvPrkeg-MQ7kNvwEkrIvE&_nc_oc=AdpcQp3rVQiuyt2fMpUYc2zl_3cjH2VcA-9Pn876ruGlRZ-2uWesZxj50tjMTEtbeEk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AeH1qJcmoZipbRsPtcoVi3XDyerjpPI7i8EWbdNesAQ&oe=6A467426"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_9ND7j8lo8Q7kNvwEKLwdZ&_nc_oc=AdqMSVeztFohAZGNbfL4NWkeqzEkEE-K0O1yoMf9JlcHAqebsMKZg8hsj-Mcua6J3E0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k4WKddJYX9QjR7O_vQsC681j2sip7CEw6GU0kD7G0Ag&oe=6A466EF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oTVgY7HqGgQ7kNvwG6z5MN&_nc_oc=AdqcRziLx2uTdmR21_etNsBVOkYTRUxQU28dSZAf3sxgS2OXnkBNYt0DyUJgRmMg3L8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oqeKTI3ta2Mtjr05ySS9EYGCSip3Lzefv9nZGEqwZSw&oe=6A467464"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest."}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/ar-privacypolicies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/amusement-rides", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7498032633654866"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75196221_2765383943649014_5298624600072215707_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujikundl-l0Q7kNvwEcbDCI&_nc_oc=Adr3eoDten-9SNaq4evfC_PeAyyQtT2vINUS8lOivMWT-xSLdA5BrK3-e51GxzaMeOc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CqiRghSBUdAP-u3FC_-rPm5qM0vaKFYVzJcJ0NBMtoQ&oe=6A466D01"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBhgJXKfynYQ7kNvwH_dv8X&_nc_oc=AdrUVEKCWxRNsUq3lKipCURqN_ApSesbvLPQrDS66I-KDyOw3brGZj90o41cgnCpV9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9-02K8aXe4_TXKY34oh_OUrKuUr0KzeBJF_Yk-eHdGA&oe=6AF8A6E6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyR-nvJ_0QIQ7kNvwEwc001&_nc_oc=AdoyWQZvZ0ER5pWGy_bu5_q4z5xBN0ky9VpSRqJzPvywEqhGoe4Zw9xjEewRc2alQe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS4OcHj7i4o_u-ytonY1cnrFO8EvAIrVjoYXZsGDsEHg&oe=6AF8A1B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB9OJ8P1qCMQ7kNvwGT0Lqe&_nc_oc=Adr21yvD853fmLKAJYWTYdBRrYW2Nc2AyS1RowdoOM4ePWj4R3h5UQdFC9Z_X8Z4zjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ17F4Swxo-z7Ny9iB1aIf8P8Hf18VxoYUFsFqKd12laA&oe=6AF8A724"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
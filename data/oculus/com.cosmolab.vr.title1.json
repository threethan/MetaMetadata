Eev2II&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZr73dVreEs1UnO_7vfRdReILIzr1Ze0JPLQsaxYjZHA&oe=699B1126"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-Cix4tCcfkQ7kNvwGfxI5b&_nc_oc=Adm663Vqyplwa3JvOe5y636yL-dFkA6oFs1gzZs7Isb1QBtBnFqMFlV5V7yuVyUwx9I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv_zuGR6AeB3RJMMxaRnkuwTD3YnEDTPaJ_GTxzdpggJg&oe=699B0BF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCdDKYr6tnMQ7kNvwFQnRaV&_nc_oc=AdkdU5DbBCGSRqEKpWZY_YUX-cvNyR39hof60ErNmmFNpJw2yJxAW0pjcGoNBWAfk1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft5LkFW-z5M5xlskFTdHbEdOXTe4kwcCBYlhjYsvLf6tQ&oe=699B1164"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot
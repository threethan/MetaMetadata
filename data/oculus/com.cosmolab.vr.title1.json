dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftxsue-cj2UQ7kNvwEQua_u&_nc_oc=Adr-iiOTDLEMel4-piKgI96IGw6-kq-DFn8inHUhPVPnEVefHdBOXysWLxg3qWAMmLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOzHBK29HQqaNob8MIieyUe_RcsaoUBZphUUq-34K9IA&oe=6A95C666"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuC1bZZVKLwQ7kNvwEOtKOK&_nc_oc=AdoAfOA1mNCRamSpiA8Q4hLg1Xv0taB8wgcLUr2gIEYI788LEgmXxRm6s1EltEyC-pk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuI5XeBFHzREx2g2ejAs2jrZnlrsh_cUOBdavoEqFvgA&oe=6A95C131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uJl6knFiCsQ7kNvwEt4INx&_nc_oc=AdqERskkDyBmKHg8DLP8N1L12gHFRnPRwKmqOGgcIVuTCogHdTIR5LoKXJnDCzQs7To&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFllivWdb_Hosl88yCqvz01YcXUDkRCh7edKhFgKawN2w&oe=6A95C6A4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
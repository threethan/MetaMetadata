dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNuFnSMQgtAQ7kNvwF5Kc93&_nc_oc=Adpi988yIXCg8e55rvT_Vo1ybFtzW61uEqp_1g1fLuqTnFGfKx0Uv3O0rb-Wzp5SYiA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNZdmFcIA081aN4B9XSXIDpdRq99fA23FIKcdHKnC4Gw&oe=69CFCD26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xe9mBgsQicQ7kNvwHoh7Qm&_nc_oc=AdrenXYLBQTBo7fYwl5HuEl8FExVemkdF0pMOuTpAfZSEBFYNkjUZ78oG7UPM5b6VPA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwr1hgUVbtmNrjQg2V1nlbRMH8ZcU4GwQBqVnAxOkTsBA&oe=69CFC7F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFEsqBjVD54Q7kNvwGXwAFB&_nc_oc=AdoHX2uYrwA--i-GHonA7ogmMFZ_gMpEWbaGHgXXj6oUPgteQGevejoyHDw-GV1fKhE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzt3lQ7ntwj6oDY3EAltESZXlWpHuWKf7k_Iw2grE6Saw&oe=69CFCD64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
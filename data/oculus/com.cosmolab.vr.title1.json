dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPKvPrkeg-MQ7kNvwG2YLXJ&_nc_oc=Adq6gSG9D7VnM61YZIteWXPr4XW7RcVU6ZrGBkD07o1mxnuqvsRCbBJG1m3KSGNc5rU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t_w7zUapwiAcgdqWQOIhkpLN74XzJC6qJXzYqVFauSg&oe=6A47C5A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZUkxxyY2HYQ7kNvwGsQkxl&_nc_oc=AdqA3zngjp46o1ECwi4KWxbwUhqpPxJoScoYh3MKwkZ8SJD55eZpF6K8VESrwIPiQAs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o2CPiwixCii_9j4DiMvc2_N771nIiHqeRUrhrPuo7mw&oe=6A47C071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oTVgY7HqGgQ7kNvwGU52qr&_nc_oc=Adonmcf3444w2N24bkEaI7SDdP-_9DynEMsYm8gnlyGnJAuGr_RM9EgQTQECs3dPOuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VOkrEn7EvL-B3Q7gWssDWXFPbQyOq2E6vJ0ActIwtww&oe=6A47C5E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
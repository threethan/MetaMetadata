dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2oG5cfMynEQ7kNvwEs8q37&_nc_oc=AdpBOpVk7ZT1YwE7Pg1aAd71lEf0Cuy0CP_hn_Oyi4_ncrhQJrgvng0NbJp36jRntag&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e3hjlLCy84fcBB4vKvNcSAv5XveLUBhJ3uJOoo3CFdg&oe=6A4522A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_9ND7j8lo8Q7kNvwGwIGQh&_nc_oc=AdoXCn3cCIfaWZJ4AgkAyt_9kS_gJomzxMytbzLnCo-1aB2z9M8rQiPlnS62uC_Qzmg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_etDfRJNrxLVgIrvvgJkNg3UgXRhTUTg7qS9nzDoHFJA&oe=6A451D71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oTVgY7HqGgQ7kNvwHT-qao&_nc_oc=AdrbaOMO4d1_XvZEAFt8H8D5xAWy5DuRqn_z3hd0q9sJi51dqe-ao794Plmc0J3v6UA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85_6FCeOkZumYfkwcUr12kAeh1Ugq48JBXSqRu-7uzUw&oe=6A4522E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
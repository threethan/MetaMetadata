dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLAJsFQaWr4Q7kNvwEmpDxE&_nc_oc=AdqXwmiVKepHpCi3XZGPfdAt6Xm8KvWVHG6_44BVmZXWIC9d8GuL-lHCA90lCMbEt4Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LUtpD6EBz0SUQJmkJouwXNcLPZXXaYRpUiXmzr3jLzQ&oe=6A242D26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XMhtYGTKrQQ7kNvwEQBNsE&_nc_oc=Ado8XFxCpRPajyR5qKJB4l-Wby7tJEWfKCeNleiNwWhdlzxQibbG2RSxmMFpgZJgsoc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OwfsWj8Z5ER8_IUjQu70Xs0NNAcVnjAaDdyzcF8kxtg&oe=6A2427F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHAz1VYT68EQ7kNvwFzAc3G&_nc_oc=AdqQpU4m6o022SI4NhRKfI6Xv3DqSrb3KLuGE6gsVgUzTDCcPlZfeMQpWS-QhfcD5hQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Re_kOcspNeI3ym077hIy4QoBvHLvq67M1_Gwt61GGJw&oe=6A242D64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
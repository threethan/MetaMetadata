dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPUDyLH2aSIQ7kNvwFhU52X&_nc_oc=AdpEPQqifZoECqh2rwSpjXymSaKVIvDCR-OccwhhGqPSKEpVzXt8o2OphmY334sySek&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0evcsBf09jdFJX6LHsDPVhapwYuv95YCmQZKcfRdX8g&oe=6A68BB26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sKVRjRiS9QQ7kNvwGBSt36&_nc_oc=AdqBHwIwtb7YmRhBGCAD63thjqNsjEM6Eq_10zNqeB9-Fb6odYsFEK3DwhBLxy1iTDk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANEWw9MmIDu5KTqJdA3Iq40m0kIsZwhndhE8DnhHhtjQ&oe=6A68B5F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TWStHIrGukQ7kNvwFJ8ffJ&_nc_oc=AdqWGPAwhzue-CyfNCEJFL2V-teaXav-xhpijyVSWbwIupNB1UziBxVgiuN2g1OwVfs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjjjtnLdojTArq3tv7Wpx_bFPr0qpeUwRrZbP9f-KB3w&oe=6A68BB64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
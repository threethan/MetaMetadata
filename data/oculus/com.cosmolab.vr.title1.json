QN0wLU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvcXWpoqLK8Qcs0iNTP2ZP7LtsU8NjlcBLacPC0hRFJOg&oe=69A1A8A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSxFYwzr-qwQ7kNvwGGi0QJ&_nc_oc=Admw4OMCmUC_6M2NlsMM667ll9sDt-w9J_k_SAOoJSYhOgbsljPZZTkeGNCfyQRdPEw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs7gXR2JNAtXt6nojk_FENz3ktTPcD7pHGTxCKc8Zvfcw&oe=69A1A371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abdbMRWr5iIQ7kNvwEm9RxZ&_nc_oc=AdnK3-WFp_GZTnnniMrxlrRkQu_aHAhhJdNSIjYOr-TKOqlBjBwpwxC950gWidGZz58&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft5KBfol5GFW2MAlL_sN6qYgQLoAVKlAsPnaIOoMf5oXw&oe=69A1A8E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot
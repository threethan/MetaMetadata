dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVgtg5EwDXIQ7kNvwE8G7BD&_nc_oc=AdqhUShzeatEpdXZtMRJaHY1TQ8a_P8cEmWeEjmuB5gpUjzmc3iMcy_0YLdicOBtF1M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-pCjsmxbt6jsNOxrsLt2REYjqVtEWlQFhIh-etKI6zA&oe=69EA2B26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPE3ohAopmoQ7kNvwHFpxAf&_nc_oc=AdpIdiQtMq_e3tTb7Qg_JvSBXT3umkMb39JvG8EOr77G2J2QE0ctxzkVz_s1B7G18aU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bTpU_-TgQsvZj4B0_al5vJyPUcjqQcl6YHyedUbqqKQ&oe=69EA25F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOeTe4u2EjkQ7kNvwE0SFE_&_nc_oc=AdqwjprrajchPa__3GHHPMEnvZYRb5juJY9W76FYZlAKUefViDxFRdY_wr0NwNe2zfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s5F1Ij-WZVIvnpAqG6hHMyxmuL8n0BYQ5SeIG3Nf6xQ&oe=69EA2B64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
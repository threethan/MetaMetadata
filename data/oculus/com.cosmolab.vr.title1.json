dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLW6WG0gxFsQ7kNvwEbQgoG&_nc_oc=AdrUkZyrtmzuY79UJusB_E9CtJEwyYwFylQixB1kLjYPZYyuJhebspc6M5BRc6JjgLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7FljwIAd6ks3tucNUvq9pJ_gkDLDADfecmiFkUSoAig&oe=6ACCED26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22IHdW2w1XUQ7kNvwEpMa8f&_nc_oc=Adqk-mTHfjo6OhpEMLCDWRrq_GjlgJrOqdqRv4qqe6WqFwbUccB5r13OXCiSNnDp1RI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuFs8-FM1TyWuxvPXJTE1dyBIwfNLiZCSDgTVmNvOtBQ&oe=6ACCE7F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DBmy-rYUcMQ7kNvwHYzTz5&_nc_oc=AdodSwfWn_tUC9NLzg6k1zaoED_WCo1wAp4EVNF1QpVOjxyDMqsYmOyiHTMBFYifND4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUm8lcdLzYjG6I0ajsfQWd54r3LUnHckhfpFpDQpReiQ&oe=6ACCED64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
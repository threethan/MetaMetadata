dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwIG8jxdS1cQ7kNvwGAycNc&_nc_oc=Adr7Go2wLksENkqXgUEFKEHZERZCG0OQZnrQZAKHyXCTffDXqsJQi-PXyfDgKoqDTuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJNLYClytgLucuEnD3rfTvc67CktNOHsHobsBqlFnOjg&oe=6A9982A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jqjUa35eLUQ7kNvwFVz2Pi&_nc_oc=AdrAToAOx_8j_fhmbPIaXszwdFU3yS_rQFaAlIpHMvRFK5JXDDd41SohuTgmJgfXnKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-4fSJpu6J9lu684QEnBq7lOwm15U64e2djyu5f1yl0A&oe=6A997D71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5ABAfULTicQ7kNvwFhAwJh&_nc_oc=Adp8BgIG1D7GHFkNhJ4c7g_s06RVdSuZAlxjsFQM3r20XZ-9vtgtglP-pCgGv3Tju-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnp4D5IfktuJPL3LVQ-7vVvpyAXqbUJJGBALlhPTvjYw&oe=6A9982E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
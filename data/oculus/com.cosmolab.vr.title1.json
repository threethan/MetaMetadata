dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylIDt8FRYXYQ7kNvwEVI5JW&_nc_oc=AdpomT6l32MzfuO1KAQwd_Sl7-PkaPfiQVlpiiOsQLPg4_7BH9-pf_fHr3tP8PmiaTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSTiIRNA6DisZZkZRoovCpN00rS3Mn-4vmNMFsn1UwxA&oe=6AF1D726"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UdorXGZo6cQ7kNvwGd5z7-&_nc_oc=AdqSK9dBxR8QcI6jAuzPlFX4s6R4MfU84vZBukmMSrX7ooZvjFyj59f4_19LiwqrQpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsiv8ogDj_4hOBQOsYLMS6MNRhxvEc-Oyvhj_fLVzuDg&oe=6AF20A31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okj-4EXyXmoQ7kNvwHw99eO&_nc_oc=AdpwPOWkImsrKYiS-axBApmwlFYroAPn4Jo8fwS_FEF7gDt2s1CjSmZTsq36z_PN8Xs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTtM1X3iJaTLx29GUVhjlPSCT6fJ-b0i2TlO7AykGuGQ&oe=6AF1D764"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
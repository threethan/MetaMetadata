.oculuscdn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi-2pjJ0lNEQ7kNvwG5inGc&_nc_oc=AdppY2uBK8_uvCfoFGrAW8AM_GehQBSrCe3FX-da0FKNnX254H0FXYJfF_tpQWUcSmw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f03RAOhckABzGbcWcU0uMOREOjRVZxWyP4aNQjx2xvA&oe=6A394526"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcPfu_bBBIoQ7kNvwEigLqR&_nc_oc=Adpkt7veJxN_PrOM54_qjdjJCL60uF5_OVZgVwMqIBhW3mf5b5gIjf6WKQHmoCqX7LM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H2lF6hxB1woBHA359ZmeatX5NtDoTTIQEViv-XK1Mwg&oe=6A393FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXJJUyXmJPQQ7kNvwFRVVX3&_nc_oc=AdoSO6tvQgB0lTUsLBcIa0iZ7k3KzlTBvU8DwE3sXqli3WJJZE35UnOgu7hAlIr9DpM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JqdSOVbL8jAPwiCZhYUFqEWum_i2rb1-gHMxWIwuavw&oe=6A394564"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest."}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/ar-privacypolicies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/amusement-rides", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7498032633654866"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75196221_2765383943649014_5298624600072215707_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Sg5ouT2cxkQ7kNvwGIzK-K&_nc_oc=AdreXJ_rNLE107ME6v6bzo1hJg-duVS-YkUKtd1u8jAiGk_AVhv3yqnozvrm7nT5Vn0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hBtxuqZZMg6aIqhKNEZshpvzzLtmGxV_AUDs6MUK1Cg&oe=6A393E01"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
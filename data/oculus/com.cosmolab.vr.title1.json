dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LKriZpRVPMQ7kNvwG9yavK&_nc_oc=AdqUR1WdAzTXULc-rMsxEtyoSRlGIK2REq7WOJIwpX73VTDfAbQag7ZziFPE2VIVE-0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwScr0YCvTX25hVqI4OtvWqPz5-pbZMpwXwvQggTLK2Rw&oe=69C29E26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3AYTfE9lN4Q7kNvwE3lfTb&_nc_oc=Adqu_ynqLgZvGMUtFADpapNJ7_3ZGMgJfdWLDo5tYWwv8CXKo5a_6VrZPmXoyIZ6w30&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeWic4AtvXlSvWeVs5Z7TzKuCWFkV3bYChP4aFlI233Q&oe=69C298F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieZbDko5QSYQ7kNvwE7eoJK&_nc_oc=AdpisA49McBerrseeG89JSEmqKyq54FBdOfO_G55mTFYrVUePCrVanehcNgybZJ_TCw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwnd7wk1RtwVsl0_H39TVo0vouQY3Qk8rmmeNOHprjHUg&oe=69C29E64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zN6Ugsv_kAoQ7kNvwGEIIYx&_nc_oc=AdrSxwNec6A1tLUpwhVHj6qLKUkerAaStiachFXz8FCK_i-YB9XGvdLzWANMydnxYx4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRMfOGmouLxbi41zjp0qp92stae7E3xo4PhMfJydZShw&oe=69C692A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TceSrb9tafMQ7kNvwEyOd7r&_nc_oc=Adqn3FNj_WkhsLMfc-KJ2fW5u1ZDF73jsH-WeZNM4SPUBKVjubqBZa5zn4RA2kaozeA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyH9UogsM85NmzRlr00QXYkaw4vG9tBu9yK6ZV5tcElUw&oe=69C68D71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RKY7ZCwSAkQ7kNvwF4beHo&_nc_oc=AdpVikn3ONI5DnQ68LKiRYd-Jw6ooHuxw4vCUNju5m6DEwF4oe8L1URzfVYkhpFpyn4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4JmhzjqXObeHA4yKBi0snQgEPQ71M2ivsFntza4OBzw&oe=69C692E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
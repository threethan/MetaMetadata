dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuF2GMDS1VsQ7kNvwEv889i&_nc_oc=AdrtWaCptAok1xXGRaZWCq1CAc6eDRNiXZyDcUG_a5JzBHo0MMt-ghUM_BaOO-fm5G4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJiokOpTr18aLBpdelTL0q0PGy3fNTYbjXijsn87ZQ7w&oe=6A54F4A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oapKhZE5x7gQ7kNvwHp1mEw&_nc_oc=AdqIhDqeWpOCG2ULxLZ8eo2LxP3r1RTOjF_Y-gr7y18uj-z28UA4TaUP4tKi4_483iE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbR-M_-jNTCUszAyqamSGZTPUJD1wCiCo5G6mjOBWO8w&oe=6A54EF71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwzsFvilrHIQ7kNvwGFgoPP&_nc_oc=Ado-qYjkWQnpGbxoudM5pqJJdO5GLp-M0WmtQr8DaJ-kX0Z0i4xVfsLAKuGlfMunUTg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIOVIFkiD1KX56t481N7IoSQPmkjx6Zi_Q4rGgZoHWPw&oe=6A54F4E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
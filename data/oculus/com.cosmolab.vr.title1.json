q6HgQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvrCD5skNNKSYxdFWqoOcoJmHBk_LqAMNC7mlS_GGd8xg&oe=699F05A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSxFYwzr-qwQ7kNvwGifhfF&_nc_oc=Adme6mON--2Jqe2OkAr5c2elfFjq4_wOIZZjx9eYUMkvDBFgZdgg3SS9gYpQE3M_yYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsxCeVxKF-Dg2mxzpaGPuZ8hTCmd4fFOe9tRwbnvkYQ4A&oe=699F0071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXyn5oIInewQ7kNvwHNqOxW&_nc_oc=AdlIv3yedxoTZsxQyh_92Ioe_jHiHnSwiANvklVubyt-_MBlZZJtc9-pPAQ3tQ_mruI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfspnIDwkB4DoJ-dWWiU4OMrYWj2qGlY8aSfhRap_niGGQ&oe=699F05E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot
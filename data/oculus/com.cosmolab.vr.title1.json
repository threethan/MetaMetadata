dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylIDt8FRYXYQ7kNvwHU-A5a&_nc_oc=AdpzTwN-Mfe0Qd_QnOSZB3tAYZjkNqTsvypwl_F_spUXdiGX_2a7HT95gKxZnWEk9wI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn_gdVXG_MCh1YcDzLDJMhaphBTdlOY4arheq5QhjLuQ&oe=6AF085A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkM2ONy8elgQ7kNvwFaEspx&_nc_oc=Ado2P_hPrX0CChWOfeh_mdNdzktde4fcN-TEgAn98Od7oMP_f0NnUlL0SmHAhGBWHpI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtNYtu7rHUa3EZGLMlyHx-I1NHuQsNpbX7Ds2wFB6ukQ&oe=6AF08071"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okj-4EXyXmoQ7kNvwG6eUjp&_nc_oc=Adq5a_3ZR0z-Wn00linBQzi7YytQGxFqLe8ExblAA4t67Rk08-tpJ_gF4sWlQ7YY-YE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSVn-Cl5Fyy6PTSnrvxqmT9phypN2waaPl9JKLgOvhpQ&oe=6AF085E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umwbu-4P2dkQ7kNvwHavvZK&_nc_oc=AdqhTQw-62kCtd3vy-i4tUENXDjRUnYFQ4jxOzFhsJ32jT07-kJsdw67B5OozSp3wfc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd6OG1_nXpuPUBHskae96fL7gSk1AIICAaOWFgHtO8dQ&oe=6A86D566"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-HleuuFsV0Q7kNvwHTG7sw&_nc_oc=AdrNSSnrBFXGnc8InRb4qVhcMiaD0wqMrvj-AqJQ_3hQSYrrrHh8fuyesqH2hc6ctgA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEDnE_4j8Jkr6tTusQeWp-_HUV0Zo0HH95R7cEM3rcFQ&oe=6A86D031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFqPMtZV5CkQ7kNvwEp0Reb&_nc_oc=AdpJguQmU0X-an-BUKGourY__E47gLI49CZj0RYC9fjXu7r4eOoWq3IEbFey0XxK_b0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwGRUujKiteqnFeQXmbYnoAJDGpitd4ldQ19iYDB23xQ&oe=6A86D5A4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbz3EWo68UwQ7kNvwEqH_lL&_nc_oc=AdrwXCR7TRwRBwDCUwyT4z5h0Ffn7b2WRfFoEuS8t9q1ytKsfSYprizksAvAmIlyqA8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bLwhr6FgZ4lgLRtMSwG9H61RDubZ3OSjfKzFQ0tBHWg&oe=6A16FE26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77ZknSycggcQ7kNvwFw_QZu&_nc_oc=AdrX8_SLpsWBkkcJwHI5ux8z6f28R5NmLY5JY59nsVfBTw0z1c7nFj4DYWjn5JnnNuo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MSISDhWpXakT-BYkqazHlcm-mnk9z6OVwRJcrBtHH5Q&oe=6A16F8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggHLRHMCyOAQ7kNvwENJFpA&_nc_oc=AdqhmUguLSNmWllyaQmtQu539x75fEKEa_QUhlQDPbSsp_gyHbxLvF50CYLUeFVWgNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zJ4w4NebeOkMvR4hT9KwLgiQDoBNtNaCnipmG0y1H6w&oe=6A16FE64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
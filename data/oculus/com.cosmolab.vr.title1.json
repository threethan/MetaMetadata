dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhGoxoEh614Q7kNvwGGxJAM&_nc_oc=AdpeX4bLqLgt9de2aCuDbqX2Fu6b-DI1eXimGMjrIDQ_W97Qxap_dESYsc0sUWt5u_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjz4bA5LF7TRtVOV7l21FyEovLf5fAHf6mURhCzkel3g&oe=6ABFBE26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iByvTWF0x64Q7kNvwEX9yNU&_nc_oc=Ado6n7p1TLYcICBv66W9-YS3FlHutjJp64_iBxknCznXibJdvGxNUGSgLkgkj5s5g8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5uAjv07FzS6iEunCUjI0EsnH-8rENwilBgYSuAl8chg&oe=6ABFB8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJoHJ0-GdKAQ7kNvwGWCzQD&_nc_oc=AdohkdN9bPoBfIyns_kjyX2pjusXXWKjiFQaQvnkTqh4i1DJrKSNnrlewAiuXZKF2jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOmJypapmjKHjt0N7UA279f7uumqdTmBF4iiNVaNZWiA&oe=6ABFBE64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
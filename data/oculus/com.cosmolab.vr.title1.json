dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umwbu-4P2dkQ7kNvwE9Wexg&_nc_oc=AdrTGu2dZxqRrCgyj1QciSfQ_yVzhj9c2kWwvkAajfGbzN3YvtrwGZ1O9wcmLxfOF_g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDYntOg0zFYJC46edc9bOqyHRgPGDgYvJLKPWKUBr7sQ&oe=6A8826E6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxZ9uDA-pjMQ7kNvwF2Ccio&_nc_oc=AdqxXqVgIG9jYEWbQ2itNOs96erQZaftb865OM5VQDKNsWEv0M_2W8J4S0QBImfM7oY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxOs5LY7P2IGCQatQBjjVSYo4yZwgrb7sMAKYziahqeQ&oe=6A8821B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFqPMtZV5CkQ7kNvwGMxl77&_nc_oc=AdpXQuEA0rysw7_gQkhwPukLYCQ_QJpnqpmOz1uOevOwhXGX-1YyhAx4UTfrkQfa92s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1HPLbHXA-9Fi8nA1jnhr7qV8cjHUP04Lsq6NV3FF8qQ&oe=6A882724"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
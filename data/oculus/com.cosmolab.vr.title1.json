dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mm3zTO6XE2YQ7kNvwHN1LZO&_nc_oc=AdofyDCwJy1r_xVZf_wchQworIGR6EeoDdhroxz2-HcQRanfRdLElHW6zOWJrdz4dYY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lrorjIjGekeqT_HUNh-6jnsowEDc8ajgObYPFJu8b5w&oe=6A33FF26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e8IxiyxJvsQ7kNvwEUf-kO&_nc_oc=AdrtqoDyraeHYSp0lU_S67amsVL3wxK2djgu6NvUp60gtE2mztiK32xK9ZA5emgMR_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Beqt_wfZo6dKRHwlrDGzPXysS_2pMXhLIUIZvE7Kayg&oe=6A33F9F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWjJdziCG74Q7kNvwHLhd05&_nc_oc=AdoUmhIfYkTjRAz_o8obyhqsNO1W86FoaElJSaZVvT7KYQ7SDgBQnPK7v5nCnixFzhA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PD4Z-lyTvHaIZFUluHC5KkRWgbLGxgZJ7_K1pe5Yn3Q&oe=6A33FF64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
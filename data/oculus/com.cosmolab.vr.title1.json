dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbrTPMwE5aUQ7kNvwG39Ut3&_nc_oc=AdoN9cBFxh9HvOpuTNb4-guH18JDnMcWxZjvgmF3rpaFsAK4rqybhNrBA9wFgyXYzjI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOatSoRZYuhv33RJ-RX0uMXCE49h1qohzclGjPnQBR8g&oe=6A637526"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4i4B1cfLJ0Q7kNvwEYBI_P&_nc_oc=AdqMtECpyBlsmdnX4g6Qoe-Knyfo_kAnN_mrIuDSF1JmI6GHBI_uQDl7ub6GKAVqw2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP8h1lT2Rrnm1Y_BEsiEvUYKAMSpFHojeDAy_mX_Ancw&oe=6A636FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGqIgF-XT5kQ7kNvwEp2VY2&_nc_oc=Adph5nO-pk6N2SG3WgGX-YkWnKdOw7q4SWEsVcbXafajVbh-EcISEGMurYrW4h6NTpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI3F9u6dqFA0WylUNGhhdbS5bxjmH1W1s8V0P_ho2NiQ&oe=6A637564"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
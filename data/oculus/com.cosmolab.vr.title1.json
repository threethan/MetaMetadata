dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTC0WTIvw-QQ7kNvwFYHLgM&_nc_oc=AdoEKCRvDCmNvSdBoPGbP9_2ndCgp6MwhlrdRMxzPymebBXFI0jD-bAnCOlLLUvEU6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgeGXF7-EWDNDdn-LCf7lqqxFau8Y3LkYO6Te8XHWF0A&oe=69CD2A26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHSofSlpZKIQ7kNvwGO699i&_nc_oc=AdqZ60VFZUZFzR2m0DlxSaCMzp7MFeH3M9KN-FFKsBdroRydUXmBnsFp5T7FQDEq5iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx_rXbo19ayl42K1j9y7xokkfDsMeaWWypU1LBBHutNQ&oe=69CD24F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuGq-YLNdxsQ7kNvwEzdU_B&_nc_oc=AdqDgWVBh_YeoG2huUXF8wFmHxoUAEVq8pvyhk82gaipwTdg9hYE4q_7DnEHPrA0U9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyk15mihSzcG5z3LKQftuwVCCI-fI_oVDOfhJKawaY6cA&oe=69CD2A64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
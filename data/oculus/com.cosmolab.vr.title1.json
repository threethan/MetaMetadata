dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuF2GMDS1VsQ7kNvwE8Ycuj&_nc_oc=Adrv5p1eIpEyaMdQ_IOtsQYlyCc297BrrrYIiW2tchb2QtetNxjHxpcGYzVZoNgdUc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNiYaRSrgWmlTLhXxrI3xZVZsp5wGACjqtEtIBKz0Zuw&oe=6A5251A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iT1A9gjLRkQ7kNvwGB-YwB&_nc_oc=AdoapULVLH1yQ1jQP5eD-CJg5nHSu_E7zXrjGX8fFvQO9StF_C19sJTBjdL0zbpZ1MA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY9rpdMx1E_vnZrtVK6v6aaSqNn9Aj1Budl51-LMhRaw&oe=6A524C71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXWpo3uIC10Q7kNvwFyQghs&_nc_oc=AdpFBey7VOWaQh3Qd2uRXoubsMA-OmW3VhrfJGi-YkO63R5uSSLLuX_QHpFY1d3MjwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWV4-xh3ZMSuAj9F6UQ3NCVKY4HOJ0cT9kITPeqfqVjw&oe=6A5251E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
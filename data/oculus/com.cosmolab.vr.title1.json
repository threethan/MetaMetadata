dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PnRRV_GNeAQ7kNvwFkcJQE&_nc_oc=AdopQp0KnyieLud9NL0nzBJhtrnlzy77N3H1VXpafNqc0WI4sy93O-b8ylcweb7-UJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSnsVC51GdJHJmQyq2CfmQr0N3jVbsi3AvJk60VNaehg&oe=6ABBC9A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHaGOHn2CMQQ7kNvwEWgDtT&_nc_oc=AdpWgRGcCWoIHeWCbsutLp7E8aOMZbdCa-MfSBsAdlyDwumLFTGCLQ67D9eRLA-15yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINYVWUQnM8gNIZekKBtVCoClrpE6Ryh_e10vr0iZ_ztQ&oe=6ABBC471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tNuDPo_uIEQ7kNvwGSVvn5&_nc_oc=Adp8wlyxhGe_RzcXexeMmixrZuWYP87hI_cWU7RL5HZfjiZdG1bIe0XvnIcvjbWiuOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLISAzTkJ3aptOxzzNYQ3-XeiiEFZmWX7SUmj4oeV5tiA&oe=6ABBC9E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
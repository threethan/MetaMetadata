dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8_S-5afk1IQ7kNvwGbuPey&_nc_oc=AdoLn706Y80Z6a-wcjBgr6HcauiKvEQZOTrBuqFjbtQudUalXzZrNHykOIR5AKpaIQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ18UjHOhz8OIPhYHogSvV3YMbF5o8OkMIaak5P0BS3Zw&oe=6AF47A26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UdorXGZo6cQ7kNvwHsc9Pb&_nc_oc=Adro5_UNCG-0G-8Z3-Hod_FpgEN8rhgB30_R8cwMegJ3c-P3JWmde9MpnBKb7_aBHK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoqS_Kw2e_dtbx2tQzyHpLadvxf1drNccJAlnBX43HGw&oe=6AF474F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kz7uDwihrAQ7kNvwG9dyeH&_nc_oc=AdrjGmZkmN6hy0kvBIXhChnqTaGtBTHsdaOkxHNquVx9DVRfjx707sWnt5t67BNYxt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWPizyU1w-mCgrm5WzeWoWecRrFwdVF7SV1f1XIGtUDA&oe=6AF47A64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiBoRiLK2CcQ7kNvwEYkChH&_nc_oc=AdpXERlCDTET9qd2xOcObbQ_KqnYOTj5NEdDjgqvkfzFlYYxz7IJOI7OoOxvu8DLj7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEygvA3Tjk7NlhcnaQEo8qGJ-WbUpO0Vwx88ZZqWNdHg&oe=6A4D0BA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFR5MxdqB7wQ7kNvwHIwCmh&_nc_oc=AdoYCVUpolL_KK3rnwDrO45dS9OB6oFBK9zI5eAUTbrF1jANpLQI7lhyQDj6Nqf6sXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2Ig_tjE2JgaFCr_7rbEFY7Jys572IMLYYxAcNLFPJxg&oe=6A4D0671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFd3MsLD_DIQ7kNvwHsA_zq&_nc_oc=AdqvGSQVBd61olmJ-pjXlasN4des2frty8kTP-FmkOITLaR2oAXI9X5Q9Gs9t444OSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUm_nas6ezl-EDDLc63wXvqsQHt8FAt5sur07Q8tml-A&oe=6A4D0BE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
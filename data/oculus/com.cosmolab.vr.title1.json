dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeRZp9muNToQ7kNvwGrDKC1&_nc_oc=Adq3r1MXmIQ0AIMdaqIB0W8VVJFbhpMRY22daEGcm2pWO_xYXMHXXrA5o3_1Tbqfpp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuGmKPFQY8ga0maM1X_KMH9kDRVBC6R99P3l-Qc3y1Aw&oe=6AB53226"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHD_9DTeMOMQ7kNvwGnM22g&_nc_oc=AdrnCq0pR9yy3n7PmzLM6sOKDE_4stqUF3Y-mza8rWjetuzI3PWboQ8oY52HHdmrYnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYt15YuDctWPTwglVIy1FCDuHp1ed06EHoN0_J1CsUhA&oe=6AB52CF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubImz2av12QQ7kNvwEh5-ar&_nc_oc=AdrIcSgN2hVkYVYrBq7qyUdmTv3nr5w0wrW9tlZPr1QIQXD3-_4jdqf06L_JlphcpyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcoilMqGBbw9ReLyv7F54jrEY5jVmQMlU5fEHbxzSncA&oe=6AB53264"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
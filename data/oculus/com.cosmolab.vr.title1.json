dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0mFQtZBok4Q7kNvwFwmyAk&_nc_oc=Adp2Pat73bUDUeKcyXHZUNUybllSQlqRhfR3WulCHrmzXJ26hC0sZZB5VoF_GNFj1Jc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xJQc0kXUOhDz9KA4KLpw5dCpu3UKVl6uQBHE_-5jBlA&oe=6A15ACA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77ZknSycggcQ7kNvwHJclXT&_nc_oc=AdqvUfWDN9zFvJQ3-XRvQPBkuHV0ssZAB0FBDgEyGinF40k8J1xErvXogYfTS9RiWtk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pm-IKIH_63xFJvjomBOnEzQD4YHLTgHRA0UhU6O7ZkQ&oe=6A15A771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggHLRHMCyOAQ7kNvwG3oqZM&_nc_oc=AdrmruVeAtEXeB7QyOMpYlEgqpn8IBBb7lQT2bmAMJjV2JDUGngk-3Qog88J6zfDewk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tCnup2Gvjwv_a4aJ6mhPF86qw19VVnNnSMIQu3ZAvLQ&oe=6A15ACE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
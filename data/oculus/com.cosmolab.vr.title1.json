dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPOghVOYeFsQ7kNvwEvjGeR&_nc_oc=Adrjr93MWF9PkuiAfFlAM2ti5_-DGjzJIYJw_e3m6Xz0pqxkk4zWiJWKLizNBVBnS_U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3_ZQYmv25_i9_e1FBlbFso8HMJ92KsBv0Wauf3GoMKA&oe=6A92B2E6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-Us9AToFKMQ7kNvwHaIgX-&_nc_oc=Ado0Y7W_iyGIaXRxBSFgjzL48qXmABk2ekYBmIJOzTf_jWBvRyjxifDxzI94Xn2DN4g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbcfWKctzR3S5DV7NT5pfA-g0UK_f8B8G8TOlv1UAoaw&oe=6A92E5F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWwbmUze3zkQ7kNvwFvAttf&_nc_oc=AdoD3Tf_elW2GfSP_Mep4-WiR-D23KJ4nCQHaIV3-y8bt6sxxbEnNjRkG3dT5cQ1zVs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEJnzksEu1np7zlCoofOjk1l_tCuR2SN5e2ZovFVcJmA&oe=6A92B324"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
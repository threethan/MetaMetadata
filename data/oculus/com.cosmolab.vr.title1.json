dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibt-iwdSkIAQ7kNvwH1cBko&_nc_oc=AdrIdRv0PRgZFSN9g_8OhLSs99aC2KQEZqqHAbACOa8CFQ-v1GBufSaLr7dvz30kJIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHBuDcXlvR1PSf6Q5-YUe8bloMj7cCcTvt98jvscdgRA&oe=6AE4A826"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5JSb2o-sfwQ7kNvwFpe9Xi&_nc_oc=Adocs6cRoAQ2UvPS_9H5H6oExLJCZZs--JcgSw7mbOdq6knHw-eirW0_6PMfCY4Pvl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsn3N5H4611gVAmlQb2DDMljvz9viSWIcQkY8cfuXjnA&oe=6AE4A2F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXFk_nsjbqQQ7kNvwFJPV6T&_nc_oc=AdpdXlO-W55aei4bIHwpSwS_Un5cqUQOgC0wOtoYfWFf2osozzn1Pq0kKK0s02SyyHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN818_cuzlzrvND6fCRg4HMRRhVcDC24unX-8V5cWRu8w&oe=6AE4A864"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tdfk_-OsLVAQ7kNvwFkAOTB&_nc_oc=AdoqxMie0b_iQqIcFBbuWzxucrW4HilteSW3dug0RWeaP3ANO-mevgqhx3RRaOOblYI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kgMcA3hQ48sQZ9qOlYZdfkDKreycTb9GATi_Q5WkP_A&oe=69DCFC26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZNlLp5QJ0wQ7kNvwFaBkc_&_nc_oc=AdqK4cZTZZNnnzclT3Vzl05nkBMmGQNy19VZPpJ18ksq4sQdDWP8Q2Xt8-oMZU8rkNU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l7ciiMV151xdlLrrd5US7L285N_o8po4LFLZcN_QTnA&oe=69DCF6F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8y20sIEZ0sQ7kNvwGnLnOv&_nc_oc=Ados1C4ChluLSXrWa3geYS8LCmilzMMFWGfnfqE86Us3ucHnHifV8x7huzehQ15lwWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W_OLOI5MQGyPkKHWaLRYNrLxO6Y832eMSmEE1loVzHA&oe=69DCFC64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QFc8Qo-GesQ7kNvwET4JKR&_nc_oc=AdrNhCT7iN-uMJMHxHvYmG9Rs6ypsqr7XfOdZLjyEUlXwBKaSaBMFmPzc1oYllHYcBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tWpdWhnhkrf9QCrmtjuohRd1Q2mxLA7svmTVChO4HhA&oe=6A0337A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grlwPgZ1wAgQ7kNvwFR_w-z&_nc_oc=AdpJUrNqLRa7csewQ9IuDXRHC3FsfTzUBuIYUPEv4hYenspXJ0ylSjvkXPn39JOYA5Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4toqhIhqTO0rWmm9r1Gy_sz6CVxT6s4honsqIPY_WN1A&oe=6A033271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCMRJmwYbNsQ7kNvwFfRGZA&_nc_oc=AdpkcL37OshidDewh8qYqp0bHN2rg02Oef55f4yJGLePcen9IkWUoIF56DUw43wHYuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DBZea3bFKWV3F3zlVXxjT9erOrwtw4bbOsSiAOpQ2Xg&oe=6A0337E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
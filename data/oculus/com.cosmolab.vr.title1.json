dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpANUBOkD98Q7kNvwGOw703&_nc_oc=AdrzybVbA5q9uZ6G9lsIYuU9kucw2et105WEbo0jnbrNqK2zyW65crMqRN86SMmCQF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33w0si6kLFBG-myg03Ydp8sX0QuPxb3-OKCO2oPAFiHA&oe=69DA5926"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZNlLp5QJ0wQ7kNvwFowRa6&_nc_oc=AdpqnEDw9T2_CetSxzZTVrJuYQ9FCLZ_vaKf6u5OCm58Fje9_CKJkKonOdjNkO4WaJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EmUBIsqzYzp3gGDgliFEE4mfKyNQXo-aoGmhdfbhZDw&oe=69DA53F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2JSwX0h-3cQ7kNvwFS7yhE&_nc_oc=AdqMgnNRKm4w422XPu-FaRgPNcMaGDDnqsTcrqVvC1sg--98KPtAQz3o516FnhNW3As&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Uu7NK7LVnNk-T2YuTAYHHsIg8Q-LatGYHrvh-REaVtg&oe=69DA5964"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
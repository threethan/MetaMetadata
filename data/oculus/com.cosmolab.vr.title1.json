dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZm9ChjHTeEQ7kNvwE182zb&_nc_oc=AdqhcLXg3TdGqOGpIDMh_KE4VPLpv5ITgSs-zjjF6NGGBi83gel75V6MfN69RBF-mFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiNWO8puq4-AeHzF9Q7sxMS0l3czSqKYUzFK7u6bvgMw&oe=6AB3E0A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHD_9DTeMOMQ7kNvwHFAgSf&_nc_oc=AdpQTuCru4Nf84PleK36upamaALlXFe9LKP6nc4JG8TQwxkXSdzPyoPZ-ZSXRF-uJv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgSR1taJbOk1qSqNdUlCmkPbgVyMGHXCYtXOwF7c_HbQ&oe=6AB3DB71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubImz2av12QQ7kNvwGO-gNx&_nc_oc=AdqrV5v7H4dvFk2zvZsKasyDjYPf5N7BhzMJBwmMYpycrwMb47OZ9FO8xYG7RZAMkVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1OgpiDinjauz_HIjY8NYP0ktmT9rQ1gpqWePC-E5Cow&oe=6AB3E0E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
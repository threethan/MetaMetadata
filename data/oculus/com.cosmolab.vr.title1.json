dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM4tFuTdTUgQ7kNvwFMUpjj&_nc_oc=AdpehpkrVACONIYd-dbm4weJjNzWSf1K4gRbXzP8KxkrtJSEE6XdhPpeT3m9vzfQCY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpgoUrKmBnNVAT_Q1sstIQ81u-e3xFarS1I-tBlstkbQ&oe=6AE20526"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5JSb2o-sfwQ7kNvwFQFTRA&_nc_oc=Adq8xja7KqCyfDOnKbsrBjKzNz-yEs_KTnhcqwFwSPJ5zM8wBMblZ1AtfmLpXFUqpzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqobH5zZIg3MqwTRLjz0fjWBC7gLAaWUX6LygUFe1Org&oe=6AE1FFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIZu-nncyKIQ7kNvwEtlHVe&_nc_oc=AdqYCAtfNYbOCLs1Du7j2bzQS5NrmZkjyhtSsaCkC5Xr9oZgB15pwMH0Y9hGCSdTYbc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlMFXfeRLyyS_4g5vq3LVGeQpuvLOERZroNOYTutkMnQ&oe=6AE20564"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
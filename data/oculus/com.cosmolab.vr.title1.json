dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuF2GMDS1VsQ7kNvwF0osDX&_nc_oc=AdqXZrvYYB24cWDa_l--mEEApV4Z7JMys862aWMEuOWzXDKikOtlirFg9sWrnLWoEgM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmrLeaFDDhrakSpBN5a-fDMNNTZk_ekrcAmwfI_cfF4A&oe=6A53A326"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oapKhZE5x7gQ7kNvwFf5Nmo&_nc_oc=AdoQTUTjeXQGfzogKkX2ohdFQ7pESSbq_wzadLnE3eYBNXfkmWSKSCqjhmIIROcVhiw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA9BsG4F5_2VWG88LwOK0lKhyVx8YJf-0-MyPRWxj38A&oe=6A539DF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXWpo3uIC10Q7kNvwHZZjvS&_nc_oc=AdroCEeKCmUfGrz3DMgOp9VIHXdBj861xXwy8b_12S4-6phPmZgjaZ-A4qGj79exFyM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT_o7hdAR8xtHP2Aqobgiodd6mHGrDe6laVVWxm3hEaQ&oe=6A53A364"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yb--V6EQ0YIQ7kNvwHrMIYR&_nc_oc=AdprP9AQDwnKSinkbTgiQwGbvT0K3KkAfHUJY_bar60Zg6HvfhoAwclVCypB0lPJRYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76nPWueMz7_omz3xyMRhIKoP8IRzJRnW0DTZZdfzXMZw&oe=6A072C26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdibfKM2Gc4Q7kNvwGpLOX2&_nc_oc=Adof07bDRc2McsksQ08c86G_sNgVP5kZOSvZETf-axtRGm6gG3Uvw0TPtJAWXlqGgA8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5twcRSbXhMdPQmqpacdOmmBVEIKFmOmofZEjf2tx-Xlg&oe=6A0726F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wspx7dg6TXIQ7kNvwEaaE7M&_nc_oc=Adpnjsfs6u3HLlDfZKl6A-9bNfno7C0o7zU5LMcDkpEGrs5OoCb6T7xUewhrhtfmPkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77PBazG_dkZ54xgvyBxA6jXB7lzD00PPmxi4sMp9CS-w&oe=6A072C64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
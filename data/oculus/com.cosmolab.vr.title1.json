dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ0ix4NOoBQQ7kNvwGC6r_U&_nc_oc=AdpPcNJMSWoUNK19bMXWp1o9fKpcaSsRb9s80tCFna1TMpdmTj-cgfDElGsrNk39ix4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRajm6X4y4WMETY47QvDW2QQrW5WTes7K7WSZ7HDqiHtA&oe=6AE89CA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrK1rlMM-P0Q7kNvwHahoul&_nc_oc=AdqMPhawKFDqakuzYeYSVccr4fsj_pnqYCeoGuUaPgBD0eqnshSdskm11j8MRCE6keY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlTi0DJDkcnk1SxH_-KLOFm3wghLnTf4HFcXwFJjSI9w&oe=6AE89771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzFmhY1sPoAQ7kNvwFmArDg&_nc_oc=AdpNOVd7xCP7AVrc9ETOf5aEycfkxXv2SXu1NyABHx4uwaq2R-c0uXPkWd9B3LZXVrg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY716_FumfXZMcNJfW6QcJ-29ReW1gz0EPxYMpgQDNvg&oe=6AE89CE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukTMUU9RHIYQ7kNvwEK45im&_nc_oc=AdpfyUkN6Fq1Oyew6petg6waWJKnXGl07ObwUzIqA1SYu7ZqVUIBmnfBrRz1gVccOMA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R8L4fZNiDjbkf4f4k3ldcL3WRvqOsV8i3wtEI7s7qhQ&oe=6A3FDCA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV4vi2FV1q8Q7kNvwH32iFd&_nc_oc=Adq3MUIHylWsleoEHEcUSyF6qfRJF_Opq-9nZsWn7R9l43iSZvbVXOzNGze1hsHT55M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XthVzs0wdJEgl-OlXp8rpfBcPWtdchEnu5FA4ZYOAvQ&oe=6A3FD771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDj9iTpw06wQ7kNvwE5B45P&_nc_oc=AdoWbPn3NkUCJGBWO84rE5w4haAeGILYuhEjOarbCU86pdNMZl3PUmx_fI8kNblHixE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f68ZtuBUhlv5L2bA_UwWPP79Ad8GjJM484EZoVzOBbA&oe=6A3FDCE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
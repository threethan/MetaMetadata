dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpANUBOkD98Q7kNvwEL24_6&_nc_oc=AdpNhwTqRBPVf2BamsrLN50MqDF6atyiHvKvFSlhFtohk31mr4KYrcsFSFoZSfizdkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20okOoe-4xI-_YGzgW-CPsxwkW8UWTjW2uFORKedIivg&oe=69D907A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mar-248IRx4Q7kNvwHgfu9o&_nc_oc=Adpb6VcAj--apelpr5yX5dZ5PDf_ROgdc9O9FsI1ySBuUtbkV9ujEoHPD-gaxlVzuZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xzGfy6icudf1KGKMn4dakLeKkZvQI_V0xgxv1VlD3Bw&oe=69D90271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2JSwX0h-3cQ7kNvwHHuQ__&_nc_oc=Adpte2gvM3XU0GM982QFtRGAYG33Cw2Qc8qrGfbCwhMH_KZZVK-RiztduEXnh-5lA_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kwj3_ng1dLd3SCD0X4gFND3a8_ThNo-SL2H58HsNE5A&oe=69D907E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzlLDkcjHr8Q7kNvwHqs02V&_nc_oc=AdoHnq4NqQ0U2Hwk2X-Ra6skBOhNCUdDgIaZg7tQXaOyYb3B_BST8YC4QTJqC1pDiqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bu56f5PpNaO79ONUEm4ZocptFybBF919O-OhfpKEZsg&oe=6A0B20A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEo0_-iBuEwQ7kNvwFEBVb6&_nc_oc=AdpBdgUmUy3LjmKNaGbqfcodLw1GSf-Mxs04JN-cb-1dH_fh-J_3rQH1_wAR5NjdAcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qRapMCUEH1emz-VxCnmBuVrQiMosuhowanxeSEXENLg&oe=6A0B1B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSrhdVFn4U8Q7kNvwE5FIzP&_nc_oc=Adocwa57JMN9DNe8wyEVZqycJrmR8K5H2rRYSdOrI9yjxtjWLVPUxyL57bXOBrcDHGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wCeFJhQUxtX1fSw1vBSUWJQGVFBRlFlDM3Cxm4c72Uw&oe=6A0B20E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
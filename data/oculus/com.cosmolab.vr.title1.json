dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0mFQtZBok4Q7kNvwHtQD25&_nc_oc=AdqRMKmaNyOPGhNTfmqOZmpgN7y-qcogTqLz_AGMXUlOUyGSV7baTfxoMOExT8lefnA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lxr4g4IXH3b2AXe3dFO0LnX5dbi9SewY2RDAZvaGaAA&oe=6A145B26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77ZknSycggcQ7kNvwE3lEWm&_nc_oc=AdqxC-Sl0hB2nspaaaEOrR0D3l3ay4BMcwRv3KsRal9DzSBOdEYm5Asn57JYpRpdldw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JUFK4d5pcjr9YNlUTJ242uxopHln0VDbQnxzwv_WgSg&oe=6A1455F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmuZF-J0T2wQ7kNvwFmsubf&_nc_oc=Adq7xxox7_2EcIcKOvKQ93e_hwEXuIkFzToTYhhd2nZFbJk2E1zIJLZlfb_RDXdZNoA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CxvgY9ObTbIQ2NsJ7kBuBQNcEetmQfRJ9qb6HSjf6AQ&oe=6A145B64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
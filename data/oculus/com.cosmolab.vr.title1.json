dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-4IPH2XIuUQ7kNvwF7-7H2&_nc_oc=AdpLoAjl68-KfRRc--LUE3in7jR9g16KIBLqWubuAROSPvfa3tsRxsZDiNy0-vgytMs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaG-V3890uF_xmkimWvomvXYrRHk7E5hcfL-c9vgVLHA&oe=6A510026"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iT1A9gjLRkQ7kNvwF0FVFx&_nc_oc=AdqU250TWg_NyeweydGbUDYK5Mw8XJ-EzROdKGilc-uhAn8ey5Kw8m-VP6dAfU_sUFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA98fpufR3-6TZbFjj5WP646y3d1qerBxFwJITkhqa8g&oe=6A50FAF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXWpo3uIC10Q7kNvwFPyctT&_nc_oc=AdpRWjTfQgdztVZYO-ovJ21YOUZEcXdQ5UdPBR_mqFwXUuKLZEIxDH0vnGe7I0X_RaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_o-RQfKA7S3iLZ424NMuaWg4IZzlIGMx8I6F7yc-0xA&oe=6A510064"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
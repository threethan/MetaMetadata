dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OGUtQlukHEQ7kNvwHO6vj2&_nc_oc=Adr2pgO41pcxzm8Mrqv_D0KbubS_xyuC88SHWpiLdjkNftyn6a1fFjLroIHHW4VrGKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFY_5Ei42cceRGW4aobwRpWueZWRLy8pIFK5Twavo1uQ&oe=6ADE10A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdFxwOilDocQ7kNvwFuIrOW&_nc_oc=AdokEsSe6PjQ1GoYPcXRFtqkZM19-ffWlMSVxWGYVQOre2t4tU3lrZBMAca-jCaiQG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDNSWlaU7zi8X7ZbenWBsWMgAsBG6iK6ZJycsY2roKNA&oe=6ADE0B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUBapNA15AEQ7kNvwHb_yXp&_nc_oc=AdoYKbWyP1aWnc-8J4GpJ0lJ3uozP7AYej0qUctJ6JbgWb72GWWU3r9ARWUG-hTCQvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd9IitZ81uWU434TqIs15OIKlLI0jqX61p6wjMvhAFkg&oe=6ADE10E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgHE3tVYj5YQ7kNvwHeHdTM&_nc_oc=AdokKFXzeLi0dRD0ADC0HGarkAQmCN6omZKkZ5v5BaKSvzEvSfSbERD8VBnQByb8cpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJje3kUwGrkLhgKewfKKSH16PDkl1r1ghDAlj-kK1FEtw&oe=6AAFEC26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLnDjPE8j_YQ7kNvwHoi4K3&_nc_oc=AdrocexXpGQwk0y5MZ3aZCLVw0UifpVyIb-6CysxdT7YIu78Nf17kjVTKRtZofbcx6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmyO4v2ly1RZTnnTGspxTZflkPjz5NkXW4LETr8yd_QA&oe=6AAFE6F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4fVhrM0eJsQ7kNvwF4iOJY&_nc_oc=AdpF6WthevqPSiGPl-Ht-j9sQgZ8VF1rG3UHk-enSEZJkma5LL79wm8jsQ_Y01VHcno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3Y9xjKxaBo9fyFUzV1RssXB9MtliDWc8fbshWGyN3Gw&oe=6AAFEC64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKecvmrtwQsQ7kNvwGu7yYI&_nc_oc=AdqyRpU_DrAIrQwgVwkXmWAaeMxK5OmNuFPxJdcD5b9T909QIZi1CWY-X5t7EhS70RU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i18cjYnnul6088OBxpZQAnRx1p5OhBnuD9bJ9SzTGWg&oe=6A1AF2A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76cam2MODwYQ7kNvwEePoxd&_nc_oc=Adp2RInlpFJDCNHIOGq-viidH9wDhZn8lv2r3DdJFR3xncBQomBPh5bx342HlW3RNZ4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bS7TTDbb3u07Mn9vZOr4E04eAvNE6WDZyhCpTVxRYZA&oe=6A1AED71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OANd-9YQyVQQ7kNvwG4igUj&_nc_oc=AdqjMVMKIou9-0dcI21Z93v1jpCcovO3v3uUAmd1r2PwPGRqCQcZCzY2pGqsUd8sWmo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FUitn5ptf49AiLCipecUFbNRVP7HAGAqc6FoeR8MPfg&oe=6A1AF2E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
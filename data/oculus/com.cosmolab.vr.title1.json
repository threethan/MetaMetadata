dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbz3EWo68UwQ7kNvwE60HZc&_nc_oc=Adqev-XQ8GzIQPUND8Msk6UJvyoj2u2kWBuNBZjd8xnwXgMkFCZi4OxqQ5nPiXF8_DY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uzeErY_Oa9SyYNvW3xSkfyGgDOkMzL0MsNZth2SZshg&oe=6A19A126"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76cam2MODwYQ7kNvwGdVf-1&_nc_oc=Adoz4Lw3Tcq0ICScNc-lweh1JDMGliCOte_1zt9QShUGB-xrhoDouthF3bzjAyz1VWk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AXKbZrgwS46u1SEPIjHORFCXberV4E1bXO0sKqlezHQ&oe=6A199BF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OANd-9YQyVQQ7kNvwHEmit3&_nc_oc=AdoDDSm1kyVbICRPnrjRs_ENBJS95qcC32Gp9ArQPuy9Jbq2bvR6iLDeB4kL6q_cncA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fIv_8v2wu2n6pp0pHQHRjTL08VnjqqWI-3qrl4sVrXA&oe=6A19A164"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
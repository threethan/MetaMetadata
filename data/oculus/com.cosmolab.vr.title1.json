dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTC0WTIvw-QQ7kNvwFz5zMb&_nc_oc=AdpnQCHOeUqUFoKEeTpxQ194oMwv2Pdr8VaNPX6zQYLMzPcDZHW2RwRrFacQNucwPK0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxslawgEDBU-8td3IlIe-hEwhvChjPIY9m5Z48WJt9dLA&oe=69CBD8A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHSofSlpZKIQ7kNvwEyheMo&_nc_oc=Adq-3TMaOp3l41K1ML3Qyln3lBBP3OEWd2exo6ANIFwtHwaSH1GLQfwbg_tY2CNuqVc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiSALlLJygfihnegNkmEUck6zXzf_tCKhTVIYVmeQ60g&oe=69CBD371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuGq-YLNdxsQ7kNvwG_81Jl&_nc_oc=Adplg4fCRUAtCycTITLvXbW0idbgQOTO_SiSULkrr0Ywrc9ZZz6xellbKdB-m8kBDpM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY5SSLWg4Pow6IW8kuej_U67s77SLAf77DN7YNmpae6Q&oe=69CBD8E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VHhdEIP2VkQ7kNvwExDvgX&_nc_oc=AdqxVf4sByTAzARQ4dPHOVZleo3p-GrxDzU3r3XAvIjeyY24psie-e79NdsONRqqLw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWF9NMr48CmQSYuxVdzTlnxuUncdJKeDI3YfiXpNQ7Uw&oe=6A734726"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tTWkcRXbu4Q7kNvwE7FAKf&_nc_oc=AdplRrfmSNCU8E-hLD4LSuSvxs2NXRthwX-AnVg-9SMuHoN9yYTdIHluC_CfJWmwg4Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwISNUZslP3OzDESvIih7Sh2rnJwV4KnKfAI1JNO3NGQ&oe=6A7341F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoVHVHaQNnMQ7kNvwGUZ2af&_nc_oc=AdoBBlFrugrUHNINhfziYGSqDTW80llj7b6gwsE7R-9FqjXhwF8HNaBSO9BuwAkeiyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAonfMGsi5cv_bBWJhqfPRJYRZpG2plfAHJtZiEaLDxA&oe=6A734764"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
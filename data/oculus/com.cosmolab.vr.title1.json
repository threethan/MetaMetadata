dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KygD-73agGEQ7kNvwFkEjGK&_nc_oc=AdrXkwqrj2ofRL0aRyhIuLPHFWmiGFIaYm2Pa_j8BrxKC5KkXpx0v2jYrdLkDvAWE2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCylIObtualxZiIjKaZdwmBCBl32Q0uz8cWjFFyFXJV5A&oe=6A60D226"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh1RH7hJG-IQ7kNvwHXXM5h&_nc_oc=AdpSoFqfOK8gmwHnFMcP15DaN5ZKVGYER7jABuRm98nt36JPG9lybnxtioqbq1OLA2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAveh0aBjsWD2hqNXAklrH6nrfFPDCoIwOSUuMy0xh9zQ&oe=6A60CCF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TChkydMu7oEQ7kNvwF5OhMN&_nc_oc=AdpUbKFMe8ib00BUnJ2Hz_cixdEjy310FnEwlFMhP1Uy6KklK-XJZFK28fX7sT4Pock&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaJ-21-wHILomrxlXOgokrIXmxWRw6w68v265rbMzqXw&oe=6A60D264"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
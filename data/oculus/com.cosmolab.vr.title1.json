dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylIDt8FRYXYQ7kNvwHJAo9U&_nc_oc=Adron_UVPLbILyUUFkCcR96IEUhijrGOoxH_L4E26UYLhzbzSQBjwWeEBuIoMs7jHlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmxH0qaxb8VEJipW6co90ILNnTj3r85rl2C3P-HjHJ0w&oe=6AF328A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UdorXGZo6cQ7kNvwF9112Q&_nc_oc=AdpjEnQ9x-KMYIQROxgk2D6jYJ3M4HqGFMES7hQ156j1GStWbtbuBjvd_6g5TaPfhgk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgjOtBgocwfG2H1nM3bjSciUsjv8OkhItk2FPKgkT90g&oe=6AF35BB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kz7uDwihrAQ7kNvwFGVmak&_nc_oc=AdoKafAEo9smtKg-sLRrwxJEUYtvd0TnQVRTw-Cn2cQXXxpfFvceHw78t9cf6o1eJMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy8uUAinSXIdM9lVJI6yddXC__BSpesg46iRSMGgFdVQ&oe=6AF328E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
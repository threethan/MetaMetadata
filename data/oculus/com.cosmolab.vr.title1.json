dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch147lQPP0AQ7kNvwHke_nD&_nc_oc=AdpfFJEdokIgbgheZLRyrQwzarGx8AffOv0LCr_7IOBG1K90F2wtJuxx87ClsV7VC0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMkyQIi-8djHeFXF-_z1yRgyev15HM0E5xHnQUA51i7g&oe=6A7B3026"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXQrRMoNfVkQ7kNvwHJroTP&_nc_oc=Adp1FpAIhqt9IUqER7ayjTD05DJGpRlNnVzW2HE-WDPJmusDeIbFb3Pk5da48nbBOMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZo6xP_jXWE65GIo9mKZJxFFC2OFyVzW5WKfTwH4qdOQ&oe=6A7B2AF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oDJKYVpTIgQ7kNvwG6fhcr&_nc_oc=AdpcSh1KAoJO9vSFF-e2f6vaalJL10K6vS1XK287T_pmyXTDgkdYPLsFLdCbPILAE1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE36u3Q2xrN_IAo33nhb9r3KoCgGuDhyMpsHQFDIGFCOg&oe=6A7B3064"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
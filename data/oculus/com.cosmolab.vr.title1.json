dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNuFnSMQgtAQ7kNvwE1oQTb&_nc_oc=AdoIxn6He4B0nvcUd7qX1AePPmc9rMhFrzMcktCV_ZNDNBFP4n6qhI7CxgKEYcRXo_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3SPyA0_j-oPYkSd-4msdD2mKoLRCUt_okuy-sFc-aXw&oe=69D11EA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xe9mBgsQicQ7kNvwFikEJk&_nc_oc=Ado7FjBxqahbyPMP_e2_gDH6_u3lYLlMMmFe43rcO75s-dpi94sdFHeGbZeUiwvVXqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4_5uYpITHpr7QZuc67n9UYYIXG1eGcDoA-7aXgam2Lw&oe=69D11971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFEsqBjVD54Q7kNvwEkB73N&_nc_oc=AdrYlwT3pZcJ5eXnMhSKxpQRXpnNei3vUorEHQacEU8aGC5MBENavZhUTAhZ2j2UkiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzz7pe1HMuti4uxsYqmXey3hdM4rrJmo-Zj31v2OQBBBQ&oe=69D11EE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
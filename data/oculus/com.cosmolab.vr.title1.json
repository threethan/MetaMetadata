dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNU6s3_R12YQ7kNvwG1Brs_&_nc_oc=AdqRMNR9saUr-pOGIwRn1d4HS2tCKhdMDppL6d9KUUro07SkWbfm1oiKMRch1Ux8LLI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eFo9d3qhOcpKA3igpIqwicYHME3hACbPkXywz-C4Qvg&oe=6A300AA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ME-cC_ciBCsQ7kNvwHdd1Je&_nc_oc=AdpMjoHvhhn9UCxOVTBdGeglAmLuogigXk5SyxiFCF4a-oqIBG7y5Sa7Ymm6MVitZho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cCATMv9Q4QDpZs9oNMtGmPA42qlVo_DE9_bHrncBWnw&oe=6A300571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t2sYtJim8AQ7kNvwHIUFY-&_nc_oc=Adq0xSfBtIOTG4hb2VnnIXhg4a4F0uhiqMaRM9kGx86KmxMJUgaOVDFeJbfVM22kSLc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86Y_ygKU5NHtYW1DnGifsn56E4gskBHpK_BCWIu_J_eg&oe=6A300AE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
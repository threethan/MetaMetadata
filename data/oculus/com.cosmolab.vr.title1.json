dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mMiYRYhDLUQ7kNvwHkbpL_&_nc_oc=AdogFbhGDuVfH080y4cHhkPHQ6ojTZ-NexnKQSKXxcd-KEr-jnRva3JXSUvCZr8rpPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVN7g8LOT8LLdzvItZyQgErwAW6EV_7idayHN9cPzDRQ&oe=6AC10FA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iByvTWF0x64Q7kNvwHrWjyI&_nc_oc=Adp5CyVTI1rS611jvetC8YURubZPMsNzqvEVQebdLenuIDUY8O9enxwg621hs8A8b5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF5DnvtqF_NHn3btbEOjFlNsAoAc4U755xO-xcYdr19g&oe=6AC10A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJoHJ0-GdKAQ7kNvwGxT5u_&_nc_oc=AdqBjkQNJxJ1nZLtCvGEc1M7EfmQ9Jjpk_VsvKrVQa3yWQIXj8UAYnSkRU--DmLTE_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjUua-QUIOhLEtrkgWpZ-k-ZwAI2f-vb0Rt_VEO-Cuxg&oe=6AC10FE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
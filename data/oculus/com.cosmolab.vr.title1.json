dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OGUtQlukHEQ7kNvwGRzO8_&_nc_oc=AdqfAPMEWsKNFpXhB2s7en-AucaB8J1KvmdMZ2Mwgxl39N31o-tjE_YZsMT7JuR78Mo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgwhsqSlirWzVa2NzQHCoKcS2Cc8tMQx3EAfhZAcjmEw&oe=6ADCBF26"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN5kBVEGVM8Q7kNvwFaevF5&_nc_oc=Adr92MwJF5RyQSAK4D7tkPbBP0IRTcNBcVUvuqZQK-nBEfM_Kn6jjm4JUUXT_SEcS5k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzFh-JHfNcq9fWd0cdA86CYnWHcgXT4GDYUwarrx7CBA&oe=6ADCB9F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUBapNA15AEQ7kNvwH6emNE&_nc_oc=AdrzHuftk4EHJgOj4VWZ_JXanFXaoXsEpav2e1H3L0BD7G_Qlqp0Jh9AESVjEowk4yg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpTcY3lGVUjrWaZ6r2PN7FeUwqU63pjqzObQ2wHvDshw&oe=6ADCBF64"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b98sDiNfapMQ7kNvwFFd3J4&_nc_oc=Ado-r8LBhIy90VA36XAx-GwCLScjsOEkKP5yCSCKnzQULb9vpxC00FH6_LEx13_EX8Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP30P1n1RZuV42FX0GQmfsi8Ci1R-W_tVeLZFq1C3HvRQ&oe=6AC50426"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BPj84Csm9kQ7kNvwEHQ9U3&_nc_oc=AdrcX6eluMKJDY3KwlvZg-5UZ2rsblS7ankUvjIwU1MQJ8Kzcl4NoRQfZ05tjzI-3FM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYWMxDnCEKfMCwRHkOKNWkMhNde6xEXLeVfx-IyqmllA&oe=6AC4FEF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHrztX65UbIQ7kNvwES8Gcw&_nc_oc=AdpnBkTwRT0wCEnGFTsaR3iO0RuMxCurTmmJ8aY-khjECPZeMEkYy93V5T2yHnLQ26E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCk-Bgum13x60Xh3ouB_HEzwDpnqQbOB3qLCjzOCx6PQ&oe=6AC50464"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
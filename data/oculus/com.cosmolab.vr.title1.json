dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_j31gisee0Q7kNvwExCzaw&_nc_oc=AdoArf4l7Tn0kDRbos5GL-NB4sjTUKclaFJ1RKCIHJEEFhWgLwI0vGsgpp4ytjPGyRg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZcZ2r0qUL6rb3C6JaB0VW-J9SMrgEw5DPhitnzEqYfA&oe=6A900FE6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-Us9AToFKMQ7kNvwEbymoO&_nc_oc=AdoyOgqkXDdF8u3mhkNT18SDxGENqGYEMLWGUTSMYqseVKPZuz9NZEfK5F4992E3OMc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh4TVqO-cBBkPPtDhTxr4Ts59da-Hbld4QrVZdesjE3g&oe=6A900AB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEWoKoetlEIQ7kNvwFV_lWS&_nc_oc=AdpahzNWhrSaUPxDsu9PoFa1ZuvjEWl2sAqp4C4ExZAzkwefNdl0CcqVk-25T4LLEQA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdwwkm65Shg_-nXU1oKBseI2oiWotYorWTMND5x1ufYQ&oe=6A901024"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
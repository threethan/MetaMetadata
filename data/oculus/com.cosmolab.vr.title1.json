dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mm3zTO6XE2YQ7kNvwGWxb6N&_nc_oc=AdrUyfazluKab1hw_0VmFE0-ifIIOMZXDnkp5NaHfxMCKrWL8OBC9K5vVPoQFao2bxU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SE6TEWdw_eeCaLzlIPbjk5cOOUhFvDrPI_5mVIf-96g&oe=6A32ADA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ME-cC_ciBCsQ7kNvwHK8N9I&_nc_oc=AdpAa0muPpciBEQlSNH18VLXNk3syxaO1uicii2qFTnNA9WTGlMVk_KU8lOUv5Qa9bY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dzzXIEoLGX2tLSyeD-Qh1VX5LEEOu4_GefQfKm3MgLA&oe=6A32A871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWjJdziCG74Q7kNvwH4FOko&_nc_oc=Adr9_K5hRPfHBZz1qTCicd_R3oFvsW1kQFN_knCTMh1YCMSKncZpscLRx73SH13jy54&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p24rStMQuVxvjCZMByUO7hw-9GPweCbgVnE0nhNiREQ&oe=6A32ADE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tdfk_-OsLVAQ7kNvwEdylsD&_nc_oc=AdoIlqtPCUZjlHZdQBq6mR1VkOpWJykItFT0w03hd1WFUjaeAEwpJ-70nm46Hg5lEq4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2flz9BvWAuXkxgKcBbh9j8sTZv-uHLKcK04uka3fKmzQ&oe=69DE4DA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSJjl1Lxm-YQ7kNvwEs92mH&_nc_oc=Adr9nyKXnXLNxFv291gBJwcOZbGnTQs2-Ox1PVy81azm4ZKinggfrvPpYkbGWByw_a8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b6ssTxqEtM_zURjSpWomHpMVpGOW1qZbQ9AIlWwSVWA&oe=69DE4871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8y20sIEZ0sQ7kNvwG5_aTU&_nc_oc=AdoZKXDZ8IVP540hvhDxY8SFNyWIbiGIxXo8t6X-G103T6WBXFxw3oKTb_pXtzhk5W0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Els5Udhhg06T-B3r7vDauSWvtKiLVvFV_cJqc0q4H4g&oe=69DE4DE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
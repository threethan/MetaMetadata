dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpANUBOkD98Q7kNvwHdW4M6&_nc_oc=AdrfmHnmjfFhP3MyyhptdkjnKvAOFsV4-FSkKnRghE9mNvOwsLuHHmbL5B0o-aXfEGw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oCrKb0P-VT6ebZNq9e50DAerRvprPZayKl2y_-8vR7g&oe=69D7B626"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mar-248IRx4Q7kNvwHB2dYR&_nc_oc=AdrFfU2ze9RdeZPNzrvXTkYwCTPDpo-L4XZ29esrQuCWAyZBtLdTetF5FF3KU4EUQuk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_CX4lgLj6r91PBB3PmpZ26ZFMfUjyq_WafZOh_r5tcQ&oe=69D7B0F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2JSwX0h-3cQ7kNvwE6VCBC&_nc_oc=Adq0sWwd88bTCf_6pz_8nbD-qBBf7RGDx5cP2YmF8Yo1y_sQr5zBS5kve5HaosSPfhY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af205LEmrN_ostQLRlxAR91jiafRvSVhhNAMaHtY43TS4w&oe=69D7B664"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIQEDTkXurgQ7kNvwHgP3aP&_nc_oc=AdrWkWBX4Dz5QmFMgFYblmfCri63ftgnLB2UY9xhXmpuVJDihHG0UYr7fGjxlD2SBMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw_-BggoMsAapvB0Ot_4vxHmBjzbZfAms8xfVy1zAHeA&oe=6A5CDDA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSKS2p8TYoYQ7kNvwE5APnS&_nc_oc=AdqhW55kxHdYX-XsxG5HElMYr40Yf2cLQU8I80oYl68qr98MnublMQVtTu3WEALUqVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3zjQBtNTxUwSxWGkB84Bl8MCio9fjboH0haHjOwCfMg&oe=6A5CD871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZQukUoK_esQ7kNvwEw64Sd&_nc_oc=Adoj1gS4T3EnsWINStYKMod1fwdJSTl1o5-TvGQp7FM83K9jLcHjkrKl0lASjmovO-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUnL_RfDW-h4-GwLzalH27Wu8jTyURY9-ujdB-e6p0-w&oe=6A5CDDE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
.oculuscdn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLAJsFQaWr4Q7kNvwGtw21E&_nc_oc=AdpG3_ymvJ6SJsCOQS4gz3TVsYBX7E-z89M_vJ08vpzKtTGPzicP2v_IgmmMbkHiayI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8an38fzcA5a5KA6krePdOiY5XpS0K9RxmxyyBKGsyllQ&oe=6A22DBA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuUJM3X1tI4Q7kNvwHrzEoz&_nc_oc=AdrYC-M7NZ5YzZZG9CuyY953lR-nMAZj2MXdHiUGFZ-RYiax17U9yVB0YrLnXvux40w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RGeCihVYPsAgfDiGXQNY913Ub4tuY305ONdHLse-6YQ&oe=6A22D671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHAz1VYT68EQ7kNvwF3of5r&_nc_oc=AdrCvFqAhsy0JxV0XM8GQOgV_NpirAJDKR2lvaE8qf2YBlRqdo6xDf2CYEWsnvf69EQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PPznukFcoy-0eqSte1f1QRBaMfVenxPx7-71pKws2DA&oe=6A22DBE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest."}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/ar-privacypolicies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/amusement-rides", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7498032633654866"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75196221_2765383943649014_5298624600072215707_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1k0m9r7zxYQ7kNvwGPfV66&_nc_oc=AdpyBm84J_Jd49ICQ76Id5fezY8ZqY_RzYUZlc15Q_mgykgRhbIB87gG6zz8KTguQls&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PuVG0QIkrmxW7fHGZPhc7NIVGslrH0Vm_4EhgdgJXIg&oe=6A22D481"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
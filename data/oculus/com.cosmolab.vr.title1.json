dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOznh8Xnqr0Q7kNvwEEu0Wg&_nc_oc=Ado9UrvID4L7zNQSX3jezuBapVI-HT3_MxqCuKbRjsaDfv_yTXZHTZS9pNsLaopmbrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgQIwkRgnhacWKLLg6IEwZkE2W-0N6E0lrN8OTXwmLzQ&oe=69CA8726"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHSofSlpZKIQ7kNvwHQXB6x&_nc_oc=Adoa-x_kWi1AAlwPbIlRxQV9u1vVwrFLA1ofaRLMqiz1YeiqqoYg9TKAUv3IiR_kMpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyEXB_lVwRYtjXN2mCi8p9sHZQVJxmv3tQuN33tMV8Gw&oe=69CA81F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UrzBtfWdkEQ7kNvwFBaDpF&_nc_oc=AdpG_PSy-FDMs3gaTBYiKm1zMFb4kUdFpZB2IJUgZYPEWzItFKFRym1slIzFvsWw8LE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDwmF_KBgnwo51-GW6HyOYoaL9_3X937w1gKlBgvPqRQ&oe=69CA8764"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2oG5cfMynEQ7kNvwFaeIuN&_nc_oc=AdquU5sPBIyIi75tlS4A7kZ23uwUjfvD_exO2oeq7h6CDgEU24t3M-FT4jja7FB1Eq8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98GxncM2tz3CQczteSHwxLC9qbOs6-pQIQJhEk73j6UQ&oe=6A43D126"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_9ND7j8lo8Q7kNvwGdDaOR&_nc_oc=AdrPSUvjZDGpDFnpjBCkYK62c0pEYk0jJ-t_cmZWyJVQ_bIo6ZcZYeo207j__e9h7To&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SaYnWZFmJE9Rps2wtiY9Ihib71icKBwAvZ5kOXXD0Ag&oe=6A43CBF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF986haihbcQ7kNvwH15GKs&_nc_oc=AdriONi2SWgOnDp93MrdWKGsrryrFWztBfRSSfPCtwdefZtWyZhfkWFm6H2QSIWV2f4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-Uu-lQmNSchSCLrHm6kruhqMtdofvG51lZcwpBElByQ&oe=6A43D164"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
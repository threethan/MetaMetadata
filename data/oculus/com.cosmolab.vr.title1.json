dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtHxTAgqO4IQ7kNvwHpU3Hb&_nc_oc=Adoyt4bddQMpIJ2iKb6NVZJXEnaGZ5tboS1Cx7L0RBQdAQNXfY8katLx3BOcQ35mrr8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MVdqKr8W2DaJOXfbql4okL38JWsOztdysMP6yAY5hQg&oe=69F608A6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCu7Atu3HAQQ7kNvwFB_4sF&_nc_oc=AdpO-N0U3cq4eve3Uk_0nQySeYlzjbN2aEW4u7Pebemle4CgRuf3g1JuuB03eUjLhm4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oafDdUu9xAp_c2zUMwYO-BQcHD6kyxyQP9am6Tb5UIQ&oe=69F60371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht09z6PnW-8Q7kNvwEV8566&_nc_oc=AdqEXVgdWtsDqxu0dN1OhomuBaEd51p3MGZa3xzQ_0IO61IpAHUJYMTb7igEl9KrgC4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0azNCeuxZUvrbx6bKdOV7FcuIr80R3gJG_5GZJXRJZ9Q&oe=69F608E4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
dn.com/v/t64.5771-25/38974882_1511622142839657_3999537418015904248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2eAIINQ6UAQ7kNvwGi0Un1&_nc_oc=AdpaIoblVL2fsjOwh6GvX3j9PUqxCuwC97mOTrI_MXYH63R1pH3VK42XAdlsDm69Fco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWPBxvngk1_OsWd28nqF0ADHbxwf-JF2wRfXWEb567cg&oe=6ACB9BA6"}, {"file_name": "poster3.png", "id": "1315029199493906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566689_1315029202827239_7591990409756183141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22IHdW2w1XUQ7kNvwFxK5-S&_nc_oc=AdokH7E-sD-b4Zcc8tnx6KVQyHJG0LHKDEbnVicU1TSIs4rAnAO0aRl8vWszOfccK4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1fMb2lI_dfFoEm4fODCDwyEKWMx7OiZnNi6pG7tsXBQ&oe=6ACB9671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "poaster8.png", "id": "1239516513820521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1239516517153854_8727949214084660425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DBmy-rYUcMQ7kNvwE-pXG6&_nc_oc=AdoaeLFGJgCJW3ltrhNS0GdFjsS3OUBpX-s0U7fKZTsmjb_VwnUOC5pNC42DFgbzC9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ8mCqKfiB7jFXCF3Djh0B-3ErOqBKpihsaNROn07Z3Q&oe=6ACB9BE4"}, "display_name": "Amusement Rides", "keywords": ["amusementpark", "themepark", "rollercoaster", "racing", "car"], "long_description": "\"Research for a more realistic experience than reality\"\n\nAmusement Rides offers a variety of rides and has conducted various studies to provide augmented reality.\n\n1. You can experience augmented reality rides.\n2. You can enjoy racing games by riding an augmented reality sports car.\n3. You can pilot an augmented reality airplane.\n\nIf you write what you want on the homepage,\nwe will try to reflect it immediately.\n\nWe are working hard to develop better games,\nand we appreciate your interest.\n\n\n", "short_description": "\"Research for a more realistic experience than reality\"\n\n
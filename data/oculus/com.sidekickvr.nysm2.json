dn.com&_nc_ss=7f20f&oh=00_AQRY9Iiwben3nE2CZRdo7w-JA2i8vMERgLZnjbroucRuKQ&oe=6AFF318D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NYSM_2560x1440_2.png", "id": "108579189713669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162693_108579196380335_5379158302984765440_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okB9WLjzV-YQ7kNvwFKY0Dz&_nc_oc=AdqxPpEyadH297TI6K9nOx-_TxQQQQ1nhlHHNe4OSo-QNn42y8y0ErMlg5GJrODXnDY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvf4MGu-ZMPCqSYDO3TRpGJHw1yJi2tiI62rbC21dufQ&oe=6AFF27BF"}, "display_name": "Now You See Me: Back to Macau", "keywords": ["NYSM", "Nowyouseeme", "hidden", "object", "puzzle"], "long_description": "Now You See Me: Back to Macau is the first major hidden object game in VR and features 6 challenging, adventurous missions. The game is based on the global blockbuster Now You See Me film franchise from Lionsgate. The player assumes the role of Special Agent Price, assigned to find the whereabouts of the \u201cFour Horsemen\u201d band of magicians depicted in the film, who have disappeared yet again after another narrow escape. Players will dynamically integrate themselves into the world of Now You See Me. Each mission has 50-100 possible items to uncover, with new puzzles and 20-30 items that reveal themselves each time you play.", "short_description": "Now You See Me: Back to Macau is the first major hidden object game in VR and features 6 challenging, adventurous missions. The game is based on the global blockbuster Now You See Me film franchise from Lionsgate."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.sidekickvr.com/", "developer_terms_of_service_url": "http://www.sidekickvr.com/", "publisher_name": "Sidekick Motion Games, Inc.", "support_website_url": null, "website_url": "http://www.sidekickvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category
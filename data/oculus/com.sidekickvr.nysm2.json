665jPvYQ7kNvwGyyKSb&_nc_oc=AdljGhCwmy9hdTHWMDFb7jQjtUXLbmJr7LGu9bi5NoOFakl3Zt7s7TpgdonCnC7d2FQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8tcGIDG_M2WQ3cO1GPniaoKiWSk8IwR1PymlwIyx--w&oe=69B0127F"}, "display_name": "Now You See Me: Back to Macau", "keywords": ["NYSM", "Nowyouseeme", "hidden", "object", "puzzle"], "long_description": "Now You See Me: Back to Macau is the first major hidden object game in VR and features 6 challenging, adventurous missions. The game is based on the global blockbuster Now You See Me film franchise from Lionsgate. The player assumes the role of Special Agent Price, assigned to find the whereabouts of the \u201cFour Horsemen\u201d band of magicians depicted in the film, who have disappeared yet again after another narrow escape. Players will dynamically integrate themselves into the world of Now You See Me. Each mission has 50-100 possible items to uncover, with new puzzles and 20-30 items that reveal themselves each time you play.", "short_description": "Now You See Me: Back to Macau is the first major hidden object game in VR and features 6 challenging, adventurous missions. The game is based on the global blockbuster Now You See Me film franchise from Lionsgate."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.sidekickvr.com/", "developer_terms_of_service_url": "http://www.sidekickvr.com/", "publisher_name": "Sidekick Motion Games, Inc.", "support_website_url": null, "website_url": "http://www.sidekickvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "MOVIE", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHP
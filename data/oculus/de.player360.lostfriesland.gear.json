scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982509_2194870380783360_254008596428226560_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWqZYlFvzyIQ7kNvwE_1q6V&_nc_oc=AdodUAeyXyZCGzRn1j8VovsR1rk7GCvJpEeLtyYdbrK7fp2l737100mpTInPbPfXhHY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdOP4PiihDQ_waPMhuFuTepXRcBzTYNqeUI5gRB2uFEw&oe=6AFC8223"}, {"file_name": "migrated_image.png", "id": "201028267866937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_1951517204905948_4749847797715435520_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj4HH9nVt48Q7kNvwEpJvYh&_nc_oc=AdrJNIFeEFbDHmllIdbrNWAG5EmFM7ntdcZT-za2u_UOGk-q4bKWCnO_27-sMRJ75c0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoWCILiY6ddxr2R5O9zDTNqcLKnDE-kzfCYuRv4gEB3Q&oe=6AFC6B74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lostfriesland", "keywords": ["lostfriesland", "storytelling", "player360", "mobfish", "hotspot"], "long_description": "Lostfriesland is my interactive web documentary based on the case of the Lost Frisians, a group of young Germans and Americans, who vanished without a trace in 2010. LOSTFRIESLAND will be an International Transmedia Mystery Series dedicated to the mobile generation. Taking place in both Germany and the US, it focuses on East Frisia, a coastal region in the northwest of Germany. Thousands of american families especially in Iowa, Minnesota, Wisconsin, the Dakotas and New York have their roots in Northern Germany and a strong connection to this place. Yet they do not know much about the history and mystery of their ancestors home. \nExploring this mystic land full of dark legends, LOSTFRIESLAND will immerse the viewer in a mystery enshrouded by a fog of time.\n\nThe Lostfriesland development team:\nMatthias Sdun\nJohn H\u00f6rnschemeyer\nEric B. Cornelius\nMatthias S\u00fc\u00dfen\nHeidi Hallend", "short_description": "Lostfriesland is my interactive web documentary based on the case of the Lost Frisians, a group of young Germans and Americans, who vanished without a trace in 2010."}]}, "developer_name": "mobfish GmbH", "developer_privacy_policy_url": "https://mob.fish/datenschutzerklaerung/", "developer_terms_of_service_url": "https://mob.fish/allgemeine-geschaeftsbedingungen/", "publisher_name": "Sdun.net", "support_website_url": null, "website_url": "https://facebook.com/lostfriesland", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664745824977126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974483_520880445034317_201567290557202432_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pexe6dwj0DMQ7kNvwGuBYX8&_nc_oc=AdpIs1BnMWmIFB1QYqeSm3ffeUdw9Osr8H-AeOz6oI7HnN38sW5ImLRL4MYjTz8fA60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9JmKhm6cQ__IV9lFsG1qHhIPkDaR8T6S9szoJGlit0w&oe=6AFC7B18"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lostfriesland", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1544032800, "lastRevision": {"nodes": [{"id": "659273660944555", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1509935985716959", "i
t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_agJEU5vt49CL3eSfm_zA90DwXp_kIA526SR2HdK7qxQ&oe=6A43B7E3"}, {"file_name": "migrated_image.png", "id": "201028267866937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_1951517204905948_4749847797715435520_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hB5U-JhNnlwQ7kNvwGFo5cB&_nc_oc=Adrg-MaBSgmZCsm0BuQqUwI8nWTub8CNz4vdGU_DPZMlTYzCzuB1BVxrOjJlVOs0K7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gHwC6Kl2xBk961MWDqJZQYi-kprRjzYTTRwr_pd8tUw&oe=6A43D974"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lostfriesland", "keywords": ["lostfriesland", "storytelling", "player360", "mobfish", "hotspot"], "long_description": "Lostfriesland is my interactive web documentary based on the case of the Lost Frisians, a group of young Germans and Americans, who vanished without a trace in 2010. LOSTFRIESLAND will be an International Transmedia Mystery Series dedicated to the mobile generation. Taking place in both Germany and the US, it focuses on East Frisia, a coastal region in the northwest of Germany. Thousands of american families especially in Iowa, Minnesota, Wisconsin, the Dakotas and New York have their roots in Northern Germany and a strong connection to this place. Yet they do not know much about the history and mystery of their ancestors home. \nExploring this mystic land full of dark legends, LOSTFRIESLAND will immerse the viewer in a mystery enshrouded by a fog of time.\n\nThe Lostfriesland development team:\nMatthias Sdun\nJohn H\u00f6rnschemeyer\nEric B. Cornelius\nMatthias S\u00fc\u00dfen\nHeidi Hallend", "short_description": "Lostfriesland is my interactive web documentary based on the case of the Lost Frisians, a group of young Germans and Americans, who vanished without a trace in 2010."}]}, "developer_name": "mobfish GmbH", "developer_privacy_policy_url": "https://mob.fish/datenschutzerklaerung/", "developer_terms_of_service_url": "https://mob.fish
scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982509_2194870380783360_254008596428226560_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zodgOqY5VycQ7kNvwFrx0_I&_nc_oc=Adosu0k9QsHor7pmCieItySXuVvKruQEqhccm0D68q3_HrF1DkA09r6Pa5SGT2JRxqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLkaARNqzxnAX9p9-rh25iMc4sCtuGg-NRJLGA-mogGQ&oe=6AFF2523"}, {"file_name": "migrated_image.png", "id": "201028267866937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_1951517204905948_4749847797715435520_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9wrydfRCoYQ7kNvwGzqQ9g&_nc_oc=AdqYqOY5ytRjAQ5A9HQD3r1IFZ59AQJKwDsymXhQCH5jkazbFSLDDpe5u8MQytrA2ZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmsW6HjYq4PZwXrS_NYpWdHOCif6gOesJZxsG6FdFpXQ&oe=6AFF0E74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lostfriesland", "keywords": ["lostfriesland", "storytelling", "player360", "mobfish", "hotspot"], "long_description": "Lostfriesland is my interactive web documentary based on the case of the Lost Frisians, a group of young Germans and Americans, who vanished without a trace in 2010. LOSTFRIESLAND will be an International Transmedia Mystery Series dedicated to the mobile generation. Taking place in both Germany and the US, it focuses on East Frisia, a coastal region in the northwest of Germany. Thousands of american families especially in Iowa, Minnesota, Wisconsin, the Dakotas and New York have their roots in Northern Germany and a strong connection to this place. Yet they do not know much about the history and mystery of their ancestors home. \nExploring this mystic land full of dark legends, LOSTFRIESLAND will immerse the viewer in a mystery enshrouded by a fog of time.\n\nThe Lostfriesland development team:\nMatthias Sdun\nJohn H\u00f6rnschemeyer\nEric B. Cornelius\nMatthias S\u00fc\u00dfen\nHeidi Hallend", "short_description": "Lostfriesland is my interactive web documentary based on the case of the Lost Frisians, a group of young Germans and Americans, who vanished without a trace in 2010."}]}, "developer_name": "mobfish GmbH", "developer_privacy_policy_url": "https://mob.fish/datenschutzerklaerung/", "developer_terms_of_service_url": "https://mob.fish/allgemeine-geschaeftsbedingungen/", "publisher_name": "Sdun.net", "support_website_url": null, "website_url": "https://facebook.com/lostfriesland", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664745824977126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974483_520880445034317_201567290557202432_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StEtxDbAtKUQ7kNvwGRdxYi&_nc_oc=AdpZB-AEMcytrjFhJ6GMQBd22mUfIL7OSfgkuMHpFe3cnzlLxAeM2E6gqF5xTynT-Sw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgOkWxYGepfzS06nILfuiGpW3bJh6XCQO553Rkz_crOw&oe=6AFF1E18"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lostfriesland", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1544032800, "lastRevision": {"nodes": [{"id": "659273660944555", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1509935985716959", "i
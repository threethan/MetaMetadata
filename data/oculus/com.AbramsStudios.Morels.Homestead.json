75_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7CVI3qdD8UQ7kNvwEUZYfn&_nc_oc=AdoINkaFyXXhzXf_bZJkaVIo5vJGcCT8Tf25Q8VLvq8y-ACaDHrrvs2xYUs1EL2MSF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM77JGMgjQZADrLeIZEiGaeNsHhmznmbRX0lHdkE6NnQ&oe=6A4A7463"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morels_Homestead_Artwork.png", "id": "274802414530877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75322605_274802417864210_6655069468533852729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHEMmlgXOiAQ7kNvwFFhAUN&_nc_oc=AdrJT3Lz_BOEEaI4Spbb_pv5QCi076EToGLJh4jSAGAsZUZC8XtDTw12K7HQxWgF3WM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRW37qOg3hq47UZ3VKna2R2THXz-v_vCZwgaeP1S8BFw&oe=6A4A806C"}, "display_name": "Morels: Homestead", "keywords": ["Sandbox", "Farming", "Exploration", "Adventure", "Nature"], "long_description": "In this sandbox VR adventure you'll start with a blank canvas of empty land.  Explore levels from many environments and find hundreds of unique items to keep for yourself or trade to grow your homestead into whatever you wish.  Grow and harvest crops, hunt for the elusive Morel mushroom, and find rarities to give you valuable commodities for trade.  Use your metal detector and trusty shovel to find and secure many different treasures.  Let out your inner nature enthusiast and photograph beautiful and sometimes rare animals.  The path you take is yours to choose.  Every homestead will be unique.  What will you create?", "short_description": "Build your very own homestead in this sandbox VR adventure.  Grow and harvest crops, explore and dig up treasure, trade and sell your way to glory as you grow your homestead into the something amazing."}]}, "developer_name": null, "developer_privacy_policy_url": "http://morelshomestead.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Abrams Studios LLC", "support_website_url": "http://forum.morelshomes
-J4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuSuP2mKHy8Mr3SP1yLgpDeX_0ySF0u1YlJBMzNbrTLg&oe=6B09BE57"}, {"file_name": "Morels_Homestead_Screenshot_5.png", "id": "3065132823815532", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003231_3065132827148865_2057858496466835875_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYxIc9BerlAQ7kNvwGfU0KM&_nc_oc=AdrpML7zg6FusUtx0s-EyGZK8qWWW3oJQjPqDUEsshCB5GSfzqSTuo1r8MAyk7QIpyA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFb0vmUnnDIqSddCHI2Hqbt6ZgH970bRUA_CDVP5UFUQ&oe=6B099DE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morels_Homestead_Artwork.png", "id": "274802414530877", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75322605_274802417864210_6655069468533852729_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqG9AhyTmmsQ7kNvwGksidr&_nc_oc=Adr-6ylkplvH6pGLfMfbvr27lk4r_ZVMYJE6q3iAhZJB8Xip--0WiAVV5X9YACunsxc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtn7yDPRn4l-AgMsyy-nmVADU4c-GPRg-T_azLVkn5FA&oe=6B09A9EC"}, "display_name": "Morels: Homestead", "keywords": ["Sandbox", "Farming", "Exploration", "Adventure", "Nature"], "long_description": "In this sandbox VR adventure you'll start with a blank canvas of empty land.  Explore levels from many environments and find hundreds of unique items to keep for yourself or trade to grow your homestead into whatever you wish.  Grow and harvest crops, hunt for the elusive Morel mushroom, and find rarities to give you valuable commodities for trade.  Use your metal detector and trusty shovel to find and secure many different treasures.  Let out your inner nature enthusiast and photograph beautiful and sometimes rare animals.  The path you take is yours to choose.  Every homestead will be unique.  What will you create?", "short_description": "Build your very own homestead in this sandbox VR adventure.  Grow and harvest crops, explore and dig up treasure, trade and sell your way to glory as you grow your homestead into the something amazing."}]}, "developer_name": null, "developer_privacy_policy_url": "http://morelshomestead.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Abrams Studios LLC", "support_website_url": "http://forum.morelshomestead.com/", "website_url": "http://www.morelshomestead.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "ko", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3078519945695804"}}]}, "scheduled_offers": {"count": 26, "nodes": [{"status": "PUBLISHED", "id": "2181446422506443"}, {"status": "PUBLISHED", "id": "1883853088961783"}, {"status": "PUBLISHED", "id": "869483279508000"}, {"status": "PUBLISHED", "id": "1265808538856448"}, {"status": "PUBLISHED", "id": "876577604717214"}, {"status": "PUBLISHED", "id": "822118086893577"}, {"status": "PUBLISHED", "id": "1299870921849880"}, {"status": "PUBLISHED", "id": "3700737853552648"}, {"status": "PUBLISHED", "id": "24323702483885397"}, {"status": "PUBLISHED", "id": "675207841681107"}, {"status": "PUBLISHED", "id": "1548354749170216"}, {"status": "PUBLISHED", "id": "1110367897136586"}, {"status": "PUBLISHED", "id": "1012056280716461"}, {"status": "PUBLISHED", "id": "1602208483689194"}, {"status": "PUBLISHED", "id": "75123283
466835875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THkKK0Ka4DgQ7kNvwFG69wq&_nc_oc=AdrXONbUfgSN_gKABZOoPaIQz7W2yZlovKvNQdg4EqJ1-Th9-YQtyZXV-GQFZRH6B_4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIau5B6Yx6Z2OB8il9V5_oi0n89nSLMbKIl_mN39_qPJQ&oe=6AA96063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Morels_Homestead_Artwork.png", "id": "274802414530877", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75322605_274802417864210_6655069468533852729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIIOxPpArq8Q7kNvwFjJW3z&_nc_oc=Ado769mEP1snsloa1N7vAw839K5B1HM3EVeLQWHX7wLreWlUj-CUvxpM-xq6jnrW6xk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwiaY04bPWsmRDhjvduxNAMF86MM17pQCH871h8whYng&oe=6AA9342C"}, "display_name": "Morels: Homestead", "keywords": ["Sandbox", "Farming", "Exploration", "Adventure", "Nature"], "long_description": "In this sandbox VR adventure you'll start with a blank canvas of empty land.  Explore levels from many environments and find hundreds of unique items to keep for yourself or trade to grow your homestead into whatever you wish.  Grow and harvest crops, hunt for the elusive Morel mushroom, and find rarities to give you valuable commodities for trade.  Use your metal detector and trusty shovel to find and secure many different treasures.  Let out your inner nature enthusiast and photograph beautiful and sometimes rare animals.  The path you take is yours to choose.  Every homestead will be unique.  What will you create?", "short_description": "Build your very own homestead in this sandbox VR adventure.  Grow and harvest crops, explore and dig up treasure, trade and sell your way to glory as you grow your homestead into the something amazing."}]}, "developer_name": null, "developer_privacy_policy_url": "http://morelshomestead.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Abrams Studios LLC", "support_website_url": "http://forum.morelshomestead.com/", "website_url": "http://www.morelshomestead.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "ko", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3078519945695804"}}]}, "scheduled_offers": {"count": 25, "nodes": [{"status": "PUBLISHED", "id": "1883853088961783"}, {"status": "PUBLISHED", "id": "869483279508000"}, {"status": "PUBLISHED", "id": "1265808538856448"}, {"status": "PUBLISHED", "id": "876577604717214"}, {"status": "PUBLISHED", "id": "822118086893577"}, {"status": "PUBLISHED", "id": "1299870921849880"}, {"status": "PUBLISHED", "id": "3700737853552648"}, {"status": "PUBLISHED", "id": "24323702483885397"}, {"status": "PUBLISHED", "id": "675207841681107"}, {"status": "PUBLISHED", "id": "1548354749170216"}, {"status": "PUBLISHED", "id": "1110367897136586"}, {"status": "PUBLISHED", "id": "1012056280716461"}, {"status": "PUBLISHED", "id": "1602208483689194"}, {"status": "PUBLISHED", "id": "751232833526766"}, {"status": "PUBLISHED", "id": "242741591096194"}, {"status": "CANCELLED", "id": "393752200322701"}, {"status": "PENDING", "id": "589203923144204"}, {"status": "PUBLISHED", "id": "401018225414914"}, {"status": "PUBLISHED", "id": "384530300290061"}, {"status": "PENDING", "id": "1157915464889588"}, {"status": "PUBLISHED", "id": "146924138086527"}, {"status": "PUBLISHED", "id": "1650287435797831"}
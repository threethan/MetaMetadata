QzehPw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVjS_yrL_GMK7pQHyTFuQ2wcZEk-2ZThz8a7M2T6yzEQ&oe=6A5A483D"}, {"file_name": "Screen3.png", "id": "1118338210239094", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831968_1118338213572427_8904184063999610555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgH5cNlrVTkQ7kNvwH8afKI&_nc_oc=AdpU5Du-3iXCyPvJzN8MhnaOzUVQnNf4Pzzf3yy3E5HV5arEgsavnjk6GQdeOZ4XAKc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHXYmt6sYJpwEPwdWwLDLArEAjrSq7bR4xwubGkUKmFg&oe=6A5A2D65"}, {"file_name": "Screen4.png", "id": "1488649155655884", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618220_1488649158989217_1031827634807877511_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umklWoipaGMQ7kNvwE3JmTn&_nc_oc=AdrTM9kkUjKuCGLF37-m_z5VPSMzRUyjhooNRLsmhXIn10o5L7cJfD7xZrtEIcXmSiA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrTM10X-5mjeX3apEyCxZbpw-XzTQKF0k9wU4nK2-qFQ&oe=6A5A167B"}, {"file_name": "Screen5.png", "id": "3083406291819090", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499302527_3083406295152423_6550961903543617990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U54y94Ws2d4Q7kNvwHf6wiJ&_nc_oc=AdqKE5hiI3ibs2FcyoS1uBR_Xklti_jiWHNfdaxJefhJo07ojb2pp_dW9bCYNywy52c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv80j7RDg8TidwantBlRXaSvcO5JmM0TrLAsNS0XV4Qw&oe=6A5A44CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AnExplorer VR File Manager", "keywords": ["file", "manager", "transfer", "network", "cloud"], "long_description": "**AnExplorer File Manager** is a simple, fast, efficient and powerful file manager app with a clean and intuitive interface with material you. File browser can easily manage storages on your device, USB storages, SD cards, Network storages,cloud storages and transfer files on wifi on all android devices including Phones, Phablets, Tablets, Watches, TVs, Chromebooks and VR Headset.\n\n**File Organizer**\n\u2022 Browse, create, multi select, delete, rename, compress, extract, copy & paste, move files and folders\n\n**Storage File Manager**\n\u2022 Browse files and folder from USB mass storage devices with a FAT32 or NTFS file system like SD Cards, Internal Storage, External Storage, USB Storage, Flash Drive, Pen Drives, USB OTG\n\n**Offline WiFi Share**\n\u2022 Wirelessly transfer files between Android devices without creating a hotspot\n\u2022 Send multiple files instantly over the same WiFi network\n\n**Device Connect**\n\u2022 Turn your phone into an server to access files from a browser\n\u2022 No cable required\u2014just enter the IP in your PC\u2019s browser\n\n**Network File Manager**\n\u2022 Connect to FTP, FTPS, SMB, and WebDAV servers\n\u2022 Stream and transfer files from NAS devices and shared folders\n\n**Cloud File Manager**\n\u2022 Manage Box, Dropbox and OneDrive\n\u2022 Upload, download, delete, or preview media directly in the cloud\n\n**Media Viewer**\n\u2022 Preview images with zoom, swipe navigation, and slideshow support and Play audio and video files within the app and manage media playback queues and playlists\n\nAnd a lot more", "short_description": "All-in-one file management tools (File Explorer) for Phones, Android TV, Watches, Chromebooks and VR Headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://anexplorer.io/privacy", "developer_terms_of_service_url": "https://anexplorer.io/terms", "publisher_name": "DWorkS", "support_website_url": null, "website_url": "https://anexplorer.io/device/vr-headset", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_
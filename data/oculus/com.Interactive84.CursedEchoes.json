0", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307435_1189463473388763_1317212034487680852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPmL4G0e744Q7kNvwHD-hp1&_nc_oc=Adpm5kNnsFY_6pv2xR2t_0SeeWOaNKnHm-_BS5E2xv5ksKh82q0435jC9A-Pria3eWE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFNYP5_1mGcXVxZhj_FJV53zIN1yTuA6lC14zDohh0lQ&oe=69CBBCCB"}, {"file_name": "screenshot-4.png", "id": "836601282712095", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619098_836601286045428_5290704437211304261_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pL17g-DuqZgQ7kNvwEZo9ap&_nc_oc=Adp26hwtg-U38i327Fsn_08XOcb4pEJP97HUmPn90ZXVBSgojk9YCBsHqVpRH8iLQ_M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuvdjFfUCKF1py_jDxcXxbNNflMTSRnxT7H3x731oSkA&oe=69CBB36C"}, {"file_name": "screenshot-3.png", "id": "1121884656558620", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821178_1121884659891953_6625228164301450688_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z91bvS6QPH4Q7kNvwHZUQzz&_nc_oc=Adq8z96Dmozxw58ng0XnPy2tU_IHOILOu2MiaPRu064dqZpwbDMsZgHNXaRfoEbE38g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9YWtMfeTZhkk6Wd_TZpMOcXMp1GhRxTvnBsNJsiUJzw&oe=69CBD25A"}, {"file_name": "screenshot-5.png", "id": "1189242123381948", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619680_1189242126715281_8662364020517699506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP5yjx5f0LwQ7kNvwGhwHFp&_nc_oc=AdrQXlojzkEcd6kwaDyOZTMf88D8qMP5esBo1PvQEuASToSvGpzHGnFJamb5EzjbzoE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw45egA3KLLYnI6YYxxfhsDfWz87XhLZ_HSpy2WMCyOVw&oe=69CBB723"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot-2.png", "id": "4178513852362067", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617729_4178513855695400_3362808483587583036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T64DTfa82XcQ7kNvwEy_KYj&_nc_oc=AdoIMjWR4ssI33gKOtlRPzOVC8xMrHYJ-1V90APjSxVsI3XXx-LcUa6DvrfKfpammYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzk_ruBcwDsBr188pqF8DFnpUeqMQRg91DI6eoUkSZDvg&oe=69CBC210"}, "display_name": "Cursed Echoes", "keywords": [], "long_description": "Step into Cursed Echoes, a psychological VR horror game where reality itself cannot be trusted. You are trapped inside a shifting home that resets with every loop, its walls whispering with grief, dread, and something far darker. Each pass draws you deeper into a cycle of distorted rooms, uncanny sounds, and manifestations that grow more sinister the longer you endure.\n\nYour only way forward is to pay close attention. Notice what has changed. Trust your instincts. The house will test your memory, your courage, and your ability to tell the ordinary from the unexplainable. A single mistake could send you back to the beginning\u2014accompanied by chilling consequences.\n\nSurvive long enough, and fragments of a tragic story begin to surface: a woman who vanished, time that stopped, and a fate that may echo forever. But in Cursed Echoes, even escape may be nothing more than another illusion.\n\nPowered by cutting-edge visuals, spatial sound, and unpredictable hauntings, Cursed Echoes delivers an intensely atmospheric VR experience designed to keep you constantly on edge. Every glance, every sound, every flicker of light could be the difference between progress and being claimed by the echoes.", "short_description": "Cursed Echoes is a VR anomaly-hunting horror game where every loop could be your last. Explore a haunted home that twists and distorts with every pass, uncover chilling anomalies, and make choices that decide whether you advance\u2014or face terrifying consequences. Featuring cutting-edge visuals and immersive sound, escape seems possible\u2026 but in this house, nothing is ever certain."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursedechoes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Interactive 84", "support_website_url": null, "website_url": "https://cursedechoes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33666845439595591"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1241733150902945"}, {"status": "PUBLISHED", "id": "881245684310076"}]}, "baseline_offer": {"id": "1241733150902945"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773939600, "status": "PUBLISHED", "id": "1241733150902945"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34788023977477726", "version": "1.04"}, "id": "1137737314880287", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "30736321022648062", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34788023977477726"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1137737314880287"}]}, "change_log": null, "created_date": 1773855172, "id": "34788023977477726", "version": "1.04", "version_code": 21, "release_status": "RELEAS
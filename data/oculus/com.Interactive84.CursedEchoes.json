xEWwROtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F-Ur1At3xX_paXCvzL0vqzob88hl-boIgKn6d1GvR-A&oe=69DF7DA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot-2.png", "id": "4178513852362067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_4178513855695400_3362808483587583036_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODVeUu4GrjEQ7kNvwHQViBm&_nc_oc=AdpcUrEdH4Ny4jHVhDhfFgOQvh6eCsrrRhZHARtLRj10gq13vNr0q186bFJbKMbzs2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mhzHEsg62IynBLazwYvMa9eCL5IBWSpDoTfAPWM1T0g&oe=69DF8890"}, "display_name": "Cursed Echoes", "keywords": [], "long_description": "Step into Cursed Echoes, a psychological VR horror game where reality itself cannot be trusted. You are trapped inside a shifting home that resets with every loop, its walls whispering with grief, dread, and something far darker. Each pass draws you deeper into a cycle of distorted rooms, uncanny sounds, and manifestations that grow more sinister the longer you endure.\n\nYour only way forward is to pay close attention. Notice what has changed. Trust your instincts. The house will test your memory, your courage, and your ability to tell the ordinary from the unexplainable. A single mistake could send you back to the beginning\u2014accompanied by chilling consequences.\n\nSurvive long enough, and fragments of a tragic story begin to surface: a woman who vanished, time that stopped, and a fate that may echo forever. But in Cursed Echoes, even escape may be nothing more than another illusion.\n\nPowered by cutting-edge visuals, spatial sound, and unpredictable hauntings, Cursed Echoes delivers an intensely atmospheric VR experience designed to keep you constantly on edge. Every glance, every sound, every flicker of light could be the difference between progress and being claimed by the echoes.", "short_description": "Cursed Echoes is a VR anomaly-hunting horror game where every loop could be your last. Explore a haunted home that twists and distorts with every pass, uncover chilling anomalies, and make choices that decide whether you advance\u2014or face terrifying consequences. Featuring cutting-edge visuals and immersive sound, escape seems possible\u2026 but in this house, nothing is ever certain."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursedechoes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Interactive 84", "support_website_url": null, "website_url": "https://cursedechoes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33666845439595591"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "881245684310076"}, {"status": "PUBLISHED", "id": "1241733150902945"}]}, "baseline_offer": {"id": "1241733150902945"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773939600, "status": "PUBLISHED", "id": "1241733150902945"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34788023977477726", "version": "1.04"}, "id": "1137737314880287", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
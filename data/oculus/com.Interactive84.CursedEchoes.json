78_1121884659891953_6625228164301450688_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QvQt-YM_JkQ7kNvwFNFReV&_nc_oc=AdoFDoowCes8ihUyuZUMJauRwHXkb4Q72cATa9wvNJyyP0R2O5oTAAtlNddjCX2y6OE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ntDpB0mr-y7DWw3R7dxyeo2H3itcLj6ucVkEttxdglg&oe=69DF98DA"}, {"file_name": "screenshot-5.png", "id": "1189242123381948", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_1189242126715281_8662364020517699506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2UqSyAFvZsQ7kNvwF7SSZp&_nc_oc=AdqRCVMZ-laKkWtjNlMtkvZkcnHIFYdahz637Y8Ridhs2nH-RgishuxfOe_xEWwROtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F-Ur1At3xX_paXCvzL0vqzob88hl-boIgKn6d1GvR-A&oe=69DF7DA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cursed-echoes-thumb.png", "id": "2448993468850401", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307413_2448993472183734_8702155126693545472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSDG3yjDnA8Q7kNvwG682ak&_nc_oc=Adq1QVThtisKPMqMTNSzimuXncVVzIWweokjqpdL3Hd2nZ2OhDhSHyN9lElKvJrUaSI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N31phvjxdj44ChbBwQ0_HuVzVNx827jvOrLPL7L1GgQ&oe=69DF7466"}, "display_name": "Cursed Echoes", "keywords": ["Horror"], "long_description": "Cursed Echoes is a psychological VR horror game about observation, memory, and consequences.\n\nYou are trapped in a looping house that resets every time you reach the end. Each pass looks the same... but something might be wrong.\n\nYour goal is simple: **figure out if the loop has changed.**\n\nAt the end of each run, choose:\n- **Clean Door** :  if nothing is wrong  \n- **Cursed Door** : if you spotted an anomaly  \n\nGet it right, and you progress.  \nGet it wrong\u2026 and you\u2019ll be punished.\n\n---\n\n# Features\n\n- **Anomaly Detection Gameplay** - Spot subtle or obvious changes in the environment  \n- **Multi-Step Anomalies** - Some react when you stare\u2026 or get too close  \n- **Unpredictable Jump Scares** - Triggered by your actions, not just scripted moments  \n- **Loop-Based Progression** - Advance by being correct, reset if you\u2019re not  \n- **Immersive VR Horror** - Detailed visuals and spatial audio keep you on edge  ", "short_description": "Cursed Echoes is a VR anomaly-hunting horror game where every loop could be your last. Explore a haunted home that twists and distorts with every pass, uncover chilling anomalies, and make choices that decide whether you advance\u2014or face terrifying consequences. Featuring cutting-edge visuals and immersive sound, escape seems possible\u2026 but in this house, nothing is ever certain."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cursedechoes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Interactive 84", "support_website_url": null, "website_url": "https://cursedechoes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34967354522878003"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820208_1271169774219893_3972265454935577538_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz5odlq-l9MQ7kNvwFM_vX9&_nc_oc=AdocUwSW_sMp_HMnr7mgLSWV2rTx54DQrWhLzgDHNYJyHLD2Z0jEc9fO
/t64.5771-25/499618440_1678579943157826_3129095830697072068_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSyF2dsHZaQQ7kNvwF7cuPM&_nc_oc=AdrRXyY7gqCL9wYyj1RQmzV888hIZe6rMJmQfncYfLY_5gqFohdrt8WuEYRnBeLdPDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKIqh7Jz0JJWttE6gtoN4sWH_R8jiuLT4g5kMphzMfwA&oe=6AFDBDCA"}, {"file_name": "Yaks_MainHub_2026-04-17_16-25-14.png", "id": "925388513462488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_925388516795821_2733775101243908540_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeAo9r2ZH_MQ7kNvwFr-njc&_nc_oc=AdrhzX-KxF6C5CygXpDknqbd1Ibo7p7Yg9dZSXwkXWYR7EGnRiEzfYrf5JICikrO3bQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBph3z_DwaLV06uC3EmbGB5Caa9NyAWc4wfAqvYukFBg&oe=6AFDDF98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YaksSummer.png", "id": "918057541033987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298451_918057544367320_4920090487782396246_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HExEUbVWi94Q7kNvwEMdxCb&_nc_oc=Adp_b9NBeW699pfB21o6phuoXZ1j1-Cdk7YOrgea82vD1MW8LPKHGF6RqFXjhT_yDA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqbYAIlxbCzMX8eAllzjouedHPZL6y2aQsJeBFJw-T5g&oe=6AFDE340"}, "display_name": "Yaks", "keywords": ["sandbox", "building", "openworld", "beach"], "long_description": "Yaks is a multiplayer virtual reality sandbox game all about Building and hanging out\n\nBe the Yak \u2013 Be a Yak\n\nExplore Wildly \u2013 Traverse open world and discover mysteries left by other players.\n\nConstruct Your World \u2013 Construct your map with various blocks.\n\nMultiplayer Insanity \u2013 Socialize, wander, or get rowdy alongside other yaks.\n\nPlay for Free \u2013 Jump right into the game anytime, free of cost.\n\nFrom building odd structures, or simply chilling with other yaks, it all boils down to your movements, your creativity, and your curiosity.\n\nGrab your luggage. Begin building. Begin yakking.", "short_description": "Yaks is a fun sandbox  vr game with open world and more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corbino5021studios.com/privacy-yaks", "developer_terms_of_service_url": null, "publisher_name": "Corbino5021", "support_website_url": null, "website_url": "https://www.corbino5021studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27415864854683602"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27557104013893018", "version": "0.0.26"}, "id": "1924614351471462", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27204898799113543", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27557104013893018"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778455833, "id": "2768554880
w_po0oJ0Q7kNvwE5KhxH&_nc_oc=AdpR50vTwLejYS_VLwJiVsXE7GPB4mZHzxFRKak6jGYGmySgmdup3_lhKGwULVHRxfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTegxc4vD55KTX8pymnpu61Qo4C6zecPSPE3_93EkRF-A&oe=6AEB3258"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YaksSummer.png", "id": "918057541033987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298451_918057544367320_4920090487782396246_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E9IKRy9lwwQ7kNvwG4GGQ1&_nc_oc=AdrLq_32P-n-aKb2tBlrv7PDmx0as70AxsLaozc_bJetfjlccUxBnu9oxFMmf1_P23w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP9dBoX-pH55P9ehpkjCtAWsW_WvVnrUKbj5t75TTpcg&oe=6AEB3600"}, "display_name": "Yaks", "keywords": ["sandbox", "building", "openworld", "beach"], "long_description": "Yaks is a multiplayer virtual reality sandbox game all about Building and hanging out\n\nBe the Yak \u2013 Be a Yak\n\nExplore Wildly \u2013 Traverse open world and discover mysteries left by other players.\n\nConstruct Your World \u2013 Construct your map with various blocks.\n\nMultiplayer Insanity \u2013 Socialize, wander, or get rowdy alongside other yaks.\n\nPlay for Free \u2013 Jump right into the game anytime, free of cost.\n\nFrom building odd structures, or simply chilling with other yaks, it all boils down to your movements, your creativity, and your curiosity.\n\nGrab your luggage. Begin building. Begin yakking.", "short_description": "Yaks is a fun sandbox  vr game with open world and more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corbino5021studios.com/privacy-yaks", "developer_terms_of_service_url": null, "publisher_name": "Corbino5021", "support_website_url": null, "website_url": "https://www.corbino5021studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"
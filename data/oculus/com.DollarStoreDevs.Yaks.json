-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu2z9A8I7_4hNer0I2tW6gJcUWPDyVRbEqCeQ4tgg_yg&oe=6A4909D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YaksSummer.png", "id": "918057541033987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298451_918057544367320_4920090487782396246_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAkeICNWMmsQ7kNvwEYmb_m&_nc_oc=Adp_vIazGFoxGqNimGdIpLlLrpyfELavnphOBBu-9UHDhMQecNgQT3ey6qlFd6dsO_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_y3AI3OzRecaOSmqZ5_CGwUDs0boWEMHXzSLZw4drpA&oe=6A490D80"}, "display_name": "Yaks", "keywords": ["sandbox", "building", "openworld", "beach"], "long_description": "Yaks is a multiplayer virtual reality sandbox game all about Building and hanging out\n\nBe the Yak \u2013 Be a Yak\n\nExplore Wildly \u2013 Traverse open world and discover mysteries left by other players.\n\nConstruct Your World \u2013 Construct your map with various blocks.\n\nMultiplayer Insanity \u2013 Socialize, wander, or get rowdy alongside other yaks.\n\nPlay for Free \u2013 Jump right into the game anytime, free of cost.\n\nFrom building odd structures, or simply chilling with other yaks, it all boils down to your movements, your creativity, and your curiosity.\n\nGrab your luggage. Begin building. Begin yakking.", "short_description": "Yaks is a fun sandbox  vr game with open world and more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corbino5021studios.com/privacy-yaks", "developer_terms_of_service_url": null, "publisher_name": "Corbino5021", "support_website_url": null, "website_url": "https://www.corbino5021studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_ap
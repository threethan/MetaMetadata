w_po0oJ0Q7kNvwEYqgBo&_nc_oc=Adrh_tYhDHO9H5LD1pzCWWOyp_XXw7ji5k-Y6jN54Tph01bJMxb4q1al_vI4GkMsv2g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ4kH6b3menFaKeQLzgUm0i3Fw_xMGjkd6smRWD_BI9Q&oe=6AEC83D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YaksSummer.png", "id": "918057541033987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298451_918057544367320_4920090487782396246_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E9IKRy9lwwQ7kNvwH-YTId&_nc_oc=Adpt0tCyDAidYbv97Ksz3fx6IxrZgNljtgifqkDsNmAGWfkmcoa1JSXJEBxVEcP-bw0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShnmPwILruh1ayMDKcIM_aaUEvj_cSqZsvEkNrAn4aiQ&oe=6AEC8780"}, "display_name": "Yaks", "keywords": ["sandbox", "building", "openworld", "beach"], "long_description": "Yaks is a multiplayer virtual reality sandbox game all about Building and hanging out\n\nBe the Yak \u2013 Be a Yak\n\nExplore Wildly \u2013 Traverse open world and discover mysteries left by other players.\n\nConstruct Your World \u2013 Construct your map with various blocks.\n\nMultiplayer Insanity \u2013 Socialize, wander, or get rowdy alongside other yaks.\n\nPlay for Free \u2013 Jump right into the game anytime, free of cost.\n\nFrom building odd structures, or simply chilling with other yaks, it all boils down to your movements, your creativity, and your curiosity.\n\nGrab your luggage. Begin building. Begin yakking.", "short_description": "Yaks is a fun sandbox  vr game with open world and more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corbino5021studios.com/privacy-yaks", "developer_terms_of_service_url": null, "publisher_name": "Corbino5021", "support_website_url": null, "website_url": "https://www.corbino5021studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EmV6Az1jjMQ7kNvwFMeQcV&_nc_oc=Ado3KXAhszhQflQJSKajAkmg4A5ZNacoLlm4fLv4rShuxHBXAVkNtavhSbKAhrrHrE4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QnPAZZpdLSTwrGS4WWNYZoU4cu8thZfrPdloE0YsGPg&oe=6A11997E"}, "display_name": "Fantasynth 2", "keywords": [], "long_description": "Fantasynth 2 is an ongoing exploration of the emotional and perceptual effects of procedurally generated visuals synchronized to music.\n\nThis installment of the series focuses on building a walkable virtual space anchored in reality but evolving with the music, intersecting with the real space like a parallel new sensory dimension.\n\nFeaturing music by Carbon Based Lifeforms.\n\nDuration: 5 minutes.", "short_description": "Fantasynth 2 is an ongoing exploration of the emotional and perceptual effects of procedurally generated visuals synchronized to music.\n\nThis installment of the series focuses on building a walkable virtual space anchored in reality but evolving with the music, intersecting with the real space like a parallel new sensory dimension.\n\nFeaturing music by Carbon Based Lifeforms.\n\nDuration: 5 minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://helloenjoy.com/legal", "developer_terms_of_service_url": null, "publisher_name": "HelloEnjoy", "support_website_url": null, "website_url": "https://fantasynth.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_
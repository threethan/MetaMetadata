10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kyendKMmcAQ7kNvwE3O5-2&_nc_oc=AdrmjVbLuSQRyI6h_H4_qIg-dvKYkBSBxapJUPwGQkczhtWIzUk5So7MBekr0oI3WBo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_nR9ZIe4XyzHyFd_-8SxUyfCRL_0FY2LQXlmbLDi1eQ&oe=6A65F97E"}, "display_name": "Fantasynth 2", "keywords": [], "long_description": "Fantasynth 2 is an ongoing exploration of the emotional and perceptual effects of procedurally generated visuals synchronized to music.\n\nThis installment of the series focuses on building a walkable virtual space anchored in reality but evolving with the music, intersecting with the real space like a parallel new sensory dimension.\n\nFeaturing music by Carbon Based Lifeforms.\n\nDuration: 5 minutes.", "short_description": "Fantasynth 2 is an ongoing exploration of the emotional and perceptual effects of procedurally generated visuals synchronized to music.\n\nThis installment of the series focuses on building a walkable virtual space anchored in reality but evolving with the music, intersecting with the real space like a parallel new sensory dimension.\n\nFeaturing music by Carbon Based Lifeforms.\n\nDuration: 5 minutes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://helloenjoy.com/legal", "developer_terms_of_service_url": null, "publisher_name": "HelloEnjoy", "support_website_url": null, "website_url": "https://fantasynth.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "suppor
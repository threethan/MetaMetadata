KhSXOo0DRM1a5LWEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQffNT6R8nCMphvSb__m8yn0-y0jIARAZ37_0CCM06rzA&oe=6AFDB206"}, {"file_name": "Invasion Screenshot 2.png", "id": "804085120432676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982635_804085127099342_7964503184631242952_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0lsTkIXZrEQ7kNvwF1HQ-z&_nc_oc=AdqEZE4JCtws-fmA-EkkfmEZDZufCLuImvwJe5HIf9vRg9BByoCPlhoAxseU14Vv2TU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMRWKslCEGVEsBCQ5__8rfnGz1sNvomLZuwyEKH_r64A&oe=6AFDBFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "INV_Xmas20_Landscape_2560x1440_4 (1).png", "id": "908097840041890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003249_908097846708556_5556974546925197874_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct4Z4VAGZRwQ7kNvwHC0yB3&_nc_oc=AdpaRrsNmCCgXygGaZYpsaTa2Vcfm9vTPbJw2iFdsbFjyewYZVDY5CaoPx4kDrhcaBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKYGl8Y9wiCPxCv72pUu1jzq3XfgFS2Lu6WfR3Y9Z7oA&oe=6AFDE0D3"}, "display_name": "INVASION! Anniversary Edition", "keywords": [], "long_description": "Eric Darnell, Chief Creative Officer, first had the idea for the bunnies facing off against the aliens after watching the 1953 film, War of the Worlds. It struck Eric that some of the most unassuming organisms on the planet were the downfall of such \"advanced\" aliens. In INVASION! Eric took that concept to the humorous extreme by pitting the aliens against two of Earth's meekest creatures -- fluffy little bunnies.  Combining the concept of these heroic bunnies with the slapstick Laurel and Hardy antics of the two aliens, INVASION! highlights the bumbling nature of invaders who fail to account for the least among us when drawing up their attack plans.  Narrated by Ethan Hawke, the Emmy winning Invasion! has been remastered for the Oculus Quest with new bonus content and hand-tracking. ", "short_description": "Emmy Winning Invasion! lands on the Quest. From the director of Madagascar movies and narrated by Ethan Hawke, comes Baobab's first VR story remastered for Oculus Quest.  When two bumbling aliens, Mac & Cheez, land on Earth to begin their conquest it looks like nothing can stand in their way.  Instead, they are thwarted by two adorable bunnies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.baobabstudios.com/baobab-privacy-policy", "developer_terms_of_service_url": "https://www.baobabstudios.com/terms-of-service", "publisher_name": "Baobab Studios", "support_website_url": "https://www.baobabstudios.com/contact", "website_url": "https://www.baobabstudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "678453680192282"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "862605944555325"}]}, "baseline_offer": {"id": "862605944555325"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1608228000, "status": "PUBLISHED", "id": "862605944555325"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6556263127795002", "version": "1.0.250"}, "id": "618816085726665"
4503184631242952_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYf940QaarsQ7kNvwGuJWtJ&_nc_oc=Adq-mTjPhCAasqqz9tAgaxh4H-nYZUWDH0kql4YtatUJWbCiObFpdZUR03MF_beC3gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7431tGDwSjRkfd691KLgwCprp-qFwaiK8aqeZcLxmWg&oe=6B06FA71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "INV_Xmas20_Landscape_2560x1440_4 (1).png", "id": "908097840041890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003249_908097846708556_5556974546925197874_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1njUiukrBAQ7kNvwE5rFcF&_nc_oc=AdoJetVM74GM2xIS-L413xLNTZBJ0pwe1AOtoFxSEp_mwI4iG7SQuyHJPYJW-KD_RCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQprl8aN_2ywiKb_tAEUacVj23LWlM6c2zFTEVej0jrzA&oe=6B071B53"}, "display_name": "INVASION! Anniversary Edition", "keywords": [], "long_description": "Emmy Winning Invasion! lands on the Quest. A Free VR short film narrated by Ethan Hawke, has been remastered for Oculus Quest.  When two bumbling aliens, Mac & Cheez, land on Earth to begin their conquest it looks like nothing can stand in their way.  Instead, they are thwarted by two adorable bunnies. Invasion is a 6 minute family friendly movie. \n\nEric Darnell, Director of Madagascar, first had the idea for the bunnies facing off against the aliens after watching the 1953 film, War of the Worlds. Combining the concept of these heroic bunnies with the slapstick Laurel and Hardy antics of the two aliens, INVASION! highlights the bumbling nature of invaders who fail to account for the least among us when drawing up their attack plans.  Invasion! has been remastered for the Oculus Quest with new bonus content and hand-tracking. ", "short_description": "Emmy Winning Invasion! lands on the Quest. A Free VR short film narrated by Ethan Hawke, has been remastered for Oculus Quest.  When two bumbling aliens, Mac & Cheez, land on Earth to begin their conquest it looks like nothing can stand in their way.  Instead, they are thwarted by two adorable bunnies. From the director of Madagascar movies, Invasion is a 6 minute family friendly movie. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.baobabstudios.com/legal/privacy-policy", "developer_terms_of_service_url": "https://www.baobabstudios.com/legal/terms-of-service", "publisher_name": "Baobab Studios", "support_website_url": "https://www.baobabstudios.com/contact/form", "website_url": "https://www.baobabstudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MOVIE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25963281356666556"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_201957651532763_1070918434082259356_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARjbKxiSV2QQ7kNvwFu8eOu&_nc_oc=Adr_Avb0_zr-EXwUjFR30Cxfh-7xeXWeI6D5LPaUAXmzdMY2kqmIdy0BnF9OSn4FMRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDhuJgX2vi9vxrGolL7EDQdS9CF9EnMIROBKzRGlDXfg&oe=6B070B41"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "INVASION! Anniversary Edition", "platform": "ANDROID_6DOF", "context_category": {"context_category": "
ler": null, "video_trailer_thumbnail": {"file_name": "INV_Xmas20_Landscape_2560x1440_4 (1).png", "id": "908097840041890", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003249_908097846708556_5556974546925197874_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL-k_fQLwCEQ7kNvwH_nqAP&_nc_oc=Adlp_A7xgh15ZJeP6K8WNhOzPm2AqveSmrmpGOiXpi02YwP-JVLJZgRujChlsz_yISw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2XBjBUSyA8Xoub0kF2vHkPtullU1FD_GJ0oXeNfiy6g&oe=69B16E93"}, "display_name": "INVASION! Anniversary Edition", "keywords": [], "long_description": "Emmy Winning Invasion! lands on the Quest. A Free VR short film narrated by Ethan Hawke, has been remastered for Oculus Quest.  When two bumbling aliens, Mac & Cheez, land on Earth to begin their conquest it looks like nothing can stand in their way.  Instead, they are thwarted by two adorable bunnies. Invasion is a 6 minute family friendly movie. \n\nEric Darnell, Director of Madagascar, first had the idea for the bunnies facing off against the aliens after watching the 1953 film, War of the Worlds. Combining the concept of these heroic bunnies with the slapstick Laurel and Hardy antics of the two aliens, INVASION! highlights the bumbling nature of invaders who fail to account for the least among us when drawing up their attack plans.  Invasion! has been remastered for the Oculus Quest with new bonus content and hand-tracking. ", "short_description": "Emmy Winning Invasion! lands on the Quest. A Free VR short film narrated by Ethan Hawke, has been remastered for Oculus Quest.  When two bumbling aliens, Mac & Cheez, land on Earth to begin their conquest it looks like nothing can stand in their way.  Instead, they are thwarted by two adorable bunnies. From the director of Madagascar movies, Invasion is a 6 minute family friendly movie. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.baobabstudios.com/legal/privacy-policy", "developer_terms_of_service_url": "https://ww
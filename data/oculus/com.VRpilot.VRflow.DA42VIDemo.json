, {"file_name": "Screenshot 5.png", "id": "697596495105167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348043_697596498438500_3754538219899813842_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGqMe01KhaMQ7kNvwE2Lmn6&_nc_oc=Adrsq9njt2Y4i1rV0wE4Kckmnl1IGpbjoA7L5cXIu2rRvSNYj_xVMOdtgMRwVB8fNIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkMR_LILXkauPlc3n70dmTmLMcABQx-AEJpwHkhsbjfg&oe=6AFDBC80"}, {"file_name": "Screenshot 3.png", "id": "1482618865557660", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75330717_1482618868890993_6018513985462408663_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RxygBQknwEQ7kNvwGgx9S0&_nc_oc=AdohpXjyEkm5MSnyUlOo32rYkKTwRpKVBjRMAf4ebt_3gbiX97z1pWJ36n79fJplpZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiXzn6E5X0mCjyqd_ZDz8fRN7IbjtQHNdsxCNdQ_GrTA&oe=6AFDD68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-11-23-17h01m00s858.png", "id": "3240897572793536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75330717_3240897576126869_1819575686048162814_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_X4gPzxSl4Q7kNvwHeeoik&_nc_oc=Adp9hL04OrxCrCov0YGdFMq-YKGOTePaKQhcLr0E5dOxuBmz5tfmNWBAjxlcCrTg0Dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW_pTo7UquUviyBq9vIB-CdXM0RaiPujApsTH3MoJwfA&oe=6AFDD376"}, "display_name": "VRflow DA42 Demo", "keywords": ["da42", "diamond"], "long_description": "This is the free demo version of VRflow DA42.\n\nVRflow DA42 is the interactive cockpit procedure trainer for pilots training and flying on the DA42-VI. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, and much more.\n\nThis demo version only includes the Engine Start procedure.\n\nBuy the full version for access to a total of 8 normal procedures and 6 emergency/abnormal procedures. Explore Mode, where you can explore the cockpit and learn about systems, is also included in the full version.", "short_description": "This demo version contains one procedure and does not have the Explore Mode feature.\n\nVRflow DA42 Demo is the interactive cockpit procedure trainer for pilots, used by airlines worldwide. VRflow incorporates advanced VR learning technologies, providing an extremely efficient learning tool for pilots doing their flight training.\n\nAll purchases of VRflow will be upgraded as we add more procedures, fix bugs and make VRflow better."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": "https://vrpilot.aero/contact/", "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "UTILITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25941918095417606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974877_802415594173166_16599059189532
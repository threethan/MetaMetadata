p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ym7Sme8Kt0Q7kNvwGjkucR&_nc_oc=AdroQqQWDQ8dtf_CrHC63_SJWPPjnxuu__fmShFskB_QEa2G8re2doiDmG8sITQ30fk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9w-JH2EGBbDlWstyQyHbl0ayrBNpcwFplxJUC9YOxfA&oe=6AFB3365"}, {"file_name": "04-new-record-combo.png", "id": "1834268041322909", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/753328995_1834268044656242_1991748281277716203_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpGjPC3OSFgQ7kNvwF84vuZ&_nc_oc=Adq0C5En00LHBQGh2DRziCOG6PpLkKMAuAIrteDqgdKwrgSVVcKcvc3LYIhJ52TbtZY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCCdGrjy7KuM7ZUkTYqyb9JWlX2b66GreQs0F-Edtf9w&oe=6AFB4301"}, {"file_name": "05-welcome.png", "id": "28724710833860411", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654854429_28724710843860410_3493034806669136685_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFY8PndsSfEQ7kNvwExwBZI&_nc_oc=AdrwJ-PFP38-oXimgpOq1PgfTF-Wdsv8fRWvtySvoI9Bcp1eUZsbeUywGbryVsGPg9U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQv2JhYYFhZLp3oU3pnOE35Knu-9dVII3SOPfPhvu7BQ&oe=6AFB415B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LineBloom - Block Puzzle", "keywords": [], "long_description": "Make room for your next great move.\n\nLineBloom brings block puzzles into VR with a colorful board you can position comfortably in front of you. Pick up a piece, rotate it, and place it on the 8\u00d78 grid. Complete rows and columns to clear them\u2014and line up one clever placement to clear several at once.\n\n\u2022 Relax in Calm mode, with no timer.\n\u2022 Try Changing Pieces mode, where available pieces refresh every 10 seconds.\n\u2022 Choose from three pieces and find the best fit.\n\u2022 Build satisfying combos and beat your separate best score in each mode.\n\u2022 Enjoy frosted-glass pieces, a redesigned board and new record celebrations.\n\u2022 Learn the controls through a guided tutorial.\n\u2022 Play seated or standing using Touch controllers.\n\u2022 Adjust board height, distance and scale, sound, vibration and effects.\n\u2022 Continue an unfinished game with locally saved progress.\n\u2022 Choose English, Spanish, German, French, Japanese or Brazilian Portuguese text.\n\nA simple idea, a clear board, and plenty of room for a clever move.", "short_description": "Place colorful blocks, clear rows and columns, and discover satisfying combos in a hands-on VR puzzle. Rotate pieces, plan your next move, and keep your 8\u00d78 board open. Play seated or standing, with text in six languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://porfiadostudios.com/linebloom-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Porfiado", "support_website_url": null, "website_url": "https://porfiadostudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "de", "fr", "ja", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1340723522463356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595129854_4653467448131682_836066078290579154_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSAUISOw5vYQ7kNvwFfRiCw&_nc_oc=AdrhkmZCt-AksSSehfR53WlvBcgDcAGgZ97mPoHCX47wEZhnkeetzV
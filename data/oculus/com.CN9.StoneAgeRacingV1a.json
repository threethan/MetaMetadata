words": [], "long_description": "Stone Age Racing is a fast-paced, Indy-style timed circuit race that will challenge you physically and mentally! Designed in Oculus Quill and transformed into a full action first-person game, Stone Age Racing gives you an enhanced experience within a Quill world where you, the player, navigate and interact with the environment like never before. You are no longer just an observer but now a full participant, interacting and influencing the final outcome!", "short_description": "Stone Age Racing is a new Quill Interaction piece for the Oculus Quest and Quest2. Step into a Quill scene and interact with the environment around you like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ptmarks.com/", "developer_terms_of_service_url": null, "publisher_name": "CN9 Studios", "support_website_url": null, "website_url": "https://www.ptmarks.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "306413461515440"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4140195292686252", "version": "0.5"}, "id": "497705868253510", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fa
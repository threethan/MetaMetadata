e": "StoneAgeRacingCover2560x1440.png", "id": "5219572094780814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_5219572101447480_7627974677105482147_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pL2yWpPkW9oQ7kNvwFKB0mn&_nc_oc=AdoLRWC5EMhq0yJL_zyN8bKhE6o61aRWqfxYIqNczg4iSNXcufZvHZx-WEFIWSB9Di0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNAhffszU6XD-L_o0pE8UVNnJbHSRZWT9JRf6j6oxj3g&oe=6B0454AB"}, "display_name": "Quill Interactions: Stone Age Racing", "keywords": [], "long_description": "Stone Age Racing is a fast-paced, Indy-style timed circuit race that will challenge you physically and mentally! Designed in Oculus Quill and transformed into a full action first-person game, Stone Age Racing gives you an enhanced experience within a Quill world where you, the player, navigate and interact with the environment like never before. You are no longer just an observer but now a full participant, interacting and influencing the final outcome!", "short_description": "Stone Age Racing is a new Quill Interaction piece for the Oculus Quest and Quest2. Step into a Quill scene and interact with the environment around you like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ptmarks.com/", "developer_terms_of_service_url": null, "publisher_name": "CN9 Studios", "support_website_url": null, "website_url": "https://www.ptmarks.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
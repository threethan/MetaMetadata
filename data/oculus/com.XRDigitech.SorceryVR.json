.com/v/t64.5771-25/75254874_1503248243808957_3726511066061799638_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHUYzc0TFTMQ7kNvwGuua7q&_nc_oc=Adkx7cBlgg8FqfzyVgtVrwRsacyDEi9U627b37mEUm7BO0WCjaLiy7ywc32I3fsCmBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEdR9zoP1GKDDUKAPlUZxxe6hLCgtEjJsrvLB1Mvmx3Q&oe=69A0523E"}, "display_name": "The Last Sorcerer", "keywords": [], "long_description": "The Last Sorcerer is an immersive virtual reality (VR) game that offers players the unique experience of becoming a sorcerer with the ability to cast spells using hand gestures and movements. The game combines action, strategy, and magic in an interactive VR environment. Players must use their wits and magical prowess to battle waves of enemies and face formidable bosses to progress through the game.", "short_description": "Experience being a warrior mage in this sorcery virtual reality game. Learn to cast spells using hand gestures and hand movements to defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrdigitech.com/last-sorcerer-privacy-polic/home", "developer_terms_of_service_url": null, "publisher_name": "XRDigitech", "support_website_url": null, "website_url": "https://xrdigitech.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6282849655148897"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com
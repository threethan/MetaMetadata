=1-7&_nc_sid=6e7a0a&_nc_ohc=JWnpshBgz-gQ7kNvwEN0j1t&_nc_oc=AdoqaaBy_RXuf7So0TG9TKksSLXuwUCjC_54J9dhl3im1FY-Ea2Gt776JbHxuFbcgcw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3PV0JpTx-pL0RbCeA-N6sWrKpSJ5Z7yJgCbTVXY_fbQ&oe=6AFC9686"}, {"file_name": "New Hall SS.png", "id": "1303999717345135", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393511_1303999724011801_6631453841422078676_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSvFV4R0X_oQ7kNvwH87CA3&_nc_oc=AdokbLWwHswCUjwkBMyQhE50qO7CdlmaBNwkgp0O49a2IUzyln8GmOqHs-93DAreGOs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLgkdMa-gxxQq9xRws0RgwbefuFcx60TtH4R8aytMhfw&oe=6AFC7A5D"}, {"file_name": "Shop SS.png", "id": "1142392257640006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393328_1142392260973339_6454570734053647491_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzkZwxqkPqIQ7kNvwG17HLd&_nc_oc=Ado_lyDgRRcPbZKW9TUBZG4TfRpuJvllnl5JRzL6anL7THOYmjm7HziCZ-KG6XGWJNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu-poX28JEvBGb-uhedrDvqk6_6lYpkzuBNojNluyuFA&oe=6AFC637A"}, {"file_name": "Shop SS 2.png", "id": "667429935971382", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393841_667429939304715_1335998649294763984_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEy4do67J-YQ7kNvwGfpzUT&_nc_oc=Adp-iPnY_fRTFVSyNdt1d3_4mb67Bs-WaYawpBA1FewaXZlhMrCtgEt3kwu50Gvh03Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNFB0R76woDd6j_Z7QMUVH7wir3Jhy7OXeAqIciw9qvA&oe=6AFC7829"}, {"file_name": "Horror SS.png", "id": "1085414736955151", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391890_1085414740288484_5669983935756057491_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrWoRgVnzYMQ7kNvwHPOwFI&_nc_oc=AdoOKxHQQn45sadyC9pJdQzcKFgGBhivA8n6co5kX2ieIzMs1hfVshxbpwxKNGKLuA0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr_ZDGCvRQ8mOvRDne7KOo8CsTaCLBqRT6NBJsp79aJQ&oe=6AFC88AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spook", "keywords": ["Horror", "Monkey", "Scary", "Adrenaline", "Gorilla"], "long_description": "In this game you are a legless monkey playing in a dark and scary environment where you must carefully run through levels trying to complete an objective while also avoiding the monsters. This game offers many levels with more constantly being added to allow for a new and more entertaining experience every time you play. The game allows for players to interact with each other and play together in a kind and respectful way. The game is heavily moderated to make sure that everyone is being treated fairly and with respect. Players have the option of customizing their characters color, Name and Cosmetic items to appear different than the other players.", "short_description": "If you're looking for a fun and entertaining horror game that uses a locomotion system similar to the popular game Gorilla Tag, then this is the perfect game for you. Use your hands to traverse dark tunnels and cave systems while completing each level's unique objective to continue through the game. Socialize with random people in the many moderated servers or even join a private server with your friends. Download spook NOW!"}]}, "developer_name": "Chaise", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRePNtTTIKOpJ0agsPbdmudgWiYMGOPwC_u5F1Pna9oKMpPcGdXC7H7708tkC2x3fW94wzdEfkMXYW6/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vQ2GfZGpli0OaUAPYpdE6Tng93thwHDyUm9bzYFagMmxKfp82chpUIxIx5DAOzDvMHTIT_TeAKIRVXT/pub", "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/spook-web/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359
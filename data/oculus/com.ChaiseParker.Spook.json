=1-7&_nc_sid=6e7a0a&_nc_ohc=ckytNSqBb1sQ7kNvwEy8WZV&_nc_oc=AdopJUQOGxMN_qeoAfruCR4ZyYbKjKkAN-RUJfLAnfSaE9GuH4ekSGbGKPUMgCTx7OY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf749keEygzFuMqh-p5krvCiYpVOhnCd04WHpGgboL7A&oe=6AFF0146"}, {"file_name": "New Hall SS.png", "id": "1303999717345135", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393511_1303999724011801_6631453841422078676_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDAFogXxaaAQ7kNvwEl5ryJ&_nc_oc=AdohzXMJH7MmBry24lFawvFAl-J9H--Q2AzzGnvRciEBFJDIFe8bGeC4NiOtJT0uHJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoDPFWMj0jH4q52VDYK3dlHvFqN17Kfxg-xDfGHg3Vag&oe=6AFF1D5D"}, {"file_name": "Shop SS.png", "id": "1142392257640006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393328_1142392260973339_6454570734053647491_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR97-ouV41QQ7kNvwHZSyvc&_nc_oc=AdrZRBw8uRmw4yZgIHpPg1lihJY0WF0PzMDRWRaisEa4W8pp3OvE0cQ047AbiI2i3pA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-NVCsAG5Yx0c3X5IAffSOX-ZXI4UbmHXcr3aJhXT8VA&oe=6AFF067A"}, {"file_name": "Shop SS 2.png", "id": "667429935971382", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393841_667429939304715_1335998649294763984_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDzNAvFo8o8Q7kNvwEjb-On&_nc_oc=AdrCZZAypmYIjBaNtrSkORcGP8fL7TG_hMPHneJaw2r6XjrYzpvPfMLHna0QkMzayzE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2upe4A5zhb-3_-ct27tp4W22Q4iu1bzbgyNUYiV2DuQ&oe=6AFF1B29"}, {"file_name": "Horror SS.png", "id": "1085414736955151", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391890_1085414740288484_5669983935756057491_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfzp_ECoV4gQ7kNvwFrNdPg&_nc_oc=AdpEK-Gum_0uKsu7qUE_hY4r9OmFGS3OGp_MRjX7jGuhZVVIrB_k7gmFzzO_oIQqGMc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVKDWvbDcTdZq6q-afolMyv_cBcyezXqLLzCdd8VWAjg&oe=6AFF2BAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spook", "keywords": ["Horror", "Monkey", "Scary", "Adrenaline", "Gorilla"], "long_description": "In this game you are a legless monkey playing in a dark and scary environment where you must carefully run through levels trying to complete an objective while also avoiding the monsters. This game offers many levels with more constantly being added to allow for a new and more entertaining experience every time you play. The game allows for players to interact with each other and play together in a kind and respectful way. The game is heavily moderated to make sure that everyone is being treated fairly and with respect. Players have the option of customizing their characters color, Name and Cosmetic items to appear different than the other players.", "short_description": "If you're looking for a fun and entertaining horror game that uses a locomotion system similar to the popular game Gorilla Tag, then this is the perfect game for you. Use your hands to traverse dark tunnels and cave systems while completing each level's unique objective to continue through the game. Socialize with random people in the many moderated servers or even join a private server with your friends. Download spook NOW!"}]}, "developer_name": "Chaise", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRePNtTTIKOpJ0agsPbdmudgWiYMGOPwC_u5F1Pna9oKMpPcGdXC7H7708tkC2x3fW94wzdEfkMXYW6/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vQ2GfZGpli0OaUAPYpdE6Tng93thwHDyUm9bzYFagMmxKfp82chpUIxIx5DAOzDvMHTIT_TeAKIRVXT/pub", "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/spook-web/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359
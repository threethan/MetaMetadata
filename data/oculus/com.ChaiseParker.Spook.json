=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbdTIYtlC4vV_Yb5F_zhxG5tm8NEP4pF9KPgrvm4MIlA&oe=6B0B416D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spook", "keywords": ["Horror", "Monkey", "Scary", "Adrenaline", "Gorilla"], "long_description": "In this game you are a legless monkey playing in a dark and scary environment where you must carefully run through levels trying to complete an objective while also avoiding the monsters. This game offers many levels with more constantly being added to allow for a new and more entertaining experience every time you play. The game allows for players to interact with each other and play together in a kind and respectful way. The game is heavily moderated to make sure that everyone is being treated fairly and with respect. Players have the option of customizing their characters color, Name and Cosmetic items to appear different than the other players.", "short_description": "If you're looking for a fun and entertaining horror game that uses a locomotion system similar to the popular game Gorilla Tag, then this is the perfect game for you. Use your hands to traverse dark tunnels and cave systems while completing each level's unique objective to continue through the game. Socialize with random people in the many moderated servers or even join a private server with your friends. Download spook NOW!"}]}, "developer_name": "Chaise", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRePNtTTIKOpJ0agsPbdmudgWiYMGOPwC_u5F1Pna9oKMpPcGdXC7H7708tkC2x3fW94wzdEfkMXYW6/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vQ2GfZGpli0OaUAPYpdE6Tng93thwHDyUm9bzYFagMmxKfp82chpUIxIx5DAOzDvMHTIT_TeAKIRVXT/pub", "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/spook-web/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359
_ohc=ASN9NIDkMeIQ7kNvwE3-cMH&_nc_oc=AdqoJhlxlx2VXcpmTENguMxaSuCQnrBy_aFLuDs-KSyfUumx3Y1jVv08f11chB2UHNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRr5eALwnu_Pyv56Onu09mioQ9IOHwYY_XdwWR30QwzQ&oe=6AF5E80B"}, {"file_name": "Cybershot-Screenshot-5-Burst-Close-Up-2560x1440.png", "id": "1514672167510642", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673531334_1514672170843975_6403872223350844828_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yal95RNz-tgQ7kNvwFLTVS8&_nc_oc=AdpJvyOwhDnnTkUpMAz4xpW27L-hYSJlQrwFWinvU83m97pjQLqXCpRar898J45uxdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1PG_Gxgau_GuPy9zOsf3uOQz6qZLJ44uBSA2rUAqqFg&oe=6AF5BF9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "07_Trailer_Cover_2560x1440.png", "id": "1077016691806724", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_1077016695140057_8402714993150303156_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns1vo0sY0SYQ7kNvwEN5-BH&_nc_oc=AdqxFAMm-i_Ym4iLCnM3WBukzpCzqyhxu2LuDJAISvkGE7SRgGQ9bQNi3PjdiT3hGZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrEdWwvkgZJuF43C8Vfz8oe_CEA-BeTiZdv6UgIqYedA&oe=6AF5D3AE"}, "display_name": "Cybershot", "keywords": ["arcade", "cyberpunk", "slingshot"], "long_description": "Load a crystal. Draw your slingshot. Turn glass into a burst of color.\n\nStep onto a sky deck above a neon city and take on an arcade challenge built for VR. Match colored crystals to glass jars, break connected groups and stop the rising stacks from reaching the danger line.\n\nMAKE EVERY SHOT COUNT\nChoose your color, control your draw and release. Cracking glass, flying shards and splashing liquid bring every successful clear to life.\n\nPLAY FOR THE BIG CLEAR\nLarger groups mean bigger scores. Fuller jars need more matching hits, forcing you to balance quick clears against valuable targets as the conveyor keeps delivering.\n\nHANDLE THE UNEXPECTED\nRainbow jars unleash effects that can shift the pressure in an instant. Adapt your aim and strategy as the waves bring faster deliveries and tougher stacks.\n\nOWN YOUR NEXT RUN\nPush through escalating waves, chase your personal best and jump straight back in for another attempt. An original electronic soundtrack and a city alive with flying traffic and spectators surround the action.\n\nPull. Aim. Match. Shatter. How far can you go?", "short_description": "Pull back. Take aim. Make it shatter. Cybershot puts a futuristic slingshot in your hands and a rising wall of colored glass in your sights. Match colors, smash connected groups and keep the stacks below the danger line. With escalating waves, unpredictable rainbow jars and a neon city pulsing with electronic music, every run is a new shot at your personal best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.titlesunknownstudios.com/privacy-policy/cybershot/", "developer_terms_of_service_url": null, "publisher_name": "Title Unknown Studios", "support_website_url": null, "website_url": "https://www.titlesunknownstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1549573296938054"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1766521754624636"}, {"status": "PUBLISHED",
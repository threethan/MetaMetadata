s3cQ7kNvwHYk0VL&_nc_oc=Adqy8LwC5r7ydcjTmR1Ms1P9pBc7NjtKpi-tMJ8cBHmYAlWH5DxaO2S1A1msKIYj9lY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxY_CqcIi4sHFJb7duqIH6QO0pLLhgw1Kz-3ajiSD5xQ&oe=6A50F712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 2560-1440.png", "id": "1513520786384518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_1513520789717851_6571364788102252840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHZ176PM8bEQ7kNvwG_MEi9&_nc_oc=AdoMW7qIUNM_5clMh2DYFgym4fQgsF-5Zvw0270MXSir3ex3EHVKiv-WV6-IN_IJ2LE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzpvuYGAi8XBg_DRteujPj8Y_BMfevk8AIwWaSShYZDg&oe=6A50F6A8"}, "display_name": "The Wizard's Curse", "keywords": [], "long_description": "The Wizard\u2019s Curse is a fast, arcade style VR game about cleaning up a magical mistake.\n\nYou play as a young wizard stuck in a crowded alchemist lab. One wrong potion turns your quiet night into chaos when a cauldron starts spitting out small, fiery monsters. They look cute\u2026 until they rush straight at your face.\n\nUse your motion controllers as a wand to point, shoot, and dodge. Hit enemies before they reach you and watch them pop in bursts of light and sparks. Between waves, grab new potions and simple upgrades that change how your wand works, like faster shots or wider blasts.\n\nThe goal is easy to understand survive as long as you can, keep the lab from falling apart, and try to finally break the curse you created.\n", "short_description": "The Wizard\u2019s Curse is a VR wand shooter set in a messy alchemist lab. A failed spell wakes cute but deadly fire creatures, and you must blast them back into the cursed cauldron."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforela
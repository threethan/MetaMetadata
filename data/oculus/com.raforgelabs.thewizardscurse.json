5-2.oculuscdn.com/v/t64.5771-25/491825009_1231773528815635_8355418998649267951_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7VB8oIwJFwQ7kNvwGi-Xj0&_nc_oc=AdqdRmRfmCnvA-LlpPVbpYIcHXzk_xKIfP9AP8AdmwnUhFF8_naCVCj72JOhVBDD6co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI7hq3WKRzVvsb0IIlgpWhIZKw6LFOWnvsu_5ao08j-g&oe=6AFDB977"}, {"file_name": "Screen 6.png", "id": "840767278788988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_840767282122321_6512268954581009538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWlfIodruO4Q7kNvwFaT40q&_nc_oc=AdpjW48a9TI_WDkg_1-C4h0k5D2VG45Nu_acc6qXPjDWyDvQmKS0tLAbrvgJo4i463w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpOTc5FmGYK9f3w_95slQWCkZ6S5x1BEL9o0t4O4_33A&oe=6AFDE3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 2560-1440.png", "id": "1513520786384518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_1513520789717851_6571364788102252840_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBgHoSCu3ZEQ7kNvwH6rbO5&_nc_oc=AdoOj7gos-bWszEaNJq3qsYM4zTlhkB1S-2ujLGhzZS7Y1G7uQzdT842bsTRZkhxec8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRQAb-ghSoHa9yn63ckwSeXTG_leB98u4Cb3HbAJNWWA&oe=6AFDE368"}, "display_name": "The Wizard's Curse", "keywords": [], "long_description": "The Wizard\u2019s Curse is a fast, arcade style VR game about cleaning up a magical mistake.\n\nYou play as a young wizard stuck in a crowded alchemist lab. One wrong potion turns your quiet night into chaos when a cauldron starts spitting out small, fiery monsters. They look cute\u2026 until they rush straight at your face.\n\nUse your motion controllers as a wand to point, shoot, and dodge. Hit enemies before they reach you and watch them pop in bursts of light and sparks. Between waves, grab new potions and simple upgrades that change how your wand works, like faster shots or wider blasts.\n\nThe goal is easy to understand survive as long as you can, keep the lab from falling apart, and try to finally break the curse you created.\n", "short_description": "The Wizard\u2019s Curse is a VR wand shooter set in a messy alchemist lab. A failed spell wakes cute but deadly fire creatures, and you must blast them back into the cursed cauldron."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/thewizardscurse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25853768987562050"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2455361618260491"}, {"status": "PUBLISHED", "id": "25094739683556756"}, {"status": "PUBLISHED", "id": "1282707829885733"}, {"status": "PUBLISHED", "id": "1656385675357582"}, {"status": "PUBLISHED", "id": "1432065061831701"}, {"status": "PUBLISHED", "id": "1978831373015203"}, {"status": "PUBLISHED", "id": "1541151930500816"}]}, "baseline_offer": {"id": "1541151930500816"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "
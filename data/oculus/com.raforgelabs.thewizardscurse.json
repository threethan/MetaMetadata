3-2.oculuscdn.com/v/t64.5771-25/491825009_1231773528815635_8355418998649267951_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv9qFTxZRSMQ7kNvwEbFTq2&_nc_oc=AdpHvPWRh7XuAbWN3oOiOJnEYGiZLKPtLWq_K_vRRuR9fYPDfFAdLiqAqSd_PCeV-vA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQASA24CrINq1hMRsP_Vi8SwdoQZ78s6jRz1mMQ5JFmCA&oe=6AFB1677"}, {"file_name": "Screen 6.png", "id": "840767278788988", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_840767282122321_6512268954581009538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWlfIodruO4Q7kNvwE63-5z&_nc_oc=Adr4Mt_f_sIYj9S_Fl35-v6t3srD_A-DxMSb2j_5HT10DDFmqH8Hvtnh7K0IVrA9SGs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS13qeVqXHR1HI8Ii2hdGhqVVpHBix46T3ZBCgw4rCYA&oe=6AFB40D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 2560-1440.png", "id": "1513520786384518", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821725_1513520789717851_6571364788102252840_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlWHzXh2vhkQ7kNvwFNuYwK&_nc_oc=AdoIjyT7d0gKcxm1aU0qvYEnSdLeFUo7Hv0b3numT8IYWzLwl2vUlDzIKRtQKGfMQrE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiBKYSVEKeu8v5PD9WXWsLMH9M1M3WqfH95UlUmtiFkg&oe=6AFB4068"}, "display_name": "The Wizard's Curse", "keywords": [], "long_description": "The Wizard\u2019s Curse is a fast, arcade style VR game about cleaning up a magical mistake.\n\nYou play as a young wizard stuck in a crowded alchemist lab. One wrong potion turns your quiet night into chaos when a cauldron starts spitting out small, fiery monsters. They look cute\u2026 until they rush straight at your face.\n\nUse your motion controllers as a wand to point, shoot, and dodge. Hit enemies before they reach you and watch them pop in bursts of light and sparks. Between waves, grab new potions and simple upgrades that change how your wand works, like faster shots or wider blasts.\n\nThe goal is easy to understand survive as long as you can, keep the lab from falling apart, and try to finally break the curse you created.\n", "short_description": "The Wizard\u2019s Curse is a VR wand shooter set in a messy alchemist lab. A failed spell wakes cute but deadly fire creatures, and you must blast them back into the cursed cauldron."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/thewizardscurse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25853768987562050"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2455361618260491"}, {"status": "PUBLISHED", "id": "25094739683556756"}, {"status": "PUBLISHED", "id": "1282707829885733"}, {"status": "PUBLISHED", "id": "1656385675357582"}, {"status": "PUBLISHED", "id": "1432065061831701"}, {"status": "PUBLISHED", "id": "1978831373015203"}, {"status": "PUBLISHED", "id": "1541151930500816"}]}, "baseline_offer": {"id": "1541151930500816"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "
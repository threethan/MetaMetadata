fw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsh_EIECXqX1WE8ikTfMBFXivkSFtmWetlGXWris0iEg&oe=6B083EE6"}, {"file_name": "Screen 3.png", "id": "2131446827669499", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491821674_2131446831002832_8535870799844936173_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs7NZoA-3xsQ7kNvwGdIqvA&_nc_oc=Adp9uDb71Np00XwZWdR5FIFBs5BcIlaGzUlhe52t2G2ixCb0M5G_xiO2rDstd_Ed-w8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS39XLxfWThgYMFPcPP-Qvnw6pArapz4g_iNAjCjZQAXw&oe=6B085CE9"}, {"file_name": "Screen 4.png", "id": "1231773525482302", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825009_1231773528815635_8355418998649267951_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WkQpuFw0UUQ7kNvwFx43W_&_nc_oc=AdrIcAtwCJFApUOtvb0xYH67J9KXhoAtINBUqK3Ny2nMM6pgHNncBlhLpJwFbTDuYxI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJptxiGYlvshrTsiH8rHSarAHagiWHavTRbi8eZtk2xQ&oe=6B084577"}, {"file_name": "Screen 6.png", "id": "840767278788988", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823341_840767282122321_6512268954581009538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMB-ppZYEg0Q7kNvwEajxdM&_nc_oc=AdpPw8ttZFpVZUmus18g2iQwhiSRk3ufmXZwiDDl8e8TsAPvgTMQCgU_Q8rSs0g4QIM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAm2geh8lsC0s0y9OHaKNDTxt2G4_jEP5-cn3XP8RIAw&oe=6B086FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 2560-1440.png", "id": "1513520786384518", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821725_1513520789717851_6571364788102252840_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAl4xIOcuBYQ7kNvwEttGwd&_nc_oc=AdoKSbv5VyIFHRCZ-k-YdYfUaoJN5RK7Ifk7yxoDsQdMBtQHO-DHqAXQZsQRboDlKI4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH-yenVPb2Bmjvy3XS_lih6ICnhO--b2VpDWVjbWKY4w&oe=6B086F68"}, "display_name": "The Wizard's Curse", "keywords": [], "long_description": "The Wizard\u2019s Curse is a fast, arcade style VR game about cleaning up a magical mistake.\n\nYou play as a young wizard stuck in a crowded alchemist lab. One wrong potion turns your quiet night into chaos when a cauldron starts spitting out small, fiery monsters. They look cute\u2026 until they rush straight at your face.\n\nUse your motion controllers as a wand to point, shoot, and dodge. Hit enemies before they reach you and watch them pop in bursts of light and sparks. Between waves, grab new potions and simple upgrades that change how your wand works, like faster shots or wider blasts.\n\nThe goal is easy to understand survive as long as you can, keep the lab from falling apart, and try to finally break the curse you created.\n", "short_description": "The Wizard\u2019s Curse is a VR wand shooter set in a messy alchemist lab. A failed spell wakes cute but deadly fire creatures, and you must blast them back into the cursed cauldron."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/thewizardscurse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supporte
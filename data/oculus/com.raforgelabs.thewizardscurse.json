cYYQ7kNvwFdF_rI&_nc_oc=AdovP_P4kYym_HD73kUHGIcQF4qVN-nzEGuNXkB7adBvx1pcR33rInexJcBRwDg2paI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9Pu0bw78NbgVNySvAGhBXoZ8vk6a1BAjtML8t97KCEA&oe=6AE9E512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 2560-1440.png", "id": "1513520786384518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_1513520789717851_6571364788102252840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdcTzHfXMngQ7kNvwH91574&_nc_oc=AdqjKQjFVTxs1eYh15z9t4rejvceQETg53w6rJSGLEkkGXK91GXyXtHqKV8Ld_2JVTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX3FeS8SzY8ZJh5A5lL-HlhQMeYSjX6_6mrJwBmC8kXg&oe=6AE9E4A8"}, "display_name": "The Wizard's Curse", "keywords": [], "long_description": "The Wizard\u2019s Curse is a fast, arcade style VR game about cleaning up a magical mistake.\n\nYou play as a young wizard stuck in a crowded alchemist lab. One wrong potion turns your quiet night into chaos when a cauldron starts spitting out small, fiery monsters. They look cute\u2026 until they rush straight at your face.\n\nUse your motion controllers as a wand to point, shoot, and dodge. Hit enemies before they reach you and watch them pop in bursts of light and sparks. Between waves, grab new potions and simple upgrades that change how your wand works, like faster shots or wider blasts.\n\nThe goal is easy to understand survive as long as you can, keep the lab from falling apart, and try to finally break the curse you created.\n", "short_description": "The Wizard\u2019s Curse is a VR wand shooter set in a messy alchemist lab. A failed spell wakes cute but deadly fire creatures, and you must blast them back into the cursed cauldron."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforela
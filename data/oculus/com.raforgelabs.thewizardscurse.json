832_8535870799844936173_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjCIadiZq8YQ7kNvwH0ZpNE&_nc_oc=AdnK7ZCDP_pr6RsxSEo-gfFk0rgzup_MeLdbM05AQFOW309W4SVvAQanxX_QKWBqFzI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0VoOH9G8qPAzK38rpXWZYIMntMBqGsHc-gvA8bVRBaQ&oe=69BD3C29"}, {"file_name": "Screen 4.png", "id": "1231773525482302", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825009_1231773528815635_8355418998649267951_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjaNYLujvckQ7kNvwEYKC4z&_nc_oc=AdkEoj3LfLNBqscO_ZChiWQFrn6jWKjbFallwaxlISpvSv-zJ2teNVr7ZQ1EdVpAfOI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6M1thwBi8CCk6ZCPU0rjF19pCNph2iHo0TgGzpa1LOg&oe=69BD5CF7"}, {"file_name": "Screen 6.png", "id": "840767278788988", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823341_840767282122321_6512268954581009538_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kppO2J-qszgQ7kNvwGWUZv-&_nc_oc=Adk1G8_Rr0_oPN_Q8syXMX4UcqPJblHA1PwtfVnJJH6DaLMwg-q_avI3PRyQXe1Qf_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvYXU8NJ1F2lxAlu7IQnCMNIkpEuYVGO5gqFdWz8elzQ&oe=69BD4F12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 2560-1440.png", "id": "1513520786384518", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821725_1513520789717851_6571364788102252840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ijrG3pFASUQ7kNvwF8vsfu&_nc_oc=AdlAzQyuSVZRsODpatrRW4GODllT8QxmIEnUbzIY4m4xalcrrEGTw9A5fI_4NINUwEY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvIEVsoNcbN4IDM_Grh40K2LiAZ5fVzlavSpHEwSuYdg&oe=69BD4EA8"}, "display_name": "The Wizard's Curse", "keywords": [], "long_description": "The Wizard\u2019s Curse is a fast, arcade style VR game about cleaning up a magical mistake.\n\nYou play as a young wizard stuck in a crowded alchemist lab. One wrong potion turns your quiet night into chaos when a cauldron starts spitting out small, fiery monsters. They look cute\u2026 until they rush straight at your face.\n\nUse your motion controllers as a wand to point, shoot, and dodge. Hit enemies before they reach you and watch them pop in bursts of light and sparks. Between waves, grab new potions and simple upgrades that change how your wand works, like faster shots or wider blasts.\n\nThe goal is easy to understand survive as long as you can, keep the lab from falling apart, and try to finally break the curse you created.\n", "short_description": "The Wizard\u2019s Curse is a VR wand shooter set in a messy alchemist lab. A failed spell wakes cute but deadly fire creatures, and you must blast them back into the cursed cauldron."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/thewizardscurse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25853768987562050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_853931500753033_482878136809421717_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7eyGhYDV2wQ7kNvwHRhH7X&_nc_oc=AdllukVtjSL
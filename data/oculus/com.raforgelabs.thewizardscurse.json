jc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9HbaLQVLHAuLu7mbtBhrnlUQwC1kNfZ5ZLjNgNvrAzw&oe=6B033126"}, {"file_name": "Screen 3.png", "id": "2131446827669499", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821674_2131446831002832_8535870799844936173_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuBauZZd9zgQ7kNvwHDrVa1&_nc_oc=AdqwhuGikqYPCe1pPFao0k5MM98mJ-3u_mGCqUk3WA8waknr3VWwEQ8Z4Z9kT4Zk_E0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXkNa2rwIXAXikTkUOe_S-jNyBr-CWO29wiIHBGbCYfg&oe=6B0316E9"}, {"file_name": "Screen 4.png", "id": "1231773525482302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825009_1231773528815635_8355418998649267951_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub8QMKOL_PkQ7kNvwEhFJmP&_nc_oc=AdpgefyVvP7pVynKwuGzR3jpvlcDpHu9UvdR1q4CuRd4B6_98YrlY5LV4ITYQUB8W38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxnQ-eeOzsVrGSdpuHaah7UGFoEzZnZCa99lAGnTJpoQ&oe=6B0337B7"}, {"file_name": "Screen 6.png", "id": "840767278788988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_840767282122321_6512268954581009538_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zYTPV1dYvMQ7kNvwFDvOlO&_nc_oc=AdrKbKwZbbQYjMlWfqbKSJAq-sImJY_PMAYI6IDkGWLucaIMPMwHvUYspnvZCFrTIus&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUpbp7W5Z07sP5P0duwJuFkgg62XoKQmX3PoycgKNvmA&oe=6B0329D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover 2560-1440.png", "id": "1513520786384518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_1513520789717851_6571364788102252840_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jE_gZEXfQUQ7kNvwF8VkSZ&_nc_oc=AdrTrnrp3Cez-sqIV_WuJMDNYdAGNMBzhsOruwDSK9mQokmmcwdAEbiwAZgiGqC5tF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYipWN1_v1yjD2FGHBAntn2R7G2XSpAdL4HoNG8AY_8g&oe=6B032968"}, "display_name": "The Wizard's Curse", "keywords": [], "long_description": "The Wizard\u2019s Curse is a fast, arcade style VR game about cleaning up a magical mistake.\n\nYou play as a young wizard stuck in a crowded alchemist lab. One wrong potion turns your quiet night into chaos when a cauldron starts spitting out small, fiery monsters. They look cute\u2026 until they rush straight at your face.\n\nUse your motion controllers as a wand to point, shoot, and dodge. Hit enemies before they reach you and watch them pop in bursts of light and sparks. Between waves, grab new potions and simple upgrades that change how your wand works, like faster shots or wider blasts.\n\nThe goal is easy to understand survive as long as you can, keep the lab from falling apart, and try to finally break the curse you created.\n", "short_description": "The Wizard\u2019s Curse is a VR wand shooter set in a messy alchemist lab. A failed spell wakes cute but deadly fire creatures, and you must blast them back into the cursed cauldron."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/thewizardscurse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supporte
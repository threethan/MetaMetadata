2269512850256834_1769328154809266172_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_HHfmTWV24Q7kNvwFunYuD&_nc_oc=Adp8gHsWBN3OqDG-42mcgkwMRvguBZp-mGBlljSIpnfi0TdF5V4_dlPa8BthQny_tfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Bw_l4TgKOGAfjkOnriREGKVwvOcrHktjn8YljnqTdw&oe=6B047DEB"}, {"file_name": "skeletal_7.png", "id": "2720651361642050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623400_2720651364975383_4733049884323465390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdV3aPmHOm4Q7kNvwEvgB4b&_nc_oc=AdoiwdSGLNC9jyKo1CMzxacghhzbM6wypzeJnS7ttL5_0-41pohcTPPfJjY3P5vJQx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0AangFSbPEeRW8OA6qfFes70u5-R3EPkSVtOzPWNS7A&oe=6B046371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1694126515190958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_1694126518524291_919285341225067272_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVmNfPwNgDUQ7kNvwFmajO9&_nc_oc=Adp0OuRE_PvGabWzT4tdjKtTY1_eGJ8iFa66d6ES0c8Y_bwH7eC48J6XbMzdQGziA34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt1sYF6nt8FiN7yj3cG-fLqNnu7B5dc_UoNSUdnoRf-Q&oe=6B048303"}, "display_name": "Anatomy Learning Labs: Skeletal Lab", "keywords": [], "long_description": "Step into the Skeletal Lab of the Anatomy Learning Labs series, where the framework of the human body comes to life in stunning 3D. Featuring anatomically accurate models developed by medical professionals and learning activities designed by professors, the Skeletal Lab teaches elementary, middle, and high school learners how bones support movement, protect vital organs, and work together as a complete system.\n\nThis app leverages the Quest's audio, visual, and hand-tracking capabilities to deliver truly multimodal and active learning experiences. Students learn by seeing anatomy in 3D, hearing explanations, interacting with structures using their own hands, and developing spatial reasoning skills through guided activities.\n\n\u2022\tTravel through medical imaging views that reveal the human skeleton, similar to a CT scanner\n\n\u2022\tSelect any structure to hear Dr. Hana Sato, your virtual guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to grab, rotate, and closely inspect objects. Examine the structure of the compact and spongy bone tissues, and discover how the bone marrow is protected inside bones. \n\n\u2022\tStep into Mini Mode to shrink down and observe blood cells produced in the bone marrow.\n\n\u2022\tAssemble the full human skeleton in a guided 3D puzzle. \n\n\u2022\tTest your knowledge through audio-guided quizzes led by Dr. Sato.\n\n\u2022\t Put your skills to the test in a fast-paced Knowledge Knockout challenge, where you must quickly punch the correct skeletal structures under time pressure.", "short_description": "Step into an immersive VR skeletal system laboratory and explore the framework of the human body in stunning 3D. Travel through medical imaging views, examine bones from every angle using natural hand-tracking, and hear Dr. Hana Sato identify anatomical structures by name. Assemble the human skeleton in interactive 3D puzzles, test your knowledge with quizzes, and reinforce learning through fast-paced challenges designed to make anatomy engaging, memorable, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}
ZY_sC_WkSZr_8ZEL6NCpzK8WsPNe0WFP3u5ZWIL3qtbCm7LW52cB2c-0Szw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXizGUMkQt6WeELsPrabLWb-6VWaIS9vM_drl_V-pgJA&oe=6A60B036"}, {"file_name": "skeletal_8.png", "id": "2890883497934097", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623443_2890883501267430_2512423248509421846_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8keUZRh_6UQ7kNvwFWfTSz&_nc_oc=Adr2OkTSjBEYDo9mvr0QsvCoEDKt1A0GWL3OLWWTuDvYx5oDHHWSw4A9rNW1ubMKQX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ-ZAmKLbp0bv3uUDUQVEOSfJL-vHOprDFgF9yKeH3NQ&oe=6A60C990"}, {"file_name": "manager_skeletal_home.png", "id": "2269512843590168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620860_2269512850256834_1769328154809266172_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3M25ww9WAQQ7kNvwHAZaJm&_nc_oc=AdokP5yAhk7LoAqoLmT6ou3q1ESIugeoPd3Mw6iWerVR2SDwiMPZtLCqkBW0HxL0T70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk9CMvl59U9FPN1Fvt02q8VAV5p1pHh0flxcCgyQIv8Q&oe=6A60CBAB"}, {"file_name": "skeletal_7.png", "id": "2720651361642050", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623400_2720651364975383_4733049884323465390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-Goao0-vOQQ7kNvwF2iR4t&_nc_oc=AdoBjbo4BSHXnoCCJwoG5BWRLamyA_C14FSynrsePb_3Ropdhgr9l2gU0JTrW44qJLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJP1JxRIpSJRVd7hv8TAXmSoJ2Ur3gGWkjQ7xYqCAdmA&oe=6A60B131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1694126515190958", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622325_1694126518524291_919285341225067272_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xm3ElKLFrDIQ7kNvwGMz9d9&_nc_oc=Adp4uNUofXfhclrNfBLu_VjUGcrF4QEKLUEbHuiEZmEXB3HVfll0r42Bt9YO7OkAi1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQdeXk5YPZv9PDcjarOK_xsKWAcrYZ84Z4KGsbwQ6O5w&oe=6A60D0C3"}, "display_name": "Anatomy Learning Labs: Skeletal Lab", "keywords": [], "long_description": "Step into the Skeletal Lab of the Anatomy Learning Labs series, where the framework of the human body comes to life in stunning 3D. Featuring anatomically accurate models developed by medical professionals and learning activities designed by professors, the Skeletal Lab teaches elementary, middle, and high school learners how bones support movement, protect vital organs, and work together as a complete system.\n\nThis app leverages the Quest's audio, visual, and hand-tracking capabilities to deliver truly multimodal and active learning experiences. Students learn by seeing anatomy in 3D, hearing explanations, interacting with structures using their own hands, and developing spatial reasoning skills through guided activities.\n\n\u2022\tTravel through medical imaging views that reveal the human skeleton, similar to a CT scanner\n\n\u2022\tSelect any structure to hear Dr. Hana Sato, your virtual guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to grab, rotate, and closely inspect objects. Examine the structure of the compact and spongy bone tissues, and discover how the bone marrow is protected inside bones. \n\n\u2022\tStep into Mini Mode to shrink down and observe blood cells produced in the bone marrow.\n\n\u2022\tAssemble the full human skeleton in a guided 3D puzzle. \n\n\u2022\tTest your knowledge through audio-guided quizzes led by Dr. Sato.\n\n\u2022\t Put your skills to the test in a fast-paced Knowledge Knockout challenge, where you must quickly punch the correct skeletal structures under time pressure.", "short_description": "Step into an immersive VR skeletal system laboratory and explore the framework of the human body in stunning 3D. Travel through medical imaging views, examine bones from every angle using natural hand-tracking, and hear Dr. Hana Sato identify anatomical structures by name. Assemble the human skeleton in interactive 3D puzzles, test your knowledge with quizzes, and reinforce learning through fast-paced challenges designed to make anatomy engaging, memorable, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1201623996368027"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499294711_35831650893146046_6949009334050027397_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0V79isu6uYQ7kNvwHtBxRB&_nc_oc=AdqjJzFBMqGm9pT_zHt6avooC2lj6etuyEjtQgDoVxNEfY_0EgrXekuCGEV-XpoTia0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb1DeW1smTy8siAwVUu8029-NCwyGR-6W6mCsyW3BuPw&oe=6A60CCEC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Anatomy Learning Labs: Skeletal Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "104
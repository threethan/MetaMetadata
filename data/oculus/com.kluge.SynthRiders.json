uluscdn.com&_nc_ss=8&oh=00_AfwFTuw0AUvbQW4yiajUiKw8k3ylSHVFOCJD00k6AYt1aQ&oe=69B6ABE3"}, {"file_name": "migrated_image.png", "id": "327933284831942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031647_417935015578012_2400822427098546176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oZVkwkXSu0Q7kNvwESDDHP&_nc_oc=AdkLQLS5S4GZouBeRtKPdTbvMofKMMsqJaxoqWalGggPtYU2svFeW6RMslrCtnhlkZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxo2d9EKwt9GGEbb8sYbVKqBPy1JCZVgcKu9jMfG7moMg&oe=69B6A73E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/szSSdM", "id": "2395015640772174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982637_2395015644105507_1151433955568779264_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt4jJopds_EQ7kNvwFfwkwe&_nc_oc=AdmMUJycKHkpYC60VknvYTInrW3Vry4brpNADp1vEvnaVx8t3D7pUIP7YB2HwSuNE0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwqp7Ao_3kaT4-MHIcfKdQMaIeo8BZySpW2X4R5AUCxGg&oe=69B68FB4"}, "display_name": "Synth Riders", "keywords": ["music", "rhythm", "beat", "audio", "fitness"], "long_description": "Synth Riders is a game about experiencing incredible music in a whole new way. You\u2019ll feel it as your arms soar when riding our unique rail system and instantly know you\u2019re in the music.\n\nFrom the diverse environments, lighting, the carefully crafted beat maps, the catchy rhythms and melodies, the way the notes flow, how notes and obstacles make your body move, the way the haptics feel, and so many other tiny details from the love put into this game. \n\nSynth Riders absolutely loads your senses for an experience that\u2019s truly unique, unforgettable and simply a blast to play.\n\n- 21 top songs and new top artists added regularly\n- World leaderboards taking advantage of Quest\u2019s brand new social features and includes cross-platform support\n- Different modes that keep the game fresh, including force mode for harder workouts and challenges\n- An active community supporting and creating infinite forms of gameplay\n- Multiplayer coming soon", "short_description": "Synth Riders is a game about experiencing incredible music in a whole new way. You\u2019ll feel it as your arms soar when riding our unique rail system and instantly know you\u2019re in the music.\n\nFrom the diverse environments, lighting, the carefully crafted beat maps, the catchy rhythms and melodies, the way the notes flow, how notes and obstacles make your body move, the way the haptics feel, and so many other tiny details from the love put into this game."}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.synthridersvr.com/", "publisher_name": "Kluge Interactive", "support_website_url": "https://www.synthridersvr.com/contact", "website_url": "https://www.synthridersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2138383172983119"}}]}, "scheduled_offers": {"count": 76, "nodes": [{"status": "PUBLISHED", "id": "805300789238459"}, {"status": "PUBLISHED", "id": "915468030905915"}, {"status": "PUBLISHED", "id": "2405138529901155"}, {"status": "PUBLISHED", "id": "3828191104140940"}, {"status": "PUBLISHED", "id": "786592430399587"}, {"status": "PUBLISHED", "id": "1467258824297948"}, {"status": "CANCELLED", "id": "1209367857613832"}, {
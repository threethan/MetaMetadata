VwV_q8pnc3yK6uQohSHvry2hkhX4aqbjh8iGiNYW7jSgwkAaUqGvrVfK1M7s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNIJDJsqop95Mqh4hj_f4imbBYmhDEQ-FYfCbwuW3ZiA&oe=6AF0A923"}, {"file_name": "migrated_image.png", "id": "327933284831942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031647_417935015578012_2400822427098546176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0P7bVqrIkCIQ7kNvwGxKWCV&_nc_oc=AdoIIw6Sf7one1qsgdu7MqwweKepEwaqI-IPOV_vxe4w4oxhsua6-pU0-TIkbtSFmno&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSoeQv8UdgL21R-CLNp3JdTbro6yNK2sptZPdTk9U9Dw&oe=6AF0A47E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/szSSdM", "id": "2395015640772174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982637_2395015644105507_1151433955568779264_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzzPZl1gyOkQ7kNvwFR05Yp&_nc_oc=AdrlMCRBMFMQJ7ty8RW7tfRJkLkN8LQR33DXVMIvMQOCPi8eSb8ZNIdpfOLzRGS2Jmk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpH5NaskFyE8DURqHzox9aU5DF6Nel15s2fl_aRDAMJw&oe=6AF08CF4"}, "display_name": "Synth Riders", "keywords": ["music", "rhythm", "beat", "audio", "fitness"], "long_description": "Synth Riders is a game about experiencing incredible music in a whole new way. You\u2019ll feel it as your arms soar when riding our unique rail system and instantly know you\u2019re in the music.\n\nFrom the diverse environments, lighting, the carefully crafted beat maps, the catchy rhythms and melodies, the way the notes flow, how notes and obstacles make your body move, the way the haptics feel, and so many other tiny details from the love put into this game. \n\nSynth Riders absolutely loads your senses for an experience that\u2019s truly unique, unforgettable and simply a blast to play.\n\n- 21 top songs and new top artists added regularly\n- World leaderboards taking advantage of Quest\u2019s brand new social features and includes cross-platform support\n- Different modes that keep the game fresh, including force mode for harder workouts and challenges\n- An active community supporting and creating infinite forms of gameplay\n- Multiplayer coming soon", "short_description": "Synth Riders is a game about experiencing incredible music in a whole new way. You\u2019ll feel it as your arms soar when riding our unique rail system and instantly know you\u2019re in the music.\n\nFrom the diverse environments, lighting, the carefully crafted beat maps, the catchy rhythms and melodies, the way the notes flow, how notes and obstacles make your body move, the way the haptics feel, and so many other tiny details from the love put into this game."}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.synthridersvr.com/", "publisher_name": "Kluge Interactive", "support_website_url": "https://www.synthridersvr.com/contact", "website_url": "https://www.synthridersvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2138383172983119"}}]}, "scheduled_offers": {"count": 82, "nodes": [{"status": "PUBLISHED", "id": "1612999350323124"}, {"status": "PUBLISHED", "id": "1082167124152751"}, {"status": "CANCELLED", "id": "1426993965968148"}, {"status": "PUBLISHED", "id": "1527857025795623"}, {"status": "PUBLISHED", "id": "1636909917426
nail": null, "display_name": "KORG Gadget VR", "keywords": [], "long_description": "\u4e16\u754c\u7684\u306b\u6709\u540d\u306a\u96fb\u5b50\u697d\u5668\u30e1\u30fc\u30ab\u30fc\u682a\u5f0f\u4f1a\u793e\u30b3\u30eb\u30b0\u304c\u30d7\u30ed\u30c7\u30e5\u30fc\u30b9\u3057\u305f\u3001\u6570\u3005\u306e\u30a2\u30ef\u30fc\u30c9\u3092\u53d7\u8cde\u3057\u305f\u97f3\u697d\u5236\u4f5c\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2 KORG Gadget \u304c\u3001\u3064\u3044\u306b Meta Quest\u306b\u767b\u5834\uff01\n\n\u53b3\u9078\u3055\u308c\u305f\u4eca\u306e\u97f3\u304c\u5f97\u610f\u306a\u30b7\u30f3\u30bb\u30b5\u30a4\u30b6\u30fc\u3068\u30c9\u30e9\u30e0\u30de\u30b7\u30f3\u3084\u3001\u30b7\u30f3\u30d7\u30eb\u3067\u4f7f\u3044\u3084\u3059\u3044\u30e6\u30fc\u30b6\u30fc\u30fb\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u3067\u672c\u683c\u7684\u304b\u3064\u30b9\u30d4\u30fc\u30c7\u30a3\u306a\u97f3\u697d\u5236\u4f5c\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002\u307e\u305fVR\u7a7a\u9593\u306e\u5f37\u70c8\u306a\u6ca1\u5165\u611f\u304c\u3042\u306a\u305f\u306e\u5275\u9020\u6027\u3092\u3088\u308a\u9ad8\u3081\u307e\u3059\uff01\n\n\u30e2\u30fc\u30b7\u30e7\u30f3\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u52d5\u304b\u3059\u64cd\u4f5c\u3082\u8efd\u5feb\u306a\u3001\u65b0\u611f\u899a\u97f3\u697d\u5236\u4f5c\u30b9\u30bf\u30b8\u30aa\u3067\u3059\u3002", "short_description": "Make Music in VR !\nVR\u7a7a\u9593\u3067\u697d\u3057\u3081\u308b\u672c\u683c\u7684\u306a\u97f3\u697d\u5236\u4f5c\u30b9\u30bf\u30b8\u30aa\uff01\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.detune.co.jp/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "DETUNE", "support_website_url": null, "website_url": "https://www.detune.co.jp/KORG_Gadget_VR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subs
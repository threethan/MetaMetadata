c_ss=7f20f&oh=00_AQL4dt_IkEAzs1G_F3inQACMhPLc-pc8Li5oM3IEjmoh_w&oe=6AB92147"}, {"file_name": "Screen4.png", "id": "2322065164939673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_2322065168273006_2212221385798120533_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_GBoiiFBvwQ7kNvwEvIN2H&_nc_oc=Adq4ZFixRqY6Eqgiqh28W5CNSD14K5WMj7kh3jsfkBpD0KGrTzsLzBqmPxGKCK2_0pQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjA4u7ooedkLWYXNVMdh16AgYFDzgjRPb001yPNj5Qig&oe=6AB931E0"}, {"file_name": "Screen1.png", "id": "1419236489944712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_1419236496611378_2765658048111213557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Qgf9su9sUcQ7kNvwFJeEao&_nc_oc=AdqxHBFgLFap2e6JNf6_h7JQBk2rPJiFPmI3WgnaW-PNHP93_Z926aol577O-Gsxqtk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiHUwdVy9r7DAO1HGIoe7qSk8sdYlcMMYAT6w1TFcBxw&oe=6AB92D97"}, {"file_name": "Screen5.png", "id": "1566373754595480", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_1566373757928813_9153847755977883452_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=304hENc1pWcQ7kNvwGAlrDG&_nc_oc=AdpBy7H2P3B_kHEQ7JsJB2FNWk6uLGCIR1zfb5g5_6nXeVQBrJB9PsSw5QuygeRIDbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIATVNO2kFV_4qxsNI1u0-kMJAjWpWp5E1xyXN04yzsFQ&oe=6AB937EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "937062729140924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312263_937062732474257_7617791955119948558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPT9tY8S3tEQ7kNvwEME3Cj&_nc_oc=AdoXgZnWbvgEfFpm95B1Pz4-FNjJ6uTc0k5jA2nQsI_LJmHP8lSoWI0FnfJIjamfRaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWr8G29BMkMmzUkCxZtolsHxZSO5HM3X2YmmnIwbHvbA&oe=6AB92451"}, "display_name": "VR Walk the Plank \u2013 Between the Towers", "keywords": ["Acrophobia", "FearofHeights", "Walk", "PlankExperience", "Plank"], "long_description": "# Walk the Plank\n\n**This is not a sit-down VR show. This is real movement. Real balance. Real fear.**\n\nStep between the towers of a majestic cathedral and look down upon a real German cityscape. No buttons. No joystick movement. No teleporting. Just you, your real steps and the drop beneath you.\n\n\n{2447914899025990}\n\n# Eight Ways to Face the Height\n\nChoose your challenge before every walk:\n\n- Standard Plank\n- Stone Slabs\n- Glass Panels\n- Metal Grating\n- Narrow Plank\n- Square Beam\n- Double Metal Bars\n- Thick Iron Pipe\n\nEach surface creates a different test of balance, courage and concentration. Start with the classic plank, then push yourself further across glass, stone, narrow wood or exposed metal.\n\n## Your Body Believes the Height\n\nWithin seconds, the view can trigger a powerful physical reaction. Your legs hesitate, your balance changes and every step suddenly matters. Can you keep moving when every instinct tells you to stop?\n\nThis is truly physical VR: instead of steering an avatar, you move through the experience yourself. The towering architecture, skyline and changing surfaces create a challenge that feels immediate, personal and surprisingly convincing.\n\n## Made to Be Shared\n\nWalk the Plank turns any gathering into an unforgettable VR challenge. Invite friends, compare reactions, capture the moment and discover who dares to go furthest.\n\n**Choose your path. Take the first step. Face the height.**\n\nUse only in a clear play area. A second person should remain nearby.\n\n#VRtravelX", "short_description": "Photorealistic, not artificial \u2013 the fear of heights alone is so intense, nothing else is needed. No mission, no challenge \u2013 just pure vertigo. This is not a game \u2013 it\u2019s a psychological test. Walk the plank with your own feet, 50 meters above the ground - Between two cathedral towers in Germany. No buttons. No controller. No teleporting. You walk \u2013 for real. More than 16,000 people have already taken that step. Face your fear. Share reactions. Create memories. \nNow it\u2019s your turn. \n\n#plank"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/FightThePlank/PrivacyPolicy", "developer_terms_of_service_url": "https://www.vrtravelx.net/home/FightThePlank/Terms", "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/home/FightThePlank", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27922086554109606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819859_1562765274984702_7154297597504425583_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuaOlJV1d1kQ7kNvwHQltHH&_nc_oc=Adqwl3Y1CrhFiWLID1WPJ9kDcl7uzGYaml0aWTCdCSxJDkDS0OycVqv0Disxd2lnhds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0qDOdAvOcu0XghXWcwZQgC5jI2u5zMtfOuCuU1Dd3mw&oe=6AB93368"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Walk the Plank \u2013 Between the Towers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1701729009, "lastRevision": {"nodes": [{"id": "688
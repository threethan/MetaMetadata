_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rruk_lqlc0Q7kNvwFJArPo&_nc_oc=AdqywmM6kP3lLt8xl7ashnEKkBudfZ4-VR92z_2AwUig2ab6TztJVVc1pAsrEK8k8_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCEbRjIQyvAefy2R1Cc-LtUKw-Ra4kcSN9oD-A8f_WBQ&oe=6AEA0A4F"}, {"file_name": "s2.png", "id": "720317432976877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035434_720317436310210_5732806501703499256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKQ4Fzif4TwQ7kNvwGZ4Tqb&_nc_oc=AdoraEh4AQvjKikh70etn2NIqqZ7BSq8SNZPU9ThtWn4-8ExvLZSpOzfl90y5IoMm8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqgWFlWq7P1oJLGXb91BWC18Su2YdTOQepSD0nWafYuw&oe=6AEA1046"}, {"file_name": "s3.png", "id": "747493860757262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297582_747493864090595_1851039702839981421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJIyDzJS26IQ7kNvwG5vx7c&_nc_oc=AdpDnvx0w9QEzQ_sNdRiLNR5jG1jzB3QU5ypqSUZxvyP_BZp9iB8MosMF_UiQzeageI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGF3a6lqVAKh8f6acHbJMrHpfayFd5kBrCAzVjpMuSrw&oe=6AEA05A4"}, {"file_name": "s4.png", "id": "900878714346783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_900878721013449_7160948324623610026_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82E4jj2Ey4oQ7kNvwFn_Hu3&_nc_oc=AdobkIVyOKigHKkWCNxIGVv_IceJiq384WrxB-dcLbRJIBNck0hGp8SY5CIVPUes96I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWajGZ3hO0XtKzT3ydTNVcPdPUnPMTf2Xb125HKXXpSw&oe=6AE9EF7C"}, {"file_name": "s5.png", "id": "1285746338778468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982548_1285746342111801_1529907829496149123_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT-5WGEiFA0Q7kNvwEPKJxA&_nc_oc=AdpavCoqVjprWadOGF0YdIw90RxRXZ4fr3P8jN5JvyAKsVeK8TP-D-TJABgtofbknOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgNWUqhb3x1Z0wrTFN4N0KKWC10e51MA2nKmPtd4QDeA&oe=6AE9FD50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fight The Plank  Between the Towers", "keywords": [], "long_description": "Prepare to embark on a jaw-dropping journey with #FightThePlank where in just 2 seconds, you'll experience something utterly incredible. It's a ride like no other, where your body reacts in ways you'd never expect. It may sound unbelievable, but it's true.\n\nIt is not just another VR app; it's a revelation that takes you to unimaginable heights. Suspended between the towering spires of a majestic cathedral in a real-existing German cityscape, you'll confront your fear of heights like never before. This app offers a truly unique challenge, setting it apart from the rest.\n\nWhat truly sets #FightThePlank apart is its power to bring people together. It's more than a personal journey; it's a shared adventure that sparks wonder and curiosity in others. It's not just a game; it's an experience meant to be enjoyed with friends and acquaintances.\n\nPerfect for social gatherings and events, #FightThePlank ignites interest and encourages group participation. Challenge yourself, prove your bravery, and relish the 'God Eye View' from the cathedral's pinnacle with breathtaking panoramic vistas.\n\nThe social dynamics of #FightThePlank are undeniable. Users are not only eager to share their adventures but also motivated to introduce others to this thrilling experience.\n\nShare the joy with your friends and show their reactions. Capture these moments on film and spread the excitement on social media using #FightThePlank. It's not just an idea; it's a reality waiting to be explored!", "short_description": "Share Heart-Pounding VR Heights Over a Real German City! Stand on the virtual plank suspended between the two towers of a cathedral, and behold the stunning panoramic views of the city below on a beautiful sunny day! Balance on the Edge at a Cathedral\u2019s Towers, Inspire Friends, and #FightThePlank Together. Join the Thrill! Experience the Thrill, Share the Adventure: Conquer Heights in VR and Amaze Your Friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/FightThePlank/PrivacyPolicy", "developer_terms_of_service_url": "https://www.vrtravelx.net/home/FightThePlank/Terms", "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/home/FightThePlank", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6886477631430471"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1085874150584197"}, {"status": "PUBLISHED", "id": "1688511322448184"}, {"status": "PUBLISHED", "id": "1563021025410434"}, {"status": "PUBLISHED", "id": "1038491298860186"}, {"status": "PUBLISHED", "id": "1302703868708509"}, {"status": "PUBLISHED", "id": "1254138662766228"}, {"status": "PUBLISHED", "id": "908414515465348"}, {"status": "PUBLISHED", "id": "1602341300902350"}, {"status": "PUBLISHED", "id": "2353107575143541"}, {"status": "PUBLISHED", "id": "849167517771338"}, {"status": "PUBLISHED", "id": "1779734070088381"}, {"status": "PUBLISHED", "id": "1096676562399267"}, {"status": "PUBLISHED", "id": "1255482839484073"}, {"status": "PUBLISHED", "id": "933612422005152"}, {"status": "PUBLISHED", "id": "617530410732406"}, {"status": "PUBLISHED", "id": "1784010249013444"}, {"status": "PUBLISHED", "id": "695248419366341"}]}, "baseline_offer": {"id": "695248419366341"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1085874150584197"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28517020964616159", "version": "2.3"}, "id": "735923211725727", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28517020964616159"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": "MORE POLISH FOR THE NEW EXPERIENCE!\r\nWe\u2019ve made additional refinements to the latest Step Off the Plank experience for an even smoother and more consistent adventure between the towers.\r\nStep off the plank, glide down to the cathedral roof, ride the platform back up \u2014 and do it all over again.\r\nMore height. More courage. More adrenaline.", "created_date": 1790570109, "id": "28517020964616159", "version": "2.3", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28517020964616159"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": "\"NEW: STEP OFF THE PLANK!\r\nStep into the void and glide down toward the cathedral roof. A platform catches you below, lifts you all the way back up, and lets you do it again \u2014 as many times as you want.\r\nAnd now there\u2019s even more to conquer between the towers: try the different walking elements, from narrow wooden planks and beams to stone slabs, glass panels, metal grates, double rods, and more.\r\nFace the height. Choose your path. Step off when you're ready.\"", "created_date": 1790335976, "id": "28484676424517280", "version": "2.2", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28517020964616159"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": "New: Step off the side of the plank and experience a completely new descent. Glide gently down to the cathedral roof, where a platform appears beneath you and carries you back up to the plank. This new sequence was added in response to user feedback and makes the height experience even more intense.", "created_date": 1790074055, "id": "28442271382091118", "version": "2.1", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28517020964616159"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": "Major update: Walk the Plank now includes multiple selectable walking surface variants for a much stronger height challenge.\r\n\r\nNew variants included:\r\nNormal wooden plank\r\nThin wooden plank\r\nSquare wooden beam\r\nIrregular stone slabs\r\nGlass panels\r\nMetal grating\r\nDouble metal bars\r\nThick iron pipe\r\n\r\nEach variant changes the feeling of balance, fear and exposure in VR, from a classic wooden plank to transparent glass, narrow beams, unstable-looking stone slabs and extreme metal surfaces. The build also includes improved onboarding, clearer safety flow, refined controller interaction and a more polished start into the experience. Use only in a clear space with another person nearby and stop immediately if you feel unwell.", "created_date": 1786620685, "id": "27921870207464574", "version": "2.0", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28517020964616159"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": null, "created_date": 1740755746, "id": "9294384573973086", "version": "1.2", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
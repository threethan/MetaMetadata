80_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j5VWPyK8k8Q7kNvwELjeY5&_nc_oc=AdoDdtxtTMGyjdQhVlBxGYhjMLM4EMq9NitFRkBD6b8ttD38IaenfFDpZ9Oai3ASwvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpkBCsJUda2qelbesxWosOTLEmMeOOvkQ_rcxJcZnU9w&oe=6AB90A8F"}, {"file_name": "s2.png", "id": "720317432976877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035434_720317436310210_5732806501703499256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwCCGGPLvlMQ7kNvwGoiUog&_nc_oc=AdoElCroskd6ous5vnNK2dLZSYpdaRuuqZJjNH4CjsFN1m9DaEA36A5pJu9VBpX5p1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtGWGMH2nL2w6W5dqQcAFSWxnsGVvTsBk2AFfaXkdjxw&oe=6AB91086"}, {"file_name": "s3.png", "id": "747493860757262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297582_747493864090595_1851039702839981421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTEw9EddJBUQ7kNvwGSQlL3&_nc_oc=AdqvLUrJ7ax4bV5czt4y5refyN8B0IDHlfYKGSJM8MKFNGumo6Lw6LIKWx_aoC0NoOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-2I7QDeLgacUOH8dxrof9ItqjG7ey5KyLmH7yz8oWHQ&oe=6AB93E24"}, {"file_name": "s4.png", "id": "900878714346783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_900878721013449_7160948324623610026_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aVtz-5E-7oQ7kNvwEDfp2A&_nc_oc=AdrOY8rtiYQYLkXdStMaCGKJVdnFYVCQzeYfaJenosG6zRZslPXXFIg7spAUpgVfz-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeNu7faFfVjADriSZrOE92oTI62Ek1AlMV-H9G0v8iLA&oe=6AB927FC"}, {"file_name": "s5.png", "id": "1285746338778468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982548_1285746342111801_1529907829496149123_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2ms_wB1xywQ7kNvwGlv1yQ&_nc_oc=AdpJtPnD1ewJ8LAQ5DUiDv-8GNSN-D46fe04_LQR-4B2Nb5ZTJWIEPleJTGHalsd09I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcZcb7PRLcPSQWARVZw4kuSRiR9X5-3hmFN6q8q7KITQ&oe=6AB935D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fight The Plank  Between the Towers", "keywords": [], "long_description": "Prepare to embark on a jaw-dropping journey with #FightThePlank where in just 2 seconds, you'll experience something utterly incredible. It's a ride like no other, where your body reacts in ways you'd never expect. It may sound unbelievable, but it's true.\n\nIt is not just another VR app; it's a revelation that takes you to unimaginable heights. Suspended between the towering spires of a majestic cathedral in a real-existing German cityscape, you'll confront your fear of heights like never before. This app offers a truly unique challenge, setting it apart from the rest.\n\nWhat truly sets #FightThePlank apart is its power to bring people together. It's more than a personal journey; it's a shared adventure that sparks wonder and curiosity in others. It's not just a game; it's an experience meant to be enjoyed with friends and acquaintances.\n\nPerfect for social gatherings and events, #FightThePlank ignites interest and encourages group participation. Challenge yourself, prove your bravery, and relish the 'God Eye View' from the cathedral's pinnacle with breathtaking panoramic vistas.\n\nThe social dynamics of #FightThePlank are undeniable. Users are not only eager to share their adventures but also motivated to introduce others to this thrilling experience.\n\nShare the joy with your friends and show their reactions. Capture these moments on film and spread the excitement on social media using #FightThePlank. It's not just an idea; it's a reality waiting to be explored!", "short_description": "Share Heart-Pounding VR Heights Over a Real German City! Stand on the virtual plank suspended between the two towers of a cathedral, and behold the stunning panoramic views of the city below on a beautiful sunny day! Balance on the Edge at a Cathedral\u2019s Towers, Inspire Friends, and #FightThePlank Together. Join the Thrill! Experience the Thrill, Share the Adventure: Conquer Heights in VR and Amaze Your Friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/FightThePlank/PrivacyPolicy", "developer_terms_of_service_url": "https://www.vrtravelx.net/home/FightThePlank/Terms", "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/home/FightThePlank", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6886477631430471"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1085874150584197"}, {"status": "PUBLISHED", "id": "1688511322448184"}, {"status": "PUBLISHED", "id": "1563021025410434"}, {"status": "PUBLISHED", "id": "1038491298860186"}, {"status": "PUBLISHED", "id": "1302703868708509"}, {"status": "PUBLISHED", "id": "1254138662766228"}, {"status": "PUBLISHED", "id": "908414515465348"}, {"status": "PUBLISHED", "id": "1602341300902350"}, {"status": "PUBLISHED", "id": "2353107575143541"}, {"status": "PUBLISHED", "id": "849167517771338"}, {"status": "PUBLISHED", "id": "1779734070088381"}, {"status": "PUBLISHED", "id": "1096676562399267"}, {"status": "PUBLISHED", "id": "1255482839484073"}, {"status": "PUBLISHED", "id": "933612422005152"}, {"status": "PUBLISHED", "id": "617530410732406"}, {"status": "PUBLISHED", "id": "1784010249013444"}, {"status": "PUBLISHED", "id": "695248419366341"}]}, "baseline_offer": {"id": "695248419366341"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1085874150584197"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28442271382091118", "version": "2.1"}, "id": "735923211725727", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28442271382091118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": "New: Step off the side of the plank and experience a completely new descent. Glide gently down to the cathedral roof, where a platform appears beneath you and carries you back up to the plank. This new sequence was added in response to user feedback and makes the height experience even more intense.", "created_date": 1790074055, "id": "28442271382091118", "version": "2.1", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28442271382091118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": "Major update: Walk the Plank now includes multiple selectable walking surface variants for a much stronger height challenge.\r\n\r\nNew variants included:\r\nNormal wooden plank\r\nThin wooden plank\r\nSquare wooden beam\r\nIrregular stone slabs\r\nGlass panels\r\nMetal grating\r\nDouble metal bars\r\nThick iron pipe\r\n\r\nEach variant changes the feeling of balance, fear and exposure in VR, from a classic wooden plank to transparent glass, narrow beams, unstable-looking stone slabs and extreme metal surfaces. The build also includes improved onboarding, clearer safety flow, refined controller interaction and a more polished start into the experience. Use only in a clear space with another person nearby and stop immediately if you feel unwell.", "created_date": 1786620685, "id": "27921870207464574", "version": "2.0", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28442271382091118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": null, "created_date": 1740755746, "id": "9294384573973086", "version": "1.2", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886477628097138", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28442271382091118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735923211725727"}]}, "change_log": null, "created_date": 1701430070, "id": "6886517791426455", "version": "1.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
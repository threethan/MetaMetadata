c_ss=7f20f&oh=00_AQS9zJoB1k256mBdl511RsQkcNp_QRp8gy1Y1pW9Ge-ruQ&oe=6AE9E8C7"}, {"file_name": "Screen4.png", "id": "2322065164939673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_2322065168273006_2212221385798120533_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YozOrPYK0d8Q7kNvwE5IJu1&_nc_oc=AdrNVFvaZO6uHrT_d9ullG0uDVeWhWrWoP6L-5h5tbsxqFHhd1RYP2ML_aXuFUZmCes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMaq9WNOUSkxFXVMbgRy7HVM0emPTjgkGlc-APmmc_XA&oe=6AE9F960"}, {"file_name": "Screen1.png", "id": "1419236489944712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_1419236496611378_2765658048111213557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMBMwjntOC8Q7kNvwFfxMfU&_nc_oc=AdpTs78XeTYtYqT7rdwE7abjwGqv-JCH8-PQBkAGH74LYGzhfFWYCqVnN--C_b--27Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOzrUeCcg1sPOiWCjYI9JRqtlFN6Vy1SiyWJ4xyORq5g&oe=6AE9F517"}, {"file_name": "Screen5.png", "id": "1566373754595480", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_1566373757928813_9153847755977883452_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_tJwu_jA-8Q7kNvwHDc9dE&_nc_oc=AdrKhTsF8BbKqojDVUnCkA50HTRJ8svkjge-yDmVSMhzsLeNRbeke61rjNQGs1_Aitw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD9zvZSZqbJSw_rv2PJLy4Tnv7AwIcUgZoidbIUYSdFQ&oe=6AE9FF6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "937062729140924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312263_937062732474257_7617791955119948558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLxYX0-3X-YQ7kNvwG8ifzN&_nc_oc=AdoUH_D9AH69YGOEqsL-3vZ_NVASkX2hIwIykTMl8WfXI-VBbQecrFMsKEJAo8nmyyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEfDT7aq1BpmlYV3W8kPNit6UtX1yBC39bIQQz6y_3Iw&oe=6AE9EBD1"}, "display_name": "VR Walk the Plank \u2013 Between the Towers", "keywords": ["FearofHeights", "Walk", "PlankExperience", "Plank", "walktheplank"], "long_description": "# Walk the Plank\n\n**This is not a sit-down VR show. This is real movement. Real balance. Real fear.**\n\nStep between the towers of a majestic cathedral and look down upon a real German cityscape. No buttons. No joystick movement. No teleporting. Just you, your real steps and the drop beneath you.\n\n\n{2447914899025990}\n\n# Eight Ways to Face the Height\n\nChoose your challenge before every walk:\n\n- Standard Plank\n- Stone Slabs\n- Glass Panels\n- Metal Grating\n- Narrow Plank\n- Square Beam\n- Double Metal Bars\n- Thick Iron Pipe\n\nEach surface creates a different test of balance, courage and concentration. Start with the classic plank, then push yourself further across glass, stone, narrow wood or exposed metal.\n\n## Your Body Believes the Height\n\nWithin seconds, the view can trigger a powerful physical reaction. Your legs hesitate, your balance changes and every step suddenly matters. Can you keep moving when every instinct tells you to stop?\n\nThis is truly physical VR: instead of steering an avatar, you move through the experience yourself. The towering architecture, skyline and changing surfaces create a challenge that feels immediate, personal and surprisingly convincing.\n\n## Made to Be Shared\n\nWalk the Plank turns any gathering into an unforgettable VR challenge. Invite friends, compare reactions, capture the moment and discover who dares to go furthest.\n\n**Choose your path. Take the first step. Face the height.**\n\nUse only in a clear play area. A second person should remain nearby.\n\n#VRtravelX", "short_description": "Photorealistic. No missions, no game mechanics \u2013 just pure fear of heights. Walk on your own feet, 50 meters above the ground between two cathedral towers in Germany. No controller. No teleporting. More than 17,500 people have already taken the step. NEW: Step off the plank, glide dramatically down to the cathedral roof, and let a platform carry you back up. Feel the drop, the height, and the return \u2013 all with your own body in real space. Face your fear. Now it\u2019s your turn. #plank #walktheplank\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/FightThePlank/PrivacyPolicy", "developer_terms_of_service_url": "https://www.vrtravelx.net/home/FightThePlank/Terms", "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/home/FightThePlank", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28517076791277243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819859_1562765274984702_7154297597504425583_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5fr_IkkHl8Q7kNvwFW6mCj&_nc_oc=AdoY77SAnRGC9ecDauPCgQKMYkMr0dtNOuc6MM8qb3ohWJg04dILYrilJoyZ_FPBayc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwfbuK0qIyI_-KH29tr9PFX9ULtpr_8xWmhRYzDjrezw&oe=6AE9FAE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Walk the Plank \u2013 Between the Towers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1701729009, "lastRevision": {"nodes": [{"id": "688647764809
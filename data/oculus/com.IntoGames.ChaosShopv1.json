=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wLNUwbVZwwdzQqhMoOys8eEpBBAHc0wB5084OExb80w&oe=6A131004"}, {"file_name": "T_YouXiJieTu_2560x1440_04.png", "id": "1417435927052409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618432_1417435930385742_9210028486566947813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkcfHhKHJ74Q7kNvwHcjSST&_nc_oc=AdqXTEJUco8c69ThTxzX_zJd3KuZNKhbwVZNv1jecL2fiYANEpaU6aqk3ubxZMIOd6Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sfVNOPppWihFrmaIuVs1dPlg7z5MTQlDT66ADAD--yA&oe=6A131AFC"}, {"file_name": "T_YouXiJieTu_2560x1440_05.png", "id": "2281089569022030", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617847_2281089572355363_3444680363118045751_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mClBquLUK24Q7kNvwEz36_Z&_nc_oc=AdpMsPvYOdAnWXeexlRyP_DRzisiDzEGarkqszQm1hghilT7IL-51Vgc10oIlYiKp_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ohJphwCYBMySdKyyXLWm09x3ObO0NQxQ7BvB02kYYAg&oe=6A131CD3"}, {"file_name": "T_YouXiJieTu_2560x1440_01.png", "id": "2241664792997596", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619098_2241664796330929_1651851667762711786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0D3k9Ga0q0wQ7kNvwFDRqap&_nc_oc=AdqXKvKriJ01XoL3n8jcfC3--H7lOawtqYtL5x_h1f6NYjiOZSI4mHJvil3rqDsqgEc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af697OMIULYaFImbvYmwUDjIAFzLKhiLvRAtI0P_qKcCRw&oe=6A12ED7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25.12.25\u80e1\u95f9\u8d85\u5e02\u5ba3\u4f20\u56fe_2560x1440.png", "id": "4184722338412711", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619832_4184722341746044_6153465715982131598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKgCIkEDQeYQ7kNvwF7_E5-&_nc_oc=AdqTD3RHOeX3j6de9gM0th5RyUqTV31TelZC1WzDTFQOZS4g_2pMNh1Fhj9RujB5eu8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dbEW2a_1_cDg_o5NHcjTdFW1pOsR43pWSMOWOLlkK9Q&oe=6A1314AD"}, "display_name": "Chaos Shop", "keywords": ["shop", "chaos", "supermarket", "chaosshop", "simulate"], "long_description": "Welcome to ChaosShop\u2014the VR game where you build a supermarket empire through farming and absolute fun.\n\n\ud83d\uded2 Be the Boss of Your Own Store\nYou\u2019re not a shopper or cashier\u2014you\u2019re the owner.   Decide what to sell, how to price items, and even slip regulars a \u201csurprise gift.\u201d   It\u2019s your store, your rules.\n\n\ud83c\udf3e Farm, Process, Sell\u2014Your Complete Supply Chain\nGrow crops on your own farm and turn them into products using machines like jam makers and fryers.   Create what you sell and build a self-sufficient business.\n\n\ud83c\udf81 Surprises Around Every Corner\n\nMystery Gifts: Get random gift boxes with outfits, recipes, and decor.\n\nScratch Cards: Try your luck for instant cash prizes.\n\nInteractive Checkout: Upsell items or give free gifts\u2014each choice changes the outcome.\n\n\u2699\ufe0f Start Hands\u2011On, Then Automate\nBegin by doing everything yourself, then unlock auto\u2011restockers and self\u2011checkout as you grow.   Spend more time decorating your store or just having fun in your own space.\n\n\ud83d\udc64 Customize Everything\u2014Including Yourself\nChange your look anytime and design your store with tons of decorations.   Your style, your personality, your supermarket.\n\n\ud83d\udd1c Play With Friends\nTeam up in 4\u2011player co\u2011op to farm, produce, run checkout, or just create chaos together.\n\nMore than a game\u2014it\u2019s your playful, creative, mischievous supermarket sandbox.   Welcome to the chaos.   We\u2019ve got you covered.\n\n\u2764Love it?Join our Discord to share your ideas: https://discord.gg/vf4Vuuy4zv", "short_description": "Welcome to ChaosShop\u2014tie on your apron, grab your scanner, and get ready to build your VR supermarket empire in glorious chaos!\n\nHere, restocking shelves is just the basic stuff. Your real path to riches? Farming and maybe some questionable kitchen experiments. Every sale, every harvest could hide a surprise\u2014this place doesn\u2019t just need business smarts, it thrives on wildly imaginative ideas that \u201cbreak all the rules.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://intogames.club/ChaosShopPrivacy", "developer_terms_of_service_url": null, "publisher_name": "IntoGames", "support_website_url": null, "website_url": "http://www.intogames.cn/#/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25867822986188657"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619485_846960987949974_7578753508110161839_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8H8Rs0zO5gQ7kNvwGQCMK4&_nc_oc=AdqUFsQ_w7ynA46QUbdYdK8lI-6-pOSOJVOy-qfPxJxnuhGgJxgkEHqQJr5mnribYaw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k3FfDaPpswaBZnPS2iorkLjjNMv8e2wuQqIn-CsiGRw&oe=6A1305CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chaos Shop", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id"
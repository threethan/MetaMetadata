_sid=6e7a0a&_nc_ohc=BcHjxS6v3cMQ7kNvwHEMOMk&_nc_oc=Adl_4DvLDuP527Toa1_CqfwFtaGzk4s7Zlnbq8_RTzNiFnsOvgj6aKnAFS1e5so2Aiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDc_V6j7lPdOcgVlVsOc-xX-47gA6e-o16HLIp_6RYKg&oe=699D9D06"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s8YS2LexYEQ7kNvwFZu3bj&_nc_oc=Adl4qJ1FWeV9zw1gD56s25dozRrY0FDPo-S_aD5sroNF2dtsVYobwY30Y27Ya4E8pSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0cCzRLYxIgeyw16RDIjAdJJjE1lkW-zW5TDmdRI4iww&oe=699D9333"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD7aQweY1d0Q7kNvwHQ5M-C&_nc_oc=AdlFDGB7D41yiEGPP51xloLj3ewNaeheU_FE6vWykLatjUckoRwyG3v18d9SH0OWGoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGfhEBVrOZasc0Q_cQUCJINdMl5D88kQtW77o7Vm4nPw&oe=699DB64D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttke3tuK-_oQ7kNvwHpSbiv&_nc_oc=AdneAnlTY_jbXzHB2i2JrexZmHKl4d9NoV1xHLMMvXhuAzjt7D6H-xJ4iocphZDnNXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0tLXG8_DHIpxg9TmJY58CKBv3XQ9qsI9wdz-VJyKXow&oe=699D855B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4LAYJhLa2sQ7kNvwHep-da&_nc_oc=AdlVQHOMKiUe70OfG8sK0sOAhjORDV9Anrr5gvjn4pLE888cjQ14seUcdKgHVibyEpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswdG3QtZdNqaE6q1Riuor7nDDZKvhS-Ysu4JLY52JXfA&oe=699D83A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
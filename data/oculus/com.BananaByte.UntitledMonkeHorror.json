54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ezfz5SbmfP0Q7kNvwF_-Np5&_nc_oc=AdmMvCVUNvS_qW4HOuFexgtO2u_9O4TdHTSyMS3EyIK974B4vIKZxflwg8z9KwUT2w8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyS1dZ08Yuf8swexbohSaQmS7Bst_B5xVz816ntBWmFZw&oe=69BBEF86"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr3Atgq-iAsQ7kNvwG-s9-C&_nc_oc=Adm-tPPDJ0RJTzWclXQDI7nA7Ns4q6ekeC1-dQMyPHRc8yeMhpwWdbyz4i73RhJCk8U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwiWV_OklCQ7B9L0jt6H6w2txZDBMLgKF0ykF-d_9naEQ&oe=69BBE5B3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zPO2Tvrd7wQ7kNvwHE34x5&_nc_oc=AdlnOIy9porUJg00o6Uzn_W7eh1I4jY70Ik6a6SwzmOWLniIz_rGhyQ8_ZHhHesWT94&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymibNBqNyavJxGQlDU9HMCD1dD8EpPN0RqTMiLl1yBJQ&oe=69BC08CD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JUMIXAd0qUQ7kNvwH1L_HS&_nc_oc=AdkRtx8xdsrSEJlUklDzayt5JzYv01djQcKBsWiljMEY8QpaiNeKivOJznVFpmW6wIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEoIWM9DXgE9I-3t4ur_ML3BlrmsaN8ulyh0OBZAFS5g&oe=69BBD7DB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHvcG9e2w9YQ7kNvwGjMEEc&_nc_oc=Adk3tBq5j6BEHWnCvFP5ZDX82F7iAsL8XJCp2YDKeBvUp7r5m6xGHju9oUjNpEmvqec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfweNtnepSNQ_qfZGIxjqLlFnetYKxkTAWpvJ-sAZxGRsQ&oe=69BC0E61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
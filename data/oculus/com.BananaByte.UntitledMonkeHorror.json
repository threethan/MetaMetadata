g7j91h-6Kx7iIGIX-ivL5Hxp5JxhV8sfWT4Z0jzQkoQGzM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3WHMvajFRsppqKPakpN8edFF4Zl0F2fhYhVRGALFbqA&oe=6A8EE731"}, {"file_name": "Screenshot3.png", "id": "870629811374449", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035458_870629814707782_436608896590677092_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtiGKO6dpasQ7kNvwGT3qDE&_nc_oc=Ado6nHO6qAL-j9IAomC4Iayzl0-ZN0hhbKgeXXNYANXIuZ79v8VsdL85ljybCQCTZhw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl9dapun2OrX8SGN0XhDZyRYFwIoIxzJ8GNyu-fcEVQA&oe=6A8EE030"}, {"file_name": "Screenshot4.png", "id": "328567173257863", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001655_328567176591196_7814056610848427289_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbnSloONXp8Q7kNvwHG83aK&_nc_oc=AdqYDBH1mUSCG3iybBtTDiitI8gTpaNoQbCOZ8vEDOifdO9Ks2K8GiNadAhOv282MWk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPR2oM0AdwwdYdrrwzzkzeJ6DtTOyEE7vauXEfE5QNMQ&oe=6A8ED656"}, {"file_name": "Screenshot5.png", "id": "6863860090391040", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75286676_6863860093724373_161777200461273615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fqa0TTlJ7EQ7kNvwHLDT9W&_nc_oc=AdpfbVor2ZHXCEyfx0U3GkC2DKqp2Eb5Hyr2u6viwdOH1Bse291URRcNtYJbhC3b6DI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0s_YK_OIhlgFfgjPXOFZrqv2RKzYC7FQBrdyNdJ-5NA&oe=6A8EED7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\n\ud83c\udf32 Jungle of Mystery and Terror:\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape deadly mazes with deadly puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IntelVR", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24306282179020462"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"_
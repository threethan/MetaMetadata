157_1054153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beTun3Y950wQ7kNvwFnYWAg&_nc_oc=Adnt0D9yiiP9SS0S-O0biOJQuEkERWPjjDwNZJjixLC4vc-rrLg4ktYNL9xOmsG-wiM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJQpP8wyKY_1-mhhjAHVJyqZv4_urHL-cNK0DnPvFAvw&oe=69AACC06"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8hhvOgKVZ8Q7kNvwFm7Zt8&_nc_oc=AdnHHAHo9hX9HR4GVARrOA_iIzwNfkQtiskpkJT4VrCLNaVykCeVmg3K7ivPatmYHMU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzf-QGe7g6wR4xgF0k9m5YMO1ouH0S5qQ7cdKn87_AEqg&oe=69AAC233"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDdTOSyUfdMQ7kNvwFYnwls&_nc_oc=AdlzZ9hd8Zh7xFrv3zkSBOqhQs6sbdovCCu_ILfZfek-CX6zV06CMkjTotX3yRXpTKw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYnNk8UpaoNr-tyy0VjFmYjrP2Xr5G1zfCml8t6i1QzQ&oe=69AAE54D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGledirXGkgQ7kNvwGLuoqt&_nc_oc=AdnDjr-SIACqRoSaPBIqvzE3XEG_t_9Q6556og2zzKVmWb5DnYec904AlzZL3C1i3Xs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUN1ZDz99gLScZIAPzeyvuae-Slz-BwdvFNuSKcDizeg&oe=69AAB45B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbL-8cfquz8Q7kNvwGi1wi1&_nc_oc=Adl4LR5m-k3e7lp1TBbEJDuLlRemUQ_TC6yI_805S3M-vqG11A28iTmZJSyB9Dfj8KE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPfoeV-kanKoLfUnwIHFK5a-xNdP2e-5kVzGnNcLflOg&oe=69AAB2A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": n
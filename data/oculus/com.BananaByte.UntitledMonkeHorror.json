54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beTun3Y950wQ7kNvwGHSQzn&_nc_oc=Adkxk2StrNTqIYjSoUH8OKu5op0QHpyxR1eT_GOfRtmUeNk6vgnxmed-9CulgtSv_RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvXFPCoQQyepao5gNWpoAFQ3hAdDZEUuOxODbNNwlKQqA&oe=69A97A86"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8hhvOgKVZ8Q7kNvwEBdx_8&_nc_oc=AdmM_vrY2uabfi-Ry7SWkb_3ivWkR175ePjvQE3HQ-7LQgHSVJ4E1Ijs-kOvE0s9l0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu-BEdKkNQVZcps6qo5QYfYMiQQdMqIsfiRw50HTwmD5A&oe=69A970B3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDdTOSyUfdMQ7kNvwGbFeRg&_nc_oc=Adk8AOLjRf9JUhJMDiKBZvu1lgfzblMWkpOqw8pfE8iPyOr8C23GUXA26l9Adnz-RJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-sSv7zv_7xcQhFVQ_zDFkkbAl5LbCfDSh36CI5GfOYg&oe=69A993CD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGledirXGkgQ7kNvwFed-IG&_nc_oc=Adml1JQ9KcTG4iNA9ctnK3Pap_14cLhliNuy2t08CC8ST02ojqCEdqgnoSa6uHjXVS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0fN6f04jo0QzVCyIWp7Ce2YN5BpNwm4kJjNDne1gr3Q&oe=69A962DB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbL-8cfquz8Q7kNvwF4paBA&_nc_oc=AdlHeUQwCqFugjrini51zg9j4rxjl9H5uxlQMCBrr19sCYuq_bCtpwgaZPrLhcdRtPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvP5f7OGkJA6rHKmqGjEDmfhhQ2w-zRPon4RF5nPN1hIw&oe=69A96121"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
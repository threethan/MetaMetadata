_sid=6e7a0a&_nc_ohc=6qXnkRItfJcQ7kNvwFCdWe3&_nc_oc=Adlvw15JCCPhOsQ5LIRilcWW2GUzgpuFYLTvL3fhk4jDTaJnwD9jpQ3v1WYCxKBSAg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsdjtAGNXKZ7wq8X7TZy0mY7GPBDLp2XM3PiGD6uaM-pw&oe=6999A886"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzJS-_QUwuEQ7kNvwFc-Kec&_nc_oc=AdkeXFgqxNTRIBdqwdBYZNEiOPkusmprmYvMn2rPjx9IIUInzTYGwhS2QxyXc2OuXYc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDCja0003iDGmr3eZbsauj_pjL_YXDXR7kpaY6scWc2w&oe=69999EB3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV3dejr216AQ7kNvwHT2zO9&_nc_oc=Adlm7RvilvTDctCFjFzWpavJikwpjUxUS3z4nS-XA3Zso2gBgSNcWAMnUzMt1SDE8gA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoRCaXgUBiq7wD0DwIAx1zdy_eZgyr-XUcxD96x2463A&oe=6999C1CD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSpkzWE5xPYQ7kNvwHE6Og-&_nc_oc=AdmIJ5-VGkwt9m_v9Mh-vMvlieIpzcr1VKWKn47Zsug8EWYLjQg6lWw5VYwwnh7gy7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudlOrpie0ggG6zzwER-bNJP4WO9tx_X8Y1iAz2_67eow&oe=699990DB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTJwJh24KIAQ7kNvwE1sPta&_nc_oc=AdlfPKozcNxo-GCQb-MfQnfP7ApPlp9oVgpWNQnOifbMWCku3h0y-7G2Lo9xJ8enwts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9Ms02xYTs_DOsk8oCaYB5O4OFEwBiAidFkYmxd8y8ew&oe=69998F21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
Wo_7JkkZkmMP_H_OYUwigM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FCPObtDNlQamuXBkV1laB87z8fYggLl1J9GuYrffcvQ&oe=6A427031"}, {"file_name": "Screenshot3.png", "id": "870629811374449", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035458_870629814707782_436608896590677092_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7roGMum0dIQ7kNvwHWYu0a&_nc_oc=Ado3993DrkgKIEgVROTLhuoX8DNxYhYguWiAxkcg0g6JZK0P_SVErIumWPhb3QJzTco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9APKCf1WWQ9QSNh3OCexxo2uXkwQrN6y24VseoMF8Ybw&oe=6A426930"}, {"file_name": "Screenshot4.png", "id": "328567173257863", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001655_328567176591196_7814056610848427289_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gR8PvQC8XO0Q7kNvwFEhwVY&_nc_oc=AdrUeZM6rhbXu1sAoS1R8L3wwc1uaJCp-wqm4RiSPLf3b5ox1OUJh2PUv5O9C1JfpAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4ITSPdrrsTXkWPENTJqhHPmrMElaDj5ebWWT2pDBeJQ&oe=6A429796"}, {"file_name": "Screenshot5.png", "id": "6863860090391040", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286676_6863860093724373_161777200461273615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3SPm2idP-cQ7kNvwEZIblw&_nc_oc=Adpekh8ZwXjGAUoITI7wSUd28tH0zMAtrnOy1_ib4UUDQCWDpeWQxXBNXIPW0s1shZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Most0gdGLtomr7I0aPIRtHAwY-VnLo2B3pX3dQ7MrbQ&oe=6A42767E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\n\ud83c\udf32 Jungle of Mystery and Terror:\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape deadly mazes with deadly puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IntelVR", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24306282179020462"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary",
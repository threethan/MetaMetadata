54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h2tUOAIsIgQ7kNvwHYNoCW&_nc_oc=Adk7br4dci9_hoXsppbEv9TEaQmyGwAVstOmoIzvfdD4h0lAD1mHywp7GcO8TLcYfSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBdPiAn4TPyG1XuAJRfvRwFEzYUGw5RuCywuqxqmWxSw&oe=69BFE406"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AD7ZgnQsf8Q7kNvwGD4f9N&_nc_oc=AdkVg4vD_CdGjBeQXDi4aXMes1qL52d_7AJN_4EH1gvO-CLbnwoD_z9adTSJFpFM4fw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1MrJSv5wHWCBtTZI46GIXuRerNbPZhhO2szixLuVrHA&oe=69BFDA33"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC_MVoYRDxsQ7kNvwEx2afF&_nc_oc=AdkJKx8-Jq9Ne5UmRx5k80MhFMiAEY6b5k6UvQPyQT_6xgmk_UhkyUHZrS21CF8L458&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh39fFA9096XecvXNLpFeG7f04iIE56_x3bEkmsEwjqw&oe=69BFFD4D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RZy_OKH7DYQ7kNvwET-wIB&_nc_oc=AdkcCxU9DIvNYuKzA5fudEYSOfmwuE6z8WMpCwzy5xc-7Oqx4Soe8G-SRnsZKcsupxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMxveqXenVmxCV2NjmvOJVEmYjptDEtjd_WoVIcxMV0w&oe=69BFCC5B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5-1FwHIpdYQ7kNvwHaiuOe&_nc_oc=Adk7xr_6Z1jpJ395C47HWags2JRdJeDKsMbG1Xe9vliLS0F1gzTKEVeWPPCU_YDeGIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxak9oTjqiQBRjrwij4gseadqysmnRL-pZPKR6NqkWd3A&oe=69BFCAA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
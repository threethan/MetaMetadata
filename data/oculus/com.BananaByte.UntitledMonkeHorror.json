54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ezfz5SbmfP0Q7kNvwFEvIhq&_nc_oc=Adm9Vvzs-oN51eOVsFFcq5rriBvItvckr8jUp-RJwem0tv-Nte2IsYnUTsRUW60Lnw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhaIXL8-IcDuQhVCyEooRXdI40dAEAQLmwJRukf5KUJA&oe=69B94C86"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr3Atgq-iAsQ7kNvwEeO9sW&_nc_oc=AdmM0c3KAHwGmP20M3_-wjgy0OVSxNNiJowsvZIb1wEUyLua5glbRee1pwAARrpkito&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxK48CtcnEbf-6iX2EE2ysthFAASO3w9SP7tfVTZ3zRGg&oe=69B942B3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlE_YLfJiTYQ7kNvwHJR3Ra&_nc_oc=Adl9oOmodjjU5oQxUrnD-yQOTVGjaiATb8-DbtrJy5EX_lPY6R3RBV4cIVJVf--W4mc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLNQNr9pLnQIsbyusI_-If637RIGfmgnQ37iLwmePg6A&oe=69B965CD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JUMIXAd0qUQ7kNvwG32j5i&_nc_oc=AdlsBtEr4tvSt-IJKi2NX69P18K50Ej-Hg4B5afXT0MPypu0PtQNbdRm61puXf2a2Qk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLMFw0uKC0sMq2NMbl-Tgy9G_o0W3RBE7YlPm5QpeLig&oe=69B934DB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EIKXMikU9cQ7kNvwHRm06d&_nc_oc=Adk0WT2m95H_mmcoKLUJMn4wcXcoFYzd9WwOIUxHXNQ8bLDpqKztCIhKdam8t2Uqgc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwf9YbUJoJr3cxJihxYLEZHpLbTdZq0AZOdENzLXeibmw&oe=69B93321"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
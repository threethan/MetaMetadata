54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVWrHHdPCooQ7kNvwGqaNXu&_nc_oc=AdmymN0orkKtpeCCrHQ_GgRVF78DllRhbQV_HyPI9qFGw2B0HSWHW7cGu_oSsPVHv6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJOEF9KX65nyniX6hKfumvWAJvKbbWcDLcb9mVd9gadg&oe=69B40686"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRtlkZFLN9EQ7kNvwGIWvK_&_nc_oc=Admu1EIlYFaoNHdjO-t8x0W1IFYwAf0kNj_lODLVUaMepJOBPvJqyWzfJiu3GL5uve0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx869NBDgPXUlZHyPGtF2ELpZugZJ16oGjFAS7TgTVAUA&oe=69B3FCB3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNmRObq68d0Q7kNvwEOWEVR&_nc_oc=AdmWHM8elQqkUC6B6dtDAux-T_cLk767-NiDZ_dkjeWadn91FS8GW_P9BZYdnr0NC3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0xaVRA8vsYUQM7MYOa9raB27g0wo2k75R1FaWPfYHYg&oe=69B41FCD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfeK3s2-fGEQ7kNvwFdQ93O&_nc_oc=Adky_GtlDnMDyQUQ5M4SVkMvBFn0Y6ubbxueAv9U7UnLo4F5EYhvFU46G6wvNfRD2GI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyisNHK3uxi1vunkKQhFMIJ_ev8Lc17xEpGyNTMqgJ1tw&oe=69B3EEDB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruS4u5_O3pwQ7kNvwEAVLXD&_nc_oc=AdnnooYJRTXVljKw7asBgd0MQvsk7IY9_mBg52GO3jI3Q5nOb8feRDxVYNV8mRsr2eE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_omSsnOfs5aRoXoCiIFY8zhB7Rhix4jMLU-4RLzLW9g&oe=69B3ED21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
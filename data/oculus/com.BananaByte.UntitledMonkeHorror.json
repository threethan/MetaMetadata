cb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu0iYz-TXLoQ7kNvwF98qZy&_nc_oc=AdoWxseFszX3NMWdi_XjuvXx73BgY7zfYkbK99GH5CYnV6DG97l8uSbuQKz0hKnMHyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_X6imifSLDQ7Y9FVJXgeMSpfz1EC81593Wi73Is4Z2Q&oe=6B105ED7"}, {"file_name": "Screenshot2.png", "id": "1554366462060086", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982712_1554366465393419_2024702302891271368_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za-iGj_YOwcQ7kNvwFCtBqI&_nc_oc=AdrxCfx4m6FW2NgXHQaMC1CwZ0V8ewYTILxW56R2MJF1-ENHW4yRB32OZByFLC_XALU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1Oy0HYS9h6sRiHDGBr07HyORpiFFxMGfsft1epPAHxA&oe=6B105271"}, {"file_name": "Screenshot3.png", "id": "870629811374449", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035458_870629814707782_436608896590677092_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9mABWlblgMQ7kNvwH3FllJ&_nc_oc=AdptqDWEd3-Fx4Gz6FHihfXF62FKhhPrfxR0mGS3i062J5sPWgchdyE1Pe_u_knhW5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzCmhwNekIQQPzT0bNBgDM952kBRla1ysWBFzOc5jdrA&oe=6B104B70"}, {"file_name": "Screenshot4.png", "id": "328567173257863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001655_328567176591196_7814056610848427289_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTS7KbwdHYMQ7kNvwFB0gXj&_nc_oc=AdpXwK8GyOPHzWc2ln7nvrCDTmyq5Lhqj4-BtfdaESJ9N5O4bIA0NhvX797weIVupHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIbOWjc2HyZZV5llZaXa-QhGARFj92qKs3ILj6bsBoUA&oe=6B104196"}, {"file_name": "Screenshot5.png", "id": "6863860090391040", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286676_6863860093724373_161777200461273615_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9HgMMVgcAsQ7kNvwHxIgOS&_nc_oc=AdoUW0fqZ8WlYSAP2zKaABhk7qOW_NAb2rIT5qwe2c53JJOIdxSjAuRAN0-nYse416U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV07N6i_XeQsJrcJ3KgxyOqeO3jltYXRz2UioMMlUkm5Q&oe=6B1058BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\n\ud83c\udf32 Jungle of Mystery and Terror:\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape deadly mazes with deadly puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IntelVR", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
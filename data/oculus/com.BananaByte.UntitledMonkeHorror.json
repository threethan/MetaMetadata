_sid=6e7a0a&_nc_ohc=BcHjxS6v3cMQ7kNvwG5vKRv&_nc_oc=Adm67_wYBZDro1t4V33saPyV1zprg4X_LOB0m9AHeIXhCKvzNMclpA1jAr-GfVesil8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft1gDm7XS-3nIOtnXd_m9K0c-A--TEL4FqhSUVO5ZK0dQ&oe=699EEE86"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s8YS2LexYEQ7kNvwEAn92E&_nc_oc=AdnlpEghVTy3mEyUi-tHIWQ1-N9c1Y8mcrQeO55xQ_Xf43IVNKh0vKknLsbGF7gT9bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsBHLuRn62r5Am585HXEE5HQIKV4IJ_fVk4V0tK8nW-MA&oe=699EE4B3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD7aQweY1d0Q7kNvwEzTSC8&_nc_oc=AdlJrcZlTTxSbSv-JJoGF-yPxXfYUDvxyRDo1EVcyGAuSPFXsmdyQRgLM2XUeo9c-qw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv2PQNTfYkOEmSkcpp3ACX03pBEQJeamN3QxQk83bFv3A&oe=699ECF8D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttke3tuK-_oQ7kNvwHOIhi8&_nc_oc=AdmewD80p0nCZhdb5Phn9SfQjbqEbVkS6QlOsEDFjzCUnz6SkxXOmOHWWgZsj73fUtI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv_OV4MYR4XavyBZZ78O8QGjjEuFgP32myp3mCEBzvCyA&oe=699ED6DB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4LAYJhLa2sQ7kNvwEp_Gtu&_nc_oc=AdlFI-OTOCn88cpzj0vGvgAq1TtjHq6KzUESDwGEqe3o8kkjG0OOqqEl9HuSYaeXqDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsGy8BtIkNagL820s7YQbKh-6SOyusOG5FntxjFGzhhnQ&oe=699ED521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
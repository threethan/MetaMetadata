om/v/t64.5771-25/75269157_1054153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4FWFGYRozIQ7kNvwHwmHi0&_nc_oc=AdregQGUye5Ppdzzk7Evr4QLq7Oxv5VPzb2pz_Uouvy-C_ESBCyIFZi0A9WxpHaBLbk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwvd_MoSfyD43xGxNdmNG93kV8b8XVjKb8EMo9g8lIiUQ&oe=69C52A06"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc8ByudBagIQ7kNvwGwykDd&_nc_oc=AdqtnCoZTJ8bSsSvGFTT2j-qTGnSMb7qZPLIKniHmvVzmH7VyMYCGoBsERbDKAid0GY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxoZ4f5DyQ0izNKTYXk0RY7lQICyr_hWKGA8CIglNP3A&oe=69C52033"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdXM_mMj5F4Q7kNvwHy3A0W&_nc_oc=AdqrWgEbFxFDphIJScfzyv0AZ_shTpwwDqqpuzqbRAARWxhY8YwqqAio4gNLuV-ggRw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtvvUDgF_KgJTdpTzLudc7LcohSdabYl73JUIXdugJtw&oe=69C5434D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HksK9JdtEkQ7kNvwHXoi0U&_nc_oc=AdovxAqbXAVyNn9g5TEPwXqRBuJfp95I8qjkC__ZVckOon0JODTbZG6HO07evmZCpNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afztwl7bKIYwnESYm-VEijj9iTqlHBSrlFYKVcJQop2rrg&oe=69C5125B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd_arZk3xp4Q7kNvwEy0zYH&_nc_oc=AdrdSly44n2_7-PPG5tK96qOBWwmX1WcYa78lOF-TSWLHL4Gni-r9PcLQ-AmoHIoF-M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUF2b7fYvxMVrr8ZfpHwpoxV8XeBQFlyPmxQd7eXmUgg&oe=69C548E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED
54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JBtJk6by28Q7kNvwGeg2xt&_nc_oc=AdmWpMsOubq_NZ8cXkrZJ6jLaMUG9ss7dmezl-jvgbIFINKqSVWqmOROiKpA0IQvh8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXyvFDHRzd22qH7NBndbmeJJilSnMI7v4iClvDAdloeQ&oe=69B6A986"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB7i7QtW3WUQ7kNvwH-dbKM&_nc_oc=AdmCGc1Hhe95C6X9VW9fNyk9NSCq0xgWajdS_0QgNRskfH0077D31iZ9Xlu7A5ABNGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfznXDu_7AafyTI343kLEQ4m1-12xiPCiTbtYVPssAmAUQ&oe=69B69FB3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNmRObq68d0Q7kNvwEDe2qf&_nc_oc=AdlJ8LSEfWFYgBCjeY3o_DphMR6zlUJJ1f9bBphyfeOnq7hw4tRJ48m1QkmjYXbODH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrofWAu2SMzkaobfAudjZHuT-Z6ZQ1HEvKXUZWcWOMVQ&oe=69B6C2CD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mLaHE583ZMQ7kNvwGLiSWi&_nc_oc=AdnGrMiUITvNvmMihMsRIAbOgWknzQbH-WI1bSACQKM-WnlPbIxwkVtqlRuKxJ_LbcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3nvAJssZSed29kOEOICM7_ow2D0I6GDCv37C6MTyePw&oe=69B691DB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruS4u5_O3pwQ7kNvwHTe0as&_nc_oc=AdnGjsbz5vb2oTDS4T6kSbkVLRwvmkCY1cwwpHGOijyfABES31hgTajR7X0fb3n7Qns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfztoZgGTEBLeI1dO2UbchfW90QGCNd7qJ7EUaG8zk9A6Q&oe=69B69021"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
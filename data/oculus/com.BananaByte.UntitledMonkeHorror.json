_sid=6e7a0a&_nc_ohc=EnClmqqiMxsQ7kNvwGlcUZW&_nc_oc=AdlNl0XzwIc3C36g2hOWEwtiQwgxpYzkpd0fmd3ua3YQDMuuh2E_Jn0TpEEMFJ5FyXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsEKS5yNindQA91dZJhDxaQkixtgvqlDMPQLe98O5X8IA&oe=69A2E306"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrFbApbrN6YQ7kNvwERbrd9&_nc_oc=AdlUa5CcsB26JPWwNb3JpcvC0C-rvBq_8IfIfMP31pwPIfq0tD8wAiFn0spiIahUx38&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGlKuGO8cQ5S9coRm0FbciXa4Z-KklMcutRsi_E16zvg&oe=69A2D933"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBhNs05XcYIQ7kNvwHbTJog&_nc_oc=AdkYJr-qZwc-C1ovCt_ziyMiYLG43sCYC6VRty0rUHFgaTWzbvr-P1E6NvnjzOv8wxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu99cikW13yqnpDd_IbU6S1GAWWwLrAY31fnPlDyNgH4w&oe=69A2FC4D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy2TaWqw6-MQ7kNvwHggUJ6&_nc_oc=AdmItCHxK7VlJX0gAznPqHSeSOTPLFLe1tcY_ksZYXcJfze4bkMcg_4uvuLvZ8AkEDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTMbKkMP1AEcdOOpuGi9CO3fqOcornJvjLSnCpyrhibw&oe=69A2CB5B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldYggwV06qcQ7kNvwGdfJTS&_nc_oc=AdkG4J-REzlRg3hkuM8N1JgT0bdOG9LaP3Z2OoYBlgUi8n68e1aCYaJZjpMn80g1RhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunlTlyfn2toAYRt0GXqAnro-_tXlHmVWEOd_xu6eK8wg&oe=69A2C9A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
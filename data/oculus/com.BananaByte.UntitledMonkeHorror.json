_sid=6e7a0a&_nc_ohc=nRRPyDavLQAQ7kNvwGoWz1-&_nc_oc=AdlH05-fNbq2RY59PI6DMFkaz2BbZ8gJB9M5pKStvmaNoIxm4aStun6S6TIHKRyp-8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuiYVtlJbwoOzbFPlVyeegWVo4mcKfbpc-Lw_ygNNGTDg&oe=69A6D786"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fczeY9eqA28Q7kNvwH4-fEq&_nc_oc=Adka-nH3Um3634UG9zr2Jjy7v_lfq90lFH3e4nyhEKtY8Br-7zqLzAMnP-jxMotkgxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuFaFDcu0nHZ16lwADg5MavSS1UVE9eIDEu22nOO3y5cw&oe=69A6CDB3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LabUR-2r6FsQ7kNvwEGkSdF&_nc_oc=Adle8tcNEmvb77r6ABXkTC9ZAtaaYcCfFDU-GZVNyBKX-bWonqxh_9p7YHg5VXTcTOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfbYF0tqJ0Dbk4ihxzimfWhmLSykWJWYk-gb3NLww2Dw&oe=69A6F0CD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzSYCXZhXvUQ7kNvwEDU5m7&_nc_oc=AdmAulbWvdXz-GqDpKRPLdmEbiPksXhKz8GXMTEW2lVLbDRsfiux4LTP50fOVPddrmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5-sBWGh5j628zEpHnLpmF3iGBtH6wOCDmhFSBdcuEtA&oe=69A6BFDB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5FGEy8sK2gQ7kNvwG_mSDg&_nc_oc=AdmB7W3fNltPyiHNSPzj0F4qbryG7rYiJcXN4J1J2n7RhJOYI_EmRBDC_a5m0SDTJ8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvDPP3RQfVgDSl8LheAhVyPL2oytvjQJSQPgvTrrUJ_g&oe=69A6BE21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
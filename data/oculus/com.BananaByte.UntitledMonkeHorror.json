54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRRPyDavLQAQ7kNvwECp-G8&_nc_oc=AdmS_US917oN6GRycmjrb2T5OubrXTV-JebaGDgfFSzeqS3mWLwOZRn8zlbqC6LaKas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7LaAcD22yfs1hbFPB-TUZpfNQvOqjKhgKkLyfRypVYg&oe=69A82906"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fczeY9eqA28Q7kNvwHEr4yp&_nc_oc=AdnUnQxgRGxWHZLSZnivheDZ0q8iqh7nzOV9zpPgvh3ZlsIDn6AaqJfZ4oCgNhT-EAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvXmNZTed8rnvAJ7Bl4S8cYeDKDJlb2rBVYf-0qVUoiAw&oe=69A81F33"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDdTOSyUfdMQ7kNvwHzGMWR&_nc_oc=Adluw0rbKUFmPlz4mlwzr9oHYLkB7COoH6EvT1j3VU3pg9Dka2eTFILuuL5URL4xYpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsbyHYMOFdzEUIM-vTE8__ZiXDQ1RDpmQDbnP49YeDyPg&oe=69A80A0D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzSYCXZhXvUQ7kNvwEVxSFk&_nc_oc=Adnml5KrwGsWtUNtV4ExQO2ygPWppIBuTmC5o6vkbXzVCcmT0XXebFDQ-9Acob0WgbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuaG_c--gKtfa9fC_nJQEoJ2n7ROgwUPTXY5Iw0z-vRNA&oe=69A8115B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbL-8cfquz8Q7kNvwEsNuZx&_nc_oc=Adl-0GleMvVmSS857a6nsHDBVSL6ZhoptbjWaeKADSXqu49Pow9_DZbY9RkVaXQOadM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuGZgZFFB5_0RDk1ncDVnCPfarozWNV8Dyun70W5RH9OQ&oe=69A80FA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
054153049182387", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269157_1054153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U03AKdJThC4Q7kNvwEST7L7&_nc_oc=AdqfugvAsNgiXiJ-Iv77H6c-HGEfxi0k3XtXpp7mNNdYUCiI_iaH6CBfBJ_LW9BJlII&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pi3RzGsdZVgYNHsBrOwSlW3c7d9D2BpJ_zPXNI6kehA&oe=69F1FD06"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx6Jguk_efMQ7kNvwG_Aaxh&_nc_oc=AdpLyV9mBNV77LRBQdZzw1OdefIVdkrRx1McRREO66NAna1xp3PHNKall2pYhKxr40c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0DnDw-UChTDIHoUidtuCVAvZsGfwjMrc6-uh2cHTOc7g&oe=69F1F333"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3UhERAzz_kQ7kNvwH3go7t&_nc_oc=Adp_PPkBhvkpGH8tfxPwps8L67CVLGqCdluN85DkXNFfZfeFIMaW9y_EwsulOi7NlbE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0A5N3a1nSY_5jPAIkBTpwgrpI6TfikudHCRrIBZWYEUg&oe=69F2164D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR6BOLvNBhIQ7kNvwHiOCHl&_nc_oc=AdpOs-nr3fTZqEO90zLZWNo0ixW-LpdjVSSwNyW31DDxAJuSkoDiN7YvraFvAJYkz4g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2c62611jyHW_LxpWOuCCnljE8Mubdl0eBWkWmyWa3Q2Q&oe=69F1E55B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHDQmfno9LUQ7kNvwHQEkS5&_nc_oc=AdrtXEWmnSrhrN046KtSjbHY7qWbdYNa4dBFrG03COgEYYPcfxZAdb4OYw4JiJiPuS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0JWKtf85boXGR-8hs_0yccniXDbruRrr1-bP3EgUC7ww&oe=69F1E3A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscriptio
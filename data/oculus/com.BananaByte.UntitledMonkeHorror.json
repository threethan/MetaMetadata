54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhZfNL1ZgjEQ7kNvwHJM3ig&_nc_oc=AdrDZ6-gPyNqq6FWFpYTACkYBEU8Yifydx6ojz_sTs3Bl674vHNRT3S29rdsQX9uXpk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz-l7rkfX-77HESZLCY8qxGQjzdHGOw542ga2i3QnkzQ&oe=69C13586"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8raK_XdZq4Q7kNvwHSK8C5&_nc_oc=AdqHosJqVYz5BpgMgZf7n2NuSicdjBvsDUAPZSaRJ6jfkC9O6k6RzVPoZqYOL5YOwsQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJoiVPKtLpkneoUsZCEBTwMYHVtcyI5GWoRAu4aU_P5Q&oe=69C12BB3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC_MVoYRDxsQ7kNvwHxzJ-H&_nc_oc=AdoFkOHcJPfxlmKgjhZGJBg00mIIu4VX3JllvbPul4gWTmkt9yO9wzjibsY8dfnUMOY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0qRCTf4Up9x9yWqWbaAQrWJGdw4HUv2JnBJ7Xfnk7-w&oe=69C14ECD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6zOxZ-a0WIQ7kNvwHRwdJN&_nc_oc=AdpYfK9cSkUsZ1rgB8fTQ4nSmFwMNBy6Yob8EG5zCYU_AieP4vVMp0GK8enJYphsKm8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAY_gNKSlLDI4p6nEzBJ9azmK_YROL-77EB13WLitVgw&oe=69C11DDB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5-1FwHIpdYQ7kNvwEtpEG5&_nc_oc=AdqxHCzNcOIGfcruIZS9YHkAAFkUtDjcov5ex7yypjRWSaDz3ac-9WCK_rz9U1loTPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1ZqCCxrE5ZGgOulpVxJkgVmhOdxDHaN3NG13V8YyR6Q&oe=69C11C21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
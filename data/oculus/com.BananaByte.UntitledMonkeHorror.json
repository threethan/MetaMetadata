54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVWrHHdPCooQ7kNvwF_Empw&_nc_oc=AdkwcglUQBawXRiiFvZ2wOhP528AAJDKpYxcdcPhmmx5ywtKv99mLRBv4ues54owFdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEWNZDJq_csjTlgk5HNSC_YLnLIS5EheSL-Tsgzth6mQ&oe=69B16386"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRtlkZFLN9EQ7kNvwEN67eW&_nc_oc=AdnrjBoGmcld2tWf1fZoApMZYiqXmN_AQDfOFYdKUmzrZEFaCC7Kpp33bWTBa5LXsko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxv2f50fQK1xyJHjU3JhVOV89iXCkGnx_fepDMO81a7eA&oe=69B159B3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1766rT_fTAQ7kNvwHNzBfh&_nc_oc=AdnM7cgrE8NBSANjyZt12Ff3QbONQvZpFNO77tiKd1goS2IBlf7h1G42BWs_WyCv0PY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8lDUDxktcpGTJBacqGoWTARYbJLG93M_cMxyfwpLkyg&oe=69B17CCD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfeK3s2-fGEQ7kNvwEjJQ35&_nc_oc=Adk-w0lWrsc5Z13ddT2Ikr_PqRIko-mQNdRJ8h4KcrDJFaLhPxmX4wWmWS5FJ00QaBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJUfbskhXd_3XHR34pmUIROa-zOzanY_NZRljMEA9sPQ&oe=69B14BDB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jdveqV0scAQ7kNvwFV2ufd&_nc_oc=AdmU5vht_bY5mY650lGuMlGgZhAWOMhqqdOUwJmzWblqJtfxmS8J9Qq5qjW7s-CQKgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGgEz7aFFWACEt95_aNxaId8RmDXD0NY1dnFMulJQ_ng&oe=69B14A21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
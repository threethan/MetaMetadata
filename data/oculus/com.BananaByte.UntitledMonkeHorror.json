54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JBtJk6by28Q7kNvwFLOSGS&_nc_oc=AdkGC-OkfTwdYiyG-U-3N8tYzgLNEYqfsMeFGeesUOTl-JbhCrLKy2IBO_hBW2auuSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCRBChfAnwRXob9LS0_20eccoPq_tu5e9KGAeIHuJyFQ&oe=69B55806"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB7i7QtW3WUQ7kNvwHjVb8I&_nc_oc=AdlmAaxsl4Hr1GDQ-azbqxL7Qqy9gaJdj3cvt1a81AUWDjZJcpiBi5Sump89Srejnuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIAD-GT_EZHwWYBA3s3kX-1E3Qw4uPoYWbC1h9H-NxGg&oe=69B54E33"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNmRObq68d0Q7kNvwGjnp1c&_nc_oc=AdnBOMTEl-etVjjH3-2q8n5aFNzPJrAW0cTYS4_XpjbTpByx13pleYRnQJU9azmLgS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfystW_ApSDTBcA-JblPQxkh2bWycImDaJ3s1RUuO39MbA&oe=69B5714D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mLaHE583ZMQ7kNvwFPzIB0&_nc_oc=AdlzkuWr6Sjhe8uE1MjbrEOlNUoVa_gmF9_CVT2VFaDIX0nYWnp1PjRUxBs1JnYDNo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnwacWq_RJo1C7tKsezRKBON1W_8aLJwqLW3mN6AKyqw&oe=69B5405B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruS4u5_O3pwQ7kNvwE2uZ2U&_nc_oc=AdnGfGQXw2OKrC_HeHhu2Cqw9TiNSAGajtpv_MKeq38qdYEwvdOxhEDI1DR0H2ly6jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2gb5gi7IinRFiYc0C5ar4iD302AcdOUXRDKjL3NofLA&oe=69B53EA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
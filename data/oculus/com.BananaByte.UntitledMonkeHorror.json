54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h2tUOAIsIgQ7kNvwHk0boR&_nc_oc=Adl2fG1O3Q0-QvCMzMD4wz0Qgbqk_0MadRdHobRZ2JJtLZOjIvUvGMpDpVyZo5sPGC0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6NV9HVGzIDusm7X4-huOgEaLSIQUi8o0HH4ItbWwXEQ&oe=69BD4106"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AD7ZgnQsf8Q7kNvwG3bz78&_nc_oc=AdlPD0h5VAKyXpg-J7zAbRdY1TU04H-D6l079blTrh4h8RSKViJF2Yvqqe7OXO-aCG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTKlJmAmkMWunf3lGIEs3q5ygY3-b3i_MAP0keORxDMQ&oe=69BD3733"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zPO2Tvrd7wQ7kNvwH6Q_V5&_nc_oc=AdlScmt1ISx0br7u9CH9vIU0vp_m3G56HlDO3kABdoLjOA-1TP0IQ6aJocjW0Az2hrk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzoHkTHnAy5ewFUkFaViEwkzlKDgnLYYb5LC2BvX9LSxA&oe=69BD5A4D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RZy_OKH7DYQ7kNvwH3tIau&_nc_oc=AdmNcIpYoBFa5oWKlOsuwFd_vxndDyk6bkog3f5XffA5j3eZu3ucEomorWN47T3kD78&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrtuSvXQ8lGm8O58x1GAnTW_oJSc3PYRDpbbhKQTdYTg&oe=69BD295B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHvcG9e2w9YQ7kNvwHEPHKo&_nc_oc=Adm9LyHjcrpUGTuq6xctJEZqRLIYlzElGUasTpMIwfvQMVp7Ilao5O47QVRKyEjJv2A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afye6rf0qImB7gCuEYIM3OmKZmym3lAkvbdEcsL_lL3lCw&oe=69BD27A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
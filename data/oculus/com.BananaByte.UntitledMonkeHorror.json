54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ezfz5SbmfP0Q7kNvwFWIgUJ&_nc_oc=AdmB3VGc6igY3qMOdosuL3E6li1NqAYXGC9rTGTf50V3hR7n10MXk3Mzx5UN5YbxMn8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9uV6GGL29HSCKCBhmIp6ai3n4y5-HkVHeTxHNbt_Zdg&oe=69BA9E06"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr3Atgq-iAsQ7kNvwF_PJd2&_nc_oc=AdksUGUH-g2FjV3sJ1wam-5Ouj5Eu1Cfv73IjjBTL-hQFHSOrD4l_RPB5niEDNxHwxM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgXBFY7hGhf2SXzcu03L4pZiuKPdV5-XCKQzrAG71LFQ&oe=69BA9433"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlE_YLfJiTYQ7kNvwFufoZw&_nc_oc=AdmjoaGHQ3cdDGt5SKmCxMh1IWAMhMPqkbuJyClyvo8V812RdxIXL7KLoa1IHUS1fRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXlxNfkHgAicj9d5c6SgEaZuQIiH3_Sz4YzRCxmuKQdQ&oe=69BAB74D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JUMIXAd0qUQ7kNvwH1mAQP&_nc_oc=AdlBBjVQRQZ5F-IrHoMGD4JUVMbxNUWLSzqhJ_-FEl4n_lRrtlpPwSNb9IEPUICohts&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXcpZLotCDv-DjRpQVgrRx59TxojnJlkbt8Ism0DXa5w&oe=69BA865B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EIKXMikU9cQ7kNvwGKUbNU&_nc_oc=AdleAzyQmYHEH-weDju0jigmWiPjFAQOeJcrrQC51YFNQWdwA3NAK28L_STNqE7L0H0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwosOlbZ_bEQ3Wz-DDJJM6T3FNvc_HU7ExD9GpN2G00DA&oe=69BA84A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
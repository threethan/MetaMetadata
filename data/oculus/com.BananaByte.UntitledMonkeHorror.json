54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlhYYbWr4fkQ7kNvwE8qUE6&_nc_oc=AdnF2JabibLvLeGqB84oJT-pEVjybbmwcg6kuvbBLSTSDYQtpiJA8FbyRVN8TfZLhkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxd7dh8dwQSafqt7_WLnrdGS1bR5kUBVhm_bxlAJAlOwg&oe=69AD6F06"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIkJL6R65-4Q7kNvwFXod2P&_nc_oc=AdnApcvLOD1p75CCWU8bMrGPb0gyqFNSU1NVQYBu3_QAmWol4OMhzMU5spkOxdXdfM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeW0n9PwNp0jmPHrENwtEGgZD3wEVDwwJFGy4U-KKrqw&oe=69AD6533"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U16MbgWIuWYQ7kNvwHGvsS_&_nc_oc=Adk2OmqTA7Fb549S4OxcTxcILzV1QiqZT0WoIKwwEh21bK9e54wGiMlsUxN-nysJoFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZlXFlPYE4b3pPXf1aWVL6eb2xUr6tJLoQz51eV6oUrg&oe=69AD884D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyx1RtSIKWEQ7kNvwEqefZD&_nc_oc=AdkA3p1dUfbcX9cqKcvMkLAz7wht-TnGYMmGdM2ok_M-igdVKmzWOQWAUyqyMPuWuEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzk76A92kahaqM7NhrOhm6y3fSgjxy1OcmeofFCIjjrZg&oe=69AD575B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByXVTgC6spkQ7kNvwGmHBgV&_nc_oc=Adm_AhGPGHxlG0IDrTMk0rUJgcTjLP22kBSNotPzXc9fUNCjwDdQrqirmieL_sl2MOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWddCALs6enWQ_Q7XlgyhaEDch0_uvV0le6M66I1YKmw&oe=69AD55A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
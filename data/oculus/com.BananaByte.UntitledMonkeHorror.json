om/v/t64.5771-25/75269157_1054153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4FWFGYRozIQ7kNvwHrjZ0O&_nc_oc=AdroPyv_QLrSs_UJcucrIyhzKRe27CRgY_TS-sqfxx8G1Fw2yyh_n6UQ58lSx3HKZBM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVvUyVVFbkcAWTdfOmEnmkgRtNSHC844ooVwJoWpD73Q&oe=69C67B86"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc8ByudBagIQ7kNvwFm9WGx&_nc_oc=AdrnTABv9Wb3mc1VfZYs1V9nZ5IA4wg6OTuyVgzCjAas4jfl2F9xzlFKZIC_H-Jgqc8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCaANWD18onyG5530l0hxSTflrAnZzulgzSw3QTSBXqQ&oe=69C671B3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdXM_mMj5F4Q7kNvwFHCC91&_nc_oc=AdqWhlxwngLpdPBQSQOAHbAcPynBg_OW6qKOOtj23ZJZSoMleWeH14-PzkMaPXHvsHY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbdB8m-i2lW3VmpDpXE_5ZpKihhuHGe4c7iZNZNbHYdg&oe=69C694CD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HksK9JdtEkQ7kNvwGNr_7a&_nc_oc=Adqnn3OPztVgX0hIIL5Jw7f1MX3AxkiZC3SFMd0_ih372oHiIvw_4C9SXlcK1pzjHBk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJ8MgnV3hjArMGm4gsrIM_KKuKMeiRfnPHubU14nbnzg&oe=69C663DB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd_arZk3xp4Q7kNvwE7-FJi&_nc_oc=Adqyzm8Al6qKuGqCRyNBhmk_sx_37pu9mBqvLBUAb4yGaXyQQPSDRV1nEx3mNWD1CKc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwX0L-toAAdzwslw6K_yKcGaBMJObdTr2u7PO8DhHSnSw&oe=69C66221"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED
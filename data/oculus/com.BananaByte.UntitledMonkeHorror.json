om/v/t64.5771-25/75269157_1054153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhZfNL1ZgjEQ7kNvwFlvDn-&_nc_oc=AdqRmRsRKa-Y91hPm6mi1CDYJpvbSRl13SdxC8GafNowyi-AnLTpqEDaS0dsW7NDzMc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7z1u2ii52KuKA7QX_PYekn8Mt4LMh0KUPNqVEoE96pA&oe=69C28706"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8raK_XdZq4Q7kNvwHuEbTa&_nc_oc=AdrMK8sWzUTLUw1T9kOvy5M0gsTJGEie2KcEJHREmaacqP64iWi4VTNAidoE3zlDWdc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyjKv9fEnw3XS5-K-3z9_yegonqGznloi8oBajLEfaLQ&oe=69C27D33"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC_MVoYRDxsQ7kNvwHh18y5&_nc_oc=AdqtvD_NaPGP57eUisLpvB3YFH5K8YtwQYdhFvOF1S3CB3aN8RY7j5iuUQpKVu1G3q0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlnuqxdOrV01aRY9Hx0F3SaJSsSTVTljDx36BC2uG-_w&oe=69C2A04D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6zOxZ-a0WIQ7kNvwGZvGFs&_nc_oc=AdqE19b1ALIFIiR6r67fc64Pls1pMTI_fXWFZvloqSAOJ2NpMtAN3Hjd1UfWY7RZ4F0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWL-FCz7ylmOifl-IvXHMa5EKluxXuovIO735_fdVm7g&oe=69C26F5B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5-1FwHIpdYQ7kNvwEe59RD&_nc_oc=AdpfkgodPLXSHg89WVDaEgh1O3cKobqXXXCJu0UIgMTmQ2jdLzuagfichHZvtxbU0_Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyn528GpHojV_L_J4S1RpqeG_occBzSzR1B30OtzwlP6Q&oe=69C26DA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED
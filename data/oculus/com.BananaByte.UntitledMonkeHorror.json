54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h2tUOAIsIgQ7kNvwElGoMg&_nc_oc=Adl78YvMCioQ12KKMH9l4tqNVcFJamVxq1z60nNkA7neUeHtQSP1eN259DJBULr4lrM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6lngv1e2Umnue3vlE87m5C8a3FTPfxK9xqMR4UwSAEA&oe=69BE9286"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AD7ZgnQsf8Q7kNvwGrXHxs&_nc_oc=Adk_YvGbNISV-Qj28COLiFGZn1LKqTGm1Xdrk4hPfjfU-r-N4vXkHGpSva59rkDjNeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFk791658mWj4TPGquZOsrcZplAdvNvaxkcYpXQzF7kQ&oe=69BE88B3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zPO2Tvrd7wQ7kNvwEYz1zk&_nc_oc=AdlQRM1gd4toRInGIf2-Lzb-pVXe8SOiuiQSXaZpD3w4awz9rwX82QaVNtigtgMtX60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaM1Cz-dHNy4zRbDIhILlPM4caTJMTvX0vKot7jyMrgA&oe=69BEABCD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RZy_OKH7DYQ7kNvwEbmI8A&_nc_oc=AdmZUBKBPbwQEUmm7B9RYvDcS6cIZG87qj4i6xhvYDQ1gxNsF3cLoal3pNYs_1m2K_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzL_dWRzOhKWvIeUiVb0mOF6f5803ICu2UHL3Wh8N5pAQ&oe=69BE7ADB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHvcG9e2w9YQ7kNvwGnRdIv&_nc_oc=AdnRtHmoSOBO3a1WUbAuuRF380G1O9eqtpfk3rioqulupVJdQZqkXeveF6Bsk9yl68I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4xUwMiE-EUk8mfBldSsKxZl9ch67hh6iJmqwoqE_pfw&oe=69BE7921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
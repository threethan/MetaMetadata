54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVWrHHdPCooQ7kNvwFz0cax&_nc_oc=Adn6OhGPGYKjUDPYZk6wKDGjhIZn0tUnxD5iiUFLS0ds-FapHQtSyX0jPcqCAv-ns4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxBunbxJRHH1a_SjeTIln43eojoyw6Kfa06UMrApmdQvA&oe=69B2B506"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRtlkZFLN9EQ7kNvwHUvMn9&_nc_oc=AdlyVQt-VcIOrZ31FRCdPMV6TaspY4oCXRrTbv81-yCNjpT94pxWuWCkDcuFLuXTOR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyCabxrQmK3FGznm07jiDjyLUMY9iNAsAj7oVnMccE81A&oe=69B2AB33"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1766rT_fTAQ7kNvwFsw2PG&_nc_oc=AdlhNAQDiTt9ZAod5p0iwOXoWIVkWSdwU0k38WyY4ru0d7K3iQUgTBl_dLe8sTvoJuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6hS75cRczycbtC9T9o0suT9KnmL6DxwhJ3p4oTrMBYg&oe=69B2CE4D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfeK3s2-fGEQ7kNvwGlv-90&_nc_oc=AdmV0geS7_5wkDXpiLYGB8I2MlB78F8w-FAMDfzurVNYuHSI8PlpB-l0xuRvX9sd6ug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS2-hCJBdmOaviXuRoR_ygN_VnIhn3GSk6AqaswxI8IA&oe=69B29D5B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jdveqV0scAQ7kNvwHpVj19&_nc_oc=AdnS6QO7GjyoYy0mXfaZ-ceBw_obN9OU8wQlQyDoR_erZeVaMCvdMxW0AMa8_rYF9AM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6ZK9jciQBYO9Q7W5SYYlmMKlzb_pVbg45Prtxzco0pg&oe=69B29BA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
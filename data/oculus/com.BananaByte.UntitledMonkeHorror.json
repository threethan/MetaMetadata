54153052515720_526367900054785146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beTun3Y950wQ7kNvwGmz8Ij&_nc_oc=AdkpI9yXCYD38FBDvDzVOjz-h6OxewodlefX-mj7Ic6EnQI_9jRuIl7GmGAyiX1Ga4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVfnBIFbUfEes1OCHF8P875_DBA_pLCVvsTW7eG1QI7w&oe=69AC1D86"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8hhvOgKVZ8Q7kNvwEs8IoO&_nc_oc=Admt-XfXUWE1wkb2v4EHXTwLvD07Mk2GFhMlJIiwBGbqT4DiNR-IM7WslAPLC-VZOzw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxnHrcmGTk_qTUB9xGCAXEGKA35GyaQPpt7bSd3wMMwQ&oe=69AC13B3"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U16MbgWIuWYQ7kNvwGcS0sw&_nc_oc=AdkRW8iD1sAFD1g5jfBy4PY2NNzVAsoaYAZKtxcacmL4jMgZZdm7hnFXLA96q4qVudw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjutDRRCziguN9HDrs_kbSaKtlAGhJtnoe3ZAKLxFB5w&oe=69AC36CD"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGledirXGkgQ7kNvwGKt574&_nc_oc=AdlIGDl9IoLWBcMXTIRIQkHki2Af6zH-xvUp-3RmtMgxu5DU8TIufFFc-SnsT0nGzlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsvZ5ZiItJ497lHkENsNES9ijIR5Q76Uvf663bcME7Hw&oe=69AC05DB"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByXVTgC6spkQ7kNvwGtbcTo&_nc_oc=AdlyJr5UbA4DE6cDMU2IjQJbICSM5xrI5Rv5DvLIR_4tRmGO25PdP6mTeKxrCnB5FFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIrc3DC3cshQ7b1zmkn8mBRdwBjLK33g_RYkw-W-hzkw&oe=69AC0421"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
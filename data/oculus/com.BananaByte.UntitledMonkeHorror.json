_sid=6e7a0a&_nc_ohc=BcHjxS6v3cMQ7kNvwH8zcGH&_nc_oc=Adk7jAArvj-dVLUWXjJvqEOCfWgVJTtQ1SIOrMPW4H7ngTjcFBe0T_mFbE_06ZUsWzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuhDtHWtzuM_NnoByuCrPLSFBO7hnhqKEyBhSnfOx1goA&oe=69A04006"}, {"file_name": "Screenshot 2024-01-21 182514.png", "id": "1061960988288768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269157_1061960991622101_5018396444982955493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s8YS2LexYEQ7kNvwEggLMG&_nc_oc=Adkg_Jwawwd6CZEDd_hE1aWPxhyI3_ALcrk3BhGbaNwzHRWpQ51dKal-h22cbbmb9XU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsSa0SQbIjXk-1BjTZo_hnZmEVqAOrQz7_2TCODXHifJw&oe=69A03633"}, {"file_name": "Screenshot 2024-01-21 183542.png", "id": "296130173456121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_296130176789454_3661379975453254209_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBhNs05XcYIQ7kNvwGidklh&_nc_oc=AdlFX7NDa2JmmM2G_tL_GuPff8pWHo7UE2OKxFMLjsmVdQIB3PSv5A2kyV1mtTPCecU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuji-R2-aTqBJFO97dQVvMG0DaBOFjm2AO_FqgfxlpJ_w&oe=69A0594D"}, {"file_name": "Screenshot 2024-01-21 181142.png", "id": "1416929152296153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1416929155629486_520440112351038313_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttke3tuK-_oQ7kNvwFOZIPk&_nc_oc=AdkAO_h2f3UOcizviT2rgmp_rFnEA6bVf5_CHfTpE9DBRG-UPqmd96iNpPeBPwV-RH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVeqo6M_k5L5r-lkYdKhchJ8jA2Z-v1Y_dlkpIy4dkwg&oe=69A0285B"}, {"file_name": "Screenshot 2024-01-21 180457.png", "id": "7271830109522665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_7271830116189331_463600548221948224_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldYggwV06qcQ7kNvwGBeJ3G&_nc_oc=AdnFm-_Sge7a87pBlZhDHiNb_W09rdpNZvrJrcN-gIXSqudYjRhzfHEfYMJHsHa6c2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsPbkUox3pJpnDhlqhXSkb3yFmmpE07ybLF_XSjHRI3Kw&oe=69A026A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape dark mazes with deadly puzzles."}]}, "developer_name": "TheEvolutionVR", "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BananaByte Games", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
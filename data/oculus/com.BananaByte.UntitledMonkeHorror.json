USLROCV8OeKjbn8WRYHabE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpw0on4mgufQCS9o3fAtms0Hbe7BdNzHTjOyJJDAgRjw&oe=6A9C1631"}, {"file_name": "Screenshot3.png", "id": "870629811374449", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035458_870629814707782_436608896590677092_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqw7GzIQ2LYQ7kNvwEbZq37&_nc_oc=AdoZnHcAD9ag8GlQKFKtoW2nsuceD2SRjlBIyNbVa7wpQoHskmGgMdVRUPvzcnV6qNM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhKFPnKTTyLKP7pWSv8tyeWJ0dwRjkvutiwrL89KVTog&oe=6A9C0F30"}, {"file_name": "Screenshot4.png", "id": "328567173257863", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001655_328567176591196_7814056610848427289_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCoHs-9We64Q7kNvwG68Ye1&_nc_oc=Adq_GdJqbxOB7OT9eseGX8YVAEomnqBvjhvVAXj0jnawQXpHcBaXHH2wykaGiyFKGSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDOVP2tvrbOrZSfRdXQNb-lB-6Pn1cxGd99Gze_ruUMA&oe=6A9C3D96"}, {"file_name": "Screenshot5.png", "id": "6863860090391040", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_6863860093724373_161777200461273615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1tOFJ4wmqUQ7kNvwHGSxC1&_nc_oc=AdpimdxFhvxrF_oel5MKI6qu-ljcx1RRFFr4fNrjl_yU-ylSZTcvJBqpfLK0WPrsu5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAlIqikAjLDkacouic9x1kdMpVPh-qKcHkGCZLFaLPBw&oe=6A9C1C7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Monke Horror", "keywords": [], "long_description": "Embark on a spine-chilling journey into the unknown with \"Untitled Monke Horror,\" a game that plunges players into the depths of a haunted jungle. As the protagonist, you must navigate through shadowy landscapes, each fraught with ancient curses and spectral adversaries. The jungle comes alive with eerie realism, from the haunting rustle of leaves to distant, unsettling howls. Immerse yourself in a world where survival depends on solving intricate puzzles, uncovering the secrets of the jungle, and confronting fears that lurk in the darkest corners.\n\n\ud83c\udf32 Jungle of Mystery and Terror:\nThe game unfolds in a meticulously crafted jungle environment, where atmospheric sound design and realistic graphics combine to create an immersive horror experience. Trudge through dense foliage, explore forgotten ruins, and brace yourself for the unexpected as the jungle reveals its ominous secrets. Every step is fraught with tension, and every shadow hides a potential threat. Only the brave will unravel the mysteries and survive the night.", "short_description": "In this game, you are a brave primate, trying to escape deadly mazes with deadly puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bananabytegames.co/untitled-monke-horror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IntelVR", "support_website_url": null, "website_url": "https://www.bananabytegames.co/untitled-monke-horror", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24306282179020462"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary",
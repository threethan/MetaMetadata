-A-woC5LHV8VmbDS9dgS4M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy0YY5LsNHOx7Ca0IG9antUcbK7M5Kn0b-VcD11-5X4Q&oe=6A916B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape (2).png", "id": "1346744693720799", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499623384_1346744697054132_6452139581552407477_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbaUBo9brB4Q7kNvwHaiie8&_nc_oc=AdrAUd6oYcEUo_SYdcFys_tz790uDbOjaTZC87mUivFEz9zl2e6f5DznXj98npHRDXc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYlo1X6C41gVoMgCCB2qoF7GDG3EEGDwg8HuGRU9pIjQ&oe=6A916A18"}, "display_name": "Zombie City VR", "keywords": ["survival", "shooter", "Horror", "Action", "Battle"], "long_description": "Zombie City VR throws you into a world overrun by zombies. Your mission is simple: survive.\n\nFight through waves of zombies, each with different health, damage, and abilities. As you progress, the enemies become stronger and more dangerous, forcing you to improve your skills and strategy.\n\nAt the end of your journey, you'll face the Final Boss\u2014the most powerful undead creature in the game. Defeat it to win and save yourself. Fail, and you'll become another victim of the undead.\n", "short_description": "Zombie City VR is an action-packed zombie survival game where you fight endless waves of undead. Defeat powerful zombies, survive as long as you can, and face the final boss to escape victory\u2014or die trying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zombiecityvr.noodlzxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oneimmersive", "support_website_url": null, "website_url": "https://zombiecityvr.noodlzxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}
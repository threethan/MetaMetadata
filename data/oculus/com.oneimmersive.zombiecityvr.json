45252303241971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1645252306575304_4122831453327456500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gcFA5VmDTMQ7kNvwGCvbX9&_nc_oc=AdqrnFjed4yz35QoNkYEtGQUkT_Lhermn-cTvPJ9URsplPUVth-tvDIqwpPDLcddauU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGKewOZHGiJpG0ThMQnGB62ba3QgDspvMKmGB1heXoyg&oe=6AE9F7FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape (2).png", "id": "1346744693720799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_1346744697054132_6452139581552407477_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YLONeJv8VsQ7kNvwGv6Jht&_nc_oc=AdoNdMAS7lJIne0dkPwtWIREYVw55a1462M6Ag6Ryga7H-Hma7q8Kwq7i-oMmP_aefw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStrTRnk2is-Em33g7YmtVcGvJTN412fqGLy9p3qvr0_w&oe=6AE9F6D8"}, "display_name": "Zombie City VR", "keywords": ["survival", "shooter", "Horror", "Action", "Battle"], "long_description": "Zombie City VR throws you into a world overrun by zombies. Your mission is simple: survive.\n\nFight through waves of zombies, each with different health, damage, and abilities. As you progress, the enemies become stronger and more dangerous, forcing you to improve your skills and strategy.\n\nAt the end of your journey, you'll face the Final Boss\u2014the most powerful undead creature in the game. Defeat it to win and save yourself. Fail, and you'll become another victim of the undead.\n", "short_description": "Zombie City VR is an action-packed zombie survival game where you fight endless waves of undead. Defeat powerful zombies, survive as long as you can, and face the final boss to escape victory\u2014or die trying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zombiecityvr.noodlzxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oneimmersive", "support_website_url": null, "website_url": "https://zombiecit
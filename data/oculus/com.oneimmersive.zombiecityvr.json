 face the Final Boss\u2014the most powerful undead creature in the game. Defeat it to win and save yourself. Fail, and you'll become another victim of the undead.\n", "short_description": "Zombie City VR is an action-packed zombie survival game where you fight endless waves of undead. Defeat powerful zombies, survive as long as you can, and face the final boss to escape victory\u2014or die trying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zombiecityvr.noodlzxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oneimmersive", "support_website_url": null, "website_url": "https://zombiecityvr.noodlzxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1272422519286325"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3443375075834606"}]}, "baseline_offer": {"id": "3443375075834606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786335600, "status": "PUBLISHED", "id": "3443375075834606"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1295616393633604", "version": "1.0"}, "id": "2117629035816168", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
e Dragonball? Yes you can!\nIf you jump, the acceleration sensor in device detects your motion and you can see the high place like super jump."}]}, "developer_name": null, "developer_privacy_policy_url": "http://warapuri.com/", "developer_terms_of_service_url": "http://warapuri.com/", "publisher_name": "warapuri", "support_website_url": null, "website_url": "http://warapuri.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "ARCADE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ru", "zh_CN", "zh_TW", "ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "441222814450595"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1342968225736129"}]}, "baseline_offer": {"id": "1342968225736129"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1479319200, "status": "PUBLISHED", "id": "1342968225736129"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2415777728452689", "version": "1.1.0"}, "id": "172681493178849", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1285913318105808", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2415777728452689"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "172681493178849"}]}, "change_log": null, "creat
53D"}, {"file_name": "migrated_image.png", "id": "218724412826164", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12386220_332980177095285_1762587284730806272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHEXvnRKUv4Q7kNvwFA-4Om&_nc_oc=Adr3MaWOaX1euNyQmnXcqDNvgw8DFLkccPk7AXxxjo7b9o8zQKhQcIj2j8JYQH9yFEA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFycwMjw53PD4Jfk5ONN_eU2OHYBQEzTbdAPRDGDw0gg&oe=6AA94D82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS_Gunkan.png", "id": "723717864450710", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12482403_723717867784043_6309615297821147136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4F7NbyePsUQ7kNvwGyIKE0&_nc_oc=AdqtSCLTqjLtPpl0tGeQ3wjY-1nPkq_y1a2RSZz_8mSbNTnDIwtl-VRj680kCOi-n_A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITVEIJZalYQ99WnqQQ3WJZ6EY7f66swP0tJ5hj9mTMmw&oe=6AA94F93"}, "display_name": "VR Jump Tour", "keywords": ["Jump", "Hiyoshi", "Dragonball", "Gunkan"], "long_description": "Do you want to jump like Dragonball? Yes you can!\n\nHow to play\nIf you jump, the acceleration sensor in device detects your motion and you can see the high place like super jump.\n\n\nThis project is collaborated with\n\nMasahiro Furukawa (Osaka University)(Hiyoshi/Aso),\nMHD Yamen Saraiji (KMD)(Hiyoshi),\nYohei Yanase (Unity Technologies Japan)(Hiyoshi/Aso),\nHiroyuki Kajihara (Mount Aso Ecomusee)(Aso),\nSAKAI Yosuke (YCAM)(Aso),\nShun Kubota (MoguraVR)(Iejima),\nMasataka Kohagura (IGDA University of the Ryukyus)(Iejima),\nMasahiro Kurokawa (Backham Co., Ltd.)(Okinawa),\nTakashi Nakamura (Kanagawa Institute of Technology Japan)(Kanako),\n\nGunkan Jump\nThis video was taken by special permission of Nagasaki city.\nCooperation: Toshihiko Tanaka\n(Nagasaki Institute of Applied Science)\nShooting: SUNCOH CONSULTANTS CO. , Ltd\n\nMade by Makoto Ito (Unity Technologies Japan)\nwith Unity.\n\nIf you want to add your recomendation area, please contact me.\nE-mail: pg.makoto.itoh+vrjump@gmail.com\n", "short_description": "Do you want to jump like Dragonball? Yes you can!\nIf you jump, the acceleration sensor in device detects your motion and you can see the high place like super jump."}]}, "developer_name": null, "developer_privacy_policy_url": "http://warapuri.com/", "developer_terms_of_service_url": "http://warapuri.com/", "publisher_name": "warapuri", "support_website_url": null, "website_url": "http://warapuri.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "ARCADE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ru", "zh_CN", "zh_TW", "ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "441222814450595"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1342968225736129"}]}, "baseline_offer": {"id": "1342968225736129"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1479319200, "status": "PUBLISHED", "id": "1342968225736129"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2415777728452689", "version": "1.1.0"}, "id": "172681493178849", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1285913318105808", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2415777728452689"}, "release_status": "RELEASED"}, "binary_relea
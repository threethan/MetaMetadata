dn.com/v/t64.5771-25/491831299_1078702211692786_4809099552490236397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdWdsAzf3VoQ7kNvwG9hGD8&_nc_oc=AdrFWW-G_Vj3449ARTMRZomHwU1t0tMquJSmJCYWt2YgfKDVM05kUL2z6xDWhpxJ6Vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREUWzbwIhoLQXWcxQy66J23oTQn2yA-MLrZ3fYZc-_Qg&oe=6AF8AC31"}, {"file_name": "EnergyCapture_Screenshot_2.png", "id": "945806491300014", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604370996_945806494633347_1735515609512017688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsEKzdmVkgwQ7kNvwHjFOUj&_nc_oc=AdqUJcrxsqEbl4cAGEtc07TLwzzoRn_F2eiaJGCNY0fJzSF7xiiICNyU19_XFM62cdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5WComyC7uhxfZqeTn4FPXwvERMr-YxX2yo-cRWJ5gWw&oe=6AF883B2"}, {"file_name": "EnergyCapture_Screenshot_6.png", "id": "1106008985180024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1106008991846690_3897749204414991384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORppk4WwptYQ7kNvwHxVuWN&_nc_oc=AdrlZkoWm6w_wziNPQYkdsoe1f51eIctHrSvd1vNUPFSPpO18WJUoRLM1oAbswTH2QM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShhPLP2Mus4d0Njnn9xupE6cK7y2sOZiQTqG0M1Kp7uQ&oe=6AF89725"}, {"file_name": "EnergyCapture_Screenshot_4.png", "id": "1791616025598071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596149727_1791616028931404_1267916811905490313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewYSe3p9kI4Q7kNvwEa4iWG&_nc_oc=Adqf2FIm61-Sj2nF2T64u8Bht_C9Lxkir6WlVjNqiTjsSY9PyOczV44qiZsOAzNDoEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl2yCE4v2MAArAKWkE3pUVoeJGHhWQryoQiDA2Mzhm5w&oe=6AF8AA1C"}, {"file_name": "EnergyCapture_Screenshot_3.png", "id": "1092246750439301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830822_1092246753772634_1992212529858592446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrrdwtTk7WIQ7kNvwHAnspJ&_nc_oc=Ado3QUNt0CpfA8EgxCmaHI3jtnTaODPerHaDf2sfVux5ECx9vE12816r6n2QvYeSBhU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDDJqd4lTm88LawNrZpqe5gX_dCfoJKc5CNzqAozs31Q&oe=6AF8A2EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EnergyCapture_Trailer_thumb.png", "id": "2091080054812607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2091080061479273_7545551049302218513_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppSgbRdRBPkQ7kNvwGir__3&_nc_oc=AdoJX3aC6CJvxHOp5YJv7JQE3xms_Z5nygrx8MSdv7sLRwrJCd59ACE0IziZUZyeTnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQElk_hyS2Pw21Vz3RBM0J-NsRvWb2KArsQJPzC9dvpGA&oe=6AF89357"}, "display_name": "Energy Capture", "keywords": ["Renewable", "Energy", "Solar", "Wind", "Hydroelectric"], "long_description": "Designed for the Mishkat Interactive Center in Riyadh, this VR experience lets you explore how renewable energy works through hands-on play. Step into three interactive mini-games and learn the basics of wind, solar, and hydroelectric power.\n\nWhat You Will Do\n    \u2022 Wind Energy: Grab a wind cloud and direct it\u2019s currents toward turbines to generate electricity.\n    \u2022 Solar Energy: Turn solar panels to align them with the sun, and send out a cleaning bot to sweep away dust for maximum output.\n    \u2022 Hydroelectric Energy: Take control of a hydroelectric dam by balancing gates to regulate water flow to adjust power supply to demand.\n\nHighlights\n    \u2022 Direct VR Interactions: Physical controls \u2014 poking, grabbing, turning, and pulling\u2014built to be intuitive for young children.\n    \u2022 Accessible Learning: Understand key renewable energy concepts through active gameplay without complicated jargon.\n    \u2022 Child-Safe Design: Fully ad-free experience with zero data collection.", "short_description": "Embark on an immersive VR experience where you harness the power of renewable energy sources in three interactive mini-games. Direct wind currents toward turbines, align solar panels with the sun, and flip levers to control water flow at a hydroelectric dam. Discover the fundamentals of renewable power through simple, hands-on interactions designed for young learners. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bk3d.de/ECPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "BK3D", "support_website_url": null, "website_url": "https://bk3d.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1094741187064958"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1062711959990160_4043143180706632094_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4JuDfxDLd0Q7kNvwEfiszO&_nc_oc=Adrxq8uhlPTQ9ICSIgtbwY4hyhYZQAOyjEV82ywv0GJvEW2_gwdw6ZSXR7DHrkWghN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO0wCfq87-WYcLDETb2VOpRFBvDQkk_MInHAMrgAE6fw&oe=6AF8A4CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Energy Capture", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date":
I4Q7kNvwFVEJcD&_nc_oc=AdqzKjl3b_hDInw1swGIv3BxPZEcp3pVHkqFCpAB_KLNyzs_4ZNurbXOuZBAb-BmmYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStB9ECxTTyo4UAY75DRc7NGSvJqbgshgrs1NP123XxJQ&oe=6AF7205C"}, {"file_name": "EnergyCapture_Screenshot_3.png", "id": "1092246750439301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830822_1092246753772634_1992212529858592446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lUY4QaPthEQ7kNvwHx_a2R&_nc_oc=AdogO2RrPbU-VHgdqXZWebO45b8rY4ttZ0am60EhLzQMUieya4LAY1gwXTtcGTnbYDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFluJa0P9tQxNTYBNyTIkrXxCaVx6P8Inh_7STIxouCw&oe=6AF7192F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EnergyCapture_Trailer_thumb.png", "id": "2091080054812607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2091080061479273_7545551049302218513_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppSgbRdRBPkQ7kNvwEgTEwF&_nc_oc=Adr4TSL-q7z1ftGW7mFcwMdd4-vv6JQfktsotFA5sijXp2dpnXbjXSxDbuDEK3cxUzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMwLIEWj5_UNFQKWtnvStRcfangK3JSR-zzlDb0EFtig&oe=6AF741D7"}, "display_name": "Energy Capture", "keywords": ["Renewable", "Energy", "Solar", "Wind", "Hydroelectric"], "long_description": "Designed for the Mishkat Interactive Center in Riyadh, this VR experience lets you explore how renewable energy works through hands-on play. Step into three interactive mini-games and learn the basics of wind, solar, and hydroelectric power.\n\nWhat You Will Do\n    \u2022 Wind Energy: Grab a wind cloud and direct it\u2019s currents toward turbines to generate electricity.\n    \u2022 Solar Energy: Turn solar panels to align them with the sun, and send out a cleaning bot to sweep away dust for maximum output.\n    \u2022 Hydroelectric Energy: Take control of a hydroelectric dam by balancing gates to regulate water flow to adjust power supply to demand.\n\nHighlights\n    \u2022 Direct VR Interactions: Physical controls \u2014 poking, grabbing, turning, and pulling\u2014built to be intuitive for young children.\n    \u2022 Accessible Learning: Understand key renewable energy concepts through active gameplay without complicated jargon.\n    \u2022 Child-Safe Design: Fully ad-free experience with zero data collection.", "short_description": "Embark on an immersive VR experience where you harness the power of renewable energy sources in three interactive mini-games. Direct wind currents toward turbines, align solar panels with the sun, and flip levers to control water flow at a hydroelectric dam. Discover the fundamentals of renewable power through simple, hands-on interactions designed for young learners. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bk3d.de/ECPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "BK3D", "support_website_url": null, "website_url": "https://bk3d.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1094741187064958"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1747435589865025"}]}, "baseline_offer": {"id": "1747435589865025"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790010540, "status": "PUBLISHED", "id": "1747435589865025"}]}, "liveChannel": {"nodes"
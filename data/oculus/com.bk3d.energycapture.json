dn.com/v/t64.5771-25/491831299_1078702211692786_4809099552490236397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZcOdmxEZBAQ7kNvwE-iP7R&_nc_oc=AdpiaA7fapQInTaDcKoCPBUqhs1Snl4eaj12dL5aPD2FPq4GXdJE4RqxeScEb9vankA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNwqriDqv7k7ZsYM3-JDFlVgDIVg33Dpb6I9kxVlgPUA&oe=6AF32DF1"}, {"file_name": "EnergyCapture_Screenshot_2.png", "id": "945806491300014", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_945806494633347_1735515609512017688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkEVIDaIpHYQ7kNvwFyKzJ-&_nc_oc=AdoHbtgXxrUqFtjClZseNb-aFsS4odh7PwpjKvm19BuOU821UQ73ptX5C2i_C2buZ5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0co7UMYRBxkSnFs4BWJKbM6rA9XwdJbkXykoG72oPVA&oe=6AF33DB2"}, {"file_name": "EnergyCapture_Screenshot_6.png", "id": "1106008985180024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1106008991846690_3897749204414991384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ws0RMn-muMQ7kNvwFHp4hB&_nc_oc=AdpfA_HjpiMCbYs7XMZ5aFqjGJvBvPzSqFPLgGk-KlOULi33Rf0Kp8e1FtUS_t7WTBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIPXGJyJf5Alkt6n4a6LX7PGOymD5YeJ4ow-D1EqeUIw&oe=6AF35125"}, {"file_name": "EnergyCapture_Screenshot_4.png", "id": "1791616025598071", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_1791616028931404_1267916811905490313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Abo1a9CDdFcQ7kNvwFmMipG&_nc_oc=AdpIqecaKC3jzv3Og3rwIY2nQFujEcPC4T1wQ0IsSseTvrmC3-rdigcauLBqxoYVh8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4AoLuCw7aj35clcMuL3oztiX3oQV8sKL4AfoG34FEDw&oe=6AF32BDC"}, {"file_name": "EnergyCapture_Screenshot_3.png", "id": "1092246750439301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1092246753772634_1992212529858592446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhlI-GUealIQ7kNvwG8dZFN&_nc_oc=AdplyrCS1j4eFIhWvGH3kzkh0A9B9NjT5eMv2rFNW1sbo2oUXoNGL_VwYUCHCCSeLXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYunwVMyfDUM5L0bAYrbopVymAfq5SGUkf2Wpm5ILghg&oe=6AF35CEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EnergyCapture_Trailer_thumb.png", "id": "2091080054812607", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_2091080061479273_7545551049302218513_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6gn20uF3EwQ7kNvwFdEZSn&_nc_oc=AdrOd2l_OkpYUW9zRwAmYn9YhQeITa3hyXgGfTVL0pqek0CXbZQROrSR9LVHGyGFpPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk3qDqOkFnpojPjml0l6TZmk5IfUrbCnOdYEqv_K7Y0A&oe=6AF34D57"}, "display_name": "Energy Capture", "keywords": ["Renewable", "Energy", "Solar", "Wind", "Hydroelectric"], "long_description": "Designed for the Mishkat Interactive Center in Riyadh, this VR experience lets you explore how renewable energy works through hands-on play. Step into three interactive mini-games and learn the basics of wind, solar, and hydroelectric power.\n\nWhat You Will Do\n    \u2022 Wind Energy: Grab a wind cloud and direct it\u2019s currents toward turbines to generate electricity.\n    \u2022 Solar Energy: Turn solar panels to align them with the sun, and send out a cleaning bot to sweep away dust for maximum output.\n    \u2022 Hydroelectric Energy: Take control of a hydroelectric dam by balancing gates to regulate water flow to adjust power supply to demand.\n\nHighlights\n    \u2022 Direct VR Interactions: Physical controls \u2014 poking, grabbing, turning, and pulling\u2014built to be intuitive for young children.\n    \u2022 Accessible Learning: Understand key renewable energy concepts through active gameplay without complicated jargon.\n    \u2022 Child-Safe Design: Fully ad-free experience with zero data collection.", "short_description": "Embark on an immersive VR experience where you harness the power of renewable energy sources in three interactive mini-games. Direct wind currents toward turbines, align solar panels with the sun, and flip levers to control water flow at a hydroelectric dam. Discover the fundamentals of renewable power through simple, hands-on interactions designed for young learners. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bk3d.de/ECPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "BK3D", "support_website_url": null, "website_url": "https://bk3d.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1094741187064958"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1062711959990160_4043143180706632094_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuxVlH1noMIQ7kNvwG2-X8p&_nc_oc=AdqJHNQ4wig9-h6TbhHNCgOYQAXbCiDzvr6M3GWLEX4PdIBGnqjzTEAUdnWaeo0TUnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOQWqR-QBXbnkPfJxzbndd76XtvUM8TOrgs9rsLfHoTQ&oe=6AF3268F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Energy Capture", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date":
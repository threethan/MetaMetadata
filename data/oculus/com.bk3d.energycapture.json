xArEw&oe=6B0DC21C"}, {"file_name": "EnergyCapture_Screenshot_3.png", "id": "1092246750439301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830822_1092246753772634_1992212529858592446_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUfRoYZlFycQ7kNvwHLpSsl&_nc_oc=Ado_rvmdlEzw88FWZ32j79Tja6fmTWeij8WaNT11k1b_nEMxcqjs0lSqh8wzahFUCLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_xnm5uNdHo_P3pw2ocFEq03U6EmtAVhbzf2zf5PRR5w&oe=6B0DBAEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EnergyCapture_Trailer_thumb.png", "id": "2091080054812607", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_2091080061479273_7545551049302218513_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5XDRiojwOQQ7kNvwH1q1q6&_nc_oc=Adoc81gJt2qmeUPoG-vArpF82vQNhAKY_mJGUVQN4r_KnUj2Y1xhvnH1n7yuuiQeMWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMl6jBGmPG-WBhNNABQWAuJk-_aySFZ6yjdMAFOnhdyg&oe=6B0DAB57"}, "display_name": "Energy Capture", "keywords": ["Renewable", "Energy", "Solar", "Wind", "Hydroelectric"], "long_description": "Designed for the Mishkat Interactive Center in Riyadh, this VR experience lets you explore how renewable energy works through hands-on play. Step into three interactive mini-games and learn the basics of wind, solar, and hydroelectric power.\n\nWhat You Will Do\n    \u2022 Wind Energy: Grab a wind cloud and direct it\u2019s currents toward turbines to generate electricity.\n    \u2022 Solar Energy: Turn solar panels to align them with the sun, and send out a cleaning bot to sweep away dust for maximum output.\n    \u2022 Hydroelectric Energy: Take control of a hydroelectric dam by balancing gates to regulate water flow to adjust power supply to demand.\n\nHighlights\n    \u2022 Direct VR Interactions: Physical controls \u2014 poking, grabbing, turning, and pulling\u2014built to be intuitive for young children.\n    \u2022 Accessible Learning: Understand key renewable energy concepts through active gameplay without complicated jargon.\n    \u2022 Child-Safe Design: Fully ad-free experience with zero data collection.", "short_description": "Embark on an immersive VR experience where you harness the power of renewable energy sources in three interactive mini-games. Direct wind currents toward turbines, align solar panels with the sun, and flip levers to control water flow at a hydroelectric dam. Discover the fundamentals of renewable power through simple, hands-on interactions designed for young learners. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bk3d.de/ECPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "BK3D", "support_website_url": null, "website_url": "https://bk3d.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1094741187064958"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1062711959990160_4043143180706632094_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzKxhz8bjkUQ7kNvwEKAvHM&_nc_oc=Adoa64oG1wGMlBQSsWWGdrn5uZki1ECXAeOfpoNlWzW0F1B7_u6QqmoSlGFgHU98nUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUvjXopTqrXSCyj4a4Y
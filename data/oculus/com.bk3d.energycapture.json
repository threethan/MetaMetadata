dn.com/v/t64.5771-25/491831299_1078702211692786_4809099552490236397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdWdsAzf3VoQ7kNvwGjO3GF&_nc_oc=AdohZ9VADzeVXwFwe1yqdD4rEBoEhVithvw0WAZpQ_nzF7xCCRyqEA-agIfUCNg9mow&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn4TZH5DekAg3EjYb8-lF1TsoZxsnJ5d2q2cltPtxEmQ&oe=6AF9C571"}, {"file_name": "EnergyCapture_Screenshot_2.png", "id": "945806491300014", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604370996_945806494633347_1735515609512017688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsEKzdmVkgwQ7kNvwE5bcnO&_nc_oc=AdqPfI62UvkCxAkqvGhMxQ9Rzr4RRjqMom92VJNHMOTbKeO9wCW6LcBaOcJYp8Os5p8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz4QTPRlhjFPG-WDVN9bbeflOlRwwC9hHkO2PO4yDqxw&oe=6AF9D532"}, {"file_name": "EnergyCapture_Screenshot_6.png", "id": "1106008985180024", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595119480_1106008991846690_3897749204414991384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xQV8sVqSJ0Q7kNvwGVPP0A&_nc_oc=AdolwBCuaK6-OF3RHUCcdWM-gn29gtaT8bawwSHcUXcn19-bMxR4e7R79eL9BnPgy7s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTOLX0gH7MsF1bjqpb2Ql6MrebPMd77-FRhA8V1mQYIA&oe=6AF9E8A5"}, {"file_name": "EnergyCapture_Screenshot_4.png", "id": "1791616025598071", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/596149727_1791616028931404_1267916811905490313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewYSe3p9kI4Q7kNvwHzvyna&_nc_oc=Adq3NaMn3_j-tA9LON99hsBh7Ppwa2rUnbT7qkL4RkLIffCL8RzHaZokqcgnU5uXZ_8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZoxhwpA2gMIaL_tfWElAs3BEVr6Jue-xZ8qXJd9CXDQ&oe=6AF9C35C"}, {"file_name": "EnergyCapture_Screenshot_3.png", "id": "1092246750439301", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830822_1092246753772634_1992212529858592446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrrdwtTk7WIQ7kNvwHhyS0H&_nc_oc=AdpKmXLHfQV2BrKiF2cz25lqTVkL2GBKNPPEVhSMSMDC9ZTKYvFoUlQTAOYM0fxaII4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMxiTRWBnIS7xBecgyZUVGHBF2Sqe0b2hTbMLSGyOhhQ&oe=6AF9BC2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EnergyCapture_Trailer_thumb.png", "id": "2091080054812607", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823757_2091080061479273_7545551049302218513_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co1ltTxT-sQQ7kNvwEPlDKU&_nc_oc=Adr_0A9jW85pU-yZ0O5V6Z1NBFCtylmMOAY6JnBBj1DCKnANrzRRCDYPnMwanuzt72g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYL3iZXwhqe7xjvguQI5dXKpMUum-CXCuw0DUYvyEIhw&oe=6AF9E4D7"}, "display_name": "Energy Capture", "keywords": ["Renewable", "Energy", "Solar", "Wind", "Hydroelectric"], "long_description": "Designed for the Mishkat Interactive Center in Riyadh, this VR experience lets you explore how renewable energy works through hands-on play. Step into three interactive mini-games and learn the basics of wind, solar, and hydroelectric power.\n\nWhat You Will Do\n    \u2022 Wind Energy: Grab a wind cloud and direct it\u2019s currents toward turbines to generate electricity.\n    \u2022 Solar Energy: Turn solar panels to align them with the sun, and send out a cleaning bot to sweep away dust for maximum output.\n    \u2022 Hydroelectric Energy: Take control of a hydroelectric dam by balancing gates to regulate water flow to adjust power supply to demand.\n\nHighlights\n    \u2022 Direct VR Interactions: Physical controls \u2014 poking, grabbing, turning, and pulling\u2014built to be intuitive for young children.\n    \u2022 Accessible Learning: Understand key renewable energy concepts through active gameplay without complicated jargon.\n    \u2022 Child-Safe Design: Fully ad-free experience with zero data collection.", "short_description": "Embark on an immersive VR experience where you harness the power of renewable energy sources in three interactive mini-games. Direct wind currents toward turbines, align solar panels with the sun, and flip levers to control water flow at a hydroelectric dam. Discover the fundamentals of renewable power through simple, hands-on interactions designed for young learners. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bk3d.de/ECPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "BK3D", "support_website_url": null, "website_url": "https://bk3d.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1094741187064958"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823783_1062711959990160_4043143180706632094_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4JuDfxDLd0Q7kNvwFLxCs_&_nc_oc=AdqDNX1wRVtRR5mC_Ev5oEWGcx6ebG5uFTdrF8zgCyPZFKRIpfdNut_QPDt6HlycP4g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyld6ONOX5fdvCfG4afr1exqNbWI4FbdwEuekOqhqp8w&oe=6AF9BE0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Energy Capture", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date":
dn.com/v/t64.5771-25/491831299_1078702211692786_4809099552490236397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZcOdmxEZBAQ7kNvwHpdz29&_nc_oc=Adp_JsEfeTuhzF9nrlIXJHIv2TpuW_dsqAuqwvbpO43UEIlV8XgPj_FepOyS-1ZWgcw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0Do5by1z0REf2r6FMXgflwMyJ8atJhBeJhAl2DDykkQ&oe=6AF08AF1"}, {"file_name": "EnergyCapture_Screenshot_2.png", "id": "945806491300014", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_945806494633347_1735515609512017688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QLBQN1_kt4Q7kNvwHw0uXt&_nc_oc=AdqYztXoIghwzMq2XUjgEc8pm8G9ToLXeq4_K6GK2Ibmn92DR-C0S7j56pq4O9q_0B4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEtR8H7eTgWDYQlurqUtvs1f6x_YuruIsP6K9Qf64uQg&oe=6AF09AB2"}, {"file_name": "EnergyCapture_Screenshot_6.png", "id": "1106008985180024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1106008991846690_3897749204414991384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59KYLsE9P6YQ7kNvwGri8xN&_nc_oc=Adp8dCNGxs_sgSTeVnBDMVD_8HDsLx7i2Q76KuG1BaWKzKTcbgWQqh_ri28NFyDFixc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAZmaaZnzg5_o4NPGEea9QrWvOkRSZjpEefwt7JQhQAg&oe=6AF0AE25"}, {"file_name": "EnergyCapture_Screenshot_4.png", "id": "1791616025598071", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_1791616028931404_1267916811905490313_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzIYbLu9AZYQ7kNvwEfAaQ6&_nc_oc=AdriBpEzf_wnAGU20QoB4wqC0w6iFNbxUiZ_l3V8aUYbnOfpzk_XXKAzrtcR5Ex3MPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj2MLPMDpffqAPgVCqnNe31FzD848Ro0yS5rGg-dWNuw&oe=6AF088DC"}, {"file_name": "EnergyCapture_Screenshot_3.png", "id": "1092246750439301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1092246753772634_1992212529858592446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhlI-GUealIQ7kNvwGTKKbi&_nc_oc=Adr0fKHMXYaWW9kX5qWL6PQep8N0rwAvVBmU9Eo6-isivHlCl3-3tWggGFtgyTRUHkY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiyyMi6M-VBTCH1Anu_baugX43Zayp9LzuLPCSeDBPGQ&oe=6AF081AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EnergyCapture_Trailer_thumb.png", "id": "2091080054812607", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_2091080061479273_7545551049302218513_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjHO1U6dSE8Q7kNvwE0Sd11&_nc_oc=Adq1DCtE5Y7VWP6VAgY-2Q7JSxPDhGJbQ5OyMnr3EsVbLFcYJwQjAeJoeH8R1vJBzSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK_eatAtSdl_3EnR-mIQLMiNSgK6IbhSBs2Vr63R0-Rg&oe=6AF0AA57"}, "display_name": "Energy Capture", "keywords": ["Renewable", "Energy", "Solar", "Wind", "Hydroelectric"], "long_description": "Designed for the Mishkat Interactive Center in Riyadh, this VR experience lets you explore how renewable energy works through hands-on play. Step into three interactive mini-games and learn the basics of wind, solar, and hydroelectric power.\n\nWhat You Will Do\n    \u2022 Wind Energy: Grab a wind cloud and direct it\u2019s currents toward turbines to generate electricity.\n    \u2022 Solar Energy: Turn solar panels to align them with the sun, and send out a cleaning bot to sweep away dust for maximum output.\n    \u2022 Hydroelectric Energy: Take control of a hydroelectric dam by balancing gates to regulate water flow to adjust power supply to demand.\n\nHighlights\n    \u2022 Direct VR Interactions: Physical controls \u2014 poking, grabbing, turning, and pulling\u2014built to be intuitive for young children.\n    \u2022 Accessible Learning: Understand key renewable energy concepts through active gameplay without complicated jargon.\n    \u2022 Child-Safe Design: Fully ad-free experience with zero data collection.", "short_description": "Embark on an immersive VR experience where you harness the power of renewable energy sources in three interactive mini-games. Direct wind currents toward turbines, align solar panels with the sun, and flip levers to control water flow at a hydroelectric dam. Discover the fundamentals of renewable power through simple, hands-on interactions designed for young learners. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bk3d.de/ECPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "BK3D", "support_website_url": null, "website_url": "https://bk3d.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1094741187064958"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1062711959990160_4043143180706632094_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om3A-y0iAZUQ7kNvwHuhYm8&_nc_oc=AdpHN0ikAiDNQnp4vXYmxUCZrt6UR76LpekgF9JjvByC8sbKgn0-l7UK5H6jo7lqBwM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_8TO2FJdsB5xeHGmY4ynLxe09ToWusJddi3TmyWeqWw&oe=6AF0838F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Energy Capture", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date":
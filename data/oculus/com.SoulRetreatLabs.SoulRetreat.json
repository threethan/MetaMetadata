oe=699D9229"}, {"file_name": "meta screenshots (4).png", "id": "902299399056066", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303864_902299402389399_5656782700268335348_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41c_MDksvcAQ7kNvwFR5ZiC&_nc_oc=AdlUJ6Uasv9xe4RODd50tnUhVrOJ4N7YLL0K9dUgunP2PX7nWvp8wb5MknDiyg72Jw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunZXpcaH0w_wqBp6e53eK1y_imXbF5zUALV5MwcKQFzA&oe=699D88B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px_Larger wordmark.png", "id": "1768400750521973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_1768400753855306_7556778556820744979_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGfESBOm2G0Q7kNvwHZkjPs&_nc_oc=Adk-BtcwXYAfUsWiyn_Ca82g9OovlyPIkN5MomplDDkSNIBdscEoCoeAZDwwH5dCUs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpmEsWucjvBli6N3Xd1pUi2RX_GgohYrCM8zFDomGIyA&oe=699D824F"}, "display_name": "SOUL RETREAT: Meditate & Relax in Nature", "keywords": ["meditation", "relaxation", "sleep", "nature", "stress"], "long_description": "**PHOTOREAL NATURE FOR CALM, SLEEP AND FOCUS**\n\nStep away from daily stress into photorealistic nature with personalised meditations, sleep stories, guided breathing and calming music. Reconnect with nature to feel calmer, improve focus, and sleep better.\n\n**Free version includes 2 environments.** Soul Retreat Plus gives you the full library and voice navigation, with subscription or lifetime options.\n\n{1588589278830609}\n**PHOTOREALISTIC NATURAL LANDSCAPES**\n- Feel truly there with room scale GroundedPresence\u2122\u2014real places captured on location.\n- Reconnect with nature to help your mind unwind.\n\n{1399164411623864}\n**MEDITATIONS & STORIES THAT ADAPT TO YOU**\n- No two days\u2014or minds\u2014are the same. Adaptive guidance tailors meditations and stories to how you feel and what you see.\n- Your mindfulness guide remembers what works for you, so it gets easier to relax and meditate over time.\n\n{867086102669281}\n**WIND DOWN FOR SLEEP**\n- Drift off with auto dimmed visuals and guided breathing where each breath creates music and glowing stars.\n- Use natural hand tracking for everything, controllers optional.\n\n{1240256504593084}\n**CREATED BY EXPERTS, BACKED BY RESEARCH**\n- Calm, sleep, and focus courses created by our PhD psychologist.\n- VR nature immersion and resonance breathing draw on NIH and NASA-supported research.\n\n{1798560980789807}\n**FREE TO START, UPGRADE ANYTIME**\n- **Free:** 2 calming environments (plus 1 unlockable, rotating weekly).\n- **Soul Retreat Plus:** 10+ environments, voice navigation, more personalized meditations and sleep stories. New content added regularly.\n\n**Try it free today.**", "short_description": "Step away from daily stress into photorealistic nature with personalised meditations, sleep stories, guided breathing and calming music. Reconnect with nature to manage stress, feel calmer, improve focus, and sleep better.\n\n\u2022 Feel truly there with GroundedPresence\u2122 visuals\u2014real places captured on location.  \n\u2022 Your mindfulness guide remembers what works for you\u2014so it gets easier to meditate over time.  \n\u2022 Wind down for sleep,  relax with dimmed visuals and guided breathing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": "https://soulretreat.app/soul-retreat-eula.pdf", "publisher_name": "Soul Retreat Labs", "support_website_url": "https://www.soulretreat.app/support", "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
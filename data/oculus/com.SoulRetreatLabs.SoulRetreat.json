NQVxkBzLHDjUp9j_aDYb3Zukj8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCorwekyX1hdfTCyCOP3oK98ZajFIB-bgvXWZtewlYwg&oe=69AAC129"}, {"file_name": "meta screenshots (4).png", "id": "902299399056066", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303864_902299402389399_5656782700268335348_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYTiefg9wD8Q7kNvwEyZxvF&_nc_oc=AdlAtzLEsbCDmDcHklNPb3QhmLCtUKgq6v1ixEZ6VSPFpeU0fmM1APAnw6z3NB4YVzk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBPENc-7dGgeSJqr1d_ZLyObivBpBOFhRJOwWurqFEaQ&oe=69AAB7B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px_Larger wordmark.png", "id": "1768400750521973", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821568_1768400753855306_7556778556820744979_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Yl7jh9nP4sQ7kNvwF_m3ae&_nc_oc=Adlci1wG-gEy2bvIMTL8e02btOuot-vULcsusBxWiQz5WiO5dsLPzMmwGFw7WmPCjpo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfywUELzq7aBfK1jOYTYee0NZ-1Wks3-jHkULqsdqQJ5yA&oe=69AAB14F"}, "display_name": "SOUL RETREAT: Meditate & Relax in Nature", "keywords": ["meditation", "relaxation", "sleep", "nature", "stress"], "long_description": "**PHOTOREAL NATURE FOR CALM, SLEEP AND FOCUS**\n\nStep away from daily stress into photorealistic nature with personalised meditations, sleep stories, guided breathing and calming music. Reconnect with nature to feel calmer, improve focus, and sleep better.\n\n**Free version includes 3 environments.** Soul Retreat Plus gives you the full library and lets you speak to your AI mindfulness guide, with subscription or lifetime options.\n\n{1588589278830609}\n**PHOTOREALISTIC NATURAL LANDSCAPES**\n- Feel truly there with room scale GroundedPresence\u2122\u2014real places captured on location.\n- Reconnect with nature to help you unwind, backed by research.\n\n{1399164411623864}\n**MEDITATIONS & STORIES THAT ADAPT TO YOU**\n- No two days\u2014or minds\u2014are the same. Adaptive guidance tailors meditations and stories to how you feel and what you see.\n- Your mindfulness guide remembers what works for you, so it gets easier to relax and meditate over time.\n\n{867086102669281}\n**WIND DOWN FOR SLEEP**\n- Drift off with sleep friendly dimming. Stars and music respond to the rhythm of your breath.\n- Use natural hand tracking for everything, controllers optional.\n\n{1240256504593084}\n**CREATED BY EXPERTS, BACKED BY RESEARCH**\n- Calm, sleep, and focus courses created by our PhD psychologist.\n- VR nature immersion and resonance breathing draw on NIH and NASA-supported research.\n\n{1798560980789807}\n**FREE VERSION, OPTIONAL PLUS**\n- **Free:** 3 calming environments (1 rotates weekly). Unlimited use.\n- **Soul Retreat Plus:** 10+ environments, speak to your AI mindfulness guide, more personalized meditations and sleep stories. New content added regularly.\n\n**Try the free version.**", "short_description": "Step away from daily stress into photorealistic nature with personalised meditations, sleep stories, guided breathing and calming music. Reconnect with nature to manage stress, feel calmer, improve focus, and sleep better.\n\n\u2022 Feel truly there with GroundedPresence\u2122 visuals\u2014real places captured on location.  \n\u2022 Your mindfulness guide remembers what works for you\u2014so it gets easier to meditate over time.  \n\u2022 Wind down for sleep,  relax with dimmed visuals and guided breathing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": "https://soulretreat.app/soul-retreat-eula.pdf", "publisher_name": "Soul Retreat Labs", "support_website_url": "https://www.soulretreat.app/support", "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
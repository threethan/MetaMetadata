{"__typename": "AndroidBinary", "id": "34823830550565636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775928870, "id": "34871284585820232", "version": "0.2.40", "version_code": 564, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34823830550565636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1008249534449753"}]}, "change_log": "v0.2.39 New Luskentyre Beach and app improvements\n\n\u2022 New in Plus: Luskentyre Beach, one of Scotland\u2019s most celebrated beaches, with wide white sand and turquoise water\n\u2022 Optimised graphics rendering for a smoother visual experience\n\u2022 The Night option on the Time button is now slightly lighter while keeping a full moonlit look\n\u2022 AI model setup updated across Free and Plus, with Plus using our most advanced model\n\u2022 In Free, choosing 10 minute Scenic Escape now plays the built in session for that type first, before later AI generated sessions\n\u2022 Fixed an issue where guest user data could be promoted onto an existing named account when switching users\n\u2022 Better detection of subscription state at start-up when internet connection or Meta server is slow\n\nQuestions, feedback, or bug reports are always welcome. Email support@soulretreat.app or join the Discord from Profile under Connect and Support.", "created_date": 1775720807, "id": "34823830550565636", "version": "0.2.39", "version_code": 562, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []},
{"data": {"node": {"__typename": "Application", "id": "28320567507558672", "organization": {"id": "559294210600321", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "28320567507558672"}]}, "id": "650324404092142"}]}}, "firstRevision": {"nodes": [{"application": {"id": "28320567507558672", "release_date": 1770314400, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38733979939550658"}, "id": "1008249534449753"}]}}, "binary": null, "live_binary": null, "created_date": 1790955737, "id": "38888099924138658", "is_initial_release": false, "name_with_fallback": "v26", "pdp_metadata_with_fallback": {"version": 22, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "36015231914758821"}, "release_status": "RELEASED", "id": "28320567507558672"}, "id": "36015231914758821", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "PENDING", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1307942114433024_4411405484097446209_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT7qsDu4zkwQ7kNvwGhJwEn&_nc_oc=AdqrzDh6fgpb1x_mDOsAUaG0UJgAK6Ant6xFgbi8LB-mHIoB9YvIf3FKXpwWx3Kii48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr-n7UbynetAg8ZEJmobYAYRb-2TKSPVEL-Cbtqz4ZkA&oe=6ACD0056"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SOUL RETREAT: Relax & Meditate in Nature", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "28320567544225335", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28320567507558672", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2020734575328650"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "59.png", "id": "2326338887784462", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293690_2326338891117795_6318380450544267270_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwHJ8XV8SykQ7kNvwFjpIpC&_nc_oc=AdqyJSYQDNsGhRqKXoBDSHmV7Cy82PFc7lP1cM4fZ6hA_hL3uKv2nrB98_Xm92hD9Eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGAXMqUToMjARTX0uJxIFVoN5aoexqfeUbNytpBtthWA&oe=6ACD003D"}, {"file_name": "61.png", "id": "2207029879783851", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830821_2207029886450517_7369003331340681378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnPJvUKBL8UQ7kNvwFr_Ujf&_nc_oc=Adp2GNpYYiVzyTetQ1GrfXSCI-rG4c3ygTuddgSfhScxV9rhu1LmtWDjzp8EVRKrw44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdsPT3pBet-T1m_sGS8EcGGgaqXsSx1Y43Bldt9RqAQA&oe=6ACCE95D"}, {"file_name": "60.png", "id": "1948336895731604", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302527_1948336899064937_109526711735893093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy6NJm_9NvEQ7kNvwGQLGAP&_nc_oc=Ado935xEDU9xzhtdCSNmR3rjChenOugLouskv4kDvpYuwOEhuKHDLXz0viIrdqn_gWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZgY_yxzl6ws_8MMtQiqJquwW9XwlEP2BJmdrlm4ZEsA&oe=6ACD14E0"}, {"file_name": "meta screenshots (1).png", "id": "1369121291361889", "image_type": "APP_I
As&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft_nHUH5hqapbcyGBwAbWZ99vG_3ipxxBRD7WyRfhB2hg&oe=69A59AC4"}, {"file_name": "66.png", "id": "1338762311062673", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308699_1338762314396006_6664816897366106756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjo7WE4kJsMQ7kNvwGl_R8t&_nc_oc=Adk4F-kW5RqIxGbXQCDPCLNdmfizJVUFlFjiS5rG4AuJgLPyEtFX-yLRqkrie6winAA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsNDfnN7pzatqqMuIslJNWOoxb3y-dK_gmnBGE5Fb0IHw&oe=69A58696"}, {"file_name": "64.png", "id": "814893714679414", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296037_814893718012747_3941211415845084627_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYdJKcvRV3IQ7kNvwHaV_dN&_nc_oc=Adm8WpvYIlRlXsI0aVFu9cE8pKjKybmZ2dcq0gyVzmTfPse2bM2MR1w5feHIVImfv7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvZI2_UQZ_C5RFaoOJ2YrggiFiAAmmO1F65y8Z3-hvsAA&oe=69A56D18"}, {"file_name": "61.png", "id": "1551165802902407", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303746_1551165809569073_8864999128709901168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3lU3hNw09QQ7kNvwESAenT&_nc_oc=AdnH5-TzrKkiglcZgzggzIb7m-ZI0fW1VuZrmtey_1aBSBwabGhiSsDf5XguC2WIYZo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftCe_nJBrBnpkPAx7vIHHmQLgByGuh80xKpnP0rAGWNGg&oe=69A57156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px.png", "id": "791609413673028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_791609417006361_902044843593706330_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqQ05BSuRgcQ7kNvwEYy32L&_nc_oc=Admtg59AWdEYxy7yRxaxgu0uc8Crf8VcjTngp9Q5IZCwne0GP_5rAEwugHSpjbG6y6k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv8QbIbxVDOFslN0R2ojyFNAjjcdz-xVgaj8Jd_XMjgmw&oe=69A588D0"}, "display_name": "Soul Retreat", "keywords": ["relaxation", "meditation", "wellness", "free", "sleep"], "long_description": "**Life moves fast. Stress piles up. Sometimes, you just need to escape.**\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature.\n\nSoul Retreat is built on the belief that deep relaxation comes from reconnecting with the natural world - even when it\u2019s difficult to get outside. In collaboration with experts in psychology and well-being, we\u2019ve designed an experience that merges science with the timeless wisdom of nature.\n\n**Stay present and relaxed\u2014use hands, controllers optional.**\n\n{2207029879783851}\n\n**Adaptive stories and meditations, shaped by how you feel and what you see**\n\n{825733700386282}\n\n**Engage in musical, relaxing breathing exercises with real-time biofeedback.**\n\n{1369121291361889}\n\nNo two days\u2014or minds\u2014are the same. Soul Retreat\u2019s adaptive guidance uses your mood and goals to tailor meditations and stories to the scene around you. Use simple hand gestures or voice to shift the time of day, paint stars, and settle into midnight\u2019s calm\u2014so every session fits how you feel. \n\nDisclaimer: Soul Retreat is a self-help wellness and relaxation app, for people 18 or older. It is not therapy, does not diagnose, treat, or prevent mental-health conditions, and is not a substitute for care from a licensed professional.", "short_description": "Life moves fast. Stress piles up. Sometimes, you just need to escape.\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Soul Retreat Labs", "support_website_url": null, "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28320567510892005"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1384096203204182"}]}, "baseline_offer": {"id": "1384096203204182"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770314400, "status": "PUBLISHED", "id": "1384096203204182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33914352111513489", "version": "0.2.29"}, "id": "1008249534449753", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33914352111513489"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771859627, "id": "33964047279877305", "version": "0.2.30", "version_code": 481, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 19}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33914352111513489"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1008249534449753"}]}, "change_log": "v0.2.29 Natural History and Free Weekly Bonus Refresh\n\nWhat\u2019s better for everyone\n\u2022 Scenic Escape and History Stories now focus more on the natural history of the locations\n\u2022 Music plays more reliably when you move your head or hands\n\u2022 No more surprise darker scenes. Auto sunset stays off until you set a bedtime or turn it on\n\u2022 AI features connect more reliably\n\nFree version\n\u2022 Your weekly bonus 3rd environment is now available right away, and easier to find in your first session\n\u2022 It changes every Thursday, and it now auto downloads after your first session\n\u2022 History Stories replace Mentor Stories, with short stories about the places you visit\n\u2022 Cleaner first time experience with less information about Plus\n\nSoul Retreat Plus\n\u2022 If you're a paid subscriber, Share Free Month is now in Profile, under Connect and Support. If your friend subscribes, you both get a free month\n\u2022 Fixed a rare issue where downloaded environments could be removed unexpectedly\n\u2022 Once you\u2019ve used Soul Retreat for a while, you\u2019ll see Rate this App in Profile, under Connect and Support\n\nQuestions, feedback, or bug reports are always welcome. Email support@soulretreat.app or join the Discord link in Profile, under Connect and Support.", "created_date": 1771607019, "id": "33914352111513489", "version": "0.2.29", "version_code": 479, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 19}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33914352111513489"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771537858, "id": "33900541602894540", "version": "0.2.28", "version_code": 475, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 19}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33914352111513489"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771521471, "id": "33897177289897638", "version": "0.2.27", "version_code": 473, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 19}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33914352111513489"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771335244, "id": "33859589600323074", "version": "0.2.26", "versi
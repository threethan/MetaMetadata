02175", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_4651832098468841_4470476753693254242_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmeaZeL-560Q7kNvwHmQtet&_nc_oc=AdpokP-NH56I70d_oNsbhgbIxhs9lN7M4878w1Sd95hcqNpdXRbdn-YiBGrwF5N8RkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXbu_fLAa5PytzZOj2zEfVhYLLoEzsq-A-siycdoPLJ_A&oe=6B105D86"}, {"file_name": "Soul Retreat - Glen Coe.png", "id": "1623312142623605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1623312149290271_6682634168743132688_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeoLYS09pj8Q7kNvwEXahGN&_nc_oc=AdrowruEixpsB8pQOiZh4OZ7Fc5HosYOikaKBmwJuAC3cv0_dWEL0epEnDM-hOyRANw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVH72z3cWJLp8WTzI3FcZSYIIugBJ_-oOd9McUvHJA59Q&oe=6B104966"}, {"file_name": "86.png", "id": "2564393877280868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307303_2564393880614201_6951867951951653855_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak7Tbjr6Iv8Q7kNvwHuciRn&_nc_oc=AdrzklBLjtH_ZBiXtiKPc8RSALQgPpI1lf4LwLjXzFPTusRfBexlJZbxsHqTwaEBwhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUWGAGc9J4qvvrHufHbMW3ys9WI9SeQBpstMlZAkx8L9A&oe=6B105C61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px_Larger wordmark.png", "id": "1768400750521973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_1768400753855306_7556778556820744979_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i66BQrJV-bsQ7kNvwFvFjk_&_nc_oc=AdpNyjhJtp4KLE0YENvM_LjtlClhPG-iBWmu_B2fVe_ReCFuV0h1nHPgbUARvnl4wsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1Et7PeCEjr3XLiRo0WWtFV2acDFcTjN9X3RNnNrb0ug&oe=6B10684F"}, "display_name": "SOUL RETREAT: Relax in Nature & Meditate", "keywords": ["meditation", "relaxation", "sleep", "nature", "mindfulness"], "long_description": "**PHOTOREAL NATURE FOR RELAXATION, SLEEP AND FOCUS**\n\nStep away from daily stress into photorealistic nature, from quiet beaches to mountain lakes. Just sit and take it in, or go deeper with personalized meditations, calming stories of each place, guided breathing and relaxing music to feel calmer and sleep better.\n\n**Free version includes 3 environments.** Plus unlocks all 17 and an AI guide, with subscription or lifetime options.\n{1127608256847627}\n\n**PHOTOREALISTIC NATURAL LANDSCAPES**\n\n- Real places captured on location in 3D. The ground is right beneath you. Lean or step within 2 m and the view shifts naturally.\n- Waves roll in and rivers flow, with nature sounds all around.\n{1432586522363029}\n\n**MEDITATIONS & STORIES THAT ADAPT TO YOU**\n\n- Meditations and stories tailored to how you feel and what you see.\n- Your guide remembers what you like, so each session fits you better.\n{2197178144164244}\n\n**POINT AND DISCOVER**\n\n- Point at anything and pinch to hear about it.\n- With Plus, ask \"What's that mountain?\" Your guide knows where you're looking.\n{867086102669281}\n\n**WIND DOWN FOR SLEEP**\n\n- Drift off from sunset to starry night. Stars and music respond to your breath.\n- Natural hand tracking, controllers optional.\n{4516888051868546}\n\n**CREATED BY EXPERTS, BACKED BY RESEARCH**\n\n- Calm, sleep, and focus courses by our PhD psychologist.\n- VR nature immersion and resonance breathing draw on NIH and NASA-supported research.\n{1583295507158217}\n\n**FREE VERSION, OPTIONAL PLUS**\n\n- **Free:** 3 environments (1 rotates weekly), unlimited use.\n- **Plus:** All 17 environments, an AI guide you can speak to, and more personalized sessions. New places added regularly.", "short_description": "Step away from daily stress into photorealistic nature, from quiet beaches to mountain lakes. Just sit and take it in, or go deeper with personalized meditations, calming stories of each place, guided breathing and relaxing music to feel calmer and sleep better.\n\n\u2022 Feel truly there in real places captured on location in 3D, not just 360 video.\n\u2022 Watch waves roll and rivers flow, with nature sounds all around you.\n\u2022 Free version with 3 environments. Plus unlocks all 17, with more added regularly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": "https://soulretreat.app/soul-retreat-eula.pdf", "publisher_name": "Soul Retreat Labs", "support_website_url": "https://www.soulretreat.app/support", "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40239835878965049"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_2130230087584845_6668971974831300590_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnJmkumc-XoQ7kNvwG9MhJ2&_nc_oc=AdpYFGqGTC6EGto-rIBIUTTyQAtzmBQhC_Bu7tE79txUujCw-zbTweT_JyUDMTbAA_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXI2-Mks6VnoxckaayflWqi2C3xF-HV--3B1anSjLSPTA&oe=6B1049B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SOUL RETREAT: Relax in Nature & Meditat
1-7&_nc_sid=6e7a0a&_nc_ohc=plT8cTxaahEQ7kNvwFDo4O6&_nc_oc=AdpZxOvPUKNDYp2Ydmob7Rsrxuf0JPlmv7Dqb8pu11mf6MQj2xuAJu68KjXgC7EeUgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSqdo6gO0gPqMbAzNIRKSp7AcwyrI9TVN3B5oxLEHtLw&oe=6AF49BD6"}, {"file_name": "64.png", "id": "814893714679414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296037_814893718012747_3941211415845084627_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2NhDutLDOwQ7kNvwGGUAsp&_nc_oc=AdpJuBXUIU2_F0t71HsexACJ4AxcgxEbcyKDDZOS3kjlCK5uAU2efSsvpPHsyt6aeQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_WPbPZh8j_ECTTQWCwNtWjOjE1YZVKhcVrMRwuarTxQ&oe=6AF48258"}, {"file_name": "61.png", "id": "1551165802902407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_1551165809569073_8864999128709901168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcBn6c62iYsQ7kNvwF-pO_K&_nc_oc=AdoYpENPAzcVXtXT-ryGRKutNpHjxQwL5fNIQG8g6VdDOCeYiBz7SbOIYlvzI_x0RXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUm3TiKyDbFa0R73DBotVmOubyz3SnWrhVKUQFkRLmCg&oe=6AF48696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px.png", "id": "791609413673028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303445_791609417006361_902044843593706330_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmSlV2qd_TwQ7kNvwHSoIud&_nc_oc=Adq4TyH3OOnCg3XkdLR2evvDyrhWzcDlhnw4XKwS2TcKIwrYHRF8rCchxVaO_IV6_cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn0y0Wq0Vaz1Tbss0DIdogTEMXaj9PJxYsjcbT78XX0g&oe=6AF49E10"}, "display_name": "Soul Retreat", "keywords": ["relaxation", "meditation", "wellness", "free", "sleep"], "long_description": "**Life moves fast. Stress piles up. Sometimes, you just need to escape.**\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature.\n\nSoul Retreat is built on the belief that deep relaxation comes from reconnecting with the natural world - even when it\u2019s difficult to get outside. In collaboration with experts in psychology and well-being, we\u2019ve designed an experience that merges science with the timeless wisdom of nature.\n\n**Stay present and relaxed\u2014use hands, controllers optional.**\n\n{2207029879783851}\n\n**Adaptive stories and meditations, shaped by how you feel and what you see**\n\n{825733700386282}\n\n**Engage in musical, relaxing breathing exercises with real-time biofeedback.**\n\n{1369121291361889}\n\nNo two days\u2014or minds\u2014are the same. Soul Retreat\u2019s adaptive guidance uses your mood and goals to tailor meditations and stories to the scene around you. Use simple hand gestures or voice to shift the time of day, paint stars, and settle into midnight\u2019s calm\u2014so every session fits how you feel. \n\nDisclaimer: Soul Retreat is a self-help wellness and relaxation app, for people 18 or older. It is not therapy, does not diagnose, treat, or prevent mental-health conditions, and is not a substitute for care from a licensed professional.", "short_description": "Life moves fast. Stress piles up. Sometimes, you just need to escape.\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Soul Retreat Labs", "support_website_url": null, "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28320567510892005"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1384096203204182"}]}, "baseline_offer": {"id": "1384096203204182"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770314400, "status": "PUBLISHED", "id": "1384096203204182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39715743898040919", "version": "0.2.59"}, "id": "1008249534449753", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39715743898040919"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794005509, "id": "39813939668221341", "version": "0.2.61", "version_code": 1565, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 28}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39715743898040919"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793999229, "id": "39812101588405149", "version": "0.2.60", "version_code": 1555, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 28}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39715743898040919"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1008249534449753"}]}, "change_log": "v0.2.59 Iffigsee, a new alpine lake + Point and Discover\n\nPoint at anything in the view, from a mountain on the skyline to the rocks at your feet, and its name appears on your watch. Pinch, and your guide tells you about it. Every location now has its peaks, lakes, rivers and landmarks mapped.\n\n- Point with your index finger or a controller, then pinch or pull the trigger to hear about it\n- Iffigalp now comes free with the app, alongside Carnish Beach. Glen Coe is now a Plus download, and the app is 1.5 GB smaller\n- A redesigned watch shows the minutes left and what you are pointing at. Tap its X to close a menu\n- Your hands are solid, lit by the scene, and no longer flicker or jump\n- Choose your hands' skin tone in Profile > Settings > Visuals\n- Opening the menu no longer cuts off your guide\n- Menu help text sits next to its item, and menus no longer tilt when you look up\n- Offline or in Visitor Mode, Environments shows only the locations on your headset\n- Live Legend stories at Iffigalp now draw on Swiss legends\n- Painting stars now uses point and pinch, so a resting hand no longer paints by accident\n- Various other bug fixes and improvements\n\nPlus only\n\n- New location: Iffigsee, Switzerland, an icy alpine lake below a towering limestone wall, in Enhanced 3D. Free for everyone the week of 14 November\n- Ask your guide about whatever is in the middle of your view: double tap your thumb against your finger, or hold A, and ask \"What's that?\" or \"Where's the highest mountain?\"\n- Ask for a story out loud and a hand-curated one that fits starts straight away\n- Soaso Falls and Acherito look better up close. Already downloaded one? Delete it (hold the trigger for 2 seconds) and download it again\n\nNew users\n\n- A short first walk shows you how to point at the landscape and hear about it, with a see-through hand showing each gesture\n- Leave during the tutorial and it carries on where you left off\n- On your first day, swiping to change the time of day stays off until you have been shown how\n\nScenic Escape\n\n- After you choose your goal and your guide's voice, there are no more questions\n- Each day starts with a short introduction to where you are and one fact about it\n- At 10 minutes, Nature and Body meditations play the hand-curated sessions first\n\nJoin the beta\n\n- Get new places and features before everyone else. Beta testers had Point and Discover first, and help shape what comes next\n- To join, come to our Discord and go to the beta-testing channel: https://discord.gg/zSJQfxaEdk\n\nQuestions, feedback, and bug reports are always welcome, and if you work in research or care we would like to hear from you. Email support@soulretreat.app or join the Discord from Profile > Help.", "created_date": 1793700213, "id": "39715743898040919", "version": "0.2.59", "version_code": 1395, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary":
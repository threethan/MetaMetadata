4939431751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr3tIf12AocQ7kNvwEJ5pPg&_nc_oc=AdrUopj-UKk8hNqQStoVyVYE6FOu5l_mc2gunCKXVP8VFVDSreodI_UaU-wyEzcGNBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Pd181VJLMno_a4ghvg9PhR6802vH--z6eOzjF_EZVZQ&oe=69EE1D44"}, {"file_name": "66.png", "id": "1338762311062673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308699_1338762314396006_6664816897366106756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQFPpPgwosUQ7kNvwFKbOx_&_nc_oc=AdrFtgjvkQeJSQkqipcpu9-9cp4Sdw3MKxHXLahyPz--9dpjPo0N95Tfet4Efn5XqK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eVm9rf84JpQ-88GMqX5VtLB7SgvQxHAgPGyd82VvAig&oe=69EE0916"}, {"file_name": "64.png", "id": "814893714679414", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296037_814893718012747_3941211415845084627_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wuh53udzAvEQ7kNvwEIIhAU&_nc_oc=AdpAEW4vc69ARsX5KJqMIKoHzQ97CRWEQ3JfoarVZB7NBlDjTlxAWFuomSwcbczKZYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kyDICdTfvdzJ0nAltM5NM3bn72v0d1Je8XQuKRnNFlA&oe=69EE27D8"}, {"file_name": "61.png", "id": "1551165802902407", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303746_1551165809569073_8864999128709901168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGlqjUX0qngQ7kNvwEu20jO&_nc_oc=AdoNUJ6_kukEJ8RPD9Kmjo7h6OB1zzN66rr0BdOieNxPTbREi-2nMWNhK4nFhf_XO2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fmilUi5o78NYmtloF9YUmPpRbIhixw4qS7TAl9oyWAA&oe=69EDF3D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px.png", "id": "791609413673028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303445_791609417006361_902044843593706330_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt5tz6x4cloQ7kNvwFkBN_L&_nc_oc=AdrmIa2IKXNUI2zGojkOsh5UcgpD2tx5MPHTotatTOxsJTsGvJ7iPbAQ_KF_ash5u0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MsgEpvMBpsQhLki2OykFST5nYs6mDl1MBTtbdQQHLdA&oe=69EE0B50"}, "display_name": "Soul Retreat", "keywords": ["relaxation", "meditation", "wellness", "free", "sleep"], "long_description": "**Life moves fast. Stress piles up. Sometimes, you just need to escape.**\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature.\n\nSoul Retreat is built on the belief that deep relaxation comes from reconnecting with the natural world - even when it\u2019s difficult to get outside. In collaboration with experts in psychology and well-being, we\u2019ve designed an experience that merges science with the timeless wisdom of nature.\n\n**Stay present and relaxed\u2014use hands, controllers optional.**\n\n{2207029879783851}\n\n**Adaptive stories and meditations, shaped by how you feel and what you see**\n\n{825733700386282}\n\n**Engage in musical, relaxing breathing exercises with real-time biofeedback.**\n\n{1369121291361889}\n\nNo two days\u2014or minds\u2014are the same. Soul Retreat\u2019s adaptive guidance uses your mood and goals to tailor meditations and stories to the scene around you. Use simple hand gestures or voice to shift the time of day, paint stars, and settle into midnight\u2019s calm\u2014so every session fits how you feel. \n\nDisclaimer: Soul Retreat is a self-help wellness and relaxation app, for people 18 or older. It is not therapy, does not diagnose, treat, or prevent mental-health conditions, and is not a substitute for care from a licensed professional.", "short_description": "Life moves fast. Stress piles up. Sometimes, you just need to escape.\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Soul Retreat Labs", "support_website_url": null, "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28320567510892005"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1384096203204182"}]}, "baseline_offer": {"id": "1384096203204182"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770314400, "status": "PUBLISHED", "id": "1384096203204182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34823830550565636", "version": "0.2.39"}, "id": "1008249534449753", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34823830550565636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775976931, "id": "34881158034832887", "version": "0.2.41", "version_code": 566, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34823830550565636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775928870, "id": "34871284585820232", "version": "0.2.40", "version_code": 564, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34823830550565636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1008249534449753"}]}, "change_log": "v0.2.39 New Luskentyre Beach and app improvements\n\n\u2022 New in Plus: Luskentyre Beach, one of Scotland\u2019s most celebrated beaches, with wide white sand and turquoise water\n\u2022 Optimised graphics rendering for a smoother visual experience\n\u2022 The Night option on the Time button is now slightly lighter while keeping a full moonlit look\n\u2022 AI model setup updated across Free and Plus, with Plus using our most advanced model\n\u2022 In Free, choosing 10 minute Scenic Escape now plays the built in session for that type first, before later AI generated sessions\n\u2022 Fixed an issue where guest user data could be promoted onto an existing named account when switching users\n\u2022 Better detection of subscription state at start-up when internet connection or Meta server is slow\n\nQuestions, feedback, or bug reports are always welcome. Email support@soulretreat.app or join the Discord from Profile under Connect and Support.", "created_date": 1775720807, "id": "34823830550565636", "version": "0.2.39", "version_code": 562, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34823830550565636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775229426, "id": "34709889085293117", "version": "0.2.38", "version_code": 560, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34823830550565636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774290813, "id": "34486066057675422", "version": "0.2.37", "version_code": 514, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files"
=AdpgOGaXeCwbTo5mebxtCWZxbbgNhWkD1cg2Curyw3Lc3E51web4MSehrOzf-oJ5h-I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25oJ8UZ2-DPkWeOgdzegX2iOYZO72-ustA8tujeZj0Ww&oe=69D79429"}, {"file_name": "meta screenshots (4).png", "id": "902299399056066", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303864_902299402389399_5656782700268335348_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dr_8LM4zp4Q7kNvwEF6XIN&_nc_oc=AdpzRYrHbi8IvNt-LepSs8weYlpeGgluox54R4VSj4JRwcQ52JJsuKUDBYK3OHkYcSs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q-k6UeC4Fx9_q4VwA9_LWeqrQoW2yfDnpSowk8gQiWQ&oe=69D78AB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px_Larger wordmark.png", "id": "1768400750521973", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821568_1768400753855306_7556778556820744979_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dl9invUDjI8Q7kNvwEl_DKg&_nc_oc=AdrSXtGFQkyhn5vn2rDf35sbio3bAT7uKAc8OKjN7OfABrfqYNGgCbmiTlU8sJYM9KI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ba-pBxxpYalOml6EWiExOrpeP9uLYMV0yvaVcz2WC8w&oe=69D7BC8F"}, "display_name": "SOUL RETREAT: Relax & Meditate in Nature", "keywords": ["meditation", "relaxation", "sleep", "nature", "stress"], "long_description": "**PHOTOREAL NATURE FOR RELAXATION, SLEEP AND FOCUS**\n\nStep away from daily stress into photorealistic nature with personalised meditations, sleep stories, guided breathing and calming music. Unwind in beautiful real places to feel calmer, improve focus, and sleep better.\n\n**Free version includes 3 environments.** Soul Retreat Plus gives you the full library and an AI mindfulness guide that tailors sessions to you, with subscription or lifetime options.\n\n{1588589278830609}\n**PHOTOREALISTIC NATURAL LANDSCAPES**\n- Feel truly there with room scale GroundedPresence\u2122\u2014real places captured on location.\n- Reconnect with nature to unwind, backed by research.\n\n{1399164411623864}\n**MEDITATIONS & STORIES THAT ADAPT TO YOU**\n- No two days are the same. Adaptive guidance tailors meditations and stories to how you feel and what you see.\n- Your mindfulness guide remembers what works for you, so it gets easier to relax and meditate over time.\n\n{867086102669281}\n**WIND DOWN FOR SLEEP**\n- Drift off with sleep friendly dimming. Stars and music respond to the rhythm of your breath.\n- Natural hand tracking throughout, controllers optional.\n\n{1240256504593084}\n**CREATED BY EXPERTS, BACKED BY RESEARCH**\n- Calm, sleep, and focus courses created by our PhD psychologist.\n- VR nature immersion and resonance breathing draw on NIH and NASA-supported research.\n\n{1798560980789807}\n**FREE VERSION, OPTIONAL PLUS**\n- **Free:** 3 calming environments (1 rotates weekly). Unlimited use.\n- **Soul Retreat Plus:** 11+ environments, AI mindfulness guide you can speak to, more personalized meditations and sleep stories. New content added regularly.\n\n**Try the free version.**", "short_description": "Step away from daily stress into photorealistic nature with personalised meditations, sleep stories, guided breathing and calming music. Unwind in beautiful real places to feel calmer, improve focus, and sleep better.\n\n\u2022 Feel truly there with GroundedPresence\u2122 visuals\u2014real places captured on location.  \n\u2022 Your mindfulness guide remembers what works for you\u2014so it gets easier to meditate over time.  \n\u2022 Wind down for sleep,  relax with dimmed visuals and guided breathing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": "https://soulretreat.app/soul-retreat-eula.pdf", "publisher_name": "Soul Retreat Labs", "support_website_url": "https://www.soulretreat.app/support", "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
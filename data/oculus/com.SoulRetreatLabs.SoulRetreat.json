{"__typename": "AndroidBinary", "id": "34362483590033670"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774290813, "id": "34486066057675422", "version": "0.2.37", "version_code": 514, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 20}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34362483590033670"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774260405, "id": "34478528455095849", "version": "0.2.36", "version_code": 509, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 20}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34362483590033670"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1008249534449753"}]}, "change_log": "v0.2.35 Offline Mode, Mindfulness Courses with Weekly Themes and Badges\n\nMindfulness Courses with Weekly Themes and Badges\n\u2022 Added structured 8 week mindfulness courses with weekly themes, designed to help build mindfulness skills progressively over time. These unlock after completing your 7 day goal based course and are aligned across the Soul Retreat community each week\n\u2022 Earn weekly theme badges in My Journey by completing 3 sessions in a week, with recent badges now viewable in a new Weekly Badges screen\n\u2022 Weekly themes are automatically adapted within sessions to fit your selected goal, creating a more personalised and relevant experience\n\nOffline Mode\n\u2022 Added new offline meditations and stories with a smoother offline experience\n\u2022 Pre generated offline meditations and stories are now included for Carnish Beach and Glen Coe\n\u2022 Generated meditations and stories can now be cached on device with a new Offline Sessions setting in Preferences > Sound. This is on by default\n\u2022 Improved offline fallback across startup and menus, with smoother access to available offline sessions when AI is temporarily unavailable\n\nOther improvements\n\u2022 Added a new day and night toggle on the environment page for quick switching\n\u2022 Increased rendering quality for a sharper image with reduced aliasing\n\u2022 Selecting Nature Sounds Only on the Music tab now starts without a breathing intro\n\u2022 Your first History story in each location introduces the place and the key moments from its past\n\u2022 Legends stories now introduce key characters from local folklore before they appear within the story\n\u2022 Plus only: Improved changing meditations and stories by voice, with a smoother return to the session\n\u2022 Plus only: Choose Spanish, French, German, or English for spoken sessions in Preferences > Sound > Spoken Language. This feature is experimental, so menus, breathing intro, fixed phrases, and voice commands remain in English for now. These areas will be improved in a future update\n\nQuestions, feedback, or bug reports are always welcome. Email support@soulretreat.app or join the Discord from Profile > Connect and Support.", "created_date": 1773768562, "id": "34362483590033670", "version": "0.2.35", "version_code": 507, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 20}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34362483590033670"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773406911, "id": "34283713417910688", "version": "0.2.34", "version_code": 503, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 20}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
/v/t64.5771-25/491821796_4651832098468841_4470476753693254242_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guLClSnlKIEQ7kNvwElYGym&_nc_oc=AdqB_dgPnlxwFD4dgra5ZiZmc7mV-cs6-705jIYNOKI6sSV4H58Sv8AdmK9MQF0POo8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROnUZbcuTO3NSwgBqifozGEXvVpaQG9hkXpY58LmdCQQ&oe=6AFB4586"}, {"file_name": "Soul Retreat - Glen Coe.png", "id": "1623312142623605", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821704_1623312149290271_6682634168743132688_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cL4hJ46XMykQ7kNvwGRh9qm&_nc_oc=AdqjUO4S4TV9J7otn4JJQu1SKmZprHvdmSpWgZvawhsldkHVa7_G3JLVd_JfLfKBcgo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX5WNsgD5bphHbJsyxT7t77LPgt6tKoNBh4TexmzCmhg&oe=6AFB3166"}, {"file_name": "86.png", "id": "2564393877280868", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307303_2564393880614201_6951867951951653855_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjroB08ElTkQ7kNvwHMcOah&_nc_oc=AdpnbZ9qTY1v68mT7iufKFyp9EAFpxUwMO_K7QlReupdzV4fyqECe9fL0LKmCsrMfcU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLR_XZtEBR2QO1b2iUCQj4yI9VqA35zDyqZ8Jzr2FW9Q&oe=6AFB4461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px_Larger wordmark.png", "id": "1768400750521973", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821568_1768400753855306_7556778556820744979_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGfu4_j7DZ0Q7kNvwG2pgSu&_nc_oc=AdrhwkTJ6v8fxWVUMVCAdBG116k6amEA738LOJYw2BpKVA1xC_1eHqIFN_NxywMSujo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdSfJGNgbEutBdDENry4SvMr9R1a-BOx32I2Nn2szHHA&oe=6AFB180F"}, "display_name": "SOUL RETREAT: Relax in Nature & Meditate", "keywords": ["meditation", "relaxation", "sleep", "nature", "mindfulness"], "long_description": "**PHOTOREAL NATURE FOR RELAXATION, SLEEP AND FOCUS**\n\nStep away from daily stress into photorealistic nature, from quiet beaches to mountain lakes. Just sit and take it in, or go deeper with personalized meditations, sleep stories, guided breathing and relaxing music to feel calmer, improve focus, and sleep better.\n\n**Free version includes 3 environments.** Soul Retreat Plus unlocks all 16 and an AI mindfulness guide, with subscription or lifetime options.\n{1131916439256427}\n\n**PHOTOREALISTIC NATURAL LANDSCAPES**\n\n- Real places captured on location in 3D. The ground is right beneath you, and the view shifts naturally as you move your head.\n- Watch waves roll in and rivers flow, with nature sounds all around you.\n{1399164411623864}\n\n**MEDITATIONS & STORIES THAT ADAPT TO YOU**\n\n- No two days are the same. Adaptive guidance tailors meditations and stories to how you feel and what you see.\n- Your guide remembers what works for you, so it gets easier to relax over time.\n{867086102669281}\n\n**WIND DOWN FOR SLEEP**\n\n- Drift off with sleep-friendly dimming, from sunset to starry night. Stars and music respond to your breath.\n- Natural hand tracking, controllers optional.\n{1240256504593084}\n\n**CREATED BY EXPERTS, BACKED BY RESEARCH**\n\n- Calm, sleep, and focus courses created by our PhD psychologist.\n- VR nature immersion and resonance breathing draw on NIH and NASA-supported research.\n{1609513830661125}\n\n**FREE VERSION, OPTIONAL PLUS**\n\n- **Free:** 3 environments (1 rotates weekly), unlimited use.\n- **Plus:** All 16 environments, an AI guide you can speak to, and more personalized sessions. New places added regularly.\n\n**Try the free version.**\n", "short_description": "Step away from daily stress into photorealistic nature, from quiet beaches to mountain lakes. Just sit and take it in, or go deeper with personalized meditations, sleep stories, guided breathing and relaxing music to feel calmer, improve focus, and sleep better.\n\n\u2022 Feel truly there in real places captured on location in 3D, not just 360 video.\n\u2022 Watch waves roll and rivers flow, with nature sounds all around you.\n\u2022 Free version with 3 environments. Plus unlocks all 16, with more added regularly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": "https://soulretreat.app/soul-retreat-eula.pdf", "publisher_name": "Soul Retreat Labs", "support_website_url": "https://www.soulretreat.app/support", "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39029217056693610"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823366_2130230087584845_6668971974831300590_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXzkBKUx6jQQ7kNvwGbbwxu&_nc_oc=AdrxyJvvEZU1_zEAeTzl_E6gSv2IkkTU0-T51-_vOKtlqu0pZECPSZLNLyOQfYQEs-E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxRhlfu-vXIMVos2TEZZvy-m40dsM_kQAPGU4bzcW6RQ&oe=6AFB31B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SOUL RETREAT: Relax in Nature & Meditate", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS"
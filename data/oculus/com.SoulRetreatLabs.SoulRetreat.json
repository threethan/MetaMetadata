4939431751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IftJ_7OTzQQ7kNvwHWHY3z&_nc_oc=AdoTuXsPrgZuGbV_6Zm1TIeftLJgCplMACjRVxCUlnVasSulu7qT1mJLa7ezQwWNL0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5P_CNUUTCAmEA5-5Pse6J-u55oHFINU3Gl5OmGjwiig&oe=6ACCEAC4"}, {"file_name": "66.png", "id": "1338762311062673", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308699_1338762314396006_6664816897366106756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ0PPT1pdOUQ7kNvwGqJk_b&_nc_oc=AdpHv9i0oC62aqhHnt05d2TPmjOco_PSJn3JZVFAIyKxZY33Ruv-26OvsPR84ZBLALw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVBaJFq8V6NCVsmHw0vQ7k9g7MpILW0xxDsaeCv5MYGA&oe=6ACD0ED6"}, {"file_name": "64.png", "id": "814893714679414", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296037_814893718012747_3941211415845084627_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve3FbL5BJ4IQ7kNvwE2CRV-&_nc_oc=Adpu0mirQmWXklY-dcQh9TQb5NJaZ_bV0e-8FrEBEL5YrcsfKXjEReu21eMRlzddS-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvdZXaerjinGv_m_TKNwuXEygrJ_C7k1BX70_RvHme_Q&oe=6ACCF558"}, {"file_name": "61.png", "id": "1551165802902407", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303746_1551165809569073_8864999128709901168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD1gPXY8zn8Q7kNvwHINtG3&_nc_oc=AdqHQL2e2w9t-cEDByYkQeOvgIhTZe5UKQTWj_nAcxF0Whme4CQWqkGmlCPSq0tC9FU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZHsym3EmOlTACxqBVPKG-PZrNFPPyN56oKhJLSm49og&oe=6ACCF996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px.png", "id": "791609413673028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303445_791609417006361_902044843593706330_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zz1UJhL3vMQ7kNvwFny1vl&_nc_oc=AdpfLgVKmoHaLyTgBTHVrSi4QOA_muNJnSKlqZbCLMnDPwkS2ueBP_wEVbdK3IBz3-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlZ6J7yvnMoIpeyTxTxSx7HpQwjSlWivfxll17uiRPIA&oe=6ACD1110"}, "display_name": "Soul Retreat", "keywords": ["relaxation", "meditation", "wellness", "free", "sleep"], "long_description": "**Life moves fast. Stress piles up. Sometimes, you just need to escape.**\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature.\n\nSoul Retreat is built on the belief that deep relaxation comes from reconnecting with the natural world - even when it\u2019s difficult to get outside. In collaboration with experts in psychology and well-being, we\u2019ve designed an experience that merges science with the timeless wisdom of nature.\n\n**Stay present and relaxed\u2014use hands, controllers optional.**\n\n{2207029879783851}\n\n**Adaptive stories and meditations, shaped by how you feel and what you see**\n\n{825733700386282}\n\n**Engage in musical, relaxing breathing exercises with real-time biofeedback.**\n\n{1369121291361889}\n\nNo two days\u2014or minds\u2014are the same. Soul Retreat\u2019s adaptive guidance uses your mood and goals to tailor meditations and stories to the scene around you. Use simple hand gestures or voice to shift the time of day, paint stars, and settle into midnight\u2019s calm\u2014so every session fits how you feel. \n\nDisclaimer: Soul Retreat is a self-help wellness and relaxation app, for people 18 or older. It is not therapy, does not diagnose, treat, or prevent mental-health conditions, and is not a substitute for care from a licensed professional.", "short_description": "Life moves fast. Stress piles up. Sometimes, you just need to escape.\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Soul Retreat Labs", "support_website_url": null, "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28320567510892005"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1384096203204182"}]}, "baseline_offer": {"id": "1384096203204182"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770314400, "status": "PUBLISHED", "id": "1384096203204182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38733979939550658", "version": "0.2.56"}, "id": "1008249534449753", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38733979939550658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1008249534449753"}]}, "change_log": "v0.2.56 - The 3D Nature Update: waterfalls, peaks, and canyons\n\nStep into an Enhanced 3D location and every rock, cliff and slope has its true shape and scale, built from LiDAR scans of the real place. The water runs and the leaves move just as they did when it was captured. Lean or take a step and the nearby rocks slide past the ones behind, as if you were really there, not looking at a 360 video wrapped around you.\n\n- Three new locations with Enhanced 3D\n  - Soaso Falls, Spain: epic tiered waterfalls\n  - Iffigalp, Switzerland: high alpine mountain peak\n  - Escuain Gorge, Spain: densely wooded canyon\n\n- Acherito, Aneto, La Besurta, and Portalet now have Enhanced 3D, and Loch Ness has improved sound. Already downloaded one? Point at it, hold the trigger for 2 seconds to delete it, then download it again\n- Every location looks sharper and clearer\n- A new button on your wrist opens the menu. Look at the back of your wrist and tap it. It is easier to find than the palm pinch, which still works\n- Over 30 hours of hand-curated meditations and stories, available with the 10 minute Guided Duration. Every location has three History, three Legend, three Nature and three Body sessions, and they work offline too. Other lengths are written live when you are online\n- Spoken Language is now free: your guide can speak French, German, Italian, Portuguese or Spanish, best with the Alina voice. Set both in Settings > Sound. Menus and offline sessions are still in English for now, with fuller support on the way\n- Better stories and meditations: History and Legend follow one clear episode from an inviting opening, Body meditations are rebuilt, and your guide pauses at the end of a thought, never mid-sentence\n- Sessions start sooner, with about half the opening talk gone, and finish closer to the Guided Duration you chose, even when you do a second one in the same visit. Session Duration is now called Guided Duration: find it in Settings > Timing or on the Meditate, Story and Music tabs\n- Your guide introduces each location the first time you visit, and pointing at one in the menu shows where in the world it is\n- The menu is easier to use: a short pointer shows what you are aiming at, and you can touch items with a fingertip\n- Music now plays through a whole session without a hand on your stomach\n- Changing the time of day with a swipe now needs a second swipe to confirm, so a stray hand movement will not darken the world\n- Bug fixes, plus performance and memory improvements\n\nNew users\n- A quicker, hands-on start: learn to open the menu and choose where to go, answer just two questions, and your first session begins on its own\n\nFree only\n- Every week, one of the seven Enhanced 3D locations is free\n- Profile now has a Soul Retreat Plus page: see every place in the library, hear the two-minute voice demo, or start a free 7-day trial\n- You can now buy Lifetime Plus in the app\n\nPlus only\n- To see what Enhanced 3D really does, switch between Enhanced 3D, Flat Ground, and 360 Video in Profile > Settings > Advanced > Visitor Setup > View\n- Visitor Mode, in Profile > Switch User, makes it easy to show Soul Retreat to friends. Visitor Setup, in Settings > Advanced, pre-sets it to one location and can start a session automatically, for anyone who finds menus difficult\n- Thumbstick Move and Smooth Turning have moved to Settings > Advanced > Controllers\n\nQuestions, feedback, and bug reports are always welcome, and if you work in research or care we would like to hear from you. Email support@soulretreat.app or join the Discord from Profile > Help.", "created_date": 1790368438, "id": "38733979939550658", "version": "0.2.56", "version_code": 1090, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": 
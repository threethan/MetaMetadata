7f20f&oh=00_Af6S9tPHTNe_tahRvn2byRb_pxcDGLL_nZUk0ptjCU2Y1Q&oe=6A12F316"}, {"file_name": "64.png", "id": "814893714679414", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296037_814893718012747_3941211415845084627_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMomQQzE5DkQ7kNvwFArzjn&_nc_oc=Ado20YA756r35Y1vAG4MaxZxfCeXHYemK8KhdIlqQNl3Z5aG1gnw1T1o3dyaSPV6qY4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VugUz-2vvxQZvFsivt1gBqwLFY9QQL1OHIBC4Nx1hkA&oe=6A1311D8"}, {"file_name": "61.png", "id": "1551165802902407", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303746_1551165809569073_8864999128709901168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ua10jc1qb1gQ7kNvwHHzM0X&_nc_oc=Adpye_IFkB04QkxLgxpiDTIbMMcC-RnWqcQZ3zdEZsNgVZMKvVJeuFLKAZeSPRW9_kA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50sTjuSvP56a1wxVAecxOWKCeFGBjjfI7Pfn3nkRfEnQ&oe=6A131616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px.png", "id": "791609413673028", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_791609417006361_902044843593706330_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYELGwzQFmgQ7kNvwGunRA2&_nc_oc=Adp58cDrFIYxENX0kCrIDyjmeZSxC0HBd9l7QFEqNFhVLwAPow90UaaIqhwiIugknWM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pYfMM2s9PlQedmPB9cscstFnUyYxre84fT3mtk4MUyg&oe=6A12F550"}, "display_name": "Soul Retreat", "keywords": ["relaxation", "meditation", "wellness", "free", "sleep"], "long_description": "**Life moves fast. Stress piles up. Sometimes, you just need to escape.**\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature.\n\nSoul Retreat is built on the belief that deep relaxation comes from reconnecting with the natural world - even when it\u2019s difficult to get outside. In collaboration with experts in psychology and well-being, we\u2019ve designed an experience that merges science with the timeless wisdom of nature.\n\n**Stay present and relaxed\u2014use hands, controllers optional.**\n\n{2207029879783851}\n\n**Adaptive stories and meditations, shaped by how you feel and what you see**\n\n{825733700386282}\n\n**Engage in musical, relaxing breathing exercises with real-time biofeedback.**\n\n{1369121291361889}\n\nNo two days\u2014or minds\u2014are the same. Soul Retreat\u2019s adaptive guidance uses your mood and goals to tailor meditations and stories to the scene around you. Use simple hand gestures or voice to shift the time of day, paint stars, and settle into midnight\u2019s calm\u2014so every session fits how you feel. \n\nDisclaimer: Soul Retreat is a self-help wellness and relaxation app, for people 18 or older. It is not therapy, does not diagnose, treat, or prevent mental-health conditions, and is not a substitute for care from a licensed professional.", "short_description": "Life moves fast. Stress piles up. Sometimes, you just need to escape.\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Soul Retreat Labs", "support_website_url": null, "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28320567510892005"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1384096203204182"}]}, "baseline_offer": {"id": "1384096203204182"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770314400, "status": "PUBLISHED", "id": "1384096203204182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35287825590832794", "version": "0.2.44"}, "id": "1008249534449753", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35287825590832794"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778844758, "id": "35606749022273781", "version": "0.2.45", "version_code": 597, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35287825590832794"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1008249534449753"}]}, "change_log": "v0.2.44 App improvements, with new music and AI improvements for Plus\n\n\u2022 Join a 30 day challenge to help you progress towards your goal. Turn on Relaxation check ins and complete at least 3 sessions a week at 10 minutes or longer for 4 weeks. Then post a screenshot of My Journey in Discord to receive an exclusive Soul Retreat mug\n\u2022 Smooth turning with a controller is now supported. Turn it on in Profile > Preferences > Controls > Smooth turning\n\u2022 Thumb-stick movement is now optional and off by default to preserve comfort. Enable it in Profile > Preferences > Controls > Stick Move\n\u2022 Resuming Soul Retreat after leaving the headset now works better\n\u2022 Binaural beats volume reduced by 6 dB to blend more naturally with the music\n\u2022 Fixed issue with analytics\n\nPlus only\n\u2022 Added a new music track, Stillwater Piano, an ambient blend of reflective atmospheres and soft piano tones\n\u2022 Plus now uses an improved AI model, with more reliable voice command handling for higher quality voice sessions\n\u2022 Voice requests for a specific session length now work correctly, so asking for a 10 minute session gives you a 10 minute session even if your saved session duration preference is different\n\u2022 Environments are no longer removed just because you are offline and have not logged in for several days\n\u2022 Added Italian and Portuguese as experimental spoken session languages in Preferences > Sound > Spoken Language. Menus, breathing intro, fixed phrases, and voice commands remain in English for now. These areas will be improved in a future update.\n\nQuestions, feedback, or bug reports are always welcome. Email support@soulretreat.app or join the Discord from Profile under Connect and Support.", "created_date": 1777632322, "id": "35287825590832794", "version": "0.2.44", "version_code": 584, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35287825590832794"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777484053, "id": "35251346374480716", "version": "0.2.43", "version_code": 572, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35287825590832794"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777294256, "id": "35200033219612032", "version": "0.2.42", "version_code": 568, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 21}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28320567507558672", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35287825590832794"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775976931, "id": "34881158034832887", "ve
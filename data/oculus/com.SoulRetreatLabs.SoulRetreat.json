.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXEc5tOkUAQQ7kNvwHKaJT8&_nc_oc=Adp3tdfDcUpPY0YkApmbnji4sEAKF6y7LW_qCWbEpqrxlfbUk6lB5cceVJCq0dMmKKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyrjnyQtSGAP-gxnVkM5b6rAzYCZXaTDlJafpz6G3xXA&oe=6B104C50"}, {"file_name": "65.png", "id": "1070306075058914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303769_1070306078392247_4031857464939431751_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aiumym4JbkQ7kNvwEbmdcl&_nc_oc=AdqvG_ikBGIFIkvC8tyb9CKPerKPjJpiuhyVkgVVl0GBEeRMbnQTZ7Njkalm0AgrYKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLOIrUv2BPSiQpXMcuo4J9RC1nH8BbmLOwa0Xo7OcV3g&oe=6B105F84"}, {"file_name": "66.png", "id": "1338762311062673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308699_1338762314396006_6664816897366106756_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lyuh6PxA1IIQ7kNvwGfGLiD&_nc_oc=AdpB8wUA-389mlrrfErf-KlPTARIsRh2VeE3hq1cv9I8zebqVE_hPgQoOGmh4pwm_Uw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWL-_maSi6_y3dtwLqMDztPofVpIKR92jmf3RGPzUTJzw&oe=6B104B56"}, {"file_name": "64.png", "id": "814893714679414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296037_814893718012747_3941211415845084627_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqXqWE1OMF0Q7kNvwGfvfHD&_nc_oc=AdpeFoIKGUrGDZzOIwHE5OjQX774ETepsvxbqIxfelKyerlJtn4G7ia0tWgb7yVNxJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvtQNCI19lt93TfHKsyZnnrifuHgvvyG3UIJL3NuajjA&oe=6B106A18"}, {"file_name": "61.png", "id": "1551165802902407", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303746_1551165809569073_8864999128709901168_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSXjJSi0w-oQ7kNvwEoSPpf&_nc_oc=AdowdIGGRodJ7RwGlWH57OQz3fqAcJ-WYZzWyuuIap7sP6q3SLBkAaHwgZjg7p_Drs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmbqk3XXMO5sCmjZ-PYpoCd52TrvwIJ6_lnm26BuVEtw&oe=6B103616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px.png", "id": "791609413673028", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_791609417006361_902044843593706330_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxmODadacZAQ7kNvwHFNMn0&_nc_oc=Adp4OWWyUsEUv-6Y6uS-MPQd56kWz93rnUsk-PTESLNUGsrO16HHKlK9eIgcrMqjLyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2Za8RuNdscV9OhPfmYz_J4t_jjzSNRLuvRXljh2SgHA&oe=6B104D90"}, "display_name": "Soul Retreat", "keywords": ["relaxation", "meditation", "wellness", "free", "sleep"], "long_description": "**Life moves fast. Stress piles up. Sometimes, you just need to escape.**\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature.\n\nSoul Retreat is built on the belief that deep relaxation comes from reconnecting with the natural world - even when it\u2019s difficult to get outside. In collaboration with experts in psychology and well-being, we\u2019ve designed an experience that merges science with the timeless wisdom of nature.\n\n**Stay present and relaxed\u2014use hands, controllers optional.**\n\n{2207029879783851}\n\n**Adaptive stories and meditations, shaped by how you feel and what you see**\n\n{825733700386282}\n\n**Engage in musical, relaxing breathing exercises with real-time biofeedback.**\n\n{1369121291361889}\n\nNo two days\u2014or minds\u2014are the same. Soul Retreat\u2019s adaptive guidance uses your mood and goals to tailor meditations and stories to the scene around you. Use simple hand gestures or voice to shift the time of day, paint stars, and settle into midnight\u2019s calm\u2014so every session fits how you feel. \n\nDisclaimer: Soul Retreat is a self-help wellness and relaxation app, for people 18 or older. It is not therapy, does not diagnose, treat, or prevent mental-health conditions, and is not a substitute for care from a licensed professional.", "short_description": "Life moves fast. Stress piles up. Sometimes, you just need to escape.\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Soul Retreat Labs", "support_website_url": null, "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28320567510892005"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1384096203204182"}]}, "baseline_offer": {"id": "1384096203204182"}, "is_approved": true, "firstOffer": {"nodes": [{"s
rkOxWOgBj254lCSU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxz4VmnLGVwOd86PYeqzq6v5KAym-eWhU0q93315hc-Zg&oe=69BA9329"}, {"file_name": "meta screenshots (4).png", "id": "902299399056066", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303864_902299402389399_5656782700268335348_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1wLJjsuJhcQ7kNvwEn3WIH&_nc_oc=AdnMdT0FgVSZptO-09pqQlWMREL3NXj4CwV4Ji6Ng9JvffdlVlGfOIIrpB8ifpI2JnA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwx8YWRc5TmiP-91-AkRnTxl5fMu-LH9KtBXe_Jq-ahFg&oe=69BA89B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px_Larger wordmark.png", "id": "1768400750521973", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821568_1768400753855306_7556778556820744979_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Birm7Wh5n-IQ7kNvwFvsuvt&_nc_oc=AdmSRBvoGfa03iiSWt5ZLsaWXE03cjUB3tF5WLGXyK9httN0rfnqEC8XsdB-qbr01V4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfJHT7xnzzTSXU-Ncoq15ahuOpDTnyaj42P4EBVprDwg&oe=69BA834F"}, "display_name": "SOUL RETREAT: Relax & Meditate in Nature", "keywords": ["meditation", "relaxation", "sleep", "nature", "stress"], "long_description": "**PHOTOREAL NATURE FOR RELAXATION, SLEEP AND FOCUS**\n\nStep away from daily stress into photorealistic nature with personalised meditations, sleep stories, guided breathing and calming music. Unwind in beautiful real places to feel calmer, improve focus, and sleep better.\n\n**Free version includes 3 environments.** Soul Retreat Plus gives you the full library and an AI mindfulness guide that tailors sessions to you, with subscription or lifetime options.\n\n{1588589278830609}\n**PHOTOREALISTIC NATURAL LANDSCAPES**\n- Feel truly there with room scale GroundedPresence\u2122\u2014real places captured on location.\n- Reconnect with nature to unwind, backed by research.\n\n{1399164411623864}\n**MEDITATIONS & STORIES THAT ADAPT TO YOU**\n- No two days are the same. Adaptive guidance tailors meditations and stories to how you feel and what you see.\n- Your mindfulness guide remembers what works for you, so it gets easier to relax and meditate over time.\n\n{867086102669281}\n**WIND DOWN FOR SLEEP**\n- Drift off with sleep friendly dimming. Stars and music respond to the rhythm of your breath.\n- Natural hand tracking throughout, controllers optional.\n\n{1240256504593084}\n**CREATED BY EXPERTS, BACKED BY RESEARCH**\n- Calm, sleep, and focus courses created by our PhD psychologist.\n- VR nature immersion and resonance breathing draw on NIH and NASA-supported research.\n\n{1798560980789807}\n**FREE VERSION, OPTIONAL PLUS**\n- **Free:** 3 calming environments (1 rotates weekly). Unlimited use.\n- **Soul Retreat Plus:** 11+ environments, AI mindfulness guide you can speak to, more personalized meditations and sleep stories. New content added regularly.\n\n**Try the free version.**", "short_description": "Step away from daily stress into photorealistic nature with personalised meditations, sleep stories, guided breathing and calming music. Unwind in beautiful real places to feel calmer, improve focus, and sleep better.\n\n\u2022 Feel truly there with GroundedPresence\u2122 visuals\u2014real places captured on location.  \n\u2022 Your mindfulness guide remembers what works for you\u2014so it gets easier to meditate over time.  \n\u2022 Wind down for sleep,  relax with dimmed visuals and guided breathing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": "https://soulretreat.app/soul-retreat-eula.pdf", "publisher_name": "Soul Retreat Labs", "support_website_url": "https://www.soulretreat.app/support", "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
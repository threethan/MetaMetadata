deo_trailer": null, "video_trailer_thumbnail": {"file_name": "CA-LANDSCAPE- 2560 x 1440px.png", "id": "791609413673028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_791609417006361_902044843593706330_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt_0EYvYrDYQ7kNvwFNDSIH&_nc_oc=AdqfnB1rOEWxAXw-xmD4T4ZViGDnqL7dtqj9gnuc6fIK3nJzTIjYi8_6GOvUj-8POVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnXWDz3JqS9zq-vpVCv4YhRUMn9QVqqs0aA9kxloe_0A&oe=6AFDD890"}, "display_name": "Soul Retreat", "keywords": ["relaxation", "meditation", "wellness", "free", "sleep"], "long_description": "**Life moves fast. Stress piles up. Sometimes, you just need to escape.**\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature.\n\nSoul Retreat is built on the belief that deep relaxation comes from reconnecting with the natural world - even when it\u2019s difficult to get outside. In collaboration with experts in psychology and well-being, we\u2019ve designed an experience that merges science with the timeless wisdom of nature.\n\n**Stay present and relaxed\u2014use hands, controllers optional.**\n\n{2207029879783851}\n\n**Adaptive stories and meditations, shaped by how you feel and what you see**\n\n{825733700386282}\n\n**Engage in musical, relaxing breathing exercises with real-time biofeedback.**\n\n{1369121291361889}\n\nNo two days\u2014or minds\u2014are the same. Soul Retreat\u2019s adaptive guidance uses your mood and goals to tailor meditations and stories to the scene around you. Use simple hand gestures or voice to shift the time of day, paint stars, and settle into midnight\u2019s calm\u2014so every session fits how you feel. \n\nDisclaimer: Soul Retreat is a self-help wellness and relaxation app, for people 18 or older. It is not therapy, does not diagnose, treat, or prevent mental-health conditions, and is not a substitute for care from a licensed professional.", "short_description": "Life moves fast. Stress piles up. Sometimes, you just need to escape.\n\nSoul Retreat is your personal haven for relaxation\u2014immerse yourself in photorealistic natural landscapes, enjoy calming music and breathing exercises, or explore guided meditations and stories. Thanks to our GroundedPresence\u2122 graphics technology, you\u2019ll feel truly there, surrounded by the soothing beauty of nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soulretreat.app/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Soul Retreat Labs", "support_website_url": null, "website_url": "https://www.soulretreat.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28320567510892005"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1384096203204182"}]}, "baseline_offer": {"id": "1384096203204182"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770314400, "status": "PUBLISHED", "id": "1384096203204182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__
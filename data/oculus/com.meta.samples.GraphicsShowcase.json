aA&oe=69FB38F8"}, {"file_name": "screen4.png", "id": "1658166027932438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241698_1658166031265771_1482428283944475893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EHs6CrW8lUQ7kNvwH8oEsf&_nc_oc=AdpOMk659vve4AaEFMumZnofiK5rO3hXsF_bZNMpgBel4ER6d3XIPnaOKWuVMwUQ38g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79SyQHGxKFNwz9_VHmp-Al4ly-6VsabePPSiHFtmqQoQ&oe=69FB3AB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Graphics Showcase", "keywords": [], "long_description": "This application is a technical demo intended for Quest developers using Unreal Engine 5. \n\nTone mapping is an important artistic tool for developers. Graphics Showcase features a Vulkan subpass-based tone mapping solution that is much more performant than traditional techniques.\n\nPress B to cycle through these effects:\n- Day / Night cycle\n- Sepia LUT\n- Reddish LUT\n\nPress A to toggle tonemap subpass off / on\n\nPress Right Trigger to toggle FFR off / high\n\nPress Right Grip to toggle MSAA 1/2/4", "short_description": "This application is a technical demo intended for Quest developers using Unreal Engine 5. \n\nTone mapping is an important artistic tool for developers. Graphics Showcase features a Vulkan subpass-based tone mapping solution that is much more performant than traditional techniques. \n\nPress B to cycle through these effects:\n- Day / Night cycle\n- Sepia LUT\n- Reddish LUT\n\nPress A to toggle tonemap subpass off / on\n\nPress Right Trigger to toggle FFR off / high\n\nPress Right Grip to toggle MSAA 1/2/4"}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/quest/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/quest/terms-of-service/", "publisher_name": "Meta", "support_website_url": null, "website_url": "https://developer.oculus.com/blog/graphics-showcase-using-vulkan-subpasses-in-ue4-for-
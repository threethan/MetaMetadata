_AQQzEC843-sj4CKrb02SKi_rtjodEscNTZ1mnO3k7eim3w&oe=6AF0947F"}, {"file_name": "Main_Custom..._14.09.2026_14-59-53.png", "id": "1764193428150415", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_1764193434817081_119365803032293517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyWx4XJ2TmgQ7kNvwFgkmWW&_nc_oc=AdrY3exbCt86pfuyTzsfkm8FnTkb-OG2CbiravcOid-g0bSLODTC1WtSV2DImxUog5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYHXPmojM5H-3BhSyqKWSuoJD03mUILIqpfR0290yk4g&oe=6AF09A83"}, {"file_name": "Main_Custom..._14.09.2026_15-00-06.png", "id": "2185777025685709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2185777032352375_653370719857600049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVxTVDSn4l4Q7kNvwHIDxc7&_nc_oc=AdovFOGYEducwFI_u2cEj1tftM1uNHE7yodYOVeUKnb2XlIwq-GddqRKD1d7y5-revw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCl4rkao8M7Doe0YskQf6U9O3HBz3vnwFsoqTQ0OTt8w&oe=6AF0AB07"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarins VR", "keywords": ["Fangame", "2023", "horror", "minigames"], "long_description": "# Discover Tamarins VR \ud83d\udc12\n\nThe ultimate community-driven virtual reality experience designed for players who love **classic physics-based locomotion** and **fast-paced multiplayer fun**.\n\nInspired by the nostalgic golden era of **2023 VR movement games**, Tamarins VR lets you **swing, slide, and race** through vibrant jungle environments using only your hands.\n\n## Step Into the World \ud83c\udf34\n\nStep into the **social lobby** to meet players from around the world, show off your unique style with a **massive selection of unlockable cosmetics**, and dive into a variety of exciting **minigames**.\n\nWhether you are chasing friends in competitive modes or exploring hidden corners of the map, there is always something to do.\n\n> **Grab your headset, master the movement, and join the community today!**\n", "short_description": "Welcome to Tamarins VR, the ultimate classic-style VR fan game bringing back nostalgic 2023 community vibes. Swing, slide, and race through maps using physics-based hand-movement locomotion. Jump into fast-paced minigames, unlock cool cosmetics to style your character, and hang out in public lobbies or private codes with friends."}]}, "developer_name": "Marshy industries", "developer_privacy_policy_url": "https://sites.google.com/view/tamarins-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/tamarins-vr/home?authuser=0", "publisher_name": "M&P Games", "support_website_url": null, "website_url": "https://sites.google.com/view/tamarins-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1365467596645265"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1369798382878853", "version": "0.4.0"}, "id": "1518363780055963", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "App
oculuscdn.com/v/t64.5771-25/491828008_993737989705034_2322025418005905166_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6jft6RlDsgQ7kNvwFFCEza&_nc_oc=AdqVOLPwL7FClueQlZn9lKBVtyyLsEV8su9cxYptiW-ZbaCPIKqMCq_8XXB3enLlx5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8ev08k1RsEm2BDHGXsvJQFc6RlcDPODoxYbN5_t5pZQ&oe=6AFF14FF"}, {"file_name": "Main_Custom..._14.09.2026_14-59-53.png", "id": "1764193428150415", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_1764193434817081_119365803032293517_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg0oB96ivSoQ7kNvwF6poAn&_nc_oc=Ado3oFd3M-INiSIDhsxlse_r5kPlGsT0lz2h3yIhr4irmr_O1xFXFLmdqEfHDGnPDxc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf4oT5xC2h3-Q0wCLjQvPWK0MLxGr7LnYug_S1REJyuw&oe=6AFF1B03"}, {"file_name": "Main_Custom..._14.09.2026_15-00-06.png", "id": "2185777025685709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2185777032352375_653370719857600049_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVgLuB8pPUgQ7kNvwHmG3uu&_nc_oc=AdqDokqtWxuftoKwD74eAoqTk-5Wyv5NXQAbmWAx3v0lBq-bFBik_7ZRQN0itOinlZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4M2ptM73zfHumuea1ntIrBjDTumIK_pn98oVbcILMmg&oe=6AFF2B87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarins VR", "keywords": ["Fangame", "2023", "horror", "minigames"], "long_description": "# Discover Tamarins VR \ud83d\udc12\n\nThe ultimate community-driven virtual reality experience designed for players who love **classic physics-based locomotion** and **fast-paced multiplayer fun**.\n\nInspired by the nostalgic golden era of **2023 VR movement games**, Tamarins VR lets you **swing, slide, and race** through vibrant jungle environments using only your hands.\n\n## Step Into the World \ud83c\udf34\n\nStep into the **social lobby** to meet players from around the world, show off your unique style with a **massive selection of unlockable cosmetics**, and dive into a variety of exciting **minigames**.\n\nWhether you are chasing friends in competitive modes or exploring hidden corners of the map, there is always something to do.\n\n> **Grab your headset, master the movement, and join the community today!**\n", "short_description": "Welcome to Tamarins VR, the ultimate classic-style VR fan game bringing back nostalgic 2023 community vibes. Swing, slide, and race through maps using physics-based hand-movement locomotion. Jump into fast-paced minigames, unlock cool cosmetics to style your character, and hang out in public lobbies or private codes with friends."}]}, "developer_name": "Marshy industries", "developer_privacy_policy_url": "https://sites.google.com/view/tamarins-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/tamarins-vr/home?authuser=0", "publisher_name": "M&P Games", "support_website_url": null, "website_url": "https://sites.google.com/view/tamarins-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1365467596645265"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"late
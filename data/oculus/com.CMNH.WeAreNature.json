 social and cultural tool for exploring the broad sum effect humans are having on the planet. \n\nExplore the Anthropocene for yourself.", "short_description": "By Carnegie Museum of Natural History.\n\nDiscover more about humanity's complex relationship with the environment in We Are Nature\u2014the first exhibition in North America to focus on the Anthropocene."}]}, "developer_name": "GuidiGO Inc.", "developer_privacy_policy_url": "https://carnegiemuseums.org/privacy-policy/", "developer_terms_of_service_url": "https://carnegiemnh.org/terms-of-use/", "publisher_name": "Carnegie Museum of Natural History", "support_website_url": "https://carnegiemnh.org/contact/", "website_url": "https://carnegiemnh.org/nature-thoughts-feelings-visitors/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "461067465697355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_539927583499386_438177489865408512_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1E55H0-xdEQ7kNvwGwrtz5&_nc_oc=AdnpsY5Ecz2q2gNJf08o44xTq8Rke4AfOt7xXDxm28gt-GFaJ4sqyJm8wWkcB5uUvc4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvNp2AWO4C505K2Z9BU_gBDei0RgXyldtoZeRYRx8cKsg&oe=69A58363"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "We Are Nature: Living in the Anthropocene", "platform": "ANDROID", "context_categor
577664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkeWFmrR8Q4Q7kNvwFno0v1&_nc_oc=Adoc5Hlfb0v6uwSq_9t2OQ83qFdSInS6VgHlfzk-Rh5ISOAdsIYOQrVR15bFQhGZuTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MyWIMIHiEHoTr1lUpJZKsCkMyGX_uYfpV6sVgSqBMIQ&oe=6A087D00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "We Are Nature: Living in the Anthropocene", "keywords": ["exhibit", "nature", "climate", "carnegie", "museum"], "long_description": "Discover more about humanity's complex relationship with the environment in We Are Nature\u2014the first exhibition in North America to focus on the Anthropocene. \n\nThe Anthropocene is the current geological era in which humans are making a profound impact on the geological strata. While the term itself is still being debated by geologists, Carnegie Museum of Natural History is embracing it as a social and cultural tool for exploring the broad sum effect humans are having on the planet. \n\nExplore the Anthropocene for yourself.", "short_description": "By Carnegie Museum of Natural History.\n\nDiscover more about humanity's complex relationship with the environment in We Are Nature\u2014the first exhibition in North America to focus on the Anthropocene."}]}, "developer_name": "GuidiGO Inc.", "developer_privacy_policy_url": "https://carnegiemuseums.org/privacy-policy/", "developer_terms_of_service_url": "https://carnegiemnh.org/terms-of-use/", "publisher_name": "Carnegie Museum of Natural History", "support_website_url": "https://carnegiemnh.org/contact/", "website_url": "https://carnegiemnh.org/nature-thoughts-feelings-visitors/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null,
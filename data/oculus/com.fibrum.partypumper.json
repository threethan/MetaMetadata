nUQ&oe=69C131B0"}, {"file_name": "38974542_726633554473159_6753725116774875136_n.png", "id": "268447069236812", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031334_268447072570145_4022656197983138343_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7imHnhwEtycQ7kNvwG6PQQ7&_nc_oc=AdojTmtUVNd9liS6_k1QDIGA1zNLfOOQxuKQnd-iidzAVGtwH5etiDtPTFfprcBMXKQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfypdfbmnfmDeJNmZARa5p74CsF8ON0vMxZm4dEi2s77vA&oe=69C13D12"}, {"file_name": "38974647_913737119011027_8073745519488270336_n.png", "id": "1358384331764262", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_1358384335097595_3063688328018203506_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEfN2ItQ-AcQ7kNvwHELw6m&_nc_oc=AdokgImtBkEBlzxMxq11dOHg_vNb-gA4WVkW0omou1m2CDEBuzqv1KVsOkcuBcnWs5M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwWGGPaUdCsVFUkLR3MKloRJsg9W8hbkKOfE5VUhoG4Cw&oe=69C143BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39036647_746012619174214_4038591227698872320_n.png", "id": "226246589974241", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982552_226246593307574_457153700721404435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3jLqERzrxQQ7kNvwEKbRM2&_nc_oc=Adq9eamBI6wFq1e7WwzLNP2GKXjIS5yfAf6ju85VUIiu7wva0AU2_iJmGU60eMPRR7w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwnoI7NHQrrPN3oSvB_pITvh8X_TJdU5q6Q2d2z7z1Euw&oe=69C1334F"}, "display_name": "Party Pumper", "keywords": [], "long_description": "Born in the vibrations of music, Party Pumper is a game about parties and for parties!\nPlayer's goal is to entertain the audience with the help of rhythm from mixes of music samples. Combine them with dance movements and fun party gadgets action to interact with partygoers crowd from the stage to Pump better!\n\nThe main tool is an innovative DJ panel with a rich arsenal of bass, melodies, drums, chords and other beats that forms a great foundation to create unique track on a fly.\n\nFeatures:\n- Intuitive and captivating multitasker gameplay - it\u2019s not only about rhythm, but also about fast and smart combination of actions\n- New track every play - huge set of different music samples to use in different combinations\n- Real party atmosphere - crowd reacts to DJ set and actions with their mood", "short_description": "Born in the vibrations of music, Party Pumper is a game about parties and for parties! Player's goal is to entertain the audience with the help of rhythm from mixes of music samples. Combine them with dance movements and fun party gadgets action to interact with partygoers crowd to Pump better!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://249724.selcdn.ru/public/privacy_policy_for_fibrum_updated.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fibrum LLC", "support_website_url": null, "website_url": "http://fibrum.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1408257203077205"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "6542196452525542"}]}, "baseline_offer": {"id": "6542196452525542"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1692367249, "status": "PUBLISHED", "id": "6542196452525542"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resul
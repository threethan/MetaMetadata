_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZSlOERAIacQ7kNvwG8CRwD&_nc_oc=AdnTZRrT747hl2jRmZnWR2zXtRTyUe4efqwL2v6NnTdTmk4mM0uV_vJI4mfPXv5eiTM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv5YPgcq7Zhyx0eICeGwxypaWxgNxibjGINcIWobPI42A&oe=69A58D92"}, {"file_name": "38974647_913737119011027_8073745519488270336_n.png", "id": "1358384331764262", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_1358384335097595_3063688328018203506_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F12xWp8Fy4wQ7kNvwHC9nBz&_nc_oc=Adm_Snn5MBzyqr_nvk9gx6lRpedqX2JXcq_pjBbl30VDVPP7ru5pNlKxulzncXKo7IU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft-Tj6_RT8tfauFhAJNZd_cle6y0pujOhtBdy1RKcmetw&oe=69A5943D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39036647_746012619174214_4038591227698872320_n.png", "id": "226246589974241", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982552_226246593307574_457153700721404435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D45iKa-As-UQ7kNvwE8s31m&_nc_oc=Adlf7XouGlFUiMjfiwIjB8ynbPoqwMTTGH5t3gL1-RFx1kEDbot8tteM07vI9f6Bkm0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftY16_HHHYT0cvGZwRhwuF6BSoU5rNbAXGVUs-7o1tL1Q&oe=69A583CF"}, "display_name": "Party Pumper", "keywords": [], "long_description": "Born in the vibrations of music, Party Pumper is a game about parties and for parties!\nPlayer's goal is to entertain the audience with the help of rhythm from mixes of music samples. Combine them with dance movements and fun party gadgets action to interact with partygoers crowd from the stage to Pump better!\n\nThe main tool is an innovative DJ panel with a rich arsenal of bass, melodies, drums, chords and other beats that forms a great foundation to create unique track on a fly.\n\nFeatures:\n- Intuitive and captivating multitasker gameplay - it\u2019s not only about rhythm, but also about fast and smart combination of actions\n- New track every play - huge set of different music samples to use in different combinations\n- Real party atmosphere - crowd reacts to DJ set and actions with their mood", "short_description": "Born in the vibrations of music, Party Pumper is a game about parties and for parties! Player's goal is to entertain the audience with the help of rhythm from mixes of music samples. Combine them with dance movements and fun party gadgets action to interact with partygoers crowd to Pump better!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://249724.selcdn.ru/public/privacy_policy_for_fibrum_updated.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fibrum LLC", "support_website_url": null, "website_url": "http://fibrum.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1408257203077205"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "6542196452525542"}]}, "baseline_offer": {"id": "6542196452525542"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1692367249, "status": "PUBLISHED", "id": "6542196452525542"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5826187237483063", "version": "1.0"}, "id": "298788166151959", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBina
688328018203506_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rY6YFaS5YcQ7kNvwH37k17&_nc_oc=AdrBOQU07FOtdEjHKngYg_-ciIZGQooFmv7TKcWGP05LDjbsv7huWIUj-GjwZz0EdbA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__OalHuSQU5do5ZmQe7q5Ypo_38ZOGLBY1bQfMThtbmA&oe=6A2ABBBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39036647_746012619174214_4038591227698872320_n.png", "id": "226246589974241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_226246593307574_457153700721404435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rigz4QafWBgQ7kNvwGKuO8H&_nc_oc=Ado7Iuq838kgPNRJ0Icqj4r71C3rStXXDIYoRSQFIdb9enqU77TJE3qjaTXvDhZC2Pk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sGUu9f-z5upGUUc4fqKJ9f3A30A-Ra3PHkjKAqaoxQg&oe=6A2AE38F"}, "display_name": "Party Pumper", "keywords": [], "long_description": "Born in the vibrations of music, Party Pumper is a game about parties and for parties!\nPlayer's goal is to entertain the audience with the help of rhythm from mixes of music samples. Combine them with dance movements and fun party gadgets action to interact with partygoers crowd from the stage to Pump better!\n\nThe main tool is an innovative DJ panel with a rich arsenal of bass, melodies, drums, chords and other beats that forms a great foundation to create unique track on a fly.\n\nFeatures:\n- Intuitive and captivating multitasker gameplay - it\u2019s not only about rhythm, but also about fast and smart combination of actions\n- New track every play - huge set of different music samples to use in different combinations\n- Real party atmosphere - crowd reacts to DJ set and actions with their mood", "short_description": "Born in the vibrations of music, Party Pumper is a game about parties and for parties! Player's goal is to entertain the audience with the help of rhythm from mixes of music samples. Combine them with dance movements and fun party gadgets action to interact with partygoers crowd to Pump better!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fibrum.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Fibrum LLC", "support_website_url": null, "website_url": "https://fibrum.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25645264895148670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001660_1409452882966012_1277321653515104037_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biFfwHkjzVoQ7kNvwFTlWAo&_nc_oc=AdqgKfPPlcT-Ro3GWIvt_fjJxuhSDnaklFmsMijJfwyxzQ2Z-BXpwacQ1pYYBPvtONk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2Wg3xXicmEhmX9xtPUPp6lT2KxoluoXpzjESTBMWVdg&oe=6A2ACB90"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Party Pumper", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1692367249, "lastRevision": {"nodes": [{"id": "5822806791154441", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applica
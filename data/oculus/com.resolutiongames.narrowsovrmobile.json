761487_6199635869863772160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jBecmtO3GEQ7kNvwGoS5pj&_nc_oc=Adq6RuCgh9BkJ-8tVeMxKMVVZUzAdy6X_xlRk1opw6DkLB7G0gMqUMkJWl4yXXvQy-M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qqFiGW7d419wSd2ai95RD0LFcnRswDexpXtmDLOu3yg&oe=6A36BC70"}, {"file_name": "migrated_image.png", "id": "492652218287187", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974562_550511935391626_9106890303289163776_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUgfTamanA0Q7kNvwHhyTWs&_nc_oc=AdqhRxe2kJQkhw04WDDXinRXW3Q_s2hNjGBBxSFS8WKtGtqBRPIoGAF5YmkTLaMufDk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h611OmolTX9B4wmUrqC4ThZ-2dOKYdW1y1_v4DcMl6w&oe=6A36AC2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Kd3uH0", "id": "339444466624445", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974466_339444469957778_9131769635790651392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSlqjkjBkiEQ7kNvwF1cyRb&_nc_oc=AdoCcHRQK6Goxeee5U1Ll9tv_nnDYOBKqnLKNJZMOxdzoI_aC0KR3kBuDxWGjGs0bIY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BXzq5BT8TuLWyKZASpWnCdIZ4IKdk6ZckpDO-wqOFPw&oe=6A36ADF8"}, "display_name": "Narrows", "keywords": ["VR", "Narrows", "strategy", "top", "pirate"], "long_description": "Climb aboard, captain! Command your crew and steer your ship to find your fortune in Narrows, a game of high seas strategy and plunder!\n\nNarrows transports players to the golden age of piracy, making you master and commander of your very own pirate ship in VR. Through the magic of the Oculus Go or Gear VR headsets and motion controllers, you can choose your own path on the high seas, customize your cannons and crew, and do battle with the royal navy, rival pirates and more. \n\nNarrows is the newest VR experience from Resolution Games, creators of the Gear VR and Go hits Wonderglade and Bait!", "short_description": "Climb aboard, captain! Become mast
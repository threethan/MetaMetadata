761487_6199635869863772160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMQmSLNrnWgQ7kNvwHAe3Iw&_nc_oc=AdrTtDl246rxKLUDfqbDOJ6jljZ-XFtTq7e7cfKAydYgY749ZVFj_rliJtiPbM4EA5o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hAQMxR9VKKGPwlbn1bV66BWrPvaJO4A_6elQxrgX0Eg&oe=6A119A30"}, {"file_name": "migrated_image.png", "id": "492652218287187", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974562_550511935391626_9106890303289163776_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3dGWRfWeKQQ7kNvwE0nGHB&_nc_oc=AdopR38bBCDGJ_XIj-TuE0nUPTqMifmtEVYix804C4T-Gn4rpBqKXKb9j8EnFdVQK1c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fxdLA7lZNvnYmYIc3dip4LmsFgatRAUSeiOYPrlaGRA&oe=6A11C22C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Kd3uH0", "id": "339444466624445", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974466_339444469957778_9131769635790651392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6tk3wbA_NsQ7kNvwFNeEG4&_nc_oc=AdqG9HJxJca7A5qG5f2tHGUqZnz8-_mN_e1aIWVTJEFOwIklacWWUfRcTNv4DH-CTm8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pIIJoB-6bzWfsfEoZnhEMPQBdmbVKSO92c_n2Bp9ozQ&oe=6A11C3F8"}, "display_name": "Narrows", "keywords": ["VR", "Narrows", "strategy", "top", "pirate"], "long_description": "Climb aboard, captain! Command your crew and steer your ship to find your fortune in Narrows, a game of high seas strategy and plunder!\n\nNarrows transports players to the golden age of piracy, making you master and commander of your very own pirate ship in VR. Through the magic of the Oculus Go or Gear VR headsets and motion controllers, you can choose your own path on the high seas, customize your cannons and crew, and do battle with the royal navy, rival pirates and more. \n\nNarrows is the newest VR experience from Resolution Games, creators of the Gear VR and Go hits Wonderglade and Bait!", "short_description": "Climb aboard, captain! Become mast
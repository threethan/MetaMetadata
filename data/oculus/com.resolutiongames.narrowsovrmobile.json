e.png", "id": "492652218287187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974562_550511935391626_9106890303289163776_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bh_7xzqbnwQ7kNvwGf6ntu&_nc_oc=AdlGAC2StQH5UEiTg8l20Zi0jqZRXEg2RiBvEKjSoa78p-LNWiMMhXUl38ljzoaPDps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNOc3_9s4jelb2mlbl98jbs0vvGTaMLxAoceeihsNKfw&oe=699ED76C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Kd3uH0", "id": "339444466624445", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_339444469957778_9131769635790651392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyoOMbtw1CgQ7kNvwHE97Tb&_nc_oc=AdmLyKbOD0up75tA-E2nMQ2JHSzfC9YQ5CnfZd8a3X_VPehRF-3N8-u2Fhlq7OzmDzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuEPLt2MZSkK2dUmFd6JnivUxciCsK5H-7wgjm3gUTnxg&oe=699ED938"}, "display_name": "Narrows", "keywords": ["VR", "Narrows", "strategy", "top", "pirate"], "long_description": "Climb aboard, captain! Command your crew and steer your ship to find your fortune in Narrows, a game of high seas strategy and plunder!\n\nNarrows transports players to the golden age of piracy, making you master and commander of your very own pirate ship in VR. Through the magic of the Oculus Go or Gear VR headsets and motion controllers, you can choose your own path on the high seas, customize your cannons and crew, and do battle with the royal navy, rival pirates and more. \n\nNarrows is the newest VR experience from Resolution Games, creators of the Gear VR and Go hits Wonderglade and Bait!", "short_description": "Climb aboard, captain! Become master and commander in the golden age of piracy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": null, "website_url": "https://www.resolutiongames.com/narrows", "ca
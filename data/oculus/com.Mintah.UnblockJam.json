bVDsZLbAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s3VNhYY-b1THT2euEWqgcKllPbuXo_E7nGnrn0_B8PQ&oe=69F9F137"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Unblock Jam", "keywords": ["Block", "3D", "Jam", "Mintah"], "long_description": "Unleash your puzzle solving skills in Unblock Jam, a block puzzle game made to challenge your mind and keep you playing for hours. You slide colorful blocks to their matching colored doors to clear the way, but every level adds new obstacles and fun twists that make you think ahead. There are tons of puzzles to get through, and they get more creative as you go, so it always feels fresh. The controls are simple and smooth, the visuals are bright and satisfying, and you can earn rewards as you beat tougher stages and unlock even more levels. Whether you want a relaxing brain game or something that really tests your strategy, Unblock Jam has plenty of challenges to keep you coming back.", "short_description": "Unleash your puzzle solving skills in Unblock Jam, a block puzzle game where you slide colorful blocks to their matching colored doors to clear the way!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mintah.com/vrprivacy/", "developer_terms_of_service_url": null, "publisher_name": "Mintah Games Inc.", "support_website_url": null, "website_url": "https://mintah.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ST
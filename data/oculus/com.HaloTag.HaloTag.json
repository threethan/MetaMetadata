", "tagging", "runners"], "long_description": "Welcome to Halo Tag! Halo Tag is a Gorilla Tag inspired game that uses Gorilla Tags Locomotion. You have to find your way around the caves to find the end! More updates coming soon! You start of with a flashlight that you can go around trying to find the end... This game is still in the very beginning of beta and more updates will come! Now download, get in game, and try not to get lost in the dark...\n", "short_description": "Welcome to Halo Tag! Halo Tag is a Gorilla Tag inspired game that uses Gorilla Tags Locomotion. You have to find your way around the caves to find the end! More updates coming soon! Still in beta!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1w55v5aVsgLVz78k4AO0xzLxOb2h5F49a3dlLN8R5-Y8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "nobodymann", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RI9Yb3_n60aHZMuCG6mErm5HkywfDTYIISA3GUj43h0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26425929600352516"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827585_1987238475477774_5243452427435966340_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4FU2rXbAb8Q7kNvwE
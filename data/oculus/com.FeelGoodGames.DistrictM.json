ontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ziLnYkVkbLL66Sg3TjRiup4bpf7Oa4ek2KlST-aJHsw&oe=6A26EC34"}, {"file_name": "Screenshot 5 - More Track.png", "id": "3689859557807096", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982717_3689859561140429_3474763701630351775_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H6G74il42QQ7kNvwHxMVo3&_nc_oc=AdpuHiGPQP3zxD_ngz-7ptgepH0PtXX688_Wm8XgMWGTzQfKaJDc5mYXGAaWuDJneUc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j0G3iSPL_IQn6hH2-TkrDh1p3yr7vWSn_4j4_kFQKOA&oe=6A26EA59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "292551388950776", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75221327_292551392284109_5502955673277100807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6vBdmbrMKgQ7kNvwHMbcsN&_nc_oc=AdqfOmJW8aiGTytaAC3_HW45Yy-kBVvQoCj554STf48pY7D787TSM6r1EHIqTmrtvAM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9auLCt12m9fEmBaRnnUp4_8-aN6qg5-rU5Gr-WFPZp5w&oe=6A26C59B"}, "display_name": "District M", "keywords": [], "long_description": "We're reimagining the classic platformer for VR! \n\nYou play as a stunt cameraman trying to capture the coolest shots of the skater as you guide him through a colorful world filled with challenging puzzles. From chill, lo-fi maps to challenging jazz compositions, District M will toss hardcore platformer puzzles at you and push your mental and physical creativity to the limit! \n\nIt's unlike any VR game you've seen before.\n", "short_description": "Rhythm meets platformer in District M! Dance to a banger soundtrack and show off your control as you stylishly guide a skater through smooth, lovingly handcrafted levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://autovrse.in/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AutoVRse", "support_website_url": null, "website_url": "https://twitter.com/districtmVR", "categ
ontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uvhvWWugsrdMHGekK6_brhLeTXqkdU0qelLhf7THm8A&oe=6A104A74"}, {"file_name": "Screenshot 5 - More Track.png", "id": "3689859557807096", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982717_3689859561140429_3474763701630351775_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dyyu_2xHc88Q7kNvwEMFnz4&_nc_oc=AdpBkumhDO_UW7CBbAbgx2n7Dd3Tlod9Pd-hWa_oEHqZWAP2w3nn-F5luF0qBeoMRTs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ti4p285DiVJ70p0qLVS0QkJ_MrsWnYexJd4pUs4nS9w&oe=6A104899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "292551388950776", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75221327_292551392284109_5502955673277100807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xy-GVOiMJ8QQ7kNvwFopBcC&_nc_oc=AdqOsStgM-W77kQA7GxX1yGUdRQ44gqnLLN9sqYO_jd0iUTdteA6mbPdZBHFcBzB6hw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D5wEmIs8qLWS_TuHqFfIF6xC2Hd8Kn00aa1Xi8e6QVw&oe=6A105C1B"}, "display_name": "District M", "keywords": [], "long_description": "We're reimagining the classic platformer for VR! \n\nYou play as a stunt cameraman trying to capture the coolest shots of the skater as you guide him through a colorful world filled with challenging puzzles. From chill, lo-fi maps to challenging jazz compositions, District M will toss hardcore platformer puzzles at you and push your mental and physical creativity to the limit! \n\nIt's unlike any VR game you've seen before.\n", "short_description": "Rhythm meets platformer in District M! Dance to a banger soundtrack and show off your control as you stylishly guide a skater through smooth, lovingly handcrafted levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://autovrse.in/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AutoVRse", "support_website_url": null, "website_url": "https://twitter.com/districtmVR", "categ
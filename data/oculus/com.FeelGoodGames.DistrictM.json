ontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx-tlfFrNx3iiqHUGTwCWfUf-_W8YSZoVsk8zHkkWDlA&oe=6A771F74"}, {"file_name": "Screenshot 5 - More Track.png", "id": "3689859557807096", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982717_3689859561140429_3474763701630351775_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8PTKDdiZSgQ7kNvwHW4vyc&_nc_oc=AdrB6LndmsylfVdh5bephAqhIuD6BGP8mN2n4O9litm4j027JmdKFTvtfyVDLuVEWtc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmn33NV-wcuIs5OwA4AwUCBhfWlmdv4d-bnqolYXKUxg&oe=6A771D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "292551388950776", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221327_292551392284109_5502955673277100807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJz3tIGRCUYQ7kNvwExb-Ma&_nc_oc=AdrmbJA3lGI1Q9iE21rmCs7amXpHzfeIDSa8cPYQe1gxKkbXJw3wei0Uv7eTVhBfc1Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTdOqc9LSYq8wvKYcXPiE5FANLkUAHvpR5NekuZxnu6g&oe=6A77311B"}, "display_name": "District M", "keywords": [], "long_description": "We're reimagining the classic platformer for VR! \n\nYou play as a stunt cameraman trying to capture the coolest shots of the skater as you guide him through a colorful world filled with challenging puzzles. From chill, lo-fi maps to challenging jazz compositions, District M will toss hardcore platformer puzzles at you and push your mental and physical creativity to the limit! \n\nIt's unlike any VR game you've seen before.\n", "short_description": "Rhythm meets platformer in District M! Dance to a banger soundtrack and show off your control as you stylishly guide a skater through smooth, lovingly handcrafted levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://autovrse.in/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AutoVRse", "support_website_url": null, "website_url": "https://twitter.com/districtmVR", "categ
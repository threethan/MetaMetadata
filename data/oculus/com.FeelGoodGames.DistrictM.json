ontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqVsvOahw_l8zEOyOeR13Gxe-_pACawiQIuNrjIwyMPg&oe=6A65FBF4"}, {"file_name": "Screenshot 5 - More Track.png", "id": "3689859557807096", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982717_3689859561140429_3474763701630351775_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGtnlkgCOf8Q7kNvwHCOVWG&_nc_oc=Adq9TncyGuwBhg8KAPR_eZNvU-cU-VpgPZLSl91PfOa_o2Y9VVtyKHW2RGChdO_lOZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVmUlZ4rfPGdp3BKOjgIYL2HElYOf_j1AWzWOD34EIlw&oe=6A65FA19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "292551388950776", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221327_292551392284109_5502955673277100807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKmThcPHVMsQ7kNvwGLohJS&_nc_oc=Adp9lZ15pDhxBtqSTdZlMiXHonSGQaNfU8ydTHoyaVhtdN7TNg31C1YCKKpJscLrnMQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD80ZRsFo7ghS6OlnkXtUqfrTHIAT7_hEjuxbBIiQCUBQ&oe=6A660D9B"}, "display_name": "District M", "keywords": [], "long_description": "We're reimagining the classic platformer for VR! \n\nYou play as a stunt cameraman trying to capture the coolest shots of the skater as you guide him through a colorful world filled with challenging puzzles. From chill, lo-fi maps to challenging jazz compositions, District M will toss hardcore platformer puzzles at you and push your mental and physical creativity to the limit! \n\nIt's unlike any VR game you've seen before.\n", "short_description": "Rhythm meets platformer in District M! Dance to a banger soundtrack and show off your control as you stylishly guide a skater through smooth, lovingly handcrafted levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://autovrse.in/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AutoVRse", "support_website_url": null, "website_url": "https://twitter.com/districtmVR", "categ
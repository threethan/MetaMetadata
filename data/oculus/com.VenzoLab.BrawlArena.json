x4QMtyJPLo3e_dLg&oe=6B0EF8D6"}, {"file_name": "IMG_8532-2560x1440.png", "id": "546104944636762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393175_546104951303428_5335905229867086859_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO5_9VTaLscQ7kNvwHfYInF&_nc_oc=AdrGMp-Ite-PHTnSBG0g-F43-ZhGLlZnbzD35XqkZ2gZyAgVykNdpmMaM-DEPNBsCLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSj8AzcvY206woHFJCqFYK8I2BHhhC8aOoLu8sEC3pow&oe=6B0F0F6A"}, {"file_name": "IMG_8535-2560x1440.png", "id": "672857648596957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391810_672857651930290_1045266761108198419_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRJVENd-4fcQ7kNvwF_76FZ&_nc_oc=AdrDXzTCa1kj6u3osjx3UfJ1a_vSzWjGOR6ZhS64StKs68LkJ6ODfKOSewrUNOWQZdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoz7-EclGWJtwD99IiqBku-Oi7TaW6JyfnkHL0jSmxbw&oe=6B0F17BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brawl Arena", "keywords": ["BrawlArena", "Brawl", "Arena", "Fight", "Battle"], "long_description": "Step into the chaos of **Brawl Arena**, an action-packed multiplayer fighting game where anything goes! Battle against up to **10 players** in wild, fast-paced brawls using punches, kicks, and a variety of weapons like baseball bats, chairs, and even tables! \ud83d\udca5\n\n**\ud83d\udd39 Public & Private Matches \u2013** Join the fight with random players or set up private lobbies with friends.\n\n**\ud83c\udf99 Voice Chat \u2013** Trash talk, strategize, or just have a laugh with built-in mic chat.\n\n**\ud83d\udee0 Interactive Environment \u2013** Pick up and throw objects to gain the upper hand in battle.\n\n**\u2694 Unpredictable Fights \u2013** Every match is a chaotic, physics-driven showdown!\n\n\n**\ud83d\ude80 Coming Soon \u2013** Add to Your Wishlist Now! \ud83d\ude80\n\nStay updated and be the first to brawl when the game launches! Wishlist now and get ready to fight! \ud83c\udfc6\ud83d\udcaa", "short_description": "Jump into Brawl Arena, a wild multiplayer fighting game where up to 10 players battle it out using punches, kicks, and anything they can grab\u2014baseball bats, chairs, tables, and more! Play public or private matches, use voice chat to strategize or trash talk, and unleash total chaos in action-packed brawls.\n\n\ud83d\ude80 Coming Soon \u2013 Wishlist Now! \ud83d\ude80"}]}, "developer_name": null, "developer_privacy_policy_url": "https://venzolabs.com/brawlarena/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Venzo Labs", "support_website_url": null, "website_url": "https://venzolabs.com/brawlarena.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9367665250017692"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "862903500247743"}, {"status": "PUBLISHED", "id": "1535076194187356"}]}, "baseline_offer": {"id": "862903500247743"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794337920, "status": "PUBLISHED", "id": "862903500247743"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29474982582192662", "version": "0.3.3"}, "id": "57146512253063
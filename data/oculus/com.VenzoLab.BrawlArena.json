_-KQPwvZICYl5dUtBOFWHiGs8TXw&oe=6B0DAB2A"}, {"file_name": "IMG_1364 (1).png", "id": "816623237634779", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827585_816623240968112_7050777985493460138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNOMJHkWRdoQ7kNvwENVmaB&_nc_oc=AdpP2sm1cUcQkJ0T4LfpRrr_RpunoJ278lt-yo-l2KzzLmnAGtiQdudqPjwOalZfYoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzh8aAt56p463kCkLVhodaO5q3RTfmO7nAXBewkP1Pnw&oe=6B0DCF62"}, {"file_name": "IMG_1367 (1).png", "id": "4249203068734994", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_4249203072068327_7588979746508296164_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHDdlAUg6k0Q7kNvwGOkvj5&_nc_oc=AdqtCPefUo4l_hAMO5ldEOXx95skaVoU_nz485l_qBbpEb_Cu8Fwd8gSeRAHatf-gJ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3L6_q9Ot9BYLBAvdJaamGpF21eJLzftRyl2LwKMFOhA&oe=6B0DB233"}, {"file_name": "IMG_1369 (2).png", "id": "1134198292214355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819407_1134198295547688_6352508361910362248_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvcUn16MyHMQ7kNvwEeQVSq&_nc_oc=AdrQ8orpvdCmqph0q8kxPmchylIcI-STA5csSEmS7yaB7Ph0wN4T7U2ROsIaaVXsUXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9NmfFXoCKslO8RrBXBYC_tAAcm9jEXLJcJaGidjmvbA&oe=6B0DBE3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brawl Arena", "keywords": ["BrawlArena", "Brawl", "Fight", "Battle", "Battlegrounds"], "long_description": "Brawl Arena is an action-packed multiplayer VR game focused on pure fun, chaos, and competitive combat. Players enter shared arenas where they face off against real players in intense free-for-all battles.\n\nThere are no complicated rules, just jump in, grab whatever you can find, and fight. Players can punch with their fists, swing tools, or use different weapons scattered around the arena. Every match is unpredictable, with fast movement, physical combat, and nonstop action that keeps players fully immersed in VR.\n\nThe goal is simple: be the last player standing. Whether you prefer close-combat brawling or using weapons creatively, each match offers a unique experience filled with laughter, rivalry, and adrenaline. Designed for multiplayer fun, Brawl Arena is perfect for players who enjoy competitive VR gameplay, social interaction, and chaotic battles with friends or strangers.", "short_description": "Brawl Arena is a fast-paced multiplayer VR fighting game where players jump into chaotic arenas, use fists, tools, and weapons, and battle it out until only one player remains standing."}]}, "developer_name": "Knockout Games", "developer_privacy_policy_url": "https://knockoutgames.xyz/privacy/brawl-arena.html", "developer_terms_of_service_url": null, "publisher_name": "Knockout Games", "support_website_url": null, "website_url": "https://knockoutgames.xyz/games/brawl-arena.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29492260717131515"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819300_1819029942013131_2005872298256405132_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&
_ss=7f20f&oh=00_AQJg49b-HzkQ_fwjGjbIYJTRiPswYmGQVvSxI-5Jvri0Ag&oe=6A9EB9A5"}, {"file_name": "2.png", "id": "1989936839076579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593858738_1989936845743245_6284533496308049897_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnJ7PZnkEWsQ7kNvwFtCF7I&_nc_oc=AdrtxY9jwejObqivrx6KVCIWah1cAeufeJn2hRMyFlMeQolM9KIU6W5VuFCcl7nJIhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV7TD5GV7zfxBobRQjLp_V_MVY_ql1Z1Socvxl-p6b0w&oe=6A9EBFD3"}, {"file_name": "5.png", "id": "1243340091175619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1243340094508952_2931266509642443634_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbJzCIBP3j4Q7kNvwERX7yp&_nc_oc=AdrvxTzrb8wv-3djUtim2o0bTBqRox0nfdMMd6pMUZM9xQSR0WRcK3BgY6eyGpkaen8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRJIZKOVSB4EI9tytSmf8k3sLYMwDBC0mhqVnPTiLdWA&oe=6A9EB852"}, {"file_name": "1.png", "id": "1831806997804586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_1831807004471252_5157362972885528526_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jFfZm_4nH8Q7kNvwEtJSgR&_nc_oc=AdqGhjlS8Sw6bxNSOzpx-aD7kVzXWavDfgUA4KvP-VnrVNwXgUzxtgw2bvkwdJTKXCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL-hjJzqMQ5_obO4gcAS56pUY1GjcIAg9M-cnQPO6Yyg&oe=6A9ECF65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duck Hunting: Shooting VR Simulator", "keywords": ["Hunting", "Duck", "Shotgun", "Shooter", "Aim"], "long_description": "Duck Hunting: Shooting VR Simulator delivers an exciting virtual reality hunting experience that's easy to pick up and fun to master.\n\nStep into a peaceful forest surrounded by lakes and put your shotgun skills to the test as ducks fly across the sky from every direction. Track their movement, react quickly, and land accurate shots to build your highest score.\n\nFace six unique duck types, each offering a different challenge. Hunt common ducks, chase valuable Golden Ducks, track mysterious Phantom Ducks, avoid trick Decoy Ducks, and discover the rest as you improve your hunting skills.\n\nDesigned exclusively for VR, every shot feels natural as you aim, fire, and reload using intuitive motion controls. Whether you're looking for a relaxing shooting session or trying to beat your personal best, every hunt offers a fresh challenge.\n\nFeatures\n\n\u2022 Immersive VR duck hunting gameplay\n\n\u2022 Beautiful forest environment with scenic lakes\n\n\u2022 Realistic VR shotgun handling\n\n\u2022 Six unique duck species with different behaviors\n\nNormal Duck\nGolden Duck\nPhantom Duck\nDecoy Duck\nPlus two additional special ducks\n\n\u2022 Fast-paced arcade hunting action\n\n\u2022 Easy to learn, rewarding to master\n\n\u2022 Improve your accuracy and reaction time\n\n\u2022 Designed for Meta Quest VR\n\nCan you become the ultimate duck hunter and hit every target before it escapes?", "short_description": "Experience the thrill of VR duck hunting! Grab your shotgun, explore a beautiful forest lake, and test your aim against six unique duck species\u2014including Golden, Phantom, Decoy, and more. Easy to learn, challenging to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
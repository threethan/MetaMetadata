dhsFVaBw&oe=6ABA66FC"}, {"file_name": "4.png", "id": "902091806282830", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312454_902091809616163_8286584787915997666_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki_lOZTXsXIQ7kNvwGs3mAq&_nc_oc=AdqS49pegC94Utukd8-ba4Qg25chN9f7hrCJLL9eU4jGa24SysnbmO3hz8AAhLqS__8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvhc04885Ektk4NZ8dttVLZyV2Yq4ZcvKSduKz2DwDhg&oe=6ABA6925"}, {"file_name": "2.png", "id": "1989936839076579", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593858738_1989936845743245_6284533496308049897_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt6j9RvFOHwQ7kNvwHKmWaO&_nc_oc=AdpqAf1W1oSHVaMy4Qbly8eoXHAH17bIltUnXqzKq63qg0VC-WlLvXqSpiL6by2TWCM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPtCNKjLHPl68x-W4uSYcEYNTukEJEp6vGWFHkcktGyg&oe=6ABA6F53"}, {"file_name": "5.png", "id": "1243340091175619", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596068480_1243340094508952_2931266509642443634_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL5-vZ59HG8Q7kNvwHi0Y9Y&_nc_oc=AdpjxuXHrA520h4I3s4wiqbd4qUTgEPuwUCJ4m8dcq5n_2kzYO6_MiHWwL_0_V9YQwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRD6LBKX1C8Zchu-qwtIt4GB_hqtGb-LmziTETx89PVA&oe=6ABA67D2"}, {"file_name": "1.png", "id": "1831806997804586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1831807004471252_5157362972885528526_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guXPmEcuBDIQ7kNvwFv-hnP&_nc_oc=Ado3D1hQeVoTDg4gBq5yBJbQMRZrxkH2t3F-HBZzhGimQWMngSEf93Ab7BxPBg3Wjr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6bdNYF4Q0nW_YMxBFt80FregD8xwdX5_Ooi1D2WDJqA&oe=6ABA7EE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duck Hunting: Shotgun Simulator", "keywords": ["Hunting", "Duck", "Shotgun", "Hunter", "Shooting"], "long_description": "TAKE AIM. TRACK THE FLOCK. MAKE THE SHOT.\nExperience fast-paced duck hunting with immersive shotgun controls and challenging flying targets.\nStep into a scenic forest hunting ground surrounded by lakes, grab your shotgun and track ducks as they fly across the sky. Lead your shots, react quickly, reload and improve your accuracy as you chase higher scores.\n\ud83e\udd86 HUNT DIFFERENT DUCK TYPES\nEvery target isn't the same. Hunt regular ducks, chase valuable Golden Ducks, track mysterious Phantom Ducks, watch out for deceptive Decoy Ducks, and discover additional special targets as you play.\n\ud83d\udd2b IMMERSIVE SHOTGUN SHOOTING\nAim, fire and reload using intuitive motion controls designed to make every shot satisfying. Track moving targets carefully and make every shell count.\n\ud83c\udfaf ARCADE HUNTING CHALLENGE\nReact quickly as ducks cross the sky from different directions. Improve your timing, accuracy and shooting skills while trying to beat your best score.\n\ud83c\udf32 SCENIC HUNTING ENVIRONMENT\nEnjoy duck shooting surrounded by forests, lakes and peaceful outdoor scenery.\nWhether you enjoy duck hunting, shotgun shooting, hunting simulators, target shooting or arcade shooters, take your position and see how accurate a hunter you can become.", "short_description": "Grab your shotgun and take aim in an immersive duck hunting challenge. Track fast-moving ducks over a scenic forest lake, reload with motion controls, hunt special Golden and Phantom Ducks, avoid tricky decoys, and chase your highest score in fast-paced arcade hunting action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "45978
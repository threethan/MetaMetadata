ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310651_1831807004471252_5157362972885528526_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guXPmEcuBDIQ7kNvwFv-hnP&_nc_oc=Ado3D1hQeVoTDg4gBq5yBJbQMRZrxkH2t3F-HBZzhGimQWMngSEf93Ab7BxPBg3Wjr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6bdNYF4Q0nW_YMxBFt80FregD8xwdX5_Ooi1D2WDJqA&oe=6ABA7EE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duck Hunting: Shooting VR Simulator", "keywords": ["Hunting", "Duck", "Shotgun", "Shooter", "Aim"], "long_description": "Duck Hunting: Shooting VR Simulator delivers an exciting virtual reality hunting experience that's easy to pick up and fun to master.\n\nStep into a peaceful forest surrounded by lakes and put your shotgun skills to the test as ducks fly across the sky from every direction. Track their movement, react quickly, and land accurate shots to build your highest score.\n\nFace six unique duck types, each offering a different challenge. Hunt common ducks, chase valuable Golden Ducks, track mysterious Phantom Ducks, avoid trick Decoy Ducks, and discover the rest as you improve your hunting skills.\n\nDesigned exclusively for VR, every shot feels natural as you aim, fire, and reload using intuitive motion controls. Whether you're looking for a relaxing shooting session or trying to beat your personal best, every hunt offers a fresh challenge.\n\nFeatures\n\n\u2022 Immersive VR duck hunting gameplay\n\n\u2022 Beautiful forest environment with scenic lakes\n\n\u2022 Realistic VR shotgun handling\n\n\u2022 Six unique duck species with different behaviors\n\nNormal Duck\nGolden Duck\nPhantom Duck\nDecoy Duck\nPlus two additional special ducks\n\n\u2022 Fast-paced arcade hunting action\n\n\u2022 Easy to learn, rewarding to master\n\n\u2022 Improve your accuracy and reaction time\n\n\u2022 Designed for Meta Quest VR\n\nCan you become the ultimate duck hunter and hit every target before it escapes?", "short_description": "Experience the thrill of VR duck hunting! Grab your shotgun, explore a beautiful forest lake, and test your aim against six unique duck species\u2014including Golden, Phantom, Decoy, and more. Easy to learn, challenging to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1231194583416245"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2206327706826196"}]}, "baseline_offer": {"id": "2206327706826196"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785770700, "status": "PUBLISHED", "id": "2206327706826196"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1241244822411221", "version": "0.5"}, "id": "1518183773395739", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1231194570082913", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1
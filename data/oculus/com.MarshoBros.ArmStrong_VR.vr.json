oculuscdn.com/v/t64.5771-25/491828087_3889512881182956_3242753980387169164_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjOKOVyWXxgQ7kNvwFZvsjF&_nc_oc=Adp2H12noaIDkfkYOKQi2-4bypfSwu5Z5JbMDXjxBZW_urCrhQ4D91Ldm6X0mpkNFqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QooEkYtatN_tBd1jXgiJY0dRDlSkLL9Nj-MA-RNOLpg&oe=69E4E4FA"}, {"file_name": "1.png", "id": "2364107750683126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_2364107754016459_5976753397773029626_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wraU4KtLhksQ7kNvwEw8csl&_nc_oc=Adqxl6czGPxFXHiKVr5-2ALuciZoOxi0SgiWdLWHL-zc265aNvv3BK9P4UtY2snMmTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zARAv8Q7SKYrP-lv0ezXdMpOGK611tVxd_ZV14Q-ebg&oe=69E4CF6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape2560 x 1440.png", "id": "1442502654067082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829165_1442502657400415_2130607345030576449_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NISHh7SQaTAQ7kNvwEji1i4&_nc_oc=AdrsDyGs3GunYsvq-ZuW5P24vje-gNQTVDCLJea1QyJoazMjnv5-PF8_kes4-sYpl8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3691uZ5djEjb2abaAQKak3eAjA7XtZ3Igsm1-wRjDCcw&oe=69E4C94B"}, "display_name": "ArmStrong VR", "keywords": ["fitness", "running", "workout", "cardio", "endless"], "long_description": "Welcome to ArmStrong VR \u2014 the ultimate VR fitness survival game designed for serious weight loss and full-body cardio!\n\nUnlike games where you just stand still, ArmStrong VR turns your entire body into the controller. It is the ONLY VR game that integrates real physical exercises into its core survival mechanics. To escape danger, you must perform:\n\ud83c\udfc3\u200d\u2642\ufe0f Intense Arm-Sprints\n\ud83e\udd98 Real Physical Jumps\n\ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Deep Squats\n\ud83c\udf2a\ufe0f Core Twists & Side Lunges\n\ud83d\udcaa Floor Push-Ups!\n\n\ud83d\udd25 KEY FITNESS FEATURES:\n\n\u2022 REAL WEIGHT LOSS (HIIT): Every dodge and sprint acts as High-Intensity Interval Training, directly melting fat and burning calories.\n\u2022 INTERACTIVE FITNESS HUB: Track your exact burned calories and distance traveled in real-time on the new menu board.\n\u2022 DAILY WORKOUTS: Choose your daily cardio challenge: Beginner (250m), Intermediate (500m), or Advanced (1km) to build your fitness streak!\n\u2022 ENDLESS PROCEDURAL MODES: Escape a terrifying monster in a randomly generated Maze, or physically duck and lunge to dodge traffic in Street Mode.\n\u2022 GLOBAL LEADERBOARDS: Test your vertical reflexes in the Jump Challenge and compete against players worldwide!\n\nAre you ready to transform your body? Jump in, drop down, dodge obstacles, and start sweating!", "short_description": "Step into the ultimate VR fitness challenge with ArmStrong VR! Run, dodge, and track your calories in real-time. Escape a terrifying monster in randomly generated mazes, climb the global leaderboard in the Jump challenge, and complete daily workout quests. Are you ready to sweat and activate BEAST MODE?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1dqWKNXMM0G14gucBFsblBqHHKGLGd2fwDzcR0xem3Dk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MarshoBros", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UC1MJIKwJKtDr1nc7hA4o5vw", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppor
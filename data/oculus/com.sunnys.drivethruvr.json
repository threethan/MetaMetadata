Ku4UmoQ7kNvwGxi7vm&_nc_oc=Adq4_PUi2UTklgk5xG79AudaB-61SOAb5wCLuD8cOebaYN3wJeBv2Kh1dotW1m52mFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm0uj6vXs1hc_p6otf8uMheZoyIYZWBtWSR-1G4VAFtw&oe=6AFC9362"}, {"file_name": "06_drive_thru_window.png", "id": "1110842408024699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624619_1110842411358032_2114687854668980549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yUPrH3V5SgQ7kNvwFj-31w&_nc_oc=AdrGFH7fNj4XHZvdaYznlKOZHAOwQe7oJ1ZSVTwtpQ2_Wr1mxNW-DuxVMt4vgNgsR9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7xosyLSMBvFiiPc213uOxLK-0adlqUMA0Yk69Bx218g&oe=6AFC701C"}, {"file_name": "04_fryer_heat_lamp.png", "id": "1823780075743433", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627502_1823780079076766_1101222910202982405_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck9F4ii71NoQ7kNvwHBs8Bg&_nc_oc=AdoH43xplDssBhEuuSjaxGI6rGvopWjg6HZrC5fxDF9-5Ic8i_76h86VMM795Y5AWPo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4NbnSLCyf1few715TdurDGZvxR8DfU2Rkv9mDf3fMFA&oe=6AFC6555"}, {"file_name": "05_pickup_window.png", "id": "1672019927821803", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620384_1672019934488469_9120401555175431974_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPw8Oi8ZZkUQ7kNvwGJA9qq&_nc_oc=AdpKK3kKfMIaBSIJRZDYPzETAmEbKVVDxZpoeABD8uT-_TWTcWFfd97lO5mvxHO3KZI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjYEXKjzjaZqYsso0-Wqoh_EKNCPniIvMSt1m8XUgPvQ&oe=6AFC5E4C"}, {"file_name": "07_sunnys_exterior.png", "id": "1942229296756143", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624606_1942229300089476_4589224653875077517_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Bfkn39ArGAQ7kNvwHHwzfB&_nc_oc=Adrng2dQO0ZUl0_vWSoc1XCn1tz29NiUAt30vuehtFUpWA0ZcbOW0hNVt9BSrkccyJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVx6kxrIBRqzCVPwlLAuj-gnscEHYL0r9ONbJObgZyaw&oe=6AFC72E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriveThruShift-Cover-v2-2560x1440.png", "id": "1680117763735959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619602_1680117767069292_5362307021930136267_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjsw-Yoh1TgQ7kNvwHI7uTm&_nc_oc=AdpBgfltw926kzLsfYdJLSRw_tHPAnbWTlexByzdc5fN7bRwTbedXrI6rqAfhqS6rg4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7xh_sRC8Y8TX8Hdia4Yy65voBGpK1sj02nYrfX2a8JQ&oe=6AFC8B7E"}, "display_name": "Drive Thru Shift VR", "keywords": ["cooking", "sandbox", "simulator", "burger", "restaurant"], "long_description": "Welcome to Sunny's. The grill is hot, the fryer is bubbling and the first car is already pulling up to the window.\n\nDrive Thru Shift VR puts you behind the counter of a roadside diner. Every car brings a new order, and it's up to you to cook it, build it and get it out the window before the driver gives up and leaves.\n\nCOOK IT FOR REAL\n- Grill patties and sausages. Pull them before they burn.\n- Drop fries, nuggets and onion rings in the fryer basket.\n- Slice tomatoes, onions and pickles on the chopping board.\n- Stack burgers, hot dogs and custom subs on the prep board.\n- Squeeze ketchup, mustard, mayo and BBQ with the trigger. Squeeze harder for more sauce, but too much gets messy.\n- Pour colas, pull coffee, swirl soft serve and mix shakes.\n- Bake cookies and toast bagels.\n\nKEEP THE LINE MOVING\nStock the heat lamp and warmers ahead of the rush, keep an eye on freshness, and serve the right sauce on the right dish. Fast, correct orders earn tips. Wrong ones get sent back.\n\nGROW THE DINER\nSpend what you earn between shifts to unlock new dishes, toppings and machines. Start with plain burgers and fries and work your way up to a full menu.\n\nLEARN AS YOU GO\nA hands-on tutorial walks you through every station, and Practice mode lets you cook with no clock and everything unlocked.\n\nPut on your gloves. Your shift starts now.", "short_description": "Run the drive-thru window at Sunny's, a busy roadside diner, in VR. Grill patties, drop fries, build burgers, hot dogs and subs, squeeze on the sauce, pour drinks and hand orders to drivers before their patience runs out. Earn tips, buy new dishes like shakes, cookies and bagels, and grow Sunny's from a burger stand into a full menu, one shift at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1807420580270106"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593922576_2139691656662727_2662586697809056240_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rOwLfotktQQ7kNvwESGB2N&_nc_oc=AdpD3vwskr3JSCmJj-zlGzXsdyKQpoWwfkGlVGWAlxPLM7bz9072huZ6YXrVqhn63Yw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_s
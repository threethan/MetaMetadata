341_938981445707117_7310175194305184347_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BI71KmACa0Q7kNvwH2t1KB&_nc_oc=AdoHLIHxUIU-GP-swEbBpFw_Mv-5_CladLvf6J_LMSZXTVb4vmx_SYgX9hZFAZga3FI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7sWbT6_k7jWpdeehj4HoHU7GlLSDRN0QTfxvmFT0WaA&oe=6B0B3D82"}]}, "id": "1382025217253011", "locale": "en_US", "screenshots": [{"file_name": "01_gloved_ketchup.png", "id": "29203059622653567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620532_29203059625986900_44515257550539340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYyayTPMoWEQ7kNvwE9dRFc&_nc_oc=AdphU9TYb4qHm2PGLObiu9tSmWm6HthZAGSyGtZropXedOlfV1hssEvP5mA8KWrw-YU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQumL61asl2Cz2LLnbCuCTd_IsHTyJ2fRr7jzR5RRpXKg&oe=6B0B13E2"}, {"file_name": "06_drive_thru_window.png", "id": "1110842408024699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624619_1110842411358032_2114687854668980549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCa4_sARrlUQ7kNvwFtyy1i&_nc_oc=AdrngSuQ8Wu1W76BMFpwFx0fBQ32QhLvE7NoSe_71Ry8rFrvXJ1gjfXUr09tZzehWsU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4jtPmoHtK62b-6BOJPbT1fCJthSqLn1MO-gmeL5QPIw&oe=6B0B28DC"}, {"file_name": "04_fryer_heat_lamp.png", "id": "1823780075743433", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499627502_1823780079076766_1101222910202982405_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wSyyl8RFWcQ7kNvwERAVxM&_nc_oc=AdqTDOA4WWjPbrcleMg8zGKXTUOxYHyq2QnND3PsEENJklBjcfwfGR4-GvEcuIOvxjE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7MtNnr_GG4nWOEcDlHuRMq4BNXW-qzNaYzOq7Z44_bA&oe=6B0B1E15"}, {"file_name": "05_pickup_window.png", "id": "1672019927821803", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620384_1672019934488469_9120401555175431974_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xoJR2zQWMcQ7kNvwH2I7dX&_nc_oc=Adrz46njvIFHmJHJAEgesuCppQVzmgpcfFhWJq9B0P1V4MQeT6AM-zRfnAqiXaaTAWA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6Q0D0Wo0nQAl5Fm1xMXwRZZHoa5FMpN-_rq7oBjMVBA&oe=6B0B170C"}, {"file_name": "07_sunnys_exterior.png", "id": "1942229296756143", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499624606_1942229300089476_4589224653875077517_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-e6GSLgkv50Q7kNvwH8c9O1&_nc_oc=AdroSPsQcORCVwsLUCCiMOvsPFSryOB-YNKiseh_WR5ZKkeZKSDVg_Gdt1dEiJMpmQw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS55TLojPN4_4WQoPIJ3dIXB71BJyRKDm_VGFlt3guP5w&oe=6B0B2BA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriveThruShift-Cover-v2-2560x1440.png", "id": "1680117763735959", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619602_1680117767069292_5362307021930136267_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgXPKasXlzAQ7kNvwF20oe2&_nc_oc=AdrwCBAdEcrAK7xWwql31cJoBs_F2sPJvghVWE4QXzs3GItTsbUvQB04l_pZ4ZwCnP4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSJs9jgndsOB_MAvNawh-6fV8ytOimKJ-YUepaHr7_pw&oe=6B0B443E"}, "display_name": "Drive Thru Shift VR", "keywords": ["cooking", "sandbox", "simulator", "burger", "restaurant"], "long_description": "Welcome to Sunny's. The grill is hot, the fryer is bubbling and the first car is already pulling up to the window.\n\nDrive Thru Shift VR puts you behind the counter of a roadside diner. Every car brings a new order, and it's up to you to cook it, build it and get it out the window before the driver gives up and leaves.\n\nCOOK IT FOR REAL\n- Grill patties and sausages. Pull them before they burn.\n- Drop fries, nuggets and onion rings in the fryer basket.\n- Slice tomatoes, onions and pickles on the chopping board.\n- Stack burgers, hot dogs and custom subs on the prep board.\n- Squeeze ketchup, mustard, mayo and BBQ with the trigger. Squeeze harder for more sauce, but too much gets messy.\n- Pour colas, pull coffee, swirl soft serve and mix shakes.\n- Bake cookies and toast bagels.\n\nKEEP THE LINE MOVING\nStock the heat lamp and warmers ahead of the rush, keep an eye on freshness, and serve the right sauce on the right dish. Fast, correct orders earn tips. Wrong ones get sent back.\n\nGROW THE DINER\nSpend what you earn between shifts to unlock new dishes, toppings and machines. Start with plain burgers and fries and work your way up to a full menu.\n\nLEARN AS YOU GO\nA hands-on tutorial walks you through every station, and Practice mode lets you cook with no clock and everything unlocked.\n\nPut on your gloves. Your shift starts now.", "short_description": "Run the drive-thru window at Sunny's, a busy roadside diner, in VR. Grill patties, drop fries, build burgers, hot dogs and subs, squeeze on the sauce, pour drinks and hand orders to drivers before their patience runs out. Earn tips, buy new dishes like shakes, cookies and bagels, and grow Sunny's from a burger stand into a full menu, one shift at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
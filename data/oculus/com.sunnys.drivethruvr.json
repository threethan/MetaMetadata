341_938981445707117_7310175194305184347_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbxbpDc80QwQ7kNvwE05By-&_nc_oc=Ado5-h6ANIcE1bIokOJ_BSb32wcWWON0Ygv8gdCBWxw-o7dXd3X1IZVthSM2F-o2xls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo9KilfgkG5h4ILMtHgSum8-EFLTlqQ_RENxcsIsvjdA&oe=6B01CAC2"}]}, "id": "1382025217253011", "locale": "en_US", "screenshots": [{"file_name": "01_gloved_ketchup.png", "id": "29203059622653567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620532_29203059625986900_44515257550539340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf8b_Y7wpucQ7kNvwHmHAj7&_nc_oc=AdraoQdSncbU9ggXPF0y665f8RaEeRjdDgTWhjkAkMuggRDQr_tHfBFp2doqsAn-OzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREYsvqK-J-cyAeGWT4dNDdkY6bvEJM35lkei27Nr63hA&oe=6B01D962"}, {"file_name": "06_drive_thru_window.png", "id": "1110842408024699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624619_1110842411358032_2114687854668980549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1R9UQlmcBMQ7kNvwE7RHiG&_nc_oc=AdrjYA_Duyrs1lPOksc5Xmvkf9bkDxYgr7Wjv3Xgui7eh7cWij5PQQmGxLOMJYTANK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhIzigw75LIoiG0tf2s-tp1jejTmx6n0lfTbLs7SShkA&oe=6B01EE5C"}, {"file_name": "04_fryer_heat_lamp.png", "id": "1823780075743433", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627502_1823780079076766_1101222910202982405_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErwEA4WiI9QQ7kNvwFBhL61&_nc_oc=AdpOF0Br-1m6ZkhGc4JNEo2J3yglJaG_zdycLHcO6Qa1Mo7NNGxeJPqMcZSVcM50MLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWGZNUmjTwspa2uG-v9DHN3CxADwSIUH0ZNagOF2b6sg&oe=6B01E395"}, {"file_name": "05_pickup_window.png", "id": "1672019927821803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620384_1672019934488469_9120401555175431974_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noWXz9E6KD8Q7kNvwGWcxxY&_nc_oc=AdpekJM2aC32X3IaQhHYMDD0HmmMkybiy3xw9at327i7Mm1A309di6i4CA1H8EVcfIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_-HNhT4gmuOaNio_zXtdqFdi5f8FoiFDC1gJBLXpZNw&oe=6B01DC8C"}, {"file_name": "07_sunnys_exterior.png", "id": "1942229296756143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624606_1942229300089476_4589224653875077517_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obD2mSdM0VkQ7kNvwHVLaTo&_nc_oc=AdqG7zPW-WrDwSdJOQA-ZykrYkzFLlPwl6DuuZS3ATFci-p2o9Hd-BTLKjAmxRZJ7kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdPKv0fdZGoRZGBE9gADT47PpdrvLF2MlM8MZRAL2nSA&oe=6B01B8E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriveThruShift-Cover-v2-2560x1440.png", "id": "1680117763735959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_1680117767069292_5362307021930136267_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4xUoWITn8QQ7kNvwEaNcee&_nc_oc=Adp0aDT2ThDgLaOJfg2O_mqtXXWY9qujhHAB0ZZsf0-OukuiucZ0CQHNcDFWFFrtRlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOnc1htcu8CjRnyYLi74dw2QZ1cdhU750xohyW3P200A&oe=6B01D17E"}, "display_name": "Drive Thru Shift VR", "keywords": ["cooking", "sandbox", "simulator", "burger", "restaurant"], "long_description": "Welcome to Sunny's. The grill is hot, the fryer is bubbling and the first car is already pulling up to the window.\n\nDrive Thru Shift VR puts you behind the counter of a roadside diner. Every car brings a new order, and it's up to you to cook it, build it and get it out the window before the driver gives up and leaves.\n\nCOOK IT FOR REAL\n- Grill patties and sausages. Pull them before they burn.\n- Drop fries, nuggets and onion rings in the fryer basket.\n- Slice tomatoes, onions and pickles on the chopping board.\n- Stack burgers, hot dogs and custom subs on the prep board.\n- Squeeze ketchup, mustard, mayo and BBQ with the trigger. Squeeze harder for more sauce, but too much gets messy.\n- Pour colas, pull coffee, swirl soft serve and mix shakes.\n- Bake cookies and toast bagels.\n\nKEEP THE LINE MOVING\nStock the heat lamp and warmers ahead of the rush, keep an eye on freshness, and serve the right sauce on the right dish. Fast, correct orders earn tips. Wrong ones get sent back.\n\nGROW THE DINER\nSpend what you earn between shifts to unlock new dishes, toppings and machines. Start with plain burgers and fries and work your way up to a full menu.\n\nLEARN AS YOU GO\nA hands-on tutorial walks you through every station, and Practice mode lets you cook with no clock and everything unlocked.\n\nPut on your gloves. Your shift starts now.", "short_description": "Run the drive-thru window at Sunny's, a busy roadside diner, in VR. Grill patties, drop fries, build burgers, hot dogs and subs, squeeze on the sauce, pour drinks and hand orders to drivers before their patience runs out. Earn tips, buy new dishes like shakes, cookies and bagels, and grow Sunny's from a burger stand into a full menu, one shift at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
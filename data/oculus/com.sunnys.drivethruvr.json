341_938981445707117_7310175194305184347_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnrTobVmXEEQ7kNvwG4wyiY&_nc_oc=AdofHn_-E38tQuAkiSrBrGkC6v5gXai97Ts5Vxp704Ww2eAJ-tDmLNIC8P3JG3No1Jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXY9EKXUx-ZdakRVwC51cpH_JYE3ps4onJ8S-1-6MjaCw&oe=6B104B42"}]}, "id": "1382025217253011", "locale": "en_US", "screenshots": [{"file_name": "01_gloved_ketchup.png", "id": "29203059622653567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620532_29203059625986900_44515257550539340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RaRnUlru2gQ7kNvwF-mLU3&_nc_oc=AdqRIulGAzBKgHxZvV4bM52TvBtIOgxuU-tif8F4I0-YDCWPw2snRL7WsmFovM_3X6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWo_dLrm14n6tgBQrMvKQg2tKoikQnqONPIj4xELeTSQA&oe=6B1059E2"}, {"file_name": "06_drive_thru_window.png", "id": "1110842408024699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624619_1110842411358032_2114687854668980549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZdJeVO29ggQ7kNvwGfjClw&_nc_oc=AdqTUkhUZJ1tIkI801LneL1cHBGjvOojg1aQubxgL4Bgi9Xqgbc0XivzVcmAOMA58b4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5rXgm_UFe3tYLYEOEI5amOapY0GvbQhMX8oBiL0vTjg&oe=6B10369C"}, {"file_name": "04_fryer_heat_lamp.png", "id": "1823780075743433", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627502_1823780079076766_1101222910202982405_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtj6POnNJncQ7kNvwEQPm84&_nc_oc=Adpm-6lSGh7Pd39NON0y9Un5wIlsnRpq9FJ4IhRoHkRiN_jA6jlu9Rtz6LIMvyFEa_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKUZJDEmRaSSWa4G0XYkEnPdNZH-DPeuBJWdPub6Zi0A&oe=6B106415"}, {"file_name": "05_pickup_window.png", "id": "1672019927821803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620384_1672019934488469_9120401555175431974_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5YnfuTma4wQ7kNvwEGaaVS&_nc_oc=AdrYmY0wZ0NOxvvQQZk2z1z18BqVdG0GoF5yQNX3lnH-st7bVSKNt6q4WIrQemg9bY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzJnmm-6L-PXas00BSTMWmx5XgQS6CNzN8jMJms25KKA&oe=6B105D0C"}, {"file_name": "07_sunnys_exterior.png", "id": "1942229296756143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624606_1942229300089476_4589224653875077517_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwzlb79FrAIQ7kNvwHlGLx4&_nc_oc=Adpf3TyoyxMh60U_NU6CCae9jWq71lYbr9T38y7Irv72OcsvNn6srsmGn_cASmRt1Gk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9lwccOc3P6PoFNtdW0rzKcfQqylXHisCTZRp-4TvsTw&oe=6B103969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriveThruShift-Cover-v2-2560x1440.png", "id": "1680117763735959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_1680117767069292_5362307021930136267_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr2KP35appEQ7kNvwEuOkB4&_nc_oc=Adrr_pXeIT-dPhyz2V7sCgOSAPkTG9vUxVprtlKiMtR1-RtaBk3t94wNoK4pmfIvgvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_7Y_pBNbTRMKaAespNn9Yvy7O35KhXs2Wk-1s5WZNFQ&oe=6B1051FE"}, "display_name": "Drive Thru Shift VR", "keywords": ["cooking", "sandbox", "simulator", "burger", "restaurant"], "long_description": "Welcome to Sunny's. The grill is hot, the fryer is bubbling and the first car is already pulling up to the window.\n\nDrive Thru Shift VR puts you behind the counter of a roadside diner. Every car brings a new order, and it's up to you to cook it, build it and get it out the window before the driver gives up and leaves.\n\nCOOK IT FOR REAL\n- Grill patties and sausages. Pull them before they burn.\n- Drop fries, nuggets and onion rings in the fryer basket.\n- Slice tomatoes, onions and pickles on the chopping board.\n- Stack burgers, hot dogs and custom subs on the prep board.\n- Squeeze ketchup, mustard, mayo and BBQ with the trigger. Squeeze harder for more sauce, but too much gets messy.\n- Pour colas, pull coffee, swirl soft serve and mix shakes.\n- Bake cookies and toast bagels.\n\nKEEP THE LINE MOVING\nStock the heat lamp and warmers ahead of the rush, keep an eye on freshness, and serve the right sauce on the right dish. Fast, correct orders earn tips. Wrong ones get sent back.\n\nGROW THE DINER\nSpend what you earn between shifts to unlock new dishes, toppings and machines. Start with plain burgers and fries and work your way up to a full menu.\n\nLEARN AS YOU GO\nA hands-on tutorial walks you through every station, and Practice mode lets you cook with no clock and everything unlocked.\n\nPut on your gloves. Your shift starts now.", "short_description": "Run the drive-thru window at Sunny's, a busy roadside diner, in VR. Grill patties, drop fries, build burgers, hot dogs and subs, squeeze on the sauce, pour drinks and hand orders to drivers before their patience runs out. Earn tips, buy new dishes like shakes, cookies and bagels, and grow Sunny's from a burger stand into a full menu, one shift at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
oe=6AFC5E4C"}, {"file_name": "07_sunnys_exterior.png", "id": "1942229296756143", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624606_1942229300089476_4589224653875077517_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Bfkn39ArGAQ7kNvwHHwzfB&_nc_oc=Adrng2dQO0ZUl0_vWSoc1XCn1tz29NiUAt30vuehtFUpWA0ZcbOW0hNVt9BSrkccyJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVx6kxrIBRqzCVPwlLAuj-gnscEHYL0r9ONbJObgZyaw&oe=6AFC72E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriveThruShift-Cover-v2-2560x1440.png", "id": "1680117763735959", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619602_1680117767069292_5362307021930136267_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjsw-Yoh1TgQ7kNvwHI7uTm&_nc_oc=AdpBgfltw926kzLsfYdJLSRw_tHPAnbWTlexByzdc5fN7bRwTbedXrI6rqAfhqS6rg4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7xh_sRC8Y8TX8Hdia4Yy65voBGpK1sj02nYrfX2a8JQ&oe=6AFC8B7E"}, "display_name": "Drive Thru Shift VR", "keywords": ["cooking", "sandbox", "simulator", "burger", "restaurant"], "long_description": "Welcome to Sunny's. The grill is hot, the fryer is bubbling and the first car is already pulling up to the window.\n\nDrive Thru Shift VR puts you behind the counter of a roadside diner. Every car brings a new order, and it's up to you to cook it, build it and get it out the window before the driver gives up and leaves.\n\nCOOK IT FOR REAL\n- Grill patties and sausages. Pull them before they burn.\n- Drop fries, nuggets and onion rings in the fryer basket.\n- Slice tomatoes, onions and pickles on the chopping board.\n- Stack burgers, hot dogs and custom subs on the prep board.\n- Squeeze ketchup, mustard, mayo and BBQ with the trigger. Squeeze harder for more sauce, but too much gets messy.\n- Pour colas, pull coffee, swirl soft serve and mix shakes.\n- Bake cookies and toast bagels.\n\nKEEP THE LINE MOVING\nStock the heat lamp and warmers ahead of the rush, keep an eye on freshness, and serve the right sauce on the right dish. Fast, correct orders earn tips. Wrong ones get sent back.\n\nGROW THE DINER\nSpend what you earn between shifts to unlock new dishes, toppings and machines. Start with plain burgers and fries and work your way up to a full menu.\n\nLEARN AS YOU GO\nA hands-on tutorial walks you through every station, and Practice mode lets you cook with no clock and everything unlocked.\n\nPut on your gloves. Your shift starts now.", "short_description": "Run the drive-thru window at Sunny's, a busy roadside diner, in VR. Grill patties, drop fries, build burgers, hot dogs and subs, squeeze on the sauce, pour drinks and hand orders to drivers before their patience runs out. Earn tips, buy new dishes like shakes, cookies and bagels, and grow Sunny's from a burger stand into a full menu, one shift at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1807420580270106"}}]}, "scheduled_offers": {"count
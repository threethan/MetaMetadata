341_938981445707117_7310175194305184347_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BI71KmACa0Q7kNvwHk83VG&_nc_oc=AdoKDP-MtRQUi3p6T_x6ZbLYd3ln9Xve7cVHGMJhd-gY2clFVv0lTAMBqM3pej8mz0M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcGUyVXYWS0oalbcbtP6Nw6VuLfJMhDu0v0WPLnYC73A&oe=6B086242"}]}, "id": "1382025217253011", "locale": "en_US", "screenshots": [{"file_name": "01_gloved_ketchup.png", "id": "29203059622653567", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620532_29203059625986900_44515257550539340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrztU3bGfykQ7kNvwGFA74j&_nc_oc=AdroM_qaylg7inhFm6asV_3b2m94dokVG-wY2h7hr-2SXsNEWoMid5DVjB5W1SK30fU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAUeetp7Dy7ePpbSKpxFyzHDwdryVW7G5MOK6BznPe7w&oe=6B0870E2"}, {"file_name": "06_drive_thru_window.png", "id": "1110842408024699", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499624619_1110842411358032_2114687854668980549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Lct7oJRRXIQ7kNvwES5Ugf&_nc_oc=AdrX-bvZlrgVpOjcczwE02r-EZt9WuWlksfZ-JLXQTbO_g3BEo2QDQHdsIbLXvrpyIU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzHAvZ9DSoSiN1kj6PZ_joj-B4O4NCYpz2dvnUFK2hpA&oe=6B084D9C"}, {"file_name": "04_fryer_heat_lamp.png", "id": "1823780075743433", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499627502_1823780079076766_1101222910202982405_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYyE_wIued0Q7kNvwGxXHEw&_nc_oc=Adq3Duots0OjyRUjNZQ_bPMexdHQOVnwUBYru73pFEal8MWVra7ce-MUXSZr0z9LrvU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkx4uva7FrBYXYVWd9cFJ3DIklagX6WDFWufztJf1dRg&oe=6B0842D5"}, {"file_name": "05_pickup_window.png", "id": "1672019927821803", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620384_1672019934488469_9120401555175431974_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqbpmw7_ZUkQ7kNvwHMx9Yj&_nc_oc=Adobq5AtltjzORqpw9OxG0jQpFiR2iu0WWRRDj10s7R2UthXg8g4MI-Vt4xfM4EfSTU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvxZh-fIN5n41fhljDiWWDjxUeVL1LaU7OT7PDAbRxKg&oe=6B08740C"}, {"file_name": "07_sunnys_exterior.png", "id": "1942229296756143", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624606_1942229300089476_4589224653875077517_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb7V0SrYn-IQ7kNvwEb450v&_nc_oc=AdrBMzKCx3U1XCmqAOnFkvIOernd0n2DQZzjnrylVgX-x-sgbtQTLSl9X7VJQKb6ZRQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA2xp3FT6fjgXOjgkgQC6jI4szJEQN6taksf-4S7x-FQ&oe=6B085069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriveThruShift-Cover-v2-2560x1440.png", "id": "1680117763735959", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619602_1680117767069292_5362307021930136267_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt81fofZH04Q7kNvwHut2yw&_nc_oc=AdosA-lrpxt9VHfYspIVW5xCsgQ-lK5IR0NMWTgYmnd6IFZmzDoXh_UaiKrceT6iXiE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8X8jsLTwZcNOEmEO-n_oicT3vtfBttMRikHClJk9WHA&oe=6B0868FE"}, "display_name": "Drive Thru Shift VR", "keywords": ["cooking", "sandbox", "simulator", "burger", "restaurant"], "long_description": "Welcome to Sunny's. The grill is hot, the fryer is bubbling and the first car is already pulling up to the window.\n\nDrive Thru Shift VR puts you behind the counter of a roadside diner. Every car brings a new order, and it's up to you to cook it, build it and get it out the window before the driver gives up and leaves.\n\nCOOK IT FOR REAL\n- Grill patties and sausages. Pull them before they burn.\n- Drop fries, nuggets and onion rings in the fryer basket.\n- Slice tomatoes, onions and pickles on the chopping board.\n- Stack burgers, hot dogs and custom subs on the prep board.\n- Squeeze ketchup, mustard, mayo and BBQ with the trigger. Squeeze harder for more sauce, but too much gets messy.\n- Pour colas, pull coffee, swirl soft serve and mix shakes.\n- Bake cookies and toast bagels.\n\nKEEP THE LINE MOVING\nStock the heat lamp and warmers ahead of the rush, keep an eye on freshness, and serve the right sauce on the right dish. Fast, correct orders earn tips. Wrong ones get sent back.\n\nGROW THE DINER\nSpend what you earn between shifts to unlock new dishes, toppings and machines. Start with plain burgers and fries and work your way up to a full menu.\n\nLEARN AS YOU GO\nA hands-on tutorial walks you through every station, and Practice mode lets you cook with no clock and everything unlocked.\n\nPut on your gloves. Your shift starts now.", "short_description": "Run the drive-thru window at Sunny's, a busy roadside diner, in VR. Grill patties, drop fries, build burgers, hot dogs and subs, squeeze on the sauce, pour drinks and hand orders to drivers before their patience runs out. Earn tips, buy new dishes like shakes, cookies and bagels, and grow Sunny's from a burger stand into a full menu, one shift at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
341_938981445707117_7310175194305184347_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcEptz5PqZcQ7kNvwHcUoRZ&_nc_oc=AdptZpd8lOo07wXbsk4ngyeD3IJEAx38jUTU1KJkWjepeo5Z7pwlxLaCalMJQ44_CrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXW-xXm2ReInvT2NEwl1LuF5O4EPzTInmH3aJ1MUXn6gQ&oe=6B0EF9C2"}]}, "id": "1382025217253011", "locale": "en_US", "screenshots": [{"file_name": "01_gloved_ketchup.png", "id": "29203059622653567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620532_29203059625986900_44515257550539340_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RaRnUlru2gQ7kNvwEtco81&_nc_oc=AdqIAYjfgadMtTKGIegijnyktPGL6wMYxdyh9iMic4gSN_9V45Y-8ZsQwWlEhDbAyqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcGJog9bazVyo9-e5DAu9V21NDF9Ypz4X9Tt6mnfKVOA&oe=6B0F0862"}, {"file_name": "06_drive_thru_window.png", "id": "1110842408024699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624619_1110842411358032_2114687854668980549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZdJeVO29ggQ7kNvwFB7Urn&_nc_oc=AdozwPtTXOWexrvoRdHHCJJdXKHdG3u3fs3JAxyQ2kp8oLnVVnCFx_54Q9DFRxEtrLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvN9MkoMs7_Ys_YyzJdU1MggDZ-JAr_rqxETEXSgDxWA&oe=6B0F1D5C"}, {"file_name": "04_fryer_heat_lamp.png", "id": "1823780075743433", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627502_1823780079076766_1101222910202982405_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtj6POnNJncQ7kNvwFMDcB3&_nc_oc=AdoeP45Rxm6cs81A69qDoFlMC8nhu39ywSY9zYX1R2_fGy7vGjXe7Ag9gTQvXfR6uq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3K5Db9a3IMrHCl3ggYjZ3YY1uilhyzWhI99_HILroKQ&oe=6B0F1295"}, {"file_name": "05_pickup_window.png", "id": "1672019927821803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620384_1672019934488469_9120401555175431974_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5YnfuTma4wQ7kNvwH_ZQYJ&_nc_oc=AdqVMMTiqlE0LhR9k_ueJ6CfIy19GVj9GOc-BSo4_qprG7BFoPx2DdVX_RiG-pgBo4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-pt0vWVRpxPw60V3RGq169ZUNT2PHLA9ykoBtluw8UQ&oe=6B0F0B8C"}, {"file_name": "07_sunnys_exterior.png", "id": "1942229296756143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624606_1942229300089476_4589224653875077517_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwzlb79FrAIQ7kNvwGGVK7r&_nc_oc=AdoMXYieD3ITzQfR1esQoOUJV-GUpDTNLuRbgy7RkjoiGGHgfGv5iJqlOaQdQPNEYJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_-J3THcm4tt-iVZYGhxM9VakOdvPhvm8sadkC4KOBgw&oe=6B0F2029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriveThruShift-Cover-v2-2560x1440.png", "id": "1680117763735959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619602_1680117767069292_5362307021930136267_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr2KP35appEQ7kNvwGobDyW&_nc_oc=Adq74FBm6nMFye4qVejPDlBd3kez6df0wVIbk-QD7YFZAI8qpLVNcpz32wJU4pn-Vco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKn6YPVDRE7Eke-Oc0pudOnujtaOvGpVZ_ZmzL-_4JtQ&oe=6B0F007E"}, "display_name": "Drive Thru Shift VR", "keywords": ["cooking", "sandbox", "simulator", "burger", "restaurant"], "long_description": "Welcome to Sunny's. The grill is hot, the fryer is bubbling and the first car is already pulling up to the window.\n\nDrive Thru Shift VR puts you behind the counter of a roadside diner. Every car brings a new order, and it's up to you to cook it, build it and get it out the window before the driver gives up and leaves.\n\nCOOK IT FOR REAL\n- Grill patties and sausages. Pull them before they burn.\n- Drop fries, nuggets and onion rings in the fryer basket.\n- Slice tomatoes, onions and pickles on the chopping board.\n- Stack burgers, hot dogs and custom subs on the prep board.\n- Squeeze ketchup, mustard, mayo and BBQ with the trigger. Squeeze harder for more sauce, but too much gets messy.\n- Pour colas, pull coffee, swirl soft serve and mix shakes.\n- Bake cookies and toast bagels.\n\nKEEP THE LINE MOVING\nStock the heat lamp and warmers ahead of the rush, keep an eye on freshness, and serve the right sauce on the right dish. Fast, correct orders earn tips. Wrong ones get sent back.\n\nGROW THE DINER\nSpend what you earn between shifts to unlock new dishes, toppings and machines. Start with plain burgers and fries and work your way up to a full menu.\n\nLEARN AS YOU GO\nA hands-on tutorial walks you through every station, and Practice mode lets you cook with no clock and everything unlocked.\n\nPut on your gloves. Your shift starts now.", "short_description": "Run the drive-thru window at Sunny's, a busy roadside diner, in VR. Grill patties, drop fries, build burgers, hot dogs and subs, squeeze on the sauce, pour drinks and hand orders to drivers before their patience runs out. Earn tips, buy new dishes like shakes, cookies and bagels, and grow Sunny's from a burger stand into a full menu, one shift at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/drive-thru-shift-vr-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
ziNM796HvpXg7MqBXBdwf6_QY3ZLhqduaE-MdC3xC7sLCT4GGHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfRTKT4dga3T_EdmFZLeeFyLOTJyowC0SZfGv_PmL_kA&oe=6A998F4B"}, {"file_name": "1.png", "id": "1381688280687237", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821200_1381688290687236_4493520471076356927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVesMYTYjfkQ7kNvwEQ5k6z&_nc_oc=AdqnxJRgNCgZgxF1hNL5vXxGtc4ev9kN00myMpWfZpPYsSwbh4A3IvCERuWNqyHRtWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeEMZiL_S3LeiDAdYijohu2xRYLKi7SgfXzzbwFQCFTA&oe=6A99901A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rush Shot Arena", "keywords": [], "long_description": "\ud83c\udfae Rush Shot Arena\n\nStep into a high-speed VR shooting arena where reflexes are your greatest weapon.\n\nRush Shot Arena throws you into dynamic maze-like arenas filled with deadly traps, shifting paths, and relentless shooting challenges. Choose your weapon, sharpen your aim, and push your limits as every level tests your precision, timing, and decision-making.\n\n\ud83d\udd25 CORE GAMEPLAY\n\nNavigate through intense labyrinth arenas where movement and shooting go hand in hand.\nDodge obstacles, react instantly, and eliminate targets before they overwhelm you.\n\n\u26a1 FEATURES\n\n\ud83c\udfaf Precision Shooting Mechanics\nFeel every shot. Master realistic aiming and improve your accuracy with skill-based gunplay designed for VR.\n\n\ud83e\udde9 Dynamic Maze Challenges\nEach arena evolves with new layouts, traps, and enemy patterns. No run feels the same.\n\n\ud83d\udd2b Weapon Variety & Upgrades\nUnlock powerful weapons, experiment with different shooting styles, and upgrade your loadout to dominate the arena.\n\n\ud83c\udfc3 Fast-Paced Action\nQuick sessions, intense gameplay. Perfect for both short bursts and long skill-grinding runs.\n\n\ud83e\udde0 Skill Progression System\nImprove your reflexes, aim, and strategy as difficulty scales with your performance.\n\n\ud83c\udf0c IMMERSIVE VR EXPERIENCE\n\nDesigned specifically for VR, Rush Shot Arena delivers:\n\nSmooth locomotion with comfort options\nResponsive controls and intuitive shooting\nImmersive environments that keep you fully engaged\n\ud83c\udfaf WHY YOU\u2019LL LOVE IT\nEasy to pick up, hard to master\nConstant action with no downti", "short_description": "Fight through deadly maze arenas with fast-paced VR shooting and skill-based challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelforgeberu.shop/rush-shot-arena/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixel Forge Studios", "support_website_url": null, "website_url": "https://pixelforgeberu.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26173486992311597"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1665785957765266_170931293364891953_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDsnCVqjl8UQ7kNvwF2UQtJ&_nc_oc=AdoFkyF8UUYUhvVXO181rzP7q5QFJdSwR1NsAC0eASJ7J6OBdX0fNdzRIgjONOuyFAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQDsEDFXEL0n0S-3iaqqP8NYBuG1deLYnjVy9buIfeEQ&oe=6A9985CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
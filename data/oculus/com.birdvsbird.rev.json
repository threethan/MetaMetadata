-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_2649008532137891_1741409640975773173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWaKMU6sd9MQ7kNvwF-0qwa&_nc_oc=Adr0mUMx9_iVcbbHpKOOUrZbpIf3cNdjnSefZQKZYmqHMQqQnHLCzow4LgdU0SK23FA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdG2033I_BR0tdArRLSwVKtSX8etehBlMxDhswlqJUsw&oe=6AE5F3E3"}, {"file_name": "resize-2560x1440-processed (4).png", "id": "1736623264411457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299922_1736623267744790_1758653882510982179_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhP2OMKgwK0Q7kNvwGinB3Y&_nc_oc=Adr3QTtLEEreYLylklyb21wIl5jO1KaBiHprX1EvCOm-1Okp4Eu6Uu4VXEnzqeL52XY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsiiOsmD0e_dE5fDtIC3InQO1IXNm1XOdY2J5RcoTjig&oe=6AE5FD79"}, {"file_name": "resize-2560x1440-processed (1).png", "id": "1542859976796121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298221_1542859983462787_1814058197466723086_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CMcTsJ9lZoQ7kNvwGQb1pV&_nc_oc=Adqx_XpX3-ZXQvcs-B8inKJZ9vuTgw2uKV8rMnOOl86DtjBzJVLorp4fhTrhsSvSsoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHVxxs7wzFjUETcZZRvZN5o_ln2hKx71fN4pA3Kd-zmw&oe=6AE5E81C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird VS Bird V7", "keywords": [], "long_description": "Birds VS Birds V7 is a fast-paced VR game where you jump into the sky and battle other birds in chaotic aerial combat. You control your movement using VR motion, letting you fly, dive, dodge, and chase enemies through the air. Every match is focused on quick reactions, smart movement, and staying aware of everything happening around you while other birds try to take you down.\n\nAs you fly around the map, you\u2019ll fight against other players using different attacks and abilities. Timing your moves and positioning yourself correctly is important, because being caught off guard can quickly turn the fight against you. You can dodge incoming attacks, rush enemies, or escape to reposition before diving back into the fight. The combat is simple to understand but becomes intense as more birds join the battle.\n\nThe game is built around constant action, where you\u2019re always moving and reacting. Flying smoothly, controlling your speed, and learning how to maneuver through the air gives you a big advantage over other players. Matches can quickly become chaotic as multiple birds clash in the same space, creating fast and unpredictable fights where anything can happen.", "short_description": "Birds VS Birds V7 is a VR game where you fight other birds in fast-paced aerial battles. You fly around the map, dodge attacks, and use your abilities to take down enemy birds while trying to stay in the air and survive. The gameplay focuses on quick movement, fighting skill, and outmaneuvering other players in chaotic bird-vs-bird combat. The goal is simple: fly better, fight harder, and prove you\u2019re the strongest bird in the sky."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bird-vs-bird/policy", "developer_terms_of_service_url": null, "publisher_name": "Bird Game", "support_website_url": null, "website_url": "https://sites.google.com/view/bird-vs-bird/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": []
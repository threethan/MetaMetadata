p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpAMdEQZs5EQ7kNvwHvNlZM&_nc_oc=AdqXc_Ip96BqXA6vcZuggDSXFfxEChQLUYK9dVQwcErROsWtwoMaQaUbJB5tCoh7pbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTPNVwS3DyZwLfqvFElEBAdU36HR7sIbI-ASBidWRy2w&oe=6B04837B"}, {"file_name": "explorer_3.png", "id": "1487503779422253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620856_1487503782755586_802549458493495103_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bEpZHlOAcEQ7kNvwENL1jK&_nc_oc=AdrNafIU9Tml2BgOCR1KZSuf68Q9xTqDIO8GQq8RdiJRRYoXdSKzkidqf6W8Kqw4q5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWgIszklh409bH4GSFy18tUUl0M4ceporQ8f_QZUMG2Q&oe=6B046578"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1303879938518218", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620444_1303879941851551_2031038815623515836_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd7BZJNAC00Q7kNvwGnMheC&_nc_oc=AdpBj1XHmId5tpHAcHNHOiEwMBDiJCacZudgRZ7-U_RO0wXlmH5IBQUona0SmM3cQTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5ULvN4P2ooq_I9y5My6hvy8VUSwhYClb_4iKWenjJng&oe=6B0461C8"}, "display_name": "Anatomy Learning Labs: Exploration Lab", "keywords": [], "long_description": "Step into the introductory experience of the Anatomy Learning Labs series, where systems of the human body come to life in stunning 3D. Designed for elementary, middle, and high school learners, this hands-on experience provides a broad introduction to human anatomy through interactive exploration and discovery.\n\nBuilt using anatomically accurate models developed by medical professionals, this experience is designed for classroom adoption, homeschooling, and independent learning. Guided by multimodal learning principles, students see anatomy in 3D, hear explanations, interact with structures using their own hands, and develop spatial reasoning skills through active learning for greater engagement and long-term retention:\n\n\u2022\tTravel through detailed medical imaging views that reveal the human body layer by layer. Explore skeletal, nervous, cardiovascular, respiratory, and digestive systems within the same body. \n\n\u2022\tSelect any anatomical structure to hear Dr. Hana Sato, your virtual anatomy guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to inspect anatomical models including the skull, arm muscles, lungs, heart, colon, eye, and neuron. Examine structures from every angle while developing understanding of how the body's systems work together.\n\n\u2022\tStep into Mini Mode to explore the beating human heart from the inside.\n\n\u2022\tBuild the human heart piece by piece in an interactive 3D puzzle guided by Dr. Sato.", "short_description": "Step into an immersive VR anatomy laboratory and explore the major systems of the human body in stunning 3D. Travel through medical imaging views, examine anatomical structures using natural hand-tracking, and hear Dr. Hana Sato identify structures by name. Explore organs, tissues, and cells from multiple body systems, then reinforce your learning by assembling a human heart in an engaging 3D puzzle challenge designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": 
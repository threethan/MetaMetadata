le": "en_US", "screenshots": [{"file_name": "explorer_5.png", "id": "989059970410191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622919_989059973743524_6743324592921230158_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkeM0tfaDa8Q7kNvwEuKmvr&_nc_oc=AdqpVBGgD4i88lJEhfFmIUdPBs9-3fKQI2OtXBu5pyNCPNQH4C_wQsOeLoj76op9Tn8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAVai6N8BokR4ORyq8ocZjLrMhuXl6SDMKBfu9KErzzw&oe=6ADCA9E1"}, {"file_name": "explorer_1.png", "id": "1866660500677942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620940_1866660507344608_3944884499170681928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7L7CO94ecsQ7kNvwGWhkaJ&_nc_oc=AdrrnRZ8fqZOK9fDWZfSI6cZgl4ApqCG_sXhamhCRQdLV_fb8Q-4TPe4GXU8bMq_EbA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV1seyZT2lp5DvBjVbpTO1KFw85zwHW9kJvIaxO0EhzQ&oe=6ADCD8B7"}, {"file_name": "explorer_2.png", "id": "1528183585615251", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310819_1528183588948584_6554402213347427020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAP3W122NxYQ7kNvwGzYyyk&_nc_oc=Ado0TZmfW8-kGhK7uhJIiPOH5osDffc1Dtct6c99qpCkuhZirWGvY4JaFZzuqK12qZQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkbUE6o0M6QSXdCXwpOa1X49_jAm8cDasw8H5DktBGQA&oe=6ADCC0C7"}, {"file_name": "explorer_4.png", "id": "2380792625763615", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620666_2380792632430281_3892537362710562308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHpOJaxDuecQ7kNvwFJwoB4&_nc_oc=Adp0PsC3-CByohQCRFHb9siySZKzuuU62lygiX96HeMenLrJUAgprMRZi6KQX9dL0j4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX_43BPvrIDUHmGoGAke18DPvDDlJKf-cMPGGpTsO8lw&oe=6ADCBE3B"}, {"file_name": "explorer_3.png", "id": "1487503779422253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620856_1487503782755586_802549458493495103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrsHYqJ4560Q7kNvwFQePBC&_nc_oc=AdrJ8KLajUsM_PmkN8J43vB-DeXHKfaRkjgCvClswx57gs1zHdOhVm1T3cmXj1pYXR4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhSx-UKnfhDFOwF5uuRFoxrWOZOs4OysNgmvwmrEMUpg&oe=6ADCD878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1303879938518218", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620444_1303879941851551_2031038815623515836_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eFqTPBxq80Q7kNvwH8cmh-&_nc_oc=AdqnRVboA2QjfXCwKmBbX8FdkjL2bw-qbh8Y5KA9dZIFBciNicdi0SL47iR9uU-QN20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4B1V2kaNHU97IfOqCGJqi_2x3vwurYbDlBLHBjQlT9Q&oe=6ADCD4C8"}, "display_name": "Anatomy Learning Labs: Exploration Lab", "keywords": [], "long_description": "Step into the introductory experience of the Anatomy Learning Labs series, where systems of the human body come to life in stunning 3D. Designed for elementary, middle, and high school learners, this hands-on experience provides a broad introduction to human anatomy through interactive exploration and discovery.\n\nBuilt using anatomically accurate models developed by medical professionals, this experience is designed for classroom adoption, homeschooling, and independent learning. Guided by multimodal learning principles, students see anatomy in 3D, hear explanations, interact with structures using their own hands, and develop spatial reasoning skills through active learning for greater engagement and long-term retention:\n\n\u2022\tTravel through detailed medical imaging views that reveal the human body layer by layer. Explore skeletal, nervous, cardiovascular, respiratory, and digestive systems within the same body. \n\n\u2022\tSelect any anatomical structure to hear Dr. Hana Sato, your virtual anatomy guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to inspect anatomical models including the skull, arm muscles, lungs, heart, colon, eye, and neuron. Examine structures from every angle while developing understanding of how the body's systems work together.\n\n\u2022\tStep into Mini Mode to explore the beating human heart from the inside.\n\n\u2022\tBuild the human heart piece by piece in an interactive 3D puzzle guided by Dr. Sato.", "short_description": "Step into an immersive VR anatomy laboratory and explore the major systems of the human body in stunning 3D. Travel through medical imaging views, examine anatomical structures using natural hand-tracking, and hear Dr. Hana Sato identify structures by name. Explore organs, tissues, and cells from multiple body systems, then reinforce your learning by assembling a human heart in an engaging 3D puzzle challenge designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1187400857790341"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2324897514922014"}, {"status": "PUBLISHED", "id": "2526240951219222"}, {"status": "PUBLISHED", "id": "1774843966841361"}, {"status": "PUBLISHED", 
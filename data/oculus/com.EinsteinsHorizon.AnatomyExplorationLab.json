le": "en_US", "screenshots": [{"file_name": "explorer_5.png", "id": "989059970410191", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622919_989059973743524_6743324592921230158_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC8xgLGEck4Q7kNvwFR2nXT&_nc_oc=AdpslWnwgjJDGKAbghQ_N2WALdmyEz7RWxdWl2qZYUavrRlt2v7TW0OVR34JO-ccQHY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_BLao9YRlgzQ84e2ubXplYkriMVFK6bqiYzu69rVItg&oe=6AD3A7A1"}, {"file_name": "explorer_1.png", "id": "1866660500677942", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620940_1866660507344608_3944884499170681928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVgl5peYHRkQ7kNvwFEc_pa&_nc_oc=Ado8YTw1PGgcTnyW2IgOKiwDz5J3NYJAnQCyWOtN-lqAxtOnQWS4KTqO7yI4rpVOrlA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPffQs-un2pZFeATSqKPKNCQpFTcc1WPpTNBusVG0OldA&oe=6AD39E37"}, {"file_name": "explorer_2.png", "id": "1528183585615251", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310819_1528183588948584_6554402213347427020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjBQhIwuzcsQ7kNvwEpkSp4&_nc_oc=AdpDHWKa7TYTtJzWSb3C6llAuXLrPkE-zMUAtmVQWIz7to-SO1PiAp-msfOF4crbRyU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFe7lNWff_oqlbz8HwQM-HtYj2gUQXGBYlnZ31xGhdBw&oe=6AD38647"}, {"file_name": "explorer_4.png", "id": "2380792625763615", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620666_2380792632430281_3892537362710562308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldAZ2j-VclAQ7kNvwHjRn91&_nc_oc=AdpXfs4LvXE5EBwBcpdI7ak6KRXTYhTvMfkjCiKV1FA5QDIcAxYEANH2X2bitQ4BIWY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyLjKR-YNhqaiHmRvOLNV2eY-cSNlld0dSCZ_9VmHPoQ&oe=6AD3BBFB"}, {"file_name": "explorer_3.png", "id": "1487503779422253", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620856_1487503782755586_802549458493495103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO8yimHqFG4Q7kNvwF1B-fV&_nc_oc=AdoCPo1fVC6i3Rg3CcM46zdgh06-BYUhO1XzsTDrrMlRHNWpIGNtd8yP0NHwY8CyyVw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORGXlziMyr4_IhasVKe_afyCRMrlIkMgq0tyHk9Fd_wg&oe=6AD39DF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1303879938518218", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620444_1303879941851551_2031038815623515836_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSv_v_XRCC4Q7kNvwHjSozk&_nc_oc=AdqISVXGd2G9aOW8rftlCwbaPiwnyuOrfbJOD_HzmC1XlwW3Hgc7hKqJGHHqLpE378A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqSXJsSyjLajmt_J53lmsN446DZBCLbK4Fh04o7gVQCg&oe=6AD39A48"}, "display_name": "Anatomy Learning Labs: Exploration Lab", "keywords": [], "long_description": "Step into the introductory experience of the Anatomy Learning Labs series, where systems of the human body come to life in stunning 3D. Designed for elementary, middle, and high school learners, this hands-on experience provides a broad introduction to human anatomy through interactive exploration and discovery.\n\nBuilt using anatomically accurate models developed by medical professionals, this experience is designed for classroom adoption, homeschooling, and independent learning. Guided by multimodal learning principles, students see anatomy in 3D, hear explanations, interact with structures using their own hands, and develop spatial reasoning skills through active learning for greater engagement and long-term retention:\n\n\u2022\tTravel through detailed medical imaging views that reveal the human body layer by layer. Explore skeletal, nervous, cardiovascular, respiratory, and digestive systems within the same body. \n\n\u2022\tSelect any anatomical structure to hear Dr. Hana Sato, your virtual anatomy guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to inspect anatomical models including the skull, arm muscles, lungs, heart, colon, eye, and neuron. Examine structures from every angle while developing understanding of how the body's systems work together.\n\n\u2022\tStep into Mini Mode to explore the beating human heart from the inside.\n\n\u2022\tBuild the human heart piece by piece in an interactive 3D puzzle guided by Dr. Sato.", "short_description": "Step into an immersive VR anatomy laboratory and explore the major systems of the human body in stunning 3D. Travel through medical imaging views, examine anatomical structures using natural hand-tracking, and hear Dr. Hana Sato identify structures by name. Explore organs, tissues, and cells from multiple body systems, then reinforce your learning by assembling a human heart in an engaging 3D puzzle challenge designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1187400857790341"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2324897514922014"}, {"status": "PUBLISHED", "id": "2526240951219222"}, {"status": "PUBLISHED", "id": "1774843966841361"}, {"status": "PUBLISHED", 
le": "en_US", "screenshots": [{"file_name": "explorer_5.png", "id": "989059970410191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622919_989059973743524_6743324592921230158_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeVkGh1kH8QQ7kNvwFM3TwW&_nc_oc=Adqsnq8mbol22PGh1k-kLnARn0yEbsDCMICMQ5cbYKKdLY4Xb3phWvbft6J1PKoxack&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiVRBDvCzsdlg_DlpMY4HXedhhhrXTWfRbdnMiH_Gd9Q&oe=6ACFB321"}, {"file_name": "explorer_1.png", "id": "1866660500677942", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620940_1866660507344608_3944884499170681928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryMu7RZFckEQ7kNvwFMeYGv&_nc_oc=AdoBaIMq3CACTW5-WrD1VOj0R9tLIAW0YD0zVXNmWgHsW2BAAQqyh76_U43OkuM4Rp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv-HJicTF_NrOS4_njNxv1elBGxg-iTiTC8JQOCCeOEQ&oe=6ACFA9B7"}, {"file_name": "explorer_2.png", "id": "1528183585615251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310819_1528183588948584_6554402213347427020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v27oh1mUXHwQ7kNvwF_Pw2-&_nc_oc=AdrkrhuS_kUN0XSjb6zYDNkhOD0ZLWFa8i8eo4f6ZHmx1zVG9pv8pR71Pg7o_pn1IuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPckO4D7WJBTx2OnTd-7hJ8uzZ5wjE1LNRGXkSdSyVc-g&oe=6ACF91C7"}, {"file_name": "explorer_4.png", "id": "2380792625763615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620666_2380792632430281_3892537362710562308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_3NOALcAoMQ7kNvwFJxikC&_nc_oc=Ado_VYK5pAIVO3c40QXF1U3XJXyiiPDtgeujSd3fYR-tDo1iaKaXbzbczKJ0oTKmF5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf2V0hftUNwQZ1ULlXM40ThLacV7ll6lNR0GWh-pBWAw&oe=6ACF8F3B"}, {"file_name": "explorer_3.png", "id": "1487503779422253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620856_1487503782755586_802549458493495103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED9AOKtgIMIQ7kNvwG8OCgw&_nc_oc=AdohvUP4gt6z8eUDRYTDRwErRDAPn7iY6nucFrEEHmF-CnY0QT8QriLdPfPGRWRLBZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIQfpoGIP7gvtSb35vs3iwaX8RVUHrQQn520W7soarlw&oe=6ACFA978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1303879938518218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620444_1303879941851551_2031038815623515836_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERaPp0DDO9EQ7kNvwHxn7Vy&_nc_oc=Adqnn9DXLPIOKnhr32tFM8Dp0qIoPcO3SujwP9V_iMw9hx2iR9TSNBcQwEkyqFl5Lpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS0A-xd9gkfSqcZojaQk3HI_IJ16LbstfunbJ50tcqsw&oe=6ACFA5C8"}, "display_name": "Anatomy Learning Labs: Exploration Lab", "keywords": [], "long_description": "Step into the introductory experience of the Anatomy Learning Labs series, where systems of the human body come to life in stunning 3D. Designed for elementary, middle, and high school learners, this hands-on experience provides a broad introduction to human anatomy through interactive exploration and discovery.\n\nBuilt using anatomically accurate models developed by medical professionals, this experience is designed for classroom adoption, homeschooling, and independent learning. Guided by multimodal learning principles, students see anatomy in 3D, hear explanations, interact with structures using their own hands, and develop spatial reasoning skills through active learning for greater engagement and long-term retention:\n\n\u2022\tTravel through detailed medical imaging views that reveal the human body layer by layer. Explore skeletal, nervous, cardiovascular, respiratory, and digestive systems within the same body. \n\n\u2022\tSelect any anatomical structure to hear Dr. Hana Sato, your virtual anatomy guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to inspect anatomical models including the skull, arm muscles, lungs, heart, colon, eye, and neuron. Examine structures from every angle while developing understanding of how the body's systems work together.\n\n\u2022\tStep into Mini Mode to explore the beating human heart from the inside.\n\n\u2022\tBuild the human heart piece by piece in an interactive 3D puzzle guided by Dr. Sato.", "short_description": "Step into an immersive VR anatomy laboratory and explore the major systems of the human body in stunning 3D. Travel through medical imaging views, examine anatomical structures using natural hand-tracking, and hear Dr. Hana Sato identify structures by name. Explore organs, tissues, and cells from multiple body systems, then reinforce your learning by assembling a human heart in an engaging 3D puzzle challenge designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1187400857790341"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2324897514922014"}, {"status": "PUBLISHED", "id": "2526240951219222"}, {"status": "PUBLISHED", "id": "1774843966841361"}, {"status": "PUBLISHED", 
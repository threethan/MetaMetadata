le": "en_US", "screenshots": [{"file_name": "explorer_5.png", "id": "989059970410191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622919_989059973743524_6743324592921230158_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Wr8_iN_rrEQ7kNvwGnNs1k&_nc_oc=AdpPavfrxYMohGSWqU82uCagtefLyAbj6whCn8YyAxYAfM2Lzlce4H4dYj_6cYQzry0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz7D4LXsSa62QfxYtKR547FaHPtnVP2svYobcgM8cVPg&oe=6ACD1021"}, {"file_name": "explorer_1.png", "id": "1866660500677942", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620940_1866660507344608_3944884499170681928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryMu7RZFckEQ7kNvwE7rO6R&_nc_oc=AdryXqPFhx2ZvcPPNLUCXKIECnRPbXApxmV6GZndL6kcfZ5JD2oTlSob6j7634Vcobg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm7mRVmvW9CKmOIGrFPdghnEpN753VyHEo-YIsN1zV3Q&oe=6ACD06B7"}, {"file_name": "explorer_2.png", "id": "1528183585615251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310819_1528183588948584_6554402213347427020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX9Q9H5yyi4Q7kNvwH5AtyT&_nc_oc=AdrV2lTkSNnmtVkxr-2C9MfFEwbY9hVt5agOjiNYm_GODKssMWOJyLM84IAzgR9FKRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJMVVXuApOmWqSuT-htWyDUoH_HF4OrwjClfoDYrOSOw&oe=6ACCEEC7"}, {"file_name": "explorer_4.png", "id": "2380792625763615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620666_2380792632430281_3892537362710562308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_3NOALcAoMQ7kNvwEb4Xdc&_nc_oc=AdrLL8wGT_hW0I8foPD-2tL0zNONJcmb0ug1ojiW3J6mUsJn175T1lRgf8r3JDAA2lI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpunPNboqrFBEY3IyZlE-nBeoMivOA0OE6FA2b1PrF2A&oe=6ACCEC3B"}, {"file_name": "explorer_3.png", "id": "1487503779422253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620856_1487503782755586_802549458493495103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCJrw2z8wJ4Q7kNvwHe0_1g&_nc_oc=Adr6DDtSOQ9_Nmc1haiIYlBbwkPdQuwNSXgfisBELO8e4MiGXMNhTOfPlx4lcejRm04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMp6sG5SDtdGimNeQBA7q6G5wdd2vVa_RsCNW1KCTlVw&oe=6ACD0678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1303879938518218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620444_1303879941851551_2031038815623515836_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2FKhIojJxIQ7kNvwHlfkeW&_nc_oc=Adr0FvVQ5RxBMONjV080KSD3uIf2kCyzMKXdDm-odNu2WRL5s0oonX8E6wIBBI1cYHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPprf6Xa12GswmcaWnUUJ8DDZS9xIMY4WQZAk06rdHsug&oe=6ACD02C8"}, "display_name": "Anatomy Learning Labs: Exploration Lab", "keywords": [], "long_description": "Step into the introductory experience of the Anatomy Learning Labs series, where systems of the human body come to life in stunning 3D. Designed for elementary, middle, and high school learners, this hands-on experience provides a broad introduction to human anatomy through interactive exploration and discovery.\n\nBuilt using anatomically accurate models developed by medical professionals, this experience is designed for classroom adoption, homeschooling, and independent learning. Guided by multimodal learning principles, students see anatomy in 3D, hear explanations, interact with structures using their own hands, and develop spatial reasoning skills through active learning for greater engagement and long-term retention:\n\n\u2022\tTravel through detailed medical imaging views that reveal the human body layer by layer. Explore skeletal, nervous, cardiovascular, respiratory, and digestive systems within the same body. \n\n\u2022\tSelect any anatomical structure to hear Dr. Hana Sato, your virtual anatomy guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to inspect anatomical models including the skull, arm muscles, lungs, heart, colon, eye, and neuron. Examine structures from every angle while developing understanding of how the body's systems work together.\n\n\u2022\tStep into Mini Mode to explore the beating human heart from the inside.\n\n\u2022\tBuild the human heart piece by piece in an interactive 3D puzzle guided by Dr. Sato.", "short_description": "Step into an immersive VR anatomy laboratory and explore the major systems of the human body in stunning 3D. Travel through medical imaging views, examine anatomical structures using natural hand-tracking, and hear Dr. Hana Sato identify structures by name. Explore organs, tissues, and cells from multiple body systems, then reinforce your learning by assembling a human heart in an engaging 3D puzzle challenge designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1187400857790341"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2324897514922014"}, {"status": "PUBLISHED", "id": "2526240951219222"}, {"status": "PUBLISHED", "id": "1774843966841361"}, {"status": "PUBLISHED", 
le": "en_US", "screenshots": [{"file_name": "explorer_5.png", "id": "989059970410191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622919_989059973743524_6743324592921230158_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeVkGh1kH8QQ7kNvwEZiH8m&_nc_oc=AdoLBc1stCZGoFNreeOV7oBN_1kSI4IA9cILUMjmaVmuBhJ5s2Vovk5wxDLTIzWOMEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQJ_wcgG8Kk6zDI8TVyBVfrkakKdGa0cEVXtM9ToENEA&oe=6AD25621"}, {"file_name": "explorer_1.png", "id": "1866660500677942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620940_1866660507344608_3944884499170681928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVgl5peYHRkQ7kNvwGF9_l8&_nc_oc=Adpb7mTBDEjPXS1AzCAClX4hVfLzegXCVJqAGxmKWUZxlAF1bCMb455T4pvCfxIDEvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhewdDiQ5PnDMofuzhPBaRCvUbWzRREVzbgeROr0OMGQ&oe=6AD24CB7"}, {"file_name": "explorer_2.png", "id": "1528183585615251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310819_1528183588948584_6554402213347427020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjBQhIwuzcsQ7kNvwGHaObd&_nc_oc=AdqSmOdOzJ4r_uGLl60Un3DSW2Y3dwF_lIqEQYGG9AAy9CjMJRoKwpZRcsOPxyAzejM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN97_iHFdHCa8Y2_aa5Gz3MVlspicZaMJ855npIdAUAJw&oe=6AD234C7"}, {"file_name": "explorer_4.png", "id": "2380792625763615", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620666_2380792632430281_3892537362710562308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldAZ2j-VclAQ7kNvwEqyfbP&_nc_oc=AdqZ0TN6iF7VbmcM-biX9pVZ0PTyd_KLtYMvme_dpPnHQa4ojogvRznLdQwDoxsR4Nc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwF1fvks36xRZ39SF0zyL_upR_5EpIOiL50s-2W1FlLg&oe=6AD2323B"}, {"file_name": "explorer_3.png", "id": "1487503779422253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620856_1487503782755586_802549458493495103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED9AOKtgIMIQ7kNvwHVD3TW&_nc_oc=Adq6Uf2uPkxnIsjYwMoxxWSiwAclVzkvMijGn5K87zZYkiypsY1eqhQdFLhWLK46A1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxj9HCQ0yg8CUy-IfpGurzpJUnMk-A1FwYIlWJmsE51Q&oe=6AD24C78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1303879938518218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620444_1303879941851551_2031038815623515836_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSv_v_XRCC4Q7kNvwHzoY8h&_nc_oc=Adp4oqFkEb--mHhOv6dcbwPDrOBCJXysaof-fTAwjB-0KGheBtU-NTIjuyL00OabYJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr8ePkO0j1yPKj6cYGcPxaq2rw34sQf1rdDk4V902Pqg&oe=6AD248C8"}, "display_name": "Anatomy Learning Labs: Exploration Lab", "keywords": [], "long_description": "Step into the introductory experience of the Anatomy Learning Labs series, where systems of the human body come to life in stunning 3D. Designed for elementary, middle, and high school learners, this hands-on experience provides a broad introduction to human anatomy through interactive exploration and discovery.\n\nBuilt using anatomically accurate models developed by medical professionals, this experience is designed for classroom adoption, homeschooling, and independent learning. Guided by multimodal learning principles, students see anatomy in 3D, hear explanations, interact with structures using their own hands, and develop spatial reasoning skills through active learning for greater engagement and long-term retention:\n\n\u2022\tTravel through detailed medical imaging views that reveal the human body layer by layer. Explore skeletal, nervous, cardiovascular, respiratory, and digestive systems within the same body. \n\n\u2022\tSelect any anatomical structure to hear Dr. Hana Sato, your virtual anatomy guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to inspect anatomical models including the skull, arm muscles, lungs, heart, colon, eye, and neuron. Examine structures from every angle while developing understanding of how the body's systems work together.\n\n\u2022\tStep into Mini Mode to explore the beating human heart from the inside.\n\n\u2022\tBuild the human heart piece by piece in an interactive 3D puzzle guided by Dr. Sato.", "short_description": "Step into an immersive VR anatomy laboratory and explore the major systems of the human body in stunning 3D. Travel through medical imaging views, examine anatomical structures using natural hand-tracking, and hear Dr. Hana Sato identify structures by name. Explore organs, tissues, and cells from multiple body systems, then reinforce your learning by assembling a human heart in an engaging 3D puzzle challenge designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1187400857790341"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2324897514922014"}, {"status": "PUBLISHED", "id": "2526240951219222"}, {"status": "PUBLISHED", "id": "1774843966841361"}, {"status": "PUBLISHED", 
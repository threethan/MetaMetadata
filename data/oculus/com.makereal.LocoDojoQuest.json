=AdrnvUo4nSMBCVl2rnSowr5OAO-2bXDSoJnpR6POHyXI-y_AePCaQGuimbMXfdgxji8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK0dPX-KlTv8cS3l89_YHxzrRT1ltPAC46gIxCWEQYtg&oe=6A58E5E3"}, {"file_name": "LDU_OculusQuestStore_screenshot3.png", "id": "187071746763373", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031330_187071750096706_3537258925062777342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHjB2eKQTMIQ7kNvwGjVfyp&_nc_oc=AdolfjKsg_tdIL_wwXBZp44Qb6-Bri8p81_huLJANvSSB3FvEWo4wEjvRpLENNIMcDU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUp0ePlUklc_iYZaDyChxoXAorINPznPV6DSzJJfpsgQ&oe=6A58CE20"}, {"file_name": "LDU_OculusQuestStore_screenshot4.png", "id": "1175343439604090", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031356_1175343446270756_5211326774104975179_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHte1YksCNsQ7kNvwF3NbJX&_nc_oc=AdrkLR70sbSk-B2SZVGGPcag003N1U-swFsUu0suwL5txnTTdA_VdFkVcuyynPXvRDg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCpJ0wokKQ5I5hTD1SVXaRDlD0TKXY4WvXt_As9lFq2A&oe=6A58D77F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LDU_trailer_end.png", "id": "148050940768225", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031354_148050947434891_531769334988008976_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lWDJjg2UycQ7kNvwEFjhtI&_nc_oc=AdpB80T2rKLzByNZaZlbunD0EC118xQ80tQpcScn2K0FvR2cpPkAZ4gWXzb61jRP7Mw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvEVaiVyON_2LN6Evh_mNaiMUXY_TevRJIBODAptqYFQ&oe=6A58E7F8"}, "display_name": "Loco Dojo Unleashed", "keywords": ["party", "minigame", "social", "ninja", "board"], "long_description": "Enter the whimsical wooden world of Loco Dojo & step up to Grand Sensei\u2019s \u2018Table of Trials\u2019 to pit your silliest skills against (up to) 3 friends or strangers in this hilariously competitive multiplayer party game\n\nTake turns to spin the wheel & move your counter around the dojo\u2019s game board, acquiring strategic prizes & launching ludicrous trials in which to compete with your rival players to prove yourself as a master of martial madness!\n\nDiscover a wealth of wacky inputs woven through sixteen ridiculous minigames. Perform well & win a pile of Golden Suns to please Grand Sensei, earning the right to enter his temple where overall victory can be claimed in an asymmetric showdown of epic absurdity\n\nNo friends? No problem! Grand Sensei\u2019s Ten Trial Test provides a highly replayable mode that\u2019s different every time you play. Do you have what it takes to obtain the fabled Black Headband? Or hone your skills in the Solo Dojo to unlock more avatar masks\n\n*NB Internet required for multiplayer", "short_description": "Enter the whimsical wooden world of Loco Dojo & step up to Grand Sensei\u2019s \u2018Table of Trials\u2019 to pit your silliest skills against friends or strangers in this hilariously competitive multiplayer party game. Take turns to spin the wheel & move your counter around the dojo\u2019s game board, acquiring strategic prizes & launching ludicrous trials in which to compete with your rival players to prove yourself as a master of martial madness! No friends? No problem! Solo Dojo and Ten Trials Tests awaits you!"}]}, "developer_name": "Make Real Ltd", "developer_privacy_policy_url": "https://makereal.co.uk/privacy-policy/", "developer_terms_of_service_url": "https://makereal.co.uk/terms-of-service-loco-dojo/", "publisher_name": "Make Real Ltd", "support_website_url": "https://www.locodojogame.com/faqs", "website_url": "https://www.locodojogame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection
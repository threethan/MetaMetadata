w5-2.oculuscdn.com/v/t64.5771-25/39036676_1564981754305635_5167014933465506280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E30_yX4hBrYQ7kNvwFZMuYx&_nc_oc=Adr_hn_MUPAHuJE9AIMw87n2Xh93hILesu9vtYfCEE3xmgg8ey-CnjTkz_aiKEIiHoo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyAGmKTqiHIn3flOHEAqZp1HW1UqYRXZf5sEdteV3jFQ&oe=6AE34FEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KharaKhorum City", "keywords": [], "long_description": "Explore the ancient city of Karakorum in immersive VR! Step back in time to the 13th century and wander through the bustling streets of the Mongol Empire's capital. Experience historical accuracy with detailed reconstructions of landmarks. Enjoy narrated educational content, and participate in learning activities. With a time-travel feature, see the city transform across eras. Suitable for all ages, this app is your portal to a pivotal chapter in world history, now accessible in the comfort of your home. Compatible with various VR platforms, Karakorum VR offers an educational, engaging, and unforgettable journey to the past.", "short_description": "Explore the ancient city of Karakorum in immersive VR! Step back in time to the 13th century and wander through the bustling streets of the Mongol Empire's capital."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, 
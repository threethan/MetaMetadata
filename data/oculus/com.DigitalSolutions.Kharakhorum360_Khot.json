F6wlEnQ53LnQZXetZJlJfgi7LcVW7kpLCeFu0ju1ZMj6Si4Kmekf0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfybjFDvtI4zKnbhKl5PUTy-ohf7zFgmRY4ZsTOmkUvClw&oe=69BAAE6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KharaKhorum City", "keywords": [], "long_description": "Explore the ancient city of Karakorum in immersive VR! Step back in time to the 13th century and wander through the bustling streets of the Mongol Empire's capital. Experience historical accuracy with detailed reconstructions of landmarks. Enjoy narrated educational content, and participate in learning activities. With a time-travel feature, see the city transform across eras. Suitable for all ages, this app is your portal to a pivotal chapter in world history, now accessible in the comfort of your home. Compatible with various VR platforms, Karakorum VR offers an educational, engaging, and unforgettable journey to the past.", "short_description": "Explore the ancient city of Karakorum in immersive VR! Step back in time to the 13th century and wander through the bustling streets of the Mongol Empire's capital."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_in
079242059010042_7654388404779837981_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5RTLjn2aTwQ7kNvwGRciQw&_nc_oc=Adq3zseMvDHHdZaFoyzboZEMY7hJDkI1X19D7ikTWeXqg5sgM14fPuC29qjP2QMPH-M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ymOiohal8FFTMh5PYFvhe5O_kmOI7tyLFxyjNFHfEwA&oe=69F1F534"}, {"file_name": "koordCoach_screenshot_5.png", "id": "1019290868986376", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001717_1019290872319709_1791401733170139123_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5fuM_HhJU0Q7kNvwGHitud&_nc_oc=AdqS8eJdB2B_OxrWqJ53Ult4jxHp670tBVpG3gaZYaD1p55_SDEGYPOXP10EavPl2sU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oRSRZFiEymIGqOI68RQf9xKrzRzp2Jn8wfcDghSAOKA&oe=69F1FBC5"}, {"file_name": "koordCoach_screenshot_2.png", "id": "1391933431275141", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_1391933437941807_3447992079508114086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MZy-ucs7foQ7kNvwGbSBr0&_nc_oc=Adruux_ovM8r_pYFlNbWHtPHjsZY0SeW5QREGc78IoD8emElBLTQrgeUef3z0G0ypCE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2YL3sfxOJFQjIFkzeq5C21KOdMkKohv3jvuKDq94Rfvg&oe=69F20262"}, {"file_name": "koordCoach_screenshot_3.png", "id": "381505740536084", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982552_381505743869417_8501101456529502553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7hYgj3xUeIQ7kNvwEvsWcj&_nc_oc=AdpTHCODHBSCrRAFmrmLdluy8Bc76zXzJLSe4sWwDSSlHJwMbK5lnUUNkuwJe9JXntA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0cAhPhdSHW5CMpbTTRNTETlui5YZk4DCSw8ByaXht73Q&oe=69F219E5"}, {"file_name": "koordCoach_screenshot_4.png", "id": "375404381165730", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031599_375404384499063_232785683121430179_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z4RbUx7C8IQ7kNvwFUEA5h&_nc_oc=AdpdGicbUYcW_P7I2xld5474lMeX2PEV1_-Q597zjPUvD8jkKNryWcboHm7R0Y9L2NE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1Lp8R-D38c__Z_03bk1_C7PyIPATP9eIUri4SVau8Vjg&oe=69F1EA32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "koordCoach_screenshot_video_cover.png", "id": "654541972292209", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031372_654541978958875_4002709303613268245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSr_nfQoaKEQ7kNvwFswtQj&_nc_oc=AdqGn7ngR2etrOiI-smJRdqWmABnAFsHIE8C2XYYN1o4JbyVqaGlYVpMGKuED6aqtaU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3V5hpux_QY3MVan5mB73zDDePvSFZYa14Er3u07b2wSw&oe=69F1FF5C"}, "display_name": "Koord Coach", "keywords": [], "long_description": "The game modes and sub-game modes are:\n\n1. Cube activation:\n\nTouch cubes when they activate to score points. Sub-game modes:  \n\n1. normal - number of cubes, whether they move and how fast varies with difficulty\n2. hand twitch - only two cubes which do not move, but have shorter activation times\n3. movement - the cubes move all together, as well as individually through your play space\n\n2. Block incoming objects:\n\nDodge or block objects that are trying to hit you. Sub-game modes: \n\n1. normal - speed and amount of objects depends on selected difficulty\n2. bonus objects - objects which are not trying to hit you appear as well as normal objects to dodge or block\n\n3. Endurance game mode:\n\nObjects appear at the edges of your play area. Touch them before they disappear to score points. Sub-game modes:\n\n1. normal\n2. max distance - objects appear at maximum distance from you every second appearance\n3. squat active - squat to avoid a large object trying to hit you after regular objects disappear", "short_description": "Train your reflexes, cardio and coordination the fun way with three different game modes, each of which has two or more \nsub-game modes. All events in the game happen randomly, ensuring that no two play sessions are the same, to make sure you stay on your toes.\n\nVarious difficulties and game duration settings allow you to tailor the play sessions to your preferences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://koordcoach.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Koord Coach Studios", "support_website_url": null, "website_url": "https://koordcoach.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "873345950105074"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1262276228853454"}, {"status": "PUBLISHED", "id": "320298116880706"}]}, "baseline_offer": {"id": "1262276228853454"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742562120, "status": "PUBLISHED", "id": "1262276228853454"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26688219930794107", "version": "1.7921"}, "id": "735476194485132", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5097554840287261", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26688219930794107"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "735476194485132"}]},
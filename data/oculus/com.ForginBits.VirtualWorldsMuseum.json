-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mYx7MLe4MKdTifl0ybxfRkgA1Z1xvwyr-0fq1NT_g_w&oe=6A392AE9"}, {"file_name": "com.ForginBits.VirtualWorldsMuseum-20260601-111848.png", "id": "981554581270549", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824318_981554584603882_6917397635831766274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBxKJsFXDTcQ7kNvwHaqhr3&_nc_oc=AdqE8zyHajzt4d9RVjOek6gNyGEZxQ3iosInFVdECAQFAyfr6R4VVA4W0OGpgo1BqGI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F1-PZL5S2Crh8-Ahm5iRhRAh7iIn4ieyM_rfQTQTGIw&oe=6A393EA8"}, {"file_name": "VWM3.png", "id": "1093759033830282", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499620432_1093759037163615_788501382558562919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8STFksBTxjUQ7kNvwHDemK8&_nc_oc=Ado7TtMWIPFbmwHKeO4KQik1ihIEYmU0PKWNE2E540kvYM3qZ7HDhTlCN2DHDlFmnSQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rWas0TfhHDYyOo1gQ6R4YZnnyLQAxkMd3d6cmRr0beA&oe=6A3961BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 teleportal template.png", "id": "1218512360195842", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619588_1218512363529175_6370240573929404878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLKtXJLCVVEQ7kNvwEw9MjW&_nc_oc=AdrSzC_JdRBeaETnuD1BCIop_atJrdZah80bziNBKHNOR-Pf-BYXd8PPKUECUSYKp0o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VinrD4fBqsk0NlY3h4_QLpYA0V4_L3ALRHe7j4ovtIQ&oe=6A392DF9"}, "display_name": "Teleportal", "keywords": ["metaverse", "map", "xr", "virtual", "worlds"], "long_description": "The Teleportal is an interactive map and gateway that allows users to explore, find, and experience virtual world platforms through the research and curation of the Virtual Worlds Museum\u2122. It transforms years of documentation into a navigable experience, presenting virtual worlds as part of a connected ecosystem rather than isolated destinations. Designed for education, exploration, and cultural preservation, the Teleportal helps users understand how platforms relate through shared technologies, design approaches, and creative practices.\n\nThe Teleportal is derived from the Virtual Worlds Museum\u2122 Exhibits, which include the WebXR Exhibit, VR and Apps Exhibit, Sunset Exhibit, Games Exhibit, Specialized Exhibit, Open Source Exhibit, and Blockchain Exhibit. Together, the Museum and the Teleportal offer a values-driven approach to XR, treating virtual worlds as cultural artifacts meant to be explored, understood, and preserved.", "short_description": "The Teleportal is an interactive map and gateway that allows users to explore, find, and experience virtual world platforms curated by the Virtual Worlds Museum\u2122. Built from ongoing research and documentation, it presents virtual worlds as a connected landscape rather than isolated destinations. The Teleportal supports discovery, learning, and exploration by revealing how platforms relate through design, technology, and creative use, transforming research into an accessible and experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualworlds.museum/teleportal/teleportal-privacy-policy", "developer_terms_of_service_url": "https://www.virtualworlds.museum/teleportal/terms-of-service", "publisher_name": "Virtual Worlds Museum\u2122", "support_website_url": null, "website_url": "https://www.virtualworlds.museum/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
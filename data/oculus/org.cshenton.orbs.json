r fingers through.", "short_description": "Orbs! is a relaxing tabletop simulation where you can immerse your hands in a pile of thousands of colorful little balls. It's perfect for when you just want something to focus your attention on, and fiddle with, to take your mind off of things."}]}, "developer_name": null, "developer_privacy_policy_url": "https://orbs-vr.com/privacy", "developer_terms_of_service_url": "https://orbs-vr.com/terms", "publisher_name": "Charlie Shenton", "support_website_url": null, "website_url": "https://orbs-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8197262013710339"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1671064320113808"}]}, "baseline_offer": {"id": "1671064320113808"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737690660, "status": "PUBLISHED", "id": "1671064320113808"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8193597814076759", "version": "0.1.1"}, "id": "492352187229530", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8191821570921050"
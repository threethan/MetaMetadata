636631497847_1019100475944532078_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj59weoXsAMQ7kNvwFIVyVT&_nc_oc=AdpDfQ7EHCy_L3LamQxGXG_WuxFhbWn5vyT0kB5UqDHEh28xjiLqIpPjFLOnzjov8jY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWb_ZwJpvMdQkfLPPs3ER9dBdmMhFr5bkloOpuGAa4_Tg&oe=6B103ED7"}, "display_name": "Quarky Ninja", "keywords": ["arcade", "shooter", "retro", "competitive", "casual"], "long_description": "Safari animals are being hurled into the air! Within the given time limit, use your bow and arrow to shoot as many as you can. This arcade-style game will test your endurance and precision. Shoot with caution, though! Rhinos are endangered animals, so targeting them will have consequences. How far can you climb on the leaderboard?\n\nThe game provides three levels of difficulty - easy, medium, hard.\n\n# The Controls are as follow:\n\n- To navigate through the main menu, use the **Trigger button**.\n\n- Press and hold the **Grip button** to grab the arrow and pull. Release the Grip button to shoot.\n\nJoin the discord: https://discord.gg/HN6F9C9b", "short_description": "Safari animals are being hurled into the air! Within the given time limit, use your bow and arrow to shoot as many as you can. This arcade-style game will test your endurance and precision. Shoot with caution, though! Rhinos are endangered animals, so targeting them will have consequences. How far can you climb on the leaderboard?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/aovando26/QuarkyNinjaPrivacyPolicy/blob/main/Quarky%20Ninja%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "Legacy Arcade Studios LLC", "support_website_url": null, "website_url": "https://legacyarcadestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id"
R4R9Rw8IFuvg0sgH-f4M381Q4cubD_MnSeOiPzU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa6RaFrro_500u-VMKLW8SzS7-BRHWVVgxIAqvDjuTdQ&oe=6ADCCFD9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RGIOVxj7hYQ7kNvwHxxXw4&_nc_oc=AdpUVG_q0Dn2DinOwbksfsBQDH-f3rO30yM4N40Nxq-jjAEbd0kvd9JgiohkJDSA8Yc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCu0u9bpFRWNnyfkzdqCSWoO7863CnqvBA1aGO2JiXWA&oe=6ADCD62A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpBoOSNG-HkQ7kNvwHbbMIP&_nc_oc=AdoTDMC7vpMIZQeJg-56AidiQ0kqp-AwF10n_YOdCSHR3usN0e5KjDv0-9O4365hqbI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWgKs_Eu3NzwvvubQVVFsrzSfvAr6PjEZYqpFWIHFYtA&oe=6ADCA61A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
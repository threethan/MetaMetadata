0_AQQwNOwve22rgzSYBHsYKjaHM6U91Ha5ye7VolEWZKnXkw&oe=6AFF2417"}, {"file_name": "meta 4.png", "id": "1082713088017960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628016_1082713091351293_8054240345066861008_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaUnIebefqwQ7kNvwE10UC6&_nc_oc=Adr8-LsGk-K82FGpRRyNC91boPcusXSHm0OltbJLV0_5G-_ttT66qcXbMfz9EVQuqKQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2pxDLBSL1Iica_lXl60QVNRVB22cvAd8yiL5zwqCoBA&oe=6AFF16D9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46S9jCGQsdUQ7kNvwFBnzPM&_nc_oc=AdoVyQqOyXkiB8TYw4zNDPqZLLBy_2SjbllhLAbwmQykret6ZXkgN4JFrdTyxw_s3yA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqcR1agOMlya8K1WJE4ZwpbPtSf6qWiJapTzgFY9E48g&oe=6AFF1D2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIP-P3V2PdcQ7kNvwFwSmLY&_nc_oc=AdrGSzRcpalOSPvdTE_rmY3BA2-uQP4AmMp6RxgjsDNmjWKgdE3Ix4K6QHHrw9yanlQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5j8Z1syVuiSDS64X3rt2MulWPci7PEzGThGx-Zin4-w&oe=6AFF255A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "NAJIHAH KR ENTERPRISE", "support_website_url": null, "website_url": "https://sites.google.com/view/najihahkrenterprise", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ms"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1253117814562902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_1744022336652197_5263347443669804935_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1eX1N5pkSsQ7kNvwH7KvqK&_nc_oc=Adpb0sJWM3DfRzanE3kNN7tjqgViM8VqB5M5CQdgWEHlT8g9cNaamvBEUajMSzPtnCI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtZ4bqcJ3GFbQHcvKdmKWmGjS2Vfrgx5DaEWh48cv_Wg&oe=6AFF24AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hijaiyyah VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "co
wq3dLYtHjTpPaWrH5RV3D5eQJi6vTn8909_n7Ps&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX3_l7utYxe0y8otJhI3Ldj7dpLeD3YeUsglSQLe_uZQ&oe=6AC90959"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xNp3lu38eUQ7kNvwEVtZMm&_nc_oc=AdrvWvgtfvguE8GfzQE2UxJGsR-YXYb1yp8uNqYuk881nL0Z7eRXuhfmq2AgRx5F2L8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNS0muNws26nt4VD_Q8dZIOqEbyVj1ytXVKIsorv6NAg&oe=6AC90FAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHbx5kCH0XEQ7kNvwE4SvWH&_nc_oc=AdrvtHNntEdZrdA7j0Xn9Qs524Yk2RmNkURnzaMXSyTlIdhNLSKNlv6cIfliXYwXoD4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCvd2UJaqV6akoc4sg_U3SvqjBdJv3EC8tu2mJ2r6Q9w&oe=6AC917DA"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
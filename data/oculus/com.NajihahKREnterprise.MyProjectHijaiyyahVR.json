0_AQQ6dAcI_78tFLjUcOD-rWJWVRaFMLpdQhpFSJk4XgfWCg&oe=6AFC8117"}, {"file_name": "meta 4.png", "id": "1082713088017960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628016_1082713091351293_8054240345066861008_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaUnIebefqwQ7kNvwG5tyqr&_nc_oc=Adrxfc3JPVkuXgjOKWe21JL3XPFzh33xmN2obxfeuALlHwNlxLV1ydmy2nv82x-YB84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTx8gOCibuvKOQ-drZ-wGszFt5B1Gacy8MukEpH2ri0w&oe=6AFC73D9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWkMR2P_rHsQ7kNvwFmvv0m&_nc_oc=AdroXhvAJdLQmDQsxzzCpSQhdaL8Azmolmx11Nc46_X63J_1tbQy1uhkNE-2f8lSvmQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpbqe8WeCnDgMi2uLzzo2YUQ7gtZvukOOb9OcSCrzOxw&oe=6AFC7A2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIP-P3V2PdcQ7kNvwHow094&_nc_oc=AdoCVwyaYeCTP0xPKmGt0TVWIJNQIF5e3IX3zP5_tgMADlwdoZxLWyKudZFtGEkZ2_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrCvZdud0QIEWIAYiG7QDLaOntutfGWEd702Dd8_v7wQ&oe=6AFC825A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "NAJIHAH KR ENTERPRISE", "support_website_url": null, "website_url": "https://sites.google.com/view/najihahkrenterprise", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ms"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1253117814562902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_1744022336652197_5263347443669804935_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1eX1N5pkSsQ7kNvwFDEdEc&_nc_oc=AdrSVAQJVHHgm9PELKom8Eha91h9AQMid-84J_Z0rAW1qHK9HAYrHgAfXJBQsBcEDYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKFUFUthKG5HdJxnWznxe0gXE0natFKKA1S3zhS5kBsw&oe=6AFC81AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hijaiyyah VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "co
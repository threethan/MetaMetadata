ZLQGL87mkDhjBD76UL2KSZ-boGNwM4fMTBpe5MU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi7PQbHM0sSfyK_c-EXbW2AbaF2nlu20fSptsZmX5KQA&oe=6AC514D9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM4a3vn14AsQ7kNvwGcTf3o&_nc_oc=AdqX_ibJBEGj-kPCNNwZRwSWIhqb1OOQa-w26nv4hfrxy7ck4ITY_G9tTa8FM8uDrxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgdVscW7CKaBWpiBGTmCPEVdYg1fmjJI_JJ0GZuRBCdg&oe=6AC51B2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwNEsoQynEsQ7kNvwFYMGx1&_nc_oc=Adrn9d1aWG5iljLeq1-_b5qCNQig3Ns2L8QwaujQmBz8DB1OvLF1JWJWchZz4HBtV2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE2XGob2y3vVh6JnDG2u_y2hDjTvdxMKOFMEp2IUcuBA&oe=6AC5235A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
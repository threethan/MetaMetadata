rIxPWyI494TfNeMs2SfcEpngRX31SeGvB6yrEro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1Qu2r2nIHBUWJULs1O-oj8Y6ZIGdRG07wRPAwhQDG6g&oe=6AC12059"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekikjG868dwQ7kNvwE9cHWA&_nc_oc=AdpfLrB8y_ONGKFQuPMI7o5EAocZms0f7yLnCXn39L63SFU9-6sDwONsk0ZOUleRBv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmqAWaJSV72J_JsI9Yp7y-hfc-3ylbru4UmZkiON_daw&oe=6AC126AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzCPz2D8TAEQ7kNvwEy1c-B&_nc_oc=Ado22NeSCFBOtGaYQiSE4047hxNYManN62mEiWmmln1oRsruy4n0je48ZaBMCFk0zP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_0aQhEpdCzoaO5cTxrDB_-qnfCOSzKAxZPRzU2YJAug&oe=6AC12EDA"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
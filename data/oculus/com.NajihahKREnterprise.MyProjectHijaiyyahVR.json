mENlEpUtczWBzAdoUN-msCU_dKd72xCz2GZf8SA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsa2yNRAbgxWsTr52_WgkZIuCyVGnACdjeaWAaoTEkJQ&oe=6AEF44D9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw8YDOQunRgQ7kNvwE17Gnu&_nc_oc=Adp7JBNHtrJTiPMD1U5FgR4pd_XOYm_nfhd3Gqt6biRj8M3S11o8X3U9yx65Z_7gKKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT99QTSgejVzrGK9bQRMXNAEOu8ZNkQbvzkzxlzrmsjOw&oe=6AEF4B2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPVuKihhl2UQ7kNvwFOYKID&_nc_oc=AdpsSPXIL2qJ_e3Lh0Lki0tHluJhr-7pfTMuEwfzDrSfpbvI6tws62_Ra34kDfjk3Mw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWw5TL1Hd3knQ2tPaNxvY4sPzAH55ZyJwBzquoYoGSUA&oe=6AEF535A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
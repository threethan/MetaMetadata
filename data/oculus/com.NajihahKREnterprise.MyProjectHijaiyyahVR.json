0WXL6o7pKfDZaIU9bLoyQzLSdgJia97D2iV_t8M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTozxUqAZvTjzYbDZUvWk8ub4l4CKRkbG_ocHrAOoLbg&oe=6AF9D0D9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEYbaMK7TaQQ7kNvwHjW5l5&_nc_oc=AdphCDGFakLAG_Pyy8KMd9EZTPTNXhvFeaG_pcCMSNjR0IkrDll2_Q3iG9th5GKcbVE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxYGLLotTxB20cE_FurXWcI8vPomY5PRon8doa6r9ZpA&oe=6AF9D72A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6QHfe2DRrMQ7kNvwGdVoYY&_nc_oc=AdpoXCWwFnaKGN2im7B6nY16ebE7RojgFe340i7v_6U0_9ail-2Dq25XKv2dApY--NY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI7yKBD8q9xAmEY5d22ORwKwi0In0GbvVELDz7MTL74g&oe=6AF9DF5A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
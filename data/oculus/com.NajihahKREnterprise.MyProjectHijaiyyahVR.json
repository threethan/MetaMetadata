K4nL1rZuG6IKfgJKW8hF0pkmSf4Ab2TamsVJBvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-N2O9lAji1VpSgxB4ZJ79vTDwYHa916_DvLIN-klU6g&oe=6AC66659"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM4a3vn14AsQ7kNvwF2y4ik&_nc_oc=AdpJtuHXYdhjM9tBBAsEoQKHmAU1kyBO6axkmqbEYLCyQtPu41jN1n0k_z6LGh0y5HY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPm5oWdCJ8qvK6T7ixtaDAG1re2b5Pm2nglM5sybir5A&oe=6AC66CAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwNEsoQynEsQ7kNvwEYE3Tx&_nc_oc=Adp29KMRGmccpV0DPQgj1l1vpLqeFdUebULu6ozFhHHHwUAFNrzU4nZRdWEHjih4kRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOGMSjxFpqEsX3W6p6MkSfuY797U4wYTado2jthPtapA&oe=6AC674DA"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
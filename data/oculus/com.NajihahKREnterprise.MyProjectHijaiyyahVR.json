BWhZnpXT-EcQ8voC9uQOwwQqDj62pjpvukNqJXc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-ZdxcWLwXxq268hGjO63KeDS9VzdgfPeT1YnnCQ4qKw&oe=6AD39559"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmtc0oEVYkEQ7kNvwEkAbVQ&_nc_oc=AdoxVXesLPLXCY2QpKxl38nUFVz314eKHGftj_yFLQZeipxjVyk56e6sfZ2b8NukvWA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEFZ7tD2EtynVNTwXgu4PdnAM85od16r9A3FKgoGyZgQ&oe=6AD39BAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-i8iH8xaHoQ7kNvwGjC0E1&_nc_oc=AdoGzaeGrvv278ULu-9rATHhiDc9K7_mBgZ-iQPJ2LrA-oYNKyifEWy21qVBRc9PTE4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG-ZiNvmQdoJpk7ooGahjUlzKYh5bmHSNpt0QgZQWYbA&oe=6AD3A3DA"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
U6Ah4kuZNdBa1JXAKJ7JaQ3p1ABav3AItpHZlCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRix3oCIn_PbC_oarWF54grGCJRAtI9YlVbTHPsDaWZ6w&oe=6AF48AD9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sngI2jk36y4Q7kNvwEwe09_&_nc_oc=AdoztyJT9SFns8nt9Q0GTMiOsqAmTayH5HwLaN6JKqqmWCICsH670yoXs666tNNMqEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgK8ORIYH6k0DK-xawUBzHK0Nq8UUMU-epFT0cBmV0KQ&oe=6AF4912A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K07Hoc-m358Q7kNvwGQ7yS0&_nc_oc=AdpgpcmffbSPBdHT59hihQB6ULLedfniY7E1AqYHRJpLp7Gts7RUhfdYw84ji16mOOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST4fUtPPGifC_sROO-BVg_G4wZG-6NNhQFQJIcVz670Q&oe=6AF4995A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
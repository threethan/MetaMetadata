IE2Nw9kfq6dvnT_X7UXCPs9uRkS6hGWd01YdItw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqb5axoXBu7dG5cgtE18xfeYqcM3JwejrLzc5nEhYTpA&oe=6AF09659"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw8YDOQunRgQ7kNvwFjhSxf&_nc_oc=AdpzKCBcIOcTJ4clhImwkzpYPqqFKWR_6UR0CqzXHtZ_NTWqcTTWWC4M3qIlNwVm6tU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6n_mILI-7o3VmZuzXfhepEONcwW9BKgJa4fhvkeozAQ&oe=6AF09CAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbp5M6xONPwQ7kNvwHMkgX2&_nc_oc=Adp8hgxYGX_NpxT7ykky0Pk1IBtjWQTkioq15aMk6avYBr4jKCDW16a8kcqCxbecLwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyzC0DTWJIVjM2s45M8Eggc5vJWddo9VAbFWjITK5xkw&oe=6AF0A4DA"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
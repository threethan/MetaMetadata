S6IG312xzLhRBvKxicDiH4IfvZh1yn-Use3LN3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSni_LMdXRedAnbXkJdtotPPBdF5_dCtQ5cuYVeGo2LVQ&oe=6AEB5059"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyKAosxnNhMQ7kNvwGA9Voc&_nc_oc=AdrxRdsUbaMYkWoSjxcBvgxuxg2PQ4Y6QEH6uN_xxMbvqPm8k1gNCcT6WAqQkJAC5gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvsFs8qNgKMto-xpGiJWpSzuGaDTzNsPnnYOSQ5zZvSQ&oe=6AEB56AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8u-uOH1c34Q7kNvwHAVkcy&_nc_oc=Adr7qoyt_fhGEJISTNIIMDJRSCisliQlTenhrCI0l6L6KVPHVZXe6_IxLbf528sfcT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEWkxtgPjaaYBosZ-JcUgA8tykGdRQr1uw8QXwHJ7ouw&oe=6AEB5EDA"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
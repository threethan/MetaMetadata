vb3ZYGhHIJwX3qj62AFC_m4JR7QoZozonA5KBd0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPSbuGuIsAVWiT-eSxlg9HYPLdtIDIJVV_LKtpA7aN2Q&oe=6AE8AD59"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2P21rUNeLcQ7kNvwFdMhD4&_nc_oc=AdrPGvfgFVHGcpqcC52lVYO--xFlcQ476scoaf4r99F3NC2gaZrk5L5SnCX-oEz0N5M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6crNmdTad8SdgrqLWWlQixfsRgO8UkqT5r5-oIqNuyw&oe=6AE8B3AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8u-uOH1c34Q7kNvwECSQo7&_nc_oc=Adp-Xa_CO8SXpkF5hpiCFbMVVpZgSPc3FfxX0Hr-Tlk_8lSTyCyKTlXDhSVVDysiiWM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDIMcmmd5DVMPBj4H1NhtMLiacllkB_0kR5YFqFNGlEg&oe=6AE8BBDA"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
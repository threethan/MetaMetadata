aHyuLvT05WBaahpihG1kn3f60EVdUgb6r7GU1ME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5x6Kum0Rv-DpBd3f0a5u54yQfuI6_LMXn4bW17rBO3w&oe=6ACE4F59"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VsJ33o6M1cQ7kNvwHeJvNb&_nc_oc=AdrWGdc9QddbMeeSy_T9FyWhtTDpnj5lBNx6uTbfdJBGu14RxaHnXsuTJrVmyuReAyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy04Wur8u2-sIBM5GJ7w1h3dKPoTiH1TF_go1Jt5Bmgg&oe=6ACE55AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CYPf-mIZkUQ7kNvwG5fnBX&_nc_oc=AdoxIBRjNp5LbZt8ozZjffWUvXDOSlpOwt4fLWbOxN64qK8uBHiinSSGBbZ-uWl-8r8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPLqU9fQuDHYVVsXpeTlgQa8kXWP0qI1aSEXsv-HiN0A&oe=6ACE5DDA"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
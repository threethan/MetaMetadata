0_AQSiuR9F8L0LJeb9If2P3efLygbrY8o8LQUxyT5WCHEhww&oe=6B0B39D7"}, {"file_name": "meta 4.png", "id": "1082713088017960", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628016_1082713091351293_8054240345066861008_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5Lz71PP5FEQ7kNvwHIn085&_nc_oc=AdowUTXiGIZcwdYTxltFRqGgNCsxwNVt2aULHpj6UEaP_e8Fzf_bzTvkS54n_rO4Ulo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4u2TfVq6Bawe5MVUh54ddkKMIrSi9rmLvOF5tj5NOSg&oe=6B0B2C99"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BrDMiSDiecQ7kNvwFo4rwL&_nc_oc=Adote76q-ckPogrYUTlokE3TPNxKoVHfKwYOOh6EuTXHtaykJmvyR02FlHUvasbAirk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIOXlx4bgHqEeOB-Sa-Hov-EO8KwwlLHhdcfiPbuC-wg&oe=6B0B32EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNhcHaXQbq0Q7kNvwFfW1y6&_nc_oc=AdojHofOh6KXRMJQ91k2FbGZKoJzxcWDFcef0SmpU8qlazB4B973OMBVLfDrSlRSWdc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScJ874FPAcfOHSqiZPXugTPg1eBt7mNDjL0fgqzGPp5g&oe=6B0B3B1A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "NAJIHAH KR ENTERPRISE", "support_website_url": null, "website_url": "https://sites.google.com/view/najihahkrenterprise", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ms"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1253117814562902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619369_1744022336652197_5263347443669804935_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPgDO8lcJ2wQ7kNvwFNUqi_&_nc_oc=AdprRZZiU9GXjB-IFwhfRJ3f5c7p1syn6_PRiyh-Dyyo2ILygAl9Np_p9dUf-MBzqJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlW0kzztIndH9VRbiTtQJApeW2TIc89HWS26SHWNlaNg&oe=6B0B3A6F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hijaiyyah VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "co
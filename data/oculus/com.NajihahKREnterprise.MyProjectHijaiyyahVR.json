urN3_EPG9ohHJtS3Ohgi_vYE_ni_lklIDW5Id20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0Ma2exZCZcioTr9CsR7fnQgbdlhK13n2aEMrYABfMgw&oe=6ACCFDD9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VsJ33o6M1cQ7kNvwFvMGf7&_nc_oc=Adp2FEeT91IH9EiooCuvmMBTnJ4kO3Jc1zpJJs-__X-uNJvTE6pWA7Prx3YXo4ihquQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg-wh_x6XDX6mBOpKbFUM_vNIhH0AkUjY7Rg9GWSQ81g&oe=6ACD042A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CYPf-mIZkUQ7kNvwHbwwlF&_nc_oc=AdpE7ITEZ0bp63TJ7i8V2qcvBnrvPn9NHELqMiASWiQhQ2S6YoZgHni0P5bm6gyrIEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaMfiPfOCI5sJbx-R5iPhh0ees6_UcdNHq3efQbKXtoQ&oe=6ACD0C5A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
RTybZUS4IyCto3NdcGL4Ff6AXfLWjDD6GKtB8sI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoNwwKTfzh4ZLsS4MD_mT4tkERx24RN-1Ci1UmIshBeA&oe=6ADF72D9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCNot7uKfOcQ7kNvwHik4Bu&_nc_oc=AdqUAZewfl-4uDNOOme9QpDwzQO0ZEmHlaLwmPd8Gzc92pZxW76Pzy9rGi-bYfNsXGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfHuegWh4q_qBp1S13Iwzh8YssbJ9yPNh3B2CADTV5dA&oe=6ADF792A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpBoOSNG-HkQ7kNvwHI3Pyt&_nc_oc=AdppBp5u6o4nnV8hkIOL5SpVbgTnqLRUqoaj6q_xzjXPTPsVzIkNLrtK4VAHRP5ReHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP621zQ_w0XrZT-0H2RjNz4NM4XbvZnNpxVGGlx3EsiVQ&oe=6ADF491A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
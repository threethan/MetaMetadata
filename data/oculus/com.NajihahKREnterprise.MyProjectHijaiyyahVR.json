lity (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "NAJIHAH KR ENTERPRISE", "support_website_url": null, "website_url": "https://sites.google.com/view/najihahkrenterprise", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ms"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1253117814562902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619369_1744022336652197_5263347443669804935_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPgDO8lcJ2wQ7kNvwGGHs-o&_nc_oc=AdrJO1lLkG0SZbmUjLKQ-FJ5ggCBm5y0ZakBSdh6QKZcuihqg832dswrz9AEn9YDx4U&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKyW_Lf2OHCbI7kZbRLHplzPuS-3qVLZVP8qgbitdH-g&oe=6B085F2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hijaiyyah VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "co
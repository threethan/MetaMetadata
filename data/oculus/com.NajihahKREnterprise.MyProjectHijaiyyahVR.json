ubfiOG9qc5A7IEN58H0ahrH_1Lp0iUTIIf7KZ5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmpaHgUHQRgIUw9r5UoRpehPUZPtAJJZyJX6j7P_CluA&oe=6ACFA0D9"}, {"file_name": "meta 5.png", "id": "1060912459892528", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593776279_1060912463225861_1186344327976997053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBwXYyoMiYcQ7kNvwG7NLNc&_nc_oc=Adpo9p6XzktmyKII_uP1Dd7rfNFpdGW5_5I3L1RD0lsnTX5HR_g5FIhXC8bokD7VxTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-1k17BYGnaosHO-ZuWkenCr4DlhiIdD8fMLsK7Z_jXA&oe=6ACFA72A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta 2.png", "id": "970087768708781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_970087772042114_4886069875287831240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CYPf-mIZkUQ7kNvwGOdBj4&_nc_oc=Adr4ZkDtS37-0qgy8x_7s_bc-zeLd0_4vPdTDQFhdw7bH0-CGgn0KeGFyKlKz3jPbDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMixQVuqQPo2JxpNudjLvv99jRvRpFJlKicuQM4yFBcUw&oe=6ACFAF5A"}, "display_name": "Hijaiyyah VR", "keywords": [], "long_description": "This immersive VR app is designed to help you recognize and pronounce the Quranic letters (Hijaiyah) easily through 3D visuals and interactive audio. Whether for kids or yourself, take the first step in learning the Hijaiyah letters with an exciting virtual experience. Download now and explore the world of Hijaiyah in 360 surroundings.", "short_description": "Learning Hijaiyah letters is now easier and more fun using Virtual Reality (VR) technology. This app offers visual and auditory experiences designed for all age groups who want to take their first steps in reading the Quran or Arabic. It's fully focused in the virtual space without any other digital distractions."}]}, "developer_name": "TEAM NAJIHAH KR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1POv2iI60Y676L5NqbBDSfrXm9WzZaDRyz2yP4W5x9dI/edit?usp=sh
sid=6e7a0a&_nc_ohc=EJ6IJjCaG4IQ7kNvwGqO7FF&_nc_oc=AdqHLKggbE4yVsRbtdh-atVRDjWMCC7z8alvi_kHJbxllxb3j4fBPj8D0dYSPXegQOs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkqoBJfpT9JwwkNBza6tNd4Ty_onzaQM_xDJWv5pAH9A&oe=6AAE847F"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9LbT6g9Y2IQ7kNvwGQwwXX&_nc_oc=AdqWX4zQMz3627_u-hirFMtmPThcPejicEhJ0bq2OTxs7fYH8Ga64yXztH04D2jsT-A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYNWTjNnURa1uv3M9qgnw_k3vJuPz2btyeLsoWuhTqmA&oe=6AAEA8F1"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5_TarD13hEQ7kNvwFW-9jj&_nc_oc=AdoS74CnO_8To3PHB21aT20tVMaefKmCf4TJEVILYSlGMuIe-zqM4P8qiXy1VjaFY1o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOraT_EoG2Lah-Xx4C_LDINOgkBGjGVqBKyhuz9_bu5g&oe=6AAE8C4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1775058523531176", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824307_1775058530197842_1248001474592057813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUI97eaqCBkQ7kNvwEQQOEW&_nc_oc=AdoBqzlvTq4YVKI8WSUqvU7On66VL2bkOWPORis4Qs-owEPVR7t5uC3SCeym25DZNAI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI80ibu2v61KUP5_A0MfZ_B0xZ25vQDpydwJpgv3nPT7w&oe=6AAEAF53"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT"
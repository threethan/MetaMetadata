id=6e7a0a&_nc_ohc=R7cKigplBhUQ7kNvwGPGTeY&_nc_oc=Adqyftrflh8Be7dICoveGfkfBodB3VdIz8FtZyQ5MeXMJkH4mrg-08iE5jfUPp18Tkc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K0B1Ri8VKS_oFLErWgxZUULbBLvCi-Msn5UC9EBW8BA&oe=6A36C43F"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFcTqoNh3-oQ7kNvwFKgwhK&_nc_oc=AdqOYWEQDPTFDforPzbga13HVuTPewrA-C-dONGB8B9IWUK7gQEsOP_L6RzhzxUz4yI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tr9GBvR4JXlBbB8c9BdQDFULzuA9q2q6cEuv3JcgvDw&oe=6A36B071"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1wO_xLRQ_QQ7kNvwEl9UIl&_nc_oc=AdqHqaDNnsT1adfwl2NxyWhO81jj_fk3u1i5qjJ4besFrEHgrTs6tbyhi8neDjr5b1k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Yc20Eo6YlZZB1PC8SfMMdhD8EA15DzPArsD2Bz2ZG3w&oe=6A3693CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QuestTrailerThumbnail.png", "id": "1533531175447820", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499618093_1533531178781153_2000269947655761875_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6UUcIssIPoQ7kNvwHwulfR&_nc_oc=AdpWzCR78m50r6WvFQIHlNLuBPt4ujLDfacuIrUTTMFRPDJP4zXmEkxNF9596IgAFUo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6ouIArDvGfmF1oT0qiNpAL-ZYf_lpDemNOu-P3mhf3g&oe=6A36C4FF"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Anime", "RPG", "Medieval", "Zombie"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_M
7a0a&_nc_ohc=Lhs5-NTCN60Q7kNvwEHT0QV&_nc_oc=AdpIPvgGEdV5PZdMMpLvzS3A4-ACf-Y5qK5HAxiKS-fIF1qVcHSrIdtGk05Iag3bKhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW1b3-PVTFSHfbIShzxAcB171fEv69V3C90z591PtE6g&oe=6A92D4FF"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlyT9n5IlWsQ7kNvwFpv6HI&_nc_oc=AdpxFhNf0ZFv5rXlgtiJ-wjIeCJA2xr3bWV7vHUL5vP2QKXBsH2HYzRCpy-bHgM8EWk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES2IOTxXzxr0a07WwKYWRDOUrctkUawKdIluvq8Si2aw&oe=6A92C131"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fethnXJL7_EQ7kNvwH5DkF0&_nc_oc=AdqPTV_N4-bwxcLWgYYqKMfXpxRe1e7KEBH-EiPxyogsr2upPTLtQoPotbD6AU-AKs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnDelR1_-XC06DAnH9f6UQxPac-Tmyd-Acuy84z-LT9Q&oe=6A92DCCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1775058523531176", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824307_1775058530197842_1248001474592057813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz3Fnf0_AqIQ7kNvwFBdeKM&_nc_oc=AdrU6yxGVuj3gNqQ1f2meK5zn9Gx5NN-SBRO2HtIn8ZG8232cNgpODfZTdi5us52jXg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjHqRdrstGDr2F8wSewa8Gsc_vELqyxJJ5Vvcwt-Af5w&oe=6A92C793"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
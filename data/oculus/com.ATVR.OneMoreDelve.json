7a0a&_nc_ohc=TQV8bDTrr3AQ7kNvwG3hWz2&_nc_oc=AdqVLNP4WUDEEj1DLl59kK20Xdr6oSKfOMKPiwJ8EHg4GnCqTOc-EpYCHowyzToAMSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiKMLOoMnAwFVeXHMJfI0_DpL4KrezeMpIw_pX6MoGTA&oe=6A9D60FF"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m8eNvf1PzgQ7kNvwHzZQ0x&_nc_oc=Adq-uk-EDcJnNbv_0bQMcbG_XSoxiGhkwc0-EkNjTifHrmay-h3Ja2OfVNp3gcYtux8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkNSa5SLCR11WdFTLhHxG4iFamQDIn-x9XyIJvVk95_g&oe=6A9D8571"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUyaMz4pF2AQ7kNvwG9JPpR&_nc_oc=AdqaTvKfh4qhplnv_4Vdq8qR48c8Gyu5LKwsTIo2O6PiaYrilhEGweru9l17PHoaEgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc3tE_STcXw_-ky8Qv9XfosBiaAqPnQu-cjQzDlbYrYw&oe=6A9D68CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1775058523531176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_1775058530197842_1248001474592057813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDE9GbhbLB4Q7kNvwF4ku0B&_nc_oc=AdohrL8NlDqK9CjIcQHzSOFyMNnPj5QJlj6zOVUiIT3Zc20Cx_MuXApltZ4gfWT4gqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqbGi_UrLvAELAG9ZuBVeOqUUn9gXfCMsL_TWAmx-Zkw&oe=6A9D5393"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
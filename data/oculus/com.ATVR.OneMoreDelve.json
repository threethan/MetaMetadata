7a0a&_nc_ohc=-H1ChTOzRScQ7kNvwHEc4Tb&_nc_oc=AdqnA07qhQXnu039xd0F_1X4OO0mxfKV_lRtSMy9kzH0ZdkA9psotTk4u-sEVJpIfa4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaMTFio2LJgKU3Oi-nyiXlwStEFSEHYry41Y6GAeRPdw&oe=6A94267F"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlyT9n5IlWsQ7kNvwF0BN84&_nc_oc=AdqeLfPXFnUKWuj8_0ro2RwqOTol0dXwUuL8y6X2clZcdtpnH8_VtLSa-y-QZ2-kdZ8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_NCgPTe50nwLgTsLXY7v43WZydFDABdqtSIB5p589aw&oe=6A9412B1"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdBbRNDnq8cQ7kNvwEhFJy_&_nc_oc=AdoJwQhIMRH7K2nLazYUeh18xMTzvPTGwuipTzxHUUT6P0_0_m1wwuPythIhnY34i0E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy3U1PGw1cKGAyGz5Ud7-oiWVnVSr7Yxsxo7Oc18ngdg&oe=6A942E4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1775058523531176", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824307_1775058530197842_1248001474592057813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz3Fnf0_AqIQ7kNvwFh1-1M&_nc_oc=AdoLtAbvrzRVAdPE6oz2q00yDzheHBIhKIJFnJ__A5N4qH6CzgaoC9dhri4Q-EHJbKk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiDKDKxcBgK8v8zjnHay-_F6GSeMHlMWDLxLoFF8WQlQ&oe=6A941913"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
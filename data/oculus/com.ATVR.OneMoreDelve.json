7a0a&_nc_ohc=YHGjLsVJO18Q7kNvwHBOF_q&_nc_oc=Adp5MI6iTtr_U8l-c9cXbN3oLt2P_LUtmEe7vAHG-4NnQ8lMISLr5tO8Hy4D2j5mLXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId_vYI-sio4EjExaw-klYyE7FLpbEYsCzmDqQGsvK5dg&oe=6A98533F"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkbe688nMIwQ7kNvwGU73lD&_nc_oc=Ado0Jibz8Q5J4aujJuSOg_Db4jVPIsxppqUvtEpZ5LMNzFKpbgxfh4mnHglqgoa6s4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhIvMvweLLohcDpEdiZxvGNoSbr3LBsmf-GFEpSQs7Bg&oe=6A983F71"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY44crlDS3oQ7kNvwGF_R9s&_nc_oc=AdrTiHICoTYqIvAAW2rtRG5-HkJDzfIns2MQtKYFec8vyZD5r_YKX8TPAn0xxt9xABw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9CEGJvVFU34aJ2QxzpJMj9RHmJ3TWDm8tj02SZVaZnQ&oe=6A985B0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1775058523531176", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1775058530197842_1248001474592057813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHHQ00TNDJUQ7kNvwFOEaW8&_nc_oc=AdqJYI3SIp6q8FHg4ZA3L1FAqum2JK5W4xIJ0PhEVMCOEk8GvPIWwJ3rcAEHrc63-DI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLtqQkliU-9k0wiczvh94D_Z8sOWO3G04oihndCiwh0A&oe=6A9845D3"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
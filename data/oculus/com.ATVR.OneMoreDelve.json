vTJVvNJSIx4VfY0V7RLGqfYOQ&oe=6B0C70D5"}, {"file_name": "6.png", "id": "3851838375126572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822817_3851838378459905_3779463647198985173_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkHP9SoLdtMQ7kNvwG4mocg&_nc_oc=AdoL97iHdwrmdxtM2pfFueiuAbXbyrbGhHiIXmlhurwo26EduDX2FCXlwRFM5Tq7MIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxMEjPqzSB8-SCFDYriXFjeVFxkDuK-NQ43vf7JdwHfA&oe=6B0C573F"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH4hKNsOZUMQ7kNvwFOK_AR&_nc_oc=Ado07V4y8psr5FrqrL4V0fLsFzzhn56B7PUsuq0WNOGctqr7_V3UGe4Rx29R5BeqXfo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6DN3oRUX8GlvN7wPSlbR1AWcNSwqsZfXpSOo4JY06JQ&oe=6B0C7BB1"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9gwAR5PCo0Q7kNvwGkn3rd&_nc_oc=AdoYxAsHrdFYH8bVOKEiaCqCArapQAOwYluoZEsub59a4aCtH6mykY5wRLswNG8VNgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSX3gG_vYgVdKd71TsHkov8BygbqFww5Fo7VMIOuV5xtQ&oe=6B0C5F0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1775058523531176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_1775058530197842_1248001474592057813_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k37sY7qDLbsQ7kNvwHFgVVa&_nc_oc=AdrEEmf6Jxw-c62Cqw10X6Z5z2pSs1tp9s1fIrMQzf7NgGJcNFp6UA8_vKhB5XYulZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSY33CnWIcaNn22SykLAmQ7leMjAQa3fOtGSs-WFaEX8A&oe=6B0C8213"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://atvrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [
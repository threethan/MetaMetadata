7a0a&_nc_ohc=5mviGL2EIDkQ7kNvwG6iXLP&_nc_oc=AdqrR9ZqmFlrNq6_53dQmvUCjFJRbMcXhgsXvN_fX6GwSX7H8_LE3xriQieZYBLj724&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2wHJyYFpbce3IzYqHJAi1_YvbCIuRqh5U9zvXg3-68w&oe=6A77257F"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFmAuiBDvU0Q7kNvwFnlpOT&_nc_oc=Adqgl__geQwwy3YGL5_r1D8rPl1fpgV7eupFi-Cb1Q1oMXfrJdFJsdCO8wi5iTRGsUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8vAFx-I1qeaGWdZ0bEHC3pFIfsUBJ-wpog2dqsFHsVw&oe=6A7711B1"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nso1pHcRxocQ7kNvwF4nCv4&_nc_oc=AdrPvAn7k_CeIQ0TeMRweysUr5nmD3o5VFhG8CthKRaQF644iTsdo1r9Ic6dFPk63Ts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG77KinXgc3wnUQ210DJZ79ahuoqHWdqghFXeFkGlSKKA&oe=6A772D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "3573594019460649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_3573594022793982_6353582445401700312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L63yjAPm7RwQ7kNvwExz3YD&_nc_oc=AdqSDjJ3mfqZAfB8nMevdgLGKhfV7LRp7cliS6Y4cVPMHXCCsnbiLbfWfSiAXOVEobA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOGZ6_oTN863phy9wBaNemVBc3P2eU99T2ct8buacbkw&oe=6A772BBD"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
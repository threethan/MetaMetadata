7a0a&_nc_ohc=OEFoovKYvysQ7kNvwEmtU_D&_nc_oc=AdrSfrdhKevBv5i9JSTdwGOW7AVJ5M1K0yy0raDj0DQ6mV7__M5zkirVS-JMRJsj62s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeDPYubtgIqJIvXxcImlhHsG_ofmkJQpVzxj3w4Y-JVA&oe=6A7876FF"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFmAuiBDvU0Q7kNvwH9Fz0C&_nc_oc=Ado6yyPoHMucTYVZ4nDKEmMFLYGaeHS8GIc9cSm9nePKPPuIsnjdQJ4UO-KgLOP6058&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED3Ej5qVoPW3VkUyuFFRIlTZ_Ehdii2JNsWvYqE4QI5A&oe=6A786331"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TxTjyqUP-gQ7kNvwGSYUE2&_nc_oc=AdoFVZ5EEu7dt_zFyp29XY5mrgIiQwky3VBDlSQKBo9U0SJLrrNEjcnvJ23jWwN5qXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyXYLhxcVLUaAvt_G95rNE2M7ttbaJ9c3xRNqtYocl6A&oe=6A787ECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "3573594019460649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_3573594022793982_6353582445401700312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5gzBHteM14Q7kNvwF1XIr5&_nc_oc=Adptq917vTwPPMx4adx7MWcqCejhb8ON2XuslvXZGZZOTSsz0UDzM1rR4WKoYp_KE6s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEipQwK0MxM6CRCYQQJ-SpAZ7JLSX4bSoIoD91AYLknhg&oe=6A787D3D"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
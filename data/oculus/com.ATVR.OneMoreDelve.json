a0a&_nc_ohc=rbFcL9cjDFEQ7kNvwE16B3H&_nc_oc=Adriz7_DfNDlyewC7JchZp7sO5Pev4dVn-YEota1h3XZEq4Elin-k3P6vJCUR-x7kZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEiNOBHxlWqNCK__RwMy6P9IOEIH51KvldRb5Q2sTEbw&oe=6AC131BF"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eskJWCvB_XUQ7kNvwF29vSa&_nc_oc=Adr9uH6ZCYn5eFGgHBrKXnSkR_03PHfbyeCGcFuQrTgbfS1-YiYyp-qkWvA5jGC7qqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR6NBxoOJ5umDWVo0CTRqGdi4uIid40MEXoowjAPsPVQ&oe=6AC11DF1"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ri96EZs6TMQ7kNvwF1Cjhc&_nc_oc=AdrinEst6ZN6R569idX-TmmTGWfHHV5MRdfR79MsxXbTKbeQFxbYW4T8JaZ5QznAdx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkbxHRNfXO8Y4gG-3FUP1XpJNnEWHdOha8Gd504VjAqg&oe=6AC1014E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1775058523531176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1775058530197842_1248001474592057813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCJLbLkN24gQ7kNvwFvc8A4&_nc_oc=Adp_1thoT0R4tNf_V067B-iQHu1RdiO3T7imXutqxJ6POp5k_ehPYoekwdj-ebM_JIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzC29WpJ46pyPak_yBkb3r2P8nD22ki954nKPDEc0Zsw&oe=6AC12453"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://atvrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
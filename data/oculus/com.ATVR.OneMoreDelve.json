a0a&_nc_ohc=rbFcL9cjDFEQ7kNvwHutu8y&_nc_oc=AdppKnHzp6i-z4W-MBuULqhKs5iLy2jMWywRJ7rovyJuvhMwZ3tSi-6Ekqwrr9pHFDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORU2_N-606gcDAolxGt5IkVTshuzUjchmDjIpa_8a2hQ&oe=6ABFE03F"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eskJWCvB_XUQ7kNvwHg9I8L&_nc_oc=Ado543eLLjYwBi6sws_AJQUbkdOrXrvXc9dvHvayTB3oRlZtGCBcGBIIFPu0PA5gFms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiLuHSik-z-w-ngG92I5yKeS_S6ulrsbNX2XXf_Ru2aQ&oe=6ABFCC71"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ri96EZs6TMQ7kNvwHslDZv&_nc_oc=AdrJf7JdHUzl0cYormI5SFzNgESI4fKOGLCTaYaZKC0MO0izfvWEaG5rnwtL1EQjSxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORtow5Tzuiy5Tdu6HBm2PkCkfRZW-EDvcQe6kzHV9L4Q&oe=6ABFAFCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1775058523531176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1775058530197842_1248001474592057813_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCJLbLkN24gQ7kNvwGNp6Nd&_nc_oc=AdqqXOUGeLvsiWm4xCI4VTiFMRwpmFaYxdBEm3goss6D66s3g5VEa9UCpAEKuVp3OFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2xpYufBgy94LgJro8j6rGpxO678UzXUncHRFyCsRSDg&oe=6ABFD2D3"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Medieval", "Zombie", "RPG", "Sword"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://atvrgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
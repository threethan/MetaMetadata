a0a&_nc_ohc=p0JxEHalAG8Q7kNvwFOQi8X&_nc_oc=AdrSmP-5gIjxjuXq9VdUm8tnqmYQehWZfkwNL6ARkqbEsSIk7nT3u4pudDOL0XsbBbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gwmBmNh-OR_-m0llDOOVuBt2Sg4IPq9ah85566bGg-g&oe=6A0DAD7F"}, {"file_name": "3.png", "id": "1191950545947410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824594_1191950549280743_7426481589409788274_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv6NE8fL_4MQ7kNvwF3KLvV&_nc_oc=AdrHZz3gBu9Yfs7ri2Z-nchJu90Jokf5W-JZlAjp_nUZyOSzo_Ptamn1kw261D9zavE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xJ2hfmpM_L1SUoIda8I5hTJWVgg1W09GgfBh6hqfSiA&oe=6A0DD1F1"}, {"file_name": "2.png", "id": "1764073000844426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827277_1764073004177759_8944125592830904355_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cg0ocwybYd0Q7kNvwHas9oH&_nc_oc=Adqj92N-w10-fmqCfTb8giyQp00gC81vNWC2WwHwmCEcOU2-R1ZAheNZNfXUb-eKpEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KTL4Et8l5j-4af7wF_m3C3HO3o0QUdzSVuqoz5QIM5w&oe=6A0DB54E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QuestTrailerThumbnail.png", "id": "1533531175447820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1533531178781153_2000269947655761875_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoR_1lJFm5cQ7kNvwEsyUJ4&_nc_oc=AdrK3s3X5ogZK5hDYoBgt3NhLkvcMghn4NCNq3R5NLUFE4Ex0YF-AQl-Lvk4EigirpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UtxFWQhuXqeYO0HjEg0ciUIO9YMMd8aeu9CaO_ZcCmw&oe=6A0DAE3F"}, "display_name": "One More Delve", "keywords": ["Dungeon", "Anime", "RPG", "Medieval", "Zombie"], "long_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n# Physics-Based Combat\nEngage in realistic melee combat where every slash, parry, and block matters. Feel the true weight of your weapons as you dismember your enemies.\n{2075948720015369}\n# Upgrade Your Character\nLoot new armor and weapons to configure your own playstyle. Choose from one- and two-handed swords, axes, bows, shields and spells to help you fight and explore your way towards the final boss of the dungeon.\n{2449503938858684}{1952446932077468}\n# Social Hub Server\nBetween dungeon runs, relax in the social hub, interact with other players and use the materials you've gathered to craft new weapons and armor.\n{2204437950295197}\nJoin a party or beat the dungeon as a solo adventurer.\n{967269222704290}\n\n **Talk to the developer and join the community:** Discord.gg/GC4CqRebvF", "short_description": "One More Delve is a physics-based VR dungeon crawler. Fight, loot, and survive in up to 3 player co-op as you delve into randomized dungeons.\n\n- Wield one- and two-handed weapons, bows, shields and spells\n- Master physics-based combat to slash, bash and dismember your enemies\n- Team up in 3-player co-op to conquer the dungeons together\n- Loot new armor and weapons to configure your own playstyle\n- Return to the social hub to craft gear and plan your next dungeon run"}]}, "developer_name": "ATVR", "developer_privacy_policy_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "ATVR", "support_website_url": "https://discord.com/invite/GC4CqRebvF", "website_url": "https://github.com/W1zurd/OneMoreDelvePrivacyPolicy/blob/main/OneMoreDelvePrivacyPolicy.txt", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT"
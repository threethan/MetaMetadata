3J16bmQuvhmP8vaOjt7XQi1Z6HlLatDg1_c8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILCkf5O5PDl2qHaojehdR1KAdn6d_paeKmWehbjqLh1g&oe=6AB90A84"}, {"file_name": "Screenshot_5.png", "id": "676451640082240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_676451643415573_3335974289550758280_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtvqLkqs8NsQ7kNvwE_pjA5&_nc_oc=AdqYbCtnKm1cdtUsu3WJg32iPmCgdm6DifrseqFiJo7ot8ZxVolU2zXTKzKYJO7zOSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdycEg91m8wwgIOZfq7PdHwMy5jp1KGj38lfSlrOEx7A&oe=6AB937AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1838817966311152", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974573_1838817969644485_116937611574330790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBL6r_7lhSsQ7kNvwFY-Om_&_nc_oc=Adqv6kgpOdgKpKu24EPnEiS5IyQsPgi8IFfIwjl5GowE4-E9QE34bL0i2jzlQkxM4BY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAzaUrsGkEoSmjBOhw1R70xx4EBlWmycqNSmIbSXqjcg&oe=6AB92CAC"}, "display_name": "Immerse - Language Learning Reimagined", "keywords": ["Language", "Learning", "Social", "Education", "Travel"], "long_description": "We bring language immersion directly to you. Every week you will participate in immersive experiences where you are exposed to your target language and develop real-life language skills.\n\nAs a member you can choose from three primary types of small group experiences: Lessons, Events, and Conversation Practice. These three experience types work together to provide the benefits of real life language immersion, and then some!\n\nAs an Immerse member you have full access to these weekly small-group experiences facilitated by our expert language guides. Each experience takes place in an interactive 3D world designed to make reaching your fluency goals fun and rewarding.\n\nAlso included in your membership is unlimited access to our social lounges where you can meet and converse with other members of the Immerse community to practice and grow.", "short_description": "Become an Immerse Member to gain full access to our weekly small-group experiences facilitated by one of our expert language guides.\n\nEach experience takes place in an interactive 3D world designed to make reaching your fluency goals fun and rewarding.\n\nAlso included in your membership is unlimited access to our social lounges where you can meet and converse with other members of the Immerse community to practice and grow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immerse.online/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immerse Inc.", "support_website_url": "https://support.immerse.online/", "website_url": "https://www.immerse.online/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "TRAVEL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "548520973541212"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "413253490869911"}, {"status": "PUBLISHED", "id": "777581120074789"}, {"status": "PUBLISHED", "id": "889835728846245"}]}, "baseline_offer": {"id": "413253490869911"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1659121200, "status": "PUBLISHED", "id": "413253490869911"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typ
_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8ju1jqfF9wQ7kNvwHEf42C&_nc_oc=Adp7VQNe5yFZGQu91ONpsVLgtm5miTDrfVLDnx1BM64MaOeDBYarnoQPPaBrGFIuHZI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSeEU6tZfddSytRMlBXJ5Y1hX6bdkjbyWn_b6VY3GqMg&oe=6B0B3A43"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PFwI1Su8TEQ7kNvwGWB4CN&_nc_oc=Ado2y8y9gWERGhVVkAAuD-0TuKG_DrpLRWrJK8FtB3Up-IypCLciFQHMgDa-rel7Wyk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcP_RZaWnu2HvLpBcE0G-dBrmwQMRorXVmIDFAsTBsbg&oe=6B0B0EA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLsaYHAiTaQQ7kNvwGZbC28&_nc_oc=Adqo8w_f3JRq3gsOGEqwkb_gTApO2eDF3UY_ovB-Yevbk5q1Qixkq3jl4n_Tg0hF8mA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuf8fWaBkOf8NNU1Bn2enBnFS1GcObAZHwmNUsc1eyng&oe=6B0B1A80"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.",
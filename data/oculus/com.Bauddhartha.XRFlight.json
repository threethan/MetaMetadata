cb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8dHzeEI0GUQ7kNvwEpcr-n&_nc_oc=AdpQkQy4AhaSHMFblVwNzYyZmVsVge3MH86gvpdeqom4R1H6V5-PJoqrUuOxZyd2yNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqRm-bTjAp5FQPb_6lLviECZRS_L1n1dczZBvstaDZ0Q&oe=6ADF4843"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_lpNv3UuQEQ7kNvwFVIV8F&_nc_oc=Ado1KUKqs84A4K2Tra5yV22Jjpyu_cFCp1a_2bAR26wdED5LAaP2U9ZoiZIsKBC1q-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNQWMZFiMSHRN6ImIZkU9JnLNIp3gOIBuozr8SVNebIw&oe=6ADF54E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=892U1ukUc8MQ7kNvwFLlSnL&_nc_oc=Adp4FNTtcU9skIG6HDm2zxmTO-WlrBy0E_Iyk1MNM9BbKNBfrEjv9tUjWqlZFKG4Y48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLpvvFZMma9M95B_Jz7PI_oI5Jjl1H_aDSqaqQRi6-MA&oe=6ADF60C0"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bauddhartha.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bauddhartha Technologies Private Limited", "support_website_url": null, "website_url": "https://bauddhartha.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28508291322169707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXqblbVM26kQ7kNvwEdQjtM&_nc_oc=Adrll6pSgDYMEqV19k-MqMIHahrz7yUJL79Ob7sSjlWvbPwz17Zgj-Irdp3kjkaUEIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1LOggjyRCP4o0UOoiUQhYA4850EgfZBZvj5dDKLS-7g&oe=6ADF6B9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XR Flight", "platform": "ANDROID_6DOF", "context_category": {"contex
_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLkcZbLjT_YQ7kNvwEV_rZv&_nc_oc=AdrPZZRbhTpAr4Rbhm4bHxvqo0AOITIF-tjOkF_-fgzRITrkJl8jtKMHMI2gwwNwIDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbrkbcDqQMDEgaEY-knTpNlMEg9wij1vp1GifSg7q34Q&oe=6B007603"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnE77LA5f90Q7kNvwEtUZaY&_nc_oc=AdoqkPmsHRUTxEelhpFA9ZxRQUv_iLcUc-KieA3unqdgeBFno942C8jF_stXb5_trBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThdLk2zCg66HLCdGdf5mCy7L78KrK-wzEoniGxXf-_GQ&oe=6B0082A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3VHUrHXadMQ7kNvwGNIcaE&_nc_oc=AdobV3g4R-KSSY1L_xDj0HP2Dap3K4V0Hf6QvXAkp81TtSGUxzpssINCs8QlHFQOYO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCblHtAnqQMuRuCHUFR8jt0BbDxT9fOJ3g6-C5tMzcyw&oe=6B005640"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.",
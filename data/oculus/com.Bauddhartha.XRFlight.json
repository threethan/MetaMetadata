_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMGc5zRvHQMQ7kNvwG73GpX&_nc_oc=AdoO7KIh7IAh_Qeh_lpTkAF6zwm95jLtMn9kHB8DPv-Ly4sZH4EC1kqVsH1zIpqi7tY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzAKhxwP4IE7avJdjPbr9hZm1BNK09gZHFL_exzPr9KA&oe=6B01C783"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnE77LA5f90Q7kNvwEONRoP&_nc_oc=Adqy4LJc4E6rJqJnzqb-s4hIBm9UnpC6SN3vmnhcngizs8g7dFKK6DMBhLWIUkUVCAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF9o9nn3b9CaU3k49-1MuriKIjbIdO5rVNnICeu1Dq1A&oe=6B01D424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3VHUrHXadMQ7kNvwECGS6N&_nc_oc=AdprD5lso2pFfaxIs_n-Vr3CvbGxcYhCVPjSH5bjCQbgeq1TqHENMi50w6r2AeASKAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDK54zw4GCuTsFFbpa7gtiyCPS22OLGIxVxd1HCI-ghg&oe=6B01E000"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.",
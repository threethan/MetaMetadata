2973_3509135615742097578_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUcxo3OQ-0AQ7kNvwHYKprH&_nc_oc=AdpCTilNYNXOWRcnRY4EMtTOODUwg0nBllJRf1AVJm0zROK6r-H6k6pCwYtcRppF8ZA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pz7QsDkfXQIdy5ywVK3hv-_BOgzsiQjdtw0AikEkEDQ&oe=6A466FEB"}, {"file_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waJ2JZv6yVQQ7kNvwH3B6Me&_nc_oc=Adqf4vSNbaAkllZo1Ku5Xoj4hUXN8_BtSqtj9FI4GKwdvrbSJe9PN4LxW39q32QFPfs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mjWPJbJdEnrXGPtKHWnuCTO0WGgUpfxtNDImZ0pL-HQ&oe=6A469283"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMonjnyAAnMQ7kNvwFlZA1q&_nc_oc=AdpeLHWucZmcinYr2Sd1x_BPw6_Nq0oVnxKIt8DxyaJK1eXMUQuOHEv6ArpQXyv_LPc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84LApKRmQRmefb9jMkuDdCU7qZT4J2OvqiDuThzdoKbA&oe=6A4666E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9sYI0leYHoQ7kNvwHyfGFP&_nc_oc=AdplnRnxfdpOnwSdycm7s_Ya_5ZqotDgMJ9bN-l0A_w1RGC0dmpBEOf5xiy8xF53z-U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88HHlHbu2qS56xv9ct6W2tpHQ32EO0shMnBu3MtqdgVg&oe=6A4672C0"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reinvision.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reinvision Labs Pvt Ltd", "support_website_url": null, "website_url": "https://reinvision.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7781343768624432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?
509135615742097578_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTEOFMUtxvwQ7kNvwHxeMoG&_nc_oc=AdqG1RAb1Cbw6G9CEedsIonriJ76H0jr8MJFRapf4j24ZkisdzZnNnb_HJCWroXClzU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6B9U6oGRndktmdFwEPRvB-FqILfZ73Rkct3dkfu7YkQ&oe=6A6F4E6B"}, {"file_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB6NRdo5zvgQ7kNvwHz5fAD&_nc_oc=AdrS_jj7V09X53QwL6jxOaluiq5daEtOh7U7D6aWhdzdOkg2Z7Gt3ypq56UawIdKqsc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7wxyweP-Ck98UrGyFo66q1_2EFnOQXCz9_wSzvRMNeQ&oe=6A6F38C3"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEYVLI8dcxcQ7kNvwGGxE_n&_nc_oc=AdoSbhzveu-d2oyXT-52JUIXrMt_zJ3ekZJBCdUfyA-mmP1N1wzDh7i8Gy46uIkGnpU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSmUYL6zsw2NRHX6Qvq5QqL2pRyOM5BnnCpNXdOTsGow&oe=6A6F4564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhDAllUc7xgQ7kNvwHw1q02&_nc_oc=Adp6qULTcL0nUvxq-3mO17K7yIj2Z20ZKcgugyo0KPfbnvAyP_r1SxSRyVhRMF4_WaU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWQrXjtzR7StpWU0vehtGFq_mp9AZXu-dYV4fadDb4Sw&oe=6A6F5140"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reinvision.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reinvision Labs Pvt Ltd", "support_website_url": null, "website_url": "https://reinvision.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7781343768624432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png
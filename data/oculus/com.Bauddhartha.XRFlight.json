5KVaYJGZOPeK04KI77BX5cPJdfUes7QFlohvLEvfXa3-uGXpk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2ehqLvMRQGSRVWyoADr6AiO_84Wl4OC7ByX8XHuAk1KQ&oe=69F0BE6B"}, {"file_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK429wtER4YQ7kNvwEi8at1&_nc_oc=AdpNbylVy-wOeI3h3traJJvVMQrRwIsIjowMTnKGtCp7t5UdPGiNXHd2y4x0FY39UJE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3NZzj-ARjcAUqQ4IJtbe6kq3zzIWlisIZwX_oW_jTd2g&oe=69F0A8C3"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oc26TE38ELIQ7kNvwGEIsXP&_nc_oc=AdptrSeQRLfvS6ebhpxYujroOUo0KaxuyOn5LgjF6xxUnacy2IUEGn8AW2vuY8AItaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2luCiFVbaG_oqyK6f9ITjlTFc1EORE39wQmZR3T_1CUA&oe=69F0B564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ValohbyoAPIQ7kNvwG4IcME&_nc_oc=Adrvt6bp1iej4tLp1xFAWpVYv7egHd2dOcqI01cAnNndgJzTDHdclAETuFpshAtPeng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1lEep-0SxZ6xpa64_-lu4ttyngHI4QvPRde-6pnfc7uQ&oe=69F0C140"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reinvision.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reinvision Labs Pvt Ltd", "support_website_url": null, "website_url": "https://reinvision.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7781343768624432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsARF179g-AQ7kNvwH_3a7l&_nc_oc=AdpW4ieWAuS0CV_vz72_jB5lNP8VzPq2z_Xe0oQAhYzQO3XEClCiUWTZVLwUiaWia4Y&_nc_zt=3&_nc_ht=s
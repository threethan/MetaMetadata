_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeOU1KqVrs4Q7kNvwFY9_Jn&_nc_oc=AdpCpYHoidlRT4og2liy8MVypiN8iOUs1Ptjguifd26IS9kQonvNP8WVpO-w96wRdyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnPcR-qXscghifsoNW7g7AIrA9i2vmim_iAOOTjNrN2w&oe=6B070D83"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdipYxe6IMgQ7kNvwEXxeiD&_nc_oc=AdoxR9knaXS82Jgr8Uqw0KoRHoi8EBLg1z1kgCuSmNSCV-18REeCLmOOcnN8W0qdotg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbfMZSo0HUyPpPuadfqHqexFHoiRJFLB90skYOM289kw&oe=6B071A24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juuDKbKURw4Q7kNvwEauq3O&_nc_oc=AdrTjEAFJdYXbF5jbTisKLbD_sVJ-R0cG4XiJHjGICAnkoCadCFBorFOx8dlrhvG3K4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHeM-Ol8MxUMF_88a2CaELP3aBgeb3cTUJe5NytHyBTw&oe=6B072600"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.",
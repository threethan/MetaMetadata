_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLkcZbLjT_YQ7kNvwHgm0Cb&_nc_oc=Adr4SIcq1jiAzftYm2_TUJWjZMBKCoyR3L01EB_XIjkNy388iRhY4RretRrQoB2Xkpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNW3QzgNT3dqc5QwxXDMfx86eYKLaIYltDKRsUqkyWNw&oe=6AFDD303"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV4jikFw31UQ7kNvwFeRvrq&_nc_oc=Adq6vkwHStzVxH17Hrx11Rl50GNi141kFDO2nlW8miE5xJqeyss9zbyAebtuWJSjXXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjKMlk2Mp2qm0yqgwrfPiT3UPF_V4w-YmS5booN2hA3A&oe=6AFDDFA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-TkI2wGc7MQ7kNvwGeCVhc&_nc_oc=AdofMApzp1H1OwMWN_-L55Erb_mBu2mGoP-Fo1EKxKJie4_p5rv4R5ea4Xp0iFFtZ3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG5hXp4pKAHRrgnemfTSLD6_WIyukoXriZ6otiJ44AxA&oe=6AFDB340"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.",
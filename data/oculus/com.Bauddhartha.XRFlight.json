509135615742097578_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YExhMUQozi4Q7kNvwEwdtg4&_nc_oc=Adqd870ByrRlReuaOCjsTgFH46mCOyjk6eiZsjiBisfphl5o1wQAyvXPiPvFQt55E5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC6QrecbwVW_Jb3xtZXONHIQ8GAk5rxRHjRvUutsgm4A&oe=6A4D076B"}, {"file_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYWlJjnwRFsQ7kNvwFdCQAN&_nc_oc=Adr9iv9OBAT_XgBGcaP0aL0rpKpgqFh5kItLGEVeqeg86BVmMSfKjY3KDFGH01Evzhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8dtxsjb0zseRwIu7h4yo-a-KdTedyuAiPAbkULTHMhQ&oe=6A4CF1C3"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DCfjApMN3gQ7kNvwHU2xUi&_nc_oc=AdrP4mTP3a467nxHcTSsWA5MtNMs9JwTWxintaPheQWU7E-Jl0p-t1FJ5nFtv9rbpT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALdoJZ5R8ThLRTF6VBabMzmPZ0m1djhqnMjhLgobYqcQ&oe=6A4CFE64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y96sE6cxQzkQ7kNvwH4DW4Y&_nc_oc=AdoLCpY82p8z5vlTo-AoDgUh5-zR-4LOVbpMGcis7cdYnuAgKbuAJ7KCrLrH4pxDQYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMKc81YASlAD2NO9W7MG_HtGKrSKjwPS1QXWZ9F0t6lQ&oe=6A4D0A40"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reinvision.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reinvision Labs Pvt Ltd", "support_website_url": null, "website_url": "https://reinvision.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7781343768624432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png
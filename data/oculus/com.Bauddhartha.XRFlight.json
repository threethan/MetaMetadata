_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeOU1KqVrs4Q7kNvwFrLQl_&_nc_oc=AdqZbMQM2a-S6fNaRtJlFVt5oR9QdldiWJVgmMYlQp_KamcabNcvAlOMzOhrkDB3v8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ3EWYQFPgQWdPdV0c8gpyd-RXPzqYTcqqboj2x9mV_w&oe=6B05BC03"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCFArU_9uTAQ7kNvwEg2UYq&_nc_oc=AdrfRhl5G0rAZtSNhx5zPKd4-iTplxtJBqjbnaL1-YHdR4Mto5qvGxNMNVWNW2CU8dM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgZDfwvMKpxPhKEn_BeU8iyNta4uLOQvu5en4pIG4FzQ&oe=6B05C8A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juuDKbKURw4Q7kNvwH-omtf&_nc_oc=AdqrqYk36zCn4FOx3S6FuhbKB5znf9raJKr8bpIhVggbJ6YcW7VHW16FTfHY4c-fQ_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpD_XthfQGjkD3Qrb9x6e4aOfUHSkdNa4uj4MyYLKB4Q&oe=6B05D480"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.",
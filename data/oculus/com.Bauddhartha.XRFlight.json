&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5gV0hFDYegQ7kNvwEosfKr&_nc_oc=AdnvkJge5TeUCA6z9-7j182kQrcyCdbYzFt_Pk1fTDNLNoIxeeUxEjkTHvVLC71ezbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyli_cCODk0f-5r2jGAc3vggmtXL6X_-0tSxGoKEx1QYw&oe=69B6BC6B"}, {"file_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_05VuWiZIJcQ7kNvwF5fmHH&_nc_oc=AdlqJiAiKIdCAiFPffzlego7UL1igPnOK40NVxdiBcJO9LqYQR1RM-Qz4wKU7ukBWXM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEl1TaxY42_q8yFzO2WRhJI9s8GBuduoaRL_PYmQQ_FQ&oe=69B6A6C3"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGvlIjsI88AQ7kNvwHHJ4KP&_nc_oc=Adl342fdEx9unf6VmIgT5yXohO0von-PC76GuswmmcAhU5MVp7hvWW6AXwEHWg13gxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz95q1EvGzlbnBdOwSFIBDASvCS292PvfGLAvfOKojuhw&oe=69B6B364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOcdi2nrvuYQ7kNvwEi2bDv&_nc_oc=Adn1JeNpOwdyr7IVt7tZg5LDoQ8yQ8lUQaYRj58MEYxlEUioB79f9_9Q3-xNhx5ZuwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6eKX6dWnR_SCsb3Pjg317GyIUvWbqVCWyqZE1p1xuPA&oe=69B6BF40"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reinvision.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reinvision Labs Pvt Ltd", "support_website_url": null, "website_url": "https://reinvision.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7781343768624432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc
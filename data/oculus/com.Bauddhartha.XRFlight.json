ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_mIkdkEGeMQ7kNvwFDkaHT&_nc_oc=Adq4pfg17nwaatIMir7BY5IVNU6IJbg7eqACjAz6n3dKJx9AMf3w31Hz5zQkSL49JzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS07Qwq7aZFeeQmoxre0GUCYORtps18bhQ6XpuslpI-tg&oe=6AF49883"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvgVi-3uQrsQ7kNvwGNAwPp&_nc_oc=Adr1SEuXQ9noJDBntmKvA5Wei-TEduDISHY7iTQsIgOxm4jmtztzYwOi0ABNZ9SPVpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSicRX9rBef4zbkduy0Qtcac_-fIqpErEh8C7fwVb-E8Q&oe=6AF4A524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7ahhxh1hGAQ7kNvwFOV3Dd&_nc_oc=AdqE1LQZerVRNEhMd-_X4lwRcuC90sQt83RA-hY-B7s2cIlc_0orqU2xLbENJowWaeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtKF_aE8OhEkvWPlh0WBMT4gjAS8VeBMXB5cxMktdsGw&oe=6AF478C0"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience.\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bauddhartha.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bauddhartha Technologies Private Limited", "support_website_url": null, "website_url": "https://bauddhartha.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28823126074019562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ic18iK7G_doQ7kNvwFli-Dd&_nc_oc=AdoLZdAHCTY2M2U24iU7_Lk6r5kQuKDby_GEMnPpy_g-iDGjMBpH2f3JkLHgXK6oT8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5iM-q8TW8RNGgBQ0QHJ6f88UWcG8Vej1FDnSVadj4Jg&oe=6AF4839C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XR Flight", "platform": "ANDROID_6DOF", "context_category": {"cont
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVbUN1wIaLAQ7kNvwH8wAqW&_nc_oc=AdlD6L08VkDbL8D5iBwbwekW7p3RTX5LniupHMkdStrRUe_EzhKIbUghoGkM6IuKpJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJLzr8xJ2qCHT5LOdM0Eqnmt2UT1EzsJgN9VCWIylRew&oe=69B1766B"}, {"file_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCd2Ank3tjkQ7kNvwFNLivl&_nc_oc=AdkkyqxQ4uSM3KQC8NwBVgsgc8yIiEf-DMZVAFLdN0ZgcxECo_QBCGXgVhZ-IMo6bfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRGcah7K0vUTsHLNyqqMc2tsY8Nu7kZSTDtaRhAIKSmQ&oe=69B160C3"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE0XkjHLcqwQ7kNvwH3CZwf&_nc_oc=Adlot9bda3AJPHUHSqjilUNMWyyTu86R619E4jjzNuhgeSzH9qQMsRygg7oye3gv9aA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLOaMFR5BRxC9f3D-KWmxoYO1U7zKDb8cOfIBxzC_Y0w&oe=69B16D64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i-1nwqxhuIQ7kNvwFTrJe5&_nc_oc=AdmdtIj42c0spv9J_nxw7T5mASPmQFNRo-GRg6AXMpVswJdt_jHBdC51drLCo2Nq7-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7i3VxEGzWw8GiT5mZBG8zvMRg74xHpNrXctIvIYdK3Q&oe=69B17940"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reinvision.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reinvision Labs Pvt Ltd", "support_website_url": null, "website_url": "https://reinvision.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7781343768624432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc
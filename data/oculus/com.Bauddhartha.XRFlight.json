_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5AO7bpop2QQ7kNvwHOlfvY&_nc_oc=Adouwk7aQ7w30PLL5O8cPjsj2GAXdlewFwcETQjm_clJfYs-JPF2mPnSkrwC48rtyrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVwNHF5CUZIQ6Wry76wfQGXVrJPTg4VZm6vVQNjx-0E4A&oe=6B0EF683"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJmknA0dZ-IQ7kNvwGtgP_p&_nc_oc=Adozlkm2oSaq4gvDaG95QlT0VDc-Fy47XLXMllvhK3y6URea4L_3bgZBBsW-DSH07no&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpie1Efy9HYST6SFK31u5zVzcWwuMvTOiYMWEvLYcQUA&oe=6B0F0324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_EEZD8E0bgQ7kNvwHuFIYF&_nc_oc=AdodwV49NzSxoXeBAIH3CJ3LDIJjS8cB9RQP-R-JmUEDfJHnmVVtr6xvwI5QQBnxS8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKqbIf2q4S85qiH_yW8IrBxsIQTL3JM0T9gUbmmRF7xQ&oe=6B0F0F00"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.",
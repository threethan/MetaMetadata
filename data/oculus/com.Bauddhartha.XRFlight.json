_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMGc5zRvHQMQ7kNvwEyczXc&_nc_oc=AdoBaPUKjYbFeTBYrQlEgzjlwKd9-JW5wNT3BbITj-zgzVKi_VE-eqbUE1bW4StJGRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLZpZO660aUFB5OjrQ8RRDfn8nP05-qgeveBfu57gFCQ&oe=6B046A83"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCFArU_9uTAQ7kNvwHxB2Xp&_nc_oc=Adpj9NOQWmufVcx9ff2unJpgw1P96eS5Q3-c9yZ6PxJP9xlt-Cv3U8Ed4iI9f4IgJFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7aFd6KjK7rTyzM2DD1X3m5Hsj5RsLglXImS2MslQLPQ&oe=6B047724"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juuDKbKURw4Q7kNvwEBXham&_nc_oc=Adq6hfNjNlwHv1r231X1lT4Coyb3BjyeKEM9Vgb8n9yV8l6wI3kwJVMMo808kvswJdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh6L1fBjlmtqNXWIhkBWs53M5xs3ne6aWgEH8ktdRtZQ&oe=6B048300"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.",
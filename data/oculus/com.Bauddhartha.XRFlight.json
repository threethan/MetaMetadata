509135615742097578_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ8o3Mu7lNkQ7kNvwHUQgUx&_nc_oc=AdrOsvmurWbAKYSg1ie5PgK2tw9Iw3JBT_vgwf0IwsZp2QBIBbiP00RY7Rd8C9xcEi4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxz3TGBc4d5AfMai006n4REPGacdPU7EMMUOdPZ2SQaA&oe=6A68B6EB"}, {"file_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWlP4HNhjCwQ7kNvwG9UeaG&_nc_oc=AdpIr_cLHz2P4NcusRHXRl-5aH02KibPhY2iSKWdUByF3leHGSL0IdfA3oN5BgqvrkE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb5W5RtcO_fWfj9EIRzdc_gJ6Kr62EkN-jv4PiEoTYSw&oe=6A68A143"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBMRn_YTm4AQ7kNvwH9iUya&_nc_oc=AdrOAZ-PvAklZbHbINMElTpfO7x_LIek7gyelbm3yq9GSyANHFXX8jGhL6HPtGTzHPc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBow6Uszhhq5Ki7PMr1FmadKAaEZ1KaX30LYFPypFpybA&oe=6A68ADE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qfb3Gs4Zd7cQ7kNvwH5ZDJB&_nc_oc=AdrsJwAIJLC_Xrkp39ErEhLNRuUUfuuZZq8Qn9uYEMfSca5Wa9CKtibWE9MT8r6Z3OM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJdB8E7nqVyHnAD5jwsi9wedO7GucH7v_B1POIEx4eWw&oe=6A68B9C0"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reinvision.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reinvision Labs Pvt Ltd", "support_website_url": null, "website_url": "https://reinvision.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7781343768624432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png
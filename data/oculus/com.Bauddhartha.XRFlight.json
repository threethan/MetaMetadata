cb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLwI7dqXCX0Q7kNvwH86bMU&_nc_oc=Adoom46mtC76bR3zDNcgrgZ5C_7YGC9MTAdMC7TtXsSFysL9eAaxs75gN69mh_AsA6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhZsqm1wJWmCbMRmPKQcKy9dt4Ei_xYKnHfemzUUZjXQ&oe=6ACBBA03"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bYo_NyUMkgQ7kNvwF8aygQ&_nc_oc=AdpwpsaNOQNaF5FHYRqFTDf01rk9APl3COKkckZni9067kpSyQDh7LlR-Ebu3AQJjTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIMFituX6MAC-wvOJFsQI2mxxpXfcmPFmKMcs2PDYNGQ&oe=6ACB8E64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo69vNKsrMwQ7kNvwGHPdwT&_nc_oc=Ado9ELanUxqzu_sWFG6_ga7-JQbCI607GxcnyiH-g-irsMswp_4apktJxID2GGwt32I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7r27iDNp8pu9v3oEFo2RsQNC0Dfnkar5xTFjivvXA0w&oe=6ACB9A40"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bauddhartha.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bauddhartha Technologies Private Limited", "support_website_url": null, "website_url": "https://bauddhartha.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28508291322169707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSbQRbxKd7kQ7kNvwFR2JCZ&_nc_oc=Adqd9n4_1otZ3WdhfhlsHlyuSFGxzjDMlWQa6Lh-zAw6spchnbeNNYaJLeUJGAgtTbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsnMKn07_96FOZXL4JhgHp3hCfybysn7SH8GO98iYPnw&oe=6ACBA51C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XR Flight", "platform": "ANDROID_6DOF", "context_category": {"contex
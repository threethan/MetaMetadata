h0Bub2WTICGMndtY5eDtG2-lRYV2ZnJvIdrB8c8-AtQAPMW6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfttSxgl7jS9lQgzEBhHIZjobo0Nvbv1VHhG8cnSviPTmQ&oe=699C5E6B"}, {"file_name": "screenshot3.png", "id": "697211268553884", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035448_697211271887217_4294840013929201766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwQSzvc1dBYQ7kNvwFwFLrg&_nc_oc=AdkC2l6cMt-f4Tycl0lHn0NKM9J6vp8-DSPMGEbqZHNXVkMZJo-GiaJCo-ReU9DKaQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft_w0ZM64QjXe5C_shPPNgFobjoMm4jVqZOTL4x5sc09w&oe=699C48C3"}, {"file_name": "screenshot4.png", "id": "842198497187407", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566683_842198503854073_4128182134212392960_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wir4TwFO6UkQ7kNvwHRyeEG&_nc_oc=AdmoMdIoGwREdrTI5827c4cUYYU-fN_fTHtwGpoEewVVutRjHStgQSOJ4Ovreh0Kcis&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv_93McTS_5KaPXGCVhQQI7KMpn6Xcgbu60DCOLPTgf7g&oe=699C5564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-banner.png", "id": "1196052154628289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982663_1196052157961622_7107487907372685701_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf19SFsRyj8Q7kNvwGA2fJ1&_nc_oc=Adk2XQ1L2xdrvD6lhkwz96dDfY4oS3RIR1HjsXb7C260zrZFdkL8MefCS4be10dKYI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs59VLbPA-U7OMMKOiSo1KVPMzpFsHkuiVUKZdTy2_A9g&oe=699C6140"}, "display_name": "XR Flight", "keywords": [], "long_description": "XR Flight virtually offers a realistic training experience for the crew members who play a crucial role in managing safety, which can contribute to the prevention of incidents and/or accidents by allowing learners to experience the situations that might precipitate accidents, characterize or follow security threats, thus aiding in building individual resilience and preparedness. These are designed to engage the crew and improve their learning of threat prevention and response procedures.\n\nModules : \n- Cabin Crew Flight Exterior Familiarization\n- Cabin Crew Onboard Safety Equipment Familiarization\n- Galley Familiarization\n- Door Operations (Normal and Emergency Door Operations)\n- Pilot Preflight Walk-Around\n- PW1100G Engine Operation\n\nFeatures :\n- Learner Centric Modules\n- Experiential Learning \n- Interactive Practice Modules\n- Realistic Experience\n", "short_description": "XR Flight training is a package to provide experiential virtual training solutions of Safety and Emergency procedures for the Cabin Crew/Pilots and hands on experience for personnel of MRO's and RAMP. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://reinvision.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reinvision Labs Pvt Ltd", "support_website_url": null, "website_url": "https://reinvision.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7781343768624432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982715_952326799511094_3510926979062579095_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmGe0S_HJ7sQ7kNvwFOmvnM&_nc_oc=AdlYrqYASzDc7sYIgc-HHwEC0CkA7l_0UQTl1f64CZ4dNxRwPWq8iUMTWDRFpF9qbLA&_nc_zt=3&_nc_ht=s
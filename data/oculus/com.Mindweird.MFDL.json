_mg1gQ7kNvwGC_jBD&_nc_oc=AdqZvftJofLMvxPtG_iVZQ3Jlg-ySJW5Hq3wPQOdX7P_CoA0Oev5C0gPyZWAg3XSvCc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p0PCV0IRKL_5l-s4OgfhqzYc63Wr8xcVJGHuC4FzRSA&oe=6A4662A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 MFDL Wyatt Billboard rev.png", "id": "842574890974146", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566682_842574894307479_7527762273476649291_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1q-ReDHlfQQ7kNvwHNxZOh&_nc_oc=AdqZ-PhM0s-Sl7DFv4ncgmm1FB61FNONcp_NRGc8JPqEGP6uK5tNsvpoGSYkS8GXrUM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6u1KwCBmTu69zgViWK_EZ7j-HZfnSu9WRdQNiQx7yCA&oe=6A467719"}, "display_name": "My Forked Dating Life", "keywords": [], "long_description": "In this interactive romantic comedy, Wyatt, a biker with a disability, wheels through the dating scene with style and confidence, only he\u2019s not in control of who he dates next\u2026 you are!  Help Wyatt navigate the awkwardness of dating and online profiles on the dating site \"Sausage and Muffins.\" With hilarious dating profile videos from Madyson, a hippie who runs a pet shop, and Olivia, a blunt but charming writer, Wyatt finds himself on a wild adventure to find love and share the moments with someone special. Will he find the one or will he be stuck riding solo forever? You help decide his fate in \"My Forked Dating Life.\"", "short_description": "Ready to hang up his lone-wolf status, a biker with a disability finds himself at a crossroads in his dating life. You can either help him out or fork things up as you choose who he dates in this interactive VR romantic-comedy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindweird.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Mindweird", "support_website_url": null, "website_url": "http://www.mindweird.com/", "category": null, "comfort_rating": "NOT_RATE
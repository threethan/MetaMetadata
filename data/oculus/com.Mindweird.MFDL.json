uluscdn.com/v/t64.5771-25/38982565_702556498676729_3708356445860492387_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpCLmtfuW5wQ7kNvwFmKqzR&_nc_oc=AdpR6paodAXbN4oaejf2MEiFQJ_FxyNVamySizp0PXMuqpod7BaRqGNlBoDDeLTczf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-joa2fKcrSkBVHXOgwdXY3OmTkXyAoFMAp0bgLjdQBg&oe=6B06F620"}, {"file_name": "bestMFDL_2560x1440_121.png", "id": "253432307398516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974756_253432310731849_567586541239218082_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dbk1-LEXas8Q7kNvwHIUzOc&_nc_oc=Adok0dcFm1TQ9s6D8QR5NDgcLOgROdz-wHiBQ55fCZrMLiqw0EskocMUAsYDFns36Ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdq2-gIihmJEDgoeb7QEYJQYHZI6kumK1J8KE9ojKA1Q&oe=6B0715E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 MFDL Wyatt Billboard rev.png", "id": "842574890974146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566682_842574894307479_7527762273476649291_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3bpbCxdi9wQ7kNvwEfntDi&_nc_oc=AdoroW3h1Z66WRCZBdgAo7dLnOqK7omhedfEsjqfBKJfFeLAu2o_krvjK93CfvJxg6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqmi-2_I381N0f_ylIjQ9yMP569eVJDku7qLYM8bARgA&oe=6B06F219"}, "display_name": "My Forked Dating Life", "keywords": [], "long_description": "In this interactive romantic comedy, Wyatt, a biker with a disability, wheels through the dating scene with style and confidence, only he\u2019s not in control of who he dates next\u2026 you are!  Help Wyatt navigate the awkwardness of dating and online profiles on the dating site \"Sausage and Muffins.\" With hilarious dating profile videos from Madyson, a hippie who runs a pet shop, and Olivia, a blunt but charming writer, Wyatt finds himself on a wild adventure to find love and share the moments with someone special. Will he find the one or will he be stuck riding solo forever? You help decide his fate in \"My Forked Dating Life.\"", "short_description": "Ready to hang up his lone-wolf status, a biker with a disability finds himself at a crossroads in his dating life. You can either help him out or fork things up as you choose who he dates in this interactive VR romantic-comedy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindweird.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Mindweird", "support_website_url": null, "website_url": "http://www.mindweird.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24877836225193556"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "300139389251009"}]}, "baseline_offer": {"id": "300139389251009"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710192600, "status": "PUBLISHED", "id": "300139389251009"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24898901369753708", "version": "2.1.5"}, "id": "1682496322167578", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8728935483843554", "is_concept"
tps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_702556498676729_3708356445860492387_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVdL-fsC0ZsQ7kNvwGHXFgx&_nc_oc=AdpwEDgWDKmF1nLtb_7UKTZ_Tc66TNXtG3az2XbFFirEml8vt0btZhFtv6dSA51hOaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t9918tssjTXXFHzsGyEC2g1UwGhF0XpDZxfu6VeuIbw&oe=69FCA720"}, {"file_name": "bestMFDL_2560x1440_121.png", "id": "253432307398516", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974756_253432310731849_567586541239218082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGDgfOoDTUsQ7kNvwFV8M1l&_nc_oc=AdoUizHyl_7M_tNBETbuVZd2DV2wq6_LDbtiyGdKV0YE94Ow3IbCEbiGgJwbuNZpqts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xl__g0u1vuWYfuO_sz-lV5Gfor0kcCC1oUJePnA7gPQ&oe=69FC8EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 MFDL Wyatt Billboard rev.png", "id": "842574890974146", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566682_842574894307479_7527762273476649291_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKkYRPOcSmEQ7kNvwETHyos&_nc_oc=AdrTxLVTDvwN8nJQOZnj_PUMkvHkgXAiGLvromn46vvtzKvcmguA0VrR5I5eOJQ6uF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lHo9PXrmdo88vpfU6fQlGNryWVfm5KDhlNx1nz13G2A&oe=69FCA319"}, "display_name": "My Forked Dating Life", "keywords": [], "long_description": "In this interactive romantic comedy, Wyatt, a biker with a disability, wheels through the dating scene with style and confidence, only he\u2019s not in control of who he dates next\u2026 you are!  Help Wyatt navigate the awkwardness of dating and online profiles on the dating site \"Sausage and Muffins.\" With hilarious dating profile videos from Madyson, a hippie who runs a pet shop, and Olivia, a blunt but charming writer, Wyatt finds himself on a wild adventure to find love and share the moments with someone special. Will he find the one or will he be stuck riding solo forever? You help decide his fate in \"My Forked Dating Life.\"", "short_description": "Ready to hang up his lone-wolf status, a biker with a disability finds himself at a crossroads in his dating life. You can either help him out or fork things up as you choose who he dates in this interactive VR romantic-comedy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindweird.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Mindweird", "support_website_url": null, "website_url": "http://www.mindweird.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944959681814453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031597_314706764900805_8296156745432945548_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NYPsUKpFm8Q7kNvwF-1AID&_nc_oc=AdqG0mVIZYCJ1M8vou2Z0MVAJBwdTJmHMDiLd0KXlyO2__8ON4folYv2-mPXfwXhWgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kQsiGRmOpIwTN2JH2CGvN5-cizdVVkvRI78zr3ts8yw&oe=69FC8B08"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "My Forked Dating Life", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1710192600,
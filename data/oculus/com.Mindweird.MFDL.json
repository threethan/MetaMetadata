tps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982565_702556498676729_3708356445860492387_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9jIqVoE-ZUQ7kNvwHo3QVn&_nc_oc=Ado75lZ1Wajan6rmKZCX60psdPOQQKt_wmYliM4brnaWmAiZSa7Z8EEzg1QFe5FPYKY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7cmmOSrzvQg7IbxYTHa5nSKJjp1kukwIHYwhFgU9NjA&oe=6AA02120"}, {"file_name": "bestMFDL_2560x1440_121.png", "id": "253432307398516", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974756_253432310731849_567586541239218082_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9iN2odM1k4Q7kNvwGxgVO1&_nc_oc=AdomaHbZ8ycoqcVpVsKFn61ZUm0x952_ez9FXXCjx4NbA1gR6AMT_h4qepnIgdWa-GA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2PVUTMWOpp8tCV0_4ocB-PS5nO7GD1ejASpuO6Em-PQ&oe=6AA008A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 MFDL Wyatt Billboard rev.png", "id": "842574890974146", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566682_842574894307479_7527762273476649291_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgwfniipGv4Q7kNvwHXy9Om&_nc_oc=AdrXT-TYe1Vdz_tWF0cAU-XivOcAWLCP8XExH-DMTqgxuxKeMLEou7Qw69XTl-cMAR8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkF5HoXnYp5kKPk7IwAsbsgmZiOwAInrKiXBfGMCWFmQ&oe=6AA01D19"}, "display_name": "My Forked Dating Life", "keywords": [], "long_description": "In this interactive romantic comedy, Wyatt, a biker with a disability, wheels through the dating scene with style and confidence, only he\u2019s not in control of who he dates next\u2026 you are!  Help Wyatt navigate the awkwardness of dating and online profiles on the dating site \"Sausage and Muffins.\" With hilarious dating profile videos from Madyson, a hippie who runs a pet shop, and Olivia, a blunt but charming writer, Wyatt finds himself on a wild adventure to find love and share the moments with someone special. Will he find the one or will he be stuck riding solo forever? You help decide his fate in \"My Forked Dating Life.\"", "short_description": "Ready to hang up his lone-wolf status, a biker with a disability finds himself at a crossroads in his dating life. You can either help him out or fork things up as you choose who he dates in this interactive VR romantic-comedy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindweird.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Mindweird", "support_website_url": null, "website_url": "http://www.mindweird.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944959681814453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031597_314706764900805_8296156745432945548_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldrjCaFmWLQQ7kNvwHEZz_t&_nc_oc=AdoKBSlUQi07Hrn22YbAoJs5kJArh1HBgOcclXuDHZWD9NMlcg22WMn8EW9Sih2sR5s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3K-1QBObPC8WHCKRuGFVDb_-HSxHHbrMzApOb51OrEA&oe=6AA00508"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "My Forked Dating Life", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1710192600,
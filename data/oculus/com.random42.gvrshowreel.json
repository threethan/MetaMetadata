", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDUXviG78mUQ7kNvwEfkj5N&_nc_oc=Ado9BmJwAH3yTHqd-bPL32S3dfA7mzXBG2NbvaCkKyNuPAms_juyCSaJ8BZUWizeKP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh
KOWndse6DXN4t2sg7JB9kQ6E0_w95RWcWoMOaNCpTbTs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RmRJETqhOZiDIFD9OZeRB3j16RoU5qrwZ4taM-vf0ig&oe=6A43DF76"}, {"file_name": "migrated_image.png", "id": "631397817407447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162711_1849447448686262_6057722101635219456_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQCJdxr57IgQ7kNvwHc3o0u&_nc_oc=AdqDWspmmZdsV8_jxg9uJ6kgUpFY4UHwUuj7kX8F7xIYJH9Wf09U3OFEPsSYSQO_g8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xr7DdK4-T12EFmFR-ltFuLK0EpCETebYzRL_9-umYtQ&oe=6A43E4B5"}, {"file_name": "migrated_image.png", "id": "548100722492611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410355_136836237022095_1490307472223633408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC_ATEZcJXAQ7kNvwE9jQr1&_nc_oc=Adr9YHsqIieAJCv3s4avl5lW-p0EAYNwbvVCFN-VqR2c4HDspb-y_R_3asX9laUlFPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZP9beAzDD8pFr0da-uVM2kJE4GEdLG26V-YHZrzAbaA&oe=6A43C4A2"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v64Br4bxLQYQ7kNvwEp5lcP&_nc_oc=AdqZVH3085fzmOFlcq0kACOn2RBGrKfXZLwcBPom3hxu5OrksOXMuD1AkJQlbjnA33c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kC12-sK4RZ8FvC4D4WrdrZKO1EElhCo1elLwTYcd8IA&oe=6A43C2BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEd4mlvqQdcQ7kNvwEUhn5x&_nc_oc=Adpaxl6MJTIwnGZ0qsMqv5AIpdrbyGV-uaXxkzVXW-Q07Alyvpaxdfnu-lIwt-TO_YE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86RkgLtZc-HYsNdzLqjh1qLQbuDt05Jg8lgDUESC9NWg&oe=6A43C6E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevision": {"nodes": [{"i
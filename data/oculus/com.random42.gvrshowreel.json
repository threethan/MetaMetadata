-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC8z1KdtbdwQ7kNvwErcR9k&_nc_oc=Adkh5fSv32Bue92mgv-2UgAkJnbMHWUzlP6wTK4yRWCOgy7KRRBKSYCBdLqNeM4h4LQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft0GDRXgen4JtyQb0ymqTDtykFYSZFk_1Kipq-jWhHdbg&oe=699EFB63"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevision": {"nodes": [{"id": "670799589762652", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1092021544167
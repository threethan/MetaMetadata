_S_yMMjgr00MSCDWlW3U8mwB6SJzqmdEXaZfA8JJWRCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_ZMjT-6VitbJuqYIFuCGYWw0K-26nNuDZM00m8bBjuA&oe=6A638376"}, {"file_name": "migrated_image.png", "id": "631397817407447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162711_1849447448686262_6057722101635219456_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ibhc4uQeF7wQ7kNvwG_Jeww&_nc_oc=Adr79i-ga9XxCfdXXquwaszlvLYVDKwwbSibqNAuDMZQXiFCS4iWBbSFVxETPldX4sM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMuRDLSBE_CfFi5U5igMxmTY3d59_IpfuITlrUM-LWDA&oe=6A635075"}, {"file_name": "migrated_image.png", "id": "548100722492611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410355_136836237022095_1490307472223633408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd17-DaapMIQ7kNvwE3WN2d&_nc_oc=AdokXKF-lngJbGlIi8T4x3u7VGV1PJwodxGBdwy8yu89QI4kMmuoJLMO9elfwPdJlV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkVclfBQWODDwXsAdFNRjkEQHk3yewgE0QW_pCehFOGA&oe=6A6368A2"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSP9sezNHb8Q7kNvwFZAH4Q&_nc_oc=Adrkt0DT_be2eZ3zYzg_J9_lcFnaiakAisJKww2-RMYAMLYO0xtkvi6ycAIGXQgD5Zo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw4pHfvXE8VJsKlO1INPrhKevyfK0vIrYAnGyUUooXLQ&oe=6A6366BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bfi_mccmapgQ7kNvwFYHVxM&_nc_oc=Adqvt5oHLzKk01dLzhEEE82WI0ygfR2GENlt_tUyBzE_hmU3p1IzTdl4huOsz9av9CQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH4kfBNo8E3xVtJrLDmdupCg3VQnurvN2YEC3_OxlcDg&oe=6A636AE3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevision": {"nodes": [{"i
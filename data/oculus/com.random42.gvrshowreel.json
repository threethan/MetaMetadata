L7gKK2hu6vFFJOuzGkqSgKMeWWg6JQEWQ3oTUuw&oe=69F0D0F6"}, {"file_name": "migrated_image.png", "id": "631397817407447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162711_1849447448686262_6057722101635219456_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyrBctOkQaQQ7kNvwHd8jTb&_nc_oc=AdoUCPe3O07ifFDrXsybE5iBXWBND630pPIMRkKRTCkbdJH4KvgM-JxSe3pek3l5_r8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1tBdFwpjvSbQ4bc17kiuPQemifjPNRTj_6cKX1jEFE9w&oe=69F09DF5"}, {"file_name": "migrated_image.png", "id": "548100722492611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410355_136836237022095_1490307472223633408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRoBq9_cW3UQ7kNvwHHU_E-&_nc_oc=AdoePD0_USI50cUKx7cZmaw--WAXmZ8siTCpZFN2_yyf5LA2mJe1-eCO9z-14IECxJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2CKI77BhWX3K3C1k1NkmdtL1gPCNBTXtzMdpXriKJwQQ&oe=69F0B622"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5HRVbPboa0Q7kNvwHDLUFs&_nc_oc=AdqoeiNd_lMdjyOd1O1b8TGU-xAp8ReUs8R9DoKh401bcmFns2JMQ29q3eJerlRz1J8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1riD8jnO9ONbIzIo7QvXe0zuD-6AhJoG5ybIG6AGmwww&oe=69F0B43D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-4wa3prTkYQ7kNvwGQ_IhP&_nc_oc=Adr20PP8qK-pVR2vmmUtIyp9esCGLy-2jXTCu_Wx8ihYT8yddVKcpQm2o-qAhc5G_0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0NrGc93LrCzbUjzCUYKo2wGYujha8tVrJUzY7t2w17-g&oe=69F0B863"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevision": {"nodes": [{"id": "670799589762652", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1092021544167
BggBxoSrwbkHySVGSPg_e5WQdF2e1mOHM0ZNhRA&oe=699995B6"}, {"file_name": "migrated_image.png", "id": "631397817407447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162711_1849447448686262_6057722101635219456_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHqksDhsNfwQ7kNvwEcLu84&_nc_oc=Admw1q03ne3fNADNzWRaiVP-qGxjJgfOCTg4SQVQbOV-rxSrfo3u6yRifXEqhxTySRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunBf2cZL_Jq393ycZ_boZs0o4x-pRmgQ_BYAmTlvbg3Q&oe=69999AF5"}, {"file_name": "migrated_image.png", "id": "548100722492611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410355_136836237022095_1490307472223633408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4pJ21EcmHAQ7kNvwHyI2_t&_nc_oc=AdnGm8NQNOIhFvg7_HiEaEbZsJKsptvS4BVCbIFgUGY65T1gxlgR_A3p8r3ds1ovgL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftu9fJJaleT6P0H5gw1n7-98N7mqZvd1pnk5bIbwpNI3g&oe=6999B322"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ-sd0leci8Q7kNvwEjbx22&_nc_oc=Adm_klB6_vkoBuW1ZiIHXtvxAYhrFRimhtYqn3dWmXfz3fiWrCQpnuEpxHdtLvmHX1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvOIy57gL9WiUkmgiY4_LczWW4pFFX6RVv5uLuwCvA4eA&oe=6999B13D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylYx0BK4LjQQ7kNvwEFIOIZ&_nc_oc=Adn6GnMsPKmfXeLQ4ajnaD8KDyAO62mznKGF8VzVGBSbzN0QXEj2HHzOetvlWm5IrX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMvFpY1tvBxdv32B2Vr_IZXJP_HCEIk_E-WMjb1poaMQ&oe=6999B563"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevision": {"nodes": [{"id": "670799589762652", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1092021544167
ca9TEkvRqebovocqQuqxtZ6bhYLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkCAxxNeO6z1PiOxmF6BtaBHynmgyF1pcvn76bhSMytw&oe=6AFDE062"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0j22KW7VCUQ7kNvwEm2ySc&_nc_oc=AdqLgB5CnomJ5t9HvX3lvx-qo6CZdtlpURhZzTwVHXYwGBmcMfztn87u9DALJz1D1rM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrHX5G1Oxjykm0OaV4KsNPaX1-fxXREvgNHP5NuHEVIQ&oe=6AFDDE7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "g
5dPkLoihEPacp8ZxeXlpnZi_YZO2QWC6JRNdZNAfI9MY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02N5TNcVsZy1gbEk8Dq4mtfqillZ_vMqeUIQaDUYf37A&oe=69EB8AF6"}, {"file_name": "migrated_image.png", "id": "631397817407447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162711_1849447448686262_6057722101635219456_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3JHJmvaYgwQ7kNvwG0TPJX&_nc_oc=Adpw8RnTDvhhORd-4uRNkDniUUmMQ5dmewjbTpMyAXhYY_WWuHnc01ZEc0qLPnnT7no&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qMdAWFXxTLjj8tohy5q2nfQczv6aaDW3e2SOKu73AcQ&oe=69EB57F5"}, {"file_name": "migrated_image.png", "id": "548100722492611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410355_136836237022095_1490307472223633408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-TVlsiwtAkQ7kNvwHWBV7a&_nc_oc=AdqmU6HS2pjdGU2e3TihsGYTG_-TA37VuxRFUdRZmgHaOq3RrE8uDAxF8jDMGW5DJ54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21YHIaR4Kp2FXEUfuwfsXbQdfOiCxGHhpiSs0NoX2NAQ&oe=69EB7022"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyREHS1mTkUQ7kNvwESIG1B&_nc_oc=AdqWkfaE3It28ZWM_jPX_nPn-PpFtTH1ZB0MHOfoFWp6UJZsP3rC15ONJHlBwT34U1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TTYv84uZwHA24ZhGWJx77TB3riKjXJWgBrywyf9_VTw&oe=69EB6E3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MorZSBS8DwsQ7kNvwEOSypE&_nc_oc=AdreBR0Bt-cl9UG8gASJ-_1v2aKywmufLq26za5MR8vRfpTaTNmFvljn4b3S28pwQlw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g0KPVX8BsTJ5S-8S74AHDXdu-RmH6mc8nJxdgF2uoCQ&oe=69EB7263"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevision": {"nodes": [{"i
_37f719hMRsmwJRUA269OYmdYtptHSIgnHpSjv6rzf4I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eKo2_0KVQgIK6qiCFDQ2OS5-jPXTJc6rtbxpNO6hSyg&oe=69DF7536"}, {"file_name": "migrated_image.png", "id": "631397817407447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162711_1849447448686262_6057722101635219456_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeiBJDDuzsoQ7kNvwH14jdd&_nc_oc=Adq6dbZBy029B2H3bD2w3V7H1wYzO_GOKtPAC5O2ydNpiZr1ZX67Ay-WSP2v81beEjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21HwP18v3lyUgjMn7YpPQJbmMsOV7sP7pTUnted_cgRA&oe=69DF7A75"}, {"file_name": "migrated_image.png", "id": "548100722492611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410355_136836237022095_1490307472223633408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyu18E6jX4kQ7kNvwG6px5D&_nc_oc=AdrYrO8MnQ8CBYZYWokHGz0p3B73E8mSZbhC4jNECx0LSiWgXg4HIQ22KdBbZlG_d_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pu9bWQ_WSVZ0xIvhet64Nv1sCNkKXseFFQChECCUfbg&oe=69DF92A2"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJME5dippbwQ7kNvwFY-hru&_nc_oc=AdpB_O1yYG3-l78TSEGWAcTmkuBeJyRLQHWhgRzuXAMGHxqtPKvpou7Dvi-LrFDxaRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZtjSdhzT2mNGfgcP4jupfIkZqFlxsvaDXC2V8Zupq6Q&oe=69DF90BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBHc3z0Vf54Q7kNvwEuDxFB&_nc_oc=Adr_UKNS-eaCCyzg0lLdBcry_9QzjHx-OaRmz4hvcM8ssZd4XDQ607yo8jfel6okD4Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nwMoVCeszfuniKe0V1NB37Sj-mCYStiiJl0LGizBhSA&oe=69DF94E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevision": {"nodes": [{"i
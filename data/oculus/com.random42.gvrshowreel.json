JQ_2RYAjQmhviAcmBxLVwzCw5ljjb3K-qCwsMh13pmSHy5mJj70CN94PQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFodP8AHt9LoATHFudzJCOXIIT9vNtP73_sx_vnIC9-5w&oe=6A8D7B36"}, {"file_name": "migrated_image.png", "id": "631397817407447", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162711_1849447448686262_6057722101635219456_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C55KT2bT4MQ7kNvwGbcLAG&_nc_oc=AdqNYW0bMPzFOEuJTZl9l_3Fcwij1wcEbz64RyRtl0F9eJ-U9yWNjETno9DEsWD5Opo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrNkH_flr8KE5WKWHSIzNpM05P189uveNLhqDJv9s0sg&oe=6A8D8075"}, {"file_name": "migrated_image.png", "id": "548100722492611", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410355_136836237022095_1490307472223633408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmDeHi-J2JcQ7kNvwEWlw01&_nc_oc=AdoKNdUsIKTV735pP4xNDBoE0NTHn8n7PorOR0A88UGFyKypBTNv5HDQ7aI89HQ8C9E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQQWZQXf02ptf--Cx9LgBWyyJyLI5VrVWAoV3DVWselg&oe=6A8D98A2"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owXTTxJpLy8Q7kNvwGJL07X&_nc_oc=AdrSIU4I7aI9FiSqfjOcbzPJO55RaNIm-n1Rm6NTD60dmW0rHwKyygYUQRFFjan17S8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWZPxFjGEDdga17MSF3NznuCCAvg1ZZpXElHnRImfnaQ&oe=6A8D96BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG9eXH_PatsQ7kNvwEv-MPM&_nc_oc=AdpXRdxJKa4yI4bSNo0UucN9yJwoW4qMrLgM-r4cowE_fwP1Csi0f9qO7jN5LLt5pAE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbdRDk23zox-8PSAbUET8ZwRtu-RE-IgILkbxCMEJSkA&oe=6A8D9AE3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevis
DtKKwfelOHXG67g3Qbi6nc3EXd0AnOac-LJjqFDo7E9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC1b3baJ-kxIovJB4a7N4PjuNX39GB1J8Cr-f7HG-Zrg&oe=6AC11DF6"}, {"file_name": "migrated_image.png", "id": "631397817407447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162711_1849447448686262_6057722101635219456_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLAQS7B4_OwQ7kNvwFO98A5&_nc_oc=AdosLjMUjHx8UPTZCfhHwFpcdIyT63qa9R-J1VK6anqGNXfv1UAyONyC9wefNpduKdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuEgALr1d4r8gk9wduIsLdxOgaL99oSGEAQ2NB8fCZ-g&oe=6AC12335"}, {"file_name": "migrated_image.png", "id": "548100722492611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410355_136836237022095_1490307472223633408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMg1-sST0yAQ7kNvwEaXEtd&_nc_oc=AdpxjcsjkGcSW-zKUCEkDL2gM9Emen5BkQiQu3aKfK3wNbV5wDke9LRHfVGSCevI60k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQphO8GRWJdi-pczitw-sDErzip4LSVtFdZGFdmxjxpg&oe=6AC10322"}, {"file_name": "migrated_image.png", "id": "510531519639390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139457_1842127496078166_2009052114700992512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V5kFH5Y4dcQ7kNvwFKAmYI&_nc_oc=AdrTBSDHyNMzDZLFyskmi5HTaYZk61QNYvojPbx7QQ1fFIYUp8bGvqzcO5kfCDy3lfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU6M127Yxxx607ti_uo6szG-wOl4NYMy4zVCx78vM-Dw&oe=6AC1013D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "keywords": ["science", "medical", "pharmaceutical", "biotech", "animation"], "long_description": "The use of Virtual Reality headsets have elevated our storytelling to a new level. We are now able to take people into our 3D film sets and take them on a ride inside the human body. Users feel like they are actually in the scene of one of our mechanism of action medical animation, watching red blood cells float alongside them or following a signalling pathway into the nucleus. Our storytelling format, combined with this state-of-the-art technology, gives the user a detailed understanding of biological processes. Random42 provides the highest quality VR experience in the industry.", "short_description": "Take a visually stunning and scientifically accurate 3D ride inside the human body in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://random42.com/", "developer_terms_of_service_url": "http://random42.com/", "publisher_name": "Random42 Scientific Communication", "support_website_url": null, "website_url": "http://random42.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201621255479525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410473_1773875692880094_1414457850_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROL-i3gV8_4Q7kNvwFj5_IM&_nc_oc=AdpNTKMHW7ZE3UO8HpZmMiFOa9RLi9STlwrZ9PS_XFNP4VHw3KOQB-GqpNY_WrNDQG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5UrQOUY3SakEpKoDwn8Gn5I_LkzQHwSX36YcO0xsbsA&oe=6AC10563"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Random42 - A Scientific Journey Inside the Human Body", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513879200, "lastRevision": {"nodes": [{"i
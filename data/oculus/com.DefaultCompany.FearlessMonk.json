 "Backrooms"], "long_description": "Fearless Monk Is A Gorilla Tag Horror Fan Game With Some Chiller Elements, Play Around In The Main Levels Or Go Hangout With Friends And Fellow Monkers In Lobby, Shop Or Gamemodes! Explore Dark Challenging Maps Packed With Heart Pounding Scares, Evade Terrifying Monsters, And Master Your Agile Movement Mechanics To Survive Each Level. When You Need A Break From The Terror, Head Back To The Central Hub To Show Off Your Cool New Custom Cosmetics From The Shop, Chat With The Awesome Community, Or Jump Into Unique Action Packed Gamemodes!!\n", "short_description": "Welcome To Fearless Monk! A Gorilla Tag Horror Fan Game That Is (Mostly) Community Based!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fearlessmonk/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/fearlessmonk/privacy-policy?authuser=0", "publisher_name": "FerrariVRYT Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/fearlessmonk/download?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1160116937194548"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2074807209843749"}]}, "baseline_offer": {"id": "2074807209843749"}, "is_app
02203071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLtiBot0Vo0Q7kNvwEo6WZs&_nc_oc=AdqIJfan5chh0ZANCFH1NtWHsZKBKTrtdFoPEhIBhXRo_L-m5EZ4oS9P1w7hmeRd0Yk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8J1m0Rmfd6PZLeOAoa2vSS3tILZfC8LRIBlmVsog6pQ&oe=6AF5E415"}, {"file_name": "screenshot_4_2560x1440.png", "id": "3532802403548703", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628446_3532802406882036_737277960398516493_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i26Iqf4_MPgQ7kNvwHgbgOf&_nc_oc=Ado7JuDSxI1MWkENR6OIGv75XU4OyuTFFhcDNQ_7qSLRKGOLO3LLCwxDtdZovUekU1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC-B3Xb85_YRz_DvuAwcm-58FuaZbZzZkW9KsvrFmtag&oe=6AF5E017"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1556445395689864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627379_1556445399023197_3356368241364370181_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghxPOpSj_egQ7kNvwG4jOqH&_nc_oc=AdoRRNCls8Lc0q5R5RJNshHI6Og1LdRrjunZYuluTBuXVqgrbjbLpa98TGcdiXxydkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdyGa85GA4rAm8zHvWihWEymhuXK4WAFigPoRtRpTjoA&oe=6AF5C5DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "3330565847141530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593869844_3330565850474863_3670443383659329633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RxSVzp2vDMQ7kNvwF2U1BI&_nc_oc=AdqHviEtZF0MZJbe5_Mnrvld2ivB8SPVOOupBPRT3itmIRvAe8PMCj_f84ieOIGGzlo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKBLk0tLtClf1zXqHuxzUJicP4L8HgaM9JQ4cXBfAY5A&oe=6AF5C7A8"}, "display_name": "Graffiti 2", "keywords": ["graffiti", "spray", "painting", "art", "sandbox"], "long_description": "Graffiti 2 is a spray painting sandbox in virtual reality. Pick a place, grab a can and cover the walls with your own art.\n\nFIVE PLACES TO PAINT\n- Brooklyn Street: brick warehouse walls and steel shop shutters, by day or by night with the street lights on.\n- Rooftop at Sunset: a billboard, a stair house and a machine room high above a glowing city.\n- Subway Yard: paint the whole side of a parked train, then press NEXT TRAIN to send it off and bring in a clean one.\n- The Moon: a rock cliff and a gold lunar lander with Earth in the sky and low gravity.\n- Night Stadium: the padded outfield wall under the floodlights.\n\nREAL SPRAY PAINT FEEL\nThe spray gets wider the further you stand from the wall. Paint soaks into brick and mortar lines, and holding the can still makes the paint drip. Shake the can to hear it rattle.\n\nSTENCILS A TO Z\nA board of 26 letter stencils plus stars, crowns, bolts, hearts, arrows and NYC. Stick one flat on any wall, spray over it and peel it off.\n\nYOUR TOOLS\n- 8 spray cans and a full colour wheel\n- Skinny, medium and fat caps\n- Take a photo of your wall, saved on your headset\n- Clean one wall or every wall with a fresh coat\n- Six music tracks\n\nGraffiti 2 is a single-player, standing experience with smooth walking and snap turning. No account and no internet needed.", "short_description": "Spray paint your own graffiti in VR across five places: a Brooklyn street, a rooftop at sunset, a subway yard, the Moon and a night stadium. Grab a can, pick any colour, swap caps, tape up letter and shape stencils, and watch the paint drip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-graffiti-2.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiview-graffiti-2.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
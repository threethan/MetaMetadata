5771-25/499620860_1570657794793645_3991531559748779479_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5UY1xxIJOoQ7kNvwE0SdfS&_nc_oc=AdobzU5EW4hk87W50AXzXJE3rgBWCk7D_Zr4MvKlQ1saQom166bdR6x8p5t7AyyIabM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmq_BF2MsPxyW1sTLaz6rALDsADpKv-dfRzDCnj5MskQ&oe=6AEB5C07"}, {"file_name": "03-photo2vr-3d-filter-2560x1440.png", "id": "4519304111649785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595143057_4519304118316451_4175326969046694903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5pqD4XJS8UQ7kNvwEawT5e&_nc_oc=AdrpnMqUeG85A-U5DhU43HRU5FDxhzdDp_d-gAhTp6BSXxD6axUxNRek0jJfN6he0u8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpaTf6THQ-WUoFj0_dYqiRuL_3Opc0F5TfJEiJVqoV-A&oe=6AEB4ADF"}, {"file_name": "01-photo2vr-source-folder-2560x1440.png", "id": "1736699104243928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620965_1736699107577261_673830695000831091_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSWhbuShhogQ7kNvwHEV0r5&_nc_oc=AdqUFAbK7nt_vPRRAgzshFHAbotYWASUN0wFMBGhO2tZiQ7gNB581CFslb9F3xlmWS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQliNONKiD60wVW5ttEL5_y6yChcIXGoTyHFyonipL0rA&oe=6AEB3530"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Photo2VR", "keywords": ["photo", "3D", "converter", "viewer", "SBS"], "long_description": "Turn ordinary photos into 3D images for viewing in VR on Meta Quest.\n\nPhoto2VR converts your 2D photos into Side-by-Side (SBS) 3D images and saves the results to your Quest photo library. Select one photo or convert several at once, with progress shown for every image.\n\nThe built-in photo viewer is free to use and does not require conversion credits. View your own 2D photos and SBS 3D images, or try the six included 3D demo photos immediately.\n\nBrowse images by folder, move through them as a playlist, and adjust viewing distance, image size, height, 2D/3D mode, and eye alignment. Choose the studio environment or switch to a black background that keeps attention on your photo.\n\nFeatures\n\n- High-resolution 2D-to-3D SBS photo conversion.\n- Large, adjustable immersive display for 2D and 3D photos.\n- Free viewer\u2014no credits required for viewing.\n- Six included 3D demo images.\n- Batch conversion with per-photo progress.\n- Results saved directly to your Quest photo library.\n- Folder browsing and playlist navigation.\n- Adjustable distance, size, height, 2D/3D mode, and eye alignment.\n- Only photos you explicitly select for conversion are uploaded.", "short_description": "Browse photos on your Quest, convert selected images into high-resolution 3D Side-by-Side (SBS), save the results, and enjoy 2D or 3D photos on a large, adjustable immersive screen. The viewer is free to use and includes six real Photo2VR conversions to try immediately."}]}, "developer_name": null, "developer_privacy_policy_url": "https://photo2vr.app/meta-horizon-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Photo2VR", "support_website_url": null, "website_url": "https://photo2vr.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1247345658462351"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1454225236532095"}]}, "baseline_offer": {"id": "1454225236532095"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787094000, "status": "PUBLISHED", "id": "1454225236532095"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1381404758389773", "version": "1.13"}, "id": "1554735576382386", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1247345655129018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381404758389773"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1554735576382386"}]}, "change_log": "\u2022 Improved clarity when viewing high-resolution 2D and 3D photos.\n\u2022 Preserves more detail in side-by-side 3D photos with per-eye image sizing.\n\u2022 Automatically adjusts viewing resolution to the headset's supported limits.\n\u2022 Improved memory handling when switching between large photos.", "created_date": 1792178551, "id": "1381404758389773", "version": "1.13", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1247345655129018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381404758389773"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1554735576382386"}]}, "change_log": "\u2022 Convert up to five photos in one batch.\n\u2022 Once uploads finish, close Photo2VR and return later to collect your results. Download results within 60 minutes of completion.\n\u2022 optional 2\u00d7 upscaling (Beta) for eligible photos, for one additional credit per photo.\n\u2022 Resume submitted batches after reopening the app.\n\u2022 Clearer upload guidance and a dismissible upload-complete reminder.\n\u2022 Improved recovery when cloud processing is interrupted.", "created_date": 1792089878, "id": "1379562448574004", "version": "1.12", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1247345655129018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381404758389773"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1554735576382386"}]}, "change_log": null, "created_date": 1787869363, "id": "1287674217762828", "version": "1.11", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1247345655129018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381404758389773"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1554735576382386"}]}, "change_log": "Opens in View Photos with the 3D filter selected and six demo conversions ready to explore.\r\nFixed Restore hidden viewer controls with a hand pinch.\r\nView source dimensions and clear 3000 px best-results guidance.\r\nCleaner conversion layout with filenames o
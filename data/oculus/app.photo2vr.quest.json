kFPJ1d8kj12g&oe=6AEB3F28"}]}, "id": "1473732521283397", "locale": "en_US", "screenshots": [{"file_name": "05-photo2vr-immersive-viewer-2560x1440.png", "id": "1438526228111452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619078_1438526231444785_5899858710893602191_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93gYRQtkYOMQ7kNvwG5eZ0H&_nc_oc=AdrtCxg1wElLBIFBT0d_uG6ZkRmdb6mYbYnVQ2GPrtvhWjTbIp3Zz83TooWVabaT5Cw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRH_nMoSyvrx2bHeZvptsAa7MiCCHuRB0kO7nxV75DTQ&oe=6AEB5735"}, {"file_name": "02-photo2vr-conversion-progress-2560x1440.png", "id": "1049399217833900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623384_1049399221167233_6119319571089487191_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQemARQ_bjMQ7kNvwFcGDtK&_nc_oc=AdoRQVcMZdP8JXUe3az_s0DvUtUUK4ZPlhALHTdzFSquMzLsWP8kpP-gloApVJHjU0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGN3fmgi44A1mwpUakCoOFImeQ8HZI3YP8qcubN7G9zw&oe=6AEB4469"}, {"file_name": "04-photo2vr-sbs-library-2560x1440.png", "id": "1570657791460312", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_1570657794793645_3991531559748779479_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5UY1xxIJOoQ7kNvwE0SdfS&_nc_oc=AdobzU5EW4hk87W50AXzXJE3rgBWCk7D_Zr4MvKlQ1saQom166bdR6x8p5t7AyyIabM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmq_BF2MsPxyW1sTLaz6rALDsADpKv-dfRzDCnj5MskQ&oe=6AEB5C07"}, {"file_name": "03-photo2vr-3d-filter-2560x1440.png", "id": "4519304111649785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595143057_4519304118316451_4175326969046694903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5pqD4XJS8UQ7kNvwEawT5e&_nc_oc=AdrpnMqUeG85A-U5DhU43HRU5FDxhzdDp_d-gAhTp6BSXxD6axUxNRek0jJfN6he0u8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpaTf6THQ-WUoFj0_dYqiRuL_3Opc0F5TfJEiJVqoV-A&oe=6AEB4ADF"}, {"file_name": "01-photo2vr-source-folder-2560x1440.png", "id": "1736699104243928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620965_1736699107577261_673830695000831091_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSWhbuShhogQ7kNvwHEV0r5&_nc_oc=AdqUFAbK7nt_vPRRAgzshFHAbotYWASUN0wFMBGhO2tZiQ7gNB581CFslb9F3xlmWS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQliNONKiD60wVW5ttEL5_y6yChcIXGoTyHFyonipL0rA&oe=6AEB3530"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Photo2VR", "keywords": ["photo", "3D", "converter", "viewer", "SBS"], "long_description": "See your photos in depth\u2014and enjoy them on a large, high-quality screen in VR.\n\nPhoto2VR turns ordinary photos into **Side-by-Side (SBS) 3D images** and includes a **free immersive viewer** for your 2D and 3D collection.\n\n**High-quality photo viewing**\n\nEnjoy sharper images with higher-resolution rendering that preserves more detail in each eye and adapts to your headset. Portrait and landscape photos retain their natural proportions. Try **six included 3D demos**\u2014no credits required.\n\n**Turn your photos into 3D**\n\nConvert **up to five photos per batch**, with progress for each image. Eligible smaller photos can use optional **2\u00d7 upscaling (Beta)** before conversion.\n\nOnce uploads finish, you can close the app while processing continues. Download each result **within 60 minutes after processing completes**, and save it to your Quest photo library.\n\nConversion uses credits purchased through in-app add-ons. Upscaling costs one additional credit per photo. **Viewing is free.**\n\n**Make the view your own**\n\n- Adjust image size, distance, and height.\n- Switch between 2D and SBS 3D.\n- Fine-tune eye alignment.\n- Browse folders and navigate photo playlists.\n- Choose a studio environment or black background.\n- Use Touch controllers or hand-ray controls.\n\nBrowsing and viewing local photos stays on your headset. **Only photos you submit for conversion are uploaded.**", "short_description": "Turn your photos into immersive 3D, or enjoy your 2D and SBS collection in a free, high-quality viewer. View photos on a large, adjustable screen, try six included 3D demos, and convert your own photos with optional upscaling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://photo2vr.app/meta-horizon-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Photo2VR", "support_website_url": null, "website_url": "https://photo2vr.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1390098084187107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_1042651648637310_1697953149019228740_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q-_oFN1VxwQ7kNvwEB2Pmq&_nc_oc=AdqmOfzl6dTvynZ3qZVmJ1DuQ_LmfvzWy2FO8zdMRaXdDkpPgLeJ7Fj3Sr_eI1435J8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM4WgGagqrgnywQkikpC-BBnM0XBl4DpHEnegb9HdghA&oe=6AEB4D48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Photo2VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1787094000, "lastRevision": {"nodes": [{"id": "1247345668462350
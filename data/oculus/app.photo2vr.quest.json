dn.com/v/t64.5771-25/595143057_4519304118316451_4175326969046694903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J98eTdEBGuQQ7kNvwFChsfI&_nc_oc=AdovzJfoiCdXW_h-_tUQok7YHQoNTQUpwEfNRrp1Syy6LdRrAeuOcVM-iqme6Wlegoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvFDjsuD07uPekL4F0H0vcOF7HpZltqauxz9_R9Q9OAQ&oe=6ADE1BDF"}, {"file_name": "01-photo2vr-source-folder-2560x1440.png", "id": "1736699104243928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620965_1736699107577261_673830695000831091_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MmNUwNrCJsQ7kNvwEnnbBR&_nc_oc=AdqGPJeB-p2um7tjAZ2r8vxZTmejcgMhQUcCQsKYLivaI4aJycBKsHAr7bJJTNqSsi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXmQxrnCAvLRgYoriUk3SW0zKHEkYJtIYVI_F9ONnA8Q&oe=6ADE0630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Photo2VR", "keywords": ["photo", "3D", "converter", "viewer", "SBS"], "long_description": "Turn ordinary photos into 3D images for viewing in VR on Meta Quest.\n\nPhoto2VR converts your 2D photos into Side-by-Side (SBS) 3D images and saves the results to your Quest photo library. Select one photo or convert several at once, with progress shown for every image.\n\nThe built-in photo viewer is free to use and does not require conversion credits. View your own 2D photos and SBS 3D images, or try the six included 3D demo photos immediately.\n\nBrowse images by folder, move through them as a playlist, and adjust viewing distance, image size, height, 2D/3D mode, and eye alignment. Choose the studio environment or switch to a black background that keeps attention on your photo.\n\nFeatures\n\n- High-resolution 2D-to-3D SBS photo conversion.\n- Large, adjustable immersive display for 2D and 3D photos.\n- Free viewer\u2014no credits required for viewing.\n- Six included 3D demo images.\n- Batch conversion with per-photo progress.\n- Results saved directly to your Quest photo library.\n- Folder browsing and playlist navigation.\n- Adjustable distance, size, height, 2D/3D mode, and eye alignment.\n- Only photos you explicitly select for conversion are uploaded.", "short_description": "Browse photos on your Quest, convert selected images into high-resolution 3D Side-by-Side (SBS), save the results, and enjoy 2D or 3D photos on a large, adjustable immersive screen. The viewer is free to use and includes six real Photo2VR conversions to try immediately."}]}, "developer_name": null, "developer_privacy_policy_url": "https://photo2vr.app/meta-horizon-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Photo2VR", "support_website_url": null, "website_url": "https://photo2vr.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1247345658462351"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622315_1042651648637310_1697953149019228740_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVC0YAFyWRYQ7kNvwExErbH&_nc_oc=AdqCSj_hx4qwx5KFk6n1Ry6eZ7sK_oqQXkIUPONy15HRL1TyRpwmBsR3pSrU2oNxTAU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS0jjTjKmkLbVnPGK3cizQhirf-E_9fJNsv4pCuK7cmw&oe=6ADE1E48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Photo2VR", "p
Wm8tYTo-wmwzV4M4HGQguqXIuDHqCQfi1BLYXLeYCsrSiieozSB2_kbOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJIhLIZ4tjYqenTHEVYrT16N8X_hNxGSy_ihvRCS34rw&oe=69BBE149"}, "display_name": "Nebula Nemesis", "keywords": ["arcade", "space", "simulator"], "long_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game.\n\nThis game is also customisable, you can import your own nemesis and fight against them in space. Add your own memes or photos and face them head on this time with a ship and laser cannons. What could go wrong.", "short_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FLYING", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
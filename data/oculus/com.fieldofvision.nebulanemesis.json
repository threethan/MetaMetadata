er": null, "video_trailer_thumbnail": {"file_name": "OVR_videCover_v2.png", "id": "313803367062570", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974685_313803370395903_4245587564169818580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZGqL1exdBwQ7kNvwH607K_&_nc_oc=Adojln7vCe6PaQv49GKi5Y1Emy9qrp2eNU_PdKUMDyJCs7FasjtUzrTXj0O6YviqR-w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Vf9Q5f16I11FMxgnuDyQb2ndMDoHTb-lRuw04EVgXQ&oe=6AE8AF89"}, "display_name": "Nebula Nemesis", "keywords": ["arcade", "space", "simulator"], "long_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game.\n\nThis game is also customisable, you can import your own nemesis and fight against them in space. Add your own memes or photos and face them head on this time with a ship and laser cannons. What could go wrong.", "short_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
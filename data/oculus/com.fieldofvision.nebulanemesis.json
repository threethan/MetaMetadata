lgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2Lunf0OLk4Q7kNvwFJxhMi&_nc_oc=AdoPgH2zv8RZl8ZTfbFHkVa_zCa-rO8YPPLZFWnzlqDUAQEO-UCiO4ab801TeOUq9EI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1bUAAuH1uEYwzjdbgneLARsWGKDLwqV880rYnfeXn_w&oe=6B0F006D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OVR_videCover_v2.png", "id": "313803367062570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974685_313803370395903_4245587564169818580_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6xM0B2TRJ4Q7kNvwHJ4uJA&_nc_oc=AdrZ0ZXRYvmBaLAHkh1DWi4NuJRLAOMn3b3uVIu_O2IuS-XEBF-8y9XWAQwjJZ0X-3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZVtv0k5bvcP8yYyEw883IhhVphj3ls4F_GYcXZ9NZlg&oe=6B0F2349"}, "display_name": "Nebula Nemesis", "keywords": ["arcade", "space", "simulator"], "long_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game.\n\nThis game is also customisable, you can import your own nemesis and fight against them in space. Add your own memes or photos and face them head on this time with a ship and laser cannons. What could go wrong.", "short_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game."}]}, "developer_name": null, "developer_privacy_policy_url": "h
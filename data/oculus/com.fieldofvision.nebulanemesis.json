lgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnlVqHLU5toQ7kNvwHePp2f&_nc_oc=AdojUpaRTO8lF7OWdLYSQwQteu-xErnBvMaifE2dpCSLwToByB2i5G0Jc83le2O8H4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGmw946EGUiYsMl4LfFVNw2P-NQwKGGh09wRji0Qk6rQ&oe=6B09BA6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OVR_videCover_v2.png", "id": "313803367062570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974685_313803370395903_4245587564169818580_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG7CYBfaaAcQ7kNvwHfSu8t&_nc_oc=AdoNVc6ByPcJfg6FOzgB6MhLmhogPRdusRAt2RnNMzFcJ-dTuEgw-656P-z881DoRfc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYUh22GM12R6WF7sBtqyTAwk49qwmF7aSl3FaTOQv7Mw&oe=6B09A509"}, "display_name": "Nebula Nemesis", "keywords": ["arcade", "space", "simulator"], "long_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game.\n\nThis game is also customisable, you can import your own nemesis and fight against them in space. Add your own memes or photos and face them head on this time with a ship and laser cannons. What could go wrong.", "short_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game."}]}, "developer_name": null, "developer_privacy_policy_url": "h
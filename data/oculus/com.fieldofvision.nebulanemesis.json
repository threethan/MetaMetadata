nt-iad3-1.oculuscdn.com&oh=00_AfsNwPEyP_JDTzojSpr78L5HxTi2WeAjVSOlicIOXittNg&oe=69A0472D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OVR_videCover_v2.png", "id": "313803367062570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974685_313803370395903_4245587564169818580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0AZ6UioMykQ7kNvwHEpU19&_nc_oc=AdlW4VIiZwqfF2NcMn4qRt0NEPZh5dIxyvblOFC_zJPvcPnPmX89PDfqD3hKsKVyAgY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5bQoemC9U0O5JLaUOA8vl8QtiwoVFMpqRy-JAxmWZnQ&oe=69A031C9"}, "display_name": "Nebula Nemesis", "keywords": [], "long_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game.\n\nThis game is also customisable, you can import your own nemesis and fight against them in space. Add your own memes or photos and face them head on this time with a ship and laser cannons. What could go wrong.", "short_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/NebulaNemesis-PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/NebulaNemesis.html", "category": "GAMES", "co
pky0MwBurFSV57uxUd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIxTkVvpmLm0OlxhWJdM5fn-cVFYYeSE3aG9p9jwMmgQ&oe=6B0322ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OVR_videCover_v2.png", "id": "313803367062570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974685_313803370395903_4245587564169818580_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-X2gIc4yGgQ7kNvwHy45Gt&_nc_oc=AdrWQ9ACPchdbk2VGHAJyJ1uhjkVpc_bZIyeZWmWSNr7-dCXDbSOtgk-fi3Ngxum7xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNCgbI6NrErBxIN1cQ-MVmk_tfSPjVZ3_-XKi92xeFVA&oe=6B030D89"}, "display_name": "Nebula Nemesis", "keywords": ["arcade", "space", "simulator"], "long_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game.\n\nThis game is also customisable, you can import your own nemesis and fight against them in space. Add your own memes or photos and face them head on this time with a ship and laser cannons. What could go wrong.", "short_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website
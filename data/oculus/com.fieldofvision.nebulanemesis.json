er": null, "video_trailer_thumbnail": {"file_name": "OVR_videCover_v2.png", "id": "313803367062570", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974685_313803370395903_4245587564169818580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiQ-wZimsnMQ7kNvwHqPPnx&_nc_oc=AdpuEIY9NUEe3OQF2OoBUs-i11m0TJppHaT242NMV3S4MoJ9d_-0niUHgaLY73Amlx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5FMrAJir4W_lYPkmcCBIDdLWSnG7jH0kEFO0NLzFKag&oe=6ABBDC89"}, "display_name": "Nebula Nemesis", "keywords": ["arcade", "space", "simulator"], "long_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game.\n\nThis game is also customisable, you can import your own nemesis and fight against them in space. Add your own memes or photos and face them head on this time with a ship and laser cannons. What could go wrong.", "short_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7L0iU5xffYQ7kNvwGomWxr&_nc_oc=AdpvgaZKdz1tk2L6ugqypzMlnP7kTFE1__KJUOTgMaHljDvBl3y5auOUTY8q5aN4Y1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt7nCUKhNAaEwQ0Iw-5GNApLK7E0IAyXbaAUywWgvvOg&oe=6AEB5289"}, "display_name": "Nebula Nemesis", "keywords": [], "long_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game.\n\nThis game is also customisable, you can import your own nemesis and fight against them in space. Add your own memes or photos and face them head on this time with a ship and laser cannons. What could go wrong.", "short_description": "When the universe is in danger, we send our greatest fighters. But they failed, so now all we have is you. So shuttle up and brace yourself for a laser shooting, space flying, alien blasting experience as you fight your way through the nebula. Unleash strategic powerups, encounter a variety of enemies, travel through infinite levels and get ready to get nostalgic in this 8-bit galactical video game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/NebulaNemesis-PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/NebulaNemesis.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "F
oQ7kNvwEejuLB&_nc_oc=AdpaA1tLNSHnCVczsZFyV9_rHl7Y7WMt9axl1aBhIz3XQURjsBteCj2B_HrL94MtHCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJdd2xbhBOHCk_jsgdp2m1iVoUib3nZjMfpzR5GGGlaQ&oe=6AFDB4A9"}, "display_name": "Happy Run", "keywords": ["HappyRun", "Zombie", "helloween", "happy", "run"], "long_description": "Halloween UPDATE! Run4Life!\nFeel the adrenaline rush as you sprint away from terrifying, fast-moving zombies!\n Every step counts.   \n   Every second matters. \n Each track is about 1 km long, designed to keep your heart racing and your motivation high. \n Lace up your shoes and dive into the thrill\u2014your life depends on it!\nHere is your chance for highly motivated, consistent, easy and happy RUN for everyday use. Simple and natural Jog-In-Place movement.\nExtremely easy to go!\nOpen world EXERCISES!\nNatural graphics with Epic Forest.\nZero MOTION SIKNESS.\nMultiple square miles of non-linear running.\nNo additional trackers required. Just basic Quest/Quest2.", "short_description": "Running rhythm game that help you stay in shape at any time. Consistent everyday training. Let's make right habits addictive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mocap4all.wordpress.com/privacy-notice/", "developer_terms_of_service_url": null, "publisher_name": "Motionman", "support_website_url": null, "website_url": "https://happyrun.webflow.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
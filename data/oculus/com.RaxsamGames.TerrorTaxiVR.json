7&_nc_sid=6e7a0a&_nc_ohc=uRWPWFil5fIQ7kNvwGyYd0E&_nc_oc=AdqW1SJYFbkU7xqL6PWQi0Zn2LHnqzL621KqtGxz_t9aLnjgLvoLhmvLjbCkI2z1s9U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrXUUWMvtadOd5BOjB8fpWszfb00deMsdlK7s8NzTJew&oe=6A4E5FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "2004861133471210", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620856_2004861136804543_1846142582016286006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mJU46KXkS0Q7kNvwFRNJmk&_nc_oc=Adr_zxoQJ9ksFDjp11r_LQFEGbux2c4tsfGFiQCWClJByBW56wC7mFK1N_S73x3t78M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeJNeBGE24ujTfYAOackSzb8FfgW_rY0eJrwgUzU9k-A&oe=6A4E3CAC"}, "display_name": "Terror Taxi VR", "keywords": ["Taxi", "Simulation", "TaxiDrive", "Zombie", "Car"], "long_description": "Terror Taxi VR, A taxi driving and shooting game you navigate a Zombie infested city, pick up  passengers, and deliver them safely to earn your pay. Defend your cab from zombie creatures using a heavy arsenal of weapons or your gun from glove box . You can Use your hard-earned cash to upgrade your ride. Spend your earnings on deadly roof-mounted turrets including flamethrowers, lasers, and rocket launchers and deck out your dashboard with custom bobbleheads.\n{1522039579661381}\n{1296626568789608}\n\n\ud83d\ude95 The Ultimate VR Taxi Survival: Find fares, collect cash, and navigate the dangerous streets of a monster-filled city.\n\n\ud83d\udd2b Arm Your Cab: Spend your earnings on deadly roof-mounted turrets\u2014including flamethrowers, lasers, and rocket launchers\u2014and deck out your dashboard with custom bobbleheads.\n\n\ud83e\uddfd Immersive VR Interactions:  Listen to your quirky passengers, manually operate your turret joystick, and you can interact physically with NPC passengers.\n\n\ud83d\udcb0 Manage Your Hustle: Every bullet costs money. Balance your ammo spending with your trip earnings to stay profitable and stay alive!\n{4452619345056261}\n{968989105913332}\n\n", "short_description": "A taxi driving and shooting VR game where you will play in an open world full of zombies and quests."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1174624175738732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828028_1680622519871484_5226032535477231358_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu0KNMskzoQQ7kNvwG_3hhg&_nc_oc=AdpKJ5Un11yy4cRhmakAvJAb0ifcUgQeSraupcvQARdd3iY4lp7xgTrIdvn0UiJaRgM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADCY_JUcSyVmuVXbDIWn3tD8syLFCWpTDM9k5K9sXFEw&oe=6A4E4C82"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Terror Taxi VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation",
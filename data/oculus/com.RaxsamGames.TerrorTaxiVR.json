ntent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBFG6zAvucIwkT96nhB5BybE7HCWwU5cn_YMqNw3FEgg&oe=6A4A6B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "2004861133471210", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620856_2004861136804543_1846142582016286006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BermAFForiQQ7kNvwFmGo4s&_nc_oc=Adrk8yvmX63aWF8xthSLR7TfaMtBQbY52xWGxq8RBzamO-CVO0C9Ct0wPY1az2VZ0rQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbb2hZEyNbweW96jY_ewg55eOl8s6W7yCuLUvX-ndvZg&oe=6A4A806C"}, "display_name": "Terror Taxi VR", "keywords": ["Taxi", "Simulation", "TaxiDrive", "Zombie", "Car"], "long_description": "Terror Taxi VR, An action-packed driving and shooting game where the meter is running, and so are the undead. Navigate a Zombie infested city, pick up eccentric passengers, and deliver them safely to earn your pay. Defend your cab from zombie creatures using a heavy arsenal of weapons or your gun from glove box . You can Use your hard-earned cash to upgrade your ride.\n\n{1296626568789608}\n\n\ud83d\ude95 The Ultimate VR Taxi Survival: Find fares, collect cash, and navigate the dangerous streets of a monster-filled city.\n\n\ud83d\udd2b Arm Your Cab: Spend your earnings on deadly roof-mounted turrets\u2014including flamethrowers, lasers, and rocket launchers\u2014and deck out your dashboard with custom bobbleheads.\n\n\ud83e\uddfd Immersive VR Interactions: Listen to your quirky passengers, manually operate your turret joystick, and physically scrub the monster blood off your windshield to keep your vision clear.\n\n\ud83d\udcb0 Manage Your Hustle: Every bullet costs money. Balance your ammo spending with your trip earnings to stay profitable and stay alive!\n{4452619345056261}\n{968989105913332}\n\n\n", "short_description": "A taxi driving and shooting VR game where you will play in an open world full of zombies and quests."}]}, "developer_name": null, "develo
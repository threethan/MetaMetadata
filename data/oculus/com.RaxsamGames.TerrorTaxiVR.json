ntent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGms_qQT5FO5UgdW8jszMrAzGFnJ52SzERXtys-p3UUA&oe=6A8191E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "2004861133471210", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620856_2004861136804543_1846142582016286006_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPP6r1yM7rEQ7kNvwHLEMQ6&_nc_oc=Adoo5DgArLQ6YCs6-tYVVE2CI1CgUkLELARY1OLxwGyE1Ez3IY_ZdTFjfh-W_wvmCKA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZf9ERANGJDATwWGRe0p2aqqQAW3iN1k57tkQ191wVow&oe=6A81A72C"}, "display_name": "Terror Taxi VR", "keywords": ["Taxi", "Simulation", "TaxiDrive", "Zombie", "Car"], "long_description": "Terror Taxi VR, An action-packed driving and shooting game where the meter is running, and so are the undead. Navigate a Zombie infested city, pick up eccentric passengers, and deliver them safely to earn your pay. Defend your cab from zombie creatures using a heavy arsenal of weapons or your gun from glove box . You can Use your hard-earned cash to upgrade your ride.\n\n{1296626568789608}\n\n\ud83d\ude95 The Ultimate VR Taxi Survival: Find fares, collect cash, and navigate the dangerous streets of a monster-filled city.\n\n\ud83d\udd2b Arm Your Cab: Spend your earnings on deadly roof-mounted turrets\u2014including flamethrowers, lasers, and rocket launchers\u2014and deck out your dashboard with custom bobbleheads.\n\n\ud83e\uddfd Immersive VR Interactions: Listen to your quirky passengers, manually operate your turret joystick, and physically scrub the monster blood off your windshield to keep your vision clear.\n\n\ud83d\udcb0 Manage Your Hustle: Every bullet costs money. Balance your ammo spending with your trip earnings to stay profitable and stay alive!\n{4452619345056261}\n{968989105913332}\n\n\n", "short_description": "A taxi driving and shooting VR game where you will play in an open world full of zombies and quests."}]}, "developer_name": null, "develo
Gw4AfgIQ7kNvwEMQqQN&_nc_oc=Adr99vqnCO-WY4Wx9ncQ-nueEwL3yeQexp4UAjTqkcFqtpVMuMlLpP1ivWO4X3OIa_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjlnZSOcniHyh0VB9afJ1VZ-WV7XfIqKXB7bWgYFcqGw&oe=6B0DADE7"}, {"file_name": "scrnsht_3.png", "id": "4519953588240197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620965_4519953591573530_8351580382402432369_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBS5AcTeFMYQ7kNvwF-BRD5&_nc_oc=AdqlOXnsSZ3cnUu1CWjIZeP0zp-tPve4jv_NndGlP8mFC6uKmwZrtCGXG8Hi1jTobVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToB4zMdE0gve9yRyfoj84DOG5kpFKz57m4527qMjEDhw&oe=6B0DC168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "2004861133471210", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620856_2004861136804543_1846142582016286006_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90IAgorofXMQ7kNvwH4kCEc&_nc_oc=Adpv7l0_yJ-gJwJC6RcskRtqXnZVRuZB_KDzfR86aIaAQ2Ix8H8RdzbfpMum7mYNcSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvBBL0O9oZPU_7AgTZekTlZVauIynbg4-IWP4d2CHRxg&oe=6B0D9E6C"}, "display_name": "Terror Taxi VR", "keywords": ["Taxi", "Simulation", "TaxiDrive", "Zombie", "Car"], "long_description": "Terror Taxi VR, A taxi driving and shooting game you navigate a Zombie infested city, pick up  passengers, and deliver them safely to earn your pay. Defend your cab from zombie creatures using a heavy arsenal of weapons or your gun from glove box . You can Use your hard-earned cash to upgrade your ride. Spend your earnings on deadly roof-mounted turrets including flamethrowers, lasers, and rocket launchers and deck out your dashboard with custom bobbleheads.\n{1522039579661381}\n{1296626568789608}\n\n\ud83d\ude95 The Ultimate VR Taxi Survival: Find fares, collect cash, and navigate the dangerous streets of a monster-filled city.\n\n\ud83d\udd2b Arm Your Cab: Spend your earnings on deadly roof-mounted turrets\u2014including flamethrowers, lasers, and rocket launchers\u2014and deck out your dashboard with custom bobbleheads.\n\n\ud83e\uddfd Immersive VR Interactions:  Listen to your quirky passengers, manually operate your turret joystick, and you can interact physically with NPC passengers.\n\n\ud83d\udcb0 Manage Your Hustle: Every bullet costs money. Balance your ammo spending with your trip earnings to stay profitable and stay alive!\n{4452619345056261}\n{968989105913332}\n\n", "short_description": "A taxi driving and shooting VR game where you will play in an open world full of zombies and quests."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1174624175738732"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828028_1680622519871484_5226032535477231358_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4SS2vVNe3cQ7kNvwFLA28O&_nc_oc=AdpbOYndXLGOHIRvuCqF1KDhtwOLGydS7IDnSy3FDHD9c2TjZP8mP9re_oXQ-g6KYlM
lI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm5e6tSeffWxD73DzSj4jFGW2zO3COxC1zOYRUY62Zwg&oe=6B09B45B"}, "display_name": "Cue Clash", "keywords": ["snooker", "pool"], "long_description": "Play Pool,  Nine Ball and Snooker. You can play solo or against a friend over a WIFI network. If your friend doesn't have a VR headset they can play against you using a mobile phone version of the game. As well as the regular rectangular table, there are a few others, including hexagonal and star shaped ones. You can also design your own tables with the built in editor.", "short_description": "Play pool, nine ball and snooker on a variety of tables against a friend or the computer."}, {"images": {"nodes": []}, "id": "777463761846924", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cue Clash", "keywords": ["billard", "snooker"], "long_description": "Jouez au billard, au 9 Ball et au snooker. Vous pouvez jouer seul ou contre un ami via Wi-Fi. Si votre ami n'a pas de casque de r\u00e9alit\u00e9 virtuelle, il peut jouer contre vous sur une version mobile du jeu. Outre la table rectangulaire classique, il existe d'autres tables, notamment hexagonales et en \u00e9toile. Vous pouvez \u00e9galement cr\u00e9er vos propres tables gr\u00e2ce \u00e0 l'\u00e9diteur int\u00e9gr\u00e9.", "short_description": "Jouez au billard, au snooker et au snooker sur une vari\u00e9t\u00e9 de tables contre un ami ou l'ordinateur."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mrsmallpool.wixsite.com/cue-clash/blank", "developer_terms_of_service_url": null, "publisher_name": "Small Screen Studios UK", "support_website_url": null, "website_url": "https://mrsmallpool.wixsite.com/cue-clash", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_
=00_AQIiGgYd36HjIPdcpo62V2Yg9JI-PpzrOKRV0GS1HTyCQQ&oe=6AA95C35"}, {"file_name": "ss_18_30_29.png", "id": "1110320714615486", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499293844_1110320717948819_1813326086519619913_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpIcwOrj_NIQ7kNvwFjqi4_&_nc_oc=AdoVBT4Et-YkVxRd9QPTiXvkcXKsuuocDP440zXe5gLmMCakVV5lmckU01CBmPEkmj0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7JrVoUID18W9IfZ_g0B2ZVtT8ynAeagjEhqz-_w9URA&oe=6AA934FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2229169547593255", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499293997_2229169550926588_6809479925237231687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQkTEFzQpQ4Q7kNvwFjcpnN&_nc_oc=AdpqhpIOITZelVJt-MaTCRMcyI42OJ8CoUR2o5vxk8DyA2U6ou1ffEuBJdgSxTp5JYs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICmVeWoR4l1m7t4_CTGUu-71RioPdtwS3k6lszdhIHKw&oe=6AA93E9B"}, "display_name": "Cue Clash", "keywords": ["snooker", "pool"], "long_description": "Play Pool,  Nine Ball and Snooker. You can play solo or against a friend over a WIFI network. If your friend doesn't have a VR headset they can play against you using a mobile phone version of the game. As well as the regular rectangular table, there are a few others, including hexagonal and star shaped ones. You can also design your own tables with the built in editor.", "short_description": "Play pool, nine ball and snooker on a variety of tables against a friend or the computer."}, {"images": {"nodes": []}, "id": "777463761846924", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cue Clash", "keywords": ["billard", "snooker"], "long_description": "Jouez au billard, au 9 Ball et au snooker. Vous pouvez jouer seul ou contre un ami via Wi-Fi. Si votre ami n'a pas de casque de r\u00e9alit\u00e9 virtuelle, il peut jouer contre vous sur une version mobile du jeu. Outre la table rectangulaire classique, il existe d'autres tables, notamment hexagonales et en \u00e9toile. Vous pouvez \u00e9galement cr\u00e9er vos propres tables gr\u00e2ce \u00e0 l'\u00e9diteur int\u00e9gr\u00e9.", "short_description": "Jouez au billard, au snooker et au snooker sur une vari\u00e9t\u00e9 de tables contre un ami ou l'ordinateur."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mrsmallpool.wixsite.com/cue-clash/blank", "developer_terms_of_service_url": null, "publisher_name": "Small Screen Studios UK", "support_website_url": null, "website_url": "https://mrsmallpool.wixsite.com/cue-clash", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24650044071317823"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1801101993827947"}]}, "baseline_offer": {"id": "1801101993827947"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759773840, "status": "PUBLISHED", "id": "1801101993827947"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24720879690900927", "version": "114"}, "id": "1403284288468148", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__type
C77"}, {"file_name": "ss_18_26_02.png", "id": "1366480615103252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294643_1366480621769918_7524409474261002527_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfFPCz6rI0UQ7kNvwEcUyIi&_nc_oc=AdrKhwWOyQwSCMdffN0nPkDjT4eZoASpjZKYMRNyU-zoQIzxFomN7SkeJvffLC2l9XU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx6h-JL89szjsCYDytXhJXiUdlXCiwIoJlD38yKUyyAw&oe=6ABFB23B"}, {"file_name": "ss_18_27_53.png", "id": "823139190137533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295625_823139196804199_7324418153246665226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plJVNgbUJUQQ7kNvwFWnvkz&_nc_oc=Adq6jNBcwRUui8Lu4wNI7V7yn13Jc0VxqIHPmCazT9Sl1H5SHP98AKvbb9koUgph_ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwHa0CxIvjhQtpf_I951lt2pDvev0npWHUyqM0P1QJuw&oe=6ABFC5B5"}, {"file_name": "ss_18_30_29.png", "id": "1110320714615486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293844_1110320717948819_1813326086519619913_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-lt5kl1yPwQ7kNvwFrOxC1&_nc_oc=AdptFEqvY94Dj6BBjIdYj5_sXtLIzOSoXRuE-q_Cumo5I0qC9M78kYXJIuu2njpnlDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMctUO20BXmJjwo4lhobwUJS1Z8IbwRhggVuLRV3vGyOQ&oe=6ABFD6BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2229169547593255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293997_2229169550926588_6809479925237231687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUL94-8dUDkQ7kNvwH-IQlX&_nc_oc=AdpPfAxj1Dm2Fu1csy6ZGSe31QYRI3x5eIBqWtuV2fCNmpQ16o-wWQws8dv3XirGqp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmclCG8LWRziZKGFkeW6PiDuygYIf7B1CD9mM8KYQheg&oe=6ABFE05B"}, "display_name": "Cue Clash", "keywords": ["snooker", "pool"], "long_description": "Play Pool,  Nine Ball and Snooker. You can play solo or against a friend over a WIFI network. If your friend doesn't have a VR headset they can play against you using a mobile phone version of the game. As well as the regular rectangular table, there are a few others, including hexagonal and star shaped ones. You can also design your own tables with the built in editor.", "short_description": "Play pool, nine ball and snooker on a variety of tables against a friend or the computer."}, {"images": {"nodes": []}, "id": "777463761846924", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cue Clash", "keywords": ["billard", "snooker"], "long_description": "Jouez au billard, au 9 Ball et au snooker. Vous pouvez jouer seul ou contre un ami via Wi-Fi. Si votre ami n'a pas de casque de r\u00e9alit\u00e9 virtuelle, il peut jouer contre vous sur une version mobile du jeu. Outre la table rectangulaire classique, il existe d'autres tables, notamment hexagonales et en \u00e9toile. Vous pouvez \u00e9galement cr\u00e9er vos propres tables gr\u00e2ce \u00e0 l'\u00e9diteur int\u00e9gr\u00e9.", "short_description": "Jouez au billard, au snooker et au snooker sur une vari\u00e9t\u00e9 de tables contre un ami ou l'ordinateur."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mrsmallpool.wixsite.com/cue-clash/blank", "developer_terms_of_service_url": null, "publisher_name": "Small Screen Studios UK", "support_website_url": null, "website_url": "https://mrsmallpool.wixsite.com/cue-clash", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
237"}, {"file_name": "ss_18_26_02.png", "id": "1366480615103252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294643_1366480621769918_7524409474261002527_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrhSKkhE-7gQ7kNvwGPS1AE&_nc_oc=AdrKQi6yf2IpRgfiZ4sag8OA8z3B2imiKz6wUD4WpeQHjFi20OxmBdxF-Z5uQWrmsqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf0Za_kwDpgSZMk307Pz1lalawlPcuKKj2FuYpJNf9PA&oe=6AAFE03B"}, {"file_name": "ss_18_27_53.png", "id": "823139190137533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295625_823139196804199_7324418153246665226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYuHyGj_ZoEQ7kNvwE9H3dw&_nc_oc=Adogf49MQiAvf2qLylMWa924QXpM7aD9p2zrbtBmK4QBpQlqSKu1K5CAg4j_2Oy_gGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy765M0hrjKvuNwbwL-lXjgMAdse5OzJY4FkiFLIFt4g&oe=6AAFF3B5"}, {"file_name": "ss_18_30_29.png", "id": "1110320714615486", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293844_1110320717948819_1813326086519619913_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quw2CyHXxHoQ7kNvwF1pIn-&_nc_oc=AdocRfSJIie9lQa_zgaKd2DWRstAKkBRV8PA-yKi8XYv8lKL1jkWLI4DkSPuLnxLT38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdlM0L4Jv5iyMD9Cz0rA3JpQzhn7uvm_OK4RiOMZ9KBQ&oe=6AB004BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2229169547593255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293997_2229169550926588_6809479925237231687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T25K4VN4ZiQQ7kNvwH9WGmr&_nc_oc=Adp3h7ftjKa-ZZ3WUS8qUY6vXU4azX16lPxLVB7qgo9BLZiwgcjqQScGKV7jd1vMZrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId5s7Z_2zCTrDUx1keJthhkngIp08P4hhUIrArBUmdEA&oe=6AAFD61B"}, "display_name": "Cue Clash", "keywords": ["snooker", "pool"], "long_description": "Play Pool,  Nine Ball and Snooker. You can play solo or against a friend over a WIFI network. If your friend doesn't have a VR headset they can play against you using a mobile phone version of the game. As well as the regular rectangular table, there are a few others, including hexagonal and star shaped ones. You can also design your own tables with the built in editor.", "short_description": "Play pool, nine ball and snooker on a variety of tables against a friend or the computer."}, {"images": {"nodes": []}, "id": "777463761846924", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cue Clash", "keywords": ["billard", "snooker"], "long_description": "Jouez au billard, au 9 Ball et au snooker. Vous pouvez jouer seul ou contre un ami via Wi-Fi. Si votre ami n'a pas de casque de r\u00e9alit\u00e9 virtuelle, il peut jouer contre vous sur une version mobile du jeu. Outre la table rectangulaire classique, il existe d'autres tables, notamment hexagonales et en \u00e9toile. Vous pouvez \u00e9galement cr\u00e9er vos propres tables gr\u00e2ce \u00e0 l'\u00e9diteur int\u00e9gr\u00e9.", "short_description": "Jouez au billard, au snooker et au snooker sur une vari\u00e9t\u00e9 de tables contre un ami ou l'ordinateur."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mrsmallpool.wixsite.com/cue-clash/blank", "developer_terms_of_service_url": null, "publisher_name": "Small Screen Studios UK", "support_website_url": null, "website_url": "https://mrsmallpool.wixsite.com/cue-clash", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
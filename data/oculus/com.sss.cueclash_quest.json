_nc_oc=Adlc9RpVjzF8BAsTfhW-nimWMVAt0SXDmY3PtgZWwPlKf2JpvIRN-ma5bY9Q1_vLGKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-A7GnoPh2BQLbaP5Jqs96SSqBeVIQ4Gb13Uaxws8wIQ&oe=69A6CEFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2229169547593255", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293997_2229169550926588_6809479925237231687_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFcYgoOhwigQ7kNvwHYeHaF&_nc_oc=AdnaOBnaIc8cd-n3eN4Cfxd5cFeNHwegIDpO_Bte43RTxJaNt5aTBK40u-EoBaqOpEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvcgdPTCQu6ifk9cGTNHqkxm-BLIz7kcnd3Frfe8oxqXA&oe=69A6D89B"}, "display_name": "Cue Clash", "keywords": ["snooker", "pool"], "long_description": "Play Pool,  Nine Ball and Snooker. You can play solo or against a friend over a WIFI network. If your friend doesn't have a VR headset they can play against you using a mobile phone version of the game. As well as the regular rectangular table, there are a few others, including hexagonal and star shaped ones. You can also design your own tables with the built in editor.", "short_description": "Play pool, nine ball and snooker on a variety of tables against a friend or the computer."}, {"images": {"nodes": []}, "id": "777463761846924", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cue Clash", "keywords": ["billard", "snooker"], "long_description": "Jouez au billard, au 9 Ball et au snooker. Vous pouvez jouer seul ou contre un ami via Wi-Fi. Si votre ami n'a pas de casque de r\u00e9alit\u00e9 virtuelle, il peut jouer contre vous sur une version mobile du jeu. Outre la table rectangulaire classique, il existe d'autres tables, notamment hexagonales et en \u00e9toile. Vous pouvez \u00e9galement cr\u00e9er vos propres tables gr\u00e2ce \u00e0 l'\u00e9diteur int\u00e9gr\u00e9.", "short_description": "Jouez au billard, au snooker et au snooker sur une vari\u00e9t\u00e9 de tables contre un ami ou l'ordinateur."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mrsmallpool.wixsite.com/cue-clash/blank", "developer_terms_of_service_url": null, "publisher_name": "Small Screen Studios UK", "support_website_url": null, "website_url": "https://mrsmallpool.wixsite.com/cue-clash", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24650044071317823"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1801101993827947"}]}, "baseline_offer": {"id": "1801101993827947"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759773840, "status": "PUBLISHED", "id": "1801101993827947"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24720879690900927", "version": "114"}, "id": "1403284288468148", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24650044051317825", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24720879690900927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1403284288468148"}]}, "change_log": null, "created_date": 1759487069, "id": 
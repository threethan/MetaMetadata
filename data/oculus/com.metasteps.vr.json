d3-1.oculuscdn.com/v/t64.5771-25/491827960_1965414771063832_2244265512506464209_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HPmrMXuAF0Q7kNvwGlPHFm&_nc_oc=AdrXanH-Vr1rKZApiQQUElT7IEHE7tMT6QqERIyFwZC_7btoFgDkLtuACVf8lIK9Jo0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgT1PFXggrANrJszTPCOjr581HvL0EsIMAgIPHsSBaFQ&oe=6B046FEC"}, {"file_name": "image03.png", "id": "1626789998491525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1626790001824858_8181927416630834626_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW5nTF8FE_8Q7kNvwGcjNUC&_nc_oc=Adpv9Xv19SYnRX5jD7oe_9XB-aoeYVSRx3K3kjnKwyPxk8G_r5X3Xy7z4nWK3YhJ6ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHsdllkhrV-8fdgWZbv7M11WmORthQqApt_FfC6ds2kA&oe=6B046FF4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Metasteps", "keywords": [], "long_description": "Metasteps is a no-code, web-based and accessible metaverse ecosystem that empowers creators, educators, and businesses to design immersive 3D environments that inspire, engage, and connect. By removing technical barriers and enabling creative freedom, Metasteps transforms how people learn, work, socialize, and share stories in the digital age.\n\nOur metaverse-as-a-service platform combines intuitive tools with seamless web-based access, customize and publish interactive 3D spaces enriched with content and storytelling, making immersive experiences universally reachable and instantly impactful. Metasteps users can access the virtual spaces and 3D experiences across various devices, including VR headsets, web browsers, tablets and smartphones.", "short_description": "Fostering immersive experiences, creativity & learning in the Metaverse"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metasteps.com/privacy-notice", "developer_terms_of_service_url": "https://metasteps.com/terms-of-service", "publis
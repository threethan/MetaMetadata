d3-1.oculuscdn.com/v/t64.5771-25/491827960_1965414771063832_2244265512506464209_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_PeutNuEN4Q7kNvwFVp0v9&_nc_oc=AdoDpgWZ97GJReUiC2jkpQ1_3cG7mLQ9MeILR3pMd6oxo3yfksJRk93Pu2wY181ULHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBtmjGTqi2m-j4gLyXE5_PVxZjqJF-ezl7bLD4oXL7RQ&oe=6B0C58EC"}, {"file_name": "image03.png", "id": "1626789998491525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1626790001824858_8181927416630834626_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vhixHBxn_QQ7kNvwEKFiVx&_nc_oc=AdqqZH027Um2hftWEG341Sv9hEO7V0d5BD49XQ7vXce2HRGLFLXqzJITjPnGk5yLbvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1UU_tp_giUyO2uSZefOwNj1BFI_3Irbw8hKXJYBBNpw&oe=6B0C58F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Metasteps", "keywords": [], "long_description": "Metasteps is a no-code, web-based and accessible metaverse ecosystem that empowers creators, educators, and businesses to design immersive 3D environments that inspire, engage, and connect. By removing technical barriers and enabling creative freedom, Metasteps transforms how people learn, work, socialize, and share stories in the digital age.\n\nOur metaverse-as-a-service platform combines intuitive tools with seamless web-based access, customize and publish interactive 3D spaces enriched with content and storytelling, making immersive experiences universally reachable and instantly impactful. Metasteps users can access the virtual spaces and 3D experiences across various devices, including VR headsets, web browsers, tablets and smartphones.", "short_description": "Fostering immersive experiences, creativity & learning in the Metaverse"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metasteps.com/privacy-notice", "developer_terms_of_service_url": "https://metasteps.com/terms-of-service", "publis
a5-1.oculuscdn.com/v/t64.5771-25/491827960_1965414771063832_2244265512506464209_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_PeutNuEN4Q7kNvwHVGT9j&_nc_oc=AdrJ_8J2RJcJ_JT1ngOVCwJsjQB0-cxQcmUuw_88a6qu2frRnWLEM4QsWWwetBen5NM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScXyN4Ja1Jdv4DONlSSLO9ap0TZr2x9OzVOWK-dw2CfA&oe=6B09B5EC"}, {"file_name": "image03.png", "id": "1626789998491525", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_1626790001824858_8181927416630834626_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyAs4ZBD10gQ7kNvwGFllk5&_nc_oc=AdpJu8MT6zuaTidb7GFOeVS05CzJNoVQBN9luNFTucEo9AXdOUOt4kOqtovky_P6OVo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStIo0xfRbv-Pgb1shaWx1_rsKzY1HBX8JCXKgftnPJ4A&oe=6B09B5F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Metasteps", "keywords": [], "long_description": "Metasteps is a no-code, web-based and accessible metaverse ecosystem that empowers creators, educators, and businesses to design immersive 3D environments that inspire, engage, and connect. By removing technical barriers and enabling creative freedom, Metasteps transforms how people learn, work, socialize, and share stories in the digital age.\n\nOur metaverse-as-a-service platform combines intuitive tools with seamless web-based access, customize and publish interactive 3D spaces enriched with content and storytelling, making immersive experiences universally reachable and instantly impactful. Metasteps users can access the virtual spaces and 3D experiences across various devices, including VR headsets, web browsers, tablets and smartphones.", "short_description": "Fostering immersive experiences, creativity & learning in the Metaverse"}]}, "developer_name": null, "developer_privacy_policy_url": "https://metasteps.com/privacy-notice", "developer_terms_of_service_url": "https://metasteps.com/terms-of-service", "publis
ZgroQ7kNvwF9WJN1&_nc_oc=Adllpfh79lexAxSNxi_g1Pdbah-bgkuqsm7xXMbVK2aw6r8UxRUyseSnxxPBYe8QbHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afufkxwbu6XBiYD8hryEWgRmbbZTixdwWuC0MWbpIjq6ow&oe=699AE855"}, {"file_name": "arena001.png", "id": "3119091628401998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_3119091631735331_3375593594409309874_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knm8TuILWXgQ7kNvwF_WYoR&_nc_oc=AdnMa8LKb0kDTJlvbovEi4fTXIVQcNtb62GyEwOLHuYyZU-BIZXYD4jApaQneRfOJbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuuo5_HAYzSK656tBCx2GDCdMvE4VoItbujRqaECZ2vCQ&oe=699AF3AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eee.png", "id": "1346898239177431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_1346898242510764_89356810441955817_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yho9pVeJoaIQ7kNvwEJdsp0&_nc_oc=Adnj3qGwJqv1_Tf18o7ZvGqCdLeq1KHRCc1pkfPFwQgH1rcKgjJZkmqYySd0VAsHdV4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuVEYFjj37EQWhux52rdUxVdsIffV7M7KfF-MVq0ndMww&oe=699AEEC5"}, "display_name": "Smash The Synth", "keywords": [], "long_description": "Smash The Synth is a game in which you have to slap and punch synthesizers and catch slimes while avoiding energy spheres and black synths.\n\nWith the red hand you have to smash the keys of the red synthesizer.\nWith the gray hand you have to smash the keys of the gray synthesizer.\nYou have to avoid mistaking hand color and synth color, and also avoid black synthesizers.\n\nAll the slimes give you points except one: the only one stealer, but in addition to the points they also activate spells, sometimes useful like turning your hands into electro that allow you to smash both red and gray synthesizers with the same hand, other times spiteful like hands become momentary ghosts or synthesizer colors change: for a complete list of what the various slimes do see the panels in the \"how to play\" section in the game. But for extra points it is worthy catch them all!\n\nEach match lasts three minutes where you have to smash as many synthesizer keys as you can and grab as many slimes as possible!!!", "short_description": "four levels of difficulty, stay focused !!!\n\nwith the red hand you have to smash the keys of the red synthesizer and with the gray hand the keys of the gray synthesizer !!!\n\ncatch slimes but beware that some are mischievous, they could change the color of the synthesizers, some speeds up the tempo and more tricks ...\n\navoid the black synthesizers and energy spheres !!!\n\nevery match lasts three minutes in which you can score points for a chance to enter the leaderboard among the top ten !!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mad-vf.com/smashthesynth/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fabio Cecchini", "support_website_url": null, "website_url": "https://mad-vf.com/smashthesynth", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1114860226051863"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1632743780672356"}, {"status": "PUBLISHED", "id": "1014916423535982"}, {"status": "PUBLISHED", "id": "601903551299938"}]}, "baseline_offer": {"id": "1014916423535982"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time":
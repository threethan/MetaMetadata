1-7&_nc_sid=6e7a0a&_nc_ohc=0YSF3pcNjt4Q7kNvwHUlyXk&_nc_oc=AdqMiUQMdgvAJtJtfjFRzmMWFder3hdoZ-zYBEDGVW210Qheh2cS9DNMUXtejrzg9TQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxEn9p9A3HMvboEVRlbDFFps-Y3xHwCfn-E3hm-KMkTg&oe=6B0EFC12"}, {"file_name": "arena002.png", "id": "597734865244595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974526_597734868577928_368354434658377476_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXhnkx6PHPIQ7kNvwGDEP-C&_nc_oc=AdreiPGDimJGABgE8um0Qn5AovsDk4iHze-jQ9wqCH3vz6yNmatnMW2Rx4oYNJ7fcFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVKRwMRQ3QngKcbv2MeDEhfUwvakNqwxxuEHjOXuXSjng&oe=6B0F0126"}, {"file_name": "arena004.png", "id": "397221225851364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_397221229184697_4925193326062909967_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpOJFL_FU9wQ7kNvwG1PXi5&_nc_oc=AdoQlhVMNi6VKOmDqArltwCMXqptCzFogqzFyd2Qp2qo4NUmg1jM_opXjAEWM0Ke4AU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlrErIBRV7hY7rcJbF8PM8OMUOde33TSa0mU6zozeAVg&oe=6B0F1FD5"}, {"file_name": "arena001.png", "id": "3119091628401998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_3119091631735331_3375593594409309874_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlLnSSRIpH8Q7kNvwFzBVsN&_nc_oc=AdrfBA2A-7YHT8lXlJcI1Rnwn2Kkp5itcCOGUoLzEm-F6V2RheVRgqL1mzWqjhAma-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUF4Feyi2yvKo2b6vnYNFhC4bULz5YrucWi5zEmDmveCA&oe=6B0EF2EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eee.png", "id": "1346898239177431", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974680_1346898242510764_89356810441955817_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL7FykRlvRsQ7kNvwEf-sfR&_nc_oc=AdortC0NVVHMfcO6NFvPLe-utFcuB8TjZIvamxuYtYlnkgDfs9TSW5ohpWc1wa-OnXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVvrWkydOWIMoEXBl2y6dnpFbSlfWE4SPzLLc_KogOnOQ&oe=6B0EEE05"}, "display_name": "Smash The Synth", "keywords": [], "long_description": "Smash The Synth is a game in which you have to slap and punch synthesizers and catch slimes while avoiding energy spheres and black synths.\n\nWith the red hand you have to smash the keys of the red synthesizer.\nWith the gray hand you have to smash the keys of the gray synthesizer.\nYou have to avoid mistaking hand color and synth color, and also avoid black synthesizers.\n\nAll the slimes give you points except one: the only one stealer, but in addition to the points they also activate spells, sometimes useful like turning your hands into electro that allow you to smash both red and gray synthesizers with the same hand, other times spiteful like hands become momentary ghosts or synthesizer colors change: for a complete list of what the various slimes do see the panels in the \"how to play\" section in the game. But for extra points it is worthy catch them all!\n\nEach match lasts three minutes where you have to smash as many synthesizer keys as you can and grab as many slimes as possible!!!", "short_description": "four levels of difficulty, stay focused !!!\n\nwith the red hand you have to smash the keys of the red synthesizer and with the gray hand the keys of the gray synthesizer !!!\n\ncatch slimes but beware that some are mischievous, they could change the color of the synthesizers, some speeds up the tempo and more tricks ...\n\navoid the black synthesizers and energy spheres !!!\n\nevery match lasts three minutes in which you can score points for a chance to enter the leaderboard among the top ten !!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mad-vf.com/smashthesynth/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fabio Cecchini", "support_website_url": null, "website_url": "https://mad-vf.com
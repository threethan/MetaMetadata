8577928_368354434658377476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f5V_m-bh-YQ7kNvwFl1EzG&_nc_oc=AdqiDKMcRa41a58GybZzG-gTwUqz5Qsl2RDY2Q4aJvnmp34a8XTfuOS_iKT3pb47qcU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW9iAso2rfsQRq_K2qawduq6LNEFtPjp_kJTL04a7muQ&oe=6AF0AEA6"}, {"file_name": "arena004.png", "id": "397221225851364", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974472_397221229184697_4925193326062909967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKR25ZFZ86EQ7kNvwEEyPW3&_nc_oc=Adpp3B45kPcn9wvrgFfYv1ByLwL9JK7gDyJCCnshzwrWtOA75ULIeoGRLhawdHXSx9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2gdoGEZ2SDMa7GBR2phrfcxFDUY0BnxigIMkyr8b7Cw&oe=6AF09515"}, {"file_name": "arena001.png", "id": "3119091628401998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974526_3119091631735331_3375593594409309874_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Bn_AUnoO54Q7kNvwHCAqPs&_nc_oc=Ado0ZExuV9sClkiGVf8mdyvoPZ77QHVM2FQ1rwIjN6hdlpzkalOML9EElecY3ElhgHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZHQlnzHSmpZNF8IlaEnzn2CzrrN4wiMWje-PQLH8D6w&oe=6AF0A06A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eee.png", "id": "1346898239177431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974680_1346898242510764_89356810441955817_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA7cwGEyk3EQ7kNvwEVAw8l&_nc_oc=Ado34Q_sNiGQCCkJgDM_Jz7PZ725I3AJI3F_NwqBFawdU79JdBEtXXK08OEBNLU3GsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQegaLhVDBY4VNxXhHqZ8Hxac0RZJS-fxBBxbQ2Gqw_IA&oe=6AF09B85"}, "display_name": "Smash The Synth", "keywords": [], "long_description": "Smash The Synth is a game in which you have to slap and punch synthesizers and catch slimes while avoiding energy spheres and black synths.\n\nWith the red hand you have to smash the keys of the red synthesizer.\nWith the gray hand you have to smash the keys of the gray synthesizer.\nYou have to avoid mistaking hand color and synth color, and also avoid black synthesizers.\n\nAll the slimes give you points except one: the only one stealer, but in addition to the points they also activate spells, sometimes useful like turning your hands into electro that allow you to smash both red and gray synthesizers with the same hand, other times spiteful like hands become momentary ghosts or synthesizer colors change: for a complete list of what the various slimes do see the panels in the \"how to play\" section in the game. But for extra points it is worthy catch them all!\n\nEach match lasts three minutes where you have to smash as many synthesizer keys as you can and grab as many slimes as possible!!!", "short_description": "four levels of difficulty, stay focused !!!\n\nwith the red hand you have to smash the keys of the red synthesizer and with the gray hand the keys of the gray synthesizer !!!\n\ncatch slimes but beware that some are mischievous, they could change the color of the synthesizers, some speeds up the tempo and more tricks ...\n\navoid the black synthesizers and energy spheres !!!\n\nevery match lasts three minutes in which you can score points for a chance to enter the leaderboard among the top ten !!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mad-vf.com/smashthesynth/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fabio Cecchini", "support_website_url": null, "website_url": "https://mad-vf.com/smashthesynth", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
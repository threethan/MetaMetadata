tps://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974472_397221229184697_4925193326062909967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4qdi31IszUQ7kNvwGZxDld&_nc_oc=AdrNg9XVwmHydYc1utuOWDFXaaTEQxNBKu0XhmINgKxCRjkdPpedl2Pl7H4wuZ4Gy2k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88bwujThViYMK940PK-UCzh1Q65V6Od-lwrN_7HTLgxA&oe=6A395495"}, {"file_name": "arena001.png", "id": "3119091628401998", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974526_3119091631735331_3375593594409309874_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0av_RPyUl0Q7kNvwHd0HeE&_nc_oc=Adoyk58xkpPtKj3EmQOGPd2jk3klwoWhN-InjJpvBGmZvufAamx8jdTTJd2JMcJEDbA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j_WD3h9xgjPXLaJeVz50Vnhl0eV6dYOXmbVpCGUUB9w&oe=6A395FEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eee.png", "id": "1346898239177431", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974680_1346898242510764_89356810441955817_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKJS8IoZmvUQ7kNvwGJXsv0&_nc_oc=AdovMJOzSMHpv2e_oH_LXAG1Kk7olpqrr6gyt1JS5qLaZ9Hb3gAzdpZkm_wjQYKjj7E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86Fcptjw418tqfpJNz0soCWNhw9s8nk3nT7zap5xHYQA&oe=6A395B05"}, "display_name": "Smash The Synth", "keywords": [], "long_description": "Smash The Synth is a game in which you have to slap and punch synthesizers and catch slimes while avoiding energy spheres and black synths.\n\nWith the red hand you have to smash the keys of the red synthesizer.\nWith the gray hand you have to smash the keys of the gray synthesizer.\nYou have to avoid mistaking hand color and synth color, and also avoid black synthesizers.\n\nAll the slimes give you points except one: the only one stealer, but in addition to the points they also activate spells, sometimes useful like turning your hands into electro that allow you to smash both red and gray synthesizers with the same hand, other times spiteful like hands become momentary ghosts or synthesizer colors change: for a complete list of what the various slimes do see the panels in the \"how to play\" section in the game. But for extra points it is worthy catch them all!\n\nEach match lasts three minutes where you have to smash as many synthesizer keys as you can and grab as many slimes as possible!!!", "short_description": "four levels of difficulty, stay focused !!!\n\nwith the red hand you have to smash the keys of the red synthesizer and with the gray hand the keys of the gray synthesizer !!!\n\ncatch slimes but beware that some are mischievous, they could change the color of the synthesizers, some speeds up the tempo and more tricks ...\n\navoid the black synthesizers and energy spheres !!!\n\nevery match lasts three minutes in which you can score points for a chance to enter the leaderboard among the top ten !!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mad-vf.com/smashthesynth/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fabio Cecchini", "support_website_url": null, "website_url": "https://mad-vf.com/smashthesynth", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1114860226051863"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1632743780672356"}, {"status": "PUBLI
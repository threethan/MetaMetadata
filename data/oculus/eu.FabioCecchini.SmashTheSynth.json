d5MiES0P0CyXWFPvgHFzpwkmsHnCVK7YWDdy4K7u1KhSQDt6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTd16k-K9udJU5lUxniUBfwH-Y1IbaGuzl_sqUXUwjVQ&oe=6AE0A466"}, {"file_name": "arena004.png", "id": "397221225851364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_397221229184697_4925193326062909967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nNujtbT9DUQ7kNvwGdIFQA&_nc_oc=Adrgsx0MhfUVvc8FCVtKeHLtqHRpr2ec76gFhUtfwZLP9FUaX-mRz8CMDhV8pg_H0Fw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIDaIU4E1BzPnJ6pslt1TySvViZHaOH6SekNRezALnlw&oe=6AE0C315"}, {"file_name": "arena001.png", "id": "3119091628401998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_3119091631735331_3375593594409309874_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLlPiFsAynkQ7kNvwF7XIMK&_nc_oc=AdpJ1R1LM9EyvTzP8KyXbBXo4dFxH2G14CklWgSN-VjU3OdIWAFSDR8SPyt5ePGkPMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk2NQVsJNUPm3bM4q1kM17QLsrDCK4olI0VxruvQ-pzw&oe=6AE0962A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eee.png", "id": "1346898239177431", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974680_1346898242510764_89356810441955817_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6pykiGbHCAQ7kNvwGHOXEV&_nc_oc=Adrs8hY5aqYkl90mS3_HX_BUFfcjNrkBZxv1KH6_a6l4-pN13OvQN07Jvpq44vwN_O0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPBI-RcfqFwltT4n68V7oA87UJpf8wUFB_24ojrGsu2A&oe=6AE0C985"}, "display_name": "Smash The Synth", "keywords": [], "long_description": "Smash The Synth is a game in which you have to slap and punch synthesizers and catch slimes while avoiding energy spheres and black synths.\n\nWith the red hand you have to smash the keys of the red synthesizer.\nWith the gray hand you have to smash the keys of the gray synthesizer.\nYou have to avoid mistaking hand color and synth color, and also avoid black synthesizers.\n\nAll the slimes give you points except one: the only one stealer, but in addition to the points they also activate spells, sometimes useful like turning your hands into electro that allow you to smash both red and gray synthesizers with the same hand, other times spiteful like hands become momentary ghosts or synthesizer colors change: for a complete list of what the various slimes do see the panels in the \"how to play\" section in the game. But for extra points it is worthy catch them all!\n\nEach match lasts three minutes where you have to smash as many synthesizer keys as you can and grab as many slimes as possible!!!", "short_description": "four levels of difficulty, stay focused !!!\n\nwith the red hand you have to smash the keys of the red synthesizer and with the gray hand the keys of the gray synthesizer !!!\n\ncatch slimes but beware that some are mischievous, they could change the color of the synthesizers, some speeds up the tempo and more tricks ...\n\navoid the black synthesizers and energy spheres !!!\n\nevery match lasts three minutes in which you can score points for a chance to enter the leaderboard among the top ten !!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mad-vf.com/smashthesynth/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fabio Cecchini", "support_website_url": null, "website_url": "https://mad-vf.com/smashthesynth", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_pla
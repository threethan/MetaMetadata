1-7&_nc_sid=6e7a0a&_nc_ohc=3f9C3kK6ucsQ7kNvwEkcJf7&_nc_oc=Ado_CZwCXNim9Gqg4wIHJLLJBLnk5511uHwskRbfsrXkuIiBhzcQej2--NvNs_ECut4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiiBHosB_qxcGjB_4wAhnMib6al40r5hWJbYZuIHT_ZQ&oe=6B05C192"}, {"file_name": "arena002.png", "id": "597734865244595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974526_597734868577928_368354434658377476_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=792nXBb573wQ7kNvwGsx-4B&_nc_oc=AdqOSg93v5tw5ROLeh2y8xMEtdNjjK2sOLlz2d_p49LdElUnng9g2w9M_brNmXKRYDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgeqbidYbmSQj2JhKi9LbHKUNBKhtJJ5oYNA1JPWDdlw&oe=6B05C6A6"}, {"file_name": "arena004.png", "id": "397221225851364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974472_397221229184697_4925193326062909967_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-e8TB-9OX4Q7kNvwE0JBIM&_nc_oc=AdrPLBTjt7dP5yUWxEcFbpo-E_Dka9KdQ8a5j9TVvEdq0kElWksCwogG9LKGWoIEPEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTndTuM58HSmNz9GgoUORBgK483U_NViIKcu-wS7zs22Q&oe=6B05AD15"}, {"file_name": "arena001.png", "id": "3119091628401998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_3119091631735331_3375593594409309874_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHelelarjA8Q7kNvwElE7_1&_nc_oc=Adq7AcyO6IAuOeLDiF9sAz9qw40kNe_IuQ9zCY6-fqVJdjzKOLW8mgyJQGqWxEvEpcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUwqucEcDeuwMxE40ceRjzJ3OR0QiouL4B5_ErteeCnw&oe=6B05B86A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eee.png", "id": "1346898239177431", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974680_1346898242510764_89356810441955817_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hOTTo3ze2EQ7kNvwHwd-2F&_nc_oc=AdrmrmL4UibJe1hMwBlqoL40Ez2P0ZJHj3hwu7wpMaMtPn-k7QFacwm-McTZalrVn0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZk3caW7buQnaNq7BtKpk1y3FdMouIXqlcux2wMypC5w&oe=6B05B385"}, "display_name": "Smash The Synth", "keywords": [], "long_description": "Smash The Synth is a game in which you have to slap and punch synthesizers and catch slimes while avoiding energy spheres and black synths.\n\nWith the red hand you have to smash the keys of the red synthesizer.\nWith the gray hand you have to smash the keys of the gray synthesizer.\nYou have to avoid mistaking hand color and synth color, and also avoid black synthesizers.\n\nAll the slimes give you points except one: the only one stealer, but in addition to the points they also activate spells, sometimes useful like turning your hands into electro that allow you to smash both red and gray synthesizers with the same hand, other times spiteful like hands become momentary ghosts or synthesizer colors change: for a complete list of what the various slimes do see the panels in the \"how to play\" section in the game. But for extra points it is worthy catch them all!\n\nEach match lasts three minutes where you have to smash as many synthesizer keys as you can and grab as many slimes as possible!!!", "short_description": "four levels of difficulty, stay focused !!!\n\nwith the red hand you have to smash the keys of the red synthesizer and with the gray hand the keys of the gray synthesizer !!!\n\ncatch slimes but beware that some are mischievous, they could change the color of the synthesizers, some speeds up the tempo and more tricks ...\n\navoid the black synthesizers and energy spheres !!!\n\nevery match lasts three minutes in which you can score points for a chance to enter the leaderboard among the top ten !!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mad-vf.com/smashthesynth/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fabio Cecchini", "support_website_url": null, "website_url": "https://mad-vf.com
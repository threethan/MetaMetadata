&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEBjZGwGJRUMW5Hg_USY-ezOWZfGSkO57qnJtL4cAAzw&oe=6AFC8712"}, {"file_name": "arena002.png", "id": "597734865244595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974526_597734868577928_368354434658377476_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkSYtNSZiNwQ7kNvwH9bwnD&_nc_oc=AdrmQoA5FlfuQKbKy5MljZmw9__qrpafx6tZQTSRhc2GEgu4M71vQ7MAXhlXpDQDXc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5YvffzWYI40ILVVU6ihbtpnu21bbJo91EXZ3oPl8sfQ&oe=6AFC8C26"}, {"file_name": "arena004.png", "id": "397221225851364", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974472_397221229184697_4925193326062909967_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_INlpxkP4isQ7kNvwHHXfkl&_nc_oc=Adpc8viBbT0fSx6cxj9RftD7bIKqpAaYheDTGTK6mT-3dC5TezW8zdlhpvE5voOxxFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoP6Yo5lcRd14CzsFG7nAPs-ri3-0WSrpuUgFTng1hCg&oe=6AFC7295"}, {"file_name": "arena001.png", "id": "3119091628401998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974526_3119091631735331_3375593594409309874_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4W_ch7EW20Q7kNvwEljFls&_nc_oc=Ado61m6Lj3-yaRgRr2q3G9zNZKO80vQk23p9yrbSzp1eaQFyjYg3TumJUPNg6aTXICo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKFJaazsBqieaj1zi3Wse1Yt04w2N86ivo0YqrTBQmLg&oe=6AFC7DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "eee.png", "id": "1346898239177431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974680_1346898242510764_89356810441955817_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVJmW3wqWM8Q7kNvwHfy1sh&_nc_oc=Adr0n4Bf5Y2cwPirjcPd_ky8ulBjg-oncdoWzV4P-h_cPXK-EXZNoWo3rGxeiJqBdC0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNB6xHuDEVXfiwbaWQxPJ6708zO5whNPlwCcLxWAt15A&oe=6AFC7905"}, "display_name": "Smash The Synth", "keywords": [], "long_description": "Smash The Synth is a game in which you have to slap and punch synthesizers and catch slimes while avoiding energy spheres and black synths.\n\nWith the red hand you have to smash the keys of the red synthesizer.\nWith the gray hand you have to smash the keys of the gray synthesizer.\nYou have to avoid mistaking hand color and synth color, and also avoid black synthesizers.\n\nAll the slimes give you points except one: the only one stealer, but in addition to the points they also activate spells, sometimes useful like turning your hands into electro that allow you to smash both red and gray synthesizers with the same hand, other times spiteful like hands become momentary ghosts or synthesizer colors change: for a complete list of what the various slimes do see the panels in the \"how to play\" section in the game. But for extra points it is worthy catch them all!\n\nEach match lasts three minutes where you have to smash as many synthesizer keys as you can and grab as many slimes as possible!!!", "short_description": "four levels of difficulty, stay focused !!!\n\nwith the red hand you have to smash the keys of the red synthesizer and with the gray hand the keys of the gray synthesizer !!!\n\ncatch slimes but beware that some are mischievous, they could change the color of the synthesizers, some speeds up the tempo and more tricks ...\n\navoid the black synthesizers and energy spheres !!!\n\nevery match lasts three minutes in which you can score points for a chance to enter the leaderboard among the top ten !!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mad-vf.com/smashthesynth/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fabio Cecchini", "support_website_url": null, "website_url": "https://mad-vf.com/smashthesynth", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "27433260
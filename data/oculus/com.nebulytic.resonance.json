at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnhaNardZZ0Q7kNvwHz8WYl&_nc_oc=Adqb9Ge0D7tfUYSiNPq9AQfwDSlVFXOKdZcUcjmhI12CCEIcRpiIjt_m7erKuZJveGs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObtnY4kwjmMX9qRiTEGo82pSQeR452XCgERzWLi2prUQ&oe=6AC4FDC5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkle7-z2ENAQ7kNvwFY-KqB&_nc_oc=AdpfFdcjSFh4q7AnULFeSU96H0syPEludFOvoZsAVdClr-Ky6-DbVeeIocS3yT_mkwU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuT0V1usplUsS17430RB1UIE2adUSz5otacxs5KgWZPw&oe=6AC51C55"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJKaJxnQSo0Q7kNvwHNyt8d&_nc_oc=AdpNdbILV3NlAjsfEbHUmq7z4O9qAUMEV5_MMHeMD2VoqzGGKXqAv2ZWtl5sh7NUdQ4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM9HSyIwjIP87T-v3rUk2Aw-fDxjyLrvoLX35HtkZ-zg&oe=6AC5279D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMCq6VuC0QAQ7kNvwHIGoC3&_nc_oc=AdpgO16JCI6DjLN_UXvM5E6lWrXEDSIGFVDw6b3j4u4eoVm0Ua19z5DQRQ-gEJ8TCiM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDSMXCsy5cGoQgPB7KwXzIlGYFhdj7zlOvkSpb6VdwgA&oe=6AC51BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB6_QPmXoFoQ7kNvwGKM9U7&_nc_oc=Adq0DtIIIEH-IVLC6ifl2KkX4IU_6aeNWB1VdyWVeVQoCLzQgnwah3ylCl5-q6wjTMg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5L2HaiWvN6G6FoW7GdJriDTjHDvQigUDIoL6AI7kVOg&oe=6AC517BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
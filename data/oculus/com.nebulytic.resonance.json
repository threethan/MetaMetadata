0264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjQImHlNZiMQ7kNvwE7N6yr&_nc_oc=AdozPBNNlIqFthIAek9v3aXJ6nH7EstbVlwZuGkH76f6INKu4HhyAZSOF6ehJLfnM6o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgiZmt_RxkSmkkYjEhulkr7hcXii-o1QH0QHx6dIxtVw&oe=6ADCB8C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOJNsEZf-VwQ7kNvwHs-uiN&_nc_oc=Ado4AUwTwybZri_BWs0DXfCBYGEjE4Zvc3MxX9da-W3m-iAVWLCXVJ4TIaD84yn7bwE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA3AmbRvLoRPAYYhxJhps3_e8rE7UDO6G8Nj2Ib8JjRg&oe=6ADCD755"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rncBA6xBc_UQ7kNvwFmC6tB&_nc_oc=AdpZW1HwapYzv6l2mjzSkuyrBbPErZir8lybfxL4gQGQLCbwyRlwSwxCMNvVVaR4qw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN49IDgOvgKkTMbJZcIWVoXizW_QZONov1noRb98xjZrQ&oe=6ADCAA5D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFWylPANT5cQ7kNvwEG1Xz0&_nc_oc=AdrqC1BJ4nnfOTe_2lnlqy2FcOMG2vY-RQlT02xL-1mF8IrmEWai-YArFtzgcGtXnUg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkOVtU-FyrIIlt8YxcFp56Cty9KRx-J-xti4QB4k5tkA&oe=6ADCD6F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo7SH46UW_cQ7kNvwFPopHe&_nc_oc=AdqF8cw0DmLtOlLaLVYrc-4bFgcvIQqYe5QBp6dt6pEvAyHjkb9Y8akqqU96TnL1_Hs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp-vU9x7lPE_toSPsDEpmAKgKfVz900qh5Gie4bmZ16Q&oe=6ADCD2BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
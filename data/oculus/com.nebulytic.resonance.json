0264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTbgOVeJExEQ7kNvwE7FK6g&_nc_oc=AdozU_2n0W1VeQ7LgHuO8ELxmRB24OFcF2_FKm5eDFF2y1_lzshexmkdcDNo5MmBsHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT8aK1Ie5qngB_FCzCXO1WmjojD1Aa0A7Uv_tvnnrF-A&oe=6AE4A1C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYPsrm2wH9kQ7kNvwE2qTr6&_nc_oc=AdoLgqONUdN5-UXNjaOLqCv7dTcGso2-82cglw2Qcx6OUEzoScFVoClU4TjtOEIXp9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNglYLkJRORG2k9IjKUBxnLLDujh5fN_TvphxLe1eSfw&oe=6AE4C055"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y1LBfhdGqQQ7kNvwEBmz0y&_nc_oc=AdqSanPl0QfeaYDD9zqzcv2vism3cSBZtOxxZmuWByr68UTi3WNZK1Rc5b3I89Y-PtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn3UXynopd1rp3SXRmjKaxzW4qIrYtnjgWce2bIs_0eQ&oe=6AE4935D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S6nuBFke90Q7kNvwH79ebZ&_nc_oc=AdrqTV_aOVk6FSKFc9Q-2S6J5Scu9D74ekWhUAbCYJ9Evx6-STOtX5YA0b24RHk55ZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU2WciXo0KC2xKBzU11xZE2lf4cTRlqwbm_C-IqibAiQ&oe=6AE4BFF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziGveHPtI04Q7kNvwEUlR8h&_nc_oc=AdqRupJHSVr_n7bUNkBNgyXVod7HMwmQv6hTqb0bdJEga4wUuETQkxUt_2zUOl9w_sE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ6nneX44XE6H9ONXYqn8sKNMarJkMtKoOA8DGevhbUg&oe=6AE4BBBA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki1OqS_5l84Q7kNvwEV5Nwb&_nc_oc=Adrj2Wwrgr9-EuqWdzba-p6JYvOvhQKDrJuLxFAH8gfa6GxUAHRbidYew-Oh686pBp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuwgMYqcvkJqOS-HMGO8doOdTqnXpkaidouWRGo1ICAQ&oe=6ACA43C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlk2n8t28v4Q7kNvwES1vI3&_nc_oc=AdrLwJSFrRjJ0gNszHsGaXtkUWT53g-3lWbz_w802UFHIYAscRg_SperrkFeDBQF14Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLaWkamC7CFow1vWYNmTuhRRlKH5WPMeu1TTWYv2Tfzw&oe=6ACA6255"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7z0ftVnxAYQ7kNvwGx3sz2&_nc_oc=Adp1XDoJ9_Dp_1sR5jCstQ-gxTOwU2Pv_EVOs_GxuULOlL5u2Y5Lxo5PpilKesj4xOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMu1K3kus8943RZxZ8Nwqy1XLt6DkXj6MCufW6bg14mA&oe=6ACA6D9D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6atKaIVsi0Q7kNvwEyMqUe&_nc_oc=Ado0z4vtDt7mE5Hi07MBgOYmljqqE-4SYLYwH9tX0AwIYQ6gD9sFo3vNjNE5HOlkAsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF7XcD2f4uExKaNZQ1ZZkaJkXzca5y2p_E1WfR72I0CQ&oe=6ACA61F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7TNeQNq6lkQ7kNvwEe86Ce&_nc_oc=AdrACkrcPRMyP7-JnWrsZwTq0uchBZBIXyQfemP1VIFToOAMIQnrgw33sA5S1o31LTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODYcSg_cfvjf9j6KyQ9PoDxm2oaOn_LEA1m5512s4w7g&oe=6ACA5DBA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
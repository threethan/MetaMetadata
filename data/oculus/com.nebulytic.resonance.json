0264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki1OqS_5l84Q7kNvwFnsQN4&_nc_oc=AdpXIq_XhazO5isS4EHT60ifoRs11WL7wQUvN3bst2LderxMoZxRErSXXH_tngeF-Kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-_Tb7_-DYPYcIYa0B323EhOVxTKWGCWmP1aMvBsk-7A&oe=6ACB9545"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5JNEwHVFrwQ7kNvwF-Gfku&_nc_oc=AdpeBpc4dyMkawapCN-N_YWhBpk88xr6xCFxa0sW-untLh93OmtvWzN-MF3SCZ7xx2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKlWbOeGyPWJlXIv8EO-rrLy0JWmtpvXwnE-Fw2GNU2w&oe=6ACBB3D5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OquBJ40fXgQ7kNvwHnDmqw&_nc_oc=AdplOM2_n1yWp8DAFvyM39gDR0LGiAwxarl2ybbDOVvIZJRY_YXJcoIupL51o-m4EG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlvNSK71v5TkZIlEGs43HY-GWdy9I7vdmXeSoUPj1RCA&oe=6ACBBF1D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6atKaIVsi0Q7kNvwHHXTO0&_nc_oc=AdqHGgrxHYnAwCRXUjQrxMGAbEtjmekggwtT2tURBs4-fbilUxjCsumOezmyePqcLi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLoaF5-IgmG3KLHo9xKYcadmesCsHlknz4i4rIu5Bwcg&oe=6ACBB378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7TNeQNq6lkQ7kNvwFG2NWg&_nc_oc=AdqVpLkO2xVuHkL3OsDTQe-myrpd2RKXY23QAa_RbaBycSwrVysgI6kFAYsuocl0dzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM0VQkMJt0GlkZSK7tqxjl-i-a_zwtKphMj6W2VKWYuQ&oe=6ACBAF3A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
71-25/491823837_1816753425996495_4903634210913859989_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekL7oc23xBwQ7kNvwGr5H0K&_nc_oc=AdpHQwYxeeyzFkTZ5wgT3N9gDJ-aT5CFkXvXqflUEMRdQLrrsDDtRT1R9iytluEAjjs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG-3CiPxfMPJ4wDxnMNwvPaVhbOvUTGomTNi6WcsXeCQ&oe=6AEC9EB5"}, {"file_name": "05-9-7.png", "id": "1126139396420264", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ccjP0oD82cQ7kNvwH2isNo&_nc_oc=AdrMhuguh984Un_bDUom45nWsIcPHYiMv7JXmyKI7LaThdbbEFi_oJk2XU1R_HGmoo0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOSEyHe_mbxkjs6iXGjkdkvl6OMlRaN7Hcf5POksiUMQ&oe=6AEC8AC5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwsOzYWCLHsQ7kNvwE9rHKg&_nc_oc=Adq4l6PmHj1POkJv47fDBW9fktAShw6uFLStOb40dU3sGSIzUVeDjT0KuabR3FHEPnM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8t3EBsLZZ6l4W36-QsJ_YgIYH7MRdSu6Zn2fvB0Nipg&oe=6AECA955"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMJMU01gb5wQ7kNvwHZ_tzu&_nc_oc=AdrdQKJhUs-OiVrcilpZaMHcDVBPlMF4dOkQOtRHHg2-vor9m5RYtLws1skZcjXq6gs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaF2PalfwJU2RaY702kh3Z0d3-UX-_el6iBDBrZwpMEw&oe=6AECB49D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WXEl4HemgwQ7kNvwGJ6r9l&_nc_oc=AdqKHgfiSLDEB0zvbOgcjII8YX7KdOg2jK0_skYysbpxMWCvg35u1zJnWkJpvBbB-IM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLdyza-SC7W3HB72ZpiPclyY_xPoY8HINBpd0rxay5mA&oe=6AECA8F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8cdnAQxe9kQ7kNvwFlM-CR&_nc_oc=AdrBC90SeCoErwOXenNnIlvDed2ikVQSEIehw9x7AQ00PKIA8-vpsSxXnvKJQDwxNCQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf-XWI8olSygSYT9eQDSicwBo8SpdrWwzSEy-rTrdGAA&oe=6AECA4BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an inte
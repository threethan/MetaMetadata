at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8eAXUDrk-sQ7kNvwEYBSzl&_nc_oc=AdrkfMOFZ0o5P1HP4sqo3ep7zns7FJKof-_NkC7Z7uqoKJEHvSi853oLfvcmsNwMgFQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSvGpKNkDDq6RvSRLgiQcX2TiNoWrHLGjHU1OX2itddA&oe=6AC7A0C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlk2n8t28v4Q7kNvwFRH70v&_nc_oc=AdreBlwAk6E3iq6fvPGRFvjcMyV8sh7QWu3fkIvadoaWQ15w0hOAq5FeVW38VMdMz1E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSwbb6-39bT01Eh01siXJ0FJPSnHJQgQSk-VsAk_iHug&oe=6AC7BF55"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7z0ftVnxAYQ7kNvwEIamZ2&_nc_oc=AdoHbckTsTQthHoYofP-_QyzEw3VZlkLWkqGo_mxQiy1VsC7L4gka7WElhDR__kdSPk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfda_VV_DJuE3cHrRHmTSzOUYVk50id9H4-D-fCcfSFQ&oe=6AC7CA9D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_Sedob2YhEQ7kNvwGftPmw&_nc_oc=AdpeJh_AGuk2IsufCrs8Lq2OJJgatfYqUpE2OV8_rsa4Ld8J2iC2gW6DCbLclddBobI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-y6rmLU0bp23GiiJJn87hsDS0vuM5248JrQyETTrTNw&oe=6AC7BEF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ4FeN2VTFYQ7kNvwEb0OCp&_nc_oc=AdqlcxtvesMquMm0nazmNsuhFmXDVaDqMrt7C241QEOfW3uSou979_G931gWwUO2O9U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy5wugMHWwNNECbpH2n6fxsQGhE3QlflRiSGoZ9Do2RQ&oe=6AC7BABA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
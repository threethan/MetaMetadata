FtLSvj&_nc_oc=AdriKXBCZWJ2LGSYnwRwMClIEXsAjHE6oukV4poEdiI3ZVRjbZ-BrHlMS_Z_IpWSqZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJtHTzuZ_exa7IpadOvJ2pMAqt9wYquoHb9JjNwujE6Q&oe=6AF8A085"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5CAPhmWNV0Q7kNvwG48kOr&_nc_oc=AdpZe1OtCIisaBrIVU2R05o7uyQOiib-7W18j75ueMy7m3o5G3gXKcNDA6f3LMUqATY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPzBnc3UZVGCDCBam_E2O_1pQ1eR8al37XrMpcR-_BrQ&oe=6AF886D5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRPlw_BbXEEQ7kNvwGXlm_Y&_nc_oc=AdpCpDnwSgvQWpVHt3otDdh8M0-SeAjrt9XIdm0SbQrNLPrt4uvmg9sS38RG4vxZt20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHSenHM6QorSRn7wCtrBFKWOmMbfCvU7tggBz0C5wVIA&oe=6AF8921D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoT_E1-h88AQ7kNvwFf02NT&_nc_oc=AdrhtAMn_Kf_NUGLvn6hDXH4ir_rcfb_faN1UpdEQa8Vx4Cpf2OhO2P8-IVJnHxMgYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfnHrq3aKG2vE_6S3XYfvHghG-LxAQB91kkc6bVndLDQ&oe=6AF88678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDAcpcwesOYQ7kNvwEuOeNv&_nc_oc=AdpjlQRoIjtl2ER6_H8R6XKV8Y87OcOo6dIgG_mQh1RMcn3s9mzBwUMFpg-ckA7nEyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWnGI_OPJbAa_FqIBV11JQPIt0vk3hAC2PQxwjPCmMQA&oe=6AF8823A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "cont
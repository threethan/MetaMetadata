0264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlbSI0c8qkEQ7kNvwGJZ9Yq&_nc_oc=AdqgeQygYOLZ-yznwRaWKkECiVV7oq274NEiKBi7DHe2iNb9vXzkaRNFOjljPx59Tqg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI-pRuMo5WwR5P1qKoGlsqfG7mQgJwoGoScmFZZkmbOA&oe=6ADE0A45"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOJNsEZf-VwQ7kNvwGZBFxB&_nc_oc=AdoE8ec9UUd8Bv3I8siFQ1gaSvCDnKDj9KOuG31PGGDphvDwunkd7NaJsNQS1EMXiwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI-YpS8c7JN_QHeP5qx92OOGfFxG5iUTROHUHHo17JVg&oe=6ADE28D5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rncBA6xBc_UQ7kNvwH6jWXO&_nc_oc=Adq8ejBMoun6wnhcz_xvceTsnGKHal6J_S63qlpWTR2PAl1OJDOa3yN9loMPWItBgoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhrJGc3TSlRUN5taNTaF-rOAwT7H4LJKbffGQ2A7u6nQ&oe=6ADDFBDD"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNgK4cxSPdUQ7kNvwFPA9zt&_nc_oc=AdovixecuvAf4FJDN0ZWdEYgV5XacsW1N6Vz6OL-eJmIIdJ6rp-8fJqdjnQ_mcPRP7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeL6Y3HW5rCoa5XM-KyADipxLJHCLSy4SbUUUF1R8ryQ&oe=6ADE2878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUMU0N3PDmsQ7kNvwGIgLah&_nc_oc=AdpD6HVXXG_Pt779yLcJcWjT0ZsXHzj_9dBFP6D3LgU36J7soiqiN0jzdHaAF_6W670&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC2f4tJoZLTE3gAn-OKLqtcebpOrTVoU9q00voImUMbw&oe=6ADE243A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
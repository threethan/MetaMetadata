0264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av5uKL9a7BQQ7kNvwGv08UV&_nc_oc=AdpfdtK2aAmzX_m5Qep0uOv61Xuw3fgBlRcMhQH8b3t1eL5s5mMfpmQPyij5PGG732w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfsOeZn6avFo1yI36gvK_iMT1zYSUwjRRwPvCl1aCalg&oe=6AD3B685"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wzKavMR7yEQ7kNvwGiepmF&_nc_oc=AdqgFbCN47AjCv_6QO2rhnTyDGJvkdDamRcCUvsVKwhXpbocfBPHnCo7OJgwjYh4-eM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1ddA__SJloQ0oI26sbQ9ASjzFLKZlkqxcj3_WHoSCCQ&oe=6AD39CD5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV06DZjh9LoQ7kNvwFWCmp8&_nc_oc=Adp-FYHdWC5nkrFneHnJn_WT6NwZzAsJUn4OfV-QhtgB2q3GOkgUcvJSgD2ehc3RJM8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYNjeXL4Bsc6Gluqod74axJZ3aAK0RCgswUQvYLnJ9Hg&oe=6AD3A81D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRJiO9RQI4IQ7kNvwFUYYaz&_nc_oc=AdqB_H4XTlvkafHTYPlZSr0GPaeCbVOQgW7FXAvJPGgmlVajqTded0bhvTowGnYS3rI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIHUnBzW-smaSGc2KEjK3QwmK0Ra7CRrxhRveWB4_QwA&oe=6AD39C78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCGnOFxJ4bgQ7kNvwG_k_u7&_nc_oc=AdpFpBXIrV_imHkAXI-8mc1yrj6wG3mpAiBV96fU4kpc8s66J3p_FRyhUGRYGHwlPD0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO7lxSeXZyKav9ePGtS6A7V-8OATg-tAQHhc4nY-iKgg&oe=6AD3983A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
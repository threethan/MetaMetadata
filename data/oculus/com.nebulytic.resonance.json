at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTZZk_1rpEwQ7kNvwE2RqiW&_nc_oc=Adqa4j9VIRuY7agZ94sVfc71or302cd8IPDJ25Wl_frtbNr7NwipJfkvjapMoPikFng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx5pSOW9dfWtN_X4Fy3sfhE80rztxe-htBRQrYCPuCzA&oe=6ABE6645"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gOVSW33_oIQ7kNvwEcZfIr&_nc_oc=Adrw2iWNQyGI2-Imuf2JgUNqkiyO3zkLsAJ2y9eB7ckoXLol0LrYtjM68Awjb__F1gA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf8TZDQZh631jDGgjljdLPfQ1nyaRz51_sA2vVkeaE1w&oe=6ABE84D5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zc9i3wsPegUQ7kNvwED1Dp1&_nc_oc=AdomM0QhpcOVM6ykvema9ubbVvq2MEMts7Q0wcYGSxF5jjGVN5GVxME2vHjKEGwmICE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsuS24rPbyT2ue7W-N7ywknBmPGRhykgQjx5m91edRxA&oe=6ABE57DD"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GSGzH7dt9AQ7kNvwGpA2K3&_nc_oc=AdrLCA5amLC-QLf-B2n2lmTBaFUYtsmLVh-fEpSleGi69rlTcIeu-0LPqMEkFD_I1P0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3wpbtt2RwGnrSaJJAJUnwjnm7o0sRxuZ1YFbaageNog&oe=6ABE8478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IQwDnJ9ydoQ7kNvwGkTTpq&_nc_oc=AdpxbRSwvG1JfAkfUQ3uSVHe2Wvv25yfPI-eYQo8fPDXOK7XOC4J4cBPRAAR3-NOcLw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGOGgCV9Xjq3jzBcUj9tlX6iZa2naLDbecZj1ptbK01g&oe=6ABE803A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
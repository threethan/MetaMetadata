0264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av5uKL9a7BQQ7kNvwFgsbzN&_nc_oc=AdrdzYW4zsv8FsaQvL_lKEunes6LJoQx9xsHyo_PdD3cHzGCFQaG4TXWJ4fscYrBZWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOWZmrH56TN6DTgPwMgLvTRIqgBswAjrdX7TOUiL0DJg&oe=6AD22CC5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niWeVXah1NIQ7kNvwHNKwcU&_nc_oc=AdqvM7-QtZLl-8UEb70Nf4jQxUP7UTFPS3L7A28yXAxbrkqSrVs-mIvZHdSW35h7v38&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6vEJ3rv7qlzyMzoP_H8yc4vkblZuHjQjoJuDy3_g8Cw&oe=6AD24B55"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTtMFg0bVywQ7kNvwGG4dFU&_nc_oc=AdrWPHzzEsf1jQJuBrLnHm0LqOwCcAwcIpok6El8rzAHXwgOYtiJBVU-DsOGkettGkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPklhD7wtvBNkx0lZZd9zwH3u58d4FaIQbNkuFQFaercw&oe=6AD2569D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRJiO9RQI4IQ7kNvwFEHcah&_nc_oc=AdpEOCYNWIa547-nCj4csAP4oRFk5C_hI4SxrJRC1bFkk7XoKn7x0Mzt26NGXnwXT_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0hqxAI6R-845aoneO7uCC0CeS3iHbk7b8ojg-9f8zXg&oe=6AD24AF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCGnOFxJ4bgQ7kNvwGrGEhZ&_nc_oc=Adog4wjp4ZbM5E_bzWHby-_3LjC6JtuQwGReDEzCvjnWxB1-Jwn6v-l2VUYoat4-M0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeX_j6wrtfZxrQzLw9nvtgGMnS94erns-MSpZwU_5pTg&oe=6AD246BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnhaNardZZ0Q7kNvwFuyWf-&_nc_oc=AdrTnW_ZhATuAM7hCE_AoDo7y0DaraZLMYBLHrj5BxgDJ7aJfCnN0LKCr5yhvJVwbnk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoA1cdi2IAd9EnTVnbJe45Aa9cz1hHqub4wbuAeGKlSA&oe=6AC3AC45"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkle7-z2ENAQ7kNvwFJEGOH&_nc_oc=Ado3GXT-HXXnqvbZdRtm5H5282kxljUFxodw17zBBAbyBz0Gn4SzLs4hBAqmu72EqyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6oPwJ0dOCoz_UAqAQq4JBV7SZzv7wDorsoAYDniYHtQ&oe=6AC3CAD5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJKaJxnQSo0Q7kNvwEgf7ym&_nc_oc=AdoHCHaeg5fHctMsc_ltmn__hdKDXzPFsRXAtL13dnFI_u84OkyV07YLkuzxgzR78IA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrWuUXCwMxjrSgqsB1zGhIcuF4JicArbt-7-bnRwoI3g&oe=6AC3D61D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMCq6VuC0QAQ7kNvwEusru9&_nc_oc=AdrOzipwtQFZ6rbUx6dNAu-nuw6g8nCCzYBMg9nC64ulIWu6FFzb29usQ3z3SfloftI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKbsYfDeVmxqNg824mN_sb6Hd-JU7v9IPEhSCz8rcjNg&oe=6AC3CA78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB6_QPmXoFoQ7kNvwFXJeHI&_nc_oc=AdoFXq4AtP5NrysiOT-wVf0WnriNYbydzIjXF3efJJLKrN44Q47rKT8U0cUYv7nRIq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFWVAPMLWV1pbRUwqMiGildFvuX-GvDgh04CYzuoP0yw&oe=6AC3C63A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
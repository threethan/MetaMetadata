ZUt&_nc_oc=AdptCH5NK1cBIHKjbZ609ru-kzt7hDR9V9KM_ykn7OeE_TSkf5X9SpLSL6CZnn7HT-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOpczz09K2qCTA5NEkXHS2qlS-39yJLP4we5u4EIBcFg&oe=6ACD109D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6atKaIVsi0Q7kNvwGk9Akt&_nc_oc=Adqq-1HJawSF-Vcq2afwXmF-dFVP_Liz54uUpf9n0Ad-7g8b-9SaN-QQm48tzolkenI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1s3RsoX1zTjhgI_14kJMB8BRs3DfcMwilQBhnraKHQQ&oe=6ACD04F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7TNeQNq6lkQ7kNvwEpV8by&_nc_oc=AdrvYqNQjCn7KzqORv6IldUkRb4kUoig45ffZFzJx7kEo1UJS-l_4EnbUsZqqgIeV20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuVupIwJWPoXS3zOvErXt8noAWD5sK7PJt3k0HtWZNAA&oe=6ACD00BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1332176139978406"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1982923082405842"}]}, "baseline_offer": {"id": "1982923082405842"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790461560, "status": "PUBLISHED", "id": "1982923082405842"}]}, "liveChannel": {"nodes": 
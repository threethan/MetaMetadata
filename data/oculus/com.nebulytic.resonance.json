at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTZZk_1rpEwQ7kNvwHIxUjp&_nc_oc=AdpP8zen2X2oNUoP0qR8PMtXWtRvys8S6_2sgDyijec4KgHuvxvagZmSiVYUvdB8ioo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-muh7FqtKu0ie84uuFocHEku6jpsGrKO6Fgp284RxZw&oe=6ABFB7C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp8a17wt8V8Q7kNvwFdhvIG&_nc_oc=AdoxSbsmQP0SqK7qKQ1Gw5OmdLUX0Gsqe2KALUYpBSY8Jpf8iQSXssN1855gQlBAe-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw8xTVmUBzH5WGHPs9cVaZxE-vyUiCu6Jqc8tpcob6CA&oe=6ABFD655"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJcqjbhJ4igQ7kNvwGPqzQG&_nc_oc=AdozGbnJ3QPIVJiAsGj0-3TcziyxUzJpD7NEXEjSvbJnHCRxBldypD72sEXKUAswfks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFjoLs4KUpM86nzZI4DKuGLSJ9OcCyQPpTuOvtt3h5gg&oe=6ABFA95D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GSGzH7dt9AQ7kNvwGUI2oY&_nc_oc=AdrB5mO9SN9xjwBd4X7eUzIZdLcXpwkI14AK9aqW7vcZtyqoJ3g_agdY63gQwh92vcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6fxWdxbdU26Nhfl-OZC1Rx5Qg5ON6jA1qwZON24QggQ&oe=6ABFD5F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IQwDnJ9ydoQ7kNvwFMlL-x&_nc_oc=Adp126w56GhrJsF-wYkDoG7tTBiOQKNGOcgKkh4riDqME3yu44qCSl7YI2X_tA_YTCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQKyPmQpUTREMfhjF7QP-3V66hq8xxYN2_j1t3t-WT3g&oe=6ABFD1BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
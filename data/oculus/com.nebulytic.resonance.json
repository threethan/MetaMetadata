0264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTbgOVeJExEQ7kNvwEgwQvd&_nc_oc=AdrttwOp_cUNn9bAODjNWlIaKVGwa-_cOpFrX9VFHnqk0-p0hLWjhrlQcU3bKHWZojM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPifdhIcZnHzE8z-tj_b4OHlqTmocDTbruhf8uQVhpUaw&oe=6AE1FEC5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqy069jRQycQ7kNvwEw8vpM&_nc_oc=AdpRFKT7Hvf1qzxOlcAYw0Ek_X6BPjICWnKBtx7Kg12lIlXztdT_q6y3lDaLrMWEWJ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP380i9TEKpc748iVaOJP00gANZR1boZUUIG_YJvzOqkA&oe=6AE21D55"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tVzdv509I4Q7kNvwF8SKB9&_nc_oc=AdrcJgtj3lqhoRbla98VmrL1cRGzx2UcgIoIBqt8SdmWOuLVSWC4ZlXKU4SyYSPpvxU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjvetaPlWAx_4wx-1ScVg2mA-3F00MobSlnSsqi3Fv1w&oe=6AE1F05D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S6nuBFke90Q7kNvwEFPSJ0&_nc_oc=AdrywOTq-x6zULEkbNRUYRC5dl6tnU-VcP_PjSnCfgP--2EvZllSUwGVEYiKJXCqeEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdXZt_dkaLpEFvWT1zczPBHTgKmt4jespwJcelxZcr5g&oe=6AE21CF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziGveHPtI04Q7kNvwF5GoQ9&_nc_oc=Adp6PNJEh32toFSqWN6HP9gFKFKbRZGUDJsS_lYfdPkrZ4mGO33gGS8jhFIX58Mi9oQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdXD6K74GlmpmTVElrnwnAk5z9_ruhvS8eLRBcHmqpIw&oe=6AE218BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
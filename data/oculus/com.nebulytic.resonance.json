at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnhaNardZZ0Q7kNvwF6nonX&_nc_oc=AdqFYqNDCVHnqL2BFjr8RXXCa8rLU2nQZTrl8kC3Aq6w-Lw1fshL_fULuznk5dUuUXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNksJgjwx6OcG3dToH2lU3TQAuN5TAx_RhLRrziI5WDHg&oe=6AC25AC5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp8a17wt8V8Q7kNvwFntQi8&_nc_oc=AdrLfHu-MCqVNkhyqTBqyo4cpzm5qDgErWBYWYl4TVTjyIqPw7PeW-PJ0L9RUrjFU6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0e423hsNzPYGTbAxlCzra2SHtXrctJwMdtQLHuHJtfA&oe=6AC27955"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJcqjbhJ4igQ7kNvwHI4LiT&_nc_oc=AdpV31sfUT55EYVpgnP_FaAm4Pqur9_YwpXMJVjOmqSTSRhxpHjRrQXWq1gIsFnCYd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2cYLCiQE5PdjTLD5HDTOu85X3qXijy8mN6ssE3An7sw&oe=6AC2849D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMCq6VuC0QAQ7kNvwGxoGz_&_nc_oc=AdqLibPaWYunPbrp1_EF6j_KQ5RzOrxhCvQBZBct-odujihJhzlTcBUcVr3KIf67ZZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9cHGGl4hUVBSTXreZ80sdEq7qM7jNBf7xrV6bH4NNhw&oe=6AC278F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB6_QPmXoFoQ7kNvwHYwjOi&_nc_oc=AdqpUxSd-aKubrRzeMV3q85u02gx6ac7HxUPfuzQobTwKg4xLUiI8R_QjH1HkKk1lWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDj0yF9Lb3RAfBFbxc-s3dCX5_VKORNByR4Oauz6MCOA&oe=6AC274BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
tent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIjWIxaq1aIQ7kNvwFQ4p1X&_nc_oc=AdrCVOAd90-g-zljl3acjCGQBpIyBYsJJQ5XaFBXgez6_g5dNXmjQq780X4ZVl_DTss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXSfttjpMNPtfkkBit0aVqInylG0eTpZ_Mm8efmuY7Hw&oe=6B0D9ED5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIUmdCk0t70Q7kNvwGBpTsJ&_nc_oc=AdppkDmdCmo-7KsEWqSa3n6ZRx_0dUhudNdKpSvNWcKSw0MfX6R9CLpuAOM6OQPf9CQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_4Qv4Is8mjxkgV2XNkAlT7nkzPX0PrWcsR167n0Ai7w&oe=6B0DAA1D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP1U1PdllZUQ7kNvwEVA4wK&_nc_oc=AdoIJ3VD1xr8plCedKG2FfyzcA7EJctZiziRtkVWoAA4VfRoM-cwPZ6A3xhTXf56jiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTv6AUFoXocF-3T9Hxki3Hiwir7bS_DleLXDoriz1pg5A&oe=6B0D9E78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=funqqNpFVKIQ7kNvwGOJp81&_nc_oc=AdprJBFv1es1DKLBd2A6zS_6CIyBdXjzp0nCk_5WM8WxxIDn4CbJcANugRdKoReT4G4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZHeThDcxriGD1phwaJemksfnUYZtoVUzVqDtBfAY28A&oe=6B0DD27A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
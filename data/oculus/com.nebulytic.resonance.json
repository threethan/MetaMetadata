W&_nc_oc=AdpopXLmQ214-UY9PIgCmrr2wT08f0ZvsxrxMUKUKYct5FvTy7wbxB9oAbUrK6fHXQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpEaPmR4T_NsehJYqRsZ9bAfeqPWjMYXY9mHm0dnk7hQ&oe=6AF72C85"}]}, "id": "1079416588197240", "locale": "en_US", "screenshots": [{"file_name": "04-4-9.png", "id": "1816753419329829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1816753425996495_4903634210913859989_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdyJHH0rAy0Q7kNvwEkuT90&_nc_oc=AdpyqrQqsN5N5ETrLTqwZeSVPP529Fg5450YKq06YREWl9LCGLkTxE8LgO51oRu5VFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSohz1MrptX8fr2sijUxSWWFo0qRVsCbJqq_n7QBIGE7w&oe=6AF72AB5"}, {"file_name": "05-9-7.png", "id": "1126139396420264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfvguoUijKcQ7kNvwFTiNlN&_nc_oc=Adpn-122CTGGAdX1X9S_v-cUYy7JljjM5op0hemJSAAY65SwawE8d94uFOnBvPJzJ7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlu4O_uZvvbEb2goqS2_s9QOy9aSScHWlvi7dozQeHfQ&oe=6AF716C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5CAPhmWNV0Q7kNvwE2D__B&_nc_oc=AdqXLNRUJLOq3Zvucu-q5qYrucS6jGiKInWI4z1KzPxzEG2R9qHDzLFdjLhzvR6Z05s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBv1U0zTISXaxwMbwbJ3cNaLePs6R2tOqox4TWQtW6oQ&oe=6AF73555"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRPlw_BbXEEQ7kNvwFoy-XV&_nc_oc=AdrKchIMS2yN8L1DDNFsDZUVB3_VzghGLyrp7xrEZNpR9kwalfBKxo5Re95sVBxQBbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1SZhRduXnuYoIcolxVyKQhLArYKYnqygkHdmFKd8q0g&oe=6AF7409D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoT_E1-h88AQ7kNvwEetJKM&_nc_oc=AdqkyNoO_fvVkEFAbDrQjembE-9hMIHzDWbppjvWYT9gFDfak5uj1QwWu0Vw4CFSbo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWumOzjpTT2DMG4CbQffMcBhhl2tO3vFB1qdLkwfLxnw&oe=6AF734F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDAcpcwesOYQ7kNvwGwMxrS&_nc_oc=AdrHr4LHJ6MGcB_oiLfc2kIspvBl2IcbkmhLsuiA8OGTz4SlN40wEcbpqjwHXh4FNv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6kp8g_WT40yMj5RhttwUgiHJ1Vv3LBxmuwT3lenerCw&oe=6AF730BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1332176139978406"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_2341447906658812_4395099943094571384_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDpGGuXniPcQ7kNvwHI94rv&_nc_oc=AdoXoQfZR9rnzISiaYjoLfSDt4PghgRUIDd3Cyw_94wfGgPV1DYMJZqzYFp9zCddHHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRON96F-wwUM3RAd3onlsAN4Nk1iicWejEd7IEMs6ZJbQ&oe=6AF73016"}, "is_concept": false, "is_test": false,
0264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlbSI0c8qkEQ7kNvwGnuQhV&_nc_oc=AdrkDX0-kPHiEUcWxQOhr0DAXhGyu-pExuXd4tPUk7CXhy9pG3ymAOstv4E4KIbNnxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-SKBux_fc-ZkqOMPE9RNE3xAwStaGIuQgdgUcdBxsGA&oe=6ADF5BC5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqy069jRQycQ7kNvwHwvQ35&_nc_oc=AdpDWGt74cqmdgkgHwB59F_KXZOWBhtouV1ZUwDgKi-HEdkIDNEM1Q8xWXHmL8WVUQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtKB8Wr14yUw7KvZiK0GWqd0UJyPUQhBwSAaHexOsA8g&oe=6ADF7A55"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tVzdv509I4Q7kNvwGXB3RX&_nc_oc=AdrQyiaKeYnXyIfNXY9qDqDlt5Tt_oYgPVdAVv6r5WXkIfdPm6q4IiJI0lnF5PbRByU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAmGjRgyfgLdspVWlzJ618CSFXqG9ujvsR1GELW-rw1w&oe=6ADF4D5D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNgK4cxSPdUQ7kNvwFLRkZ5&_nc_oc=AdrescDQg21q1HVl5yVvkpRUhnzqXfXYgq0ep3D7m6KLSJ88Z1KwT1bh9v2c1vMsVQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4oYR9STZVT97jeqqQHEpNBHfrQMXvvjoMRKYcQ5saow&oe=6ADF79F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUMU0N3PDmsQ7kNvwFFgwHO&_nc_oc=AdoDc_-2YjNaeQlhuLKaHWq4WGsTXxUbzLQHMqlbNirGN2bNH7LR0lLzdiuyihNKFYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_MsyYv-KLwZNhrLDVtYRRQLzu3oHIXfM9ZxrB1h913A&oe=6ADF75BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
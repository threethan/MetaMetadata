0264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dl86xRdAREQ7kNvwExs6xT&_nc_oc=AdpYqtM4wI_28ZWMqncyjfFrZRlDcOOgdp9_RIvn4VMcAB2rTwJH4Y50Zl4WQCvwEC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN74OzJx0MoDn_ZaEm9_pnsIUSygT3TfhK_tUDSVektxg&oe=6ACF89C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niWeVXah1NIQ7kNvwGPuoz2&_nc_oc=AdqnncgU-1FMGwFQoSt6kcMRqNBBuS7Cwe_cERosQI_KpavObz89ItE3E5SBk3lt1Ks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT3xW5YLC4beDU61kuh3OYzBaEN0DI2QYFFGWCc346gA&oe=6ACFA855"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTtMFg0bVywQ7kNvwG56us1&_nc_oc=Adr6u15ObbtOSc_ZuiVFRVrXc8PORB8g6pLnZLYFvj3oqTrvO8h-FR2QTz-jT0iEWJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhRCzDyV33vAJb784ByXRNDnxDvFvWLvRXtpr6vTqqwQ&oe=6ACFB39D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJS20BT1pWQQ7kNvwGQC84D&_nc_oc=Adq1L9tzeoUZ7V-tUh6UOzTuPH8p5IuazMJhNuoo_qjZaukuvVHy2GLh608C83d0ebY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvnUTT-bnM3AQU8Z3IKScmYZa_2FfA70nx4PxvcaLhUg&oe=6ACFA7F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdOtDYEvB10Q7kNvwETYjJ6&_nc_oc=AdqN1uxfUrIO3V8I6_ZwHj8bY4B7MoJMM1cPVckU3TfxRYim0LMzMtiEgxR3yyBbUKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXeCOKlxRxTm9l250UW0X-roAyiD2madHNB_0vlsg0Pg&oe=6ACFA3BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
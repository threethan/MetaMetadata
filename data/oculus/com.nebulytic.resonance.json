Ho1Uvi&_nc_oc=AdojvUCSLWdzrfGzGtb9LvuLwXIdh-TN4bsKvQXLUZk6uDJ96medA7E3uCTtrwdlx60&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU1MxeHeIVNjODu5Y1nTu7sGvFQIsfwoMVdkHRAlaLWQ&oe=6AF9B9C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5CAPhmWNV0Q7kNvwG1Bvy0&_nc_oc=AdoVhhNGU0v7j9Rvtg4uKW85zZHlkUNDBa8Sba-OtMfJoQ4gMfCi_VxY1PI3SDGJ8l0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_hzI95UBX_TSs1tpPM1xeD36eC8ID-IA-P2ZYt4EMtg&oe=6AF9D855"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRPlw_BbXEEQ7kNvwE9f2Ei&_nc_oc=Adr05UgWb_OwJkkg1cFhZIi7_aFFjRuARYGa6w4X-TS16h404GbFwrVAzJaQVIDBAbU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrm2TgZVWBRNYEsrMTPbwe2vvJax8UPpNp9CeRRk-5qg&oe=6AF9E39D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhVRO0evxiYQ7kNvwHIQ_j0&_nc_oc=AdqLv2ZrUUf_n45l8F79B-i9T3-at1QsetcaX_G0doKT2VhQ9ENmosuzzdNCu4ng99Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Y1WpjCRfEmH2JXk0JEVVhhwic0dBqaENfXai5k58vA&oe=6AF9D7F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nRnh9T0U6kQ7kNvwHqrokI&_nc_oc=Adq1E6bbWoUQftD17UDk9FNQyim43IA0iYukkP7b1HV9xZYn--d5u9iYRbo1XsGg3kg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmhitG86h9QYLjNCpBr64uHPjfzOb7bVnDk-tgKmj_Bg&oe=6AF9D3BA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "cont
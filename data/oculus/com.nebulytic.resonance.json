17027516026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaXvVvRgSugQ7kNvwH_ngAE&_nc_oc=Adow-y_ORAxFjESBg4CvPm_RNMLjQNf4fS8uJQ-q-h7oX_WBYoDviRZe8JDfq1Q6k0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnMrkN4-8afT4CXxS2Lc8pp_Bo6vsIDEJ4tXfYwonpNg&oe=6AF5E3D5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig5-jHdWfbkQ7kNvwFidxL5&_nc_oc=AdpPWzX5ORW1BQvFaPWTuYFA1HyVvotpoC_4d4-Fo9BaRY9qSgo6EFzLicXuoiOY_bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAl-RH41Hn2Z5XqbTZFGNvX5MoLNNMO-RUIgtjkpOqKg&oe=6AF5EF1D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoT_E1-h88AQ7kNvwE8QGg6&_nc_oc=Adowj8FARGfEMATx3cPsGvZkzQ9huAVLQopSAa08AC8C1sJWqpvSlB_zJqzKma0tQPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq_N1a03CW5UDmMyveq4T1jCNRv7-OkKElZvgxZiFbSA&oe=6AF5E378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDAcpcwesOYQ7kNvwGlLJ0b&_nc_oc=Adp38Tsfm8HImfXFX-PUyG_6WF3rewcwzkaAqh3BbYuYgoj8Vt-JVgjuGwyouxkB0WI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8vHupyO0WONhCSt6u-Kuf0yb4aoL25RRqRqMZM_bCbA&oe=6AF5DF3A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null,
0264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTbgOVeJExEQ7kNvwE1Fgic&_nc_oc=AdqBysnsh1_Tbl10rRiWfVbcDKeAdI7j_JscwK-qlGY_wAYUjJdhZ-tYxjvj2ll_eaA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSKQA3qH3FHXvBE061MVceD-PfDMeFLZvYAV38m8yDUg&oe=6AE35045"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYPsrm2wH9kQ7kNvwGoWHbZ&_nc_oc=Adp4zc9UV-KFQWfZKvu55RtUDXv7N4kR-bIzzErqnxVgeezbsaf75YMNpg2mf830xq8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOse-R_Z8tMEPwzx4SZlnDUY7latH-a-EYkuilkjbMiFA&oe=6AE36ED5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y1LBfhdGqQQ7kNvwGyx7iD&_nc_oc=AdqOA2SI_kzklRs0YZJ7YySvJ3SbOhM7Q6T8m-17BkuWg1AhFTUSNhPa8_XHwKUqQxo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX9l-yr1Y-uky6PPb3YfIP83vzbH7-oFJ2IBGy2MmkGQ&oe=6AE341DD"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S6nuBFke90Q7kNvwECo_Ai&_nc_oc=AdrnIAz-ZIidwZSJ4W6RQPdApZNSE4PgzdkUjKwKY_-iFwk5d_kRCZQVzQUMA1pB_vY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKBFaL0GbpC-R6Vu_KE-huYU0hrpng8IxmjLGiooFQiA&oe=6AE36E78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziGveHPtI04Q7kNvwGXVzEi&_nc_oc=Adpv30t4TJ5mASRZ550etH9JN4ejij3Ih5pef0ByjVNdUU2116R142GCN8K5rrSScWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqSZxrvIwUYW6bLvJ34hcVX6LSjrhoI7cJPrd-UeE9PQ&oe=6AE36A3A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
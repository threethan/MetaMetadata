at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8eAXUDrk-sQ7kNvwFEMQ6B&_nc_oc=Adr851fjzVbMV2zNLb-N2BkwzvwAE1y22VF1BqFOkfEj05-tsl-c1rNvFUBcVs-0aAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQFE3OoYZWAjHWkFHYEU_N_QcNPzNZrFEPxwJxeI3SXw&oe=6AC64F45"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkle7-z2ENAQ7kNvwGGP34Y&_nc_oc=AdpLyj9Wzm_6hGj-QKcBDgeyc9yk5ItFvq4utbzGYFqoVeLw6K-h4LbcaOilKzg-F50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfH5BlUhVSPT6_9d8qZe_-SkGkMDrZmzeXVtww1Kb0dg&oe=6AC66DD5"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJKaJxnQSo0Q7kNvwFQB-MZ&_nc_oc=AdprRWjniqQkf_4qa9LwsYH-upNHotm5x2zAkqi9ov4iQLBTs0VNL_KlaJMeSPziB9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-6gv0AJ6DYKP8l9k9GNc9vufEvUKUANxcpPtv-NCnZw&oe=6AC640DD"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_Sedob2YhEQ7kNvwETOtZp&_nc_oc=AdoFrem7R__vj0tpYY3U8tp-PGYxKcMDYh8i97ydZKMeY8dTvWR2hPGwvPJPMpQb0Fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRU8TjJUQvMuMsgCD-vj8-kjl10GkfTpIC47lrUnG3DQ&oe=6AC66D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ4FeN2VTFYQ7kNvwFrqNt7&_nc_oc=AdoYYMeVHyUgUcV3EDcvvQHDszIQ2XlFognq---WBIUxFqGZWuIKojyPxlnDESENiXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPMdTLaOuC0j2zwEMzk0yQxTviCVUbTT6kFbriSKbJeg&oe=6AC6693A"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
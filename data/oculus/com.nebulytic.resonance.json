 "screenshots": [{"file_name": "04-4-9.png", "id": "1816753419329829", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1816753425996495_4903634210913859989_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuAiKv7fgrEQ7kNvwGu_v9s&_nc_oc=AdrRKpkBCGFCKodHzeHQccBrEMsXtgdSFJbmcDxfYbKPbtSEzI1mkelEre8LU6OG40o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdqIZ6xtefxpI2rfPSatiXjNgfm1GVTh4ObdzfDJI9Eg&oe=6AF1E4B5"}, {"file_name": "05-9-7.png", "id": "1126139396420264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fbV7si-N34Q7kNvwG9U-Il&_nc_oc=AdrFI3eNj7gOuP_XSlGu-ndmSvYG8o_UTk_Ii7Q3AfUIkwKRtUIBBO4JN9_ieij0Brg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3hnzlvEMrShCRi3JFJiWx0Fx3scsp2aEy4h1k_gVW5g&oe=6AF20905"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVLqGUu18UoQ7kNvwHUyyQu&_nc_oc=AdresE1D0cscuU_Ds0e5mvhPcQUC926bXImRDH1P5FI3pDSs3z_pu0rkrOttBQlzpdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8j-nZ7cPNYKk8F5zlSEACQYejXJYi39T12EylkCOHVg&oe=6AF1EF55"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uVou7mUC6AQ7kNvwEPgEtV&_nc_oc=AdpKtQCDYlPSuqwDIm4fk5PYr7Ik_Tg9H9C6GOAGpGuNMQ2OcalSvUCzIwGEYY49Xgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwfAYS1grtXnQIt6fZ1jO19Lar9XLz7IGZJkIhPj5R9Q&oe=6AF1FA9D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-50dByulpcQQ7kNvwGug5Ys&_nc_oc=AdrFLgoNmd-dPoqgTJRynEb1NRkDc2edVT6iOTPeIglGgpKGLcwkvufHYcwV-hsTbIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_v5tUetYMf8L2VLHEbbhGLHvEKrbzc17jeE67MdLjyA&oe=6AF1EEF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mPT13EY0iUQ7kNvwH8urms&_nc_oc=AdrH31DsWJdmAk7T4j5lxDc7YmmArwElYCKeU4YegEpFnMKeIBbHRSIkTNJIrmY4p5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMLo9rHz86hBRyQtAXp_mC876v8RBDvmBZmyJLDg29BA&oe=6AF1EABA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/apps/resonance-mri/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1332176139978406"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_2341447906658812_4395099943094571384_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awfj5skxTfAQ7kNvwGcx3R7&_nc_oc=AdpGjFIEyliMLlzHYlmTacWsM6E4cQN7AbTTqQrhqm-CYAvAWdd3GslP_pgS_xps3ds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZyBuUq4evufHZabdq44IN63w7F6kI8ANp2EIz3TEXuA&oe=6AF1EA16"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Resonance MRI", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_n
0264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1126139399753597_8574293823866681376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDEQYhdBWQ0Q7kNvwFBRQT3&_nc_oc=AdookFN_DnDb0SsMPoMf7_6NTXdYBlQDWpzx6_z5D1uRn36jwjzE49FEKa7ibHO1F1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBjNftXITj27DmnN-QMMTCxYUGfvw820LpLhy3E7dyTg&oe=6AE744C5"}, {"file_name": "03-2-30.png", "id": "1445817027516026", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_1445817030849359_7225642583361889890_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oxM-8FvL70Q7kNvwHp79Tv&_nc_oc=AdrJa1FKirqUp-xdPP0vXMobr3esZ-52CWo66wdpfh1Lq4Z_SD5U_z8A-G07tCgHq6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXeKpKTh1jiFjkPr9guZ2ANeLyMVMxs_fKZrwixS7ynA&oe=6AE76355"}, {"file_name": "01-1-1.png", "id": "1488712559683294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1488712563016627_823327239163959001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMd9SC10SIEQ7kNvwFX-AQc&_nc_oc=AdqbSGG9cJTcyH_68eFsIlLSSm8-jasPojXd4uGxQl2-2cmHrxKFoXhtlWdBlbiskuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNwQN3k8Dt6-O-JI45-88QLEvz1RAjd9NZPVGy6R_xxA&oe=6AE76E9D"}, {"file_name": "02-2-18.png", "id": "2619737835209074", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_2619737841875740_8767653288582655541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9dVYs9m0dsQ7kNvwEu6T8T&_nc_oc=AdpSVZY9AUdp5lorjdGw2GkQtPyADQAB17aV28923huJAtg3t7WfwbDMN9IKLcOOoQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-D_qaN7Wug8iw_JD2t_74O2LNvgsfBfNIC7Xys1TTUg&oe=6AE762F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3161291127394217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_3161291137394216_977590643166855885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQwHuNatOVkQ7kNvwFqMLoE&_nc_oc=AdrnQ9lF-4ialmZP2PhsAGKSp7iJt5Py8ONSXQ5LNQX0DFo4aHdmjlCqymmlR9gIJh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8UiGrqiKq6uF8DppBdfPasWL4bV-81TRlioicI4yijQ&oe=6AE75EBA"}, "display_name": "Resonance MRI", "keywords": ["MRI", "Resonance", "Imaging", "Medical", "Learning"], "long_description": "See how magnetic resonance becomes an image.\\n\\nResonance MRI is an open-source educational experience for Meta Quest 3 and 3S. Place an exposed-coil scanner, an anatomical hand model and a volumetric moment lattice in your room, or explore them in the app\u2019s VR studio.\\n\\nFollow guided explanations of static fields, RF excitation, relaxation, gradients, signal reception and k-space. Inspect a 6 \u00d7 6 \u00d7 8 sample grid and compare the laboratory and rotating frames. Watch the pulse sequence, received voltage, I/Q signal and reconstructed data together.\\n\\nPause, scrub to a point in the explanation, move between sections, and choose 1\u00d7, 2\u00d7 or 4\u00d7 playback. Choose either of two narration voices, mute audio or use captions. Move and rotate exhibits with Touch Plus controllers; hand interaction is also supported.\\n\\nThe hand and receiver are computational teaching models. The app does not scan your body or produce diagnostic images. Its public source, asset credits and improvement roadmap are available on GitHub so learners and developers can study, modify and build upon it.", "short_description": "Explore how MRI works in mixed reality and VR. Follow magnetic fields, hydrogen moments, RF pulses, spatial encoding and reconstructed signals through an interactive educational simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/resonance-mri/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/resonance-mri/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/resonance-mri/support", "website_url": "https://nebulytic.com/ap
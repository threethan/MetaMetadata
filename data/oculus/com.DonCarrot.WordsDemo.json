-AdOwZXkxcG08GYKclBIFO3DbRZg&oe=6AAC0CB3"}, {"file_name": "Screenshot 2067.png", "id": "1487317732748061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_1487317739414727_4441987301379278799_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGt_WI5KI_AQ7kNvwGOdFhr&_nc_oc=AdoYbFVzEr1t3uQmSNvUlgmT_AoXs2gxP8zGGVAkAqdO2qTu-6X4j7jpvYi0WFdVPvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4s7_BUclHkC4vn0a4qpClYWpao8o8LmDCojKeMr14XA&oe=6AAC0B89"}, {"file_name": "Screenshot 2068.png", "id": "949692957507598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_949692960840931_3989156488311187566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHurFVrDx8cQ7kNvwE8NHKm&_nc_oc=AdpEzKHXTgcw5kx98Le6AjjzQaWWXE4ZtpW2TBsSSiJwVZv0e-lcsIyaEyhV7-jkdLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8uP3fycs4FoXR6q4l7lToTgNUp3m_UoPwoJBHnLHxiA&oe=6AABFE8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Words Demo", "keywords": ["words", "search", "find", "crossword", "puzzle"], "long_description": "Chain letters through a 3D grid and hunt down hidden words before time runs out. You\u2019re drawing a path from neighbor to neighbor, trying to spot what\u2019s tucked into the layout while the clock keeps pushing you forward. \n\nRack up a higher score with longer finds, watch your progress climb, and tap a hint when your brain goes blank. You can also move and turn the board so the puzzle sits just right, great for a quick word game break or a longer \u201cone more round\u201d session.\n\n-\nWe\u2019re shipping this as a small demo while we learn: themes aren\u2019t in yet, and we\u2019re testing layouts at different sizes. Tell us what worked (and what didn\u2019t). \nIf you are interested in the full game, sign up on our coming soon page.", "short_description": "Chain letters to find hidden words in a 3D grid before time runs out.\n-\nWe\u2019re shipping this as a small demo while we learn: themes aren\u2019t in yet, and we\u2019re testing layouts at different sizes. Tell us what worked (and what didn\u2019t). \nIf you are interested in the full game, sign up on our coming soon page."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doncarrot.com/legal/words-demo/", "developer_terms_of_service_url": null, "publisher_name": "Don Carrot", "support_website_url": null, "website_url": "https://doncarrot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25889518770748388"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1657303765717006"}]}, "baseline_offer": {"id": "1657303765717006"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774034640, "status": "PUBLISHED", "id": "1657303765717006"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25889550020745263", "version": "0.1"}, "id": "1646003973513683", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25889518740748391", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25889550020745263"}, "release_status":
252_9015845141139880288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w9cwUmaGlQQ7kNvwFs5DI0&_nc_oc=Adp2D2qc6CQhcDpfvohqHmuHxhyiizsC70k8D9JZyohHShNJzNaZcC1xM_G84EbFGx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNwmj_okWKswuFjLlxmuMcdMfBaXPdZfNi_aUKz2rJig&oe=6AB3D426"}, {"file_name": "Affinity 7_Custom..._03.05.2026_23-20-57.png", "id": "1665092607946770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820983_1665092614613436_5905164905245809308_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrWSMuq1urMQ7kNvwFNxR9r&_nc_oc=AdriudT_ttWktpfOkq01b4LV4KWvvvdR_-AbrDE5tZS4W6pPKSHvUan9RMTiMNR9L1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwPREkMnGN8EUEyAn7DxKHXDlvgzqR9u6BJ7b8rih05A&oe=6AB3F8C7"}, {"file_name": "Affinity 7_Custom..._03.05.2026_23-22-04.png", "id": "1350029070301285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304938_1350029073634618_2961789013921746152_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSo2pA6aEDUQ7kNvwGiOLw5&_nc_oc=AdqF-JtcpfTuySmJ-xl7FHfvAH7IKMLtyYW6tZLBWD3DoEY9xBxrxghzRHSjLN5JSaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg649EBU8WphGIxK4GwfeEpM-13tqJ3OvMSM0bUJvbEQ&oe=6AB3F2D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Affinity", "keywords": [], "long_description": "Affinity is a multiplayer horror game where you can jump in and experience the fear alongside other players. Explore dark, eerie environments filled with tension, mystery, and unexpected scares that keep you on edge. Whether you're sticking with a group for safety or wandering off on your own, every moment feels unpredictable and intense. Each session brings a new experience, where the atmosphere, sounds, and encounters create a constant sense of unease. Work together, react quickly, and stay alert as you navigate through the unknown. No two runs feel the same, making every time you play a fresh and chilling adventure. If you enjoy suspense, teamwork, and the thrill of horror, Affinity delivers an experience that keeps you coming back for more. Step inside, face your fears, and see how long you can last.", "short_description": "Affinity is a multiplayer horror game where you can jump in and experience the fear with others. Explore eerie environments, face chilling moments, and enjoy the thrill together with friends or strangers. Step into the unknown and see if you can make it out.\n"}]}, "developer_name": "CBS", "developer_privacy_policy_url": "https://sites.google.com/view/affinity34/home", "developer_terms_of_service_url": null, "publisher_name": "CBSGames", "support_website_url": null, "website_url": "https://sites.google.com/view/affinity34/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "35375553448726474"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1244417377503026_7303358874301984693_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzRLKCdb9xcQ7kNvwG5O2Bf&_nc_oc=AdoF-CKp3yqldOu5tj9ryZRDwo9S1t3oVh_06D2KsTp-Pv3EC5J3CVdKFQuChcs5PPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_fUrkgH9oZWyv1JSmN7cS_yUcabnB_b8mpJPXkdPyiQ&oe=6AB3C961"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
_sid=6e7a0a&_nc_ohc=fVAEZNs4CEkQ7kNvwGAKHTt&_nc_oc=AdlxxzUlSEG4uSKAmbf3f__RYgT6NvtzRvGR13_-4iPeqUXx_x5nZGCn6-g7ffnR7AI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJjYiECiBdH8os7xvcnVKSnQ1Qsi8k6FPwztZv3nez-w&oe=69BD3640"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bodyswaps-cover-landscape.png", "id": "454349065904986", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031414_454349069238319_5029651659616390261_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUPnXOUgjIsQ7kNvwFIcgqB&_nc_oc=AdnVUNmMBp9zPF70GJCEbR8AR1jCTxEF0jOig-lK667SDnU3b5K5aH-lkKA60enFoGs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxETSoylWE4vDDtgxC3u8j7fKxxJ0uemshxzKIHVAelYQ&oe=69BD2888"}, "display_name": "Bodyswaps", "keywords": [], "long_description": "Practice and perfect all-important soft skills in Bodyswaps - an award winning psychologically safe VR tool that combines behavioural science and AI data with realistic workplace scenarios. \n\nExperience role play like never before to build skills like:\n - Active listening\n - Clear communication\n - Gender inclusion\n - Understanding and resolving conflict\n - Giving feedback\n - Career mindset development\n - Job interview skills\n - And more...\n  \nThrough our 15 minute simulations, you will\u2026 \n\nObserve, analyse and identify best (and worst) practice. \n\nExplore your impact on others with simulated conversations where the outcomes reflect your choices. \n\nDeliver an intervention in your own words, then Bodyswap to see your performance from another person\u2019s perspective. \n\nAnd fast-track personal development with truly personalised feedback and guidance from AI-enabled behavioural and semantic analyses.", "short_description": "Behaviour-changing soft skills training for successful careers"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bodyswaps.co/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bodyswaps"
Sdq-gxAD4NmLpwtASyMww9_1FzZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvPDVdQxVZGtOHO7aI-X4D4JqC-Wcigp1K4yvpKDC4Tw&oe=6B0064EC"}, {"file_name": "Oculus Lab screenshot 5.png", "id": "890709921476258", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001667_890709924809591_5826909436836624504_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeYtqZc0E-oQ7kNvwH38IB8&_nc_oc=AdoQY1c79IAGM2fZxEhECSzCDm_Eo9T8iGS_X6ORXYHgjzpyBF_7OO22rwTjwEL6Gh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRzAN6UuZR12VprnPp7tBKBtDowkiwOV41Y01DjKOL8Q&oe=6B006E00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bodyswaps-cover-landscape.png", "id": "454349065904986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_454349069238319_5029651659616390261_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sa10a4slasQ7kNvwEmS4kP&_nc_oc=Adq_AVXBhWERePs-XqGJg25ceEM1wGEfrX91qkUaMihfP74RhySY5i79K5bsRHlHQaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzU2SaVKpQ-ypBTO1uXJoo34HV5-FUM06CWiwkxTklZg&oe=6B006048"}, "display_name": "Bodyswaps", "keywords": [], "long_description": "Practice and perfect all-important soft skills in Bodyswaps - an award winning psychologically safe VR tool that combines behavioural science and AI data with realistic workplace scenarios. \n\nExperience role play like never before to build skills like:\n - Active listening\n - Clear communication\n - Gender inclusion\n - Understanding and resolving conflict\n - Giving feedback\n - Career mindset development\n - Job interview skills\n - And more...\n  \nThrough our 15 minute simulations, you will\u2026 \n\nObserve, analyse and identify best (and worst) practice. \n\nExplore your impact on others with simulated conversations where the outcomes reflect your choices. \n\nDeliver an intervention in your own words, then Bodyswap to see your performance from another person\u2019s perspective. \n\nAnd fast-track personal development with truly personalised feedback and guidance from AI-enabled behavioural and semantic analyses.", "short_description": "Behaviour-changing soft skills training for successful careers"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bodyswaps.co/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bodyswaps", "support_website_url": "https://coda.io/@bodyswaps/bodyswaps-help-center", "website_url": "https://bodyswaps.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "265188515753773"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "536605695793533"}, {"status": "PUBLISHED", "id": "933012890781502"}]}, "baseline_offer": {"id": "933012890781502"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "536605695793533"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28294012720297445", "version": "3.7.2"}, "id": "1137608120032062", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3714188128706579", "is_concept": 
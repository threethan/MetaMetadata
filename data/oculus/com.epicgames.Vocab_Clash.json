zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bhmitp0Sv5Mxnd2S_djvlRjbx53V7olqe0BwG1h4XlA&oe=6A3C0167"}, {"file_name": "5.png", "id": "2080419739427646", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_2080419742760979_9134837804864652596_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBNLe46_cv0Q7kNvwHR_iYm&_nc_oc=AdrRISN6VCuXa6l5bcLtw5z-mhS8DkmDfV3Jo4rkqdArocupoJId-05bISFdGaOGxT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E1PbmyroIEK8yv6DuJV9SCRp-J_w2mKpGXI8iXYh-Yg&oe=6A3BCD51"}, {"file_name": "7.png", "id": "1406567077674981", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1406567081008314_8602459913139063095_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEVrnJaaGegQ7kNvwHyQ1_K&_nc_oc=AdqOUUbVfX3V6KdnqcEmDJfvNqv2B3Te6JkMbMCTjSg5cMf1F7qRaElzMDOB2V45k-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mt1kj1Pa6tDBBUuYe0tsqe9UpaNAopXhWrax_uSB_EA&oe=6A3BE9E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vocab Clash", "keywords": [], "long_description": "Vocab Clash is a VR vocabulary training tool based on the \u201cguess the word from visuals\u201d concept. The game presents word meanings through text-free images or short videos. After observing and understanding the concept, you choose the correct answer through physical actions like boxing, throwing darts, or striking a ping-pong ball\u2014building a direct \u201cconcept\u2013word\u201d neural connection through immersive interaction.\nDetailed Description:\nVocab Clash completely redefines how vocabulary learning works: \u201cUnderstand the scene first, then answer with your body.\u201d\nThere are no Chinese translations or English definitions in the game. Every word\u2019s meaning is conveyed purely through visuals\u2014images or short videos. It feels like playing a visual riddle: you observe the scene, grasp the concept it represents, and react quickly.\nThe key difference is that your \u201cselection\u201d isn\u2019t a button press\u2014it\u2019s full-body movement. You punch a target, throw a dart, or accurately hit an incoming ping-pong ball toward the correct option. Physical action and visual understanding merge in an instant, turning word meanings into intuitive reflexes.\nCore Features:\nText-free visual association: Meaning is triggered entirely by images/videos, forcing the brain to bypass translation and build a direct link between concepts and English words.\nMotion-based answering mechanics: Choices are designed as sports actions like punching, throwing, and swinging\u2014replacing mechanical clicks with embodied memory. ", "short_description": "Vocab Clash is a VR motion-sensing vocabulary game. Players learn words through images/videos, then answer via physical actions like boxing, shooting darts, or playing table tennis\u2014bypassing translation to build direct concept-word connections while getting a fitness workout."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zp1412042552-hue.github.io/vocab-clash-website/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "ZP Games", "support_website_url": null, "website_url": "https://zp1412042552-hue.github.io/vocab-clash-website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34147292004869572"}}]}, "sc
CZKqRDk5I7D5k-NeyzEyU2Cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTjiwBmK7PPGAZr7evU-3IiQ7DtCyHS-_ehplBTeZerg&oe=6AF47CF2"}, {"file_name": "4.png", "id": "311919491506832", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250456_311919494840165_1584254742490173776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1KCYxooSJoQ7kNvwFobug6&_nc_oc=AdrOTLFj2rGMpCLiBWDa19fKYyFo3kpeips8-d_0sKYcuBRLChhUGFaMmE2jqSfFe4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXgVJSrL9i9G71PrgR21q7IS1ZyBDkpnS_PJitLJqu-w&oe=6AF485E7"}, {"file_name": "6.png", "id": "824719212431609", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75429290_824719215764942_9145987177559641066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlekk1BtjUgQ7kNvwGts7l5&_nc_oc=AdqiJUQWPdY7Rcr7LjD2jTZVkGfdZ_SOEkrIR80qCHzLcjpYsOjfEXzrn5EaKR0Tpyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbOxUdMG9XWkizyAOOodNCy8GYgcz43sliJwQExK5zzw&oe=6AF494FA"}, {"file_name": "7.png", "id": "234717609071774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222943_234717612405107_9009905920403019402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNbP5qOlZFYQ7kNvwEtDKvJ&_nc_oc=AdqmzUY73XJYsqbVNutwRT7Zo5jlSuvmsL6j9Ca-7l_X-UtjnKc-q5l8YH5hcngwURc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsl63gw1N9n8Rjkmb8HGZIVjUOBdc5hUZ4FI7P5Uk2vw&oe=6AF49698"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail\uff3fEN.png", "id": "1385848982285711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_1385848985619044_7932645804283440994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Rs3CMhvh5gQ7kNvwEMxOQQ&_nc_oc=Adp0BS-hL_hufaaAJg76eqAu53uOcIPSO16jcS0u6uKhkRHkbQGjs1bWGEgSE9WSYJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDoRhZK6_KflQHeIO9qkvvwcopjk8k38cAUAInIzuLJw&oe=6AF492BD"}, "display_name": "Hop Step Sing! By My Side", "keywords": [], "long_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\n\nJoin Shikiri for a romantic seaside date under the midsummer sun. Experience the joy of clasping your hands in hers, capturing picture-perfect moments, and crafting a mesmerizing VR music video that fans will find irresistible. Elevate your experience with a special bonus ending, unlocked by bringing joy to Shikiri, along with unique interactions that only VR can offer. Create unforgettable summer memories with Shikiri today!", "short_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\nUsing hand tracking, you can hold Shikiri's hand and take photos. The ending of the MV also changes depending on several interactive actions.\nThis heartwarming content is only possible in virtual reality!\nWhy not spend a memorable summer moment with Shikiri?\n"}, {"images": {"nodes": [{"file_name": "Logo TransparentJP 9000x1440px.png", "id": "7116072908484709", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_7116072915151375_8188742455952032553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEgemU6UWLcQ7kNvwGX4b-H&_nc_oc=AdqkgPOxnwUAz0IQdp3n3vHH9nrSPZw-anaskwUNIyOFW0-JbbVl4HqBEIneiZ9UpGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrk0hdfFITUBWJBS8aSIU0KVqd_dLohBTA1SXEzmqjtQ&oe=6AF48F6B"}, {"file_name": "Hero 3000x900px.png", "id": "2125333631133687", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617315_2125333634467020_1924779169024147524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiCEO86nElQQ7kNvwG_k7ja&_nc_oc=AdppO7WOMXmxHPfAzb_EkRMx2F2M2MtBdyJzHPcKB4avMlKNKXwB4-DjbKBtzQXFZh4&_nc_zt=3&_nc_ht
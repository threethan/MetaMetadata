om/v/t64.5771-25/75250456_311919494840165_1584254742490173776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhpXfEsyU8EQ7kNvwHrUUe_&_nc_oc=Adl-AyylAkS4cPb55rvwE8-w1hCag6OO0UVHrgm6l61t_Ne3zZ6dbCUbHz-DkYWxcWo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftI2IxPIp1Y5Z9YXN5epnS7e1617GL42ov1zfD7zIi3RA&oe=69A17C27"}, {"file_name": "6.png", "id": "824719212431609", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75429290_824719215764942_9145987177559641066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGfuqVWFZR0Q7kNvwFqBeHC&_nc_oc=Adn9lKcq12JfKZdfO8HXDsUhBNxMMuOQWTZIu54gmf0Ffpe1rsUXWOmPyXM5Uo0pv9w&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsvQW33ECOgHQ0xhdm5TSms9YwBxDq9udVG2daGqxL8QQ&oe=69A18B3A"}, {"file_name": "7.png", "id": "234717609071774", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75222943_234717612405107_9009905920403019402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL1nvEEfdKcQ7kNvwGuuim3&_nc_oc=AdkFMQ0lFXoTKWtjimNdw3Xfflpt5wf2ZXprFATFWm31aXdsH8RNEBnCuwmN90VYIkc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuAoctbklrfDpd9ggiL1BII-xJiFkC_24t5svJHO5n3OQ&oe=69A18CD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail\uff3fEN.png", "id": "1385848982285711", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031529_1385848985619044_7932645804283440994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPi74CkIeIkQ7kNvwFPllLz&_nc_oc=AdlPpUbpUnOmYyFFKc5aLeHeTp7bxs4mBqxBCwJDM-jQL9cCADLfe9mjvrTgesqqr0Y&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvjzAV8wkFJi_lBa8IBf1ptxZkglEFlWObsguIayO8tkQ&oe=69A188FD"}, "display_name": "Hop Step Sing! By My Side", "keywords": [], "long_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\n\nJoin Shikiri for a romantic seaside date under the midsummer sun. Experience the joy of clasping your hands in hers, capturing picture-perfect moments, and crafting a mesmerizing VR music video that fans will find irresistible. Elevate your experience with a special bonus ending, unlocked by bringing joy to Shikiri, along with unique interactions that only VR can offer. Create unforgettable summer memories with Shikiri today!", "short_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\nUsing hand tracking, you can hold Shikiri's hand and take photos. The ending of the MV also changes depending on several interactive actions.\nThis heartwarming content is only possible in virtual reality!\nWhy not spend a memorable summer moment with Shikiri?\n"}, {"images": {"nodes": [{"file_name": "Logo TransparentJP 9000x1440px.png", "id": "7116072908484709", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974800_7116072915151375_8188742455952032553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d46mY4yUvB8Q7kNvwEuX9qX&_nc_oc=AdkPDEleV0IGOY1AiMhURop7HefRUbdGIx38G-w_knsv77mMGB0sRBSHiC0LkAo2NPU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afts_OgeDq_y5VRr2yIttoo2l65ce5TPNDQgAp91f2m8Hg&oe=69A185AB"}, {"file_name": "Hero 3000x900px.png", "id": "2125333631133687", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75617315_2125333634467020_1924779169024147524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO6dmTJe_hoQ7kNvwF1tzy4&_nc_oc=Adk8tJ7XNULnpDhSxpX970hmPIxBCSZxweTSyDpVlxgxA2A9rztyUVgrwBsfIy6sXXg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsdDWsQ9PDPAXh4luDN682Rz3Vjwq49Q-LMD89mzpwaew&oe=69A1A7D8"}, {"file_name": "Cover Landscape 2560x1440.png", "id": "414602887664849", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75269597_414602890998182_55270659584
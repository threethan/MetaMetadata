Y6g0h_YFidUepZCczrfK0nQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu9bv9aurBOYNmWcLrkVD_J7rNu90IwWyKsZgjEfrzKw&oe=6AA805F2"}, {"file_name": "4.png", "id": "311919491506832", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250456_311919494840165_1584254742490173776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB4_oWPMR3gQ7kNvwHuUn-q&_nc_oc=Adqf73rW3f24mn7d6Qqc-EAklX8zuDGHSiKY6oqvM5JY2IF1fQB6la9yksY7Fyvae_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm2ZpL8YWQLp1UU688pgdhbqgAxird6FDQgzC47BwpsQ&oe=6AA80EE7"}, {"file_name": "6.png", "id": "824719212431609", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429290_824719215764942_9145987177559641066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKi0og32lrEQ7kNvwFiLhe8&_nc_oc=AdpuTTUXxBg3joDxCou-DxwUz_ZCv2J2DJ4U6VGDBwyq5NGehjzudy6rKY6uaF3-4_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUH2j1p86B-_Q2-ZaUmzAAgBLgP4-BOt3xk-EF7oZaew&oe=6AA7E5BA"}, {"file_name": "7.png", "id": "234717609071774", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_234717612405107_9009905920403019402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkoOPatal78Q7kNvwH50dI-&_nc_oc=AdoJIPxV-kSlO5CjHgLUryaZJfC0fh8vEYER-vS3DjczLmMVkIidbz6oumsaVsP8h7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKB6wdztQeaz7Z04zRA2d-C7bymOTvT1n9vP1kI4A_kg&oe=6AA7E758"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail\uff3fEN.png", "id": "1385848982285711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031529_1385848985619044_7932645804283440994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iblt4VEzNpMQ7kNvwF5Q5cT&_nc_oc=AdqLAFC3doKF2HpWo_rxi7oMTyWSWISzgsNWdYRYLoUzfw-Y_tNElM_NLxBvcQGpONo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQRpRczq2hr2sFOgtmMf_K0Vqvo9nHmik6CYNJkL9MWg&oe=6AA7E37D"}, "display_name": "Hop Step Sing! By My Side", "keywords": [], "long_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\n\nJoin Shikiri for a romantic seaside date under the midsummer sun. Experience the joy of clasping your hands in hers, capturing picture-perfect moments, and crafting a mesmerizing VR music video that fans will find irresistible. Elevate your experience with a special bonus ending, unlocked by bringing joy to Shikiri, along with unique interactions that only VR can offer. Create unforgettable summer memories with Shikiri today!", "short_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\nUsing hand tracking, you can hold Shikiri's hand and take photos. The ending of the MV also changes depending on several interactive actions.\nThis heartwarming content is only possible in virtual reality!\nWhy not spend a memorable summer moment with Shikiri?\n"}, {"images": {"nodes": [{"file_name": "Logo TransparentJP 9000x1440px.png", "id": "7116072908484709", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974800_7116072915151375_8188742455952032553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uBs2oQFQxoQ7kNvwEWl0Gd&_nc_oc=AdpHSxVRgE9Yvuh6I1df-P22BjahqbN0aifc_5kXScRBarb2G64cORkxxHomA2lmktE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJubj_5i4BhOZbGa2BIsJnMoyeNNOcbIkMuNfU0CYs_Gw&oe=6AA8186B"}, {"file_name": "Hero 3000x900px.png", "id": "2125333631133687", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617315_2125333634467020_1924779169024147524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SggAlJfEkR4Q7kNvwEuWRC1&_nc_oc=AdpKwBy8C_BaKC4HXeHdOU64zsugnxb_q4bq-u2dtlsV-9qnkc5bJLnSdtufQUswhsY&_nc_zt=3&_nc_ht
Y1RnXFpjaoZ939lgITAEOPdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwzP59jcDTkY-BQhgBy-gX724M62HC6_lkUEWWU60qeQ&oe=6AEF36F2"}, {"file_name": "4.png", "id": "311919491506832", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250456_311919494840165_1584254742490173776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0iaqnHclpMQ7kNvwGLBcho&_nc_oc=AdqUuuR9GzgKEZxte3ZyYpY2yMsFCB6GbfOO6VvLYothFrtM9HShA64ECV_fwxxOZhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCHXCfKIDY-ZRjEsAhL-hOHIpDKt1HbA-9FwHXFJRjfg&oe=6AEF3FE7"}, {"file_name": "6.png", "id": "824719212431609", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75429290_824719215764942_9145987177559641066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9GxJfWs11MQ7kNvwGZkTEx&_nc_oc=AdrwW7Kr-kyen9SGeK-b4EfFbPntKagKRx4ObYg66MNkek0jQ-p50Czw42y74vt4VnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTid-Rfq9J9aOWwsL_VPBrWPn8utZyVpnAXMhx4RXNyw&oe=6AEF4EFA"}, {"file_name": "7.png", "id": "234717609071774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222943_234717612405107_9009905920403019402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUrdhS2Jjl4Q7kNvwEkoHw2&_nc_oc=Adpw2PQskLjFdf2oTTzac8VNVc1Keb-S7d3o5c_LDfLkNSQx52ZPvqt6oIJQIn3IZIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgxnQuvEJBx656yVdygBu8TcJ2IWAKxFgAnzAxs4OnmQ&oe=6AEF5098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail\uff3fEN.png", "id": "1385848982285711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_1385848985619044_7932645804283440994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CDIVr30NCcQ7kNvwFZD3fa&_nc_oc=AdqKhNEKUeSY0ibmz3M-NSbCrQg6_Oxw6qNexTihGVvyvbmMi-f20p9fmi-27uP9_ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR65Lf668ab2ATme3pahmyooKwKym1nuMzbhqUzSj3TwA&oe=6AEF4CBD"}, "display_name": "Hop Step Sing! By My Side", "keywords": [], "long_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\n\nJoin Shikiri for a romantic seaside date under the midsummer sun. Experience the joy of clasping your hands in hers, capturing picture-perfect moments, and crafting a mesmerizing VR music video that fans will find irresistible. Elevate your experience with a special bonus ending, unlocked by bringing joy to Shikiri, along with unique interactions that only VR can offer. Create unforgettable summer memories with Shikiri today!", "short_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\nUsing hand tracking, you can hold Shikiri's hand and take photos. The ending of the MV also changes depending on several interactive actions.\nThis heartwarming content is only possible in virtual reality!\nWhy not spend a memorable summer moment with Shikiri?\n"}, {"images": {"nodes": [{"file_name": "Logo TransparentJP 9000x1440px.png", "id": "7116072908484709", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_7116072915151375_8188742455952032553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37HP8odvAGYQ7kNvwHojY1O&_nc_oc=Adr0yhwnWQEz-0SVzgCbSoYY9UFtkmPyjRs7fCRYVYZWJD_n-vsaUZJ7ABC65q5M3b8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi27wI6aM5WEeD7nwAd1Sk1U4YwdnFutxHgZNvuHs7lw&oe=6AEF496B"}, {"file_name": "Hero 3000x900px.png", "id": "2125333631133687", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617315_2125333634467020_1924779169024147524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfULbjhcsk8Q7kNvwEg5ne9&_nc_oc=AdrbjkPd1Bro4dzaDugVR1hZ2jXXgzVb8ci6tejpve6rxHckKRmpar5zlRnCSv_Z2KU&_nc_zt=3&_nc_ht
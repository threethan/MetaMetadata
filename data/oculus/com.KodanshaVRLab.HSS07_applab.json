wXyAB_l-q5xb1b5KpftRjeXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKllZwdq1SemQSWYH8OE_yVA5gqCa6D6mDZXh3mt-lQvQ&oe=6AAFEEF2"}, {"file_name": "4.png", "id": "311919491506832", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250456_311919494840165_1584254742490173776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkE6IeMqDfMQ7kNvwE6LIc6&_nc_oc=AdpTVt0r6lvSvnmxTOYs4uUAs3C2hLdZf7BrizUYo0SCuuSXDXTOkMx7qc_5x5J9KRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy_P_FmdosqzyWDSRbbM8lkI3M-68l2U_KYiZArEjPEw&oe=6AAFF7E7"}, {"file_name": "6.png", "id": "824719212431609", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75429290_824719215764942_9145987177559641066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRjm3ecaWrUQ7kNvwG5imZx&_nc_oc=AdqTvRnGk1ArqD6CTkcvAz1sdBtyJhCx6wFtNwfQo_7_TueDzRPFFgY_TzKHH_b4E9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVzVvn4Vrarmj2qzVtCMa337GKcVjEv0yyRRHjCvRcSg&oe=6AAFCEBA"}, {"file_name": "7.png", "id": "234717609071774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222943_234717612405107_9009905920403019402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u5_LH8nPkIQ7kNvwHzULAY&_nc_oc=AdpbU_O9RupYwAk9BywIQXBCrhzDycSipQ6GykHNU4OnFCgSLFuYZJ0jNx8EMRuafnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTVA41k7fuyJN8dl9WpJUnaMqeWg_qc1n9g41aPGmWEg&oe=6AAFD058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail\uff3fEN.png", "id": "1385848982285711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_1385848985619044_7932645804283440994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McW5zW5BIRAQ7kNvwE17bt3&_nc_oc=AdoTPIY234ITlSAaSsQbh17Tfvh2cK341UMHkumkT_E59fZzMPgnYtRhY44f0HNY6rU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk2PemMsBwVE6J93GijkMtWyUUrnjZuDtzZc0v1MGXCw&oe=6AB004BD"}, "display_name": "Hop Step Sing! By My Side", "keywords": [], "long_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\n\nJoin Shikiri for a romantic seaside date under the midsummer sun. Experience the joy of clasping your hands in hers, capturing picture-perfect moments, and crafting a mesmerizing VR music video that fans will find irresistible. Elevate your experience with a special bonus ending, unlocked by bringing joy to Shikiri, along with unique interactions that only VR can offer. Create unforgettable summer memories with Shikiri today!", "short_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\nUsing hand tracking, you can hold Shikiri's hand and take photos. The ending of the MV also changes depending on several interactive actions.\nThis heartwarming content is only possible in virtual reality!\nWhy not spend a memorable summer moment with Shikiri?\n"}, {"images": {"nodes": [{"file_name": "Logo TransparentJP 9000x1440px.png", "id": "7116072908484709", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_7116072915151375_8188742455952032553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-21G_tI8jEQ7kNvwG0d6jf&_nc_oc=AdpJ7lRF3ktY_5SD74jCCGMzxm2PxotOygHaGw_wXE1I3CfWrOIMIT8r0sCpLPh4eE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2PM-He6vTz6tHo3fDPTcyNYdwFCvnZfEZ1G11z9V3rw&oe=6AB0016B"}, {"file_name": "Hero 3000x900px.png", "id": "2125333631133687", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617315_2125333634467020_1924779169024147524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUi3_DmBLH0Q7kNvwEDH8rK&_nc_oc=AdpbYXeBoCEzOlk7hwyLxfDYcw4LiPI_kE9q1-Wln89ayBevpvHsPJ5wdTtoF9OSOhY&_nc_zt=3&_nc_ht
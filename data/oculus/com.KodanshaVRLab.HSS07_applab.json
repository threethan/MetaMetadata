A7dvPfJ7taa18C_ARq0G6jAA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGh6pDWXgSthvipvfaR93fA3do9yPoKz-WLqjLRjvLgQ&oe=6AE89F72"}, {"file_name": "4.png", "id": "311919491506832", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75250456_311919494840165_1584254742490173776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvKdaZdz6J0Q7kNvwEHyMjQ&_nc_oc=AdqlhPYHgAXF4yhECI3G_IyDgTXBkQ2eKTop2QsyxDp7Ak7IQ8ZS6I8_72SGaUtVRnk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzv3mhoEgXVTsak2F1QJLFYeIPMzvgxR9ftFiYDbl-Kw&oe=6AE8A867"}, {"file_name": "6.png", "id": "824719212431609", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75429290_824719215764942_9145987177559641066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haq6p4KjAdIQ7kNvwEFwv4z&_nc_oc=AdpLuWA6UFooCLB_fVywSlVlszvj1_rQzjZxqSttrpiA2dUA7S3Qy-2p2xaTlzGbbjE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3QUdmlQqgJXGTxvLIZzdHcLZ9xy_c3ePl7hIEEGm1Bw&oe=6AE8B77A"}, {"file_name": "7.png", "id": "234717609071774", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75222943_234717612405107_9009905920403019402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWisaTIKLfgQ7kNvwHiMEO9&_nc_oc=Adrwr1esU0CT1CudrkrAz4KBMd4_dXwuIm1E3lvLSoxBy4HsjdRMZWdDQM4xmhfEfl8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0kbnyQd9sLh2A11PndDdrxBw5WNTtvubHy4_N3RGqOw&oe=6AE8B918"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail\uff3fEN.png", "id": "1385848982285711", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031529_1385848985619044_7932645804283440994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOxWYUfqNXMQ7kNvwGWrSvz&_nc_oc=AdrwFF__lmvgHTcB5lQQX0aoIPIG-4n5ru2z9OaBlBtDOD1nHCdYK5mvUFGXDm48UtA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKlbB4gv8p1mT-xKMmHFzG_UCpi-35wV2JfsoDB-2PUg&oe=6AE8B53D"}, "display_name": "Hop Step Sing! By My Side", "keywords": [], "long_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\n\nJoin Shikiri for a romantic seaside date under the midsummer sun. Experience the joy of clasping your hands in hers, capturing picture-perfect moments, and crafting a mesmerizing VR music video that fans will find irresistible. Elevate your experience with a special bonus ending, unlocked by bringing joy to Shikiri, along with unique interactions that only VR can offer. Create unforgettable summer memories with Shikiri today!", "short_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\nUsing hand tracking, you can hold Shikiri's hand and take photos. The ending of the MV also changes depending on several interactive actions.\nThis heartwarming content is only possible in virtual reality!\nWhy not spend a memorable summer moment with Shikiri?\n"}, {"images": {"nodes": [{"file_name": "Logo TransparentJP 9000x1440px.png", "id": "7116072908484709", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974800_7116072915151375_8188742455952032553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSZHOiwgEn4Q7kNvwF3VEyu&_nc_oc=AdpHvkXz4l0rfgtzw2tdK-Q0TdIxhpMGW-BZZYBn7XYqi2hzvyUTUs8qut7NxpCHKic&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp3BqIozRFyiVZDvk2tPWpLo_JrntrlSCSKVasrK3-kQ&oe=6AE8B1EB"}, {"file_name": "Hero 3000x900px.png", "id": "2125333631133687", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617315_2125333634467020_1924779169024147524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLzXNkqAIYcQ7kNvwEB5Cr0&_nc_oc=Ado1T8-Y6jxHd2OADgHGHSAUQROH9cafi8QzMkbdYC3GA7IJEfdEXUGseLembzM345s&_nc_zt=3&_nc_ht
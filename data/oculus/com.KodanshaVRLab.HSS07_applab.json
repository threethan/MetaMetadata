h1QY55On2Im5Q61gZPufthuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjujo75VFzrqMVQcvVF9lJC0gscatsCG0aCLxhthrTgg&oe=6A75ECF2"}, {"file_name": "4.png", "id": "311919491506832", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75250456_311919494840165_1584254742490173776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ly8ipHo_a0Q7kNvwFM-oz8&_nc_oc=AdpGnlaD4saKuY8mQTi-JJ6pecnbHDHEoyHPJj8qcYuTyFRlj4BLGygCm24NDaLW2tA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXrVkzSzVKL70pK9w7lvPlPSIC1-mEI7CaHakmbnajQg&oe=6A75F5E7"}, {"file_name": "6.png", "id": "824719212431609", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429290_824719215764942_9145987177559641066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t6sPg-BEwUQ7kNvwE0o7-W&_nc_oc=Adrhp83yRawLaOhV1htE5y3_fknAZgFIPCKo8kl0gtWeN4rF2XRNIq8rn1zQOiBH_pc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsFJ0D7lZ6zDDgdEDZDzd33vvuS_DxYg_w-2wJJ1avbA&oe=6A75CCBA"}, {"file_name": "7.png", "id": "234717609071774", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_234717612405107_9009905920403019402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXPboBLd5t4Q7kNvwGRLVn7&_nc_oc=Adpq-1Gbbf1_42zbKeejUngo470RZyk01RwB6bSwod_S2m3V7vFlOsw-w7L1zb3adt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiwJ3AO1n584TZMENvSHxyhf9Zj3i_JDXpKLMZDDiPlA&oe=6A75CE58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail\uff3fEN.png", "id": "1385848982285711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031529_1385848985619044_7932645804283440994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji6RWi_UsMYQ7kNvwHFup4a&_nc_oc=AdoKvDetREBw7z9UOEr6jJVVzcAKfUhKvLRzDMDTP-54Wf4G_DaPlSNPUtaxC-pq2Qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9QgJHAViT46XMAyFFjco-kzcTBMRcxMwYoBdIGCDOsg&oe=6A75CA7D"}, "display_name": "Hop Step Sing! By My Side", "keywords": [], "long_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\n\nJoin Shikiri for a romantic seaside date under the midsummer sun. Experience the joy of clasping your hands in hers, capturing picture-perfect moments, and crafting a mesmerizing VR music video that fans will find irresistible. Elevate your experience with a special bonus ending, unlocked by bringing joy to Shikiri, along with unique interactions that only VR can offer. Create unforgettable summer memories with Shikiri today!", "short_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\nUsing hand tracking, you can hold Shikiri's hand and take photos. The ending of the MV also changes depending on several interactive actions.\nThis heartwarming content is only possible in virtual reality!\nWhy not spend a memorable summer moment with Shikiri?\n"}, {"images": {"nodes": [{"file_name": "Logo TransparentJP 9000x1440px.png", "id": "7116072908484709", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974800_7116072915151375_8188742455952032553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrRRdh3XM2MQ7kNvwFvoqh2&_nc_oc=Adp4QZWyW9n0_x2szT34JPLBsLzlA1dXmtsSNH1aodVfBmOWewSiU-pw4rkxxD96iIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkSNdHcyCQ0vhAhy-UIzx5KTm-pnsrydG6MCQmdiwslQ&oe=6A75C72B"}, {"file_name": "Hero 3000x900px.png", "id": "2125333631133687", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617315_2125333634467020_1924779169024147524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgDR-Ffg1VwQ7kNvwGQdaLi&_nc_oc=Adq0yT1nZ69wnZ0msnHOrTFU2ykQrDLCtSz7_RnbWRwqPiC9mHKAURdym0bUgJy0UQ0&_nc_zt=3&_nc_ht
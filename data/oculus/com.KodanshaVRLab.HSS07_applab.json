UC-5Drihq03xGVd3PryX7A44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4rYk2gDPobw6SafiH3kQHOJ34df0z3_b1hkt8w9meGw&oe=6A9D79F2"}, {"file_name": "4.png", "id": "311919491506832", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250456_311919494840165_1584254742490173776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcCi0Wx1Fa0Q7kNvwG0Flkx&_nc_oc=Adp76N_X32Ll4ohERGBlelD1tR71jUJ9Caeb62iz-PYVM-67RkIMs3UyxNZsorIX0_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLerPuiiqN8pE0-xpLjXaCapDU_fQfI5DQLYdFRe-PGfw&oe=6A9D82E7"}, {"file_name": "6.png", "id": "824719212431609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75429290_824719215764942_9145987177559641066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVT6PRwJNIkQ7kNvwHiLWwQ&_nc_oc=Adp_BJ1C5-atrTARp0OMmuIodWz0Wf2z3LHYVYIPc_oFfMoII8V0lCpbE56A1dQihzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNibL_2sO-xUbnkssHHMKooQw9_F1Mt_-LHHHyT3-LBQ&oe=6A9D59BA"}, {"file_name": "7.png", "id": "234717609071774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222943_234717612405107_9009905920403019402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDgJjqDGiwEQ7kNvwGb7wBw&_nc_oc=AdoCfaPZAT6CUGpA5xy2KUy3mABdU5svQXgnLYKa09N-DoqElrM6Ep14bJzdoZOFSVY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr24P_tESBVI5d3r8lnWB5yg3URKEsEffoaw1iPw1U0w&oe=6A9D5B58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail\uff3fEN.png", "id": "1385848982285711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031529_1385848985619044_7932645804283440994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXwxREecqH8Q7kNvwHoa1ds&_nc_oc=AdqNTrfvrEtfn7ItAtOq1dGtM176bco5fYsFt0v0aAJ0iGQjcKqZSAtrd_tqWSXsv9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt2srG2vsuenHXboFb0IjGbyCSdJy_jGGbqTr31F-vYg&oe=6A9D577D"}, "display_name": "Hop Step Sing! By My Side", "keywords": [], "long_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\n\nJoin Shikiri for a romantic seaside date under the midsummer sun. Experience the joy of clasping your hands in hers, capturing picture-perfect moments, and crafting a mesmerizing VR music video that fans will find irresistible. Elevate your experience with a special bonus ending, unlocked by bringing joy to Shikiri, along with unique interactions that only VR can offer. Create unforgettable summer memories with Shikiri today!", "short_description": "The first solo VRMV by Shikiri Shiishiba.\nEmbark on an immersive journey in the first-ever solo VRMV featuring Shikiri Shiishiba. The theme this time around is \"Let\u2019s hold hands.\"\nUsing hand tracking, you can hold Shikiri's hand and take photos. The ending of the MV also changes depending on several interactive actions.\nThis heartwarming content is only possible in virtual reality!\nWhy not spend a memorable summer moment with Shikiri?\n"}, {"images": {"nodes": [{"file_name": "Logo TransparentJP 9000x1440px.png", "id": "7116072908484709", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_7116072915151375_8188742455952032553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lheFIZv196oQ7kNvwEi9C3v&_nc_oc=Adp_AyF2X0wYbfKRdhKphHf9uR6cZldsfhjlqpYTAbKOIWU9cIQrEMBSca4UYtpzvVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjZC3zqRavWypivU3nvwuCjFsKVnSzps_Qi_6ncWn_aw&oe=6A9D542B"}, {"file_name": "Hero 3000x900px.png", "id": "2125333631133687", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75617315_2125333634467020_1924779169024147524_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWUaLIl97m4Q7kNvwHGTKEF&_nc_oc=AdoEItvoGyHz8-o7lwL2ZsWsnE6qb5MtRJeK1hvz5cpaigxpjs7JAMv_5iV9-IBxtuY&_nc_zt=3&_nc_ht
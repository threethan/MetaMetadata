ent-hkg1-2.oculuscdn.com&oh=00_Afs-F3cLoOUVwbo-cMz55f3LoLKF0pDNWnOS0qwfeZq0SA&oe=69A18341"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiOFzR2vqpEQ7kNvwG5sT0y&_nc_oc=AdlsW0k5brDGO-mm-rhCf6GeJP9QzARcbVvV0a5iTZhj0dL9GPWW9bOUuRfG4VkidGw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsU21jVs4iHs4jMGsHadT1JDYtwJPolEnFk7PItG4SOBw&oe=69A17900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXB8PKyS1HoQ7kNvwHVBCj4&_nc_oc=AdkviuaFAioiKLGBQTA24V5qK0sEoHFTOodwMAqdV2ndOZbNKMSrW8DLcBkGsdS8sU8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afsw9lWb0dniDpz8dqP8tAPoR-jXPrt4Yndbv7ublUQkmw&oe=69A1AD27"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, custom maps and mods and more coming soon!", "short_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed g
5/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BDcQRP-7wsQ7kNvwFBZtOx&_nc_oc=AdmxMAodkeL5l4Eko4K0WREIc3A8DSwKw-jxZBkVRwLsBZyXcKpMP5l2IFr5Rg_7bao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCtD8G-iZd8XnA-BKyyWHlDlKIWGwXsqqDBheVg8hnZw&oe=69AEB241"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9T2TbpJr-sQ7kNvwFPju5d&_nc_oc=AdmmuV255LCRdNIyEcG8LoD6GxgToK2Z4BMbYCewRVZD5zN73h5tbey9VVEd3FhSItc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLJEMu7h6ilgdR-4aGWQf4L7BbUP5dI0H6TjVp-lFydA&oe=69AEA800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GkOy4iXPKUQ7kNvwGnLfux&_nc_oc=Adli59iB5VVOZyxQ6c-nSd0Vs3Jx48LGtpAtCMIW-zyPJzZAcA0nsmQeD1YYx7lRBJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7fPmYfi8VsVREQ67idSya5ZnRC-Cbwxb0M2ku7RWiNw&oe=69AEDC27"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, cus
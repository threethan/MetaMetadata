4xu&_nc_oc=AdrrbBGhkh92tw6pURWOdQLZsn_pbViQPqX4_fpLKoHG6egZCGfDSSIecCH5w1FjFU0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSZNqDOD2q_1uC_GcuYTeOrqKprUmiUjizDHfFXnoGig&oe=6AA94BCD"}, {"file_name": "applab-screen-1.png", "id": "2295662090600983", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974824_2295662093934316_6501429904913338434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcwbwHgG2Y0Q7kNvwF-XJpm&_nc_oc=AdqlQscG-hznKUSAWNeY2-XpH7-iE2TSapWMJbLyyt4Ab79wwrxaMysu4Q5TLQZ1_ps&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOuLF7tZJCq5t-QLlsoF0VVomcyJ_VuOHLOivuMYZEBg&oe=6AA945F2"}, {"file_name": "applab-screen-4.png", "id": "808117726988730", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jj1pmRyTEtkQ7kNvwEV2Nux&_nc_oc=AdrD-b5cYpM6kFyhgyPYdOoW3TtvztbQaAhNdr3wIi85OYuah3wd3UWzGHQuojEVbeU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY4_x45psqaDFVi6Do97afFvBe9D8iVgjz1qmqLx6NDw&oe=6AA96781"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZGxcZNg920Q7kNvwGd-jUQ&_nc_oc=Adpxvc9X6wdjFznBpbwaqn7lbnPcOsHEtAjWxjp5Q9YaI3hwwN5XuYHbF_LGEZtIHNA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxESLByqytrIS1ctoitIZgTr9F9oqDFeERByrLKu86tw&oe=6AA95D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcV_IG237IoQ7kNvwGBw-TV&_nc_oc=AdpxkJKnPqxMEdyQQi3iyEPFRrd7rtXB2x2W2qe1eu0fbzj93o3CfEH_SSVlYXUBSPo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRpP0_BBJFx6xQIJlS0a3ptVThbgPF_VYqBe7M1X41gg&oe=6AA95927"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, custom maps and mods and more coming soon!", "short_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oakgames.it/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oak Games", "support_website_url": null, "website_url": "https://oakgames.it/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_
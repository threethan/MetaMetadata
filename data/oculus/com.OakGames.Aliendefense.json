5/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuO2LdCuOREQ7kNvwGYWNRe&_nc_oc=AdkJIutU6_fGd3_Y8VPZKiljdZ36u4GHV386D3oIzq5OK1_WJZbpcts51qUKODvcZpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzkyat6Y8dONYs6yf3J_VqhkemFvGpkNlS6DWXDCerTtQ&oe=69B69B41"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAXNzFraq2cQ7kNvwExt117&_nc_oc=AdlLW-W_TwDwEqvjP18D0Elh2neIx2eHNRzHZRrJkz9bHDuNV_DKyorwne4dQUtCC3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbQShzcnx-RR5garMLbROlo9Vu5BjAVKAQkOf4kAE8Cg&oe=69B69100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LD5lAZcdoBYQ7kNvwFrIXCr&_nc_oc=AdkzGRYbVhRV9Y8bw0ZDHOPYfRWvmApvLT7s1P50A8z93t9FGkb7GGKwFzQ5tYLhkvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzba6X6M4fAg4jvgw-XSC-sLgQzXwMFavzo46RTyqjc_Q&oe=69B6C527"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, cus
ent-ord5-3.oculuscdn.com&oh=00_AfvBbC9vwEMNO3h40xIdWJo1zkfvevq1VGNA-UM-IbOCvQ&oe=699C3D41"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGhj8lcaYMAQ7kNvwGKQBJU&_nc_oc=AdnP86pVPgRZcmizWL_G6CjpaEqPH8FsoDPCUI2OBrIu-XWPkBozp-4rB5K6lJg1CPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsjCv5POWCIOb7ioc1TjmYaT6CEH-wysCAuPyp1QseTwA&oe=699C3300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtUMVY3ZrY8Q7kNvwHaTnqd&_nc_oc=AdkJSMSSDUYQywoXsMZq8c1KvmMQ_ZdPKmpx9RJQvLxDQp8UeXXbVpG-MKYQbQ4fung&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvArV8hO1mrIX_7Vcs9GxKZ62cQwfwmV0JHAVzB69zV4A&oe=699C2EE7"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, custom maps and mods and more coming soon!", "short_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed g
ent-iad3-1.oculuscdn.com&oh=00_AfuEmFqudW3eNUqFcbpYTHJepsIUbIuTQiA23TM3m6rDvg&oe=69A2D4C1"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiOFzR2vqpEQ7kNvwHNlzhD&_nc_oc=AdksVyKGX1eZp8TdqKRV8vJrkEK5IzzVgbZB8eKGVjSH5k5rMeqmwpi7KWBjdQeDDpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftiJSYqBiUVnJOfIPnjaTuVbZqLBvDp-24eY_9FIksqxA&oe=69A2CA80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb_7vECaU-QQ7kNvwFP1-Dg&_nc_oc=Adnm7aq4hPxIt6aWW4LK6jO-A23OsFTNCSWWCcpb58bQk2vXfZ-toIJjWp8xxxPExK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftp0ZKsAAhcGmScC7UECDFSG8UtMm72XDvuU4f5xJqEog&oe=69A2C667"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, custom maps and mods and more coming soon!", "short_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed g
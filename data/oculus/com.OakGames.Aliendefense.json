5/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuO2LdCuOREQ7kNvwG_juW5&_nc_oc=Adn9oczJewGGoPvxU6rHVCrh2Z332fowdcJvW7c_RcZsydpT7F3ylORFakSwq2LV460&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3xHqU9UxAChqygUVqX-EuTwDIcZSMpbaZ-KulPDef8A&oe=69B549C1"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAXNzFraq2cQ7kNvwGHApp5&_nc_oc=Adm0HwEykXFGFCcPFhmax7UIUb5eOyry5AxoJgqH7-avqUgjz0ynU60x5vMjGIwVEOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyv-y6Ota_KrZN1gMujbzgLTMH7OlgwBr80KkKaYhmAIw&oe=69B53F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6a8Lt6mPbQQ7kNvwGpNyau&_nc_oc=AdnA8dbELW6bn6tpdS13PfC2nqmglE8DaBqhngrt1S1fLHt5hLfq6Q1VJKXRckOB_18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLzLLKFdeVLwKAqrcCRs-IStKQ5Ab_PszOwtO0vqtl3Q&oe=69B53B67"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, cus
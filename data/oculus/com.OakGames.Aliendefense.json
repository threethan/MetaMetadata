M3B&_nc_oc=Adr1LuvVtXvVzqMPMrDiVWHOIueZuaEjKXQlYHfstxyuuBHv3WmoyD7yO3RcxffIWrE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CWlLRpFmt8qH3FfZK-DdAyCDJORq9onMFri61aNCCNQ&oe=6A11AF4D"}, {"file_name": "applab-screen-1.png", "id": "2295662090600983", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974824_2295662093934316_6501429904913338434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ymb5MWxt0MgQ7kNvwG78Sa6&_nc_oc=AdosrSGkbQEHTvrx-H8Lff7tOWRMKA64niiNDJbc6C02vrjiePSD4sK2o9DfbqTXkZU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74F19wl-cvVaGxlVqLcfIEe4ALHrf0aEX2cpgP423PrA&oe=6A11A972"}, {"file_name": "applab-screen-4.png", "id": "808117726988730", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nr9K-ntUjSMQ7kNvwFtjEfZ&_nc_oc=AdpRAOdNi7QVm09UQyPkn6NT7pwkqbmUUz--8jkhf3cSO5Qd6ZNPtmcZP2iQPKWwwc0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N3A8TLa5bEdULpG2dqkrEGQGzfr_9JIVDOcAhPRHOUg&oe=6A11CB01"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsMvQ_d8ZncQ7kNvwEGak_L&_nc_oc=Adrg377RPokDblIK4Ibw0IAsLxu6v_PyinPWjp2Efjw13YGB0rb3N4THtNb3vXFKHmk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AsSPanNs9JD8FVw2nSniTUrbWDHV9pRRTiIc2xuEjWw&oe=6A11C0C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wx8uzYQ7TYIQ7kNvwGugKqo&_nc_oc=AdrM6DAmIGxNcH3VUXNWbuxNqvDxnmUPmtsoJgqgo5QCWE1H0AJ0bTOKFLcnRIwOhgs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T-bX-R0MJpLBCGWpD3b5fx_o4MjXEpgz7VQKftpdhIQ&oe=6A11BCA7"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, custom maps and mods and more coming soon!", "short_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oakgames.it/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oak Games", "support_website_url": null, "website_url": "https://oakgames.it/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_
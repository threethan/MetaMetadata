5/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKFt-YkSQf0Q7kNvwGgYYCO&_nc_oc=AdkfqtAesbYXj9xuenaZz7pm90TQrM29J70E---eChLOAvbkc78revHpQd33zif41FU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzO3O8bfbVlXu_Fgf7xh1GL_HKGrFapm9vgfkgKSKi5YQ&oe=69BBE141"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo-6croWVKcQ7kNvwG8WJI2&_nc_oc=AdlFLfb84ekBD-iGxeqM0UKWQz5iCn58QwjqYdwvkNqlQTA7Q9qVm4MiuTc3OwGaEcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1hahzH7s996F1RJMOmF_DaueBt05IkHWP8MHNsDJD7A&oe=69BC0F40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txFxkUEfWGMQ7kNvwGHXUum&_nc_oc=Adm3W1QPD4RbcSmz7Wv81BPKrzsC-cRgtwUUEUl2fA4R4B231SJj16LYw6AJUD6dLjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxPdXbjuFF6LAWiGyGHk6HusQSM6IbZIa7rUCPZnNXgA&oe=69BC0B27"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, cus
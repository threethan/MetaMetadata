5/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laoPqIy1lIoQ7kNvwHNPgsg&_nc_oc=AdkXzd94nU4Fc2YEDsiiCcmkv9eGo9Zn4gsmH8wQLRIzhEk3Vj1Xg8VOpfJy42G0RKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIQKNN63ifBKh0HJm6TERoJgqczF82i0JntSmxn5RZOQ&oe=69B003C1"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuY7fUZhTB8Q7kNvwHsh4KZ&_nc_oc=AdnAE3N5T1s8VcM4q87UOb5oj-Kl0i6q_kufIwI9h0QEseCRKpbi7ArVuaFZbESLrbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIF5qYeLgAPRSRg3055F3kE6QWBudLNWpri5xG0Vd4EA&oe=69AFF980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GkOy4iXPKUQ7kNvwEsHXL1&_nc_oc=Adly9MpuOaQ9MKXywOEkFIugxuwhGQuKH7CzbleBCULi4_qHZTStmG6vW6K5sWVwxjk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSb7ifBqo0ZPkuKRiaxTG68b8ucsd4fR-KLlmLl8cUvw&oe=69AFF567"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, cus
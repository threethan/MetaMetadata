ent-iad6-1.oculuscdn.com&oh=00_Af3r5nIy4dVmA_QAfHJIyYLl_tkEMHjDm286iKdUC_FO7g&oe=69F09D41"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JPppRkblOgQ7kNvwGITMVn&_nc_oc=AdpUWXe10Cneu2UGPnokOfN8l6NY5kYo5TdZpXx8fmJxXS0VQbKnpP-b2dQTXTlO1ao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0XBjwvcukGlN0haOQQF-I8iUYlgHiRQej07zTtzsT0-g&oe=69F0CB40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGfIjd_Pv0oQ7kNvwFUTpCv&_nc_oc=Adq9YqDTLPNblvg0iEI3Okyn0CbzywmyoCJd0hXQwbf90CVgKmbUm8tZZy33FtvvQM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1x0ahCemSTjWWujgIe1roqaRaeby_KHHxdx6dSzrygqg&oe=69F0C727"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, custom maps and mods and more coming soon!", "short_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed g
5/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKFt-YkSQf0Q7kNvwG8_vTr&_nc_oc=AdnSXGMzsID8_9P5WHj1tRZ1bRtmrxbiQp-3qZB1UOMeRkrUmWeu4ZmJsasLa0ascOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaAvXav98J_TevI5TXPLTIGSdyyj8nKunCJFg18zRSfA&oe=69BE8441"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo-6croWVKcQ7kNvwEBG9-o&_nc_oc=AdlPSIv1uUV7UrzqUrIjritlEnwzQNlRmJBj9T8FREnU8eTrf1hDaR4KnBDMeqhd_tM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHarilSm4sRhgL03G6BXYcwAL0itbZK5YADvN0KdvxGw&oe=69BE7A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t-BU5x4ELAQ7kNvwEI3XPB&_nc_oc=AdnTjrFDPc9A0ItWaBv3gwiGANBdpsSxQqW7aVDM8UjtRV3tC1bvG6V7tiDFBSoxID0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw04-iCVsHlkRcl8LUPtXk7swPVkxJvm1wysZKRPggY_Q&oe=69BE75E7"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, cus
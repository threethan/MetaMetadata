e": "applab-screen-4.png", "id": "808117726988730", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75303840_808117730322063_7850217859878412936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXcPaQJJuTYQ7kNvwFx4R6Y&_nc_oc=AdodxZ3IxjHZFMbKZYs58Unt0rpsrMtP_99IZrOa-YFD4_dhqYJSMCvX7vrtFJHefa4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99TuIVU21r-eaghQxC7lbpGr3z28CNuZHcYlee96k2KQ&oe=6A395801"}, {"file_name": "applab-screen-2.png", "id": "778270189949017", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75251816_778270193282350_3264347988904653899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfpaQGoy98QQ7kNvwH0U2jq&_nc_oc=AdpbEdI44VaNn-rzI5sBb7H-Zl-pos-5O0HilZxCbkqZFLTIpEA3PernmY9S2_xE7zk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V7pj6v0tbC4onkKC7rgObhPOUXMVtEBD2aiuVFmx1fQ&oe=6A394DC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "applab-screen-1.png", "id": "769405067507451", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982658_769405070840784_3427807102980286009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7hlb7eeu_EQ7kNvwFWust1&_nc_oc=Adpw5Lflg-mhdHYpGti68V_EApw-ON0b6bsVMZDg-U1NiNKHQ0l2m5Wk9yYKZt_oCVI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99wHEq8oEjU8rwUm5N5hnUJh0TylusOjl4wMOu8bfxAA&oe=6A3949A7"}, "display_name": "Alien defense", "keywords": [], "long_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity. With a fascinating story and exciting missions, this game will draw you in from the very beginning. The gameplay is easy to learn and provides entertainment for hours. It is inspired by \"Tower Defense\" type games, where your task is to defend your planet from waves of invaders from outer space. \n\nGet ready for regular updates such as cross-platform support, new weapons and maps, custom maps and mods and more coming soon!", "short_description": "Can you save Earth from an invading alien race?\n\nThe gameplay in Alien Defence aims to maintain the classic physicality of shooting in an arcade game. A Science Fiction themed game in which you travel through the galaxy, fight ruthless enemies and uncover dark secrets to save all of humanity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oakgames.it/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oak Games", "support_website_url": null, "website_url": "https://oakgames.it/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "498228998819886"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8369999286406998", "version": "0.8.8"}, "id": "3409752172617775", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7935548316518766", "is_concept": false, "l
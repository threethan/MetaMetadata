i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8RoX9n5nTYQ7kNvwFTEnJ6&_nc_oc=AdoMAKLU-dVC5K2gr06U72Q-z8tTHLSWssBibr1ebZdpISaznMF5iP9BRshr5srIAeU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KFl76GXP7m63U9RRkBycbi6kN6Od4l_PHqzziiM8GoA&oe=69E23123"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9CuLy2hI78Q7kNvwEqV1ZS&_nc_oc=AdpKC1K44qNMlaUcC3yVFx_pyXrsInxzSLCNJ9C0qPz8naf0oiES1wSBjygPtL970hE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LNe4VUjHDNtFWF-3vNr-jGHb9NAxQfZeaV_psmPwKMA&oe=69E21D1D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85oBxbj5xlsQ7kNvwGkKMqs&_nc_oc=Adrx452i4p4UJ71OD4GiTD14JnlkK-psIuANFIUCzHHM4qtJYi4RKTa5P9j1uCto5Ik&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fPqCnkDzIyNmFNoIwGjVIw-4TRwtmkbIIcHomJ9MhgQ&oe=69E243CA"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4Olws4H2XIQ7kNvwHJX7Mv&_nc_oc=AdpG-s-UdXfxIhaVxxH9NLr1hu6_qINUOsppWIY_dFmOq79S16N5yk8rEHm7OEBM-bI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37zWxp6zgLHfSJzcs4ZbBjn7E7VwPn1lh4aeD8TzOekg&oe=69E248B7"}, {"file_name": "WoodCons
i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTRMlNHTKQwQ7kNvwFegb0V&_nc_oc=Adqx76VMXouBZbqPCSYt2keI_gl_UtEL1CRZOzEVcNtSsNuIYt1IunQhU-MsBCBDbKA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07121Fcu1PUm1XtHTS6bG52WQJ-T1HTvMIkoVVa0XZ0A&oe=69D7A523"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-u1u6qoCEoQ7kNvwHx2_-E&_nc_oc=Adrg8VU1jBOOcSmg6PKT-Byw6tgvC5-pS0yMT_7S7V1iF_KQRjX4e4d8To4gOxoF9JE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1L-SY4K0pgeg2s2fR7-sJzNUMKLpkW4Zv-BP8d9VSilQ&oe=69D7911D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvFT8AscB4sQ7kNvwEIEArb&_nc_oc=Adpx0LHs_tO0MXJweAmJVNevgv0pcLt5rfnJtlHCDq-F0HCMUiF0TsK7JrFCEqWFenw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ygAK6lQaLEvRLVhLEZkcE1vkoxtG3g_HyZy6xMl_qcw&oe=69D7B7CA"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNMN7lR4qSwQ7kNvwEAYxIV&_nc_oc=AdrOC4D_Q6GM1vh9FxxAaN6MqNGqc_uZ3Yxj5IuL-_1ztMJJEaMraCQOt2JWKiM-5zY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qrm_i-bUNT_8vRsvE8Ud0eNMXUan5lOUre9DUULpCFw&oe=69D7BCB7"}, {"file_name": "WoodCons
i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8RoX9n5nTYQ7kNvwHa2FBC&_nc_oc=AdrRGmNMiBWf0zC7Sw7Y4nG3AJr-QcihdvaT8qDxeyk63jiqA3TEWM6Gv3ds-riXwPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kgtaURH8mTdnLB_ZvA9PG3p0xLhZhhntuqal8Qk0mHQ&oe=69E4D423"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9CuLy2hI78Q7kNvwFLo8V7&_nc_oc=AdrdwbBfQpq6TYM4oFdlUM8hVOXUbxKgVnJv2O1Zm8061d9TJ01eH9qeSfhk2MU32fY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qS8_4yNM1ggTtLrfQT75A4uqUUBCDLQcX9XRsIK4DQA&oe=69E4C01D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPzmdbTgOhkQ7kNvwGF1UqA&_nc_oc=Adq631k3vSeytgw9gKUPjY91N1otwYXjTtP-bi2KQ_ZDjyOoqHwLaJEPfforQqeOuag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31a0uMvvpJvxjt4Ay38gise8hVk0giSsHgLRWxQR7Nuw&oe=69E4E6CA"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4erB64n2GwQ7kNvwEZnqj7&_nc_oc=Adrgf3M3bLBK0zb-hCJKdvElDprh3gWJNTjcq2lse_5FO6eNDQpiCBivQDbZ9YuKtlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XYw5cWG5VR51C1iwpcjsllYy4YSMSKUaT_AQwYIz39w&oe=69E4EBB7"}, {"file_name": "WoodCons
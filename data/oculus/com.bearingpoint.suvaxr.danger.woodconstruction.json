i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8RoX9n5nTYQ7kNvwENBILg&_nc_oc=AdoALnaZgPcnlwVT0keefLdNelb60XNgnvOj4ralDTq-o5a-rX5EffULBMhk7uYajeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26z0E722mWkA2rAeSsGCzyMeKGBAACMfKwXzYvdGE-bg&oe=69E382A3"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9CuLy2hI78Q7kNvwGYHWsd&_nc_oc=AdpTxmISvWpVsOfa9XkJf7XFjUZOqtq0KcE5iV4JAWoTue4ELAiWMMEOfZQxjgjPXCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e3cozHoAFJy4rIrd8wzDwFvXh6X3zNna7QJV3BqEezA&oe=69E36E9D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPzmdbTgOhkQ7kNvwEabdXR&_nc_oc=AdqRXbDATL2S0KZKsrkZJGWz1WKdKos5Yji3qB_GyJvgPzg1XLsYkQBLJQHnCk9kZhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1msSwY9G1xvLtx7Pi93twTKS-17nWzyrp1GmU_mbwhUw&oe=69E3954A"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4erB64n2GwQ7kNvwEryc7x&_nc_oc=AdqB_jtC37HoI44aSgbZ4K44fn-s7q7qs7MMEidWArq6_-klnaNV5WXTB22tsAKhV1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pZ_GrX6h4hSI2E9Vm5L_L6Mf9k77nLAi-HnGMFaC9Lw&oe=69E39A37"}, {"file_name": "WoodCons
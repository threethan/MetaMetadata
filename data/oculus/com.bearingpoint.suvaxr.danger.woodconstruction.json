-PepM0544Q5FCQgKUCkOS8mEB_xecCuAf1_8yVVgqHw&oe=69DF7419"}, {"file_name": "Wood Construction2025-11-12_13-28-53.png", "id": "1382773266762441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821719_1382773270095774_5399011534594914650_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubq4g8FLu6EQ7kNvwGonynm&_nc_oc=AdpK_2vSFFggfgLE2PMM7AhJVeya1TErtwRl5VJbOQicpY3U2Cd-IhDIzp06n1YSnmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10iXEq4d2jzYyXz3bCyw8lUWoIZClxvJ_R1xpCNAWruA&oe=69DF7087"}, {"file_name": "Wood Construction2025-11-12_13-30-23.png", "id": "1821299741850495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819281_1821299745183828_1540269861210710072_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMVMierxgtkQ7kNvwFAkSh_&_nc_oc=AdoD67hMacarFefInXA6-Qcto6yR7OcP4UD0paPKGUC3cB6mCg1LAb6kXosOMiUoixM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09tcAaS9krsryuEFmNqU6-Ev_a7peN0QXKCnW693IS4A&oe=69DF7277"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Costruzioni in Legno", "keywords": ["Cantiere", "Incidente", "Sicurezza", "Prevenzione", "Strumenti"], "long_description": "Immergetevi in una nuova dimensione della sicurezza sul lavoro nell'edilizia in legno! Questa esperienza VR immersiva vi porta direttamente nella quotidianit\u00e0 lavorativa con i moduli in legno: situazioni realistiche, rischi tipici, conseguenze reali \u2013 senza pericolo di infortuni.\nScoprite come piccoli errori nell'uso di utensili, moduli o dispositivi di protezione individuale possono trasformarsi rapidamente in situazioni pericolose. Imparate a riconoscere tempestivamente i pericoli e ad agire in modo sicuro.", "short_description": "Scoprite la sicurezza sul lavoro nell'edilizia in legno in modo virtuale e realistico: riconoscere i rischi tipici, reagire correttamente, senza alcun pericolo di lesioni. Imparate a evitare errori e a utilizzare in modo sicuro utensili e moduli."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_E-3Tz82l0Q7kNvwFh2xtc&_nc_oc=Adqi9ROm2gXHTjFbPf49ho9Kb74d5oHsndLQrq0-YlAsvs5XJYWMMBoiYXisLj4NZZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ocODMeFBR8B4YvM0ESVmip_cn7pdHZpWByRqR76x08w&oe=69DF8E23"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIPiOf8kG4wQ7kNvwHzSzuQ&_nc_oc=Adp2KBhKycxbGowwmD1oQJf5LNOggG6uIygU5BVH4dLtj7rKq_1d_5v3zEPAV6K0qHs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b5-DQmM1K6_AyDOuVoWr7wi9ZetEZnvBN1204CvQoIQ&oe=69DF7A1D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85oBxbj5xlsQ7kNvwGsvnnr&_nc_oc=AdqLqdHN9wInIhy8k9qiqfGVhoaxxLJLTgKbBQ86pUs1Xk9wIjeBYw0QnU53FD0tNdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d0CKGu675MTCvhuEYsDFhhy7r_HQ5fkdeKw4CBUv5Mw&oe=69DFA0CA"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4Olws4H2XIQ7kNvwEbo7Bn&_nc_oc=AdocCEZIXWwHsL97vgDUCuqHKRCxv6GOxt6bcxxDoFzaDZfvRZdv_8cG67M3vP4UKsE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Kq-pGkx8DSB01EFY6545RzfKpIjI2o-R7KRzGrEkWEw&oe=69DFA5B7"}, {"file_name": "WoodCons
i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CA7sESNblkUQ7kNvwHWKVcA&_nc_oc=AdqSWbuGS_o8PgHRahC4Mlxz_ElzEzgEALHm-BbeXiGdocFZtYu8uvahhwtoV96dDU8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DDxHy5JoaVWd8jv_MgUgfdwdAcXSBVyJSXmgykGraBQ&oe=69D50223"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LucENkZ2NOoQ7kNvwGC-Ce6&_nc_oc=Adpiv72Yq4mtsSnBlwAM4ors0lTHTFQ9Umg2CgJi_1oDwFl-Co1vF0hyCpVgh_rCYS0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iZHmEuWkrKM0HBktU7bgFenvd1hZbjUvdZrplqv9xEA&oe=69D4EE1D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoTKNS4qXXgQ7kNvwH4hTBI&_nc_oc=Adr4SzpjVSdRSyEAaFWLuBjtxfoh3HPoe4s0EXXLwRyPF45bDCL0M01ZuN97FxTTMQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n94aMSekGRIjnUzq_0Ik0wTGWPY1idZ3PI_-70S5Yfw&oe=69D514CA"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woIkJc4fWSsQ7kNvwGJi3Dz&_nc_oc=AdrrOYBxZB469pSwBKN_dIzcADWX30MnXcJ1DqtbTpbTnrDNs3aTprkFrwc9UOSfp9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zPA814I_wc27_fkxBLNQmEUq1aLI3iEI5z896FLUijA&oe=69D519B7"}, {"file_name": "WoodCons
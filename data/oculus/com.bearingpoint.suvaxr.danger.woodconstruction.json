ent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_1382773270095774_5399011534594914650_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn4WyY_l-UoQ7kNvwGWark1&_nc_oc=Adq3MO_3SRMo7o9srmDrZRbGCDxcOWBM__U-Xosca21Ehe6F4i1wVka7x6n_5xeZBUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9tmNlQ8luUfEUUYe1n-gvAhExlaDusHh9lfIGREo14A&oe=6B006147"}, {"file_name": "Wood Construction2025-11-12_13-30-23.png", "id": "1821299741850495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_1821299745183828_1540269861210710072_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVzruEVX23EQ7kNvwGf1RsQ&_nc_oc=AdpQeiXEdSiwMelGPwDUX2ctSO04vEgvsnucWdzQk0FdM8CeCMdI5kCz2jUI6C5maCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYVf4HriWqYEm1FRaEzxFq6kDU_V4YXcnEPo9pQS7UzQ&oe=6B006337"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Costruzioni in Legno", "keywords": ["Cantiere", "Incidente", "Sicurezza", "Prevenzione", "Strumenti"], "long_description": "Immergetevi in una nuova dimensione della sicurezza sul lavoro nell'edilizia in legno! Questa esperienza VR immersiva vi porta direttamente nella quotidianit\u00e0 lavorativa con i moduli in legno: situazioni realistiche, rischi tipici, conseguenze reali \u2013 senza pericolo di infortuni.\nScoprite come piccoli errori nell'uso di utensili, moduli o dispositivi di protezione individuale possono trasformarsi rapidamente in situazioni pericolose. Imparate a riconoscere tempestivamente i pericoli e ad agire in modo sicuro.", "short_description": "Scoprite la sicurezza sul lavoro nell'edilizia in legno in modo virtuale e realistico: riconoscere i rischi tipici, reagire correttamente, senza alcun pericolo di lesioni. Imparate a evitare errori e a utilizzare in modo sicuro utensili e moduli."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "i
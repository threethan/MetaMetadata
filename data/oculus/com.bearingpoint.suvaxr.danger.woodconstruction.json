gk17kC32r0z1nnI4kTPKTpXxBWBGZ8NmE9XZAM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdbm9vMtcFmz5bPU19ae0V6YoBQTgpW41FiONlq1q6Kg&oe=6B030598"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Holzbau", "keywords": ["Swiss", "Safety", "SSVR", "Holzbau", "Baustelle"], "long_description": "Tauchen Sie ein in eine neue Dimension der Arbeitssicherheit im Holzbau! Dieses immersive VR-Erlebnis f\u00fchrt Sie direkt in den Arbeitsalltag mit Holzbaumodulen: realistische Situationen, typische Risiken, echte Konsequenzen \u2013 ohne Verletzungsgefahr.\nErleben Sie, wie kleine Fehler im Umgang mit Werkzeugen, Modulen oder pers\u00f6nlicher Schutzausr\u00fcstung schnell zu gef\u00e4hrlichen Momenten werden. Lernen Sie, Gefahren fr\u00fch zu erkennen und sicher zu handeln.", "short_description": "Erleben Sie Arbeitssicherheit im Holzbau virtuell und realistisch: Typische Risiken erkennen, richtig reagieren \u2013 ganz ohne Verletzungsgefahr. Lernen Sie, Fehler zu vermeiden und sicher mit Werkzeugen und Modulen umzugehen."}, {"images": {"nodes": [{"file_name": "491821099_1326903868960130_1921854581316705860_n.png", "id": "25773949738857722", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_25773949748857721_5484447958600108761_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bo2KJ4yQzYQ7kNvwGrewVu&_nc_oc=AdoFhv5IziHnmIvNmLnoQvXdIoqsZIYKR8-74s1X_5xL-KIIlO8GjMgWSht1etbGqzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8hE0-TwdDWxL_MvqGSiBkfZqGmKrriuTOMTCZiR1tIg&oe=6B033718"}, {"file_name": "WoodConstructionCover - Querformat.png", "id": "4704317628573886", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822550_4704317631907219_1053607659652492456_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXkBfTfdaVIQ7kNvwGwZCad&_nc_oc=AdrggKKtXuSDjLY
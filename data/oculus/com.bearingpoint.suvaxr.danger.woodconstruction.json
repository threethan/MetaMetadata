91437012087183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_1491437015420516_3076795593487942917_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg3ZYBzAFJsQ7kNvwHUtesi&_nc_oc=AdoV9qbr_ATgN05AN1EKbdbW2Y5K_QBtMDNzFpJY0BFMAY92BRIq8x39qA5MuGPfmt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VqIlCCM-kJsoJCLw589S_YmY2CrdKc-T0YLeFAdTRtQ&oe=69E4B6BA"}, {"file_name": "Wood Construction2025-11-12_13-28-53.png", "id": "690631380783318", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_690631384116651_3302334720868996153_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkLroWwEbrIQ7kNvwFAzhlK&_nc_oc=AdrouiDuko-baQ1givjRueotYd5cH4o0DXs5ze0k9etobBz2bu2kaHaIiKlhXoGDUis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qyakPuvr8A7lRATc-k8dC5QgFtabu-9gr0eZsXtDUqQ&oe=69E4C6D1"}, {"file_name": "Wood Construction2025-11-12_13-30-23.png", "id": "24970819072587941", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_24970819082587940_2892462854058582781_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdrpsW26QC8Q7kNvwF-_9_w&_nc_oc=AdrOfEjtJgs3f5UGwCaWgEa0Nn3hquXYtU7M0O4CT6Vi0dP1DwG85qdjjvsEs6-4SCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xzI1vcrYX963p73qmff7HWQxKZLMXIk_TprdFv7TdIw&oe=69E4BB6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Wood Construction", "keywords": ["Construction", "Accident", "Safety", "Prevention", "Tools"], "long_description": "Immerse yourself in a new dimension of work safety in wood construction. This immersive VR experience takes you straight into everyday work with timber construction modules: realistic situations, typical risks, real consequences\u2014without the risk of injury.\nExperience how small mistakes when handling tools, modules, or personal protective equipment can quickly turn into dangerous moments. Learn to recognize dangers early on and act safely.\n\nTranslated
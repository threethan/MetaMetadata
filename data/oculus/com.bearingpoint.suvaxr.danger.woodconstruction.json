i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_E-3Tz82l0Q7kNvwGdiTyn&_nc_oc=AdrHu9n2HuxC7LG2opiBDFyuZpdmyskCCi3RTO-qq2VonBvCQUmHYXzeKUo06a_XzP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XMBaI7jZJs5LJuAKLHy9zskmIGXIfqJJ1sGhzaCbKRQ&oe=69E0DFA3"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIPiOf8kG4wQ7kNvwGbWt0_&_nc_oc=Adp0kQL3CK28e5t10H6OxZ5_DhWRJPV1UZvm9YMaEdy6tO4ISgGWyXamhXaXxjVJ8no&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GGjzl9PV6YZl24yo4JY70FWPy7Ai95PJs1WGH7PR5_g&oe=69E0CB9D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85oBxbj5xlsQ7kNvwHxFSJ4&_nc_oc=AdpyhouBLT7_VcJC4dmEm72vgBFtRcIQYnt9F16uvimxbc4U6icytKZcDIkoIEc3m0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2USo1yIyAFsY5uSOPMnOjVlmaRPPVx0eMFVIp2kZivsA&oe=69E0F24A"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4Olws4H2XIQ7kNvwF5eMC2&_nc_oc=AdpP-MMBkYHSTeUiJ416rI-MctyludDbljHK0PCZD-Flf4f2wCKv6JoH3zDNcmH4mXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b6m0ppJUvlH9Ufq1G7uXusai9Q3XInQaXkR1b0BbcuA&oe=69E0F737"}, {"file_name": "WoodCons
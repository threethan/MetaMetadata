i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vreKaa8MDvsQ7kNvwGV8ydK&_nc_oc=Adr0bm5rZYJe3kp1yRONrk1gje5l5HcJB4-6hGWR_eTVnubrwQCnmjgv14mH8GhPXsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3p2iGt5hewhjODyoMOrFx_LaOydcUTxN7K3E3ILHHA0Q&oe=69DA4823"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trItQvklVvAQ7kNvwFZh4qL&_nc_oc=AdrbESY25TUoka5_Mk-2udI2tt2bCHYBKbVU8cnQhQXJWsyjX3xQxZIcRr6RyxRsQY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1toXtBC3Bs3hH72G0TD1sFtMSSzhRi7XuCtlIh61xhlA&oe=69DA341D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvFT8AscB4sQ7kNvwEEISyK&_nc_oc=AdrBYRKQQ0zbuxCJu292_aeIWiEPe8ACKeZfedwFFEIg3wkqmmhP-Q9cOHwBAhJS7nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dubUlBRB_lzKLvxehnrKau3QqSY-2MHj3Pq32DwHAvQ&oe=69DA5ACA"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNMN7lR4qSwQ7kNvwGbbgCs&_nc_oc=Adqg4Welfe_RrOn8DyMC11SSS3-uETDILJ-npCiJrFaunSJ4jKijmzIycjQr03BuEAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3to1jSOlEUZU4JZ3FVX4phZG6xvFZZB6Lywe5l07KLvQ&oe=69DA5FB7"}, {"file_name": "WoodCons
uIhW8-QybQpE-HNCT2dcyGSQqwUqRoCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c1yYgLQt0xHruzz0e7Lq_FgYmjV5aOcIHjUpJZDeQjw&oe=69E38A43"}, {"file_name": "Wood Construction2025-11-12_13-30-23.png", "id": "813072831353774", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_813072834687107_5035709752876879030_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgEBmrAk-NEQ7kNvwExP-ge&_nc_oc=AdpsdAYzBFP-gN-NG7rU7mYEkL7Zyoh7jvX9xRd4pY5plJJnuZtz1oXOf7RBVw-qUsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l5-odvuzTWgi3uMd9iausPL_dvoe4WCIFrdLSxaff3Q&oe=69E36658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Holzbau", "keywords": ["Baustelle", "Unfall", "Arbeitssicherheit", "Sicherheit", "Bauarbeiter"], "long_description": "Tauchen Sie ein in eine neue Dimension der Arbeitssicherheit im Holzbau! Dieses immersive VR-Erlebnis f\u00fchrt Sie direkt in den Arbeitsalltag mit Holzbaumodulen: realistische Situationen, typische Risiken, echte Konsequenzen \u2013 ohne Verletzungsgefahr.\nErleben Sie, wie kleine Fehler im Umgang mit Werkzeugen, Modulen oder pers\u00f6nlicher Schutzausr\u00fcstung schnell zu gef\u00e4hrlichen Momenten werden. Lernen Sie, Gefahren fr\u00fch zu erkennen und sicher zu handeln.", "short_description": "Erleben Sie Arbeitssicherheit im Holzbau virtuell und realistisch: Typische Risiken erkennen, richtig reagieren \u2013 ganz ohne Verletzungsgefahr. Lernen Sie, Fehler zu vermeiden und sicher mit Werkzeugen und Modulen umzugehen."}, {"images": {"nodes": [{"file_name": "491821099_1326903868960130_1921854581316705860_n.png", "id": "25773949738857722", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_25773949748857721_5484447958600108761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC-YIqmjJY0Q7kNvwH4CBYn&_nc_oc=AdqdWmw15urW6jkKKVuKNeajnoM7V1Y6JYZAqu3M-RI1jC93w4Clt79qCG8BsHCBT5E&_nc_zt=3&_nc_ht=scontent
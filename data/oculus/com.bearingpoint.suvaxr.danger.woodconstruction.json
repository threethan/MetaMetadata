0_AQRisnilYJPf57_5XrphA84jn6fjElGlft4anYGWboJRsw&oe=6AEA0811"}, {"file_name": "Wood Construction2025-11-12_13-30-23.png", "id": "24970819072587941", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825050_24970819082587940_2892462854058582781_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnBVlb47qeAQ7kNvwHJPEr_&_nc_oc=AdqACaYVP5lHAypXT-rJ-XhHP8YLMPqrJMi-13deFftwo0yCuBfNXv5dzGGq5U6AbEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS27nGOVtAWOfZ0ivN3bnR1jxrQsh61Tx6r_5IpRqY1Qw&oe=6AE9FCAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Timber Construction", "keywords": ["Swiss", "Safety", "SSVR", "Timber", "Construction"], "long_description": "Immerse yourself in a new dimension of work safety in wood construction. This immersive VR experience takes you straight into everyday work with timber construction modules: realistic situations, typical risks, real consequences\u2014without the risk of injury.\nExperience how small mistakes when handling tools, modules, or personal protective equipment can quickly turn into dangerous moments. Learn to recognize dangers early on and act safely.\n\nTranslated with DeepL.com (free version)", "short_description": "Experience work safety in wood construction virtually and realistically: recognize typical risks, react correctly\u2014without any risk of injury. Learn how to avoid mistakes and use tools and modules safely."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suva.ch/de-ch/praevention/beratung-kurse-und-angebote/swiss-safety-vr/data-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Suva", "support_website_url": null, "website_url": "http://www.swiss-safety-vr.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "
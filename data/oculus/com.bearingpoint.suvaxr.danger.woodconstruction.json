i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vreKaa8MDvsQ7kNvwGMLqzO&_nc_oc=AdrjvfMiA1PK679hDH_PO_4ahnZuDJ5g4wp8fjvtuN0r1yoto_RMfFYdGG_DnAWWFx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SNECXVye1knA5BnX5HFIYnoKjiUGkvhxbU-ZfQIcfPg&oe=69DCEB23"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trItQvklVvAQ7kNvwFwuwso&_nc_oc=AdoLLRvndf8iFEA0FgS-agtCmK4BmYUEQRHWdMZuYILGiyi2_rHVnHBymsZLCqF7odQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HHM-FyLcPbbeenW0KtPAfpZT3zMogGMrpVM74Ll9LBQ&oe=69DCD71D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS78paBQy3oQ7kNvwG7uh4t&_nc_oc=AdrWJ19_RNP2rFixaTdazLgLiHuWSmfX8OWgRF4w42qxqhJvta4qG3BeXpocT9oHVhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2s7zJ-zyav-aPcUG4CWw452Nv4i84dgMm9B-eeUThhpg&oe=69DCFDCA"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JogtJluWlskQ7kNvwHwN0KW&_nc_oc=AdoR-ZjwUKwdPKbFZ_ctBYXe3F5OKQkj-ZjAgvjbFXijyZOnaBhW7zBJzvfFl2QVsVw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29gBumQCUYIJdPUAttlyuDfLIPksT_y6NvZQGRuh1s0w&oe=69DD02B7"}, {"file_name": "WoodCons
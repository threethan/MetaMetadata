i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_E-3Tz82l0Q7kNvwGW53IS&_nc_oc=Adpr0scdPpSyKqb01g9kGaqzRrK52dsbsl5c3xPE7c7-6gm3BwwukM9rv58dcUa20Nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HWcVNXYw6_j-vRbXCXXQUizvLCSNlxhVxFQJZC1qXwQ&oe=69DE3CA3"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIPiOf8kG4wQ7kNvwGn8o6o&_nc_oc=AdrhbOzz5SvTKrXzTk7A2VwSf_UhD36MQ8O2atjudOCem1dNnYobnytwcKstt1a5HZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RX_ozf0iBM8rjYyDb4cr4QQm4nJvlyRVov-kc1GLaug&oe=69DE289D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS78paBQy3oQ7kNvwGK0K4j&_nc_oc=AdqtgvD4YjZGDGOHoOpU2xGoDZ9UoHCsIXIs9_gaBJI5JONJ2V-P96ZqHNEj3-TUal8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xq0dO0pmzsdctneTPR0Ae_a3LFE4O71u2SgA45b0rrw&oe=69DE4F4A"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JogtJluWlskQ7kNvwEvz_n7&_nc_oc=AdphaDDeXz7VQAA62-7EnNvMNm5Q8COITS4ZKFnJLCHG4DhjcD-pjSH5E1PXig7tkew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14oZQlKhmVfwI2LUsPloeRw5ccPcHpbrqlmiqyueuEHQ&oe=69DE5437"}, {"file_name": "WoodCons
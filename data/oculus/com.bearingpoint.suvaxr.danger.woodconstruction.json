i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTRMlNHTKQwQ7kNvwFZsrwr&_nc_oc=AdoCkcTf9B1RNIdkJEfOG2dcdEUyZ8_dAi8e_fulKoH7it0Urxbz6UwrzPBToyNN0BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x2Ddt6IAo4XVb7Pvq7D1ObH0O9_tCDCAmN4YL9VYafg&oe=69D653A3"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-u1u6qoCEoQ7kNvwEacxis&_nc_oc=Ado8wlTra43s9w9r-HwxliCAr_aQIwv1XuW_QiN3OGNxB1o_tCo4JmkUHubHhwmLriY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21XECknP0CF6ko-aMdFj_zZJ3c1nxVrkuZsO9b2w3SmQ&oe=69D63F9D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoTKNS4qXXgQ7kNvwHtXh8I&_nc_oc=AdoECCsm-Yid5kuzsH3f0-2TL7LHQMPS0nnDXVmlOxgV2HsYFiZzjHHi5V8oKdutpsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af242gvaednn3Jvr7xeKdcrmpZ08TCrHUa55fz6tuvZPAg&oe=69D6664A"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woIkJc4fWSsQ7kNvwES1ZEj&_nc_oc=Adp1ikQOpfF9vmI4tdCjE6xeKASRPhMO75J8BPn398rdq6LkBHG7UEffN5h41HGuNRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mrDrKduS4k_w1RYPx-Wa_A6epxpyTQNTaqs7l7qAA0Q&oe=69D632F7"}, {"file_name": "WoodCons
i."}, {"images": {"nodes": [{"file_name": "WoodConstructionCover - Querformat.png", "id": "1735425970481901", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_1735425973815234_7026648888461368653_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vreKaa8MDvsQ7kNvwHOfahf&_nc_oc=AdqyVKUNJBymPKk82gF_hNCXUdPqigPhFABeBH2fTwTd-ZKubj8rkHFNZ4dFQ3XBJp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jGpcKze5wB097v67q5r15z-otc0Uo-ZPF91AIW-29yw&oe=69DB99A3"}, {"file_name": "Icon.png", "id": "1404469407857988", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_1404469411191321_2374008257608234867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trItQvklVvAQ7kNvwG2L6N6&_nc_oc=AdqYcAK57iRXxnRbcNS21JMspZSvGw1mKMm0l7kPvSBi4iHCxSbtyZruZvnxvUHDOtI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V7wAhfDL47_bcrLrrjhhm3IWg6Sg5UtS43x8bP-DI8Q&oe=69DB859D"}, {"file_name": "WoodConstructionCover - Hochformat.png", "id": "1138371601691473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1138371605024806_6545105809583793091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS78paBQy3oQ7kNvwFx5xHR&_nc_oc=Adq_DB0cgRmdFA3geXEz7GmzFoP4goQJCevlW2gZDAbhq9SjQYYZmB6GslhvdYDD2iM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16SFbUUSARS_WBjAS5ORa9ZWBInP4M_vgYTD4N4lrQ0w&oe=69DBAC4A"}, {"file_name": "Icon.png", "id": "1061729109131103", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818874_1061729115797769_7442033601794403369_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JogtJluWlskQ7kNvwEPPMIm&_nc_oc=AdqU5VSwoTu8WJOcdB0GLRrwBzS-VbYFreYSrKB2JlOttCEFVQ3du45H97vUjwf4rYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QR4wX8q0Ig3_xRvFNtqKkGnvgcyG-1E3QA5j9YFy-pw&oe=69DBB137"}, {"file_name": "WoodCons
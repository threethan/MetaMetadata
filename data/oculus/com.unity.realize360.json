-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YFEkh7Mfh893sm0jTmJKHcj8teAZvhpgNedUYOKf7Ww&oe=6A3694E7"}, {"file_name": "Screenshot #1.png", "id": "1997354660660676", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974582_1997354667327342_6139063468551020573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_Li2hlJaEQQ7kNvwF8QcNS&_nc_oc=AdrzY_wvbt6blS4nOFJnfJkb6CAio_WK5bAnKspBimHEIR7mxhRBFCijQIIN1megNL8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iFT6RVp35Gt5yTvjUxXHR-ydKTivpaFKZ9yq12QkFMg&oe=6A36C48E"}, {"file_name": "Screenshot #2.png", "id": "1097796864759815", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404389_1097796868093148_6068326403978759300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKq1icheVO8Q7kNvwF59CIO&_nc_oc=Adq1cbvDgcvSlvPr54o2FpEELFCP5E9aHKJOrdyYXbtoOxC07uc5373VZySA_fD-cwQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E7r1OIZShVN33eOt9Qirsp5_GbMDuAVOgJ-J7NckXBw&oe=6A369614"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape copy.png", "id": "954624603062184", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75289915_954624606395517_4711202673844930164_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRw6lF4JeSYQ7kNvwFQ4CDe&_nc_oc=AdqAMIL8GO265HsWGW_r7Qg4gmZrjgm9uDp_dkFn9RrItOvksG0-fUUxV5VVQ49m0gY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Yfqt6g1i26K7rtIyojDRP1QAqSNmV45YIVn-P11fRQ&oe=6A36BD38"}, "display_name": "REALIZE 360", "keywords": [], "long_description": "A tool to generate 360 degree images using stable diffusion.\n\nPress A or B on your quest controller when in the generation to open the menu and save the generation or return to the world. \n\nDISCLAIMER: \n- Purchases have been temporarily disabled as this app is no longer receiving development support. For now, do not expect future updates.\n- Do not expect any data or remaining generations to be permanent. If the servers close, then you will no lon
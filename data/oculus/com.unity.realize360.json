-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA5a7fcQO7sHdJMGzPaqxVZYSVOjEouoDImuHjp4AUwQ&oe=6AA40167"}, {"file_name": "Screenshot #1.png", "id": "1997354660660676", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974582_1997354667327342_6139063468551020573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNwH6vSFU8QQ7kNvwE2ZaNU&_nc_oc=AdqsgFTs19z1Qw5_kKc-UNOqFomBk9UCx3Jv8q00Fx_1qWFplAIftD0Mc-3KY4mHtrc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU2WkpNkmNyWkd9JswO3vdF_swxeTzHNmA_tzXT8i3cQ&oe=6AA3F8CE"}, {"file_name": "Screenshot #2.png", "id": "1097796864759815", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404389_1097796868093148_6068326403978759300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm92M9LmH2MQ7kNvwH8q5X1&_nc_oc=AdpKZDuj9qVHjT4FqxSRUqRl45kWfN1UHgoFGV8VA72p8jA1Yxt7OuOES1rYbbCTuws&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOWXmTjNeI0n-8Ag08zdKL9EcTraiy7GtYROsMFifNlA&oe=6AA40294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape copy.png", "id": "954624603062184", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75289915_954624606395517_4711202673844930164_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVWyRTgQ1VoQ7kNvwENL3wE&_nc_oc=AdpCqB15QTBBFU1QD2Y_VuE0MY35ntPdejyZoBh7u8NlGHfLJ0x8gilU73z8zaqYuHo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdEg8l2a09attNk_QTDlG_VOU8kMoZcWWxW-6_z9kK1A&oe=6AA3F178"}, "display_name": "REALIZE 360", "keywords": [], "long_description": "A tool to generate 360 degree images using stable diffusion.\n\nPress A or B on your quest controller when in the generation to open the menu and save the generation or return to the world. \n\nDISCLAIMER: \n- Purchases have been temporarily disabled as this app is no longer receiving development support. For now, do not expect future updates.\n- Do not expect any data or remaining generations to be permanent. If the servers close, then you will no lon
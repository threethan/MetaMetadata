_2129761532184821853_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjgAVS0NASoQ7kNvwEA8wCS&_nc_oc=AdqYfOdF_gEMKfCNwSsjR1j2djPWQxasPKi3YsSJBRPO1QTlPGqnSebYTcybLpT_hes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVlPDhgzEpHXm9X4S-VFJf2VwvOZNy2KsIcmGhISrhYQ&oe=6B106050"}, {"file_name": "Screenshot 2024-03-09 142318.png", "id": "266416859882245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451788_266416863215578_7902922668268230820_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkJXEpRzOGcQ7kNvwEMNO4x&_nc_oc=Ado3caqRW6q8twNg5HAlT84m0fB9tVkDpxTXU0b1cK4TzzzCV1Ju9ockXTHhUY5tKV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW3r9bBBMem_kUuZlJj0T1soT5X_vCTYs4Hkn7E7htwHA&oe=6B1038DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Artboard 1.png", "id": "743217317909179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974913_743217321242512_2084107497766815733_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxzMFMPzQkkQ7kNvwEoT0Lc&_nc_oc=AdqODN7O2pJj9fNiyxo_M13wyAbqJfhemcPRREJ-3IuBwXSCtZkF4zAXLmVk1q8c9h4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViVzwkwh-1lTYCmW1I0FfmBarhPMDTfRz_-NcENVGO0g&oe=6B104631"}, "display_name": "REALIZE 360", "keywords": [], "long_description": "PURCHASE COMES WITH 25 AI WORLD GENERATIONS, for just the price of a sandwich!\n\nUnleash Your Imagination Like Never Before!\n\nAre you ready to step into a world where your imagination could come to life? Introducing Realize 360, an innovative VR application that harnesses the power of AI to create an endless universe of possibilities, all tailored to your unique vision. With Realize 360, you're not just a visitor in a virtual world\u2014you're its creator, architect, and storyteller.\n\nWhat Makes Realize 360 Stand Out?\n\nAI-Powered World Generation: Utilize cutting-edge AI technology that transforms your ideas into breathtaking virtual landscapes, bustling cities, serene countryside, or even otherworldly realms.\n\nEarly Access Perks: Be among the first to experience Realize 360's evolving features. Early access members will have a say in future updates and exclusive access to upcoming tools and assets.\n\nContinuous Innovation: With Realize 360, the journey is just beginning. Anticipate updates that introduce new features, assets, and enhancements, all designed to enrich your creative process.\n\nDon't miss out on this unparalleled opportunity to explore, create, and connect in a universe that's as boundless as your imagination. Dive into Realize 360 and watch your dreams unfold in a vibrant, ever-expanding virtual world. Your next big adventure starts here\u2014bring your imagination to life with Realize 360!", "short_description": "An AI powered world-generation application. Early Access. Bring your imagination to life with Realize 360!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://realize.agilepilot.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Agile Pilot", "support_website_url": null, "website_url": "https://agilepilot.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24990805473901573"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffe
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lTufIDMDRkoyV8vzAdpdVhMKEpG2YxZkuhBJe3EUW8g&oe=6A3937E7"}, {"file_name": "Screenshot #1.png", "id": "1997354660660676", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974582_1997354667327342_6139063468551020573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_Li2hlJaEQQ7kNvwEhHF9D&_nc_oc=AdrxbeVUIBIn8iXXlBNVvOv2EHp4_vLfTztkDxFZ10WGW23US5PT5czH5Qm77x9LIDM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qGyFMS_aXn4tTTMRjaSmz8EEeBYHhHKZEWedHWSNxPg&oe=6A392F4E"}, {"file_name": "Screenshot #2.png", "id": "1097796864759815", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404389_1097796868093148_6068326403978759300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_2cvcKdcoIQ7kNvwH5nnvL&_nc_oc=AdpoQuolzt7kIMpWDtd1EQYV60-DvhVyzwgaPQa4PTRzMMaKFuXdqpDTPBlNbDi2c7g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZaaCi6NOdeIA1lzHSbBvecbhB97Tn45RExc7FgI-gpg&oe=6A393914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape copy.png", "id": "954624603062184", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75289915_954624606395517_4711202673844930164_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdH5LthwogQQ7kNvwF_0Vhu&_nc_oc=AdofI4WBYEm0b-ZTiXXglke7DMq8iPVP0cjfTFZlCTng7QDWJnxRL32nXAueKjoMQZE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95DWaLvljkP165_eEZklt0O5dPLILrOD8wuDS3qCGtrw&oe=6A396038"}, "display_name": "REALIZE 360", "keywords": [], "long_description": "A tool to generate 360 degree images using stable diffusion.\n\nPress A or B on your quest controller when in the generation to open the menu and save the generation or return to the world. \n\nDISCLAIMER: \n- Purchases have been temporarily disabled as this app is no longer receiving development support. For now, do not expect future updates.\n- Do not expect any data or remaining generations to be permanent. If the servers close, then you will no lon
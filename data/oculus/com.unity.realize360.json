scdn.com&_nc_ss=7f20f&oh=00_Af-ujGSUfNOtKF2kVyVF7iO0WXlQeN9II5n_JbDA8eSQdA&oe=6A47B867"}, {"file_name": "Screenshot #1.png", "id": "1997354660660676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974582_1997354667327342_6139063468551020573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LLaoiKymvcQ7kNvwH0hRJA&_nc_oc=AdppWg4db7BU7vqLRSTPbrWOTGsiGj8H0N84qs3OAmQ1aOcbbkYTj_poJtquBg4p6J4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ETr5xoXKK35rCaaZZKjsM-dAaCo10NCFC97FpWGxiYg&oe=6A47AFCE"}, {"file_name": "Screenshot #2.png", "id": "1097796864759815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404389_1097796868093148_6068326403978759300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL3RBRaRD74Q7kNvwEmzLxj&_nc_oc=Adq1vU1nOH7mcryLwf6BVlkNVwgvhdJukpudic-1BLf_tsnzOF8ytUF_tbyKUtsUYVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nIb9IbJFyjy0QDCgLPp1QSvkkmcWfb30zmMIgLmGvzw&oe=6A47B994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape copy.png", "id": "954624603062184", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75289915_954624606395517_4711202673844930164_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5g2ypANrXoQ7kNvwE5J8FO&_nc_oc=AdrV1PXqm4dvPb4o2ETk6XhZA-uPMtmmN6SuidJKU7PQXw9mDQ3MVvyTLztBEgfqVNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zPPw2XHK7kJ_fIZfj93AKxmIAGhPCDQOKjeAM6idKCA&oe=6A47E0B8"}, "display_name": "REALIZE 360", "keywords": [], "long_description": "A tool to generate 360 degree images using stable diffusion.\n\nPress A or B on your quest controller when in the generation to open the menu and save the generation or return to the world. \n\nDISCLAIMER: \n- Purchases have been temporarily disabled as this app is no longer receiving development support. For now, do not expect future updates.\n- Do not expect any data or remaining generations to be permanent. If the servers close, then you will no longer be abl
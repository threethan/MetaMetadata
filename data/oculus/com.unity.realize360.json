-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu456kO7dK5QgYlY45hiP43zJpuj4sQfKiE3Xay5qcGA&oe=6AA94767"}, {"file_name": "Screenshot #1.png", "id": "1997354660660676", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974582_1997354667327342_6139063468551020573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbII9U3JMskQ7kNvwFe19QJ&_nc_oc=AdrSNvOJP_HY-g1cpxDCp1CltcS1JjzeFxD1mHxKWiu9h7eAwWdBSyFyCdO-U4iu5OI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_AO_v8c6E8PyUHeAzpfG22rNmW2nO1gaNG7KE8iDgvw&oe=6AA93ECE"}, {"file_name": "Screenshot #2.png", "id": "1097796864759815", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404389_1097796868093148_6068326403978759300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymH6wKRmw9oQ7kNvwFBieGP&_nc_oc=AdrRhYhwBya2TnbfizbM5t-RoZpjha20Zsz4khHRTtd0T0TGNLSlfeRQhNypIdkuh4I&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3rqSRMJSkYdDumt2ZAUJ90_AXhB3uZsyx8x_dUXylNQ&oe=6AA94894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape copy.png", "id": "954624603062184", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75289915_954624606395517_4711202673844930164_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b85To0YKKbUQ7kNvwGRdrS1&_nc_oc=AdpU4U9ZrAbnbo8EMPQGpOpWSQj8lFSyrLi_2Am8QHBjSnuz-qWVoy-uUkGr1VEukgw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2SKFW0-Bd-CR1HU213280YyDH6g-U12Kdrgwfoh_QuA&oe=6AA93778"}, "display_name": "REALIZE 360", "keywords": [], "long_description": "A tool to generate 360 degree images using stable diffusion.\n\nPress A or B on your quest controller when in the generation to open the menu and save the generation or return to the world. \n\nDISCLAIMER: \n- Purchases have been temporarily disabled as this app is no longer receiving development support. For now, do not expect future updates.\n- Do not expect any data or remaining generations to be permanent. If the servers close, then you will no lon
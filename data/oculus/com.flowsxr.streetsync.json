=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lz9pG5O3RvPZ_iY1LfeWrGxEAvCNe4DGXhFg8n83K6A&oe=6A26D670"}, {"file_name": "1.png", "id": "1901605253964518", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308245_1901605260631184_8655122282247954556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQxlxesiZYEQ7kNvwEb02ID&_nc_oc=AdoOAl8qznwgkcRKSUeWdonel3PAETyhdsSvwCHbVq7szt8PQKboeIkohdYc0HUTn58&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6AfZSekNAtA9oYocgW0J-OwIZRaq4KrZrs27NNUSY-Q&oe=6A26CEDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "another_cover.png", "id": "659651373786300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618288_659651377119633_739911926317579341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOjKlJ8peboQ7kNvwHw2_Jo&_nc_oc=AdoRv0mOG2R1y0x2G4kLSSLJ1QZ-TmxFiVLUi9FhmcLPDsZAsu7yd2mhiB5vXzYdMU8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QmoCBY45eaxMSw5AcVH486yCqGTV8Ta9a3qk_3iOkuQ&oe=6A26EB9E"}, "display_name": "StreetSync", "keywords": ["Car", "simulator", "RC", "Parking", "Vehicle"], "long_description": "StreetSync: MR Garage is a cutting-edge mixed reality car simulator that lets you control and interact with vehicles from RC scale to full size\u2014right in your own space. With realistic car physics, dynamic engine sounds, and intuitive controls layered onto your real environment, you can test your parking skills, drive through your surroundings, and customize your ride in immersive new ways.\n\n\ud83c\udfce\ufe0f Control cars using Meta Quest controllers\n\ud83c\udfd9\ufe0f Real-world floor detection for lifelike MR driving\n\ud83c\udfa8 Customize car colors and restore damage or health\n\u267b\ufe0f Respawn vehicles to retry or restart your course\n\ud83d\udd0a 3D audio for immersive engine and ambient sound\n\ud83d\ude97 Practice parking and maneuvering in your own room or garage\n\nFrom tiny speedsters to life-sized rides, StreetSync turns your space into a mixed reality playground.", "short_description": "Drive an RC-sized R34 GTR, a full-scale replica, or anything in between\u2014right in your living room. StreetSync delivers customizable colors, realistic audio, and high-fidelity car simulation in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/prasanthsasikumar/Zenflow-privacy-policy/blob/main/StreetSyncPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FlowsXR", "support_website_url": null, "website_url": "https://flowsxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24030289203275161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499309594_1950873619016743_8936430717902182429_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNsohweVFiMQ7kNvwH7mIE6&_nc_oc=AdqaUt1G9N0FfTdSwyKLXlAzvFYdJ0OYoll4NNmOG4RI6Y5_DSIMKOr31deFLQVUUx0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-MCtir5NdlTilaVNeg6Fvmwg1u9YA_v7kFintGl1a0Q&oe=6A26ED2C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StreetSync", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": 
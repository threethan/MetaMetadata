0507161_7549188882722286317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWfll_I6HeEQ7kNvwGcGg_K&_nc_oc=AdoVwOh6uUU4rvbcn7XUmJN6cCUoj3sUShtyFtFzx2XBVlgJo07gAkmm0tZJCQItdAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I6WjGDZ5blrWhW_lc6j2F6PcI4P-H9ivjXKV2GFEJ4g&oe=6A42708E"}, {"file_name": "2.png", "id": "984174370307356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296451_984174376974022_555949778142456287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRlNxa7FSPoQ7kNvwFno7Cj&_nc_oc=AdoJ9m_Y7_civGev6gKw3LrjMo1bvAWxY30_AWZACsk1Quwr17goePtwIh4rKmVy5tI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RF4n5W2qdPK5lWtWumPwvpiTQRcmFkwyX_KhUE-BZnw&oe=6A4285F0"}, {"file_name": "1.png", "id": "1901605253964518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308245_1901605260631184_8655122282247954556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnjwrj_KoTIQ7kNvwFySAtf&_nc_oc=AdoTOrmBx5rL8iylzEeuwNFJzNQKH__j6t_xvuYQsGT18ux8Xh3Ocnh7iz_kProG5mA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vVdt84eidlvTHIyhtgIGUxC56jWgwj2GkMkxe6iYDCA&oe=6A427E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "another_cover.png", "id": "659651373786300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_659651377119633_739911926317579341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cykvATI5ikQ7kNvwHhY7yP&_nc_oc=AdoVlhUSXwF19VB9CaC_Dd6clanGYJUvgWhaLXow5T1k9D-7J6bYfrma7lHOfvLsZ3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bHTO6Xhg8LLIW6LZhRPQLmCBrRi2ShuRQVey7O9iVow&oe=6A4262DE"}, "display_name": "StreetSync", "keywords": ["Car", "simulator", "RC", "Parking", "Vehicle"], "long_description": "StreetSync: MR Garage is a cutting-edge mixed reality car simulator that lets you control and interact with vehicles from RC scale to full size\u2014right in your own space. With realistic car physics, dynamic engine sounds, and intuitive controls layered onto your real environment, you can test your parking skills, drive through your surroundings, and customize your ride in immersive new ways.\n\n\ud83c\udfce\ufe0f Control cars using Meta Quest controllers\n\ud83c\udfd9\ufe0f Real-world floor detection for lifelike MR driving\n\ud83c\udfa8 Customize car colors and restore damage or health\n\u267b\ufe0f Respawn vehicles to retry or restart your course\n\ud83d\udd0a 3D audio for immersive engine and ambient sound\n\ud83d\ude97 Practice parking and maneuvering in your own room or garage\n\nFrom tiny speedsters to life-sized rides, StreetSync turns your space into a mixed reality playground.", "short_description": "Drive an RC-sized R34 GTR, a full-scale replica, or anything in between\u2014right in your living room. StreetSync delivers customizable colors, realistic audio, and high-fidelity car simulation in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/prasanthsasikumar/Zenflow-privacy-policy/blob/main/StreetSyncPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FlowsXR", "support_website_url": null, "website_url": "https://flowsxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24030289203275161"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2065
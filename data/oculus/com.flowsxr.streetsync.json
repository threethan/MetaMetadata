0507161_7549188882722286317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPDaoP8lKuAQ7kNvwEhf-aE&_nc_oc=Adr2yVRFM2Z18e8UgpN2qEqCO5vYgp5MqMEA4DACj50dOb2pgdtcmmMtvcU2d2dBP6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-yU_btOGs56cQIfWCY5YotR1spGEwBfzHy8qJxCBZAQ&oe=6A086E8E"}, {"file_name": "2.png", "id": "984174370307356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296451_984174376974022_555949778142456287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KBui4yVatQQ7kNvwFJza3o&_nc_oc=Adrxs5a4zlMUGzb-l-Y4W723KwWaZvFXoWQ9L6LIQ5AS0Mxj61EZZbFkCqmnuTH22oU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zlU19XMcsaKsb_PSMFi5_FtSAzFiaKEtE8Urxk9xqDw&oe=6A0883F0"}, {"file_name": "1.png", "id": "1901605253964518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308245_1901605260631184_8655122282247954556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEYklxOBRgsQ7kNvwG_0l9J&_nc_oc=AdpjRWglUKuuK7Lhj113EtLT0vAMJ414oFJKAOtBtmnS_HzvlpNvs4pEfzaXjvWmFM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77IKdI0eg9gpFaQMRLLoGUN_BIHVtZKESLds7A_PpNDg&oe=6A087C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "another_cover.png", "id": "659651373786300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618288_659651377119633_739911926317579341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tkd00aVIs8EQ7kNvwGSftG9&_nc_oc=AdrcNjMg-tBLoZSile3kx2vkZg50BIcmSjSW8hyFggpkxBQdB0RIy6SnFXAYRD-FDF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44cue3ywop_swxzBSIKA7pxbt-Qrx5Tcnq38AZgSNQKA&oe=6A0860DE"}, "display_name": "StreetSync", "keywords": ["Car", "simulator", "RC", "Parking", "Vehicle"], "long_description": "StreetSync: MR Garage is a cutting-edge mixed reality car simulator that lets you control and interact with vehicles from RC scale to full size\u2014right in your own space. With realistic car physics, dynamic engine sounds, and intuitive controls layered onto your real environment, you can test your parking skills, drive through your surroundings, and customize your ride in immersive new ways.\n\n\ud83c\udfce\ufe0f Control cars using Meta Quest controllers\n\ud83c\udfd9\ufe0f Real-world floor detection for lifelike MR driving\n\ud83c\udfa8 Customize car colors and restore damage or health\n\u267b\ufe0f Respawn vehicles to retry or restart your course\n\ud83d\udd0a 3D audio for immersive engine and ambient sound\n\ud83d\ude97 Practice parking and maneuvering in your own room or garage\n\nFrom tiny speedsters to life-sized rides, StreetSync turns your space into a mixed reality playground.", "short_description": "Drive an RC-sized R34 GTR, a full-scale replica, or anything in between\u2014right in your living room. StreetSync delivers customizable colors, realistic audio, and high-fidelity car simulation in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/prasanthsasikumar/Zenflow-privacy-policy/blob/main/StreetSyncPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FlowsXR", "support_website_url": null, "website_url": "https://flowsxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24030289203275161"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2065
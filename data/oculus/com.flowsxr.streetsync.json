_QVzHmD8eIquRuqyR5pxqRSDF1w&oe=69A6DF8E"}, {"file_name": "2.png", "id": "984174370307356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296451_984174376974022_555949778142456287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh5zW9-NuakQ7kNvwEzaicO&_nc_oc=AdlTqM539DmzDINNj5b17Te5cSO2SC5WdbQYPaplDup0jEHw-HyP3H1Br9Y1gyZnP0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsE80oNtp3EZodQ5vGLUeHPvfa9c103ngAHpBnEwuzZbQ&oe=69A6BCB0"}, {"file_name": "1.png", "id": "1901605253964518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308245_1901605260631184_8655122282247954556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rD3QkS2eDoQ7kNvwGQQ14b&_nc_oc=AdmZbxQF-_JIu12q3j8VrCbrhF39JfnGEBOhMPlfytqUMPaj-JjbsDF344j_ZZ0SKbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUHISzqurB-HTcMBO4gl2WlmY39u0xWsNqpHq8NiL97A&oe=69A6ED5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "another_cover.png", "id": "659651373786300", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618288_659651377119633_739911926317579341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKunPpTmT9QQ7kNvwG-rd6n&_nc_oc=AdnL7tAdSuIIIUk5hCSVjsu35_PE9niHKkFEPQyw1i8blDo5mQa9W1Wk04Edy5gngc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftXHIZbzV-_aPAa1rJusYpU-X439g3wrItxWO4TH-cnPw&oe=69A6D1DE"}, "display_name": "StreetSync", "keywords": ["Car", "simulator", "RC", "Parking", "Vehicle"], "long_description": "StreetSync: MR Garage is a cutting-edge mixed reality car simulator that lets you control and interact with vehicles from RC scale to full size\u2014right in your own space. With realistic car physics, dynamic engine sounds, and intuitive controls layered onto your real environment, you can test your parking skills, drive through your surroundings, and customize your ride in immersive new ways.\n\n\ud83c\udfce\ufe0f Control cars using Meta Quest controllers\n\ud83c\udfd9\ufe0f Real-world floor detection for lifelike MR driving\n\ud83c\udfa8 Customize car colors and restore damage or health\n\u267b\ufe0f Respawn vehicles to retry or restart your course\n\ud83d\udd0a 3D audio for immersive engine and ambient sound\n\ud83d\ude97 Practice parking and maneuvering in your own room or garage\n\nFrom tiny speedsters to life-sized rides, StreetSync turns your space into a mixed reality playground.", "short_description": "Drive an RC-sized R34 GTR, a full-scale replica, or anything in between\u2014right in your living room. StreetSync delivers customizable colors, realistic audio, and high-fidelity car simulation in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/prasanthsasikumar/Zenflow-privacy-policy/blob/main/StreetSyncPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FlowsXR", "support_website_url": null, "website_url": "https://flowsxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24030289203275161"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2065670823840507"}]}, "baseline_offer": {"id": "2065670823840507"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751464320, "status": "PUBLISHED", "id": "2065670823840507"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {
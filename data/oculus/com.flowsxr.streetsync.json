rides, StreetSync turns your space into a mixed reality playground.", "short_description": "Drive an RC-sized R34 GTR, a full-scale replica, or anything in between\u2014right in your living room. StreetSync delivers customizable colors, realistic audio, and high-fidelity car simulation in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/prasanthsasikumar/Zenflow-privacy-policy/blob/main/StreetSyncPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FlowsXR", "support_website_url": null, "website_url": "https://flowsxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24030289203275161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499309594_1950873619016743_8936430717902182429_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUENveu_aooQ7kNvwHdnYF1&_nc_oc=Adq6n3KBps50q-xaIWXpRc4pBblBLCtBqu7EeLn8-jGk_UFkuw8HFvkDTc5-0hDKY5M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cGi9M3GrNOqTf_NsCX0W4pCnlAwf1qu2glm443IxubQ&oe=6A119CEC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "StreetSync", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"t
0f&oh=00_Af94Wh6flg1pabl4x76XwRhI5B1lKOa-QLTupsBv4EzN7A&oe=6A242F12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qjt2-22InAQ7kNvwEiysXt&_nc_oc=Ado6JqzhCeFj3O3xEI2D1xTN-9WPI9mOkt3uo7EtKDV8PF2g3yS_wl6Kycgd5O9g9j4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--ic4WaeB6H5a8CviAPDrNFsRtyqELrfoFIaO7ENtHvQ&oe=6A241FAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EphTgfQW3MsQ7kNvwEahV46&_nc_oc=Adq1_UZGQ1xED5hfapJE7fwxXJouzF3rwoQcyrdyBtPQlXPp9WcyfPo2XzaxYTe3DWs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bl6x4uP3RdHLnkSEy8NMMH1e3JUBqYWQbjMsP1hzplA&oe=6A243A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDp3hqyxXlQQ7kNvwFYujsd&_nc_oc=Adp7mmvk1k2EHe2WMgwxPo3px_SmGnUkH-tdOy8Flf9yeTfV8-F943Di20XZQB8uCC4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u1aicZBVM89HlM_t4KJNZOd3nh-dC6tHSPaqUmXxW4w&oe=6A244553"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
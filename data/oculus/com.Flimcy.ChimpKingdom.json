0f&oh=00_Af84v5OuTxUSzve9Ev3Lsr525uJM6fJ8XUAatwIbDB_RIQ&oe=6A315E12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNoKhbD2ON0Q7kNvwFP3B7x&_nc_oc=AdqTUpbPmgzPotgWfJW48GVlU86CeCcvOAN89_-VJqP0eR01c_mwHqLK_xlyfamBqlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CSAXndGm9jrDcICey5RFllQa8iCQQuHxN4DZ2zn383g&oe=6A314EAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H75u0zJnu4Q7kNvwH15E4s&_nc_oc=AdpkA2Lt-_zh-w2l0dGGocLCG_00MscP1VXe05XF7N80MsjruNkx20A23z-st4ky7Rg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KIsx5rV2rTFpW_naQT44lmhkfbrWEwTNbB_D3ygEPog&oe=6A316952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKi2_fgxUaEQ7kNvwEHokil&_nc_oc=AdrPD_QUFdo4bMlUOF5O56kgnLqf8-9NjTKmTVTlVH5uXGxS6nNwVFablXtLrrjAu2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98I7KiK947k3dq3X8pOSb0eHVX3SSw_PrnjW8mKH5kWQ&oe=6A317453"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
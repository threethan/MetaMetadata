0f&oh=00_AQGfDp-5SYxo5J5UrIqHtpc213AW53PXxg775B-HorQOUg&oe=6A831B12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Axz_VwGOnS4Q7kNvwEI13tG&_nc_oc=AdoknzR2qTGuFfEIXRV3RBFQMuCChAgq0qPc4lkl9xVdu0wlrDZjgvJrVitTIK9a6C0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZF267e0hZPGTVZJeTN6DUj8c5XOew_zgb_C8N-93lFA&oe=6A830BAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wggSBL2lj4kQ7kNvwFN5bRj&_nc_oc=Adr_9hlw16HRz1gA5McHsKs9FQOdsmlayVHMREEoxr9vinb2RcIDNtgm8quM2pmOfwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbhASLontkvi9Etdvp0rKZfmC7lkgHxx4BpkOi4up5bg&oe=6A82EE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5vD3lbfG2kQ7kNvwHDgaVe&_nc_oc=AdqERk2HpQpQVgdof0hihi5WdvwTZxMX2vko3UHMw7Nf82h8Pz_9r19R0k4cnYRkPQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5C52OQ95aAgRNAhaZB8SVv_n5bpgkKUUWQpRlTXmIrg&oe=6A82F913"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
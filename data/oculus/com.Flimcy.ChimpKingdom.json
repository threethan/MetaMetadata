0f&oh=00_AQCQIEIhc5Vnk_8mM6zWYEXQJdULjaSA9i8lUmYOY47GSg&oe=6A58EB12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr2P9Pnua8sQ7kNvwGoArqA&_nc_oc=AdpJ-nEAXGUHagHkVDNAkyc3G5rtrAtChY-XzeFY0Ytqy_etiTvUUDuzH1LH--f_eXY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMCa2InjhwOyu0e9jK1G-6va8yU9Jf4cA30S361683cQ&oe=6A58DBAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjBgP0ZhcC4Q7kNvwEln5oM&_nc_oc=Ado--3XiDrI1pCUn0h1_f_2DR5o44VJB7v7cDRUVFh1geW0jBQsAj599UXeBPvA0Eec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMB_5U4_DU8d0HYCL8M0VEQiu2fknqUFBNuXMCl1cDrw&oe=6A58F652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZuUlndvrHoQ7kNvwGzRY_B&_nc_oc=AdqyZ4IPmCZyHH_pXB9W6vdnurmwzvm1WrvPXzmztjQtTDbOI_S3dBmmiW9A8DJobKQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiApIJQIFeP3ytoMV7l4wbnwxZ6kHhjzjGmg4Bxit4Kg&oe=6A58C913"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
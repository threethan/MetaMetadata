0f&oh=00_Af9GoxihCGhG6vazKypsajFHwvNV007oU6chDGeHPWrVHQ&oe=6A3E8D12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt1Vu0WfBCcQ7kNvwEIOnsS&_nc_oc=Adqqd9I_FwDPHKfn8zeGw_MZlkv-LmMZCj3LFT0x8ltyMKaK9--7_IsOnLvU8Ww6-fA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cFkE7bga6JoRvAiOrdqFbQOqI2P-Ye3mqrRnxFq7ZRg&oe=6A3E7DAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfnESGnoNhQQ7kNvwGw7UuX&_nc_oc=AdpQaLJurWO_yHJ3oG6dWVxblBCxHivsNmhLemyBFtHfk90nRMZXPymToaGAj-B5cec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cG4-u26yUu_0rNGfMNQYewIJP4YXfOAZVPN14pe6rjQ&oe=6A3E9852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUpMhrUJOGkQ7kNvwGJc7dr&_nc_oc=Adqb3iLudC2ILzP1bPQ9u_xLeojjDhy5vUK_7-wmdduqcyA268H8j0MzNEL9MW9Udh8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OISdN746bG2gNdz-sf4MN-tMRNep_umRurxsNO-1JJQ&oe=6A3EA353"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
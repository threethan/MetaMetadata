0f&oh=00_AQLFmydE1wW1-qFshU8mUI11m66qU59lfthxnRT63kj04w&oe=6A9D7912"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f598zuM-cDYQ7kNvwE10ur9&_nc_oc=AdrGwMV6FLfIDXXmFv9Kq8fuYE3aHfeudNovPh6OlTclQtYeOJJ5kDUqDf2o7IGdJv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHGrO88zyMW1h9Tykj3MwO68zwoG2aLQLOZAxE7kct3Q&oe=6A9D69AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrHx14B0_REQ7kNvwF87QEl&_nc_oc=AdrqCfEPHHJkyeJGlByjpdO6JV6JOBXB9OMx1v-e74_MqHTlbd9w9UA0a4EAv__iJpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2d-R6fiEFgsC_SSTbwsvsyN26uI18CdeX7qZXD4tJdA&oe=6A9D8452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNQvbcbTSF8Q7kNvwFIVukn&_nc_oc=AdpdVFkXPKs3ML8RMOzVyaC2xstIja8jpNd90nrSI8oCc5o-0WJZBIJmrPSjIzSTCLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGgW-lGIg9lEc3vI3UGrrRUxlGoMY3t5YWfDIsFOi8yg&oe=6A9D5713"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
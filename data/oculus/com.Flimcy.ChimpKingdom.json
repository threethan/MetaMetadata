0f&oh=00_AQIVuxivEUrRgKdNKV3l3P3k-H7wEHXGPktE0j_i7w-rOQ&oe=6AA56212"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDYqJ3i74j0Q7kNvwFty72J&_nc_oc=AdpsnNaI64Fxa0O_FnGFEvjiJk-s0G3mpS5ahzj9VkxCXvfko3yQx6pb1wht0Prc3VA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJMRoBrdW-kRbFtQvfDpQtvqKhTGeHokKDqU5DYwVTYw&oe=6AA552AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6mMaO6x4-IQ7kNvwEX-NdW&_nc_oc=Adr4zFPTUaCXvhe1f4S6iCxAPOfe0lJaHpIWKD6zjFwVoKxNNj9fC_c5BvFiy-eQDqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0891jQw-WQ3eNLvl0zrICWXI_jvehbwnOY2_yzvxYJw&oe=6AA56D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQxgF4RPKJgQ7kNvwF0Wq_e&_nc_oc=AdoYyppCloVA9slRplDThw96NmVm3zlzE_wZyrTi8nhFYQGaZJvyBhuZb2A30kxaoTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrF9jEJjVSnaWldPg_xeoV4GSMkpOV9tUHkkuq1pMU5w&oe=6AA54013"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
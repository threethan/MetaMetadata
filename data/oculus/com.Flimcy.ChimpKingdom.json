0f&oh=00_AQOGH05GnQUyiCm1xfzihhRJB6nbFenWAo1vcReNFwLTWA&oe=6ADE1292"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCQynACI-BgQ7kNvwGOpXpA&_nc_oc=AdqVExZTIctvuRqeC5405CTUMTndqgzP6PTYqFichwmouXXk27ii-vcBvdfz205pyzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcG_QicNHpuYc9vtEOKrRU0zyzUW1N2yD9LwWLCgYbbw&oe=6ADE032B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhZDZMJDDl8Q7kNvwFNcvez&_nc_oc=AdrjwWFFKJcPfriZn9tn3V7gy8EHs1Zeqya4Uv0oZmPAmN375mbaHBYie7_Lien7gp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBoBbtZrHp2M8huUDgT340OTJxaswYJmeiTUCZHtI65Q&oe=6ADE1DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJuis31b6t0Q7kNvwGqgUlQ&_nc_oc=AdpbfhUJk0W84Nu_yeI_Nou17XW_la9tV70_rKuuE0L3Gij4CU7y3xiYihmEZ40-Sf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp3dx7tW3yKPOorRLvJ3WlVqVEwhpCpLKKTuWDntnV2w&oe=6ADE28D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
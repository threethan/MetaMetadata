0f&oh=00_Af9TyaOFDNNha6JFNr3JAmFKcO0LlinOcG4XQaioc32KCA&oe=6A297512"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=temwgsvRsj8Q7kNvwE2o_5X&_nc_oc=AdqLXBwCBBA7X0SXB0vjVeBfcmE_SjjEEi5tN8EN-j6r7GkuPt-tDcjPZhYxFes6_3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SepzfaFq8ag-LE1YdZF0h3Yf8JyAym-ph1wew00YrtA&oe=6A2965AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB7YqmFrqvoQ7kNvwFOO6tg&_nc_oc=AdoxNMzy5LJI-ZgRZhMbUgGGZz4jq7gMtNG0TU0Y6cOkXe1mXkUXvrvfYZuSXlA5dgs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PowFnRn2c-5pGTSMMclKbk5Qb06N3R_hzmDMpdGw5EQ&oe=6A298052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7K5FTxSnE-oQ7kNvwGvnPJ4&_nc_oc=AdprIH5kffFqiDBtDZRZnUlNkGOAJfoBtOaLHLifoB6WADJO2g0mWr97kywspRxRMiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KUbBn4BGl5UCopxC6TxzI0-qlqKKh1NtxORE8p9VedA&oe=6A298B53"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_Af0rvnY-126XZuhDEohvcUyClULnyC_FYmSTcod-0M7K5A&oe=69EE2192"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQXkp-dv6agQ7kNvwEpkyHv&_nc_oc=AdoBYS2l4K-tmPtX801qWTLiFWXLdg-QFzsf6UV1SAY4c9IhJ_nU26y8FV7svMAGUsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06YebW_QVC3qeLLAkz8WvFwwjd9blrYOeXD9AjvZNcOw&oe=69EE122B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LQCY-11vPcQ7kNvwFrreMr&_nc_oc=AdoObR52dlZtx-MCWAI5gZtQcKn5RtzA69V-r_KDKOnjn2fso3QbLJ2YIRyiryEiUvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dudm3-HcBD68x02F9gN7gf-9VjQFKIPh2PmiEvCLqmw&oe=69EDF492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjqvLE1PgvsQ7kNvwGB_V2Q&_nc_oc=AdojHx2SPS-8fvHjv69n00DlIqfe1g4giUOv3qMm8e_PyIzdjfY-0_wVbFWKaGvdBYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0plpJ9BxxjymSXeGE_qf90bVjDLAzGt6flJ4qIADrTRA&oe=69EDFF93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_Af1jBw-eVi1WmQHTtmlkFus5OpEI2cFpcdrMiNRbavYahQ&oe=69D66692"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yt6eD9XsdlUQ7kNvwHemkl7&_nc_oc=AdpxMRH3MdqtQvkvX7GjqHbVY-E9E7RYb_ZYatevamGWgAl1rcWnMbwRO-9-Grml7J0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dyQouJ7EA7p37g_MNGmjYL-xnoq62WANcL5-5l1lK4g&oe=69D6572B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3F_bpn7ENsQ7kNvwGnGzFJ&_nc_oc=AdpI5SPFxJDFN6eM2znpkPmQDirIWEZxMMgXAYlXiIP_xrgi1tfe25ltdVtA9SfWrU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mKN_AH1VDH2-jPnj9LJHs-VE9wjuDPFmf3bMZ2i8bwA&oe=69D63992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2DH9fID74QQ7kNvwF9wel_&_nc_oc=AdrN1-oc25AR0Wk5zhYJt5M3gvzh-ldNtlANpRBGRiO_SqBqBsRWmc0BU75pl82BBF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KZMMRGfLy1zCokeNMIoLKRPd-nUD6OcCAgIevfLOpHQ&oe=69D64493"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
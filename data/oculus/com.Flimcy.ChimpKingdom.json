0f&oh=00_Af-Y596C0We6sX-O46ZPKT_JbKJGpmYggLZuEDg3fzlB9w&oe=6A43D312"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvuY_G5vmCIQ7kNvwHHGHWZ&_nc_oc=AdosZ3BLGVMyigs1OkJgJmaAH6696P9f8RNSyJFoOxf8A-ZWHZM39a6djalW8bmxzbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h8eh_1yLLpoifygKep0lPFqX5yGn3gKQi_eR33ShaQA&oe=6A43C3AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLhQRJhDqicQ7kNvwEk0Gee&_nc_oc=Adr106548FAscMGculiHgbVu3XyTRqTD0AQRSWZIyJI1M2LRyhg_rewXR3aZ6MYUw10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af___tbR23775SE-_Kbvw7OLhEiZPyfXf4TrNLmk7jBDqA&oe=6A43DE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FDtiQZU7aUQ7kNvwHR4ewI&_nc_oc=Adpl34TiEjmBoLz99egCLKeg-xVDfg_kkuk5Ogc6dvMTqSD_XVTo_bdyPqacHohI0cU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DIjbjc1Jsz0vHVnZjeKew6kZq1k-XhB3vVPD7FvR0FA&oe=6A43E953"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
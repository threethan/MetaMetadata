0f&oh=00_Af0gqOUPsxJwREFsZmwYaDDZ7vIIpDxNO2Hq5PgvveSU6A&oe=69DE4F92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRaqu_D1k2AQ7kNvwFGWwh4&_nc_oc=AdqXXHVB82y4Esa3tD2m7IVsOUxPcksPhxA5Wf6J5cHRlzvAKxzjx7ne-DCr7qWIWaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FXcq3eleTwuVX7ohH6zENoH9NZCenswjN1AfdlajIJg&oe=69DE402B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eYe9X5-t6QQ7kNvwHVGcN1&_nc_oc=AdqJla44gNHb85QJFHmbMbxdD54NJEjwXG1lLnP5PrjhtEZ8V3E6qMvfxxL12dW9mU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kdWK4olAQuan3r63K4DH41vsJcCR8E7slDOK2ZbRj-w&oe=69DE2292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGQi0aPfc6MQ7kNvwFl0gs6&_nc_oc=Adof9_uG-BUYoLuX68hq0sJNh0z2o1a8-HHVHa4VpetZZl223SW29qxSlzo5vR5o6-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g8FKZ9Kaeczkt_N83hJTnR8z3kBYElXHtPmtrlcwSlQ&oe=69DE2D93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
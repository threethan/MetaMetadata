0f&oh=00_AQNbodeuGsyTdS6nRnq9QqzS8LC8GMw5O7w7WZh4XMXPbw&oe=6AE4AA12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plL28GP3mLQQ7kNvwEpK5LR&_nc_oc=Adox9TEAyE1vuw8Q_J5rMrn0A3EHqjNxm4ygxc2gudorwlYxc6cShhMU44Y0olx5r44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Yv_vp42kfpGhAJBUX7M8O3UYGTuF4HcGcBIl3PY9pQ&oe=6AE49AAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpVr2wPrSRMQ7kNvwGz15cy&_nc_oc=AdrB-J_0OYxTMHzHOKp8fCghZlcjBF7FxYcDYhRLtrRnjRMh8216aISA6eDyA7cQtQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFPanZJ2bTYNlNlnHxaev6-kBmi3HxujcOTTtD4cP3xQ&oe=6AE4B552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ib_aN286FyoQ7kNvwFV3xRU&_nc_oc=AdonisyY7UGVEuzElRzkHIM0M_p8Ddv7W01l4PQiUOHu4gmmwE37iIEb2jniEGeudmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5NTapL6l66K1K0n0hmOeXcUB8aUH_WIWfo6zVJ9f7QQ&oe=6AE4C053"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQFTMmfeHWJ_i7hPfdEGQqKlbhAEgq3Trz0EkjY7UcTESw&oe=6A897A52"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSG5tGrmPY8Q7kNvwEcr41V&_nc_oc=AdqmRIggl_hj_XqJa54ivBgVOxOyUUrTDOu6WWkYZIhOIQ3MiFhWpOXuhYh0qa2Ms1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0l41lJXJ6vb-L9xrMY346EydECiLQssNu-AKkvMXVRA&oe=6A89A32B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpMZStuwN3UQ7kNvwFA5tK_&_nc_oc=AdpsAXvER90p7bFU7KQGMoAC8fDMgTi1CI4GLz_1v3MZ80Hw_sY0Ia2f7yx2kXSobyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5ede4XHJXJR0aaHSdm2Q6jdjzPobGnwXPmqxeJhnf3A&oe=6A898592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWt2Hx7CZo8Q7kNvwEbVUgK&_nc_oc=AdoYWlZbeFDZ_GnTNcUHf8sGgMYOyonE6Zhz0mIaEaOavwcBNTnzPRJwm0x8GBVlmJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCyPOcvl3n_r7JCXdemwfrmj2B2R4fC_J49xkdV7cgfA&oe=6A899093"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_Af2PFrgA35xHSYUhrSF5XY7etWrhTAEe35c9jBDEzI_4jA&oe=69EA2D12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnIZKrcrfPcQ7kNvwEjsWbZ&_nc_oc=AdrVOM5ceP81o1PwFs79dufvW4VrgP2TC0GvtbDC92fl--UoVZKGKkhC08Lotn6SfnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0limntZGhmOfDtTGizJAoFA-ECH4d-052vy-Tqsmw7ng&oe=69EA1DAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHpe_ZPUPTYQ7kNvwG6QcgV&_nc_oc=AdqSxyV-XYHEVRyylnASMX4W0KnjyPabDJfrMSxAT0IKM8OKX7GS7OBwp-HrUTEgPuE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UXcXsHrz3WaVnUhZsPRKVUSP548dGxio3VSGyl1dLYQ&oe=69EA3852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2E5xCP3_6IQ7kNvwHuuJzq&_nc_oc=Ado7NDxNZhO86t2UxbAOWYTbT6fx4OQomz0cd4bdxm5ScocMOZEv2KPYnRFE8g5ovGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HY2VbNQNJdfcuE8r6RgCjn-BY9WY2q_X64UhZuF3mOg&oe=69EA0B13"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
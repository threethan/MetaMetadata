0f&oh=00_AfwBmy3hnw4LVRIJRxx116x95yyS1wfz4IrM2cFFp8jGSw&oe=69C69492"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyr-Mw1rNMcQ7kNvwHS0nPP&_nc_oc=AdoDabmuvzDOLLs71xioLmA2iwrlVsv5zzLtm6XEYljhCpUe8Y9VDWYwjoNzYN38fUc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdIrOT34Poy7RiEdwR9jpfRi_PaJ7SpIkvkM0F2W26HA&oe=69C6852B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f2BiVixvFAQ7kNvwGIQSJ2&_nc_oc=AdqIS4BK7YsZYnzx-mtbMSFoPL_vkTIu-xctNsuF05wtzdRrj0qRchzFExAhqH_gkP0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4QxcS_JSEaPz_w3Ox6IJx-GK0ZvrDS4yqcuI7ZWCdzA&oe=69C66792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRCTjGJA-AgQ7kNvwEV-IFP&_nc_oc=AdqcIRmwASWBwT23TlnagyD6j6UV0U2-xqslm4yK4tWrf7Jx7AeSPzmdWS9EZsdC18k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1NAUYWO4qDr_vBxDvxoHLg1gddbDjtuuuqFrioaf3zA&oe=69C67293"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
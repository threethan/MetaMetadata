0f&oh=00_Af_AXLb5bn0lv3KOa1TqvygdtvJQ15K3Z9ejc97Vk64mYw&oe=6A3BEA12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWXSpWemrKoQ7kNvwHdVHRy&_nc_oc=Adov5wv5aCLClkhU_Z-9zAC_3t21E2AA5YTmC4RP33S66kUfnq6lhkyx1PxQJyrlaJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iXJtn9ZbT9mHa2vbeNKcfVlC6HL4CfmLK8zilYW4O9A&oe=6A3BDAAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL759SgWD2EQ7kNvwEXJMNW&_nc_oc=AdrgUWXW6GEBWJ5IUvn2Wb_yI66YWD81miKMZ0QsiQAblUHvTQTnhU6ELkhFTP6EbN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eoC3kTBhL1_VxvfYMGywrpBJ9AxIyApapiIDyGUxmWQ&oe=6A3BF552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUpMhrUJOGkQ7kNvwFapWGA&_nc_oc=AdpRPVuIY2wasaoGV_dfLek7-YfAPyWduvpSoAR7BjENlce39po89UGqHRjvZeEYbTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xpBz01G9Z3XtjRea8Mtv6hHSPBVUGZ23dxp0rgXB0iw&oe=6A3C0053"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQDgj00sHC5l1LXmkMbhlR_VO9qzZs2bcuTO05PsP8I5-A&oe=6A4E5F12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RbcjF3HugkQ7kNvwFGNBkM&_nc_oc=AdoNcqmcVe1_4XIeGo_iXW6WzVtuzA-wStpYICnGohf1_jELD72kDIIgA1fzTG6xwWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCr12wbu4lMS2X7qFJ_IaR23lPFS1sLCXeTMALlerS8A&oe=6A4E4FAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7i8T3gxxDwQ7kNvwFuBhDU&_nc_oc=AdoeIAf-Tfe7K9oyMpyn09g9H_4TRAFkrSjTl4fTjO3e8OTGNf-gOUrpJx7on5y99cY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKZxDQ5KdE_nPh-6UU_S5CQngi3z1dBET53gLl_RBMew&oe=6A4E6A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=empI2VOfiXAQ7kNvwFk1YgJ&_nc_oc=AdphoDg06myqwTPbMOC4NZCaarZ25VjgDnsI8tCsWIRNBJHhuIeCqjiNSGDn7g-sXOE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhoX0VndkrW8JkTZVwpAhRCwfr80GON8x6RIM0QJQTIA&oe=6A4E3D13"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQEn348Ii_vfKJS9WGsgRsEMyE_eb_ZsLaiyj96lbGh9_Q&oe=6A75EC12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Oj7IVrtjkQ7kNvwEoixPx&_nc_oc=Adp6e4VK_BvpI5AebKAbQWxH-_6RWeGB1XtCwIL_Nhk7tzSITxWD_5XHsc2fhiVwmLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT1iyOvguoUbGunCZQ9bXrGr0FengQXLt5N9IReGHd1A&oe=6A75DCAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cVf0Nq_oWQQ7kNvwH_W4H2&_nc_oc=AdqFsbd-RgSu2mojE02ccJ38KZ96wkeaUhj0xtYHvKFaDogEr9fEX1NsRAH4SF4HxDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz6aEBiEKLYoXHNnHKKsFC7eipBqTxpC-1ccr8Xtt4WQ&oe=6A75F752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lbzsQ5MxjYQ7kNvwErGbhy&_nc_oc=AdoeWUmuBWvcFVA_bf15yacVdBeTgRC_70Ph2F7gLzlOF5bwaZWOmm-uLIvCDNHuqSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIowZ10Gcv4ez8bN-CiqTjSIXz0R7mP6r5Zq2dvccQ8g&oe=6A75CA13"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
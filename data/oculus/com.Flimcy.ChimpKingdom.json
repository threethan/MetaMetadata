0f&oh=00_AQGJhPOugB2OLNpGohsppV7Bl9exGsFRTTTEbayehL1TPQ&oe=6A773D92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Oj7IVrtjkQ7kNvwELgVu9&_nc_oc=AdoJrkNTBkT8TRrnMyU61Ee_F0cGURzlFmLZZfO5_C1MDnh99BxKmlih0R14hzN9me0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz3EIrED-yLrmoUZjYrZlMqGiHDeKYjb3fPsRkHXBFcw&oe=6A772E2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cVf0Nq_oWQQ7kNvwHPy-Qm&_nc_oc=AdpaiEzzZVg2v3UZN49mPVmyTd8NuTCI6QBv5fVyntAmrhxr-xro130QG64WJQHg744&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcu6kJvD1Lo5qVKfnHeufDiAcbAJ4M_Bx4zEn65roP0g&oe=6A771092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tE1sWBF85yYQ7kNvwGvLLLW&_nc_oc=AdqnNpC_Z6-z34iudXi9lUIXkuBCvalcbThlaViuil0yA411gKY2gyvb6_Qsfhcy9Tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSgs28wFl4deqjvqGmGwI-EWVuW0WXfPmUPlggTXNEFw&oe=6A771B93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
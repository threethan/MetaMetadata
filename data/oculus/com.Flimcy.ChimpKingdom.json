0f&oh=00_AQNZFHMWTsp91S9hjjIjy1KU_lUMU4JUGmPnG8RDC7Ar0Q&oe=6ADF6412"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCQynACI-BgQ7kNvwGeXtcc&_nc_oc=AdpFHTGEsYshMdWmaGlc5SQI4AaE3aRtuTnM-A5xf8TYB4UkIQhg1C0jirzM0dfVYqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYdVFl5j4Dh3bMow66k7inh1dXZBYvgyAgLB3VzEOmBw&oe=6ADF54AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhZDZMJDDl8Q7kNvwHZydKJ&_nc_oc=AdrVrCMehEwusZ5fqzSUr7QRWLFRXqBhTiIVtmZSizWWiOwpmVpVpMiL7YPGK_UdPtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkQi2m5zJGXaAqcss1yuJMHa116nDjbdIciKnb2YZYaQ&oe=6ADF6F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJuis31b6t0Q7kNvwGd7iTv&_nc_oc=AdoFsVU_OpRRIf4VYKh8YkbWdAt51xAJZV3IxEl-SViKebHrH2t8H5jahSGuCjv70MY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMElD5xCwcVzTo6g_hSFywqi7fJ3ituE_iIY6OXFxocXg&oe=6ADF7A53"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
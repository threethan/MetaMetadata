0f&oh=00_Af8NZGYel3-zo_Dvzau7znHAzinhNRI-TWaMgKmIPluknw&oe=6A300C92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNoKhbD2ON0Q7kNvwElRMTx&_nc_oc=AdpLO707wwsLZN2CO5KiCFerlTyvmu4ubyU_8qvbyrDHC-VnEdmF-cpMhD6DL3Nvqf0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95Hn-pbo7-T3iEbHlQ-dLrtUtCsbu-zjRU_hxkaw-THg&oe=6A2FFD2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H75u0zJnu4Q7kNvwFKZvfn&_nc_oc=AdofneuEpcvYyOJQMPoH3v9Jd2LsVjab-_dbKTQxZgZaLs2jAmMAkZmBQP-2H4zvZWA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3isM-qutodjpFFFtAmQA3sxfYvhmFsohhuejkIfkK6Q&oe=6A3017D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKi2_fgxUaEQ7kNvwFpCU79&_nc_oc=AdriZFvDQirMMnZSp4RVmLfmle21j-149Wc9Pfi6PKsFUF3ynEG0yZbRoSMajhC9Ybk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gmdLZ3cOBPVPiGT0IZg6mzYB2HGzH_mXVWnh4wxk7rw&oe=6A3022D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQByFOvBIiQSnjaVIgay6IvHpH9koF2r90qW5rMbERvMxg&oe=6A6A0E92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKiu8o3qKXgQ7kNvwH-gq1L&_nc_oc=AdoyTY46_hI3Ug3spR2HXTfbLn3cZD-zI44BfY1uWari14w1oNjBBdJAoMOdNUeGHpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPy_E-YIMstAcZO7h6nJ48cIfHIpMiKczR0onX_fkJNA&oe=6A69FF2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzpBwLh9dOYQ7kNvwE5WRCf&_nc_oc=AdpyNQwiuutNK6QC240pc_fb6QtcdOt-R2zHIAzAcHhZxr-Y79WW6lAnojrcvIN7TNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzGfuTZV7BdR3Mg3uRrPtYrbAZiaTp-sw2OverRRnZ6Q&oe=6A69E192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wOrg7vzSuwQ7kNvwE21qLo&_nc_oc=Adq4DpYDoqL3tFqbFZERPbd679xA7cfLAH3asVnSX29IhcO6kbfES-8WgAFaxbPb6vM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB6DvRysQMGdgxNFZNA7E9uHOrXi8GaSxNQ22v9aZO9g&oe=6A69EC93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
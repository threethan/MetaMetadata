0f&oh=00_AQNsSlHWgzh1mAHd2d78Ak9tLAYPLo1FNZWeiHS_SQFcBw&oe=6AE5FB92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plL28GP3mLQQ7kNvwHsbZzC&_nc_oc=AdpkBTZOrFeYoybZcrXVW8MMJYGgmCqgMmqNwUlxiQPyL5J5-uz8p4muT0s3_0f_uYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpn3TpFQckc7foXfrBBfj_lvGcoSmGbt8Pfqsr4qXexA&oe=6AE5EC2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpVr2wPrSRMQ7kNvwH9LLlP&_nc_oc=AdoavLmkUOKRjs-Tg98fmqjUQ0XKjbN3nBg0QCtJcwguVvefq_jl49vDgEgLoOBvNIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Oild8UNqAO1T1ey0ISiqlDBxXn1PPrUFkXnV0gAJhg&oe=6AE606D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbNOt1EEnNQQ7kNvwH84vmV&_nc_oc=AdoI-jcD5o-QYTKJ78HHfZ55wDj6eAg9LH4COW6vZXbl926bTCdiv1OKap4ikIbacHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrOfL7u0pLSJHEOVU90f1g0za_3PzpDP0GFP27On_Trg&oe=6AE611D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
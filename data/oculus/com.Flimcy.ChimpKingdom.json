0f&oh=00_Af0dRe4c3mAQmm2REApI6XX1rsEGdFsGBfyWlAyR8wuLFw&oe=69DBAC92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRaqu_D1k2AQ7kNvwHfn7Sh&_nc_oc=AdqBvp4D6WL9aabf_-tPZ-iT62dqYbj9Mo19A0aXVRR8QKeYj-AmdasO4eB3KjCPvRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VjlHfLogggtj8lYul0FelpGWpeaRRoOM5vGVQxYOXvw&oe=69DB9D2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCLOdYZwnVQQ7kNvwEqcUCY&_nc_oc=Adr6LYCcgyp17wjMEw7x0ewPSdB3sLhOYdyxQ-k9JT_rD_CmhY0AUQKfZkD0spgASJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mhggQYTnew2oFC8eArFGSp0tPklBKWRYuRT7Oxn6XWw&oe=69DB7F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cyy0VXGc6jsQ7kNvwF87QcU&_nc_oc=AdrUyYSu02CF6y8PyrGz7ynqgBAAz-bYLrSO5v4auieIRVRr5xarwssHWjYJf1Mb-CQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nXGUnaHBDCJ-Pv5ux4izKaprK7Q9NKG9oWSB4VH6Jgw&oe=69DB8A93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQOk7PI51nQ0YMjEcMdFNqGS3S90aR2ZjiF7Bl2cSZ6C4w&oe=6AC3B492"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMh2iPySbvkQ7kNvwFRnq4c&_nc_oc=AdqEvoaFGm4QYZ5-62vSq1gaz3E_eLnlLRTC35gICklCMgaf7L5JaJSuD6Qiasu-kIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2YupeOmQD_jVojeMXZY8asd-mmirWTi_sNNWL0fY0pw&oe=6AC3A52B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnmeEeEaL6IQ7kNvwHrkmfn&_nc_oc=AdpegSbFFLlx1-65mZjJ66lHW6nwXYnTHpvikMesJmRLFp3hf486xQLYqywwDPjRoh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMg7GkLiREYLPztPW3gb_8L4G1RfExdgivEOh4TOBy2g&oe=6AC3BFD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ANTeKXcQV4Q7kNvwGsuFNS&_nc_oc=AdqZZUdicbBWaHKstM2aUTL6pmelcPclBAM4UCH-ZSyQ6hvE1Bv5iXKRDPYWlbfN1Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpHUkGRwk7keZxjWejDhlWpRHfFiuKtU8LPg5ldIyrAg&oe=6AC3CAD3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
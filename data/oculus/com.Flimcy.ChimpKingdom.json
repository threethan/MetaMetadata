0f&oh=00_AQIDX4OX45F5OVFSz90XgDvgtGmhIC8sVoIw8UZTRiUcKA&oe=6AB13F92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36qSVwjdQKUQ7kNvwFpseB4&_nc_oc=Ado-N9pJIUJcyPMj1075PbbQINskx9nIRsMSg-Sl68uEXQOtQtvEMAL7cHf9wAp_XRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFoM-4jrV44lLqPEMwDcVbmI15H6me5xNbkynnIfS_kw&oe=6AB1302B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MeYcO85vekQ7kNvwHW-WCb&_nc_oc=AdqBBxkQbsbSX4mXL5xg0DjGj8RPEjSVSmd4ONJw7nqCifpUbeLeVPlm0uJX72PNgMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4-C2Dhct7-RFpS7HtDlCHesISbpxtUsvUYDBxWjtAOA&oe=6AB14AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhUg2tg-ETcQ7kNvwGVsCCC&_nc_oc=Adq_Fg_cTCyFBKDwuFiTe-aPvRLxkwkbdo8A4QYmCd2sHTlJrSjWm-95l7N1BrNZP2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5z26NB3D-E5Oo_1j0ZFbuD1H-zIqa_sQFJADeHzGWsw&oe=6AB155D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
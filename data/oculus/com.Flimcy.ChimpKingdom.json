0f&oh=00_AQCEqfjN6dd0Dex3f5oErxungVAqiHaiWl5GqNRbeVrNcw&oe=6A5CDF92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsNCj-PuiPMQ7kNvwFNJVbu&_nc_oc=AdqjoMbEsBC9HOLuysbbY7aT6u164xI7V4bQZBnOgik6IJ-pG0TVKlssFxiR6vh5mkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC382KRIdH-EZxn3KdSNz029QNzNsbSXtFFYiBpjF8rpw&oe=6A5CD02B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2tqHe1afWoQ7kNvwGddkJx&_nc_oc=AdpJ8UMxmpe72UZs_IZJ-pnQH86k8aUapfFr0ysWWRKAx026pVNfjGFLwUUhlKKH9PE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8g_gfBU2s3E1ReUw5ydIq7icapNtQV0RCcdpuIKPGuw&oe=6A5CB292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5POuK_ZswkMQ7kNvwEHpwjj&_nc_oc=Adp1uqI8WhoitUPMkb6AfrRaLrtEEukZ_5GtLia2MgrIdpYqutr_WyEN_7xBNqG-BVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD31oJQW7YKuuWIHfUxfSAk7bM4sXqLCDPxEOfFKLIZfQ&oe=6A5CBD93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
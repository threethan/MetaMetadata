0f&oh=00_Af5PhCnTtV2nbkfZn69KhZ3f-DD1JfpMNbQj8mlLmFDkEw&oe=69FCA212"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWRIRUxdOzkQ7kNvwE_5b-c&_nc_oc=AdrUARbzBQMusSm0JM9G5iWIWQIa3gvh_l3Fde1cgRIP8cAQL6jawv2TEDcnhkAkNmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qx-fh2I50S6FP6UwDY_x5knVXWXLLCrHQi5Cnbw4t-A&oe=69FC92AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDi-SulgmMEQ7kNvwEk98yr&_nc_oc=Adom6FtDrDHZHR0qVv6HQvlUX8hWGfC2-n57b-CrTCSy3OuR2FumvRPh3SQzlp_GHJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Felm-3YvJOGc3wBM8ZNGdbqPSATdRvpTGQAgSSC4q0A&oe=69FCAD52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaO8CWxXbYYQ7kNvwESMsZR&_nc_oc=Adq45gV7QXIyCDsOMxVFMJB3gkONF6bVlsjwbyb4VrDCo7cBnHDezN-mSBmrUrFdP10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sDdq5-PvbKuXioRKnPhNV9GOkQYStBthSNFcEtyXmCw&oe=69FC8013"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
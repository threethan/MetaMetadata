0f&oh=00_AQAa9xex-TCEPck9CatOmnRZUzYI1aNHdjPL2D58TMxO0w&oe=6A676B92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI1wuFlwqiMQ7kNvwHZD5NT&_nc_oc=Adq0jAq3evZNyys6MiCer82maER00RGhLyq4PEi51CTKO2vW3fcLXCiD8uRLL7vMIHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEXrKK_FdTRxfdu448aTAjNypxM0L7rLmXzyNa_lRaag&oe=6A675C2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzpBwLh9dOYQ7kNvwHkQIfL&_nc_oc=AdpML9CvJo2D39X9e5oSiFaWMqp07Nsf3IVxV7waVu7DZnvqQ3kf_sEFRx3k1aKfZg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3Rlm7bWoZ5itM4uGrrM53hrilveyTYuFjyJbJ5g7bDA&oe=6A6776D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wOrg7vzSuwQ7kNvwGpXVwC&_nc_oc=AdqsSQEiNIl0efifUms8DYpvC56CPEAtSyXKHBfynSisPpcfM1ex5OOjBqiTgCHLWmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbKFymLCV4m9-My2n4j_8YLohQaE1jSW51LnVxMMSUsg&oe=6A674993"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
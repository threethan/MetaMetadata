0f&oh=00_Af2e3iPqQzXsNdGAoyWJem2n_CIZ69hLOFlrw8EEOyRqog&oe=69E4E712"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUNRmPJQ9U4Q7kNvwFrk2qv&_nc_oc=AdoyO_w850EE75jlHx7g6YyrtciYHSSM91VI5-12dS37kKRSN8Zva2jYbmSX0slUaeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z3Fxt_shonfx9ePkTmArzxY5zx9v-MIvpBxbggV0xgA&oe=69E4D7AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcymYfvursQQ7kNvwE1eY9t&_nc_oc=Adq_FpCUfMaTkcGCjYhvcquFboMPoHt_B9NsAfylCeTaeetNFBhgmEv0-oJQ4CWP2RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XDE-b0BWdVlnYfilGqh8NJJrmZpSlRkkMPoGfaJyEzQ&oe=69E4BA12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa0rDOQql0sQ7kNvwGFje3Z&_nc_oc=AdokgD38pVsrDlUueJDxpEhinBQMnFETvvwMSEI9a-1HWhtaFd2mrtzMBFNxbeek-vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Bc7oB-mZlywtgsjIvHfW6GHzpttoJjByNzicYUnnwZQ&oe=69E4C513"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
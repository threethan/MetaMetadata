0f&oh=00_AQJdFQExefJQDsb6oB-QN0CFXcHGR31JnK7h50Ri6L5kFA&oe=6A9ECA92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f598zuM-cDYQ7kNvwEfIYQa&_nc_oc=AdqorEMrqgNC_as_tOqpjzFo3YxARmx5D9YrCTnkEYRy08eGWMw3WFPf4Lv2KpNECBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ8Mhnkc_2whEgoEBzp8NYqii0GB89sIA3g4MknB70aw&oe=6A9EBB2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrHx14B0_REQ7kNvwGxN3ry&_nc_oc=AdrU0HEqI1U-lZ18PDdze3J0WM-L42BOyTyMqRG9aHqo1pXiU7eRuZzKHNVyuHNPItk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbO9RXBDoueYI3CtKwGU1cEeNXOuaYT3pjwSajS-d3iw&oe=6A9ED5D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV9MR1mDU7EQ7kNvwGdfFGz&_nc_oc=AdpTnJkLOkqMJn-ZZM97SrtmYcVizArxpG4u0fRcQi1T5JVDLmvFtiAPiBI4nQWRRW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsIdymjZY89rdMpUwb_NN3auUR6MvLUaEh5lUNQlKweA&oe=6A9EE0D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
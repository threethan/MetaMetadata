0f&oh=00_AQC6FsvskRuL5Uq-dgV0A7BEYsP7jT4BkiUf46V34jXzxA&oe=6A4FB092"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RbcjF3HugkQ7kNvwG4_dX1&_nc_oc=AdrJiOkDraL0WYmzl9td_F-A32yIgLMGAW1OPZTy5tgYKT4HH6KXbyj36-heG82gO9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmgbXcxyLYq5cBK29QUTgSRR6C69xYUQAtSQDiHzM0UQ&oe=6A4FA12B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7i8T3gxxDwQ7kNvwHMWOv5&_nc_oc=Ado_6BCV0pMSHWkCmrZvH8lvekgVGYCgIy3DXxgEp9TltaQJ_8Axt5R3U0PzpMyqw5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBipZIhEJGNR50zkPERreT0E1siBufOKlTq3cItEIcBRA&oe=6A4FBBD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81eBdgTt-0oQ7kNvwFWHd7C&_nc_oc=Adp38TxXafaBq2crGG_Am6HKnf30hnMFShjMEoTDnM0U_dwM1YQVR5t309Az4SSGVLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGTSAne9pbnbBIJ8vxgoRX8fAeAfvi71105RrOC_0zlQ&oe=6A4F8E93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
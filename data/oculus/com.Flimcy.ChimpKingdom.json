0f&oh=00_AQTKiQ8R-CrbS-Z6ybJOb1zi0zb-tSvizjpS9Ix5TcAdHg&oe=6AF5CD92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nURjtlhvW1gQ7kNvwHU1sYj&_nc_oc=AdqF8WrlpWuEk4D8EVfQp_AWnQEHgimcf1d0pjkZTVUc6LsZYGbG-j53cMSlH_1GI-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt0QAIheMO_X4rT_8L8K9yNtGslbNqPVxOLaA5r0we5w&oe=6AF5F66B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jboJ4pYrCOkQ7kNvwHVE2lX&_nc_oc=AdpbQV25Qb6YGF4B2L3JE06kfAy5_NQxqv7tKSjS-Y7GtlhASHWcFWbI0ML4KTCPIs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqFAw2lzgqmPKyiHgtm98uCIqcqwf6ZP-tKSMkdEhZLA&oe=6AF5D8D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3uKyMABIAsQ7kNvwGvlS0l&_nc_oc=Adr_Y_EpSUkk3h7UzLxUfeQXpWuFa041GiFoboQS87i3muMcKnqAHYT1j1a6bA6CfEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMI1EzR9beJ1dutyZcFv3e-ACgzb2L3IGvGmMogJeNtQ&oe=6AF5E3D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQRxgrF4J5n6KQPYWty3Peftrcwpabm_ZLsSemCjMxX0ew&oe=6AEB4192"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T9dD8vrOlQQ7kNvwHLZFMN&_nc_oc=AdrBwDAHWYfYjhlWy5mYNnSc7L4R6ABHSuKC3soFJPqEQiICPbBZNsfb8jcsLSnVAWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTize_LAmxhlbreywWK-UWpa47IzIQ_WCYJ52r4XpO5ZQ&oe=6AEB322B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq9U3qXlHEoQ7kNvwFK3Whd&_nc_oc=AdoqlpzF_yDO8CXAtwypX04_ZX8qRkKy5jRiTR1kZztYlw2SqxPcEuu5YyiESF4gm-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcnMKRgQr3iynZ2jqn7pHzgEZWGdXrbt411oOsSzfRgw&oe=6AEB4CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfVUERRod68Q7kNvwGmv7PE&_nc_oc=Adp3_aHM5nyH0ZeJMKDIGuymYkjappy2si9C0GUJwPQCggjeT4ws_ogJoFHF45pVDPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0HYlLaaMBOH8xddpndoDJG7juFPiYDN_4UNXv9kmnqw&oe=6AEB57D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQKWcSQk88JWCePqe6QQ60vOB8Q3fCHAm6A1o5TstUbdbg&oe=6AB29112"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36qSVwjdQKUQ7kNvwFtw5ac&_nc_oc=AdqYovEst-eyz4H7XQ9rpctlodsPCmGqr8_9058xTcq0aURtUrMTCbjdtBjzIWLIIZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZv9tQiZhA4dabW_0d3z5hB80tBZdRIKOA8j2FjodgNA&oe=6AB281AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MeYcO85vekQ7kNvwGo0oGq&_nc_oc=Adohtc5lqBCPXUpV3uOZt9kmchgnGTmwkRWkWbIuEfLzkyp0W34K94oH1GQPNEGiEYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-XpytfHNz6nz-hbSpsQCkQSw4Ks_3wkPJ_x4UtNGdBg&oe=6AB29C52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFuloaJ0qZIQ7kNvwF3ouM-&_nc_oc=AdrqsOa3IARSWjI_BXlooQHUohdktxz6F1P71dlu_2r28PJNzWI_yL2LaHevEhWBZAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMUDGupnLN_MiaFkaPy8bqLy1z0sYJoqsJIZsy7d2kAA&oe=6AB2A753"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
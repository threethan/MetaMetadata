0f&oh=00_AQEJOm954_WXkWxLMircpY00herdxoeHYaWOB0vonIG9vA&oe=6A975212"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obhfh4Jg3ocQ7kNvwHlBxYZ&_nc_oc=Adp5RpBuIFEDDTPYjNjOLa4e0h_BUy2RZSFDfBsg-LY76Pk5xL3d3mjvER3uJJoNBnc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNjVykC7wnNRoEjcmt2g-dheTezJz8dk-23nqHv8I8Gw&oe=6A9742AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIMkZrLYrmUQ7kNvwGNnEF5&_nc_oc=Adpl5Wn7RKfFoMzdtV8pgVbREgJyqXiF5Rj7D_3bZNs3DFCYT_AVXHVk87gOXYb2EUo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEn1pU9VCwZuv0PuJXH2UT3L-txAuQ7BbwJl0nZG0V1g&oe=6A972512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0YK53P6lG4Q7kNvwFmF9gO&_nc_oc=Adqle600RlkFZP3xaXN5qZXyPS9Q51AFCbGx_3BMGjz_m0Bht2Uc_3ZmffOCpv2Illc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNPHX_wmXb7ziFHAPT_JG1kQ17uPopWdJha63uvrHqGQ&oe=6A973013"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
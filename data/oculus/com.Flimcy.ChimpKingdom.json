0f&oh=00_Af1Tq8Z1oE4KEUSg_iuXJIrGMcySeuIsk84SpHmBtoofXA&oe=69D27212"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z1iF3_rvK4Q7kNvwE2-o_V&_nc_oc=AdoheIx_r2-CNDEXeqKKw8DT3-JlUOWc9ZOjTsVopAamPuFNx4DMD8nEfLIDKxx82Hg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xgNM4FaQZNNye8u_i_yrcyzcFogsKS_kU32mqAEdY7w&oe=69D262AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_2Tr9NOz0oQ7kNvwErp4js&_nc_oc=Ado-icluPA_IAqzjIdqL8boGU1GWbxrkUMKHiFex2DQtpJDhdxlO9yJMcDFh8-Jvmmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39U_DS2B1m3AykVKerzkPsse0UyMeUiV-D9d38e89CIg&oe=69D27D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H_fAj_lHJYQ7kNvwG446nI&_nc_oc=Adppvs5NqdLtOONXC2EFNNwpHKzcEjm0ra-O4I8f5fZEcf1tBiH-Fg1CzLDOB6yagUw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bIfE5aMY1K2nTwHRHZ9p6e2iWqhPnT2KGkapaXNZu3A&oe=69D25013"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
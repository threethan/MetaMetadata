0f&oh=00_Af7-QiWo0Rc250V9gQzGGAvhz1fKf4qeGYHjG0N7LR4vPQ&oe=69FB5092"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWRIRUxdOzkQ7kNvwHxjx9s&_nc_oc=AdqljhS0xWj7yZTzdjDgL3FFIgHSHkI5pEXPQGeaPQK75LrHv-ftOZ24GKc9Pv5wrpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B1iag08m3qjCrl3qqt1s9VeD-ikRpL8gDLPAak17wBA&oe=69FB412B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDi-SulgmMEQ7kNvwFVycH8&_nc_oc=AdpLd5LN7BjYlqWg6Gk1wqepCNAJqh2ArDevsk1B5cTljTdgJwwE8IW7Oxo1RBKf2xg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J3FmohUki-OZAqvxRjq5myflKA6F6xtfW0s4IH0h4lQ&oe=69FB5BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioTHEdYSZyUQ7kNvwHCbvjy&_nc_oc=Adq6jsxM0wrfkvRNnXP_lfunL44Xd9X70bf63sB3z-Iol0oubR8Z9Q276HkH1TIfOH0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QGAySCziROrwZQTKcPsRIdzUajHSs3hpp2lxU0rqAag&oe=69FB2E93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
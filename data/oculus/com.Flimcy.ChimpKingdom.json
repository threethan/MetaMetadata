0f&oh=00_AQIQ-Q_6vn-9Bo0H8899yxzhknOSl8NETlUYt0Qx1Y8E4g&oe=6AA80512"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDYqJ3i74j0Q7kNvwGFz2Y9&_nc_oc=Adpj_gfFZfw6_iNRUIGP39_ObCwdAPQATRWspQhhlWzgborTtf7PxyIAfb0EWYrFLGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK7RpnGIUpj8YeUlxuAJkZmtZOiBNrjkDcehveu4PdWQ&oe=6AA7F5AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6mMaO6x4-IQ7kNvwEXFIGp&_nc_oc=AdqHBq80B_Cd9f5-b5P4g9qLA5mMV-c5EqpLHued8SdIwbyLZz5N7dcyaZdUd2rF_bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOUqfosbJN7HtLLqRoHK3QY8m2NoPLPJqOfnA04GQSwg&oe=6AA81052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2BQQjAC-LoQ7kNvwHi17wy&_nc_oc=AdocddERrLFoX-5kIsMiuZ6Yhrq4K7wlvh97sI72-xG8nahFGgAMAI_4kDb17ibtWy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1NaC2gLg4fKIYOzoUF-AVgOpKmDdmIXXCoarADsRASg&oe=6AA7E313"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
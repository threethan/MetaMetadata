0f&oh=00_Af_wujHEHoOm-OZUO--zDJ_XEtw9B0SHk0vIszitkixsuQ&oe=6A3FDE92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt1Vu0WfBCcQ7kNvwFBJsQD&_nc_oc=AdrfZz6NGU7-THPJ70es26WwJFH65BrY963IXtVlbC-jRnXINFhWoeofg8nPrNgimD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k2A_0N8CMqqr7VvyZwrzQABXoRkVJxia-6gIWF9BOPw&oe=6A3FCF2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfnESGnoNhQQ7kNvwHgBce4&_nc_oc=AdpmkFsDBosaxqpcmD1nhfd5G9I-m4xk1hhdrFDkXPKWqbLM2b92OmSAEhB1o4sQ0f4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Wa_EIPZKi9Iyuv8EYEGsVgpgHFDGhRenxKCdr8gUWjA&oe=6A3FE9D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csCBwnxcoNEQ7kNvwFVg9eI&_nc_oc=AdqPj4J-xA4OMgFrPvUAL6Ty2j1LEO19BrVV5I1aWP4rvrXYWk0okMJe5rSk1nyCIUA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h_nJW0NJNrtfvv9AG1lUfth2zae32VWBo1CpAUOrgsg&oe=6A3FBC93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
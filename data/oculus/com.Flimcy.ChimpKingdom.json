0f&oh=00_Af3posRVAkTXFbw3G0VS6J83edp_gASUzpnTO0lHVHRgFw&oe=69ECD012"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQXkp-dv6agQ7kNvwG9SF9e&_nc_oc=AdoAXJEJg0RiccloXh-QqaTR5KOwHplAqYOz1veXmw7Gz9kiJ7wZ-IAkUtngcoqyuhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ujnm01rVh8YK01BPa0Hekxp3NBHwPB90zE1qMi47QKQ&oe=69ECC0AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LQCY-11vPcQ7kNvwFbDNV1&_nc_oc=AdpTVAuemoaXfYSpdep4dHLvPdVs0tofteKqrfjW5pvlrI8Z0YMpf5IUcf4DCbAQMg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yiaC3Tg5Eqf-tggYAyM5VgvfNkU_JazL88udHIDgMEw&oe=69ECA312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjqvLE1PgvsQ7kNvwHhGzno&_nc_oc=AdrlJhFeHuE4r5t6G_FtkxiWxd2D40Zi-aDHLFj8Oe-cGZI0la7L1enPGxlUWAWCKAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IOWKcWhJW-RRvJBFC5bcGyypTnkyUQBTwRqnon6dlsA&oe=69ECAE13"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
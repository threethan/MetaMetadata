0f&oh=00_Af5VnR7zsWEokLWoEdZvIumYBjl_DC61MAHDcNLLGk9r1g&oe=6A203A92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNaHpqXcQmcQ7kNvwHFHOTM&_nc_oc=AdrCq8Zi2GihJmRKitgdtZpvRarwLkX8BSmDhSRDz0V0laqKTVAsYp4ZBXbhZlXQwqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Con95eKkaEocqajt_t1Xnn8SqQkRHjQqCsxQwll1FUw&oe=6A202B2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH_-2ZrKV-oQ7kNvwGlK0o7&_nc_oc=Adrgo4FamvvyrkTLhN2bh74lm5_gn31UUFwiJOvMx6Dih1uDDThlIktj5Rb1vrp8O-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OlO2gBpN1Mn_NoN7_P4j4czVPhQP5DTtTgQp9E69Yow&oe=6A2045D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMB6xlxDPW4Q7kNvwELLhiV&_nc_oc=AdqH9vEuLl9kUx3vDC2x6cnJRCfzz_Fkyijl4KrofVgxQuxZbrVtCYw4rovXY2Kn_J0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WnjtSvuFJUzWRQjx-GF-LSCoXL-T1pYM7j4Q95DCNxw&oe=6A201893"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
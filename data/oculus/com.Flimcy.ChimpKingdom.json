0f&oh=00_Af0QcvZrhHboL3mBWyICwV_XUMdLb0Q4BFubg0QPaXlqFw&oe=69EF7312"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs4xjikUHCAQ7kNvwHs_9yR&_nc_oc=Adpv6qD-tmPAMANCj-r6IyKGatzwNRcDLTfhWp-inK2meH7DlcNx27XkWuTbIIYNqmo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af123RiUykmi5O9WgYy7Ij2De2M7mhap6ytsWuuaCpld9Q&oe=69EF63AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lFBWyrLbIwQ7kNvwGT0ccR&_nc_oc=AdrzBGoqY8BdVIZcnZ8XyI0OWQdvNATXSSoUwhXOFW5MS3lI4nxHPnY1iFzefmuM8Ho&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cP8YfsijkQUypP2F-z0pK9Q9KBuaeU7NAlwBHfwnwEA&oe=69EF7E52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjqvLE1PgvsQ7kNvwF_43rJ&_nc_oc=AdpWa0bWYQBTXMma37_fRroCr0tAYPh0MYIei7zhjZ2E2MHbjcNuSY8YqzpZf7hcsaI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3AwpT1lCxr8bU0SZcQ03FFxnS4pIaZq-kKnmC7634TiA&oe=69EF5113"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
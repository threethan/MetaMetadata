0f&oh=00_Af9k3GimvJQU1y8-NzPELupuYUjhcSTd5zq8eSikAeT7Sg&oe=6A3A9892"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWXSpWemrKoQ7kNvwEMfKKd&_nc_oc=Adq6Bpn1Eeg1kWnlqZ2BaPCxzaPyZsfN9MrJfjeybthetuuTOXeSFKIzN64mrDzi6VU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S35HOKrtOTdu7OszfblsSlzN1TvIJ8U7t4J4fvJVhfg&oe=6A3A892B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL759SgWD2EQ7kNvwHo6VLM&_nc_oc=AdoM5OfI_ug_9jKQK-pY_qeG8Y0SGZLkuva9h6rftW3yg4VHyJ_7ZRWYg5lqwJ4ni1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yVE7zfMlfDcZFQOhJWw1vU8NfzP9uuSW5R1irrFJkhA&oe=6A3AA3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpOur5Vn7aUQ7kNvwEapQUX&_nc_oc=AdqeI-MWWnWXKm8ooj-GuR1xEPks9iFTz7eZiDUF2dFNFthaMCMoZnOorw6nJ9VYSPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ghdBoh7stJr2TbJwUt79niivtr6Tb6temvokX92B8nw&oe=6A3AAED3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
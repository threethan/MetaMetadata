0f&oh=00_AQLkIESvg84o96zJngH1iSEF8_xW7ImV9V3J8BrVal0vXg&oe=6AA2BF12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd3XbG69phMQ7kNvwEj2J42&_nc_oc=AdpnrlL7IVvV8njWfyPLs4wunjtNfZe5IBaT9BFCO4uHY3oje_eYsYSnJHyUZmd4XGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2yFIy2j3hJY6aTQJCjgebg4wLVMyfVbhMi-p5zuKUOg&oe=6AA2AFAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5XsWpRljDQQ7kNvwG3vJ-A&_nc_oc=Ado5BevEffsILdk40kLXN5G0LBftQhXWTY9omz92YDiSPg08KAtGK7ddPr8j-zeH1jQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSuMdYL7P9njrQcBgYv3l0LtrbiVLO6u3SvYPws-dF6A&oe=6AA2CA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQxgF4RPKJgQ7kNvwGhi47P&_nc_oc=AdqhjUx0AIaNZzFbVXJJ7F1PM5-cCqBdNHUkbnRB9WOqaKzCnL0Wcwn62t7NA6i8gUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHyK9AhjGzA5pa2mASulIvfjgaSSkxY9ut6e1YhPuWxQ&oe=6AA29D13"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
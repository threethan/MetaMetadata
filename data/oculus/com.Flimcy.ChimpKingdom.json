0f&oh=00_AQGruwYqQuYAFj4kW0UOFPe5O5JErbrB5RwdYNRy5PGMDg&oe=6A916352"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGpoLum03rcQ7kNvwGFtYlC&_nc_oc=AdqmgYElYtAM58hWFAvTLtuED-6q8nb1AgmVH1zvoz7As1OTTwlclOuS3cwuUaFR0_E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVUPG_eftEYQusNs50t4IW8uiRVWn-BoeyMF7EOgb0CA&oe=6A918C2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8AYgxL0QXEQ7kNvwEvZRd0&_nc_oc=AdrcI4ya5-ckDabKAtjy61ERcaIs6REhwwajAcWH4CbWl5FYs7Klx6vdsaLNEyhJC80&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjlI6W4wHeMJ8t9LDDbpCgBWj7AejznXPY0G7GltvUPA&oe=6A916E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJKacfYo-8gQ7kNvwFoabw2&_nc_oc=Adrf0qUTsNWtS-6Dv_0J79GXfx4nHwr1J47kOtbD0oYfjllA52aBS_Jll7rVrQIoFCo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJqJzfaNnEcGZupwqVsCfElPUk-oaKpedzSI2G9Wd6zQ&oe=6A917993"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
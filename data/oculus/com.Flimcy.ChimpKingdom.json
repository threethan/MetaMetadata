0f&oh=00_AQK0gpak0EV67rl9IUsY8JlfdBgQLH3XwAfnR9hiFyZnHg&oe=6AB53412"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=663WHwctPj4Q7kNvwFuAqEO&_nc_oc=AdreoGfUjJ9x3WhrVLTRsSs9E1ut6DmcRiWNDdKKHvI5nin1a5Jp5h0IkYonBTTgoXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJamJS6t2RlJkLzfJ8-TvvC52EwYVBWItMJDgs4us3Tmw&oe=6AB524AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugnxng_98o4Q7kNvwHowEU0&_nc_oc=AdqwOxWFZIBGj3U1woelgid5vbvpDFwWIEIXXVP6J5z0ZgAl58ZcC0A5DZ7cA7S1syw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjwV8ftnrAT2q6UaSOfj6-WS1XVBbenfZ6ijSXZqgSvQ&oe=6AB53F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFuloaJ0qZIQ7kNvwE8I6Bf&_nc_oc=AdqSr2isytorWeHWAnY71axrPkVLzGy7fV4m_xFFqe3k_0qPi0qrgYG7I06GVQgfbiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmHsSEl6HPnJzMWNxFQvrAi1bvWNdBiFgchZ3e-fB23g&oe=6AB54A53"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
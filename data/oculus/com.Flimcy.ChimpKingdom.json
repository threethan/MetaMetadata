0f&oh=00_AQIFNjCMgqA4T4602TBRGCqBPFjonDDaKAseXzS7ijd-Cg&oe=6ABD1D12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co1eo3AVRt4Q7kNvwHFUqB6&_nc_oc=AdpCXLFB24Le-hpDDV7mw_xGT3ntK2C7RfeVFem-iJOkbHB5Zo5V6nZVTruKfGGvdIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKW-q6k7P9UFQkrmAuWae0ts984dasHBRMFLDB5GgkmA&oe=6ABD0DAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3vY2S9g3vIQ7kNvwGeowWZ&_nc_oc=Ado8z533N55DQF1Ska6c_TUNpW4MfaBSXIK7PI_T-XNVWDJ75IZH7EigMXdf8IRMROI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDcB4AjXCP1S7I9UXbpZow6dPwWtttdukf8VBWa-1DOw&oe=6ABD2852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRaxqfQ37AIQ7kNvwGJbWGl&_nc_oc=AdqnwTUM181AquOq2jddBPno8lxXNOomS4y_XvujkHIGHiT2iMuV039SNTQSY4YjY_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4ORPvyzfUEOPcHeCNcWKYoeh4dO35K0sR2WNqf6tsDw&oe=6ABD3353"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
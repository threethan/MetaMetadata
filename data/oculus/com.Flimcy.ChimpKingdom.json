0f&oh=00_AQLxJihB0RSIhSCjoPZN7O52qCbkUoXKCQZl04Zd7oRRzQ&oe=6AB68592"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=663WHwctPj4Q7kNvwHnxKLc&_nc_oc=AdpKQctHg3Tj25Kco7NpbTrNU-Rwyhz9E5fj5SHXEumZMQvFW5ySiYqOd9u9_ZtQ404&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVhPVOhFNP4LJSHZ1_o-nHgpEAw_LdzURwy9Fti-ejrg&oe=6AB6762B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugnxng_98o4Q7kNvwGKznIi&_nc_oc=AdqpYcDbb8DAtffeiYzl4jrWwNsL9vmM8nrGOfOsLn0n49I0gGQ-JzoPm13Nv8CsTCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZbuUQEwOh2ERuuLgUyPtdugfCXZ-820CxvpEJQcPGBg&oe=6AB690D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DERyuZhwtFUQ7kNvwEe-zEN&_nc_oc=AdoOrM_r38GBOYli4mwbkA_zXiB3T_u7ZCA0joCG0_x9d1coLQgW3zRnVSgqCbB0U1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM4zt7Vs9OaBppCv8NSCZxwHA_n-D2lYZHEf8GYcHUFw&oe=6AB69BD3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_Af9tcwW2jJki1aQqag78GxQErOiU5F4-2xYgQJ4LqpuM2A&oe=6A282392"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=temwgsvRsj8Q7kNvwGmdOEJ&_nc_oc=Adrji_uQ-zmOvNuZUvEFe4bZu4S2XRB6bYVuj6cjP8dODl6tHeHMGFAliT_5KIWb7_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3kMZM_ZexwOXFZ_9VsLc_4DtnrRkMJjVe9jQ-V2xwTA&oe=6A28142B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB7YqmFrqvoQ7kNvwEx6jj-&_nc_oc=AdqajbNkNd6_jNGIZkoMPflQEXRrSHTfntvZOCvD26q0S_ST4uIF1s2Zsq0XXJ1yT0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8msI7ej4pBHKbFscvoc3E4pIcjkf6obw5nMLYKnTdFoQ&oe=6A282ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7K5FTxSnE-oQ7kNvwHWHVas&_nc_oc=AdokGjVs17g2oSSR_s8CBJVfnq8lZe29SKmxOzFbX5PuPyhOEFcvXf9R18incQMu3H0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aQvroEHF8ayaqeROj4oYo_uZldqR4K5DJ_6GXFNM0wA&oe=6A2839D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQBpxm5zUN2nj--E8PomvJyXxyL61wt7dXBG7X2PrYvRXg&oe=6A54F692"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WfrIt4rwE4Q7kNvwG0PHoQ&_nc_oc=AdoFNKZJHXIe0VNsjD3SgpQF-UEU3cY0NayZJrTr1PCayZevSNWdmDaUoSnM2pH1UCE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuWMG3B_K89Fj4WqBCZh58pB6j8P60nwWoUjuBY137Ew&oe=6A54E72B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pim90zoWbe8Q7kNvwHwxrJN&_nc_oc=Adp3LLKOK_upB53rEnoEpvfmjJgNHxywhOa2_dLOmbzgUTNYGM0MKHzDxcZNFlSVH_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_2r33OuYTMgiDdqYz1GOfA16BNeE0-kWiLvUQMomlLg&oe=6A5501D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-JoMQPM5kkQ7kNvwHMn0qZ&_nc_oc=AdpCdbyNOgYbSiIUXpQaetUgD1S6ftlBbWyRwA_NroZ9UrDuxn9p_Av-TBv3D8XxlYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrQNV3W93IwYdPpInCVZIq7RpzV2R7GYQ2DHvfYmZpeQ&oe=6A54D493"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
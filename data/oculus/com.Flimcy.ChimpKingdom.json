0f&oh=00_AQPuGXfyhnSZhqX7yva_jxnNEIFA5w-yhgXJYSatA8f5Ug&oe=6AE0B592"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98JUZZLR7e4Q7kNvwERdK51&_nc_oc=AdqOPo4hmpaQsjEv6D7wef6huEYdj1MKVViNTHJ2751MBiqspepEzFQbAX7EaL_NtvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV-WiIbb-UIs0tPY9xOvshTNX1iUr-DDlrxzo90J6-OA&oe=6AE0A62B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_tqyq47bTcQ7kNvwH9g1A5&_nc_oc=AdrZ_9h7Fw1HIXkZX_x3gvLXiu5ktFqYkfMXxBp66cZjXL2L35keEDPyCBQ16UJ_stw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDJ2RYFky7xdZlzQBsFQFuG6eO9nHs0T7vSpPDJg_Y1g&oe=6AE0C0D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJuis31b6t0Q7kNvwFgkzPo&_nc_oc=AdpFJm9pr-Uu5R6OTt0JfCunpD_nK4TQW4t36pZ3HvlkwrMm_6CFyxCvCu26lXOILA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZve39VSKbHKCEFVmiNSkZ2aj91s27BupV1K9QwfOlMA&oe=6AE0CBD3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQDlJ9vlAPKhK5LqpKOxzvBTKY_DJI6QWAIIwlqqo3rNWg&oe=6A6CB192"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKiu8o3qKXgQ7kNvwGPoP55&_nc_oc=AdoclXIT2cqBdD3_dZ9NE6L3stjzPVfs1lDJXeW6-iCS3_Fx6wUk_y6buv5cIeJnfrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwQTJM0gZy4EgjdFy_DBoaf4of4eve_zGHdWfIcBTkXQ&oe=6A6CA22B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87x1l_xvqpAQ7kNvwG9fieY&_nc_oc=AdpksE7l17sXFWkADAmgxQaonzEx4NRQuUdnB51dEvAkUHCds-fLlk2GWH9J8q_HsLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCciUi7FYsrD_AflVs_6W53BPRV0AFHUdmLyRV1qzng-g&oe=6A6CBCD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7QRkUUi0QUQ7kNvwFnTElF&_nc_oc=AdqBu8nAxatnsg_6jHteN-xWh8btRDZk03n86WD38oB4Elb7DJd4WtvJQFjFMrf8AaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAD4uce1WJ0JtN2alQV_Ik9PX9gzXANgFw0Go2ZlxkZQ&oe=6A6C8F93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQOsPP8zXrvE7qFBqonnt6I-maSjA2a79J3w28hb3vX65w&oe=6ABFC012"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co1eo3AVRt4Q7kNvwHOgHrC&_nc_oc=AdqvcnlaHf97WnF69geZzWm19Llkhjhvy7HVzMGbmn2Q_ABHxNQ1C0l46v3SL60Rjyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTc_mOjfv5Q1-94pPenwymsB_AzZxfenaI0PYl4RW23A&oe=6ABFB0AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3vY2S9g3vIQ7kNvwG7x6kQ&_nc_oc=Ado9BqI3Y8srOdx4YrhUOPmuQluzruWxJig_kxWC25wZlj-uvEMn3lCiC85zJ-SFOvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPtyS0a2Y1SgxdLwSwMAW3XSRyaADEsE-PIcWlsuguSQ&oe=6ABFCB52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3WpjAp4jqoQ7kNvwEQxEU_&_nc_oc=AdqEToFgS3pS7NkRePxzFe0RUIpdyWku24AVFXCNcB5yGTg8q9taku77u8BP4xRaRME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNix7m-XvNFe4EXRt5htQKnjFPT8b4nCBBCTnm7SqL_GA&oe=6ABFD653"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
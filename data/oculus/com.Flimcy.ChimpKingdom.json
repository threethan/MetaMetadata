0f&oh=00_AQEDFKDErILKLt1akqBX2t8voGrMUa-zA4GgpXMVPahVww&oe=6A843452"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Axz_VwGOnS4Q7kNvwH0IEps&_nc_oc=AdpNLb4sE76o4jMU0RvB0C3sba3uIuy2wiC6-ciEx0xb_0w1mJkDttDCREUeIE2nyAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2KEdPL3jhToVwbE2mAY0HNP_f-f1rHowtbDbFr7oGBQ&oe=6A845D2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wggSBL2lj4kQ7kNvwFm_Iwl&_nc_oc=Ado_eKDpoMI3uVhJWp2iJLJUUYFV8cWRsemScwCOl9R0h_4wl4aIQGGv8xWMNq4_2xc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEzCKzPilME1ZbvohgyeQmDu1zMUo7iP7MxhMoKNBXbA&oe=6A843F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5vD3lbfG2kQ7kNvwH34kmf&_nc_oc=Ado2iwrkwqFxnqCOms98TjZ9Jf8ZTv5KBvSwrlhuNU22ilciT2kujndJo0vLKNvKkcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmFV_K6m0LMqRB4gtBLTpLafueztneRaOEkYBc9JuvBA&oe=6A844A93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_Af0I888aaekj8CF5E4dksINWaI_98463RssTqTHvYo1x3g&oe=69F75C12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QocYOm6hhHEQ7kNvwH6l35t&_nc_oc=AdptkMrhv5_rqvOhm6HhauAyPOdSc5szFjGtTClcS2JT8q6ITbGFk3GtUsQp9ClgnyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mBRU0pVvpxqUXf2gX_SNJb01j9nVdFqzfuNlu6cnKHQ&oe=69F74CAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwIYs2RemQEQ7kNvwEvzUf9&_nc_oc=Adre959A8oljep4t6nUaZzFn0tP3D6sVLBkpJoGnXbC6SNqondlYC5Z1oQ5D99JERXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3L_cfUeN4_phAUQDaKRPc2Tep5lSEQ5U-pgAb53zoZww&oe=69F76752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVLp5nCN3jEQ7kNvwGttr7A&_nc_oc=AdrhgvYbJisED45FNmNPgcRZe0DNuMh5qsP1GKUUgmc-ewwEaezilNItt98z-H7I7zE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Oy51sA3OrLDAYqhbs-yjPMMawZ3xJf-Ko9dSK1WjCAQ&oe=69F73A13"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
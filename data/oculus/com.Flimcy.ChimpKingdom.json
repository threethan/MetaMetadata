0f&oh=00_Af7ke07Zd1k-YEt0aZstd6rwGBLT8JQGJbm97qraOsAvjQ&oe=6A048B12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQh8JjNo6JIQ7kNvwEwg21x&_nc_oc=Adpar45mlAAvLG7rMeQZM908O-Cv8LFibYHSU5d77tARoOtumDPPTMjggQwQMsx0sYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yAkV9JKVUw4Nr-1zPIhMFRBw5W-_rYMyuvfkBFzCX1w&oe=6A047BAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Pkgs2SStacQ7kNvwFAVWoU&_nc_oc=AdpHaGFfVZvq9QEM5eae8tWzz6m70ej0FFVEI8jKHJe74mFHBIrQTl-LEaEwP4NShiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ch5gLVhEVHUcjhfXF2NigJVtlFRFKdaj41LS-UJ7a-Q&oe=6A049652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZimcnmeQmQQ7kNvwFGxMYG&_nc_oc=AdpDVWaA0aIbIH2izMRpXyJuqnpgWrd99VybdMkfibPMRChM_IPwtFAyjtdXCXb_U3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4drBUbVQBZJ8HhbXXnTdc3aBJI9EIjMOO25hI60a2_qg&oe=6A046913"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
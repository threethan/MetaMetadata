0f&oh=00_AQJuplR38EgR-z25AGu208iDFB9QweNz2MKKe6mt5Pv17A&oe=6A9AD612"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzsn-JMfZTwQ7kNvwFlFl_1&_nc_oc=AdpyvFzQs72_L79ds4DIiiZooX0O0KCGgXxCFZgB7nS7u0_dQFUrn_5Zr95-b7Nnycs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkgA8xkex3Z1yl9FyXUAe-1lVeV7uWJzW0hpL8eLllhQ&oe=6A9AC6AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqqO5MQ5tdMQ7kNvwG0qYUS&_nc_oc=AdosgzVXqjuoy7dsdtEzu4S194mkVspWvElrERO3AnunH-kDw9wTYYObU4sZ_oooS7o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn9GqhaYN1RL57xSj_Kp7Yh-9NeT55K8zsjtbUgFhd6g&oe=6A9AE152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNQvbcbTSF8Q7kNvwG0-enr&_nc_oc=AdrlQkUj3XWWUOxbAZNELWqXlHQ77Cv8NVpl-DRBkgJFFeX4mteYOpbNGLnV9--uqWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIGjKPOHtyflUHLsC-zVwi1SAM4Y9Qe4fTHfTFV37Jlg&oe=6A9AEC53"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_Af4DUF0ufIEw1VIrVLdGbYrgsSH4Tqud60xyVFLoQucDcg&oe=6A087F92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6_NWkHPskYQ7kNvwGB6Ub6&_nc_oc=AdrqZi2IwIP5P50t-nfgztQ3IpuP_jCBr1ddz-5yHBn1jJGkGRF2RfjYeIn9E9QIk0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y3aZREq69noC-1EE29ByCXE78nqEzQWZ5amY8QCzO8A&oe=6A08702B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOXul401wWkQ7kNvwE3lWf1&_nc_oc=AdorwydASlVdrzcCF5wZ2rH6V6NjtlTLc0W6K0UeIhGwXBiurYD8JlROMG4Pl0246Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PB0EKPSaIVjRFNa4tuiquH5VwnDHT0KgB1Cp66UiZSA&oe=6A088AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5jT5U56Q20Q7kNvwGHcJIf&_nc_oc=Adqky4ha75C5WBG2RdiFDg1CRkJ-QQ3e8km-PR-QrwQexAydEZxgmchejE8n2PFWYug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_hWx0Izx226FZpBszm4Uq75SMtDHPJu8YJcH-VXsQEA&oe=6A085D93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_Afx_LPNKQkK6ayKz_59CbM0uTnNOvnxDbEVi4_71vVRtKA&oe=69C54312"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyr-Mw1rNMcQ7kNvwHVX-hx&_nc_oc=AdpVgCeftid9zNHQ2IqZpdAdkW2CxsArEPSelAX9TexfNCxdDuwNA6UBPtjHnl6l6a0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEYnZSBcs1YFDNAJ9uNt-GK3uLoTKUArjt0pmgQ3x9qg&oe=69C533AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f2BiVixvFAQ7kNvwEbh5Vw&_nc_oc=AdqJPnGxHXYdNnu9TRqjWhQkrKRM0lG9IynEPZwB13WsJJ_SEeZflbzeo10lVAZ2_R0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuJ-iKZ8cl9w7dlMJUzIMV3EqWgfnUB3V6-WcZwhXOZA&oe=69C51612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRCTjGJA-AgQ7kNvwF4z43z&_nc_oc=AdoPCW6y7JS28yk4bQyJFATk0t5USLaBffBx-zALkMjlQu312IDSw8GmWm27QV5b3jc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKOOB7YXXBu8nsELCUT1wSdme1MzwLqIwSsDdsKUJAmA&oe=69C52113"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
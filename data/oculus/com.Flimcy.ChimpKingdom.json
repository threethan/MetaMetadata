0f&oh=00_AQDJnlpoFq1_CqMJh_dNbS62tz_eOaftjL5z5IgkR7ggeA&oe=6A5E3112"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peuB5n-VuMQQ7kNvwHxSe9A&_nc_oc=AdpbbRQCXjIID_tSS1_HkH2PT8WaH0ghxFNsawCFeIsDjFN5JfTmLbCKaTKjePgE2bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW8nHNQICTH4FbATkoSl8CLG5fcubvdzY26Y70clY4sg&oe=6A5E21AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2tqHe1afWoQ7kNvwGTxYlS&_nc_oc=Adq1x9a7ZN5u-ws2Znmac_Osc8pKM4M1hY1cbcR3Kf5dDrCkb4W7h8g7Zi-xQ-XXLIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkP0Q-TqPkKg_NUdycNo160eMxnkn3b7nP5syX4U-BgQ&oe=6A5E0412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5POuK_ZswkMQ7kNvwEga2Eh&_nc_oc=AdoIgHeR347JOv4BgN2yTphSJIe47POC90h5Bttrn-ClIlwyu_lyx4hhU8RTqKyE9XQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9aHKWWRyt0BvSDesba3x89uADa7YHb4y6tKRqoyzQ0g&oe=6A5E0F13"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AfwOpcCtg4LXJ6JgBqYDWdmncxoEcJlyKydplXuZUn0i6w&oe=69CA8912"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc2Cj9tOe-oQ7kNvwHYmCrr&_nc_oc=AdqFRUCfzcUJWuBkcEUkGLVOavDrSWVq28g4PDLj9VAjywZnZlaW1oCPejC3nx3DNHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLmIEc4Vx1-4FvRBomQXEKZuXnPV8iDdRzA_qdZGXriA&oe=69CA79AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sD2f4X-1wwYQ7kNvwGeRAFi&_nc_oc=Adp8bqEegv_BnowZtv4LN8g7h9430o8M836R17wJKbRVJlMYV4GXODaHyDAOM4CJqQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwmaar5E22uP9mCpkw55wHsH8z2CgqyOezAj2dDTEFirQ&oe=69CA5C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnj_UiDQRmAQ7kNvwE4PeT5&_nc_oc=AdpzIah2Lsw9wREnPwvL9to4-mgc2JmK4ynrgdT6ab64ubRa2wcRmg3HhuBLErNyC_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyr-7y5s5WmX1lhv5RSAKV8X3iwubcxrehuzE9YXTgdag&oe=69CA6713"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
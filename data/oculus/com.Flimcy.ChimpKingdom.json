0f&oh=00_AfwGUq2TDBYrpExxvxynnc5rUXZvPhzxUsh-sz0IvrCk_g&oe=69CD2C12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YpST2IDDc8Q7kNvwHH33B3&_nc_oc=Adp3gl4RSyoxrWTTvBpreBeaJIVzErrujz6_kdJfEZ1wdtyN3Qb1dMD1p7B7_Yap9J4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7S4qkE8U2gnwGSjWrQsdEnH8dU_lNt11XSNeZ5SBIFQ&oe=69CD1CAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvozYg-LbcsQ7kNvwGFAQYa&_nc_oc=Adp1wNvY_3OY4WOYfhrHSldoqb8Smkg-edMFMnXtrOXfnU7U_QYfFynRfwI8VzmunzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxti55tR06peov7ubHrQvDZ-hdetmqKTW3lltac-tIPxw&oe=69CCFF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_TJjTs_AuQQ7kNvwEkXc2x&_nc_oc=AdrG19pKbpGooSOulr0VOjTGxwhq3lKdfxuMvjbzt5I8RXUrfzajmHTHKbP0xM17pb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzul2IdZajfeSAVKEe3o7u9uWX2HyaIVBRc3oY9kbYrnw&oe=69CD0A13"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
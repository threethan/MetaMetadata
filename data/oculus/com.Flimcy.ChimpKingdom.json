0f&oh=00_AfyCy2-nRaZLhTud2opwxxxj_lPzm3UE4p_gvFczg_MigA&oe=69CE7D92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YpST2IDDc8Q7kNvwFGNFuE&_nc_oc=AdqGs7aK2hAjZoswvI46gcFuxl9G2ggFFJ47am3zGCgMXAIlCtgUfXGJrRIAT7DdNQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJTu6_WqD9OV7vZ9plkfg4tuWXyOu5UBcVoKjUgAPCoQ&oe=69CE6E2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvozYg-LbcsQ7kNvwGUNAs9&_nc_oc=AdoFX5E6iGI1ktKQCbuyQhEf7OqfcT5I9-zzQrzW11Cwlkry8YotfZ4f1L7mb9GaQWs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1UI3IxviwAWMPKwrW1WT3fVtFuW7i05nOEJcg2ImFVA&oe=69CE5092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_TJjTs_AuQQ7kNvwFTjEsO&_nc_oc=AdofN2ZF8VG6r-j00ifoj1ABDB-qr_njJTbUigeFoNofoIqaTRoBqCltcOIsDx7AwiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrzoZiZzcyR1ojzkHyM_5e2kA7f2h1zL5ZctCDpB5c0Q&oe=69CE5B93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
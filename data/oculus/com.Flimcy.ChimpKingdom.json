0f&oh=00_Af_Xp59vsgHJcY1qc3r9Dizqf-AqnXwSO5QnRWz6hltgGg&oe=6A2EBB12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNoKhbD2ON0Q7kNvwHQihGO&_nc_oc=AdoxSJ2Qs03ZE9aWdw86bl1nJzU-py83sGSSE2_rmjTOj-G7Fe0G3zH7Q3lkJ7GPYqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zl5RiL3n6eZLw9qz5uZBy9E2Dq-gutBISR0a-V7hSig&oe=6A2EABAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H75u0zJnu4Q7kNvwE_kFgV&_nc_oc=AdpetZ7zvrLzb4FOlW52MDpUFMeCSQn0yFtgj4orCyvtlDh7VQSUfglS54w5Vloi5mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G4QwL2LbZpwZXm15lv9yhRECVjuQgI-wU-FX-hmBcxw&oe=6A2EC652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KwJGaeLyiwQ7kNvwHYZEQP&_nc_oc=Adru-L0hN7Oo6xU0HwP572rM_7ZKXI6gw2QH1l-aovoJ7Sp6RRK9yo4LAyzj40TyvME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c17GOZ_0A7i-ZCuXr1GKceFRNMNORw0tBy1ibRb_LoA&oe=6A2ED153"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
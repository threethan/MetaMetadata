0f&oh=00_AQARUN9fxdTKZRaUQLsZeRzIS7oTGk14Bj-juAglFvMuJw&oe=6A64C892"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE1ONxgaUT4Q7kNvwHr_Ehe&_nc_oc=Adp5BsVt-CeuXdcj3sSb0Sc6wk2cfVCYaO7UkOxwCo2iOHqxPs_iuPNeQw567co6w28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcGHrVgXR7Q0WtMHFoEHmahoMA4H76KV7fR3RQd7czsg&oe=6A64B92B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od9wxJnnMUQQ7kNvwE_C36R&_nc_oc=AdoqKoS2tg-81T7CvQXkCgQG96NdVzLzm8rBN2LFCWJJgdtE-f-bUSrav0CBtzdQPEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZtbcaHhJSXM_oqozaXA_r0pGTxnrgtLXL25aEfhbfEg&oe=6A64D3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fe4ZUeb4T50Q7kNvwH4mMx3&_nc_oc=AdpTuXCcZusMy4b-Pz8X8J16qGYMuazM0pwoSAMP3uIiG9v2tRciqKhHn_VaGEq0zM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvz4M6pl1502Km21x3G_mL2bCWGXLIEaFv7B4koJ4Tpw&oe=6A64A693"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_Af5eAG-fHlMbnUWKO5EjtKhQtFPw6L_E3saPUItfSo_tOw&oe=6A05DC92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQh8JjNo6JIQ7kNvwFpiW8J&_nc_oc=Adr1pivtLBmw84P48cLi9xsCk2JaYOQiLJGzgn5LM73FOgAjLnpSxnfsUBySJt5as_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hbO01KxClF_5JwtIoPWLEPo7808GCAh9qjqErowdZjQ&oe=6A05CD2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Pkgs2SStacQ7kNvwFbtG0B&_nc_oc=AdqPGTLygiOCgv_CE4b2ljboIIy1Rhu7bRB6oeIWxeUr8490UwBTUergpbFGRgiQH3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SDaD6uo6nkRs_e4XsIn5nxg490v7b0D_Pbbf_IN9F2Q&oe=6A05E7D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZimcnmeQmQQ7kNvwGXelda&_nc_oc=AdrTSlqs_Wew5QVe_v57McmbynVX2X30HcQXUWfITggw0t0icXUGvIppjW2CBiJu_18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tsjVLnIO-xXPB8kmhcVWLcNS5Eu4e1YD3PLekdyJ4IQ&oe=6A05BA93"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
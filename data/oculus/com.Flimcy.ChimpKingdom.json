0f&oh=00_Af1fNEMEpL6uCrxyU8b8WxZZZrlav36Qn-hpTlTXiVCurA&oe=69E8DB92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnIZKrcrfPcQ7kNvwHjvgmN&_nc_oc=AdqqnYLXES3Dnl7_ABN2bJ3o_u-brYiJPkhj1tA9wcQJOZxtWmFVfL5stBT4oIOLPa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ipb2I_5-tXlqbGUPqVcbjKUubcEUsYGWfumbP_1Mc1Q&oe=69E8CC2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHpe_ZPUPTYQ7kNvwGxtnje&_nc_oc=AdoUPNeQcmIytkdwIyj-4Ci50U_-Q-kfw59LbRgXbqPRqA8rlR0eMDqQjfZhGpYSpAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BVGWvL6bmwvHlJmYbU8IrrnF1LSgaYw-BcFeby-x5Fg&oe=69E8AE92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2E5xCP3_6IQ7kNvwH-9Egd&_nc_oc=AdrpKW_IAQRBfljtlrbG2_qMhPiOFoOezpFeKxa-8M9fNxbmpFRlff6J15_Sr_ZxbfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Hr-uzijP0PR-DskaeLKsTbjw17Wl6gz4N0TK8VhVfMQ&oe=69E8B993"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
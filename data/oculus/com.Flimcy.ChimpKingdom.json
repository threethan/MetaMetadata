0f&oh=00_AQSq8OlASRBcS7fOVK95ryiVsis5lFSyD7umnCzTaea1LA&oe=6AE74D12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plL28GP3mLQQ7kNvwH73qKV&_nc_oc=AdrBU1CAtfs6mOe9jGzf_uc-KkzzcHwCrEo42uHKFJEpQ9cVvlwtaBQuXLlFONNK6T0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaHUCJYoTMO8TTDpfueTj8ld1YDGabKSqzOZcXSG_VXQ&oe=6AE73DAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpVr2wPrSRMQ7kNvwFhMQTi&_nc_oc=AdoVFgy5IUoRDc5jk9oJ4ADUJVeQZPpDchUUc1F62mz2aI8RYlTb8dNlGCkb_O31K6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQme6s8HiMyoSTt8YPBhz9LoLMCbGNg7aey1hgpBy2aSQ&oe=6AE75852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbNOt1EEnNQQ7kNvwEkw3pX&_nc_oc=Adpx7mAYoH1P3JAgFHp-cpGUQXlTD509tkE308jOKtaNvdI-6CgNw-39lBcasdC2fDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfh8ZHBodPbS3f-0GH6GnKyMKIasB2XK3a9THxgG38yg&oe=6AE76353"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
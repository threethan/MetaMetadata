0f&oh=00_AQNXk3fyLxzMfogp_s4w5sIZ44JmXTfdBCbCA0MIUd4XAw&oe=6ACF9212"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK6_MGL7X24Q7kNvwFiGJ1q&_nc_oc=AdrNu0SsA0IMeqq9r1kTpnttZkb1GmzwE4816u2QrzL8oNCAXX4uLA1yyrx1667JAJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIqXmlrJsTyGcpSLYCRNYKT6LxTkwq4a-SzltHNPeIEw&oe=6ACF82AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTf17Z46j2QQ7kNvwEn6dbm&_nc_oc=AdpRqvAhr6txN_WOwhhsVyszZ5helZoq8kbpBGAzWXJIS4abQIl_lAE6X9w5rGOggvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp2OJ7vFUSqo27GOoGh9AZj4fBjiRXmYCjpMMgimyF1A&oe=6ACF9D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eoe6j7NupPIQ7kNvwHqK0tM&_nc_oc=Adp48hQxq2hcFxV3fTyofvCTYjPRj-Sg7akoFKP6jOvQ2skUtV7TK_vFRJn9zRJ4Paw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODAEvKPhR-_mYHeOy6xNtSkLY0PcCD60OzI-5og3kOaw&oe=6ACFA853"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQPhawXEyW2q71kKI3wi42svv9-G453UhrQd0rOKrMJUrg&oe=6ACCEF12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK6_MGL7X24Q7kNvwF1-AQX&_nc_oc=AdrMHSc6ci2cMIStBBCECdiHLPLafnQ36mqKlavNp9luu3zeuxJ3eJFhS93Wm2H-DQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOXwifLnOsG4e0PhK1_M6Hi67L4bJA-ZxDxAlYVNXjug&oe=6ACD17EB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTf17Z46j2QQ7kNvwGLFnjy&_nc_oc=AdogFWJ6qQGgCq7P2PP_Au0Y-2hjYLi0z2WYNxwwQLUuSeM3HhX9srhbl5eHilQ6hUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0ol6HmatYFwc9nFjkFgdjjdqrVmVGi4ZhBr3ced4OBQ&oe=6ACCFA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f25UkrUd5CUQ7kNvwH-dvLW&_nc_oc=AdrpG-XPRUgLv42pucn5JoiFxUaeZNbf4sbyoLAzy9AkJ6KSnAuvIHquley_Gemm4Zw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm-hUiMW2DvtoDAL9zj_BKUhDWr4HndFIdcKlQ28rdeA&oe=6ACD0553"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
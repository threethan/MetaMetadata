0f&oh=00_AQOSlYknjoQ03InjDDlUyyWm_F9TW9lNvPrnhvtv2-GHiQ&oe=6AC8FA92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omMMWRSnjiMQ7kNvwHwNBQe&_nc_oc=AdpRv5-tNRnatGCz3-oJDJoX7d784l4dCQ05aD_mg1SKSFwzhZvrsPK7s0FHAMTq9EY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN66Rt6amsQjR_6cJv3ClOEmBe2XKdzJYuzyzpK6W15vQ&oe=6AC8EB2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEU4SmtxhOkQ7kNvwGupX3W&_nc_oc=AdpCvYaJ_U8irwfFmrewGEHiXOKfJnXv9PXDftZOnSPEc2ys9wL5jvHH6bSU69-daO8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxgRVQBQdQIfzj2iLHUz7t-NZONJ1usFJacT71KKRPhQ&oe=6AC905D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb0YVxt6bVMQ7kNvwELJXln&_nc_oc=Adp64VeyGNmMhYHQNFcCpgD6_Cl_9MN4090G-T8s2AtReMdr_7F6xa6H7t7zJOGrouE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm9owUrXACex9SjXUmQ6KzB8-akSyOJti_ddJyrT79gQ&oe=6AC910D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
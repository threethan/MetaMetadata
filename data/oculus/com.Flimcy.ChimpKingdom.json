0f&oh=00_Af7aTVQtMscBs5SS0hPCps-XprVaJtBtWlUwj7UgVAEl5w&oe=6A0C7412"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O43DD8RF-EgQ7kNvwECkn-T&_nc_oc=AdrIxnyKC9_yCIbGHipH8nbIUPhH_gw1P1eiXlDYIAllYparacx-U-Lr1lsxk0YppI4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66Y8nx4qoIcnw_JsM1wFyxsniTRKAUswdeOAMdU-JI_g&oe=6A0C64AB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5X2__HyLvM4Q7kNvwHZuE00&_nc_oc=AdqgrPiDbfpZCr3LeyE8tsoctVEfhaguNcDfhBLgWQU3jmM5oXqYAYgdX-MDmPHGKXU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P9lZN2g5EedOvRLD2Itybhh0dK8BGxaWJQtO8xb-4aw&oe=6A0C7F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpfcxVRfDhwQ7kNvwGxi9Pz&_nc_oc=AdpQZb_t1JH7mGSc1AkFXq-NhSoBo_sv4XbuNbOA98zCzHWwCBeybjUGJeAj20yaGII&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pNdpdTIylly_Vz-m5koitqc6CMRFRfSlcdYbCXBALSw&oe=6A0C5213"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
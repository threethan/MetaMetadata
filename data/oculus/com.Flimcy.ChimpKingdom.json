0f&oh=00_AQD4CiwyEQDaoZlxMh6UK-9rmVtq5AQWFHnA-uz9_Yht-Q&oe=6A579992"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr2P9Pnua8sQ7kNvwEWhg2a&_nc_oc=Adq2yBYApcuxX91Dp25K63K-_sJRg37lVpedP7s_0m-E1aDAKRdYquRU6HBBAJSOQCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxYM8A-y7GuAlUQcqwdOd_ZBeK7qlK4_9Cx_R94rNYOg&oe=6A578A2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjBgP0ZhcC4Q7kNvwHJd4dB&_nc_oc=Adpsx3b5zAmsHz7AOfuiUmfBX1P754oBsic7MbDHz5nIKFGFpTQBJGLXoJY0BHm7y3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeOGhUAa5abUTEsmoa_vIvLiiTRnwMO3992mmlmlSUzg&oe=6A576C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZuUlndvrHoQ7kNvwHVENyp&_nc_oc=Adq5kmc-sPM6wEWBQm6CEdtb7sL_UVaORPspRjGtxfrKfP4-4-Slg23otDP35zyJ5z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMcn1k4GHRHIdJglN5SbfBMd8dQ075PbnSjuF3bA8J-A&oe=6A577793"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
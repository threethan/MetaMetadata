0f&oh=00_AQJbnKfNeqZupuZbhom6QS-fzOnuY39k8qxM0GvkD_jb6A&oe=6ABBCB92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRfLnuHNKmkQ7kNvwF7VkhI&_nc_oc=AdrvzGswX8ru7fBU_v7xmMNlkT2YuncK9_VdUa09200mjlea8MsV4N7Ic2v_iY1G2Gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-SHNBe7hDhFFd8eUOzVuDb-HwdKYqlF5A-nyQjfMcug&oe=6ABBBC2B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8TKkvMVV48Q7kNvwEiT7PC&_nc_oc=AdobJmRSskSmQV8e_Yfshdflxuyr21VaBV8Xqs3W5h64eNr0QBEUSRrvVBbvAr1QB08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhB9CmRXMo5LAXbsuBtWRdlm28J3R-qDnVIEqqJ42kvA&oe=6ABBD6D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRaxqfQ37AIQ7kNvwEcuAbu&_nc_oc=AdqdoTWvrCbxmFRFRxYwc1aU5yE6ay-ShFOFKC-pnmgIQ6sFn_Rm6ITYQABV9qWB3M4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1aORQaha8ZM1TeMH0ttIGHmwunHVZfoESB7qye0xuLg&oe=6ABBE1D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
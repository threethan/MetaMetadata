0f&oh=00_Af3CYGHMJeqHZzE3K1QBotCqHf8_q49RsSQW6pB4HiCAUA&oe=69DA5B12"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJWPLbhxsRkQ7kNvwEGoBWL&_nc_oc=Adp8yVLGfWMQJIvcJ96JKzoTQHbwPTgCaIe9cw56Sqd7yiyBGtsEl3MhhI0nG_1oiaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QcXrQylSIL9j1Z532z8SfQgh98Lo4fS6KMlhqMhSoiQ&oe=69DA4BAB"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCLOdYZwnVQQ7kNvwGfXpfn&_nc_oc=Adqw7wOy7hchdQNtskgRh6pu_5q2-rUwlt3_HMvah3MSsSpWyrN8r1al19TAlE_4fZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RUP532zQzpdI_QqSdqxBycZQjdoRGaxghLN58fbKXYA&oe=69DA2E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cyy0VXGc6jsQ7kNvwF1LjdT&_nc_oc=AdqVsYfbllz5v39w6uOXHgQ-uBdvEcDRFRzlLQYA3KxTV-Y0OdYXgZ8TSdRaNbQNmhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pvHZjPlyKb_VjxZ7qFbNGErtkwaphP6_LaCH0pkvVFQ&oe=69DA3913"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
0f&oh=00_AQRY62Ofx7Fa50sNnoToAgr1z_vs7a5XkmBtR2IHZcU3OQ&oe=6AF32A92"}, {"file_name": "Untitled design (7).png", "id": "877825833471264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86661268_877825836804597_5883543275937235476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-QHOZI-wJkQ7kNvwGXJVOr&_nc_oc=AdodVFwNi0MF8l2Tx6qwkP5wcNDgrol4HvXVSjbwGBJtcEl5oTSJbmA_8A9QG1k2kys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMlbrsx8nDA4TCMH5CsxlgYp3GrnW_gtYXEBX3EGLMZw&oe=6AF3536B"}, {"file_name": "Untitled design (8).png", "id": "2676714449137209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974702_2676714455803875_934717980046163925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysto_1dnRxUQ7kNvwGYTZA_&_nc_oc=AdqrReORVi-pbl2ENwv0PRuGbZCuyHsz6XezEb59SAGU8qdfyRY44FHVhbELK5i8SGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs6WlmQNlTMEwYHpHMLyyfNCxGwR6VJCQqx89bKFsbqg&oe=6AF335D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "957857345197920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340707_957857348531253_8268323953929920624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K_D0U1QBowQ7kNvwEnYdsL&_nc_oc=Adr3diXoyG48UyGciYnDFgMOiA0iVRftBvTzb4ZV7c5-SC9O54k6PcEbl0czlWPRIak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfIC05SJNALdnJR8sGGAHEXmLiijiKdT6IggnxlIUM9Q&oe=6AF340D3"}, "display_name": "Chimp Kingdom", "keywords": [], "long_description": "Chimp Kingdom is a virtual reality game that puts you in the role of a chimpanzee. The game is designed to be immersive and interactive, allowing you to use your VR headset and controllers to move around in a virtual world!\n\nAs a chimpanzee, you will explore and navigate through the game, using your hands to climb trees, interact with the world around you. Along the way, you will encounter a variety of obstacles & challenges.\n\nWith its rich and detailed world, 
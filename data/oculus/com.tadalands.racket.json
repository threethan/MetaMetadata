vwFbYLDn&_nc_oc=AdrTy8SA_TDoZ0-Y7pmTwaeDcMNWfmfuQBYMiew2xRw5vSUg1sfyJZBLfOLbRGhZ1i0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ30GN156HyXBILjgqahzTV9qln814Cf0G4KwGt0EO_ig&oe=6B0DC298"}, {"file_name": "screenshot_2.png", "id": "1627868995205969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292426_1627868998539302_8855209738549634197_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlhxthLEHoAQ7kNvwH00aGx&_nc_oc=Adr6YHjC3plOQhLbWwWmusfg-hqOxjrpDVzas5XJP1g2Ce9tWJWV3JESTNjI3p63D3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMwlzrLo7a5TkhFsyEskTf9sgpzkVVuap7n1bbeFF3Nw&oe=6B0DB06E"}, {"file_name": "screenshot_3.png", "id": "779408218150445", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCcvgE96vS8Q7kNvwELQFam&_nc_oc=AdohqSNoUAM6NC_StyAHIOHiRFx9nwSrDQyU4mik4c7yjz61BvjpEiUmDI8aZPGWsYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFjsOusLOtah-tDNnejOizPA7xsmeVewnXVr0z2TFSkw&oe=6B0DA594"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLQXj9Xxj08Q7kNvwHsI2PY&_nc_oc=AdrZ_3tb1_op-utPXR8g1E6LlhtHxVh4z5G72RlbNPs-GZmazkZvOyVJlA6ZPERJSGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQc6f6ZspRRWwuwuqrKekSVeCi4CJhWOZZV23fv9NhWbw&oe=6B0DC35B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF8sxcWytk8Q7kNvwEf8njy&_nc_oc=Adpthh6cKW5OCNi9DFLFG8SmXTbP9FHYv0QjnGUFRUHEey7Awq_ODH1w4YoabTaTM7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSahZo-peoj1dVxmeIo4zu3tW7EX9hj_lHe4jXUsDuT8Q&oe=6B0D9C86"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{2456526188145145}\n{1654292779218752}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1562212618171654}\n{2166347640765667}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{943483241475364}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{3870486249913728}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack** (coming soon!)\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": n
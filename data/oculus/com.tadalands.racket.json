6XyLeK3cC_TdcLA3gsTxnOGh3i3LoxzfibBqP3UR7K8kGwDayg4Wg-VKks&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAIvep_OCb5heUeUlb1otsCkBXrSxGG6xddO_kbU-H-w&oe=6B084458"}, {"file_name": "screenshot_2.png", "id": "1627868995205969", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499292426_1627868998539302_8855209738549634197_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8uuNMozHYgQ7kNvwH4Fxu8&_nc_oc=AdqqrxCJbPDk8xLIp9ln3MvaIuKtAwSDzWWwvStZtYpJN9SsT2nInKskDx8BLXVKkoE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Iqk0SluwitqpxdZe6A3eJWqrnPxbmvuMEQTxpLqOeA&oe=6B086A6E"}, {"file_name": "screenshot_3.png", "id": "779408218150445", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-9ubmOP4EIQ7kNvwHL8v9E&_nc_oc=AdovZ7Ve-FkhSI98g3GCv9suXh7y3l5x5jlvTRrEhEuBmgSXUb6GK2pGN5vx2bp2vUs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2B1MAEi1pGtmAqqH8vei3tJ_6oeRDhm86TC9Dux23YQ&oe=6B085F94"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjd_oLLCwNoQ7kNvwHHdrwH&_nc_oc=Adp8ce7peco7Nr2gvVGHr-3H3jV4XYlNYNl7X3Nm3uTmGbt-N4Ldkj9oc_RC0j1yxDc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHO4HwYzyW4FJUevZuizSXMvfi7H8PiVsITFUl1oig2w&oe=6B08451B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21rC4NqWNzsQ7kNvwGieblc&_nc_oc=AdrsctngLgU5ASqeDQgmPsNLm6R1G4sh3eNi-1FDevYPKF-v_uRNMImMQE8y5Xw_hJo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV_NsxgtZMCAbgX1G9QknkHbR1Bl7xeQKb8YIhzNTUPA&oe=6B085686"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{1484297246543606}\n{1410889190718617}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1337261258620738}\n{4377521685860721}\n\n# 10+ soundtracks to play!\nWith more on the way!\n{1635285844331795}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{1450901666528272}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{1267561554789112}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{1248220990162544}\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Timing-based judgment\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack**\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25308829025482472"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1745624466508253"}, {"status": "PUBLISHED", "id": "2595689464200927"}, {"status": "PUBLISHED", "id": "1739530477194903"}, {"status": "PUBLISHED", "id": "1570240778092666"}, {"status": "PUBLISHED", "id": "1985870202815459"}, {"status": "PUBLISHED", "id": "1299039045756835"}, {"status": "PUBLISHED", "id": "26131547593139463"}, {"status": "PUBLISHED", "id": "1353438633487411"}]}, "baseline_offer": {"id": "1353438633487411"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1745624466508253"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28352907357741275", "version": "1.1.1"}, "id": "911055411868172", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25308829012149140",
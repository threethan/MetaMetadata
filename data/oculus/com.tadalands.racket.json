2Nw9IZ7uZt1T15LcN9ueOufWbLj44ydA&oe=69F5FA2E"}, {"file_name": "screenshot_3.png", "id": "779408218150445", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKRz8tHguiwQ7kNvwGQ618t&_nc_oc=AdrKi7OaSSYW-I_Fq2PlJlmIc3tyCqzOMeJiADOya7ZiBumdEvWYVgG_bAgAbz7mAvs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11Pz-3fsCMpLtnVPyTFyq3G72-vF9sIyr526C5EcqTpw&oe=69F5EF54"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8CEk6R0bp8Q7kNvwH4auw2&_nc_oc=Adp7C3l2sOIuCs-OG_ypNU1cKacpBSOc5ziwinRFkFNlNACAUNvzpjuLsDFyMrNEV_o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pqWep057Eda73uge97QWA1_3CBHKH7pwS2OHG5ler2g&oe=69F60D1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Gr7WRjAStsQ7kNvwGESyb_&_nc_oc=AdpI1eUfnbdX4ia-bTpfOIWvvxWvbzoQe6SDxg57X3tw4ib35n8Cv1Qmep6iz1dULlc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qknrre6iQOiQ5Jk26HHWQOItFsFANevJCLNGaAFor7w&oe=69F5E646"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{2456526188145145}\n{1654292779218752}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1562212618171654}\n{2166347640765667}\n\n# 10+ soundtracks to play!\nWith more on the way!\n{921067940915134}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{943483241475364}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{3870486249913728}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{1359047132608125}\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Timing-based judgment\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack**\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25876920392006663"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823940_2026436977934989_2004540668435118243_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiI1-wdoJ5sQ7kNvwHB0uc2&_nc_oc=AdpXzt1IGbBERD75LpHWMUmzHWG6Kroy91fqAVDNT8evl1m35yTb55fraPT58qStyqQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ICPrsNXHEqo7S1_J1j5-irNZRySsfkwURJp00a69nNw&oe=69F5FA48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm Racket", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1773688260, "lastRevision": {"nodes": [{"id": "25308829038815804", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25308829012149140", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1446123690553538"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover_portrait.png", "id": "2064916844050609", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818849_2064916847383942_9131593543343957782_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsRWfiASXRQQ7kNvwEQRrmV&_nc_oc=AdpR9lUA0e3a8q4RFCaexOqbUiEDvotY6acpPN0bEqq9yOnWvzEvGVDggewkR1XvLvU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0j4-Y9pF09AeiC1kF9z5x8N7
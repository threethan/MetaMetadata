0a&_nc_ohc=uoaIHGd8-7oQ7kNvwFnwddH&_nc_oc=AdoPobNEsSGWDZq5l7GwkKzhAkkI_KYEfbrC3v6HyLAbitqSRVuE8Qmqq1hcsSvIRqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jugqZWhHS5Ewwc_Goyr0Ys6VfyOXUXz-hbctlj_wE5A&oe=6A450954"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQbSOOmdXiwQ7kNvwGV1Hah&_nc_oc=Adp7CO5DicmSVwnT98pIB5UXD85ACWZCljyOan956CpQVJkJBSeH16OgQ2mrAg_vCCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_icNqF7yx1AySoH9gcitjQag27WSHtWrRbu1nZvODdzw&oe=6A45271B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMoU0qJHEVYQ7kNvwHOBq-O&_nc_oc=AdoQgPOGcHRrYRfv63kNYJK9KKSfXMENMtt2aHoWVtFwN8u0YSfJBv5IKQT9mpAzd44&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UhzZNxEauA8eVWS8yFPQwkaVykK_63Cao1ExuHAUdJQ&oe=6A453886"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{1484297246543606}\n{1410889190718617}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1337261258620738}\n{4377521685860721}\n\n# 10+ soundtracks to play!\nWith more on the way!\n{1635285844331795}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{1450901666528272}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{1267561554789112}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{1248220990162544}\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Timing-based judgment\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack**\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25308829025482472
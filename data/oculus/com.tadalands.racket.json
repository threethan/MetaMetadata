&oh=00_AQG0AMX5MclW1cDUYyDJItZxXcvKYIUKVfvXZzM0_7eQrw&oe=6A7F240E"}, {"file_name": "cover_hero.png", "id": "857663483976289", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_857663487309622_8870678543505847970_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czPGKYCaUO4Q7kNvwHbPvhu&_nc_oc=AdrcTSu5A-5hC4V0HR1W3AT8l_9ptw-hUw9s5W6EgmEbj8iggLYmH2tn7ALS53GAXEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ5XjzMg4lCxA0zWLOkVsZn10IJdPeIckCVMF6E7qf8w&oe=6A7EF7A9"}]}, "id": "1327051256115796", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "891022580605907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830411_891022583939240_5063192558899532992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vtzhr5Bmbt0Q7kNvwF0W49_&_nc_oc=Ado_I_4QN1FDUwvKnxGIm0Qj_VMXRp6_HwUEjOuP3Qisixm9QvhZxuAUQpGQvJCyg7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9LvxbSU3QefMTU-F_MJFXY5OUyVqCmIC1FBcmrhk3YQ&oe=6A7EFCC0"}, {"file_name": "screenshot_4.png", "id": "790030570357947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593877129_790030573691280_5036816664283651399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EF3iKUcgD0Q7kNvwEhiKOM&_nc_oc=Adpf4jHQXqA8zEWqMatz-15coIiq5xBeLIIM6Hygij-h935SG96Ih_BZjaKku2cT9rY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhyhXShd5szNOhRD8lxmebG3tTpRVnEXu_dQvkQpvoyA&oe=6A7EF018"}, {"file_name": "screenshot_2.png", "id": "1627868995205969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292426_1627868998539302_8855209738549634197_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVvG19UOOcYQ7kNvwGo1-6h&_nc_oc=Ado-zpPZ-DUrFrdz1tQxnJoVLflTf0UyzgqiuXbc_YNFCL6GAHPEs22hZa6s4tasnXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRGHHmDQRK66taAdI8pDkCRXC7h-OST74itp_vr5p0JA&oe=6A7F162E"}, {"file_name": "screenshot_3.png", "id": "779408218150445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FMad2FB14YQ7kNvwHIlKmT&_nc_oc=Adqgl1k67SMrtKLgJXoTillbJxmAxi2qFnudasYSDiYmgh8Ip6Jco7RITP-zaLMKfsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuS3w0Bmay4hSNlyQKr7xqw1DhJVMzqa0IX94yrOHdDA&oe=6A7F0B54"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTFVrfKLZvcQ7kNvwEvm5xe&_nc_oc=AdpSOpg_UFknwY6_VZllPkXj53u0mUAfYUcr4ycAtkYzsRoakNj3lUJJRhVnLTWRyKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIg-_9E2eaSsHTNZ3Pa8vuBnwvZptymt7r-9gjTTQwhQ&oe=6A7EF0DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QO21SGBlhl4Q7kNvwFms63q&_nc_oc=AdpEwrmDGz8TU3XwMhq-Hj1Gd_8zC_J5dIUWNHbDSZyCsraxnm1SYH-fqU0CesrIkh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB-bzokaC8aOLpxFsGbP4cAT7pIMcBS6XP4tGTQtpleg&oe=6A7F0246"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{1484297246543606}\n{1410889190718617}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1337261258620738}\n{4377521685860721}\n\n# 10+ soundtracks to play!\nWith more on the way!\n{1635285844331795}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{1450901666528272}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{1267561554789112}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{1248220990162544}\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Timing-based judgment\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack**\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
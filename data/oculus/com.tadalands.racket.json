o7DgJDX6ZEUZa_MU-xwRWqIlZg_1tBmQ&oe=6AABE92E"}, {"file_name": "screenshot_3.png", "id": "779408218150445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltBPzV1OiAAQ7kNvwHCMyDw&_nc_oc=Adp66pV8ycq7rwC7QbWVAhP2pyj2ZVn7ALABhuJljwYcpWlyxwk8kt1FaTM4l2btDp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdZErN-3jvPcJ-KIio10zdUh-4s5qDYRPqIr4O-P4Mcg&oe=6AABDE54"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3sO-izE2-kQ7kNvwHdFI4c&_nc_oc=AdplHpz7u2dH4WqCiX5yrsyzdsi2wVMOHrCDnq05Ei9usqaBzD1bdPDRg9s8b7YTAWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0NGf6pElMP_w5pWZmJCesIJH86sUgSKTQN81TaPayUQ&oe=6AABFC1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOKaddmhHaUQ7kNvwE_mT47&_nc_oc=AdrXzRadVWAWIXu_04bGcphXkUc86GzI5Y1hlc0PYSkG-lAowID4V1inXtX1cFVk0z4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6ZZVrUxQjc_UnHKS50dVdvz83JD_Ruh7v4YNGNHGavg&oe=6AAC0D86"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{2456526188145145}\n{1654292779218752}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1562212618171654}\n{2166347640765667}\n\n# 10+ soundtracks to play!\nWith more on the way!\n{921067940915134}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{943483241475364}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{3870486249913728}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{1359047132608125}\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Timing-based judgment\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack**\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
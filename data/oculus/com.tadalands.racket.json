ntent-ord5-3.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1nlFhW9-4oQ7kNvwEd6erK&_nc_oc=AdolK2dZpr-o_xo41bbzSluKn739HbY7ZqrQJzvd4CKbV_Sj8zOmJqGM1foPBnKhZbY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWWZT6oXrEFUjBFROenCz8vPbs5uAuUSyV9QtT4FQlpg&oe=6A732DD4"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUxxCyUw4qsQ7kNvwFKtQyg&_nc_oc=AdpuCd01f2DgwlcAmT0gC7sD0Z2iKGaKFw8SH75Hj7CcgSfLYMJr_4tuBgUCUlHzeFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0rNJJcUKhRezxbmUkklF9FbJkPh96wnrcOIFuwnsecQ&oe=6A734B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSS55fJ-ADUQ7kNvwHWy3la&_nc_oc=AdpIQqOLQd55WMN8iev3JkdtGXpSJG1xf5kblrLdxKse6VEO30aCq1v6GR3VZwo0qUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmGuRAmf5mTz3wJVe-smDfZIhRIqiTulplIcUe5JyAWQ&oe=6A7324C6"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{1484297246543606}\n{1410889190718617}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1337261258620738}\n{4377521685860721}\n\n# 10+ soundtracks to play!\nWith more on the way!\n{1635285844331795}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{1450901666528272}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{1267561554789112}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{1248220990162544}\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Timing-based judgment\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack**\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
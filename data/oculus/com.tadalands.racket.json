&oh=00_AQAVsE3-Hai8Lkcom6jIg1k0jjoi8oO6u21iWzUUz5JPYA&oe=6A5CDD0E"}, {"file_name": "cover_hero.png", "id": "857663483976289", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_857663487309622_8870678543505847970_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3P3Sx4OiirAQ7kNvwEP37iQ&_nc_oc=Adq4YkJw_fMVJtA6svMOThdSWh48w0wnhG9Llx6C4lTdp4PUAA9cUMH3Ok1j1e9Nzfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYuvDnToB-jwjEPY3h4BeOWSD_upY9msRHdSd2RuoNtQ&oe=6A5CB0A9"}]}, "id": "1327051256115796", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "891022580605907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830411_891022583939240_5063192558899532992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6ACnCBs7fwQ7kNvwEkTNJw&_nc_oc=AdocBkcico9itZzZhWM03Hm7YAbTu7JLKR24ulNE6qmL1XcpDPg7-_j5zuZsTBLO6kY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRZiKV8vREsPouexMZXlIF9PLAJsHMxxStmzd8bkPU0A&oe=6A5CB5C0"}, {"file_name": "screenshot_4.png", "id": "790030570357947", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593877129_790030573691280_5036816664283651399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a_o9Lk99n0Q7kNvwEB3rWy&_nc_oc=AdqLuivx57Lh8dszD4VBso5bu0dkEhg2fGuBwZjd-H3MhYZqxaXk_yvR5shpFUqo5lw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ9TxRkofS51L9snuTcUpj2x9UNlhfbGs8Aeh7hBRlVA&oe=6A5CE158"}, {"file_name": "screenshot_2.png", "id": "1627868995205969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499292426_1627868998539302_8855209738549634197_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91w1-INGZxQQ7kNvwF5jiWO&_nc_oc=AdpiaQyZgExl6B5QGFmLdB7rIQwVgm_K5kA-8SQ80SefInZTn6aTexVdrfD6fCX-mwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_IYkcX-fCzoQuLrdoHMd45Vf9aoiDaDsvzKQURId0_A&oe=6A5CCF2E"}, {"file_name": "screenshot_3.png", "id": "779408218150445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QQb_1m18PcQ7kNvwHAoUnn&_nc_oc=AdoXAFgomdJIC-dScFkfb0BpyiizcNXySIOQoULqTgMxmpPvoVl2dOqBSChvK8mVuZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyPR2NVzf_dq5UNu2A5wzE9iwMP907rJm-c-S47oWxYA&oe=6A5CC454"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrRc5owt7qAQ7kNvwHZcQbH&_nc_oc=AdobsuL1HF8bIX4z09AFZd8nFcb2mgty3VC1YnBGl_iQKk2dHH0VB1PTmBVIivwlOCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU9IB20XKKAFAbTmfcttvoOL0I6ghbuaSP4l0XIHNtmw&oe=6A5CE21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi3MUwgOegwQ7kNvwEvNQpt&_nc_oc=AdocGe05E9ugIZfsQP69lNLQiQ9FFJW2RmmqDCxhfxlDSQSIguFTzRbw-G67MMukow8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAJuGDUSm2GlyJCa57J8kXOPi6-3UxwcAXffmLwGtNvg&oe=6A5CBB46"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{1484297246543606}\n{1410889190718617}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1337261258620738}\n{4377521685860721}\n\n# 10+ soundtracks to play!\nWith more on the way!\n{1635285844331795}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{1450901666528272}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{1267561554789112}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{1248220990162544}\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Timing-based judgment\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack**\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
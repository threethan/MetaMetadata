}, {"file_name": "screenshot_2.png", "id": "1627868995205969", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499292426_1627868998539302_8855209738549634197_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHACQ1Htt7oQ7kNvwEsb_5-&_nc_oc=Adp-qi9PzUGjghw_KWTrE2dglGp-Yih2_gGhF8k1Z7oBKEARlLLQY4KCf6wpPuYAItw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtrsXxOcrv6E4OkbMVeKuN_wH6_XAIxWhfahnFNWUtMA&oe=6AE3482E"}, {"file_name": "screenshot_3.png", "id": "779408218150445", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEd43MDjXZsQ7kNvwFWlBa8&_nc_oc=AdpbE0E7vlXDkE3kuAN-R4q2EZOV5WhSoyqtBoZNIkWSlt2nh5BXfHNW7w7yevwGO1o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeWaoHQMyNUGWxu3H2VLcYPYTI8FLPbbuKE-2qh9UprQ&oe=6AE33D54"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbfudzoUySYQ7kNvwEhDHXw&_nc_oc=Adra5HBAyODMpGXi0sJuhbq0dBuLIsRdCX2mJK-YOAJ7VTGV25z0njNwbbjEKiO48dc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT6_rfKoWLG3B5BxDwbqOwvBuAHcyE8e_KCoojscNheQ&oe=6AE35B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PmLEIiMHOsQ7kNvwF7R1bI&_nc_oc=Adp1rrdyI46N84xfq2CTeubc3SvLGGekCu8flb3WrE5Jzgmia3FMeY46zX9TVARj1ls&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSZoddNZB3PjDMeBa9z7lsr7uzysVQ-w5fRgDyBqgwGA&oe=6AE36C86"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{2456526188145145}\n{1654292779218752}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1562212618171654}\n{2166347640765667}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{943483241475364}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{3870486249913728}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack** (coming soon!)\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"},
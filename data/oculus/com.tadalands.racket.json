vwEIPqjA&_nc_oc=Adrp0d_hLhxzJmt0XUz5VcnHvgARUpa88vHy_SLYUhCwvViwoNTJaxGoiBpvX4QwyUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGo3Ymkkk452N5HFZeJ2FuYLK-xdrmntLLr3u-lzOpFw&oe=6B005B58"}, {"file_name": "screenshot_2.png", "id": "1627868995205969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292426_1627868998539302_8855209738549634197_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmFJow6saq0Q7kNvwESP_JQ&_nc_oc=AdrOq1h_VcR3r1WpHN_PAyIzvQSJWKFq3sISylIbgG87QXY0Ziu0zZnMQHrqTznKsno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxxhOK01ajD8jKbZSRaFijIMQ6AKiPCKmMdz3D7YieWQ&oe=6B00816E"}, {"file_name": "screenshot_3.png", "id": "779408218150445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831792_779408224817111_4893719912834152767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoP1bQc_SVYQ7kNvwFJqNRN&_nc_oc=Adqo-1XNOq0AGD9g5LpcRZTYGhB9BdpZ0SOsDWnDMg_wYXmAIWY0sSSZMdzQ2QApM7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8iuik0ySCMZ4GFeQpVQEV28ViwXYL7ulRRlTKXkb4Vg&oe=6B007694"}, {"file_name": "screenshot_5.png", "id": "1487006422847682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308046_1487006426181015_8516299229555799045_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09ar3X-OiaUQ7kNvwFrc8tC&_nc_oc=Adojog0lbwmnpc5OHQDw1ZnFpZ9mvtuxhcDi-nDy8c4Cp62HZF_DLBl1iezvdZsMIcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6-SLRd3ct2DQw7ktyZhAwkg8ICpzDsDfmtMYMqAXsQQ&oe=6B005C1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "2088294511950853", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_2088294515284186_2508530305675353287_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEtXYMtvKOYQ7kNvwGoT_mR&_nc_oc=Adq-ov2tAxHgB52RNsPXBuEiDMsCqT4_Ukob4X1XImQcRidn8nnjUDL04zzpU2TB0Do&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLfbF1l29VpP_NDq86YyTPgR25mSzqF65iehSeoBuOZA&oe=6B006D86"}, "display_name": "Rhythm Racket", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of 10+ soundtracks.\n{2456526188145145}\n{1654292779218752}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1562212618171654}\n{2166347640765667}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{943483241475364}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{3870486249913728}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n\n# Features\nWhat Rhythm Racket offers:\n- **10+ soundtracks** with more in development\n- **Variety of genres**, including EDM, rock, artcore, and more\n- Discover artists with banger tracks\n- **Work up a sweat**\n- Accessibility: Left handed mode and adjustable hit locations\n\nWhat Rhythm Racket does **NOT** offer:\n- Soundtracks you'd hear on the radio\n- **Multiple difficulties per soundtrack** (coming soon!)\n- **Multiplayer** (including community content and leaderboards)\n- **An editor for community-made beatmaps** (maybe later?)\n- Racket and ball spitter customization\n- Modifiers and alternative game modes (e.g., dual racket mode)\n\nThis is a game developed by a single developer, so please understand that the scope of this project needs to be tiny.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": n
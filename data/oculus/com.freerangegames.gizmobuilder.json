&oe=6A1C31AB"}, {"file_name": "RGW MR image 03 with caption final.png", "id": "1009459670098656", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974649_1009459673431989_8631668915892176535_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=548dAhKJ02UQ7kNvwGBqWsU&_nc_oc=AdphjRuZygphQXRc9FtibAqbiiNOL1OmOXDbxgXjeMkgjcRvKmODxZdtLlqXl-QZMr0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UGj0wr-_mFIxWfFK1mKEYUrzPEsGqzlzM48zRzmdbIQ&oe=6A1C3734"}, {"file_name": "RGW Screenshot 03.png", "id": "1270395360582060", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974859_1270395363915393_3215400979223388870_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKVVfw7GQV0Q7kNvwHxebr_&_nc_oc=Adov5X4sAx3z1ylo8Gb67WpCCBF7c_AsgRvF6E8DKS69z7Kk-OgW951q6h5CWEyAPZI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vppJSy5l10_E9ofQx000ZvVsL2DJrukjQOTC3Gw8tgg&oe=6A1C4A79"}, {"file_name": "RGW Screenshot 04.png", "id": "641812057795517", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031501_641812061128850_7446013559396686593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_bhF-HCmZcQ7kNvwGU23et&_nc_oc=AdrAEi0IoOVUu6kAi4waLXgXR-IqfggQnGU2JYiuIp-1Okhtg8c9hoLiK2bjSYPDJlk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54bLeiSPNHLkpe6-FrpuoAsfrnQodx6RELZrf5IPDdXw&oe=6A1C27E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rube Goldberg Workshop", "keywords": ["gizmo", "gadget", "maker", "builder", "machine"], "long_description": "In Rube Goldberg Workshop, you can make tons of different machines from over 100 components. Go from virtual reality to mixed reality and use objects and surfaces in the real world as part of your creations. Bounce basketballs off your ceiling and into a set of drums! Use your kitchen table to set up an epic car stunt jump, equipped with fireworks and all! If you can imagine it, you can build it. Push the boundaries of your imagination in a game made for mixed reality.\n\nFeatures:\n\nMade for Mixed Reality: Scan your walls, ceiling, and furniture and use them as surfaces.\n\nPixel Perfect Precision: Tweak your creations with intuitive controls that let you set and stretch tracks at will. Pinch and pull with your fingers with the newest hand tracking features.\n\nFeed Your Ego: Our recording and casting settings make it simple to show off your genius. Reimagine your room and capture your creations using our scene backdrops, so you can share your creations privately and safely.", "short_description": "In Rube Goldberg Workshop, you can make tons of different machines from over 100 components. Go from virtual reality to mixed reality and use objects and surfaces in the real world as part of your creations. Bounce basketballs off your ceiling and into a set of drums! Use your kitchen table to set up an epic car stunt jump, equipped with fireworks and all! If you can imagine it, you can build it. Push the boundaries of your imagination in a game made for mixed reality."}]}, "developer_name": "Free Range Games", "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": "https://www.freerangegames.com/terms-conditions", "publisher_name": "Free Range Games", "support_website_url": null, "website_url": "https://www.freerangegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING",
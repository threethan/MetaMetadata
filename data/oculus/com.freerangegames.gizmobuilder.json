.5771-25/75307246_357604020119299_766109413262695594_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg-W2_fBRYkQ7kNvwGHlt_U&_nc_oc=AdpP7qGvYorCsJly3o52By79yHaQDsWhgqCFZkLONQSyh0fNmvexIQ8W-ta3FbMyiPk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyXzEgHdGRqz3CSAk9C9D_GtkqhMAdBTtYQqRkU7169g&oe=6B0B41AB"}, {"file_name": "RGW MR image 03 with caption final.png", "id": "1009459670098656", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974649_1009459673431989_8631668915892176535_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlgmOO6RHZ0Q7kNvwGvG_eU&_nc_oc=AdotXQjTn0UYtyMgvWppt7bKQ3m9a9DfKeReNgpfedIUxRQqC56lf0XsJXBAEZyqAQ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHoPRkIhKed7Hg8B5iVHjV919PosUOPzTGm-EbvcbdIA&oe=6B0B0EF4"}, {"file_name": "RGW Screenshot 03.png", "id": "1270395360582060", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974859_1270395363915393_3215400979223388870_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdJk_dKpu-MQ7kNvwHZwTdU&_nc_oc=AdqSbSe7pF4RoJltAaxZ3W8hlvHGV2k7rqZC_qQrfKPzAXcIUCi7My7Ih5uX3VE-nIQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-5umzNLcGViVjy3ybEcZ4gq4gxSva3X3fiobSVwKq0g&oe=6B0B2239"}, {"file_name": "RGW Screenshot 04.png", "id": "641812057795517", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031501_641812061128850_7446013559396686593_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXdJ5kMaSm8Q7kNvwEowCbC&_nc_oc=Adqajb-DZLA5UkwvZn0UTLuiW0CNGUkvX6dyHAklXOtGlPyBfMHRFFv48L_KdVqX_zg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNwIBZ5pvwxynfPcoZj1Ciy1G_TVmMW_4Cw1KfQ3Jz8g&oe=6B0B37E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rube Goldberg Workshop", "keywords": ["gizmo", "gadget", "maker", "builder", "machine"], "long_description": "In Rube Goldberg Workshop, you can make tons of different machines from over 100 components. Go from virtual reality to mixed reality and use objects and surfaces in the real world as part of your creations. Bounce basketballs off your ceiling and into a set of drums! Use your kitchen table to set up an epic car stunt jump, equipped with fireworks and all! If you can imagine it, you can build it. Push the boundaries of your imagination in a game made for mixed reality.\n\nFeatures:\n\nMade for Mixed Reality: Scan your walls, ceiling, and furniture and use them as surfaces.\n\nPixel Perfect Precision: Tweak your creations with intuitive controls that let you set and stretch tracks at will. Pinch and pull with your fingers with the newest hand tracking features.\n\nFeed Your Ego: Our recording and casting settings make it simple to show off your genius. Reimagine your room and capture your creations using our scene backdrops, so you can share your creations privately and safely.", "short_description": "In Rube Goldberg Workshop, you can make tons of different machines from over 100 components. Go from virtual reality to mixed reality and use objects and surfaces in the real world as part of your creations. Bounce basketballs off your ceiling and into a set of drums! Use your kitchen table to set up an epic car stunt jump, equipped with fireworks and all! If you can imagine it, you can build it. Push the boundaries of your imagination in a game made for mixed reality."}]}, "developer_name": "Free Range Games", "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": "https://www.freerangegames.com/terms-conditions", "publisher_name": "Free Range Games", "support_website_url": null, "website_url": "https://www.freerangegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external
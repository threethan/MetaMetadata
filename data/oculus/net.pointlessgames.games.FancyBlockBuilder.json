9rMHkQ7kNvwFpWeN6&_nc_oc=Admm1KhQ6CS-b9zOw-QY6xKuj0w9XQSxR4rdli2BQVcqf5p9pp5XlfELWdtznwEVzmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu8arbaCVpi6BJsQakQKzlrxug8BEreQVbeQ0JtK8M8LQ&oe=699842D4"}, {"file_name": "botm.png", "id": "2539688516409177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820980_2539688519742510_4981278050738826651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYVJjQ3hvT4Q7kNvwGLWa27&_nc_oc=AdmmtyfRjBD6UV7u9vjQ6qEQ_lez9ACK6Nh6KIeHAl8Aq3ubH9UiMfSjlQSAQipqykw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv0swiF2he2epdlmWNdkqWgi0gmJRxncfa8sHYV3MvHMQ&oe=69984B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbb_cover_art.png", "id": "1094907687802436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476599_1094907691135769_4674174474379994233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kq--Lwoi5ssQ7kNvwF4iJ9g&_nc_oc=Adk7JmlQZhZERb1NTTRCOw9tC-nhr874rg6Hn3aj7ePAfIziZLY5oh2RkWG4JOIq47M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuF74OiXSa9GcoyArR5Z9sLXMxGt9Pt2-ijcdHQrS0Lqg&oe=69983B34"}, "display_name": "Fancy Block Builder", "keywords": ["voxel", "block", "build", "craft", "paint"], "long_description": "Unleash your creativity in Fancy Block Builder, a voxel-based sandbox where every side of every block can shine! Build, tint, and design your dream worlds, explore amazing player creations, and enter your masterpieces to win Build of the Month!\n\nOnly your imagination sets the limit. Combine the freedom of sandbox block building with the full-body immersion only VR can deliver!\n\n**No rules - just blocks and dreams.**\n\nMix paints...\n{1751713808850838}\n\nBuild...\n{807028605282694}\n\nAnd submit your creations!\n{32395620430084666}\n\n\n**FEATURES**\n\n\ud83e\uddf0 Intuitive building tools for all skill levels\n\n\ud83c\udfa8 A colourful experience - the entire RGB scale is there\n\n\ud83e\uddf1 Step inside, and live your own voxel based creations\n\n\ud83d\ude49 No audio required\n\n\ud83c\udfc6Compete for the prestigious placement of Build of the Month\n\n\ud83e\udde0 Join in shaping the game, share your mind in the official discord https://discord.gg/UxJvVjQcg4\n\n\n", "short_description": "Unleash your creativity in Fancy Block Builder, a voxel-based sandbox where every side of every block can shine! Build, tint, and design your dream worlds, explore amazing player creations, and enter your masterpieces to win Build of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pointlessgames.net/fancyblockbuilder/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pointless Games AB", "support_website_url": "https://discord.gg/SKCsftY8at", "website_url": "http://www.pointlessgames.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24903542672645765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828008_1516714362691092_6913914791562130980_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDjFt5VUqwoQ7kNvwHK33k2&_nc_oc=AdnIJOSyj0nORlk3OOfz9VgSIFPrLr9x8BJ4evNZkgSD1BZCHB3E4sjpe4aZrHkF1Lc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftUFc1HK1Ohb17G23a2WKvfr5exJpOhXjAo9T9hy9PPjg&oe=69983BC2"}, "is_concept": false, "
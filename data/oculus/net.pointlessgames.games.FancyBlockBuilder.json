-7&_nc_sid=6e7a0a&_nc_ohc=M2Ou4JXLeuYQ7kNvwHkYNcP&_nc_oc=Adoeq_yvXEo_7zW2UQ3Rj00f3MWr0DDqUfNzivZ_BQENt12chz3iCIJbhFHUKZrub4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7McEtam4R26xRqNtw2nDuHlI3lbeXQtuZzZxAG7-ilg&oe=6A5F70DC"}, {"file_name": "FBB_Screenshot_Waterfall.png", "id": "26340171235625410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_26340171248958742_6672692321374765394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVtL8paIc6wQ7kNvwFVZQPv&_nc_oc=AdrzMttwkNGC4qFr8zVcsA0TzXM1tqz2mXPqJPtfAsAnTLD5sBGBat7d1bGKCc97FCo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALO2mtl4Qegq7EztHSkZe1KWlDpzgxvUExLzl64rJ2Qg&oe=6A5F849F"}, {"file_name": "FBB_Screenshot_BotM.png", "id": "1472298144346524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1472298151013190_8764561447883995104_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgj8BtpDTecQ7kNvwFWOCfx&_nc_oc=AdrMDEDbVE4nUAX4p41gI6IoTB3Q34TI2JOHk0vkop6NgSdBvD5B66hnkU8PlI4FfbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwmYU5e21CiUzJpobL1FDLfbW8aj7D2ItnephEV3rRvw&oe=6A5F8CBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBB_CoverLandscape.png", "id": "2049235945976501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499315353_2049235949309834_5266292983082652084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zax0sjasx4YQ7kNvwFR_NDe&_nc_oc=AdoWNuZP4vmDnUffVZpgwRtYgd4IDymuhzRp8NekKIXBM2OnJafr2HURafoD1DQBTQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtP4IyvLR0jidV5aJT_Z-EYAyO2MRjrypG3jiXEsbxQw&oe=6A5F8C64"}, "display_name": "Fancy Block Builder", "keywords": ["voxel", "block", "build", "craft", "paint"], "long_description": "Fancy Block Builder is a creative voxel builder built for VR! Players can explore community creations and submit their own builds to compete for the prestigious position of Build of the Month. With calming, ambient sounds, flexible movement modes and a variety of build tools it is easy to get lost for hours creating epic builds. The new multiplayer mode elevates the building experience and gives friends a laidback hang-out spot in this playful sandbox experience.\n\n{4309567509307458}\n\nOnly your imagination sets the limit. Combine the freedom of sandbox block building with the full-body immersion only VR can deliver!\n\nMix paints and build what you want!\n{1751713808850838}\n\n\nSubmit your creations and compete for Build of The Month title!\n{32395620430084666}\n\n\n**FEATURES**\n\n\ud83e\uddf0 Intuitive building tools for all skill levels\n\n\ud83c\udfa8 A colourful experience - the entire RGB scale is there\n\n\ud83e\uddf1 Step inside, and live your own voxel based creations\n\n\ud83d\ude49 No audio required\n\n\ud83c\udfc6Compete for the prestigious placement of Build of the Month\n\n\ud83e\udde0 Join in shaping the game, share your mind in the official discord https://discord.gg/UxJvVjQcg4\n\n\n\n", "short_description": "Unleash your creativity in Fancy Block Builder, a voxel-based sandbox where every side of every block can shine! Build, tint, and design your dream worlds, explore amazing player creations, and enter your masterpieces to win Build of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pointlessgames.net/fancyblockbuilder/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pointless Games AB", "support_website_url": "https://discord.gg/SKCsftY8at", "website_url": "http://www.pointlessgames.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
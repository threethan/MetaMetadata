-7&_nc_sid=6e7a0a&_nc_ohc=1Ge_B1ocqvIQ7kNvwFlXp1l&_nc_oc=AdoR-jN1NWIzXwOgNTLYV_09oVYaQ9gT5xmGmVAwEl7iwD9fmYzKGCrbWW4lSKRC27k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE2_6PaDdA5GhNx6LgZT1XrJ_rnkBb1Qvzi53_jXSOuQ&oe=6A50F05C"}, {"file_name": "FBB_Screenshot_Waterfall.png", "id": "26340171235625410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_26340171248958742_6672692321374765394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1ZSbozlb7AQ7kNvwEOsn5R&_nc_oc=Adq4BajIrsP1rzsNhAoxteArpKw4E1Edsn5-kbHq4YZNgfG3r1asOoHzYHLX3FyBpdg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFMzeStrwgVHkZZIBPrlFao0aQDWgChXjw5rRpoUFYIg&oe=6A51041F"}, {"file_name": "FBB_Screenshot_BotM.png", "id": "1472298144346524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_1472298151013190_8764561447883995104_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KVT4mPi9I0Q7kNvwGpp0Gy&_nc_oc=AdpIqQ9eu9mGgJMFAmfsx86Lecvt6_YncrDa3sVGAOikF8bd_SdB9B30MwGhLA8xJa0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZYlVWB-c7iyivKsgeSzFobSomkFh9TNWVoANTW3-AHw&oe=6A510C3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBB_CoverLandscape.png", "id": "2049235945976501", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499315353_2049235949309834_5266292983082652084_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mexkk289tO8Q7kNvwG6PiJu&_nc_oc=Ado8QWiQ91v7AFtDMMB-z6TEZsbIUP8_X801T9XhO0uIqa2zGI4SU8SKhMYuarUpnxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIHxX80Ei-OWxDrXfm1_VR_fXG7SxTHPCSRpcW-v1Ayg&oe=6A510BE4"}, "display_name": "Fancy Block Builder", "keywords": ["voxel", "block", "build", "craft", "paint"], "long_description": "Fancy Block Builder is a creative voxel builder built for VR! Players can explore community creations and submit their own builds to compete for the prestigious position of Build of the Month. With calming, ambient sounds, flexible movement modes and a variety of build tools it is easy to get lost for hours creating epic builds. The new multiplayer mode elevates the building experience and gives friends a laidback hang-out spot in this playful sandbox experience.\n\n{4309567509307458}\n\nOnly your imagination sets the limit. Combine the freedom of sandbox block building with the full-body immersion only VR can deliver!\n\nMix paints and build what you want!\n{1751713808850838}\n\n\nSubmit your creations and compete for Build of The Month title!\n{32395620430084666}\n\n\n**FEATURES**\n\n\ud83e\uddf0 Intuitive building tools for all skill levels\n\n\ud83c\udfa8 A colourful experience - the entire RGB scale is there\n\n\ud83e\uddf1 Step inside, and live your own voxel based creations\n\n\ud83d\ude49 No audio required\n\n\ud83c\udfc6Compete for the prestigious placement of Build of the Month\n\n\ud83e\udde0 Join in shaping the game, share your mind in the official discord https://discord.gg/UxJvVjQcg4\n\n\n\n", "short_description": "Unleash your creativity in Fancy Block Builder, a voxel-based sandbox where every side of every block can shine! Build, tint, and design your dream worlds, explore amazing player creations, and enter your masterpieces to win Build of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pointlessgames.net/fancyblockbuilder/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pointless Games AB", "support_website_url": "https://discord.gg/SKCsftY8at", "website_url": "http://www.pointlessgames.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
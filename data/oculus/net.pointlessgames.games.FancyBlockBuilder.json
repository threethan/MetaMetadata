CFF"}, {"file_name": "FBB_Screenshot_ClubCool.png", "id": "1271984518450926", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825497_1271984521784259_7802072810956978419_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfDbZcOzO3AQ7kNvwHFG-ib&_nc_oc=AdoNYj-86QN72sMhuU4KdA_NXzO-WbypWqGkn3IMe7MYX_el5kKog7vtDlEUl93GCm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlRhAgO4lSpvMY8_QBOKkc9n7NH0EPJapnIWiY9R3Npg&oe=6B04749C"}, {"file_name": "FBB_Screenshot_Waterfall.png", "id": "26340171235625410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_26340171248958742_6672692321374765394_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtcao3UZ46oQ7kNvwFwxmds&_nc_oc=AdpE0dnWB0KqfsUFDzu5s6ZDiGDRnSNwUKltBqpzosWKvX9atmOvsdJkbrKySlC-SEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSYdQZg1qwOBuUIdtzga19PNJsiJJuCOeQWiD1z1Tgwg&oe=6B04885F"}, {"file_name": "FBB_Screenshot_BotM.png", "id": "1472298144346524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1472298151013190_8764561447883995104_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOHpHNeWdoQQ7kNvwE3-r9Q&_nc_oc=AdqjvN1naUS8uFxPZHr55O8MM9jUGAMBBaeeQG-FiWUXryrIYKfFSJizt4x42b3ViWM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmZQ5NF7Kb-6_8rNNgmv7tfK0eRbMuRhAxP5Om9eXOWg&oe=6B04583D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBB_CoverLandscape.png", "id": "2049235945976501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315353_2049235949309834_5266292983082652084_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22vz07QBzAYQ7kNvwEF8b86&_nc_oc=AdrID7juLaIxHcxEmdvml0HWZBrw7xZQ0ccq6tl5j3CcZH18dk14l32Ve7phP6rpino&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2ajE0upN3nRfD2acMoRiDHl--pg1bGIgEUZlWQXsWmw&oe=6B0457E4"}, "display_name": "Fancy Block Builder", "keywords": ["voxel", "block", "build", "craft", "paint"], "long_description": "Fancy Block Builder is a creative voxel builder built for VR! Players can explore community creations and submit their own builds to compete for the prestigious position of Build of the Month. With calming, ambient sounds, flexible movement modes and a variety of build tools it is easy to get lost for hours creating epic builds. The new multiplayer mode elevates the building experience and gives friends a laidback hang-out spot in this playful sandbox experience.\n\n{4309567509307458}\n\nOnly your imagination sets the limit. Combine the freedom of sandbox block building with the full-body immersion only VR can deliver!\n\nMix paints and build what you want!\n{1751713808850838}\n\n\nSubmit your creations and compete for Build of The Month title!\n{32395620430084666}\n\n\n**FEATURES**\n\n\ud83e\uddf0 Intuitive building tools for all skill levels\n\n\ud83c\udfa8 A colourful experience - the entire RGB scale is there\n\n\ud83e\uddf1 Step inside, and live your own voxel based creations\n\n\ud83d\ude49 No audio required\n\n\ud83c\udfc6Compete for the prestigious placement of Build of the Month\n\n\ud83e\udde0 Join in shaping the game, share your mind in the official discord https://discord.gg/UxJvVjQcg4\n\n\n\n", "short_description": "Unleash your creativity in Fancy Block Builder, a voxel-based sandbox where every side of every block can shine! Build, tint, and design your dream worlds, explore amazing player creations, and enter your masterpieces to win Build of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pointlessgames.net/fancyblockbuilder/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pointless Games AB", "support_website_url": "https://discord.gg/SKCsftY8at", "website_url": "http://www.pointlessgames.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
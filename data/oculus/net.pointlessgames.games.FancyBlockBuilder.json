om/v/t64.5771-25/39035392_407898101328450_4545903828551909673_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7e5Y-w0Wy8Q7kNvwGSaQXo&_nc_oc=AdpcioLk6g9KbqrUZuA_c2ImYyugxQpmrDcmJ6rjQeqjbWMdYeTHvm-bNnFZspr_XHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wzGo9r1cTng6l33fqojp3S6vFuEhbs3cHhVMBO7B36w&oe=69E0FD94"}, {"file_name": "botm.png", "id": "2539688516409177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820980_2539688519742510_4981278050738826651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o87sjVMseq8Q7kNvwE9-bYG&_nc_oc=AdoI6s054-Wf6dkqwbKMw4mxr4VaytGwIor5wf_3mjPfUG_wxXGwgNg_vBBvQqwi4_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DkBTKfHvym0jYkPnTBgb0C1MHoAauyA_5sQlAYR4WPA&oe=69E0CDDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fbb_cover_art.png", "id": "1094907687802436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476599_1094907691135769_4674174474379994233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZpP6Pakg7IQ7kNvwHLgJBu&_nc_oc=AdpDCK1VCUdCU6W9pjGSrWA9H74rjjtJQf75IvFgiGrHYXJsLriEl7l6AQ-HMzHwBng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZSQcj32KS2NsllJDhY2ehkwfXb71ic4PXOa5OpaQ-ng&oe=69E0F5F4"}, "display_name": "Fancy Block Builder", "keywords": ["voxel", "block", "build", "craft", "paint"], "long_description": "Unleash your creativity in Fancy Block Builder, a voxel-based sandbox where every side of every block can shine! Build, tint, and design your dream worlds, explore amazing player creations, and enter your masterpieces to win Build of the Month!\n\nOnly your imagination sets the limit. Combine the freedom of sandbox block building with the full-body immersion only VR can deliver!\n\n**No rules - just blocks and dreams.**\n\nMix paints...\n{1751713808850838}\n\nBuild...\n{807028605282694}\n\nAnd submit your creations!\n{32395620430084666}\n\n\n**FEATURES**\n\n\ud83e\uddf0 Intuitive building tools for all skill levels\n\n\ud83c\udfa8 A colourful experience - the entire RGB scale is there\n\n\ud83e\uddf1 Step inside, and live your own voxel based creations\n\n\ud83d\ude49 No audio required\n\n\ud83c\udfc6Compete for the prestigious placement of Build of the Month\n\n\ud83e\udde0 Join in shaping the game, share your mind in the official discord https://discord.gg/UxJvVjQcg4\n\n\n", "short_description": "Unleash your creativity in Fancy Block Builder, a voxel-based sandbox where every side of every block can shine! Build, tint, and design your dream worlds, explore amazing player creations, and enter your masterpieces to win Build of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pointlessgames.net/fancyblockbuilder/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pointless Games AB", "support_website_url": "https://discord.gg/SKCsftY8at", "website_url": "http://www.pointlessgames.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24903542672645765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828008_1516714362691092_6913914791562130980_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8VSKlbS594Q7kNvwHk10F1&_nc_oc=Adpnh37nq2sBw9Psk4J45RorlT8GbCu6Sz9v0-cGMLMd6kU1
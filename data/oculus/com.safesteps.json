ent-iad6-1.oculuscdn.com/v/t64.5771-25/499623512_1566663151339423_2735790319503785752_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNWhQwtpL6IQ7kNvwHhBBKL&_nc_oc=AdqrFj1uo7gRhp8FzQ9jkoMvZmkOANkhlh152UIp6P7qyclAtJRu0KEXDpUgcyudKgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7DHHCcnqiHPn0P95IjzFCLB0By2bVmBEPRc9zZqbXyA&oe=6AEB60A1"}, {"file_name": "V2.png", "id": "1072380925591656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628456_1072380928924989_8109336363623410894_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAJHtK1CPDoQ7kNvwG5b7zO&_nc_oc=AdqdO7HuRFWqIgv3NRpHkISsYTeSYMvF_PY0Kqr5_tzYDSpe2HBHL5UjbNObCQgPUMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Hl2jGsX5DALuLgbm9lCOKuW6wUw9GWcMEzX6JVR2nQ&oe=6AEB3410"}, {"file_name": "V1.png", "id": "1803369600980930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620316_1803369604314263_2951014379186385611_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_SAY1deXCQQ7kNvwF8GRZe&_nc_oc=AdrNxjQ13EhZeA6P_TwPGgj6SurBwzrS8r72v2pnBHdKkSRAknLDMp311As3GEdjm-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGfXABA9itIoY7FdngHNsWg7ErdHQT7lS5GBVq2_5QpA&oe=6AEB4A73"}, {"file_name": "V4.png", "id": "1417842776477449", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620559_1417842779810782_3827818758806445771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvegnp47Rh8Q7kNvwHZJM5I&_nc_oc=Adpowl5Lm8_w68lte81l1s9yGu2JkicBPXmg9L9GMUZ3j1GM6gFMEOOU_mq1ypaUQ60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjhkk4opqRi-1s7Lfj22ENysK8NuqIDqcIFgsiCDMINA&oe=6AEB4F46"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Safe Steps", "keywords": [], "long_description": "Safe Steps is a Virtual Reality application designed to teach Indian school-going children essential traffic and road-safety practices through immersive, interactive experiences. It helps children understand safe road crossing, traffic signals, pedestrian etiquette, hazard awareness, and responsible behavior in realistic virtual road environments.\n\nThrough scenario-based VR simulations, children can observe traffic, make decisions, and learn from their actions in a safe and controlled environment. The application turns conventional safety education into an engaging and memorable learning experience while allowing students to practice real-world situations without physical risk.\n\nSafe Steps demonstrates the use of immersive technology for meaningful educational and social impact, helping schools introduce practical road-safety awareness in an engaging and technology-driven format.", "short_description": "Virtual Reality Application for Traffic Safety Education in Indian School Going Children, Safe Steps uses immersive VR to teach kids road-crossing behaviour, pedestrian etiquette, and traffic-rule awareness turning safety education into an engaging, memorable experience rather than a one-time lecture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://safesteps.info/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Yogeshwar Navandar", "support_website_url": null, "website_url": "https://safesteps.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1467218869797325"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLI
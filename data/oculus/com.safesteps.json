ent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623512_1566663151339423_2735790319503785752_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jrb2tqQsHgQ7kNvwHLgjST&_nc_oc=Adqc7KlwKvwb6_tF0SNKW25Oj2asjBiPiAX2eQgWLQ4cQTc7nWWBm3VtsOlRj3yAoQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2wrF_qU534Or11gab2IsnNDGaOsWbZBx56WHDoqgpjA&oe=6AF9E121"}, {"file_name": "V2.png", "id": "1072380925591656", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499628456_1072380928924989_8109336363623410894_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaCGCrCao5wQ7kNvwEEA0Y0&_nc_oc=Adrj-7aSL3mmTzckuf4twJpanL3LJfr5QnAEMyYZbYlduAZ4hfqSl54a6NoC5ygamBE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjXMJ-VPN6o-Chb6NUW4k6x2odMPMfwWy0s6uq8_UpuQ&oe=6AF9ECD0"}, {"file_name": "V1.png", "id": "1803369600980930", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620316_1803369604314263_2951014379186385611_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXuDPANGztwQ7kNvwFhyyQj&_nc_oc=AdqXV4GuUmZif9eGLITT9xYtlMfQEeR22vgjWYkD_nWryvTkz8-GfYpgpHxlogOlS1g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA5UZJUNeiqeB5Zl2svoFcOXdv0HpZfVK_IyB4diMAsg&oe=6AF9CAF3"}, {"file_name": "V4.png", "id": "1417842776477449", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620559_1417842779810782_3827818758806445771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uv7ApipxiMwQ7kNvwG8SW7B&_nc_oc=AdoWAYcW1jT4NqgQ18TuL39zUG8yTJ0a-p8jQls-ts7kyzegasrPq9AfnF-onBVotr8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwk_3WfvOdspsamlLr2cHZnahWLBDh5famgHlCi7FhYg&oe=6AF9CFC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Safe Steps", "keywords": [], "long_description": "Safe Steps is a Virtual Reality application designed to teach Indian school-going children essential traffic and road-safety practices through immersive, interactive experiences. It helps children understand safe road crossing, traffic signals, pedestrian etiquette, hazard awareness, and responsible behavior in realistic virtual road environments.\n\nThrough scenario-based VR simulations, children can observe traffic, make decisions, and learn from their actions in a safe and controlled environment. The application turns conventional safety education into an engaging and memorable learning experience while allowing students to practice real-world situations without physical risk.\n\nSafe Steps demonstrates the use of immersive technology for meaningful educational and social impact, helping schools introduce practical road-safety awareness in an engaging and technology-driven format.", "short_description": "Virtual Reality Application for Traffic Safety Education in Indian School Going Children, Safe Steps uses immersive VR to teach kids road-crossing behaviour, pedestrian etiquette, and traffic-rule awareness turning safety education into an engaging, memorable experience rather than a one-time lecture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://safesteps.info/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Yogeshwar Navandar", "support_website_url": null, "website_url": "https://safesteps.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1467218869797325"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLI
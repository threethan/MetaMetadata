0C74ovg9EIWScrVhavmcAbGC6u9jCvUAk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTTVr7eV3_3t3LodcnUP6Ck4kn5kDvygMpe4fHf03whQ&oe=6B0B2544"}, {"file_name": "Fish 2 resized.png", "id": "1860013181343043", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619465_1860013184676376_5973224383090838826_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ni717GyzcsQ7kNvwHl81fb&_nc_oc=AdpJOU4RdXsuB_iMQswWbGn0AJw6_P1bhJTO6ZAeZOT8lhqATT_c4fEmEGTBJrpj2ps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQG0prAjKrjA1hNwfa-slF-itE04MxPZIeMLzZTCDi8HA&oe=6B0B4400"}, {"file_name": "Fish 4 resized.png", "id": "1413307510554335", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301061_1413307513887668_6880525417940326382_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJlY9_oHms0Q7kNvwF7ybYV&_nc_oc=AdozqklSsoq_xAtccBI2SiinRaUvvc_tyrgZyk3FWtEWG9qeZJMluYivyUTYpwsvfko&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRo6rPPa5N-QqRJoRSA7pqaqDmnYzFTST4ORfqPb05RNw&oe=6B0B3C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "2431035203770012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75251816_2431035207103345_6702715656944969325_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXM3xOD0GtQQ7kNvwHBBAdq&_nc_oc=Adro9Hez38CNQ2jFBfammlL73__EtKo5WNNc_jla9tbs9KIvMIZrDySKaWLopIP6onQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlmeGVRp6wIv5Osq9bWqdBc-OBC-9Ax5hs4PI6tr7c3w&oe=6B0B37C2"}, "display_name": "Cuddle Fish", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Cuddle Fish brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put some kelp on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nSea you there! (Get it? \"Sea,\" as in the ocean. The ocean that fish live in. That's the one. Feel free to join our Discord if you'd like further explanation of this incredible pun, or for any other reason: https://discord.gg/tRRZE4xKAW)", "short_description": "Cuddle a fish or two."}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://www.meepengine.com/aquarioom-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://www.meepengine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26691818853818328"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974914_6899313850107605_2780616801883933623_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxFhgOMiv08Q7kNvwHNVOGw&_nc_oc=Adq8s2w0LXiUHjFWkSayLToltCI6I_t_sXslMvQ_5Sv3ur6XUZvZCiDIbPYbbdoN7yg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUtXkTHtT2gJjIp3Te3QvEs9Etf2jNqW2822hSyz6tMw&oe=6B0B34D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cuddle Fish", "platform": "
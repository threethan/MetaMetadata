qsxVF&_nc_oc=AdmYMBPVvn0A5T-6hgLqZXtVaooGn-XVbgmLtZEJ0DLqoczu7wObUwh4P-A-U3ODC90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsxtBmmISuXxV4q0VbA_C8WyY7-fToN-cIseakt4mwYXA&oe=69A044FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4dk247Sw3AQ7kNvwHHLHrv&_nc_oc=AdkeIyV1MoAnDwnKHQfVAbjb5fYaNZe5Z6W7I71vyM1a5xFQmN6YYuFq4LPS_vR9FS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZtCEyUQLveNJ02Rtlfz5ZGlqa4cj7IkmkIPbhc3XTsg&oe=69A0566B"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recomme
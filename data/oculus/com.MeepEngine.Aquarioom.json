869654617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wWrY4t4YEQQ7kNvwFMgeDB&_nc_oc=AdqnV2l5AbHJRnPX5E2wWsds7OmbVyCEJjKQZykUn3zvZmlClrW1iwgpts_ONlcDobc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LBCpHgkTC_YqqrgLUWxJw6Ct2Fe1jXh_hooPHTadBXw&oe=69E6247D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETDVGErvd0kQ7kNvwEtrmKq&_nc_oc=Adqso2aNBAFfxHBN4-5Ru_rjpsyDQlSKGQYxsk5Ry0663WTGSzFmXdgxYDp5YzM20RY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wN-o6orXUfmNm5JnaZQm5c8ME2nQn8yURy2YN5QuGnw&oe=69E635EB"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
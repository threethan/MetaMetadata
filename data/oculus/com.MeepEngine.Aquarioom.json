xMKCmrlhGGZ1V11QLXcwfaVqmxaMzfweg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh5BtpndyG4wVU_oo2-b9GinsoJyCv29E-SbKjWH82Lw&oe=6B084A04"}, {"file_name": "Fish 2 resized.png", "id": "1860013181343043", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619465_1860013184676376_5973224383090838826_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik1F43aAbiQQ7kNvwH49sxF&_nc_oc=AdqS5238OdPbRdjEfnbKVxzpSf3dFEcKduv_rPlRrCeEF_YTm39fP1I3SZIGtF31nhg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLhWzTCW-zJLjt6xc6bv9RvNrlvcqyjiZ1XhfGdE0JNg&oe=6B0868C0"}, {"file_name": "Fish 4 resized.png", "id": "1413307510554335", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499301061_1413307513887668_6880525417940326382_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJlY9_oHms0Q7kNvwGiogct&_nc_oc=AdrFrR1Fa2OOZBQCT4x1nw883M_fW_ZOCbLqUgjTKSjlu1n6oXi22XYcSQL77Oq6M0Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJmhQmdxUenxU-6BCytLmmmc9igKjxmkEA4i44LI_DkQ&oe=6B0860D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "2431035203770012", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75251816_2431035207103345_6702715656944969325_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3g3Za0ZkKgQ7kNvwFTiQMl&_nc_oc=Adq8XoBAH1Qz6jNOOkQMbESz_aVq4ZTgsugQI_oyd9ha4uR8xtSlbNYSnSOZjdH0DEU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO-cMcTezp6fO5q7ATY5Mi0Z4A-oozLiJK-Bq11RJFVQ&oe=6B085C82"}, "display_name": "Cuddle Fish", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Cuddle Fish brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put some kelp on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nSea you there! (Get it? \"Sea,\" as in the ocean. The ocean that fish live in. That's the one. Feel free to join our Discord if you'd like further explanation of this incredible pun, or for any other reason: https://discord.gg/tRRZE4xKAW)", "short_description": "Cuddle a fish or two."}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://www.meepengine.com/aquarioom-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://www.meepengine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26691818853818328"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974914_6899313850107605_2780616801883933623_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxFhgOMiv08Q7kNvwHVU4fS&_nc_oc=AdpjdZy90zl4nkH2CTn8c9xtkFF18AaThHpLS0gZFHKmckOk0EKK9u9-uyjVzV5eMwE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8sbdvETufytcUslrHZyocLaKjbAo3mQYV2hHXH8AxNQ&oe=6B085998"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cuddle Fish", "platform": "
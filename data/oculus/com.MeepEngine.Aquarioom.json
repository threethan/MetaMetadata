culuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kU92lkRrlQQ7kNvwFpe0m3&_nc_oc=AdqH_q8PAJRLYMYmAY-sU8Z8ajmq397f9wJLUP3Q4HluMIZYVGUGZ6QFKcjtx6ko51Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5wrYphkbHiC3AUG2oyt6kn6ODMy5mEx44zy0cpaoh0Q&oe=6A6768EB"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "280759791377476"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3691805
ETMYsGqtEUmBfzaPrGdPaLz3pbFX3vTKKrs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyLI6gPJaFZ99BEp6C7E8CCw9QhAfXYc0OaX_RqoiNvng&oe=69BA9105"}, {"file_name": "Fish 0.png", "id": "610769394577911", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974741_610769397911244_8729976635437616134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT7n3jcJ9kUQ7kNvwFE5vyi&_nc_oc=Adm2eYxG0vKeS-0tdrkMeqqRG2b-O-u32g-omXhOnNhE7l4pwkUj8LS_pKJaXVWbIqg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy6Lh68F5fG9yS2T9pZgVpMI0-95flO9N2xG_matG2IBg&oe=69BA97EE"}, {"file_name": "Fish 3.png", "id": "991970591912248", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982670_991970595245581_1878516064011182791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3_F2zOYJt0Q7kNvwFVQhPE&_nc_oc=AdmLfUEwH7gkQDn3vBapRZo_A_GAsQPGKXvmeqnZiOsJmm4rIa57ORy8X7X_6c5M5ME&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwyXezQNrog81UwCBSjv3iKM0lXEbyY6XnQWRQcMlKBlg&oe=69BAB0DB"}, {"file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G7lO0jo7cgQ7kNvwHAciX3&_nc_oc=AdlBC6wRe3e94VBnin8M8Kb0xTusJgtVSZ-RrVO761XMtqgJCFi_dKAa2XD4KE4ozbI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0gSiX6Zgmfn7MwoI9_twHgAuscmPp6jPDSCk5JWCZ1A&oe=69BAA2FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "2431035203770012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251816_2431035207103345_6702715656944969325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhv-oeyv9FEQ7kNvwF7ctFw&_nc_oc=Adl4RbN_tt0st8iE8Ce8zg5a0oxcSXP4Se7po4_2FUZ8i2YGI6t8oCdeak21FPGJXlY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyX8rxaITpVY5LA6hYD0jquTLu1InXsY1pWuI1s4Ef80g&oe=69BA98C2"}, "display_name": "Cuddle Fish", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Cuddle Fish brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put some kelp on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nSea you there! (Get it? \"Sea,\" as in the ocean. The ocean that fish live in. That's the one. Feel free to join our Discord if you'd like further explanation of this incredible pun, or for any other reason: https://discord.gg/tRRZE4xKAW)", "short_description": "Cuddle a fish or two."}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://meepengine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8680938848666271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974914_6899313850107605_2780616801883933623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R93PPNUO0-kQ7kNvwHLP29Q&_nc_oc=AdmdWHQYa_9LyLU7n0_b_1huNJO1
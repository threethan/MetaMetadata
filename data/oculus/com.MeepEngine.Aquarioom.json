-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DGJKvEzwr22NgDRikPsuYt2GxJ4tTbnc6VriJFXzjGQ&oe=69D26BDB"}, {"file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AINIbkZz6zwQ7kNvwE7nyGz&_nc_oc=AdrKf5a3w89f1-8GEno5NGiLNeN7-ugoRyjdbisf5JZSy3JJNZoNr_NwqFtyATyrK4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04fBXgk3r6wR78JGKIOBr_dX4fHtgl-SaPLNDCjYtg2A&oe=69D25DFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzseocvbGMgQ7kNvwE9oSjn&_nc_oc=Adrz2F0YQ24V70rf0ha--bXwkIj6m54Y0R-52Ec_pwyCJKA_2YQ3LPmy9WyKIimOjpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z0-Xx0u5ldYcw5G7iZGaIVCsxOM5bqGDtyk7e_cEgTQ&oe=69D26F6B"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED", 
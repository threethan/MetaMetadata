42-nXU_fg59v4eaZ--dSDwBz_w1LvWWBP88&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9abmgXnxbAfblHd6gXMzXnSWezlGtaQAzTayP9vml0Q&oe=69BD3405"}, {"file_name": "Fish 0.png", "id": "610769394577911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974741_610769397911244_8729976635437616134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2XA1EeSjRMQ7kNvwGzqdm3&_nc_oc=Adm7jh5_2JBD64lcSoRDek0u4UFyJHgr_sB4xJgCaAmpa5mkOaJHN0MjZX1nvrnMB5I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8rjrcjSbOHgjGoJFwDvOwzCcDRAXlX-xtNzXxlymlJg&oe=69BD3AEE"}, {"file_name": "Fish 3.png", "id": "991970591912248", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982670_991970595245581_1878516064011182791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nafg8JAsi_gQ7kNvwFelq4a&_nc_oc=Adna5-GZ40x-cboOmcng7PdD1Cwb-zAoZ4tNUQcc24y0WFOrY5QXW4J3ky-jn4vVSNY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxT0adN-7pZ_6S-P7gy3lQSqSu0y-AwdKOxjLHXjm3pXg&oe=69BD53DB"}, {"file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnrUvM6beJcQ7kNvwFSuo2n&_nc_oc=AdkZmPJp_hJ077gpUvmM99HgOXiKn0XHYfAhW4A_I9OckeEp-5Kh2mgWd8phcVNTbxQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8rlKLfbeX0PRXoDxgYl489Zv4-GpXkU_oKl2-Omz_EQ&oe=69BD45FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "2431035203770012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75251816_2431035207103345_6702715656944969325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhv-oeyv9FEQ7kNvwG9HwEy&_nc_oc=AdmGhYnIAYtRfw9AcGA-jH_7CAN2FrYkgLQXylS8QYxNYqdSk_7wH2HK1D2eH4mzIjo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5sBFLr7ObbNJ5-TUE-aS8sEvE-BP9c0_-Ek2G34Rurw&oe=69BD3BC2"}, "display_name": "Cuddle Fish", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Cuddle Fish brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put some kelp on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nSea you there! (Get it? \"Sea,\" as in the ocean. The ocean that fish live in. That's the one. Feel free to join our Discord if you'd like further explanation of this incredible pun, or for any other reason: https://discord.gg/tRRZE4xKAW)", "short_description": "Cuddle a fish or two."}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://meepengine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8680938848666271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974914_6899313850107605_2780616801883933623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2SzaaHg9hEQ7kNvwGlNEzj&_nc_oc=AdnsiNEUYuTD6NjaggUjEmtw6XYE
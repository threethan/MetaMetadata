-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgmY5glVchsLXMGRdHaIRURPRqp_m9NNf1efDtI3LX8g&oe=69C53CDB"}, {"file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbojcsKxnVYQ7kNvwFgaID7&_nc_oc=AdoCE7sk_5bpVhpVntZ8_Zfx677lK2eM5SDdbZ3sYyociv4DD87mPr6TTlLXIp8-1BU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxd-_VzlS8Ar8Auh6XGYF02mVYgButn3SicQ7vPs-cxIw&oe=69C52EFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld8DTvmhHcAQ7kNvwFHMVUi&_nc_oc=AdoQhJiuGFrtbZ471YEL5BW5rt_MFm4Ru-_TlUEGAGMzTRwwu-OIaKEPK-nGSm0dDew&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3U1M479bNA0_gs9qe8QQdU4HLhlF2mgsl1xjoNVadRQ&oe=69C5406B"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED", 
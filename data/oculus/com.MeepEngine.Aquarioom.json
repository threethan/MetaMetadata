869654617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wWrY4t4YEQQ7kNvwG3EWj-&_nc_oc=AdryEcGdgEL-mu26qd1ri6xy5tjQxw_B1XnJWojqfFFtDDXwFeTkGm78QdBeCutyZCw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20LIhQqrwACJ-pL0246crkzxEoxAi6VG0Rr-2KISFARA&oe=69E775FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETDVGErvd0kQ7kNvwFKDrqh&_nc_oc=AdoMyYJH4wsgoKphjRs9InatsVbnSlO0KYyZvO76rK-dHFExzHS_B7AKJ8MPzb9CXas&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af340pkhVa_pq5mvhkLTJSUJs1Gqm2oDYO4Z_lo-4k5h1w&oe=69E7876B"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
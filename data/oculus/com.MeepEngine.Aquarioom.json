gVhyy8fEGHWjZpvd0kx4ommjLgLZloy8j8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy24f32h7kH0VFEl_A3crax06CE27PwLMNiYXD0wsC4Sg&oe=69BFD705"}, {"file_name": "Fish 0.png", "id": "610769394577911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_610769397911244_8729976635437616134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-EXNVb3HcwQ7kNvwHRghTS&_nc_oc=AdkN3YqqXyuIY07gSRJbe1Rr8Orem3BXPwX4_-T8deMBBwa-W-0mZ6S7lCOhG8zgZ-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzi1_O1mICnV-FdmD2kQFZ7LPOR7WtC8gQrZXtuupgbnQ&oe=69BFDDEE"}, {"file_name": "Fish 3.png", "id": "991970591912248", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982670_991970595245581_1878516064011182791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nafg8JAsi_gQ7kNvwHhntTo&_nc_oc=AdnUfdZX-tu750VYy50LhRj3KLSkbbLtze5ktTvCWcm5-WMuT-dce9JUUyc2zXn7Jwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzg-1TS0QnyeeHTL3rcaRLPoSvpaypPz_3C9hXYOYo34w&oe=69BFF6DB"}, {"file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnrUvM6beJcQ7kNvwFz9JEa&_nc_oc=Adm8atS9Thh-5wZUp3bmDmuUE74Be7Ioqnu7rof45CzuNZa6VNcftOjnVvq-Lesoqvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5tZUlo7jbARuCY2P4c-XCf-dYjZdO3krRWCW2aOHFBA&oe=69BFE8FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "2431035203770012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251816_2431035207103345_6702715656944969325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6iMUH-WHwAQ7kNvwHjNfws&_nc_oc=AdlhG5xJRS7CSEJ2R7tFENN7lVgD-ya2-DxSvrn3txaz6T23rVokdbfoMdCl4dL9LSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd1-E4W53_XcNhYxnN_FFrl763J0jmCC6tkajMW-Ra_w&oe=69BFDEC2"}, "display_name": "Cuddle Fish", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Cuddle Fish brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put some kelp on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nSea you there! (Get it? \"Sea,\" as in the ocean. The ocean that fish live in. That's the one. Feel free to join our Discord if you'd like further explanation of this incredible pun, or for any other reason: https://discord.gg/tRRZE4xKAW)", "short_description": "Cuddle a fish or two."}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://meepengine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8680938848666271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974914_6899313850107605_2780616801883933623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q2Y6FOp77UQ7kNvwElTLZj&_nc_oc=Adlt3aNbXPySndq8OTXE_-3KXaYU
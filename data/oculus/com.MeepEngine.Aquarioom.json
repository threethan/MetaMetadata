qD710-bIhW5U8INe8wsDzrItrPm-Dj12g&oe=6B05D19B"}, {"file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylYPsgyYI68Q7kNvwHwUXnb&_nc_oc=Adr4K9R3DqjK2aLBSwRDfXESZlVZ9Me3dZowc-WCkVAprITmwMIQdpsOmKni2QCWGnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwIR6Z1OPww2EEhbtOIMFFWIC2DR4fluNKU--d9DUirQ&oe=6B05C3BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-f8Q_dhqLkQ7kNvwHXX79Z&_nc_oc=AdovynwHFWEydQkqCVLvVnjIZWI_wrwwBKxSoASEYb6VTkyTSNZAx6P2BLQmQRazrac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM285GtuXGmS3RrrtTLimdv7wWjXRLh2kZoOKe3EtS_g&oe=6B05D52B"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED
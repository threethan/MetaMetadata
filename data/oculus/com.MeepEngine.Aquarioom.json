ps://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619465_1860013184676376_5973224383090838826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FhTR4L5xEUQ7kNvwHoxIY8&_nc_oc=AdqJqErDlcJ0FjNRDgwm9YwiFfJ6arLHNvtcZVQ7_EPleTggaMMBR75aDuRzzz1RjOk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFualyTX5TC7TH1UjO_GVGwbYu7UmP4h1915Wz4NNQlUQ&oe=6A81B780"}, {"file_name": "Fish 4 resized.png", "id": "1413307510554335", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301061_1413307513887668_6880525417940326382_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rynEQHt6Hc4Q7kNvwFF4HdN&_nc_oc=AdriaeCk9LRrqzT1YJ7TGYMX06YshHVxfCNQMHcz5CnikU3qeUoLnzUCpd2Q07yigyQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEotiWw6YDXX52wqYxz2pSxyioKYG8dB5Z7_KgDrK_5Kw&oe=6A81AF92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape (2).png", "id": "2431035203770012", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75251816_2431035207103345_6702715656944969325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXI9a4BvxhcQ7kNvwE-RBl1&_nc_oc=Adqs2ytJgV1RwlK4P4Vse1bfvumQIyq03gLyV69XDQj2ONrSdqq8LZcEzKiWRy8xsf0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1Tn8rHvBesfZizIyUahnUxkCVufMtsKHUbZM8mhExoQ&oe=6A81AB42"}, "display_name": "Cuddle Fish", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Cuddle Fish brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put some kelp on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nSea you there! (Get it? \"Sea,\" as in the ocean. The ocean that fish live in. That's the one. Feel free to join our Discord if you'd like further explanation of this incredible pun, or for any other reason: https://discord.gg/tRRZE4xKAW)", "short_description": "Cuddle a fish or two."}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://www.meepengine.com/aquarioom-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://www.meepengine.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26691818853818328"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974914_6899313850107605_2780616801883933623_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtPkZBK7AI4Q7kNvwF_XkX1&_nc_oc=AdpG8_CqertPQFcedLbgYy4fyqFccw2Y4lBv1JPZ25BHfOmHJnatoFCw3xXqcAykXkA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOEfbGBHQKfezPeYZPEGWpIXsuGVA9r94lhvxbZF2ubw&oe=6A81A858"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cuddle Fish", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1695970800, "lastRevision": {"nodes": [{"id": "6488870461206465", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applica
rOi_VcibmIKjZxKtlTicY8mEVy6p4xxYA&oe=6AFF01DB"}, {"file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqplR7jejrEQ7kNvwGKbM_6&_nc_oc=AdoBFDIQE8UASiZIzxYCZWX1iEzczqKqoFBIAaiyAIDgMXohW2745F0bJK6KgZWYcsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5EKlsWJdLxPmHmXGSIvmrxPH6lz_L6P8vr0j8Qphg-A&oe=6AFF2C3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV6GWK0UnHwQ7kNvwHqS39J&_nc_oc=Ado-43ni7gcq8tpw4vx3_nij6aDcc6Z99-exaRa4TB3M_EAYDlA_mkI4Pw6Wg62R_74&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDUL4R8pQfVCy2mRUgATrgdOgIBeFJk_v_RhDz50wVkQ&oe=6AFF056B"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED
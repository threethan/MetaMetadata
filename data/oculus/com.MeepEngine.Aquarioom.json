file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0Q_ICVT6p0Q7kNvwFbsAdq&_nc_oc=AdlZtT_xEjbiBSYKRnwhpmz4ipttCm4N3waDBofYJE59fuG6D-t73tHAwVselmTox5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3iRgxWH7BI_Vq-q7OzA_TP8JhMPG0-5Z9g2YNMvuusQ&oe=69AD73FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnvR4mIEeK0Q7kNvwH370uk&_nc_oc=AdmEamjlnpJVrr4BrWPKYTWSHlf4CpRCZ2ioVV4U48R_4toE1ysZP00Fugww4VJEMRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxa3aGs8GSh_C7bAiJqZObmAHEPFxds0Aj6So-g2EB9Ww&oe=69AD856B"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
xHBy5fNdoGMD_edZ0UTQQfFbO5MLkJhwA&oe=6B0C691B"}, {"file_name": "Fish 2.png", "id": "1123618298599670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003260_1123618301933003_3615572849869654617_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BUnWyj9GKUQ7kNvwF2n6wt&_nc_oc=AdrT-VujIITe1gHQBhhAEId68sdGb32thMLPSbQgdKEGkT4iAzNeMT1WvgwQZs8ISBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqOBybj1xctmPFTrZ_L95wMZlI066v99yMQXSsL_4lMw&oe=6B0C5B3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "350388727311139", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_350388730644472_4155762025545067916_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfPIBwE9meoQ7kNvwFuyAdI&_nc_oc=Adpqf37SDI7zpo2W2ZvbMo1KodJNuRuBFOt5lh1R-Yrbga_0hUolVewRy3m4Uh1AzvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtmK7iEDxshGVU5xVtJnOoXNppK0V4hx9x2LsavFhuxw&oe=6B0C6CAB"}, "display_name": "Aquarioom", "keywords": [], "long_description": "Has this ever happened to you? You're in your boring house, watching dull television, and you aren't surrounded by any fish at all. \n\nWell, no more! Aquarioom brings magical fish into your space that you can feed and pet to befriend them, like any wild animal. Once befriended, they'll bring you fun decorations you can use to spice up your room. Put a jellyfish chandelier on your desk. Cover your cat in seaweed. The world is your oyster, and you are an oyster's friend.\n\nIt's aqua. It's room. It's aquarium. It's aquarium room. Aquarioom.", "short_description": "Turn your room into an aquarium!"}]}, "developer_name": "Meep Engine", "developer_privacy_policy_url": "https://knipsch.com/aquarioomPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meep Engine", "support_website_url": null, "website_url": "https://knipsch.com/", "category": null, "comfort_rating": "NOT_RATED
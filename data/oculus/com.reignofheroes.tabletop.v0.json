ale": "fr_FR", "screenshots": [{"file_name": "01-plateau-grass.png", "id": "962502129880352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622153_962502133213685_962277158968275899_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3mVhP0xM7oQ7kNvwHYGjgh&_nc_oc=AdpdxSBIpz2IrLjV-hEhM9RdmUh8tiaPJYfxlxBFZF8WCpH8BzijJX6f1V3xtjAFVkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUUYSbsHx9bvgmTbUKbhQqMdtnE4Ri-ICnLbT1kYfozEw&oe=6B105895"}, {"file_name": "02-choix-heros-fr.png", "id": "1109396438511367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/594008142_1109396441844700_5588607990457622128_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krxzVKv3mZIQ7kNvwGJMOpz&_nc_oc=AdqhrHY0s7mRDAdElZ3KgFlUB_useTVBo8pgxDUl2Ax7RIjfnha1RJcoLdFdxiqKO0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_pglDXBGyGaK8jZ3VxrvFwsD1BA4jEJRHxwyzbZyH2g&oe=6B1056CA"}, {"file_name": "03-magic-lane.png", "id": "1867926587535229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626728_1867926590868562_8509760117738584737_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj42dGgvyOoQ7kNvwEbgZ8O&_nc_oc=AdrwlJiGLwoB8Od1gMzPccKeklJuozsZGWFuTDE_1LBcu3bTuj6C4LiBfGfVOeKznYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVz_vyLNy4JfawSGbGe8XGZruoBcThDvuhg7Ak2G4IIpg&oe=6B1036D6"}, {"file_name": "04-melee-river.png", "id": "2123321975049537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620630_2123321978382870_6956496106410955008_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKkEObG710sQ7kNvwHwbsS2&_nc_oc=AdojMRDYBdI6egELPrLakiOBcqLeFdwRnXczZfoZPpZhh6TvhzWctkDl_DC7l61m20Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzD7rthGxDnir6xW4v7lbdbuy8SpzYK4PI1E6kJyM5Og&oe=6B103B8C"}, {"file_name": "05-tower-lane.png", "id": "1030809530051508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620669_1030809533384841_9168639280287712056_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwNAhMhSz6cQ7kNvwEmM7t9&_nc_oc=Adrl_d3tYVErfuG6kjS8oWp-jsShRCk9UqSaywRXUbTobmUvhGLy_CsCvOHO97jhGR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXXBq9m1Cx-IopyAeo3Jdiepd-Po35QBt9lNeVK5Hbeg&oe=6B103694"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reign of Heroes - Tabletop MOBA", "keywords": ["MOBA", "arcade", "strategie", "multijoueur", "fantasie"], "long_description": "VOS AMIS. VOS H\u00c9ROS. DES BATAILLES \u00c9PIQUES.\n\nUn ami lance l\u2019assaut. Vous encha\u00eenez avec votre ultime. \nLa tourelle tombe et la victoire se rapproche. \nDans Reign of Heroes, le plaisir du MOBA prend vie sur un champ de bataille cartoon, juste devant vous, en r\u00e9alit\u00e9 virtuelle.\n\nFAITES \u00c9QUIPE OU D\u00c9FIEZ VOS AMIS\nJouez chacun votre h\u00e9ros dans des \u00e9quipes de 6. Affrontez d\u2019autres joueurs ou unissez vos forces contre l\u2019IA. Pas besoin de r\u00e9unir 12 personnes : deux joueurs suffisent en multijoueur et l\u2019IA compl\u00e8te les \u00e9quipes. Un mode solo permet aussi de s\u2019entra\u00eener.\n\nD\u00c9CHA\u00ceNEZ VOS POUVOIRS\nFlammes, glace, fl\u00e8ches ou attaques au corps \u00e0 corps : trouvez votre style parmi 15 h\u00e9ros. Combinez vos sorts, gagnez des niveaux pendant la partie et placez l\u2019ultime qui renverse le combat. Avancez avec vos sbires, d\u00e9truisez les tourelles et faites tomber la base ennemie.\n\nESSAYEZ. TROUVEZ VOS FAVORIS. GARDEZ-LES.\n4 h\u00e9ros sont jouables gratuitement chaque semaine gr\u00e2ce \u00e0 la rotation. Un coup de c\u0153ur ? Achetez ce h\u00e9ros pour le d\u00e9bloquer d\u00e9finitivement et le retrouver \u00e0 chaque partie.\n\nENVIE DE TOUT EXPLORER ?\nLe Pack des 15 h\u00e9ros d\u00e9bloque toute la collection actuelle en un achat. Changez de r\u00f4le, d\u00e9couvrez de nouveaux pouvoirs et choisissez le h\u00e9ros qui compl\u00e8te votre \u00e9quipe. Les futurs h\u00e9ros ne sont pas inclus.\n\nInvitez vos amis. Choisissez votre h\u00e9ros. Lancez la bataille !\n\nJeu en fran\u00e7ais et en anglais.", "short_description": "R\u00e9unissez vos amis, choisissez votre h\u00e9ros et faites trembler le plateau ! Plongez dans un MOBA tabletop en VR : combats en 6 contre 6, pouvoirs \u00e0 combiner et ultimes \u00e0 d\u00e9cha\u00eener. D\u00e9couvrez 4 h\u00e9ros gratuits chaque semaine, d\u00e9bloquez vos favoris ou choisissez le Pack des 15 h\u00e9ros pour varier les plaisirs."}]}, "developer_name": "XFX", "developer_privacy_policy_url": "https://projectsvr.net/roh_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stephane Quillet", "support_website_url": null, "website_url": "https://projectsvr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1483826964807579"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622153_1443556740438267_7831734796757283588_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI8A2O3xIz0Q7kNvwF_xjcq&_nc_oc=Ado9oWPiU3d5_VIzUQ5U3OWTlnTIDbVWF5HndvMEn-N572UmRy4zlUDHXwYAeZZmyPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00
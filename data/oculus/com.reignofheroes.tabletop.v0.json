n.png", "id": "1863403174675981", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628411_1863403178009314_3437405261041658287_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Du-cpaoYgx0Q7kNvwESE46F&_nc_oc=AdoXLWw-uwXuihnXJIsrojoep3PuuOx3fzqpMqHKGb1txAvWDqUlmEfqunSdJ9hDoAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTeV4vHmvn_HSSseFMV__eQ3mCc5-_rGMr3u7dz6lH_w&oe=6B1046B1"}, {"file_name": "03-magic-lane.png", "id": "1666483035009939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/783433199_1666483038343272_4281443150302620187_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVJOS-COqQIQ7kNvwHoPnkC&_nc_oc=AdrsOY55L9Gt8DsIr-TF6KqEtoKKMDqwaFXoX-AJ4JKnB6O_YF_E9f4W0BTqqTU1OoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlSfOeUmMA3Km1WsYqjPu7AexqH2mkefMNeeVmOc7j1A&oe=6B1067E4"}, {"file_name": "04-melee-river.png", "id": "1124000320010716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623111_1124000323344049_5853169462391860240_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8plX3aqlHWkQ7kNvwEST5LN&_nc_oc=AdpW7lPgMagolPvC0vxT9O32SpmFBQ0Zug43ylB5pcGrRChtuGyg0TnQfyA80uzh_jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVqqe-msxHbcXPxtkZHks361lRVxgW7Y6j4qZIDM5m9UA&oe=6B105E0E"}, {"file_name": "05-tower-lane.png", "id": "1486875300054450", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620532_1486875306721116_5930597047541358316_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFKteLjUsN0Q7kNvwHwmHqo&_nc_oc=Adq4PaY9nWALtMxJGKn8ef2jEWiHE6jYlrwa2CC1y6TraXH8k3VsQzuQ8D5q1fLl2Ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUE1U7fe_dV61v4cizmv5O5hTVsSKJCDKIyusxGADworA&oe=6B1059E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reign of Heroes - TABLETOP MOBA VR", "keywords": [], "long_description": "YOUR FRIENDS. YOUR HEROES. EPIC BATTLES.\n\nYour friend charges in. You follow up with your ultimate. A tower falls and victory is within reach. Reign of Heroes brings the thrill of a MOBA to a colorful cartoon battlefield, right in front of you in virtual reality.\n\nTEAM UP OR CHALLENGE YOUR FRIENDS\nEach player controls a hero in teams of 6. Face other players or join forces against AI. You don\u2019t need a full group of 12: start multiplayer with just two players and let AI heroes fill the remaining slots. Practice solo against AI, too.\n\nUNLEASH YOUR POWERS\nFire, ice, arrows or close-range attacks: find your playstyle among 15 heroes. Combine abilities, level up during each match and land the ultimate that turns the fight. Push with your minions, bring down towers and destroy the enemy base.\n\nTRY THEM. FIND YOUR FAVORITES. KEEP THEM.\nA rotation of 4 heroes is free to play each week. Found your favorite? Purchase that hero to unlock them permanently and play them whenever you want.\n\nWANT TO EXPLORE EVERY PLAYSTYLE?\nThe 15-Hero Pack unlocks the entire current roster in one purchase. Switch roles, discover new powers and pick the hero that complements your team. Future heroes are not included.\n\nBring your friends. Pick your hero. Start the battle!\n\nPlayable in English and French.", "short_description": "Bring your friends, pick your hero and shake up the battlefield! Jump into a tabletop VR MOBA with 6v6 battles, powers to combine and ultimates to unleash. Discover 4 free heroes each week, permanently unlock your favorites or explore the full current roster with the 15-Hero Pack."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1706487287817546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628436_1706487291150879_7763404142005837608_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy0URkAggoUQ7kNvwEZas5S&_nc_oc=Adq4MpfseJdBe-SoOZ5eHnMCUW
qTU1OoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlSfOeUmMA3Km1WsYqjPu7AexqH2mkefMNeeVmOc7j1A&oe=6B1067E4"}, {"file_name": "04-melee-river.png", "id": "1124000320010716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623111_1124000323344049_5853169462391860240_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8plX3aqlHWkQ7kNvwEST5LN&_nc_oc=AdpW7lPgMagolPvC0vxT9O32SpmFBQ0Zug43ylB5pcGrRChtuGyg0TnQfyA80uzh_jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVqqe-msxHbcXPxtkZHks361lRVxgW7Y6j4qZIDM5m9UA&oe=6B105E0E"}, {"file_name": "05-tower-lane.png", "id": "1486875300054450", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620532_1486875306721116_5930597047541358316_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFKteLjUsN0Q7kNvwHwmHqo&_nc_oc=Adq4PaY9nWALtMxJGKn8ef2jEWiHE6jYlrwa2CC1y6TraXH8k3VsQzuQ8D5q1fLl2Ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUE1U7fe_dV61v4cizmv5O5hTVsSKJCDKIyusxGADworA&oe=6B1059E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499628893_1904623297576485_330286441389635127_n (1).png", "id": "3504967179804622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908887020_3504967183137955_2895120365982784464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AsDAqgmWZEQ7kNvwFQGWOX&_nc_oc=AdpnJopwBeasMXnjQMtgOtPgIjMGyfZ8xBfg3IaRwxqvwSDGsTcOKOO11qn6dgiFKGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXkbJHJZf8Y949XWfiqHJWDnfzOJ6lkoxO9D7Lc0tMiVw&oe=6B105ADB"}, "display_name": "Reign of Heroes : Tabletop MOBA", "keywords": [], "long_description": "YOUR FRIENDS. YOUR HEROES. EPIC BATTLES.\n\nYour friend charges in. You follow up with your ultimate. A tower falls and victory is within reach. Reign of Heroes brings the thrill of a MOBA to a colorful cartoon battlefield, right in front of you in virtual reality.\n\nTEAM UP OR CHALLENGE YOUR FRIENDS\nEach player controls a hero in teams of 6. Face other players or join forces against AI. You don\u2019t need a full group of 12: start multiplayer with just two players and let AI heroes fill the remaining slots. Practice solo against AI, too.\n\nUNLEASH YOUR POWERS\nFire, ice, arrows or close-range attacks: find your playstyle among 15 heroes. Combine abilities, level up during each match and land the ultimate that turns the fight. Push with your minions, bring down towers and destroy the enemy base.\n\nTRY THEM. FIND YOUR FAVORITES. KEEP THEM.\nA rotation of 4 heroes is free to play each week. Found your favorite? Purchase that hero to unlock them permanently and play them whenever you want.\n\nWANT TO EXPLORE EVERY PLAYSTYLE?\nThe 15-Hero Pack unlocks the entire current roster in one purchase. Switch roles, discover new powers and pick the hero that complements your team. Future heroes are not included.\n\nBring your friends. Pick your hero. Start the battle!\n\nPlayable in English and French.", "short_description": "Bring your friends, pick your hero and shake up the battlefield! Jump into a tabletop VR MOBA with 6v6 battles, powers to combine and ultimates to unleash. Discover 4 free heroes each week, permanently unlock your favorites or explore the full current roster with the 15-Hero Pack."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1706487287817546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628436_1706487291150879_7763404142005837608_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy0URkAggoUQ7kNvwEZas5S&_nc_oc=Adq4MpfseJdBe-SoOZ5eHnMCUWslrlELsqXGse4V4ZnxvoPQD8Tqmlll0Iqc6oSbeOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5S3t5xqLPJSPMoK-2ls5JYoquJlvunf2x1gWIZK3cbQ&oe=6B103B43"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1473974914874097", "image_type": "APP_IMG_COVER_SQUARE",
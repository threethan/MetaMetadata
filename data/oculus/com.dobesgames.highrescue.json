cae4r0Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGx0jJepk5T1wRZPlT4Fmmt4OmPDmJPmBTYzTGK_HHpQ&oe=6AFF30E2"}, {"file_name": "5.png", "id": "202071012569172", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001675_202071015902505_6130434384487279671_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LR4vH3ElAIQ7kNvwEirPAl&_nc_oc=AdrfswvemLoE08UBJQoMJnRIKA82pr1zu4c5Td7Yu0RmMe-g1pcFYXaubvwE7aNXlYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHhkA5sxfwZD6yfw_ljv8DgqBjs5dceciuFIXd1bj88Q&oe=6AFF092C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmY-PeKhxi8Q7kNvwGknDjn&_nc_oc=AdpcymnbfDPNL9InVB9xO27zJMvCMzaqoK0-Km4m8ivxCU_pGzzr1iJpl1iMs-24L3o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrLNFg6f5ALjlGpSu4KVajhweJJFvJFRoWOaICWN3MQA&oe=6AFF2DAF"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer
0YbY1-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCnJ4Qqr1iSmLS8cr5v7dejxF0xoGW6gr0UHdrZqfM4w&oe=6B0F02E2"}, {"file_name": "5.png", "id": "202071012569172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_202071015902505_6130434384487279671_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pePA-JrBmwcQ7kNvwHAPKw4&_nc_oc=AdoT8AXKTUdrneFKPObU7CNmbdd7g_CNi3fojBzcz2C2AMQRXJETUo6UkbcpprrRbMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6pe5CBK6t-nWkVArav7H-_lZFrnbXLkAPWvNO51K6Kg&oe=6B0F136C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgUI7CdD53UQ7kNvwEWxtTH&_nc_oc=Adp85zgOsKBVvVVYvHVB0XMNBDpQKdRPXwzoDACQEDRgfTGVp4ZyuRoriRITOlFO7rE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcpH6blI7fnFLa5iPlrE1TbsibI77m2C6sLJpgxAAWZA&oe=6B0EFFAF"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer
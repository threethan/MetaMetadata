7&_nc_sid=6e7a0a&_nc_ohc=2UaH1u6g0qkQ7kNvwEHwc4n&_nc_oc=Adr3r03Sq2MZaRcadEiqNBvNNXVRktPnvey1wtDECpbr60_y8c3u6k2CEDTtVkoctTg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RFCeTB9Aj8jy5dXKMdCV6YHu1mTPE9eT12iO4GFT8Eg&oe=6A2AC7AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMLqkjUU3MoQ7kNvwEh3OZA&_nc_oc=AdpgO7bapHmkRM25E9e_nSlshV57kmWVXY59IU0X_aBa3OLJd2IedlJy5Vie2sp_NN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8krxV7vfw0gNSdaWxDr_P31Z_qeMUUX2jU64yrXDDWNA&oe=6A2AB3EF"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://highlewelt.com/privacy_highrescue.html", "developer_terms_of_service_url": null, "publisher_name": "highlewelt GmbH", "support_website_url": null, "website_url": "https://highlewelt.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
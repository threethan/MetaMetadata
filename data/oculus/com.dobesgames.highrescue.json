NIR6mng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-c251Au1k1bfvqJ2pXp7Kp6PY0DU1UBWVZ28Gxqu2XQ&oe=6B008262"}, {"file_name": "5.png", "id": "202071012569172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_202071015902505_6130434384487279671_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvngzeZSDmcQ7kNvwElavAx&_nc_oc=AdpTercsgdy2JmL-dvyRMrQCkgbo3PA8pJP9NMHdsWahFjwXYKUVmI2eS5U5kJH2cws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB8oOLowRji8ozu_kAIAft0NmehwJBmo07uuPiYFB4vQ&oe=6B005AAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmY-PeKhxi8Q7kNvwHEruMP&_nc_oc=Adq11hoPxi7ef5SF7sB-RYSeRhCRqo0kAkRZkOlR2Ns8yF5vjZk76iKuWY6CGy0wj5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpXA0k8J5S1X0_FgJvbbVTKkGPuv5ER_UbOuS-xF9Ydg&oe=6B007F2F"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbAWcr50ZxIQ7kNvwH3m4s_&_nc_oc=Ado1nsq4ldKY24HvpuGk-nbid2_SHFs9mFD9xC7ogig4MimEr7-wNacQY8yOwkE9TcI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfDT13SXXSCg7oZAbVGlkvOAnG-RV7BdHh5H1Nq0bB3w&oe=6AAE9DAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9KmGEtppV8Q7kNvwGVmzM-&_nc_oc=Ado9RyMK6NV4pcCXHgUS41pxDtZ2QKFi6I0DbmLp1M6Hfl0roAhSvGHm6CBL-N2nxuY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP3VvnN6wKyxqVdPF8UK9eqZB5jfqtXcJenxicQy0ftQ&oe=6AAE89EF"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://highlewelt.com/privacy_highrescue.html", "developer_terms_of_service_url": null, "publisher_name": "highlewelt GmbH", "support_website_url": null, "website_url": "https://highlewelt.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534"
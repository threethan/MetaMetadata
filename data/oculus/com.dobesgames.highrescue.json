_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ky7dvAimBxwQ7kNvwGK_Hx2&_nc_oc=AdqfdW72h2sO9owcwSn5hltS6EnDyNe0RIOy21aXGEmZv6jhuQUI5w_-MgZgDS2vP3w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjdFCWvpnlHqnhiJyA-2VVQMWcjf20ca8nsRkWmdCtKQ&oe=6A8D6FEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7zof3SPcCsQ7kNvwG0N7O0&_nc_oc=AdocVwyV-P0MyalpIh4g8pollfo-ejoV9UM7CNa5UaShTkk9kbrddsCFVeM9-G_Taw4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG44tWPh7_5VBmPSp7fP7hPhoUPbrXT3dCFbPcjgkrSRg&oe=6A8D946F"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://highlewelt.com/privacy_highrescue.html", "developer_terms_of_service_url": null, "publisher_name": "highlewelt GmbH", "support_website_url": null, "website_url": "https://highlewelt.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "274
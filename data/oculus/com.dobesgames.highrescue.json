p2LdEjk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5HmeAAKlmdK0TRTKx4q8ZfF__j2JylfGp4zovPuPkLw&oe=6AFB3C62"}, {"file_name": "5.png", "id": "202071012569172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001675_202071015902505_6130434384487279671_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21cxXks40MUQ7kNvwFO1Cid&_nc_oc=Adqg0YCNPEcQJrrXXbIHn5UFYtO-55WNjZsxAScdEj2yLN0Hnq1Oe3Ne7hkCGPOna-I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKXXKE_qctJK2DUxNsA9dxkRK2LZTwEDgt3YA5n-9aFQ&oe=6AFB14AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7975A_oDAbQQ7kNvwFDVPYV&_nc_oc=AdqNKYXDX4-PaLMNjn8_xSyuuv3qtXgv1buYLMUxvwQqPZx-XiYNGM5anuYvW1s44hY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrjr2yI9QJhu8UF3g1sw3x8SMj5nSs6RfVPn4W_YhDJA&oe=6AFB392F"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer
GbKOw5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Vw3s3Y26egIWIIDGBWvxrIWLUnK0IHYxoPX6jjfuMQ&oe=6AFDDF62"}, {"file_name": "5.png", "id": "202071012569172", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001675_202071015902505_6130434384487279671_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LR4vH3ElAIQ7kNvwF1hsSl&_nc_oc=AdqvzDypDzmlw9wyGtEDB4aYNN80IA7VYd7PlMiCMq6aFNsmUiU2VnDW5qgQRkbKlZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAHCchmk2wWw_lUWPsahRiNLnCl03VVflaiLxE75zjmw&oe=6AFDB7AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7975A_oDAbQQ7kNvwFjnI9D&_nc_oc=Ado8mkycsV0JYtK7OGA3J3UXig5cqZ9u0udTZaFS0xDB-tzpssEkymeEXqZfjH8pV6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi39MOBl1Yl8wK5ckKMihGLsE_uD3PZ7FIASuWwM2q2Q&oe=6AFDDC2F"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer
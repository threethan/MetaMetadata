7&_nc_sid=6e7a0a&_nc_ohc=qPzVov8Cim8Q7kNvwFY_mzV&_nc_oc=AdrRwlKM1DLrsq_Gg-QvW2Z7LvBPdFxqS0pL35KEKZeGMEOl7wqtnpSMcK327hnsxdI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D3ybPwlOJC9rh9rx-xyvhNgEypXKfoFxzQQrAt4yJnA&oe=6A218D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16Qo603U3jgQ7kNvwFSZbkW&_nc_oc=Adoa6mV78Rjz39NV8uow9EL5xu51YjhP1k2N5WoMGmPPjaCBykiRJN-U9Yk6uQaRcGQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3-6ETI7NCKL-YhJuH7dBNhNSDB9K6QxNouqOB_TMVLw&oe=6A21796F"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://highlewelt.com/privacy_highrescue.html", "developer_terms_of_service_url": null, "publisher_name": "highlewelt GmbH", "support_website_url": null, "website_url": "https://highlewelt.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
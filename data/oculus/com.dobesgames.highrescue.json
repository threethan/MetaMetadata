7&_nc_sid=6e7a0a&_nc_ohc=YpmW9fNPSJsQ7kNvwEle277&_nc_oc=AdrCSNcBgJ-fBuuQZvppb0FwWwNE9tZ0wAKITa0Rp4sLaQK-cApbGG7ajxPcvOVt8u8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BwYnjLt0Aj6gefb5Pgx91_LrKxLvKXDuK-7x3pMbYuA&oe=69E8DCAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "957698088745851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_957698092079184_7037937944838343346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiL6RMToQS8Q7kNvwHT4mzI&_nc_oc=AdpGDRvEFTgwyCqYJFtyTdEgrUBcSGH6QOWUjGZsZytn00L8Vvwf-dLuw6HkkKin3uc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vIQMpu0S8Fi-Vm2vM8ljQ0iDWkj4o-ht1IatdLzTx1A&oe=69E8C8EF"}, "display_name": "highrescue", "keywords": [], "long_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n\nTo achieve the best results, we recommend starting with the training level.  \n\nEach mission always starts with different initial conditions. The position of the astronauts in space varies. The supply of oxygen can also be different. Therefore, keep calm and get an overview of the situation first.  First supply the astronauts who need it most with oxygen. Save the astronauts with the highest priority who have the least oxygen left. \n\nAlso pay attention to your health and the energy level of your jet stream. Good luck on your adventures. ", "short_description": "\"highrescue\" is a virtual reality game in which you can prove your skills as an astronaut rescuer in 4 different levels. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://highlewelt.com/privacy_highrescue.html", "developer_terms_of_service_url": null, "publisher_name": "highlewelt GmbH", "support_website_url": null, "website_url": "https://highlewelt.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
176", "locale": "en_US", "screenshots": [{"file_name": "Untitled design (24).png", "id": "718818230859621", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822808_718818234192954_1142510036114401739_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdKHawIr4HkQ7kNvwEQPHp_&_nc_oc=Adq3rHO_V4VM8nfhHQXFBolKVqHmn5Uc9KL0CQmotNmQU9NS0st67djfjqOQYdoZRqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QcdLeGDy684zds4LcIwKXtra1NJaz3BIchtbhlT0GPA&oe=6A2EC8B8"}, {"file_name": "Untitled design (26).png", "id": "709870325145757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818943_709870328479090_5586985217871597277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O0LBw0xKqEQ7kNvwFG4J8D&_nc_oc=AdpijvlT4Mk5pN8SzsLaIafd2OJMzrOjSIB0OUFzUEGWEF_q6afU3AOk-UUd3jvbc1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YE7VFZ5hB_Sk1b7Tz1lZqr3t-64P2mhr2j-ddOvk5WQ&oe=6A2EBD7E"}, {"file_name": "Untitled design (25).png", "id": "1083786329841802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820619_1083786333175135_8252295555421765945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4sDzJSYIGQQ7kNvwEcltJD&_nc_oc=AdrM_eHrZD6QIgemWMjS4dQiyZ3wRxZvF2LTUww0gQP5CmyN-Mtw9ZKZJHCay_4Ryxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CMwau1hem4ATSpe5pa7NQ4j1aIcScwNpemEIkFfhsKw&oe=6A2ED4CD"}, {"file_name": "Untitled design (27).png", "id": "727053993281284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820652_727053996614617_5617461802732070744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihab319V5eAQ7kNvwHoOFIS&_nc_oc=AdrW0MP6cbDctsN4DZKsX9KqgvKbVycS0gjj1la8pi72o3av1JD2UJdjr1Ig6OnCqPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9siTkOOyMtYHE6MZ7vtPQpXZxzt9dMU-wgcmHqEllQTg&oe=6A2EA696"}, {"file_name": "Untitled design (28).png", "id": "766578155847247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822495_766578159180580_5026253048970441725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j_NgveZuU4Q7kNvwEnbMcX&_nc_oc=Adqk7wZAIuUGb3Yoz04ck1U7GNSCe1BLmJCY4qL0HgnKOHqUy_P4HDE3H7gBzfQ0bkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WEFm5w5ClOs31UTu7pGbWy4joBpw0wfnMRP3OMnb5Sg&oe=6A2EB516"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Uproar", "keywords": ["Monke", "Gorilla", "Horror", "Uproar", "Up"], "long_description": "Uproar is a scary yet fun horror experience that combines the intensity of classic survival horror with the fast, playful movement of Gorilla Tag\u2013style gameplay. Built around a pixelated PS1-era aesthetic, the game embraces low-resolution textures, crunchy sound design, and eerie lighting that perfectly captures the unsettling vibe of retro horror while keeping the action fresh and exciting.\n\nPlayers move through a variety of creepy, atmospheric levels using freeform climbing, swinging, and wall-bouncing mechanics, giving a unique sense of speed and freedom rarely seen in horror games. While the world feels dark, broken, and haunted, the movement makes exploration feel fun and engaging, balancing fear with adrenaline.\n\nBetween terrifying encounters, players can relax in a fully stocked in-game shop where they can customize their character with cosmetics, making each run feel personal and giving a lighter, playful contrast to the chilling environments.\n\nWith its blend of retro horror visuals, fluid VR-inspired movement, and both scary and enjoyable moments, Dead Signal stands out as a horror game that doesn\u2019t just try to scare you\u2014it makes sure you\u2019re having a good time while it does.", "short_description": "Upraor is a Scary, fun, and overall enjoyable horror game. This game uses Gorilla tag style movement and style.  There are many levels and a nice shop to customize yourself in game. "}]}, "developer_name": "Monkefinn", "developer_privacy_policy_url": "https://sites.google.com/view/uproarofficial/policies", "developer_terms_of_service_url": null, "publisher_name": "Monkefinn", "support_website_url": null, "website_url": "https://sites.google.com/view/uproarofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26546180475070368"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2165691227274516"}]}, "baseline_offer": {"id": "2165691227274516"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780194660, "status": "PUBLISHED", "id": "2165691227274516"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27341902365498171", "version": "0.31"}, "id": "1695637614410388", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24045906161764491", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27341902365498171"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781061828, "id": "27380596098295464", "version": "0.38", "version_code": 158, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"node
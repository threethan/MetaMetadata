6176", "locale": "en_US", "screenshots": [{"file_name": "Untitled design (24).png", "id": "718818230859621", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822808_718818234192954_1142510036114401739_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdZSXNn3FPIQ7kNvwFNpG5n&_nc_oc=AdqCckTISqq0gpU7xx6QrOC8YRmeN2_2tzIM8jT3TjotrfOpZvpYHVbgX8RkoOhKjh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dSUIMh14y8TNLBoEDcqGxqFJXmkucC_ynp2TY68qRNQ&oe=6A3BF7B8"}, {"file_name": "Untitled design (26).png", "id": "709870325145757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818943_709870328479090_5586985217871597277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0gLhtNQMiUQ7kNvwGw9_Ro&_nc_oc=AdpUHy7elCZeAV1eyJCMRvH179hKaGPbQq5w3DeUV2PqKolCMFMyMUDUOLUfAfjwOjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wzSTlx_bbTRcLNZJln3YLe3qGRl4Wliu3gQNTEwb0HA&oe=6A3BEC7E"}, {"file_name": "Untitled design (25).png", "id": "1083786329841802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820619_1083786333175135_8252295555421765945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbXDQSmmEj0Q7kNvwFDIf_f&_nc_oc=AdoeRkB0xZIWcQsKVNQ01aPKT1Or6e3Bc18gXqTuWpBLadoDzOciwqjeioy5Wh1qIu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i0dbch2hjlfOJUNZfNrK6Pljy77s-ciG7RNiNOl2acQ&oe=6A3C03CD"}, {"file_name": "Untitled design (27).png", "id": "727053993281284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820652_727053996614617_5617461802732070744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5qJMT2TlvYQ7kNvwF0MQ6L&_nc_oc=AdrbprMTdtFF_mC2DyPu_3xQOne0bUjPi_t5hGPFurAGCu1IeAmtxz56PR6xasDRHLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kXCqbHKpKFDAE-wnziS1T7jCW01FT_NKcQHnjSeifiw&oe=6A3BD596"}, {"file_name": "Untitled design (28).png", "id": "766578155847247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822495_766578159180580_5026253048970441725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UtHrSX4IgUQ7kNvwE5qwBT&_nc_oc=AdqAHkIHL-whXjYO6XYPFbMdM4-Fu_WibeCF6eY3I-zFbnBMm6YEsseGpbOIONQzeQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8kqoTPVw3T9dhFIqroOEA5cMvo7ah-GMR1DGpLZcWXw&oe=6A3BE416"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Uproar", "keywords": ["Monke", "Gorilla", "Horror", "Uproar", "Up"], "long_description": "Uproar is a scary yet fun horror experience that combines the intensity of classic survival horror with the fast, playful movement of Gorilla Tag\u2013style gameplay. Built around a pixelated PS1-era aesthetic, the game embraces low-resolution textures, crunchy sound design, and eerie lighting that perfectly captures the unsettling vibe of retro horror while keeping the action fresh and exciting.\n\nPlayers move through a variety of creepy, atmospheric levels using freeform climbing, swinging, and wall-bouncing mechanics, giving a unique sense of speed and freedom rarely seen in horror games. While the world feels dark, broken, and haunted, the movement makes exploration feel fun and engaging, balancing fear with adrenaline.\n\nBetween terrifying encounters, players can relax in a fully stocked in-game shop where they can customize their character with cosmetics, making each run feel personal and giving a lighter, playful contrast to the chilling environments.\n\nWith its blend of retro horror visuals, fluid VR-inspired movement, and both scary and enjoyable moments, Dead Signal stands out as a horror game that doesn\u2019t just try to scare you\u2014it makes sure you\u2019re having a good time while it does.", "short_description": "Upraor is a Scary, fun, and overall enjoyable horror game. This game uses Gorilla tag style movement and style.  There are many levels and a nice shop to customize yourself in game. "}]}, "developer_name": "Monkefinn", "developer_privacy_policy_url": "https://sites.google.com/view/uproarofficial/policies", "developer_terms_of_service_url": null, "publisher_name": "Monkefinn", "support_website_url": null, "website_url": "https://sites.google.com/view/uproarofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26546180475070368"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2165691227274516"}]}, "baseline_offer": {"id": "2165691227274516"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780194660, "status": "PUBLISHED", "id": "2165691227274516"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27516254788062927", "version": "0.60"}, "id": "1695637614410388", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24045906161764491", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27516254788062927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1695637614410388"}]}, "change_log": null, "created_date": 1781923874, "id": "27516254788062927", "version": "0.60", "version_code": 192, "release_status": "RELEASE
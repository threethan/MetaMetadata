LDIQl21-_H1VyLkgz52KxoUxhkSezd1Jf8QqZICUwx4v2-tK6FzLHUZeYNX8DpE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTun08o7opVWBeT5VU2LVopNyt6xk3eQAm8cLXa8B5R6A&oe=6AFB1939"}, {"file_name": "1000008436.png", "id": "2240214070130642", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499313074_2240214073463975_5258950669039752862_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLCEtmLJVJkQ7kNvwGqTVCX&_nc_oc=Adp8mDk9SMEV1vr2PCKC6wwZNBvMYN5BtB2EE0iZxHyME6WiVBM8lYqe5Yi_WCocH48&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaLAhwcewMx0YfW9u_IHY1jn6UyZhCcgH_MW_7M2b2jg&oe=6AFB3480"}, {"file_name": "1000008432.png", "id": "1716944946124819", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312310_1716944949458152_256444867735582311_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVTaLqgBnVQQ7kNvwH6ihqZ&_nc_oc=AdrUJw5bjxxCxQPq_1-AfJnZOpag-wxsSYmwntXXMPOZLSHLFEU1BEQnyhlaZcyXy-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAlpnRj8XG0KtVDzJssuRXX6XpptnH-nuf1BLzGV-VeQ&oe=6AFB2E57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Uproar", "keywords": ["Monke", "Gorilla", "Horror", "Uproar", "Up"], "long_description": "Uproar is a scary yet fun horror experience that combines the intensity of classic survival horror with the fast, playful movement of Gorilla Tag\u2013style gameplay. Built around a pixelated PS1-era aesthetic, the game embraces low-resolution textures, crunchy sound design, and eerie lighting that perfectly captures the unsettling vibe of retro horror while keeping the action fresh and exciting.\n\nPlayers move through a variety of creepy, atmospheric levels using freeform climbing, swinging, and wall-bouncing mechanics, giving a unique sense of speed and freedom rarely seen in horror games. While the world feels dark, broken, and haunted, the movement makes exploration feel fun and engaging, balancing fear with adrenaline.\n\nBetween terrifying encounters, players can relax in a fully stocked in-game shop where they can customize their character with cosmetics, making each run feel personal and giving a lighter, playful contrast to the chilling environments.\n\nWith its blend of retro horror visuals, fluid VR-inspired movement, and both scary and enjoyable moments, Dead Signal stands out as a horror game that doesn\u2019t just try to scare you\u2014it makes sure you\u2019re having a good time while it does.", "short_description": "Uproar is a Scary, fun, and overall enjoyable horror game. This game uses Gorilla tag style movement and style.  There are many levels and a nice shop to customize yourself in game.   \n"}]}, "developer_name": "Monkefinn", "developer_privacy_policy_url": "https://sites.google.com/view/uproarofficial/policies", "developer_terms_of_service_url": null, "publisher_name": "Monkefinn", "support_website_url": null, "website_url": "https://sites.google.com/view/uproarofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27720011121020625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298502_1475426891039568_5599351887650471167_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_
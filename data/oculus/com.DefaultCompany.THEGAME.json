6176", "locale": "en_US", "screenshots": [{"file_name": "Untitled design (24).png", "id": "718818230859621", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822808_718818234192954_1142510036114401739_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ipw0Vn4MgXYQ7kNvwET2rRY&_nc_oc=AdoGTMt70_nVzhV4tw06biKBNTW-FafFj_zdMp6XvPRJ0_f5IPzDKFy0HW3ULB33bjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hep8uk_RVMXEoCWh_0xFtLJD4VyGZOX1c3hjrX-0j4w&oe=6A380338"}, {"file_name": "Untitled design (26).png", "id": "709870325145757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818943_709870328479090_5586985217871597277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNJ3h5e97RoQ7kNvwHWzccA&_nc_oc=AdqPTQEZ_cS7ciIfmK84SV_y04PQsCJWr-il_7p3poO7PxsXx_em_Ygk2XtO6mGf1EY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BWBexVqbShH4ArSNAoUknxq3H7-1eXlAz_SVlrOHCfw&oe=6A37F7FE"}, {"file_name": "Untitled design (25).png", "id": "1083786329841802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820619_1083786333175135_8252295555421765945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkDbpltyzp8Q7kNvwGfoKt4&_nc_oc=AdpXm9hq00flHbRk1nXiNrSPYGjUx2les2AEPgRPKpjMEh4o3FBTUuZaT_U5SPOBv1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cgLxrBZoz1I1AWH9c3sdI-NajxjCzQEYxvl6pOmO6TQ&oe=6A380F4D"}, {"file_name": "Untitled design (27).png", "id": "727053993281284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820652_727053996614617_5617461802732070744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4QX2QaDZHEQ7kNvwFxCsIQ&_nc_oc=AdppTTBblNpqPJv9sgkZCA_7GZ45itjfGIQtTkHgaxPdE-aSjfLXRvrtpLT6Euv-QX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WfjEAUCQiUdUy4RkxOXAJRKEnvNW1wLWuFtMNdL_t3A&oe=6A37E116"}, {"file_name": "Untitled design (28).png", "id": "766578155847247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822495_766578159180580_5026253048970441725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfYzu0EezugQ7kNvwHRC0cr&_nc_oc=Adr20wz3rjhpxemgA2W47IdS708JfhXpSF2Hr8vhChbkFHnwSTpjIpQFxCkjdI1OEBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-segUZyfHzWfKXQls0nxv_74ux1JWNftiX3jSEjgLGwg&oe=6A37EF96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Uproar", "keywords": ["Monke", "Gorilla", "Horror", "Uproar", "Up"], "long_description": "Uproar is a scary yet fun horror experience that combines the intensity of classic survival horror with the fast, playful movement of Gorilla Tag\u2013style gameplay. Built around a pixelated PS1-era aesthetic, the game embraces low-resolution textures, crunchy sound design, and eerie lighting that perfectly captures the unsettling vibe of retro horror while keeping the action fresh and exciting.\n\nPlayers move through a variety of creepy, atmospheric levels using freeform climbing, swinging, and wall-bouncing mechanics, giving a unique sense of speed and freedom rarely seen in horror games. While the world feels dark, broken, and haunted, the movement makes exploration feel fun and engaging, balancing fear with adrenaline.\n\nBetween terrifying encounters, players can relax in a fully stocked in-game shop where they can customize their character with cosmetics, making each run feel personal and giving a lighter, playful contrast to the chilling environments.\n\nWith its blend of retro horror visuals, fluid VR-inspired movement, and both scary and enjoyable moments, Dead Signal stands out as a horror game that doesn\u2019t just try to scare you\u2014it makes sure you\u2019re having a good time while it does.", "short_description": "Upraor is a Scary, fun, and overall enjoyable horror game. This game uses Gorilla tag style movement and style.  There are many levels and a nice shop to customize yourself in game. "}]}, "developer_name": "Monkefinn", "developer_privacy_policy_url": "https://sites.google.com/view/uproarofficial/policies", "developer_terms_of_service_url": null, "publisher_name": "Monkefinn", "support_website_url": null, "website_url": "https://sites.google.com/view/uproarofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26546180475070368"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2165691227274516"}]}, "baseline_offer": {"id": "2165691227274516"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780194660, "status": "PUBLISHED", "id": "2165691227274516"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27421586907529716", "version": "0.43"}, "id": "1695637614410388", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24045906161764491", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27421586907529716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781666653, "id": "27475709985450741", "version": "0.49", "version_code": 170, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nod
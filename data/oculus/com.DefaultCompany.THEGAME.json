6176", "locale": "en_US", "screenshots": [{"file_name": "Untitled design (24).png", "id": "718818230859621", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822808_718818234192954_1142510036114401739_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdZSXNn3FPIQ7kNvwFM5XD4&_nc_oc=AdrlPUImVU5enWWBxltN05Fo7Eitb1cvH_zBCgneY0kzO0lu0jDsiXcsQtLSgzEeZHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sYNwrnveTYkwlThmpQqnRQYfcr5DLi7KahUG1JyYmxA&oe=6A3AA638"}, {"file_name": "Untitled design (26).png", "id": "709870325145757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818943_709870328479090_5586985217871597277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNJ3h5e97RoQ7kNvwERKZi2&_nc_oc=AdrubE0OTRjSwle1sj7UE1WkVG0brnRbdJJQuYNORToJU0aqxinJgoOQ9h6tctpm3GA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_taNLyekMRRrPZmGHsCjoezOAeB1VR59z2_OigKiUGrg&oe=6A3A9AFE"}, {"file_name": "Untitled design (25).png", "id": "1083786329841802", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820619_1083786333175135_8252295555421765945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkDbpltyzp8Q7kNvwGDrHCX&_nc_oc=Adof1B9ge8F8sFAbjQmbDTvifvISD0y4KCRlH8_bAY0cHjln2yUIfWf17UVm3tUvkKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qEYxOruAvg0R9uYvpARm56mZBNe0rwIMi56Cb_JEa3w&oe=6A3AB24D"}, {"file_name": "Untitled design (27).png", "id": "727053993281284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820652_727053996614617_5617461802732070744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5qJMT2TlvYQ7kNvwGqq7c8&_nc_oc=AdpgSGdvi1g8mQ8iIh4g4CeL3aD7CNt-Fq-wQg7edC3636-HK4GnwlolBFQkRhwIO7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TncM1PwuE_ii6Y4lBMXRNhM78g9uvEoK34MyKaOXw_w&oe=6A3A8416"}, {"file_name": "Untitled design (28).png", "id": "766578155847247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822495_766578159180580_5026253048970441725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UtHrSX4IgUQ7kNvwHpHYT4&_nc_oc=Adp4zuwQ9zB_kpy2fSvAPc5_OnYLQT7tiyW8E01BCyO6956rE6E4PqIJFAJm5EBQ9UI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l2w9tm-g7OqHBqZRz578u1aJ7CRRLJ2iH3P18D7O_mg&oe=6A3A9296"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Uproar", "keywords": ["Monke", "Gorilla", "Horror", "Uproar", "Up"], "long_description": "Uproar is a scary yet fun horror experience that combines the intensity of classic survival horror with the fast, playful movement of Gorilla Tag\u2013style gameplay. Built around a pixelated PS1-era aesthetic, the game embraces low-resolution textures, crunchy sound design, and eerie lighting that perfectly captures the unsettling vibe of retro horror while keeping the action fresh and exciting.\n\nPlayers move through a variety of creepy, atmospheric levels using freeform climbing, swinging, and wall-bouncing mechanics, giving a unique sense of speed and freedom rarely seen in horror games. While the world feels dark, broken, and haunted, the movement makes exploration feel fun and engaging, balancing fear with adrenaline.\n\nBetween terrifying encounters, players can relax in a fully stocked in-game shop where they can customize their character with cosmetics, making each run feel personal and giving a lighter, playful contrast to the chilling environments.\n\nWith its blend of retro horror visuals, fluid VR-inspired movement, and both scary and enjoyable moments, Dead Signal stands out as a horror game that doesn\u2019t just try to scare you\u2014it makes sure you\u2019re having a good time while it does.", "short_description": "Upraor is a Scary, fun, and overall enjoyable horror game. This game uses Gorilla tag style movement and style.  There are many levels and a nice shop to customize yourself in game. "}]}, "developer_name": "Monkefinn", "developer_privacy_policy_url": "https://sites.google.com/view/uproarofficial/policies", "developer_terms_of_service_url": null, "publisher_name": "Monkefinn", "support_website_url": null, "website_url": "https://sites.google.com/view/uproarofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26546180475070368"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2165691227274516"}]}, "baseline_offer": {"id": "2165691227274516"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780194660, "status": "PUBLISHED", "id": "2165691227274516"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27486731541015252", "version": "0.50"}, "id": "1695637614410388", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24045906161764491", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27486731541015252"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781827575, "id": "27501828342838905", "version": "0.50", "version_code": 184, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nod
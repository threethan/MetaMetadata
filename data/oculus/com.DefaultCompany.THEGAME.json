luscdn.com&_nc_ss=7f20f&oh=00_AQBsc4-pmh9vCWNA1rssV7sbXcioMYeYaKJRODwSzbRmVQ&oe=6A5A4A38"}, {"file_name": "Untitled design (26).png", "id": "709870325145757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818943_709870328479090_5586985217871597277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMDU_QAYSLQQ7kNvwGx8Khf&_nc_oc=Adr7ZYlQoK7ERwwmuyp-XkqbZW3QzVioAL5snD55gbZS1HM_WbZlhpLjmk3k8tlYHLY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATxoDgNBce45XMwdkZV5RSNbgSd2IrZCvOVzZWxd3W5g&oe=6A5A3EFE"}, {"file_name": "Untitled design (25).png", "id": "1083786329841802", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820619_1083786333175135_8252295555421765945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-po-i-lsuwQ7kNvwFpZaqI&_nc_oc=AdpCDtDPVHqLCyn3XHl_xVFokf6SiC0VfS0jc2R81ASnsHpJ-nrYVYv2Vx5e7ri3euE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIgc5RER2rHYgCxvXjASIoI1874Fc_NXbOXtlLYBVhrw&oe=6A5A1E0D"}, {"file_name": "Untitled design (27).png", "id": "727053993281284", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820652_727053996614617_5617461802732070744_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YEpoZgnRf0Q7kNvwF1Myld&_nc_oc=AdrgbiFXi7xJxRDLrPDRezLwPEIR4npd8-gvGfOVJrzGHUWyP3A29ZVXUJNdN4gyZSE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtUV45dE2uEhC3JbR9kXoWVlCtgqol0r-OxbXGeKEERw&oe=6A5A2816"}, {"file_name": "Untitled design (28).png", "id": "766578155847247", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822495_766578159180580_5026253048970441725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J_EkItY1_MQ7kNvwGC4lwJ&_nc_oc=AdphEqdYGMzq2rToykVgnoAoGXoet21iGESjkJtl6UPgAf3jpPgX04JFEDugjJzMOBw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlDqsynDrCHxgzfgcul8QC93MXW46VMsVZ7NqmYv0_XQ&oe=6A5A3696"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Uproar", "keywords": ["Monke", "Gorilla", "Horror", "Uproar", "Up"], "long_description": "Uproar is a scary yet fun horror experience that combines the intensity of classic survival horror with the fast, playful movement of Gorilla Tag\u2013style gameplay. Built around a pixelated PS1-era aesthetic, the game embraces low-resolution textures, crunchy sound design, and eerie lighting that perfectly captures the unsettling vibe of retro horror while keeping the action fresh and exciting.\n\nPlayers move through a variety of creepy, atmospheric levels using freeform climbing, swinging, and wall-bouncing mechanics, giving a unique sense of speed and freedom rarely seen in horror games. While the world feels dark, broken, and haunted, the movement makes exploration feel fun and engaging, balancing fear with adrenaline.\n\nBetween terrifying encounters, players can relax in a fully stocked in-game shop where they can customize their character with cosmetics, making each run feel personal and giving a lighter, playful contrast to the chilling environments.\n\nWith its blend of retro horror visuals, fluid VR-inspired movement, and both scary and enjoyable moments, Dead Signal stands out as a horror game that doesn\u2019t just try to scare you\u2014it makes sure you\u2019re having a good time while it does.", "short_description": "Upraor is a Scary, fun, and overall enjoyable horror game. This game uses Gorilla tag style movement and style.  There are many levels and a nice shop to customize yourself in game. "}]}, "developer_name": "Monkefinn", "developer_privacy_policy_url": "https://sites.google.com/view/uproarofficial/policies", "developer_terms_of_service_url": null, "publisher_name": "Monkefinn", "support_website_url": null, "website_url": "https://sites.google.com/view/uproarofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164
scdn.com&oh=00_Afuca_4WClpEroASHFFxu6LoPODpEXDpyBnwT8lTeF5B3Q&oe=69A58AA4"}, {"file_name": "Screenshot 2024-09-07 124524.png", "id": "1577553926133220", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75540502_1577553929466553_2775195833809998069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKZT9gzRfxgQ7kNvwHKoHXk&_nc_oc=AdnZp-TV8TeanVwyeT5QwhG3RK2x_DFvxYbI2G9tZZQHMPPlbKzrl2lmKiiQUkIu5Jw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsetRLjZhbz8vVqmccwNczAmYxRYucu1ZDcGpuGMoEj1g&oe=69A58A6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Havoc", "keywords": [], "long_description": "Welcome to Horror Havoc! In this game, you will descend into the darkest reaches of the world, discovering a past of betrayal and complexity. Solve puzzles, find objects, and do whatever it takes to reach the end and survive, all while bravely cascading through with only your arms, a flashlight, and your friends. Will you uncover the truth? Solve the mystery? Or will you be yet another victim to the beasts that conquer this forsaken land? Find out now, in Horror Havoc.", "short_description": "Become Monkey. You know the drill. This time, it's a bit different. Navigate an abandoned world, level by level, puzzle by puzzle, you will be hunted by horrors you never knew you would see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1fe9f90d-bf9a-4389-941b-fe8315999c00", "developer_terms_of_service_url": null, "publisher_name": "SkyeProductions", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1FA1nIgmhoMHm_IjYZshbhESbv2OnwOwoVr0cEhB5Bfo/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": n
AQQQ-MmIP_jwY_81YjYaSZADpTo27fIE6WvyBrUQOSVXZw&oe=6B09A5EB"}, {"file_name": "Screenshot 2024-09-07 124439.png", "id": "1770666970427620", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982501_1770666973760953_4005353008941897419_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5W5fiI39wAQ7kNvwHCxgT3&_nc_oc=Adqzr1QmJ9r_5mMtXJnhJV7gmzkoVEJnuOUwDYgwxshuNBrOYLMLet_REp3g4FjDrY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLXmE2FQMVlVvTQSiCGxt8zURFglLr7GDYhaivpJAqYQ&oe=6B09B7E4"}, {"file_name": "Screenshot 2024-09-07 124524.png", "id": "1577553926133220", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75540502_1577553929466553_2775195833809998069_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdqQWmQqC4UQ7kNvwGfB_zW&_nc_oc=AdpzubzPalJM9qPfdpNOwO-xHrWHZR4dgYQ0K6mPo97C-nIrB_63UHWWTsK6Xig3-XE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6sknIuuk3PokUoCoicpVcj2FkeWDZl61vRdyc-1sgNA&oe=6B09B7AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Havoc", "keywords": [], "long_description": "Welcome to Horror Havoc! In this game, you will descend into the darkest reaches of the world, discovering a past of betrayal and complexity. Solve puzzles, find objects, and do whatever it takes to reach the end and survive, all while bravely cascading through with only your arms, a flashlight, and your friends. Will you uncover the truth? Solve the mystery? Or will you be yet another victim to the beasts that conquer this forsaken land? Find out now, in Horror Havoc.", "short_description": "Become Monkey. You know the drill. This time, it's a bit different. Navigate an abandoned world, level by level, puzzle by puzzle, you will be hunted by horrors you never knew you would see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1fe9f90d-bf9a-4389-941b-fe8315999c00", "developer_terms_of_servi
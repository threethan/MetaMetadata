c=Adq9yzlepecJtEyS8xE-nQ5Dwn7XKAl3L0r4Xf_txkPIi45KhMG0yRzdvh-vuy8HfSg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFsPCo2Gdl6-6MTMDVOlB0QZ3R5zOATQ_pYKbj9GHsxw&oe=6AF9CF0C"}, {"file_name": "7.png", "id": "1689175972861486", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/654859273_1689175976194819_8471763499057183558_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kzg4KFYUiMQ7kNvwHzcDcx&_nc_oc=Adr7HV24CwR1BiaNxj7wJDP8oU2VLtJnwBNB-4JsxebKd8fayIF3QWs3GRIWjze-7z0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl4lRydu6z9Nb2Qr2l0cys28xGMD7x1ssDoCUFBwOxaw&oe=6AF9CEB3"}, {"file_name": "Untitled Design.png", "id": "1157148787268813", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825503_1157148790602146_5741894023436776137_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA9oYhS_R50Q7kNvwE2kbfB&_nc_oc=Adpy0E2AaynsyALRtwJ1qB4F1uSaTEvGEFk6qcew9bRgX8AFlQF6HkkxdX1-Pck1X4g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt7VlPjCuEXlb_EPRgXI251bRyxpnjESD0l4OFcAnRMg&oe=6AF9E33F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Bus Drive | Bus simulator", "keywords": [], "long_description": "Experience the Ultimate City Bus Driving Adventure in VR!\n\nGet ready for an exciting and immersive driving experience as you take control of powerful buses in City Bus Drive | Bus Simulator! This thrilling bus simulation game puts you in the driver's seat, allowing you to experience the challenges and excitement of being a professional bus driver. Explore a realistic virtual world, navigate through busy city streets, and transport passengers safely to their destinations. Put on your VR headset, grab the controls, and get ready to enjoy an unforgettable bus driving adventure!\n\nMaster Your Bus Driving Skills\n\nGet behind the wheel and experience the thrill of driving a bus through realistic city environments. Learn to control your vehicle, make smooth turns, navigate busy roads, and manage different driving situations. Follow traffic rules, control your speed, and drive carefully to ensure a safe and enjoyable journey for your passengers. Every route gives you a chance to improve your driving skills and become a better bus driver.\n\nExplore Realistic City Environments\n\nDiscover a detailed virtual world filled with busy roads, city streets, and exciting driving routes. Experience the feeling of being behind the wheel as you travel through different locations and explore your surroundings. Enjoy an immersive driving experience where realistic environments and VR interactions make every journey more exciting.\n\n", "short_description": "Get ready for an exciting driving adventure with City Bus Drive | Bus Simulator! Take the driver's seat and experience the thrill of driving a bus through busy city streets. Pick up passengers, follow traffic rules, explore realistic environments, and transport passengers safely to their destinations. Enjoy immersive gameplay, improve your driving skills, and experience the life of a professional bus driver. Start your engine and rule the roads!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "RexxxStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
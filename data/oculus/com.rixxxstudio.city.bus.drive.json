dn.com&_nc_ss=7f20f&oh=00_AQRt7VlPjCuEXlb_EPRgXI251bRyxpnjESD0l4OFcAnRMg&oe=6AF9E33F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Bus Drive | Bus simulator", "keywords": [], "long_description": "Experience the Ultimate City Bus Driving Adventure in VR!\n\nGet ready for an exciting and immersive driving experience as you take control of powerful buses in City Bus Drive | Bus Simulator! This thrilling bus simulation game puts you in the driver's seat, allowing you to experience the challenges and excitement of being a professional bus driver. Explore a realistic virtual world, navigate through busy city streets, and transport passengers safely to their destinations. Put on your VR headset, grab the controls, and get ready to enjoy an unforgettable bus driving adventure!\n\nMaster Your Bus Driving Skills\n\nGet behind the wheel and experience the thrill of driving a bus through realistic city environments. Learn to control your vehicle, make smooth turns, navigate busy roads, and manage different driving situations. Follow traffic rules, control your speed, and drive carefully to ensure a safe and enjoyable journey for your passengers. Every route gives you a chance to improve your driving skills and become a better bus driver.\n\nExplore Realistic City Environments\n\nDiscover a detailed virtual world filled with busy roads, city streets, and exciting driving routes. Experience the feeling of being behind the wheel as you travel through different locations and explore your surroundings. Enjoy an immersive driving experience where realistic environments and VR interactions make every journey more exciting.\n\n", "short_description": "Get ready for an exciting driving adventure with City Bus Drive | Bus Simulator! Take the driver's seat and experience the thrill of driving a bus through busy city streets. Pick up passengers, follow traffic rules, explore realistic environments, and transport passengers safely to their destinations. Enjoy immersive gameplay, improve your driving skills, and experience the life of a professional bus driver. Start your engine and rule the roads!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "RexxxStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4544190472514648"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593839439_1833056254390043_8614734158688911251_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJzq8uQTtqEQ7kNvwEm3itm&_nc_oc=AdpHSEKQYitb31ibbJs_8P6OkIgmyvl1-Rt_qpTQsbCMjqHykBKwG6Q4qLgSjwF9Uk8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0kWp7BhE9iPJ1-VzCXLSSCwl7KiW4Ftcz02YMXtKKBA&oe=6AF9D6C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "City Bus Drive | Bus simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1793933880, "lastRe
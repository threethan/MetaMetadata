ts", "id": "2776542286000603"}], "release_date": 1793642400, "lastRevision": {"nodes": [{"id": "1786911279213844", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1786911269213845", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2133203170598701"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1735377010898702", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Fielding - Sports VR Trainer", "keywords": ["\u91ce\u7403", "\u5185\u91ce\u624b", "\u5b88\u5099", "\u7df4\u7fd2", "\u30b9\u30dd\u30fc\u30c4"], "long_description": "\u7403\u5834\u306b\u7acb\u3061\u3001\u30d0\u30c3\u30bf\u30fc\u304b\u3089\u98db\u3093\u3067\u304f\u308b\u6253\u7403\u3092\u6355\u308d\u3046\uff01\n\u300cBaseball Fielding - Sports VR Trainer\u300d\u306f\u3001\u5185\u91ce\u306e\u5b88\u5099\u7df4\u7fd2\u3092\u697d\u3057\u3081\u308b1\u4eba\u7528\u306eVR\u30b2\u30fc\u30e0\u3067\u3059\u3002\u30b0\u30ed\u30fc\u30d6\u3067\u6253\u7403\u3092\u6355\u308a\u3001\u81ea\u5206\u306e\u30da\u30fc\u30b9\u3067\u7df4\u7fd2\u3092\u7e70\u308a\u8fd4\u305b\u307e\u3059\u3002\n\u25a0 \u597d\u304d\u306a\u5b88\u5099\u4f4d\u7f6e\u3067\u7df4\u7fd2\n\u30d5\u30a1\u30fc\u30b9\u30c8\u30fb\u30bb\u30ab\u30f3\u30c9\u30fb\u30b7\u30e7\u30fc\u30c8\u30fb\u30b5\u30fc\u30c9\u30fb\u30d4\u30c3\u30c1\u30e3\u30fc\u304b\u3089\u9078\u3079\u307e\u3059\u3002\n\u25a0 2\u3064\u306e\u7df4\u7fd2\u30e2\u30fc\u30c9\n\u901a\u5e38\u30e2\u30fc\u30c9\u3067\u306f\u3001\u8d70\u8005\u3084\u30a2\u30a6\u30c8\u3092\u610f\u8b58\u3057\u306a\u304c\u3089\u6355\u7403\u3057\u307e\u3059\u3002\n\u30ce\u30c3\u30af\u30e2\u30fc\u30c9\u3067\u306f\u3001\u8d70\u8005\u306a\u3057\u3067\u6b21\u3005\u3068\u98db\u3093\u3067\u304f\u308b\u6253\u7403\u3092\u6355\u308a\u307e\u3059\u3002\n\u25a0 \u81ea\u5206\u306
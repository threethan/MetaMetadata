2114174653815703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIbQWKMmTFMQ7kNvwFTuGvQ&_nc_oc=AdolgvgDDgwWae2KvOSkxmJIMRFG5dOyNNc4uowbm4hP3owE4x1nt1CgNjsJV8EpQXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlWOLiXvAejqvn5OM6QU7LVww7yqhDL1N8FfqmfPCOqg&oe=6AF47038"}, {"file_name": "10-screenshot-menu-P09.png", "id": "1748968419729202", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_1748968423062535_6991706597894889365_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHcGyQwQ-pYQ7kNvwHu7Q37&_nc_oc=AdoTq8y3ZjSsv3tcVsiXMyRoOWTvgiM773lyoznMqV_zuHnidw9Rj690wksdj2FAnJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ091RFo_jtWrx7PoAAQvIfraaR80UTl501Xxgy1oYirg&oe=6AF47593"}, {"file_name": "08-screenshot-setup-R04.png", "id": "1862766225155758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_1862766228489091_7627673587077347494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luz5zIunvzkQ7kNvwFUbIor&_nc_oc=AdqrLi1-Vgj9hdhkongYT_SPuR6e3wXJjqXbvn-bCIIb0aZAh387U0e-H51Nys0YX50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKiGOxCvi5DDSxFjFjBR8tgIQAH_2R60sv0kVKN87NSg&oe=6AF474B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-cover-landscape-2560x1440.png", "id": "4795904183976227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_4795904187309560_4406571936753172802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6_SjsNUF5QQ7kNvwFP8S6Y&_nc_oc=AdoGGEwl1KsFV5I8EegSop4bkI9oLXLMQuaiUP13K93LKkZnfbQLaCiDidLYs9yJkv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVYq_9QnbhZm3R6GmuGo-x3MSMY0KPgOnHwCcFbQhHvQ&oe=6AF480CD"}, "display_name": "Baseball Fielding - Sports VR Trainer", "keywords": ["Baseball", "Fielding", "Defense", "Sports", "Training"], "long_description": "Step onto the field and catch balls hit your way!\nBaseball Fielding - Sports VR Trainer is a single-player VR game for infield practice. Catch batted balls with your glove and repeat your drills at your own pace.\n\u25a0 Choose your fielding position\nPlay at first base, second base, shortstop, third base, or pitcher.\n\u25a0 Two practice modes\nIn Normal mode, field balls while keeping track of runners and outs.\nIn Fungo mode, practice with consecutive batted balls and no runners.\n\u25a0 Customize your practice\nAutomatic setup measures your reach as you move both hands, then lets you choose a ball speed. Manual setup lets you adjust the horizontal and vertical range of batted balls, as well as their speed. Save your favorite settings as presets and load them again later.\n\u25a0 Review your practice stats\nView your totals for batted balls, catches, errors, and play time. A separate Fungo tab lets you review your accumulated stats, including your overall catch rate.\nChoose your throwing hand to set which hand wears the glove.  English and Japanese text are supported.", "short_description": "Step onto the field and catch batted balls with your glove! Choose your fielding position and adjust ball speed and target area to suit you. This single-player VR app lets you practice infield defense in Normal and Fungo modes. Practice catching balls over and over on your own, even when no one is available to hit them to you!"}, {"images": {"nodes": []}, "id": "1124267030157862", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Baseball Fielding - Sports VR Trainer", "keywords": ["\u91ce\u7403", "\u5185\u91ce\u624b", "\u5b88\u5099", "\u7df4\u7fd2", "\u30b9\u30dd\u30fc\u30c4"], "long_description": "\u7403\u5834\u306b\u7acb\u3061\u3001\u30d0\u30c3\u30bf\u30fc\u304b\u3089\u98db\u3093\u3067\u304f\u308b\u6253\u7403\u3092\u6355\u308d\u3046\uff01\n\u300cBaseball Fielding - Sports VR Trainer\u300d\u306f\u3001\u5185\u91ce\u306e\u5b88\u5099\u7df4\u7fd2\u3092\u697d\u3057\u3081\u308b1\u4eba\u7528\u306eVR\u30b2\u30fc\u30e0\u3067\u3059\u3002\u30b0\u30ed\u30fc\u30d6\u3
t-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzG1WtgKBx4TLweNXnXM5mVBvCgvbXx-MW1NBWoWZkIQ&oe=6B0F0AF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-cover-landscape-2560x1440.png", "id": "4795904183976227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_4795904187309560_4406571936753172802_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_2KjX5wN30Q7kNvwFaH_o1&_nc_oc=Adp2gTIx2CRzaijEMbcmh1_ojH2ZOYeGMB0IeluiUPmFAKnkaeLqvokHrQNh4xZctqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVm1JLuaf_yHXKTA9T19NNMCi-Go9Yca0DlE6E0O4UQgg&oe=6B0F170D"}, "display_name": "Baseball Fielding - Sports VR Trainer", "keywords": ["Baseball", "Fielding", "Defense", "Sports", "Training"], "long_description": "Step onto the field and catch balls hit your way!\nBaseball Fielding - Sports VR Trainer is a single-player VR game for infield practice. Catch batted balls with your glove and repeat your drills at your own pace.\n\u25a0 Choose your fielding position\nPlay at first base, second base, shortstop, third base, or pitcher.\n\u25a0 Two practice modes\nIn Normal mode, field balls while keeping track of runners and outs.\nIn Fungo mode, practice with consecutive batted balls and no runners.\n\u25a0 Customize your practice\nAutomatic setup measures your reach as you move both hands, then lets you choose a ball speed. Manual setup lets you adjust the horizontal and vertical range of batted balls, as well as their speed. Save your favorite settings as presets and load them again later.\n\u25a0 Review your practice stats\nView your totals for batted balls, catches, errors, and play time. A separate Fungo tab lets you review your accumulated stats, including your overall catch rate.\nChoose your throwing hand to set which hand wears the glove.  English and Japanese text are supported.", "short_description": "Catch batted balls flying toward you at the ballpark! This is a single-player VR app designed for practicing infield defense. You can customize your defensive position, the speed of the ball, and the range of batted balls, with both a standard mode and a \"knock\" (fungo) mode available. Even without someone there to hit balls for you, you can practice your fielding repeatedly\u2014all on your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sinfonia.biz/sports-vr-trainer-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sinfonia Inc.", "support_website_url": null, "website_url": "https://sinfonia.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1797962478108724"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1319716840179875"}, {"status": "PUBLISHED", "id": "1143129084807513"}]}, "baseline_offer": {"id": "1143129084807513"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793642400, "status": "PUBLISHED", "id": "1143129084807513"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1799915607913411", "version": "0.1"}, "id": "1661875408920632", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1
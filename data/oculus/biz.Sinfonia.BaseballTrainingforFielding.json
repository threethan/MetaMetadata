-TMtiiMNvV06uN8IihEFThqrml8jhgDSPoPFZ2RSEgBdOeXRJv_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWXNN7pYveXfXbzMu-NRLXLON2qCFui9GN_ZcJM6mgSQ&oe=6B0B1EDB"}, {"file_name": "12-screenshot-runner-G0.png", "id": "1690394372653725", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622192_1690394375987058_5712114174653815703_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVWYrWANnpIQ7kNvwHDyPQS&_nc_oc=AdqIcV40noztvZveEo_Qqjzsl_f_waBfsQA9CEuBDVEBqU8NRklFVVsabC70rTgSyRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZ0WvPx72kbDD8wFoFbuc_RkLMO-h8g-St6N99cVd5mQ&oe=6B0B11F8"}, {"file_name": "10-screenshot-menu-P09.png", "id": "1748968419729202", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628050_1748968423062535_6991706597894889365_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE2qRcw7SscQ7kNvwGC_MJ8&_nc_oc=AdqeRMDYUyUHgRpZ3jcbPx-EKT9jl68B4v4O6PVlyybLFcc4AOfmwF6AyhcV83iwMDk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSz435CV0yIgqKmKPTjPpGQTnA_RbtkVJwNvPu45X1SuQ&oe=6B0B1753"}, {"file_name": "08-screenshot-setup-R04.png", "id": "1862766225155758", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620414_1862766228489091_7627673587077347494_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqvCrcAWry4Q7kNvwFN1ioa&_nc_oc=AdqrMTci2lDIz6g9GoGjyluv12B0Ioc9prizOG4YpX0skhXa-ixrKW3qoWOQf0xrOP4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtcZl4vK0_9VRd6Puo3OEH-5d2Ba485huVx7dkg_makA&oe=6B0B1671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-cover-landscape-2560x1440.png", "id": "4795904183976227", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622916_4795904187309560_4406571936753172802_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZHKXIGSzu8Q7kNvwGabl7q&_nc_oc=Ado4TKHs-7pMwrvyrT6pKi1Y3mqf4N9mYH7YgajhlxJZ5Yb-k1Kbksj5QIyhpXSfxoU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaWomSzVsksLlhVECmYq2N4HqErrbgP3K66fuQKtQe9Q&oe=6B0B228D"}, "display_name": "Baseball Fielding - Sports VR Trainer", "keywords": ["Baseball", "Fielding", "Defense", "Sports", "Training"], "long_description": "Step onto the field and catch balls hit your way!\nBaseball Fielding - Sports VR Trainer is a single-player VR game for infield practice. Catch batted balls with your glove and repeat your drills at your own pace.\n\u25a0 Choose your fielding position\nPlay at first base, second base, shortstop, third base, or pitcher.\n\u25a0 Two practice modes\nIn Normal mode, field balls while keeping track of runners and outs.\nIn Fungo mode, practice with consecutive batted balls and no runners.\n\u25a0 Customize your practice\nAutomatic setup measures your reach as you move both hands, then lets you choose a ball speed. Manual setup lets you adjust the horizontal and vertical range of batted balls, as well as their speed. Save your favorite settings as presets and load them again later.\n\u25a0 Review your practice stats\nView your totals for batted balls, catches, errors, and play time. A separate Fungo tab lets you review your accumulated stats, including your overall catch rate.\nChoose your throwing hand to set which hand wears the glove.  English and Japanese text are supported.", "short_description": "Catch batted balls flying toward you at the ballpark! This is a single-player VR app designed for practicing infield defense. You can customize your defensive position, the speed of the ball, and the range of batted balls, with both a standard mode and a \"knock\" (fungo) mode available. Even without someone there to hit balls for you, you can practice your fielding repeatedly\u2014all on your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sinfonia.biz/sports-vr-trainer-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sinfon
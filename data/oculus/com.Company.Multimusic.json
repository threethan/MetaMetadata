ription": "An educational app to learn multiplication tables and the name of notes on the staff. Also, there are extra levels for ear training and a musical memory game. \n     You have to move your head and select the correct answer with Gear Vr Controller or touchpad in the shortest possible time. And make no mistake or you will get an electric shock!. It's highly recommended for teachers to encourage their students with Maths and Music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://termsfeed.com/privacy-policy/97bbd061665a34feeb770c2e5a014223", "developer_terms_of_service_url": "https://termsfeed.com/privacy-policy/97bbd061665a34feeb770c2e5a014223", "publisher_name": "Rafael Gimeno", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCqdPBw7LqObII7qDh6pUwpg", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "912317356015364"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "382898265763981"}, {"status": "PUBLISHED", "id": "2443609122590152"}, {"status": "PUBLISHED", "id": "640622063068976"}, {"status": "PUBLISHED", "id": "534541607101465"}, {"status": "PUBLISHED", "id": "115691233113973"}, {"status": "PUBLISHED", "id": "126048574653111"}, {"status": "PUBLISHED", "id": "357592154960227"}, {"status": "PUBLISHED", "id": "432568653996944"}, {"status": "PUBLISHED", "id": "626315921230398"}]}, "baseline_offer": {"id": "115691233113973"}, "is_approved": true
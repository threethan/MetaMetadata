, "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974762_801573187291720_5842889010530489848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kd7xfE09PVEQ7kNvwHxjTIZ&_nc_oc=Adp5jaPjjktLs3WnSahuL_Hp8bOUXKzCEAUDaWxY6SiNlBNxvDLc4FbDnnXLVTOM36w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdXQf4w4zJgcUh8H7aYpK0UXlQ5Vysyd_qkOqV0lqiIw&oe=6A859024"}, {"file_name": "5.png", "id": "2053511904816102", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974647_2053511908149435_1165453731717341145_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQcqUCABrggQ7kNvwEv0agQ&_nc_oc=AdoXNrUVhZd5tFgqoKQ1sMaMCFsRkgGRoSNYhiSvdy1kbiNPMx0hhYyIfoi-9CCeg7A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjxfKHdQuAnk0dBr4R_znUajsfb2x40orWp-fhRsZefQ&oe=6A8583F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75195907_586598099202845_1649866001526745780_n.png", "id": "363913562193889", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974580_363913568860555_5710565582024455571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDH_Y9KfKXMQ7kNvwGcG232&_nc_oc=AdpWIDZiny89cNbbOpS0P4DEXKDSjEBtFDevsAr6cbreDvRUchkeZHRFFO5qxrukuyI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwdUZB9qUhagBcJxkDsopjgKPzmad-2zra4x04-qA_mA&oe=6A857FB0"}, "display_name": "Pizza Master ", "keywords": [], "long_description": "Pizza Master VR is a fast-paced pizza-making game for Virtual Reality. Work as a chef and wield 8 core ingredients to create a wide range of pizzas to satisfy your customers. But don't slack off- their patience is always ticking! \n\nYou'll be easily immersed with the intuitive gameplay and Pixar-inspired visuals. \nWith your progressing skills, business will quickly boom, both a blessing and a curse. \nCustomers will be harder to please, robbers will steal your cash and if you don't keep up your standards, you'll find yourself out on the streets again!\n\nFeatures:\n\u2726 Over 30 levels in single player mode\n\u2726 Endless mode\n\u2726 12 unique recipes to master.\nComing later:\n\u2726 Asymmetric online multiplayer mode. \n\u2726 Only need one VR headset another player can join on another device \n\u2726 Play as the chef in VR, while someone on the same PC plays as a waiter on mouse and keyboard.", "short_description": "Pizza Master VR is a fast paced pizza making game for Virtual Reality. Work as a chef and wield 8 core ingredients to create a wide range of pizzas to satisfy your customers. But don't slack off- their patience is always ticking!"}]}, "developer_name": "Plectrum XR", "developer_privacy_policy_url": "https://plectrumxr.com/privacy-policy?fbclid=IwAR3TE2ug7boo8sc3jzgTy9dn-w56Irpbb_xv2wMSD_zoUhWW8wt910IKr18", "developer_terms_of_service_url": null, "publisher_name": "Plectrum XR", "support_website_url": "http://plectrumxr.com/", "website_url": "https://plectrumxr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FOOD", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "960744027904251"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "534650842226145"}, {"status": "PENDING", "id": "639981047125034"}]}, "baseline_offer": {"id": "534650842226145"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723004535, "status": "PUBLISHED", "id": "534650842226145"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__ty
FzeZOu25Jb0AVQQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lSSIgCIG8Lf3wyfmyka2uy4nKqnvbjcdV0Zzu15pC-Q&oe=6A243CBA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuGc6a2fMFcQ7kNvwF2bRLf&_nc_oc=AdpGchzV2f6wfbkCxGmWZqUa-3F3azvcYOPel3ofHEwsJM5V2La8m7LSU5UEWp730vk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xmD55BllsdPmBub4drqkX4oPmG1xN7NeaFsmc1Y-X5Q&oe=6A24485E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zbwg_p7iE98Q7kNvwEscqZP&_nc_oc=AdoXkuvDDo1b-zqPC91LHikbasOf00lNvSIskuguRiQ31S87EkcV4puOuzDRSy2OvXc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xps8YxH-zVygh7E6i4RHV-2Z8XlF9WBtc80ZuzTmatw&oe=6A243D49"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY2eeVlHf94Q7kNvwGXXrEZ&_nc_oc=AdoxlC9q2ABp1g6iDGsUkRlwxmIOSy7k3I67ccieeCeMOXnEy7IeW94S1ngTX2wYfho&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CKoqOxn-l-IAmy-q4vMjTL8ER0TJzxkLMUO-qYEXuPA&oe=6A243AB2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN_mpIhkKHIQ7kNvwHuCBes&_nc_oc=Adq_wCCeDfDd-UPR18yRK-mbsZmSjMq2CFioJDNfYMfjunz3rE0_bvmd7Yc3p_06wHc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oic9DwMbUOt-HWnUEWpae114o9bsWF_kusb7I__MCow&oe=6A244D97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
Vg&oe=6A43E149"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPCTW0eEOLUQ7kNvwH7qYzU&_nc_oc=AdruCH3AC5su6D36XHMxb5t2PHpsfNQZuMslzmbVmY26c2q3bbwcuJ5A3qGa5P4v3H4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-togQzG5OO36a8IsetYsH7jtMkZTIIeJaXdMxZaZlnZA&oe=6A43DEB2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1njLJu4IWYQ7kNvwGqD40N&_nc_oc=AdoLFguSDKveixYtyr-vSJaREEoXmPtQxOOfQySgCWTkH6qhJvvJhs94NgmJ86dyy8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vXTN_-ocwA0Drmch7CJqf62wp9Wt3oAeM-NM_A2JcLg&oe=6A43B957"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Conn
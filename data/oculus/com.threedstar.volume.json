-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kBAaEM4-u0Q7kNvwGCyi-K&_nc_oc=AdqXs4mFmpBSPqKnm_-IIPU2QSF_wOHiIx3RXv0i0zvQ2UQQ1iUVx1omGU4T9bFeI7E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0_jeWvb9AMlp9Oiu6GExFTzQI93tcayb_mAIAMMarmQ&oe=6B09A1BA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6nQ4VpBhFAQ7kNvwHolofI&_nc_oc=AdrmfI0Mgj02Yekl6SskjE66ZNajAD6OlvFA7rQ6uMUrFOyd-dkjQAKNHHgZu_cy624&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNq45g1_mSExuwIfDnSlNvXMDuu-Zqd2mwZ2WuNt0riA&oe=6B09AD5E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcdKJSiZOsoQ7kNvwHM_Lo4&_nc_oc=Adobggw-7L6-0_-UK2l8vmwgkcNcNIF0M9-63I4YciAW6JyKJ8Afa_j4b8kGIFV1u0E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzjuYe2ZWwrTlm02_YNOQY7EiCh52PrdwWgvfnkqBdKg&oe=6B09A249"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzWjOch39V4Q7kNvwGmBAhj&_nc_oc=AdpHfCbeUKLQOO3KXTu6vDzz8FYsG_vTsuLJk9owI0-fxnLj39xGb7dod_qeZElCzeE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0WwJUDg3P6KJIQoWZsQW1jkRF7Zr8I_117amA4qalcQ&oe=6B099FB2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvrHY6CbaNgQ7kNvwHrj8vG&_nc_oc=AdrdFdu3Gwc9d8aAzhU1AlrmEupENAigq4XjjXH7IadmUWAim7RWHl_2fzKj6MIr5cY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnVc77xhIQfVNpZ-hTHBSPAnFcYbjP83p0XJeRHUFjfQ&oe=6B09B297"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
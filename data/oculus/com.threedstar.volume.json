issBXpw5T423PWY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOJ339Wx7SZte4ipbEjybQGY4a6ZgD3WD_ydnrQ-cylg&oe=6A97277A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8kIaTCf6BoQ7kNvwFtTjbA&_nc_oc=Adqk94rgPhEo4DFvAZTIz4sO1f2ZaG1fisXYdvpUAVVtX92ZXvHvZwBuxgFytWSBOjI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo4PKEerNfnc5SAlSTQKLo_iNWcpSnPind3xSmFcpJ9w&oe=6A97331E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5KK-CbD8lsQ7kNvwGEHAwD&_nc_oc=AdoUcniruPbiDJbOBnWFZnqyDonK6eIeo2xXijhZWZguma23P5ttgIwCb7Bm5Gr8lCM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq1_ykHWXUcQ0ukSQdNYGxXRwUuNaYa1B09m-OqAiKpw&oe=6A972809"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGPXAs20MdcQ7kNvwGEXEbt&_nc_oc=Adqkc6xZ7Hoq0gVzc_e_r1TnXrWzrT78zS0CH_R34BeKuL0Vth0o8f5oyQy3yl5IQa0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl2BSsKTsExkZ_z_UOqOo-1YCjrjg5TqelK3xrdL-UdA&oe=6A972572"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVbppxYAA-QQ7kNvwGv0SqU&_nc_oc=AdqrCurFafmjr8VkscSZAvh8c3Sv7KlbV4Ka2dWhEfEtRXcqQviwo7EfbfXqjIxiXQw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8DqbcNKT_pDR4WF4lkr2tUfVlGIodyC_8udSL6OM_fw&oe=6A973857"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
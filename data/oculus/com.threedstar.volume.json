-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahTB_3q-Q98Q7kNvwECXS8n&_nc_oc=Adq4eIccXl9X5pmXK_F0QRykvSLWCy3snLxIS-OAQbYJ0gbZ3R66GPOR7grV5_hBqTY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB3uDZ8sTI99_ZV5XX8RLN4jK9hnTgylm0Hpixb4AvdA&oe=6B08503A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6nQ4VpBhFAQ7kNvwHvwDeY&_nc_oc=Adp7Rs6ZpGnywZ7-fLRlxMEJpw73AhCbUtHfl7Y-YteC6QxzekPwHi0wRl1g1fDSsfs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtKbZ6sEowv1v6WrV9DollC7ybFrDMeiAUKKBxKQ2I0w&oe=6B085BDE"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9thBO4i0yEsQ7kNvwFWbQoI&_nc_oc=Adp8Dry4PmKAsDu7UHxgBLpFtGoUid_a7orQC9tQR-o36YaeOCfsWHORImfg6V6NwHM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRerMvqeNPxejlWRSvmLKtI7GBTSTGpFUIyJ4wX1wzqrg&oe=6B0850C9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzWjOch39V4Q7kNvwHnZF3G&_nc_oc=AdpzoNTblpPmple-mW9ma6pihP4BUZVqKBE6ZCb8DEOy1tyD9tBTFfx4xFRFHMWwlwA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT8Y3WemrbNVBMhlY-P9b5mPxEqyFZQSVVKO0JTgXNjw&oe=6B084E32"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvrHY6CbaNgQ7kNvwFIBX5w&_nc_oc=Ado8-7pYOMxe--s-Sv6mrUf5fmCTJdO2fe4ja5qylDAT186WTD6DNijbg0ixxLD2XEY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLkPytz1Xxr-NSEJb4Q5FUAG2K1E9eYsiWKBhIsuPWiw&oe=6B086117"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
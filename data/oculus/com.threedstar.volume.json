-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn0gyNqu_GYQ7kNvwHqQ3l-&_nc_oc=AdryKjsaBJ6yWlJddYhkRrhQZFZJbq-k2V_vyEq2DjBvBj7d01drqGqBMkX2KADAMl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVo5TwYD2mJVxulz3g9HViRgvFzFFCxVEpsRojoF6wVg&oe=6B00673A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKuf-f7wZxoQ7kNvwHkGqPx&_nc_oc=AdpXbfaCRCvMZSx4xSPDhzfhLhoH9ZGr6BTM13XGZ9pCkTEoOCfnuo40_nHyfmqZ5WM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Qzx5TuSu1xCdHPLt9o0RnX7ayKHABxJlmibyEjYDVA&oe=6B0072DE"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC42uF3dLxIQ7kNvwFk9wJA&_nc_oc=AdoKBkYiAXZUd5yw4UpP7dTc-rTPm19nKwoCK9_BB8T7l0Kx-6jcESIPsDciVjkXPqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyhoOdtOVHBngr_LNyvanG9wV3nE7VXiEIZd1Yv6e47Q&oe=6B0067C9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfkrn10V5bUQ7kNvwHybkwF&_nc_oc=AdrM06ALf3TBwB3M37f4w6Rx-vDVoHmTvg05hsT7bP29r_O_Yru3xfCfkqXdKGEwPJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROSvzIRKflhqFOHZb5d0PM0TKfiJ7aToe67JroedPqZw&oe=6B006532"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7-HzTfk4HQQ7kNvwEABDoW&_nc_oc=AdrUojWi-3Sc4l6frx64Q885xbQdHnCS8Qh556zrC9Tl8nAyZ6cenoYbM7jixWt495U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTPmQrq7OftDU7w59fRZ6NxQOYYJm7wnqsadz7GB-Dfw&oe=6B007817"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
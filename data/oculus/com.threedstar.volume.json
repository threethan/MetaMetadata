HfQBu3S-zSxYI2Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-j5KDi9ZYlSh7K8VTHLBzgvJLJUtFixVdlt32G1ZhNg&oe=69C5187A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQyz26_fF7YQ7kNvwEll5eA&_nc_oc=AdqzKLP4S71y2jIo7RdswG1wQXLPfsXTNJFK2zBFOjbKBfhfqOfiylswe-mbOM-wPEg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqqNjqi0-JAO0ElNm7eEQUwh6JNR3FY6K1KIDjaOwp9w&oe=69C5241E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcn4gORP0zEQ7kNvwGxy2cL&_nc_oc=AdrMHDcCBl68JMfnjmtz9urJiLpFW4bse6tMchKd-cMQwGNZWScvEEEm_f2NO4Ul6nU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwj3iNlS-DGYHRD16R87S8EBQ02uAV6wgWy6_kY9VO-5A&oe=69C51909"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRfqyYa3CocQ7kNvwHI6K1K&_nc_oc=Adqqq5NC2twzMGutg_HthsrO_kewgHD-w5BWj83ku2P2j1ykeNyHq9x_L0ggpCTL_gI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfWahUSsGrOxlKZ-fi3SE4Aj5DnzBeLaXoQeVgh-rrDQ&oe=69C51672"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1KqpRvncWIQ7kNvwFm89uU&_nc_oc=Adog1tn0vIe5nEYraS9--0LwGgYrmZE66KJpAD3nXfIz2Aqd9SP9G_el8UcLrdJPS74&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSKkFcDy5zWLWqZaTAXamiXtpkRD85vDe6LlD1ffpa6g&oe=69C52957"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
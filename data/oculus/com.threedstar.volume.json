-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9ITyvuotg8Q7kNvwFei6eF&_nc_oc=Adodo0DiKgshKgZp-ZmVa2_duRMc3ay4I_Vhpgy7EeBkIxbvHrIuzfBdHFAn2NgpAFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQpj-ZU8swWvtRsSU1tl48DbrZ68vupHFimrYzx3fdcA&oe=6B0DCE7A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-cbFYha2mwQ7kNvwH3tiY-&_nc_oc=AdpVnzu0q50JhDx3G-TLNuhslJY-QATqZUz8kWVyJs9K1099tzBnvNfYjeENbPLF9DU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPDej3rxPLZseXqxghvmP3dF8ZELkc0jxI18aZ0ZYTFQ&oe=6B0DA1DE"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F49w2_GYlKYQ7kNvwEM0gY6&_nc_oc=AdpxjXxGf5dxhQIPXqE_lsk8ulakn9pK8mfm0rv2GJUqcmtTzsf8qfx8xrZv9JpoEVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVmtz8n9qphTgfpT1xsCjLk5FGN-VYJX-rdZAf_nZMaQ&oe=6B0DCF09"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLctNVbJ0rYQ7kNvwGGDBNc&_nc_oc=Adq2aYMrf6hqlQYdGmw6bji_RoOeSFo7CWZ8VTq6ujJmUfCUAC-6ewyqHLhKOoxHouw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTf4_hgFrsoqNrAmmZ3wwmNqZnQO6CtJ-fTz88oc2LLhQ&oe=6B0DCC72"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTId_zAfm8IQ7kNvwErIzUH&_nc_oc=AdoEpOcK0B4JSC73BesZUi7OctYsBY55h4qT9w8DfDS_FAp6xQhIyy6wK7FfeezmnK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGNZNXSpOlthpqRKfbOaBW7r5fMgBbJy2y6tXGsLq6Hg&oe=6B0DA717"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
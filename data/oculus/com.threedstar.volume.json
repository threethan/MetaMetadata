xV15LBCXxfn_JFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj2v1ryYLBCCaS56VHBDkaXzHcrUDaTaEuHWHIPL0QqA&oe=6AC11F3A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4pqiM032L8Q7kNvwGvifNb&_nc_oc=AdpxF34nV2K0nv76fv87XCb7ikPZMoFuRhclA8D_4qMUmMFr5rJRrQxNsZEUghrKcCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5QFz8QC7jilCNvxFQHx-RHPrDQMumd5f7mTNh9ZAFHQ&oe=6AC12ADE"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlLfnuafmWsQ7kNvwHOaCkU&_nc_oc=AdrDsTz2YX22HiJWPE0iJWVEjOaQNmtdFShPidkyFux16Qnu8Ink4x7lcynKy2HDBEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuKWMtUjR8oL__jk2dS-qw1K8ktqYwEH6Oz5HBnbb8CA&oe=6AC11FC9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIGcp1csy2EQ7kNvwFdaw8p&_nc_oc=AdqifB7b693G1q7L2jiWpuL5mcfvbPBbsOQsCRVQ5wTrl53Zd3GNt0AOG-cCqiBq4h0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8bm91BeB-zzTNe2-tw78FQ78QW2yQQwPfy9uqavdZ4w&oe=6AC11D32"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gulu0BOV7cQ7kNvwG74abC&_nc_oc=AdoAQN6JI2WvUg64vO0VBxlGEoWJa_59TS2DlrcpJALrdoKqZB1OshJjS65hcCWQunw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvaQZjTxSOlPAyTiHMfV49eeYtw--fpD_49TUKX-j-GA&oe=6AC13017"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
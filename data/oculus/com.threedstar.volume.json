-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahTB_3q-Q98Q7kNvwEOleaB&_nc_oc=AdoQhtyMC1btWIFVLlFtvYHVNfAjHfQFHL5s6VHAScGlMIJHkLSY-XCbsDxk7Bq7AAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb31SbLpp6ftGFwafKOBrbRDDa79uuQaMJ_SyVv0GX3Q&oe=6B05AD3A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGCIivCyGHgQ7kNvwGWMOgY&_nc_oc=Adpy18eIZYfmmgO2Xm161ZDYCRXR0NdQGA3nRovVMO7zAmlprM6zre5OPnO-H5R5ShY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmQD7mWmCmLeOBguGD6S8Ryw-UkN7IzIs4xIi8RF4LCw&oe=6B05B8DE"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9thBO4i0yEsQ7kNvwG4v_qq&_nc_oc=AdpUCQ_XlScUSaz3sjIwn5plph2PhRXeLb3RwgYqQ3uD3v1oy5lGYLDmXAK-TFIe-rY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTP0thQYnGi62IVQStcPk8vrtsyqrxLEYbRxTftUdtlA&oe=6B05ADC9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J31HGuFHhJoQ7kNvwHT2ZXV&_nc_oc=Adpgt7OP_IStUWXejlOXQhEpN6oUVvBEu_IVlXz6U_9_A_K1OVFAvi_imBf1VFD5CgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmrY_aLjD96z8Vyfl2MT7FcpbyTpB2Hitk3Mza6H-s1Q&oe=6B05AB32"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsvPKGQ-H60Q7kNvwG6sFxr&_nc_oc=Adrq9VLf9cMwoYumeWJAlZl6VY7DnKISSX0WFrd3xTCsT_EpjllunFj9C8rxxvouPPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8xb9TshxiAD4pv4O8YE41cMDmcuWDlKEWzAC0Cy7YLA&oe=6B05BE17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
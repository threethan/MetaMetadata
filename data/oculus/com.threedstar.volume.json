vw&oe=69DF7709"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvJepAxsmRQQ7kNvwFT_7LD&_nc_oc=AdoL0l-o-SWvvGKkCHZzFV83ManbOGCsCGJCixUzn3GnDn0fYx219BrvdhJ5a3jg_7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZCO-2o1nJld2Cb3J4pFOpBgxfIPGnMoacO59gd4ikKQ&oe=69DF7472"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE5BxXkbHqEQ7kNvwFQckI_&_nc_oc=AdoGIxldHeZH2XLkiVWI93cLpA_zlPtZJ8KPH2He9JdOkEMY6pUyZ5akxzKbsNB1vro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uQ6iCZk9u_kygzZUp6AQ0TKy3sTsTNxYpJjd8utcZ3w&oe=69DF8757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Conn
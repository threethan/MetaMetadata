ibb3s0JQi8ScFBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKdjJyF6Lx8eR2xv-YIw-dKJYASvY9c5w72XDwbvMF8A&oe=6A52613A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDooQruacj8Q7kNvwHdLND7&_nc_oc=AdrJdTQjIpQnBXeUyhuxpE4DJi9X08rfuffm6xh2TJqRR7B8L7G62lYNLZ8dj4T_OvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3W6MJv4pY75p1k3zT1RgH8g6W_YeAaR5YwdECtqcrHQ&oe=6A52349E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNtPmvDH4QEQ7kNvwH1EWuY&_nc_oc=AdrTl1BfAfD3GyU3gPIwH1LTc332WNtUChVVtIJWE0jmyQNQeI5TreUyvK_FUiHtjIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOVPf23P919M5sAkwL-Glb3SExRixzQQO4slcRFWzg5g&oe=6A5261C9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TA7GMZQkogQQ7kNvwHI96V-&_nc_oc=AdoTrhUF4VEdxAK8Zj4cb3K-V4FpgkzgP027V6IxX4eulbLey9KOqt9vHquvx1FS-JQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAudmqKPSBpjt-ieEd-zgNfGwU5EUozuazg46w2IR2ElQ&oe=6A525F32"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahfk2lO0MaYQ7kNvwF8ttNk&_nc_oc=Adr3yTObo172jkq6YISbzywWZ-03jDTW8zvfTxLCHfiTBinfl7SsYS8W5UP3tqeO5Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbg6Sl_OiVloLTsEJVm6sHnIst1w9AhcGeqzKjDjapZA&oe=6A5239D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
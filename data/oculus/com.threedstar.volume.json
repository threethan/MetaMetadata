-Cz-A3gxdY8QtqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgVlMBgjT_RVOvjZRXDA1Qh1z0T45U90JLtgYv94DykQ&oe=6AB7E4BA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1C_BC8dPDoQ7kNvwGz9DV9&_nc_oc=Adp9qvEDGYOhq1QoR8UY9QCZGjKMTEZIrY-7nwz6btXbNlYtUHieTkAQw29kJP2TXKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrnBn1XFmyjWjzX0ABxhlDhwi3TeQskgY0u4NQR-nmnw&oe=6AB7B81E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA9NDwPTzI8Q7kNvwEdwRoq&_nc_oc=Adr4qXB_FzIVD85qw9TLGtzHBNGBmRDuqCvXHLV5Rn850VxHIsKNMTE_mnDDWDw66qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoMP7SFzsGaVO9mYlY_bOw5b8OzbkEMBbi0ARL-IiDaw&oe=6AB7E549"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LB3MeH5lxfYQ7kNvwFgmGc-&_nc_oc=Adoobt5elxjlGtknYFifsvIMHMw8SEwa3aBL93f1L4EEycYTxKYJ8J8bdN7jKeTByaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ1r2V8-nY2pZSIspLyLO2hu9Ymo2XaPb3U1Tlq9A5Bg&oe=6AB7E2B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF2NxlZqKaMQ7kNvwFqb_he&_nc_oc=AdqItTHL6VpqGfCqbS0fX8i1s3iSbChJvol30o4qzZuTmdwrr2_ea9Jx4zHGtlSFWww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSvrG7sj4ySbP-AgDg7Rr3zLGLreYwb5GKfeUzbZNACg&oe=6AB7BD57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
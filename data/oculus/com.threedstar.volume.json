OzOfG22KlqMIqDU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe1RUytbJfKlHEh9hc3R_gvm0zJrj6ZBnXDGPb_Lt6_A&oe=6A58C07A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt0Ob585IPUQ7kNvwFune1d&_nc_oc=AdqU6R_vxA8DJHide1tDPcjYgyq7Lt3q2Ai89reVAEe4F4-DWcq2luuDdenjt5pPZU0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX1PNLveXyquA_78XaPuw30NHkGnekSByX1TvK-efHJQ&oe=6A58CC1E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYWBYRP795QQ7kNvwE_9a0J&_nc_oc=Ado3dz1ZWoqHdxiLjnmIq2-wZmUQlJtHiR1dQyniqQNCcf6Sc2LyVHIKNqrtGXionsE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD28kyIXBkEbKQJhgX9t73SRdvUn_mJixBonor6mw8fnA&oe=6A58C109"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RibMN1cbeDMQ7kNvwF4WWxF&_nc_oc=AdqaxIhAmxtciCRNvS928ToCJhQbTtaZItpzxYNv1hlcltCfpOiTJVsdJ-pFStWdFBE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA88CguetCN0BSJLMF_tBxjSlbEryVsg3fVGkHfV_yd_Q&oe=6A58F6B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CLj4882MZYQ7kNvwF4PyHV&_nc_oc=AdrS3n9HnQY4TwYG8uzFzBxloQ4kK4H3X3ZwOHK2bdn3KN_B9upn6S8piCxCV-7Zmjs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeHKVlTQifcGdm-MFJB72WZZWgpy50c_DFic0OMToU4w&oe=6A58D157"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
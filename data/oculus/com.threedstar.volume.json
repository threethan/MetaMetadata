M3ZTqOYHdQ1VNBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IJFbY7AdHFzcs3IDjJUzLHkISjqP84nxOdQeG9_7l3Q&oe=69DF767A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAX6aHc7cqoQ7kNvwH4szRC&_nc_oc=AdouK0yeipdN1_zvAyLeJcfH7n8c8MdhILctBQMfSAoXUE7dlxYTQPoP988hFZ6CUNk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b-d1mxgpFIUOVeJTVUMhNejMx1Gf9XAplcMOLAuA3zQ&oe=69DF821E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9uhjQqBmb0Q7kNvwFi3ifT&_nc_oc=AdpSeyLGmGtw_p_YoYNTcjyPML7dKh3TKOSU2q0DTwL43WRpjxPcnqebHE7vWHutJ3I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yWRVCD-nejfoczBgfYxQ9cwBEGkjReMEeZu2aLnanvw&oe=69DF7709"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvJepAxsmRQQ7kNvwFT_7LD&_nc_oc=AdoL0l-o-SWvvGKkCHZzFV83ManbOGCsCGJCixUzn3GnDn0fYx219BrvdhJ5a3jg_7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZCO-2o1nJld2Cb3J4pFOpBgxfIPGnMoacO59gd4ikKQ&oe=69DF7472"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE5BxXkbHqEQ7kNvwFQckI_&_nc_oc=AdoGIxldHeZH2XLkiVWI93cLpA_zlPtZJ8KPH2He9JdOkEMY6pUyZ5akxzKbsNB1vro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uQ6iCZk9u_kygzZUp6AQ0TKy3sTsTNxYpJjd8utcZ3w&oe=69DF8757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
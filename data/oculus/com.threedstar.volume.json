-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9ITyvuotg8Q7kNvwGbmkRE&_nc_oc=AdpytHAV5kI4iJLrAb83UE4O8R2WvrqyLqV8MGXca_2J_F9RF1bGUbr4XZU3Jwkfu_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZ8UnVEeU4ILdfYPRQB_bZAKJjgow90-TAn4wEHDGh0A&oe=6B0F1FFA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRDC6wjvviYQ7kNvwGfu1sL&_nc_oc=AdqmfSCajFStCn1no72ATih9oG6_VmGibqcRSVsm-23dWQPuL-ltXEYvcyhOcJqnt_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoApumBYZg6oj0qmVhubEhB5Oj6xykfGU0_iU3vF_UAQ&oe=6B0EF35E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F49w2_GYlKYQ7kNvwFNIimB&_nc_oc=Adq9QCa7DxGJ43iM8WK6E7C4AB-aumiihZK3i_SisFIyvshfKVeyIULJUOgdWDiKopY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUa1XS6Lj2sznUpk9CDpAEsUhl2CSAzVBD4aHLBXyqs7g&oe=6B0F2089"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msG4QRsC8rMQ7kNvwH8-nu8&_nc_oc=AdrESWgkviEYY2hJ2OM7zP33Q3mhA1C1dsku92fpDFH52UPtGPBL2ssnBECQ6iOQuNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUtsFtR-DxdZrXOaP9hxGnRgMR1j7zG_TY-HE6OVacm8w&oe=6B0F1DF2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTId_zAfm8IQ7kNvwEwKhw2&_nc_oc=AdpYHIkyRduOyiWPht2OnIUhuBuC3EdMZI_aPmzZdlIZQyTB_gQqB0ndS0v01FJrFIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWk75NAzfdNU-27U0aaqzS8YRfPSW2cnfpzHOnG03KRgQ&oe=6B0EF897"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
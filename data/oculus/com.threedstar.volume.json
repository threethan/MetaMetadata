E5-9cH6Oh2Q6ZFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALXtTWdtuhiUQmY-hlt5_AeWjGXFt87LmDu97K7JhrBA&oe=6A5E067A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g0oWcloGgcQ7kNvwG3uCiz&_nc_oc=AdqMXga2cL9q4l_KivGMvpSWpXB1BqU3CJnwcD3HYTJZ4zcKx_hgsU1Wi3yRsYHwJ4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyVChAqTTiUvIjgw9y5v_3P7P2_gCIaH8bigz23EJaZg&oe=6A5E121E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZAdR1Zr5v8Q7kNvwEwjcr7&_nc_oc=AdrDk_CCR-2haR8vwgoWrhiKSVs6Vf79kbw_6F15viYekTNGeU647OZC6fs40vFnj30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6MmefF5QTNsiqGQfrj0p_FqzmEAScXrvWSY2uIG4vUg&oe=6A5E0709"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOTJA9ZUpCIQ7kNvwFAwm_e&_nc_oc=AdoyTY2x12QRND7pb_9JdK5e6XVZFwXdgILZ1KGz7IKcbruLerpctK7Yc9IMg7-NLx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh2C-A-5C457gJpCTOYcsvk0Y0Gzi-RTnDjtcsgBT1bg&oe=6A5E0472"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgnStCuws3IQ7kNvwEGgIMm&_nc_oc=Adqh2DGtksXQA1_649It-Ck0RS5xk4EeQPVA_q6EFwak15nyx0aXzY8SaSjj0TlFOdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0lbGNY96r1MydT2401FN_xF1CnJZlQMSf4lSc1SI49Q&oe=6A5E1757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
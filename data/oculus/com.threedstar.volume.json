pw&oe=6A972809"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGPXAs20MdcQ7kNvwGEXEbt&_nc_oc=Adqkc6xZ7Hoq0gVzc_e_r1TnXrWzrT78zS0CH_R34BeKuL0Vth0o8f5oyQy3yl5IQa0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl2BSsKTsExkZ_z_UOqOo-1YCjrjg5TqelK3xrdL-UdA&oe=6A972572"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVbppxYAA-QQ7kNvwGv0SqU&_nc_oc=AdqrCurFafmjr8VkscSZAvh8c3Sv7KlbV4Ka2dWhEfEtRXcqQviwo7EfbfXqjIxiXQw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8DqbcNKT_pDR4WF4lkr2tUfVlGIodyC_8udSL6OM_fw&oe=6A973857"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Conn
Gw&oe=6A170E49"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWOaXbnWxW8Q7kNvwHFlJNn&_nc_oc=AdpJVXQiA0OknT6B41spEwz9ljIY_c1bnrHH6Dgp_uIX2yx85h0ID2U7siq7MXLMEDM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qE2yCAmAVZR8lpGD1NwC88Cv-Yd1lwzrvSxJBob7I2g&oe=6A170BB2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4oEBDLiLsMQ7kNvwHBElQM&_nc_oc=AdqCf1yMnu795qza1j-_8rMjbb0ckhoft_U2_Q-dCvxzU6DWv29di4ucnybGXT97K_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af425WDvwr8jMzBk5knaYcaBsm8KdlKtE5mg3jOfNl9Jvg&oe=6A16E657"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Conn
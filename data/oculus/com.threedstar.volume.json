_SqQq0C5-zrydoA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6KHPytxTGv7sOkx6xzkUNH50GCckIImXad8tWyAh4Ag&oe=6A8AD97A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1SKuGp2dMQQ7kNvwFedZNs&_nc_oc=AdrRqjWe9nUWtt3t9_YBG2MTjLeGfougqJa71wRJt_AR0WArINh5ecqwaeEwr2SspFk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSI1qsAJeJXrbLp2yL8ZBvbdc1gPfpiLxaIYSSl0JwRw&oe=6A8AE51E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp9n19rnn64Q7kNvwFb04v8&_nc_oc=AdpD3mlKhHqO09SnUN3A89jibYPlT0ma_QqJ_O-8aKTu_LaNuEZtsA3KNS5y0tUsITQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvd4YtyHjHJdugPQJAgPc20mykCp3taPENwgd4gahrvA&oe=6A8ADA09"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LccgRjyLk_AQ7kNvwHowCTv&_nc_oc=AdrWdg7T2LX0-5kUiyg57ChM_NmRDHN6s960yuIQEeUFYTwWnPTiOObDMPcV3WNb3u0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZrmidcycd977skmwvGEvHIgK8W5mwsFj9-XBL71jQYw&oe=6A8AD772"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXuACGHRTQcQ7kNvwFFIR0l&_nc_oc=AdpGRqwj0iUrplFANZyJehdnGw-Y_Ttuz_DqQBfyE6zniVwQ12D8RE4BELqq9P-wfRI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSfMNZv57hM8aFCYHrtUEWFUygoCcJ97FrAUBpZ3blqw&oe=6A8AEA57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
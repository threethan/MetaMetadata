3A&oe=6A6CBFC9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrmvPuFwH40Q7kNvwGQWdNv&_nc_oc=AdpHOhCFXDNMab1hLPOQCg6HYH7fNR2f_BSgiw42F6DKZnGPqE37a4SVxuQAJQkZfpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9hhVgmOK3G62mWbTzPuM0JoS3Fs5-b7lEsesi6e-AiA&oe=6A6CBD32"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UhHWxiAIJQQ7kNvwGUolNP&_nc_oc=AdouPt1tgpTDDjDu1aXDF7lva4F5bS2EiVI-9rg-a10foOz36MZSNCq0TA6rFfU4h4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvHLIDCrxxsMp3_wVHD3ujQmlHL0aXVLeAaM4QNpIQNQ&oe=6A6C97D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Conn
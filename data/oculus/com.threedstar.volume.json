Gw&oe=6A413E49"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPCTW0eEOLUQ7kNvwH4ZDgt&_nc_oc=AdoyMNWo77np5dMRlh4qhJ5gvgO98fvYuW4DsB0weh82mROGZ8Rag58ezHevCSLi5ik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VwqigNtvcPiQcOc0_WdnC6MBmLtd_nCHqESXHhX5t2A&oe=6A413BB2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmnRxlgucDgQ7kNvwEXlbVU&_nc_oc=Ado4Dm7aUIQ9Qrzhx7eqCshp6VdZ3b6ObaM3vKP4B2iQ-IwzGCQlM2OiiYeSnAdU8eg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mhbO3zfxKLNPToUyI0oT2XPCL1RgTthjKFSTvQCf2YQ&oe=6A411657"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Conn
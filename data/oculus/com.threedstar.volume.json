Ihg9AD8bWg72PIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4zNg1PTJZZhU3c1F3jBU-a8cPrn48fGZzQYfg18-vCQ&oe=6AA2CCBA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bsy27NNFHF4Q7kNvwFepWgA&_nc_oc=AdrDz4QbzUR4VpWRKj4DriWA4sHqZC5gBSaH515BmgrosPi4JewbSGljrH4bSN1lft0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHWRLWmmMik_ru6vvghPIBjwIQURdlONyfHf0aJbCRqw&oe=6AA2A01E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKCKOYPMEcIQ7kNvwHT1bf6&_nc_oc=AdoXzSGZrJ_zfoEwZ7r5IPqbuQN4XZJQ8r2cu0CspEHluS2CJ7pQRrFORkVS1eVIZqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISBRboD44FS5NQsQaGMsuYJoHT6IEAXV94BxBY6gpK1Q&oe=6AA2CD49"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bLIiIlSQW4Q7kNvwGgb_Ic&_nc_oc=Ado1us_fDH1LbxHe_QHMayYhEPn6wZJGP_jPpfhdQbAjETusAApqTJ7IQFXL6v66qeA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrX2S8HZUeNfm9dgr3A_Bn043O4Z_tQJ0rcL1LdUHwkA&oe=6AA2CAB2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1mU-pol38gQ7kNvwEi7SyW&_nc_oc=AdrFjNPvPehXZ5OZJVpoJteSj8xM6XD9iap7_bvaq23sHui4IGJZDFvz9ogFdgNsoTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU-xUsJQrazzrm3tvOhm1TAzG6e_pnu8Qv7IfnQxz91Q&oe=6AA2A557"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
kkmhA9-pRE9l-ZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h9mTfFYU09SvqP__DTpY08j8qVwvugqi2QYV7p7ytjA&oe=6A26DFBA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gq51y2HpCx4Q7kNvwG_SjRH&_nc_oc=AdpLF4VILVOXTDCtkCd_fahpv5Y9885u9OkWjGogcLt02qShS3bfGMuTL0EEN5YRQdE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pc5Ma6xiuF-VmbYBecr_ed0a2arvFQcZDVjCSn7rtJw&oe=6A26EB5E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zbwg_p7iE98Q7kNvwEK45Oh&_nc_oc=Adrjk0krKTWD0NKAnhR7nNcIOmfYw3wc38tLX2NaiiJyOx1h9_qB6IzCz9lktQSjrpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qkrOu_Wr42c3gZJNQcakl_H3GN-MHxsPj-mXGJpGCQA&oe=6A26E049"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W5t9YE3LjIQ7kNvwHq_DPb&_nc_oc=AdqJib5OHCM8jQganYg7IlMSMp8gmdYN09TfU_305ojeuCe6vKGtsvEXPO4nPZutZhg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m3p60OcXBH5tE6bUYMAK-QA0j24ZwUyJGmijJf1IRJg&oe=6A26DDB2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76_5MdnIotQQ7kNvwFcmPQg&_nc_oc=AdoNyWQ0a7GX0wyb1D3p1KK2KHmVfWTA1eNGhl9PEXHB2Z9kRvc8yvn9eJv6Voyy-yE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cxwczIr61uTj2kk1ZzKpHjq5eo1CtiZjs6NABOzkpTw&oe=6A26B857"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
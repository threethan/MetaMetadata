-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zP7mxX78M4Q7kNvwGAyXQU&_nc_oc=AdrlYIzNWIkfiDAa356mBYG711QeXMFZ_4AXEybbN1anoFSA1xe0hu47kSHbqlGF9lc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6aRFyTO5PvgtoXt-MZZVFoHszUkctvcidaB6eWfJXrQ&oe=6B030A3A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGCIivCyGHgQ7kNvwFMuRJ2&_nc_oc=Adr0rJR_fxuYZBm7Auw8Sr64WaLXOeEIyHM9dmjxREJLkIer4Dcz_ZZLqcsg-dyy8FE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGCtcy8yY6vosYqD_usFXbg7-UrnkVjd6Gxk9mr0j2Ww&oe=6B0315DE"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXfhUAwkb9oQ7kNvwHnDHuo&_nc_oc=AdoXCEr-EfIet5V0col7nJ5V-2hsAtkOlambo2l1W4b8O3tLT5NR18VA0y0d37eiuLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9w-TdcYSFC9tNFmIhiybS43s4vaLZjsJK2ILt_W33RA&oe=6B030AC9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J31HGuFHhJoQ7kNvwET92NI&_nc_oc=Adol-6eTuW5l0a6Ne1-_SKa2JGjXf6lkXOWVRsHv_f2sRV1tugK3Sb6XHy4Ng4H2WTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6u8N1rIFrJsjoQ8BqtJAT8Y_6AZ3_8QGiLQYTBezGHg&oe=6B030832"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7-HzTfk4HQQ7kNvwFfiSI5&_nc_oc=Adrn8MAWrSgdY6uo4ZljBZtH1VxUSeZkVTHJEMDicvtISzI0KQRm4c9n4ZYyy12rpDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ1neR0kFmdJuXtN3x3R92RxruMOsEeGhXiNKpzeUIrA&oe=6B031B17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
AfDLOXfe_EMasD0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS_v12l3q9D0vBvWjBiwwaZtU9bP1Vc4N4MdhNsGTfog&oe=6A92C27A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia_9KR-avO8Q7kNvwE3B8OI&_nc_oc=Adojax-3A9r9EMSjUCrsz6qRzLJNQNsIKMdwntDZwK8R_pVP-_iiKf2p_UN4msSeY5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFomMV8wG-6IOMR94fjHz_v28yNJaA_3fjXUTS4S1WLcA&oe=6A92CE1E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NlWOy8vY2EQ7kNvwFF63CX&_nc_oc=Adp2lBStrgdY5-i4KgcRyluPocutDrHmp1gWGsyz3iSJR8GurWFWBTeUshalvi1Slxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjiJuw4CRQeLwlUYdJQIUHgIfbNza0qOzC8vLlD0XLXw&oe=6A92C309"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx0fhOR5ET8Q7kNvwHHcSWv&_nc_oc=Adr_K8ZTH3iDlAHqYQH_OTf6eVawgjb4qfdDzfJ_wSp3fBHwSeJ0KwSOzdl8j5G06iw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlv7_2MtkXnveuvt-jGegvNIfl1JEH6wYvizCXV4c9dA&oe=6A92C072"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7zVnf-R0MwQ7kNvwE7YzY_&_nc_oc=AdrSueJx3Fi_yUmUdEmcZEflxw-cjtfzdoXA2EANGVCI81vrPr330FMsYPFS9HKNexM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHzhJr9rle5kUXypqDp8rx7m1ZqkyiPhTkexi-5ROluQ&oe=6A92D357"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
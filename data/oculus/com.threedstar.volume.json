fMpLkeI7i2q3qws&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4_te-vXzrk66yvm209F3pbtQgjl67sbBiG9Xbt5ys5w&oe=69CBAFFA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUcrEveM8okQ7kNvwE5-uaO&_nc_oc=AdpcuMH9NpT5RGsVc7G6oW38MaLVRL1uLx-XpbffQaNIuB-zN88aBt2Bji-3ZDt5Td0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcNqTtSRKw89y-HKNp7vP9f-VHzQCkEXUpF22fZi-D1g&oe=69CBBB9E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldpQw2SV6eMQ7kNvwFe6XEe&_nc_oc=AdrgGl3q_gYKwtuR45rPB5zNLe575nas_brm1locndzahqk8kF6c1Cv06DidIsFiHAI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1NvV0jPxijisLK8HFumgfLLlQAji41e0q2v-65g9leA&oe=69CBB089"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njPXMDxXrkcQ7kNvwEvenWP&_nc_oc=Adq3ZsrMEoK82TSq43IsGIGrfgGZ7UoFPfo-3rLoVu5JHNmFPAlNJThWeaNwAbnLoaA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFeZwlX5tZEu0RbgvJAxK4nL5KVnDX7M3FrSnRLbcLzA&oe=69CBADF2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqVcTfMcnp8Q7kNvwFUFd-J&_nc_oc=AdoxeS7L0MbpnIZk2q00VPfDrPfIcd60toRn-banYlMwHgrSeRvkOsV4VGJ_e7u3XSI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJPtCSuEFnlXTpu4YJiQYg-9onXyZDh_QbxKfc2on0JA&oe=69CBC0D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
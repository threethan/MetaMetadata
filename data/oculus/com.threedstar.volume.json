ontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNjxbQVdCKoQ7kNvwHwBVNC&_nc_oc=AdmO6N3NuD6OfaSy16mrcfnp_q_dDuKXxnVC53aviBgnAslhvkGEDJl5RqfkoFOjUlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzOnnb-DNejqW3IQdVncW-Fp_7oQrzSrJaq7mvGJ146A&oe=69B938F2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wQF8Y8HBjAQ7kNvwGPFXGX&_nc_oc=Adlrk45BBLvIvScI_bFIsIxrM5mNzKkFJJ5VF1jiKjXcDyJEc9SjkTEV3U-Hfj0Btds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpEodrbRz_11DU2vvadhCvjIUSKcpWcW89id_ENKmyDA&oe=69B94BD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8689010311176850"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "931943002212171"}]}, "baseline_offer": {"id": "931943002212171"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730906880, "status": "PUBLISHED", "id": "931943002212171"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8657695637641651", "version": "0.19"}, "id": "1422341928183122", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4984962741581644", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8657695637641651"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1422341928183122"}]}, "change_log": null, "created_date": 1730426252, "id": "8657695637641651", "version": "0.19", "version_code": 19, "rel
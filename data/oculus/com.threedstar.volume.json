aGLr5xzbDlDW2Vw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BbtuwlMl5_9suBf3e5Vonn-0njOL5FzXR3WRB5ltNOQ&oe=6A146ABA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgoKXkY2awUQ7kNvwEQLb6s&_nc_oc=AdrjetCvxADeJjgb6KQkK6Rbwxg_fQneLnhUxGvbB_vMRd-AVaXY7ddsHoAYd-GHT_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_FmpNFpqogyY-XBjR2DCEeF167-4RCVkfUQ_Fvpd-JA&oe=6A14765E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5ITAcke8poQ7kNvwEvZBsi&_nc_oc=AdpwAVnpueswiZ76OAvUTUc1N8jRoFEgL8YWYdeUYzJldBbdi0lmTBCzv0PIBMQ53X0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fSAelE2j-Drd85t2cmSK6khFTgVkbuuA_2mQjUTm66A&oe=6A146B49"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQP6sotIUScQ7kNvwGkMi7O&_nc_oc=AdpKSuNWaZC_hqcEG7cuBiGIThj0qdyCQ9vSyQOJanmRHHhf8fCUinT0CRRyzR9UyLQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gCFRSwhTwKXUxjOb6MI8KtZ9dA47dm6ZhzevR5vv0xg&oe=6A1468B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ir59kSYRuwQ7kNvwFZizHy&_nc_oc=AdqwT-a2U2rlh4BOhtjxdOijhcXTnN25JI0ylPK_9eKUy94W2Q1NDZjrfu9Fw70RgZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bNHtvDk52lGFPj0M6IOOOY82V4IGi_rtolmZ0-4C8xQ&oe=6A144357"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn0gyNqu_GYQ7kNvwGTSN7q&_nc_oc=AdocOdtdT2FACnK2bNxq2gfusU2sLnNOqlwzDjKZ5fQWCYcaBJknaXntFtii9-_wcRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUn7Y9S6UPazhR88zgl_0kXQevZhMq_vnb9YL3N_UWrQ&oe=6AFDC43A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvbTXcShLnkQ7kNvwFB_0Rq&_nc_oc=Ado7W4eDZiWC0jGRZ0PG233mqm3rzCzoSoX4QEiN3BXF_Q-O4vNNiIiD2tHEKLogGZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrGVstJbbLAzd_qoYQqAckSEK6ze4ybV1Nv-_UPnLrXw&oe=6AFDCFDE"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC42uF3dLxIQ7kNvwH0spyA&_nc_oc=Adq-vZq6Xwjl0qhTRj_LDSjMth_cGYOOj0YQWkwizikGrxOfK0TlAwHcX0y4NzSA1M8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn6zgzELcHiBAhnax4DaM4OML5bVndXD1alxQtG5rl8w&oe=6AFDC4C9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VsfthYwdBoQ7kNvwEk57AK&_nc_oc=Adqkqn089ef2AWpRibTf5S2P8cRfxg7exbrVVKTNl2HADgJFXlH4dO1Vpvo-5xOj_kg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOMaEuchmWYL8PwbyCqzLJk11nCqJi-2BGgS1dLEZNsw&oe=6AFDC232"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOUCTmjBVHgQ7kNvwEqeL-g&_nc_oc=Ado37aZH1yMPb4ZotZXUmlRecfH1r8wEVN0j-skUku_GAEx35aworwR_EC_pUyDKoIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDJFF99GQAgTFA4fEf3a9SLTRvDcMAl1a0Wifn55QLZw&oe=6AFDD517"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
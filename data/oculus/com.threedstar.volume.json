F4q3O7I5MxBtaao&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtQvsA2eS6lLPAhA4xEU3R9pczCYggPZnYk6EVZkxIgw&oe=6AB6933A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1C_BC8dPDoQ7kNvwGy5euA&_nc_oc=Ado0nCGTLdbeXhUgZvMYGHVafIpLiBcxFLm2WU3JMpIIF1uCjg0C0d3s3M0djEjVbD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlsxC68_voKK0sqtFj_A5F_IB4WkQvWz3ZtoVVW3YOoA&oe=6AB6669E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA9NDwPTzI8Q7kNvwED9nrz&_nc_oc=AdoGfUakzKUnpqO2yzwEAeKx7MaxhQ3bQUjHBHOLLIOu71IuvDeMe3wpvb2KWTizoWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBnRWAdOJ0LptWeMJ9M3-QLKUN4N4jjifslzRSzJscBQ&oe=6AB693C9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KX2R5bMLqwQ7kNvwE6Z7tg&_nc_oc=Adre1m3gRFSVZ_i_s_9Mcpd8pYnj3NUbsStw6CGS-w6qvJ00ETs6nBUyYQ7GPlKtW1Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeZ9MagHjUNlpjytSn_h8lmFm3EEtZvDVzhYrAuSsIMw&oe=6AB69132"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF2NxlZqKaMQ7kNvwHWhXwv&_nc_oc=AdoEqt9mC2SZhBZkxD8RPMlR9ThStFHWwRt-FTFGBMUW4ZvsDCBMYgKo-7iIKAGdEYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3F8uyFHmnCxDyGvkAjuu1LXoCa9LrRMrQSTVv4AAHWA&oe=6AB66BD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
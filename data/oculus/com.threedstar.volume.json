-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zP7mxX78M4Q7kNvwGYxnmT&_nc_oc=AdoJAN1xpJ4pSI8Ov6Pw7iX_ja2AMNfK8m3X42TFwmAeahLbNpuaNms9XMPbMFwOyjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY67yfovQI-9_AV7DaN-HOZ3UfTvFQAjx3Mc2XTmasdg&oe=6B01B8BA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKuf-f7wZxoQ7kNvwHDZ02p&_nc_oc=AdpD-a5uJ9E0pK1oQEP8dM1g0TIYBmQry54hlH174SshTwrrr-QUyOw6oo6owH1rnGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbACyBHTPm3Ux445BsllNoLCuAi-p6UtVo5sMf29ZhmQ&oe=6B01C45E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXfhUAwkb9oQ7kNvwFkRkBm&_nc_oc=AdqIE25ZH-lP0bYzLjEcsVGi0-U0Oaqg9QDjoXzVPVxW6MsqGiw9vNchYmTEdlTM-4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Lh40H5M_rtZLIpKqH9D_juaQmBknwEhAr30Paf1G2g&oe=6B01B949"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfkrn10V5bUQ7kNvwF85_iY&_nc_oc=AdrLuAXh00wsvh2ml979GwTnp-YS8RnqlytZ2fxy9d1gQ2U8dbitt7wirZiAFnQtVWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgBxR9CV1iRzpPL0V5tn-q-WDW1Maxm8pSAU7RsNNSEw&oe=6B01EEF2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7-HzTfk4HQQ7kNvwGxvOzr&_nc_oc=AdpIiqkne-enjYGxPVInZNtlma2-E3uSbxafnEALtxsN7XLfkgiMhaBN7dVr_aBceKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNR8V416UQD7fij3f0jbttzvj8xiGUbK_CGuzI57EQJA&oe=6B01C997"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
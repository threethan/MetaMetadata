-EzRjQuJAMDzugk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXFuTMploXUAZKYKAlLDU0Sf_Bb0Zg_8IkarHp2x7h4A&oe=6AB29EBA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69mGTFjt7-MQ7kNvwH-W-fH&_nc_oc=Adr7ykCiQ55iwLRzU9_35Y6YlHgLy2-TvufzK-n-3wneNH5mxvcs7LGpFvrarY70E6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhNBAE4Ie0yrNEl0Ye_ZfF6mudM-z2HIlapNZP1HROdw&oe=6AB2721E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_oPAmmieYAQ7kNvwEqfxuP&_nc_oc=Adop-DveZuZizEso8ZohH40nE5VyFpBwLwkcSWbtQgUPAOa_3vj3jNu9Cbv9Gl4HvnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2iVHkFoEZzTfuzpKKXy3kTVlhnLNzJz5-HxfWk64aLA&oe=6AB29F49"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3ExEHf9dAoQ7kNvwG49HRa&_nc_oc=AdoXPQqCV_CSCcTfshVmLp-aINzE4-CnD1L7ZJomhtocp7Z0AIIvfRhTpoLEFcVyyLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAUtck7A-FXyHtAURfp4UAL9UDDnILwC59nZzoVFbFjQ&oe=6AB29CB2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjIOqH5Pp9MQ7kNvwGczuTm&_nc_oc=AdoWmGT0wX5MPyvtfvu6mIOOSxOEO1VI8bee_UCh387GljtdArexuYljgyM6nlFR0HA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjEn1HH4bJ8iZAwi7mhdN4FXIxyx-ynBdspuzkL4sSLw&oe=6AB27757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y153aEs4sJIQ7kNvwGsqSS6&_nc_oc=AdoVluUK5Yht6T66FExTQLUosu6mr6W2vB3_bVYvP4x_HqYLu2dT9REbWAsBEKF-jo8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8zy_BoKXeiAr_PV_WMm4u5Cko328LVkE4l7pQy_ZrCg&oe=6AFC72BA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvbTXcShLnkQ7kNvwG50vZW&_nc_oc=AdquBvoPDj9pUhQqP3tumtgLe1wgEOHdtMms0zzx_DtSCDHRQS_KNAhe3WofBigdbFE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnWavtLW6tt-8uchA6atz3N6WQRp35O-gBNnGnSAHR0A&oe=6AFC7E5E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxwgCbVf2BwQ7kNvwFmVj5A&_nc_oc=Adrg5MPtQEhs4d1JOrOGNC1p7J89c9PXctOxbR-HzIwSt0BZZutsSdbc9ENj_qC30WA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8nJBA0FY3BMsycnGrQwQnkBxnl02Lslho3QtKgOvuEg&oe=6AFC7349"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VsfthYwdBoQ7kNvwGu6QWQ&_nc_oc=Adp7IVwCWs_u6NdDukU1UFZ1GUFcCYLkM5wlRkigIKAgRAt1uR_FGfBOn0YjpYjmKqE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIhAttv1X-zJr29ExVkf1Y_LvtRM72IqTLAGKrqgsVvQ&oe=6AFC70B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOUCTmjBVHgQ7kNvwFno2P-&_nc_oc=AdpKA3uXOsIM3GnJZdwpqmTmoMsY5H7IVenMqmR6m1Y8QmMMCnDfwCcmV5qFo1bLons&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFqJqcP2K7uHRKAhcA04YIYdjQT6izmIOystCaJZIUyA&oe=6AFC8397"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
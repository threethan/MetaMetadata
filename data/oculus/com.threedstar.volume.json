-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9ITyvuotg8Q7kNvwF-se1B&_nc_oc=AdqNehSMdT1aCw6D2z09HbleVytwQjRug2L_tRGJrIcqMONzTG7hX8CWTh--XE7cluE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVGV7hUG8CISoVmxICZoz5pq_rudXbS_osQntXV5lwpMA&oe=6B10393A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRDC6wjvviYQ7kNvwFptxtb&_nc_oc=Adr1NR7dDE4Y21SlzBLomwDPwovvwh7w3rtHy8sAHPpSKOzsL0FVT3YyqzDUvhNGqAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqRklGuBiTkkMgToIFSpGuAG3mUmrHTQROIe2H8bgqVg&oe=6B1044DE"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F49w2_GYlKYQ7kNvwEHOWSI&_nc_oc=AdovTWJJzTzYP_II_IbCvIOdcwgFvhjo2d5Q8aLCzWE1RArNu1588f9paOYZAQAYewg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUl7SGa7ZMukKbtx3y6ZUjX8LPxY6tU5rUwKM4ApJeMw&oe=6B1039C9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msG4QRsC8rMQ7kNvwHP96HC&_nc_oc=AdoZxew8RIsB85AOp4xLsm2BSgv32UHtWpQGuP-78PEJCy5I3ahRtknNd35HIGtOYvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqiKCkxtzvyutZ6thM0qRGZy4nSYVmJTOH75T36DOwmw&oe=6B103732"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm3eX5KdbrAQ7kNvwG74hqm&_nc_oc=AdriiNNg-o5FzZ3RPhbqIGvzZ5BFPgzOxUsdleC71TunWq-Zwgm7BYuSIVJnulrfYnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCm5YD10-PfzaUo6g1PYGuvbMsVJYEbUz-ud69OfXkGQ&oe=6B104A17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn0gyNqu_GYQ7kNvwEx1NUW&_nc_oc=AdpNXIO6fYmoXziID4wvMC66gISCRoTS7PR3E4BjNhJ95fpsXytorEkhfWpHln0yh-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxe8ozi_-0Jczl8ovKj31IDjq8q4WTDvB9iS-8U6uiKQ&oe=6AFF15BA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvbTXcShLnkQ7kNvwGXT72_&_nc_oc=AdpHMFIBmFoxgdw3J1dPnntIgKvTXfYFTrJkRKEBXs4z_5Zw2IgaKrhBIRukL6n7R90&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBs13YjNIjA6jkDBGjbhTUg3t2Xvt_9l1LR74t_jVb9w&oe=6AFF215E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC42uF3dLxIQ7kNvwEYFCpf&_nc_oc=AdoQgMe7a-afcOeN8KRigY9NdLQyoAFPslVPPoMrGUTk98jyHUXSndzt8g9t5kqbuts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnJOqe7s-i6VXqUPWUsznsyFp98yGSOhl251zKv69z0w&oe=6AFF1649"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfkrn10V5bUQ7kNvwE7Pjn-&_nc_oc=AdrZiiT1giu1xu8CFS304E7jx6IW9tdAPWZyIsjZ-GNif-QgdeDPjk5OhTJ-nwmmt6k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGZNakg4H4PM9OD3qw-AnnI4blDrOFp5UXDDcA-Qcohw&oe=6AFF13B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOUCTmjBVHgQ7kNvwF32TZz&_nc_oc=AdqROJM3toitg7G_D9L5KYnHza4UHeZ-5lGyIsK8UTkAVrckcWWJO3Cb1Qho-pFGosU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR4XOhnBYEgSrxVzcZ-Mc680mBSgmkT6lzxJsbH9QFTQ&oe=6AFF2697"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
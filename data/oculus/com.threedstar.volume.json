0tL0EQ4XR7miWA&oe=6A22EBC9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY2eeVlHf94Q7kNvwGPrA5-&_nc_oc=AdrEgUZumlOa8HvFnLlL7mbOKJX4BM-PRkcD-nJJpoEaEYqjSZFRiP90P8EcfjYAaFA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZDEFHuawkop3po8draCLBECOfexB6xAA3LPZZBE43NQ&oe=6A22E932"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN_mpIhkKHIQ7kNvwGoCBlF&_nc_oc=AdpgnCRVlD3LP3GqldVbwkJiNqYOCS8dZQ0rkDPUIZdRl3s6zuTFASPCuKuFIXSEXWQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VhTeSjL1UTis-K7FEuyoYtBAyxzOYiZlGl8CrO-zhHQ&oe=6A22FC17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetoo
4g&oe=69E76009"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU4fkK0EIE4Q7kNvwF2Z2JH&_nc_oc=Adobr-31dy8rqy4Ls3MGIqBdY6jdSuMCqJZD-N-VWcMiV9uN6iJhNJ_fOnXBsE6wiCA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WrcDjFyskCAR0xmpsz2toPs5l8mbtcWOchnbCEyH0Gw&oe=69E75D72"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrM_f4sNzhkQ7kNvwF4lvc4&_nc_oc=AdoYrYC9s6Or2uQMGnq3ol5-2kkYusSHk6fJtu3vIsXKEoLGGSRbE_ERurAS1vhrtjk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SaXVIXAP6y6FM4w2uZO0Zc9GvMdgQWXxUMX7imGBA1w&oe=69E77057"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Conn
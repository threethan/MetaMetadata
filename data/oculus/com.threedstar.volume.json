RfTh8Kf36M8Inr0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOAZXYOMIIHp5ZMf8p6hj0X79au-2kXBMlheJq5lEQlg&oe=6AC7B6BA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxE4MdsiWmcQ7kNvwHpmjI8&_nc_oc=AdqLlYjuZE9-hrpqr0fl-wHzVulUb6OdD9hv6qtueZRGuEaX4yI4gBBlKvNY-TWGTo0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv5O2Vnt_cEVGzENhLk3nEvq6PkEkfyFsAI9imSZtacg&oe=6AC7C25E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxrAr1jPv-AQ7kNvwHawNqT&_nc_oc=AdrL4pZkg8NAqXlg5LcW15iQVWEjgRNx5wvcQ47Axa_zRvX5tzNdD52UupzrjMQOfKw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrfvG7AUsU49C5YdePjo2xZetaEN9BvSXZqvlYD9E6Ew&oe=6AC7B749"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84zdluquXDgQ7kNvwFODhxd&_nc_oc=Ado5d3IBdbD5Er_1n_g2Tb3ejJZHndnlPSzlpdDeghM2cMn7Ku06T7i0J1OXuKHPbrc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSVGDfIpPgyQuDj57pRGTongGADBJanRcTu7eoYYRnDg&oe=6AC7B4B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8mNup6rh7sQ7kNvwHCmuaH&_nc_oc=Adpim6hxHNzXj6hkBgitlyC-K_LW7iqGzAtJYaXjAvNDGMAzP0QO_hsP9s23rmDzzVU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9imQ1nXJSqo7H9557lasF-j_lyZWPi6PQnH5JUj-lbQ&oe=6AC7C797"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
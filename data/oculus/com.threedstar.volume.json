Ew&oe=6AC7B749"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84zdluquXDgQ7kNvwFODhxd&_nc_oc=Ado5d3IBdbD5Er_1n_g2Tb3ejJZHndnlPSzlpdDeghM2cMn7Ku06T7i0J1OXuKHPbrc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSVGDfIpPgyQuDj57pRGTongGADBJanRcTu7eoYYRnDg&oe=6AC7B4B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8mNup6rh7sQ7kNvwHCmuaH&_nc_oc=Adpim6hxHNzXj6hkBgitlyC-K_LW7iqGzAtJYaXjAvNDGMAzP0QO_hsP9s23rmDzzVU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9imQ1nXJSqo7H9557lasF-j_lyZWPi6PQnH5JUj-lbQ&oe=6AC7C797"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Conn
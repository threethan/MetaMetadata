5RPdt5i8UwtcWbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkUT8vSDKgPiV3KO6VkUwed6cQwaqkGd4JXt0Fg3yx9Q&oe=6A7C58FA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUvEqi0AZDMQ7kNvwEvPqGw&_nc_oc=Ado9FKi4YOKdPT34XOrghrITLP9ur5ib3hMKV5AUUnM9Hi3VGdBFj_014dhh_ZJY90I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeDCgaeJErnlgM6q0VGBiAphdEmLpOWha_I-u6fVG2OQ&oe=6A7C649E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0lrYc0DmxkQ7kNvwEQfgUm&_nc_oc=AdpnGOvIVjWFWYEtVKrAZhLp8JppD3ZZQVJC0G64kjNjoC1F-VUNxJTx6S8sBU493UQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvZHfHhucx1-Alwhg5N79GjLWq67P1lp6oBH2h7hfS_Q&oe=6A7C5989"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxOS4YTD8nMQ7kNvwFbCcA_&_nc_oc=AdryPF90a6h4jLydPM2ZudYmnSpEVk2HYrrulcWO91ENFCYHlQnKjzQa4p1ssjUEp8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK3C6RgFmUrAbFu5NFn8jzFKXhnr9spxe_Gor_tdXnPw&oe=6A7C56F2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Df-yp2EIo_sQ7kNvwG7eBbT&_nc_oc=AdoqTZ3sWT60QxJ8ERdblW-89mywESazc3cVDbWhxt-IbbEDjumamFeIJP3I0TUol-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdrF_GMsUpXqLb-Tud8-ax7SXbXH5vzzYbcifRVJfNyA&oe=6A7C69D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
YMi3Gm5gtjKY-zE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsAdW76-G1YTYgT_qn_qMX0TQE7ZeVl4ugcd7S2X0FIg&oe=6A9D86BA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMufSqOfF4sQ7kNvwF8TQw_&_nc_oc=AdpA-E2L3aOlcVAHhevXZGpUsa6SeCPam4AAgHu2zm9ptnAr6vaWTSZ3Dpg88bcX4sk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInsN1I2jnL9rKvKFAv84_j3Zx7p7YXDRxXxcOzwxLnXw&oe=6A9D5A1E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oog2KXSl0eoQ7kNvwHi6YYr&_nc_oc=AdommGu4_wTc85z6bwNbdYxD8doQHFhtzmg1MIIS08E2S9XlkqQG4sWPscOc6Zq8APM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdeISFQ8vJNvGrytph70L08TkREdnU-NM-vWiUD77N5g&oe=6A9D8749"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdpL0IjCtAEQ7kNvwGdAFN-&_nc_oc=AdomxPkd-mVLFlcyxkES-GL6MSx9WDryMey-exybAmDIoKGY4dMQzvEDrKs1aVtxnEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLji_Hpf2gZfpMROVsPvc1KGNbITqDGR55N-kRSSiU3Hw&oe=6A9D84B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv3h_k1cJs4Q7kNvwG8G4wX&_nc_oc=Adqp43HmaKRRq0dmBOhN96FGRyUlwjhO4Fmqi1o3RuM80MZKKtn7mlnmmPdRsEsBAAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4izl507XbA0ro2Iw0eQujtoXe9iK1aIxre80az925sg&oe=6A9D5F57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
wxNrcKJc8VijVxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EarTUAn0y6HNvseDaGXomxzqRd0X51sPFTFdhv-wUBw&oe=69FB5E3A"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu3aod4AhegQ7kNvwEMo4hp&_nc_oc=AdpAWHjOJahKgPJ_h2CJIUZ6ezNOW2FtR7bd_4mCrxXDQTrK7D-b_pFXe3fPaM0bOAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jXZS_PD715_Nn-UlxWTmOxr8YVGMSEzuFSFgDkjnYPQ&oe=69FB319E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gJ9Nn7OMsUQ7kNvwE2_vHd&_nc_oc=AdqiTa5BswXJKA6lCAY572mE_mfvdfvUIpwEGqBNyydLvgPF1Wn0tNqJN9KfUafqqWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XVYkyqSrdRYqc12sDdXDl1_1nFoiLqct06Xl5reJpUw&oe=69FB5EC9"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edIsRj4bGp0Q7kNvwGo-c7c&_nc_oc=AdplEONX-s4T5JnThAdFfhvSHej2wbbmkzCSjba29pekuee2Me-BY4Y7BRTBV6SeeC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71FtdQZM-pPrrDpOznytInAkC8A9sQHGvlxhuOBh_keA&oe=69FB5C32"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuGaOBvpJ78Q7kNvwEazWvi&_nc_oc=AdryLVXAOwLOk0FlRVGzHiGc86FctfD5LIOhUmtLPuNN6tWZ8oGVC9vWMaIcOHV-9rE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E7loqw4l_-4a3Z3dDL2GEFmtqDPU7FvziK4Ck-LIegw&oe=69FB36D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
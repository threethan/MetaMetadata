-25/75393561_2974363369383617_1461363991548440522_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zP7mxX78M4Q7kNvwF2M6eL&_nc_oc=Adq5L7mIkE6jOI9Sljv8lEcsL4nxPn3LYO6Nq7sHKt1UruooIjAmGxNWNXSHypgD6XY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz9i6A4ALYYJXfU0TrNiFIBCxXvUSLo9fRkJxc27maKw&oe=6B045BBA"}, {"file_name": "Screen 2.png", "id": "1305046170670187", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035363_1305046174003520_1459331477914301738_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGCIivCyGHgQ7kNvwHhAIqd&_nc_oc=AdpwpPw9Y4Zz1Knt1Nwn4tlv3mx47uEC1MTzN5U0hk591cWW_C5ecWR6unzkEdCqyrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbz0W1uZnX-eHOOrkf7KqetjV7MTFi0QqOwvWu4ddyug&oe=6B04675E"}, {"file_name": "Screen 3.png", "id": "1045305903945790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_1045305907279123_4661957935061094766_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXfhUAwkb9oQ7kNvwGjcecf&_nc_oc=AdoUDV1tcE8c1uX9W7ZuTHjrS3ioVl-Iq2W3kYqleKAoyRoBjdAi9KTZl_mOj7aLCOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTZbNOXEM1pd3nZRdlUYu0gOi3eSdsAPBOWqX7gNRNyg&oe=6B045C49"}, {"file_name": "Screen 4.png", "id": "1028186085747600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572928_1028186089080933_4863748077338907382_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J31HGuFHhJoQ7kNvwFuDpuZ&_nc_oc=AdpmLctdQJ1hwmA36BpnSunKyK1whpBpgSQdkRtPr3wUAop7DZymyWiPw08evnUYtBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXo4VVdZNrYKBeTSGDC1lTKIUTcEnzc9XeI4PTv6KEuw&oe=6B0459B2"}, {"file_name": "Screen 5.png", "id": "1076454480544205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75481465_1076454483877538_6762957139370141645_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsvPKGQ-H60Q7kNvwHXRdxJ&_nc_oc=AdpQC4DUvdWIELMzYGRPC6LAca3Lqtu6RR19-ZIRqfxbHUteocKh2gxRJ5Lhfk_qynw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe93CC9X36h3zO51j-4m6gX2sLTxvoWBlccmklw3wRqQ&oe=6B046C97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volume MR Music Synthesizer", "keywords": ["music", "synthesizer", "multitimbral", "Bluetooth", "MIDI"], "long_description": "Experience the magic of spatial music creation. Volume is a mixed reality multitimbral music synthesizer perfect for rendering spatialized MIDI streams from external DAWs, sequencers, and controllers.\nEnjoy a completely cordless connection to your existing music studio over Bluetooth MIDI. Select presets and position instruments according to your design. Manipulate instruments in real time. An isometric keyboard included for note visualization and noodling / soloing / experimenting directly in MR.\nSynthesize vivid sonic landscapes with the multitimbral polyphonic wavetable engine. Create novel and fascinating binaural experiences with ease. Explore, experiment, compose, and produce your own spatial music with Volume.\nGet Volume today and start having fun with spatial music synthesis.", "short_description": "Multitimbral Spatializing Music Synthesizer for Mixed Reality with Bluetooth MIDI Connectivity"}]}, "developer_name": null, "developer_privacy_policy_url": "https://threedstar.com/volume/privacy", "developer_terms_of_service_url": "https://threedstar.com/terms", "publisher_name": "3D STAR", "support_website_url": "https://threedstar.com/support", "website_url": "https://threedstar.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
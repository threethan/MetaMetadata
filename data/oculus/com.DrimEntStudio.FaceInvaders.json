10559_8090618256467452634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxpxxvxHHcoQ7kNvwFMGS6_&_nc_oc=AdrxBYRPHCy_rqDqIVrSunrOCqtAgqQGr-nAVrz1BGlMbFsoD9ctJ1jfmnNk61WQ5Go&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh7JAR4oByj4KXossa_3xd0k92DGY4AAq1I2oHM9YfJQ&oe=6AEF55F3"}, {"file_name": "FaceInvaders_Screenshot_2_StoneHead.png", "id": "1178529641369483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1178529644702816_6767033690600746035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9em0Ucp9qh0Q7kNvwFSNK9R&_nc_oc=AdpbmJcxK6IU-0v8ge6O4kZ0xUL09kwRQPzjBcNJ2mKcyMJD8Ux1DLjisEn3WC1Uic0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeYZU9USIkBDe-LtBeEmRSwTEYdqPUtEP7LcB1sSRzHQ&oe=6AEF3204"}, {"file_name": "FaceInvaders_Screenshot_3_BuildTheGun.png", "id": "1142887224839922", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1142887231506588_5299288545079152901_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayp1ujD4ZTkQ7kNvwE-vTGw&_nc_oc=Adogg_EHYCot3rttYkcYEwEXYvzKY9OdP3JqChGCx0rffMhS3RJXGRdXLaJdsQ903TE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8Xp93IaUW5WNk5aDY0FctYI3rdaLT8nyNx_Ty4PWOUg&oe=6AEF66E8"}, {"file_name": "FaceInvaders_Screenshot_5_GoldenRush.png", "id": "1887906392179172", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_1887906402179171_7335656583724092093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ8DkCXp_50Q7kNvwHd-r4u&_nc_oc=Adp1lKfAQY3AxYdY9cbMy1RTB5io8Uj6ubdrBZ2SJsn9aUJPyBb2fLH0URlR8o6amtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ579wOLmfqxtPo5-C0RUNd9NJtKNCLGf8uObEARW7mwg&oe=6AEF3F8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FaceInvaders_Cover_Landscape_2560x1440.png", "id": "1148314308149404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1148314311482737_682109958420087614_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcvJDqFU4moQ7kNvwGIB2NS&_nc_oc=Adq1gUogVP01F58eGEjtT6JdatPm4mSUBQiMSh8qAzVN6QJRXeb-Q84EhyJgO6tGruk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoeFn6PoX5F5IzocJOJOWaThqeaZ8iHHZJG__KqeV8Ww&oe=6AEF6627"}, "display_name": "Face Invaders", "keywords": ["arcade", "shooter", "loot", "roguelite", "blaster"], "long_description": "# Faces are invading the sky. Pop them all.  \n\nGoofy flying faces march in formation, spit at you and dive at your head.\nYou stand on a floating platform with a toy blaster. Keep them off your face.\n\n{1262924043581608}\n\n# Loot it. Plug it in.\n\nPopped faces drop gun parts onto the shelf at your waist.\nGrab one and plug it into your gun with your own hand.\n\n{1119672390638629}\n\n# Build your gun\n\nFour ports, 12 parts, five rarities: every part changes how your gun fires.\nAfter the first boss, a second gun joins in.\n\n{1557024026455201}\n\n# Fire, ice and lightning\n\nSet faces burning, freeze them solid, let lightning jump from face to face.\n\n{1632724391637433}\n\n# Giant bosses\n\nA horned brute, a King and a stone head with eye lasers.\nDodge with your body and aim for the eyes.\n\n{1594911458203782}\n\n# Features\n\n- **100 levels** in four worlds, a Golden Rush bonus level and a boss in every ten\n- Helmets, spitters, kamikazes, splitters, healers and **golden jackpot faces**\n- Combos up to **x25** and falling bonuses you shoot to take (some are bad)\n- **Infinite mode**, leaderboards with your friends and the world, 17 achievements\n- Stand in place: snap turn, a side step, seated play\n- 13 languages", "short_description": "Goofy flying faces are invading the sky. Stand your ground with a toy blaster and pop them wave after wave as they march in formation, spit at you and dive at your head. Loot gun parts from the faces you pop and plug them in with your own hands: scatter, rapid and rail barrels, fire, ice and shock cores, homing and ricochet muzzles. Build a gun that fits your style, then a second one. 100 levels, four worlds, giant bosses."}]}, "developer_name": "Driment Studio", "developer_privacy_policy_url": "https://drimentstudio.com/faceinvaders/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Driment Studio", "support_website_url": "https://drimentstudio.com/contact", "website_url": "https://drimentstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "es", "es_MX", "pt_BR", "pl", "ru", "tr", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28808287422155814"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_1795362408047176_7019798727561363637_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkOI2gsHwWoQ7kNvwFXAqpb&_nc_oc=AdrGRtfUBMcFFViwaezi29tMrwzTNXn9SYnk_fZUAcLege5OYnS-_G1WMCklUToqx4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGxBZz_4ctA4We68_rvHPSbkp_hBBgbD6utliX6MLd1w&oe=6AEF3B19"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Face Invaders", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], 
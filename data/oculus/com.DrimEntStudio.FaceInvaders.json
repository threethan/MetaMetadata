10559_8090618256467452634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9ukMSJj9CkQ7kNvwGXdNvA&_nc_oc=AdqxsKjZAfzdrUcnrgvpHQzgRNanBPuHaUkNGdsmQs5NVEWOVu7Qz4bhY4naIGZ6sMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObW4-JRzLMqTzTP4nvCMfJMNTJegz5N5m_PMV6iYJ5lw&oe=6AE09D33"}, {"file_name": "FaceInvaders_Screenshot_2_StoneHead.png", "id": "1178529641369483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_1178529644702816_6767033690600746035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Ldy40eQgEQ7kNvwGNZ6Pj&_nc_oc=AdpDT8zFp3RylwuKRkTGj84mdhhxyeTx0LtaITL7dQ8bMYJbqKuCQ33-UrZxznCk9YQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf19dsVtnChcV-1_JSrK6dsqpM45NxWed45yIJzytDCQ&oe=6AE0B184"}, {"file_name": "FaceInvaders_Screenshot_3_BuildTheGun.png", "id": "1142887224839922", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1142887231506588_5299288545079152901_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uS8ikSU5iMQ7kNvwGljX8X&_nc_oc=AdqU9ygGvm564BSMiN2CayTrsf_IEEzGgH4sQx5LiKJoYUn4LRzegVt6bB9PHHzbXFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGGM7OG7n3-Qf6gwSIu5U9CzArx-iaTs6AsAcAEwGXPA&oe=6AE0AE28"}, {"file_name": "FaceInvaders_Screenshot_5_GoldenRush.png", "id": "1887906392179172", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_1887906402179171_7335656583724092093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqxPWhSdnrQQ7kNvwGwfwwq&_nc_oc=Adoe6WHJqkgST96_KmAn3Bezy_cykKFeRC5z5PHx24DNJPrD1xZF3mokykidv1usShs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw1sX7plbuMdSkN8S38kdifQLdffhJ6U0vxzAEGHUHYg&oe=6AE0BF0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FaceInvaders_Cover_Landscape_2560x1440.png", "id": "1148314308149404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_1148314311482737_682109958420087614_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb8hzfJE1TwQ7kNvwGtlQNx&_nc_oc=Adp_TLGwaooMY-bXTebJyD7tQ-LqUP0WgpuQwtXpEr2aE-1ycMfDikY44TpBcdXoT24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJAYZZ3_cEYo73AOpVr0_AuenhzUQ_0JtQxgmFs_5-eA&oe=6AE0AD67"}, "display_name": "Face Invaders", "keywords": ["arcade", "shooter", "loot", "roguelite", "blaster"], "long_description": "# Faces are invading the sky. Pop them all.  \n\nGoofy flying faces march in formation, spit at you and dive at your head.\nYou stand on a floating platform with a toy blaster. Keep them off your face.\n\n{1262924043581608}\n\n# Loot it. Plug it in.\n\nPopped faces drop gun parts onto the shelf at your waist.\nGrab one and plug it into your gun with your own hand.\n\n{1119672390638629}\n\n# Build your gun\n\nFour ports, 12 parts, five rarities: every part changes how your gun fires.\nAfter the first boss, a second gun joins in.\n\n{1557024026455201}\n\n# Fire, ice and lightning\n\nSet faces burning, freeze them solid, let lightning jump from face to face.\n\n{1632724391637433}\n\n# Giant bosses\n\nA horned brute, a King and a stone head with eye lasers.\nDodge with your body and aim for the eyes.\n\n{1594911458203782}\n\n# Features\n\n- **100 levels** in four worlds, a Golden Rush bonus level and a boss in every ten\n- Helmets, spitters, kamikazes, splitters, healers and **golden jackpot faces**\n- Combos up to **x25** and falling bonuses you shoot to take (some are bad)\n- **Infinite mode**, leaderboards with your friends and the world, 17 achievements\n- Stand in place: snap turn, a side step, seated play\n- 13 languages", "short_description": "Goofy flying faces are invading the sky. Stand your ground with a toy blaster and pop them wave after wave as they march in formation, spit at you and dive at your head. Loot gun parts from the faces you pop and plug them in with your own hands: scatter, rapid and rail barrels, fire, ice and shock cores, homing and ricochet muzzles. Build a gun that fits your style, then a second one. 100 levels, four worlds, giant bosses."}]}, "developer_name": "Driment Studio", "developer_privacy_policy_url": "https://drimentstudio.com/faceinvaders/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Driment Studio", "support_website_url": "https://drimentstudio.com/contact", "website_url": "https://drimentstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "es", "es_MX", "pt_BR", "pl", "ru", "tr", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28808287422155814"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824318_1795362408047176_7019798727561363637_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmWFJeaDuj0Q7kNvwHDK1lU&_nc_oc=Adort7VfawIPEo-bGrYRyxrFMfw-fczR-oQNzVnqLeZA7C2kJDgwsinsNLWd6_8PG30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6TA2VnkXmcuAfSKSR45iRpTfJURSt-6HCXc8RvlG1jQ&oe=6AE0BA99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Face Invaders", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], 
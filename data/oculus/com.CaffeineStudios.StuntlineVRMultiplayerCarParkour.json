-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExlhodnXjIaDkpdj-aENTihayQWQQOyXg3Iq4GJkVLQw&oe=6A940078"}, {"file_name": "ChatGPT Image Jul 14, 2026, 10_04_19 PM (4).png", "id": "2404542270032552", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499310667_2404542273365885_3683492271573756304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtyQ8qJlNOMQ7kNvwH7H4ex&_nc_oc=Adpme_IymthrosYW30LepOMARu7m_xmztNRYOl9yJJ9G5geFHXxMIFnuZxcIaqGQsgw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH2t-RkjswufDUF91CjvSluWlc5QlUGyDRpRvTckRbSQ&oe=6A93FBC3"}, {"file_name": "ChatGPT Image Jul 14, 2026, 10_04_19 PM (5).png", "id": "1380348053983103", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499310646_1380348057316436_6790286613793209013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgPAU45TagIQ7kNvwHwrA6w&_nc_oc=AdphsopZMYo0VbTjwQzntdxy6Vybks6ItY7R_-JMECLkQMrN1gIJ9vCfSa0PrkrFRKA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHksN5p0_JRh6PR5TevU3xTGzryvdkf4CtDBzbzUOO2Kg&oe=6A94194D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image Jul 14, 2026, 08_53_03 PM (2).png", "id": "1284820253530874", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/654854429_1284820256864207_3438374651273054175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N77a6NQ64wQQ7kNvwFcDpo8&_nc_oc=AdrWGyjA1ciaeLMjgD9qYocq9qnvBDidGAt-F0nxa6OFF3xhKPFk8HceztFThRWcAWU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUXwGW6Y_WZjfS_5PIGOD6rX91HJlvUfrWlJTDiwcFBw&oe=6A9406E4"}, "display_name": "Stuntline VR: Car Parkour", "keywords": ["CarParkour", "VRDriving", "StuntRacing", "ObstacleCourse", "CarDriving"], "long_description": "Stuntline VR: Car Parkour puts you behind the wheel of a stunt car on a sky-high obstacle course where every turn tests your control.\nClimb spiraling roads, balance across narrow sections, weave through slalom gates, dodge moving and static hazards, and time your run across disappearing platforms and a collapsing bridge. Explore branching routes, navigate challenging mazes, choose between safer paths and risky shortcuts, hit launch ramps, and conquer the demanding final climb before making one last jump to the finish.\nBuilt for VR, the game combines intuitive trigger driving with immersive in-car steering, working mirrors, responsive audio and haptic feedback, and a dynamic day-and-night atmosphere. Checkpoint recovery gets you back into the action after a crash or whenever you get stuck.\nEvery run is a race against the clock. Learn each obstacle, refine your route, improve your finish time, and compete for a place on the global leaderboard. Whether you drive carefully or chase the fastest line, Stuntline VR: Car Parkour rewards precision, courage, and mastery.\nStart the engine. Hold the line. Conquer the impossible road.", "short_description": "Take the wheel in Stuntline VR: Car Parkour, a high-altitude VR driving challenge built around precision, nerve, and speed. Climb twisting roads, dodge moving obstacles, cross disappearing platforms, escape a collapsing bridge, choose maze or jump routes, and launch toward the finish. Recover at checkpoints, master every stunt, set your fastest time, and climb the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/stuntline-vr-car-parkour-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQ
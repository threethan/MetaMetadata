.5771-25/654867655_1609859286935372_422156495198787760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3Fbe13GxkkQ7kNvwFl0y1_&_nc_oc=Ado2mZoV8ZtyCZ9QQFNIHKWfpmKY1WG_IZGiY6qr7hDWCbLAL7jfKgq5j27N20Fltng&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCNU2YrFrmcEVeUZjUeSCozTf7nGNHhVO9t11p-oXsbA&oe=6AF9EC4C"}, {"file_name": "4.png", "id": "3308864969308005", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307920_3308864972641338_2158216937547526163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly3wtCOhShEQ7kNvwE4JuKY&_nc_oc=AdqKzMExoIt6h4WTy8BbjkjJ5Trk6Rt5Rl7H1nFARv6zwHRoythYH-W-cC-MMRb7CNo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDqq5V3QbCFLA6EufGnP1k6mnFw7Un679Iw7tojYAoYQ&oe=6AF9E475"}, {"file_name": "5.png", "id": "4564552503787601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499313072_4564552507120934_8581666917278412879_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC1bw826dDcQ7kNvwGshbPS&_nc_oc=AdpHCHZ121F7n1bBznQS2eDkCmyBamoRNY_r6_FBkZiFBCYbvGiMXX6ZgRG86sZqAG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLJoZivIFcCyIXemDRCHV2wEH1ZsYV1QvCNLKbDr1R6g&oe=6AF9C68C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Calculator", "keywords": ["calculator"], "long_description": "Calculation functions: Enter and edit expressions directly, and make use of the available scientific tools. For trigonometric functions, you can choose between degrees and radians, depending on your needs.\n\nHistory and customization: Review your past calculations and navigate through your history using the up and down buttons; you can also clear the history whenever you like. Additionally, you can select your preferred language and switch between light and dark themes\u2014the app remembers your settings.", "short_description": "Calculation functions: Enter and edit expressions directly, and make use of the available scientific tools. For trigonometric functions, you can choose between degrees and radians to suit your needs; the app also offers both basic and advanced modes."}, {"images": {"nodes": []}, "id": "1092418597123809", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mi Caluculadora", "keywords": ["caluculadora"], "long_description": "Funciones de c\u00e1lculo: Escribe y edita expresiones directamente, y utiliza las herramientas cient\u00edficas disponibles. Para las funciones trigonom\u00e9tricas puedes elegir entre grados y radianes, seg\u00fan lo que necesites.\n\nHistorial y personalizaci\u00f3n: Consulta tus operaciones anteriores y despl\u00e1zate por el historial con los botones de subir y bajar; tambi\u00e9n puedes limpiarlo cuando quieras. Adem\u00e1s, puedes seleccionar el idioma y cambiar entre tema claro y oscuro: la aplicaci\u00f3n recuerda tus preferencias.", "short_description": "Funciones de c\u00e1lculo: Escribe y edita expresiones directamente, y utiliza las herramientas cient\u00edficas disponibles. Para las funciones trigonom\u00e9tricas puedes elegir entre grados y radianes, seg\u00fan lo que necesites y cuenta con modo basico y avanzado."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1wQveMXfV8vKL3RtiDofTXa3a9TZ6cvBiE3f-naNqjxM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-calculator-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
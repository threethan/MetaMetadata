6gKbFM-9WjcIkLM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbQsnRnnxtuugSPHwknXJ7Dw_LBMiNPrrPJbDo9Mz8fQ&oe=6AFB35F5"}, {"file_name": "5.png", "id": "4564552503787601", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313072_4564552507120934_8581666917278412879_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC1bw826dDcQ7kNvwH7YxUV&_nc_oc=AdrIbV6XACHAxGoiQpb7fVHrb0jpYzytsT74LpMThh0X4Ql15ZFamq4iYGdC3NMYh2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTEVC45avh0xBTWH-X3On24zwZ98aBAo1PjRMJ063jlQ&oe=6AFB180C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Calculator", "keywords": ["calculator"], "long_description": "Calculation functions: Enter and edit expressions directly, and make use of the available scientific tools. For trigonometric functions, you can choose between degrees and radians, depending on your needs.\n\nHistory and customization: Review your past calculations and navigate through your history using the up and down buttons; you can also clear the history whenever you like. Additionally, you can select your preferred language and switch between light and dark themes\u2014the app remembers your settings.", "short_description": "Calculation functions: Enter and edit expressions directly, and make use of the available scientific tools. For trigonometric functions, you can choose between degrees and radians to suit your needs; the app also offers both basic and advanced modes."}, {"images": {"nodes": []}, "id": "1092418597123809", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mi Caluculadora", "keywords": ["caluculadora"], "long_description": "Funciones de c\u00e1lculo: Escribe y edita expresiones directamente, y utiliza las herramientas cient\u00edficas disponibles. Para las funciones trigonom\u00e9tricas puedes elegir entre grados y radianes, seg\u00fan lo que necesites.\n\nHistorial y personalizaci\u00f3n: Consulta tus operaciones anteriores y despl\u00e1zate por el historial con los botones de subir y bajar; tambi\u00e9n puedes limpiarlo cuando quieras. Adem\u00e1s, puedes seleccionar el idioma y cambiar entre tema claro y oscuro: la aplicaci\u00f3n recuerda tus preferencias.", "short_description": "Funciones de c\u00e1lculo: Escribe y edita expresiones directamente, y utiliza las herramientas cient\u00edficas disponibles. Para las funciones trigonom\u00e9tricas puedes elegir entre grados y radianes, seg\u00fan lo que necesites y cuenta con modo basico y avanzado."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1wQveMXfV8vKL3RtiDofTXa3a9TZ6cvBiE3f-naNqjxM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-calculator-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1523394754179055"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1670398071312201"}]}, "baseline_offer": {"id": "1670398071312201"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794346560, "status": "PUBLISHED", "id": "1670398071312201"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBi
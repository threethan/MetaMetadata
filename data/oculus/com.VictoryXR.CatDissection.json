707003044_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF1HKbtRciAQ7kNvwGqo7Zm&_nc_oc=AdorJFt3w1GQk20AP53U69D4mhObOO2wXoMwCQ1RRoah6hlodKcgwK0m1Dbx6cL0rRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeI9wcZje7yyEwxHY_82oX3uyIuO-N6zYFPiQC_42qOg&oe=6B006FA0"}, {"file_name": "screen_3840x2160_2019-05-30_08-59-36.png", "id": "1087691371706859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982479_1087691375040192_2883170994051929962_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwwIbc48T-IQ7kNvwFloWgG&_nc_oc=AdrcgFNkzQyuYSP-f5q6Z4C4P8utCc_z7FCcX6JhldK6icEBc9XpmNqe7VeSofEzRjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsCqJQCJti4Oc8en9Q8ekfNY_yxlfzbt5ZfARpIdyfpw&oe=6B005201"}, {"file_name": "screen_3840x2160_2019-05-30_08-50-39.png", "id": "1969634163178042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031539_1969634166511375_1933600362679177853_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf6T8jE5WewQ7kNvwH_S7um&_nc_oc=AdogJsS_bb9vMYi9-VXbjBAU5NiADOq8xhdZJu-hudP-CKcRQW2J-qG5bG2Uficb38U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBPcdF769GaXJVVVAowkXzoG01N5-GJeMOUNrqw0wm8w&oe=6B006E40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_3840x2160_2019-05-30_08-50-39.png", "id": "2495285880766998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031363_2495285884100331_7543578855093933327_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGayrog9XU0Q7kNvwExEEln&_nc_oc=Adp6xTLI-48NbJNZxCRHNQ33ZeH2Arie0VNIs3cs29aCEBLcLUxwDhkd5Lm4aV-50e8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTStB9n3WNqJXADoiVPmjZA5H70L_60O-n2NNpFo6QMPw&oe=6B00760B"}, "display_name": "Dissection Simulator: Cat Edition", "keywords": [], "long_description": "Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality cat dissection in Dissection Simulator: Feline Edition. Learn the fundamentals of the feline anatomy through its various systems in our fully immersive VR experience.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections.\n\nSchools can save on expensive and rising annual costs of animal specimens. Additionally, acquisitions are reliable and not dependent on animal procurement. Learning pacing is user-controlled to ensure maximum understanding of the teaching while moving through the program.", "short_description": "Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality cat dissection in Dissection Simulator: Feline Edition. Learn the fundamentals of the feline anatomy through its various systems in our fully immersive VR experience."}]}, "developer_name": "VictoryXR", "developer_privacy_policy_url": "https://victoryxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
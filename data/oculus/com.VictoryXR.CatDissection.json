uluscdn.com/v/t64.5771-25/38982479_1087691375040192_2883170994051929962_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnuc2AHXjPMQ7kNvwEDLvAe&_nc_oc=Adn-IKapfOOtjSVxTREAQ7CSPI0HBr1ONTHX3j0YTkBR_pwOi4A4ubNhWJgIUghQsUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3Ejd-omwwSR1GGyIiFvhJjiSxkh8j4IvXohKYr9o_Yg&oe=69A05181"}, {"file_name": "screen_3840x2160_2019-05-30_08-50-39.png", "id": "1969634163178042", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031539_1969634166511375_1933600362679177853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gLIzRW4xZYQ7kNvwF1ZYYZ&_nc_oc=AdnjYE5B9lnemG9OpDhJ6FklQYJ7hIZ4EWhG0LdAq8dGw15WFIUDNfnkKigByrL-Jps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuq6rBQqTPFT90CpmY6jFt0S1nD4fmaFrc5yiZ6PJRRAA&oe=69A03580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_3840x2160_2019-05-30_08-50-39.png", "id": "2495285880766998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031363_2495285884100331_7543578855093933327_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5CQCG90HUEQ7kNvwGe3pOS&_nc_oc=AdnBpFIgdKB2EGYBhyPE3DWTXI-VPt6Mxlb-tOAugntiGkB19Uza5XaAr7aRq7zMziY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsJ1ZnDGTrP250p-liibJEhOS8-TI1-QUynu4PUFdnbwg&oe=69A03D4B"}, "display_name": "Dissection Simulator: Cat Edition", "keywords": [], "long_description": "Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality cat dissection in Dissection Simulator: Feline Edition. Learn the fundamentals of the feline anatomy through its various systems in our fully immersive VR experience.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections.\n\nSchools can save on expensive and rising annual costs of animal specimens. Additionally, acquisitions are reliable and not dependent on animal procurement. Learning pacing is user-controlled to ensure maximum understanding of the teaching while moving through the program.", "short_description": "Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality cat dissection in Dissection Simulator: Feline Edition. Learn the fundamentals of the feline anatomy through its various systems in our fully immersive VR experience."}]}, "developer_name": "VictoryXR", "developer_privacy_policy_url": "https://victoryxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "725739815260490"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3903247753068737", "version": "1.0"}, "id": "791671054773665", "channel_name"
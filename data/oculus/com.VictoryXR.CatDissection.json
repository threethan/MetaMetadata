707003044_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urC8F9li0XkQ7kNvwGKoKqJ&_nc_oc=AdrhFonx3xDzcVWj8204WBThWjQOHJ24Obl2PF81p0y5Fyqtji-GrZEsVAJ1hChZ89E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAPpaaFtZVy-EN12s6PnFfs_tflVSLomglITaovYdhCA&oe=6B0D9EA0"}, {"file_name": "screen_3840x2160_2019-05-30_08-59-36.png", "id": "1087691371706859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982479_1087691375040192_2883170994051929962_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QLJEi8F2wkQ7kNvwGLuY3D&_nc_oc=Adq-K_Bs-930kn8GeADzY2kNQNPDT2tIbeXykW7TE7IiD-m-QYCgVb9usEROTDubCIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS_usxKZPEGElJuS48RPu17tS0m0glD_9-NxHJM6ApwA&oe=6B0DB941"}, {"file_name": "screen_3840x2160_2019-05-30_08-50-39.png", "id": "1969634163178042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031539_1969634166511375_1933600362679177853_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMt92w4qiBUQ7kNvwHvCNsb&_nc_oc=Adorh-PEGiF-BPewBQDpMbhi5Su911hBsXImLTVv50uyFxjvbFzVYfeZHrS85_VUTcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTob_uA716vUEx5SgPe8oRoLarkznsyJD-Gx4U6gY4_Pw&oe=6B0D9D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_3840x2160_2019-05-30_08-50-39.png", "id": "2495285880766998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031363_2495285884100331_7543578855093933327_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6ikWtKwEv4Q7kNvwE8KwH5&_nc_oc=Ado1kJ9WbohA3SLhng57_Z_eqw9TFcUeuLzlP8ZCQ1f87xzPRE7sfWTDmnOZTk8MVX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGMcFKK_SyoIlONsmGxTejJMSxVDkwQVDkSQAKQeau6g&oe=6B0DA50B"}, "display_name": "Dissection Simulator: Cat Edition", "keywords": [], "long_description": "Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality cat dissection in Dissection Simulator: Feline Edition. Learn the fundamentals of the feline anatomy through its various systems in our fully immersive VR experience.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections.\n\nSchools can save on expensive and rising annual costs of animal specimens. Additionally, acquisitions are reliable and not dependent on animal procurement. Learning pacing is user-controlled to ensure maximum understanding of the teaching while moving through the program.", "short_description": "Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality cat dissection in Dissection Simulator: Feline Edition. Learn the fundamentals of the feline anatomy through its various systems in our fully immersive VR experience."}]}, "developer_name": "VictoryXR", "developer_privacy_policy_url": "https://victoryxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
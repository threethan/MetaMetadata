a0a&_nc_ohc=QgQo7f-NocMQ7kNvwEFeAkm&_nc_oc=AdpcRv56MiioXcM71zmGBfAys8VOIg8x0MKDqIfYmNagJz42wzpaimrD_xklFFzeBaU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBZkiG2lixox4fOeQq0d8ETAr5WBUH9-I6XoqerEKfJA&oe=6AFB420C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (49).png", "id": "698697579383210", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392129_698697582716543_8370621040367410281_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-6urKe9zZUQ7kNvwE8LOQs&_nc_oc=Adq23i7A2Wp-CvwOb2KCKiNlwegylKFFV11Er4C9keTU7KrksKjfmujtE6RndUggXmM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1hZFtD75qmEO-edAzwcQx2-POtG8DpueBUm0ergaj8A&oe=6AFB245F"}, "display_name": "Labyrinth", "keywords": [], "long_description": "The doors to Violet Co. have been shut for years, its factory left to rust and decay. But something still lingers within its walls.\n\nIn Labyrinth, players navigate an abandoned industrial complex filled with intricate puzzles, dangerous obstacles, and relentless creatures. Armed with mechanical hands designed for factory navigation, every movement is a test of skill and survival. Solve environmental challenges, uncover hidden areas, and piece together the mysteries buried in the facility\u2019s remains.\n\nBut you're not alone. Something watches from the shadows, learning your every move.\n\nThere\u2019s only one way out\u2014through the heart of the Labyrinth. Will you make it?", "short_description": "Labyrinth is a first-person horror puzzle game set in the decayed remains of the Violet Co. factory. Using mechanical hands with unique abilities, players solve physics-based puzzles, explore eerie industrial environments, and evade the horrors that still lurk within."}]}, "developer_name": "BeyondIllusionStudios", "developer_privacy_policy_url": "https://sites.google.com/view/beyondillusionstudiosprivacy/privacy-policy", "developer_terms_of_service_url": null
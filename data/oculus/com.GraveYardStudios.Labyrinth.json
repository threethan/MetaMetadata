1-7&_nc_sid=6e7a0a&_nc_ohc=D0U-Nux1Vz4Q7kNvwFavPRD&_nc_oc=AdrygulTXFv2LmUkvmDuvzcxa3VAezzMJ2KbKwQILhwnb7KhfrrPKz0SxYTlp6fisd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWr14QQiakFHCBXSsM1GswAhMbNcBtX5Bbz6OJQQYiy0g&oe=6B0F1BD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2024-01-05_114146528.png", "id": "747485063498465", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974534_747485066831798_4834069944485897448_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1q2Xtq-G6kQ7kNvwEuwP_G&_nc_oc=AdqEfAmn3DHCBpMZLmLmZfmvpFzQxbjkQqBXx8dfueHI_T8CfwelT0gyPagmjhpC1o8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHQRfMIKbAsYDAU4U6YLoDn-9RKFgZg7Q8lXPHfJwbmw&oe=6B0F1B44"}, "display_name": "Labyrinth", "keywords": [], "long_description": "Labyrinth is an immersive horror experience that reimagines the world of Gorilla Tag Fangames through a haunting lens. Set within the confines of a sprawling, maze-like structure, the game challenges players to navigate a series of increasingly complex and treacherous environments. As you traverse through dimly lit corridors and shadowy chambers, you'll encounter a variety of Terrifying adversaries that lurk in the darkness, ready to strike when least expected.\n\nEmbark on a harrowing adventure, confront your deepest fears, and discover the secrets that lie hidden within the Labyrinth", "short_description": "Labyrinth is a Terrifying Gorilla Tag fangame that brings players into a nightmarish maze filled with eerie atmospheres and lurking horrors. Navigate through twisted corridors, solve intricate puzzles, and evade terrifying entities as you struggle to find your way out. Will you escape the Labyrinth, or become lost in its endless darkness forever?\""}]}, "developer_name": "Bmix", "developer_privacy_policy_url": "https://sites.google.com/view/graveyardstudios/home", "developer_terms_of_service_url": null, "publisher_name": "GraveY
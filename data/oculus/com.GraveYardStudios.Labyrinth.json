.png", "id": "910793456866282", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035447_910793460199615_2650904304643598124_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4AKFmTO_IQQ7kNvwEPMb9i&_nc_oc=AdqUUqP77C7WvKUZic8K08rzhgXObVCJlyTU9dvnB3tCbjKIs5r1lMgZ5H8JKtG6L7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2g7l7Ovny2Im2ntLVmTHVsKgE1sgGVtT9a_UlgvbeTvA&oe=69F1ED1F"}, {"file_name": "image_2024-01-07_110048120.png", "id": "1817947822055568", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974714_1817947825388901_3207215594745603444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If8n25FTbNAQ7kNvwGPYzff&_nc_oc=AdqjYVZ241F7-kaS5mI7VKA8b3bqGcQDYZvaBIikpd51bxRo-n2Nm6LV7L4DUoj0beg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0PGzIagTqJYwmqV8z-ofgo2TEk9A-O2mfE0xFtfpXDvg&oe=69F214BB"}, {"file_name": "image_2024-01-04_225946729.png", "id": "1822468888188623", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974705_1822468891521956_3152685838474796444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8J2z2KCx5UQ7kNvwE8BVO1&_nc_oc=AdrEwmeqI2mjlnxa6KR10cM9rDXRDueONuqkAYo6GUnzzOxOMSDI7qXnhI84Xs6XEZU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2budfQKx8_UqLrV1P2KRWr6hQcFCX3-QUEjYuCv4eLEA&oe=69F1E751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2024-01-05_114146528.png", "id": "747485063498465", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974534_747485066831798_4834069944485897448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI4vJjR8NuwQ7kNvwFDYFub&_nc_oc=AdoXZaIW8cpJnW4MjGyDfsWNnxjEEKmzGD72AtPKC6xLYQkHc7xcIE6-f7IPEBBmDNo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1xyZBngVHIM1Sdw7vzWEGw_-7FVa1MYSvQJL4EkXJZSg&oe=69F1E6C4"}, "display_name": "Labyrinth", "keywords": [], "long_description": "Labyrinth is an immersive horror experience that reimagines the world of Gorilla Tag Fangames through a haunting lens. Set within the confines of a sprawling, maze-like structure, the game challenges players to navigate a series of increasingly complex and treacherous environments. As you traverse through dimly lit corridors and shadowy chambers, you'll encounter a variety of Terrifying adversaries that lurk in the darkness, ready to strike when least expected.\n\nEmbark on a harrowing adventure, confront your deepest fears, and discover the secrets that lie hidden within the Labyrinth", "short_description": "Labyrinth is a Terrifying Gorilla Tag fangame that brings players into a nightmarish maze filled with eerie atmospheres and lurking horrors. Navigate through twisted corridors, solve intricate puzzles, and evade terrifying entities as you struggle to find your way out. Will you escape the Labyrinth, or become lost in its endless darkness forever?\""}]}, "developer_name": "Bmix", "developer_privacy_policy_url": "https://sites.google.com/view/graveyardstudios/home", "developer_terms_of_service_url": null, "publisher_name": "GraveYardStudios", "support_website_url": null, "website_url": "https://graveyardstudios6.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6360565610711836"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7052662981502092", "version": "172"}, "id": "38932475509544
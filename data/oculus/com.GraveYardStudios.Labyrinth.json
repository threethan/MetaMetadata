a0a&_nc_ohc=A4wAE_5UiNAQ7kNvwFiiP1w&_nc_oc=AdpSd9fRNlRUH3Ob4Q9sTrgJeVj4fknNPFeffb4yCPgYC79VYYVVBxx3fuDBT2f4dXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT88GLpnIOJ9wyy1xLszJItLT_tjPydfwPRkzi0py9BhA&oe=6B032B0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (49).png", "id": "698697579383210", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392129_698697582716543_8370621040367410281_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXzYVHR4_8AQ7kNvwE2NWPS&_nc_oc=AdrjOCb523p84I2-WqdFLIe4ldvAeyuy1IlZ3jCxiYAlowbVPyXtVjyghPScT_2emK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVjtpFaRtNgIJjf7duxXoF11fiD_u5iUZ7pCkSt8YR_Q&oe=6B030D5F"}, "display_name": "Labyrinth", "keywords": [], "long_description": "The doors to Violet Co. have been shut for years, its factory left to rust and decay. But something still lingers within its walls.\n\nIn Labyrinth, players navigate an abandoned industrial complex filled with intricate puzzles, dangerous obstacles, and relentless creatures. Armed with mechanical hands designed for factory navigation, every movement is a test of skill and survival. Solve environmental challenges, uncover hidden areas, and piece together the mysteries buried in the facility\u2019s remains.\n\nBut you're not alone. Something watches from the shadows, learning your every move.\n\nThere\u2019s only one way out\u2014through the heart of the Labyrinth. Will you make it?", "short_description": "Labyrinth is a first-person horror puzzle game set in the decayed remains of the Violet Co. factory. Using mechanical hands with unique abilities, players solve physics-based puzzles, explore eerie industrial environments, and evade the horrors that still lurk within."}]}, "developer_name": "BeyondIllusionStudios", "developer_privacy_policy_url": "https://sites.google.com/view/beyondillusionstudiosprivacy/privacy-policy", "developer_terms_of_service_url": null
1-7&_nc_sid=6e7a0a&_nc_ohc=dFtY5vDSJwkQ7kNvwG7yIjc&_nc_oc=AdohfeDvFb-gXN42scwsrBIcVuJTo7iXwrLrQAsd2qW07OhMrOGxY0OBWPt-oXzjNKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQra8FlDL1TCln8jIAeRfkY7pv-sjSXbtl4nNL_hGnflQ&oe=6B05A911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2024-01-05_114146528.png", "id": "747485063498465", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974534_747485066831798_4834069944485897448_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bjUT6ROmDMQ7kNvwFqURlZ&_nc_oc=AdrKoAkGe_dqsnDl6TmtJN9Z0BdOD6NjIYv1SGs5zrEc3qcaqkdJs1x2QRS_2FP36iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR05RFUW8yrUq3s_HBGe-NCmwz-0GGpaKpNyHw2cAqT0A&oe=6B05A884"}, "display_name": "Labyrinth", "keywords": [], "long_description": "Labyrinth is an immersive horror experience that reimagines the world of Gorilla Tag Fangames through a haunting lens. Set within the confines of a sprawling, maze-like structure, the game challenges players to navigate a series of increasingly complex and treacherous environments. As you traverse through dimly lit corridors and shadowy chambers, you'll encounter a variety of Terrifying adversaries that lurk in the darkness, ready to strike when least expected.\n\nEmbark on a harrowing adventure, confront your deepest fears, and discover the secrets that lie hidden within the Labyrinth", "short_description": "Labyrinth is a Terrifying Gorilla Tag fangame that brings players into a nightmarish maze filled with eerie atmospheres and lurking horrors. Navigate through twisted corridors, solve intricate puzzles, and evade terrifying entities as you struggle to find your way out. Will you escape the Labyrinth, or become lost in its endless darkness forever?\""}]}, "developer_name": "Bmix", "developer_privacy_policy_url": "https://sites.google.com/view/graveyardstudios/home", "developer_terms_of_service_url": null, "publisher_name": "GraveY
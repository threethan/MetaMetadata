&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XONtbT9l5MQQ7kNvwHDkYYe&_nc_oc=Adlh1Ernas9n07jS0RH-IncTI9xtlik9IfOB1f-OY7CDJiU9evtYcLaOVnAbiPDPZRM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfypKCmJbOr23OnFyw5gq6SbRbmmHOs8WmpwZMWLgv2fMg&oe=69AABD9F"}, "display_name": "Labyrinth", "keywords": [], "long_description": "The doors to Violet Co. have been shut for years, its factory left to rust and decay. But something still lingers within its walls.\n\nIn Labyrinth, players navigate an abandoned industrial complex filled with intricate puzzles, dangerous obstacles, and relentless creatures. Armed with mechanical hands designed for factory navigation, every movement is a test of skill and survival. Solve environmental challenges, uncover hidden areas, and piece together the mysteries buried in the facility\u2019s remains.\n\nBut you're not alone. Something watches from the shadows, learning your every move.\n\nThere\u2019s only one way out\u2014through the heart of the Labyrinth. Will you make it?", "short_description": "Labyrinth is a first-person horror puzzle game set in the decayed remains of the Violet Co. factory. Using mechanical hands with unique abilities, players solve physics-based puzzles, explore eerie industrial environments, and evade the horrors that still lurk within."}]}, "developer_name": "BeyondIllusionStudios", "developer_privacy_policy_url": "https://sites.google.com/view/beyondillusionstudiosprivacy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BeyondIllusionStudios", "support_website_url": "https://sites.google.com/view/beyondillusionstudios/contact?authuser=0", "website_url": "https://sites.google.com/view/beyondillusionstudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "528142316460358"}, {"id": "275629210202852"}], "external_subscription_typ
1-7&_nc_sid=6e7a0a&_nc_ohc=aNvKDHJQX-IQ7kNvwHVmI2e&_nc_oc=Adoc86SzWBhUf2Xo632RJu_3X7vHld_1TWWll563Qs3VkLDydt502uSU3G6oau08w3g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1aPLO2lo3U1b-elH_JIaLIBOvZdMT8yy6KlojQtJM7g&oe=6AFF1191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2024-01-05_114146528.png", "id": "747485063498465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974534_747485066831798_4834069944485897448_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MoY_ZPGL4EQ7kNvwH_gaXW&_nc_oc=AdqLTpNkxMpGQt5q_ZBbiXgzy-shuL7gb7oEmYfyA5sR11ak2ZWC0G4DyZ_bLjnI4E8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCgrs4tL1h2oiuJKFTpYNl_7iLjiORA5fqQG_-JP6wwg&oe=6AFF1104"}, "display_name": "Labyrinth", "keywords": [], "long_description": "Labyrinth is an immersive horror experience that reimagines the world of Gorilla Tag Fangames through a haunting lens. Set within the confines of a sprawling, maze-like structure, the game challenges players to navigate a series of increasingly complex and treacherous environments. As you traverse through dimly lit corridors and shadowy chambers, you'll encounter a variety of Terrifying adversaries that lurk in the darkness, ready to strike when least expected.\n\nEmbark on a harrowing adventure, confront your deepest fears, and discover the secrets that lie hidden within the Labyrinth", "short_description": "Labyrinth is a Terrifying Gorilla Tag fangame that brings players into a nightmarish maze filled with eerie atmospheres and lurking horrors. Navigate through twisted corridors, solve intricate puzzles, and evade terrifying entities as you struggle to find your way out. Will you escape the Labyrinth, or become lost in its endless darkness forever?\""}]}, "developer_name": "Bmix", "developer_privacy_policy_url": "https://sites.google.com/view/graveyardstudios/home", "developer_terms_of_service_url": null, "publisher_name": "GraveY
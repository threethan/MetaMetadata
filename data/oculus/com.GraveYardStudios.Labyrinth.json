cdn.com&_nc_ss=7f20f&oh=00_Af6f0bXV5_ZWcLqvp_B-TB5WY_HYAqvbkBssTm8Pi1uGWA&oe=6A01D7F3"}, {"file_name": "image_2024-01-05_114323449.png", "id": "910793456866282", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035447_910793460199615_2650904304643598124_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nZiEgUXP5kQ7kNvwHwAHe-&_nc_oc=Adqryqyl7C7QTky2DnjspDyrqh883t7CUx1nlgdTDF-QTniLnPaLSDdsQVjjNWN7rEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55pCk0Z8fT3IXFl8KUCNYHT28RDUDtSK_1lAgIbQigqg&oe=6A01F75F"}, {"file_name": "image_2024-01-07_110048120.png", "id": "1817947822055568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_1817947825388901_3207215594745603444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSgJBq1vJz0Q7kNvwGcGg3w&_nc_oc=Adqz50jkBTpmhFEycBtvRiS7Rvd3P5g9pvla6AmBb2xJJr9WYytiTom0ONNHQ4k8LZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af549aYBfF5uXjY-4UlBMJWHATQnSJHH3xeQtPaHDvjeYA&oe=6A01E6BB"}, {"file_name": "image_2024-01-04_225946729.png", "id": "1822468888188623", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974705_1822468891521956_3152685838474796444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVUU7KP3eXMQ7kNvwFUr2uz&_nc_oc=AdpocO0TJkyvSmeuDdIm377yWqOpd_AzckAEcyPBc-lmC0bCx-zOhOIGIrXhNQWiyGY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OzfZHvEyESoZHCahVi8njSai5bQjZeR8ydSLZ4pBrPQ&oe=6A01F191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2024-01-05_114146528.png", "id": "747485063498465", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974534_747485066831798_4834069944485897448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROqpv2DiUusQ7kNvwGHCM9B&_nc_oc=AdqPKe1fVp6dMSYwJovnX6X4Bw-OSM2oVwcc19HZJy6gwnllmuCfHaxwqxzQS4n7i0s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q0-1aq-q-a9LiRx0Na5pwz8FimsTvSl9B-3gtAWmDng&oe=6A01F104"}, "display_name": "Labyrinth", "keywords": [], "long_description": "Labyrinth is an immersive horror experience that reimagines the world of Gorilla Tag Fangames through a haunting lens. Set within the confines of a sprawling, maze-like structure, the game challenges players to navigate a series of increasingly complex and treacherous environments. As you traverse through dimly lit corridors and shadowy chambers, you'll encounter a variety of Terrifying adversaries that lurk in the darkness, ready to strike when least expected.\n\nEmbark on a harrowing adventure, confront your deepest fears, and discover the secrets that lie hidden within the Labyrinth", "short_description": "Labyrinth is a Terrifying Gorilla Tag fangame that brings players into a nightmarish maze filled with eerie atmospheres and lurking horrors. Navigate through twisted corridors, solve intricate puzzles, and evade terrifying entities as you struggle to find your way out. Will you escape the Labyrinth, or become lost in its endless darkness forever?\""}]}, "developer_name": "Bmix", "developer_privacy_policy_url": "https://sites.google.com/view/graveyardstudios/home", "developer_terms_of_service_url": null, "publisher_name": "GraveYardStudios", "support_website_url": null, "website_url": "https://graveyardstudios6.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6360565610711836"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveCha
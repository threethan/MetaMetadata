cdn.com&_nc_ss=7a30f&oh=00_Af1-0P5m2PAgMsf8B_7l3AqfHNmla5-KsQEx0Yh_ArunSg&oe=69EE1173"}, {"file_name": "image_2024-01-05_114323449.png", "id": "910793456866282", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035447_910793460199615_2650904304643598124_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VttzzvStb2EQ7kNvwE_4UVl&_nc_oc=Adoq1hCu8Ww1TXh9Y5dfn8dPSn9qLuicESj6bE6__ugE4Pz0egyC1CT6FnqnigNbiFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ju0XGmTD1lEx19PYmcRtgRD3TMelMRirXdG4x1dRS8Q&oe=69EDF89F"}, {"file_name": "image_2024-01-07_110048120.png", "id": "1817947822055568", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_1817947825388901_3207215594745603444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lJy14tFJtoQ7kNvwEP_6VT&_nc_oc=Adq5lIRoqqppQRiBlVILlBsRROFDvdYPRP4JPQuvAKGbxIl3ytQi9A28-QeSAMccUKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wWE40qO_JWO4IZENek_JFooARkXbBhN5xvfeI23M8iw&oe=69EE203B"}, {"file_name": "image_2024-01-04_225946729.png", "id": "1822468888188623", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974705_1822468891521956_3152685838474796444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neyVBQEj5V8Q7kNvwH-tma9&_nc_oc=AdrlN21PDFwOapCAd85uPlXFvElc4BLqpD9XZ4I2SpmtWz2Tk4n3v0Y5VdxsewDQdWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Lu7gN_SxLaNK6EoupU7maal2DACqjS5LQc20wkYMiww&oe=69EDF2D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_2024-01-05_114146528.png", "id": "747485063498465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974534_747485066831798_4834069944485897448_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdmfFkwxKeEQ7kNvwFszp-f&_nc_oc=Ado6rJWpBWc8Tq22gQko8vfUjlCpN9sHZbq3NwcHCyULQqD5v8UtkhjE7rhuZNdHWRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bS7YNX0wvGsP3NUmOWIZioJ5ng4kXgoasund2Q9fFhQ&oe=69EDF244"}, "display_name": "Labyrinth", "keywords": [], "long_description": "Labyrinth is an immersive horror experience that reimagines the world of Gorilla Tag Fangames through a haunting lens. Set within the confines of a sprawling, maze-like structure, the game challenges players to navigate a series of increasingly complex and treacherous environments. As you traverse through dimly lit corridors and shadowy chambers, you'll encounter a variety of Terrifying adversaries that lurk in the darkness, ready to strike when least expected.\n\nEmbark on a harrowing adventure, confront your deepest fears, and discover the secrets that lie hidden within the Labyrinth", "short_description": "Labyrinth is a Terrifying Gorilla Tag fangame that brings players into a nightmarish maze filled with eerie atmospheres and lurking horrors. Navigate through twisted corridors, solve intricate puzzles, and evade terrifying entities as you struggle to find your way out. Will you escape the Labyrinth, or become lost in its endless darkness forever?\""}]}, "developer_name": "Bmix", "developer_privacy_policy_url": "https://sites.google.com/view/graveyardstudios/home", "developer_terms_of_service_url": null, "publisher_name": "GraveYardStudios", "support_website_url": null, "website_url": "https://graveyardstudios6.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6360565610711836"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveCha
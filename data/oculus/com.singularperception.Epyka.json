: "Photo_2022.06.30-14.17.58.png", "id": "1375486423391826", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_1375486426725159_8881900926330453526_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78EYIDypui4Q7kNvwHLDxOm&_nc_oc=AdqBgNxXHGeH6NY_ZdJeye0MFShg2H8gOlgre7n5k3fqcNvwDIelBgY48KE9SsJ2mG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiZxAxTk4IBToNZc4StbSvYITujlH0AsmZVFM4XTpusQ&oe=6ACCFFE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "535676839134110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035394_535676842467443_4205523101072274633_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAhNk4zMfUQQ7kNvwEo8xo0&_nc_oc=AdosLf8_DiDiMAVK2__ObSHvV4PM4fckNtkEi9Y-8i44AdXMFzJBEW9xTJWL35hFJ0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsonAfR8cE0OHccfTmcxugLvL4BgUUJVmsuRGTCzHoug&oe=6ACCF390"}, "display_name": "Epyka", "keywords": ["adventure", "puzzle", "story", "dog"], "long_description": "EPYKA charts the adventures of archaeologist Scott Hudson and his trusty dog Jack as they search for evidence of Earth\u2019s first civilisation. But when the duo stumbles upon a mysterious, undiscovered island, they soon find more than they ever bargained for. Uncovering an evil that threatens the very future of humankind the pair must work together to solve ancient, magical puzzles, uncover Epyka\u2019s wondrous secrets, defeat a malevolent force and ultimately fulfil a destiny they never expected.\n\n", "short_description": "EPYKA is a family friendly adventure that will appeal to all those who enjoy exploration and puzzle solving. EPYKA is set in a bright, vibrant, colourful, stylised world that immediately engages with the player."}]}, "developer_name": "Singular Perception", "developer_privacy_policy_url": "https://www.singularperception.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Singular Perception", "support_webs
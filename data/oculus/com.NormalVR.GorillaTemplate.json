ng", "id": "1285893169965431", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304305_1285893173298764_7539557642295252471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaXafxOW2eQQ7kNvwG6E38k&_nc_oc=AdpLWoiiuVVFOTatsdsIsx8KLnDMpurJHqL6clT-vTONogrXZy8k5bcowNQh9G47Gzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRKujEdDZGHlNciXWSjld7ZyOSAQ8LHWunvUm5NJDWcg&oe=6ADE0DE0"}, {"file_name": "Untitled.png", "id": "1923330311955410", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308575_1923330315288743_912968072525287752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36b0gFajYE8Q7kNvwFnkXM-&_nc_oc=AdqDZGZUdsg9nshwuxJDuI2fCLONcKBRKT3-KpD0gWRzJKflMj2Sx1HoGPPR6iNSc_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQgSaCM6OYgxZnBff4-AzD6L9_T2TjtBYGnq6fDknpvg&oe=6ADE15E1"}, {"file_name": "Untitled.png", "id": "1194898328873472", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_1194898332206805_2861506729731868887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMslWciZiGQQ7kNvwHEMNiD&_nc_oc=AdrJveusIGOPPKDa5YMOdoGGuQ0pxBejy6BbLiKx7YshjHJzhYFIcsOQrHyLlpWa4qQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAdRhwuq28hOAcvE2LECkntXWYxEWWoD6MDkKHwFsu5w&oe=6ADE0C21"}, {"file_name": "Untitled.png", "id": "1441975080927377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307315_1441975084260710_8373938286152957657_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaAkIGPpojwQ7kNvwGe4F1g&_nc_oc=AdqLlfR1ghCMau8OcwGbM8GZYV4-b99uU4cfVuUuKiYKJshdhw2stThYlwvNyqGWt-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYKKEiMte_kXmEafqAwQxUEmbQmumQwwEQwD7C9h_ssg&oe=6ADE110C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Banani", "keywords": ["Mutiplayer", "Hangout"], "long_description": "Chimpanzee Banani is a VR multiplayer movement experience that pushes arm-based locomotion to the next level. Inspired by Gorilla Tag, the game blends intense climbing, zero-gravity physics, and horror elements with social hangout spaces designed just for VR.\n\nMove using your arms to swing, climb, and launch yourself across a variety of maps. \n\nFace spooky horror zones that keep you on edge, then relax and hang out with friends in chill locations like the beach or the main lobby. Whether you\u2019re climbing higher, exploring eerie environments, or just messing around with friends, Chimpanzee Banani delivers fast-paced movement, social fun, and unforgettable VR moments.\n\nBuilt for VR. Powered by movement. Welcome to Chimpanzee Banani.", "short_description": "Chimpanzee Banani is a VR multiplayer movement game inspired by Gorilla Tag, featuring horror modes, and zero-gravity gameplay style climbing challenges. Swing, climb, and launch yourself through creepy and chill environments like haunted zones, the beach, and the lobby\u2014all built for fast, fun VR movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1XBOCoINLulK7HBar84EwGBWH2QyyExNdmfqaZ9eHP5s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Michael Skalecki", "support_website_url": null, "website_url": "https://express.adobe.com/page/JcyTah776HUEG/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
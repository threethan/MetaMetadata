190217773_245221400686386112_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJL-uHxG0mQQ7kNvwGvdCrA&_nc_oc=Ado7dRYveMa_AasiyYAooKcy_YnnGANgPYHfOEj8vkJhYYAKYZKiDzh3IErLvGoHGgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6sY7Yj8Fre5qufyeaCSpl0JFyd2RhY2FesDR-cStOCg&oe=6A99725C"}, {"file_name": "Screenshot 2026-08-27 143051.png", "id": "1445804704033647", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301196_1445804710700313_5683587437832379264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXU4RsjdzoYQ7kNvwG7bRRb&_nc_oc=Adq0i_Ghn771rNo9jRLkVhl46zzANhp010-QKQHQVEw_YTDGYDGZs4NbRDWOdQD5fdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvtyhlCd_UJj4ktt73UuRi_1cSzKJpqEpaB7L0OHz8eg&oe=6A999286"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Banani", "keywords": ["Mutiplayer", "Hangout", "Horror"], "long_description": "Chimpanzee Banani is a VR multiplayer movement experience that pushes arm-based locomotion to the next level. Inspired by Gorilla Tag, the game blends intense climbing, zero-gravity physics, and horror elements with social hangout spaces designed just for VR.\n\nMove using your arms to swing, climb, and launch yourself across a variety of maps. \n\nFace spooky horror zones that keep you on edge, then relax and hang out with friends in chill locations like the beach or the main lobby. Whether you\u2019re climbing higher, exploring eerie environments, or just messing around with friends, Chimpanzee Banani delivers fast-paced movement, social fun, and unforgettable VR moments.\n\nBuilt for VR. Powered by movement. Welcome to Chimpanzee Banani.", "short_description": "Chimpanzee Banani is a VR multiplayer movement game inspired by Gorilla Tag, featuring horror modes, and zero-gravity gameplay style climbing challenges. Swing, climb, and launch yourself through creepy and chill environments like haunted zones, the beach, and the lobby\u2014all built for fast, fun VR movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/5460c3aa-9a29-4619-a971-05a475035083", "developer_terms_of_service_url": null, "publisher_name": "Michael Skalecki", "support_website_url": null, "website_url": "https://express.adobe.com/page/JcyTah776HUEG/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28400965566258251"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499309014_24790067023999463_735070770930030134_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY-vYkigAI0Q7kNvwFyMIDd&_nc_oc=AdoFA4gJ3u-359-lO5JTe4rKZBfOkAXjM24xdskHSSTEbR4pBK5FPVggBz9bpc8meSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgM5aKbSCUtEd5ie8KLl18xvi22zCxfc9oriMFHM6log&oe=6A998D35"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimpanzee Banani", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 17673
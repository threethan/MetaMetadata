tled.png", "id": "1285893169965431", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499304305_1285893173298764_7539557642295252471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5GKHZGf7qAQ7kNvwFuooWo&_nc_oc=AdpKY_tRAZz2Eys7_t5F_-EcM3O-C2Vi-C_ZDlnP3SyAINznwX309VCkDn7TbGtZ8W4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9K5XubTj8GUOp5-X440NHB9lMgCK_GiI_XB5cJ2uC2A&oe=6AAE97E0"}, {"file_name": "Untitled.png", "id": "1923330311955410", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499308575_1923330315288743_912968072525287752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAvhUKCFm7QQ7kNvwEktMy_&_nc_oc=Adr3E-moKmpd8yX56ZSUYekvoV1Ap92q38jmpHZYNbs9C7QCZAziNsk_RsVfm-MiUlw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcnv_PWQGTy-r2bo9PY6sAiQqatrjkv4mtCkZtaV7b5w&oe=6AAE9FE1"}, {"file_name": "Untitled.png", "id": "1194898328873472", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499307311_1194898332206805_2861506729731868887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIPxysOhmiIQ7kNvwFtKk90&_nc_oc=AdoaPzYoGqokuaLvRpkNN9D-XsRvGNtryuuuDD8dnzwHJ_fe33dvHUuiCg1PDEMLO4c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1tSShfvg4fLLJF-GdUMOCVbXkC6pggzAY6gOPZ40gXw&oe=6AAE9621"}, {"file_name": "Untitled.png", "id": "1441975080927377", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307315_1441975084260710_8373938286152957657_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ4QNCZcF0gQ7kNvwEZ-qj5&_nc_oc=AdrzviGlwoO5GAdp17KmhKBpMmcuZnbal5efmwI1tX5N9ws6Dm4y25wxjx_Ff8YpFZE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-9aWbwpZg-Hyihs0SpArJl9mLezxBpg54uCJzxlLBZQ&oe=6AAE9B0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Banani", "keywords": ["Mutiplayer", "Hangout"], "long_description": "Chimpanzee Banani is a VR multiplayer movement experience that pushes arm-based locomotion to the next level. Inspired by Gorilla Tag, the game blends intense climbing, zero-gravity physics, and horror elements with social hangout spaces designed just for VR.\n\nMove using your arms to swing, climb, and launch yourself across a variety of maps. \n\nFace spooky horror zones that keep you on edge, then relax and hang out with friends in chill locations like the beach or the main lobby. Whether you\u2019re climbing higher, exploring eerie environments, or just messing around with friends, Chimpanzee Banani delivers fast-paced movement, social fun, and unforgettable VR moments.\n\nBuilt for VR. Powered by movement. Welcome to Chimpanzee Banani.", "short_description": "Chimpanzee Banani is a VR multiplayer movement game inspired by Gorilla Tag, featuring horror modes, and zero-gravity gameplay style climbing challenges. Swing, climb, and launch yourself through creepy and chill environments like haunted zones, the beach, and the lobby\u2014all built for fast, fun VR movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1XBOCoINLulK7HBar84EwGBWH2QyyExNdmfqaZ9eHP5s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Michael Skalecki", "support_website_url": null, "website_url": "https://express.adobe.com/page/JcyTah776HUEG/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "us
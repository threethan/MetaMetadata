ng", "id": "1285893169965431", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304305_1285893173298764_7539557642295252471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZgcKrN-Qm8Q7kNvwFdhW7Q&_nc_oc=AdoHHJ5MxilZ18a2eVpH6fd2-Ils1VNLZj0LRmULRc-OBNUPwVNx4pcLrO_aWOh4Naw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXG8ts1qmUy4lJD1M4AAbNwJGbpUK2KdZT2tJZANrxFQ&oe=6AF1D460"}, {"file_name": "Untitled.png", "id": "1923330311955410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308575_1923330315288743_912968072525287752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0prdjhxI8wQ7kNvwFZY7MA&_nc_oc=AdqiTZvj2A9QrBj3CkkEyQNnFpGUQvT3ruY4S88mK__KJPvrR4V3DTzx-xpmIeC3IKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFV_2J5Z0tK2iAdXsUN3EApgKjVtSXa8bhImv-Wo9gKQ&oe=6AF1DC61"}, {"file_name": "Untitled.png", "id": "1194898328873472", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1194898332206805_2861506729731868887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYiJZWApBIoQ7kNvwGFwI89&_nc_oc=AdoO7MfLcza4e_qTUzo1EYjfCaUM3vqYrPVa1EagFfJgcRfk0JhhvWXXhcgmhGA-CO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh9eWfjrCHT08dJBcmvJ5XUXmiFFxy8syZaQD8rqZHJQ&oe=6AF20AE1"}, {"file_name": "Untitled.png", "id": "1441975080927377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307315_1441975084260710_8373938286152957657_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QgxDt9EI0oQ7kNvwG0oNAF&_nc_oc=AdqaVYNGfZJrmwTDHsdMkjd2CYaDNzSG4MBa6YzaibvnYkJnVQopXh1C1nrktARCnes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvM7yCyDIlrTDRDx0E_EALa-0bhlgMQSAxojdlc6VfXg&oe=6AF1D78C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Banani", "keywords": ["Mutiplayer", "Hangout"], "long_description": "Chimpanzee Banani is a VR multiplayer movement experience that pushes arm-based locomotion to the next level. Inspired by Gorilla Tag, the game blends intense climbing, zero-gravity physics, and horror elements with social hangout spaces designed just for VR.\n\nMove using your arms to swing, climb, and launch yourself across a variety of maps. \n\nFace spooky horror zones that keep you on edge, then relax and hang out with friends in chill locations like the beach or the main lobby. Whether you\u2019re climbing higher, exploring eerie environments, or just messing around with friends, Chimpanzee Banani delivers fast-paced movement, social fun, and unforgettable VR moments.\n\nBuilt for VR. Powered by movement. Welcome to Chimpanzee Banani.", "short_description": "Chimpanzee Banani is a VR multiplayer movement game inspired by Gorilla Tag, featuring horror modes, and zero-gravity gameplay style climbing challenges. Swing, climb, and launch yourself through creepy and chill environments like haunted zones, the beach, and the lobby\u2014all built for fast, fun VR movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1XBOCoINLulK7HBar84EwGBWH2QyyExNdmfqaZ9eHP5s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Michael Skalecki", "support_website_url": null, "website_url": "https://express.adobe.com/page/JcyTah776HUEG/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
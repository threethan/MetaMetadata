ng", "id": "1285893169965431", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304305_1285893173298764_7539557642295252471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUVlxJHq4rAQ7kNvwGLFte1&_nc_oc=Ado2dpOmjuo3FnL7JIoF3G-IO4l5XEmJawJfTKKjaZ488naVe22geNNo3uweK-MjUZE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc0b_PeFLeBPfZcUjQ2XjCTn_2rgpc7e2v8UX8JLml5w&oe=6AD3BA20"}, {"file_name": "Untitled.png", "id": "1923330311955410", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308575_1923330315288743_912968072525287752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMTefPUhl7IQ7kNvwEh0UXU&_nc_oc=AdoX5s3gKCKzy7nWdK3GE0Vaz3JowlD2nhYtbtpW_HkyZ5_m8AXG3ijeWU0vysbMqsM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkC1RMahkhIqQB-gCaNnGFpTf_izpln8ME8dDkktLS7w&oe=6AD389E1"}, {"file_name": "Untitled.png", "id": "1194898328873472", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307311_1194898332206805_2861506729731868887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEtK-4S78Y0Q7kNvwGEwzQ4&_nc_oc=AdounG4eOWnAc0VU-xbEedjnqjKrXgCfWrtpztuJghVNIrUFq46fPMmoeg_vtz7jYLA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBiGCXVjEFfADgoqIO2mJ7hW7woea-05LxCChhlMKFjQ&oe=6AD3B861"}, {"file_name": "Untitled.png", "id": "1441975080927377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307315_1441975084260710_8373938286152957657_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2dC0TLesTIQ7kNvwE0BgFu&_nc_oc=AdoAfvrQeypHaX_osPrwusEfoTntEAUjA11uCWz_Wz4my8OzBsMlWpX-TGFSY75Go2Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc0elFb8v9u23-GydUk6zZzoOR_E_YB5BDi_vIM1GPYg&oe=6AD3850C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Banani", "keywords": ["Mutiplayer", "Hangout"], "long_description": "Chimpanzee Banani is a VR multiplayer movement experience that pushes arm-based locomotion to the next level. Inspired by Gorilla Tag, the game blends intense climbing, zero-gravity physics, and horror elements with social hangout spaces designed just for VR.\n\nMove using your arms to swing, climb, and launch yourself across a variety of maps. \n\nFace spooky horror zones that keep you on edge, then relax and hang out with friends in chill locations like the beach or the main lobby. Whether you\u2019re climbing higher, exploring eerie environments, or just messing around with friends, Chimpanzee Banani delivers fast-paced movement, social fun, and unforgettable VR moments.\n\nBuilt for VR. Powered by movement. Welcome to Chimpanzee Banani.", "short_description": "Chimpanzee Banani is a VR multiplayer movement game inspired by Gorilla Tag, featuring horror modes, and zero-gravity gameplay style climbing challenges. Swing, climb, and launch yourself through creepy and chill environments like haunted zones, the beach, and the lobby\u2014all built for fast, fun VR movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1XBOCoINLulK7HBar84EwGBWH2QyyExNdmfqaZ9eHP5s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Michael Skalecki", "support_website_url": null, "website_url": "https://express.adobe.com/page/JcyTah776HUEG/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
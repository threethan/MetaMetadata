ng", "id": "1285893169965431", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304305_1285893173298764_7539557642295252471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUVlxJHq4rAQ7kNvwGLZGdE&_nc_oc=Adp-XfQLWWr6Kdelhd4P5m8OqBDYskhGQokZCOzZ5BcXhcVee-vYdV1TLB0wVVZBMis&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeNBztMcE36v-3fCHyITJD4Wn67kuwT261KQx9kOhHfg&oe=6AD0DEE0"}, {"file_name": "Untitled.png", "id": "1923330311955410", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308575_1923330315288743_912968072525287752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVewKxuIw7AQ7kNvwH0hgnc&_nc_oc=AdpYScMa-jPgvJOsVfi6RtGfmWdkCv01UsL7XnefhI59MaNv9x8rAGU_l6H1Ent3FSg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3QvS-IWPfxmwQeMexuTKDyCtewSvo31x81fGQcfWEag&oe=6AD0E6E1"}, {"file_name": "Untitled.png", "id": "1194898328873472", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307311_1194898332206805_2861506729731868887_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEtK-4S78Y0Q7kNvwFC-IeY&_nc_oc=AdoLfeJRibESleFQ0kitbk8BCm2kAjXF-cWGqBYqMyFqUw4xNl7_qlftfrH7QoUZV5o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCOXs_2iTs9U_CVdojm8BaN9ZhqPUm9gPEs_B-DD0vAA&oe=6AD0DD21"}, {"file_name": "Untitled.png", "id": "1441975080927377", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307315_1441975084260710_8373938286152957657_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vSGmpSX6T4Q7kNvwGeJ94p&_nc_oc=AdokMRVcZxcz4pE6lCZnYZ0s5lY-GopNdANRoc6IJeKt-DGgc7B1I0HWE1lKqrPV5AA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv63Q0yNSv-Sv5TbJAuRhSLAtvfY09ZPeRTM9UE_VJmA&oe=6AD0E20C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Banani", "keywords": ["Mutiplayer", "Hangout"], "long_description": "Chimpanzee Banani is a VR multiplayer movement experience that pushes arm-based locomotion to the next level. Inspired by Gorilla Tag, the game blends intense climbing, zero-gravity physics, and horror elements with social hangout spaces designed just for VR.\n\nMove using your arms to swing, climb, and launch yourself across a variety of maps. \n\nFace spooky horror zones that keep you on edge, then relax and hang out with friends in chill locations like the beach or the main lobby. Whether you\u2019re climbing higher, exploring eerie environments, or just messing around with friends, Chimpanzee Banani delivers fast-paced movement, social fun, and unforgettable VR moments.\n\nBuilt for VR. Powered by movement. Welcome to Chimpanzee Banani.", "short_description": "Chimpanzee Banani is a VR multiplayer movement game inspired by Gorilla Tag, featuring horror modes, and zero-gravity gameplay style climbing challenges. Swing, climb, and launch yourself through creepy and chill environments like haunted zones, the beach, and the lobby\u2014all built for fast, fun VR movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1XBOCoINLulK7HBar84EwGBWH2QyyExNdmfqaZ9eHP5s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Michael Skalecki", "support_website_url": null, "website_url": "https://express.adobe.com/page/JcyTah776HUEG/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
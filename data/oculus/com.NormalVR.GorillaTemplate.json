LQB5fWewcfh5-p9SFUiMXoU26KjoUGH3XaxdG7l4OrUN1GFJaD1VoSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz776UL6lUySSu5iwF9lamgzYO5KBGUPRkQe6QOf2YzA&oe=6AFC8D03"}, {"file_name": "Untitled.png", "id": "1285893169965431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_1285893173298764_7539557642295252471_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6p-ADJY-cEQ7kNvwHs7yk_&_nc_oc=AdogfG37GKE0x-vVW_j-RDtjr759lL8eGwtDDvHMjWUC5vc3qYdmOryCjcfOzTRc9gY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp3UrI95LjXHmCCIsf0CgCCw8laQzYBWFJY2dgTni4zw&oe=6AFC6060"}, {"file_name": "Untitled.png", "id": "1923330311955410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308575_1923330315288743_912968072525287752_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBxGXA7SLD0Q7kNvwEbKOm3&_nc_oc=AdoNLnqsIug2OaZ0l0RA_Qry6lRZqfk58A6HCr9_fNDtUDmokhE4hz-wsMkg1ufOUG0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO_DiIHHrZIF2Ke428ref94BMy_6rPAfloz6cwgrYeiw&oe=6AFC6861"}, {"file_name": "Untitled.png", "id": "1194898328873472", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1194898332206805_2861506729731868887_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSwD8jLNqA4Q7kNvwFf0zPx&_nc_oc=AdrT9hPBh6xqZQhu7K4SO68yTt1raCf2ymk4tHOSLnfTN1NfdB6JZd0WJRRsfmFlvNY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH9AEGXSaF6wpec3GPQFE34Ew_a2M-bNuiao8LFKYhfQ&oe=6AFC5EA1"}, {"file_name": "Untitled.png", "id": "1441975080927377", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307315_1441975084260710_8373938286152957657_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STj7qLefQ3sQ7kNvwHUDQxO&_nc_oc=Adr2Y2Lds3rP0jpyubDpAsz6RkqNvwvkT2bPEbmIrgxWJU86EHVmFctuhGMh-iC3P-s&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTUDgmkung9pzaR1MRvgpnRmJc27lu41TLtFN6rlpSQA&oe=6AFC638C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Banani", "keywords": ["Mutiplayer", "Hangout"], "long_description": "Chimpanzee Banani is a VR multiplayer movement experience that pushes arm-based locomotion to the next level. Inspired by Gorilla Tag, the game blends intense climbing, zero-gravity physics, and horror elements with social hangout spaces designed just for VR.\n\nMove using your arms to swing, climb, and launch yourself across a variety of maps. \n\nFace spooky horror zones that keep you on edge, then relax and hang out with friends in chill locations like the beach or the main lobby. Whether you\u2019re climbing higher, exploring eerie environments, or just messing around with friends, Chimpanzee Banani delivers fast-paced movement, social fun, and unforgettable VR moments.\n\nBuilt for VR. Powered by movement. Welcome to Chimpanzee Banani.", "short_description": "Chimpanzee Banani is a VR multiplayer movement game inspired by Gorilla Tag, featuring horror modes, and zero-gravity gameplay style climbing challenges. Swing, climb, and launch yourself through creepy and chill environments like haunted zones, the beach, and the lobby\u2014all built for fast, fun VR movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1XBOCoINLulK7HBar84EwGBWH2QyyExNdmfqaZ9eHP5s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Michael Skalecki", "support_website_url": null, "website_url": "https://express.adobe.com/page/JcyTah776HUEG/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
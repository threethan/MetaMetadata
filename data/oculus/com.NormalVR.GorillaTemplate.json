cZClm3KDKa_5aLMPbJfso0Y0KWLAO-5TyF8eQimBpjyhnjVjx5aGhhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDlmK03USxG8_5Cr3VfTqWtkF_jeeIBoTKb9qXm6UXVg&oe=6B09BC03"}, {"file_name": "Untitled.png", "id": "1285893169965431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_1285893173298764_7539557642295252471_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJzItkMBIAkQ7kNvwEAZoQ4&_nc_oc=AdrgDCLnn4UuX9GvTGYICFzzVMl4QVjeGmbHTbsiA8NCqFc7gHwsApbdFlhyptB7lts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeKTsyXmscCYaapXF8JSCsnDPju3xEm4vuRM7eEOnbPQ&oe=6B09C7A0"}, {"file_name": "Untitled.png", "id": "1923330311955410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308575_1923330315288743_912968072525287752_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDGJdbxFWfwQ7kNvwE88Oln&_nc_oc=AdpQY7b7rluNBjMdV7P4YomDeAZqHFwNDGfdTK7VGh1FMehPh-fP_MuzyzWOXnKTwUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHbxJOiHZEeOIBqhY19UAkrKeZNe4FteHA3DoyEsy-HQ&oe=6B09CFA1"}, {"file_name": "Untitled.png", "id": "1194898328873472", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1194898332206805_2861506729731868887_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAo2kFpTxxMQ7kNvwEmF3bU&_nc_oc=AdohCW5mBZ1Pk_4kyyG5BT2ndl4muVN2f6UJbXv6GmCiFzN6hNqsUK0sPmLbsB5eBJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYoEB-BPw1Nr8P-c05YBEOP8vAWDq8giFlZtllt24Fxw&oe=6B09C5E1"}, {"file_name": "Untitled.png", "id": "1441975080927377", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307315_1441975084260710_8373938286152957657_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx6DDR2wriQQ7kNvwHVzRuw&_nc_oc=Adq7aNa4NxbPfaExxNyQaG-ZNPw49jiBybzo8IUYpblFOPAczPwRPXMOpeCuB0TVIPs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUhO81ST7kH86jAafMK7qBV6VpvHH1xnoDWS0mvlH6DA&oe=6B09CACC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Banani", "keywords": ["Mutiplayer", "Hangout"], "long_description": "Chimpanzee Banani is a VR multiplayer movement experience that pushes arm-based locomotion to the next level. Inspired by Gorilla Tag, the game blends intense climbing, zero-gravity physics, and horror elements with social hangout spaces designed just for VR.\n\nMove using your arms to swing, climb, and launch yourself across a variety of maps. \n\nFace spooky horror zones that keep you on edge, then relax and hang out with friends in chill locations like the beach or the main lobby. Whether you\u2019re climbing higher, exploring eerie environments, or just messing around with friends, Chimpanzee Banani delivers fast-paced movement, social fun, and unforgettable VR moments.\n\nBuilt for VR. Powered by movement. Welcome to Chimpanzee Banani.", "short_description": "Chimpanzee Banani is a VR multiplayer movement game inspired by Gorilla Tag, featuring horror modes, and zero-gravity gameplay style climbing challenges. Swing, climb, and launch yourself through creepy and chill environments like haunted zones, the beach, and the lobby\u2014all built for fast, fun VR movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1XBOCoINLulK7HBar84EwGBWH2QyyExNdmfqaZ9eHP5s/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Michael Skalecki", "support_website_url": null, "website_url": "https://express.adobe.com/page/JcyTah776HUEG/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
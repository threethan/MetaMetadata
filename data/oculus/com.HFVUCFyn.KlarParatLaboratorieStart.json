"keywords": ["VUCFYN", "HF", "Education", "Laboratory"], "long_description": "Ready, Set, Laboratory Start is a laboratory experience designed as an introductory course for HF & VUC Fyn\u2019s chemistry laboratory. Learn safety procedures and proper lab conduct before performing experiments such as precipitation reactions, titration of acetic acid, oxidation of alcohols, and substitution and addition reactions. Perfect for students looking to prepare in an interactive and engaging VR environment!", "short_description": "Ready, Set, Laboratory Start is a laboratory experience designed as an introductory course for HF & VUC Fyn\u2019s chemistry laboratory. Learn safety procedures and proper lab conduct before performing experiments such as precipitation reactions, titration of acetic acid, oxidation of alcohols, and substitution and addition reactions. Perfect for students looking to prepare in an interactive and engaging VR environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/vucfyn.net/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HF og VUC Fyn", "support_website_url": null, "website_url": "https://www.vucfyn.dk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24125596723691591"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculus
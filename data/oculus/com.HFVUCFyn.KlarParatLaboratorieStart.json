i3DNLQ9o4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98HCVsNJXW4z7R_iV6gJOFe1XO_Kg0cGCTl2n3-8wURA&oe=6A47B217"}, "display_name": "Klar, Parat, Laboratorie Start", "keywords": ["VUCFYN", "HF", "Uddannelse", "Laboratorie"], "long_description": "Klar, Parat, Laboratorie Start er en laboratorieoplevelse, der fungerer som et introduktionskursus til HF & VUC Fyns kemilaboratorie. L\u00e6r sikkerhedsprocedurer og korrekt laboratorieadf\u00e6rd, inden du udf\u00f8rer eksperimenter som f\u00e6ldningsreaktion, titrering af eddikesyre, oxidation af alkoholer samt substitution og addition. Perfekt til studerende, der \u00f8nsker at forberede sig i et interaktivt og engagerende VR-milj\u00f8!", "short_description": "Klar, Parat, Laboratorie Start er en laboratorieoplevelse, der fungerer som et introduktionskursus til HF & VUC Fyns kemilaboratorie. L\u00e6r sikkerhedsprocedurer og korrekt laboratorieadf\u00e6rd, inden du udf\u00f8rer eksperimenter som f\u00e6ldningsreaktion, titrering af eddikesyre, oxidation af alkoholer samt substitution og addition. Perfekt til studerende, der \u00f8nsker at forberede sig i et interaktivt og engagerende VR-milj\u00f8!"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3535560159909375", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_3535560173242707_5479737608755447133_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsViSmi7AscQ7kNvwFhdm_0&_nc_oc=AdqPfGTppg0ekP5rnFbZQxKftGkxHcrUnT5Casa4POcae-hxjKdT2L1W0WjSzqQfkGs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tDETw6wpfBbrp964vzUcCLrt6F25IDTYOtYGq5QnQFQ&oe=6A47D4E5"}, {"file_name": "SquareV2EN.png", "id": "1709818859965519", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1709818863298852_1513888621232161053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T8CdCbkDUgQ7kNvwGeYDKK&_nc_oc=Adps4rNG7tTmgg7U06Km8wjbrVXMTC8SM0U_46qe_sdQx
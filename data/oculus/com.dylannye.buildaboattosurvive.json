ohc=zwIAYWOJu5gQ7kNvwH6Bngx&_nc_oc=AdpbdSFUlDhQ9yWA_dv3FmpQftr01-ihrQkZjkOHtpLLnUS41spRx91-nKN41u6eBcE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRoEu7f-XGbAOzQxaQaJXoXxa5DEDd5wY6NY6Sm59kvg&oe=6AFB1BE1"}, {"file_name": "S1.png", "id": "1664460655259163", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673652249_1664460661925829_7268062513035667410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3D75XDvQYkQ7kNvwFHk0IH&_nc_oc=AdpsHVr1-tXyfNnTmtMAlSHCGnWyP-kH1wnfn20sbV3QgdqixHuyMG4RrzHtTFoTOuw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUHDa7kQuFT-2fWY4vho679fdGKcEnA4FnvdsZ0kwxbw&oe=6AFB3DA7"}, {"file_name": "S3.png", "id": "1125874587065902", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/613034358_1125874590399235_6998474057762135819_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_Tzn9losHUQ7kNvwEMKI7v&_nc_oc=AdqOXJjcH4Prw5_a3DHZH5KheohtdBiJKjGaENy9t9kwyRJfMub08uw-kIidIHukLAM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKrIss8a3lR-3HAZPTpBqjLwla8r2WgGsh1TPr4psmuQ&oe=6AFB1BBA"}, {"file_name": "S4.png", "id": "939881565591141", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673516539_939881568924474_8654462076272830907_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoboduNQNBYQ7kNvwEUXsQc&_nc_oc=AdrVxvhv9KNRaxOH0CyoCW3DDDOCd08IkX4lGC4MWRylAEST1dPfwgFKkRJYirSzZjU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkT3RNAT6zoKfVYTtgfOXTKqbkiyLyHQEzWl0YWkjDMg&oe=6AFB1D5A"}, {"file_name": "S2.png", "id": "1428015208795393", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/825629712_1428015215462059_6712148048473219601_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkp23XKggUcQ7kNvwGsg4Ge&_nc_oc=AdoWBUErv2fWxrsi_-YvgqUN6nhwHtlqtt_FQ9i34asX2ODkqf8cHTPSla4WIEefBoY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsIJIW39bXcIxZR4nQLTWQuDBWUlpM4RtMwTB9f1qjCg&oe=6AFB4563"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BABCover.png", "id": "1432053629116884", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/654944867_1432053632450217_2507533807527108825_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDY5dvbjANkQ7kNvwHtz-xY&_nc_oc=AdrT6JqGntTPBhNrRndbsNscjTHwR8CJNvnFfnXrq9BQfcE81OgXzVJZxo__rk1blbQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7oQZoA0WqrvE6XMQ34GYeep3_oIE0WhG-NIf_M1Q5vQ&oe=6AFB4A52"}, "display_name": "Build a Boat to Survive", "keywords": ["building", "sailing", "disaster", "survival"], "long_description": "**Build it. Sail it. Survive it.**\n\nBuild A Boat To Survive is a VR boat-building survival game. You don\u2019t have to reach a finish line. You just have to still be floating when the disaster ends. Build, fight, and survive.\n\n{1780859906463702}\n\n**BUILD YOUR BOAT BLOCK BY BLOCK**\n\nGrab wood blocks, seats, cannons, sails and more, and snap them together with your own hands in the shipyard. Every boat needs a ship\u2019s wheel, a mainsail and a seat. After that it\u2019s up to you. Build a wide raft that\u2019s hard to sink, a fast sloop that can outrun trouble, or a floating fortress full of cannons. Pick your captain\u2019s colour, press READY and launch.\n\n{2312143772911946}\n\n**21 DISASTERS. ONE BOAT.**\nOnce you\u2019re out on the water, the sea turns on you.\n\n{1875607896781370}\n\n**SURVIVE TOGETHER**\n\nPlay with friends or jump into matches with players online. Build side by side, crew one boat together, or race to see whose boat sinks last. Grab the wheel, pull a mate back on board, and yell when the Kraken shows up.\n\n**EARN GOLD AND RANK UP**\n\nEach match pays out gold and Captain XP for taking part, staying alive and throwing skeletons overboard.\n\nGrab your hammer and hoist the sail. The sea is coming.", "short_description": "Build a boat block by block, then try to keep it afloat. Krakens, ghost ships, tempests and powder kegs are all coming for you, across 21 disasters. Sail solo or crew up with friends online. The last captain standing takes the gold."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1429714885331208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673689288_2610135726115987_470850351856016072_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiPStLTjQ1kQ7kNvwGBr1jj&_nc_oc=AdqBR87Ng4U6V9cWIRH8lhNiFUAeIeZqF7dWKKOFEkm1ynO1194kfT7EOlIBXgo5SPE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMUrurzKBauAdfhxVmep4KzYNN_fm3sl6D073xcS1D1g&oe=6AFB4A57"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Build a Boat to Survive", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Surviva
nments, and sudden audio or visual effects.", "short_description": "A multiplayer VR horror game featuring arm-based locomotion, fast movement, and social gameplay inspired by Gorilla Tag\u2013style experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/projectprimal/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "FSGames (FSVR)", "support_website_url": null, "website_url": "https://sites.google.com/view/projectprimal/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "25018796781129882"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1149501190487017"}]}, "baseline_offer": {"id": "1149501190487017"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772558100, "status": "PUBLISHED", "id": "1149501190487017"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25215080344834857", "version": "0.2.9"}, "id": "773808635786766", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24966504129692481", "is_concept": false, "latest_released_binar
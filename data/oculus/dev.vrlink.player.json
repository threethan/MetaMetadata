xNMQ7kNvwFQv9HC&_nc_oc=AdqxOVI1SzekrNhLIRdEaD4RMPvv3BadZM0TYDBMSX6_V1EvtZawEcqUKg35BxNlNrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM3_w-n5uL8GS9IT4GFL-nYWNKLzYeU3Q_EpuyG2CloQ&oe=6AEB5739"}, {"file_name": "2-subtitle-menu.png", "id": "1419585666973870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_1419585670307203_4902503351763634687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhrneVY6rowQ7kNvwHYeYvP&_nc_oc=Adphmq_Fupi8BEcjX79DTQRLVxSqhQ8ehpA2u3cUQk_SFcYXetmdhOO4H_obot7nKmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjYrjwZK6MLG0fzK2S5776wVfbfmZInM6c668UMY7M5w&oe=6AEB5B04"}, {"file_name": "3-360-video.png", "id": "1405748231146464", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620316_1405748234479797_4688823819564853402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV6Lsy3YaLwQ7kNvwGkuCaC&_nc_oc=AdrElDBpP-XtTllh11EZIoYbMd7LGD4GJbonK8zEZIIkW7VzVCA9ENtnTsRAefnrbAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMNOQAsxCVFEquM43Xzdr5tRkWIjOZuICAXz0Ht_uxmw&oe=6AEB4EBC"}, {"file_name": "4-subtitle-settings.png", "id": "1124137760155163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628092_1124137763488496_7806207681770845589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSXyAigk7QAQ7kNvwFYkO5f&_nc_oc=AdpXguhOWst79t7ANdtZSHzTGE8Rq9E0ij3HuSbAox54vvhyHXW3V9UzJ8I_WXgwfQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlWvJRFFRRA8KtfCLcwKpXliXFx2TNzWbMX5RIHIjY3g&oe=6AEB2D85"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnewHXu7N2QQ7kNvwEC2NY7&_nc_oc=AdpFMDI0LIVJGTbi5AXtlgYEYpO1lERztrGmQRyK_irNdtAIFF6xlF4YGW4buXFEoeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Qx82GxT1XBK3zIDsdTQLZ5fTEXzgQE4nyGK9FuVFww&oe=6AEB2DFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1395218070347720", "version": "0.7.24"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1395218070347720"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793418552, "id": "1395864473616413", "version": "0.7.26", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1395218070347720"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793416676, "id": "1395778786958315", "version": "0.7.25", "version_code": 56, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1395218070347720"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Smooth screen resizing, steadier pictures, next videos start sooner\n\u2022 Resizing the video screen, or turning 3D or accurate colors on or off, no longer flashes it dark: the screen before stays until the new one shows its first frame.\n\u2022 The next video of a playlist or archive gets ready while the current one plays, so it starts sooner.\n\u2022 The last 100 pictures stay on the headset's storage: going back to one shows it in about half a second, without downloading it again.\n\u2022 Stepping quickly through pictures loads only the one you stop on, so it shows sooner.\n\u2022 Far less memory used while viewing large pictures, which could close the app after a long session.", "created_date": 1793402201, "id": "1395218070347720", "version": "0.7.24", "version_code": 55, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1395218070347720"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Faster, sharper pictures, and whole fragmented videos\n\u2022 The next picture of a playlist or archive is loaded while you look at the current one, so it shows in about a tenth of a second instead of 2 to 3 seconds from a server.\n\u2022 Pictures you just saw stay in memory: going back shows them in about half a second, without downloading them again.\n\u2022 Switching pictures no longer freezes the view for a moment.\n\u2022 Very large pictures, such as 8192 \u00d7 5464, now show in 2D; before, nothing appeared.\n\u2022 Pictures and large videos are drawn at the resolution their screen can show: fine detail no longer flashes as dark specks while you resize or switch to 3D, and an enlarged picture shows more detail.\n\u2022 Grip an edge or corner of a picture to resize it, as with the video screen; one size is kept for both.\n\u2022 An archive or playlist link opens its first file about 3 seconds sooner.\n\u2022 Fragmented MP4 videos without a full index show their whole length and seek quickly.\n\u2022 When an online subtitle search fails, its row says why, such as a title too short to search; tap it to search by title, or tap the retry icon when trying again may help.", "created_date": 1793369927, "id": "1394291833773677", "version": "0.7.23", "version_code": 54, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1395218070347720"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Sound in step with the picture after earbuds come and go\n\u2022 Bluetooth earbuds or headphones put away and back while paused no longer leave the sound ahead of the picture when playing on.\n\u2022 When earbuds connect or disconnect while a video plays, the picture's brief speed-up and slow-down settle sooner.", "created_date": 1793180548, "id": "1387267147809479", "version": "0.7.22", "version_code": 53, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
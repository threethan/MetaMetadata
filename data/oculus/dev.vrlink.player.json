&oh=00_AQQliVu8Es1886uHeLLO_PAVuGfhPkrT3ZrsqYqoX2-oLg&oe=6B0B3060"}, {"file_name": "4-subtitle-menu.png", "id": "1770422170921849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499624656_1770422174255182_1464885918873116933_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7hRCEo3SOgQ7kNvwEVnPFR&_nc_oc=AdpcSUlxBtDIXNNMoNGMK4ITAqHQJzi0BppZA8DRErkxRdEN9dDIbi7Vge4FIjMUxRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAf1dP4Bb17xJxROCYHbkPiE7ppCXURAkIkNzuiMfySA&oe=6B0B272C"}, {"file_name": "5-file-menu.png", "id": "895153853684565", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623558_895153860351231_2134896274258043047_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvxIYx6NcVIQ7kNvwFXHdvW&_nc_oc=AdpSmOW4zQZERSZK3APqJLtau02tN11cXivhIUKbfdm7j9lUIohHOexHLr4yOcT8FPQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1FigYi82ekWrscDpFfLLS23AKa5Xo-eVdKvyVZgTNSA&oe=6B0B1F2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["video", "media", "360", "VR180", "subtitles"], "long_description": "VR Link Player turns any video link, or your own files, into your private cinema.\n\nPLAY WHAT YOU LINK\n\u2022 Movies and shows in 2D or 3D, 180\u00b0 and 360\u00b0 video, pictures and playlists.\n\u2022 Links, live streams, your headset's files, home servers and Windows or NAS shares.\n\u2022 A cinema-sized screen to stretch with a grab, or curve around you.\n\u2022 The right mode is picked for you; opens from web pages and apps.\n\n2D MADE 3D, TRUE COLORS\n\u2022 Any flat video or photo in real 3D: each frame its own depth, made on your headset, even 8K at 60 fps.\n\u2022 Accurate colors: SDR as made for TV, HDR tone-mapped to each scene.\n\nSMOOTH ON HUGE FILES\n\u2022 Downloads ahead as you watch: seeking back is instant, even if the connection drops.\n\u2022 See the frames as you drag the seek bar; jump \u00b110s with the thumbstick.\n\u2022 Picks up where you left off, with your audio and subtitles.\n\nSUBTITLES IN YOUR LANGUAGE\n\u2022 The video's own tracks, or OpenSubtitles with your free account.\n\u2022 AI translates subtitles into 80 languages, or makes them from the audio, with your free Groq key.\n\u2022 Place them where you like, even over 3D; nudge their timing.\n\nMADE FOR COMFORT\n\u2022 The room around you starts pitch black; brighten it any time.\n\u2022 Speed from 0.25\u00d7 to 2\u00d7, snap turn, recenter for watching lying down.\n\u2022 Controller buttons play, pause and stop; a built-in guide shows them all.\n\u2022 Details at a glance: resolution, HDR, codecs, every track.\n\nYou bring the links: VR Link Player doesn't provide or find video.", "short_description": "Paste a link or pick a file, press play: your videos on a giant screen or all around you in 180\u00b0/360\u00b0, with subtitles in your language."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388443121025215"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623558_2939113183116766_3816396785751376153_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7ZeAn2ezhoQ7kNvwGfEaAA&_nc_oc=AdqC4xjnKz5_lBOmAZGhvovazhOJf6-V4Ww72WLLcUXg8epxwBvGebYXjgtCXUMFaKg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYHGbKMa_8xbcL3EupVw7MUXtlY_f-Z_ckxLbM2KmRQg&oe=6B0B170D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Link Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1791902580, "lastRevision": {"nodes": [{"id": "1352415007961360", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1352414991294695", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1827279898284489"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "4534916820159462", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593815290_4534916823492795_3171706532997711046_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMsxVqjEhH4Q7kNvwGFU-OB&_nc_oc=AdoRETHB461JtTOJM36GO1WOheiTkmesJp-fNPtqNtQVaphRidZxxXGYKD0pgyUyc1c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMhtU32X-UR-HAuEKAljsoZW0vX7fLsWnL-N54ezxF2g&oe=6B0B18DA"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2939113179783433", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623558_2939113183116766_3816396785751376153_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7ZeAn2ezhoQ7kNvwGfEaAA&_nc_oc=AdqC4xjnKz5_lBOmAZGhvovazh
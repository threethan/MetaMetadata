, "id": "1107469931671382", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593942860_1107469935004715_6168229408760507926_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0NE91GOLawQ7kNvwHKfj3e&_nc_oc=AdrP3vJzIQQGrzknIaAtnH3WBNmw5fQ239OVlZIMlBr4Rjm_P4eq4fxgTTRu_b5wZsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP22XJQmdUcs_2EVfx1Z22JTBwI--GWvWVUQ5a9ag4-zg&oe=6ADF6B0A"}]}, "id": "1765626177997473", "locale": "en_US", "screenshots": [{"file_name": "1-link-panel.png", "id": "1470139141648502", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_1470139144981835_2679519420706697761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZML080JEB4Q7kNvwGSJli6&_nc_oc=AdpD9cjbYFinYSTQixfPr3YK7fiOcw6PBN4LGzwck2cCGKCMHbPWDLo8oH05IzyqkqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh4dUc0Qhr69jisTNun7bmNhluj7MDWuuu1K4bYy4g2A&oe=6ADF6A30"}, {"file_name": "2-360-video.png", "id": "1135497198983129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593790560_1135497202316462_2030901946487349583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PfwCQD-L4sQ7kNvwGdmkga&_nc_oc=AdpAftCDFJjGSkNqEIAZBa1SwwmDq_PKHSKRGd4jkvODb9fDY81ExVFTV89HSAoLt2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpqKnj4L7om_JXtofQa8By_OzKY6J0Z44topfu-RcU6g&oe=6ADF538F"}, {"file_name": "3-subtitle-settings.png", "id": "2143141713078656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619602_2143141716411989_7730943247921295285_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gQvxmQ8fpYQ7kNvwEvOTL5&_nc_oc=AdrxGDRFGgYKp2n19WUorAIUVkHd_vOs6T1_Zff7akfxBOzyCGnrn4NE-n5I1LF4IUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbZx2pOnKqUeQFWW-v5NbW_GiyYyUWTLrj4c-wStBVJA&oe=6ADF76A0"}, {"file_name": "4-subtitle-menu.png", "id": "1087692420544285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619382_1087692423877618_9090089854616291447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE08xsSEbpsQ7kNvwEKgGuQ&_nc_oc=Adp_stCqwZlFFtn_SXkOT1mnA2UZm6hYtSISAN7AtXk5UKnPPGasQAalRFgcippQV8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4R8QqsuY-CYUsSG6ISI30wIKRfqfeWs2hFEPx-v9pbQ&oe=6ADF456B"}, {"file_name": "5-file-menu.png", "id": "1094226826853819", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622184_1094226830187152_3581893724358968313_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIi0efmFKocQ7kNvwF0JOO7&_nc_oc=AdpS0GPCT1ajWHLrkTVPBSwrDvEprjfx8lrsz82YlOp4Q1fbWitiHgs9dVzNiBmRPZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNgVU4VxZ5MnPZoQBONNWbKnltzR-vHx6XghVOC9AZTQ&oe=6ADF45A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["video", "media", "360", "VR180", "subtitles"], "long_description": "VR Link Player turns any video link, or your own files, into your private cinema.\n\nPLAY WHAT YOU LINK\n\u2022 Movies and shows in 2D or 3D, 180\u00b0 and 360\u00b0 video, mono or 3D, pictures and playlists.\n\u2022 Links, live streams, your headset's files, home servers and Windows or NAS shares.\n\u2022 A cinema-sized screen you can stretch with a grab, or curve around you.\n\u2022 The right mode is picked for you; switch it anytime.\n\u2022 Opens from web pages and apps, playing at once.\n\nSMOOTH ON HUGE FILES\n\u2022 Downloads ahead as you watch: seeking back is instant, even if the connection drops.\n\u2022 See the frames as you drag the seek bar; jump \u00b110s with the thumbstick.\n\u2022 Picks up where you left off, with your audio and subtitles. Your last links wait in History.\n\nSUBTITLES IN YOUR LANGUAGE\n\u2022 The video's own tracks, or OpenSubtitles with your free account.\n\u2022 AI translates the video's subtitles into 80 languages as you watch, or makes them from the audio, with your free Groq key.\n\u2022 Put the subtitles where they're comfortable, even over 3D; nudge their timing.\n\nMADE FOR COMFORT\n\u2022 Dim the room around you, down to pitch black.\n\u2022 Speed from 0.25\u00d7 to 2\u00d7, snap turn, recenter for watching lying down.\n\u2022 Keeps playing in the dark, with headset tracking off.\n\u2022 Play, pause and stop from the controller buttons; a built-in guide shows every control.\n\u2022 Details at a glance: resolution, HDR, codecs, every track.\n\nYou bring the links: VR Link Player doesn't provide or find video.", "short_description": "Paste a link or pick a file, press play: your videos on a giant screen or all around you in 180\u00b0/360\u00b0, with subtitles in your language."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373991552470372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623558_2939113183116766_3816396785751376153_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9qMeO0WNLsQ7kNvwFSy6bK&_nc_oc=AdoXN03s5rNHAwnICxHLH_NrV4B-Z1ZP9rxi2tWkWUbIgaowEm0MNvOpHR-z110wK_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00
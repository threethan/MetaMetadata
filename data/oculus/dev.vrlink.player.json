1ipx1WcK5pOVkqUmNs6T2b78xO7tj768Nl13Y8Ikdut7ijZFu_FtZfMyyUOa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqJS8KUeO0uaOWPstLMZIczr53XkF6yULuUrvRr8-7FQ&oe=6ADE2839"}, {"file_name": "2-subtitle-menu.png", "id": "1419585666973870", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623131_1419585670307203_4902503351763634687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB42f803pmUQ7kNvwFBIA31&_nc_oc=AdpBgV9Tsn2wWNE7IbzC_LIPPUIfnGXT0aRVEFuDuEqV_EaTNMBfpI0I6GXv_8NSKc4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd8UfeDLE32J-qDzKRIPxznRJ47w0RcddjV-Z4BQRAIA&oe=6ADDF3C4"}, {"file_name": "3-360-video.png", "id": "1405748231146464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620316_1405748234479797_4688823819564853402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vOCNeXKjbkQ7kNvwHVYR0w&_nc_oc=AdrZ5ODS9_685Qa8AZ15T1BGjQHtl_aAhBl8auYaBJ3S6UIVU37AXQZbwbdDPA_V0qQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDciRswP6lB82A_8jgnFaRJT-UvQfLIApJE8tG1k8L5w&oe=6ADE1FBC"}, {"file_name": "4-subtitle-settings.png", "id": "1124137760155163", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628092_1124137763488496_7806207681770845589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h61QHAkbKe8Q7kNvwFWLY7A&_nc_oc=AdruxqqUmYnD8JuE3XY8NH6BjtrcMOya2X1HRSytwRgusidhVnbdaG1B6qDnt8dYAFs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRiKYakTreiYvG1htW0vLNzP67ifepK7ARm5MsFPQ3Cw&oe=6ADDFE85"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l54aVRioJoQ7kNvwFik8Un&_nc_oc=AdpyPMidVXI1V5VocoY2I3_eZ1TK9kvG_tIOIfiuqTUiWtCcKKMnJXGJqZie7lezJEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfo69K0qsg7hKcK_I3hudSCAWIwT_UY4OsIPC8Dsy4qA&oe=6ADDFEFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1369467449589449", "version": "0.6.24"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369467449589449"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Very long and very large videos\n\u2022 MP4 videos with a very large index, such as 18-hour compilations, no longer fail with an out-of-memory error: the player keeps their frame index in a fraction of the memory it took, and reads and seeks them exactly as before.\n\u2022 The disk cache has no fixed size limit any more: it uses the free storage (keeping 2 GB free), checked while it downloads, so files of any size, even 1 TB, play, keeping the part around where you watch.\n\u2022 The player keeps less video in memory ahead of playback, and has more memory to work with.\n\u2022 If a file still needs more memory than there is, the message says so in plain words.", "created_date": 1792341963, "id": "1369467449589449", "version": "0.6.24", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369467449589449"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Easier to read\n\u2022 Secondary text is brighter everywhere: the details under History entries, the subtitle search messages such as No movies or shows found by that name, hints in Subtitle settings and Feedback, and the version number. Some of it was dark grey on the dark panels.\n\u2022 In the video info and controls panels, the labels on the left are now as bright as their values.", "created_date": 1792310398, "id": "1368772289658965", "version": "0.6.23", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369467449589449"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Faster and clearer playback\n\u2022 Hold A for half a second to play at 2\u00d7 speed until you let go, with a tap on the controller. A click still plays or pauses.\n\u2022 The time pill shows how far into the video you are, e.g. 12:34 / 1:23:45 \u00b7 30%, and it's only as wide as it needs to be.\n\u2022 Dragging the seek bar shows the time and percentage it will jump to, above the thumb.\n\nFile details\n\u2022 As a video opens, the status line shows its size, resolution and frame rate for 10 seconds, together with Resumed at when it picks up where you left it.\n\u2022 MKV videos now show their frame rate, measured as the video loads, in the status line and the video info panel.\n\nDimming and messages\n\u2022 The room dimming button is now on the link panel too.\n\u2022 A link that holds only some parts of a multi-part archive now says so at once, with how much of the video it holds, instead of a server error after many tries.", "created_date": 1792307500, "id": "1368718562997671", "version": "0.6.22", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369467449589449"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Play and pause\n\u2022 Playback now resumes on the very frame it was paused on. Before, the picture skipped about a quarter of a second ahead when playing on, as the headset's audio had already moved on.\n\u2022 A paused picture stays on the frame showing.\n\u2022 Pausing while the video is buffering now pauses, with the A button and the play button.\n\u2022 Pausing for the Meta menu or when the headset comes off resumes in the same place too.", "created_date": 1792285699, "id": "1368324513037076", "version": "0.6.21", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369467449589449"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "OpenSubtitles\n\u2022 Searching by title for a language that wasn't found now lists that language's subtitles only. Before, it listed every language, so a film with no Vietnamese subtitles showed only English ones.\n\u2022 Machine-translated subtitles are found too, after those people made, and are marked Machine-translated in the subtitle menu and the search. At times they're a language's only subtitles.\n\nAI subtitles\n\u2022 AI subtitles from the audio no longer run seconds early after a film opens on music or quiet.", "created_date": 1792258245, "id": "1367829416419919", "version": "0.6.20", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
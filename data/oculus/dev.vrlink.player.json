&_nc_oc=Adr4FIVHPnXVQ3v4hDlAMhY9dJbaTohUqI1iOVJi1uTgu4GRRiP92X9h8k1iaGhLlZI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1m9O5TjKedU6mM640PwOJjWE6TdX_9iW-pfk2Neuuvg&oe=6AE335F9"}, {"file_name": "2-subtitle-menu.png", "id": "1419585666973870", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623131_1419585670307203_4902503351763634687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-mBRBlVOOAQ7kNvwEPNNah&_nc_oc=Adrn9dEOsf_1bdWRWd16WbqKJmoCzryn7q3ux3QAV95IE-3HWcQaR9eA9YAqRiUy344&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6tiPINcffF5iDIIFaCMC3uyMHL0oiMfUcPqOuIpcksw&oe=6AE339C4"}, {"file_name": "3-360-video.png", "id": "1405748231146464", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620316_1405748234479797_4688823819564853402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69vkbhVmTUEQ7kNvwH-3XJu&_nc_oc=AdqL7al9JHMSxweH69_yAiFyyz5Ch6LcUHr1OMOziwx7N3yJx4ohuyLqkgfCDBk68sg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmV9Ycwjd0jlX7rr_-E5UlwAmCpx5sE5xdGRxUBD42zg&oe=6AE365BC"}, {"file_name": "4-subtitle-settings.png", "id": "1124137760155163", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628092_1124137763488496_7806207681770845589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGemgZC31V4Q7kNvwHD1zya&_nc_oc=AdrATzOIg-4nDP92CrpzFPt1xu1hov6StvECJkDII-BNCr07DgVe05nfyFsehSIq-dA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKnWhZ0LI9yQG32rIbc0vshcC51DgJAy9OEH9ZQGm4tQ&oe=6AE34485"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUJPl_kTfd8Q7kNvwGuJSNE&_nc_oc=AdqiuM1BTKpjSOdWZRtBQqXvzlzwlluHhkrS4N6P9OgLTYCP_4gvxBMEp6iOnDudDQk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFZplO69MMBa_JwPTRgVFm9YBSzX5DtJMbd-y_uBtiIg&oe=6AE344FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1381011555101705", "version": "0.7.11"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381011555101705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "3D turned on while paused\n\u2022 Turning 3D on while a video is paused now shows the paused picture in 3D a moment later. Before, it stayed flat until you pressed play.", "created_date": 1792892090, "id": "1381011555101705", "version": "0.7.11", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381011555101705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Better 3D for videos with black bars\n\u2022 Many films and dramas have black bars above and below the picture, and older 4:3 shows at its sides, in the video itself. In 3D, the picture's edges by the bars no longer bend out toward you, and the picture gets all the depth, the bars no longer taking part of it.\n\u2022 Photos in 3D that aren't widescreen, square or portrait ones, get their depth right up to their edges too.", "created_date": 1792889056, "id": "1380958025107058", "version": "0.7.10", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381011555101705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Photos at full size, in their true colors\n\u2022 Every photo and video is drawn at exactly its own size: photos up to 8192 pixels on their long side (2560 before), so a 48 MP photo shows all its detail; video up to 8192 wide, 4096 an eye in 3D. A smaller video after a larger one no longer gets the larger screen.\n\u2022 Accurate colors now works for photos too: on, a photo shows the colors its file has, a wide-color (P3) one's too; off, the headset's more saturated look.\n\u2022 HDR photos, AVIF or HEIF in HLG or PQ, are shown like HDR video: with accurate colors on, brought to the headset's brightness, highlights kept; off, as the headset shows HDR.\n\u2022 With accurate colors on, HDR colors deeper than the headset can show keep their shade: a deep red stays red rather than turning pink.", "created_date": 1792882681, "id": "1380847961784731", "version": "0.7.9", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381011555101705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "8K plays smoothly again, accurate colors everywhere\n\u2022 8K 180\u00b0 videos at 60 fps (8192 \u00d7 4096) play smoothly again, on the headset's own decoder: since 0.7.2 they played at a few frames a second.\n\u2022 PC colors is now called Accurate colors, and works on 180\u00b0 and 360\u00b0 videos too, up to 8192 wide. Its menu line says it affects performance: 8K SDR keeps 60 fps, 8K HDR plays at 35 to 45.\n\u2022 The screen, the panels and the controls sit 5\u00b0 lower, a little below the eyes, where display guidelines put them. 180\u00b0 and 360\u00b0 videos stay where they were.\n\u2022 2D made 3D keeps all of a cinema 4K video's detail, 4096 wide.\n\u2022 Flat 8K and cinema 4K videos (7680 \u00d7 4050, 4096 \u00d7 2160) no longer open as 180\u00b0 3D.\n\u2022 A link that has expired now stops with the server's answer within a few seconds, rather than buffering for good.", "created_date": 1792873542, "id": "1380676835135177", "version": "0.7.8", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381011555101705"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Errors you can see\n\u2022 A folder opened again from History goes straight to the player, saying it's opening. If it can't be opened, as when its share or server is down, the player says why in red, with Try again, as it does for a video. Before, it went back to the link panel and showed nothing.\n\u2022 A link the player can't play now says so in red in the link box's own label, until you change it.\n\u2022 Holding B stops while a folder is still opening.\n\u2022 A view mode picked while a picture shows is no longer kept for the playlist's videos.", "created_date": 1792847808, "id": "1380075445195316", "version": "0.7.7", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
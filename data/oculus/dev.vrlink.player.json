&_nc_oc=AdqE9uaqEDNJN2h7X7g2UG9tWd_fPRPVl997Bo_nWo5SA5Kvq377FuV0cbC79ca_Sco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXQZ8WF887ddMSk2bRP4WJLfRg4EWFC4GRiSRbioe5DA&oe=6ADF79B9"}, {"file_name": "2-subtitle-menu.png", "id": "1419585666973870", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623131_1419585670307203_4902503351763634687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB42f803pmUQ7kNvwHfID34&_nc_oc=AdqeBamHmqbqj3FNTySYEKYOV4oihZSfqoaXPCJr_oz_S8Yo6Wf08TASX3chOUIlOaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM4fN_PT0JVcJ3CJTZDSxvl9gz2QLjIT4D2ppvwVMoZQ&oe=6ADF4544"}, {"file_name": "3-360-video.png", "id": "1405748231146464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_1405748234479797_4688823819564853402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vOCNeXKjbkQ7kNvwEKPEyq&_nc_oc=Adp131YqT9sac8gbvj9QKT_KiN6x4c3O5hY18NUKFOp_Aasdl4feBD3IMZibDDacGyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgoWSEOIwUU6Ssly5Zvjg_DJE9hcZV5EIhFXaF1cAWDA&oe=6ADF713C"}, {"file_name": "4-subtitle-settings.png", "id": "1124137760155163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628092_1124137763488496_7806207681770845589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbiPO53SwXYQ7kNvwGQ7Yb4&_nc_oc=Adq1s0BoRSiAUB6gyrbKXJZKIN7nGTncGevolQcMc1wOQFWJV7_8hWYnCcwM6u5kC5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgMxBtuZljTOqPhnTBYZaVJ4_zcbmazpuPrzX0nI048g&oe=6ADF5005"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l54aVRioJoQ7kNvwHduoDw&_nc_oc=Adoavne6l29nBdZ8Wls0s68tEssSoN0820_s52LvbCh7rSGkT7osfqg-whnvnR6vBKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd1aoHJWU5aUsdAo7ER_3aLDF__mfdI1KqPW8yAHPk8g&oe=6ADF507E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1374634285739432", "version": "0.7.1"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1374634285739432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "2D videos and pictures in 3D\n\u2022 2D made 3D: turn on the cube button on the Flat 2D line of the mode menu, and the headset estimates each frame's depth and gives each eye its own view, on the flat or curved screen. Pictures too, with the same button on their controls. The first time, it downloads its depth model (26 MB), a ring around the button filling as it does; Storage shows it and can delete it.\n\u2022 The curved screen is now a button beside it, on the same line.\n\u2022 Logins remembered before 0.7.0 are found again, not asked for once more.", "created_date": 1792592671, "id": "1374634285739432", "version": "0.7.1", "version_code": 32, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1374634285739432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Files, more links, 3D films, faster starts, and Storage\n\u2022 Files, on the link panel: play the headset's own videos and pictures, a web server's folders, or a Windows or NAS share (smb://), with a login when a server needs one, remembered if you like. Save folders with the star to open them again from Saved.\n\u2022 A folder plays as a playlist, and subtitle files beside a video, with its name, load as its subtitle tracks.\n\u2022 More links play: HLS (.m3u8), DASH (.mpd) and Smooth Streaming streams, live ones too, RTSP cameras, and http:// links. Other apps can open a video or picture with the player.\n\u2022 3D films play in 3D on the flat screen, side by side or top / bottom, half or full: picked by itself from the file name or the picture's shape, or in the mode menu.\n\u2022 The [2/30] before a playlist's file name opens the list of its files: pick one to jump to it.\n\u2022 Videos start much faster when reopened: an 18-hour video that took about 8 seconds to start now starts in about 1 second.\n\u2022 Every MP4 is read with the player's own compact frame index, built on several cores at once in under half the time it took, and in far less memory for ordinary videos.\n\u2022 The two videos you opened last keep what was downloaded, and the five you opened last keep their index, so reopening one starts without downloading it again. When storage runs low, the older video's download goes first.\n\u2022 From servers that support it, a large index downloads compressed, almost 4 times smaller.\n\u2022 AI subtitles reuse the index the player has read, instead of reading it a second time.\n\u2022 Storage, on the link panel, shows in three tabs what the app keeps and how much space each takes, and its settings: clear or reset each on its own, a whole tab, or everything.\n\u2022 \u24d8 beside the link shows what plays: the links, the file types, and this headset's decoders.\n\u2022 Holding A plays at twice the current speed, up to 4\u00d7: 1.5\u00d7 becomes 3\u00d7, 2\u00d7 becomes 4\u00d7.\n\u2022 The controls guide says exactly what each button does held, and for how long.\n\u2022 Changing the screen's mode while paused, or after a video ends, keeps its picture.\n\u2022 The time shown while seeking or holding A no longer gets cut off for long videos.\n\u2022 Logos drawn in a subtitle track no longer show as lines of numbers, and translating a track with no lines (subtitles burned into the picture) says so.", "created_date": 1792562305, "id": "1373991365803724", "version": "0.7.0", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1374634285739432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Very long and very large videos\n\u2022 MP4 videos with a very large index, such as 18-hour compilations, no longer fail with an out-of-memory error: the player keeps their frame index in a fraction of the memory it took, and reads and seeks them exactly as before.\n\u2022 The disk cache has no fixed size limit any more: it uses the free storage (keeping 2 GB free), checked while it downloads, so files of any size, even 1 TB, play, keeping the part around where you watch.\n\u2022 The player keeps less video in memory ahead of playback, and has more memory to work with.\n\u2022 If a file still needs more memory than there is, the message says so in plain words.", "created_date": 1792341963, "id": "1369467449589449", "version": "0.6.24", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1374634285739432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Easier to read\n\u2022 Secondary text is brighter everywhere: the details under History entries, the subtitle search messages such as No movies or shows found by that name, hints in Subtitle settings and Feedback, and the version number. Some of it was dark grey on the dark panels.\n\u2022 In the video info and controls panels, the labels on the left are now as bright as their values.", "created_date": 1792310398, "id": "1368772289658965", "version": "0.6.23", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1374634285739432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Faster and clearer playback\n\u2022 Hold A for half a second to play at 2\u00d7 speed until you let go, with a tap on the controller. A click still plays or pauses.\n\u2022 The time pill shows how far into the video you are, e.g. 12:34 / 1:23:45 \u00b7 30%, and it's only as wide as it needs to be.\n\u2022 Dragging the seek bar shows the time and percentage it will jump to, above the thumb.\n\nFile details\n\u2022 As a video opens, the status line shows its size, resolution and frame rate for 10 seconds, together with Resumed at when it picks up where you left it.\n\u2022 MKV videos now show their frame rate, measured as the video loads, in the status line and the video info panel.\n\nDimming and messages\n\u2022 The room dimming button is now on the link panel too.\n\u2022 A link that holds only some parts of a multi-part archive now says so at once, with how much of the video it holds, instead of a server error after many tries.", "created_date": 1792307500, "id": "1368718562997671", "version": "0.6.22", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
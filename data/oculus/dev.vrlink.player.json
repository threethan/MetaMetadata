&_nc_oc=AdrAFsMeO9SFcj2PlmP65fncciuquhbBOXciS7Bjs7SsgzEHYOGPb-txkmZhdyipHFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCu18pQWamOPqL62XXMBvvut6LQxPCdzbPPkg5Mw-7PQ&oe=6AE762B9"}, {"file_name": "2-subtitle-menu.png", "id": "1419585666973870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623131_1419585670307203_4902503351763634687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsbsmjjwg50Q7kNvwHZpo5z&_nc_oc=AdpZJWiVUDl5ciQF96ZJ2MoLWCx4vFuUAI5tCVTqzt9rC2Ea1SkZo86vz9RPYbUoAp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO8ajFCoBq8Z19BfqzFkDjan5ku8Yq1PUfwKFm96vafw&oe=6AE76684"}, {"file_name": "3-360-video.png", "id": "1405748231146464", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620316_1405748234479797_4688823819564853402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FNBTb0fbisQ7kNvwE6VVJd&_nc_oc=Ado27vJxKfZmIUztona4KMl8ryKbTOXFgNGOAPgGmCT7tK_fIRz2XmKufSZYwx3YJDA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReAbU5HaoFcVE_GzbOYA2BpC3-jS548VEw20AmFci6uA&oe=6AE75A3C"}, {"file_name": "4-subtitle-settings.png", "id": "1124137760155163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628092_1124137763488496_7806207681770845589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQL6saV4ijoQ7kNvwEVriIR&_nc_oc=AdowVumX44Hu2VtmFU8IIeXbP-PHbSc1oVFvCFu3zfLZade8BE5ELRpcqHvgcGjTtk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaKPqPjkaO1NKTZFJDt0C1cPvv75eUmiyeiWZOlZ7aDw&oe=6AE77145"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59d9saA2VscQ7kNvwG4N9tL&_nc_oc=AdqBAO2iWZYbBOxYrCSa2ukcA-I_6wyDguW7Ivdnxl3-YnxGvG9VhnZV7ufwYBrOmPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxMX_es_X96xQzF7dMalOkrONmtDPlyqeo7V6IlC95-Q&oe=6AE771BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1385122458023948", "version": "0.7.20"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1385122458023948"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Steadier 3D for videos with black bars\n\u2022 In dark scenes, the dark edges of a widescreen picture are no longer taken for black bars at its sides: the part of the picture made 3D no longer changes from frame to frame there, which made the depth unsteady.\n\u2022 Black bars are told apart from a dark picture more exactly, and found on one side pair only, top and bottom or left and right, as videos have them.", "created_date": 1793089305, "id": "1385122458023948", "version": "0.7.20", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1385122458023948"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Better problem reports\n\u2022 The app's log, sent with feedback when you include diagnostics, now says where in the video things happened: each change of the black bars found for 3D, the 3D stats taken every 5 seconds, and a playback that fails. A problem you report can be found at its exact moment in the video.", "created_date": 1793071120, "id": "1384740091395518", "version": "0.7.19", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1385122458023948"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "3D for videos with black bars\n\u2022 A video whose opening fills the whole screen, as many dramas' do, no longer keeps its black bars in the 3D picture for the rest of the episode: the bars are found again as soon as the opening ends, and the picture's edges by them stay straight.\n\u2022 Dark scenes keep the bars found before them.", "created_date": 1793068807, "id": "1384691708067023", "version": "0.7.18", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1385122458023948"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Subtitle settings\n\u2022 A new Check again button, beside Paste, checks your OpenSubtitles account and Groq API key again at once: a check that failed, as when the connection dropped, no longer stays failed until the key is changed or the app restarts.", "created_date": 1793061098, "id": "1384533408082853", "version": "0.7.17", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1385122458023948"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Pictures in 3D\n\u2022 Moving between pictures in 3D no longer flashes red.\n\u2022 A picture's 3D depth now comes in a moment, 6 to 16 ms after it shows, not 70 to 170 ms: the 3D model stays loaded while 3D is on.\n\u2022 While the next picture loads, the one shown stays, with a spinner over it, until the next takes its place. One that fails to load shows its error.\nVideo in 3D\n\u2022 A video made 3D is 3D from its first frames, no longer flat for its first 1.5 seconds or so as it opens, changes size or has accurate colors turned on.", "created_date": 1793058827, "id": "1384491138087080", "version": "0.7.16", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
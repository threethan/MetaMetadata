, "id": "1107469931671382", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593942860_1107469935004715_6168229408760507926_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yz1UHk2jVUkQ7kNvwGI5Xmb&_nc_oc=AdrlK7dEVoNtcjvEkZkcQWxa_yMuPvPqop6iGjTqWEEdxtql68JoCYc69l-wWQhL3nY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWZm2P1ID5c-yjD5vEMBtITj7z7BQmfrdC5anc5x5bRg&oe=6ADE198A"}]}, "id": "1102705932500551", "locale": "en_US", "screenshots": [{"file_name": "1-link-panel.png", "id": "1682585616932449", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623512_1682585620265782_8603102649527761425_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVu_ICD0LQQQ7kNvwG4eO1Z&_nc_oc=AdryQ8gLPV_w1l9Eh1I9V8VoA9OSJSiLG_-_ljsP3KwqggPBbzps7fjtqWOHXtxHPP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjjVfLT1xdAztIvQfVImStCLa-_SG1TkqnGhYbvQ_dhA&oe=6ADE10CC"}, {"file_name": "2-360-video.png", "id": "1846396620048557", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623565_1846396626715223_2597470299475782426_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OySEWkVTFg4Q7kNvwEJifZm&_nc_oc=AdpaZ8WCnQV3AXz1H4Sp7Ly7npJtYVzDpZGDstUa9Swqh3pV8rJBrkXBFQHgO4cBbpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxBFxsVKqjUUMQMf7kTJBT-XgPIvvOQvOmDL4kzmuqyA&oe=6ADDF72F"}, {"file_name": "3-subtitle-settings.png", "id": "995055696977190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620532_995055700310523_7574150090874281187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFQBomj-QX8Q7kNvwF4EVus&_nc_oc=AdoEjlDhcMYmEMSOA2N5Gz68JpczQrGFgl9ohJJ4Fn7kFeeXF7BAvNwa54Jpoxar72k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQPNUNy945E88m_OZfEgOPs0qr6BY-2suKVkevkaLDaw&oe=6ADE1EF1"}, {"file_name": "4-subtitle-menu.png", "id": "1141930878781673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620403_1141930882115006_1196894236706866279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_m5aBL7CLwYQ7kNvwFVdglD&_nc_oc=Adr74E6YAQigdKTPHi7r0AMzVJ2DjcshHJhoRPvV7L5dT1AHAsJoakAO7TVlw9j94DY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM8aLANgALkowfCOX5NgqFxlX_Mry4QCOxLbbz5Aezfg&oe=6ADE149E"}, {"file_name": "5-ai-menu.png", "id": "2176467256615398", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593875952_2176467259948731_5810026720942415230_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfjV8kzlPU0Q7kNvwGLbZpe&_nc_oc=AdqeDsoDOWhZh4cE90Kvkqgoo3M14hO6fX9DzP42xfQkQfaBB9KvPc5KEv1lIuumJHM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgOBfAEreug3KoT6ogxW1OnPH82fMKtlakt25fbUOfrQ&oe=6ADDFBC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["video", "media", "360", "VR180", "subtitles"], "long_description": "VR Link Player turns any direct video link into your private cinema.\n\nPLAY WHAT YOU LINK\n\u2022 Movies, shows, 180\u00b0 and 360\u00b0 video, mono or 3D, pictures and playlists.\n\u2022 A cinema-sized screen you can stretch with a grab, or curve around you.\n\u2022 The right mode is picked for you; switch it anytime.\n\u2022 Opens from web pages and apps: vrlink://play?url=<encoded link> (or its intent:// form) starts playing at once.\n\nSMOOTH ON HUGE FILES\n\u2022 Downloads ahead as you watch: seeking back is instant, and a dropped connection doesn't stop what's downloaded.\n\u2022 See the frames as you drag the seek bar; jump \u00b110s with the thumbstick.\n\u2022 Picks up where you left off, with your audio and subtitles. Your last links wait in History.\n\nSUBTITLES IN YOUR LANGUAGE\n\u2022 The video's own tracks, or OpenSubtitles with your free account.\n\u2022 AI translates the video's subtitles into 80 languages as you watch, or makes them from the audio, with your free Groq key.\n\u2022 Put the subtitles where they're comfortable, even over 3D; nudge their timing.\n\nMADE FOR COMFORT\n\u2022 Dim the room around you, down to pitch black.\n\u2022 Speed from 0.25\u00d7 to 2\u00d7, snap turn, recenter for watching lying down.\n\u2022 Keeps playing in the dark, with headset tracking off.\n\u2022 Play, pause and stop from the controller buttons; a built-in guide shows every control.\n\u2022 Details at a glance: resolution, HDR, codecs, every track; for photos, the camera and exposure.\n\nYou bring the links: VR Link Player doesn't provide or find video.", "short_description": "Paste a link, press play: your videos on a giant screen or all around you in 180\u00b0/360\u00b0, with subtitles in your language."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1360909090445285"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623558_2939113183116766_3816396785751376153_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9qMeO0WNLsQ7kNvwHnieyx&_nc_oc=Ado1vkaI1LA6IGLVp6jlrhpicpOoJlTAGejCoIJOknviXhVDTwac0yOGAHG2FTUarIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAizAZ-UaVN
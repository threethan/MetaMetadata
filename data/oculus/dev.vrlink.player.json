_YkQ7kNvwHKLi18&_nc_oc=Adr9pABQ4enLu_HzzBABQLhO2HZoSiyyWuD-Q6G7AwmSjuYA2iY_UJYw2oAykiyj7dI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8jpDkDznKWVljklu6Rsp6FylwVTxYn3J2gH1wrZxXAg&oe=6AF1EEB9"}, {"file_name": "2-subtitle-menu.png", "id": "1419585666973870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_1419585670307203_4902503351763634687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fjKIIIY6SkQ7kNvwFIrI_O&_nc_oc=Adqn39Uox-Uf8YZQWY8z6O-kOIW8HYwH_A1DWnQivvU0JIYtsoXgJQErdT63PpCs00w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_uQaaHdHM5FnOBAgs4YqlydcWpC0bv991X1LS-5eHLw&oe=6AF1F284"}, {"file_name": "3-360-video.png", "id": "1405748231146464", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620316_1405748234479797_4688823819564853402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC9E2h-f0kAQ7kNvwHTcMhK&_nc_oc=AdoV0tHVwA6R8ag--Y5AzhF_AJpIvFVUWD13V2J2wO0Csw1mkX1mQFMeps-Y4htAcBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1Itb4Plz4SXTxsPlScrNWurAa223ECPdGncg3Px-P0A&oe=6AF1E63C"}, {"file_name": "4-subtitle-settings.png", "id": "1124137760155163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628092_1124137763488496_7806207681770845589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mM0VtlQiVMQ7kNvwFAEVH8&_nc_oc=AdrXsblJeT4bd9MmB6A3x9pCar2BFTRw4xO9D2_rpcnxFy7Hya3-H3lLdRtg4AZ5mdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7YVkee3YHaCNLdV5lKQ9SlwSDqwfVY9fZWl87YPR6Ug&oe=6AF1FD45"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm5nUgxiH2kQ7kNvwEIH1ot&_nc_oc=AdpOyX7wIln-vXe8oKRvtlZAeNDAwTbnJs8EwUR--McZ7mflo_F553bzMeXnMiSpLJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIM_faW9nGsDIAIpDTjU0AQuNbe-kHqaLyAV0BGvny-w&oe=6AF1FDBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1406078119261715", "version": "0.8.0"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1406078119261715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Smoother playback, sharper 3D, and control over what's kept\n\u2022 Settings: choose how much the app keeps on the headset \u2014 History, playback positions, subtitles, cached videos and pictures (by number or by size: 100 GB and 10 GB by default) and video indexes. A changed setting is marked with \u21ba and applies when Settings closes.\n\u2022 Keep: the download icon next to a file's name keeps what's downloaded of it, whatever the limits; kept files are listed in History's new Kept tab. Remove a single link from History with \u00d7.\n\u2022 Share: send a link, or a getlk.net page that opens it in the player.\n\u2022 The controls show the date, time and battery. A name cut short shows in full when you point at it. Files reopens where you left it, with the folder you came from highlighted.\n\u2022 The headset's refresh rate now matches the video's frame rate: 24 fps at 72 Hz, 25 and 50 fps at 100 Hz, 30 fps at 90 Hz, 48 fps at 96 Hz and 60 fps at 120 Hz, so every frame is shown for the same time.\n\u2022 Each frame is shown at the refresh it's meant for: uneven frames in 8K60 down from 18% to 1%, and none in 4K60 or 1080p30.\n\u2022 Picture and sound line up within about half a refresh from the first frame.\n\u2022 2\u00d7 speed plays 60 fps video up to 4K at its full frame rate (it was held to about 74 frames a second).\n\u2022 Turning 3D or accurate colors on or off, curving the screen and resizing it no longer flash black or make the video jump; turning 3D off no longer leaves the screen black for seconds.\n\u2022 3D starts faster: its depth model loads in 0.3 s instead of about 2.5 s.\n\u2022 Sharper, steadier 3D: each eye of an 8K video is drawn at exactly half its size, the picture's left and right edges stay black instead of stretched, and HDR10 video is tone-mapped before its depth is found.\n\u2022 The smallest screen size is now 55% of the usual, where even 8K video shows no flashing dark specks.\n\u2022 Less GPU and memory: the app's own eye buffer is 512 \u00d7 512 (0.2 ms of the GPU a frame at 8K60 in 3D instead of 1.2, and 64 MB less), and 3D lets go of 66 MB when it's turned off.\n\u2022 Fixed: the picture could freeze for good after brief stalls at the start of an 8K video; 8K AV1 video dropped frames.\n\u2022 Downloads: a seek stops the old download at once (seeks start about 0.1 s sooner), the cache writes to storage in larger pieces, and reaching the storage limit no longer removes an extra older video.\n\u2022 Dolby audio starts at once when you come back to the app (it took 1 to 2 s).", "created_date": 1793712175, "id": "1406078119261715", "version": "0.8.0", "version_code": 58, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1406078119261715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Back in the app after allowing files access\n\u2022 Allowing all files access for the Files panel's Local tab now brings you straight back to the player, with the headset's videos and pictures listed, instead of leaving you in Home.", "created_date": 1793418552, "id": "1395864473616413", "version": "0.7.26", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1406078119261715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793416676, "id": "1395778786958315", "version": "0.7.25", "version_code": 56, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1406078119261715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Smooth screen resizing, steadier pictures, next videos start sooner\n\u2022 Resizing the video screen, or turning 3D or accurate colors on or off, no longer flashes it dark: the screen before stays until the new one shows its first frame.\n\u2022 The next video of a playlist or archive gets ready while the current one plays, so it starts sooner.\n\u2022 The last 100 pictures stay on the headset's storage: going back to one shows it in about half a second, without downloading it again.\n\u2022 Stepping quickly through pictures loads only the one you stop on, so it shows sooner.\n\u2022 Far less memory used while viewing large pictures, which could close the app after a long session.", "created_date": 1793402201, "id": "1395218070347720", "version": "0.7.24", "version_code": 55, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1406078119261715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Faster, sharper pictures, and whole fragmented videos\n\u2022 The next picture of a playlist or archive is loaded while you look at the current one, so it shows in about a tenth of a second instead of 2 to 3 seconds from a server.\n\u2022 Pictures you just saw stay in memory: going back shows them in about half a second, without downloading them again.\n\u2022 Switching pictures no longer freezes the view for a moment.\n\u2022 Very large pictures, such as 8192 \u00d7 5464, now show in 2D; before, nothing appeared.\n\u2022 Pictures and large videos are drawn at the resolution their screen can show: fine detail no longer flashes as dark specks while you resize or switch to 3D, and an enlarged picture shows more detail.\n\u2022 Grip an edge or corner of a picture to resize it, as with the video screen; one size is kept for both.\n\u2022 An archive or playlist link opens its first file about 3 seconds sooner.\n\u2022 Fragmented MP4 videos without a full index show their whole length and seek quickly.\n\u2022 When an online subtitle search fails, its row says why, such as a title too short to search; tap it to search by title, or tap the retry icon when trying again may help.", "created_date": 1793369927, "id": "1394291833773677", "version": "0.7.23", "version_code": 54, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
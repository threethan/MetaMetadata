bLwaY6DuA2F14OUUVf5lltnDREhPZ8jfgKn_2rvnAmg9z8izSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrf8qgoEVI_8RfOUy9TOyoFJIehP8y0Yxwd3QY8odg0w&oe=6B06F80A"}]}, "id": "29282264051379378", "locale": "en_US", "screenshots": [{"file_name": "1-ai-subtitles.png", "id": "1121939467442983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619059_1121939474109649_6083394874881689144_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQsWhqCFgG8Q7kNvwFOFXco&_nc_oc=AdpnS_n5IBJzzKOA5iEaeAiP3dliav5qnMKzV4bwjnqJTekqP4j-40DCuGDTa-jDwT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjxuZ6dxZPLkeN4CMUyuj2ClQeAytiRMA8AwktWpfuDw&oe=6B0706B9"}, {"file_name": "2-subtitle-menu.png", "id": "1419585666973870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623131_1419585670307203_4902503351763634687_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8zq3JKH_jAQ7kNvwGJy_p_&_nc_oc=AdoZEX7AQx7Hs5vnP58K4g3Q8tuPOl-1G0C6FY2YGKqfEaBX5pqwayTCdesRRPH2nYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9n4nvOjYjmJP2QWdKkBAQ_v-t-qbWKpAb6-5l2-RRxQ&oe=6B070A84"}, {"file_name": "3-360-video.png", "id": "1405748231146464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_1405748234479797_4688823819564853402_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19L0tyYz_lsQ7kNvwGlzTRk&_nc_oc=AdqwWfSa6ZLNltR7oCUm6hWBtKND_5X4yaHLHx0kLKHwtvxBJSKX6YLeDcaegR5-TwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA17rYHc22zzs1dHmaL2mg1oqgT9T3Zx7nmZsNv0P0xw&oe=6B06FE3C"}, {"file_name": "4-subtitle-settings.png", "id": "1124137760155163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628092_1124137763488496_7806207681770845589_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k_Zu0MV0D4Q7kNvwEo2l8r&_nc_oc=AdoqHun6A2g3GbF1bxRduRuPatDAvHOvrJv48Xw98EJwh6llyr6d3aaCird1P9fod_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTiMCPyXqlR1a-9SyGGZJy06YrpV3Qjf1z7M94LAnFPg&oe=6B071545"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykgQ1P9fBZsQ7kNvwEAm8ol&_nc_oc=Adp5nNqPG8r0uM3OSW1v0oyoj86X8w6wgfGtNYX_y8pspIgt8gR25MeylpcVgXyljNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVPm9vgeYkgOcn80EY_oVabxDFZG6uopi7-CMEJWoiVA&oe=6B0715BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1436375282898665", "version": "0.8.7"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436375282898665"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "More comfortable 3D\n\u2022 A person or thing in front now keeps the same shape in both eyes: what's near is grown a little further in the depth, so its outline no longer stretches one way in one eye and another in the other, the main thing that made 3D unpleasant to look at. The trade is a slightly wider halo in the background beside it.\n\u2022 Less smearing at the edges of near things.\n\u2022 For films and 60 fps video alike.", "created_date": 1795001881, "id": "1436375282898665", "version": "0.8.7", "version_code": 65, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436375282898665"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Clearer 3D, subtitles in any language\n\u2022 Videos at 30 fps and below (films, most shows) and pictures are now made 3D by a depth model with four times the points: thin and small things keep their outline, and far less of the background moves with a person in front of it. 60 fps video keeps the faster model. The new model, 26 MB, downloads by itself the first time 3D is on; 3D works meanwhile.\n\u2022 Less of a halo around people in 3D: the depth's edges are put on the picture's own as it's drawn.\n\u2022 Steadier 3D where the picture moves, as when the camera pans: the depth now follows the picture's motion, 10 to 15% less wobble there.\n\u2022 Search subtitles by title lists every language, not only yours and English: yours first, then the best few of each other one. One picked in another language is kept for the video.\n\u2022 Holding a grip still puts the screen, or the subtitles, back; the rest of that hold no longer moves it again.\n\u2022 Fixed: a video whose file doesn't say its frame rate (most MKV and WebM) could play its first seconds, up to 15, at the wrong display rate.\n\u2022 8K60 and 4K60 with 3D, accurate colors and AI subtitles play as evenly as before.", "created_date": 1794992821, "id": "1436195166250010", "version": "0.8.6", "version_code": 64, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436375282898665"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Sharper 3D edges\n\u2022 3D's depth now follows the picture's own edges: a person, a skirt or anything in front of a background stands out cleanly instead of sloping back into it. Hair and fine detail are left soft, so they don't break up.\n\u2022 8K60 and 4K60 with 3D, accurate colors and AI subtitles play as evenly as before.\n\u2022 3D pictures get the sharper edges too.", "created_date": 1794742097, "id": "1431078746761652", "version": "0.8.5", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436375282898665"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Picture and sound in step\n\u2022 Every start (opening a video, seeking, playing after a pause) now begins with the picture and sound lined up to within a millisecond, and seeks show their first frame about 60 ms sooner.\n\u2022 The picture stays on the sound as it plays, at 24 and 30 fps too (it ran up to 18 ms ahead), and after changing the speed. At 1.5\u00d7 it's no longer 30 to 50 ms behind.\n\u2022 Pausing stops on the frame showing and plays on from the next one, its 3D unchanged.\n\u2022 Fuller, steadier 3D: each frame's depth at full strength, and scene changes found more reliably, so the first frames after a cut look right.\n\u2022 Smoother playback while the headset is busy, as when AI subtitles start: the headset now gives the app's drawing priority.\n\u2022 Fixes: a video opening as the Horizon menu took focus no longer plays behind it; a mode picked before a video's tracks are known is kept; B while choosing a file to attach to feedback goes back to it; and other rare cases.", "created_date": 1794212841, "id": "1418514821351378", "version": "0.8.4", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1436375282898665"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Steadier 3D depth\n\u2022 3D's depth is now found from every pixel of a video up to 4K, not a few of them, so it flickers about 13% less. Above 4K, as 8K, from a 16th of them, 10% less flicker for the cost of a 4K frame.\n\u2022 8K60 and 4K60 with 3D, accurate colors and AI subtitles play as evenly as before.\n\u2022 The app's log now notes each time the headset recenters, by you or by itself when put on, to help find problems.", "created_date": 1794087723, "id": "1415849024951291", "version": "0.8.3", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
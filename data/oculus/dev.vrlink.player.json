C0HybSNtRAHhV1Ogcg2Dtdvc3el4H8kOqNyng5GtBJP87Yl33A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOd-0nV_dx45nrhAqOkinfXCaJ-fkk7s4AGnL_1E94Uw&oe=6B01EA4A"}]}, "id": "29282264051379378", "locale": "en_US", "screenshots": [{"file_name": "1-ai-subtitles.png", "id": "1121939467442983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619059_1121939474109649_6083394874881689144_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr5shRnTIlMQ7kNvwFqixuC&_nc_oc=AdpBpdBKcx25R52me7zkH9DQinvpvILwoF23trnYZQmp7MrMcb7EgThqeyasCJSdjh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkV1G55AX22OKzNej24TV4RihOVaCIGO_AP0WYvXA4gw&oe=6B01C0B9"}, {"file_name": "2-subtitle-menu.png", "id": "1419585666973870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623131_1419585670307203_4902503351763634687_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJd4SePy-lUQ7kNvwH1gbSb&_nc_oc=Adruy9ftanIHFezMufQ0WEIEeUuDEWZkwe43lzbHcxG0I50BmeA_W2x2OFMDpui5KQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOO0QNeYWaZ3l_V0iJ0Bul2HjhCGLO42yKA3XdBASanQ&oe=6B01C484"}, {"file_name": "3-360-video.png", "id": "1405748231146464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_1405748234479797_4688823819564853402_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWAmm58QtAYQ7kNvwFZeZQx&_nc_oc=AdoSLO2vtnCyrqew-Yr0KCgjyO9yMg3uWEnLFvAnJPwzqbp7B7M8DLMpHHSFOQz64Pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-lkocGQ7iaYNS_H5AYTf6WqWxKsukFHTEB05aUbm5AQ&oe=6B01B83C"}, {"file_name": "4-subtitle-settings.png", "id": "1124137760155163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628092_1124137763488496_7806207681770845589_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8L07qw_cjQQ7kNvwEifOvt&_nc_oc=Adoz2U5CBogC8q_CtZDjrcgSeEqxAFjP9sYYjGuq7Zt4Yb3SxXpXjL3m6yxKmiXDeDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWjV1xNqSFZO5s58VgPAdSk91McIt6BqsCNH5Q6endAA&oe=6B01CF45"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX4py_NBxp0Q7kNvwGhsSgl&_nc_oc=AdqNlk-UKBEZoLzoQIsKQ3lDFwase4HX7qv7An3LiA2FP4tmLmmefX9Vg5BgXFhEc38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSod5pbHh2md2MMtW46sV-OSOOgp-Jt4Lupf9Uhfr1c8w&oe=6B01CFBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1431078746761652", "version": "0.8.5"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431078746761652"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Sharper 3D edges\n\u2022 3D's depth now follows the picture's own edges: a person, a skirt or anything in front of a background stands out cleanly instead of sloping back into it. Hair and fine detail are left soft, so they don't break up.\n\u2022 8K60 and 4K60 with 3D, accurate colors and AI subtitles play as evenly as before.\n\u2022 3D pictures get the sharper edges too.", "created_date": 1794742097, "id": "1431078746761652", "version": "0.8.5", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431078746761652"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Picture and sound in step\n\u2022 Every start (opening a video, seeking, playing after a pause) now begins with the picture and sound lined up to within a millisecond, and seeks show their first frame about 60 ms sooner.\n\u2022 The picture stays on the sound as it plays, at 24 and 30 fps too (it ran up to 18 ms ahead), and after changing the speed. At 1.5\u00d7 it's no longer 30 to 50 ms behind.\n\u2022 Pausing stops on the frame showing and plays on from the next one, its 3D unchanged.\n\u2022 Fuller, steadier 3D: each frame's depth at full strength, and scene changes found more reliably, so the first frames after a cut look right.\n\u2022 Smoother playback while the headset is busy, as when AI subtitles start: the headset now gives the app's drawing priority.\n\u2022 Fixes: a video opening as the Horizon menu took focus no longer plays behind it; a mode picked before a video's tracks are known is kept; B while choosing a file to attach to feedback goes back to it; and other rare cases.", "created_date": 1794212841, "id": "1418514821351378", "version": "0.8.4", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431078746761652"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Steadier 3D depth\n\u2022 3D's depth is now found from every pixel of a video up to 4K, not a few of them, so it flickers about 13% less. Above 4K, as 8K, from a 16th of them, 10% less flicker for the cost of a 4K frame.\n\u2022 8K60 and 4K60 with 3D, accurate colors and AI subtitles play as evenly as before.\n\u2022 The app's log now notes each time the headset recenters, by you or by itself when put on, to help find problems.", "created_date": 1794087723, "id": "1415849024951291", "version": "0.8.3", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431078746761652"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "A background image, shares found for you, and voice typing\n\u2022 New: a background image. Turn it on beside the room's brightness, and with the room black a 180\u00b0 scene shows around a flat or curved screen, a picture or the link panel. There are 10 scenes in a random order, changing every 3 minutes (1 to 60 in Settings' new Image tab), with \u21bb whenever you like, or only with \u21bb using the clock button. Each downloads the first time it's shown, and Storage clears them. Off by default, and not available for 180\u00b0 or 360\u00b0 video, which covers it.\n\u2022 It uses the GPU while it shows: 4K60 with 3D, accurate colors and AI subtitles stays even, with a few more uneven frames (about 0.4%). 8K with all of that on a large screen gets hot enough to slow down, with about 4 to 8% of frames uneven, against about 1.5% without it. Once it's hidden, its memory is freed.\n\u2022 Files' Network tab now lists the Windows and NAS shares on your network by itself, and a server's own link lists its shares, asking for a login if it needs one.\n\u2022 Voice typing: the keyboard's mic now shows for movie and show searches, user names and domains, as well as feedback. Links keep the keyboard with / and .com, and passwords and keys have no mic.\n\u2022 The keyboard's Submit key now plays a link, opens a folder link or searches for a title, as those buttons do.\n\u2022 Settings' Keep tab always shows its Back button, and the room's controls are the same on the link panel and in a video's settings.\n\u2022 Subtitle keys are checked once when their tab first shows, and again only after an edit or Check again.", "created_date": 1793939858, "id": "1412338155302378", "version": "0.8.2", "version_code": 60, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431078746761652"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Steadier playback through everything you change\n\u2022 Each frame is shown at the refresh it's meant for, from the very first frame: 4K60 with 3D, accurate colors and AI subtitles on holds an even pace, about one frame off in a minute; uneven frames in 8K60 are down to about 0.5%.\n\u2022 No more freezes of up to 0.8 s in 8K HDR's most colorful scenes, when turning 3D on, or stutter after resizing the screen.\n\u2022 A video opened from the app no longer skips its first frames, and picture and sound line up within about a refresh from the first frame.\n\u2022 Turning accurate colors or 3D on or off, curving the screen, resizing it and switching between flat, 180\u00b0 and 360\u00b0 no longer freeze: the picture plays on through them. Curving or flattening the screen is now instant.\n\u2022 Speeds: 1.25\u00d7 and 1.5\u00d7 now show every frame of 60 fps video up to 4K, 3D included; 2\u00d7 shows about 100 frames a second in 3D, all but a few without it. Changing speed no longer stalls the picture.\n\u2022 Pictures can be curved like the video's screen.\n\u2022 Video is drawn at the size that keeps it sharpest for what the GPU can take: on a large screen in 3D, 8K at 24 or 30 fps is drawn far larger than before. 8K without 3D uses up to 20% less of the GPU at large sizes. The flat screen's usual size is a little larger, so 4K and 8K are drawn exactly to fit, and resizing settles on those exact sizes when you let go near them.\n\u2022 The controllers, hands and pointer look clearer: the app's own eye buffer is now 1024 \u00d7 1024.\n\u2022 Fixed: if the headset's sound stops after many hours on, the app now restarts it and the video plays on, instead of staying frozen until a restart.", "created_date": 1793895092, "id": "1411391338730393", "version": "0.8.1", "version_code": 59, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
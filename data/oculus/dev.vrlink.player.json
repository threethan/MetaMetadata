, "id": "1107469931671382", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593942860_1107469935004715_6168229408760507926_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WWsMQZXmSMQ7kNvwESD-p7&_nc_oc=Adr7Z2xiShCkx4Cx_aXnp4CX7XTYGOFfLOJjFpqLrLLp-Yra4Bp2mY4UDfkSEEDvLS0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGuu1iY6f_y--ulZ_-_iVbKMTSoxqq_2kyGZRDhU_Tcw&oe=6AE35F8A"}]}, "id": "1765626177997473", "locale": "en_US", "screenshots": [{"file_name": "1-link-panel.png", "id": "1470139141648502", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622916_1470139144981835_2679519420706697761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyU-hoxoyscQ7kNvwEZaoh_&_nc_oc=Adothr63FXTpD9x7oHuw0f3Q3M0UyLmC0eLVriLsSMN8ILjjfiGBBJu4apD5CPH-rAQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO2dILchZIGheW7MqzeoLozftmgUnGF7l8d9Z8kkqJzA&oe=6AE35EB0"}, {"file_name": "2-360-video.png", "id": "1135497198983129", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593790560_1135497202316462_2030901946487349583_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0pYOp-WJ5cQ7kNvwG75R5c&_nc_oc=AdqXUpikRObLCqzU0knoRw726nL_-iSg-AP6SHUeuyoluNlgfg57TnLQ11AH3b89mKo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNconEoLsneVcte3gMC6J0MeL1PS9rG5D27ZBEZOzsXfQ&oe=6AE3480F"}, {"file_name": "3-subtitle-settings.png", "id": "2143141713078656", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619602_2143141716411989_7730943247921295285_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXlsggJRbfoQ7kNvwFWjRiI&_nc_oc=AdrpqCTsRD_3SGgbmmF9KQwuvke1EZZ93EsAK32-tCjklaz1f_BAjuFI4hZ2Rwu6APM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2bfhucQq-R8ATFCBGL7CB9TwNXblt3J48F4niQJpv8Q&oe=6AE36B20"}, {"file_name": "4-subtitle-menu.png", "id": "1087692420544285", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619382_1087692423877618_9090089854616291447_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLkNbnrpsQcQ7kNvwGrJ6cI&_nc_oc=AdqplzslQfrtJVbI8sygpVk1SqoDOiY0HoBkQctb1fRbHTmSzQY_rB-vfmnV8I3aaso&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ_NmiasGNF_r8GXdYZc7QrKCeFchn68BSGgABVAawQQ&oe=6AE339EB"}, {"file_name": "5-file-menu.png", "id": "1094226826853819", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622184_1094226830187152_3581893724358968313_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdjU3z-dTzsQ7kNvwHCz4of&_nc_oc=AdpHyPCrzxdvZvzecsBLGRij0g_4UtGIbt5HzLHrZSMZOka0-ZNJKkV6pqydheCXDoU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaX2W8EVOlcM7piYUow_bluZ80rPxbu-9JDOuO-QHITA&oe=6AE33A27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["video", "media", "360", "VR180", "subtitles"], "long_description": "VR Link Player turns any video link, or your own files, into your private cinema.\n\nPLAY WHAT YOU LINK\n\u2022 Movies and shows in 2D or 3D, 180\u00b0 and 360\u00b0 video, mono or 3D, pictures and playlists.\n\u2022 Links, live streams, your headset's files, home servers and Windows or NAS shares.\n\u2022 A cinema-sized screen you can stretch with a grab, or curve around you.\n\u2022 The right mode is picked for you; switch it anytime.\n\u2022 Opens from web pages and apps, playing at once.\n\nSMOOTH ON HUGE FILES\n\u2022 Downloads ahead as you watch: seeking back is instant, even if the connection drops.\n\u2022 See the frames as you drag the seek bar; jump \u00b110s with the thumbstick.\n\u2022 Picks up where you left off, with your audio and subtitles. Your last links wait in History.\n\nSUBTITLES IN YOUR LANGUAGE\n\u2022 The video's own tracks, or OpenSubtitles with your free account.\n\u2022 AI translates the video's subtitles into 80 languages as you watch, or makes them from the audio, with your free Groq key.\n\u2022 Put the subtitles where they're comfortable, even over 3D; nudge their timing.\n\nMADE FOR COMFORT\n\u2022 Dim the room around you, down to pitch black.\n\u2022 Speed from 0.25\u00d7 to 2\u00d7, snap turn, recenter for watching lying down.\n\u2022 Keeps playing in the dark, with headset tracking off.\n\u2022 Play, pause and stop from the controller buttons; a built-in guide shows every control.\n\u2022 Details at a glance: resolution, HDR, codecs, every track.\n\nYou bring the links: VR Link Player doesn't provide or find video.", "short_description": "Paste a link or pick a file, press play: your videos on a giant screen or all around you in 180\u00b0/360\u00b0, with subtitles in your language."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373991552470372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623558_2939113183116766_3816396785751376153_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W99Os-AcUvEQ7kNvwEn2aU1&_nc_oc=AdrMbPMl86lmIMsfOitCUz3HpnkXEehkLlJ6_5YiNITj-MtEnefhYjSfI70PWsQ-EKA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00
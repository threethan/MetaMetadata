c_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8YmJi0J_QNt--e137CtxuSugB2JAYBU6ayAqN-PxLkA&oe=6B0EFE45"}, {"file_name": "5-link-panel.png", "id": "1116060920911279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1116060924244612_1073016054096992979_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2Ge7Lf1SNIQ7kNvwGTg-VB&_nc_oc=AdqQs3r46JkuYjOsFRObATWbTHQg_ejOnnH_YnPoYZg9V3-i_J7Vluq7T5JrkXL4gjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrH-1oXq514LDqa65W0oMaXeYVTww0XVkt2smXUpYASQ&oe=6B0EFEBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["player", "link", "http", "https", "vr"], "long_description": "VR Link Player plays video from a direct web link, on a big flat screen or all around you.\n\n- Flat 2D on a cinema-sized screen in the video's own shape, or 180\u00b0 and 360\u00b0 video, mono or 3D (side-by-side, top/bottom). The right mode is picked from the video itself.\n- Smooth on long, high-bitrate files: the video is kept on the headset as it downloads, so seeking  back is instant and a dropped connection doesn't stop what's already there.\n- Pictures and playlists too, stepped through with A and B.\n- Subtitles in your language and English: the video's own tracks; OpenSubtitles with your free API key and account; or AI subtitles made from the audio, with your own free Groq API key.\n- Grab the subtitles to move them where they're comfortable to read, even over 3D.\n- Snap turn, \u00b110 s seeks on the thumbstick, recenter with the Meta button.\n\nYou supply the links: VR Link Player doesn't provide or find video. Subtitle services are optional and use your own accounts.", "short_description": "Play videos from any web link on a cinema screen or in 180\u00b0/360\u00b0 \u2014 with subtitles in your language and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352414997961361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1813280343279387"}]}, "baseline_offer": {"id": "1813280343279387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791902580, "status": "PUBLISHED", "id": "1813280343279387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1447670598435800", "version": "0.8.10"}, "id": "2327437844777960", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447670598435800"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795566231, "id": "1448872561648937", "version": "0.8.11", "version_code": 69, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447670598435800"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "A crash at 4\u00d7 in 3D fixed\n\u2022 Fixed a crash when a film was played at 4\u00d7 in 3D for more than about half a minute: the app ran out of memory and closed. It could happen with any video of 30 fps or below.\n\u2022 At 4\u00d7 in 3D such a film now keeps its 3D. Before, the picture went flat a second or two after the speed-up.", "created_date": 1795515342, "id": "1447670598435800", "version": "0.8.10", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447670598435800"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Subtitles stay when you pause\n\u2022 Pausing no longer takes a video's own subtitles off the screen. Before, the line stayed only if it had just appeared; now the line you paused on stays, in MKV and MP4, text and picture subtitles alike.\n\u2022 Paused, the subtitle shown is the one of the frame you see. It could be the line of a moment before.\n\u2022 Jumping to another place in an MKV shows the line being said there at once, not only from the next line on. Skipping back shows it at once too.", "created_date": 1795432824, "id": "1445832548619605", "version": "0.8.9", "version_code": 67, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447670598435800"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "Smooth 60 fps video every time, and a crash fixed\n\u2022 60 fps videos in MKV no longer stutter when opened after another video of about the same frame rate. The headset's decoder is now always told how fast the video is; before, it sometimes wasn't, and such a video lost about 10 of every 60 frames for its whole length until the app was restarted.\n\u2022 Fixed a crash when the seek bar was dragged at the moment subtitles were being chosen, most likely in a video's first seconds.", "created_date": 1795242621, "id": "1441750352361158", "version": "0.8.8", "version_code": 66, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1352414991294695", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1447670598435800"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2327437844777960"}]}, "change_log": "More comfortable 3D\n\u2022 A person or thing in front now keeps the same shape in both eyes: what's near is grown a little further in the depth, so its outline no longer stretches one way in one eye and another in the other, the main thing that made 3D unpleasant to look at. The trade is a slightly wider halo in the background beside it.\n\u2022 Less smearing at the edges of near things.\n\u2022 For films and 60 fps video alike.", "created_date": 1795001881, "id": "1436375282898665", "version": "0.8.7", "version_code": 65, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
, "id": "1107469931671382", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1107469935004715_6168229408760507926_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrFmb6YRF08Q7kNvwHXVGrb&_nc_oc=AdrhcZsFaeeJg2THlmz1PoIODHylLO79OlkTZXGRFXLtkaHiLDdzEGaO-Qo4aoM2dFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAQapFZchAKIzmLeKelKHlSznr90xg5T9s848Z7aWBoQ&oe=6AEB488A"}]}, "id": "1014887868323925", "locale": "en_US", "screenshots": [{"file_name": "1-link-panel.png", "id": "1470139141648502", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_1470139144981835_2679519420706697761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0-Ni6agOO4Q7kNvwF3FNox&_nc_oc=Adqe1EovMy4hJ3_TybWyAFs8QqOkaYI_o6hsJplAzrY8p47V40NazByHsi_CqWYUfi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-JvZR3IzO_DUL3qEe31aZymx7XO2hJPp8u8FyQbROSg&oe=6AEB47B0"}, {"file_name": "2-360-video.png", "id": "2223033955094806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593860406_2223033958428139_3876752668697350898_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_X5vKhmaywQ7kNvwHKgLoK&_nc_oc=AdqWdBJAIGdASczBLLH7ekUsLMHgxt8YxgEjh8UFd49zEIKKjb5pQCZaabpx08Apchs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrSEjO06IJ_xb-uzvcQQ6mNjdLPX-s4rB3esoAUvBA2Q&oe=6AEB31E8"}, {"file_name": "3-subtitle-settings.png", "id": "2143141713078656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619602_2143141716411989_7730943247921295285_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX63CDohrz8Q7kNvwHEbRSI&_nc_oc=AdqE1gUqUXDHusS-bQPtMy1aF_dsHjZ-nXMpWwSM-elCleckX8Qpd8ZD9Is81Cm8S8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgVs_GzjjIc3dIhj-AIbKYrgbRkBrVf22lAhRnaSX86w&oe=6AEB5420"}, {"file_name": "4-subtitle-menu.png", "id": "1770422170921849", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624656_1770422174255182_1464885918873116933_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hh0cJ2_byKcQ7kNvwFxpiCR&_nc_oc=AdrUsV7SPI7KP_7h1douwz4yRltNfcG-wcti483YwD5lXQF0XdprOAQh8azl1r2hLGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGELjTBojg4365-xW_8JPJO2As0Wc_ZBkUWOd21JDdyQ&oe=6AEB4AEC"}, {"file_name": "5-file-menu.png", "id": "895153853684565", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623558_895153860351231_2134896274258043047_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KC_9o51dUNsQ7kNvwFEEYdl&_nc_oc=AdqKZXFnrOqf0LhN6nLxvOjzPF_IR2cg0xyON5MRGrkRkJK5Wtk6bH6lXcAwm8YJbmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPgBq3Q4edNtaiCrUb5qRytVTNlg4ERDxu261OcgXzxw&oe=6AEB42EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Link Player", "keywords": ["video", "media", "360", "VR180", "subtitles"], "long_description": "VR Link Player turns any video link, or your own files, into your private cinema.\n\nPLAY WHAT YOU LINK\n\u2022 Movies and shows in 2D or 3D, 180\u00b0 and 360\u00b0 video, pictures and playlists.\n\u2022 Links, live streams, your headset's files, home servers and Windows or NAS shares.\n\u2022 A cinema-sized screen to stretch with a grab, or curve around you.\n\u2022 The right mode is picked for you; opens from web pages and apps.\n\n2D MADE 3D, TRUE COLORS\n\u2022 Any flat video or photo in real 3D: each frame its own depth, made on your headset, even 8K at 60 fps.\n\u2022 Accurate colors: SDR as made for TV, HDR tone-mapped to each scene.\n\nSMOOTH ON HUGE FILES\n\u2022 Downloads ahead as you watch: seeking back is instant, even if the connection drops.\n\u2022 See the frames as you drag the seek bar; jump \u00b110s with the thumbstick.\n\u2022 Picks up where you left off, with your audio and subtitles.\n\nSUBTITLES IN YOUR LANGUAGE\n\u2022 The video's own tracks, or OpenSubtitles with your free account.\n\u2022 AI translates subtitles into 80 languages, or makes them from the audio, with your free Groq key.\n\u2022 Place them where you like, even over 3D; nudge their timing.\n\nMADE FOR COMFORT\n\u2022 The room around you starts pitch black; brighten it any time.\n\u2022 Speed from 0.25\u00d7 to 2\u00d7, snap turn, recenter for watching lying down.\n\u2022 Controller buttons play, pause and stop; a built-in guide shows them all.\n\u2022 Details at a glance: resolution, HDR, codecs, every track.\n\nYou bring the links: VR Link Player doesn't provide or find video.", "short_description": "Paste a link or pick a file, press play: your videos on a giant screen or all around you in 180\u00b0/360\u00b0, with subtitles in your language."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getlk.net/vr-link-player/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "NTN Player", "support_website_url": null, "website_url": "https://getlk.net/vr-link-player/privacy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388443121025215"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623558_2939113183116766_3816396785751376153_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F40YY1bYLlkQ7kNvwGkcrjg&_nc_oc=Ado5dSXDRg0_JmrD8ZDuJFyB7R9kota1ah7wzZpkpzHqmVIbRcD7J0totjN-LFKrtyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc
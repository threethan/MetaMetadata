e_name": "metaquestpic.png", "id": "2218506455619236", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499299891_2218506462285902_2036923788231666228_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyX6V8w0Rq4Q7kNvwGvN82V&_nc_oc=AdpxpzkEYFEekvc7vIL7ay2apuhpHNRT_Q5u3rRTjESenTX9MDQMKYqKGiYfT5q1tjE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTNfrK2iYkEdyzVzBq9tpGc1yvWf2bNbV9L6n8o7hQ1Q&oe=6AFC814C"}, {"file_name": "Screenshot 2026-07-17 231705 (1).png", "id": "1909946596310635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507840145_1909946599643968_8625532640280397294_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rtNMK2VyhAQ7kNvwENR73U&_nc_oc=Ado3MPgAo3BtO7NnS6E7lu2Lci6GqC883SQsBNzgRsm_wn-19XyoKO-_9L-CyxC7jNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKfJhMYPiMuIlM4Na_xZq7vRY_Z7N4vGcHn2BtTuJ6nQ&oe=6AFC6A17"}, {"file_name": "vpn_resized_2560x1440xxxxxx.png", "id": "859309253694644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_859309257027977_6079478225800758708_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMFUT_y_BoUQ7kNvwExLDOy&_nc_oc=Adpc-ie581ZNPwq-hxRQyasiog3-zOHK1h-AyK3pNxCJ_eVmL2QwnFfLHpvi52-yIJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf-g1o4F2UaXdpr9do4y3BHXc47Gj1dTYfp5awPLkExA&oe=6AFC8440"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cybertection GuardBot Security", "keywords": [], "long_description": "Cybertection delivers an elite, enterprise-grade cybersecurity suite wrapped in a striking cyberpunk aesthetic. Designed for users who demand absolute privacy and total control over their device, Cybertection transforms complex digital defense into a powerful, visually stunning experience.\n\nTake advantage of an advanced security matrix right from your central dashboard:\n\u2022 Trigger full-system malware sweeps to isolate and neutralize hidden threats instantly.\n\u2022 Launch the WebGuard VPN to encrypt your connection and shield your browsing telemetry.\n\u2022 Use the real-time URL Inspector to catch dangerous phishing scripts before you click.\n\u2022 Run cutting-edge Deepfake Verification to analyze media and flag AI-altered content.\n\u2022 Track active security events as they happen through a live diagnostic terminal feed.\n\nWith a high-contrast neon layout optimized for quick navigation, Cybertection gives you massive defensive power without slowing down your device. Easily manage your account security and monitor your active subscription status in just a few taps. \n\nLock down your digital frontier. Download Cybertection today.", "short_description": "Cybertection gives you complete control over your digital safety with a sleek, easy-to-use cyberpunk style. Right from the main dashboard screen, you can run an instant malware scan, turn on the WebGuard VPN to protect your privacy, check suspicious links with a built-in URL inspector, and use a cutting-edge deepfake scanner to catch fake or AI-altered media. You can also easily check your subscription status and manage your account securely in just a few taps. Take charge of your security."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cybertection.net/meta-quest-terms", "developer_terms_of_service_url": "https://www.cybertection.net/meta-quest-terms", "publisher_name": "Joseph Plaugher", "support_website_url": "https://cybertection-guardbot.com/support", "website_url": "https://cybertection.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended
op&_nc_oc=AdnLgFap6OE7kmZ8R8PTgRp9zM9a6i9fb6wCHJEspsRnsVRX0kxVWfYB_9eZ2OHVn7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXVJhQuxYJ16LFAKK5gWKo4rvOMtPe7aLfaQ9IwMArPA&oe=69BBDEF9"}, {"file_name": "ScreenShot #4.png", "id": "1476417007333200", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823893_1476417010666533_3225405788543420996_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkJYPd2wK8IQ7kNvwFtaw7I&_nc_oc=Adk1ABfYFrQkcceifFB19sEJfzn0DRBaioX9DPH04mOA2aRjYgX2f4i1FzG3tCnDhpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyW0XH_OPYDqpOZuhoT8Rv8JnFJgPAVLUcHFfyZJRMkcA&oe=69BBE3E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret Limbo", "keywords": ["tag", "gorilla", "secret", "secretlimbo", "fangame"], "long_description": "Secret Limbo is a Fun-Filled VR multi-player gorilla tag inspired game where you and your friends join together to explore and collect Secrets around the map!\n\nThese secrets can range from finding a hidden text on the map, to solving a puzzle that may require certain tools, there are many different ways to collect secrets, such as puzzle solving, parkouring, scavenger hunting, and more!\n\nIt has many maps and secrets ranging from a chill nice forest, to a scary dark graveyard!\n\nYour goal is to collect every secret and become the champion of secret limbo! Who knows... you might even be the first person ever to unlock a certain secret! You will only know through playing! So... What are you waiting for? Play Secret Limbo today!", "short_description": "Secret Limbo is a Fun-Filled VR multi-player gorilla tag inspired game where you and your friends join together to explore and collect Secrets around the map!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/secret-limbo-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mooneticity", "support_website_url": null, "website_url": "https://sites.google.com/view/secret-limbo-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26568395396079435"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299139_1234102612248106_5760645738852735193_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLsh2GznKnQQ7kNvwHfkDKL&_nc_oc=Admtww4SIol6acwdi1ScE-P_Mj0Ym60Ne2YvVjzwn7kF8LrvM0GdG_l4SAiXZ1narLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxI_Iivd8e1UVbF3ip1DY_Om5tE7vboosvw3Pk3xo0TWw&oe=69BBDFB2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Secret Limbo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1773149820, "lastRevision": {"nodes": [{"id": "26568395402746101", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26568395376079437", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "950712717389499"
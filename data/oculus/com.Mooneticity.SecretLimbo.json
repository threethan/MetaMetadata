0a&_nc_ohc=4--KRe8KVt8Q7kNvwH-pFez&_nc_oc=AdofJnN1RoYjO1jnQiZVc6NO-UsGgo9X3LpnjK01LktUAcK07eFF6NrhFN7p2gqp4lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wugob8_MiYfCMIfwkXjPpnGjPUNcparH_sWCsy-LLxA&oe=6A204939"}, {"file_name": "ScreenShot #4.png", "id": "1476417007333200", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823893_1476417010666533_3225405788543420996_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOH1c3ie1DAQ7kNvwFQOjlO&_nc_oc=AdoVOsEdQ96Ob6HncruS1wLvNeMxuxLnmKa027EBoOvZJTpyrFHqDl05A4B-ooOQ77k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D7NxQCBuNjXipM17epTSRoKKc7yROX9NARP0n3KCEVw&oe=6A204E25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret Limbo", "keywords": ["tag", "gorilla", "secret", "secretlimbo", "fangame"], "long_description": "Secret Limbo is a Fun-Filled VR multi-player gorilla tag inspired game where you and your friends join together to explore and collect Secrets around the map!\n\nThese secrets can range from finding a hidden text on the map, to solving a puzzle that may require certain tools, there are many different ways to collect secrets, such as puzzle solving, parkouring, scavenger hunting, and more!\n\nIt has many maps and secrets ranging from a chill nice forest, to a scary dark graveyard!\n\nYour goal is to collect every secret and become the champion of secret limbo! Who knows... you might even be the first person ever to unlock a certain secret! You will only know through playing! So... What are you waiting for? Play Secret Limbo today!", "short_description": "Secret Limbo is a Fun-Filled VR multi-player gorilla tag inspired game where you and your friends join together to explore and collect Secrets around the map!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/secret-limbo-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mooneticity", "support_website_url"
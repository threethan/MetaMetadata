.png", "id": "842399378826630", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_842399385493296_6934619184713280216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS-7EYJDBy4Q7kNvwFcfIBK&_nc_oc=AdqC0EzyNQwQEcOjiSwZ01yBvWBpiBl8oL2ggJl9AnO9Qmujhfi5ZZzFuvt0dtG1fgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Z6JoD3VgVFiFdnXxkQ-MbhlLY6iYn7mF8YHL3Ic-Nw&oe=6AE9DC25"}, {"file_name": "5.png", "id": "4108940516076102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_4108940519409435_5922822390056460056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8ST08AXkiAQ7kNvwFMz3Le&_nc_oc=AdrCiddKUMWO4oBZ0T_iCtb6x-3S4IE6wpHwvWtsEaoChLSbz2BWlG0CZveBrj2ugR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_M6t3N91g-h9JykJQS5UHGY-Y1NNDZquaTR6QoVAYZw&oe=6AE9E0B5"}, {"file_name": "2.png", "id": "2004994534223431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_2004994537556764_2394858790548936124_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGsSvwLH4C8Q7kNvwEVCn82&_nc_oc=Adpgs0H7vvGjuPSuCGrpYLk0uYyWH2EswpCsqyiysn4TPs84aycwjM9_KTAsnbBPoLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLgUCeemMsDDrG3uiW8KEPGFjxPD3XUV46SanrGo0qvA&oe=6AE9EED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11.png", "id": "2280975749383318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817987_2280975752716651_6477708620983174944_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLFGiJ1iMuAQ7kNvwF4UUhW&_nc_oc=AdpS9z27yRHAxMIEoPd84Wvvjmq3CdFsDJ2_PWCnD0MrCYJcLSWnNZXI-lk6biV_G9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVLmYrMZmG-uoOj6Wewm7ZYnwdbii_Nu_xPcUEjV6XBQ&oe=6AE9EEB1"}, "display_name": "Leaf Sweeper VR: Cozy Cleanup", "keywords": ["Simulation", "Casual", "Cleaning", "Roleplay"], "long_description": "The leaves are piling up, and it\u2019s time to take matters into your own hands! Step into a cozy, relaxing virtual reality where your only goal is to restore order to a beautiful, messy home.\n\n**Leaf Sweeper VR: Cozy Cleanup** is a satisfying cleaning simulator designed from the ground up for VR. Start with just your bare hands and a trash bag, and work your way up to professional-grade leaf blowers and automated vacuum chutes. Clear out the front porch, tackle the driveway, and unlock the sprawling backyard at your own pace.\n\n### Key Features\n* **Satisfying VR Interactions:** Physically sweep, rake, and blow leaves using intuitive motion controls. Hear the crisp crunch of autumn leaves underfoot and feel the haptic feedback of your tools.\n* **Incremental Upgrades:** Trade your bagged leaves for cash. Buy larger trash bags, wider rakes, and more powerful leaf blowers to clean faster and more efficiently.\n* **Unlock New Areas:** Progress through different parts of the house, from the cozy basement entrance to the relaxing pool deck.\n* **Zen-Like Gameplay:** No timers, no enemies, no stress. Go at your own pace in a fully immersive, stylized environment.\n\nRoll up your sleeves, upgrade your gear, and discover the oddly therapeutic joy of a perfectly clean yard.", "short_description": "Grab your rake, fire up the leaf blower, and transform messy yards into pristine spaces in this relaxing VR cleaning simulator. Pick up leaves, earn cash, upgrade your tools, and unlock new areas around the house. The ultimate cozy chore! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://w42dev.netlify.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "W42", "support_website_url": null, "website_url": "https://w42dev.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
771-25/491823812_842399385493296_6934619184713280216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX75JAfkNc8Q7kNvwHfzINo&_nc_oc=AdoNZt5gvuNbUsrxHZtHd6EwLxLFi0ZfoB099n54hBaJEQVc7KMWQr1lunH_F178w5M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWn7-YNb6YUJTGeFgRTO0YybKBXAM9LWOF2ir3vYSQeQ&oe=6AFB37E5"}, {"file_name": "5.png", "id": "4108940516076102", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823949_4108940519409435_5922822390056460056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FQhPL00R68Q7kNvwHJU6p9&_nc_oc=AdpalsoRuEB_4LRdyiVmZfSfC4w2oUaOP3ETCms_eAt0IkOVLr9EvtKDomNbEhfnMzI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2JzBI7JLsF-GzDLZaWmZhUFG6TQeTykC6olIzx_FI3w&oe=6AFB3C75"}, {"file_name": "2.png", "id": "2004994534223431", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825503_2004994537556764_2394858790548936124_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51K0WGXqF2kQ7kNvwGJh0s_&_nc_oc=AdocTi9xY5MMrKghF2xYVyrok1UQHRsoVb6o4WUcOthTAkMNt2brHY4lQZgvZYnDw20&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK3aZJh2kDRDGdoDuZzpzsWbko_Ps1Q1kAiLHkzbkGkA&oe=6AFB4A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11.png", "id": "2280975749383318", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507817987_2280975752716651_6477708620983174944_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ9vdxYkvhQQ7kNvwHICKR9&_nc_oc=AdrmWZ4TQq2Uo2e8fNgi1nat-Oe2prJGUcnc9cYMpx230tTcIf24amAulkmT3dkNP00&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlJlFD2-OTIoBZwP21rL57J4jFR5jAZmJdEsWIGERtWw&oe=6AFB4A71"}, "display_name": "Leaf Sweeper VR: Cozy Cleanup", "keywords": ["Simulation", "Casual", "Cleaning", "Roleplay"], "long_description": "The leaves are piling up, and it\u2019s time to take matters into your own hands! Step into a cozy, relaxing virtual reality where your only goal is to restore order to a beautiful, messy home.\n\n**Leaf Sweeper VR: Cozy Cleanup** is a satisfying cleaning simulator designed from the ground up for VR. Start with just your bare hands and a trash bag, and work your way up to professional-grade leaf blowers and automated vacuum chutes. Clear out the front porch, tackle the driveway, and unlock the sprawling backyard at your own pace.\n\n### Key Features\n* **Satisfying VR Interactions:** Physically sweep, rake, and blow leaves using intuitive motion controls. Hear the crisp crunch of autumn leaves underfoot and feel the haptic feedback of your tools.\n* **Incremental Upgrades:** Trade your bagged leaves for cash. Buy larger trash bags, wider rakes, and more powerful leaf blowers to clean faster and more efficiently.\n* **Unlock New Areas:** Progress through different parts of the house, from the cozy basement entrance to the relaxing pool deck.\n* **Zen-Like Gameplay:** No timers, no enemies, no stress. Go at your own pace in a fully immersive, stylized environment.\n\nRoll up your sleeves, upgrade your gear, and discover the oddly therapeutic joy of a perfectly clean yard.", "short_description": "Grab your rake, fire up the leaf blower, and transform messy yards into pristine spaces in this relaxing VR cleaning simulator. Pick up leaves, earn cash, upgrade your tools, and unlock new areas around the house. The ultimate cozy chore! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://w42dev.netlify.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "W42", "support_website_url": null, "website_url": "https://w42dev.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1287094724478980"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1347243410732454"}, {"status": "PUBLISHED", "id": "1732449248887770"}, {"status": "CANCELLED", "id": "2245456806406005"}, {"status": "PUBLISHED", "id": "1023616480541474"}]}, "baseline_offer": {"id": "1347243410732454"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794182100, "status": "PUBLISHED", "id": "1347243410732454"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1472567412598376", "version": "1.2.0"}, "id": "1026885089980861", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1287094717812314", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472567412598376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1026885089980861"}]}, "change_log": "What's new in 1.2.0\n\n- Real tools: take the leaf blower from your right hip and the rake from your back. Let go and they go back on their own.\n- The tutorial now lets you try both tools, and teaches pausing.\n- More comfort: a slower default walk, a comfort vignette and seated play.\n- Menus open in front of you instead of on your wrist.\n- The game pauses when you open the Quest menu.\n- Scene changes fade smoothly to black.\n- Fixed bugs that could lose your progress or coins.", "created_date": 1793927169, "id": "1472567412598376", "version": "1.2.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1287094717812314", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472567412598376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1026885089980861"}]}, "change_log": null, "created_date": 1786879651, "id": "1311547592033693", "version": "1.1.1", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1287094717812314", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472567412598376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1026885089980861"}]}, "change_log": null, "created_date": 1786853083, "id": "1311061325415653", "version": "1.1.1", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1287094717812314", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472567412598376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1026885089980861"}]}, "change_log": "Version 1.1\n\nCoins can now be earned. Finishing the tutorial and completing any garden area pays a reward, so the Rake and Leaf Blower in the shop can finally be bought and used. Replaying an area you have already cleared pays a smaller reward.\n\nAn area now finishes only when every last leaf is gathered, not just most of them.\n\nFixes\n- Leaves no longer vanish without counting toward your bag\n- The rake keeps its pile while you carry a bag to the bin\n- Removed an unused internet permission\n\nThanks for playing - Make sure to drop a rating and feedback.", "created_date": 1786085630, "id": "1296853000169819", "version": "1.1", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1287094717812314", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472567412598376"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1026885089980861"}]}, "change_log": null, "created_date": 1785692218, "id": "1289202394268213", "version": "1.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
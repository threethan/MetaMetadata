EgOlDkU--VqTpFxg&oe=6AFB3CED"}, {"file_name": "3.png", "id": "842399378826630", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823812_842399385493296_6934619184713280216_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX75JAfkNc8Q7kNvwHfzINo&_nc_oc=AdoNZt5gvuNbUsrxHZtHd6EwLxLFi0ZfoB099n54hBaJEQVc7KMWQr1lunH_F178w5M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWn7-YNb6YUJTGeFgRTO0YybKBXAM9LWOF2ir3vYSQeQ&oe=6AFB37E5"}, {"file_name": "5.png", "id": "4108940516076102", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823949_4108940519409435_5922822390056460056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FQhPL00R68Q7kNvwHJU6p9&_nc_oc=AdpalsoRuEB_4LRdyiVmZfSfC4w2oUaOP3ETCms_eAt0IkOVLr9EvtKDomNbEhfnMzI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2JzBI7JLsF-GzDLZaWmZhUFG6TQeTykC6olIzx_FI3w&oe=6AFB3C75"}, {"file_name": "2.png", "id": "2004994534223431", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825503_2004994537556764_2394858790548936124_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51K0WGXqF2kQ7kNvwGJh0s_&_nc_oc=AdocTi9xY5MMrKghF2xYVyrok1UQHRsoVb6o4WUcOthTAkMNt2brHY4lQZgvZYnDw20&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK3aZJh2kDRDGdoDuZzpzsWbko_Ps1Q1kAiLHkzbkGkA&oe=6AFB4A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11.png", "id": "2280975749383318", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507817987_2280975752716651_6477708620983174944_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ9vdxYkvhQQ7kNvwHICKR9&_nc_oc=AdrmWZ4TQq2Uo2e8fNgi1nat-Oe2prJGUcnc9cYMpx230tTcIf24amAulkmT3dkNP00&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlJlFD2-OTIoBZwP21rL57J4jFR5jAZmJdEsWIGERtWw&oe=6AFB4A71"}, "display_name": "Leaf Sweeper VR: Cozy Cleanup", "keywords": ["Simulation", "Casual", "Cleaning", "Roleplay"], "long_description": "The leaves are piling up, and it's time to take matters into your own hands! Step into a cozy autumn neighborhood where your only goal is to turn a messy, leaf-covered home spotless.\n\n**Leaf Sweeper VR: Cozy Cleanup** is a relaxing cleaning game built for VR. Start with your bare hands and a trash bag, then earn your way up to a rake and a leaf blower.\n\n{4607776649440330}\n*Clean with your own two hands. Grab the bag and get to work.*\n\n{2620829915007063}\n*Aim at the leaves and hold the trigger to pull them into your bag.*\n\n**Key Features**\n* **Hands-on tools:** Pull the rake from over your shoulder and draw the leaf blower from your hip. Let go and they fly back into place.\n\n{1380581040819953}\n*Drag the rake through the leaves to gather them up.*\n\n{1454731316792202}\n*Point the leaf blower and fill your bag fast.*\n\n* **Earn your gear:** Clear an area to earn coins, then spend them on a rake and a leaf blower.\n* **Five areas to clean:** The barn, courtyard, playground, pool and lawn, unlocked as you go.\n\n{1911545579826864}\n*Five areas to clean, from the barn to the pool.*\n\n* **No stress:** No timers, no enemies. Play standing or seated, at your own pace.\n\nRoll up your sleeves and discover the oddly satisfying joy of a perfectly clean yard.", "short_description": "Grab the bag, pull out the rake and fire up the leaf blower with your own two hands. Clear the barn, courtyard, playground, pool and lawn in this relaxing VR cleaning game. Earn coins, buy your tools and unlock each new area at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://w42dev.netlify.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "W42", "support_website_url": null, "website_url": "https://w42dev.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
595516342562_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3gE5JM3mhgQ7kNvwFbSGgG&_nc_oc=AdpePH0LH1r14SQRdgIu5_wCaIeo8QlIdMac2s5vgaygXS4iYOMHeL0stpnivqbMpeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0raON_OmGUPV441giDxa5vzBzwpRhqApmUtMjSusEeQ&oe=6B0C74A0"}, {"file_name": "com.BeardedGuy.CoockiePuncher-20261002-155321.png", "id": "1744578966754173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1744578970087506_184867581268551437_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M7HHx1FJyUQ7kNvwGjkkNv&_nc_oc=AdqgtB8QsqIyQ58oUpHMmdf0sQbapsA92DwzmqKI9VmkfGYNac5LlouTwo3LTQEVbms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-zonJ7p-JroYJYudSB44NjuiRxDJP057ye0ssmTCugA&oe=6B0C8020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt3Upscaled.png", "id": "1665458421844068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1665458428510734_7766498067514048318_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mZ2uzB4PkMQ7kNvwGua2kY&_nc_oc=AdrMle75HP8DPwkihCD-qGoR7wkakmJHsWqkxS4SIrWqCBxVgsHYObKkvp6eTlYWIT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHJUh_nc4ljcPuFUklHy0ZfmNpe4v0aj2SneWMwl4orA&oe=6B0C56BD"}, "display_name": "Cookie Puncher", "keywords": ["Cookie", "Punching", "Workout", "Bakery", "Boxing"], "long_description": "Welcome to Cookie Puncher - the only place where smashing cookies is not just allowed\u2026 it\u2019s encouraged.\n\nStep into a  world where your fists are the ultimate baking tool. Punch, crush, fling, and obliterate cookies in wildly satisfying ways. Whether you're going for precision hits or full - on cookie carnage, every swing counts.\n\nBut don't get too comfortable - the Cookie Thief is always looking for a chance to ruin your fun. Stay sharp, keep punching, and prove who's really in charge of the kitchen!\n\n\ud83e\udd4a Features:\n\ud83c\udf6aPunch Cookies - Smash your way through cookies with your own fists.\n\ud83d\udca5Crunchy Feedback - Feel every hit as you pound cookies into pieces.\n\ud83d\uded2Shop & Customize - Unlock new items and customize your experience.\n\ud83e\uddb9\u200d\u2642\ufe0fChallenge the Cookie Thief - Keep an eye out for the thief and take on the challenge.\n\nPunch first. Ask questions later.\n\nThis is stress relief\u2026 but tastier.", "short_description": "Punch cookies, dodge the Cookie Thief, and unleash your inner baker in this chaotic cookie smashing adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cookiepuncher.com/privacy/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BeardedGuy Games", "support_website_url": null, "website_url": "https://cookiepuncher.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39572678882347446"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824328_1383495826901220_75271845962051583_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-l6Ltk3Fh0Q7kNvwHpXq7N&_nc_oc=AdqPXDirTxZCpcaYfYLRRAi6cdKEsr1XGPUwV9Zdf11a8eDdf2FfBAdVVlBg-tw-HEk&_nc_zt=3&_nc_ht=scontent-iad
3_8318819940985198401_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnJs1GpY-goQ7kNvwEpZJ3d&_nc_oc=AdreXZ_HV0rBK0ZLPN3lwITHjJ2-fDtM4jb5ypVZZTsvkDFcoDT4WDYIb24UO848w_E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXBzC7sxDolHazXXG79iaJTGssJlXwIrBlbyZX9udQFQ&oe=6AAE8984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt3Upscaled.png", "id": "1564248915736562", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823930_1564248922403228_6762068753518313366_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-QqlwQUpg0Q7kNvwECVW2U&_nc_oc=AdrVGnSo1FizKymScBrwGPYR88FJJQcUSaN1Ktav-tyxsdF_T3a7VoggvJGgv_2fDTI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHSty1zbdMDZr8jEzHqAWtJqymFxKPZdu7Drqis21m3A&oe=6AAE9361"}, "display_name": "Cookie Puncher", "keywords": ["Cookie", "Punching", "Workout", "Bakery", "Boxing"], "long_description": "Welcome to Cookie Puncher - the only place where smashing cookies is not just allowed\u2026 it\u2019s encouraged.\n\nStep into a  world where your fists are the ultimate baking tool. Punch, crush, fling, and obliterate cookies in wildly satisfying ways. Whether you're going for precision hits or full - on cookie carnage, every swing counts.\n\nBut don't get too comfortable - the Cookie Thief is always looking for a chance to ruin your fun. Stay sharp, keep punching, and prove who's really in charge of the kitchen!\n\n\ud83e\udd4a Features:\n\ud83c\udf6aPunch Cookies - Smash your way through cookies with your own fists.\n\ud83d\udca5Crunchy Feedback - Feel every hit as you pound cookies into pieces.\n\ud83d\uded2Shop & Customize - Unlock new items and customize your experience.\n\ud83e\uddb9\u200d\u2642\ufe0fChallenge the Cookie Thief - Keep an eye out for the thief and take on the challenge.\n\nPunch first. Ask questions later.\n\nThis is stress relief\u2026 but tastier.", "short_description": "Punch cookies, dodge the Cookie Thief, and unleash your inner baker in th
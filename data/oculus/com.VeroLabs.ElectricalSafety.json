onal protective equipment (PPE)\n\u2022 Execute standard Lockout/Tagout (LOTO) procedures on enclosure circuit breaker switches to isolate hazardous energy\n\u2022 Conduct multi-phase zero-energy verification using a digital multimeter following the strict Live-Dead-Live protocol\n\nThis VR experience is part of VEROlabs, an all-in-One platform that transforms education and training through immersive Virtual Reality (VR) experiences, students and educators can explore and run VR experiments across different disciplines.", "short_description": "Get ready for an exciting journey into the world of industrial safety! Put on your headset and explore up close how to manage electrical hazards and perform secure maintenance on high-voltage systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vero-as.com/verolabsprivacypolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "VERO", "support_website_url": null, "website_url": "https://www.vero-as.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1363884623471715"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604375581_1089312403961998_9194262280280448293_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IlTLeRsN1UQ7kNvwE2PtBX&_nc_oc=Adr54oWxeQSRjTOXdMeRFt
1122724415143289", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982678_1122724418476622_3834998671565994706_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1kLQC3K0TgQ7kNvwGN-ysp&_nc_oc=Adpc3JAnReLi3F5BbgrMOQZxC_ISnkKMH1vbirt-IFTe0MyiNxBuiJfq2h8baWLg004&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMvJvLdVoWeB_ldEBYgDORKOLqL69uwU_xtbFtIQu3SQ&oe=6AFB39C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "332206752061398", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75230038_332206762061397_341053309800558256_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66UVmdKF_f0Q7kNvwGGWpAD&_nc_oc=AdqY615Dy4TxhkzHVKjakTtCJC2ieutcGKbVirzMSCYgzI_Af85ICnGRtxHDZhTu9AE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8xr-gBex2-gH3w30U3tED-S0aLxDcslcbf2R_h1ildw&oe=6AFB2793"}, "display_name": "VR Club Live", "keywords": [], "long_description": "Tropical island during sunset with event decorations and two music scenes, one just above water and second in caves under erupting Volcano. Dive into world of wonders and enjoy your stay. Complete daily quests to earn rewards, customize your avatar and uniquely identify yourself at the next generation concert. Innovative solutions like hand tracking, 120Hz, haptic feedback, various effects and interactable items are already implemented in beta. Multiplayer works with up to 20 people in one club instance and is created based on location... so you can meet someone from your area! Full body avatar and fingers, music, voice chat, effects from a VJ spot - special area where you create a visual spectacle for others, all these elements are synchronized with everyone in the club. To have more fun there are dance games and activities, one is about repeating movements of person who started the event, other is dance battle 1vs1. After all that fun you can ease your mind in beautiful rest area.", "short_description": "24/7 VR music festival, hang out with friends and other music lovers from around the world in audio-reactive spaces. Complete daily quests to earn rewards, customize your avatar and uniquely identify yourself at a new generation of concerts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrclub.live/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRCOO", "support_website_url": null, "website_url": "https://vrclub.live/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SOCIAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "452358219706065"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "685998364332038"}, {"status": "PUBLISHED", "id": "2419699528167554"}]}, "baseline_offer": {"id": "685998364332038"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748162940, "status": "PUBLISHED", "id": "685998364332038"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5150967045016142", "version": "1.396"}, "id": "254746380000667", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4293462287433293", "is_concept": false, "latest_released_binary": {"__typenam
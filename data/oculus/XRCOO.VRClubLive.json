NvwGnqCZj&_nc_oc=AdoEcYg9q6M3PtQjIQSzEaXJtzJcGZGW4ckRb54jiP-iCvZyYsUa70yJFAxrohuhRpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3CVA_cR95mIXqIuS_h-SOnG50honc_RskdQJtl8lYc4A&oe=69F0D136"}, {"file_name": "3a.png", "id": "1604568116561021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1604568119894354_4212498607118299207_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LewFmcBUZpIQ7kNvwHocXV9&_nc_oc=AdoaPiIz_RFof0i-q-TT4fJHA5qhlwiyZ40YexkDy6g7v7zImBksfyoDtzYotKCAAQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3tmpItBGycbRf31ab82Nu29fopv8021L4iY_gO4or2aw&oe=69F0CE1C"}, {"file_name": "4a.png", "id": "595410048226143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_595410051559476_5214533794294161366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yEeTGdRuboQ7kNvwH8cijQ&_nc_oc=Adqu4iScQsTBw19H2OOd325sJgqwIj5prknMeWNUygZi8o2d7rA7rBJyCStYsO242UY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af35fRUwLdcwne1eDF_LwaepJx9Lse5Ga5FB96QiJ-DzLQ&oe=69F0B9BA"}, {"file_name": "5a.png", "id": "1122724415143289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982678_1122724418476622_3834998671565994706_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSR3qJdfijoQ7kNvwFMmNtL&_nc_oc=AdoXE5HaOV_Tc3VDO1H_uOz7CFFzVzmJVvRy2ML907olb8vN101S_93jHohDfOrFIyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0pJajKfzjyih4slxp01jzX6Dpmx9rO4_16ZHnKpe-L9w&oe=69F0B289"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "332206752061398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_332206762061397_341053309800558256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVbPv5PjdDYQ7kNvwF-Ms26&_nc_oc=AdqYgZFTX2x-3SLiiFENzGUGsVxAckZ9c9AEX8ZKxjc4ufQMPUFvVOAyRsqnsb1Bm0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0SB-Frw64DF0qgPRPxym8z8zU3QYyo91n1N3aY-9Hv5A&oe=69F0A053"}, "display_name": "VR Club Live", "keywords": [], "long_description": "Tropical island during sunset with event decorations and two music scenes, one just above water and second in caves under erupting Volcano. Dive into world of wonders and enjoy your stay. Complete daily quests to earn rewards, customize your avatar and uniquely identify yourself at the next generation concert. Innovative solutions like hand tracking, 120Hz, haptic feedback, various effects and interactable items are already implemented in beta. Multiplayer works with up to 20 people in one club instance and is created based on location... so you can meet someone from your area! Full body avatar and fingers, music, voice chat, effects from a VJ spot - special area where you create a visual spectacle for others, all these elements are synchronized with everyone in the club. To have more fun there are dance games and activities, one is about repeating movements of person who started the event, other is dance battle 1vs1. After all that fun you can ease your mind in beautiful rest area.", "short_description": "24/7 VR music festival, hang out with friends and other music lovers from around the world in audio-reactive spaces. Complete daily quests to earn rewards, customize your avatar and uniquely identify yourself at a new generation of concerts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrclub.live/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRCOO", "support_website_url": null, "website_url": "https://vrclub.live/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SOCIAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD", "OCULUS_TOUCH
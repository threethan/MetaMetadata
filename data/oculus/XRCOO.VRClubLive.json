cdn.com/v/t64.5771-25/39031629_918700868647961_6457761451850240749_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dt3DvQAeh2sQ7kNvwF9dkyi&_nc_oc=Adr3_PafVmM4Q62t1VWaKTaebHjPRdkjIXZLXg0eehC3cu52sIaeVBGBKTIep0ebHUI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1bXIK3wwljpPEzqoM2EEL-7n2ovHcmzqd8IlG4dKdttg&oe=69F1EA76"}, {"file_name": "3a.png", "id": "1604568116561021", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974504_1604568119894354_4212498607118299207_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZIWGF8JBnIQ7kNvwF9NoYP&_nc_oc=Adr41kkVoV0rAwKDB6zb63eCfFJrOXzRQaAAAkH7wFfW510-n_Aoxhx4u7TR1BaFbcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1h6Tb6ouBWbM3ntZOW9NkbQetIgmuyk4rOW8oMVKBfpQ&oe=69F1E75C"}, {"file_name": "4a.png", "id": "595410048226143", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569471_595410051559476_5214533794294161366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yEeTGdRuboQ7kNvwE_HuTh&_nc_oc=AdqkIIYulpX2eAUbKLCmPa0_QpTLwqlAYJLwir0mbINzmtgJdZM3yb727jsAQLslzdM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3PinrAO-lw5k-h9YHGFsvqGPDboqTNOMgRG6kYH3fqCA&oe=69F20B3A"}, {"file_name": "5a.png", "id": "1122724415143289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_1122724418476622_3834998671565994706_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSR3qJdfijoQ7kNvwFjgtlY&_nc_oc=AdoDjkJNCKBBa4Yb5_33oa3Yp_Vc8l6am0I_mIobe-Ko9rLgf6rYTqVegT0hBBfatIA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EPU8K_oukAKkE_cXNysiiDsoTVVUI-q3Ikm6myxEFVg&oe=69F20409"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "332206752061398", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230038_332206762061397_341053309800558256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZjiW4L-7iYQ7kNvwEZsyWz&_nc_oc=AdpaZm0eljjD5b4cj-04Q6NlxV9MF-s5vNEhrgY54ARvMQLowYNImoZD-hwkSHTyzZI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xJoJeIE7cPgRSnePSXyDxl4New6APLAXwQi8tng1Yfw&oe=69F1F1D3"}, "display_name": "VR Club Live", "keywords": [], "long_description": "Tropical island during sunset with event decorations and two music scenes, one just above water and second in caves under erupting Volcano. Dive into world of wonders and enjoy your stay. Complete daily quests to earn rewards, customize your avatar and uniquely identify yourself at the next generation concert. Innovative solutions like hand tracking, 120Hz, haptic feedback, various effects and interactable items are already implemented in beta. Multiplayer works with up to 20 people in one club instance and is created based on location... so you can meet someone from your area! Full body avatar and fingers, music, voice chat, effects from a VJ spot - special area where you create a visual spectacle for others, all these elements are synchronized with everyone in the club. To have more fun there are dance games and activities, one is about repeating movements of person who started the event, other is dance battle 1vs1. After all that fun you can ease your mind in beautiful rest area.", "short_description": "24/7 VR music festival, hang out with friends and other music lovers from around the world in audio-reactive spaces. Complete daily quests to earn rewards, customize your avatar and uniquely identify yourself at a new generation of concerts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrclub.live/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRCOO", "support_website_url": null, "website_url": "https://vrclub.live/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SOCIAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_
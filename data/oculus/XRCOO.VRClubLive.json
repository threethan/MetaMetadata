NvwGjPnCH&_nc_oc=AdmqnEYpB_E4M2SzjP44w-tr0wKbrm6yNvzGiJbc85VTY6_7o6pq1XQ7BLki5kBta-M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuz07MkpqGXV4pZSCkT4ED3WqOXj58sjylK4HmJ25ivuw&oe=69A57376"}, {"file_name": "3a.png", "id": "1604568116561021", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974504_1604568119894354_4212498607118299207_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1tDiImbookQ7kNvwE0C6pp&_nc_oc=AdmvOC85E9Qcq5BmGBhgcwx2p3hgsayoQk4EYMkP-bDvfGzJq3UYSH87kThaUDgKx8A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsOa_RtYR5rNb8roGK710DsHaVlKz3_1s5D6Xq4H8AtMw&oe=69A5705C"}, {"file_name": "4a.png", "id": "595410048226143", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569471_595410051559476_5214533794294161366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3Nb3-y47WYQ7kNvwEMR979&_nc_oc=Adm8oR1GXPDAZ0PTWwQVDKRebnQULtiQvnhxHLtfVkaRMjyMaYOE7dX-0KfxyM5lgxc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsO19twRT4j_nQcUzVKiOWU7izg3e0sbhz0pkaVvEgmjQ&oe=69A5943A"}, {"file_name": "5a.png", "id": "1122724415143289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982678_1122724418476622_3834998671565994706_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MX5dAFumgKEQ7kNvwFxZlmf&_nc_oc=AdnX54jnxSuQ38xbZ9V2CiX49SIGOsyCCtT_U5H2o84mN86bryf7q_HNHACjos17E3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftR5Na9UU7HFxrrJG4vPAttxjM88lu3A_w2LoLQ3pazrQ&oe=69A58D09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "332206752061398", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75230038_332206762061397_341053309800558256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk-5Ldp0IFIQ7kNvwGoeQ-u&_nc_oc=AdkTEC7DNJja_jflSKeqS3n9wu992Fp4gZ-Y-e0AXyRC7aG7k-Pc9Wlb6BMygF2Rzf8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvpriaieIuCUVgMrQDcH17oEXSDpspgpXEUpUIL77z6tw&oe=69A57AD3"}, "display_name": "VR Club Live", "keywords": [], "long_description": "Tropical island during sunset with event decorations and two music scenes, one just above water and second in caves under erupting Volcano. Dive into world of wonders and enjoy your stay. Complete daily quests to earn rewards, customize your avatar and uniquely identify yourself at the next generation concert. Innovative solutions like hand tracking, 120Hz, haptic feedback, various effects and interactable items are already implemented in beta. Multiplayer works with up to 20 people in one club instance and is created based on location... so you can meet someone from your area! Full body avatar and fingers, music, voice chat, effects from a VJ spot - special area where you create a visual spectacle for others, all these elements are synchronized with everyone in the club. To have more fun there are dance games and activities, one is about repeating movements of person who started the event, other is dance battle 1vs1. After all that fun you can ease your mind in beautiful rest area.", "short_description": "24/7 VR music festival, hang out with friends and other music lovers from around the world in audio-reactive spaces. Complete daily quests to earn rewards, customize your avatar and uniquely identify yourself at a new generation of concerts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrclub.live/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRCOO", "support_website_url": null, "website_url": "https://vrclub.live/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SOCIAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD", "OCULUS_TOUCH
56_2047933462058631_5610111210418776854_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgNYqxR7pEIQ7kNvwERsDta&_nc_oc=AdquUhd4buzB_jqBPwvbg-zUNIPPSHslIQBzVPndcwr0H4TC7il1kCWZy4j6QzMGQsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbBafoYZ6jK1VBwz0H8eXHa_p3X-HBmddTdYWX1kJ7Xg&oe=6AEB4E3F"}, "display_name": "Komodo 3k Arena", "keywords": [], "long_description": "Get ready for a big Komodo 3k explosion and then a big challenge to fight against hundreds of komodo dragons chasing you, a basic and entertaining shooting game with different levels of complexity.\n \n* 24 types of fireworks to customize your Komodo 3K\n* A weapon in each hand\n* Health and Ammo Pickup Boxes\n* Hundreds of Komodo dragons approaching\n* 3 minutes in the arena with different levels", "short_description": "Create an amazing Komodo 3k with fire in the sky, then start the fighting arena with hundreds of komodo dragons, very challenging experience, you have 3 minutes to win.   \n* Customize your komodo 3k with 24 different fireworks effects"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bunkersurfer.com/privacypolicy-komodo-3k", "developer_terms_of_service_url": null, "publisher_name": "Bunker Surfer", "support_website_url": null, "website_url": "https://bunkersurfer.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3353892664848735"}, "review_message
ure.\n\nAchievements\n-Implemented \"Mystery Achievements\" and added a few for discovery.", "created_date": 1659799004, "id": "5285010321583145", "version": "1.0", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4608218339262350", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5285010321583145"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "704447760469400"}]}, "change_log": null, "created_date": 1653947406, "id": "5098278050256374", "version": "1.0", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4608218339262350", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5285010321583145"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "704447760469400"}]}, "change_log": null, "created_date": 1652309701, "id": "5042115749205938", "version": "1.0", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4608218339262350", "is_concept": false, "latest_released_binary": {"
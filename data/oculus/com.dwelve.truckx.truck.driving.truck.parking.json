X9UgOjAVQL6kpbEqwEj7joD9_lId5c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmheevmMe00QTwnccMeEZ4wr2RxhzuM1wApjGpYRgiqg&oe=6AF9EA6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TruckX : Truck Driving & Parking Game", "keywords": ["truck", "simulator", "parking", "driving", "tanker"], "long_description": "TruckX is an immersive VR truck simulator and truck driving game for Meta Quest. Get behind the wheel of powerful trucks, complete delivery jobs, earn money, explore scenic roads, and build your trucking career.\n\nExperience realistic truck driving in VR with first-person controls, traffic, toll plazas, police checkpoints, parking areas, fuel stops, traffic violations, and truck maintenance. Manage your journey and expenses while taking on different delivery routes.\n\nBuild your fleet by purchasing new trucks, upgrading your vehicles, unlocking routes, and completing more challenging deliveries. Whether you enjoy truck simulation games, driving games, or immersive VR experiences, TruckX puts you in the driver's seat for an engaging trucking adventure.\n\nFeatures\n\u2022 VR truck simulator experience\n\u2022 Immersive first-person truck driving\n\u2022 Multiple trucks to purchase and drive\n\u2022 Delivery jobs and career progression\n\u2022 Scenic roads and diverse environments\n\u2022 Unlockable routes and destinations\n\u2022 Truck upgrades and customization\n\u2022 Fuel and maintenance management\n\u2022 Traffic, toll plazas, and police checkpoints\n\u2022 Parking and traffic violations\n\u2022 Earn money through deliveries\n\u2022 Explore the road at your own pace\n", "short_description": "Drive powerful trucks in TruckX, an immersive VR truck simulator for Meta Quest. Complete deliveries, earn money, explore scenic roads, and build your trucking career. Manage fuel, maintenance, traffic, tolls, police checkpoints, parking, and road challenges while unlocking routes, purchasing new trucks, and upgrading your vehicles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uafle.github.io/dwelve/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Dwelve", "support_website_url": null, "website_url": "https://uafle.github.io/dwelve/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1405880085931781"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2117748035535553"}, {"status": "PUBLISHED", "id": "3011926709151931"}]}, "baseline_offer": {"id": "3011926709151931"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2117748035535553"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1477305762122546", "version": "6.0.1"}, "id": "1018313844547661", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1405880075931782", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1477305762122546"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1018313844547661"}]}, "change_log": null, "created_date": 1793280784, "id": "14773
n the jungle? It\u2019s calling your name. Are you just playing the game\u2014or is the game playing you? and this game has people in it!!! and i think something is there....", "short_description": "Chimp Phobia will terrify you in the most scary spooky terrifying ways"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Offsale / Ben", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24560785416888019"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297237_778463908005407_7273385967916308838_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex6xgUsWfocQ7kNvwHaT_AE&_nc_oc=AdoImW_FsiAJxWGBcHMpVE0NnAzZaIue_QIjse_p1340mcyQQ-IV1-MxDcNGPn3ckMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRtnqPLDelMjYKQWSWb00tMmyfEksfDpIAZzEPymsO0Q&oe=6B0C7D49"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimp Phobia", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": 
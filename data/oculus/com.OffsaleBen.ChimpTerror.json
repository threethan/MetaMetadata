ng you? and this game has people in it!!! and i think something is there....", "short_description": "Chimp Phobia will terrify you in the most scary spooky terrifying ways"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Offsale / Ben", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24560785416888019"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1757349285149973"}]}, "baseline_offer": {"id": "1757349285149973"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758579240, "status": "PUBLISHED", "id": "1757349285149973"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25075485075418048", "version": "0.18"}, "id": "1400118711061963", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24488109097488985", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25075485075418048"}, "release_status": "RE
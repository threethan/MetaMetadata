ErgXOjmZJoxSL86OSIp578HGcrYBNwjwZA&oe=6B01DC28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Phobia", "keywords": [], "long_description": "In a hyper-immersive VR world, you strap into the suit, boot up the system, and become a monke\u2014no rules, just bananas, tree-jumping chaos, and primal mayhem. But something\u2019s off this time. The game doesn\u2019t end. The NPCs start acting... aware. And that ancient monke temple deep in the jungle? It\u2019s calling your name. Are you just playing the game\u2014or is the game playing you? and this game has people in it!!! and i think something is there....", "short_description": "Chimp Phobia will terrify you in the most scary spooky terrifying ways"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Offsale / Ben", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24560785416888019"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "250754850
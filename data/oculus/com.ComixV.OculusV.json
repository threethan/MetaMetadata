6\u30de\u30f3\u30ac\u3001\u30b3\u30df\u30c3\u30af\u30b9V\uff08ComixV\uff09\n\u30a6\u30a7\u30d6\u30de\u30f3\u30ac\u306e\u6709\u540d\u4f5c\u5bb6\u63cf\u304d\u4e0b\u308d\u3057\u306e\u3001\u307e\u3063\u305f\u304f\u65b0\u3057\u3044VR\u30a6\u30a7\u30d6\u30de\u30f3\u30ac\u3092\u4f53\u9a13\u3057\u3066\u307f\u3088\u3046\uff01\n \n* ComixV\u306e\u73fe\u5728\u306e\u4f5c\u54c1\u30ea\u30b9\u30c8\n- YK Yoon/ Noon Bora : \u30e9\u30d6\u30e2\u30ce\u30ec\u30fc\u30eb\n- Park SungYong : \u3073\u3053\u3046\n - Nanbin\uff1a\u305d\u306e\u77b3\u306b\u8f1d\u304f\u3082\u306e\u306f\n - \u30b8\u30e7\u30f3\u30fb\u30bd\u30af\u30db\uff1a\u767d\u864e\n - \u30ad\u30e0\u30fb\u30b8\u30a6\uff1a\u5b66\u5712\uff11\u4f4d\u6c7a\u5b9a\u6226\n - \u30cf\u30ea\u30f3\uff1a\u3068\u306a\u308a\u306e\u9b54\u6cd5\u4f7f\u3044\n - \u30e6\u30e9\uff1ayoura\n - Ji Gang Min\uff1a\u6765\u3044\uff01\u30b3\u30f3\u30d3\u30cbVR\n - Baik Sung Min\uff1a\u7b46\u904a\u3073\n - \u30c1\u30a7\u30fb\u30db\u30c1\u30e7\u30eb\uff1a\u5c0f\u8def\u6563\u7b56\n - \u305c\u306b\u3085\uff1a\u305c\u306b\u3085360\n - WhanJ\uff1a\u30aa\u30f3\u30fb\u30b6\u30fb\u30de\u30fc\u30ba\n\n* \u3053\u308c\u304b\u3089\u3082\u591a\u304f\u306e\u4f5c\u54c1\u304c\u6b21\u3005\u3068\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\uff01\n\u3055\u3089\u306b\u3001VR\u30a6\u30a7\u30d6\u30de\u30f3\u30ac\u3092\u81ea\u7531\u306b\u63cf\u3044\u3066\u914d\u5e03\u3059\u308b\u6a5f\u80fd\u3084\u3001\n\u30a4\u30e9\u30b9\u30c8\u3001\u52d5\u753b\u306a\u3069\u3001\u69d8\u3005\u306a2D\u30d9\u30fc\u30b9\u306eVR\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u4e2d\u5fc3\u306b\u62e1\u5f35\u3057\u3066\u3044\u304f\u3046\u4e88\u5b9a\u3067\u3059\u3002\n \n\u30a2\u30d7\u30ea\u306e\u3054\u5229\u7528\u306b\u3042\u305f\u308a\u3001\u6c17\u306b\u306a\u308b\u3068\u3053\u308d\u3084\u30c8\u30e9\u30d6\u30eb\u304c\u767a\u751f\u3057\u305f\u5834\u5408\u306b\u306f\u3001\nhelp@comixv.com\u3001\u3082\u3057\u304f\u306fhttp://facebook.com/comixv\u307e\u3067\u306b\u304a\u554f\u3044\u5408\u305b\u304f\u3060\u3055\u3044\u3002\n\u306
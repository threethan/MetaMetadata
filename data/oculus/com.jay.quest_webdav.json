", "id": "955327449667836", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391895_955327453001169_4021793165597410392_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0ezZ5vPej4Q7kNvwExcpO8&_nc_oc=AdqBi3wjgk00psN9tBM4vqXLuQ3ZYcvG11s_IZ-wFaky1ghibTZ4vSzNvqdh0YiiKjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5kk4Hz_xGpWMK-5yYoMn-qNjgy8nEFAFQ75d6NZnGKg&oe=6A99A3C3"}]}, "id": "1291724052330330", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1173008207807666", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392130_1173008211140999_362491003145368863_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K6WzU9ijFwQ7kNvwF9UkhY&_nc_oc=AdqU1GHBuZlEfaSaSUViztCZqdIIT50bzTrCwGmyU0_AkkKPNNZNAzYN77xMZBRsW3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIofU5y4Tt57jkdVNhtaQoovummlL2igLMAWCjyf_xkDQ&oe=6A999E90"}, {"file_name": "14.png", "id": "993999722828875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391892_993999726162208_5002436862853731200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkCRWSt8bVkQ7kNvwHqt_vl&_nc_oc=AdrlXCVjX1Xr-H_JkuRVxF5aDdXWyV8_klKLpawotkeCzBqCXrfZIyLjcNwjO4m-HuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI69rPNGdadmsPUNLNwJLcGblFxGY5_XuS6iFkcQX2aPg&oe=6A9980D9"}, {"file_name": "10.png", "id": "948827407399767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391959_948827410733100_1362349620727723926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wHberMV4q8Q7kNvwH4rkWq&_nc_oc=Adry46XS_42rnTlNAAqY0oQ71wbTMTAx5w-c34JipGeAPVttsqSQxy5uHEnW0o8Z3uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtOOXo0geBBoa9jpqmrTA_WqMoPBb23EhzSXVPIbrCPw&oe=6A9986AB"}, {"file_name": "6.png", "id": "951115556794142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392305_951115563460808_7479908943135039264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdpPledxjK0Q7kNvwGzN--D&_nc_oc=Adq8T0gTPzFOlw0AIUyCOGk9ejDbr-JXXJbFmkrNaEfLWxKUF3pfxwXmTra_sWj4kjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4zC990YqkaIEqrKzoHTTyHv4zSRHR--lrZtO62mYBVQ&oe=6A997EDD"}, {"file_name": "9.png", "id": "672080595156604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391880_672080598489937_5711139023445067151_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrqaivsonCkQ7kNvwGC6njm&_nc_oc=Adr7ONjs3EY30k1koT0_OnkAH8WxeKKintJgX0G-aNo2SrxZGxBvQTw7UOIrWf_PoDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWTKLYcnzDH5h5tZ6cGK7lmxxPWzz_JOsL_p6tUwF6Jw&oe=6A9972E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple File Server", "keywords": [], "long_description": "Tired of using USB cables to transfer files? Simple File Server for Quest lets you wirelessly manage and transfer files via a built-in HTTP server\u2014no extra apps needed!\n\n\ud83d\udd39 Key Features\n\n\u2705 Wireless File Transfer \u2013 Access Quest files from a PC or phone over WiFi.\n\n\u2705 No Extra Apps Needed \u2013 Just open the provided HTTP URL in a browser or supported software.\n\n\u2705 Secure Access \u2013 Protects files with a username & password.\n\n\u2705 Full Storage Access \u2013 Upload, download, and organize files effortlessly.\n\n\u26a1 Easy Setup\nStart the app and enable the HTTP server.\nConnect your PC or phone to the same WiFi network as your Quest.\nOpen the generated HTTP URL in a browser or supported software.\nLog in with your credentials and manage files instantly!\n\n\ud83d\udee1\ufe0f Privacy & Security\n\n\ud83d\udd12 No internet access needed \u2013 Works only on your local network.\n\n\ud83d\uded1 Runs only when activated \u2013 No background processes.\n\n\ud83d\ude80 Fast & easy \u2013 No complex setups or extra file managers.\n\nDitch the cables and enjoy truly wireless file management on your Oculus Quest! \ud83c\udfae", "short_description": "Managing files on your Quest has never been easier! No more USB cables or complicated transfers\u2014just start the server and access your files wirelessly from any device\u2019s web browser. Upload, rename, download, and organize your files effortlessly with a clean and intuitive interface. Whether you're moving game mods, managing media, or organizing documents, this app makes file handling simple and seamless. Fast, reliable, and hassle-free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/simple-file-server-privacy-policy/6c65190e-b9bf-49ba-a69b-98379d35e489/privacy", "developer_terms_of_service_url": null, "publisher_name": "Deviraj", "support_website_url": null, "website_url": "https://astraai.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24465217896431367"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396953_1419566932358529_3875154636947242614_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODGbgNr09bgQ7kNvwFfLV65&_nc_oc=AdpW5q3tkHfq9QB_DRDiWm-8Zh4d3rxlXr5u1-3DckwP0M8rOLDAV1-OyYSw_4ciYmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvmWKa7gtQj8pLUsxzrVEyLWR7BSEM1EiCNYgwl2NkuQ&oe=6A998874"}, "is_concept": false, "is_test": false, "is_trial_offer_valid"
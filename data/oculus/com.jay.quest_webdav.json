uluscdn.com/v/t64.5771-25/473391880_672080598489937_5711139023445067151_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrqaivsonCkQ7kNvwGC6njm&_nc_oc=Adr7ONjs3EY30k1koT0_OnkAH8WxeKKintJgX0G-aNo2SrxZGxBvQTw7UOIrWf_PoDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWTKLYcnzDH5h5tZ6cGK7lmxxPWzz_JOsL_p6tUwF6Jw&oe=6A9972E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple File Server", "keywords": [], "long_description": "Tired of using USB cables to transfer files? Simple File Server for Quest lets you wirelessly manage and transfer files via a built-in HTTP server\u2014no extra apps needed!\n\n\ud83d\udd39 Key Features\n\n\u2705 Wireless File Transfer \u2013 Access Quest files from a PC or phone over WiFi.\n\n\u2705 No Extra Apps Needed \u2013 Just open the provided WebDAV URL in a browser or supported software.\n\n\u2705 Secure Access \u2013 Protects files with a username & password.\n\n\u2705 Full Storage Access \u2013 Upload, download, and organize files effortlessly.\n\n\u26a1 Easy Setup\nStart the app and enable the HTTP server.\nConnect your PC or phone to the same WiFi network as your Quest.\nOpen the generated HTTP URL in a browser or supported software.\nLog in with your credentials and manage files instantly!\n\n\ud83d\udee1\ufe0f Privacy & Security\n\n\ud83d\udd12 No internet access needed \u2013 Works only on your local network.\n\n\ud83d\uded1 Runs only when activated \u2013 No background processes.\n\n\ud83d\ude80 Fast & easy \u2013 No complex setups or extra file managers.\n\nDitch the cables and enjoy truly wireless file management on your Oculus Quest! \ud83c\udfae", "short_description": "Managing files on your Quest has never been easier! No more USB cables or complicated transfers\u2014just start the server and access your files wirelessly from any device\u2019s web browser. Upload, rename, download, and organize your files effortlessly with a clean and intuitive interface. Whether you're moving game mods, managing media, or organizing documents, this app makes file handling simple and seamless. Fast, reliable, and hassle-free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/simple-file-server-privacy-policy/404f07b3-1f5b-4bc2-8953-14cd5c898205/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kalki Arts", "support_website_url": null, "website_url": "https://kalkiarts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}, {"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "TRACKED_KEYBOARD", "GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9344289898950747"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "4483783798434368"}, {"status": "PUBLISHED", "id": "1536374548099813"}, {"status": "PUBLISHED", "id": "904071259360970"}, {"status": "PUBLISHED", "id": "963330309358748"}, {"status": "PUBLISHED", "id": "1579892539937742"}, {"status": "PUBLISHED", "id": "2224794048016078"}, {"status": "PUBLISHED", "id": "1295428772129941"}, {"status": "PUBLISHED", "id": "24062013173467498"}, {"status": "PUBLISHED", "id": "1722375148417053"}, {"status": "PUBLISHED", "id": "977896934438988"}, {"status": "CANCELLED", "id": "1112689477485076"}, {"status": "CANCELLED", "id": "1820098522215637"}, {"status": "PUBLISHED", "id": "1842395523159386"}, {"status": "PUBLISHED", "id": "311701
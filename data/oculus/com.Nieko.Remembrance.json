le_name": "12.png", "id": "26778113288548783", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618896_26778113298548782_2248379806066760800_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0wpUfl7C_wQ7kNvwFDaLSn&_nc_oc=AdprRxEDxRYjoM1SekZwGsGodmi_rv8_IpMbBWSFDrqvHnx99_2I0kCD_6faG3W6g7c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBP0rlKQ-rocIlIXPHwNDBXb80YQe7WwAHbiW3JJWZmw&oe=6A973607"}, {"file_name": "7.png", "id": "857978200672533", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491818885_857978204005866_2796147374153145821_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BdsXD7TEa4Q7kNvwE-779G&_nc_oc=AdraIba6jOProHbu9jeYOFBf8XAPaL4ZcU51ExYZGEzSaU6ZJYxTacqYnTMma1N75EQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEorS7FcJBOUhKzHn7GZDAFLtXWe_Qt656HHt-53WHAlw&oe=6A9742A9"}, {"file_name": "11.png", "id": "5464232193802328", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499623131_5464232197135661_3253032402275909037_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk7DKcGldP8Q7kNvwHbhR9t&_nc_oc=AdoKOrHpRHow66LyzBLmGSfUne1aoOtG6E3yAdOoaaIelBDUUDm2CF-hhBYSkfG-tYc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYcNHoM1WX_XyUC3TsOqT_aYfs6xC14GD6_vNUNPqrqQ&oe=6A972598"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Remembrance_landscape_cover_meta_2560x1440 (1).png", "id": "1717600335937677", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823949_1717600342604343_3370663257819765511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWeCGxLNg4kQ7kNvwGeGQCe&_nc_oc=Adqq5IIdI6Q-DKjKu_28725NnqtoRRNEdQr489-eny-zHoslQSmc7gbnGSFaoe0b96U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo6iOW3WmMeQl79eV6TbRmzbeDOzW2Mhp8-vbVRTozBQ&oe=6A972936"}, "display_name": "Remembrance", "keywords": ["puzzle", "adventure", "fantasy", "narrative"], "long_description": "# Unravel a Mind in Crisis. Chapter One.\nRemembrance invites you to dive deep into the fractured memories of Professor Isaac Nemeth, a brilliant but broken scientist whose work may hold the key to humanity's survival. Guiding Dr. Bell, a psychologist, you'll navigate surreal landscapes, solve intricate puzzles, and uncover haunting truths buried in his subconscious.\n\nThis is Chapter One of the Remembrance saga.\n# A World of Mystery and Emotion\nExplore a series of richly detailed, dreamlike environments that represent the professor\u2019s most pivotal and painful moments. From a star-filled childhood bedroom holding the promise of a bright future to the chaos of his shattered laboratory and a broken life, every memory offers a glimpse into the choices that shaped the man and the secrets he\u2019s desperate to hide.\n# Key Features: \n- **Immersive VR Gameplay**: Experience the game\u2019s intricate world and emotionally charged story from a fully immersive, first-person perspective.\n- **Thought-Provoking Puzzles**: Solve mind-bending challenges that mirror the professor\u2019s fragmented psyche.\n- **Emotional Narrative**: Dive into a deeply human story of ambition, loss, and redemption.\n- **Richly Crafted Worlds**: Traverse environments that blend memory, emotion, and a lifetime of regret.\n- **~1\u20131.5 Hours of Story:** A focused first chapter into Isaac's fractured mind.\n# What Truths Will You Uncover First?\nRemembrance is more than a game \u2014 it's a journey through the depths of memory, morality, and hope. Chapter One is where it begins.\n{997666959512873}", "short_description": "Chapter One of a mind-bending VR narrative puzzle saga. Step into the fractured mind of a dying scientist in Remembrance. Piece together broken memories, uncover devastating truths, and take the first steps toward a mystery that reaches far beyond one man's mind."}]}, "developer_name": "NIEKO", "developer_privacy_policy_url": "https://niekoplay.com/privacy-policy-remembrance/", "developer_terms_of_service_url": null, "publisher_name": "NIEKO", "support_website_url": null, "website_url": "https://niekoplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37153963114248075"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491828038_1516154333351953_975929964084264152_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNx42wSPAB4Q7kNvwGLLWuT&_nc_oc=Adp96BDeTNIoA_JtexmRPUlyvBej--iRD542Isi6GQY4NmVeA1O2nztQVx0LET0NqEI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElXktW2YYK82UTXDE61o-l2LMYnH8CdqUoj8TVI-tvPA&oe=6A972AF4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Remembrance", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1785308580, "lastRevision": {"nodes": [{"id": "35238482932462779", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "35238482839129455", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_ce
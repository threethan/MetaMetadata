0f&oh=00_AQQzDvaIw11lVd9a4PeclyDBrmXyNysZIwRO84zs8najRg&oe=6B01D3E9"}, {"file_name": "11.png", "id": "5464232193802328", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_5464232197135661_3253032402275909037_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=183ah7IubTAQ7kNvwG28cPE&_nc_oc=Adr1y7loA0LdIgeSD0taH2b32PCb0bzJd7OFISuqokCvZaUrkplHVvh1wSzqUFXI0Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMiAV2Fukrn0bLQoNaYyN7tjvmbaEXSTEF9Dq4J-Xx_g&oe=6B01B6D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Remembrance_landscape_cover_meta_2560x1440 (1).png", "id": "1717600335937677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_1717600342604343_3370663257819765511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68lwxDLKraUQ7kNvwEvEtB6&_nc_oc=AdqU-tQTIEpbDoxGhPvMvOVsISh0iD7Xg1F_i3a_gKD9Z8kAi-UshGWHI-JIn5BKT0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYGmBkEzjIbhvfHnzPxHN5SWnWKV4QzJ4WH3aWeTL5YQ&oe=6B01BA76"}, "display_name": "Remembrance", "keywords": ["puzzle", "adventure", "fantasy", "narrative"], "long_description": "#  Unravel a Mind in Crisis. Save a World in Peril.\nRemembrance invites you to dive deep into the fractured memories of Professor Isaac Nemeth, a brilliant but broken scientist whose revolutionary work holds the key to humanity\u2019s survival. Guiding Dr. Bell, a renowned psychologist, you\u2019ll navigate surreal landscapes, solve intricate puzzles, and uncover the haunting truths buried in his subconscious.\n# A World of Mystery and Emotion\nExplore a series of richly detailed, dreamlike environments that represent the professor\u2019s most pivotal and painful moments. From a star-filled childhood bedroom holding the promise of a bright future to the chaos of his shattered laboratory and a broken life, every memory offers a glimpse into the choices that shaped the man and the secrets he\u2019s desperate to hide.\n# Key Features: \n- **Immersive VR Gameplay**: Experience the game\u2019s intricate world and emotionally charged story from a fully immersive, first-person perspective.\n- **Thought-Provoking Puzzles**: Solve mind-bending challenges that mirror the professor\u2019s fragmented psyche.\n- **Emotional Narrative**: Dive into a deeply human story of ambition, loss, and redemption.\n- **Richly Crafted Worlds**: Traverse environments that blend memory, emotion, and a lifetime of regret.\n# Will You Be the Key to Humanity\u2019s Salvation? \nRemembrance is more than a game, it\u2019s a journey through the depths of memory, morality, and hope.\n{997666959512873}", "short_description": "Step into the fractured mind of a dying scientist in Remembrance, a mind-bending VR puzzle adventure. Piece together broken memories, uncover devastating truths, and decide the fate of a world teetering on the edge of collapse. Will you save humanity?"}]}, "developer_name": "NIEKO", "developer_privacy_policy_url": "https://niekoplay.com/privacy-policy-remembrance/", "developer_terms_of_service_url": null, "publisher_name": "NIEKO", "support_website_url": null, "website_url": "https://niekoplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35238482889129450"}}]}, "scheduled_offers": {"count": 2, "nodes"
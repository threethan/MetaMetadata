ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1717600342604343_3370663257819765511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKs6Y9gSd7EQ7kNvwFWeNtC&_nc_oc=AdqG8Y669YkVyYkwxbDaX82CRkGXhh6H0aKvigTWnmXlqmD5nvlM_XXEefKirBaS2uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwAne8QYPgJ3C_anI3kjSYEG24JB9vhE9K501w9GfdfQ&oe=6AC120F6"}, "display_name": "Remembrance", "keywords": ["puzzle", "adventure", "fantasy", "narrative"], "long_description": "#  Unravel a Mind in Crisis. Save a World in Peril.\nRemembrance invites you to dive deep into the fractured memories of Professor Isaac Nemeth, a brilliant but broken scientist whose revolutionary work holds the key to humanity\u2019s survival. Guiding Dr. Bell, a renowned psychologist, you\u2019ll navigate surreal landscapes, solve intricate puzzles, and uncover the haunting truths buried in his subconscious.\n# A World of Mystery and Emotion\nExplore a series of richly detailed, dreamlike environments that represent the professor\u2019s most pivotal and painful moments. From a star-filled childhood bedroom holding the promise of a bright future to the chaos of his shattered laboratory and a broken life, every memory offers a glimpse into the choices that shaped the man and the secrets he\u2019s desperate to hide.\n# Key Features: \n- **Immersive VR Gameplay**: Experience the game\u2019s intricate world and emotionally charged story from a fully immersive, first-person perspective.\n- **Thought-Provoking Puzzles**: Solve mind-bending challenges that mirror the professor\u2019s fragmented psyche.\n- **Emotional Narrative**: Dive into a deeply human story of ambition, loss, and redemption.\n- **Richly Crafted Worlds**: Traverse environments that blend memory, emotion, and a lifetime of regret.\n# Will You Be the Key to Humanity\u2019s Salvation? \nRemembrance is more than a game, it\u2019s a journey through the depths of memory, morality, and hope.\n{997666959512873}", "short_description": "Step into the fractured mind of a dying scientist in Remembrance, a mind-bending VR puzzle adventure. Piece together broken memories, uncover devastating truths, and decide the fate of a world teetering on the edge of collapse. Will you save humanity?"}]}, "developer_name": "NIEKO", "developer_privacy_policy_url": "https://niekoplay.com/privacy-policy-remembrance/", "developer_terms_of_service_url": null, "publisher_name": "NIEKO", "support_website_url": null, "website_url": "https://niekoplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35238482889129450"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2116685082396040"}, {"status": "PUBLISHED", "id": "1224330749582463"}]}, "baseline_offer": {"id": "2116685082396040"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786702380, "status": "PUBLISHED", "id": "2116685082396040"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37023823427262045", "version": "0.4.1"}, "id": "949878741295522", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3523848283
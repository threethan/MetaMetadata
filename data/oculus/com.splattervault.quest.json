262388710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNutbPndIUIQ7kNvwEU7o42&_nc_oc=Adr322bphkROEeX0UZgYpvPYj_f4f9JxUJjSOYgrcCcmF1_NIFUEKQyxQRVP24fg-f0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Lil2ANj5dcueoGdLgfNl4W9ooqP4S1icUk_ZgASkwg&oe=6AEB4EF6"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bl5hfqUuG8Q7kNvwHB2w3f&_nc_oc=AdoJWiGFfx70A3vqM6lQrHYTCen9Ae2lrsfeA9KVP1W5jFWI5GxFspxw8DSvHBD7T_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXNwyTwfUCL8DDhU2x8tyZIv6Wr8SvxUgxsRVPTQo7nQ&oe=6AEB4DDD"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjCKTTmh02gQ7kNvwHvPZdw&_nc_oc=AdoNP3VV-5CFMoPhhfYZp_ySELYQ2gJEIs_966CJ5co268dV-nHowbkjnv_ib0BsGAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9nEiPQ9YC_2CFMFdg5Xm_DyEbew5xcdrg_qiHXzTKFg&oe=6AEB48F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26920859790940686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298790_996359659447497_7859886029628891609_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxN0ERZnP94Q7kNvwE3mgdI&_nc_oc=Adr57zmQ6fmgbVYJv0Ey_pnDmktAEF9LOl2-PCVMx0h5-9wc6y84yb5Gz5hYvNzbt4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSemDX10yM
832389014755_4269405188876757729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uastt0rAKhwQ7kNvwFR4JS2&_nc_oc=AdqgffGkr3gTLdAvdy8s9nV82znKczu9_Pssoy9jSUTp8vaKDu3cnw6r-fPN4Rdq53A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFElvoLHHXUbdw5eE0y-EDafMbYRjgJDdZZXqVv_PL0w&oe=6A7B376C"}, {"file_name": "splattervault_screenshot_01_2560x1440.png", "id": "2162291197879158", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305050_2162291201212491_5914393149013059166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR2S9pp7Ol8Q7kNvwGi2SMN&_nc_oc=Adr1eYd-FRMBmZc25JVKuHD7-pUTZO9Dw7rEIcOdajrks1nNNmMF36UmVMOfPjlXmIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEC3b9Z4vdBV8ThWR_0MXwKHCx0YYk3om60jiiO6xV8w&oe=6A7B23BC"}, {"file_name": "splattervault_screenshot_04_2560x1440.png", "id": "1364650262388710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtMb0M7OaW4Q7kNvwH4OmXF&_nc_oc=AdoDdsatvec62eZx2-lrrcvDQmnm4mpC9batreaex4OTXsaGcwtFnWasGZgYxeSRG-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmmv7eIufwzQbXcE4wSdiL1Fn0dVcu99N4Raan8_-auw&oe=6A7B0736"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBiynP3X5GkQ7kNvwFBs8hE&_nc_oc=AdpKf7EdSAMafaUu1KnZdXJ9gKTT1RxS0cczITv3kWGGIpZHTf0AongK29og_YrZe30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmIK6JAEnn_jm1MSQF08fkTSX5dpmQ69y3SzlskC3ITw&oe=6A7B061D"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBH87haB8LMQ7kNvwEIAyn5&_nc_oc=AdoQJ_EfejMZNnRunJVBYwvMQBbQtv5oEfzcfdxZRw6PDWwVGO6lMio7iXwv-ZHfgFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnHNkndrXWyDp_YL2cXRSxRNr-rLGEGll6_vn-LpDAZg&oe=6A7B0134"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
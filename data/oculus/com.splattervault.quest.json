262388710", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl5YmeyyJj4Q7kNvwHkXUJL&_nc_oc=AdpfCkA0I8Tgk7UKrM6UE8DbAM3NgMbdRIh_zG4XopWPxXwqFZmrSqwYwmJMz4W8cUc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbB9mpnndZlwKegRFk-4EyZwIPDvtpKPfHWnSosYVCCw&oe=6A74A7F6"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kh_2gDPUC9IQ7kNvwGMlYf7&_nc_oc=AdrGdlGMnbiuDVaFY28SKEjJvkOqFwySCwM9qiUyQhvKPRU8N2tpDqwakznVJsU23W8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErvvwdOZm4CnnfJn2iG8mFrdDD0ss-WSUT6FMTxiU3Hw&oe=6A74A6DD"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2d2d53e4zFoQ7kNvwGE1o2d&_nc_oc=AdqmRACi6PrfyGdgeV1MFIkqItWoV9kPWX367nobxlfVKqkO3LyoI3_ry3UJJuge2z0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGssdqOIJAf8cLqlKWi1suFHgOidF4heBSuIHUxvT4KnA&oe=6A74A1F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26920859790940686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298790_996359659447497_7859886029628891609_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MDotpY69hQQ7kNvwE_5yRW&_nc_oc=AdriP5Mrifq9oWz3GhqEMlwgXVU5jnsFutZi31NsEDsS5Vf9Ud9CS5Lnr9dltFTiSuM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJzlloPw2
262388710", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_rWcb7kKPkQ7kNvwFzYy6S&_nc_oc=AdomZX-aw1-gS_1ScC3RHoqdWEvK8X4BjHzHka4Q1EVdoyrwoP-day1QQ04y1K7HcWs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af969hRCII7L1L6vAEh7d8rPLPCFXxmgq-VXX8-pBxgBDA&oe=6A2C2576"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDgTUPSruFgQ7kNvwEUQ49V&_nc_oc=AdphhPHmbsLo2uoZ5osW-B9D6tXlo5L40JMgP6XTExd8WrLQBR_S5y-QAScl-30FbuY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vkxfGbA6u-IwLh-94d4unKqhfaTpDFMbqtyNJxvuP7Q&oe=6A2C245D"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylaRYP27kAIQ7kNvwGfkRpI&_nc_oc=AdrxZMPbBqK96G9y5EK06GEEOD2L5LpbQnEW_GTf1kOWQdqiblHvHbNzvB9EOjc7h7I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QERHG3M7OcNTpD-wnRIIVFfLnBeJV6ZkPD_FbLuVm7g&oe=6A2C1F74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26920859790940686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298790_996359659447497_7859886029628891609_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6Tiq_YHLAoQ7kNvwELFi-g&_nc_oc=AdpmX0lDpOMeZjVdQ4ZPF5cxr0qaKC6KL8VyL3VbQ9Ha9ZKI3aPgWaLa2fGhcl6Je2Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sOiGAEX-
832389014755_4269405188876757729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIJfnamLkbAQ7kNvwGVj0l7&_nc_oc=AdrJFZNHRtDVw8vLC_J-B0B48AGFrIQFCNwlhw82inDK9QFOTc7hy4CIJYpbdpzIhu8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoaFfmzW5xbfJLAt5uCFagJHxSpv7DOXmKoCpfhUSUNA&oe=6AE35DEC"}, {"file_name": "splattervault_screenshot_01_2560x1440.png", "id": "2162291197879158", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499305050_2162291201212491_5914393149013059166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0e6faDD8TMQ7kNvwGknHNr&_nc_oc=AdpoxZHScYmqtfpd0UP_0ifrX8D3o0Qi3N6SpxollPeCM-UO0VPZRruYLiCsy3TJUVI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKepl5nN8DasWN8UV4jG8pY5RVI4PqOIoBj7AfRmy4uA&oe=6AE34A3C"}, {"file_name": "splattervault_screenshot_04_2560x1440.png", "id": "1364650262388710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fedkGNIQZn4Q7kNvwHtLR69&_nc_oc=AdqDF9YXgVuqol8ZvHSJZ_87EGM2LFeaMj3jGivvnleBIiNbkH65bAkH6KupxefPeRo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0aAWK-VxoiUPWkTRpky_rw5WHuHlgHXl4RSVehQF4Cg&oe=6AE365F6"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLgd2bARj1sQ7kNvwGkhyPn&_nc_oc=AdqTHvmp_ZqQZcLwiLvvpgUoo7t0dCO2O4MMXxIlfdcmp5WcWsDOmZtRnuUklEqlcOg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiqLi-MBrdB49bES6wxChTcaoWtYgiGZt9Grl72ZUGlA&oe=6AE364DD"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGgn_ybFuogQ7kNvwHsZgzS&_nc_oc=AdpoHLpjm1SKQ0WpEdZrtDUh2wDYfZuhZ7Svlz7M5Zqx8G7gKfq5OMt9gwG5EMrLHjU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsSXmJl9q7EgnBwDTlxaLqHrmyHDS6wfnyxFMJjhE_CQ&oe=6AE35FF4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
262388710", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-bWoaDKxSsQ7kNvwFgVWhT&_nc_oc=AdpAUiGRYdwI2m_3dT5QJplP40Vd9PEbklok5HcnsupJfYuIldy9ahHzwP71FeQ8WwI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lPYdEIWqJl5-JV-h8lPClMwsP8-0hMJAD5mo4CHIpAg&oe=6A170D76"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08HBgZb0wSYQ7kNvwGKACd2&_nc_oc=Adp-DmB33dxfdph0juomax5OmumWlHh0-FvbTQgM1m8VptB7RnxODd4pIzTg8qvTILg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5us0y1CpL44bCD-tguYhhjmbe72Fdf9kRQn-cY1T19Dw&oe=6A170C5D"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi9s_W2WeukQ7kNvwEUHZ1J&_nc_oc=AdqYx07AWa471jIxvhyetfHiB8iFGzyrXe-B_1PtTOa44MsHJ5wLcuJ-D8jpJo60MN4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66GlRy7yvEeagcMztyaFg32q2zvb0XpjqsB2wYNdv4bg&oe=6A170774"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26920859790940686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298790_996359659447497_7859886029628891609_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiKm9jwozg0Q7kNvwGjrJRw&_nc_oc=AdqLVr1gggEX5Uvw-jATuwoC8oVfr3x3ES8aXtZkiKt9OrPhXNl1gXsquCL34xMUs7I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r8Ec740o
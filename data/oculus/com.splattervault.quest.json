832389014755_4269405188876757729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbW1eSrGiFUQ7kNvwGb79B2&_nc_oc=AdoSuFwEW0V1HVvQNJbGTij4SIgblC_IPc0a208cLMjpaIsaV5P__bJO_DeKpzJ5uAQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuvAfhJuCgJbE4HzaODt2Aqgi8RWxQc7hTUIT8f_BDyA&oe=6A80452C"}, {"file_name": "splattervault_screenshot_01_2560x1440.png", "id": "2162291197879158", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305050_2162291201212491_5914393149013059166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_R-_gw4PncsQ7kNvwGGpEeO&_nc_oc=Adq7W7eKqzthJ_PeWysVzfOkdz6shc_d3vLi5BAgt78oYlylwX_6_oY9RzCwyZZm4Rk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHstE8VAkmw_zrQM9KMuxby_jjOrsKFJG0rpKKTP_d7BQ&oe=6A8069BC"}, {"file_name": "splattervault_screenshot_04_2560x1440.png", "id": "1364650262388710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJl3TVZ1aH4Q7kNvwFJaIWc&_nc_oc=AdrHSnzt2g9_itUeEIbFtEv4DNBK-2QpRfrbRw177bN5MjhDkEL4mTsYBllIbk5hHBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPu64M03sw4LoMh0XTgoxNbnj0O0osJOIaf0IlJFXRGA&oe=6A804D36"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdxtm6VpQfQQ7kNvwGduDon&_nc_oc=Adq4e3P6hErjOoB-Qlqnu5PBZqt1Ya41b2wkf3PNW9AC-ESyIglDg9mzTcFkmxUVKjE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR384Dp-KXWNgnQfwhZ_5beWiJuGGFAhxymBfQwAlOdg&oe=6A804C1D"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIl2fguk_mgQ7kNvwErB4mq&_nc_oc=Adr7ipq7IzvFDzwzsfVWEspCJyEOy_TImKW5BWGjxMKTt8YC8SpjGe-2_J1XlAnMQnY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8t05r9361b3sgeTeVOR3SEpPiZTIpDdaAVP-sZEwBfw&oe=6A804734"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
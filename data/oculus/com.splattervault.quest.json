262388710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_rWcb7kKPkQ7kNvwGU7G7e&_nc_oc=AdpejzXyMuC-8XDtuEgkIDaA96-2xIykgeD9nSTxdSqZS4J1B_5vIpfUSTPr4Wf1pNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GdEtTxO5M6YbItiRuut9hCIpOtbcNCky7yck_nuQ19A&oe=6A298276"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwr1zOv-LV8Q7kNvwGhyYc7&_nc_oc=AdoSlfAfDf58MKk2MdKDaY1hmTrBX04J8qUxnsFLCN3-MDfS463s_t9fPtw9LwlRE3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8KZ9nC5hsC2yFu9yt-MG5WvqCcAb0-oSz41j7xUEgBQ&oe=6A29815D"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjHSryWJDbMQ7kNvwFql25S&_nc_oc=AdqGCnzr-nYGaqKTPOewvOJDMx4c87vkzQPDR0i4T70AnR3IJ8P60pRaIa_X-2CuMFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ViNIeYEiYpJ4KOxJp-5hwLvMKuzFQRt6k3utCNca2Kg&oe=6A297C74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26920859790940686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298790_996359659447497_7859886029628891609_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc_r_1cEyL8Q7kNvwFG0fp-&_nc_oc=Ado7nxnWQsiDHv_jEsHIZ6t8QYxj44xLcbTxP3MpTxvpLMeTa4K7Ar04UkoefqSK30E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i8VxmgX_
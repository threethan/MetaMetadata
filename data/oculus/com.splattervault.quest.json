832389014755_4269405188876757729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dRBuXCGaHsQ7kNvwHuLz63&_nc_oc=AdrpHK5qwf3Gdkne64hg5fALI9AYqiRF5u9O7Rke_2hpnOAmtnbI6WbxBZbB2mPElss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXO2pbZz-4Qs8snnOe04-PA7tcSopXOpovbJuiCp3xug&oe=6A5E366C"}, {"file_name": "splattervault_screenshot_01_2560x1440.png", "id": "2162291197879158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_2162291201212491_5914393149013059166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq0_vqiCxRcQ7kNvwFQlNTI&_nc_oc=AdqJLBiljKMRxeEnk4hnO50t7CXKv_X7q61ZwyDbpESen7DdfwWW1z-MmCtT3KtI8j4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9oAXUoG1srpzEBvRq-aMlLPo-u0xW2nfAQCituoKNEQ&oe=6A5E22BC"}, {"file_name": "splattervault_screenshot_04_2560x1440.png", "id": "1364650262388710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7uAKMKr3e8Q7kNvwF7QfJB&_nc_oc=AdoS4SBRJuu0x2SfgEzChOMeT1zxpWEjXwO4hYY0XriP55RIlpITKIxoMLlwhc5DG9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBklpWAMGRwjbtXGFIZ5Iy5XS25Qf2rXgnC2NSeaE9Y2A&oe=6A5E0636"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcm8dEO_rhcQ7kNvwE5NG7a&_nc_oc=AdqPac6fH40sshZ_UVTMDRK7Nvy_ALqrsA3hlv5CQ-jXQoHh1A0iCqzPfcln42ftPuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDme14ZporUhnzeTTQJjNKZdGanOOKdF4UoJRSREp6ydQ&oe=6A5E051D"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTwnPM3nllAQ7kNvwEhWvtj&_nc_oc=AdrFv3J18R3Ne8zmJqzqFuvKObKnvX7-K1UjDYcz33BwgTK6y9-IGlbw1suBu0J3uxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_C2vUUvAeRQKWPxVy8G-4H-8M6SwalCXchARqkrnDBg&oe=6A5E3874"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
832389014755_4269405188876757729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHSG_9-4IzoQ7kNvwGZRK7C&_nc_oc=AdrlGpINVzxw3UIXZTf1Tzrx4f0kN2Bgs0NBcpdYp2ep-kqXIvj9nRNQzeLFXqo40hE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dqpDrIpvNMalc85AZ6ATDKlr5WbWyFDd5yfi5qmX7Tw&oe=6A2EC06C"}, {"file_name": "splattervault_screenshot_01_2560x1440.png", "id": "2162291197879158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_2162291201212491_5914393149013059166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dcojRRGOx4Q7kNvwEo1SPQ&_nc_oc=AdoAl79aKFploU0AQdmnC0kTQ6fIusMpqJW7EQq8Y4mJD48K6jAWxTMpQ8hhFfinoG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ehyc1SlnhlC1Ur_03iuRNv0SDcNrel5i8IlO7cEdhkA&oe=6A2EACBC"}, {"file_name": "splattervault_screenshot_04_2560x1440.png", "id": "1364650262388710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qf28NQyB7UQ7kNvwEMm_ow&_nc_oc=AdrKucI7FCDmSgOD8U4U6xenQO-OtpBKXJjIBNwtXdbO-AhV4b_ZgF3C_FVqjQ7DV4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gN0vw1F3GCEl8DWB2jt32aPesg5Eqd02Jmed5tV5l-A&oe=6A2EC876"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDgTUPSruFgQ7kNvwE0hNMZ&_nc_oc=AdrvypiEw6Al45KM6IEV9N5Rp9rBT19jSrEaPKBVoxa6PNLW8jgG5SE3VnSStP_DxpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mqgrSD6i1g58QMHb4-zYpD1ZQ_egpELlZvrFZCKgz9g&oe=6A2EC75D"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBhWsII4ZM4Q7kNvwFIkIwg&_nc_oc=AdqSwv2KQwUPuxWHsW9R7551hzfKh0x5Np6yypWMaeZQLc9sBS2d-WmYMOp60xPsrTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C45ILVYQsNCz2SthLVcU7UAEiw_OoJpl4MfOF5763hg&oe=6A2EC274"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
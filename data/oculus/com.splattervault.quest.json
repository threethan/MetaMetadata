832389014755_4269405188876757729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlWOlb4a_YEQ7kNvwFIGWl2&_nc_oc=AdpYIFALDyeJ7KhLv7JpWR4b9xkd2hcT4KxVLKKdA0Rka0DNn-F2thvcT7m8dPVUvcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5zbyyAXVZlr2Po5OeN8_4SNSbB_D6Tn0Byj0_1OwLcA&oe=6A86DCAC"}, {"file_name": "splattervault_screenshot_01_2560x1440.png", "id": "2162291197879158", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499305050_2162291201212491_5914393149013059166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dys1vSVoBVMQ7kNvwGyZsb8&_nc_oc=AdogpA0qRy6I7G33MPUflw9OwFZhTAgrG-HPd-4cZA6oYTdlff5wOl_IsAJrdBy0opw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI9IzxZQKzq12DSLw2W0rofbgmbpqGXumS-AeYlA8Yow&oe=6A87013C"}, {"file_name": "splattervault_screenshot_04_2560x1440.png", "id": "1364650262388710", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHcA-nWaHxEQ7kNvwFoJ874&_nc_oc=AdrJI3yeWZRdo4QZjcHfMloL9Tf1WJwJFD60PZVjAqr9A05yahS03Ql1hpWrEHfFIG8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI9NYQ1elCZqUAHchdMNr8fRxbLj347KkXgfgq4dGe1g&oe=6A86E4B6"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvkp6zcdLskQ7kNvwGZgSN_&_nc_oc=AdpbRGSDt0S2IFD41ljgC4anH_1jJqRguPZmPuIU9l7BG2ogruGMFZYAbpB2vNtZ1Hg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe30YP252EUyuachrb3vpLlcosh-EJiu_AS7O53lWLaA&oe=6A86E39D"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XxfpwYll4kQ7kNvwE8GJXN&_nc_oc=AdqYVfEcDKljLaImhmHQ00YnMMwyR0_oXSSDvCeFWj4Cpdz1rum4wPGbLFub19E1HG0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPtrpHp7oTg6h4vlDO2E5AinGNFqG9uXF56U1PWDICSA&oe=6A86DEB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
832389014755_4269405188876757729_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsBTnX76bEAQ7kNvwHOhZkT&_nc_oc=AdoI6tL1dilJjXcYokpLKp8iKDDfmPe2d2PRkLWxQFudHN1qI9AKh3dOifiOA-xRYFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyJS4M92NqdUooExXVEDPk_SIVRt6uruxR-3kmSvTJew&oe=6A4FB5EC"}, {"file_name": "splattervault_screenshot_01_2560x1440.png", "id": "2162291197879158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_2162291201212491_5914393149013059166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5heLoPF-eIQ7kNvwHMSphU&_nc_oc=AdrzOS5Pb18QGiJV_gIVwu62VEllO3_iolFYGa-sosuppJPK8GBtftA28yJTgobaaIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1BizA_SAkXkkXc0pkHDKja6aDFeObtkfrdE-nMK7Y6g&oe=6A4FA23C"}, {"file_name": "splattervault_screenshot_04_2560x1440.png", "id": "1364650262388710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303391_1364650265722043_1654794426330502342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2tvJeJBknUQ7kNvwFSgEHv&_nc_oc=AdrrM2svTVLS51cQYFKABE6MDur1yIEbmR64FHnOANeqyI_TODZoqyhmTEt8aza4rzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVfAamHGViKeRaYCQTtnyulk-a8C2dO7r5XjL1au0Fgg&oe=6A4FBDF6"}, {"file_name": "splattervault_screenshot_02_2560x1440.png", "id": "4344725972445771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308204_4344725975779104_7420391808958265444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yT58iwjne4MQ7kNvwGVevhB&_nc_oc=AdoFxfVVC7LgHEJ-Qv-6SZnQGZKG7ct7a0UVxnc7a0Xtl_liFlAR1Lh2eC602zLo4Qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqx0S5_9YeKG1fkwoOo7VaEumhFOWHNrVaY7vHa8VwEA&oe=6A4FBCDD"}, {"file_name": "splattervault_screenshot_03_2560x1440.png", "id": "1536187988180738", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307954_1536187991514071_8763602562002398962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHak2R-NMHoQ7kNvwGlhjrn&_nc_oc=AdoGF_0_D-eqDkrIa8lwHn_yldq6T9EOE9kTzFlakO8d88aIy6rnDYQ8j3pE_6PesOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClEDHIb2kpHaY_Je2NqOcLbd_9CqgWA4NCwohN-7CKzw&oe=6A4FB7F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SplatterVault", "keywords": ["splattervault", "dedicated", "server"], "long_description": "**Your SplatterVault command center, built for Quest.**\n\nSplatterVault is a companion app that gives you full control over your on-demand dedicated game servers without leaving VR. Designed for Seamless Multitasking, it runs as a 2D panel alongside your favorite VR games.\n\n**Features:**\n- Launch and manage dedicated game servers in seconds\n- Track your credit balance and session usage in real time\n- Coordinate with your team \u2014 view rosters, matchups, scrims, and practices\n- Browse and configure games from the full SplatterVault catalog\n- Switch between personal and organization accounts\n- Share active sessions with teammates via invite links\n\n**Built for VR players, by VR players.**\nSplatterVault powers on-demand dedicated servers for competitive and casual VR gaming. This companion app keeps you connected to your servers and team while you play.\n\nRequires a SplatterVault account at splattervault.com.", "short_description": "Manage your SplatterVault game servers directly from Quest. Launch sessions, track credits, coordinate with your team, and monitor matchups \u2014 all without leaving VR."}]}, "developer_name": "VYRX", "developer_privacy_policy_url": "https://splattervault.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VYRX", "support_website_url": "https://splattervault.com/faq", "website_url": "https://splattervault.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
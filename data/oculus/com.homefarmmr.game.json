22988511_4853970029240715366_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qo482siKOZUQ7kNvwGdzamH&_nc_oc=Adp11OeI--4AzpoThtAF4usk2yB38IVF2feB34cmq6BR5iF0ODm7FLh7UD0CI8knz7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9iuUhqK8D2HgiURoiBnkRoctluaEGIChfZtZBR16rYw&oe=6AFC6A25"}, "display_name": "Home Farm", "keywords": ["farming", "factory", "multiplayer", "simulation", "cozy"], "long_description": "Your room is the farm.\n\nHOME FARM is a cozy mixed reality farming and factory game for Meta Quest. Place your chest, build fields right on your floor and watch wheat, corn, peas, potatoes and beetroot grow in your real room.\n\nFARM WITH YOUR HANDS\nSwing a scythe, pull root crops by hand, break rocks with a pickaxe and crank water from your own well to make your fields grow faster.\n\nDEFEND YOUR HARVEST\nSneaky gnomes steal your crops and snails munch your lettuce. Catch them, trap them \u2013 or sell a gnome as a pet!\n\nFROM FIELD TO FACTORY\nDraw conveyor belts across your floor, smelt ore in the furnace, make bioplastic in the lab, 3D-print casings and build motors and robots.\n\nSELL TO CUSTOMERS\nCustomers walk right into your room. Serve them at the register, earn coins, level up and unlock new crops, machines and greenhouses.\n\nMULTIPLAYER IN YOUR OWN ROOM\nPlay together with a friend in the same room and build one farm side by side.\n\n\u2022 True mixed reality \u2013 your room becomes the game board\n\u2022 Local multiplayer in the same room\n\u2022 Comfort mode: everything at table height\n\u2022 11 languages \u00b7 3 save slots", "short_description": "Turn your real room into a farm! Plant crops on your floor, harvest with a scythe, crank water from a well, build conveyor belts and machines, and sell to customers who walk right into your room. Mixed reality farming \u2013 alone or together with a friend in the same room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSYJmOXSMNbDCU9gZH-NilQAS-HfPOfTxDINnPJMY4J1-9DFz9EXfsQX1IQBA_YAhVW5bolcesXPomg/pub", "developer_terms_of_service_url": null, "publisher_name": "Twilight Reality", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vSYJmOXSMNbDCU9gZH-NilQAS-HfPOfTxDINnPJMY4J1-9DFz9EXfsQX1IQBA_YAhVW5bolcesXPomg/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "pl", "tr", "ru", "ja", "es", "pt_BR", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1706314729224457"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2096915754548857"}]}, "baseline_offer": {"id": "2096915754548857"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793372400, "status": "PUBLISHED", "id": "2096915754548857"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1700522473137016", "version": "0.1.1"}, "id": "1672984947881442", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1682285688294028", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1700522473137016"}, "release_status
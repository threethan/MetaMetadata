2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyl7RH7Q44rJ0A7nxjVmLzUemkQfMmwg0Kf4qFZDGOgVQ&oe=69C685D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqEA2gPI7HYQ7kNvwGm77xT&_nc_oc=AdrmPFSJpFqR7Xzkoue2W4Y_2V3w8ugsMOdZy6caihXcDBvFl0rRfOZhk33cMjzyZMc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkgTsPcZa9WmIGHmZbaQ2ROw9xzkfK98f4R3b8nFEr6A&oe=69C68D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJg5uX5gkwEQ7kNvwG10EMu&_nc_oc=AdrYEeHHYTj85lNGqOr3PGoM_hr5yy5JLXPiZyHQxy2AGUTiz5k7nCxFl4rxN4FacpY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBYXyA5u_oWJZeZPM6-S789zEu4aYWzUXx8d6qSQi1WA&oe=69C67105"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98OwkJdIiu8Q7kNvwGUkZBM&_nc_oc=AdomxPuQmvH5gNcLMU8_a1AHo8hkuyZ9AMmu_1eVcCVgvCcJ2zNRs2AZUZTz9QccSJY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9bYrzV9nSm9OS-WHVTUMDiy6la0q-EC2h00dtVk5Z1g&oe=69C6711A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5emkIuNvbiQQ7kNvwG_Iolz&_nc_oc=AdrHNpcK5J4lq6EYp47lm3JYKo_fL-X26c-0nQlvCZbjbgY4fcqQ2GsYUAuuxCbenfU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzddVBWMrArjSu4ajucNfdih_ugyueySfZUvh0Cpiqkzw&oe=69C6956D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsEdzL5IOFEQ7kNvwGIeFa0&_nc_oc=AdrKnu-Tbt1YiPoOaAWosmFIerNSbVngh_HEMMC83BEVoixKzCu8JEmiCJDIv8HHCxI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afylw2DtxIBEdtr6cAn5uJExZynAmaki6-3MGDL729CRtw&oe=69C68597"}, {"file_name": "HickonuQ_1008x
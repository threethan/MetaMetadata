1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oKsO5dxdYF4f2qRVYRl-mp-pOBimZqtw8Mlpyehv1yg&oe=6A1C3751"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYzzcR_8W_IQ7kNvwFkYsID&_nc_oc=AdpUlSndltFblumvuUcxlVefvlQxFyhIqfVZAVxf-JcihOPpfNWObS8zTY0tZfIPoaE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pr_w2MtpynyDhwpEbeuk53VSrOB_wmsCJR8WXy4yRrQ&oe=6A1C3EBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ_eHq7tGpUQ7kNvwF2SCOz&_nc_oc=Ado87Wp-pktQ8YDynsO0om1ZFMiXCVjzzTLYYAZxHpzLWArkPyg645IyZlZiIv_wgJg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gP72FfuCdFtTUJwBoz-LFK0QGZbgoREc1sW-2-VATEA&oe=6A1C5AC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdRPlq8zMggQ7kNvwFRol0h&_nc_oc=AdrBw-dk5AF8vbfJsBWLcEOMgiTc9z4UOp-UqhDP_RKHL9Oei9MJFLiwMRV4opAkGKE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j-sQyHKH4fS0GQYZSzCn9vSqBJCaVCqnFPM2ARpF-TQ&oe=6A1C5ADA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVhJH911EFsQ7kNvwER4OHp&_nc_oc=AdqBZdYiJDI7Nml0pPi2_fayuYPOYlE5Q2s-cQYYBOirU7ezvCjv5eAs04wBLor5U9w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42IJpGsUGkGdSxwAityManeikGIEuqjG8d83_f4-8ssA&oe=6A1C46ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe1yE5v-UowQ7kNvwFR2N8M&_nc_oc=Adol24t_i64T7ePhlRhHk35ntn_m3gRxRNRunlr1vo6bjg2LOY1d6Xymt5I6uQye-G0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fV-gcCS2SeqBiftrSdWiyUFHTjK5_oBFKsviDFQkcsQ&oe=6A1C3717"}, {"file_name": "HickonuQ_1008x
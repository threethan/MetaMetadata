2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwaVKrxpt2AUSw1ozqwYUDlLe6H8uR38PSxwuLBIg0ZQ&oe=6A64B9D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9FOinPsNC4Q7kNvwHh-mdm&_nc_oc=Adohwiks_dLa_BFx4g_9vcMrcsecWngVuMODhQUDEST3bKm-TFJB83YMOmiIT9CNHvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApUEypY8gtAHtoul-7nKVYEjq59CAOHYhTOpD_Kofm-g&oe=6A64C13D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqZm7F9DqncQ7kNvwELlmaM&_nc_oc=Adpb43nvo8b3T1FTrTpVuQeGesJtIuHXZDvV74Del-YSlM1creunhm9EpIle2-FbBJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACrUVyPXSGnimaCrI3_LTpTPUSLgNxYLIo3rCLEcUK3w&oe=6A64A505"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu6x1N8CrEIQ7kNvwF4Xnnh&_nc_oc=AdrT0gV7KNNpYKCzcz72_SteBgly0QEbazOZmrqPtDyzg-XDRJUP_pem16l4lPO1038&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYxA2IAfSCme3CeRs3FdzMAu8bGtul4MjRuO5qXKzsoQ&oe=6A64A51A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-TTUVIKxxoQ7kNvwE2iZSI&_nc_oc=AdqV3co36IF1pj8WdwOKv2TJ7t1g1QlnFlV2G8UQTiBPxNvrmZMpE7P5zZ_a9Qz_m2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqqBIENIwpWqqWZd8O0wjEhKjKWW0ea7fv3mgSD4f6rQ&oe=6A64C96D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8I9QiPd-kIQ7kNvwGXe6lb&_nc_oc=Adr6jyoY8OryXwdiSVMKXKeFCl0_2oCM1giCOvWTOb6cK8BtiVPZjB0M1ykzWToms-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKC4aq78uimOlKeHxHBPO3cxlfA4UFZVrqm8QQXbp0qg&oe=6A64B997"}, {"file_name": "HickonuQ_1008x
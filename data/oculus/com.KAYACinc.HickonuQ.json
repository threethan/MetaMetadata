1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8_eHzZJ1y52cKCcKdICYy7FWMhyDy-7Wp00QCUkejfg&oe=6A918CD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJWBqmY_X6sQ7kNvwF5lj49&_nc_oc=Adodd1w8bcW8Ff80lCWtIOTzsb35k-NXiEROSG4iS9ZFF9Q7eaU_AbULnfwmVRvbnkc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPdFTb7GzC8OrMb1TiWSXD7pgWsn8eyRc8fvs5s3y_aA&oe=6A915BFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKMOeQVK4bUQ7kNvwF10nYB&_nc_oc=Adqa8Xw9Des1A_nFwMe-waw7hah9Zapmv8-fo73x7oUjSGdC1Gd41t8j3fHONeUMZ-A&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhuELyENdqBTniL4vE3vM2LU7OCjgsiWZmCPUJ-XOySA&oe=6A917805"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXicDE3KM6IQ7kNvwGRtknc&_nc_oc=AdrBNaBBhGXgJF4eFOMj1McM5VppR_G9q4AtpYTXX0K_f5AjYYkdeO3h0rNMJejFN_I&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa01RaI_yOg_IqVhUXbDu_pYNDjGQzRXqQ45PciKFS4w&oe=6A91781A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHZGFzhOdKkQ7kNvwHTcK_1&_nc_oc=Ado1EEho_InNG1ffpn1-yrYUbgHWvkmi51q9c2fFpm1voEds_3DpRztAP_4vI6dC_6o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5k2ngJN-SFof6O4jWtJuec5RaHNYeXEj5n05ouuj7zw&oe=6A91642D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH653sPAZb8Q7kNvwE1VdKy&_nc_oc=AdrpfdPSSjdo6xZPlhjmquLM5RtorKGVPHYF5kxgAhuGmkOpP9TQhBTKSD6L1a5l1oU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmg-WNrdgPZkHJ3KEJKq7uhDMGyX-LdU8V6HyZ031gJA&oe=6A918C97"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWLpA0cY8PfkHjebxr_sla4PMdN_8eSTlIaLUy16_Hgg&oe=6A6DF451"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRm0gZkWpVcQ7kNvwGfulP5&_nc_oc=Adqfkcd6tyOKiV7Qv1A16PF-3RPMbiQSZ2_RwqUQ9emeoCpHV0PEfEyB2BnGAtvgJaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqOUE2-pyv_URHiht0Lu3KnaQ_OmBkAOVsdWLxXxQ65w&oe=6A6DFBBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxCPp-oA15MQ7kNvwFQsicM&_nc_oc=Adqg7kjHyzqiy2sRT3Mt5pnyTCDdGqLX1zFsdiMfbvXhPIU1YwM7HqBqT21YiDVPvYA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOy4_PNISEwjjvkeiWRfT0fvYvOAizuh5Kbn0uDHUMwA&oe=6A6DDF85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmvFrx2fVWcQ7kNvwFNDO67&_nc_oc=AdqzK9eNi4hee17RnfyEovXjo-Lh6mhUdLhKBJu0vTGegam8mlZAUuo2oht09HrGwoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYokoZSvZuTLveZLHUXe4ZH-BwbfJT5uCT995u8gdd1g&oe=6A6DDF9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO4l7f6cvn0Q7kNvwE9p0Tu&_nc_oc=AdpXWMmg84HvDGHJpT3VAxMJtr3AotNKiIcWXegGzAl91f1V-kN1Lgutp7odXH_63Bo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCbwjlTWDdUje6-g5wWgBKkAdo9O4KdwvUJjfQNmYHRg&oe=6A6E03ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbG1uasqtxYQ7kNvwFWfYj0&_nc_oc=AdqfG9WQ8K0vLs1BhKMqWDHFv-2YgRo2Dxbd1cQGFc_CxFYpBncx6atjECGq53z-Cnc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvTg2tO4KnBqTWAnvY-mxxLq32IVvwU_mH_5oKDG98SQ&oe=6A6DF417"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xPoUI4KXNSuttKI3hGg7M4n4M-T1ijveIzFSwpfxurg&oe=6A071F51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DXz0zINI18Q7kNvwGWAXQo&_nc_oc=AdrZifhogMSFU4M6qlEdUrp392Zj3dU1khFpZIVAyvdyDciNHIcz4zTIzf10abPYky0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rhuG7qHLNH--7UBuSOdbg-DY8NtM3nFZmipZBuHN1XA&oe=6A0726BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEy9lboYaLoQ7kNvwElCkRx&_nc_oc=Adpl3cY6NKVo0aHRbAPxUrgloSP1O4bI1BAHSKBzYIWvXvx7Hpou1mkVx97I9YvmTTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yxpoPktIV2yro1eW_7lLBz1H40VWGvRARHzLwArwnqQ&oe=6A0742C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leM5nR97bWQQ7kNvwHSZ00u&_nc_oc=Ado7yyRvHVRvld1vBjsuHMZ7oAG-bbjIg0X0TLwKvGwMSXHjImqzyP2UedJWuo824V0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SSQ0mYq1wsxig4wH_elXoFR0rulBUzfiERQni5cRy5Q&oe=6A0742DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cgU16YH3akQ7kNvwGBQ4L1&_nc_oc=AdrkGBbZmSzMytShdLHIVGbOVO8Nf-CUCAH_gOMImQURcKhdK86fsZe2sK093zM9Hno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7piW4d_bdjF81byiKExJYZ7b18_0kWvNsmi2LIniaknQ&oe=6A072EED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBxmobDPAVAQ7kNvwG1A5tj&_nc_oc=AdqKIrkV5ADExxqtih9FR25xWDyFfzPb66wc3cGS0CsG21smK4_RYxOBYFt8VCPQKLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gi1r87KQIHuL3UZXq1_4TcaQ5ozcQUwhmXTjAacyLuA&oe=6A071F17"}, {"file_name": "HickonuQ_1008x
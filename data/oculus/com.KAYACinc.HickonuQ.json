2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kuJRfZGIcsNV0fv-z4NZWvBE4it_W-8hC8BkY1xrLDg&oe=69EA1E51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1aR68Qrz5MQ7kNvwFrawIk&_nc_oc=AdogkTvwJGZz9XQJIpdYcCyXvluDvWDjomnL4D8Vt-6MJNEkLaidaCF_gNHVLXSDIEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lBI29RQUfeoAXmzcyY7RaUKXKW-UOzBQW4ux3DsvhWA&oe=69EA25BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKYi_DxcxnQQ7kNvwFqPuLs&_nc_oc=AdpAE0AgpuIBmpJ4Hq8rqf9liw7k0JHOQyBDJcOygneUdi7HXcR6iPEiPFS_l7xOn_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IWXlvupTiz-aTX9mAWvSygSx_vWj5ylLxuaVV7lI7OA&oe=69EA0985"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXlW0D2g7dAQ7kNvwFeBjoS&_nc_oc=Adr4p83psBkntVPnehvRMTKKhGN3RTBtFHR8rCJCUvK4ZWKXop854Iar2MiEA5Zdm0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EYbGi-tQT_Y6ZhrcCvppU84Ag3CetzqIs4ivpS3aNBw&oe=69EA099A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV4m0C8HVc4Q7kNvwGPAlLM&_nc_oc=AdoWJYTy8BGMNAD70tpC-icNdgamFdF-4MRiIEXVNWQzYj-xKKCwFAz4FGoHfxos50k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Mpigfs4D54MMZL7VnKbRsVLc0ytD4fCFmolvVs3gouA&oe=69EA2DED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9JkPWtCg4MQ7kNvwEk4HZf&_nc_oc=AdpranIT0CBnz5aTtJkJXjjIorNTCoC29GFimbcEas92vPwEl7dipxdmJ-uSxASRBMs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L5yMXy9ijwakf8g2049vHfBqPP6lc-rkSavJ-GgGvjQ&oe=69EA1E17"}, {"file_name": "HickonuQ_1008x
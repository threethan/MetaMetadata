2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPFR6f0ojJIfJ-VgV1L0RXr1AnBTjAU3dB3pKGJVFLmw&oe=6AE88FD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSvgRB0px14Q7kNvwFt-cgI&_nc_oc=AdprYw92vCzm5n9UAiWFBevZ42tPKLYuFxDcka9jdITLwCWJcXV6cWfbjXoyK3xRVS4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDpluSl0QA9gSIBnBWa18SK6OkTonuC1w-kPkw3XDS5Q&oe=6AE8973D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83YGlg-wZiAQ7kNvwEVY5wg&_nc_oc=AdpdSWr7UkrtmQXgX8ZKPjg1kQadfOPa98fOZsS5UZRZXZnRZ3k9kKInXYb1FwfqkTw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmXx5sflkC-cGohggT9q5CBaIXWliWMDRWi_-qOCjEQg&oe=6AE8B345"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2kc92TYLrgQ7kNvwGc7a8U&_nc_oc=AdpYmtZHKActTYcjkxIwygbPuUbVcAzjC4-aGMtZComQTxOomftx6FdlceY63H4i9V8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWfu1FJt2s_d6nl55jQRzk3gH8g6-059JLXHo9EWOIDw&oe=6AE8B35A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8xF72aoXjQQ7kNvwEU0N-J&_nc_oc=Adru1pxp_JWv0xo_UQfylwDn9vQFctXY_C46iIITRQJhOwowZ3hgVmOHpQMxyUSPtbU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs54uBrzxXGl32dFSyEDCYpM-ttmMKAmj62UbNPRREIA&oe=6AE89F6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enOVVnnNjnIQ7kNvwFk1izz&_nc_oc=AdoHv1R-quXs2fB0AZJ04USSim58Nazwykk3ghALn-urRlnbHmg116hHIyxBrs9eecM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbKgWUE9ORDHxgxaffqzN5nsgxQmUP87z4oZAcQIyA1w&oe=6AE88F97"}, {"file_name": "HickonuQ_1008x
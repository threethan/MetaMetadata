2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IWeaBAKp3C-V21VR8QH0j69chI-CrDrldVgEWJHEG_g&oe=6A0087D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iprja2WhJKcQ7kNvwEVE3IT&_nc_oc=Adr1e1mEqzwCI_Q6lhbbD-3pxJe1SBz6_XViKjB6FCSX7CEOru9w6gSpcmAYPFDUh4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yx5BekzzDTC4yNmShfFI_LxJjCKMEx228Z_voL3SiSw&oe=6A008F3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cknEsEtxYWYQ7kNvwFxq4rS&_nc_oc=AdoSbUGV9l2uPorT-MiWNeVRh2JZLnLaQUGhX0xHsDVJ8j_WoYm7TNK74evWxxBxDKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zeOvACrm2Pyne1iMFiz8U1OT9yPn5Y5G-VmC_2tW3fQ&oe=6A007305"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jyznGFqVasQ7kNvwH0dJ5j&_nc_oc=AdoF-5Fq0ppJsHoWWhJOwSZmjoLVGrE0ID-CaEPUMPdTpGcUNlM9cuTbuxmXB2EijHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fJaQk9AMQWzQEUjLw7-D-mKFN14ZJc3KjX0C2IucXLA&oe=6A00731A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bl04CEhxmgkQ7kNvwHKu26s&_nc_oc=AdoIpbJ7r_kmEjvVvhZ6mZNr1yVRX13LDTkrA3BDfUITkUz2e8A7J3YRnQaTImjXfKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P5EmePcOIYywPfgJRCdG7WNqtZm9sMSPIRPnL7Ty1bw&oe=6A00976D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PR5ntxZM_0Q7kNvwEzrHrc&_nc_oc=Adozj1eQKsK-9rAZFG4yW-e546JomTfmfaD2DLel8OLMnrVyG6xDxaVjDhxmQw-0MC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tQmNFqdO-Hr3T9z4tE97HALuac6VmLRBCQbDxse9HRg&oe=6A008797"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM13brVk9jhMTlvpBq4g4TjX1ROHkuBzm809rU3x2JDw&oe=6A6F45D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRm0gZkWpVcQ7kNvwE80ixd&_nc_oc=Adp9VAqN65oxIdtN2GN93HH79ljPqjYD-Nu3-dLU6uTR3MxI55L1FzffUW10XalqBxs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATyTRVcOVIzEj_8zt0NmMNQZ2ZC0aUDU4yLluDVgedsQ&oe=6A6F4D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxCPp-oA15MQ7kNvwHQxQTP&_nc_oc=AdoUUFEcgNwoRiu_gwGvrqiLL7PsT0hVoNCf6uLx2tTL3V8-UGDlQrns1HgOjMjMNPg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHNisYuGpvOJYcQgk2x1nYb0gHE8Si3gdtypocflUcqA&oe=6A6F3105"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmvFrx2fVWcQ7kNvwGigtnn&_nc_oc=AdqIZc2UeiSv_CRBhBwuBo3XZKTeIpZ1r6W0GKXhOZDkp9InAlkVfi7LHGyUhIFlfr8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv-a2RlUgCXaYvqidAoy7_hWcFuUcgm1ihObvtSW5XIQ&oe=6A6F311A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO4l7f6cvn0Q7kNvwFzHCM7&_nc_oc=Adp5svAfs7Tv5Jt7V5y_1uEZo9VBxadie7YWD_Z_sqaKbsQ1MN-ECt2Fu3zA36p_MPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA69lKaVRAWszhuANzbNx9vw2E9xQOpVjR3tl849i7hnA&oe=6A6F556D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbG1uasqtxYQ7kNvwHlY73p&_nc_oc=AdqF9a6-z8t1O7s8C_e46B0h7A3DqrY1nsPrKEbc8HnoJgZSKlhl1stpYuxSOFpRFS4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsbvHmIldUZUoUjEVEDo44ADuzKvhsly5TjNr9iM8ZOg&oe=6A6F4597"}, {"file_name": "HickonuQ_1008x
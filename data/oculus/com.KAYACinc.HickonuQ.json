2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2gM3Ar-EsVAXLuZsQjjgbQefOI_ML1hlZ47fenJWXnA&oe=69CA7A51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gH46YWbUSkQ7kNvwE8hlM6&_nc_oc=Adqhxhj6Y7iFUsKv__v-ArOKOj-9cT89vJta0oHR3EakYgKjpsDMmkC_E3awDS2Xc3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWQAy2aywfglnRvhpmVR7sIqjax5AQPsvKRXMxa500-w&oe=69CA81BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLe9NCNGI0UQ7kNvwFMWT-p&_nc_oc=AdryynqZaD5WKgXbzPFpbJwTCy9g_Ybwp1xoAVcSGA9CkMyUpRuKF-ZBA3LgYVl9mxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3qFGCR0WiYwHwHeHQqHeKRkWUXpRKFXxF8RNTc-2Q-w&oe=69CA6585"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_3IqimPIGoQ7kNvwFpUcOp&_nc_oc=Adr7uq22N4irXTbwAtt3ev-d6BNw5vWdoCDpkAfmW7TvoLBn9FX7w9pALgHVydXRmZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEsmhMk7hco13ep2MJGnOYUmESiD-qQda2ia8clI7oXQ&oe=69CA659A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnqUfAG7fiIQ7kNvwHM2-hl&_nc_oc=Adq_CbiXesWuXr2Kc1dWP-jk0EkxVkyX3i7A-CVIAh-csL9wqZfRqiz3AnGnvLGHXfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxP7i8txGnwKXdMhXAwa-2HL_f5Jbw5mtUiMM0FkjT-iw&oe=69CA89ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhi4eqvj8IEQ7kNvwE2TxXo&_nc_oc=AdruxcKOON0ZA5mlDQIELIaKOHmCtkzrs4mlnSPQ-rg5oJlYh9YfA8bFmi8wCwTLrD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIW4ZRygpFkFno_eqh52XpbFlt2jA-H-JQAF95kQGJ3A&oe=69CA7A17"}, {"file_name": "HickonuQ_1008x
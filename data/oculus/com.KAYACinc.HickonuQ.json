2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvIhOFpvywGNSWD3UT9okcD8BCsNCDdZoDXvjEpZcYZg&oe=6AEF5F91"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYJzFrIKIKUQ7kNvwE-bFIn&_nc_oc=AdrqKT3gTY1NrrPEIr1NoyAXz5BiS8GJC5xu_znd5cZd62ICQf8KKuiKLbhGtxGBllE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCgKQHx_RJQJEsmPwBNSOuDohvQKeKLxJ9JgEtX8JB9g&oe=6AEF66FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSfduuNaYqoQ7kNvwF8kXCr&_nc_oc=Adr8txFG23LQ6iBtjpJ2Kiv5DiaDPhaVK2D2raW5dQvUjuWoK_dXhsImN6aNq5uNZ3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC6f32hOrmoRiZ-OFYu6NF7Tc3_Ww5D80gmk8X0GbVRg&oe=6AEF4AC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyrJEjctrrkQ7kNvwH2tMxw&_nc_oc=AdpFDBX_3s4U3Owp4sN9vHEH-LEU2aKDLjU2gEZg_Og0raYxasBPWhVKbdDVkhnwJ60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAfWL3YdIfGxkqhIt7ONa8uej3iDh9LCuftjux0f7lfg&oe=6AEF4ADA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVHQ1aPtzAkQ7kNvwHV_sqV&_nc_oc=AdqUhassrFWDfLum-2SV8li6_m6tpXQoZVA4EHYfzZE7JpLMIPKUoz5QQw-X2Fz7SAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRONnMflHgJ_RorMysVautBqezvz9y0Yxc4c7SxgjDzig&oe=6AEF36ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ9EJfLNLJ8Q7kNvwHzejWO&_nc_oc=AdoW1qOzt0WLYao_CkzT1DgCStPQ9Sm30U9n4ELuTSvSMf9-wn1XUyjnbJspOhBL0Co&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQF_8ZMYhec377S1hUCYtgsBMgS7ZSt_f_V-_XxU1d_g&oe=6AEF5F57"}, {"file_name": "HickonuQ_1008x
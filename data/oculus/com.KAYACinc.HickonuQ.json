1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mXVoOQ6lZ6y5N-Dw44DXIOF6UJyNGpHoH7yyvKc9TAQ&oe=6A09C251"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DXz0zINI18Q7kNvwGFaBIF&_nc_oc=Adq4DsK8MNQynobo-X9RClUDG40L8b9QEF0KKmW8aLkeuWIOQ_Qu_NAXSXBRk4FvGpc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aqwctO7eNxO_aUvuXVwzQ4aGmlTQQ5nONej4bVYbcJw&oe=6A09C9BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd-jYm_MuJcQ7kNvwGwHwmy&_nc_oc=AdqR0Q9KENS9h9GKccwteHzp7ph6DIgRoOib55O10IVi6k8_89u34406ffbEJYzbirc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g_WRJNKXEbEr8XXMJmN9n5kuLGURZdjHyAPsEoqcCww&oe=6A09AD85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmx3Slgxc-0Q7kNvwE2NaP5&_nc_oc=AdrheXpSq5-g_btJTXKRNHm0matb4jjdmXnBgWSPCAZKL36D3RlqSXhloeBoP8xt2no&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LQObsboydV4djEG9A3nuWgkPbThXHmFAQUOPYDBQllA&oe=6A09AD9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cgU16YH3akQ7kNvwGN-I4N&_nc_oc=AdpHiDk8PTcAatK9I7Zn5T6LaOFg7E7zXKSYtcIx0Lye29qHe6yxdAqM2OnkVnYxfyc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vF2x4eSESX5kTWo6ZeePVXu_58-rcG642Gub0q-mEDw&oe=6A09D1ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmpC7E2mR_MQ7kNvwH1blUZ&_nc_oc=AdqRNT83BGqECHB6h9QAIfq0mTaLEd4dn41bmI5UElX1YrHO_EXqqXHpHeihuZiO3lQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KBIw_PT-39YelfGYUCGJSebkf7fLfYMJYUvowDVroFQ&oe=6A09C217"}, {"file_name": "HickonuQ_1008x
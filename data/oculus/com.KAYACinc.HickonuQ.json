2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20-TTuc48YGLyvXOFvUJKrZiX4bFBf0tccJDejGA19tA&oe=69DCEF51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1hn0j_sUwIQ7kNvwGOIjOA&_nc_oc=AdpMjGkk4dgkodb-XZZ-0xa4pABcF9lAjhTpEsHP2a1u1rckx4VkUefb5cpRDt3ErDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K85LiMG61u3cDnIMH9ukIomJvmRNhktfJqZkGodlaZg&oe=69DCF6BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8PAnuPXL0YQ7kNvwHQ2e0q&_nc_oc=Adqg54L8vipNCFEA3XDScVNgea6qQKPQ1SLKWm2TctqMcpnqkRBVCAVviuNmhNOcB9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2as5frlUbFIRvnllybkNV0VUOaIoVliLzOPNaOw5HT6g&oe=69DCDA85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRccv5HnVFkQ7kNvwGZ7jtM&_nc_oc=AdpFSWruvRcRNTiphwWA18C17hJJPjkTesaH3a321xr5__2dqSSlt4DRAy5TYzxafwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DM6KJJQkqGBNVmYtHfTgaR5BJX9wn0uI75reOUbx0xQ&oe=69DCDA9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxRwoNaJ55cQ7kNvwEifFgX&_nc_oc=AdpnPDFSE48-KwNhZrKlfo3DxEM45MdkzxwtQjH92VHnwes1B83-4J8uIve2gVxaxQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ywNyN4WCZibsK4O9hrkgRtCC2q2fYU5Ez_-CCQsxa5w&oe=69DCFEED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB_bcp5TDAYQ7kNvwFAPL1R&_nc_oc=Adq-4d2Ouw3_SkKK1xskjqFkvyJzPyTQE3BOFMCjetSuCl_ZMSluRDiGQIxoO9kz6rs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03bP2RDeXpGnuuIb08dCtZ-Xy3BVqmebumLJc602GGQw&oe=69DCEF17"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKSyS1yA5tJAykd1JkusYk8_P4mJsgMk12AJgTpXx9eg&oe=6A4BAD51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqeHJ_HBYEIQ7kNvwGS3yOg&_nc_oc=AdpRCO-cNAGrTZpdELyFKjyAATAMfnL840pVA0iJ_hS6hDViGIQ-DOtKSkXa80WYbHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI8tX6GwTR0lu4rNK09iitHbB_k75L55cKtBJq8Ozj3w&oe=6A4BB4BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuKKWD1fbt0Q7kNvwHz16cF&_nc_oc=Adp3yZ7fKxJb9LxztslINg_-xYkoUrRjRuA07QXZtX9B_bEN_acoGRAagtRdDiJl6UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb_8efPOUwjK5N4Ewks_T10-7lclEB4OEHvjPZ279Hdw&oe=6A4BD0C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePxZaFXyaGQQ7kNvwENn78Y&_nc_oc=Adp77lA11XVsI59Qf2QUmLDSDZ7tNSuI4NZJNwEonj9Vpu9mcYUnLNfYzHyqLTnLk4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVFsnjnKpIh229bBiJRFzPHKG6HEGyBgDQ9rTuUwd5rA&oe=6A4BD0DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO5SJx1xkPoQ7kNvwFNV84D&_nc_oc=Adr5hXZoXqZLkNHROHBapO43r-MA6EcUMQHinZjvFqaj9i2P9_oyzurN__Y4jl7isq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiUzNVvTV9r7dSJjAgc83VK7PjcDOdBj96m2ccpwsREQ&oe=6A4BBCED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK7Hg9vyMY8Q7kNvwE1cic0&_nc_oc=AdrVFhGAFx722nDFrlgNsjqrlItGJyf4UBmF_3OoIY1ANSC_u_fSlBcia-ku95qbvZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHPZE8oZ77SiXeEOAhAETGIMPQrm_VlTJbwbJn39Dk5A&oe=6A4BAD17"}, {"file_name": "HickonuQ_1008x
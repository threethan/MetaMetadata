2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GEQI8xHupGSdFH0yg9bxy2_Pn4aeQIKdoJvDBz4xjWQ&oe=6A0870D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DXz0zINI18Q7kNvwEBYyR_&_nc_oc=AdrltODYtwr83QnVq-1UAz5sbWsQT6dkiq_ze-v2y6USob2G1TANH8s7ZV5PaeqwLCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UZ3f4fhd3D3zFN7MRjPa2rfKNLC7cV2SZ0rT3UC8MSg&oe=6A08783D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEy9lboYaLoQ7kNvwFCD-FA&_nc_oc=AdrUfOjbfgcwouv8cDExLFqf4bojtgT6dise2hihBUoOQWWWDJeHt69SuW_alcyH6IY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71xcEe8vvQc0pMXJYHKRlOUD-W0ukvJxTj6Pyf855ESw&oe=6A089445"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leM5nR97bWQQ7kNvwHqz55D&_nc_oc=Ado8Gipu85PddV-NVpVZoBhYloDnFeXYJlQyDfSyONRROaeM8RGKw2ZEuo_DBY4ihVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RmQ6PwIX0SV9Nq0rQBGgwf-APcMmkH9O0BTWUjo8nqQ&oe=6A08945A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cgU16YH3akQ7kNvwGtSFvv&_nc_oc=AdpZZ5M4sLLsSAEkHLMRYw3GXjkdrZ7jK5Q3VxL4erxlzL-MbuHk0PzsTWVwLEr5WE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XIIrTxIhOFKTGmNnmh_89-nLwb_jJ9zrcNbzNaoX8nQ&oe=6A08806D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBxmobDPAVAQ7kNvwFIJX0y&_nc_oc=AdoiRJsjxxMt0rOLuBbb7EvjvK_ajFNiE5XrDa0pt2umh-xPG5gPFPPXNKOQGXRm4z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LiSpQZYyBR0ebHzvvMsqbDfJnN2v0VykT65iWYr9-kg&oe=6A087097"}, {"file_name": "HickonuQ_1008x
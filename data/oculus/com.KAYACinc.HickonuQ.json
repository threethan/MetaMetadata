2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrH_EdWbzZxJ1hfXu3vuUoF6JTFn1PwL_MTpj49WJLlw&oe=6ABFB151"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mHkfsGnTIEQ7kNvwHv0OFJ&_nc_oc=AdqSg7ABI3xD8XmD-p21Lh9HkKv3-GU8TWmbnZy1ktY1XSeCqYkBtOPnp9JX4jfdUII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu7qH6ujVMIs1PPIAGA6hW_gZsink1m55J_3hxmzuj8Q&oe=6ABFB8BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_gs0h8KmJEQ7kNvwExGh2D&_nc_oc=AdoR3owm8Qt8zEmh_5c6SKfJSqGHfHgAmFCbyyi1RL83KY7NnbGg1_UF5L1CnUImh6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-CcXjKybZg7bt9rbZw852pbABbWQXa3_idPyWrsDgxA&oe=6ABFD4C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z_ZqWnUiQ4Q7kNvwG3n-bu&_nc_oc=AdpRsY4HlwEYhuscB7fEJH_erW61RPMkfvDqKJt2QVoSO8oYVr951NR-lm05Je63x9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYQVR2tHRJMDhBe35dh_Sttu4acpNGb9fdr8EJbNdGUw&oe=6ABFD4DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wqWr3NtmywQ7kNvwE9atmu&_nc_oc=Adrr2RGoGGO77B9K_iWaSDIoarEpVtJiBtzCw7GJE6FbXbEqusSNaEBvxjPW-mjfSNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-Jqn6kiTBgURNnusopWn3P1uP4UZVzNvNN6-ITG50UA&oe=6ABFC0ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XXk8P8vOfgQ7kNvwE-Z9Mf&_nc_oc=AdobpfnfPjH39mHmEFuMMz76Y6CvlRjJkOOBc5v6WhRIIXmOtcmdrRGSsszk17sYr50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7cn-QtI1Se-wH5v5tkf1wun8286WRKVFzVIT3Oq6Q6w&oe=6ABFB117"}, {"file_name": "HickonuQ_1008x
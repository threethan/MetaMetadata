2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJcqWTRVbNnBVECvVFNLJK4Hh77lrLtwlH8UxHpbKbcQ&oe=6A4E5051"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNaZ_ctUtygQ7kNvwF56_hC&_nc_oc=AdpxtK56Q3FqAa_mBbUe24SXrCHkzXzv3hrJDa0yk2CBAOIj9PRPkRVl8PjtNVh-MNQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARB3IF5eK-1EJC6QOKBdLez_emoGDkRq8tYmT4JvW6cg&oe=6A4E57BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjyL_icD3fAQ7kNvwHe8eZb&_nc_oc=AdolyeD-Kz0YlkQLkWowjNfP4yUCq2xDa1wyG2lNqybAefTWKliYfb9-WzE5wkInGrY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTM5ipxopsEUZ0sTPpiTsHFSooRwPHe-v6Eo3eMFtTRQ&oe=6A4E3B85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7ZnJmYa7ZsQ7kNvwHXv2XJ&_nc_oc=AdosGqR0Um37AWv6Q7mobWQ2zTj3DnFnI7ilmAqBRroLFUlZqsbwIhdK4aKDk0lQ8As&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAonnL37Ef7CCzFm3KhgqT2vfgRx9NP6-u7wjV-LYkNAA&oe=6A4E3B9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eIlQVzUskgQ7kNvwFOcx0M&_nc_oc=Adrm77FEOgBxxZ9YzNvmMBpT4kGvBBXeExfXgFnV7SkHT_VEmVCiLkVZOxOPsKbKRkQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwKiwrcYpx6UE0w4xGbYM5mj1zPbwOepQY9vfi_kOHKw&oe=6A4E5FED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5Tr7oNY5woQ7kNvwFaHI8t&_nc_oc=AdoXy-0W52C_OkLH6_FP7IdUzTfx_HUQfsbpWhXiJ9B_ln7E3SpGimUpvV_ViShY7hw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3nbCIWGcd8J22Y67g7aKXY3YkxDrXW8SvEqVP3wZNxQ&oe=6A4E5017"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxCcqadtd3F_Q371gL52llkWFPndQov8a1jca30NOSJw&oe=6A578AD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=337wGD-tjTMQ7kNvwHC-5gj&_nc_oc=Adqpffe8QEG3zUgBmJoJuGrz4OjNXKAIJJ-brInwNEn7-yxgStOwhC7IAnWCe1-zXN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcCmU4HwAcdCC5_to8fRaDJT7kBr24z1rTy03v_Ta1Pg&oe=6A57923D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvAlqsZWdA0Q7kNvwFKbj6J&_nc_oc=AdokEqLrD02KKkorLlO8l6QRBzf07iOQp8NRjsQ6LPbzBl3twEP7ajzF_seu6jcuI5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWrlcF6Y0NTwu0DYEiPzxy4wWnTlA_hjF8iTQd6MMUcg&oe=6A577605"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSjISh2pmuMQ7kNvwHRo50f&_nc_oc=AdoLWS0xwbJ3LIUIJXnF8Ky3ZsiHtXoSK1vfXSvsgo1Pz4G0O2Wbd7LpDoOhHkqhEuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlXk2bbWOxtnR_HYWzswMrOgeb9jCzlLkn1oRhBDVsPQ&oe=6A57761A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKN20YGdXAkQ7kNvwFe9K4C&_nc_oc=AdqTu6pEWBMwoA0_HDLqFQZYyDOl85ICXJZDNG1iVhEsJyjsi7SHIe1sZI6gKadnsqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEfZZksu_mVK-f1-fPtVaNA3bb_XlpAlSn6wkoOOPAww&oe=6A579A6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR3yHLhNhKsQ7kNvwGmFM2f&_nc_oc=AdqO9LZ1UD6dUwKVMS251AxjT23t20zCinG0zc0gNbpQHIdYo_y3Mpl18IunfMbtyoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASLVMW5c7cxIsDjKKhBcl6i1zMjRQXfT7glvdJbKxsew&oe=6A578A97"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFuB0mFHwB9n5Ed7UCaHVmPC5no1_erruT5TU1dIHWqA&oe=6A79D1D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc8xjjG7t8EQ7kNvwHrrd_h&_nc_oc=AdrRhWJ_SPLPXArOenPVh3ZFK1EFA701kqkE-5CU0ZofWHWaXpm9Fk6SZgwrRlDiB8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnRqbqxXd6sIqHFUfcVtm-cDbVG7VmKjoCaNLQ1X46gw&oe=6A79D93D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq9EktrZsz8Q7kNvwEQw04x&_nc_oc=Adrpy2a0APZ-dfhasTFKyflHXbeMuq80oKIAkkp-RWggAU2WvhWc9dpxKci9uqIM8xw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJv0BS_a4GGh3jAhEYNqcEyXbqyw0dPqBeUoSS4XAFHg&oe=6A79BD05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HITu7jCU4MQ7kNvwHaogZO&_nc_oc=AdqmGsGXB36cEU1LtuatEyJ7Oa0y4hSWbB8EHMjPiplO-bUZqJM7ukuBpvJ7fESt2Sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrvpokZ5tQ5tkF12JMUZZRuq8M89ylAbS0UgPow6yIJA&oe=6A79BD1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVuN1CljqQAQ7kNvwHT8DF-&_nc_oc=Adpqsa1sbW1hx5A1MnwEaW7fOs8mgJL6VJ-terwKMA7ANN03Nh0FXbtsiSy_igYNX5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6tIEEIOCdcwxNtgQQMiJY3fEIFOrbbss0s_PK32a0fg&oe=6A79E16D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZH7s4WzukQQ7kNvwGkJ4zR&_nc_oc=AdpKqL62yfzd3GqLk3x5SA6s4NKAGYM-xl6Ar2yCgi0b9umW-osIdPV-Gd8ZoNeMb6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5e5vCm6jmkqr9TvC16QBc1pkULJI4kRWl68CyBwW2oA&oe=6A79D197"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZeObH9q4-nlSS70jcG8AEJzGqcdFTsadptGKF7YTmvw&oe=6AC8EBD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnvOfczlqL0Q7kNvwFMr-mr&_nc_oc=AdooFjV6gniNOTarE-WMH2cgCzfjD8oSG3lbSKqjz9O7fsnThatQWlVvK6-7wwr8ps8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0yqHOdiJx_YXpxZCkkGw1lFkwiZ3_NQpdchYAsAhPBw&oe=6AC8F33D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqQOML3GQq0Q7kNvwHNkpSS&_nc_oc=AdrQ9ctFiMyMghBiMsoCq1QHvJLm-pcv8wgDRazu3G8lxjPIXmYEP2HOhlWgP7LC-ig&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0piaRaBjQjKnwUDYbqjd3FEYR5K7oUmcQNP6rOf8bqg&oe=6AC90F45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6oelUk69d0Q7kNvwEW1x4l&_nc_oc=AdoIHr0gpYtrcDyxzlm89UKMScg9K3SxZ4iF862KjH65K9vlKd7UhZPNfKXyHk5dJq0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhN3U3fmRU0BQD4tbqcphj5VdumPPkhIXMnr2X2KMkcg&oe=6AC90F5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KttjsQz18SoQ7kNvwHN_YCs&_nc_oc=AdpqJtyDBO6vZ3TrqNrYUaBragQ6jptGKEPHkJeSy8eaZNz4fWOmGEwE7avfkgiJ99c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2t7_ZwnaFwkFuS1tO-ioMD0GV7MzxIrVtqmeANfcoiw&oe=6AC8FB6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z98VnjhrFAsQ7kNvwEepU02&_nc_oc=AdofPXAcx1hyZ1Bn4It3nRQ-TMYTxNsyQcZvt8YtECxwwmjJYE0Kkvv29v1FS-7XX4w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUgLCsZCHfoBk2jXKvSAv0a746wdIHzhTutnWnZQ46Tw&oe=6AC8EB97"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzVSAQWS6LSAHbs2vobX-1tyXin7lPm_jfWpecmAJIYA&oe=6A50F351"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNaZ_ctUtygQ7kNvwGX6WGC&_nc_oc=AdrMCCBw1ByKF8yuv8sWDs0cQRHONAv2pdCvbWL-xRvY-3GydCRK8rMI_dSZOP2rJEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpFdG9nAyQWc5q50K1WxlC_NtKy2oJulQBxSOgBTy6tQ&oe=6A50FABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLmiFSbin9QQ7kNvwFg3-Cg&_nc_oc=AdofbdzfwvTCbZlXT6NTqQU5F3BgRB1eUMVR6b_reGU6tfwbKg92a9yWP4KQFUutXWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG31tZs-bK44f1HhOVfuus9R4b-TYfEeEuY53LRQVI1A&oe=6A5116C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnYPVqOzwSwQ7kNvwFUgueH&_nc_oc=AdrMJWVqeKdHkCVW_Dh1R1KrH_cvl4jW61Ohl9ydOZ3t3RTfk_KASuZyJp4_6G5ogs0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz1BgG92OaCyTfovgNOMblWxkjBu7fR27L2imQ46xuhg&oe=6A5116DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eIlQVzUskgQ7kNvwFA1Xqe&_nc_oc=AdoGYqXEYG-1_HGAbD4oEDpfoDrNjB8-o0-uhAWoZOZ732budL0sIxE7ZOb3DmRHd-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtZ5iHE-u3fM238YnATRZodTiByw4chAW3fewlufgH5g&oe=6A5102ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEVYtYdie-kQ7kNvwHV4hCz&_nc_oc=Adq8XJ3jVcWQW60KW_GCm_shLvFmppQmQl25tsoPGwsjPvwv0u3qnOOIdMHsePfBxIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4--Dv4OqbZKC70q-B3J2uNijR3SKChDfxD-Q8eAKoZw&oe=6A50F317"}, {"file_name": "HickonuQ_1008x
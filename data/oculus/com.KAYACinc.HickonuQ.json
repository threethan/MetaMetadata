2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tccXCyzloBQMHWAV6SEtafVguwMplqQ8iSYTu8EKJ_w&oe=69DF9251"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u85DxVoK3pwQ7kNvwFp8Uvu&_nc_oc=AdqfHcCkISMZNp2Nyf7ZxptJmrGuMZ6HYovSbGXFmsrLXfUfID6WGh0OmxKYIZDf2qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fdXVWm5s0sWUW2L-PlN7wKtcSQJO3MM92ZVQLpmvnNg&oe=69DF99BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRLKv8_p35QQ7kNvwF2448X&_nc_oc=AdoXnyR72iRDEquLu3kfoKVvWJBK--qTJx1os510KgG13a_qBNZ9uzeAFQ26EYAKfyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13dM2zm5Nb34ybzNTchE_4Ih8827U0OLtBwbWlFYOg0g&oe=69DF7D85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnmBUbNTBNsQ7kNvwFW8B0U&_nc_oc=AdpglDGd_XnKdPi4PLyxw3YNw1UTnyhTLQCZeURRYcyEQqMFRA1zHtcXy91qox3qduw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aw2f9PZgSOCmT2AbTFNV3gFEfXvaFV6F9fgrui6-TYA&oe=69DF7D9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHbo-OH1XcEQ7kNvwEYyuHZ&_nc_oc=AdqiOpTPLmVo6599_78a_8Ufw8a40_NleaoqU00R6Vo58YqUwAzr5LunXNics3k3ids&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b0_DSmllAttZKX5ZZOBw806RJ-0JrZTvJl4pEYBBqpg&oe=69DFA1ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeKvXrDvtLoQ7kNvwH8YlrD&_nc_oc=AdqC6J92nPjm26hOfDuOeLfBU52DRcrolNWAFpifhuNuKO3SENJmZHu601EOX8fHKpo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1edDqdXgCWJyfB25wgg9KvgZeh8mLnW1R3qyWEaQA9hw&oe=69DF9217"}, {"file_name": "HickonuQ_1008x
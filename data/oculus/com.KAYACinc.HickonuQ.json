2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y94azbN8wzhUD0N5o7Ej_kb_l7J2d-Kx1flNdQBn8jg&oe=6A43C451"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr8VUIacwFsQ7kNvwHSpshq&_nc_oc=Adqo3tR3fNsztBMT3i8wvvCGG3leBbwnbCJJOGTKQ1wSphxT7oTWb6QuUyzEPfRP7JU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--Ua0ehvTEJhOQmXjXpim6LLhI2YeWVKX3BZ2v5xJtPA&oe=6A43CBBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm9owX4mFMgQ7kNvwHIGoiH&_nc_oc=Adr5QbYC7VrDmbvcyQpArslAO3RsnOwvX2Li6VIyZ5b3_R_wxN5EmFORnmjy04uIU_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8idhvN8HkPCgCuoHZgCOY7pGAkPSzEW_IeShZx8xOgSw&oe=6A43E7C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnYdN4tPtCYQ7kNvwFk8M0N&_nc_oc=Adpejwg5l0-kY3LDSwa199IFOgtMteozsYd5JljtAfpvNEKFAX218AMUoe4yW3ZcaPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qAsJ7BucD_qwWdpqKaMfe88Ic5Z1_dglVmBCbZ5EK8w&oe=6A43E7DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBqcxlEbPzYQ7kNvwGXFHd_&_nc_oc=Adpdggn2X6vN-_bP1NnnDGvTzhFe1VJcIa7HEan520FazWwJN07j8LZY1xfWkEIrSLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fOWHe0P7kVyOF0Qik3P4-eKXxn5YDa5Qe6CL6_NNgng&oe=6A43D3ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9BzDSzqdcMQ7kNvwFAUg31&_nc_oc=AdrS1cvfRbZsPPhQHFt0F5wic-SDMceGF9pY_FEVFpZhQtG-YuatyDU0BmaQLlp23IY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8thIja3qH00a3VJjba36BhhYUGu_RAJR4nEdSohNVShA&oe=6A43C417"}, {"file_name": "HickonuQ_1008x
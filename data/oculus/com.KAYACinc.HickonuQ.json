2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBguGswYbk1vowdXHOcK32ihVrL-7rZMrpMi8c-YsgFkw&oe=6A4A5BD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqeHJ_HBYEIQ7kNvwEB36th&_nc_oc=AdpCQWdZjkP4Mhwy06ucAb2sz83cOayJ8AUJQD05GFotZGgkBvNgqb8qTDojlMfVG_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNw7Mqy4qpR37azVEx-MnYTu8nC3X6pTCf9jLZwwxEgQ&oe=6A4A633D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuKKWD1fbt0Q7kNvwH8a3Ch&_nc_oc=Adrh1nDUGUdq-WzVO9XbLTBi-PXRr88vTDn3jUkQ0CZxLGZ_7xxCqXz6WM7r-mA7BfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC41HEnWDeFY1FBDToFlivmiLswWsq2uvptHK7Bcx7aJw&oe=6A4A7F45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePxZaFXyaGQQ7kNvwEscq4n&_nc_oc=Adp4BLivqdyV3C3x3uyxJsG4zo2thD-YDGGQmBMHCXzypkiRAl8GujsPEIO_YbhslbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbtz6JgYaES40N-CdA5Uv1qXh2oEzJ-UzbBLy18LkQrw&oe=6A4A7F5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO5SJx1xkPoQ7kNvwFn1DBQ&_nc_oc=AdqOz9u-YZZp3QXJ3xV9kOY69thez7aSl2-IBfIr8CBfES3gWLyzyUG_-aR8QVL5B6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwcuEkgzvOqgl2hstBQTkXUrh7NOgezTie7a86vjJFqw&oe=6A4A6B6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK7Hg9vyMY8Q7kNvwEKdXe0&_nc_oc=AdpwyS9004JZhHLbbXm1zlyjdi6eulqeNF49LlYF7Qg0JqfY6vlKdJmK15GlfAfIp1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwsHaW3YaxwPRP5yukQznrnbzwbr_2xWuuilojjsvqHg&oe=6A4A5B97"}, {"file_name": "HickonuQ_1008x
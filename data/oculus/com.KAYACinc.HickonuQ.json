1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_dAgr0NlJcQgmQAh-QOEayqdHrbO5yiInqmHBJq-DWA&oe=6A748BD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54qruer932gQ7kNvwEBXP9x&_nc_oc=Adqiojd94EofhQhAyc5vIAu_SotEpgZdNHsl0aLGq8yqTzDjtiDyQmQL9u06XSNjSJg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCVf0mEWe0aIuhX_sJhDf5rv5oo5ZGcA_h80K5mSTQgA&oe=6A74933D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPHvGJ2UeXQQ7kNvwFB7eNC&_nc_oc=AdqGDJkCSqwYh-c_e4gUjqv4LWdkpbN9Ijvm-x4JFjcJB7I2ASFQI3XROnDFzidm8xI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0KupMr-HZKeU2F75Vmx9x7Dc4lqO6h-XpybP12VRKqA&oe=6A747705"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epLc3RQMKdMQ7kNvwG-8wuc&_nc_oc=AdqEgYCR2EMbacD0-WA3i0nUSlzjbQfjFzLF5UQyaQfo9bWD424Ty116361bS1kWb7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwIDvN6KcI8yu5Q_7dHrO-2PiSQeqrocLhvEbk13R2iA&oe=6A74771A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzI7H1YP57cQ7kNvwFOMcz5&_nc_oc=AdrxwBU3uVNxduFuX3VCdukotHVQbMxfxYwflo646PYSU6vAg5v0eij1Jcfe1ZqIq8I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhq3ydzABBM4GhqIwGM01oAojth5xB6R0yy4qINg9ghQ&oe=6A749B6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I73GPpp-wEgQ7kNvwFQ9EOM&_nc_oc=AdoeTkeINxX736F4EaIR6hUVJC92YO5-XUXffBVQUqD7DsGuZ5hQe0PFk0Qz2hgziLg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-XYFZbn9cUwtO3oriqrU_tLT6GCriNtq59ZsdH_HI4w&oe=6A748B97"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9QlR9bl2NHXZSu18Zcc5PRCsa-w4ppA7jhW5QSNeOwQ&oe=6A217D51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJFylfBkus8Q7kNvwFesweO&_nc_oc=AdqttKVY0-QWT1cnocUKgcZ1cxiWDm4Tvc5JgSkUoeWJxbKDWEN6ZIAWCC8LSi7QuGg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6JKEx9MchaAsU-Z1ONCk6myitqrUVwTWZOUWgTsvfAg&oe=6A2184BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tbklyoxy48Q7kNvwHQ6kX-&_nc_oc=AdqR-y9sJup2Hn1Gjgkjr80q0f8ih2FjNJmAT_S2lrizygIFdmWzcfDixwL0t_yeUn4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NyuYzI6ccRzcZiGo4pT15_9j2gDjlfC1dbMdVGaBEgw&oe=6A21A0C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZhzYd4uY5AQ7kNvwFUfGjK&_nc_oc=AdrG_25R4OdEdHbwHJ5_2q8MMlAr7R71TPE3KiehHFiXJnG20CpuJgU8l7ly5ZA0vKI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rZ_6rjw5XIrNYm8KF9nJB3yst3BgJaTSGc-t3fIdFOA&oe=6A21A0DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVUebi3EEp4Q7kNvwH81vka&_nc_oc=AdpuSry4-gB_GwpS9LRYZFdl2evWOJDBte0v0ke7w-clgJKeMs39BsqLJ2Ck6g0tSmU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6Z1OuAY4ineSf9uW-dw_wqPV9lMyqzmOwOPeRHNUsug&oe=6A218CED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFOBYnOopMYQ7kNvwHtx0zg&_nc_oc=AdqkCymrmGjxnMXaiWDN39S9RH-5LfjYd0IdxgX5DNFYWXd8ytAhCrek97BVn4Caftg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WB0Me9zHTq7ItRsU75cedisKYCvGyBTZH9yn56wUJcw&oe=6A217D17"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HZ-dekzA5Lc9VnORT7vWFQzwZ8uknTVouitUV88or-w&oe=69D7A951"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0j59YvafOMAQ7kNvwE3JRIM&_nc_oc=Adoja4-L9R4jDjpE5s60FhPNJVxuVD66JbqldpTnPNv0womt_YfUwJ-2-Cip-RyiRS8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gwyENlpjapis0TUsDv0H5KYACff6vEaeyzjGgNQr5oQ&oe=69D7B0BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5EztVQLU5UQ7kNvwE7PBhB&_nc_oc=Adoc4DKi9grDBjHGtU65M7pjVrG8Z4TmtNToLtOM39g8B-vhRlCBjNflAn7m38E77N8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yajqj_RlZBLdg70M3JxmSsZk3by6yK0YFU9ywGRYESg&oe=69D79485"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeNBjO7Ia_QQ7kNvwGMJKNE&_nc_oc=AdrexLhxcMcZ62PoXYMF1qBjv-eWIDCc0PZCHT5LcNt-5_UNRZAdMVIJOvcLwF6CKks&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qtxr7_9D5A5zXhJExSMUQc7VBlewE8Mfveg-LBhCCgw&oe=69D7949A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmApZHlXNvYQ7kNvwEkUh65&_nc_oc=AdosDKDXd5-qdgvpO8GD4tt_wgt40SbSzYfhGXNFu9mmzN87ohA8hskV-Ps-laFBsGY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35KnotiDcRx1E0N2YOqXyDR9eJE8mhUe66tT3q-ocm2A&oe=69D7B8ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oj2kMu-6jnEQ7kNvwFuZuAe&_nc_oc=AdoLMHDEqK23XjdN_P1w5yaV-dt41CYjQj8ZN2e7Yr1H9DXqEA_e2OjeLiLViPsFGwY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bjZolWHTHnH4aLBhQW6rIsnAtN7IR3UCFlh7DMouauw&oe=69D7A917"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8j_FcmGTQIHtTchqN_5IG2kB7d7_AW_wqZCtVejeasA&oe=6A490A51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lLN0Wc1DRAQ7kNvwFMlrA1&_nc_oc=AdpRaqYP5jQIY9A6boIr58b0UYtlQFdvermO8mwKX3QMmgsLSAZNjXiVpIkF0CWN7nA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0OqNFJLotwIfJZpYxzh1TpIcEjUrNi8_5zX3q6zLO-g&oe=6A4911BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuKKWD1fbt0Q7kNvwFcHjO8&_nc_oc=AdrA5VRmuCivSKJf98vjZiBjWZNhMvW7qDr5aBnl3_aCb02aC88PjW31le0Aelup_-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC77hhOvQRISqiTvjiq9O_-NUZFe7pYe3BXEvt5uPRzUg&oe=6A492DC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePxZaFXyaGQQ7kNvwFFVtt-&_nc_oc=AdqPce4IrXL3sd73Sj6gFWg8TASPiwFoMmB2jyija8aD6A4F9_AwBywiUKiDZMN9DhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ5RQIbAfW4YhZaBZ6tjH0Eb6o0oZ-semc26Xkd1R8RA&oe=6A492DDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ig3FTr7H7u0Q7kNvwGQc4Nc&_nc_oc=AdpByMR8ZFhtNo7WRmFJiNzaCMplaT-4fQBqFRfrTHQXrUtP5-_6Kpo3zPYVZ4UNqFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh-mQs2apAJSodaTFlPRmsvndz8b2n6VVBRLybeKJRbA&oe=6A4919ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK7Hg9vyMY8Q7kNvwHCk3yF&_nc_oc=AdpYnZdGB2nu7GWaEi04qmNOkzr2ALn16Yv97B4JBJH0EMYp5E9wDcr4q-olt7sWSgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqrQbMbOievGqdq8cIzx1KK7htPAti265PlMYhAn9C2Q&oe=6A490A17"}, {"file_name": "HickonuQ_1008x
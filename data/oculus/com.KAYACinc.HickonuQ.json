2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS1cyFo1bDIFsDQXSWMVCQPyNfjMoVtm8XJkbtR2UNbQ&oe=6A71E8D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54qruer932gQ7kNvwHCFkjj&_nc_oc=AdozTGCHHaSWUchCPNawsWRJiOjgTAAauaPbq_H-rGVVETE5TYRXOfy00dCTS9b5gDk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwOJx7b99FILw7BMd1IORdJs18IOXfycviczWaRGQt9A&oe=6A71F03D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrmzUnpwv8MQ7kNvwGh25i5&_nc_oc=AdojHYfMTUFiEcBwzEMQ5PIDBVh0Eo46KILJbxRgSWEBgpCduqDuqTxW_hEDalqLGhc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN8GyOozHnO7I4hTQSA_GLKfMIJZXt0Fot37XDpCNjWA&oe=6A71D405"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOEFU2ax-hAQ7kNvwExGTC8&_nc_oc=AdrDnGbpEF4GV9SedKXoaML93d7WXDCrL4JfXB3rnNYNOGvZ5DUcf2JN2TtolcyO7BE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiM-QOPeL2h7QSZBZJF9SgqDv9hu8KljGEUBsZ1sfcgg&oe=6A71D41A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzI7H1YP57cQ7kNvwFJfFPa&_nc_oc=AdrvTP277XtVeVTQIMRIHgX6OAIafndOGsW-jK7HelK1adGdPR2OPXjBiX3RRRrjwvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFga5WyMRobiQUFonHDmuNIVlcQFhk121n15JHwP48gjg&oe=6A71F86D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVS95iydGdEQ7kNvwEDlW2h&_nc_oc=AdrX-SojHXdltcz5LsaN-b3beX5w_ca0nNxt3sj-qj-ll6njXP2mnsESlBy9zh_WmmI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm99IKm6OVkWlgQ4V-DfAPg-630_u-FeAc3Xe4JD0vEQ&oe=6A71E897"}, {"file_name": "HickonuQ_1008x
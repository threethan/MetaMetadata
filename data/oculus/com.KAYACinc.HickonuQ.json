2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S7QMNw7O8zwolpX58hXeYzZ7fgasGSd_j2U7yLakjXg&oe=6A1EDA51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJFylfBkus8Q7kNvwFkgTKo&_nc_oc=Ado_JPotEAWuSSul7tjBfikbNWDX0TbhyzKwHRXnh041LOEwNfi37njd1zSgaE0ds7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VkNJPWk7xj7kUiAzl5crkna1IgFXvI60UJMfC7Nt3BA&oe=6A1EE1BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVKGoZ5zFr0Q7kNvwGU2ANH&_nc_oc=AdqXP_qXRAq428HorHAU3kwT6a2a894SfMmok6ZciMr_BFmjUWbHELcnWSePnCOwIKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eTUApksv4y83tbhYh0lahgI_K3NLGOsBxk14uca8uBw&oe=6A1EFDC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijYLi6Bx0b4Q7kNvwGquFYR&_nc_oc=AdpQF-bwSxg3Nc47VL0F0RCeBdChfNEDmba_d6hWuA8cbTd89gYSPUefqFnBXHGV_dA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VxLX6EnuFAZ6RnbNcDVxrTa_yXH0Qop7Jcfh3Frqnwg&oe=6A1EFDDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVUebi3EEp4Q7kNvwHuouNn&_nc_oc=AdoyU_rD08F8ma9VQbloLKU1tOIVQfAasQdnJGpdXtUWEHC05G2nMqo1RLvGfnBWHfw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C3Yrn7h6b7BjIW090QTqJzy38NS_mF9GQ-aqwcVUOwQ&oe=6A1EE9ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjuzM3dIQ1UQ7kNvwGhIfwX&_nc_oc=AdqjM65Kq5Gxc_xlaTtqym6-U6LKqPiKltcBpnWpFc3RBBuCeWevZhLMbB42ACVjWlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qWAPIXw719QG-fZ5-0XHL6zFKikdYF7Tqy0_E5F6j4w&oe=6A1EDA17"}, {"file_name": "HickonuQ_1008x
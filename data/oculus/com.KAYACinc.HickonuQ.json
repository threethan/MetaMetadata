2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16rKFxmRGbJaU3idgTh_Y1tQEUpsUcY1KzdvqmdS4cBg&oe=69F74D51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaamcOjN-50Q7kNvwGYylku&_nc_oc=AdrtGak3nxg0o11K-FhQV3BRgDiWszhspMqWQD44lPRDDnafTyRGrxPZVlJZaLAohlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1g6938f7ZDX-lsbcZhes8FrkYKieTBHzX9Qp_aqkovmQ&oe=69F754BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEgZUulCKfYQ7kNvwHlm74Q&_nc_oc=AdrLxj0MXj2WGA9jCUhSa3Zsj96jMIcv6Pn2dW_-hxxfDt8fKGi4zHHDuyB83vAnT1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GC0CS9jW68iLPN16nLw-l4RtOhxdVJpJuGf1tQPiKqQ&oe=69F73885"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8GYO08L-4IQ7kNvwHHhDXH&_nc_oc=AdrqE4VqHli2GyOVJLT4qWJQ4rxydhezHm15QsliGPRxpFPfmsRIhDSGWgaRiV0k4K0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OJWdUvz-7LQjjLjXgE84V5KlNvf8oKt73nigQ4elxDg&oe=69F7389A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF6AXYbec_AQ7kNvwFpKJp5&_nc_oc=Adpr9saMDDSaLz--U6QxmjX-QdSTgmGTjlpF1d6Y4apiATUfu2ZEb5ufgymop5UO3xU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28oc1nE9O8kFiR-zzGx8DooEzrvXKfGYM4lE96VWBdiQ&oe=69F75CED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj2HyQVs4pMQ7kNvwEs5aB3&_nc_oc=AdqzUEIQku-WpvXluvBCfyOf58gST0ILG7PUP-8yu8pt8m-QL2VvBYVyKlavXkl07Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13lTNUonMdYA2e7Q3CXfp3OJIJxjvtVw8KP4t2fIn0lw&oe=69F74D17"}, {"file_name": "HickonuQ_1008x
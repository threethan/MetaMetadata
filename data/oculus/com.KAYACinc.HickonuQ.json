2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwrl7nKgGdUzMUzvCu5hvfdA95JWMPbzX70PdVzcwtIHQ&oe=69CD1D51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mje5MR4f_Z0Q7kNvwF06jhc&_nc_oc=AdoOFZyEI2WbSGMvq3n_gd88FuKq3xCC5KB01qRFPu5-Pz5mmvWsu4v3hotkLHMPcCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyEyiXI_vQYr6bU6BdvrQ31vHK6p6oNhzyvVd3gTjXlg&oe=69CD24BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLe9NCNGI0UQ7kNvwHeZUpt&_nc_oc=AdqoDW79C2J8_rj7GoJMNafgtb4kbKnmvOKBpGOIsh-iRCmRwm-pjD0sIH72r9R4hwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVuDoF4-RZH3r9ij3__bq_66YP7UA0_DyHbBtQmOwNQA&oe=69CD0885"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_3IqimPIGoQ7kNvwEOObi9&_nc_oc=AdrprdSNPo226zLi77o5YK0H4ahYY_9NtlfevIcetUFJfxpWTuEZwX9ZKBFkafTnQuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHufxyC7T3yWer13w9_epdby-f2RpsHM78d1DK-quGmw&oe=69CD089A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFlcvtLl9bIQ7kNvwGON24H&_nc_oc=AdqvgjuZ1-_JUxdvEvott5dr2cbNtgHgmytL7J2Y0JKb203dAsfVLGZoURFdPcJRxS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn9D5fvObMLAyhRt5dcxKsbiF4N0FZcFgJn7lh7SwVIQ&oe=69CD2CED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhi4eqvj8IEQ7kNvwF25HZP&_nc_oc=AdqWiu4xrkvXh54hubyWYvWP4mNMNB6N1xCTmhWf6FdEhj7KJ4NtehrYCHPn1h-lXQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUb_Z5umkirCHtnGG9RmO59IPS91xQPdjN2XszNSCjtw&oe=69CD1D17"}, {"file_name": "HickonuQ_1008x
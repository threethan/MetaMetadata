2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4Z45smo2_x91ZZnnkzanUZkEFmjTT7vDX-2ZEN3JJKA&oe=6A5F73D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVXjm4oUqcEQ7kNvwGUZAEK&_nc_oc=Adq4Ozz2b1QkwIymtiZrak_sqTGKCJXiGRI1ywo19k_ayjZR8lCnr3fiJtx1lQmUJcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYwSjiFgyzewl_GamxhyTcNAKEoXU_1N3r_pJ5x2htEQ&oe=6A5F7B3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qde47g8q54MQ7kNvwE14r5G&_nc_oc=AdrGu7k5vh6LYYulr4tbvnNz9-G13dtMN3LbSN8X5qY3GsH53aPY4-6qzgiOVctgADE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAx15HfCC-nddNt7Q0VcblEiOcN2ZVcvWT1vd168GI1QA&oe=6A5F5F05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkG7J-2m50IQ7kNvwHArlET&_nc_oc=AdqOGjf08Kc95-z_CgYhb_RxMhzubYaJx4LP7Yh7mcQVUUx_0ACEok2Aw11KN6iDAZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvKqwUp1LfRjYBH0UTryXvjkrwyLiUsQ0tuCVb6skfYA&oe=6A5F5F1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mlGtf8LPIcQ7kNvwEJUuhb&_nc_oc=Adp1dIRA6kHGKmaziAcpIMkGQClVntlcs5xZ3MT1hcdNV5izlvVquipt0ZaZ4W2PVRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLTim4uMdwYlUCafBoBhmnTEaY_aj09w1Aq_CavhdSrw&oe=6A5F836D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVeMMsLrXikQ7kNvwG-ssXT&_nc_oc=AdrAH6xv5xb7e8BPyEFyYeG0y6In35uCZfTQ3z-hVtfCbRkdQlskSeS6cU-IRy6V-Dg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7HjhbJHP9Hq5X63MN4CXTKqWZR8OddHyQsiSCQChMKQ&oe=6A5F7397"}, {"file_name": "HickonuQ_1008x
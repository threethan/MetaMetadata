2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSRVMGbgXv8LkAjsWfX0eMItbV6hcSgHKqG8S_3vIgNg&oe=6A7F17D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C8R68mjXM0Q7kNvwFOugiq&_nc_oc=AdpAgoYzxLVy842SlsepJ_DEpYgq-aOBr1nfLsCD7W5F0cBQeKmPhzOhHvubk_aedW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7nqDLCCzDPL8otckVb9dpbvSdTNEHR3EsyJnc-2XUmQ&oe=6A7F1F3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY-GgMeWmFQQ7kNvwEa9NwH&_nc_oc=AdryLxkg9yP7uQ-8i3moDyp3TeWC_a516j-e1-eHWiS3k7J_OCe4XduyX32OKtEWpVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5N-uElAxyPZbRiICm5zTKgvXeV_Gmjn1k5Rv95g4kCA&oe=6A7F0305"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLPNLIAf9roQ7kNvwGNA44Q&_nc_oc=AdpS1bFr3iN0f3sAmYIJ9F4d74-rMGNSdLei-AG0myaSleX3Rt2mPtVN09yt1CiSIpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFHu3f4A50UCSPtAmEUguzy273WZ-3IC99p3x6OKEmeg&oe=6A7F031A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRDyfRX_684Q7kNvwGvHVd2&_nc_oc=Adrwg2rbKa609WteBn1lc3fcptCCi4ckn9ikvGXCNnu8qqzmMOgWGWDCkNaoHgJjomo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHANevzEaI1OBJVU-wU-Ql4oCN4SxFzMXWpAdjXwIiNQA&oe=6A7F276D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqJCpvI4_gAQ7kNvwGcgDag&_nc_oc=AdoXyKC7sSpRURBvPHaaa3RNpTFmq2aE4CEnxusucu1zbJvptngPQxJdBN6_gAPPDKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqdulVgpJ_w3iRWmjDfNJqWS7z1PTPIhvAIfdJRWcCNg&oe=6A7F1797"}, {"file_name": "HickonuQ_1008x
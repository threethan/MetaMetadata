2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFGwh_PNrdx9-KiXAMSvpgj-6AmZ8YiajaZZoGmW4LxA&oe=6AF20291"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxRSb35XOmwQ7kNvwHNOl5D&_nc_oc=Adqh0NyrS35IQup7S18Ep86tB6_AspUFqNQQST_shZFvcmKKtHv62b-RDlemSkEpoFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9S9-XHWKhNKBE_M37N1t6WxTg-VJ3kveb0ffiWwc2Dg&oe=6AF1D1BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSfduuNaYqoQ7kNvwEydVR9&_nc_oc=AdqEvQHsZgT3_cZIcULcczTOiomjFYOxrhTozA70BdsXUcwR5ui-sD4sgRK3bKKRA20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgaOce25KIGt0nW2oHmA4nZjPrcVAUhW7xezE7vvd3Bw&oe=6AF1EDC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyrJEjctrrkQ7kNvwHE76vL&_nc_oc=AdqgB-k7Ygss0eFL6NmvioPb5DjLR-qpjkgpYtPpDT1JAJLoemYBaL1Ao3qGSe3y9AA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG4Nd8VpMLB0uG0_xF6vC_q5asBNmKZO-mOBY_jjbJCQ&oe=6AF1EDDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPvHGVPx_6kQ7kNvwHHpt7s&_nc_oc=AdoYAiz6-uRURcAiaXJ9-LxCOjqwW9Wv7f3ajQltiyrkgdl2aWdhO3fmieRrdRged_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1DUHhUOTx52rHfQ_W3a0sXVTi5hbBjEGpZNWxNMl6jA&oe=6AF1D9ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ9EJfLNLJ8Q7kNvwH4Kjh4&_nc_oc=AdrrJVjtUTbvVNnTEeDe7Z-kvdFoJwZzEuZQ1arRKKodNAi78OyM9R4YreAcKwsRyZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUDN4e4fosgGaggXgWF2nuLA8zRNesGTkusQJWdishdg&oe=6AF20257"}, {"file_name": "HickonuQ_1008x
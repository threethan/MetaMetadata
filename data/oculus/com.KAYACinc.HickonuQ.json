2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-xDZq8rK9IHfu8KbINlImvzi3KOqIRou9gVfblqPMpQ&oe=6AABEAD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSx3S0RfkEoQ7kNvwHd9da5&_nc_oc=Ado8moXuZZ2-iDM5crXSINqOU-gxx7Z_7iHQDn_QJgm9V1kJrlo3qtmyPebFT1-E44s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYzM7aohkK-3gsKfZSlMw32dFGiumY61vK_DcRCY9i5A&oe=6AABF23D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huMKvO0EfFAQ7kNvwHVtVJw&_nc_oc=AdqAe_tx16hDV-L6uVgh4zmH0S846f2Hm_oKIx6i4rASZI0z2tuEBUzHC0IbFFt61iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8008KTCbHqpw4fsHanV721bVQG2IWj359XmdxOf-gRg&oe=6AAC0E45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jdPSAaf_X0Q7kNvwH12f2I&_nc_oc=AdrHmchVy9sNyeGkhooNIrfUPvXHuJh2NjY14EHDFgEJkRBhL5ZTErIUmH5HAoa9hUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOgu_K-jywAKeEnWO1ExBjA7m3KOlM8_tbqvZCz1342Q&oe=6AAC0E5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBA1g9pocdMQ7kNvwFFqzNo&_nc_oc=AdpUHHLT49t7uaO2tzRtz1R-tjCgZ_G05sHG8M60IIH5kR5dxhnd4wnqtZcd7WhE-IA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsX9uWlwTVWaNBn5bqG_WTrPaH33PFJbPev5ACYxflGA&oe=6AABFA6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4BsV7iBQTMQ7kNvwF342OL&_nc_oc=AdrEauD-YYOS43DHL3pNf2apYAfBY6R4Vm3g4kcxZzmENFDnKAXyv6BGfKERTkNs-cY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH0117qZmSolRLSrZEol8uHSeinE36F2nvN1HKxcAEHw&oe=6AABEA97"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-E7XJ137btNUTozIiLLVFCR7Oq3xlF9j9bpmyFi4dLw&oe=6A159FD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlRG2D9BCeEQ7kNvwGgwpH4&_nc_oc=AdpsWEQasU0SXfZYv_IVjz7RkLa1QoMpIEsnlzW6IryXO2dmYDZmb272Av9SMwrv6Nc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AaKYm7mOA8bnZzDNkP_vV8qN_PCYVy3AGz-7hY7A64g&oe=6A15A73D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Uq4PSsDm4oQ7kNvwHd7VsS&_nc_oc=AdpGgdepqhMw-n5s8JOplD8nMlQupGwxEATT3bAPHyqwiKqTZVb6GAx5SJgSnhkHQ14&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lmqK7BpSwvfKg3iuJX_tFusEBwh6qKz-L3nlsMpvpdg&oe=6A15C345"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ-xE5zuvFwQ7kNvwG8gbKo&_nc_oc=AdrvRjSIo1OCn8sGo0eV9dmI5qMv2X-s-wqdyBe_iAUEhXtCALV0hytlSDnAmgIesVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HuPijzkxfF2lioDhg6AuhnFghhOcOCXBNYdC5hbJe5g&oe=6A15C35A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBZNQeYBQxwQ7kNvwGjHHfJ&_nc_oc=Adq1jljycp2Gr4OiF2GEKFwstK8V1U83JOgptF1-ddw6VSM1-1ELbIexT_DfFYoSIcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h4KWGR0wAOX9k93IQpidJdngxqSspMk3cjfPbAUTLFg&oe=6A15AF6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fARVitYLS0sQ7kNvwFnSvCy&_nc_oc=Adqv3Lsmub_ul4SMf9g66dhm6UicXetHR-7Y2Opl7ek2ygm54-7LGgoOaBijkVS0ldM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xnWdFnTeeDV2wNEEUmAOdi-U3Qthc4npDrZaXgwipNQ&oe=6A159F97"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpOBF0kaAAYvlhvCDhB1wkCJsgQ3dGNjvsfodF9nGjcQ&oe=6AC102D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reQxFqAQHpEQ7kNvwGBt-cp&_nc_oc=Adr-CcZl0oNH9oXzIZgjShWLEtfyVllntTVFwMwF3ivG0Agg-k0xo9r8MHljmut16ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsxSbtkdkNiL9Z0YLlnVIa-7Np9imWInxmfnZV7Xop8w&oe=6AC10A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_gs0h8KmJEQ7kNvwEPa3ni&_nc_oc=Adovy9nqhrA-_8tuwVRbdropaO76k9Em39NApFusZp7OyQrMF6pS4dHMhblDcKWVxbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMC5tgO9QuBUHfFrenyYIe2k_PGmOMkPAmCIpm7vlvdA&oe=6AC12645"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z_ZqWnUiQ4Q7kNvwGmBgUV&_nc_oc=Adp7zZ2wrd20bWUthk-M1dRzAqCLRABBmQ25HIzh8G0sscVixBNLauD5zimyfC_9RLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAtw3qNiQwvI324I9ACcZcbnzzJ-Bj7KPQ5VwGsI_OCw&oe=6AC1265A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Xj8mWxL6nAQ7kNvwHRwRMZ&_nc_oc=AdpHA0WIU6EIhthaycUhHOhvJE99vrncHqBQwk1AHEqAlHneL9icjp2g6EClPwhYcjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSWzcYgGuVv6tXjZ-opQoHTYq6pqcfUhWw-GuMfAXt-Q&oe=6AC1126D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XXk8P8vOfgQ7kNvwE9HArW&_nc_oc=AdqF-vHNob-oZGEhXC-SsWabISbDKnQIJEGdc2CIeXtTqpnjUN0Bxu6ws2efwShA3Kg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1SaKBrAxrvFOa4QmVIE-l7G-esIXefA0VjcQlIHKjNg&oe=6AC10297"}, {"file_name": "HickonuQ_1008x
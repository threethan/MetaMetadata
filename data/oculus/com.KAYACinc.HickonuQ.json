2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OtSGV7lOmIX-6DfP4z4VOHQszwRwHcblYGTVicF2h9A&oe=69D657D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J21APF0mvzYQ7kNvwHtdweL&_nc_oc=AdpQzS2SU3rPklDovfIeA4XMVer4m07wRv4Djn77iLhcL1w8x5kxSRoN9MnBnjmUltk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GMjZnv2Bgx43DYhcRPtIaDzL4ML55dnGi6nOdN_I70Q&oe=69D65F3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5EztVQLU5UQ7kNvwE4Oy34&_nc_oc=Adqk23PexaWYtTM1i0HEBUctyhLSL06s4_Q-Fpllg55xwDezeV2-eQ_q4yufwyosLg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mGxCPCWuaBsw57gfjQC118oQOPIfIiiPqLFu1E_Rlhg&oe=69D64305"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeNBjO7Ia_QQ7kNvwEIBIyr&_nc_oc=Adq4pRlx6XJaBELeim9lXKdlAIqITsfjN2woyinLzrjeLqdvFfief_0SDZl9E9HuNTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tW2OoRNJWjcjumiPiYjIDxGxCMfzvL1edePt8lqXbww&oe=69D6431A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDZpldGwOYYQ7kNvwGmJPF2&_nc_oc=Ado4S2e7NuGdg8RYCz135YbN3Fe3XTJD9hR5tV7TkDlb130RFGgRYlmD2LgZIjMm2jU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ljW4exHGaUbgm2IbYh1coqLh0sTcij_x6keemEpLz0A&oe=69D6676D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oj2kMu-6jnEQ7kNvwFnq57O&_nc_oc=Adq5YFqoJmwgUrfTnEWdgIISS2KTjF14H-ZGoH2T2zLqCBOPsCzSAu7xfAaZXyL3YMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02S-iblH995vK9YCWXGEtpFME6VH6ctwklzI67HWNHgA&oe=69D65797"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM1U2FqAOKX4xoxU9xgTV1PTGGOS9QMUw405a6W2noQw&oe=6A6CA2D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYZoLjqjZqQQ7kNvwHuzXh4&_nc_oc=AdofDPHSwbovlnW6JID5cUoR6IHvIJ4IyItMb-ARkb-bSUMvfzYYQx9jGV72jVewQC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGzXpQ2NLiqq5_Vp2WtwNGe7F-nKY_GqYLvahivgRQ-Q&oe=6A6CAA3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxCPp-oA15MQ7kNvwE8ndPD&_nc_oc=AdrspPE9u_CTnz_fQYvdipKgpfLpgfNUDWCW0oBZCZN_VP0kaMmlNKKYLt7sym2R_rU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmTIfCqs3-0fDiwhrkcCKd2Shv5SKc8vlYjDOWg16ruA&oe=6A6C8E05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmvFrx2fVWcQ7kNvwF3_EVs&_nc_oc=AdosFUPU1gV7TLeWCZ7xPZ8Aa2nyYkXN6KAYDXmnHFr4YghTe0mxicAM2AsLTF9iS1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYifM9ui0eQPpScvt5_zER8Cd94inTeUhwWvKV9LB2Eg&oe=6A6C8E1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGBQuQxbLMUQ7kNvwE7S9WG&_nc_oc=Adoe53_1gJ4D9FOUKBXmnAEBEjEWIjGakT1HbIO3OBQt6RotJrczpRXatf7gB0y_QRM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdUkdTLiJHhZtzFALFcLW56uB7M-bO1HXokLKdZF2XBA&oe=6A6CB26D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbG1uasqtxYQ7kNvwGrSckj&_nc_oc=AdrAowlWbo9SjYhT6g5DZw1I5VVcr6QkCHJpUbzQmyE4imutl6w2I7bjmCasuvumLoU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGuZCIeon5fh5zHE_FCI02sznVmntWwh2ncFNxB4VH5Q&oe=6A6CA297"}, {"file_name": "HickonuQ_1008x
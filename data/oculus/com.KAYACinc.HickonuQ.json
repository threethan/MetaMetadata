2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgNwv-KefWlU0TvlpO_DnKPfmPzp2N6gS5_EwzqnoZiw&oe=6ACB8ED1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnvOfczlqL0Q7kNvwEAz3MP&_nc_oc=AdqoKTjcir5KRU8Teuvi2FvkPy-tfL7fQ97Gtv6rBQIqviUj-9n-0GrSHCS92jCpGyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO41vekCqDCva6w12-Dhlbhe0wcGOsD9Z-ZXBt6m2VuuA&oe=6ACB963D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv0Jtw8IGeQQ7kNvwGTRrEK&_nc_oc=AdqVNzj3pugKk9SRolmKRbQLh-DGgOQ3CgHhh6lpC8N-GvKbUNh8YbQ3fTc8lwArOGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgfrO45yeZmpm6xI7DPPcl9gTeQSaHYt4ZGi0tob4X4w&oe=6ACBB245"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ-Xktc6NV8Q7kNvwFC6bA6&_nc_oc=AdpCT-e-6n2GNPLtEUZbqRTLUGsiaHp3c3DvPRbScbUhJuxDzb4BnSHLdaqHgR83XOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMybPsr4w-R7kLVRHj9PrA4cjJNVkogExZpHG-QcIZFBw&oe=6ACBB25A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KttjsQz18SoQ7kNvwHRScRz&_nc_oc=AdpsFUUEr0rYhBuz5j-DbuF2A6eCcehn-KnzYkzGFeJ9NjuEOoGeDEEtdSRDKZb2Mnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPjP94RYun405Mwb8bgWsIuo_NCcfMtnB_yrCkf2O5qA&oe=6ACB9E6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QaLQqulMCQQ7kNvwH2lxpH&_nc_oc=AdooqBUPQJKNSdrLziPva_A_yRzvoJb6WY3-RcBVgHoi_l47BEDl3i44JXh5uK-N7Yg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOax3lvkEbulLsc3N_foRfd8knajAsXduBzG9gVMOVNFQ&oe=6ACB8E97"}, {"file_name": "HickonuQ_1008x
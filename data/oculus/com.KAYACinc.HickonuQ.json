2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqvt7PO7z6NkdqkykqtmlrQas2KcDcd7BkZXoQ1Upn6Q&oe=6A985C91"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utW7FVK019MQ7kNvwGC_oDD&_nc_oc=AdqatbkamvOie74cLKTNM9iGl-5iqdh5WQAPQMYHD2ucnmWyvKgCw0nZ1ldH8ExamMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIINEZOEaDCzlS1CbgBrpKOJBszUkcX5MqHVIoxDz5rvA&oe=6A9863FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sDrfkj6LHMQ7kNvwEZVxpx&_nc_oc=AdpqWWDEmtUDeFz3G_GB-biE-JFh7WT7N0A_vU2GvQbnCr6oODyNfglPV3tNrXbg614&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIboL3_5LW1fMgyVVLsgw5c2DDjInr4SmNCRlnTsd-zIg&oe=6A9847C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Nn6Hz8l7BAQ7kNvwGBbNQ8&_nc_oc=Adprc1paYcF5RxqHPDpKkfFoMKzC5kxeTYzaGfISqzEWAhpd51DQdtz-Imb6116NS0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuorbKXfVPzqP7NQs96yUPTHgZxCbmljvccMVyI-y0dw&oe=6A9847DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBjSJuRyMZoQ7kNvwHy_mi9&_nc_oc=Adp1Fb2_B1oUP7RyzkuUuJuAruqBPi_7Ig7XEthmJUXFINjbMtt4v_Qfv0YGyGMV2XQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXr9avUAeA-8msU6pqXSeYA2LOHnCe6T3V1xXeK4Irlg&oe=6A9833ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efzgLgir0mMQ7kNvwHZCMoQ&_nc_oc=AdrUnntZKVDVs7VWG5FtadtnwaXE17DPjmHKr7U_XdsUqtzdvF25SMpP8QA1wgngBRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLEf-tMh8bxFDA2tpeAAhikB8PkicVTuRTpr0uWsW5BA&oe=6A985C57"}, {"file_name": "HickonuQ_1008x
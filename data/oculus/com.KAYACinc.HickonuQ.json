1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SbL-gHnZaIUvz4XxTm5nb5Qxa6UqrC4ZwdZWNtpmqZA&oe=6A26C351"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tec2B_vp2UgQ7kNvwEpVHDA&_nc_oc=AdrwzIdCrFcCqA_Ob-BrMLOOVGEto6syN5VNHDJlN9JJKzIjDwB19mjCIgyxhH72d6s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x5bl0hSJyVAjVZo2LcCcfa4NlvLPNmFBshN7f-cWr4Q&oe=6A26CABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNlfZ5qmZBwQ7kNvwEAlKFb&_nc_oc=Adpi47y1IJrm1nRo30xe4UPLDXBHcTQ6ni_4jptzndiduhG-tR594b4685T06lsBWVw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8emP-9us_yiMQ-rLCKN4JhzvnP4Uw6IXVL39rqH2Y_0A&oe=6A26E6C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB-Ff4vbeQ8Q7kNvwHyiG5o&_nc_oc=AdpMj6-0ZU1EP60QOULDJzYrpkbKuNiHk7u9ptaLgu_V0f6QaZAgEpYBXQQVX0NECW4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TYcz8nOAy6CbyK_68aOxaNBZAPKt5kVz2BflASV4OjQ&oe=6A26E6DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYUY3Zad_5wQ7kNvwF_VN-8&_nc_oc=Adp7KSGHCSHJ1p_dOAprY61LJ8vIK7aIEQZVCWpfxHxPalnsvNJxonF_3BlVPuEf3ak&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WcFDbJ_sQNL2SnMCiHmZE_xM9EAXlJGTep29shl24dw&oe=6A26D2ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU3R3crtLjEQ7kNvwGg25Z5&_nc_oc=Adqjod8uQnZ_c7WxHeTbrnmjb6GZNuOk7GvE4nVuHXVW8DSLk12uSmF1hDCVVdk3jkw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NX7I5qo9VVCZuYmkj6Ya6FMH9p9eqB_lpcjQhll6VSg&oe=6A26C317"}, {"file_name": "HickonuQ_1008x
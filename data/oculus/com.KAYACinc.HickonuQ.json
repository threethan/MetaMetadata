1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzoxgjE2JPsxmwnFLTbRjOB-X5Y1jevuBXa0Gp0TGwow&oe=69C7D751"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gH46YWbUSkQ7kNvwGqO5c7&_nc_oc=Adp_VRVCsupWmYAuAVo56RskJwNJb9Wkcmgc5R477-u-pL5thTndzLs13XnsDjRy_-M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyyt9qBQaskdNdrAUpyg4mHAYTBMKNXEGlFzqqGbk_CcA&oe=69C7DEBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJg5uX5gkwEQ7kNvwHFSIal&_nc_oc=AdobZ33iIsm1wj6s4ItxSiYnpRnlpJFdyxziFJ4yiyXmKpRKVIcMFTQB7ED75LG8c5A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyv3TTDsnKi_0FOr-SoCnI6TnmnT8dH5Q__hc8qx6UfYg&oe=69C7C285"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98OwkJdIiu8Q7kNvwHgzO52&_nc_oc=Adp63srIbEJ6mIxqGT33OYFQqinHCCyNvl1cBVaZXNKlqY-OC1xeWojk3TnZ4-jAQq0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFSXCfGV8vvMMQT2cakIfQjdDWQxgWWcMfg7jHM7dqTQ&oe=69C7C29A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnqUfAG7fiIQ7kNvwGgUq5X&_nc_oc=Ado2l4OhsgA8_WafnHv69UPJoD0OxYen0P8D4l1heUnIpWz6xTOaHvSHB43XTdWHmWE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1s7K9frAJ485PvvcdC6HrZhT-0hGanTlzsHQrDeQJ1Q&oe=69C7E6ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsEdzL5IOFEQ7kNvwFoaFha&_nc_oc=AdoSCdRZotMh6p1Mv-CBFQaTEHCZs-K3QfM6A6ohmv5NVSI3KCeqx5kLp8EEqkMBnrY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrxEOJKEga-LBSg8-xr-SLGW_9Yiyz7bmMTtBNMfbjTw&oe=69C7D717"}, {"file_name": "HickonuQ_1008x
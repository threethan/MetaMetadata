2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv7kW0By_wXwkilvYG3GCaI3oOQ5YFGS8BRisZ8COrKQ&oe=6A9AC751"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYO2RXhdqFwQ7kNvwG6CejY&_nc_oc=AdoH7hW1VBoaBVkh_JshlhWf36RR1ghXXQuxyZ82IELRctymDlieN1iKkiLoaNeQstw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXSgh0lMU52_kBEoLBfcJeDWPen5yqNAMuJBXg4BbxUQ&oe=6A9ACEBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sDrfkj6LHMQ7kNvwHnTTw9&_nc_oc=AdomJR2Nw_7s7MI2BjNnrVS1bTNch4BEx5VTmG84frg9wKAvpdfm4l7z4YCAO7p9maQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcUWKu8Tqrsszx-fWG7vF5ZEsnrdjx49z5rB4BaSR0Zg&oe=6A9AEAC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Nn6Hz8l7BAQ7kNvwE7K1k8&_nc_oc=Ado_h5SbpRPqEuoAg1lprg-aM4RDu0Wh6geTqaq5j6BNMjcg1mHi47LD2dnzfIyy_SM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzuA1KB0xtuD3vxDpHClNgygmky90jzJkkAHx08hM6GA&oe=6A9AEADA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sruibuJ3uz8Q7kNvwH_oIRV&_nc_oc=AdrBRz86wajEoUYfbPG1nMjibnaJ9uw5wt0z5UCKXBs9lwODZHI9fQrTh8GIbnl34LI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPzlp7btCYdLJLhgVU1EGVrb14CgSC6EYPKkREGSELWQ&oe=6A9AD6ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efzgLgir0mMQ7kNvwEu61ib&_nc_oc=AdqUG-09zZdhiHAuaVbwRrYRWHUfAlVIq3ipBtvngCF_rL6Ydg6ITsc4lum3lr_NmRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuoz2kLpfQuyXPnOIWQnHjLMfY2eeyLJCC6Gj3PIHFFg&oe=6A9AC717"}, {"file_name": "HickonuQ_1008x
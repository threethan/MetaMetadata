1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeGb6zmxB0SCk0zJLdDl0xy0mgL7cy1k5pDkxfRFHeeQ&oe=6A830C51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0nfAUvOIMUQ7kNvwFdMg96&_nc_oc=AdqU8j2oT2H3worLgBQnML2PrkNJqd6MZBU54Z9Mj4-K74ewAZQlvIjlLTNsg4963Jk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFezEilTuUunkkY8vOi_gweDPyJ1So6vlxs5VqHRq-hsg&oe=6A8313BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbQYO31K4LgQ7kNvwFKCsLn&_nc_oc=AdqwdNccgYp7r6nW3USr40nLm1D1zRkN64rigX1s3e9fqF2e9w_KEk8JFFzgP690YoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQiRUz4ZUAzqDWnUC25XnKVEFTQSC0vkRFVrsWea5WRw&oe=6A82F785"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAcmQb5kfYwQ7kNvwG3qOl_&_nc_oc=Adoj3Tsl6yyehpA0_46NtZxMhLWGqEyMXCopfdHKn2NZVLAUSMznFgyatcuDSWSNSck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9W5VJ_6XwVLFckT9BRgmXHIWFNnFh9HvZ75OJQZhsYQ&oe=6A82F79A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SewrNPhgM7YQ7kNvwHwcdAy&_nc_oc=AdpGQi2hlKb-ecfjo0_inuqRTqOenBSVRjgEvU7FTKgUUyJFd6nRWuajHSgwAjSJIWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxIZqT8BX5FgG6GebRwuTfzNd5Y687h_meYp2A9NFk7w&oe=6A82E3AD"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX-M0kwLOO8Q7kNvwHDNnWn&_nc_oc=Adqs0u05Exm-AVib_vetq31nYR5vtgYPQNZqpGJ_CfV6RDb6liBKBeGGhSMrbvavWcw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe4slZKUwvJBRj2F-s_qZRQQmSGCa5uNM4zJiqxaoZtg&oe=6A830C17"}, {"file_name": "HickonuQ_1008x
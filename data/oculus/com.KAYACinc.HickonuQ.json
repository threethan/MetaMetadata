1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV_WuAn_9mZThvUwn56YHEA3PVHcMYAnWnLsm61uJTdA&oe=6ABA6B51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FoHnNLCvhEQ7kNvwFEp3nZ&_nc_oc=AdoW3oBwbA4CDoK7IhiAL6lb-72_DDCk7CnaCGjYQgdJkTuTjzxnynk-P7OQheDON-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9UYHtm85H6qUttMu9kCcf4mCxwlF9SENDNGFxJit7Sg&oe=6ABA72BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogNU86NTwIMQ7kNvwHwSOXu&_nc_oc=Adog9KmJlgBZYWzmooVcbAhqTAUIbGw3B-DSSuv3lZK_lmbEDNq58451BsLuDfb1lHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNXW4BqYNDpypgLqujq5vEGx6ZUlXE73F3u-m-GHrTIQ&oe=6ABA8EC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr6kr5KZCkYQ7kNvwHTzUe3&_nc_oc=AdppPhwJb9h3TqHR2IgDWiTmUe-qOkdMxIHFK6oqo_5yslaHYfA6M7XMUvPNGQz6QMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMM2GYbULOdmDbAYv4HxkmjEXIXngdvqZzwKXLlkZa1g&oe=6ABA8EDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFB5dLZcCm4Q7kNvwE7sLS6&_nc_oc=AdppZQHO2OEUPOcjcGkJtuDyUfqA41Ske2Pb2l_UHTJuUeBwLrjGnNVBI-aToqLq5gk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdtAJ6-gaBh0MK7eAlJWOfAWdp-wdkaxqZaazPTNmU-g&oe=6ABA7AED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwkeG87GpycQ7kNvwH3ECkN&_nc_oc=AdpIoSfabe8gSkd0Q9MtSRA-K8f2Hd5XmmOT8E6_h0dbfyAs8PwyO9WmctdE6lFE2vI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN5tuqchn6KTDF5u7doZ_kDC6Yk7QGzYSLQ3Qr3MCatw&oe=6ABA6B17"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64UBxE29CHnDPM5UgKHMe1ZWYGSWWLt4-A7rzNyODilg&oe=69F9F051"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaamcOjN-50Q7kNvwEY0CCe&_nc_oc=AdqDGsv09LUAA2bOXkklIBzWQWq-emBtUeQT6LIlk-9e3Jvea95Y3rsqCZI9O8j3ob4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gStcN6MwOZJFhPAmFF_a2N6PMEHWXzJWfPpmolRJzCw&oe=69F9F7BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFFdu7ofs8UQ7kNvwH8p6Go&_nc_oc=Adr_EbY85e7tFa9Wh5i0aFg5V_L9vVkUUVnjFi5hI7OkpUNM-BWRsjtSbXik0w8f4ZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F3yERab-ZBgXUz6RtjddeRg6INVH-0upqs9lgKBdRXA&oe=69F9DB85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0itzSaGIqogQ7kNvwEgjWii&_nc_oc=AdpP-3AdMFMfzKN6D3zYXmvT1PoAgOFjonS07TBJDOr7vIAsRC3gM54cEtz9seVhTMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VAVBP3WfyL7t33cG7R-KGBgKP13x9JrbZ13uKcsAHLQ&oe=69F9DB9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF6AXYbec_AQ7kNvwH0DaX8&_nc_oc=AdoGKw-fc8Dp31KDVMGUhTUDW5HY_1KU5T7FOc_pCvlrnQs4iJQAD0G6pt9Em0GbBuA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5knw57omV0OCjMRN1P2GUiFW92LQz50fFxe7RdwVnf2g&oe=69F9FFED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe07MqguC5sQ7kNvwF_uJ-K&_nc_oc=AdqtdEHgjVtFIdPSF6cyjcXlONUfBcw-DWElIRrOWAX_YNPaHrqHCwXdofSeLnkeXUs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ELGE5jlKV56XnLGI8XylOgSE0JBHvYGeOxEJrfDle8w&oe=69F9F017"}, {"file_name": "HickonuQ_1008x
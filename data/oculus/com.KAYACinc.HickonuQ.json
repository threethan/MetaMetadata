2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE7E7Ud6Cw8jwuhAUvrAeRkS6pE0H3A-4bpsA7CBrEjA&oe=6A675CD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMl8S0sUx38Q7kNvwFxuejM&_nc_oc=AdrLdoEyJBIF60FzXq5t9YgJ3mccCe7s6mtC9l0FA7gw-runJBrNhbjnJPNWXsFWEpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_qi7LMfnUcIZEj4LecyhemQL25XJvoN0ugxSdgMj41w&oe=6A67643D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqZm7F9DqncQ7kNvwH_bJLj&_nc_oc=Adr9LsY4p5ry_oqFg4n7f-VWERX6zi9JCZyZ9b173omFPCU-ObIl0EfgFF87YKf-5Vc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp3bwfKREowS071C0TFO-ej8_TzQjZSA2uOd59RWxFTA&oe=6A674805"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu6x1N8CrEIQ7kNvwFqvY7S&_nc_oc=Adrt_zczgNwg_IX-YKXTfTkDlDrC4OPWKBUN4f_tkrMMFQ7EEorgofeuKF0mgEvQsqQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzBAT6uJhqRwA0ebW4oCwuox294VPYlvYCrlcJXvmbMQ&oe=6A67481A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTENWKc2W_UQ7kNvwEmuHFz&_nc_oc=AdpA3CEBmS1jbSPMq05MCrXBP3Gh4o_fpK9Lb35nwHelYis8x8pgprlI-Yhb6I_H4ec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsJxtJY_dcs_rL2TbtXw0Yq1xuafDsl1Bgj4K-EFP0gQ&oe=6A676C6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8I9QiPd-kIQ7kNvwEvdWxk&_nc_oc=AdqWKDZUc1mjtfgN_vjTRiLSNOR4sdTV1oVzRBcDi7erp49kV12afRSXA4UL0fFJAiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv9wbLbsKgDxJFp3m6UX7u4MFW1nMOP3dkprfsXS2fxQ&oe=6A675C97"}, {"file_name": "HickonuQ_1008x
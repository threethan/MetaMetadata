2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSjv9_OEWMrLsrK4oj0Hq5jV4jq9GwdZ4pL3Rh79dDPw&oe=6AE9E151"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSvgRB0px14Q7kNvwEZU7_j&_nc_oc=AdreGC6LAHFbbvYcJuKQQ7LeIs2eNkSkUWqsB8u31rWCXdYJ0tR9EUgBJDvyp5JkqKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSdrMKSVurSAetzYES1RZuQrZTB9pfPgL4U3gdu8s0zg&oe=6AE9E8BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83YGlg-wZiAQ7kNvwG2nZrk&_nc_oc=Adoe6DLDpbj2klpr8C2J9cnuSOIMV5dJrw-U-vs_e5vUko0Oe3untQs_YYUzxBmTdbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQejZozTrmoBX02x_3oOioZY936773lhcanScJXOAsu2w&oe=6AEA04C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2kc92TYLrgQ7kNvwFtZ6KZ&_nc_oc=AdrvsYVekyc_eWpRyzT2TCOMI6ZYZWD4Mh-ZH6VhwZKcqGwbhRgTCUavmCK9InUzk1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSib-D12er4PzNOm-gDqNlEAkAJuCbslKlpIEP-UrhOFA&oe=6AEA04DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8xF72aoXjQQ7kNvwGHvvEi&_nc_oc=Ado9a6phhqd93CAVlX9wqjIMFLIOxa1A7B7DXw9mdYYeHiIqtbFOESRC1Cy50IqDk6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRac0sSM1WKMTdNlf_x1wXjMnDNIS2at0Xv51Wc1ha3bg&oe=6AE9F0ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enOVVnnNjnIQ7kNvwFYpbCJ&_nc_oc=AdrF6g8CzEy0QwS-v7dU0r8cVmPvkUAuayXOe9ipdF0ajr-Yzv7NCMwI9iMIde_FQN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZCMM3_igDM3PgFkKnPdDFsImHfd6LEq6oE8t20b9lbQ&oe=6AE9E117"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ko0wG8bx-DQ9NFEm96qTj-fcDIw-sL0nUHpb6KzNkdg&oe=6A16F151"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8VD5NDSGLUQ7kNvwHnqk6e&_nc_oc=Adq29x3s0MybfQVPjBObJJGXAPIRfeMTRgvFtrhVRBknw8A93nPDKJIyRl-0GLmYfu4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y7tEK1n1kwwzpUsj0YAPZkw2BXDuZznesEIap1nSpMA&oe=6A16F8BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Uq4PSsDm4oQ7kNvwG9nGyo&_nc_oc=Adrjl7Z36xm19FrYXUGxzPqgjXe1xTZd9UrMVUw0TM5uEMFL6E90eo1pi1sjN2mKEe4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w-J3YTv7gqOe4KW8uXRNprnLCiBsTtzw58rVsadglWQ&oe=6A1714C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ-xE5zuvFwQ7kNvwFysiM9&_nc_oc=AdpQ564Vx32XTgnckt8YhDtddXTt6Esft7nhMF-7h_jcFVNJun8O1bvHoZUHVQGAOWI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4po4riop4FayEV3bEMkpCsFWBZnsHLomUnZn_YVESWNw&oe=6A16DC9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BexnnlEHnVcQ7kNvwEEPewp&_nc_oc=Adorrwif2Xa4BRHiI_vIonVDQz9AvMfkOymqo-h0Al0st-0y5edecB4hplBrmrfPc1Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ziq6h_J4XfhaT0AbGGSkmhMQLBpQ3lUgOwjl1iX8N2A&oe=6A1700ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fARVitYLS0sQ7kNvwFQ5obr&_nc_oc=AdrSuNzbB9NWBtq4sw3a-BfBdT-kUu0BsBGn76Hfu2Z8HHxjXeSgvIclSs1dXCobG5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LEDsx4jwoNE8Z4Ypfjq63wffm3dA8XDasTI1RKjrgcQ&oe=6A16F117"}, {"file_name": "HickonuQ_1008x
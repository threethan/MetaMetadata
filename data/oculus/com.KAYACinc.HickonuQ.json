1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rGhstpGPaoww27dQFz2QhhjCLg-7eA__YywZMKJN51g&oe=6A2C0951"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DV7hjNTaxQQ7kNvwHogcEq&_nc_oc=Ado_yU1KCCnxjdgS_mQrOMnEuiII2aMKBj46LZlYiT_-_z2_4Uu2hCVHWgVZGaAdGwU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vRZkwlc_cQZ8fhQgudRyQ2RTSYyh93Rp9xFTfDI2SlQ&oe=6A2C10BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpY2hyDNshEQ7kNvwF00u7l&_nc_oc=AdrjYrZ2QNhyxa22qWSqL1dUhQjwY6reBQjKN0yw0z_1JdM7GzjfAuV6GIbIVxfzxdM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l1XYIWgY81iF0W5ejMBQn3uR8epTAS-_JyTAurvG_KA&oe=6A2C2CC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i291NH4lYokQ7kNvwGE8cWW&_nc_oc=AdrcK4OT4gsIw53O5K1ioEiTVFaDksfl43mFBmx9QIn2CKev1G56LJzP9hl5quanPt8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZEf3vrZTi8-9zzze65by8fzQGjyG7I0A821k2z-EcVA&oe=6A2C2CDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL5W9iE3AFkQ7kNvwGItU9G&_nc_oc=AdqrsEPbQ-zdnEvquNb9kFX2tdGMJGb3Tkivk35bI_O-SnOIhZrRjQCpeNxx6XcPs_8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RyPEdwittq51exrPuFMjm4Emb0S90dfW6O11BUhbDyQ&oe=6A2C18ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SedaxHTbZoIQ7kNvwHliFTE&_nc_oc=AdpAKHrdCG_d9UuPdKJ-Hu8WIPWW6KigkYZ7lk6YrQd3aW_r4HUSbXuymKxK1OlVU1s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YZZsVoG1lF_Ir9wjhnRQwFU5RywoTe6AXr9GAaSqf7g&oe=6A2C0917"}, {"file_name": "HickonuQ_1008x
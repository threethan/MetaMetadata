1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwA2KncsoF3rEgMHrTU8KzTAwxIgE1lipQJlBFCry3Weg&oe=69CBCBD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mje5MR4f_Z0Q7kNvwHGip1q&_nc_oc=AdpYSVzSHpt2TIttoZ4wPWJCcvyVpY0dKFSpMtliWShiWtfErg7TqbHfHJ2c1KRiPwE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcYz-tKNyA36fW9zRFKt0YNzjXJqndOJ7_qR677ObJOA&oe=69CBD33D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLe9NCNGI0UQ7kNvwFQiAUE&_nc_oc=AdpI_KZVdRLMC_3giEKCJatZt3F1NNrI5buFU-sznFILfOFRdvDHATRGpy3m-bl3Ljk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi_xHV62EstqKW3vRCmOWDaD578fRJIPF1WNwJ0hdJ2g&oe=69CBB705"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_3IqimPIGoQ7kNvwFHu1qZ&_nc_oc=AdqkJz4rlUHL3A6vx3MCKPa5DjIqs-wroK0mnQhWf-ddIPpTDrfMOHTfdsCutG72fkk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLI9DCaMcGagE53OnZy3NJIJyEiJTB1CB2SnRDNvkaAg&oe=69CBB71A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFlcvtLl9bIQ7kNvwHp7zV1&_nc_oc=AdpAcM9gsqhdFwE1KUCYNc5u-8fDfGRH0wYgw9YtTzGq3oL1mCovooEv6I1ompU05YA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwodMqKqtBo1XAPqOHBfiMb_ybL3vmhmnD78pcAAzUJiQ&oe=69CBDB6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhi4eqvj8IEQ7kNvwG_jj91&_nc_oc=Ado6dh_idTdmG6lVeIjubmlYVYvdYrwvW1pia-kPoUoG3_DKDhvp33SpeBq5k9M31As&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcEGOnLDBzUp4uOmRHWI1iHGy1VvjsfBawKQoKau7ySg&oe=69CBCB97"}, {"file_name": "HickonuQ_1008x
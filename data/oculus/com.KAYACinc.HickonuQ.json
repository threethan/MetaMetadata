2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zMwUNNavT8htgw81bFH4CcUJUhX4wPm7E2bZJZljEjA&oe=6A37E6D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NliHSXmEpksQ7kNvwF_nB4G&_nc_oc=AdqYTbvYOh9TFThMP1TzQv187o8z91tfl-9pE9FgLHbW2fgk-2HB--CIDsYQuef3Gj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PgNercl4QK3eMzq0_db7YJkKAlIBSoHiG6vc2FvwEcg&oe=6A37EE3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1COLT0LepwQ7kNvwEEuFep&_nc_oc=Adqh_PwSbbJsCspBoYdGsdU4jitnofXskm0ugxvwXMqNf2WoJK6ezc9XEPQWCmVRuXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HmzeqotH5SV-z1P3--7UUjrUy2Wt0grC0XSlJ5Huxkg&oe=6A380A45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px2X7KqkwfwQ7kNvwGYKrnV&_nc_oc=Adp_beK2TM4pNGz_FxHifbrG5lHySG6WKZXbctkrB86aoXsmBcvFkAb5y_2EGlo05DE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uXTJTycHDSHq_C-cZTSif_sWTrZBaODLg5Nbq1oCYPw&oe=6A380A5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgBOuZcpUrsQ7kNvwFtZRcI&_nc_oc=AdorLuP9a8mx6K000AJ7ndq8eIqd6bjfDjlIejE1RaYVmxGnS1bTMTsoGWThVD5nL6s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bijR36UIdhPqM6ScQRo4eXLwQAX0OBfn840TSQqQglQ&oe=6A37F66D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVnx0tj8HfQQ7kNvwEhkDkn&_nc_oc=AdpImFWdevKNUx-9t_3XArRwl91JmxYWBby2KgO7K28GoM9expBni4e6iJGdpFvIYa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ljNJWunaEBoj6g5kA4G45Mz3q0EnYB-dcT2z4V-9JIQ&oe=6A37E697"}, {"file_name": "HickonuQ_1008x
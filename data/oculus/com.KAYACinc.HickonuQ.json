1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0f5H6jYd9P-_ICuKSEUppkO5H1t4FvaVDJd2BvPBDqA&oe=6A903B51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZD0X7DvUZoQ7kNvwHkYSkl&_nc_oc=AdqX4CLM8GwTjQw2fcRVfSY2sVIrYYkpKWozQTNR68poqQiOu7yBd1NJq0geUpv1xlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRYvg4F4X9Qy9Dx00HAa_cGrD_kTxMWytdsJImc5HsVg&oe=6A900A7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKMOeQVK4bUQ7kNvwEs1TJE&_nc_oc=Ado0-8vi6qPqgeryKAoWhGgyBvGVlGXw0xZxTrE4Fdbds0nK9o8nZBoSXN7kREB--W4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYpXNdx9MliysFmDgtGhbkKt5DnYPGXopq7b1CSDcQ6Q&oe=6A902685"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXicDE3KM6IQ7kNvwG_snrT&_nc_oc=Adro7ZNPv3aCOtQ6eSG5H4qU5LVL5_QCjM0gxpk-jj1cVktPxcbwceHX2dTBullJbUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH45C5pz2JvM0J2L54UGt60Fnai70wDl0JyKjeS-SwtOA&oe=6A90269A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHM9h_ckn74Q7kNvwH2bwRK&_nc_oc=AdrTCnZHxcxOWnF7ZwL87J1CQ-bn5lSKh0h_xCe2sxdAiZd4G8ehvyVIWmaAA9EdTNc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsD4Snpqqq1lPvLujnCurVITzbyinW0vvYM8r-TyUREg&oe=6A9012AD"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH653sPAZb8Q7kNvwHVAE6I&_nc_oc=AdozdWa_ugOvuOZ9qJiKwWSxgafLyo2FrpISw5onIPRXZAkF46G85LYSuSQOeiFSb_E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7nqUiSe-9x9_k6SShdYyEeqOqLpEhryyqwmzcL9XBIw&oe=6A903B17"}, {"file_name": "HickonuQ_1008x
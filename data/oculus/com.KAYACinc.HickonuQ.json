1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ETXwEWf2wqYVpG9w1GV1cTSiuREWmvrZSZi5X92JSMA&oe=69FB41D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYmH0XixlxcQ7kNvwEw8DG1&_nc_oc=Adr0sxD3AjC3T04XUiExEPCR6sJae8InThmGZAp7-ae2gAhNSKtgscvTYgRPUcw5HbM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61P65445XbUUMPAwvGNZiSxMBg3bjqOp672CHC4RlAKw&oe=69FB493D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFFdu7ofs8UQ7kNvwE-w0Hm&_nc_oc=AdosGIS2_CZgCSMUM5pPX3GjrWW2FZ2g8-ZN1I_-SgzaFCi7H2PR233Ows4Qg9INlu8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KqdOtkF-RYJci2IXxKmnzFmMIbBzmxJCgfSWHh26DIQ&oe=69FB2D05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0itzSaGIqogQ7kNvwEAMWhs&_nc_oc=AdqpPtXaeMeAThItZ9X8YDAysZ2lfBEswlq2wX1VIXlpEEAhmni3RprnXwQZHuGK8fI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kqeA5LYgxLpCOaM3qvVyMcnPoJFJdMXwl_ozvGapshQ&oe=69FB2D1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UEvhYCMwG4Q7kNvwFEoaNb&_nc_oc=Adr2ajX0ZdmaIAgFxSBifVEvLuW-Fvw1qCwiRl3v538-7Ov8BnppQkNAEi4JeNkbe3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vy4F8I8GWih2hBprvZKRKDGIDSu4mSEOMLmGtka31_Q&oe=69FB516D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe07MqguC5sQ7kNvwHJ9IVp&_nc_oc=AdpTLm3S75ErqWt8_nlzbnLxiTNGmkBIf72GRSWdvLiwaH1JLYaJso-0wnXJaW5ejZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q-H4a219CtT7rtrD5gyc-fZkK_0GTHw41QlRuV91QrQ&oe=69FB4197"}, {"file_name": "HickonuQ_1008x
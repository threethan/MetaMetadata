2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzYwlp_c-ZGW3L7CbmyjlrE2DOaFLBtWMAJcuXsO0Upg&oe=6AAA9951"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSx3S0RfkEoQ7kNvwEhqynm&_nc_oc=AdoKIO4xccj5pAE1HswN0OPJ0FO5qUGBAP7bc84GVisaBpqF732UhQAgeVRFIc0rpqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9WT_2s7pJI2zXPYm-Esk725OMPjNk1jNoYArMSWcD9Q&oe=6AAAA0BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBZTpFhcubAQ7kNvwFBTTu0&_nc_oc=AdogDQq9IihkU__AdIM1hi4nVTLJrF22qrh-nEnZFt7aSKFBTlKb3Ta8qR4EWwRs1Ro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICrLZOyax3PCQwy0LMG6QpYvVuxwe0lNkPgWegCrcS6Q&oe=6AAABCC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsvcZozoHrIQ7kNvwErC5Eh&_nc_oc=Adrbzuh2WU1l0v1cK6x5rcbf49hW37j9-gClurW3X9hcecm2FN2P89XOzPJ5_UL3IzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJie0WCTbnRH2nWgW3X4KOXh3D6hMmnLrzqzzmlcW_0AQ&oe=6AAABCDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBA1g9pocdMQ7kNvwGmzj1-&_nc_oc=AdrzkW6eFE6HY_fNWHArSEpyTBl2GNDlbx7LWQpWkJAJM5-6rxdmhgcV8_FVfuiyfEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQezYVo2GxwL-YmmlTyftIlWGw-DTIlSX49CslxIjvOg&oe=6AAAA8ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8eHw8QSZ4wQ7kNvwGvs9W1&_nc_oc=Adq9cGOZmP1bJVi5pzIVHnl3RYJw2eAOF8oSQoJTCBd9XbUFG64k2vKcT9CMpVQ6Q2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL32lP3rMSBolcGY-6aikg8I8rd3bWHMRJcQPpvL5fSRQ&oe=6AAA9917"}, {"file_name": "HickonuQ_1008x
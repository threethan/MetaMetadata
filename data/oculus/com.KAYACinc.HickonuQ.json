1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIdT5fDf-lOcAMglbfiht8ujUhxt4ts0pv6ivPlfGPVg&oe=69C29151"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFOBohNhpmsQ7kNvwEIk2r4&_nc_oc=Adoj-D17NI5jOC0kB5b7IStjRTSfiUfGQVbkObwlGqUkNuNeDGHf2lBarqLYe981hM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy15nc-xK6piqcZiD04D_ct9wslu3K-h8tQeNviOuT2EA&oe=69C298BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yZIggIdYYwQ7kNvwGV7Kc-&_nc_oc=AdqKA2-Ei-rWpwLNn5rb1Iubs3vbe2913A59g6W9zpAOxCj8XMDTkA2nu0wCRhjYpI0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybDKRO6pwslSWnAyQb5K9LD1Cpp311sFhbUH4VggyMbw&oe=69C27C85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLVYjXNR6QoQ7kNvwGMjNJy&_nc_oc=Adqrekmf_Ffz_zo8syulfKuIv91zZjwDWeEgFrafArklJL8WTZlN9UFqDbA00Q1IY18&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSbXm0Icyx9BNzPfr4Yk9IPjXa_H5lzwcuTMbh8Rw8ow&oe=69C27C9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UU5WA5btFhoQ7kNvwHV_7fV&_nc_oc=AdqWTtjRyivGGXHpCHJJ0XvCn41a7Rux7-lG35mcFuM2ahs3xIJZMoKQfDqkvwfRUPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJqQ6x-iYVYBwxfjSWizvRdzCw4NfrlGe01oJf-RpALw&oe=69C2A0ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZNYT6EIMkEQ7kNvwENEkyt&_nc_oc=Adqqn-lvvABJmonDMYXs4IurgNEAK-ZyWatDz4qhHmTN4RY-sgxKwsyGyA4Orxq4COY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDbFXKMl2tEezIzk2EGkt61fgtxYV2fSgtNQJx7-UhLw&oe=69C29117"}, {"file_name": "HickonuQ_1008x
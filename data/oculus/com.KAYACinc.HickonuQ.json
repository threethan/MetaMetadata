1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU4Yc8Y4_i2BEi-_Vj9buyMYWOkZNmCNUudcO7yJxHHw&oe=6AE0A6D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki1p6kJrEH4Q7kNvwH-aXkG&_nc_oc=Adq0tkV1rVWH5CS-PoKxgc__qulDPU3JlQYzWModSj0703ICayIfwfkKJId9PUics9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmPr0IOlMxdJMv1veNKsfFXgThMM_Z4w63C8Er6xY3iA&oe=6AE0AE3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnDFNn5rydgQ7kNvwEVCycf&_nc_oc=Adr8-Lha9D9XK3FMWXotBItx9JUm9Jt8b3chGd6Xf0kUF0O7JoNHIWNYRsGVrJFZkDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMreYsYeAl-82Hwq6RymLFMmkYXLEUwhEFwWnr3B90Ggw&oe=6AE0CA45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-XbTMC9D7sQ7kNvwGkHiYg&_nc_oc=AdrCldwP2mDPpIzYekl0EMQPzpOfLwDK4O2OjbRyXvttw4mumLF3TJejbrzS07ZxO10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOye3A7uXC9deCXX8nyQC31BkAx_7WW8hE8_oEEbuivsw&oe=6AE0CA5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5NoL2yanqQQ7kNvwHtejAc&_nc_oc=AdrUrr5KTyTtD_bDGlCmM7HWCEuSDgzmKg-al9c0gqVxP6CZhymLQ00iIHSPfXZptlk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI3p3OJF4jFWOBFnH7_vMcNv60-OL2w8j1o1k7Od-2sw&oe=6AE0B66D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bciBmliYBZYQ7kNvwGcGzae&_nc_oc=AdqepF9GXbreWl-f87xt2MsxALJDZFewr3rXQzstSheQGVCDNwphSK2JZXiTdfmTrno&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZs1-i_FMTwxz0o7-3-8kbYDRdLAQSyatlxBnk2nCzFg&oe=6AE0A697"}, {"file_name": "HickonuQ_1008x
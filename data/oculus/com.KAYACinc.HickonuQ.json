2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_v2ABTHZKeXhvY0VOLr6vfGc2-jefdo8dBQ3i4evs7w&oe=6A032AD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi48_J_mnckQ7kNvwFGqg8G&_nc_oc=AdoPbZhY_8DAo_L-DdCX14qygBMubNnmFnS_YVwVGXurLsX5AwlflEK3mAckEyS8lT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dck32kYhtMs4qTss5yngBMYq9rEZCopVwvdst641PoQ&oe=6A03323D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWRq-BOmIu0Q7kNvwEF9LWr&_nc_oc=AdrMGU5Q6yMgEMcV5qcYWqIyOQ3s2A90F13BZkkhVrKGuT74cW5Pyypq8mLAId1wGy0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5127L-_TOE3BDjrA24p82XnOgExdgRPkAMLA9q1-rtmw&oe=6A034E45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS8-w5xw2jkQ7kNvwHCmez5&_nc_oc=AdpOw1RHTLR4ocs_-KFwXq2eAFx4-fyUIqMBSuk2VdNdQEpE0h_p2aOYnsZatzp5pcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fuk_yd9BQFu6kBke9RLA9X7kyWVfIXHPp9JQYP7tREw&oe=6A034E5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PReP8dVu2oYQ7kNvwFOuJ7R&_nc_oc=Adpa0az2aKUFzWPLnQH4RkmgxMfMa4cypPT2WVZqxcFY7P-JattP8AT6N38QD1qucgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bF0_Z2upk3SJpJ9j6dKIlCY78KC86mAofZ-DbDTkc4A&oe=6A033A6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u37WXFSanIQ7kNvwFXx3pa&_nc_oc=AdqMtGETHAupMdczdkiVc1DEIJg86g2Dx5wOw9BLfvUtmCwWKRMw_FLiyAbF5_oSn14&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af792RFmStmgl_CCItmcI-d9UtyMS6bQZk3frTYUKGikMw&oe=6A032A97"}, {"file_name": "HickonuQ_1008x
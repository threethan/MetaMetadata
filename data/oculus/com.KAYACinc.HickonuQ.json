2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnXaiBHPs_a2ijWichzXg--0uGYemq09lOoDqtyDTZxQ&oe=6AB7C851"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1Q-EqABYqMQ7kNvwEyUGlZ&_nc_oc=Adovxwg9GWuegkoOWgGdXzpFlRt9gDpT5eBWDv2oi55JaL0qGGaMkCHjKGU2tJryOBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLme0IqKU1PpBfxNA3TWX-gjrIlPqYL_FBh5WGKJT9GBg&oe=6AB7CFBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogNU86NTwIMQ7kNvwEweltQ&_nc_oc=Adp4u0GV_kgE-tVFWiOfG2Am-s33EKhPud7g90MWqP-iqF4raT1yJoqjZ1A9qVt4Jc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBZFAkoQLus7zBOhxPCI24T1rkjSAWMCBqZFDL_C8T1g&oe=6AB7EBC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr6kr5KZCkYQ7kNvwF6a_Gy&_nc_oc=AdrqaCcz20s7IlKRdm90xsHM2OxnGmP4-CmUIMEwnoeNG2k4a8Zxb4KcFpXhRKgnTn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTSseYu9zIMOrx3kweZ51p0OTkMtZ27HDdFwroigxvKA&oe=6AB7EBDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgoiL5CRLqAQ7kNvwE2od0r&_nc_oc=AdqUUwWPlunV049OZAi7o6dXnmlEMxo3M1RxorsJ1UdooGoTk1Z1jLPGvb-oh3E0_yU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_jnRbnxUhGmjCBN0ezOtqbYQuH9Z44sT2OjOwtRIY9Q&oe=6AB7D7ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwkeG87GpycQ7kNvwEH_vhG&_nc_oc=AdrQGUDbklOdnlR-cAEEzUSoI6egUgEXcPEU57dLQvOMLKHA_b_yIwezONhLH5YPr1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmTB6F045Tl3M7LwGXz58YIpuuN-79qx3ez3MOJJWmHA&oe=6AB7C817"}, {"file_name": "HickonuQ_1008x
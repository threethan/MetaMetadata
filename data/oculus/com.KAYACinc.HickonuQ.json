1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKj3Y9IesWXL5F5TJFP1Y6sqk15_Vcg5uK2e7OKZEOlA&oe=6A8AF551"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yecpQ6p2jr4Q7kNvwEP7FQe&_nc_oc=Adq3p5FZItvRNbY2k88A-E4b5AIwjbmV1g0XOBUMS3L2O14MEJOLXUfOPoNFkr3GAj0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0nYCaZ-NkSN_KWvrq-ZjQgv2Typ_-AZGtuZOkzi8NGQ&oe=6A8AC47D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jb3n9TVIIasQ7kNvwG_7AEg&_nc_oc=Ado0p7I5vgcfJXNOSQ9LS6wjHfpD0-yB38JtpMupU1cYUkWlM8NK95AuSIat--k7iJI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDoBFFQrna12Z3LzChQ8mgTCHfKzSKPJoIglqbDfoqSg&oe=6A8AE085"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udSm8qRd36cQ7kNvwFiKwqv&_nc_oc=AdoCOBBvU88GSmRa_jOyUvCJyc1Jr1_xQqfm2op4ogAQh7OlJFe8CVMRSORU12_TSjA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlS84EYAuZ9XjzA_Sa4zkm0pKpYVH4JbrXtLjG69rjQg&oe=6A8AE09A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMWo0ox5Z54Q7kNvwHCK-zB&_nc_oc=Adr-bMdot68O0xpEwjcvvFX3GsNH4RyKJhCvMSh87ra_kNbWFqGlZ5HnnM1Yh71Xh1E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPCXZoV5CacGzdujhBRZA3KnIA6A1ryg2hHCy1vj4wDw&oe=6A8ACCAD"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJOTvCc1ftgQ7kNvwE5qv9g&_nc_oc=AdorU1LPl2ErYVZWuXv722DeBJWlY-HSr3p0N39ZNbETkSqbOKDNwJ0KDUeIduqr4lc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjDd_Z8naOdFCl-DZd0lxBE51E7sMYsFTqVlH2xCseWg&oe=6A8AF517"}, {"file_name": "HickonuQ_1008x
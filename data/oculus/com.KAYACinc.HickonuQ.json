2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90gd9EBOPuUTxHbU3l0T4-DychKfzh89h71Xun5x5TKQ&oe=6A2EAC51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv5YjTwruhUQ7kNvwG7A3-W&_nc_oc=AdqPtFaEe9gr2wA6f1gnkGJnndJeNqerxHAv0CNqhXuG-DNB2FKaYWd_yyRYZnEq11E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KOrHOCEWkrkxI6XSDiOrp5UpbgRWzZadr4xFf9kU3Bg&oe=6A2EB3BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsQrkdcbDi0Q7kNvwFPbZwN&_nc_oc=Adpa6vszzobA6hE2Asg4VtcjZhL0vek9DAfcN9ZSoRA-5o3aEEf3o3a9jyCzezk9m0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pfIX8tFXuT71si7xjZaQVuLVJPI8_6QnnjACGsLBzXw&oe=6A2ECFC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYV1_FdHsfoQ7kNvwHUcHNI&_nc_oc=AdqCM6uzkmuGgdKCN-TNxhQYNjaRdtxB-JglwzjKVXJLmZZiSs-9kNiiIO9JZ5Md90g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RY37FQm9xBdvetE4n7KrVfIQxqjim76D2EuqAfBrzIQ&oe=6A2ECFDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl4WSkXavgQQ7kNvwHa6nzh&_nc_oc=AdoWhJtnFL-mG1N9NYiYQ8L3g-SoUMBX50qfctco9LOr7ftPxutigJjdxy7tN4s61xg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-esnOncBLJHCIOw9L4SP5iD66zRu8u0o398s0dAPjh9A&oe=6A2EBBED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pwf9OdiXeHUQ7kNvwHN84i7&_nc_oc=Ado4kqgMCkDcgo8yXLyVloHCdq9__EwR1cPt5gSzhHh3KTLlWtgqz7OPEVQ9TTCnICI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SlGSG0wHNDucvxfAClqXRZn3pM1VOzw6HnOW9nNxxgQ&oe=6A2EAC17"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLV57KaDWodBszwp2bPXXt36cHzMFT2R73eVMGdR9bTQ&oe=6A9D6A51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih0a7izXz3QQ7kNvwF6T4ci&_nc_oc=AdoVGV0uCuqXqCxuZn-7LaJYxxXOusHjwG-vkOaBq5q1c9SkzFpQlY7IhzOJMWkGjms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWGpsnem61G8MMUY3oI9FdVyIPVUPHx_n3OrdoO21M8w&oe=6A9D71BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEekKovYGboQ7kNvwF497yr&_nc_oc=AdpMflhye8LIBwhHwNOjEAmTEM7gZWV8951x2cu8HdRpbZtWHTC4Po37KawFFKpj6Cg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx9Xpep41Xat0SWGjSyMF27HtQ4Kwf32JFZ54OIQzFew&oe=6A9D5585"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa1Siw5QiqMQ7kNvwFc-0yu&_nc_oc=AdpfoigysgttAukAh9QwFY7gSm9Kcskb-BgXy3UcyuOqkUkEQpClynOjik97NUU0r_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX1uGlPC1rMntAsCA_02XkhnEPMIr4NJX8WXRqgjAdrg&oe=6A9D559A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5L95SCmmPwQ7kNvwH40Wqr&_nc_oc=AdpthW1WvrQDH0806YnvLI0iBWBlZFBnEVVABJ9P6PoAUO4CMOrhfoFsi9tFb-MvpgY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS8DJi4Avh-Jai1YnDMgQwjblqff7EgOblcD34OsgwBA&oe=6A9D79ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqGWyzm-EOQQ7kNvwEPY55l&_nc_oc=AdpNRPtnU-ZgccHqZYpVPDXeZTGmLJUFPBbcRKDmhWhBqRa0VnzpvxVhJOhXEUy9ebk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW-JSZe7MwO0cXEV7TtdXB0rFYrIQPwHrUcLjVKtfb5Q&oe=6A9D6A17"}, {"file_name": "HickonuQ_1008x
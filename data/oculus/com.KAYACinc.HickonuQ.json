1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yOCQL6i59Uygiv7VJMEEXAE_i0G3UK_N4woGnK1ovZg&oe=69E0E3D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u85DxVoK3pwQ7kNvwFeKiSS&_nc_oc=AdrhGRzlj5sRNdLk-RK-8kU0K1rI_0cfRGB9Hvdw-GBawiqgE32b1RU1en43uyssSEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1auumZ7WOxRd2s-Fjdg3LSoN4Pf9oo707w61GvTHX-xg&oe=69E0EB3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRLKv8_p35QQ7kNvwEzxPqz&_nc_oc=AdqpPKqL8XpvPSkelXkTY0p26hWxfVDbTP5-LqF2zZ3S2FluVIe_mKI0KCwWPVn7Jgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zVrfGscRKAhWvMc4idsyPz5lNKMn2OPx0ixz5Sn2kRQ&oe=69E0CF05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnmBUbNTBNsQ7kNvwEQ1167&_nc_oc=AdqEZifEkJgo6ugPmrvyPgPSSrxRLc1shHyAsKzSd2tEIi6mulem_zkvrjiFxwcZ2-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26Qd-OOV_RNG25je3MbsD7xW51AMFPFYzntYRjOk8V2Q&oe=69E0CF1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHbo-OH1XcEQ7kNvwHpZji3&_nc_oc=Adq1Vpr2YZkFssdvewD6IgcELJ9R2IGFOt2OMy1l5fqlXwYp_QEI3bKMOEzAChLJhsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af303gjF2Ean_ahnwfTIm1OIuss9VBFRis3f_uQC6bj4-g&oe=69E0F36D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeKvXrDvtLoQ7kNvwE1TqT1&_nc_oc=AdrQ4FLQecJxLkKhvWnf5Zr2SSV2YCfb_dnjmw7gxHu5OOPp3q4QoEyohztjV4Z466A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Icm-jgewgVbRHRxXNBp3tpXd1XMh3lfHDVNgOgu00lQ&oe=69E0E397"}, {"file_name": "HickonuQ_1008x
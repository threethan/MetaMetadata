2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIgYsDkZ1q0uy9Y361nyeE2bXeERpls6MC0F256hC8_g&oe=6AD22651"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkwcW_HNeB8Q7kNvwHXyfbD&_nc_oc=AdpHQ3yx1BVMIqOCe1M9Yqs-t2MQFejguXlYPc95pI8L27wVfkdsOKGciX5Qxiz9J1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe7N0Yf0wphMfnfRJeWcVcl4ZA9jpm42-sD3FlW91R_g&oe=6AD22DBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdWfZd2VGo0Q7kNvwFEqqrZ&_nc_oc=AdrUxVG-eeW5Rbyfr6kKXDre7fJqlJewQ4a4SuyC8Yw_DhzsPunuuOuFMp-uuONoqGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNt4ZLGkAT_892gYxIBf5CMVVlMAJJrXUSaaKpYF4QEQ&oe=6AD249C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OnV6rMN_xgQ7kNvwGbyfH2&_nc_oc=Adoy3O_j8NhOfWKXi8TdO_PIvKpvWfD3q2zqNuyAncgbTMCuLvcXtbjWFfkVrIXAyxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP80UJ8sY-8iR7ov9fbZHAjg0xeWF-EbPH8lFhbohPGQ&oe=6AD249DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCL1odyL07YQ7kNvwHwRogF&_nc_oc=Adp8nFgihcq_cn1WCzFMoMKu3YjdNsA-WHy3qODN_jV8NZljU9-P39TYWIwVAaq1yEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb_5EsySliOIcAOvFNaSomvCHtPAcQK3p5GwLbSqqhUg&oe=6AD235ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhSrOOpdw8EQ7kNvwG_qoD4&_nc_oc=AdqLGvhwgCnhLH0GIepSfWKnmfILivAGXZe2qSDHa-0s-221DrFLu22gj6OwzV4JE60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNAk90SPmhMsZ1RQQl9z2EGzD5JfjemhJ4NOV_l8ykEA&oe=6AD22617"}, {"file_name": "HickonuQ_1008x
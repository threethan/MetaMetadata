2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh7ZBmZhiSG6WjPfyAvtgbKgaC7pr--VZsCRjqnjVX2Q&oe=6A6B5151"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYZoLjqjZqQQ7kNvwGUKXlQ&_nc_oc=AdqbMq-NNMRGIJjB2-4z6mHjhzvE783AOuGVRnz_8Q2ZL_W3QotcOpnmnkmZb4NvK34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnteMqfmGugY6shmgQdzwtHHsG-Uc8xwbUgzmzsfGLqw&oe=6A6B58BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94fD3HcQOU8Q7kNvwFbaU_C&_nc_oc=AdoHnjKkww6nYnlKPvwqzipqQTcY5eKP6NYmTtRdmr65zrhJi6Bsp5HurYRWQNDYH5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZbBWle_tXSFuLbUavlX9j70erkQuDbDc5OdddWovvpg&oe=6A6B3C85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHhgsTtu49wQ7kNvwH7G1dN&_nc_oc=AdqnfIL8rX4HjeFvnClp7vhpiIqHgiMiuCr_Ikhhywznr82ntHQ5j-iyntFPk2mYQLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKKDCpdIrXukR3sIqXO04Kkrjs5V61mbW_bK-nzXfaBg&oe=6A6B3C9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGBQuQxbLMUQ7kNvwF4kRSE&_nc_oc=AdqQTVrnl3iF5tFj0PuWzahEOFXZZcMppJ4PkZZJdnLuN3cQU00txl6-rrQ6rp7kmOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoSefyz0H326bz0ZNbbBAC1Dvywz6KUjMgYpN1r-W7wQ&oe=6A6B60ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdmo5AEuVgAQ7kNvwEzf4Wv&_nc_oc=AdqDJI6bLvWLe6zRVQYBLNe76vlFO_VD-0g1ZeYcip928Eu4bx8bUnSXqUtXEj-CKNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw-dVdye1Oxcj7C-ZagiGit9-Y-nzsqjo9258BH7tsTQ&oe=6A6B5117"}, {"file_name": "HickonuQ_1008x
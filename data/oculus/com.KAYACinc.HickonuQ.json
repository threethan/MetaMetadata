2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtVevuK2jYJTnVBTP1R5-wzyKw4HlcCtyYFHbOxqxIZg&oe=6AAD3C51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR8hDQv3ssUQ7kNvwFZ0axl&_nc_oc=AdrnA19kJY7UVa3UsSPAWscSBGUoNFd1TkS79AHopQLhn_lDnUCrcrQJdeqa8Knn-Ew&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt-7rhgAWb99UOA3aMdtE_BUZH4Cel6vdaCsQ9QXEzXQ&oe=6AAD43BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huMKvO0EfFAQ7kNvwHsrsX2&_nc_oc=AdozAZ-qKEwKH4dmYCq6sftFODznsEvLABNTzuYoJVCxMe1OH0f0PwyjC2-NbSjRkEA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaZZFOyZLcg-9rsQWIxInlkf8K5yRJJorQRDH3r5oDfw&oe=6AAD5FC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jdPSAaf_X0Q7kNvwG1DDpo&_nc_oc=Adox_DMXRpZNQXvuwvvtKeVPfTA6PeI-5k5p_l6KwAJQeU1ouw3uPpUNBWompWO9GKY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYAjZoRYYK1ReacZcZHuHYcw2CXk0ybmBAnPkJzt9uFw&oe=6AAD5FDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hu3G_955Xr8Q7kNvwEzMTbF&_nc_oc=AdrU4Baf1yqrh3AZ5m8T2-TkfixJDnNhncJ7YTllKE-9JrBBHsBGbrpxI-Yr0nE7tNU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsFTWz1KIvh5PmakmwzoYrFANfkMzTCvN3nXHgVyzTQA&oe=6AAD4BED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4BsV7iBQTMQ7kNvwFd2-3U&_nc_oc=AdoJDWoNuWdxaI_vAMoD4xIk-XQNjHTT-GtbQOdgwKdDa0rMb3FGKEwKtXVeAIH7hYQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTQTDzyHHUdZII_CspzwmZEDlS2YsFCYkKjB46zwDfZg&oe=6AAD3C17"}, {"file_name": "HickonuQ_1008x
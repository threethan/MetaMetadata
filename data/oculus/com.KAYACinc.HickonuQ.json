2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40MoTtfkNJK1127jRSwpiV0fgMaAoCkwG858cfth7eGw&oe=6A1D88D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYzzcR_8W_IQ7kNvwGfGHXO&_nc_oc=AdoaNGlRVjcbyq87tJHlnM3NG9bYGUuXCI22HEJsFpaaMsrUShQur9tx8CuqTZEY2Kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53eM_z6qTipB-KV3Fwh6keowN6E8zmZusAigPFohwx9Q&oe=6A1D903D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVKGoZ5zFr0Q7kNvwGX9Sh1&_nc_oc=Ado98YeHAvm9HLf-Kgj5JVEMcutuj5LLFrHAPe4Kb8vNb5qJutJxeBT_RagwP8p9s4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cShTuVlAsZeegwN_AGPrZnv0Yp1_wqBDbwiBi4cAAdg&oe=6A1DAC45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijYLi6Bx0b4Q7kNvwEnZlqI&_nc_oc=Adqq6yZffcFg5o627x4VmSdG175O1Ms5lllprevdn98UMs-rdKPTdGknQIDYwm4fhbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hyH9fWlfld65AznN28BffurTzzLT55s_2ncuy1HiPSw&oe=6A1DAC5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVhJH911EFsQ7kNvwGm1yxX&_nc_oc=AdrC12JPpXPTGrbTucvl5T-zHXzM2ITw9ED4U_FTpwRwMMMx9g-4a6J2Eg3mCAgO57I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UA4mkaK4YSP5Vec45FEh6OzZsnQZqyk01vdkoKYT9LA&oe=6A1D986D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjuzM3dIQ1UQ7kNvwFw18kg&_nc_oc=Adp8F9gW7WzKUiTDcgbQyzajGee6GWIHQ2Q0xFNVWeW65S_x_g_LowRdpWmrVk8E7nA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TjzK7bYFLrkbOTm_FWouuhc5Q08GR2ewlFwsCGurBXA&oe=6A1D8897"}, {"file_name": "HickonuQ_1008x
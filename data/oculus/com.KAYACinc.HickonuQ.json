2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3etUFvWYV5VJjLeE2m5B_gQPnnib5cZEhyRbyWp0Ehpw&oe=69EB6FD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6Qe9bDRCOcQ7kNvwHbavon&_nc_oc=Adqb6fsjHVRg-V4z7339-JU0U7WVIUbLfrxlHwitwTTbuc3gAXLlK3qj2uCCX135bHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QbkDnCtmPECskDGGAIRX4XjPingpXD5ORgjxw5Dl3EA&oe=69EB773D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKYi_DxcxnQQ7kNvwEO7si2&_nc_oc=AdpLlwuAX84xYqwWghR6JVtjN0vY0F7RNMz41jV3BDT4a65kKxvZlgL-Eu_PaH9N65A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38WPZSirXknwZvvH5ba7rSeX_2bQFPHqe6H8ar8U8GnQ&oe=69EB5B05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXlW0D2g7dAQ7kNvwGIlg8Z&_nc_oc=Ado7e7GfNXYEe1B7bTraJRU3FWPJkMc5d-B5gVWLoi5TNL7q_aYUG7TuDELdxWyKhNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OGKtPSycJ010xf9EMHjIqBhjzSKOSm2WVZL6wNmEs7Q&oe=69EB5B1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HXBbRp2bz0Q7kNvwFfiq0x&_nc_oc=AdpRJJuG5VgGAqd0C-y22U07G70RdsBZoZzE7JJTmWywNxYUnCR_tzrd1EQrjwioKqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iUCvNJbWVw1wMuJhjpCuQVrYQgVtnrIb8EDpgsXZqnw&oe=69EB7F6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9JkPWtCg4MQ7kNvwESicxL&_nc_oc=AdoE96p6kFWpy2956fDYRuEytp7Fgc_tlMOFNepCXcnlAn0OaLYoqtp5aoITMztk7CU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03WSkSGpxLyqh09GPvPNH5rH6YQFAs7A3pCY0Qw-a08Q&oe=69EB6F97"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzMLQ71tHaz2tA5YGuvbQDu7t5LbtHR6JX9EfjAsdvnQ&oe=6AB130D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Gl7-CKst-0Q7kNvwHFoT32&_nc_oc=Adp__Dq8lo5uY5AznO42lmpNuM5fUw8ZSt05vvTFEEyh6XEV39a_zBj0bfQCIThJB8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUVtQq7YzMJISCBrWd7lVP9HH51wZDl3Lu9Z7s8n3LVQ&oe=6AB1383D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK6AN5wXr04Q7kNvwGWQk4_&_nc_oc=AdowdUiP6R7yUuA_LhaR0x5PLf521Re9oBywKfS79vNm59_qLbNVf8JX0CfTQv7mTws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS-7qPUyIC0jhnRqbqvj_-cIqEb_0EulscDqEHv7kihg&oe=6AB15445"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2klVnv-oQG4Q7kNvwElMBaq&_nc_oc=AdpuMcitdH656mCscyiAN72kGxrag5J6-21Q_LgxgQXjunlnyT1qUBTET9UFBd2QN5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOc9nR0MKEhc2V9IIK5aLAegJuU6VxhapDFqhXtGcmxw&oe=6AB1545A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0KSBAOtitUQ7kNvwERHJrf&_nc_oc=AdrTQxCWeK_V9yzFVxuODRL9NLNCGS9uNUCY3TDWqtLo_oAY2r3ceXS1U5D3sEtVnSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqktCYOyly1DITlPu0cOHrYvUReKIJnXMQPQVZLGqCzw&oe=6AB1406D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxsPkRsyUzIQ7kNvwEiigZJ&_nc_oc=AdoYPCrOPqP2Gw4njUXcqarfp5fneWHzLaoUPH6NCK5LINM3Z10MCJpSBeAKXVVhFoo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILUMjQ5ovAo27i50Od35deDztOiY6ocPbNcwN4DHl7bg&oe=6AB13097"}, {"file_name": "HickonuQ_1008x
U2MB8NbGI-FN0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXJ93DYhlPXhbM4hvkorkV5LWG_BoLcJa1AOJHMjfx6g&oe=6A8EE9D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZD0X7DvUZoQ7kNvwGYrjo-&_nc_oc=AdoLU1NUlFy3rt6CyjO1JTP2kk2Ms7FMOr7iYfxQKwdbYLSpsSyu6yem6mKPX6TRcUw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG039i0cH80WwwlmNyMUY8FQx9_Pg2HcLC0uJaf1hV-rQ&oe=6A8EF13D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlTAs0VkexMQ7kNvwHBuU60&_nc_oc=AdqRybbCNUTrsvfhNgoyQmLVVg6tt1PKJ796xH7E0RumymsLHfyFYP4cTFb48LAdqCE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFchq4DPcwgSZ-VHrd_8TZ7tyE770RA3SI0ZoAE__Gj6A&oe=6A8ED505"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ptggg9xtCoQ7kNvwEaqgk0&_nc_oc=AdrKWi2RpJ_B01Tu41tw9wrwDNAKY0vb3HArQdLFQJIvHZGNEMeSlvpfGrjogERvBRY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcmPI2imGenB_jMpx5B59v6TJbPfggoc4exWIh60zJuw&oe=6A8ED51A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHM9h_ckn74Q7kNvwEhku1t&_nc_oc=AdqEM7m7Mk9G5ITx4ydOs4VWDaBtrg3Xexn_L6qKT0qufn3gMFOAzQU9Vjr1EomTSds&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaRpByL_d6dAnJtjF4PC-_jr3sGIIhv7RjzdvDPBBtPA&oe=6A8EF96D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPJ1y9Vb_lQQ7kNvwF3OLcR&_nc_oc=Adqvfy39P4aX64hsyeFOm0dzpEsB9mPATdkW1uLI5WVjy3fhZy9_LkaR4m8xVMqp8cs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWR1w8VL85tcqn6p6O7a5XE76ti4AJzIj8OyND21H
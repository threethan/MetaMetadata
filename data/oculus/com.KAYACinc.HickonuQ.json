2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAkIipZIXt1LcYOnvLFg7jMOkWu-b8lWqyDulqEFWGVA&oe=6AC3A5D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reQxFqAQHpEQ7kNvwGFZj6g&_nc_oc=AdoSjjT0QmOvxttzaEsEtgwZv3uQSXQ9zAZ_5HJ1NZj4ZhQODBbUwpuvH2HdRN8havg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPRmx0Q-HHmHYFlShiY54_wj8_PotjuHkxH5kXySlQIQ&oe=6AC3AD3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0cdYJY4jlkQ7kNvwGi_Oe0&_nc_oc=AdofbXLTqcwOCaUK_4Tgp--P2gDCFXAoNYUa3qtJd6Mf5pzR26MwALSUhKDwNyMFStU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp1FxfT2PRUWauo9kEP2zvjt_C2_NB0_tSDcU0lgqCpQ&oe=6AC3C945"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l_kWqztMkoQ7kNvwHBG1Bw&_nc_oc=AdoAst_npXgOb2E6uGuLE7l3uMkmHnX9bZ6exTPGWg9uKJjShXhgrjmxxdVuDBgSGVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo0o1EWDVqA0MobZ_0MNdTCbfTDfcqGhjPT6VtgrR-GA&oe=6AC3C95A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Xj8mWxL6nAQ7kNvwEEprOT&_nc_oc=AdpuaIWkpPJbInj4c8exbdufskOW1In22KVDjooz3J3CJrPOhoVUlJ0kkV4F-tM9rKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCD9_rJUBLNjnNpwGjpl9zOfnDftAwbX-7tXZkotKTAg&oe=6AC3B56D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nokgCY2SJQMQ7kNvwEbBQ8T&_nc_oc=Adqo7m9nsibZBlZH-uNJjzs5Vi6iL--Lwtdgkc8bXtBnoKMX_1ZXeYxB_BRVo1ilOew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvFnAynRNMZZPjM4AkFEsQW8IllW3Vfqi5cQQI_N776Q&oe=6AC3A597"}, {"file_name": "HickonuQ_1008x
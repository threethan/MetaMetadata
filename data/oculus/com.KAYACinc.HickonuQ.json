YW2PJlIU2LI38&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMZtz-fERWABpqwXTPbel4qmsRSMVaWWtUIMLhTxxzEg&oe=6A85AF51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd6Qy3O6cAsQ7kNvwHwjbe8&_nc_oc=Adp0UfZDcKUTDsOoYraiRd7Q4Ay7GzCP2YR02YO0AjMFMkgKjezgvCeSwdgH3ALVqGU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx7vrMHVJMwCyDkpeRigvPWnNrt1BORaMZ591AHp0LKA&oe=6A857E7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP5IBoj-CB0Q7kNvwH7gG2g&_nc_oc=Ado9_vqq6b4-libxAu0IkHI_xnDAGmDx9BHcxN6nQ6BxntZkT5oL_sEsvSzQ2YtOvnw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZhucHyR6hU3_aioHXScF8LAPFrZNUauRnu8fMUVFVew&oe=6A859A85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCfvcl5F-k4Q7kNvwELbxHs&_nc_oc=Adq-suZQHka8BmLXmkD5GY_c9EnGZQMuVe34a5WBRV5IpJAqqe3AzatIR4B57WxIsXs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_23QQrC-WLlJXXfGWGtNiWFi45zLv6ApDKKj5sb3GIQ&oe=6A859A9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaUKDcrBQusQ7kNvwEM5Cso&_nc_oc=AdqSXrG1HATlEiQc5gqtnHalsnAoCrzM-Ny97KoaSe5oWygm2ElEIxplASTQfOj4_Lw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMj6i3dtiM09l2ob0QZNuK2Kpp74eq_g8WKA8yLfBaBQ&oe=6A8586AD"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBXNNVbsUhIQ7kNvwEHVNVg&_nc_oc=AdrTyq3hzHOVDwL_C00yZESmY0E7SK0WEbILiG7uVHFA2R5Eo5UM03gaZIIDudUGua8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENlyBNke7r1N7JEof3QCxkDUw_yoZ3994oi5j7i6i
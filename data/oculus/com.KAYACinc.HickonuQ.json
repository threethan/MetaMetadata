1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eHeDMEzr_LTYLgYx5M6OBRTnlcKVnyXYsEEz1OyA3Pw&oe=6A2AB7D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DV7hjNTaxQQ7kNvwFLmHdZ&_nc_oc=AdoLwg2Ty25xmPrw_iywGf2heqfefL-quZBT7vmxSAPgVawTlh_v5jPpfk4JfuQIw1Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_MMgYYuBHjLL2EyBanTOZe5fM7xB1kF1Hgtl4A4BYBg&oe=6A2ABF3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpY2hyDNshEQ7kNvwGfpuYu&_nc_oc=Adp9PciZG_WO8IjTWc2PjecScqO2TkHWgA_TSoRztw5TvK9_QuilZa9hUSLpzycoNo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S_HmRF7QiKv3WPFiIJcvg_kfdPSUx_OWi88HcHBdpsQ&oe=6A2ADB45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i291NH4lYokQ7kNvwH-xbwP&_nc_oc=Adrdj4wq-Thl0_-b_badjAKv5aXkdXqL0WZbheOZAjGw6llkJ4LsvTT2c1VxxWLcwno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88BXji1rysspn2P24Rxj9icplcS-y6zJnfhBQdQ2hEEg&oe=6A2ADB5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL5W9iE3AFkQ7kNvwEDf9Bp&_nc_oc=Adq4zW8clMCxtCRIHRuc-eKm4Ja-2bYaV6h32YI-jcq42yM0uqUrIln0rWzwpCSF6Yk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n5HKwezXC2tccFQPL2UUfO5mlzj2Vz-EkchXaE0QBwA&oe=6A2AC76D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SedaxHTbZoIQ7kNvwGvxtxc&_nc_oc=AdrhbEke6qX9QHw9MGyhm3J2TVCDtw_o_gGt_CgUNrOfPoJqQFjHcHWec6pcw23ATbw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NRuQFQuLEepjZv1kOftVSoCnKOtMrhdIQD551N_5UaQ&oe=6A2AB797"}, {"file_name": "HickonuQ_1008x
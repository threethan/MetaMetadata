2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfWXc24riEplWUIYrwPBFHhlpqU_l6MQ2VrJMQ64M7jg&oe=6AA15ED1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3ZDfEIMhrYQ7kNvwEc-xet&_nc_oc=Adp07Rs8cA5lGF-ynG-TVLCCmP-QLxjNOHzwNVrOAYdBR_E9BfqNMm0CxpFtqg2s53c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVEDRD5d4YGWVy0Hub3dS64ZbIag79XwAnFckQCZ5afg&oe=6AA1663D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5NA04gGTD0Q7kNvwGMg8Rh&_nc_oc=AdqQHexxqD2SDh09UJF99brjdScz_elrO3ZJm2ygOvysJidHX6VDK9IQTm-5nfRgG5U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITRJ6s4bGeqPwfWT0k4vqYMcl3H2rY6zbL-Ote3dwtuA&oe=6AA14A05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbDLx0DjpigQ7kNvwEjW__J&_nc_oc=AdpKUjZFtvAEgEaz9HtSxO5X35wbKUcnr1z4U82zav6rk9hXKyT48gevd46Z1Q-1kfs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSifS86ZFZXeyNkMAAWVCE8YTUPjwLgh3oIEfIENgApw&oe=6AA14A1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlLHUOtPUcwQ7kNvwH11Kwp&_nc_oc=Adr-xAL_xBeK4GStXRMnfdScq6aEU34xcPs59l2FceLiPHX2Oi7EQH0BcV7yrU4DKmw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYMbfNYVuVdFbi0f6kUw2Jbn0Lz6DY79PaHEYGcJC4ow&oe=6AA16E6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEBl3tpd9WcQ7kNvwHSXXca&_nc_oc=AdqaN13R1Im_adkWmxsaWHaDmXMM0VxRmKqxmLwhP6teoA9oCZaSTX-uawsrJOqSYF8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRu0PZpasVtq0omfNryjLK7QBqYbgh3BW6OcwDo_bsGA&oe=6AA15E97"}, {"file_name": "HickonuQ_1008x
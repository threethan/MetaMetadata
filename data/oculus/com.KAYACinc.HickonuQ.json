1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXGtVe40e26lr5LqhBxvDmYS-Ryen7hh7ySOemLXdWLw&oe=6A772ED1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM7n64nINnIQ7kNvwH_JIHI&_nc_oc=AdpT8KdUNPrFjQUNkOXPZ0a-tbP-hsjStytVWPn-LvHtvlUYt_xh77fudywcvhmrHOA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELhnbzz8CfkE4wsrtIBrtajHQT3yztP3NacA66jA-FPQ&oe=6A77363D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPHvGJ2UeXQQ7kNvwE6825O&_nc_oc=AdoqfPNyvRHZguz-O-K2cydcvFEcLDUn4NF9f-8pBlzqozG4ObdwCpsH-uFJVRY6w_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkR95OxT7pCtT2s9lSZ1n10DvQxGcACw7JIcSVGCVmaA&oe=6A771A05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epLc3RQMKdMQ7kNvwE79svp&_nc_oc=AdqvuQSXPNC-UKEgVHBlhE-3ngIY_qc7i6O2_dHs4whO3MHn6ilgeyUVI-xiQ3A0zFY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW-L4u5ZEC6AzHj0KzhATyHUD9faX6lPl46PZebuY22Q&oe=6A771A1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoIb23ZPvqQQ7kNvwElbEuZ&_nc_oc=AdrM8PyQEMTGirZeLbaDGv8ZZ6mqOkhlmlKsjw8FB03tRIYsP-NTIWV_x9rvlB8PNjc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiKvsYA6Fk5SvCsTadB14idFHDC8g0MP4ukJddTrlrHw&oe=6A773E6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I73GPpp-wEgQ7kNvwEXvbUQ&_nc_oc=Adr5aTyBPFEqsBBMZ3d40miQFrLZffW7-zB5wMN3THZZcS_z7WnIG2nUZzALNjng50Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWzr33iUrj1J5HXa2PH5_QU6UelXzWrizBHsE3WAyYxw&oe=6A772E97"}, {"file_name": "HickonuQ_1008x
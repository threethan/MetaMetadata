2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ouS5qrJMYnPCeSP7RsNY8Opi7Seo6mS1xLO08u_Sclg&oe=6A199451"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8VD5NDSGLUQ7kNvwE1SLie&_nc_oc=Adr0JBSJTGmy_rctpDgqLR9rcuP-OlITPznqrpZ45hRimUbCsx0QlughmMm4Tqe1uBs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MvdR9Fyycc5xGZPufNrEj6URfmEScBvaKEblqyxvsRA&oe=6A199BBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ_eHq7tGpUQ7kNvwFjJnsA&_nc_oc=Adq16Aw1P7W1hu17esVwz3FmGklaM5My9sY755GU5dBkgJRno6kvNO3-_rFuBXIFtmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ztfpQQ25at0k-1qDkW2-UVRWPoVei9yi9lie58yVtxA&oe=6A19B7C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdRPlq8zMggQ7kNvwG8i3Dc&_nc_oc=AdpQiM3gz7ukO-pq9kfF2maVuHafpXYqtr30aT1xKRnAq46t2EEnvsB1nru8iwDNqxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af607-UAz1r_NxhlLmfCBd9K41T0Vay9S7U7zBARSw9JQQ&oe=6A19B7DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BexnnlEHnVcQ7kNvwHIdDwE&_nc_oc=AdomACPrS-l42Lbt5d3T8giUfsKW3H-b1rNcxmcEPrzStvSQib_MGvPePXVxtB89hP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QUWYEHMnrAxtlFWO4_7tUANy3LDpzrxU-mXUYm8L1Gw&oe=6A19A3ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe1yE5v-UowQ7kNvwGj4OkZ&_nc_oc=Adr49ixhXjtVuUwA92uYsLTW-0liWjsslyfNgYffLkQePn0szsufL0CDn6uD9471AOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aRnU1RwPb1-qPxVqtbboRoOOIKIsN7GWIHsKIpMSRtg&oe=6A199417"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9JF1kms6IYB8xsy3Z1qKhfI08AdIxT1s2fhn_Bq76_Q&oe=6ADCB251"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA8nc37rzBUQ7kNvwEkq0h7&_nc_oc=Adp19-rWOBD39vOjUMO1OZ5B_MQ3qcQh2oB8OBDq5KxjQ8e-r_G9yhu-GbIKJk2FiOA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx6TYA_FD7sBn0QNaSa1QZJuu7mXXBSy_XxkuMW5Mu2g&oe=6ADCB9BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6fvo_zMIZ0Q7kNvwF76mH2&_nc_oc=AdpiLynSsWWM5RzS9weBM3zUgJeDBhsW3XwRkhviRJAfID83smjhGTKzuoNU_1mUkMg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv2uTz04ERBQ7nDb4sxVVnNEUbY0iZsxK8nnZsyz8TMg&oe=6ADCD5C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybbOYdtX4AgQ7kNvwGnhDgt&_nc_oc=AdpuvscR1pE5F6QTa0akCbg79_cceBo9mwlcFy4s-2T1OxI94BNHdx8BqG7ZWK8cw1I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2WhNn35fx-hZ9hvhQV9sj-LzlkVMsW3gac1sYZ0_eXA&oe=6ADCD5DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG8fi7CRSvMQ7kNvwHR1Fx8&_nc_oc=Adq0POa4B6emA95O0i0oeG6pUTI861aaLLrdIfS2JfZN0zoOGRgak8ZqtMg1rxE6KsQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtdAUt5aQPn1QjNS39qzWHLvqhLXQQK_A4K5E9KiG_cA&oe=6ADCC1ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tibeSwZlU20Q7kNvwFtdC5X&_nc_oc=Ado9g06axonk5qdC73mT83AnM4ZFm1wZn9S0ywDf24d_bDVkmB4gZQn5JRijiOLqTZc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx36U98EkQ1Cj0LQFWP22LiiwQKks89h5K8g9Fy8Qz6A&oe=6ADCB217"}, {"file_name": "HickonuQ_1008x
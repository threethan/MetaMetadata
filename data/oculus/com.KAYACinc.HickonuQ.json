1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnw837vO6uNylqD8ovkRHEl4aZDy0NDFCo5giRunxfrQ&oe=6A5CD0D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6q17vZipWUQ7kNvwGFHcAm&_nc_oc=AdpBvHY7e6xCNCngGvSeiM9aDs4r5f6LYGJQsjFqVOPB3IshAHKsRLh1iGUdWkHmJ9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA61EFjk01RphAWqUwc5aUVMp0u7Yb8g1yDPX_6cCP-Fw&oe=6A5CD83D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qde47g8q54MQ7kNvwF7tIYZ&_nc_oc=Adrl8y1HEQycVPK3ZrDI4M-ON-X55Ut2FckYU2I8kaFBLTMrPFlj2a5oEDzxuVWAto4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyMehOxAkfDQYtmfCVxh0pBj-amkhrTQeGfMtSQQJs5g&oe=6A5CBC05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkG7J-2m50IQ7kNvwF8gd-D&_nc_oc=AdqWgL1l0gaZrgwIhOQUNwHLmT7WrSQzwQsy33pxBUEKpQBIMNln_N28cBTpX1Ljvf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc7o_xoQFfP9kjHQQCTSkO6y88JYBKLxUbnUk9lvPAlg&oe=6A5CBC1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxb6zjF9pqUQ7kNvwFUsZvI&_nc_oc=AdpbM1soejNvHzgGZH1-l-P3pO74cTAvWdnVLw3u-xFcslZLrM2zQvpDRfz8il9ZUGE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6aJNRlOxDAXW-dD0a5hhIKIcJAaMqV0ZgYyGJH2ZpGQ&oe=6A5CE06D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVeMMsLrXikQ7kNvwESgp2D&_nc_oc=AdqasChpoBxeIaHmScVgXFphl6ptpYL9-DuVRs6-_ZktC4IWuGl9uK059PBg2gp6U2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQN-7AxXpudXGteNsZ4TJMhfB2Dr9WVhRRIVkOTunVTA&oe=6A5CD097"}, {"file_name": "HickonuQ_1008x
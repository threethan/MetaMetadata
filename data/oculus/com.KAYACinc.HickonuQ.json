1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO23AUm_2MCbM9w_TnPcHDaAI2wJ75wCvN8Kjgxr-gcQ&oe=69C53451"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqEA2gPI7HYQ7kNvwG4s4Eq&_nc_oc=AdqUXbHzhfVNaB9NsHRzCqsYSqo3CiuFDdNItOM97BqIuZu0Y5JAtweiLkX23_HJfzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMjy5OWrtrgKFYszxB9NM30q1cc8Kssfiw7lxy13uORQ&oe=69C53BBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yZIggIdYYwQ7kNvwF1YGi5&_nc_oc=AdqY2rKoJEiKLsMS0DZ8EDmNDnGxayEEOsbEgRauorTh_fsGb1vYk_lbzojI1YJZy3w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzO0bULU49nzIP9nxiRTlqegMWCfSPiKiR_7_tN8_e3kQ&oe=69C51F85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLVYjXNR6QoQ7kNvwE57er0&_nc_oc=AdqFj_b8BSJ95ceNXn6TxWobXz3OW9AaKfx2fgM4bh7UO-vZRinDNu0kXD8XvYpnVTw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxchOIe9khEBVj8q7b5_spdCvSGu3Ca8bwvj-z8nHz5Pg&oe=69C51F9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5emkIuNvbiQQ7kNvwFqWDB2&_nc_oc=AdpaSk_ZdFx7Z1LkhH-Y7qb6R4LZYOLDakW3qMj6ov0QfShPmEvTuWZFRLLhW9ZbTT8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLLu0ax9rKxlOYwT24hwTqBR9r2yPpLwtxkI2OXhCjTA&oe=69C543ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZNYT6EIMkEQ7kNvwFpsUC1&_nc_oc=AdrUz5E_-XCkaEId8SGEUDSu8k8NhUFcs9Js_cKXOX8NKJ-g_O7S_-DoY_dpwZHzR2Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzd51EZyhSRI_7DDTOqlSm5MeWOW4E1Q_xtsWExbpbucQ&oe=69C53417"}, {"file_name": "HickonuQ_1008x
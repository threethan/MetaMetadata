1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i2xdhMIca2S3skJ_NKPMx4PmXlMDbT83I0CoGpBWtzw&oe=6A3543D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l231criar6UQ7kNvwFPZSP7&_nc_oc=AdqBj5OFlzMC5lvmhvv3BYluxjvZQvhZ9m_8hr4ghvGBd2XyrchfI3aS2qHWWDKQ6bs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y_M_M0VsBsKoPHVV2bRTTTG2Z9YrSURAIkr1hMMQJ3w&oe=6A354B3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1COLT0LepwQ7kNvwGzw_qm&_nc_oc=AdoGOaAcCfz2qlBAMPUA3OhgmPQhvRFVR3IzPJIqeYo6yXQQrslxA9qepTjZsytXNZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0TwBW8g5FiCl3ziHuTebATt22UfjigK2uV5-k-xg7PA&oe=6A356745"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px2X7KqkwfwQ7kNvwE5rgUZ&_nc_oc=Adq3SfhM2s3u0mruBYjOJMtnBoMCD_HQhq9zj0K5X6ZvfJcZ8IxDXMVIRINGjsG89oc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ilhqL7SKk7Gkj3RFjtr9AmW0lxkwiF7U2QVP6DSTsXw&oe=6A35675A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0ZzfdumZ8sQ7kNvwEj4FM1&_nc_oc=AdoMWFq_YP9nq3qRv9Dw7frIBSg-MtXTNQyWxCg6Cj3eR_QcYwpkh6Bb91FDgSIgJxs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f6hK30QlDcKZpPmcRzSTH8JcbmsOkex5nJ-rZTBlaRA&oe=6A35536D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVnx0tj8HfQQ7kNvwErIKNg&_nc_oc=Ado5h4kxLBLhhro0ZmjygaDXmHbevVYElaVcWqs30DWfwVppqPtEfokBkSWWvaIohbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q-eomzSWjoFxhK8ZVGE71R0t3oEqkopTPPvDaOWG3tw&oe=6A354397"}, {"file_name": "HickonuQ_1008x
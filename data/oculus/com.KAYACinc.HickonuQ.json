1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-_-_IA-Ax5_AkfLqq6tVOA269vLJYwraCAIFNsyk-9Q&oe=6AF9EB91"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b71YQeQtvoUQ7kNvwFTA8A5&_nc_oc=AdrdbO5GscxDpY5Sdj-JFAr6FxNHBkmP-LrR9eA1aM5xey6vkpTtVBhzdVln-d1s9LY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCfsm_w3Ih3GT3-QRHsD-6m5EpFZKkXGkv7bPGh8OA0g&oe=6AF9BABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO6aF3ThTLsQ7kNvwE-JqQr&_nc_oc=AdpJIj4dwkqXZUZRweb7SXHsQWCjbmI2lwKp-93h0x-wKuNT1EGg_PObWcMm8iLYOPs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH3cr1VwCS0TDFg--mAJR5XRl0Jf4T2eRFJUCvrh7f4Q&oe=6AF9D6C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bapT-Np-rGEQ7kNvwFZbmaJ&_nc_oc=AdqT1izMlgPMwsusjScALxGG-pYgNAnFjXp96ImUt072liNzIB_YIXcsseXP0fsb1zc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkpUCIhQ8SqYu6vB2MOTE-_7YekxNPU4ZOxgKfoI8YrA&oe=6AF9D6DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBtmEhso7ZcQ7kNvwH6zg3T&_nc_oc=AdqvyCJOKcX1xOVkWH8jsfHKBijJ3YX43dUABKerN8eXKJEry-ZUCWldlAlzXDqPwys&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSup0AZLjYvf6cv1F5u8Ziji8RIlZ6x5rGZBv7duT3A4g&oe=6AF9C2ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UckDtvWtkF4Q7kNvwFiko4S&_nc_oc=Adonm24htTKyA9EjjPsUePq9u4rA9poemn2cySiBWwIGFA9T_my0dTq5AXQhXgu5s28&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyfpLhUZPDOZ2xV51ex5ZQMEljtd9kWqvYlTBvrygOjQ&oe=6AF9EB57"}, {"file_name": "HickonuQ_1008x
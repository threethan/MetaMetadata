2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYKUaZG3trnA-paSXSZ8xOhY_tSPKfxFPreq_rRxysrQ&oe=6A75DD51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM7n64nINnIQ7kNvwEM6odp&_nc_oc=AdqF-m5n08YoIRnmHM15sijcwhx-qAot3EjHa8vOCLAD6W_qYVRR0FmeHIksKQFk6_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiWEhpXLzHxsOYsmZzhxQHD2AfiEgIIY2zl2UDKJymCQ&oe=6A75E4BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPHvGJ2UeXQQ7kNvwHB1BzQ&_nc_oc=AdqEppYlIgFZIa88T17DwBfDkCIITJoZNFNK7wAiwBFMtpOMXg6WA_QJs-HQ73-nLTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg3yUsGj4xC1myR4lik7Ej_w00S8ERKerrgWOdztfuKg&oe=6A75C885"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epLc3RQMKdMQ7kNvwETLrcp&_nc_oc=Adoe7Gpf2_1eHpdlpVlK2VXySPRv2fqKXXGRYzy6yt0-Aj3AEAfmxOL4NzpO8zPtGJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEClH-TtxautsdxSzrVw7j1mvwP5uYSznsbgtF6FX6Mpg&oe=6A75C89A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoIb23ZPvqQQ7kNvwHk5rWb&_nc_oc=Ado0Potxy2efvxdV9f1_bRe3VXnnC9Co_75wD_LgLxbFLF2LzR0PwemHZy81RxYxu2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3mnGiPlgcS7UVKbNnxmFAXcE-4vr0_d3W_vz96D0PMw&oe=6A75ECED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I73GPpp-wEgQ7kNvwFAXT5S&_nc_oc=AdpKGXpuItpyd0i3N6QhxaGt1e5xQJ5nDc2BjcJCHZJbLbu2N6hOnbZjO-pLbqsWeWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH55t6Gaj-YXgwVia0t3vr3nCWXp2Kf8ped09Fx-_9D-Q&oe=6A75DD17"}, {"file_name": "HickonuQ_1008x
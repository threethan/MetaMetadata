2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMktVhGA_xP96q3EngW-hE_dCTVcb7GGDwTGf_4ysQLQ&oe=6ABBBCD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FoHnNLCvhEQ7kNvwEvgaWh&_nc_oc=AdqgH0h-v184MxhESPqOHxQKOX90h22bmAw4IbrJaTevZT5A6TELKe7fXCUHJJQONGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsfEQ7ZddX83w3Fe707m62nlyaZLJfWl2HMjIBdzkXhA&oe=6ABBC43D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQcTOLJnlmMQ7kNvwHg5XCf&_nc_oc=Ado7aQ6T_qUncjhZw5bDAkVLbR2AxqwC6GYfbxM6uDCNZhDEq_7PDL6kc4vCMqXu2XA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8IXA5VJ-p99aZ9_VtUWi5lyAFLKq14MF7FTRB0OooRA&oe=6ABBE045"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IK4hMKbWkGoQ7kNvwH9OEs9&_nc_oc=AdrjZzr_m-WveESw4y0lzlaw_hFogyt7junQ6FS2in1PVeDGAxMCcSDXGuzEeboMVpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_oSNlXTDq4bSqJ7wR9YHglpuGztWXjdO0mT2bl3P2ow&oe=6ABBE05A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFB5dLZcCm4Q7kNvwGhQ9QH&_nc_oc=AdouyNtBaAdCZA1AapE_LZLPVsJ7fjV9lIOmgsYKhqs4R9TJNjobJW1An_bas5LkqLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK70OzS-umPERt5IkS9jLuK36K6JcuVA-958u7ZjG-Q6A&oe=6ABBCC6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52VCKGAs_p0Q7kNvwHhHQ9N&_nc_oc=AdqhDqKvkcCWAD3b7tE1wff6KXVqbPBMeFJ3kNUcDMuYVfuGY6DkmYA62ghaIc7r-hQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsPFEjyXgpsDBYgf-NYeURZfJwFsWw8ORPJVphgkbA6Q&oe=6ABBBC97"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkDTihrJWcRtSDpZV-GzgLmjKw3_9Omc_JRjZ2oiNxpw&oe=6ADF5551"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA8nc37rzBUQ7kNvwFJI-mN&_nc_oc=AdqkABpdPkfBij0fYK90cEmojqMQstQGnx4BES4cJ2iilY28d-HlZuS9uu0-zHh8eOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8qbRyNGJ2siuRwgdH1MNZfgSXTUzRv099fB-hIyCf8Q&oe=6ADF5CBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnDFNn5rydgQ7kNvwF7q2Re&_nc_oc=AdpYAgGEry8KtXq-XZqMrSJncOcV4fg7BdLf9jMPCnKXwC4lgyuD-DYEUMBkiAcy600&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJsbvltpeRFhqIkKs2DLYyuC-k1IeAjHnLu9Z5D5liVA&oe=6ADF78C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-XbTMC9D7sQ7kNvwFyScC4&_nc_oc=AdqACnDMEHYxA4-IpWAYWzHaFRt5pQJTamEem3Bfv982ml2FI1Ej64A5YHif4vW8Mhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrsr6JKkEs6QV48QUi12881RvcDNODSz9YtxWpwTZw0w&oe=6ADF78DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG8fi7CRSvMQ7kNvwHEYw9e&_nc_oc=AdodMsQK4i5FqfRS-GgOHOmpw4i4To162CPWg-vOi0QbhncXQWj-DA2cjvHtXq-MRzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1ndR_gozVQzQOp7wSYgmrDt9cLSCi-2n92Ojd5E4VXA&oe=6ADF64ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bciBmliYBZYQ7kNvwFTkPYu&_nc_oc=AdqFs2QquoVXjEEuMZNV26XGdMv5dYS6WK8EyLF1JHSRpePRKAFHKcpGksChKci3V9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP26D3BqmGTOpxQlPSjKGGXQ7YRijk85B04MKmqauj2_A&oe=6ADF5517"}, {"file_name": "HickonuQ_1008x
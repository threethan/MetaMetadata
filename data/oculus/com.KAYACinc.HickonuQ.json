2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8JmOhg0yLtSkgqUEOrXJGQ7zl7VZOQvdUXmjcVobZag&oe=69C3E2D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqEA2gPI7HYQ7kNvwF77kNM&_nc_oc=AdpRB3YiVm6hqnSlI3Q4u7nFWLeq9lYnpBWb_9Gdw1MlBaIivzud1Q_zq5aMHOi8dWI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwu0VVkc0ZBtj5OOjv22PEIg2dhLNLFvUNI_HnWB03uew&oe=69C3EA3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yZIggIdYYwQ7kNvwH_7U0T&_nc_oc=AdpkTWiZ0Q-OzdTEze_grF4e2_OrsMksr5CAXit0efXvBV24d01qAhiwFrI5hyFzXzY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOgiczhMnDR4pHEg65Tw7k7o2fHKPU13ZkPX--LJt7og&oe=69C3CE05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLVYjXNR6QoQ7kNvwHC1JP8&_nc_oc=Ado2eB4RYR9t1i1sR9ax5MNvZMkzjvuBKSAqTL5-Xws9V_-kUkUdwujHrtUvVt8n7ew&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8cy9ZNvbXTq8X1b9SUPgJuo_ZNlsL6ZMnVRQx8r3XOQ&oe=69C3CE1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5emkIuNvbiQQ7kNvwHM2U_F&_nc_oc=Ado8CO9ac1rLUvGRzh12iXdndr9c1MZa21iIP3dSK6DfpomBEz2udIdtg8B3BPXkG_k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwMlcnI7CPCQxTxTWDNvrCKcJLucT3z82JZawmTI2tkg&oe=69C3F26D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZNYT6EIMkEQ7kNvwHk0fOu&_nc_oc=Adp8ucQEY3XJqlJrLIlPYu6WzO6ce1DwI6HB14wZhedt2n0rPkigImDWJX_CTAEdf_s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwuxo_5UlOjMJQBhZ4LvG9LRCqeZqqlyRzCEhVAbEy_CA&oe=69C3E297"}, {"file_name": "HickonuQ_1008x
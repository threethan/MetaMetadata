2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kMCJosf688v4O4uHCeRCePV4gUMPyREjqnd6cYuHhmg&oe=69D50651"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J21APF0mvzYQ7kNvwG4d0v8&_nc_oc=AdrHrKS6XYDT30qVhcJ9V76TXXHXYy31E4YbZZakI-U9G089S76dU2WOx1oWSBJzySU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BxcITOU2YQAwTMN_nnwywHYZnYnEIZPy3YZRp8buytw&oe=69D50DBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcFmKjSt6TEQ7kNvwG3DQ-W&_nc_oc=Adpca_Bt2T2q0ee-DszDG3NdYf_9ngVpFIWAsWKLSgVdtEfXve7Pe5t-FTfqWMRfpxQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ItOHYXyU7a0JSc35Xj8TO3yuUskYmD-OUTVfY4J4FdA&oe=69D4F185"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0TQRML1FrYQ7kNvwH2KNOv&_nc_oc=Adqu2t9v1LYF7FaWL9JEuTj7PubPyAV7R7KIjVBVddpqKNNEk5CnLmEzJFU71t-pZW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X2OccYPyAADQNkSUrLi6B-38vPSKSAMhD2MwBcYHlnA&oe=69D4F19A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDZpldGwOYYQ7kNvwHenNuG&_nc_oc=Adr-XwPj2nmONpwgmIdLfRN55jaFoW2gO42NOEstPAMN6ZYhXVg7z1WxoDKDm7-JRwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l3z7esXRNv0-i774SH38RAfClk_jvwJUtvRlrGeTykg&oe=69D515ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVrhsmNhsjAQ7kNvwGY0x0R&_nc_oc=Adp0Sp0mOdEAk-NOQ5nwCIYyvmsTep0ay1EPRqR6zEgfzQHAHUqNfCpJo3JoUlCqk-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R1DtwifplcV0Jp9jNn6qEVB5U521ChqGPcn07S30UIQ&oe=69D50617"}, {"file_name": "HickonuQ_1008x
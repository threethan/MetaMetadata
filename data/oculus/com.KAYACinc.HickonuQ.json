1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37UnJ8fXSTVXYlLKocPVTfjLDCKmAxXawpU1QxlliKnA&oe=69F358D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIP-nkE3pjIQ7kNvwFj-bOG&_nc_oc=Adr56NfME2HwYcnyQ9oIFWHMTQzBuhLXCX_UVcYRnYXDV621svr1dKcfwsDLhcwprpE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OBQSGgMvey6BCpt0_tf2GaqXwrtw674pd1GB98-0o_g&oe=69F3603D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odQmetJjqCEQ7kNvwHfzQOT&_nc_oc=Ador8bNRxfATp-PLQruI6XsrvpC3jFtJKRGwu_HRM8ro1SXLAfENQZe8ZY1qGJIqLoE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GVPSCX8zZ9ewmjVbOcEGfdgBzLiheV1I8eBTVSC1PvQ&oe=69F34405"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63guDQcvZwoQ7kNvwHQCQey&_nc_oc=Adqmm6tHRnYW729htjDcZILRYicI5TVu83pGgmH4bYIyfWHmr3QxdVVJdnZeYMluWv0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2w4e1sfivTlQFBnlvv8wGeusem-gNuA2_TzdiiArqXIQ&oe=69F3441A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzds46c0WLkQ7kNvwFvoY3v&_nc_oc=Adp5Of0GtM9YiNX6pVhXpYzCAcDGNx-jSzMM0pj-EdLzvhmbR3rsdBXfeWCSu0wiVq8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2REspdBEMYwzOO5uGc5Zkd-qJjZXpxqmMiy0Pl66m-uw&oe=69F3686D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsy7xRo1xiwQ7kNvwE-Z3NQ&_nc_oc=AdqRcDeaMBD1dAXQ1R_ipDt6W_dT3yS4ibIap2svYeXNhJzBs22OETNXeEjRC8AJRgA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qPljbj3tlz-uHT9fCaWlyIJS8dGGVYUxptjW8JfJ2Ww&oe=69F35897"}, {"file_name": "HickonuQ_1008x
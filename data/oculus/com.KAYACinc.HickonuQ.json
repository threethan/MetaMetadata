2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1goicaCAVvG98V-kM79onOcH5ycIOTn5Equ8WTCyu1g&oe=6AEDD5D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYJzFrIKIKUQ7kNvwHZz8zE&_nc_oc=AdrZoLvHIjIKUzH7eWZe698p1FDpZhPkaJ6akI33VWcK9LUU6ut1e1l6v7lLZ-ZDm2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsZ2qxXczzMmBLzkwU_fkDQjUgjhMSoljOaT620KvJOg&oe=6AEDDD3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkkDaeA5LNMQ7kNvwHXzqjo&_nc_oc=AdrbXMUUeYuVi4DnwRFlW86kw66qR7SJTgLzkCZfxrq1hrNOX5bFrQC_oqdybDyDwOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9lY2eJ1rdxrkfrk7eBr3SAm9O8twb0cJeHkYcIn5PpQ&oe=6AEDF945"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfxwxSdb8VsQ7kNvwEpffpr&_nc_oc=Adqw9jG_nXZFf9PQDW5D87m272Q6Ngb5z6FhfJsMjtXgG1KmDJ1OakRtCgD8mjxdpRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_4D4-NPQaYOHhJZuuNdNtsIn8gtcOCoXOKwv7h4V2Eg&oe=6AEDF95A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVHQ1aPtzAkQ7kNvwGJrwrv&_nc_oc=Adp5dk6y4t5WCL9n1fnI7u0HEa9M9skU20urnE8gHtVlD3yuz7kV2OTkwY2rRRZ648M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKJ4WSABEoh0BVKobUbRgQHhNsU48W40a68XBqFlOi7w&oe=6AEDE56D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVdR6nR8L7cQ7kNvwHwonSI&_nc_oc=Adqi9LQeFB7YfDD4HJofCbdKqmFZPU7ezLHqZXsh_v-yyWhuJb59Hyyxz9rQ2Vut0ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_WdQ8Iq-pBqB0-BpKuUwz0W1GCpXgjwRMRVLwF3uqPw&oe=6AEDD597"}, {"file_name": "HickonuQ_1008x
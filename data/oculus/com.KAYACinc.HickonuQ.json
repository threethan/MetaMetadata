1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD15g23wUlwCr4C5Z1sZsnVwFz9QGy0_oZnXwK48UZEew&oe=6A563951"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=337wGD-tjTMQ7kNvwFngGtW&_nc_oc=AdpbCjQ9rdddi64tyuhzGhv3tIAwPnm9pbTKP7umwH4AN3KS9k9KFi36gxS5NBUZCB8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBXyxN9gzqJUxRguVlC5OhetD_RDYzEvtq0lo8Q38ZaQ&oe=6A5640BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvAlqsZWdA0Q7kNvwHvu8tE&_nc_oc=AdpywW6c8OLkU9YE2otFam8ZDuQeHjincIAZafOTH9n3l-_zGCix45zr5Dnccx9YKt0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6t05mAPWH5dHCiElW-AyXVKErY4bOhNkOvTE9YdFy4g&oe=6A562485"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSjISh2pmuMQ7kNvwH3kNNv&_nc_oc=Adrtbz96cGRVswHNbRWR8xCNywdycQ6CfUWPNT2qXMB0TCxKHVfhK12cuEx-wfMSMb4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt2vp9zQRlVi1c1WfFBIak5kzjCmfnUD-l36yMd2Nx8A&oe=6A56249A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKN20YGdXAkQ7kNvwGnZqbN&_nc_oc=AdoxqRfLmGE038EH1HKqmnBwn7pxt11t9jDat2NAwqT0tnYPMF9bgrgREqiT7bcjw6Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOsNuZ3lRm84sbFN1lc2KCz2IbzLY9eTrhP4DU6W9M0w&oe=6A5648ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR3yHLhNhKsQ7kNvwGOltR1&_nc_oc=AdoqcJnJYWcfov0q0q1XLIdLVrs5vmHde1LodzwvHd4_Mo05xMli4SwHfugoeL8dFZY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL-9vf9jF8lc3KhAtmlEC1R-Uq-UjS8Bq1WYwc0m2RYQ&oe=6A563917"}, {"file_name": "HickonuQ_1008x
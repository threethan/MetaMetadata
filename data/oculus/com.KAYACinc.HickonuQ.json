1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFynZDmm-1wv70l7kA21LjxLS5fZq0LE4LflnAPRyK5rQ&oe=6A89A3D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yecpQ6p2jr4Q7kNvwHGZURh&_nc_oc=AdrsB84GEuipfw58BCHGp7sjKA3ephkqeufSOoycx56KZQyVb2WlqpOhcLNCaEQRq14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW2MWsRH9siJP2cSB0kAosUgpoS8qpm5LuSeMirqkX7Q&oe=6A8972FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jb3n9TVIIasQ7kNvwE4VjYj&_nc_oc=AdqaYLheNXf5NoXrZLXiLzdWFV4vpiaOs9bDaYJDRJDVTaThXiXJHicYK7Z5fYvNErc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGvwkefET0q1Cdur1DQeOwJsTc6aURJ1GuxvgWPylQHQ&oe=6A898F05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udSm8qRd36cQ7kNvwHzuDRU&_nc_oc=Adp2f7kjvxYfRCCI2IFqTfiayHKclRfjQZDRR9LH7asQt4YCieIbjcmmiuC3HyVlelA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOhi9RywI9n_D2fYycK1JiIeXfLEZNSgkVDzCoqaZOaA&oe=6A898F1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMWo0ox5Z54Q7kNvwHoN4OT&_nc_oc=AdoaW5BA-8PhY5XplfB6i6aOnUyjJuvt4TujwJiN5MR6zRmQAdGHQ8OutIXj-sEX1oI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoPZrCxKUKdbuRI6iHukgvJmjdZHM3gaiyXDv5ZPHnIg&oe=6A897B2D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJOTvCc1ftgQ7kNvwEu015G&_nc_oc=AdpE0CrJt2x3ZDdYtuu9p_ObuL8Xh9zvg0vmPwJHXON6wjezwI-tOq3WWV7qSUjeRQU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlHmMf2bVhFyCQT5hgRQJrA85GvD5OLW6PP9Q3g24H9Q&oe=6A89A397"}, {"file_name": "HickonuQ_1008x
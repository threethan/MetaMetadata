1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ghqF0TNhaLodJZ1WM4fTEqBMUMG8Aqsgy1wtpb6W3wQ&oe=69F89ED1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaamcOjN-50Q7kNvwEHf5Vc&_nc_oc=Adp2JhmN0SSdD2Pd86vf_9zJUdeSsSeUMBZh8wnsO6O-izgSbiKpuP3RICppNpZrOdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IwWHKfkKGd8nkMIFIZUyJBrUXaanM30kiLL9_mvRI2w&oe=69F8A63D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEgZUulCKfYQ7kNvwHbQ55G&_nc_oc=AdoGK0bejVsI_efOlbVNtrjfDQ6m5MwEiqsJwFQrh8pOIA6wi1K3azOWc6WWrsAYWkk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IvVFs1ykc5h842Qb5sizJl83sUz1d6exH4CtCvUxliw&oe=69F88A05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8GYO08L-4IQ7kNvwHiuyH9&_nc_oc=AdrMho31_c8uH-Mi2dKZgt8gFOCh0QqNPz5Z-ftiXXN_FhGAS1f6w35vPXO6qPzZ92k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af097b1XbhTAlPdDeH2Bj8E6Z95m_-wr8YWwDXeGSjEcLg&oe=69F88A1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF6AXYbec_AQ7kNvwG5n8Y3&_nc_oc=AdotVF3UvcBW7CeMAUG4sgjirgarzh5zlwRDe9CE3cc01b3868_EQVLe3HKOpf7G_6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XCcBCPqiJwUlx548B6GcTw1GmUqsLchBs1Hb3NYBwIw&oe=69F8AE6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj2HyQVs4pMQ7kNvwHIxVJ9&_nc_oc=AdpZL0DGQbUEROi7MWPcBvpDEk6Ux-YAYhypoRJSfH1pwxRBNkIBc9YU877i_e4QhR4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ykx9NpcfDdh-oi36_3e3PzJlsL1JPjsavTxzoQs5q7g&oe=69F89E97"}, {"file_name": "HickonuQ_1008x
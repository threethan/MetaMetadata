1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUjBtVwi0dJVtVymxPeT70uM8A9WTTDfZ9wIyPxskZ-Q&oe=6A660B51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMl8S0sUx38Q7kNvwFKKaRt&_nc_oc=Adri6fp5zbKIstputGucn80TgIXzAh3rnaivhM1A_M7w29ERg2hMCohP8Mn_w81jqkI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRhaIjpt1N4ci2X2fGNvXq8xVFBuITLCnzFsvJ64ZPUg&oe=6A6612BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqZm7F9DqncQ7kNvwEjFMX0&_nc_oc=AdooIeSkfU9qWGB8ZQ-yg1muXOYXEPBRd6rNoqkYDDqyRbWnRAU47DcCCnrWeRVSZ80&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw7HAMYYUL-mSchTgsd2F0-iP7LtdDCFlqT7veSP5i5w&oe=6A65F685"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu6x1N8CrEIQ7kNvwFAEGaG&_nc_oc=AdpBZoRCNkBk7028LXzWc75waML6ktl2RRz_Eazf0ab9llpRA4Dh5jlz5dBeKGuwLf8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGMrHKveUigOnUCVsQ1MtQyYtM6r-FI5GmG5sQibBlKQ&oe=6A65F69A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTENWKc2W_UQ7kNvwG3iYBP&_nc_oc=AdoFRcP7zePFnMZmdWS1SX7ZZ1GRDsPx2DFJcZjvUaia8KtlKI6MhF7b2HXKIrjfG1Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo0q8AeH1Xggpf1imCYC7X9R47mdpxL1N8Yw3EbnsKLg&oe=6A661AED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8I9QiPd-kIQ7kNvwH05hlJ&_nc_oc=Adobp7XmzFc6XwwzPY6zq6aBNSAwYHf8Zj2Y-ggVBunfdaO7qCkkuJatvF2WEGlpXpk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANGvRDcQKIdjWWT0EACC4fIheeIBqQk-D81ok5C4nIIQ&oe=6A660B17"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0E-zLemiUE6J0qGnfaCT2Txxe-VcotQCIYXY70RtkA0w&oe=69F5FBD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIP-nkE3pjIQ7kNvwEzuWHI&_nc_oc=Adq4APR5DUCAX7bzKZLAojSpFDxz-x0p7rTbphh8R2Q2329-Vyt0oS7L99eeaag9jZE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VKNGq7PB7PH_RhaBwwhmnz4QlaERsPJRXwjxbZ9v0cA&oe=69F6033D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEgZUulCKfYQ7kNvwFmtuON&_nc_oc=AdqH-5OALAmuUjIPJLXEsMZ-uoCUizla58pyPEOkOnI3v7tPm8liKMTOIzmKuKgXZyM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af274QzCbYq-oJBl9ooHg1Y0_SQJQkQOm0WHoO2fgA6OIw&oe=69F5E705"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8GYO08L-4IQ7kNvwHISHFo&_nc_oc=AdrdQFrjiVM1BCrUBgMJ0LHb_ghIK_tEqJqQoeXygzDc8bSSzGAQxzUQbua5aTjCb9o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0X3v0Irdplz7n2PYF82qgYIPJxTHl5dRmz-yzcKerbwg&oe=69F5E71A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzds46c0WLkQ7kNvwEAS9Vi&_nc_oc=AdoYhqWy8Pt6RAchRYgj7WWpHOTVCf5ge7MU2Idcwi7CF2C723ZhZduGk02AubkbBk4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bIDv8xP3mhafhudUpFZ2vZNrP47_GRz3egMh7_mfBCQ&oe=69F60B6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj2HyQVs4pMQ7kNvwHnBq_d&_nc_oc=AdrNqOHpiMBOKnOTPLAp8MBwvOHv6bmD3Bs7f8S3tEs-byp5-t8Xe11AtY65YgLkAIc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0STofjaXWbpvZSC6VcjKTWRKf5Vv5lEXpwk7jUJGv2vg&oe=69F5FB97"}, {"file_name": "HickonuQ_1008x
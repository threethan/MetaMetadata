2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hPljnLJaUbePGqFuFfCofkPpE3nPnCBgUJ6tYgi2Dew&oe=6A144E51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlRG2D9BCeEQ7kNvwGXx8uE&_nc_oc=AdoksgFzJRW3Luqo0_t4PotDjm7FejlHFyDve6_aG2usd8z-pNtL0-3-mkXbSjhNRM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hTYWKm34htrDobfq6SRtH6-0fWes3GnwBaCpckfdYXg&oe=6A1455BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_UbPT8s5BwQ7kNvwHNKk2l&_nc_oc=AdoNMYvHGtvPaYJgv5WSq_4tDRm2aHK5qGOn1lkoj3uSiyjbDI_Ba23LYgxYQvv40Z0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JugY0SGTdoTuq5hmR-xOGkOWw1VtsCo76PuE3hJcmlg&oe=6A1471C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4PCL6_XpKsQ7kNvwFwQAQy&_nc_oc=Adqge3tk5o3LEd-unyvKPhm465q0ZFfIFflE5C0zggEbq1JUJgn1GPa84E5c45PFV-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qU-qeLIFJrUb1lBhgnD0E9kz9XWBNvRT_rflZFZjUbA&oe=6A1471DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBZNQeYBQxwQ7kNvwEBJaDc&_nc_oc=AdqtCWFLbizATfV6xh7vkZQdaiHLDYZEiFar8Yj5fIJpcKe0g8bUk4OVzqAGX6eEUR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zS--NHk3smIJvOyFLXraJ8rFjXhb46scmdyZ0ixZTMA&oe=6A145DED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy3fSLq2pvIQ7kNvwHLM5b6&_nc_oc=Ado2MmB1pLVaVD3ruuxJDIw9s0WsI3NT7z65bPd-jBseFK7OP635_FejS7ktmelsWlk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cZkPIA4ZB_uvSId-rWGujpIaUAB7O91fMz4DsJsIxVw&oe=6A144E17"}, {"file_name": "HickonuQ_1008x
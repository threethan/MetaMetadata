2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mgivH22512BLVIM8w0cW7AFH-sjObfz_8J9y46fcNfw&oe=6A05CDD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi48_J_mnckQ7kNvwEMaq4L&_nc_oc=Ado3nGN5n4QC5yTCHNEXQo6iuc1JNh0ErW3bLPhDJoSofdI-VhG4RBgrTKz89e9M8uQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xr6KWgqGU0QxwzRupl-Omvsjur1AocPbjuhcdwqsW4Q&oe=6A05D53D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEy9lboYaLoQ7kNvwG29RY7&_nc_oc=AdrPTAc1gnbv_eA1xEvEEMbGF9deLFLxZfv5-WKILYw9u-vNurfewnEkDfP_NWaxQoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72YK2ipq36AQAsa6bWzHZxjX0BDGtbYXSlwLS_Vs8fIQ&oe=6A05B905"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leM5nR97bWQQ7kNvwGCUoLP&_nc_oc=AdrWTpeVRc4jsAO90132o6H6UOiYnvLxc9bj6sTOinm-nBOTEm4PSxZroU1irfIQryQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U8wsuuJWHWIDjxUoco70-_8XXFWF-l3PYhpenVqSh_A&oe=6A05B91A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PReP8dVu2oYQ7kNvwERknKe&_nc_oc=AdocYiMUlcO1qOma4zK_68Tg9jycT__sEzI4U3FM_QrpE7sc1QDN9bt_LrV99uEx8lM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KYgI2_ncNW9oNc_1ytQnrjJ7tlHCB37ToVBvsjRUqFA&oe=6A05DD6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBxmobDPAVAQ7kNvwFvmC63&_nc_oc=AdpUf6phrIBv5GAdz56egslIBU7zTUDZrc4hCaTyXephRN3HYMpHKmVMVa9QKH_PWw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rsOg3Ij7l4VqmSybdzoCTVVYZvz7ybxVFP_leyyB7cQ&oe=6A05CD97"}, {"file_name": "HickonuQ_1008x
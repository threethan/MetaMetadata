1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbARtBc1fpBoyWRbdSSgZXuJxCs3kxuDBoisZE9jhs8g&oe=6ACD1891"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErOMgWzUeNkQ7kNvwF41RQ9&_nc_oc=AdoFckSm_06kq6O9Pcejl6iqg82RDFE7L3wA2bUNYbU-4A57eHTyyHl36I41jwm_Z44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOclL6NEV6_xTyFLatK72q0-LInkdK7lbp2jRpzHSmlew&oe=6ACCE7BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv0Jtw8IGeQQ7kNvwFj6ci3&_nc_oc=AdoIfVM6yQtUpRcUshejlEP3YSF0X2wUzZcswYDeJWBfLFhcGjcVJMJIiCWwGdPd7p0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9DkkjdyxedTRbUvpq9MDoqmLlxUurCH7LyVcQjN6llQ&oe=6ACD03C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ-Xktc6NV8Q7kNvwFk7Tnx&_nc_oc=AdoUIyE333xSlrJmmpcwA-aulu2vGveco8b4LkOxwHBUY5y-2h6p73t3CM-fRTYSdj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsqGAHiaeXL6MS608Aib_BgeRTKfekmGpGIEwYZGNCBg&oe=6ACD03DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6x2irMEQfIQ7kNvwEIZZwu&_nc_oc=Adqwb5L_jiO1kRHQNfXgiGWQ6pxvD2AavW_SqXcCCRSAbaorm_FsMUrmR2bflhqwJNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXnWeDYqt5ohcJZetlKvtzvkh2kaETtSRxXUt3dmIcyQ&oe=6ACCEFED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QaLQqulMCQQ7kNvwHZg6QU&_nc_oc=AdobEURKQR9bM4u8LNOwaJVTJn_foWVzzn7Ge4a39TZyQ_apDY5blVH4MAyuKXsdXY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNarGukyKDxAnlhSQvcsstvrL_kSAkRUbyZRPOJ5vT85A&oe=6ACD1857"}, {"file_name": "HickonuQ_1008x
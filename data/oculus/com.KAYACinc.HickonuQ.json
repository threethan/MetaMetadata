2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZiypBd2AZjS7SNHelnZJ0LkZc4vDNOm--3iK_ELA_0A&oe=6AF89A11"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b71YQeQtvoUQ7kNvwE8ZAUD&_nc_oc=Adp-YniJQCjYsQHoJbmOCpvOQl6580mMtKu8Bw5EFk7ODdXw-KfSK3VP18JNWzG4iS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPtZj81rjccapvayfX0DMSdG9a3ZmwkFh3vbZVbbEOuA&oe=6AF8A17D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO6aF3ThTLsQ7kNvwHdbxH7&_nc_oc=AdrEH5r224bafJLp3k0gjZ9y3vcuLhhGDrmkEQaDXHZyJDH2nP_QMymFAhj_VmbXvU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6j5bVn2A6z-SEHOHPMpvwzapQKIE9uSGM4h5TXF0iRA&oe=6AF88545"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bapT-Np-rGEQ7kNvwEzXJ7g&_nc_oc=AdoohiWLXOpbzzvC1grXEIJW8toue81jArnPquZa_bLDcquie4eW_cssH-y9j9LNwRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHsdQbtSqrjbioZezu47liJEQSOe1Hj9C-42GNrsVVTA&oe=6AF8855A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBtmEhso7ZcQ7kNvwHQI-aL&_nc_oc=Adpm35G4QZPrVF_mmvhhgHsRLudnDf0CUC2zIDzWzIdyIqbsc17BRL2T9RPmr6UmOeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNJ3vCUEw0efJRIq2SiQsESEhPDF-G-3FvZhNHU1wl5w&oe=6AF8A9AD"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UckDtvWtkF4Q7kNvwFxcYGr&_nc_oc=AdrBiYy4a3-GDf86r4EifPwC9UCD_uPvo-uBo46N-f1-BElPu3Qk2m4LGqSMi8FBnDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg73YxowNv-ckneGZHNAoKnfU1XbaDTGkWLBzeMgWIqg&oe=6AF899D7"}, {"file_name": "HickonuQ_1008x
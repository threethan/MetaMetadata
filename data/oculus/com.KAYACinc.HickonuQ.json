1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzGNcCd1cUBoYxFgk3RZsEnE1bluQzzeS8wxuoz5sLaw&oe=6AE349D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki1p6kJrEH4Q7kNvwHxBp1R&_nc_oc=AdqIhR4IALVEtGJ9PVlq7apFrgOzqK-cY4h6xyu1MjEkYn4QjunDDdFp5KsBIab4Jjg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGxi9d_XyCzg5AibFDWTVzRSUXCT1va2t4qQxVVlt5lw&oe=6AE3513D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhmKD4bSRgYQ7kNvwGTNgJ0&_nc_oc=AdqLlVofBvatgIvQe8XZVdA_NBN872fUmeuuJR1SmA3nwYxkkbkQJfLEHYFC4c9E-_c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvlOgIluFCH7NgsDkR-myUoEHCrKziNdMLZxp4VnwlGw&oe=6AE36D45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPPScKeVMgIQ7kNvwESmzkM&_nc_oc=AdoI-IUWSRFDQT1v05HZSV_CN-eDNE8W78OA3eUhOz6RcjUsn4_HbzWRZ7dmbRwR3Ec&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHXfdhj4-0yrwSM4l0zYtFVjxQ1WSBQ5J2HwnUnKW_XQ&oe=6AE36D5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5NoL2yanqQQ7kNvwGs_pXX&_nc_oc=AdrAyha0q4_QbU3xySGa2AGHy9S_wDmll_D2_enXEStgojSpFPzwSaMxRKUB8ak1SGI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeBOUxbuNhvbLm2KWsjXR8py7_nPPhPm8nFWcZqoCAYQ&oe=6AE3596D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNr-Sh_BGOIQ7kNvwE1iAyH&_nc_oc=AdogRj21PIHkl_K4162w40cUgiQqu-VV9_T7_X__nyNomuXAl_xUuqKQETZMwGf3Pys&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhZZhS9DYEYYcWL8g7cTskt8ItOOmzdtG8RaTDNY_WPw&oe=6AE34997"}, {"file_name": "HickonuQ_1008x
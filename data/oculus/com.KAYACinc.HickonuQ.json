2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93dAH1TGElrg2_rdi0KPvIzopAOTdQubsyQ3AnAAZN7A&oe=6A2D5AD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DV7hjNTaxQQ7kNvwFFMDXx&_nc_oc=AdoNdh0coESmmciFHKM9DblATqfqkoZHld7jJiAPAj9LAXLFA7apyof24DbkHiNSEt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fDUzGC87XLbHsTho60SIZuPPOSS3ZrQWdzP6Rzsq9jw&oe=6A2D623D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsQrkdcbDi0Q7kNvwHphH5a&_nc_oc=AdrwGeEmGDBSc_1UFzpTv5loaHjPQShzf-ATWxZvMcn6u4QfLSnyl5z6Mp7edsYcPUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_MP5yyVK2KCOQ4urJ8a72YJSKsn3XXSPbqSjZOGwEHw&oe=6A2D7E45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYV1_FdHsfoQ7kNvwFVzmbR&_nc_oc=Adr1Y5txn0PoT2ZJ26ET5NSc1odNqjxRRdMCbpqkocsK7bYp8Ua_U9VoOKwah-CxSSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qH1y0hoJQ5YckDD5y2PfmjqnnuLqeJ76JBF2Pu_e5Dw&oe=6A2D7E5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL5W9iE3AFkQ7kNvwH-L46k&_nc_oc=Adp4vPRFBwHl1mQ2LiAE9oMl2LVYZ5f7wZtVk_G49TUrXA2cSCxG3s9gh4fsdbDVOtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1zcg9OUGHiUKgP_aqv4XqZI59_9RoHON76fHZCiksYQ&oe=6A2D6A6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pwf9OdiXeHUQ7kNvwGfb7sg&_nc_oc=Ado8VvGTFG4LvcQNCIY-aZhJTiYm4NlD_XyT3EfkuCoAo4mTqoSyb_g4ZCNCWga2W7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hhndvzXJoQ72wTFuJ2ZYGCunWgKteY-GG4Qi1D4XHOA&oe=6A2D5A97"}, {"file_name": "HickonuQ_1008x
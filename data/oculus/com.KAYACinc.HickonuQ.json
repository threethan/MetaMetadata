1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Mz9z0VvJtrxyvNzTagdF_52yavNuKRi375T3SpYjAw&oe=6A539651"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbl3XNZmJwYQ7kNvwG__Kib&_nc_oc=Adr8_hWTPotGlNj3ldwJhWo6UUPwxuPL5E4xlgSqxksrubliqMeHt5lTk4dZ5eIplgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX0SH4ZhUA2FTYXAwOnHbsZOEQJEUmPe3jYD2zGVg_uw&oe=6A539DBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLmiFSbin9QQ7kNvwHok9G4&_nc_oc=Adrw6OHgTcBb60bnFIwGbFILHlW2ctrobuWTh3FFmAz3dX7IYPCDk0XiZUyObb6mMcc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI0-e9sNsiYG1AZDHdjssWMDfkxp27f0OfBfmRIiY0yA&oe=6A538185"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnYPVqOzwSwQ7kNvwELlqLP&_nc_oc=Adrp-3lggH1N5VBfCgjp30ucC9uRK6gk3hbIycTdFJtDs7gkcOj78Vf7s-CZ6eCWFlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx7Vygfbw3psQn4A-FCbAugAqsgkJSektQRQQ_8c_5TQ&oe=6A53819A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7HfymU02yYQ7kNvwEvpBpz&_nc_oc=Adqa9Yd7zGiUM1szufqKLpIwnRdBJTyCioRgJSNvr8mblpJ5vBZfnxvF0pH20RCSXKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEqa6JJzJZlfiKBx1DgjLW5Mqbpnf1Yu44yHDUO09jag&oe=6A53A5ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEVYtYdie-kQ7kNvwG2vgtf&_nc_oc=AdqqYFR51iugihGcmtGDwbPH21WWN8MuKZP5e618O9qSE4pLEZccJyRrF0s4F0ZlAhQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXAl7QstiTi-vhbg5OPRpQbWqYRpt1JhMfLpRHJ7ifrg&oe=6A539617"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sVb_eU8xdcKnncekLSt8BHgYc0kfanSS7SrROGuaRow&oe=69D26351"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbLyphm8OBwQ7kNvwEpH0cv&_nc_oc=Adr8nGbGI0AuMV4LTICXMfUCDORvO0QcGWIzGPs57d80ULSFMaAB8MjaKQnOgWcr7bU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Trr8zVB7jAHL9BsqDLTgvVZwc4dJUAseOxVgXFROpuQ&oe=69D26ABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcFmKjSt6TEQ7kNvwGapOb4&_nc_oc=Adox3j8VMDMkHFaR7Ey3vjWG7IkVat-xj2xFGMwCMg-1IWnFWUg84SwYK4aqBqSntL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zH_fweTx8sz5KqFc23SNbu72HN-DLDDDDdKTk6MZ52w&oe=69D24E85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0TQRML1FrYQ7kNvwFbam6J&_nc_oc=AdoaIs4Rgb8iB5K0nvQ8DtMucg-nLiFDUBuSyU3JoG_FA6sfF8Fpy4T9mFZHrWsnqko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qooA9OqpVmItyMB4pOiH3OSalqF7Dq5q8hEQkPYh9lQ&oe=69D24E9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTfURZktX-EQ7kNvwGEE99t&_nc_oc=Ado2LtjvGkSJfod0YX-fPOJTMiGADkOVd8Kvq9l09iR7HSehe7lOyLJj532gKR2PTxU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XsVYmtZ-MiATE-njNwqc1wKqXIJijzlRdqeIvWdZN1w&oe=69D272ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVrhsmNhsjAQ7kNvwHMhvEe&_nc_oc=AdpBImWxbGigG9nz0t2IN9mML-D0-dVozpIM24V-kdnJYQ5VFoknv6J7Gzjn0IySrX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bzvsF5HjUH7ar51T6U1FMLz3eM2RKwJfEj2gpE6ewEw&oe=69D26317"}, {"file_name": "HickonuQ_1008x
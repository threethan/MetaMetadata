1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XXANM9nwvauGg463lvxEQk71TFamhrcC5f5_7CGECfA&oe=6A202BD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJFylfBkus8Q7kNvwHJno-V&_nc_oc=AdqiLDyjUjYOd6IWPczlyz5TGrceapAHw2JFGQI9lZo_b5_DuDIVGYt-TCZqO2IXjpY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P6fkB7z7g6Oshdml7pP_gsZTFILp35NVVO3PIjc3CDA&oe=6A20333D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVKGoZ5zFr0Q7kNvwG_Czfa&_nc_oc=Adp94o2z27ycQH5OxqYMjCqAH5VhJMJc51CfavjL6OQMFFxDIOpZd-_nJktKWapdXaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ekOr4tWxyKJQhyVQvkLEtRRbQa2XxXUPONiTvNF0tAA&oe=6A204F45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijYLi6Bx0b4Q7kNvwHuspok&_nc_oc=AdrTtA434M_v6Q0x0WO6O8eUVJ5cQNWcxuIXpl81LO5a1X51NDR5jLT5HZyQsY6vE48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RhuF6ZAIcjHLM1kJw1nS41UwEZ6l6-lzwzBv6kYhfrw&oe=6A204F5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVUebi3EEp4Q7kNvwFnofme&_nc_oc=Adqcl4gbsCtP8uFKurzc8yqrHREGedTRt35l365uYlp3cDP43PgsQPTDrKsU5yb-5yI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iaO7vPpyUCgTtjixiywzS6JHyz68GaU6NZK_GSMDvlw&oe=6A203B6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjuzM3dIQ1UQ7kNvwEsw2WE&_nc_oc=AdoQ2feA1HGIyUPLzIu9W_3qA933SbcetqXc3vL2ga7fsq4S0fLctq9jJc2kYolie54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GwSCWcyXD82qLkJ_9NUlG_otbnaJJXPpZDZK-Au3ndg&oe=6A202B97"}, {"file_name": "HickonuQ_1008x
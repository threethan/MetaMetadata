1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GcBMrEF5Wi1bknrqcVysKUkTpFFTUVp5iIv2SDkFS-Q&oe=6A242051"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FXUD7-qoz0Q7kNvwFN14uF&_nc_oc=AdpUZW1Vc_EbI3U2FHcjrwgpUSo18y2-ty094i3Zi1tXAJLI9ibiGuylctnGOeIxZEc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NZloPJnUNbJKC4BjyKH9dYcebjprcY4OP21HSEHiE5A&oe=6A2427BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tbklyoxy48Q7kNvwGYtqa2&_nc_oc=AdrosxY81-rUyoXpuBplfhBj_LefJKcTnvVxEV1mHRIoR1NaMD4CfWJumtRArY2o7W8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SJigubZje7P_J7xk8yK26BkjrS9e936Gr6JYcfpbsoA&oe=6A2443C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZhzYd4uY5AQ7kNvwERrNRx&_nc_oc=AdqCC2rwmuwIO1WLGnDaNYmVnpB2pOjNUJ_jXJ2KzbGBPLw4iAI_oO96mt5CTtQUEew&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gY9sGq6QlxcvjK2P7I8-iQhogFHZFvruW1mtgG_SwcA&oe=6A2443DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX4QLDIJmGUQ7kNvwG3bUMS&_nc_oc=AdrwgtLHXSvNm2bgHzCeZ1tXoV4f01NRAwRzuL68MNKkKRsM0X3p8shtktawDS_YnlA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P3xX9OFp_x50Fmn5F16R-MXJUbkRGNMARvVyA7WzThQ&oe=6A242FED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFOBYnOopMYQ7kNvwELlIYN&_nc_oc=Adr3gIel-Fhc82w0UPGTx4ihylxcWtD9PePrEst8tbUmlmSC1QVXsNsTou3Z-4-r_L8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80SvHyxpDMBUx0frd_fu1TxNIvCJdP4OZg2u8QjhDSLQ&oe=6A242017"}, {"file_name": "HickonuQ_1008x
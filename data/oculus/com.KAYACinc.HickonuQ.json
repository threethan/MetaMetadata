1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HfWfgdah0MhSRP3j_aoYeJM1iAnTpNTQTDr-ffNyuSA&oe=6A4272D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr8VUIacwFsQ7kNvwHkziSy&_nc_oc=Adqevm8lw3GLkOa-yeiOHNEXzv-IZg15fhWIBmWsRQsqIWm0EU46fO3eimW-zl0s90Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9--SURQtjid7IdU2g0RS4jzLw9SOmWf9uPgc7WeWJMpg&oe=6A427A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm9owX4mFMgQ7kNvwEBVspT&_nc_oc=AdqgELUGMgDvQ2_R1IgZMPBXL_9_OA8zWokk31lYjBlGWZ0GsSf0m1f7gKEsAIWIKnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yc6WK4h_-Q8tPKgv75aNHdPVSQ2I39JdjY6Wd1AFulQ&oe=6A429645"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnYdN4tPtCYQ7kNvwGcHI6S&_nc_oc=Adp-oQDvGa5xkv-ci4AO-4umdrSTWMiDS-0YYpzJuFIKwcytmRkCmNUujBrZXsVkrx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DMU0ySa4kHXu0L42WBR1lYStssKkZfqBGWFI54bQuLg&oe=6A42965A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBqcxlEbPzYQ7kNvwEqhX_a&_nc_oc=AdpaHxhK2SP5D3ewvQmrPMEG9Rs3AgQmCVD_DvPXvVJquofIMbulVdiH3XezlUgxqpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zsqeUIgCoCoT86snXxZL0LYObWghuLtOBfvuCjC4BlQ&oe=6A42826D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9BzDSzqdcMQ7kNvwF-VKdz&_nc_oc=AdonTW9wKJ38PIp-QTZhCzLb5Xz2L6J4Aiz9qrJqWCX8YOeYDlLg84iNHoOi0RFyTSs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1Dhfr7_tC6wHgbG0Dsry3qGnfF4fL26ZT9jbcokoGpg&oe=6A427297"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx9sodFmP3po1AFOYJwtiYZFThsyptykI57sjdsf6s6g&oe=6ABE5FD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mHkfsGnTIEQ7kNvwFCiL6i&_nc_oc=AdoAV-VFCUeNkKQLGX77IECytx2inpSAKxOqRYFFiDKsLN12bb2WnxmFBd8zvu8-O-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2YLHBkjRlWzZ-AOmsC8A3bjwiUH0zhTQI48BeMnM5Qw&oe=6ABE673D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQcTOLJnlmMQ7kNvwGt1KvJ&_nc_oc=Adq6EFm0G12SZvjWhaUH84ZM9WWyhI-aZfrq0Dbs6xcX8akqnY4QAbGQOspuYP_-ALs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIWj8T2MA00bUralO8VVUT09DazMbq8rap2oZBnrOiyQ&oe=6ABE8345"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IK4hMKbWkGoQ7kNvwE-Yn56&_nc_oc=AdqdMBOL-QDymVvXYuKZYWB3YvivSqyvvOrdNoED5R_l9G4mnU4UavtQ1WWWEOzzFp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo017XyeDHVUb0_-6SqT505Jv9X_-l0Ek2YB7MYzKzkQ&oe=6ABE835A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wqWr3NtmywQ7kNvwFq-X6m&_nc_oc=AdpOH2yVNZ0xDD_BPvQwIPcvaPzeutvYYjBtDRUIY0uV6x1BQ5oJh3FQ0JyEHNjnWBc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL49wHU_E9KvuRy6XpRyfom9EvonzLwLksSPBhexcXTlA&oe=6ABE6F6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52VCKGAs_p0Q7kNvwETpmwy&_nc_oc=AdriFNeXYC1FDmpSvHgHOx3nEwXogMghDMoBEWzYHhqwRLFqVuo-G1PpVraYz5pxvZI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbtnjtrq4y3cs2pmW26vU1ZzvG9i2E3DUubncu7DqJ_A&oe=6ABE5F97"}, {"file_name": "HickonuQ_1008x
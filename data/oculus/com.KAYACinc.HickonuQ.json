1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tODCQXACVw50YUnkQDl2xLfcnxJx2ZLKlpS0xwWex5Q&oe=6A2814D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tec2B_vp2UgQ7kNvwFsk6YV&_nc_oc=AdpElLT7dIqYqbOAXRx8AkBrDN-Atkwl6IAwOOCnrjBrCYyPBI8uyBpByu_e2lVlWwk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8of1NM4A0VT2cF6E8mvxDWflfhm15gen5M2AHNXtuc4A&oe=6A281C3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNlfZ5qmZBwQ7kNvwHG0z_z&_nc_oc=Adoj5ud0KtVNfugzW7AkQwqFSFIjlMGA13YgBDWXQCR30hSxgcpyA6ipNC6nBvDliKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sFIYTf58MLqCSjRwEKgTJesBA1mNX00RVfk5XFGNBug&oe=6A283845"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB-Ff4vbeQ8Q7kNvwGKN25q&_nc_oc=Ado0F22obdeq9Ai2qP3UMQMpV00l_20-AhTPd-dUIb5zD4-yGnQaNkZcrn75vrNgreo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BvwRYNtMYo41cKmmYHMwCpxPGoL0Yh8cRx4Zo9TMYNA&oe=6A28385A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYUY3Zad_5wQ7kNvwG6xsEy&_nc_oc=Adqj2BMGleQuTzlST2rDyX3EGOqzBk4Iu3AGDQWk0UJTHQAALcujBiY75-ad774R_KI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IV2D_gG5KWaRetUnL-jsmiIRTeiYOTMS-y1uoqDIrLg&oe=6A28246D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU3R3crtLjEQ7kNvwGvqfWX&_nc_oc=AdoBXGZBDXaovXaM9kFtv1Bk4pKOC_FfvDhSlUruBl2LoT7FkNINNcOrMqQ8GR6FOao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KTRTJBXvxNOJ6KHdyFtKkyNjbfX39nSLfQBamWuCocw&oe=6A281497"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGILgGdxXdft-B_T7GKtJD0vtrr3Im_pMOLVSBjygZCg&oe=6AD0D4D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkwcW_HNeB8Q7kNvwF8wF9k&_nc_oc=Adq9ww_Nebc9N2rEMaNVw0I_x0s9gJU8BYCmDG_LyHzA7XHByUbQ2XxfJ9oequX1mwM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnt6FnlRVG2a2OuvcK9zuZFETjv0zOzC6d1TmoFggm7w&oe=6AD0DC3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdWfZd2VGo0Q7kNvwGzn2jq&_nc_oc=AdraoRfs-iTn3BNzK-0DYTkzaHvCnPiGOMXwFnHtdXw6_ixVevE5CKaawB9pXDGvT2Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3xx4NHGoMHUIUE1aLSnHicUvT7Pqg-zHZX9hlG0d6fg&oe=6AD0F845"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OnV6rMN_xgQ7kNvwE3LTe1&_nc_oc=Adptmffp5xt6GlgRgbCM3luotprrsWlOLp6vcBzSAsue_-iMuvUILMNrPeCuGgPA0Ew&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqrGTq_ZufVEJRURKC6OAB38W1H-E1U8PfJRZl1gjwng&oe=6AD0F85A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCL1odyL07YQ7kNvwFMnQ2L&_nc_oc=Adq7VkHVagyxmacmIE8Xz6jzWG_S_WxfZfM0OtFvIIe2r7BbBsE2_zmpBcugkmNWq4w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-v_UxlDQq_fFRUE2WM_KVHG4iXUF7buaMmQ64ckBKRg&oe=6AD0E46D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhSrOOpdw8EQ7kNvwFa1y5J&_nc_oc=AdoiFEKn1HJRyf9pKISVYWxHqIktocJC7q0Dvc2fjR9aR30KbDMiRy7Ry9MA4wf2PVE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLW3y29rbCl_3U3DUh48YMZd4QkIOFDpgWExTunF79sA&oe=6AD0D497"}, {"file_name": "HickonuQ_1008x
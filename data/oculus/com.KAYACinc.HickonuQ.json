1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNJ_4o-2KW9NJ8gQJuHjhLhedtYMWip-SJk3mJ9VCr2Q&oe=6AE1F851"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ki1p6kJrEH4Q7kNvwF7wpDB&_nc_oc=AdoAD3Y87ZYAe6wmj86wuiU7B8JghXN2h7l32Wm3MtTCv0rkqaxZZWLGOTxz6mUIdLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTY3hN4ant4c8rHG0WZnoo-_HEzxjI6BBGKRNdkDKAfQ&oe=6AE1FFBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnDFNn5rydgQ7kNvwEH8Eb3&_nc_oc=Adprq-PWkErSrE5GWRB3Nb20nGm7Bnqzd8HvyPW_QMS2eKcUjjQYZE4448r7VsmiJOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXitIM4K6Tu7oZIu2AFNoJLexVHuaiWXAZYyZl8ma0-Q&oe=6AE21BC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-XbTMC9D7sQ7kNvwFEN5DC&_nc_oc=AdppCla6DjMN6-_yHPST3kGqQyO_Bs9Y8yh5PGNu7qGRjvf_mAAohHht_I97_7mg2ps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtvX_aeNZbnXkecP0Uns4awIDgL4mortqbjGJ5K9HOdw&oe=6AE21BDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5NoL2yanqQQ7kNvwE4hLd0&_nc_oc=AdrY0i81zvtuYIR75E_cx3Wif9hbyHHIwjwmkJ914jJnwQwmJfZqKO4-9lmpW_anYQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyHclyGiqVr4ikERNGATHx4fLpAq_lLo-I8K_6786npQ&oe=6AE207ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bciBmliYBZYQ7kNvwG00DZx&_nc_oc=AdrXoirSvOFBalKTnrXaz1x-Xeq9AgFKzr_nofCjOXUBQbydCB8I1XD8bWwRV8Ci9-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOENabcLfIh8Ip9XRj-pC11AN2BajjCCumHdiplbx8cKg&oe=6AE1F817"}, {"file_name": "HickonuQ_1008x
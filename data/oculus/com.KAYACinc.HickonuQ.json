2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsWSS_gQq8KHQBdH-pGk3txEgRlme3ljFxzSmFnaf4sg&oe=6A709751"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRm0gZkWpVcQ7kNvwFoxwx6&_nc_oc=AdrvH9Z1t67cQFUsrnXlgU-ZZqU4dG2801nOTIyKkbVDXg39FOthtEbLHaDzbx7lrBk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz-a75QZForCC54U-1N-GpOa0hg3tzonihpgIUnf4tOA&oe=6A709EBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrmzUnpwv8MQ7kNvwHnsq90&_nc_oc=Adq8sfgyCGEOus2iUT3fCy25hsgtZRJuvCgjihSEtNd3F3AqjlD7Ldkm7qx3W_oOOec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFifFbqeze_GCeY7TtzrJOIYOyu63giNLRiq2jdPeVByQ&oe=6A708285"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOEFU2ax-hAQ7kNvwFdQH4E&_nc_oc=AdqFSEYeurfLzghcIHUUihzhLBk46qgbvMnjzKu4CY6JCtN7Z6B-8_NADxE-QBYhN68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr5ARoU-92KkNC6DCBE0SsxmzVg4Crc7m46rPpZaaubw&oe=6A70829A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO4l7f6cvn0Q7kNvwGWUTr_&_nc_oc=AdqSJZ_7hjlp59arQShC3ZUuCo04CxF7-7aSvz05WWSN6jij7NlQK4zGiNb5uDOOOIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGztg8k4G20MaNVdKEPA1Loh9_3U9ovdMxS7aSgAJ66GQ&oe=6A70A6ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVS95iydGdEQ7kNvwErSs3I&_nc_oc=AdqaAUffMgetioh7zZlh8i-DhjuAdPaaCeYG7U6NVAypdRIHuy_HQFYhY9tarsbqFFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaRIJlByd0gLLLcF1XPTakKayqZWq1sMLbtSOagGp3SQ&oe=6A709717"}, {"file_name": "HickonuQ_1008x
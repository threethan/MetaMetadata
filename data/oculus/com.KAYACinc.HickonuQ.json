2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-7jLkJXMtB6GGdFbMufZuCZqsvMNOBOt2_FtL0c0d2w&oe=69E23551"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u85DxVoK3pwQ7kNvwG3z0jW&_nc_oc=AdqhBjCFQYZBbeXCyBvyQgFHTOaElLfphWyEDTB-Hnh4Gv1c9eZHXTBeXeoem4KwQPg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16m_dr8n055ulsQ4XE5cI1t3pjNVndG6Wcacn-tsuG7w&oe=69E23CBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wptOtRU1vFEQ7kNvwFt_9Rq&_nc_oc=Adpuz6LCDl_SnVuvLaL1RDSwrK6fYqY6UIYhaUdjwTeessP1czBGY5OTQB9XdSYXelY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h0FxpmMTYBAXGf4763G3d-nJ8xWfP0s1s0U0nmOl9wQ&oe=69E22085"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6glqs1qqGM0Q7kNvwFY7qc-&_nc_oc=AdpyZeiRLzO2TyY1d1mquqLNJGnhl49OdKx5OKvqPgr-SwbTrEXEMkgy2xtGtLTVzOs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k-OEVc1Plbruo1vuwPd2wg9JF45awcZZ_U_Qh2A4l-Q&oe=69E2209A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHbo-OH1XcEQ7kNvwHnb0Mt&_nc_oc=Adrz-HOKKVhAmjxjTGlreCbj_pGV7G5PKe5rpvXw1IFh2hWOd5OHi1hag7Y0wuIUIkc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yeA3B1vgOYdBFi5iiWLsYnq6IqdEfXoeXI9RC_4KHsw&oe=69E244ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVrH2O_YbmoQ7kNvwFgGiMf&_nc_oc=AdosBOIwLxdA0Bjfy5LAjSgkSw7n8GAJxN9MzaCfkpOmb51qfX6KIHNvToo74oM1wu4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YrzJhTBLG2t8kUYlZis9by6QVHl9aYppjjOOqkoqoXg&oe=69E23517"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84Sl7Wh3RtfQp0FqywWJLXk6YFy5QZBTVr9PYgZj0ncA&oe=6A3FCFD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdyv9OmpGJoQ7kNvwE6v1zL&_nc_oc=AdoXwarSZ2f426Acs1Z7NyL4Dfi0uELQPZu2HzznQpWaj8-RU0ldWPpZMJZvg4bZNDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9smIjy8bcBIykJd9ERdyPAulbzdVro3R3fKTcHi0W6Dw&oe=6A3FD73D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR8GpXK_b2kQ7kNvwG4poQ2&_nc_oc=AdrNY9mv8dyLthToEHz0UMpOJN6XccFCl1iHNl7flubkWJe66vFbfW7cAMsxwMZN4Zc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IU9-xJktHQwGjIr2cwYrHA-YfvZFbvDi-921qZ9gVLw&oe=6A3FF345"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acX2-hfbBZYQ7kNvwFA9xbO&_nc_oc=AdpWwU7ZCzkdtX9i0p1l_E8AQigRmEKUYuEtEXeHOs8A_p3Fast1bf0LHxx2io3mDbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s6EFqwQHEir-t4A0KfdykO3v3--Po-bEXBWD7rNYb0A&oe=6A3FF35A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9KFNBxAxZ4Q7kNvwFpKr2R&_nc_oc=AdpRN9q8VFCb1lHKtzTLz4wr8EHRXpRVUmCmVE83NaQpwy20hkCIJ2W6G1qWKob0MoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nO0WkSS971DOwAG0Hj4Ut5Bb-YAfuLXRLyr9TYqYB3Q&oe=6A3FDF6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EB1mlkiLx0Q7kNvwHHsoZb&_nc_oc=AdpvtakSjOU8K4qGMYsNewsUnFZ2MFT58OgcOm0zu0MI_aVBQBlCEUvqhNddDqn0Ih0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uXeSjuzSUZOHwLtkrZTL430AWWEhxMQ9MQjuIgPivag&oe=6A3FCF97"}, {"file_name": "HickonuQ_1008x
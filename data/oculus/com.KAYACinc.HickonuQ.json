1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LX7rXPYxCwEYfqnVNtD30zkQ4eXH4nloaY6xOscyznA&oe=69E629D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0SFcF-8-o0Q7kNvwHWDed2&_nc_oc=AdoUvyH_HLpUDFI0_VGyY-Hs7mdrJ7qEeSfptghhFHiDf41xZnDF7p5OzdthDKa2V7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sHb9b88w24aulLF-4B9wB1Tay9wOGacI1vZMS9V8VOA&oe=69E6313D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnMqFLrRSJAQ7kNvwG2dUTj&_nc_oc=AdqfwNGeI0hXivlsvdO7EWEdTbFmvYyY2ILecW9lh9IObFP-KSXHlY0QztunAlPJT48&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fuf7J5HZZwd0dvuAF5DIDUJX_g0GYNI54CkfPU59tLg&oe=69E61505"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qeg0ubOPjwIQ7kNvwE2cFdv&_nc_oc=AdqNfnxAqjpVt6-PBpVgNZRPdaLUN85diVsy68IpQJOzJ7C8TQzBSaRlTUzzd97eQuc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12QVfUKRoerTLLQt-lKhmPL5mdYZyxDZP-N5iatSw7SA&oe=69E6151A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0xzvAx5DyIQ7kNvwGsVFM4&_nc_oc=Adpt6BgnQnNjZbnrHazYPf8s2D1QCIJGLftZqrqCgmTThX0eijvE1H-spz_5m-MBmJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oSEdJr_SKF729YOpZmx-q5Vgg7J5iGzmMRazHE0P6zw&oe=69E6396D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRIF71nukG8Q7kNvwHw9kJR&_nc_oc=Ado_FOAdvfPXiAPhVZOvGI7diI9OyL3JsARvZGTzh_Il7iFMEUyR-2A4ODIGP3xiUig&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tLUl5gyoxIzHqee7Yiwyz38HnXtdiifxfW8IlAosaLA&oe=69E62997"}, {"file_name": "HickonuQ_1008x
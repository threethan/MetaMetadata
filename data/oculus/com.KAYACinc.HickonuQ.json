2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WkvOPbN5YxdKf2ODAwQ7Dcbo3O3XaKGnCElEMfwLvxQ&oe=69E4D851"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0SFcF-8-o0Q7kNvwHpe-CN&_nc_oc=AdpSpfMelcwnCRioaETVaDPt-w3BMXMXn4nWjdaRKuLZtZ1Jkwsnpepnyr3iruu1I3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13zt0d5aM1uFnftd4Q-07DseUtew_nWY74_X8gh1SZng&oe=69E4DFBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wptOtRU1vFEQ7kNvwE3QuIT&_nc_oc=Ado14cfrQOcPaOjvVN7u5YkOASDVM3OJfIsGGM4QCVqS80nP8ZD87EAb1UnYcqDAI4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QyIpz7uK6nHdazMCo-ql6_ZAkGKlMQjObAUnerYFfVQ&oe=69E4C385"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6glqs1qqGM0Q7kNvwGz1WUk&_nc_oc=Adoqw1tYXkDeBWYZqPhx_qbuBLLFA27C2_mpf2eanLLwM3vLYdrwPWRBKwysi6F3cRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DxqKenTxg9vXAYBYWfX1-VybnVgDYrrWWKb4EsecWXg&oe=69E4C39A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0xzvAx5DyIQ7kNvwH2ALGJ&_nc_oc=AdqzRFkOWoh-73KuqyhrF5SUyI3eQU7ZncMzObRIPHIrLBcIzGnicDX5U4gY1z6nsyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G0q7eYf3AoxDMfi9y3k_K1sz0bB53OJY95qOlipYWyQ&oe=69E4E7ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVrH2O_YbmoQ7kNvwGpodfR&_nc_oc=AdqxZJ8CYRh92DEEqFcTbZjiK425TdMckWqedOdEc3EuVe5yTUaX0v78-5rSbylCViQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gAz3skJCL1hZMCmtNgPuAegPf9TFWuSEdJyI7_kGFhA&oe=69E4D817"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9ae3VNZmC93xiwHd14GPGnxRwgJ61Zzw6PzMo08JNlQ&oe=6AF74891"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIExNFn-iI8Q7kNvwEwnDjL&_nc_oc=Adp6Vor4tkzwtRyEJqyvC-tNppGmaHpr2W_6zxS5HkYCuTh9jPkBG7nfDsZ93wse-kk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlC4hofqTjm_CCnv_kKoXOOfM1ncQlGC9vtqoQmatD7w&oe=6AF717BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO6aF3ThTLsQ7kNvwEMlQ5N&_nc_oc=AdoBNR8oqp6Ha_XhH8JGhX2cPrAPeuACM_EcyyMv45-r_v5AfUesJodtMSKXrROTpUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGFEpC4KRiTtaKWo3aWUexHtdAkt0hQ5nqmThXM4xOWg&oe=6AF733C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bapT-Np-rGEQ7kNvwHBZFPC&_nc_oc=AdpIJ0DneUTb-mxKiOZ399ew_R5490DChNQIHE7HAD-8T1I_3dQsr--uv6JTIxyq798&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLvmb0tMzbyod39VTHlXUHHrykl09KpsmjPb0fIbKudQ&oe=6AF733DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiQMDQX-R-QQ7kNvwHtTn2j&_nc_oc=AdpKgw2cSTyrjvullcsls9Utmyw1A56Ofp88KRHVPkPlhDAJhfD1Avw8AFiwj0Vc_Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7QPO6SH1WFTxgqcPF60GLcN9-uDV8uznh7oAd35QzHg&oe=6AF71FED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UckDtvWtkF4Q7kNvwHS0Q2U&_nc_oc=Adq28IYFgbyc7USWUGji06AboW8q4y4MP6S72Fv7ZsckLNpHIs0E9-nyn2fOuUZavl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOZUNeMIYXHiOTsd2SxVnFNEFtkv6r7FRuUM0Nvv4cYg&oe=6AF74857"}, {"file_name": "HickonuQ_1008x
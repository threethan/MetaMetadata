1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2kPlkQaltHrjfyNu8UoCetmJJA4Pv5guVGisrS_4VoA&oe=6A92DE51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJWBqmY_X6sQ7kNvwHQfctm&_nc_oc=AdpOfxZ0LxZxj-vhAZJFIrjegMZRy6WKHep2nhcLiyY7X9XG-OJdXOEKk7UvIxOA_ts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4LkGr1-vLYaWve5xZgK13AzpW2OOEopoNziBGwhQijA&oe=6A92AD7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKMOeQVK4bUQ7kNvwE_Drf6&_nc_oc=Adon2Tdxq1v5bnx25p9k0W5atfGIX5QhZPKqgZ09yUXPm41p6R00kXQlGBXBuunfIZg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1-qFS9WxaxPfraK97iHjVOPUXvWjvO_vbyEhUoMjKMQ&oe=6A92C985"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXicDE3KM6IQ7kNvwH00MBi&_nc_oc=AdpeLLPO_-pfUPcMIAWhzUjqfIMw8CN6ygWXFbYK_76ymFLi_hKIU5idIYY8o3BmPHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOv9ZKM7toaiox7tV9htXH7hswqByCwqlu_GrVm5kdtg&oe=6A92C99A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHZGFzhOdKkQ7kNvwH90XKy&_nc_oc=Adp_3TzmDztdlKGXCoNNyzW-2-hIl7OB9RkHuBtgI10a-fkodNJ3-V2RxknehPI-Q7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFTJsXAm3qUZnIq2BqkI9yJMOWesikNdztxBbN3SrPhA&oe=6A92B5AD"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH653sPAZb8Q7kNvwFsbUnU&_nc_oc=AdoSkBF7KKSdIYu5j1P6-JXyDLIkt75AckwQDOOU5XFOQ63pMZJj2X_bT4JTkocbjyw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUJJxANYXdbvL7YJXuJm8knzvhQ6PJMpjh5aYsMl0rUA&oe=6A92DE17"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08ii4wRgzAA_JIHRFWh8mhOByGaTUeTfZLXsIkB62TRQ&oe=69E386D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0SFcF-8-o0Q7kNvwFnZS-N&_nc_oc=Adqp2UGTHCoxl368Cxsc62u1Y1r19ziUH9G99Wro6md8ou1MReN1sa8qhSKmd0BqBL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g88XwyAL5kWmzR6JXRvizuEg5BfL2pBvbHoWujMW9uw&oe=69E38E3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wptOtRU1vFEQ7kNvwFvlqdL&_nc_oc=AdqboSqne0SZMRrIzb0tP6nFJ7no9U4X09pyIOythgD2aPr60LiztIhK8AEXTqHtz20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Hv72AIYunzL4a4bt72Z2TguFruOR61dteWaMEd26tmg&oe=69E37205"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6glqs1qqGM0Q7kNvwH3tRI6&_nc_oc=Adr4wmVXF6Cml0i66nSpMXAQZ9mTpXBJs3-NnTefTfZiuGEt1EJJpjFKQzr7PuPtd_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QKZ7bETCqZzjII__qNNYXPLBw1_KJSqAvJRg486ZX2Q&oe=69E3721A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0xzvAx5DyIQ7kNvwEyQwIK&_nc_oc=AdpYOmzrcUnMBoyXUdsB_DMB5MubKG4KfBp9ia50Rjs1U1wOuqElBEmJtmxaTTu5pc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30WsNrbux_aC3KMDgrjR8q52DFqO1Hl29B7wmD1jLfwA&oe=69E3966D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVrH2O_YbmoQ7kNvwEGmUdm&_nc_oc=Ado8U0kJcmgFKcs6n_tFqxrGYFxZFiWwYUzPNARgI7BkjEN10XxSR6Tbtj5JXauuJqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TmlKNStBKE8AjfNfP3lUkbamVk1_wrMOXvFzKtqRFXw&oe=69E38697"}, {"file_name": "HickonuQ_1008x
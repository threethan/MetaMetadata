2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAVXXgbXEJSEvLpGyv1tFN-fCejRZjuAI70E5nIEGe1g&oe=6ACA7591"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnvOfczlqL0Q7kNvwGrrsvR&_nc_oc=AdqyDtHJdPxGhe98-vCuC5MI3s-RJifAW-0dw_4X6SGH2WgUJRyxwGrfnafVzFb478U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwkyxOhNtlG6FsS9DEVvXoqmr2VfWhfjJWsv8fnji9JA&oe=6ACA44BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqQOML3GQq0Q7kNvwEC2lKX&_nc_oc=AdrfYCWurJ1N6V82q1eAYdJq5e9kE_wJMHLUjF18jxk_xRIK4omdtjnmImhujxy9qpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRW3GAX2K1CPZDYmJutnNI8dkHt15ZqZInjuGrkFp99g&oe=6ACA60C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6oelUk69d0Q7kNvwE0ZuDG&_nc_oc=AdocwcUgt0-sDNYhQc4vWqttZOzUMx5LCeVW2mtivMGMMrM37fLKdjMk6boL85AYROs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxwmlpLZM2Yw_JdJyjocpF6p7a3SK2dTPtDi3GceKZvg&oe=6ACA60DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KttjsQz18SoQ7kNvwF5Dxmf&_nc_oc=AdrNgvjMvaudDZKvrwmxr_gwO0Sraapz7_zUAwEP2T4mCPauLxM-oGDmfdYVBzP1xEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNS4vp0XwE_SdjVt9e6OoyHVuzENM_cpwgXWyAOqx36w&oe=6ACA4CED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z98VnjhrFAsQ7kNvwEVQQ3C&_nc_oc=Ado0i61w3dddGM21AnP0Rdkg8QVSuAOfE1JY2xVWuqM7bHU6Nb-325X2XnubddZD9os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBtcfyZtO3trbdXmwmO8BE4ycVK3_yWMed54jljER9Vw&oe=6ACA7557"}, {"file_name": "HickonuQ_1008x
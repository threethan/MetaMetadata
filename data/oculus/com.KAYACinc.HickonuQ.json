2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2lTqmt8PfIYmIp5WmP5Jlycc-ijuEmUiTq0gsiTqbog&oe=6A4FA1D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNaZ_ctUtygQ7kNvwFvaVbM&_nc_oc=Adpr6dMg7htBa_30lOwY77tfj5s28sgqky3hn0AjsJmwTIkuOjqCXW2Zgn_54V3o55I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv76fP3Fpf8YDoR8dqUtPGtr_WOIMV8gq0w8Lcc7DpoA&oe=6A4FA93D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjyL_icD3fAQ7kNvwGV6Xhk&_nc_oc=AdpeyDMjLneKdX0CId2f8SCItEW7afRfI5gqClBQnDlt-zeNiO0aISB9dLFDGoRWEco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcVG9gEtlM0EV4V8hVoquYzsKOLXIUuQcoMBmoxqnE7A&oe=6A4F8D05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7ZnJmYa7ZsQ7kNvwEg49fj&_nc_oc=AdqnhxvljqMBQUpWVsQdayOcsC8IHZ2ic6aD6htyv84bgZqytFrKyZ5j-0pGuhDDucM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNmRPCkBQFzMbmwZ7YY1iNwHotpIG0dYYDTR7ZTrdBFg&oe=6A4F8D1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eIlQVzUskgQ7kNvwGiwmgY&_nc_oc=Adp73Jwd7odhE9XvtxBuAaWSGKwsT0_UNRQVxooF4-3xabVVf3itRUwqYR96R1dp80s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsWT1AQmd_0IKshxmqsHJ3-8G-0WtjDhfqKr9Qy_96ag&oe=6A4FB16D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5Tr7oNY5woQ7kNvwHFm9BV&_nc_oc=Adr4p5U_D68yGk5TeBLw1zGH1L2C1jeyw_kVqGnUG3g1uIF1h6E8U_X_QUjM4RkcLas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGHHAhb1tlzt58C-fh57myq8PV5ZxnU50Z-oz-h-hBww&oe=6A4FA197"}, {"file_name": "HickonuQ_1008x
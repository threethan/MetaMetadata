2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcdK3ycjr7KoOjA_79Sv4AANv27Q04TByDGSsuxmPldA&oe=6AC79A51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8f1MfpM4skQ7kNvwEN4Sbr&_nc_oc=AdrhpomAGao1xhNbSSew4vE8z47B9oT5V2zx2ZEBYXDWDRuvyOUxgPin4X-4mTI8sWE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUfO_9a57-CrzHOKJevlSfLPhtWUYKIs6Sgp2EnM3pUg&oe=6AC7A1BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqQOML3GQq0Q7kNvwFHi9iG&_nc_oc=AdqRRYxDouE9vJFIYZRRzaMr1gwiZMlIXIHDu54xGUdionMe_rw3AyxXSURasJFPRXs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ81uGC0YHpVSKUDvRFv3Bo4mHLMD_ryibqiVgwUJpNQ&oe=6AC7BDC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6oelUk69d0Q7kNvwG7vnsU&_nc_oc=AdraGFtS1l9xATKyy0X1tVuH8TjU-_xa2O2aUfb--3QZAedV5duSO5yt9fDANVPUyNk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqn1nwIp-nhFFkuabBxGSgc3Ew01mVz4-xeeZ1AexnnQ&oe=6AC7BDDA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2SL4f6x-WMQ7kNvwEgzEQA&_nc_oc=Adoc0DhBwX6FlhQxLq70x0vwFFnzPdZSm76kIMJfk6IvAxvMSzQmVZnb96ELd29kRlk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTM5m4HOgBUBUMhK3eS81ywat67U9KUYvBJu5q1Jj7oA&oe=6AC7A9ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z98VnjhrFAsQ7kNvwFl-4_A&_nc_oc=AdolfJzHwB-t9fyU1kzayIOmg4lxInViyZgnhzJ8yLOeRsmy-pQBzMLl0lY9T_NHyp0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV3ofqALuFFL3Wal2EOzLipt3CqIODRooz_gxI7ItYOg&oe=6AC79A17"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcFp4Q6hf_E9dCfunQcjRckHt26c6XP6kB4VeqU0_5Qw&oe=6AC4F751"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8f1MfpM4skQ7kNvwHaGWT8&_nc_oc=Adoe0S_8iksPEbXq3nfMUlQiwZeINPFo3hDzMgoESZKQh0l38n7M7WXQ477zM7UaUTg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZMvq_6JCwqqUdxuwxIuoSkZsmwam7FZkHMRqIyAtxhg&oe=6AC4FEBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0cdYJY4jlkQ7kNvwHtE2wx&_nc_oc=AdoAoCdMtlW7aeAB6TsAMuwOVFhM79pHc-_gr72mWXMf5r-hBDw2Yq5eTevvUZz44Xs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiAqP_RJpVV8XlLOx4jIZm-egLo-V5OwU2DOjlD4xXyg&oe=6AC51AC5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l_kWqztMkoQ7kNvwGpYuv0&_nc_oc=AdoK2TF2XNyQLN33dGItTeX89rcb_KpmRetEToaxJDbzWbzOsmNxiSwFBgz35oYcEiQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEr5GXGB1znBorsD1IkmPEmu2dgQKnwH3ZnlI9GFG3ZA&oe=6AC51ADA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2SL4f6x-WMQ7kNvwE-HkiY&_nc_oc=AdpyvPWMJvPP3NPkiQULEFpofSRr9NNPM53yqGFJTSHUcxQnogglA9zeLQgbvBgGT9s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1tYJnkB5D9TQFVjMJSxCzZQm10Kbl_O9KFUjoEpBCtw&oe=6AC506ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nokgCY2SJQMQ7kNvwHdYECC&_nc_oc=Adq_p2fZGOljx9VXFk9As_5GALnkw8O6LlO9WSiBT_YgPPAlLSUq855z0IvM_wyP8mc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7B0DSQKpT9EQOlJjrYWMu33ZZUmMY6VbPbXKITgu_dg&oe=6AC4F717"}, {"file_name": "HickonuQ_1008x
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-AfOg8GnOsDwRR7NMzzhi268aiUxzP8EmpHo3n7ON-A&oe=6A9EBBD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih0a7izXz3QQ7kNvwGVaBZX&_nc_oc=AdoN5yBNnmJvjXCozWhxEp_gLkpGKygZezsC7vpn_ab5Vc0vbD8PUCoh735byknLS4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoFzkpBxWChMzP1eEuKsJqVytqRUI4WyqVIrHTY4cXQg&oe=6A9EC33D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEekKovYGboQ7kNvwEcmpsw&_nc_oc=AdqGHooA4hvbnPz6sWGZerUjwdfaR-eCoDVWquHKPFO854sSbmUakGVkPmH-SdF3O2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNTQY1FNwv1-bxbuvYDPGQDRvNIYWkEKHUnH_yyrIeDA&oe=6A9EDF45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa1Siw5QiqMQ7kNvwEt3FaB&_nc_oc=AdrEjEvfxWl9Rp73GgRsEygKB-KXDB_XcT333ujbkV_DUCYWOG326WYMqzZn1VX-oEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJX83H65nGXv9tz5iOoqqKh_eHIrBGoUcuhyF5eDVmJQ&oe=6A9EDF5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5L95SCmmPwQ7kNvwH-xNsW&_nc_oc=AdpRgJgQ_eyDGnDf4WcJhYI2uhZwgJ_kMuPDyyTmnjWG-3xIuB0K-0HIEXbdRHz3J7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL64tUdO-5vewPwKulXoe-DvAC4zeFZ1Br8-qOLE_qKLw&oe=6A9ECB6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqGWyzm-EOQQ7kNvwE9xNLs&_nc_oc=AdqixkWKVnBf3J2NxvOdbkWQ8xaCSvrHy8dZDQAQiHb-hV7C84AAMf2OlEinBlYwzXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtXoM9W-L6cY9tzlHP7Zll3IZoerL1sojuQ0nnd-_4Mw&oe=6A9EBB97"}, {"file_name": "HickonuQ_1008x
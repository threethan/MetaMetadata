2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07T5XFpgaaC8VTW-hOQSGg_PN-ZgIurmvGJe41t_u1AA&oe=69EE12D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6Qe9bDRCOcQ7kNvwH092Vw&_nc_oc=Adq6VSxp0Ny7mJMIM6EQbjbGBWc-219LT0USWvF0QgNyr0zBBDZ09a4PFZtd6sVFdFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lxHJ9_gSozojW8ZoCkSNcRf8sUBxfVTqC0fBJjDi4ew&oe=69EE1A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joGKQmORxZcQ7kNvwFb3IpO&_nc_oc=Adr7QaO-ipwP_X2xIXEih1jws2M6GQtK8Jp3JqwdN7JjhuDnLwul1RBbPM4UCAPDYII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SVdVcaHHtwbhFb-IX4caWfw8q4KYJ-vkgQdrlilpF-A&oe=69EDFE05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPbtgiP0_BEQ7kNvwEl80go&_nc_oc=AdpBQAKMznjvJoraj9duzrTbhjg4Clid-gPUAuddbMQn3bBj2K_pyDn7wzVapd9MUEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r_-XRsQYYqTZvDRLEFik4uoUhsCbpyXvI4tDJNei9Lw&oe=69EDFE1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HXBbRp2bz0Q7kNvwGT4o_8&_nc_oc=AdoBcruW4Pq-B_UZHzlyfluBGW-4D5oyaIs-t24gRgHm3AfeCgG_IOMphQ9s-TzYdGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17F267yL8nh1lcOv_NJhxkD1H3N_Mx-kIK1WEbJSVLbA&oe=69EE226D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP4Xpk-kdlIQ7kNvwETjpSq&_nc_oc=Ado32S3BOBApFs3Hb_oEMS62iDCNFttlqh4YYVPfJWqA8i3DuXdc9hl8ys5GubdTg6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fPYHoAPo2cm9naT9WxJC0WOEuoOPC2qhUwTMEjxZZaQ&oe=69EE1297"}, {"file_name": "HickonuQ_1008x
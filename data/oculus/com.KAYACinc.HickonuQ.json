2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZdPjm6Y9gCxnK4KUeSrEjIridb3Qx5AM8QoQHsN2q1A&oe=69DB9DD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1hn0j_sUwIQ7kNvwHxAis5&_nc_oc=AdoPUi6xbEUYZ9Dy2Z-_bFbEaGzydnajessOqDHWgoioB0G6_8cKEElfONmpylAXH7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lKHWBNEVZR7NqrcwXAeGLZqcmJiZMilgHG3cGXlZ-mA&oe=69DBA53D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8PAnuPXL0YQ7kNvwFCA-Lw&_nc_oc=Adrk6KHvmo2XWSGClMZ-I9noz2hD4JhENAQlHS5x_FTYw4dqthf1EgEpeDQE-qLZ9lg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X0bAukJL7PZ46uIInbUjw8cFS2g8REbodYukrGQpLAQ&oe=69DB8905"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRccv5HnVFkQ7kNvwGE0Pje&_nc_oc=AdpiZG8HmsDF1qRlT88O5uEcXunBjiU9Z9fYJOxdJHlq3-9DHcCdGI93F6yiDMgKixQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IR9gD-IGDqWYA4__udyhiVAR71QQMc-yzSg9gD41IwA&oe=69DB891A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxRwoNaJ55cQ7kNvwGQca4P&_nc_oc=AdovqXMMwZce8mkFlMoounnamrseqhAh-TI3rejlj_zA7kspM6zQl3L0FmV2nJYRmf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oI5_wFQ3G3p04tn_wKjsoT1cfmQ2qE5HuWm816gJUxg&oe=69DBAD6D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB_bcp5TDAYQ7kNvwH5qvBF&_nc_oc=AdqOi7VTeRLm1mFCyMxhI18n3SuJyPfHurCYhdGLm7hhUJMGnR3aPjNoBRZjGGomf98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dS6b6SXdF4SP3cxBxbKU5sHWtxFd9CJeM4PrjHRDHvQ&oe=69DB9D97"}, {"file_name": "HickonuQ_1008x
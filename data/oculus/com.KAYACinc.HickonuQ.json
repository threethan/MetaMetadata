1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bU3Gr14GfS8omgXtPHwcKvlWASbJNnIi3oGOklVS5Ug&oe=6A4515D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr8VUIacwFsQ7kNvwHckj0g&_nc_oc=Adqjj3fsDpABaWeKd8HAWrqfCbE4zRjnSF-FqwlRz7B8NQz5Jg2rYK_M9az52Yo3UKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hychQDvpknN21UzJfjzaSyDM4HEd-1Dr878KwdGWa3Q&oe=6A451D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNTONVC0JQIQ7kNvwF-rrDn&_nc_oc=AdplOCqAAdtLqpDbzhA0LOT1ZZOSZknMzVZ3wI0BTEwzWwgG-j8m4gObC9nuc9BubT8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bck_32GT49oHgsNwyVCA273-xPj-udhrS3gLW4XbvTg&oe=6A453945"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L4FLB9oWK4Q7kNvwGMbnS3&_nc_oc=Adp-bphYu0W3YhocrXhz1-auFA2uDzB1gPIXAvqhAyuwmyHYUsA77IunfYS13PJq_eI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jFBdlAkATJrDTAxUleIUmc9ck1kd68i1UJj9ubz7EhQ&oe=6A45395A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBqcxlEbPzYQ7kNvwG3l1gr&_nc_oc=AdppC55ceMMjGGcwrmkXgC6Lcsw09FkWBR4e4x4LtutQX3IZeWZBGAN08YAm7ok0F5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91T_C931JKFvbTOpLnyfaL42iK8gvUuwzSToiB785bRA&oe=6A45256D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiXHDEFj_owQ7kNvwGNW4vG&_nc_oc=AdrU1Tno1Tg3OntsV_Yse_uZzDoz6kKSOx_FvhSgDOLqOuHXMH6JIzfIHjTsbH2DS5M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LJechLAO4RkuMdytUTMuFm5eSHoRvdGeuCNIG_mu36w&oe=6A451597"}, {"file_name": "HickonuQ_1008x
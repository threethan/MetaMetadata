2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S2-qiqQBZ2NfVYv_oxCUu6dT0uCjTX4ma4g3XArnp7A&oe=69D3B4D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J21APF0mvzYQ7kNvwEB5QDb&_nc_oc=Adol6P0cf9Hu6qp0fq0lvoq_Zmmv8Gt5qY1XZy1OsNY48LXMNzOdEVO1xP2edwlwVhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bC5MPs78QOPFMot9haF0thiysvvlkzOOBNY1WeoAonA&oe=69D3BC3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcFmKjSt6TEQ7kNvwGEG_QX&_nc_oc=AdohrOLyaUyVVuqFCGQejG3ThTCrlflZoaTcOkf50FRoh4m3NfVlTjp58G1CL0lohZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wOno4iHJXqmRbZf22sC2KgpFHyYznYfs3r8kAcl6z7g&oe=69D3A005"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0TQRML1FrYQ7kNvwHrUnLj&_nc_oc=Adpgu47xE42su8R60hTgXWx0SDCVze5PZT-3b9os7LI49PrYi-r1HR7ydUvi5bnSqhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qEypb49oegcT2-P-tRUDln7Uy3cTVP0Qti7tIypHGvQ&oe=69D3A01A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDZpldGwOYYQ7kNvwFmiuV0&_nc_oc=AdpZTrBu_Zem3P4r2lAvGq6UzIuzMBxbtXlT9WebktNczfMq4SDAFVSBzMyvewJMI-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3luytlnjN1E9kMD6qPlL0toXRti7lBqtDBXk9wSU0hkg&oe=69D3C46D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVrhsmNhsjAQ7kNvwG7Dkwt&_nc_oc=AdoXT48C16PjIKBra4Ep-APYHaZ-Uxwzli7xfPf6DhiFIOWu1GUcicHsyhRtJIYivuo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NSTC4Uw1WSNLUbH2NEmxvGhItGJ7udHJY-LpC1DQJ-A&oe=69D3B497"}, {"file_name": "HickonuQ_1008x
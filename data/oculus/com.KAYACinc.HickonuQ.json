2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_3ErwWbUHVbtRSrfLSV_msF_fvo3cyilnR5et0H7mQ&oe=6AEC8451"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYJzFrIKIKUQ7kNvwE7hf--&_nc_oc=AdpaKmg0WJpLqiKJ3n_ZkAgELREfwpgsX-slZTeQi3qzNXMXKKdA8mbHrWE4Sbjwv-M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJdoc7bAI4z3he4yVQIUyrmQBWiT85YPmr86w1Y77o4w&oe=6AEC8BBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkkDaeA5LNMQ7kNvwF3bLXM&_nc_oc=Adpaqa5re3e8ct9yNqY1OgooKHM8i-q3n6ewoE6ldX1T7qYxk1uF53Zkxhd5IlSX-L4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjHSBSOxGb-skhDmqGmEDCGlxpUEkc1OIHDCyakHIKtw&oe=6AECA7C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfxwxSdb8VsQ7kNvwEffgFc&_nc_oc=AdpBtbJ0udcBP6CYHnmGelyX6ISll9wP_JPxzsw_D4R3Y0x53f6psSlLHisLHmHoi5o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJQDColpe4BjZpn4nQrXH26hABmqONHOcBq83639m7EA&oe=6AECA7DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVHQ1aPtzAkQ7kNvwFF0bnn&_nc_oc=AdpNqTybs9tpo2-DCWxwGIwCSHVoSkrasQ05gP-kc3841xFCs0_4pX-i_15j0Qs4Nkk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx8xT3tIIEiBPcUboDUazGXvDT5ke8KuQOkj4pXP6tfw&oe=6AEC93ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVdR6nR8L7cQ7kNvwHeZVnh&_nc_oc=Ado_xjaubKaVDaW4BFke8GDTMcqVMjYdGx4SHaZzBU6q-wVt9pp41x9PL4WEzFNTFis&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFgk5hDXMg9iJv_8JH9Nhyy_jDwMM5TQchDS-PEpUyaQ&oe=6AEC8417"}, {"file_name": "HickonuQ_1008x
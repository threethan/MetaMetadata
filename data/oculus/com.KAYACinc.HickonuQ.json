2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsSdhCY1fVVFveLDEb_IcPDEd_xVI9O9imWqwmq9E48g&oe=6AAFDF51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR8hDQv3ssUQ7kNvwGQM1iT&_nc_oc=AdpmneHRJDccMqcBvxUWF6faZphuMMMDxduhiVHnSDkDPEQJ0TvbyiuvheyjUf4rasA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJqwKgq2C3xCE5zl2dfoCYVjFr0kkvdjMz7cBWN5CUBQ&oe=6AAFE6BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK6AN5wXr04Q7kNvwHiuUaP&_nc_oc=Adrzo7zh4yUezedVG8KH5gKekLdZff84W4WA6AzPhDrQDEFA2YACvBtvmOGZYX4UlwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDTqk2X0C_EV1S1knOVFI5slku4eY3HQ074hTKM2VcPw&oe=6AB002C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2klVnv-oQG4Q7kNvwFJgI-f&_nc_oc=AdqmFsRgg7yGBOYbNo-7TTIfvx2vNUm_KANpgIP-AZCKGBvvMHFZD9YFxJE0wsYhuO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3Ay2CTmFQXN-zVTk6v21NpgBHdK0qdKFt4uNnli9Lkg&oe=6AB002DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hu3G_955Xr8Q7kNvwFxvV5I&_nc_oc=AdoE32xtmA-ET16vpColvYEDCHHdcIW0Mq-qzUhRuy1PAICAtdPlVx_ymh28O8NXl_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOaoH5LlspFse20uh3nbzvynG2xnIOwKLf-z41KYHzHg&oe=6AAFEEED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxsPkRsyUzIQ7kNvwE8clfs&_nc_oc=Adr8nYtVjaCkFGFxxpcqb2tVWeAZVM9_JGvsaVaO2MJE6Gh_0SJemrZ9XaxACIO4PFU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK94x4XB6ijMjVTeflt70Rh838AGFfmzgLNqnAkmEUuJw&oe=6AAFDF17"}, {"file_name": "HickonuQ_1008x
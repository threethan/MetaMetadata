1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rywEi8Hq1dK4n5pIMzthObneRF1Wy1S_QsSQFF7ftNg&oe=6A0B13D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvfJoOeUUMsQ7kNvwFDpLLm&_nc_oc=Adrq49AotyaLHBZ1o9cAVms6ltJR99U0wUJKWAwB2P1sU_9zrLmEOS4Whx5Inv9J2DU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jZj_bgCzdmy01Ed-POzu-X-COeQ_9XLF_gP5mMD2wIg&oe=6A0B1B3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd-jYm_MuJcQ7kNvwFuODkh&_nc_oc=AdqRgUioqfmVWRaXE_HG2Fe-Q3Laxw64N34X1unQbOMzjAW9oQSLs3HvY94bKy2rtGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lokWIUX9UmLyw7fD7BxYSf2HY_CxeM9FnJTQdr38G7Q&oe=6A0AFF05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmx3Slgxc-0Q7kNvwHutabK&_nc_oc=Adq7hKrkgiG0XyNvLS7dzXyCcKUWA8XweJ19VB9vV7-JUGekZ5VTk4iYcMYfoBMSly0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jwov7HSc4v_BZRz7Rr9keBPWNPlwZB4aJMEALQHeymQ&oe=6A0AFF1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9USKrxR66oQ7kNvwF8iRMc&_nc_oc=AdqaDJPNr08n9vM-oURTyNTTNi1G-sDj__c4Y2Wr9443IyWBUOAaNgKbhUjsQvKJfSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tZbmFh0ZjEiBTx5y2Qn6fBGRBN_yI7csfB9ZOk36hnA&oe=6A0B236D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmpC7E2mR_MQ7kNvwFL0Ed9&_nc_oc=AdrSMnWtNKZbBTQZBMNsre_EYQHwXlKgv_gLGXLiG7PuOh2edsMKeED32Qp4cNpL7GM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QD1JMl9puV3jxPh8yMfKMHCi5g5P2Tr2JQp-OVvIdlw&oe=6A0B1397"}, {"file_name": "HickonuQ_1008x
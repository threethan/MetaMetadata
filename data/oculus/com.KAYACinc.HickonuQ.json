2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QFbvd1zi40ndBzWkXJc1KTT3C1Yg7qUJSNy2cq9RP0g&oe=69E77B51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1aR68Qrz5MQ7kNvwHj1OAJ&_nc_oc=AdpPevRTE5m-TCt8id7e39gnr0Fkttpdbt5t9Pa53vqj1dzAuki4exoac9sW8yNXwGk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eOtpRZuzwRXHkX0ao4ZKhVOyMJJq9-3TvQ-NxGjNzEw&oe=69E782BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnMqFLrRSJAQ7kNvwGmKZ7-&_nc_oc=AdoQ_ussxyL7cuuLSFG0SDBBC7BHZGgbkjDfsKQOUeT6xCHmM9XRb0PnXpmgVaaCHJU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a_xRF2y18ziElONQXUfrvWcU-Ad65FS0RQlIpMYn7vA&oe=69E76685"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qeg0ubOPjwIQ7kNvwH8YHym&_nc_oc=Ado7W-Bp0Q8VqZQqL-oXqM6Q5YDUDe23_0gC4tAS7cn_9kJfFtAcgf0GgvHCn0UKYNA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YLPP_eph9h8dV1aaCSGswc5F-PDVdZtKqMPGTrEsomw&oe=69E7669A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV4m0C8HVc4Q7kNvwEDBIMB&_nc_oc=Adp2PLW2WwsmfquOWTkwHyYKymJB5E92pdaNZ_0VLClYTso6xJR3bgGyAOnp7Lrh164&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25_BUAUCwiO34umR2CTbOFEdyEE62ifAYjYtJOM1cx4Q&oe=69E78AED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRIF71nukG8Q7kNvwEBE4aP&_nc_oc=AdpcLRO4EHwDQTGAhA0DZ3D2iyhxm6u4BBIvSShNWyYMwCh8FCGIuAPqJJ22kaxnmGc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C4sJTBTIrkr3InCkjHgMrchTDxd4I42eECJLozPrT8A&oe=69E77B17"}, {"file_name": "HickonuQ_1008x
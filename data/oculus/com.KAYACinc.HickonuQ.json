2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIgce5_jjaSdy-bScRoByxiHAXm93cZHCd14IJWg4CnQ&oe=6AF46D51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIExNFn-iI8Q7kNvwErMrlr&_nc_oc=AdqiZ9xD6i80r6DMH_A2pGdCFHBAGb_uxUw_d8fvVRXIytbu07zdiLMIWKdMBtuFQ48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQId6TgcBO7uR2YvVDLRFsmOJPOYVPccSEWxibFwBMZaw&oe=6AF474BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-OdvzJIDyUQ7kNvwH_nVRC&_nc_oc=Adq7ACi84jCTs4kF_6DoF5ENYYX-F5HkKvQ5ObHyJp52jaMB6jNTt3w1Qc2vAaThC6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC2TxVqb2cZJtZv64rcb0lNLbL36BldKdRGEfENtg3iA&oe=6AF490C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQLbupT5FLEQ7kNvwEp6e3W&_nc_oc=Ado70Jzz0kbzfC3t1Psy-mU88nD-BeBznu4nJ9sH8uk03rnQlBtoSHH2tiyX0pm9P2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcABpibPG3nb2cQzrnz3Ocaqd16vTe7kj3HAvcBkZVHQ&oe=6AF490DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiQMDQX-R-QQ7kNvwF1FJyy&_nc_oc=AdqOB6FovNEZPtywVW11gsHh14ppm8OlafH5VXFi5vN0_UwLzFkqAM-_sO9pVk9RKug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKiroGBCWxXBVLZdXZdiL_3HY4d3qxwnk8fHuByJs4aw&oe=6AF47CED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rzencjMXeAQ7kNvwH2qfG5&_nc_oc=AdpFYePFk51VLSiEmxIu6XajsdJu7JQFiMqOCHYVIzL6YgsuhRLupaB_WbkhyllUXaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFohrj4BhOB2rI6DFnBVdEna7Q9riANyGYu28Lgpr7Yw&oe=6AF46D17"}, {"file_name": "HickonuQ_1008x
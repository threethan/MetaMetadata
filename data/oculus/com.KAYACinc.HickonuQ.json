1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsORxFrjBDDcb56wI3Af3v57p_C1FVxkJG950Sc5Rr_w&oe=6A942FD1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJWBqmY_X6sQ7kNvwFEanpZ&_nc_oc=AdqH-fhQNOFi7hE7m-5Kbj5vUkgqwQ8dm7hlqYqCTSYEMfEtlW87vsc50WcmyxMQ9zI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA3fdOZ14VBROzsmekxhxmtqKffwML4hRqgS50m0ePGA&oe=6A93FEFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSEKAW52mmQQ7kNvwH0zAoH&_nc_oc=AdoyqBmZyzxYB4zLe905F4l_8wbWUDC5Z_FMbwKRO-RGMkxh2M76ZSsWV9eSlrL6BMU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2osE2BX5nHGHKNmBLMwbMY3G7iAAYsaTWyE_8lWZd2Q&oe=6A941B05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et9EQ-SuihAQ7kNvwEI2zCm&_nc_oc=AdoTdKhwRVRhnJnxvHeKwT2SnkpFNwX-0lnfhv-HdEBFA7XTV_ii1kKmjZPNP8Fym_o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDS98S2xyBz_fkfybxfHJ5xrKdfzdMZiOHgAbI_gtXZA&oe=6A941B1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHZGFzhOdKkQ7kNvwHo73JD&_nc_oc=AdqaAS-O_F9AQmUwdIdLUvAjd8iSd94NCNwl4QjnSH7FJXZeKextccAqWj1CruD3ohM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw1YWWpFSI_IudWnJM2VKRnUZ9HKcu0_lsrF08Uct3mA&oe=6A94072D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0RzzJrBnY4Q7kNvwFXseVM&_nc_oc=Adrzh65skoLSwJrDsTt35d3JxU-BSud5VY3XsLdeC4zK7Rm-ihyQL0ehUUloCOewoLQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHsMgV1660r4B00zE6VQ3FzVv7MQAcd6qugyYtxhTvWQ&oe=6A942F97"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaAJJsrNprnU1Yylk-pKqfgwpLBUtOMU_3cR806P_Tcw&oe=6AA55351"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tNSQcVgOTYQ7kNvwEsKwE5&_nc_oc=AdplAD7X25CqoqrxySp6jI049HS-0dGeDB7AoW1ZTnB48UXhvAOUh14gsntBM8cyZdc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWHs5oKYJxeyyFaBLkn1W4aM2WmfMNcJ2t0N4bypw8Aw&oe=6AA55ABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ3fhvJvVpUQ7kNvwHvidTs&_nc_oc=AdqLmUvDyau981FUAx-_-oszXh_AM_8BOLxTFVafJSFJafRwOzAinK5XgTViC7zjCaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI08SEmSGvkw5U7DB1KRKMfDwvOdmsv4T7avfAAcORvg&oe=6AA576C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOet3wOhekEQ7kNvwH2bmDu&_nc_oc=Adpieb2Gz8XmirHIKKefCvAfyrUwgMyESv4hLUMILzE76Gyyt-6Sl1HzmLaauBehNzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRE5-bqjbadjaKPKsHd7imbMqjQA7mxGiyrv8ksRMqLQ&oe=6AA576DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqr2rvuTjFQQ7kNvwGiJbSK&_nc_oc=AdrZiFR33HgVBJ0PtpC93oL9Y4bloenLsDbe_9zpEoM-6kD8LBTH7Rq6ch5JMQbPHDY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_nsea2_yMcaN74u0e4mjTh2SLOEQf2FAKyoIXxCJXmw&oe=6AA562ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUOnRkKxftwQ7kNvwFkHZB2&_nc_oc=Adpx58DSaJaZs8w_LIEfCEV6swYJ5C-WBngVUDejwLPbfVLN-EzHtdCbo4OpMm9RP3k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCJTesmqCIG06Cfo4x9Nn6ya9bca0bal4O4bR5raN0Og&oe=6AA55317"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EBS-K_I4EfRXHdE6BdTeWIxf18zi8gn5_sCbMDddIQg&oe=69EF6451"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC02zVkk0PIQ7kNvwHoWleP&_nc_oc=Adp5FtTFQEaIOTIvOcwElJ1HOkjZ8uxBpkC91cKoHL_DlZrG7t_MOOGocy06CbMNrP4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pnGVshgdq_Wn2YKaDN2Kgz2azb9p77k8EHm9pTml_rw&oe=69EF6BBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joGKQmORxZcQ7kNvwHcb5zx&_nc_oc=AdqarwlzDk9JF3aMRKXXP_XRZVL8mnQdhEya5jtroAkM5bWFb4vEzq1GBl8Lk3ElaAM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1E7qQYMoaOIwbncAizrWTcLtmzhXF0IHUsQG0m77HmgA&oe=69EF4F85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPbtgiP0_BEQ7kNvwHPZejU&_nc_oc=AdpdQuIB_x8B2GjmvNHsk4Yh8rubgyhHO4qBv6f9TUNRp8f1CmTEdsbV6_vMX_Bw8lw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3omLka0BQkrQdB6FZS9tlJ-Gj2AiXO6sqgSFByoyK9lg&oe=69EF4F9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbR0XHnreokQ7kNvwGRGxkr&_nc_oc=AdoRmhAG2Kcjv27Ef8wt75X_pyEeH8JuWMjLyDnoD4bga2Orlt9AOi-em1WDg_JT9Ik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FZU7FlQtr3oXz4eWcVGurZvrkUDOXKwZ5lP3g91m4bw&oe=69EF73ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP4Xpk-kdlIQ7kNvwF-MHAH&_nc_oc=Adqv-0tbhxOfj0wCOeOzBXXAIljBgc7l37yIE51lQ-VRalh_NDRYEmMcWKbDsP8V4ZQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rdNcu4wEqC1PhuqRrv1xsRaw0CmGxiMApxEsUVhHMMQ&oe=69EF6417"}, {"file_name": "HickonuQ_1008x
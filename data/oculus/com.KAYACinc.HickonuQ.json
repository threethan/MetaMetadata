1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gXaaOlBy5Oa4lNSDvlK4xIqRQ3UXYiNQt_3jQV-xT0A&oe=6A3A89D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v26ikFGuHYEQ7kNvwFHHJIs&_nc_oc=AdoxTVvFY0kemcR4QanosKs49jtEdzGPbhDk1QCA436zNyM6WYpJXj18ZVKoNpyp27M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o_NSSx352aB6WLbUVUl8XHBiE7RjTo3ZJe9zfjdUlpA&oe=6A3A913D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQELlmLvfJ0Q7kNvwH8BJv5&_nc_oc=Ado8UmGErme9vP6U8ttpWlEKH3tl8S3VUS3fI5QwQh4Ta3po_LkOPqYIxa7uW1y6Le4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nAhzOVqRR1wz_w2FCZ3EYwTJ2XAb1sKBEuQAa5ie3mw&oe=6A3AAD45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYNUyzsAN50Q7kNvwEJ0mQB&_nc_oc=AdqmkvDfxMvX9f63_frbUXP54qtw9JiQcoBvhhE-gfZ7OVrcFIxnlcDVBgM5V-IF7zc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GCaAU5nIwjMle_fl--b_WckS4kHUXKZFMo562pqmZKg&oe=6A3AAD5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO4of0K2JTwQ7kNvwH_skRK&_nc_oc=AdreoWdV6BrMqS-eYpypkiF8C-72TlX5tcBvZ7G-vjZRp5rsMFGAb1WwsCryUFhJ84U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aMs30Swc6OyNMtGUKe47nY_Btm28KGow4q0IFFWVKgg&oe=6A3A996D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqKt82wiVukQ7kNvwEcmjjZ&_nc_oc=AdoauN6g2uDRv5-NBLgT_iYcgskLeHuj99qVwo3OWEpXWaHU_-SfG_qsh-LIXPEeUH8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Snhc8jUbVBp-MYSgFPlKxVE7m1-aPvC9f2MC-id9iOQ&oe=6A3A8997"}, {"file_name": "HickonuQ_1008x
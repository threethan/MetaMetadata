2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SMj9fGkDah24z01PzRAtBqwWuM3Vgfx1n-9N7ndx9TA&oe=69FC9351"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYmH0XixlxcQ7kNvwFaR7Z6&_nc_oc=Adrj2FCAZ5MKc_KtSs8Ayn_kH1rZpTFDqRLgW_0kLNVB0uRmmysJyRNACW9QQPrh_sk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75Cn3NlTCT5zhB15V1tU-5DlRyx-Sav-ZPJeTUPvacuQ&oe=69FC9ABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFFdu7ofs8UQ7kNvwESCILa&_nc_oc=AdrZvMrN3gibhw8DFY5Ibx1TQfYiet2YgaCRliuZRmEL6ra2m0y0ZONqpA1guK2SX3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af540xfM2cbFrtspiZ5pQilF5O85uKOY3W2OeeKt4MsQKw&oe=69FC7E85"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0itzSaGIqogQ7kNvwGcaBcY&_nc_oc=Adrcn2PH6qCjKystzHIhcurYF3F0BT6Lh5o8VPw2Ah8E6VzLizLFnNQwG-VijlAz_fQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wzhFDUPNVVhgV8Fq61rarFBy3LunUnkn7FOoRGHqQlg&oe=69FC7E9A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UEvhYCMwG4Q7kNvwE0jn_R&_nc_oc=AdrpnGS3cjVXnJoAJpAftYv4NRnNOknbKpbFqlXIVGn6dFvY5v149zu9f3PP2rHMLyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JLngVDDUydcpUKPFvYhI-JNkOplImnchhzcWoO_bifg&oe=69FCA2ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe07MqguC5sQ7kNvwFPH5IP&_nc_oc=AdoTS8kUdAY-CTUUg81pJrxVATgvGTqBE9dYxyDqNOKMf2RV0mnn7QkRy-lH8y22k90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MJxfHoFMFlUXQD4osX2MX8qljLKqKcFcnG_s0P_TZIA&oe=69FC9317"}, {"file_name": "HickonuQ_1008x
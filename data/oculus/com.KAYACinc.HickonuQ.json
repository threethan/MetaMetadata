2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxH2gVpPlF6bp2lu0cUt5G_zP95jut2WD5qRLPDVf15g&oe=6AB52551"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1Q-EqABYqMQ7kNvwG4OIdf&_nc_oc=AdqrAJ8b87tTfsTlvCyTVBj9x3OXXYh8tgnWDgtOI7wHV_yCooWZ8LoY_jpfd9KsSg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkzlz1eVq3bO5EbC6hO8KxznNLGcuhiDvvYX_e4o3D_A&oe=6AB52CBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvKOOv8UpOEQ7kNvwGyLT0c&_nc_oc=AdoZIgbHWArHc8zi1Ub3nj86E2h4j6ewClwFP5yUub7mP5CEBV34l2QfSJIvE2CX5GU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3mEWESunz41Pmk1BSSkjoSbxz_ie1_I5RzZT6XccFbA&oe=6AB548C5"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esmg5wHTUJMQ7kNvwFo3bEf&_nc_oc=Adpc2kKEmYwhXRb-e_HJCVqM3DlOx6vkAFZwB8hQ2lh3Q2hxEOLqV87JMuuccG69fxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS0n7vobJB02GVmI2rX3kc8rntvTmXWARgYqdBEviq9A&oe=6AB548DA"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgoiL5CRLqAQ7kNvwGsp3GH&_nc_oc=AdpHw4tAv1n4-sn3w19woslmUl2mgvCfzmYBAFGU_l5RuL6UjkJfKanYXAio5IHcx0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKiAS2891AqCbMNvM2cIUDLsl2fbLwW_vag3F3jid86A&oe=6AB534ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v03p-SZmWkQ7kNvwFVYzns&_nc_oc=AdpESPwjEIpsxUO8eHRP_I6Id66P1-SJoa1uNCX21p7m1hRpaaEEnJTGOE8q1g-fXt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB11Fq1ZBsWz85z-evgOoSuRFutjd1zispOIJF2regcA&oe=6AB52517"}, {"file_name": "HickonuQ_1008x
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1MPoUIsPUOhOprMyszWcyeJzE3F6MNBdauJ71TZ9ZPQ&oe=6A68AE51"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMl8S0sUx38Q7kNvwGhlhVT&_nc_oc=AdomJycY2upizqLtoIxOwjwe5co_3IJH06XB6bNtvS4bU7i98muu7a-UjTZbxeiT8NQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp-eSiAedWNeALxT7TJrCfRI-IrdZTy-3LGYJZvqrOwA&oe=6A68B5BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94fD3HcQOU8Q7kNvwHvdccP&_nc_oc=Adonm1EaZ6lksJTcTZUcnhahdpLwlwqW2XRHwRQOKDSKizBSUgdnPgx-AevNE7XoQSc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdG0zOFgYGK_aHb5CpuQDWXKYowNKATOMAJGcM62g4pQ&oe=6A689985"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHhgsTtu49wQ7kNvwGEiATO&_nc_oc=AdqfMOVzqihdqlvpwkTRIfgydC3wDIp2gT4ZUL12crn6mfyVg_de0CNv9LaTHhaltmY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB584aysADuL3RHMATSAFBz93Bzr_GXevEW0s5HQaZ_NA&oe=6A68999A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTENWKc2W_UQ7kNvwF2aoJT&_nc_oc=AdqhkSYxuzAxyE4MSdQ8pUSceYUtvxRAQz17z3-yeVy6XcTMDJSb7Ap_4tb8SdKARxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhrbhYsdj_LKbzi2tcJpJQxPnXPq5MJn7PjgO-3D3LwA&oe=6A68BDED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdmo5AEuVgAQ7kNvwEZbSaX&_nc_oc=AdollmAKhB0vuSht4pn9gaEtUKORqpZPfa0o_rMxSbyK9EWYFrkha6hgeb3suJ4EGaM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD71ZyRes_LM8SbSAzdkOJepKnSQKy-S-hDYYOOfK-Yug&oe=6A68AE17"}, {"file_name": "HickonuQ_1008x
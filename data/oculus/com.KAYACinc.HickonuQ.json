1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3W8APuTy9_kmaxDhbUlBjUZalRhsfd65GvaCkp3QugA&oe=6AD3B011"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkwcW_HNeB8Q7kNvwHwug1E&_nc_oc=AdpeyTNnx75ZOlJjh-mVulbRlJb7NUcDOYVuDDjVSYuyBHj5MCd1gz05Y6j-q8KXnhk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqDelsT2qpCRi6wU2rDZ9LFuUac7noM6AuhBqPPkGilg&oe=6AD3B77D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjgiPtYPAw4Q7kNvwFylpjN&_nc_oc=AdpY4L1FBQ0XHFc5w7l6Y0CpDwdEZg0MSQn0VKMbJzgP-VwCnep3aD_3XXCiBhhYq9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBSAVrzkH9WmdqYVt7kcFYQRh7_EfMCKBSrQFK--Ij3w&oe=6AD39B45"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDcY3kXYRLoQ7kNvwFXjUPQ&_nc_oc=Adrg-bZp-_72Sypv4Bu6P3iq6b4oA2FzDRJAD8nkMnyQhIvoa5Pm0x5GJ380HNw4hxg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpQYadc3LKV782Y9oyIvXGwAlTIf_UBeWMnt5tD9066w&oe=6AD39B5A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCL1odyL07YQ7kNvwE2jK8A&_nc_oc=AdouzEzKI5ORWA_-5sLW30DX6dYMBDEPeGiuPrlVxtFv93j91JIAO9eMjV-WgbHaHIg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuiGqSCbG0SUtijHgjlhrR3XFSnoCedEj5C4RwoHRPgQ&oe=6AD3876D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OH959WdAxMIQ7kNvwFSeRsy&_nc_oc=Adr4npp1MsVIC0Gn5ww0fQBCOSN0rGX6xA3AigSPJbQwJDAMf0gjHeiRD2PVihLE5zY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPga-z1qu8TTOGUX-lDYgMT7FBAcOo-Z5XopEuEhu6ntA&oe=6AD3AFD7"}, {"file_name": "HickonuQ_1008x
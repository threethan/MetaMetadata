2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6BiJPSZ4jbxgyBM--INjchLIeEnP7QZ7UFhrcapgV7A&oe=6A9975D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYO2RXhdqFwQ7kNvwFrUhkT&_nc_oc=AdquXbgCCWBqL4z1y8jLD2xBZXEmmOt_d1rFfsgGh8-XNRgfSZc2kkwjrXd-oD2_Vdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj7WpSknB9-5-KbfGgEnTNLrV8ly8Yw0UIGtnoVHyaxA&oe=6A997D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sDrfkj6LHMQ7kNvwHCRcT7&_nc_oc=AdqppS0oEDbwPr1rQGyYwxDT4IDnniDsfSnrTPGzgJd3f3ECRDszsLL4xZRzyWp_IGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoIDGRbwGhBbGYVNk6WNnwiVthn7_H7CPvCFadGLbBDw&oe=6A999945"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Nn6Hz8l7BAQ7kNvwEuDbVK&_nc_oc=AdqHvNGY4r5dTvq5b9H8K5qsazgwHzdrRxBwB2uaDHWdZrpewwoIgPVi75pU1hakoYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLusG54ZC_P_wfDidbw4IwT_EHtBluL17hLclMxc_WpVw&oe=6A99995A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sruibuJ3uz8Q7kNvwHRUs0C&_nc_oc=AdoLoJluwnggM2NzYjZTV_jkmMfCrH-f9qHWjYPFGeiLbPTNO-6xpRWD7PHja-ys2lA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIyu0ql5qR2qtsbk3_YpFUi5Uze7a329MAfnY8VE0Xmw&oe=6A99856D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efzgLgir0mMQ7kNvwEtGF0a&_nc_oc=AdpaKbPvXIgQiQZyBlHPssic-hId1umIwOsml9bLYszjrWNYvv7o15ZYw1gK8dPiGKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInVFjkz16HCPdX18gt1ioR0tKKygynV9_TJTMCFienFg&oe=6A997597"}, {"file_name": "HickonuQ_1008x
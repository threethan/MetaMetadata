1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xp1KH7RGc6P-UkwkjqivB3-gE0fQe9vIxZfd20hhevA&oe=69FF3651"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iprja2WhJKcQ7kNvwH8qPpo&_nc_oc=Adp0oRo0TQF8G-wypmnxrJGI4WPZ_4IfxZjoFnbZ9SFqYOFAdlfo3xco2SA89XcyvEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oOiwGaChdTUnAPpLCum4Y3206WSj1F-ihnSeSQduPYw&oe=69FF3DBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cknEsEtxYWYQ7kNvwEM3ttt&_nc_oc=AdqiYF0we-HnCAqrCcIIsQQAoJMHs7-uXDRrzRECx8KWRjDQkQRph25ev8yCm9svwCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NEWDEviMnnNZmfiFbCsitWczjCiGloPEHYqOhsR6jcA&oe=69FF2185"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jyznGFqVasQ7kNvwG3_8Zd&_nc_oc=Adpqzq1ISirEraWdqk2Hy5DWfRnTeNrF8ZMQlWhvWmbHXpyyO-hEGWEj-jcy7WlUoqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tZ1CDw5GcoMXwBgAbVk6twj_T_RacXFYBgPL9rYfQig&oe=69FF219A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bl04CEhxmgkQ7kNvwFLVqTZ&_nc_oc=AdoK84OXAfcQ4KeM8tGCcdLKeGwquzSHiMyIHU9TC6ar4DVZw59jZASj5n8ZG-E_RHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r6i70ap3E5pLU3PkniG4Ys4tQ_pAB3MsyHuVJWhAEWQ&oe=69FF45ED"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PR5ntxZM_0Q7kNvwHnyTRn&_nc_oc=AdroDUZnTy8_jgHnHlGzA1SqIuMZXt1l1qqAvdpTW30Azz8R-wDTuxTdVfwP397e4x8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sVEq04fIcU1N8-2kTp6YEB7ok3oaLmVjRdCvzsfWbKQ&oe=69FF3617"}, {"file_name": "HickonuQ_1008x
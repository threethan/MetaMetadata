2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcfK6RZ-ghbZoBLykjIp5lSAmIcJZ39bi7wz_8YsZlxA&oe=6A8700D1"}, {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_06.png", "id": "9275378455810120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392876_9275378459143453_7807101496732911332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd6Qy3O6cAsQ7kNvwGZC2Eh&_nc_oc=AdoCcoRemaeAd07f1MOmC3xRpqLBgq1Tap8gpJXMOHWHPzFzQO3Zc_XnX0a8Pu3-KDM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1QExVfJMSlU-lLJQ0KfX4dFM-7QPlOqLA1XKFeu0kPQ&oe=6A86CFFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HickonuQ_\u30b9\u30af\u30b7\u30e7_01.png", "id": "2855274224629294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_2855274227962627_328113015056250623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP5IBoj-CB0Q7kNvwHZ5xdG&_nc_oc=Adodw5Vz2zQhFMh73zvGpMCSa8u9405Jos3jyqz9J5w0ZVXt23_1LhbABcfQ1EYAuvA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh_TJ3JsF5RsiopWSogMLFgczDqSDb7HO3RaVErLo-yA&oe=6A86EC05"}, "display_name": "HickonuQ \"The Rise of the Legendary Farmer\"", "keywords": ["MixedReality", "ActionPuzzle", "HandTracking", "RealWorld"], "long_description": "# Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\n**\"HickonuQ: The Rise of the Legendary Farmer \u2019** pulls vegetables out of your living room, in the park, on the road, anywhere they keep growing, with your bare hands! Find the right moment and aim for the best harvest!  \nThe Rise of the Legendary Farmer** is an MR action harvesting puzzle game set in a real space!\n\n---\n\n- **Harvesting Tips**: Grab and pull to complete the harvest! If you let go, you can immediately sell it and make a profit.\n- **Thrilling timing**: Too early and you lose, too late and you rot. Aim for perfect timing and you'll be a god farmer!\n- **Exhilarating physical harvest**: control the flying seeds and experience the joy of a bountiful harvest.\n- **FREE MR PUZZLE**: Once you start, you'll be hooked!\n\nTranslated with www.DeepL.com/Translator (free version)", "short_description": "Grab it, hold it, pull it out! An MR harvesting puzzle for everywhere!\n\nIn HickonuQ: The Rise of the Legendary Farmer, your bare hands pull vegetables from your living room, the park, the road and anywhere else they grow! Find the right moment and aim for the best harvest!\nThis MR action harvesting puzzle game is set in a real space!"}, {"images": {"nodes": [{"file_name": "HickonuQ_1080x360.png", "id": "3769886749993965", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3769886753327298_7873851012123971987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCfvcl5F-k4Q7kNvwHA05f9&_nc_oc=Ado7J0hy96itzNHfkwsQ9TqvvirO8UJn2FNmUGjMwSnlXX0j2xXWV29P1j4gV_4U7iU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo5m5U4YUl0o2HXLwVHhdvbbnypy13P1_uHOZnX5hzNA&oe=6A86EC1A"}, {"file_name": "HickonuQ_2560x1440.png", "id": "1286422819224822", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974447_1286422822558155_924012105581734869_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaUKDcrBQusQ7kNvwETxyZj&_nc_oc=Adp_9Dh0d2VAD3GoY6pmoImSMoONhUnx5FCmZYHva7VO-YsRoGDu0bEEaFEY2vY3E7c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC9JI5lIB04wWi8Rywf7p0PQrrofIAKdlEJuf7Px3FVA&oe=6A86D82D"}, {"file_name": "HickonuQ_9000x1440.png", "id": "1284631692891617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031452_1284631696224950_1420600272098178709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBXNNVbsUhIQ7kNvwHxLKgC&_nc_oc=Adq9Xa6BgceBubaMQTrHrbvNKXSwmyH5x_EcxbjMUaKiFWg2YamWesMmhrEr8F7vLW4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqKQ5TeFa_cvYKZZrp0NrBemvUjlYm1WcipBe6nr-qTA&oe=6A870097"}, {"file_name": "HickonuQ_1008x
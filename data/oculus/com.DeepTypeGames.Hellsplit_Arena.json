i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3khNfznUafEQ7kNvwHkYKm9&_nc_oc=AdqT3nU2Tf8H1H24vBw-bg9t5_rI7KgunLLTcUMeondCY0Frk3Midqg-QRGHi2tHsnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62c8QsDVpNFh8GrtzHjXhbKHucn-x8CI6840M-voer-w&oe=6A0B2988"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tchn61eQ3b8Q7kNvwE-6Fz3&_nc_oc=AdostuqleAtzg-4PS-tjmS6NiVavTx7FjqARk32omGlJ_6sK-aKUY3CA_NqhFNATr-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FuBLCM3iqVQ5_O7TMmcpo1klppxJ94IEDFip7lyQcqw&oe=6A0B1C0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb6Q6rIXrg0Q7kNvwGbeaVV&_nc_oc=AdqEr6dVqCWsqkNfEnQ7fujjXaY3Op_ZoBK5Ubl695yRr2dHBBux_WPr_7IHdjrugyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fcc3urttD7jN_ov7pFcBEZ9Cc5qKwNBXJolz_w1IIAQ&oe=6A0B09DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXTl3hMW7fQQ7kNvwEHyk-n&_nc_oc=AdpBy2uZlWBTskfCiAm5EZouJi_-BDYp_WfaVtvdZvzKLG_IdGM4aHFtZJLJjKSq2NY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49A8f3OYAvlM_qih1LE6MQR2A41R5fSowMElldQluWuQ&oe=6A0B1A58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtbyUVMdRyUQ7kNvwF0Zjkg&_nc_oc=AdpEZAfFlGkHcXpy5J0JpmpAwA-L-oOJMKhPoId-2EA1VVRNpBwcdCkXh8OZUPvnePM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hxIyzqLFLB4xJ5pZra7JGo11sHl-I-75Aavp5Lnx2sA&oe=6A0B09FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
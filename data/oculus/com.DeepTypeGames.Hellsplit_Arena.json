i": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK647PE5dfwQ7kNvwHpeRVv&_nc_oc=AdoAve87NWxQV6cAIkGtuaaBmk3SGF5pgLjnaV1xoKzZ2wQjfQFLve1HMIywLvRNAyQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLsrwh8zlh3bUKeXEjEf1rt-ylENdtVukGBKWTDB9IdQ&oe=69CBA948"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsIQj5qdx3oQ7kNvwG7Hl4l&_nc_oc=AdpNNNCrYe-ebHvjBnPX6ONKOTv3jKT3jYsLNSrZyEukPRrmxwNB9E6iZw2M_gqPgFA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyRgy6VcEEru8JkyX2V0lQkzW1X55cyHMG79K-_aeVBw&oe=69CBD40F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZcFJGOqp9sQ7kNvwE56-X7&_nc_oc=Adr0Kg7WufHDDYg0R7HcOr-yj7-lV9n5iq_WFO21aAUARJLfGhOT2HGRQZ_4MoTwfU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8vVGYVSJhw24Q8b_DZ7oTda32F2-awkj0oKdWkQ2kwA&oe=69CBC1DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9nqYmTxDjwQ7kNvwH_ILjY&_nc_oc=Adq0ZrnB2UcQl8IszvNq5QQcXUCtbliNfMSzmjH4yXxpRSKtxOW9KTYPIxRLlDcaZD0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAGgL4BuPkKL3tW8ejeceYcjSq8mMhFEVjS_rwQhMPSA&oe=69CBD258"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43PkOHa9F10Q7kNvwHdhmQ_&_nc_oc=Adpts_dBQdmnobHVCbuQ6i2qopeHtNnDITSboVwlLFD3l2_TBtmg6SwBgCmroq8WN6Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyc5oJXsnjc1nZAV1JFPhu2ZwYsbwnG0jE-QzL0bQVIIQ&oe=69CBC1FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
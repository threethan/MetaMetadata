i": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7RJzm0Vnp8Q7kNvwH7jz-P&_nc_oc=AdqmzQ3G2Cgp89LGRYzpqabTbZ8twzFYn9iA0EcPFRhPqa-ME8-QiNoWCp8hkZB-i1Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LririEPsJhCIHsaE9JWXk8N5x7vbYrSAYZ6X5A6s-Ug&oe=6A219308"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLIRNLJILSYQ7kNvwFf73jc&_nc_oc=Adqve8kO8c4lymgzTue-obHtbll_HaX8A6r8WNXBm1K-zVnkvCCmz9D1hK9sx_DWsRA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U8M5-tS7CFpqeBuVS8v_ggqfJpynkqXnwmLCtm_rx3g&oe=6A21858F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iWw6bwruC4Q7kNvwEy8axV&_nc_oc=AdqvqBHEdwM6alyGbKkqarR-dbOltbe62asKwBy2eHvqBv6j861rE4U2-6IpH_G5YUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7OM1KYLP9J2l096uwzAKJ-cfGYpPfEEaSV7KCqa3A1A&oe=6A21735B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRiObacD6V4Q7kNvwFAMkvu&_nc_oc=Ado4nq2HZIniT_lsbPgv4cOE5uloZ3IiGq-qJ97mpbPeYJuO3Qhk6cmEPejdR1jTbSI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rjpYUoie33NBVIcd2-KSj5YfuiUfeigtn5PUMepfOpA&oe=6A2183D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKYJ-XgoM20Q7kNvwERdevd&_nc_oc=AdqL9D9P2fG5-QDRpjdsKYveFm6aVTpF3TAuYbTaMeSyY_JdZniIngYC3gkiO6UamVU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A9oR1803JUvff-PXXuDp7tKcEX65NuJWYww-W9Inzhg&oe=6A21737E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
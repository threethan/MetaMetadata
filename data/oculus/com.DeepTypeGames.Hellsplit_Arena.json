 {"file_name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO6V0z_6jTkQ7kNvwExO_vr&_nc_oc=Adlzlro-DeXAcJfIwYNffSowI30uoqeLl1pKo5tluohG3PkmrCILhhoSm6tcUlt1iFw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwK6H4cKWCdc3WcRCF6jVICwBBekGbWAil2dRbJ4Usosw&oe=69AAB762"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro_H6riOdYIQ7kNvwGgjmwu&_nc_oc=Adlvn0BX93m7vXhx2UaZW8apQ-sKGIxd_RZLjZO8ZjTIlNkhsMm07rLOFIIpnfb9TjI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy53SniGgWXzPdy1mSNf86Z9xpE18ZLM4Q-VzLI3SbS3w&oe=69AABBE1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsNCCJ6BGmgQ7kNvwF5PRTR&_nc_oc=AdnIbxOkBSKarO02iv7DNNZfOGvxftvgOq9dRM8sfwgvSHBNwQZ2TKdY5s_cxaFPcTQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afz3F-kWW0rBCznVC5V5RUw3LO1n9xCqhbhtCzzaqhevIA&oe=69AAB4A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLzx6eViUSgQ7kNvwFxdA8g&_nc_oc=AdnLoT6s44ABH-yCepIBebAW13onOyDvg24fI2Siba2t3pnE4qwE04Ms-btg91rb7Gk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwX1EcjPPfBwZtdXVZ7kk09Ehj-V6ekmtY0NfHP9G0R7Q&oe=69AABE87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxGypSFOg0wQ7kNvwG9H1ve&_nc_oc=Adl9vTMBZr58S_q-ndSQOnAEGdUzXQ92GxRsG1ViSNrt8DCIDzmdalDWAavBwRjVsnQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afwm4OaOKgSlYGapO1pkuNqIZEE-Ti-GORqgntxyztjjPw&oe=69AADDA3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743
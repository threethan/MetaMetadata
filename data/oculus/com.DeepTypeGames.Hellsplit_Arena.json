i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK647PE5dfwQ7kNvwESbBjj&_nc_oc=AdrHPL3CVVnJBhb0ntXbW7KqSpkOXM11xpXb25i4s54mB4W34-o15lYUpQ8RCCz3CmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afza981RswwlS5jqXBC4H1Z_y-FGMv4TezLLx2-PfWynIw&oe=69CA57C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsIQj5qdx3oQ7kNvwFmbY_e&_nc_oc=AdqQUeE0iJouXK0_Ma2q_AFVnHQQJpWB8x5V1P6yr5zzzNsnP9ucmMDz2n7ZyDRLbjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLk5dfC4psVUjq-BOO8pizue73OJ7JFPjNwZXZZNIKOA&oe=69CA828F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7IeqX9BWA4Q7kNvwF76Uhj&_nc_oc=Adp3Ay3TVPy7CjjYczrSRszN6K_Czw0us1j6wu0lJwRLuzSnTMlSkZVz67Gce1fYHDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXQ70THCijsYT6H9fQCXR_O8LqmnxuYHW-6YdYLD6YgQ&oe=69CA705B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o57cGis4hpEQ7kNvwHnpg9l&_nc_oc=Adrg7LKjWHBfzvsu-eJ70oXniqbiSqRt4ga0z-iM7yp0QdyaBx_TecSYJaPGqhJW-2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyvy10O5I-KnCOavpXzYZJc0dDaC4R2Meno_OfDOuzWpQ&oe=69CA80D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43PkOHa9F10Q7kNvwG6Qxv_&_nc_oc=Adpzd0elYKFGNDot5Kc_WOrBeCMAyz1vfkWvoPHnl04PFsk4501biMDx6OHSGttYvdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_v6a-S2GGPbziORrno0iODxp_BmLg2S99wt2X7193ew&oe=69CA707E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
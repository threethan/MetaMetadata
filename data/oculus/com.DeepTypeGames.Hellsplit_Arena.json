i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyffLgfaC4wQ7kNvwGgJyCJ&_nc_oc=AdqOCLiSeiO2CgbCPt2VNN1yvRtqhu653697kKBuJpjw2vJZ5i33F7IUHTP-fIVk9Bc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qqvBgFn0PQqgvitC2JPH7Oiu7I7fE_t_mBIvhwzZYlA&oe=69D27908"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaZ-x8brpZ0Q7kNvwFPTYlF&_nc_oc=AdrqdNC1pR81--vg3B76U70X9l_-DEWEZdgpMernl7RsWIbW8ABs25UogEiv713JFIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P1jHkLYIkLk5XXg6MwUoJEIfSSLpjrJuOcCVxW6UfPA&oe=69D26B8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK7SvQNioKkQ7kNvwGbb2ek&_nc_oc=AdrQcoPd-R-gR_YIZNg7AzxA6t_IkXeMnutiDdkwcIbPCVt8t8O1Po4ZpPZliwSI5xk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BXZDJL0_waiaqk29GIz9aqAKC9LQmfg0ZRliEbC6k0w&oe=69D2595B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtVt4SE30s8Q7kNvwHfDKxv&_nc_oc=AdoW6AnNyv9spUaoOYgD8R9jQn6CczWG9ixHxGpY0qnrGNrQfMnWhNoSuuP3pM1EFTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-65WAol1114sE0Mh88YEVR8qYFwvTuJy6f5edbD3LkA&oe=69D269D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiXR27jZIB8Q7kNvwFsdemW&_nc_oc=AdrBvwh1wgVgTXgvoqpk7Z2HBFtsBTYHjHl4B65oBnmO069UYKGS3IC66eII4Ga9YQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qYOpumS4eR5u9m1hHiw8CYz-qrgVglzyrp06jKwIT1A&oe=69D2597E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffm8VoeJaJgQ7kNvwFtMtZq&_nc_oc=AdmEr6TKH0F5plUVPV1cqCwgtskopLblnQ-pJcqNHVzpvd-4rxznOS6QD4TCZr2mylc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyNE8KKV_hB4UNSYCMOO-pphLWruH9oP4ri9xwm-CUcrQ&oe=69B7E662"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8y6c2iYE4UQ7kNvwGacTfE&_nc_oc=Adl_rRWTEXSNicQwPYJaVMs_MowurtJz-dhM46-m4CGvuFP4ttCSe_bYn4hvULr03S4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx4jvrRFt2j7ydeyE0PD8MVh7GjVL7-bs0fPWH64Xpp6Q&oe=69B7EAE1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNU8LK-J7uUQ7kNvwHZ0HQd&_nc_oc=AdlohGczOvfA16UC-euRD6iFGC8lDMngZtgT5rDj7DMtR7Q-qjut7M8ZRqmUSBuBLGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZRuoLdD1_b16unwqF9RC4qWKGwfKHtMxKIM1zr-xPlg&oe=69B7E3A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMjxrfHBVOUQ7kNvwEb7DIV&_nc_oc=AdlHanwaSH-OGbbb2FkiWf1eht_b13JAyLDxRzj7PBc-vocfmPD4cpFG0bPAYDrbyok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwdPjIS2us7nENYOgvJ3Lfl4fVzzdQdTI1lisSZg5T96Q&oe=69B7ED87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2MDXEYYGSQQ7kNvwHMGccb&_nc_oc=AdnYZKZWK25v5kc6Lbu67voBLlvXEih__llV2kvHTXRUSkMim6AhQ7zI8QAY_q1kzXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfySovuWjL6e9Xh4yfJXXQRAo-hU9uUC3MykZiLUvunDbg&oe=69B80CA3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
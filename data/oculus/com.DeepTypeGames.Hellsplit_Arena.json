i": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2VDTIQ4-6YQ7kNvwFvqIIr&_nc_oc=Ado0lpMygxjx14MAr6490ccZZUCCuhNz6r20vkGU6t3Ffdsq-9xnIE4fD7BbDclbLLU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17Who2KBbcc8oRmef5svlO2k3WbtXs1FxE7eJHMcBBbw&oe=69E79108"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ-DnQD20IMQ7kNvwFCp32M&_nc_oc=AdoQ2yZe50N4W9yPutZli0gVko979am-aH3xjEXmeE0r4oB4MwgfNF1_lXvM-wxmfoc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_BJ1l-UY_IM5B2xaajsJt0WD3_H8LuF_v5oqI5I3AKg&oe=69E7838F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q_ioqzrZzAQ7kNvwE1OGoU&_nc_oc=Adq_EarxSaWW1HnwyxKTZvqXjDS7cCkFGN1O9PlD8VA1XFQyEEsJatc3mQzcBbMx2Kc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zHvhdKZmvhRJ4T7qliCwn1qEn69T_SOS90gL5zOTwkA&oe=69E7715B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDY-VH7YrhAQ7kNvwHeygll&_nc_oc=AdrgOaYFJlq4NCCsPLm7DXoKoyPJpz2NmepuY4UHUMyumH1D8uHyyVnGDAWMEt08qS0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OrHhdqZBiNW68uypKFp7_QIFtSYr67MamVaiI8F1aJQ&oe=69E781D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuw91EMSSxIQ7kNvwHCtC5x&_nc_oc=AdoBESmNUmei0FkD8Bt37eY68tHZctqH3u9oTGTU8EIktNi3z6Wc5Qc6wfK46DiS-1Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LBfOHXMmJNCm-eDYIjectvAEVibbxLmpoKz9gIiawyA&oe=69E7717E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
eI6RZrq_CuQqA&oe=69FDFB2D"}, {"file_name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNbIqBo8kF4Q7kNvwGNh-22&_nc_oc=Adr18DXYP2RupQViSWCZd-Qo9Ldm7XeLZrfWqs_PouyU5uIPqhmmELDaMnmzn7TL-X4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7prR5Xhx_hEizZNediInvOUSEW-YdxW-D5QtFRIHvY7Q&oe=69FDFE22"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zrkLhIJVIAQ7kNvwFw5jEN&_nc_oc=AdrKv2utZEkyE-2quJu2QO7HggFut7ctHcDVKYMGK8p6StC8MIreNRAp_5wpD5safu0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SB1zzK7WIicxByrhgYPCskhKCDYQcgtdPB4xJEsBkIg&oe=69FE02A1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkhzB0VQrJ4Q7kNvwFqGkZX&_nc_oc=AdphRzkIN8SJglEWmTYyJolLy107XUjY9LaNRVaGJziTD-szeKZYoQSqIdOVmfQd9wc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xxhDaSckh_eqAxIu1f0tDhz80CBW74fi8iMAfw0evdw&oe=69FDFB60"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIXhZP1YWj4Q7kNvwGI73nR&_nc_oc=AdoI0cfvWN3OFbbET97Px-ygEwSo_1HgkbxFpjF8mhmUA7liMMlCr2m70GOu_vw8uJM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54Z5rdbg-aVrOFfl899kSzCfEmVK8gN0tm6vGjq995dg&oe=69FE0547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpYY1CJsbW0Q7kNvwEhC4d4&_nc_oc=AdpHzS33JkcjyD68Lc56knKijGmK-QjE2ibA7HEtQpi8I4skCiwrhRrA3tSopQiDh88&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y-0Qf39xeBTnKHUAHpEQ7B0a3zbk00dSR1JnCOMaYfA&oe=69FDEC23"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfo
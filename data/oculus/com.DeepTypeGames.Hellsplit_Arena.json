i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzGorBbcLzAQ7kNvwHgSaYP&_nc_oc=AdqrhdUlzcp6TGuF7EtBkQi_ezoTuiTwLZmSS27x8YhcTphhytltIygcHT579a8CxtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zQCXj7C7HXIde2C5cD37yFevPSi9gU8YZxERBR8_3pw&oe=6A2ACD88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT85eG-ZENoQ7kNvwGlnRGQ&_nc_oc=AdqUBhwvma9NtLFfdYlIsIvdu1n0biGYzhlUDtuoTN0XQlidSDGN_4K03IRoobQyvyw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jBXhmeHFEul6SgNMDWELwcgLFnt5Xms9BHTXBKCpI_A&oe=6A2AC00F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDjHFjmWDCkQ7kNvwEoIM8S&_nc_oc=AdrAjrfTuqvDusxlurB2pcGOSOW1hdiUOVgr5M0PePpPQu5lcEVFiAtck6dBgwzoL-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Lbnd_Jv3RYScWWL3cooVJd4oKVMs8Vtm3XVCllkOgg&oe=6A2AADDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZujIh3r6BOEQ7kNvwHAOZRK&_nc_oc=Adp3mU6JpLaO6_10gFr_4V-2mEf0LLPqZijSQzYLTnU4j9w4BnQSooZ4C6lBzXeXzsE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dGIqFcDiVGI8G9-owIfsn0D5Z6ekjxdEhISnCQ0QbKA&oe=6A2ABE58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn-V2RsM0PUQ7kNvwFisxG1&_nc_oc=AdqPQGee7pu-c-KMl0HV5iOWCSjE7t0BypuguvVewrOIwebX6u4SSp9mRSJ6k4_QNFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-aLyIgIyQgOsPIZZHl4Wky67PeE-3FE3A4Om5Sn9kaw&oe=6A2AADFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
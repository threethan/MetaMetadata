i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG0MMTE3eggQ7kNvwExDkhp&_nc_oc=AdqPMWCLaH0q5LQIBSZSm2JAghor1_hD4Cvm1vAkk7cAcjHMbevRPN1qfPYXY5aoQYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eBMlEo-KkAmx38axJzHWytwkO-cmHZHXsxtflXMKwSA&oe=6A034088"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiP-VmEIBcgQ7kNvwF5C6GA&_nc_oc=Adqlc7dfQbOY-CL1PYkwz-oSmz8GIgY87eWwlOizP93uc4TRvgXPKaQDzikLADxunL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BRxz82eI8mg1IwSF4esNwA1NctP0H_ggJ3OKkzHTeRw&oe=6A03330F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGugw3XcWVwQ7kNvwGIfafJ&_nc_oc=AdpiZU0bzVJQ5bTTjoZHc2sm4RI5cNZm5xT_ofA3eoTVr7gyYM4H6SeiYkD7dqgtCas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o4kvCz0BQ831jYdgDDc4ryW9j86Mg0xE2TSaiW5X4tQ&oe=6A0320DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjqKIxWj7UUQ7kNvwEsZDmn&_nc_oc=AdrMOf_MABOHhBfqvZIGtgm5ro0WI2ucahj8vquy2A0tCITNR4KzybVUv_OCe6JdYDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aqyl0R2viUpFUMj5xFi6zktGaj5ZN9H4102Q3EjtSqQ&oe=6A033158"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B79NylKoynsQ7kNvwGEi5TM&_nc_oc=AdrowC9lxDGHnFOtZFZaxmobKKyZMygrmotjJJ_k92MYUaIZRS-PlPsv7_R67A4tLgE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f60_tiIiRMnFEmAJPc8KG4Rqmeq0UZPD83ROwc_3j0Q&oe=6A0320FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
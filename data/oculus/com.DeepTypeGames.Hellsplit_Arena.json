i": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkPFiteHYQoQ7kNvwFn3hsR&_nc_oc=AdpHgNlH-PEKZ3OgrKHAKOhO-tXUBZsYDm2Tx1-H2GJdeNzjL0-JDbYBNVsz7010hrg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vmrtUZyVz2KxVfcJYa19ZS36ToKa-i3-KUepSSkFuBA&oe=6A301388"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtcrWkG9GrgQ7kNvwHKFvcc&_nc_oc=AdpgegBgGqlWNBb_MId99d7pBgQo1NjHQv3RRYAvAChP_L1MD_Y57_o2Vo7xdWBNB4o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TMnpDOD4O6ZlSxuZMjvW0EuimsRV6PMa6OLWEkzBwAw&oe=6A30060F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smtafPBLCc4Q7kNvwGIPToG&_nc_oc=Adr78OaUYx2Lh_Tav-n_NkcpI9Qy2DWMyFaG-ON4ZdMQpCyGkLQrjGF46h9zEsI01AQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6RdF_EoO_z9FyQVjtVMFnHJ9RVIgio1YjD9nzGxsaoA&oe=6A2FF3DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEpuP2ZnT-IQ7kNvwFhoc5w&_nc_oc=Adrl_gb4c4VPrKmz2NxfhaFg1tVu962HQr-pYKTa6qgXpnD7ZDknqqWzNt8zlK3tWsY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pt6m2r10rfSJa7avxnMJdd2rJdbjThSqG40ABVZqYqQ&oe=6A300458"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE-S_RrJK_oQ7kNvwHjG75q&_nc_oc=AdquL73Yco-cHq4P6CQXuukydk26pNrCo34PuJJwMoxjIEnZIvh7em27bPTjcIFKW8o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W-mSIpfQImdOUg1n0ci-WRnzCyL9-UwPt_5LoRaeZYw&oe=6A2FF3FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
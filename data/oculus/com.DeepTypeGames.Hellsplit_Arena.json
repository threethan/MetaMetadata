i": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceQk3A2sTs8Q7kNvwGgqczS&_nc_oc=AdpwdPGTmLMX7-GAxwBDPz1cluu_dIwL8pBpcPgkv9heCba8N2FFePW-5LTUKDhuOPU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tyvQ6wp3PBuXWXcY9DX1mPL3MDIYX9-STkHX3-En5Jw&oe=6A106F88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H7RxS6sXCsQ7kNvwG4UWak&_nc_oc=Adrnmt5iIFb85M-z3dsMT2SQNAR0G5MKXL1-_NMwbuPimM2Z8YUvIv7UhwPSPRWhKkc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sm3fXoPFRpGEzaUgPug_qvhXaJAyv40sVgpU_sPaX2g&oe=6A10620F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3wGqgwFW8cQ7kNvwEjvzIv&_nc_oc=AdqcdNl4a0O77n8oj2TKbteeBaSFgGzZG9vJU6VRcvkA5MQwdWTXzPAvY0D0MKDYyWA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64i5LbIvgIG_ctHeu8YCTdR0SvDWRgyrBNY-wLnWPFQA&oe=6A104FDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PlFHwauXukQ7kNvwFhEhCf&_nc_oc=AdoYNXZsGgQgcdmCGCTyZcskCc1RQ-8ZGnVjVw3HvxQ4CYS9iwD-sDg5c5CeJhdFJBo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lJ7HvDOcf57HrX_cJkFlUjo_xrpYGHPWrc_Y7DuaHJQ&oe=6A106058"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr7oDRQ7qp4Q7kNvwFQM7eA&_nc_oc=Adr84kEN1dFUntg9hqUW5pP49vvYO-aleMo5al0UoPFEbnjX6qbdc5lvVeAICWbrGt8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_RZb-ct-pCzvHA4FKTFk3qmwnp3XfKAwDid-YeK_k6Q&oe=6A104FFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
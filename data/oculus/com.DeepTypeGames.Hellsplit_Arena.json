luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p98SyQnuhKgQ7kNvwGqMYrj&_nc_oc=AdmKcm03xsyESWGv9V67-lzwjmR4kUi7Xt-8unJWL__hNv1DxVNe2ahTGGFdtpdfHxs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvIjRRHH0GUiv7GL7HxRtSx4tspujIfILjWP2NGgVJhfA&oe=699AE562"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l3bxLxUcQAQ7kNvwEEaYsh&_nc_oc=Adl5wKIQGCugFrEM2_Bpcy-0DOSsrXmYU_ejWf4C8ZK8b4UuLsUVP-ImnJdMoiCZ2tY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftDFogQQbFf7Pq6I41_8ty8GS8d9_vRfbJBvwRD_sbcjg&oe=699AE9E1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H_a8Fe0uJ8Q7kNvwFPEPRj&_nc_oc=AdmG8srPBHPvwtVbda3byp--t-jV9AXr7FpukYfQfuJLE-Uofnm5zXGoLy8NVZZUJDw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTYonxvzPL8RBxGCYQV1QmR4JRvAh1o3bLw0Ucozs-ww&oe=699AE2A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U26mr-CD5UQ7kNvwFgsoS1&_nc_oc=AdlZnD7FCEJK7tTANrEExfn2wlyo0mOg8CMAy_DeCBiXM4jHlsXjSpxcRbY8_yRUigY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftwyRLjUmZAbDVLCb0aJzLRun7rRcUo9I-qHZdbftCSNA&oe=699AEC87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOkqAIs7xl8Q7kNvwEGyeXR&_nc_oc=AdmP8Wt62X7-tqUK_1_iRPZnWKf9MyZu8lo793-H-CqT_V4JAMBsbm4VbufU6uBRejY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu0HUXOmZbwTFmjC9a7Xp7GUKgLML8fxy9-QMmgIARWmQ&oe=699B0BA3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
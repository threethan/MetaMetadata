i": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ge3vTjxGLAkQ7kNvwEplhFV&_nc_oc=AdoLBSNZJMqsLkWf9e91ccDZ_0VaGwj1vstcD5fq-TkYw1azgnIbLjdkEt_qCQ0AIfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GdDeF8XCKobiqPhryip1MW9zc0m7T01jDgJFy-la-hw&oe=69DCCCC8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM19S6rcE8cQ7kNvwEYp85t&_nc_oc=AdoTFAgZderYThSXLCRyKoTPrqqcTmNUDjrstYCD2fyAKVVDg7MGcweUKZgiVGk_ywY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sVswrHprJClPp5cA5dNfE4jOI3KLABDUQMq8njTyCfQ&oe=69DCF78F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WbqmRTJvSUQ7kNvwENG9u4&_nc_oc=AdpS7Oyg_NZokqGE0-UJrL1dZ0tgoMMC6qAtrLUPA0lSxDQwtnWlElVCKR23mlAqklk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AKoN2q6XIr44uO3_w-qLfLt45YkU2kaApH3ebDppfUQ&oe=69DCE55B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GM6vOR7MQR0Q7kNvwFsFSCO&_nc_oc=AdpJQnJrujw6eqzMaOxN6jQlO9KJzyn4hue0THehrXJbLSE8sGgutRu0ItgMN1udQTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PhhWeA3triSVkz6ehcN_mHcZVaE8y2uk8Flfmqe15pg&oe=69DCF5D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv48XvmlNZYQ7kNvwGq5fyV&_nc_oc=AdrqFXFr_zGzT-zSL8Y_pKIfilo1cjHiwXGS4CO7xWB6XOnbLf-sUFRlv3wNT_sB0r4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0--Gd7T3hQii80nTAreuc_OiSCJH-sqioZnkdkgVKXPg&oe=69DCE57E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
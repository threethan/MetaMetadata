i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUX9JBP1flwQ7kNvwEQPCgp&_nc_oc=AdqyP38y_OVRAEZjaIXt8wOEbE2JLDUG7_hZFKCLaX-EVHDMVwVEBRcmr7Fd3tGsckc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_30F0H_YV2XRFiey0mdt1FKtkm4BWk5M0duHTV3UCNQ&oe=69D63548"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Exx_J4ZRTkQ7kNvwFLp93s&_nc_oc=AdrRKPzIE43hbJ2lFIgTO1CkDkLH2_5wztMt56xMADO_YeErDI4qiDX93VpyZkaDpGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qnRbaq4GuYsh-AA8Duuo2JaZFYxAOPQ02fbaD_A0Jlg&oe=69D6600F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncaZNmpE2ogQ7kNvwGlWVIA&_nc_oc=AdoJ_dNCIcVu0k6QW-2NDlDfTtLg8-azrDpoBNxA_Eid1eRoqiFlDKorMaDReHPRMhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rJSbFaW_mLDXIx3fPbMtT0iJ7wgNWzHe0azDgYfV2gw&oe=69D64DDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8GRFcGK1GcQ7kNvwGih3uD&_nc_oc=Adp2FHHj6wzybSivaKd_XqOfWuSMnTjAXdAZNUz9gK2Hsd6wEtYVJj5UjFlpmYFVR0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y1M1-a3l4fhX9Ty5s7gw39abGINl_AUTwV9vvf7_e_A&oe=69D65E58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAX9MqDG-acQ7kNvwEBcC3D&_nc_oc=AdotaZmCcrIINqNEy6IGK9pjGcdPXKTThd6lNX25Ni5BPW9Sr-sj24fGm3wFuGRCE8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f0vGtwzsJ1XY5T7UWmpKpIn9RZqRwbIRV3mwdvrXTrA&oe=69D64DFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
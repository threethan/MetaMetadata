i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKtJ-937pVAQ7kNvwF11JFT&_nc_oc=Ado5HZ-BRoiO9V9SC1gJ-NpWN6pKMSv4eHVawF5xxjvSun9ETSW2KxcDjBUmiErP5bM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TASroQZW5myeuJL4Cumxj_kSntv9DRxBAbKf3XYzg_Q&oe=69E8AA48"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ-DnQD20IMQ7kNvwHqNfx3&_nc_oc=AdoxKhrdboFRFjupWn1FeXblCHvzq7DzvH7okLDFy7-bAZo6vTMbeQEU4Gwgh1yVkmA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hcp8mRIOtpzIcXGWXJjsxTAMcd5lChO6daIB7q8xKgg&oe=69E8D50F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q_ioqzrZzAQ7kNvwFYiHkF&_nc_oc=AdrWVeCT0I4NRFkdTZYaKvnlLIFDZ5XnWGiNpiXBJ1A1ebpGWePU9r7kS5W_gNxVmFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DtuyhzX326w0JTWBi3wK7noTzUP1DRwuBDMYOdcbvTA&oe=69E8C2DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDY-VH7YrhAQ7kNvwFudLNU&_nc_oc=Ado3nDHBP2qRg_-2CLEU-zn6wNZFtiQrvkZn9Fvj299be30nPdXxSR9MKUy4S_8CrZ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w16G2JpsMMeCeQDUDsy3ww9eJftji5uHS1eyQTbgXwQ&oe=69E8D358"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Ixyz3Ld_sQ7kNvwHqVaNz&_nc_oc=Ado-FjJ8gGG_jTJxja6B1AWMAzDfdO5ANXereK6uXuRs9cJyIxNcFxvZGDEcbGiH5Uo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z11OL9MoLiq35fgSvrFkMyVj4yGiV4NPBagVu42K1_A&oe=69E8C2FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
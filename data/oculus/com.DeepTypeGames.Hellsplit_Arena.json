i": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkxP3nKIlE4Q7kNvwGfaEej&_nc_oc=AdrLYf3UmmjO4F4cDufk2kAsqSqt_g2WrDrrwv_Km6ErPl8YKVf9G5ExUkG5MEm4R1o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GsWyLYPN5ToKqHndkpBs53rTzhtWbsXTpYbxOf6OI-Q&oe=69EF7A08"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q89LWorFELUQ7kNvwEdRUSX&_nc_oc=AdqBhOf2Gkv3hGwAb5cXXSPKjpnacApHBV8aSso7MKB29rv2QAvL2PlYdvkz0U7Hc4Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X3S4yIIkgoNtr7tQ0I0ur_w5GnhWvNpTHBhBV947ncw&oe=69EF6C8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw-GFeqT5BIQ7kNvwH7oDFI&_nc_oc=AdqSyN0rYU9HA7aYhzorOQ8lZzFx9S30Hr09o3_I-k5CWksmMJKeYjbB18SusHfm_40&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0r-1iYE-NcrGAlubbLqnCM3Fqeow7R5xeqa8UnI1q83w&oe=69EF5A5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy8l8pwXMfQQ7kNvwG1IGw7&_nc_oc=Adr8OqoxzXaUq3ilP4sSlfCj8rifhaPrEFq7IcUwhXEHl1C9gPKm8ZW50nkDGuR057M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IUj8OhkypbGp4FMPVPjCCLvJxSk721HqitchhpzPZbg&oe=69EF6AD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYGEuX6kZz0Q7kNvwE16WwP&_nc_oc=Adon7YgrL56mzzQbwL00TF_eXxHjJy_0S2SjKJwZXunTMRRQLOBWY3W6NaRP32YbKdo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GhGJ8YFZoupvHM0vK1of9Yez5FWeASmuMs7WsrVh95A&oe=69EF5A7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
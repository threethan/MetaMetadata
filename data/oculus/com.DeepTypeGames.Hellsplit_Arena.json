i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwA9D5dzGesQ7kNvwFpTpG4&_nc_oc=AdrpB6TarB_2ElyoFv1txxxC_knU3xzxypUFOWFN0pAxDnw0Tc_GY6j7SwSy75Im9ZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W56VglePlcXbJ10x8fDF0ybOYPrIA6mcwYaXnRFkaoA&oe=6A43DA08"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA82ymQLduoQ7kNvwHBtrwB&_nc_oc=Adof59p7EX4N7kLleWK44fsXVoLrsKBuMHShAmSsK0CgoMWZbxa1YV2NJDkL5S4vGws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90qejOxU8831eShfy6BrrC78BPkfBWBO1l4V5PvujMDw&oe=6A43CC8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogbxcMRWj-AQ7kNvwGfdrH4&_nc_oc=Ado0Fy0WfFz2kip1bTL67iSgI-XxCrO0vnmy75wgHuI1PGy8fuvceMt94OQdVWArbSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TMciVVv2gCAIPEBWXrIfiyAZc5PMOgLtMcPFQEUkp3w&oe=6A43BA5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1Oi1Zcnt_IQ7kNvwE9Worl&_nc_oc=AdpDsxEmtYroD_NUhMs7G3PYOTzygVhueRzNp4aftvey6bd_uboAkg4lkEB84ZW-abk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AL7OMQK2c_xazYBaPx_JPDqTR-pY-25dCQD2NMGVnAQ&oe=6A43CAD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_GJxU13AbsQ7kNvwFTvy7k&_nc_oc=AdrmWpveyXVeYdFzpjLmudGakr71eGnIfrjRMwj9OVi3WNKDKq3kK1FgcaRmAsApXB4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VbTduxkTUuky4I7gC54XVDG6hmK-A7Gw4-WAQZT7TJQ&oe=6A43BA7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
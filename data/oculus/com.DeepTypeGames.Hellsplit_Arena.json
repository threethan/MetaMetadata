name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffm8VoeJaJgQ7kNvwF8Kfvq&_nc_oc=AdmvAXMEBwvlX892Sz_wHgquGS65QXJ0ZqrwklFhsoIhGQkSWOMelJJprHvd2VDlBKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUDoFUmvAfSWQCXwpSLXXCozrvCQysNdt0vWVvBpjBJQ&oe=69B54362"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8y6c2iYE4UQ7kNvwEAVSs4&_nc_oc=AdlxsewApNWbEUQJpgnVIho9mUPBNfqn_Cx-CHfBIcf65L6byWvID49ALNjItiQ3gME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOgm8f3HaKVpTvgrGLAqU7ihkA9QCtIgZLSyAAn4xADA&oe=69B547E1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C19HVTG1fvIQ7kNvwFu4Ldr&_nc_oc=AdmNOi--bSuTfUhZ6f_0YVKiruOHnB1MI0XltF-dgPNvnp4v1Nq6HkdCT_nPtKCZEGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWRQX_YLi8hodNHN8tv5VN6ox1JIQndO5QJuT1XrXNdQ&oe=69B540A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K2E8KRuL-0Q7kNvwEC_7LZ&_nc_oc=AdnDNK4cJodxUzTPPMOPMYwUFGr4Y3Kt_-JzWV2EctZ-ABJ4ADOjlvXqf4A8SOEpRTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXcnx7zIUeJ_gYwgWDd6VDRb6JEnxObZp69mi7FQRvDQ&oe=69B54A87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYqvHxJj4wYQ7kNvwEyhnaD&_nc_oc=AdkRvgqJy5dGbq0OIwe6NvT67l5rmE5jCQNnAEnRf7p6_rfTUdMI0pIb4sQQMa6ZODs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjtkY7qKDsUaeOc0k0iz_qzjTJkXexEhrhCKwTAI46SQ&oe=69B569A3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
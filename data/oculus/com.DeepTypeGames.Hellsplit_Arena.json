i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKtJ-937pVAQ7kNvwFPQbop&_nc_oc=AdogxOrM6mFMqh9HqsUHgYeuh0Oh69Nzn1ZGtfNsO-fx8aGlThke5hR5XuAHmSeipW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v819SokoixCMIY7UGEdaSPEXovpAzq93gBUqNwnqjiw&oe=69EB8588"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-YmrslMSZoQ7kNvwGmx3ln&_nc_oc=AdrC9ztE4Qj9r26TDgflHzVhiE-P9zHmrQYItufeUV3qam3AJUZao6MjsnWHOoJWoRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ip-RSs3X-QW55qEd0V02ePNCm0saRDDF5ICCpV8nxqw&oe=69EB780F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mme1w0PhKWgQ7kNvwHCJSSn&_nc_oc=AdpnB7nAFqq4557UTx6k1MyEAkHsO-dW8wakh19fc6aHlwjA0Rw2IMLmFpS4SabgYbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fEQrXiCfQnruw9xQZ1cLuYlODvFi6A4CWxYuGIEBVIA&oe=69EB65DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdFTyjkqSp4Q7kNvwHCF5_w&_nc_oc=AdrXCQuSeAaA0KRqQFYRmIIsACBvGyt25iKI0KrU9_6WbgdE0TvLbOiA-s0R2Ayah4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02fpsX6v1qZju57FNoUS97yOBwxhJ-mCQQzYLD8BLBog&oe=69EB7658"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Ixyz3Ld_sQ7kNvwF9nm0h&_nc_oc=AdpjFmZXrEh27yKvLe_W7rPxY8q0YTRw6uxuAzGWet6bac6wzOloilD8o7ZKrV4iKcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qXpMGT5wXrMeomMpUEcX_ObgL31htaHzxG08-5aSvBg&oe=69EB65FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
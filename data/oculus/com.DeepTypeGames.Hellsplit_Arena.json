i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFsijPelfwAQ7kNvwEkBbGV&_nc_oc=AdqGQLd5empshaJDehWUWPx09_5MvAOxo85BgfOz30zLWITLqqsM-qSoSOUzrXDUtXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PnpoZPwUfEzcgs3fzi5ndpiOql0n1WP5o8md3BYZWSw&oe=6A3FE588"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNK8QumSF5QQ7kNvwEJDtuv&_nc_oc=AdokyCENx7k-Q_S3Hfs_oTFqYjTao_KNs9Gpq0KYui-Sulrq1YIfo0Dc6e2_bNcnVxk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EI2LwbFZ4RzVaMgQKolybD0wLxg4Obja1bdX8GNo-pg&oe=6A3FD80F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHdDLYeloxQQ7kNvwFrVA6n&_nc_oc=Adq4gtsm9X6-t9dH2zkeEuUlU4BmiZQLxDLT-w3cJTL33N19y-hsv06w-3tqSdjCQ2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4zS_7iV6L5krbN6SIEjmGbGpeCwf8nzBaXqWZb2KJBQ&oe=6A3FC5DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdGfqN40LFMQ7kNvwGvdVeC&_nc_oc=AdqOeqlbCHsf4b055g2WxOdFh0IrePL1NVsy74A1EsLtXeG17hMPpNOE-1MQqx98Nr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wFhKd-0XsJ9bMceHcPdJ0mFXGqAfrcs_INphcPqz2nQ&oe=6A3FD658"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E8lNPIViqYQ7kNvwHOkgvJ&_nc_oc=Adobju9t1zPFPEL_2v70WWmVN3saPdStoenLmsBfkkpxO9msSlGMmjfw3QAoq9f6RlY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lpZ5ucvnT0kMZRZ6VJ-SxVwnFI5lPCbZs1fGwZXojYw&oe=6A3FC5FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7RJzm0Vnp8Q7kNvwGTt9tv&_nc_oc=AdqRkJ7lwrLMckyPn09o-IVZgQfbaxkNgGfqpFBIUlFIDzG1TbpEVIh0is13ina4_FA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kQW8ucjn7ABCs3KD_2m5CyIdPJ9u81NgAUMVJ9Kd5zQ&oe=6A204188"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-MSZHxjIH0Q7kNvwEkSfTT&_nc_oc=AdojSln6RwKUXYK1hYZ2u4IKKOaW8Sfe62ekowaByqsjdvTtmNFlTq2t0sKSs8J9dqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KXv7j__h_EH5ASpP-Bf7va0O05l6w9DXNcuuV0vakUA&oe=6A20340F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iWw6bwruC4Q7kNvwEDTvba&_nc_oc=AdqGf1yi5-VLjU--zv5EAiadiAPbKuE6-kANMcfTNIuZYTTaRIjiryCL7YjAMXlNHXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wswc58PsV-Sx3bKTIM-tGO6aflNoX3-__xi6wi1YmOQ&oe=6A2021DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRiObacD6V4Q7kNvwE-bp1w&_nc_oc=AdqFABWg00RMQiBTro_zAZx1pEKbeSAUWOLk22AURwaYXD0DFXbeVUs5MHn2XRLOeZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_FT5GvbRBwmZ6vvxmIHS8y5HPW1DG9keNG8gVL2eYgg&oe=6A203258"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKYJ-XgoM20Q7kNvwHM92cJ&_nc_oc=AdqZiW3GG1nMkdLnUwkD-m4K9l2pV9Xdq1ji77mcLAgJy-KD93_VT0gWMe0KhOE-b3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T0dCKhaZOiOGv6vXKLtH8kzbS6ZmN9gWQgyEsTvrLyA&oe=6A2021FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
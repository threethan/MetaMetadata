2395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfERy-gaLHYQ7kNvwGSg_XF&_nc_oc=AdndydgSgXHF1oJwWJ65l1pqLyavxOKUC7gcQSK6FUgK1cOBh7F9fdkFXuifc42bRwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytsEak-bHzPeucMqT0d8R2eC8WqairdZBcwDrFKsjbpQ&oe=69B3EE48"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SO58B5eAvYkQ7kNvwEtYR3v&_nc_oc=AdkPHyfJoOmKtbxQ9gJFeFdl6VCJwoLo8J7O7lwbCaTGUJciCbbqu0BA6DjLrKH-KBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyNMv2oz9TDAYw9I3x7aUG1a1NmPNx_NZReglB5NLY8Jg&oe=69B4190F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GScFYD5wT9gQ7kNvwHm0d_D&_nc_oc=AdmgkzHfbxyyjC0VVvMyB6fmxqTOGrs0t4HQLLE66O6j4wlJKTjzGJXL_6gc-RHHevY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywL2v4DeOFExYBdQpuv51a8op2cuYoRbhxnVRbxNGxpw&oe=69B406DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEgXYqh1UWsQ7kNvwE6A3ip&_nc_oc=Adlfk2U3j2308drhDL-oPMnI__kudyAGI-usjsYC2gFKjYjDTzITsJCn1TH-FHDri3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_z1tHShS1XUdhU1M6NdxVawx9AXZ8yKPYg_-agYqagw&oe=69B41758"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7ZZL4g5b8IQ7kNvwF0FpIf&_nc_oc=Adm4vMMRf9CxWMouBYm3su4hx0FIwW78YLu_gnJ2GSZrlJhgSSmbrzekeSgrdropfng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJCdWiJQRNLs_dRzwuVKiY1EtR58g_2y8UmOqSto1gEw&oe=69B406FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308
luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p98SyQnuhKgQ7kNvwEc2eOn&_nc_oc=AdmNjS4CEl4Yi569z-ev2_iMPFBTp0-tuYQDIHEgo8_Kas7WlXZEvxuy9mRUo-7u5us&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDw1WLzHnn5dVAU_UbyEV5wxXi224mGJU_0QtrqBjDPQ&oe=699993E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l3bxLxUcQAQ7kNvwHoZDWH&_nc_oc=AdnaxW6roXfVhu3EQ7c0TwQg7GeW6V0Isdybb2VUxNKnOE9mLFLQjDye_VCpkncTY1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQ5k-Q4bOAYyXIg59RCu0Xltco7WZcENCxuuyfiHUsVg&oe=69999861"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnFSCaL5uaQQ7kNvwHnOL_e&_nc_oc=AdlMKgs0JcvoeT_-_JKjLHqL-VDoWEuyHXRnj3OaIkiNFXpPtlLEQB9np4IViN-XLoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuGlF-ndm-k-vX48l3Fa1dBupwJsZkHYQGHj8rP-hu_Zw&oe=69999120"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI1XC5i6hpoQ7kNvwHB8ADu&_nc_oc=Admw1RFO0RwxP_D8J8inu8sipPf73HzyBLjRWX0SWZ6LCvjq7Cp0AOdWiHXZ41dsqbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftM8N_pf6xKWKeHNo_12IKBq09xaVrNOq7StylFmmejtA&oe=69999B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOkqAIs7xl8Q7kNvwHLta4W&_nc_oc=AdlUJUEeIjO6UFD4sKLJXlMP8ZgtQbguX2X_aWovYo7xQxELd9EWzTEjHnEupoNR1Ck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIx54YNJzgfACKuuYQOmYxC1-c-6qZLS1Yw7sXt5w83g&oe=6999BA23"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
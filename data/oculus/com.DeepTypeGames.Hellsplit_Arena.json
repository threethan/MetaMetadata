i": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URTZugA5J94Q7kNvwEGO3CN&_nc_oc=AdpeZVAEnWCCTAU67cJrKyJenkyiVHyADLoSUgZ7qDHT2BWrwJhNDgN7o8-Jxx3lQKc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBFE5Z_IfJ7eTcVseMTK3qro9jAEV83htyS2fxVc6fgw&oe=69C511C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbZPKyOSswYQ7kNvwHOqCeH&_nc_oc=AdpNgWOxUUK_rwnI5FH84fBwKzYthKpB1dLUKYfsGylTseG50lYq4Gjaf4ttWRaQNn8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh_P8VU77tZC9kpRcu3E3n_EIjVJMXFg3l8hCHMdCkPQ&oe=69C53C8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ihKCMAQ7UEQ7kNvwE8hQQ0&_nc_oc=Adrs8WXXzleFTDih8pI6JNP7C1YHDextfiFXaB-ueF4M2U9Pqdnvu7KYQ7vtvwtf0iA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1_rN8DB0JzD80Z0bJwMBKj6Ae_d5v-Wu691yy5Nh8Vw&oe=69C52A5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HGNd-WUhxAQ7kNvwF9ezuq&_nc_oc=AdrHFDmoPKqUrIaNR8geG339bVg0jiWAAQKKGyhUc-AmsW2Eq764CgIo3eO67uKvfes&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUz6__hIEKh-rQn9itPbWNdB_Mh8JUvfvEZsmEifwDng&oe=69C53AD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfke2Up8OtwQ7kNvwHQTndM&_nc_oc=AdoNsrnSQYUjKNMQIBN5Fce8TQUgiYTiMxJiVqolGrxg_AYQ53RHw_Y-NuH8U4jHIxA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLK2iUUnEB_RPoEr4GSYycgAdsPEXOmPf1_dzzp72iog&oe=69C52A7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
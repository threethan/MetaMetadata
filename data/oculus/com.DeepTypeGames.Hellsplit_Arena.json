name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-4jy9czqi0Q7kNvwFd9HFx&_nc_oc=Admn_dEtAM_LzgkeHADkqHrr0NkgC4gsrAB9PpTWRSL0rXKki8fm6FCyBczSOgm6_oo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSr6IPbn0Cjy5Tzi9e7GTh9vFu_chVdsKOWHImqHzBFg&oe=69B937E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_rGHb1vF_sQ7kNvwEVD-qp&_nc_oc=AdnDKPPSKmEkonvuzjRZ9SjVhWCoRRRHD19tjbBv_ml44-oBae8dKgDMurs1G2x3c_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQmNTsEqBjPSs3ze0e5iUvHDF0xPE2h-2I2KFKpgmgXA&oe=69B93C61"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNU8LK-J7uUQ7kNvwFG1ixX&_nc_oc=AdlZQSWRIB7fdXphhbtmJYSSsSkO1u8l9SofIAGTgMTp7LhCYazAJHP14ViMxEK3P_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_YducG6bawu_uAwniyQ2qJ8FDRBq4TiVF54Vv-EaPVQ&oe=69B93520"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMjxrfHBVOUQ7kNvwELRzPv&_nc_oc=AdnMa_yzPB1psfqyzJXmPG5XzIwjQEVfjXoxu1OnM8gUySEMl9ANinI_s6SVH8xNPKo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxIhQvsUZj_k2h4ACRoI4qOo3pDx3_3WNgZDxPjbULb2g&oe=69B93F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2MDXEYYGSQQ7kNvwHMwatm&_nc_oc=Adk9RhTCikLJVjhtwkfb-je4xgNkricpR26Cpz2BSPQrUMJo62XbCOlLMB2hxtMBR30&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxr1K7l_cZ0jxxVtOeYVf2rv3_JrisKAeaXLt-Mm-zPdg&oe=69B95E23"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
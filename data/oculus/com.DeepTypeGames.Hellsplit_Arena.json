name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-4jy9czqi0Q7kNvwHEW-VF&_nc_oc=AdlHFZDAd6_4xxvvkrcVhdv2OkOxylnJHKwl2F93Uo6njvk_PVfC0eeOoPmU6zD5h_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGDEI5IZXNY083AJ9wQx5p_EvKsHI7dPoJZ7H5NtbDmg&oe=69BBDAE2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_rGHb1vF_sQ7kNvwGn1uq4&_nc_oc=AdloLWSaiRLJVugaMZqboRRL37rrEW8GJQMuTi1LZAh7SU_0cGNITScLgwl17znZV8Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmDagSR78wWimq85V6EhZTp5K5peSaQ1B2Bs6XqiIzbQ&oe=69BBDF61"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_wbNKEPc3AQ7kNvwHdsRQb&_nc_oc=Adnli4SXe_Gn2cBioz6Du9LWhV1p32TP9tGMUifIUGjcy_0wyCbzfQX3kHAKxFcQMMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDz1o_mrQCGbPUulJnk65h7MCLQ94dArG1oKOwUpP48g&oe=69BC1060"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WcdLOHDwEwQ7kNvwEGMVBG&_nc_oc=Adk9V-I5BADDtfVsAufLD6M9x8RR8rOuxa6G5bp4jSKH9kRe1YEVDtvVo4RMsLqq9pw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw7yOG_yqdYPs9Kgf52c0x0MmegdhKB5vlBovKV1lr7lQ&oe=69BBE207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNa7swMePAwQ7kNvwF5opNA&_nc_oc=AdmmoITahuO6mRJkx-DaHiYBljsfaciOesu6ac63tFYpjHEAQgoUsOsB8gX4D5Bm3tM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5o1eAqovIrJQAWdFPGSWc_rxXUyddIndwq71rC3lF7Q&oe=69BC0123"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
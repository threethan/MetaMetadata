i": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUX9JBP1flwQ7kNvwEA6O5f&_nc_oc=Adp7tZhKVBmJhnRfmCRv5hqnAysnpa9BBewIfri2TYBkNH77z2yJ9mA27wOqKVlhVEY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3C5JPGvv0i6pPJO1Ccdz_GM3x51xoAc7uXRcGhAdRjhg&oe=69D786C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Exx_J4ZRTkQ7kNvwHtZ5tB&_nc_oc=AdqEwxEJSrdlhLJ4gAe-1Y8WV9QiMR8rdEpZcsbY5hkveFWzJapuCeCcj4LKTHKV-ns&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NwJGfwMWywSi3gG9aVT0ocpx9h_zwmf7QEAVUCFjdIg&oe=69D7B18F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6ykMJ-10-YQ7kNvwGmWWag&_nc_oc=AdrgeAzVr9UiG9mEmsLxN0csc-10SqSSpVDcSrBkdjzcQ-fB18sjvBVt2NH5wX8qbhA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tP3vnI5DsJERMwEHtkI4sIuq2-AB4Dii_Pc9VrKjtzQ&oe=69D79F5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj2bJ3hpqugQ7kNvwFWhNWd&_nc_oc=Adqd-ieXh2keHyUkPAwlZThnFPb4cuR2kwbZymTQfMMbqQTkkyjtKmazDW_xAaQTPmE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pseIr837ohQGf_aeebcJiuqwQXxa0NSPERagh-V1q5g&oe=69D7AFD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAX9MqDG-acQ7kNvwH2Rj1u&_nc_oc=AdqfRXOqgX9JrQWxy7LamTTw_4ZrNZ-UeSpGScK4n2eGP3tT1FWrOQk7C9OSyXZ15fM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b5kWydMZc44By2LXA8Sw_SA8RueDyeAU0d2_fJ8ygng&oe=69D79F7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
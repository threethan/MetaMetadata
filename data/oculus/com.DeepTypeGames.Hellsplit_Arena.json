i": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftIigVcBYmIQ7kNvwGrIHNv&_nc_oc=Adp6inDyckq6sMR1SYVG3jtx8SDsKW_puUX-29Bp_3JwM8DsE_LGqAXK3L3OzQ7jGLg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I-qkJ2ivx-pjHHj6yUZJzcBKljpLzJyWvAVwkzCJ7Iw&oe=6A26D908"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0j_K52ZcW4wQ7kNvwGmbWr4&_nc_oc=AdqNhFE69IE7qRfyQyvqu2Zbwsv5vYhbP7ckkwgwvDlSd-TP6zJjlml6YIBefU3dnAo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n3qNUp_3-vMXvEd7kBBbiF16rCyLPAgdcYnEvhCYobg&oe=6A26CB8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDSwRuY9sisQ7kNvwGwWeMF&_nc_oc=AdoCBaf8GGtVmA4wTDKaViKSTvYa7Zb8XDbI4Xl-zFJcXWlmSxVZ4JSXYyARPrbFXh4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91nYptA9aST09TubFVz88VHSPiQHMr6qwdVzhmD1GeoQ&oe=6A26B95B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=643QRUCAltAQ7kNvwGZNqO5&_nc_oc=AdqXFHn6FADnCQABbCoau4UmHUg_v823q-FabojPbpmGTdv90QSEZ9diegMjSWDRA4Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EjnUCP6NIHwRKTFVIrj5VbsZcr1EwbrCFAOep4P5xRA&oe=6A26C9D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4hWNGS8ZuEQ7kNvwH71Yn7&_nc_oc=AdoPK1UFdY8ENCMtGQIjYwsEBHY3mEEibsF5kvlmPfcIhJo7XDIkfk0S8_MuNcN6Brw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d8N4V8oT4hC4-uNKh4wXA5bjob0idGa7B7udVlTdIJg&oe=6A26B97E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
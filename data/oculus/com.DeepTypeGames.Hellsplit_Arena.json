name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VZkZmeYOVEQ7kNvwFIgjmr&_nc_oc=AdkY-Pu72KSNoeEC5kYtUdaEKuWgUxWdWD4MQA2p4aPutyFIzOI3XGUZ3XqPfYbFFuU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwstw72ojDJO1RotEOw3iOd7BknDA_mQzhnYKQkRig2Wg&oe=69AEABE2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFajx-put50Q7kNvwFyEb_I&_nc_oc=Adl7wE3es0Vbaqr7-a65S5QaYohxOYWKrQTSoawvBmBcT4RGt8sRhrTQYWvKNwangSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNC2yPqFWxPXbNkEkAXzuJaozNYzlcgx1ckwcy3HuzbA&oe=69AEB061"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5s0N9MTD0oUQ7kNvwGh4hjo&_nc_oc=Adm800BERdsvBKL9uneyXve1NTLME97-m7zWQu2DHso_8ft64GT0HpHP6fmy80iML3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxoj51nkvTODtbBwesJs4uuIMMt6YT6pVncdCokHVtANw&oe=69AEA920"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KafSznNaf_MQ7kNvwGXpQ1I&_nc_oc=Adllwbch4wOcSpMPy3dzV4d0jsELtDjRTTZqDcy_MBqlthwpv_y75w3kP7qPbVxh8o8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAt8QiGCoRct7cxDvNWmgI8mD-mSXvILJstkTFkwQuFg&oe=69AEB307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzOU434oLhsQ7kNvwHOX4UQ&_nc_oc=Adkr_pwq1qgCSvDOA8VFMagssU-83mq-1mHg9amjR-HwOs2MgmaxF-IhbHAtyZykkj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwW1tEx1fQp4xa5BF5K2G-GcNKdz_BtzXGd8Ja7vc6zEA&oe=69AED223"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
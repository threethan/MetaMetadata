name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO6V0z_6jTkQ7kNvwGuF-nX&_nc_oc=AdkkeDFQl4RbyldZaSzrOS1FH9Nhcu4CVIbexIxHEKlkdSBpQDZ-zDFMHPUsjhrBHpI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5hreGGS6JMYKNYBc5JpTKu_NkIvxcAZum3qopBfL7Lg&oe=69AC08E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro_H6riOdYIQ7kNvwHib9Cf&_nc_oc=AdlPyLuf-vthmJ2cKdqcu71GDHLYukXdyrh6UvPLTXipA0UZ0D8sIkfGp_bvdLX8lVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzbx-uHcCIBpym4om7JTJ-WwQQ4dumCpcvyBr49yR5-og&oe=69AC0D61"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsNCCJ6BGmgQ7kNvwGHpLU9&_nc_oc=Adlyy9BhFuw4y5Yaqykq-XUByiyy_ZBiWevQD97h4rAdM5-api_RjO8HVSYzD52FoiE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6bFj7W_CsI5giEjekSPpd7R_Qa5OYYwSPc-vbmKoZOQ&oe=69AC0620"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLzx6eViUSgQ7kNvwFuMNSd&_nc_oc=Adnq_zE7OPqMYrfUQUhSs2lQMMrBImvMUWMXZow-LVelu7-7-YM3RjIHTLw5nfGFNJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6CGCcNwlqZphwJIMZlK4bbiKJoC9Y6NG9ZQJn42kB_A&oe=69AC1007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzOU434oLhsQ7kNvwGGq4Xz&_nc_oc=AdkEcWxrGWBnS7n7u09tIFwio1Jr1zQMAUXfBMsMSoPiVEPkc9yoZOvADMi1qOS_2rw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzNSGu8PGqyA8jnDg9HASKN7r6ohP9xkYEIuyPqqHetfg&oe=69AC2F23"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
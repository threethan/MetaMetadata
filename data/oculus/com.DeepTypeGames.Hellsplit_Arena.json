i": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MncrgDXghIQ7kNvwFAUJlV&_nc_oc=AdoB-pTvmohx93DwQ_Fg7kp6OsUCAkKzyCJ3JtIXjndsvetamVqi4lzXmPBMjejYa18&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Y9f6CuDU9vRKVZY2RcXz0UvFCuQUMNQsioFugEkb_6w&oe=69F4C008"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5KKoZoUN0AQ7kNvwFDXoAI&_nc_oc=AdrQv663m8AHmtiTYs0ZObXA8VKYUeFrru0xVT9FWUbOqlwOFatEDjijeCzQDap6h9w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3H8rkPN6Flf4QpvQISbCrWSYro6NHFEqvMnMv9wwr6_g&oe=69F4B28F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sT4hlh0yXsQ7kNvwEBF7U7&_nc_oc=AdockqTyMYLPEZ61KXe8Eq7Ie_61u56_ACBZhNe05QFx3c8vSbI_A9yZC0ARFQbZJTI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XJbbKYIsyoOgEG0whjVbdQUEQYd9XsiTo2CM63QAdaA&oe=69F4A05B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMZVmI9sQJ0Q7kNvwHKkAkV&_nc_oc=AdqXcET8OCUYYVH13Plesrt970b4RgahE7FOYH0nvIPEtNah39BY8hmw9ExN_vmm2aI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UsB16-IoYbEYlVJ4CQ3cuKINaxYZcJQ-awN3u0DIoRQ&oe=69F4B0D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl4F1oUmaWsQ7kNvwHmACSu&_nc_oc=Adpo4gKMf-FOuQ93rEkiFmgLcwhFZIWcaceT4_jLdJ83bTU9MYni5KV78z8X4RqnxQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15DhW30X0IsHjJQJQNaUTL7y2Hl4owkBQAEyotcW56LA&oe=69F4A07E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
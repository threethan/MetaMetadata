=00_Afv4okqSWdjD_MuxC4FLjHPKpE3V_kTazvMNcfu6XqqQ9w&oe=699D84C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89EMx8JLDNYQ7kNvwH0Psqq&_nc_oc=AdkAMtG5E8ls6VqfQe-kFL8L4XL1ze9NKRnmFr2okNtVCPIKrttOo-_ktVdc4QwsZ7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFj8Wg-QjL-WSXMNvF_1JvjWdNVLYXrDEOfAZ2s72OZA&oe=699DAF8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wixTNFOUrQQ7kNvwG22-gz&_nc_oc=AdlxkcfYrKgMPziErOakGl_8WC1z7R5CpR6IcfQeMpa-1dPzyDEvYJkaG7ovJOnIRdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftljPfGP0nuiQ4oBXLO0_bqOUTaW5jYyAIypdh0A3zs6Q&oe=699D9D5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8jfQjPWB5UQ7kNvwHOL7Dc&_nc_oc=AdnJeonzj9NVJ2e4ExUSUuwAtKHqZf2ztmUuaSNO1i5Md0HWNXgHBpe3Rh84zn5pVfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsC61CHrrbkfpDeFXcPPJH4TeJvM3yXTg1hunkwMdNgoQ&oe=699DADD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNRqdxvlPN0Q7kNvwHcetoq&_nc_oc=AdkxkzkgR1-oHi_NuPhA_Q5gJ1dgpP4m7vYnwveTBTSVDKqWtYhqc3Q_fA7jx_640kQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDyWKkLVHR9b-Ijo94Rm_oYkoC-5swXiF5MIu6IfsmNw&oe=699D9D7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
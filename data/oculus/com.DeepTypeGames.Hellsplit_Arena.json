i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-B7ezsHBbkQ7kNvwH81Xz9&_nc_oc=Adq4Ro7NYzhGnZ7-nU0WIPeyqQ8xUnFwxvuPqv5PEhHxtPLA-7ARpFonV7rjsHpGQfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XP0abRdzG-0e5ZwbefWwztXSXlmoI5M4EIyn5uJ8vEQ&oe=69E0F988"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOayZ_owF98Q7kNvwFLS4KD&_nc_oc=AdoS_LXNtmVlYkFuvPb538tqeQB_vq9eY1fKGVsgCJF4h8eG4Q18RfgJiGCPSTcbSUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WEJBgD0UmEmu6bWQU2llph9giu2EKwMHQX3lGUXoEig&oe=69E0EC0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBx_M-nNRCMQ7kNvwFw79Gl&_nc_oc=Adpc9HE0B30WA5pswoGJVgNM2dgeS9cY44r34k5RLe9N8qrknQVRvvHBY_bK5xek9SU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WY2aom8UoPq6I2btyyMbHs9Ovg9sCLgc4fsLX68WMyg&oe=69E0D9DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THfKib4tHVMQ7kNvwEwfVe8&_nc_oc=AdqR-Hvr0LMpqy5BXM9eoC-VZG9j54yotY_Y6nVCU7gfZMIDnOVClUJlkb3Eqd2PwHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wxxag4vTypQ4UD7e_Q9yjYi0Sw2d_XCuX9rww8NO7hg&oe=69E0EA58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxuNI4s1c50Q7kNvwFwmK_K&_nc_oc=AdoxnDG9HQeORU_u0YabGoEQlHuhCkWYW5esUg4CEFo889eatGhPDsmYvsz6dazP_Ig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a779j147VqpI7aDKqOvroMSOE9yAzzjr7JoETnsReFg&oe=69E0D9FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymo8A4EdrrcQ7kNvwHSEY92&_nc_oc=AdrzPz7tRfAsX0AA3AvieDtiw5VfDVyt8Z2EObQpdQjBrt5KOo1N34wwjYWDXu5-U-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7arYfXJ4HHGtR6xc8DvUFVibd-8ip9mEXvx_2Dm-WQA&oe=6A4D1488"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYjhceiSw7UQ7kNvwH-75tq&_nc_oc=AdpLR4UTzg-6od4BzkASFG3iRWZivpvdHc2Xg_9OzbZWdDDz77T6-0vyLma1qWId6C4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4iw7t17crgCJGuiqx9lkbNjuwH6rCnL7-LXlL38ynMA&oe=6A4D070F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt-ChWCM_nwQ7kNvwFZup15&_nc_oc=Adr-HDvp4h0ofG3f3KrIVwBU1dsx2ARC1-rbtMAFStky-TdPmgb7ak3J8Qg4cLimJFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGuwZ5hiR0ZUgtlIiuTwd13hvJQWyUzOj5ilZ4XS-H3g&oe=6A4CF4DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJHaKebBeNkQ7kNvwEhbhqW&_nc_oc=Adqps3WjkbH9PKAjhzoDTD_Qrqdq9SgIbYBVI-ZFBbCNNkXN5GhJ0g2oXFIv57xQrOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQQlqN4fKJWTxt5j0dz5cVjilymJ5yWYl7I_fL_KMMPg&oe=6A4D0558"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htiyMbC2tNAQ7kNvwEXeaPG&_nc_oc=Adod7-nFhdEslUXZpsFIARReTWwZbA78jsbBW8rOxm7TTsCiBMajyuhRr8KZv2xvC94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATJ7SeZwVyfYsEBlZUpSnY5QuZH4RzvMjvnW4lc8IYwQ&oe=6A4CF4FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
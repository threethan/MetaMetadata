name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRp7KZm1slMQ7kNvwFAmD5g&_nc_oc=AdmQhxp0TFvTp5RNyPAW1PzjkAMgppOiMo1XcIiYSQNVhLHkeHyLkjFRPGxBLWuZuUY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWE3a7Us5rgd_6ya6EKKqGNeBoqPzRzt3xWeBpy0UBKA&oe=69B3F1E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpoY6NpmuIEQ7kNvwEP26TF&_nc_oc=AdmUJw_JcFfMZdpkoFfknOoxWqS7OLLaOh49EFKNXpYAFzsaTKQdv3gynMWWAdTz4ew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyKVstPSvuT0s2FMEpz_Q-QhV8Voltt-cRPy8CpqTnsRQ&oe=69B3F661"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C19HVTG1fvIQ7kNvwELF6a4&_nc_oc=AdmiitxVHLbPVvXWKTBRAU6QEsFGOnfNaDw9IoY-Hr9syOpjQk_J7dO0z_Py61XATSI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyp5Y-HxYocqnKBaOBZxK0ud-oySbsmYW3xp9rLiihqjQ&oe=69B3EF20"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K2E8KRuL-0Q7kNvwHsnqoe&_nc_oc=Adk3NVhVVqdGAYmW3J0kwCSmxBmx3C-rd1ohjiLR5yeK9_sA9Z8vKoZPwIapBDpOueM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwsMynW-kht3DcPzInhzt6T8RMm0I9k-VnPz3jkHOSLKg&oe=69B3F907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYqvHxJj4wYQ7kNvwEOz2WK&_nc_oc=AdlEQs39eTWAMU6m-_qoqctetyKnF_R0f5fkg7fIJ68Y8dJ-LJTeMlvkQfz2fOupjo4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwID-1z7Y2-spjthD_6YxKpCaf9lD1eGV3_BL-EeiNd-g&oe=69B41823"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
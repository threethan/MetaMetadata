name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO6V0z_6jTkQ7kNvwEQNkZ2&_nc_oc=AdnFTwVj-MZqvLy07gFLJu1dEcE56tX0ncUwtFqtJKCCyzP1WJ1j5lRY-PVjGl6TWvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftajA9E4YJZ0R6FT2VJ3eB_J4q8lDQNqiTjWfDXwW4t3A&oe=69A965E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro_H6riOdYIQ7kNvwEc6KGZ&_nc_oc=Adk7RyL47QBs2X48nBc2ab26cfvN6ak5sxU210r1WNdJDsyq9m8m7-xbF59Rz1gskio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfteX9hOYf0HqlbFR5RPtAqa775NnHw8iYjpsIlH26tLBA&oe=69A96A61"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YVBO9ZbGNwQ7kNvwHeR_sk&_nc_oc=AdllapD_nsqMZJun8PT-wQPO757lioPVKiGXPkcE_wTJ10xVyYrR_b04Ylztiuycx3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfssXBc3KIR3hJkrWh5kVM3MHBHaItFYAMilSbmgrursBQ&oe=69A96320"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWBz52BEA1gQ7kNvwHoqy5e&_nc_oc=AdkHIjbjx3lMBSDxUP2eC9xzIvsoP8ee0LWkO5coIL2A1HZojAHFdyZjaRe5kdMypHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft1XFntA1fpCiA7CXLbQj6aZHVWTjVlIcPvN_Eo3p5nAQ&oe=69A96D07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxGypSFOg0wQ7kNvwF7cTam&_nc_oc=AdlWNiRRq1cUteH1EocYnF1s8_mWkXfcLhaWZnk_E1Ozo5Zh_XIVRKIgsH0nHoIn9qk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvqtkqYOpHa_5WWb3SAaWz67ndE2vfgHRIOcmyRxO3QJw&oe=69A98C23"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
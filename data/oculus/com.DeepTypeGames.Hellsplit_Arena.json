name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VZkZmeYOVEQ7kNvwH-P7bQ&_nc_oc=AdlBdvwy0tKjXQr6dzhjgKSYs1mQt-3-H3PVabzyIw2qJvpb13eeGd1w1fMmPKeEZnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrThY2ZiMoP-CJt4YkYfzJLJTUOra9JgrP_m1w9z6E3g&oe=69AFFD62"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFajx-put50Q7kNvwFC1XH6&_nc_oc=Adm9TrKKWIO25iFWDwP-iL0o2j-3oZKCDcsWBJmuvVlh0hUT-lUatqaaza2aavf1kDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyU-ec4zWBZR7Gdv0LpoXirspudhj0jT02y06yF7oJzTQ&oe=69B001E1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5s0N9MTD0oUQ7kNvwHNy1j_&_nc_oc=AdmvqYaulvKm_ivA6u5mIgLavOoSwUlKkpNCXcKfIHGourFUz9y2obcfXioWnETKlIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbliOoIDup-dk2JbL5AeN7S0RG84xdCEpn_kJNyvslcQ&oe=69AFFAA0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KafSznNaf_MQ7kNvwHbNdy_&_nc_oc=AdkCIrQG7uUmbnFO65ocHOM9bdRTZW3iBIj1rX4SDlRKlQGJqEMFW2RxkK1FDZWicKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpwjxRYd0yG5PX4hCDOZThJ4kRIBdkFI9jcIPFMiH7hw&oe=69B00487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-qlfJStNpkQ7kNvwE9U7Px&_nc_oc=AdnWzRAal_O-GWBeFpsJGMM-zZdPo3HZD7wuafFPTQrGPgJFou5bvqh1B-fbcJwU67g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzD1HUGHUpjCbSLtq4l3pwRZEMSbRnvAbwGEM6D9uwyw&oe=69B023A3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
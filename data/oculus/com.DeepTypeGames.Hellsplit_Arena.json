i": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DUel7_EiIMQ7kNvwGJIKXY&_nc_oc=AdovGLoPyV6-lHAHteO40g1p5aVByR-4dHjxe762JMM6Ptdr0WBZnMafP5mcTnig-mk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TW3vvrBZuvQGMnbbNp4N2UavqR7I2ZFHcRDF-Q7qFuw&oe=6A170708"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnADBQwX9_cQ7kNvwH2qJV4&_nc_oc=AdpjGhc4kAIT9RhyocZNagi6Q7nMOyUpVNzqxbHQjR1kj5xIb6M0qWM9ejOaBzpy9TQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57V503URRfmaTKQgwSQR8KZuJipxJUete2rRnjqmVa0g&oe=6A16F98F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5UovmHAvekQ7kNvwHChAFh&_nc_oc=AdrzF2wwXuyi5qNzTtTa1bPxwcTHh9rCeaW-rS9yZmEaDjJ6Alelptp-sz_FszEoF5s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fM3EXzZ9VYpTReSZOVU0ANOZCkXvais2l7VNYlIudgg&oe=6A16E75B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWZ27ivW7W8Q7kNvwEEWvVi&_nc_oc=Adr4J4e4yOF8otz2H3gseuUjyfAX65497nwu5maPuHr1zXT5OEUa6Frnr_J3Ohhm2u8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YB165xT7VsgZomJkTNdrPNdwWmyRvVYGMv_oey-_vSA&oe=6A16F7D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ml0ejHXhQkQ7kNvwE5KX02&_nc_oc=Ado-aV_JX76Hc04yYAhvoHtc649HnDu-quHoL0jI_hUncJM1D5GnAlIUeV4WumchQzQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-D51voXmfYCTw8XL165WaOwBbhl98l6EDovgka5gX_g&oe=6A16E77E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
i": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzGorBbcLzAQ7kNvwFOAdzF&_nc_oc=AdpfpioojggLW-IwZkwNegAlZllZAygvdp8CeNcgysyxYm2VPF-GAf9OkG15lAsgSiY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zpD0Ofpm2Cr83zr0ok-IvmH4hdL-8dVyCkCvNcpP4DA&oe=6A2C1F08"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT85eG-ZENoQ7kNvwHdmrhf&_nc_oc=Adpnda03JnDwEchejULuLzP2Kwf3HeeGex-C04U8Ik5LoetxY4eDNk13n6Vq66mllFA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CEgawwGBqj039B_ZO-jSEOTf4qO0k_sOQe0meTrClSw&oe=6A2C118F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDjHFjmWDCkQ7kNvwHQUNNn&_nc_oc=AdrDSJ5ZgKHKxzebGo51WMNJASjl8QFXqDpdzshCyDMJ6uZQg7JnoWe9w603CrEp6MM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98GxyXJliKl0_mCCIV3hFBRtBgDiC_ngZ8fv0-nCzIlg&oe=6A2BFF5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZujIh3r6BOEQ7kNvwEkSauy&_nc_oc=Adrvsz3_HioE5JaqNXqNh5H6xLeAZux7KC3eHdlSlFsHN0O5GU4yRPLIvUVPXlR8B9A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CgUTMk71bbtmW3JtXhy2pzAoIvPhOvLhJwavsm3TKdw&oe=6A2C0FD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2qTn8vCbLgQ7kNvwHLQtU5&_nc_oc=AdphHKbtjRxDMGTAeCUM2qV3rFL5lzVm5fXTPgkCTyiWTkug5Mi4C3W8DnneuB7jjCE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EJPUJi9VVUdavwCSeDK7eQ1eJmcslk5zSQvpk5Y83YQ&oe=6A2BFF7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibVN0GhSFc0Q7kNvwGKIqip&_nc_oc=Adk-oF_51Zakg9zkTZryvbSRbdHAER9VC4Emg6oxGuaItER05CfiRQXEhSraj07Eyns&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft97XGuPmBmaTWd2QvWEKMVJRAQgfzoDXiTI1F3dq-yrQ&oe=69A57162"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9QIpGiGj4cQ7kNvwH1VFku&_nc_oc=Adk-W132ASMaDjG-UO-oxpSwIsejFB47kf8JTsJaLwbsemeicexGLkjgKb5FxOM34K0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftoCc7PO9a-NODMsTCT63Ik5PmG1aDZVlfPWTXOBu9urw&oe=69A575E1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxWB31ngrNUQ7kNvwEJ47vZ&_nc_oc=AdkNRkE15z7QdFOXQZN1HaFCEY7TV1XrtNx93heQxqXEbqxVQ2kYR_76skMwXEMXFhA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsfklD76z82_VAAWJCTV3iqw00BkqbWcyKkg9v0iqmbfA&oe=69A56EA0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=341sbCUnY8sQ7kNvwFcjDcg&_nc_oc=Adnw5OLDSKEo6Wo1NhSPfI9pSnKBmCW3ha0lwlmZm43Bm4_PILBNXfYwlCddR88ma3I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvL8cbhkMwjCqd9IHtSAV8wIBtshPI8qcQ-lpqC-w_99Q&oe=69A57887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-1bnZnkUKsQ7kNvwGLSK13&_nc_oc=Adl-37KB2uwiPUanZQRAdTaoIre--pXhuCV5EVetQmpNjaHqp8t9YC9_X7Y4-miAN3M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftP1lwjTljTDsS3xwztNbo1seV1gvvMkbtv5epXP_52Iw&oe=69A597A3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
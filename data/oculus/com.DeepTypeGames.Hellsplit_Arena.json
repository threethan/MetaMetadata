luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uZBU80JXCoQ7kNvwHxQ9mf&_nc_oc=Adkss9Nvwc-tOeZP29_o5W7Rsb66XlPIu2KT9GBOwdgijdjfI46dpu1N0k_HL6VTxhI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsRizSX6bqLSaTcM5M9wWM17esSBgxR1pbi4czgtCNnvw&oe=69A41FE2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_U67-98EfwQ7kNvwGjeB6F&_nc_oc=AdkqVWEVN9ibXCCxjXRJKAnAT61l5kPCFheJMbKx-K9MoWiqbONqoe5RVnTSjIIQ8dY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftEvxQnmq-tArhp9K1NhTLjCT_Q-D4hCcpLrkZxldHjTA&oe=69A42461"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxWB31ngrNUQ7kNvwGmblMi&_nc_oc=AdkiRUfykBgGViF7hljTXSoRXa5bzb8SMCjZV99Go1loSpWaX2tbi-wVYqBL_ISrj7E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmDz1R5AOV0rfX31rppVDPPFCLPPtsdP4TfN1YIdycyQ&oe=69A41D20"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=341sbCUnY8sQ7kNvwH1pupB&_nc_oc=AdmARi7NasVz9MURO1VoouIo5AmfuCGoHVQLq7jvycHJHoWUdGfe88zbxM36HigGR2k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuM3QSqmU6E-61XXLzfYgHhZOrTgVUgld22cinlAJ-aOQ&oe=69A42707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-1bnZnkUKsQ7kNvwEgM75p&_nc_oc=AdkpqUE4Qh9ekitufYvb0jSjYQW2Mbpoij3N5CpEY6kAN5-CyYz65-kB03Qn30AuJRs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsO9XPDvQiuROrTRJdDoT6oXwVBtT3d5Z4HXcFtjt4jcA&oe=69A44623"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkPFiteHYQoQ7kNvwHuz0XW&_nc_oc=Ado9QHldt31obyKxhV46guKbVSuTck8Xn8xmCOjnxv-daV99KxnQt-xf-u7ja286Vew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dkiuqKPi_rO3dBAVns64IYrZeL_sarpTVSr0dNn1WwA&oe=6A316508"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rZSWgZPAIsQ7kNvwHhQqgd&_nc_oc=AdoiHi8W0sVaxxRqX37E-1YtaflKZx33v8Ms9u01OXGJ6-dGW_xy7WgUDCaNPelw0AA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pk-z93Nu6PbSNLJZAWOHplMfkd9rGCbJ4j4q1djhX6Q&oe=6A31578F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smtafPBLCc4Q7kNvwHTQj4M&_nc_oc=Adp-HZQ5aFSSofHWUigyAqbS7zOHugbNflW1xqeBxiEbRW9nCuEtCBQC_1AluvOR-bg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3zvnJWjzEXCInDOtCF5Ef5rmXQJmZYdCO0xOJXcvf5A&oe=6A31455B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEpuP2ZnT-IQ7kNvwHqv66a&_nc_oc=AdrFKmC7E9Fti_5J60KJdlin_zquUTB-YMF3Aba3cRkOS7gNAD6erw-v7voGO1KTgUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OVGSoTMZe0mzC2s63ZRyOa5PhDdB46Bu3luwDYtrkGg&oe=6A3155D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE-S_RrJK_oQ7kNvwFWmNWM&_nc_oc=AdpZ9Vr30fYX4YVJGWO0iyDmqSCdDmHGoe3jsBspuQKYVAC3gisiIWaPswxE3eKAr-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_XnWYGgo0Odc6Fi06-Qfd8Pw3V9gNLpdBoXEshqNgRg&oe=6A31457E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
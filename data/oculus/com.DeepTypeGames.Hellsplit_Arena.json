i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyffLgfaC4wQ7kNvwGQG5e4&_nc_oc=AdrQPobGgQ68b6guAgyFXQEltF7rwzMo7bUj1v5dJZISsEI_Yo_adieTqZ_OwxnnAs8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0__Gdto1FwII-Vcrhm2YRqBRRYOw8rtpo0YEYeWc8Jg&oe=69D0EF48"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQDzqsJaGO0Q7kNvwE-TdTh&_nc_oc=AdoGKNxDjSyX47wiXhBQbZtoixOkovGZ3jEf2OwULiVpObtjgud1MXd481mwKX52EiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afww3uWxy60Un4FKGhwX_FXkgpJqo6BpjeDmhFdcveBEKw&oe=69D11A0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK7SvQNioKkQ7kNvwHzjxP5&_nc_oc=AdrVOrUX_KLQyz9SGCb0en16ye9UKpUBEqJqycFmR-J-G8m1KEYRkr-u8Mxj6Gf7how&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTFXFxAKSDeCZmJnppIlDfzZtFkizL3LxVDPZWM326Sw&oe=69D107DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtVt4SE30s8Q7kNvwH2L7MZ&_nc_oc=AdrirfrXe_Q4bPI1G0hfP_P2GRy3Zec-Xa9hs1IHNiBNkBqneH5WI5yUNfkoUBCBZaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygWqeHcqsHzoZraKoXtDsqqiOZEW7ZcKgIAtQUXtJy5Q&oe=69D11858"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiXR27jZIB8Q7kNvwFMpITX&_nc_oc=AdovomsDUAl4msOsoKK4ia8yXL7e3wrgFPgMmEr4X-pUtZIeqHe4GUgOtv7WNmBHhJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx02eHJ_cf14TPd6LXH05YAdAwtjquWl2ZM-tN6z94pSg&oe=69D107FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
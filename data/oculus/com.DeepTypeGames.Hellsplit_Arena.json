i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGzNoJKcDgkQ7kNvwHQDPh5&_nc_oc=AdozFLiLEqdW2tYSOQkgH52h78Zav4WUw3_S1xubiPyovOuUyqEYLSBVktGv2iQ1cxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YIf_1S6Znd5hgAWvC-8mZKvdwl1nfFh6nU1oXMJIxkw&oe=69DA29C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM19S6rcE8cQ7kNvwELAgK4&_nc_oc=Adpnb7q9meilHdN5eFiUq77ZU9poUvsOgsAHia6wN1Bp2IPthJpNJ5wJptDkZ6sX-eo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fDiNVABiflksDQfmG0iPmBZNobxh26LVJfJ3_nUtJ3w&oe=69DA548F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6ykMJ-10-YQ7kNvwFBePI_&_nc_oc=Adrj6TOwyEcH7iKRcHhnNNclwz-3BuvKlHjkrSXOGDDMSgskwvJCBLf8YAIRLEW_cg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2q4zKnqQbeHYtxjobJt4fU7yJXkaT03TldsCnnYLaE6A&oe=69DA425B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj2bJ3hpqugQ7kNvwFykyZi&_nc_oc=AdqGPXksitt_-gjpgFFKcmdI85K8UJvxwsuuHH4C6FbnFNILd8qrOnJGtzmWDm6kyVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CWKLEgmgBK3i_EGuR0V4UuyFx_CWkW6ykXxsvrEcEMw&oe=69DA52D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG_efOFGwmMQ7kNvwFHAKMg&_nc_oc=AdrmMXzZ04DW4kSLZ9K7Fh4C5IVKqGOQpa_5bWggrgNIp3yZyzn5CBK8ABmVoP3HYo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fOcdkkKLLGG_03UqMXooIhV324S-kFVRQz7DJPYpaxw&oe=69DA427E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
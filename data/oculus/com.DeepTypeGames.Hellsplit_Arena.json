i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT359jEJTDoQ7kNvwFaf5MV&_nc_oc=AdpRhFb0uwjVb26-Ia59psYnNdaTl9Bp-TbILgr8LrIJb0dg61_YQ0_bhLDoRuB7AVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mC1M0F6GJK82XF-1ZNNjkAyefCidnLZpaTbF5oYDVTw&oe=69FCA908"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hw_L67njKowQ7kNvwFT-EKV&_nc_oc=Adq8YXMv6kj8yVvSpsHlHJCXnRueJzH2dQiHyu2m2WJubsSq4pV8AxVnWVMn3sOMW_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EQZSFokj43EaqZcWikDhFXhz0gcQyINFRthEF-uNJsQ&oe=69FC9B8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiVLect-dssQ7kNvwGeMIRp&_nc_oc=AdpRnitwEx89Q2m0GPj8K_1LbiR-vqhpVCcrMpqYFDwmmY9qumWXR-8PEblDU_H3a0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af704zUVO7nMaQGMMtbuYZKu_NeGa3tt62oW88EXvQty6Q&oe=69FC895B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqwDtRp51egQ7kNvwE46_Wn&_nc_oc=Adqdvl3fGqcP7GJd6OR7aC4l-2I90v1Rr0bKrMiZv3nljQQQPasC8Mb4sjyAkAnkKeg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sQNZkMgWwXLKm6WhIE551bwxAaNPtK5MZzLr_Uqi8VA&oe=69FC99D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP4qIONe_SgQ7kNvwGTbs3q&_nc_oc=AdpbnQIR7bVezFf9ddt_epKYqii2hUWrZ3gqh4yvbjQa8dnODZNh4iNmJzRbHtVRILA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69VpD3UgwMJB-i6kRpLNy6paD9igFpms9Vi_hbBJTHKg&oe=69FC897E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
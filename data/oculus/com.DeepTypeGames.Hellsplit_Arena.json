i": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT359jEJTDoQ7kNvwHGSagu&_nc_oc=Ado1D0A1EqXZ6jewZGFw1wSvf6jsdOkLxi78KYHkRIOAKVyZi6YwY7qRGzwSudx42So&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Iiql_RYgVHmVYaPOV8lgwgfFzHW7BMvqXzjprv8-YzQ&oe=69FDFA88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxNeFUQrYGMQ7kNvwFvFoic&_nc_oc=AdpHDsq2J0sGdYfnufq1UAwAmXRErZN_7xgW-FZKYArM9oblO2ofExN9auaGLT8QbTg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y02zKB6rPpMfN5bkj4VVkpPGZ0jZGyp-dQPEG8OfCPQ&oe=69FDED0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiVLect-dssQ7kNvwEy_jnV&_nc_oc=AdoVLI3VPKjaYxysa38V1stdI4kClriErHUa8pcj_5D9_nMos22raLDKGsXb22eueYo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IRP1v10Dot7osWnHkQ23GKPP11oUBJZt6fsQe4c3ooQ&oe=69FDDADB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqwDtRp51egQ7kNvwEFPezn&_nc_oc=AdqGphp5ZflcIsITPxOv-xNF-HDAENwUQK6bA7AdpfmLdpye8XHlXPt1olWxC3A6ELk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Oq98ROEjPTdZVn7J-jstvxKYx02I1jEMnqn2DXALqUA&oe=69FDEB58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP4qIONe_SgQ7kNvwEwoISt&_nc_oc=AdpbrE0afBpXRmIGJ-9ub3ZVccognOrPYVHG3Lw9s4trkmh88hKtxqadw3EdD2g8Z9g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NHwt9pOIQ6VZYgWac-IIhBuqJJ45Svrzmm3_wZnzoBg&oe=69FDDAFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
i": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URTZugA5J94Q7kNvwGiak-g&_nc_oc=Ado0X3t1h8nbOEoFjFkKo14ue2K4ZvMeh9_1yerZ683H6padcyHf2bMNdApSyNGetog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwunL1lJcFMmqXqq0ItxMQ-1zogsCxxH_XzaMTTjVf8Cg&oe=69C66348"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOuf26cexdUQ7kNvwGuuyBC&_nc_oc=AdoOVMOP9SuGcGycVd-ewwFu-yPenZC4DPiQQDZ-kanFW9whKaNb3VA5IlTXVzeF5M0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-X8xhroh-JEyPrZ_6gBDcTZbRR5UgAr-gslAhTeb7pA&oe=69C68E0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ihKCMAQ7UEQ7kNvwFltDKN&_nc_oc=AdopGvEr-ugpy5PGCH_HYHZ7TxwvsunCqQchMMSDIgTZceR08GkUdueWu515G1O3b00&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnsaOwnxYLxM52XzBIYnC8CqTqaZmWB1jWiM-HV7b6UA&oe=69C67BDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HGNd-WUhxAQ7kNvwEX36-D&_nc_oc=AdpL8DkT7M5Lj3d-pozP9KR-NNdXfIiaUglT-9s0JTeWCQEcSUwWY64r1Ne7s0vbbZg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUYOSRAoY7p20IhrMyk5AdX0ONn5dXUtsEu0bF0HI0rg&oe=69C68C58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfke2Up8OtwQ7kNvwGq5cgr&_nc_oc=AdqOZkGMDjINBMeT-NII09pl_S_yYmOwdwAqBMSktx-e-EzForJ7VOMBZQJTBlpH7p8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyct_FGYI4CVig9nAb3l4cfhBVM5vzUVzwXLXmtpDetfQ&oe=69C67BFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
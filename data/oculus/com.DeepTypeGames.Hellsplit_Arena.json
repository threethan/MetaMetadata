i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZsv-nZt3awQ7kNvwEbdLVx&_nc_oc=AdqfhmowGmPyPEk916T8RboLvatP8LY6LPRT9u9SmK1beJKWwTO18u9byj-pH3lfOZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WrF3Mdi-Xj-9IwcVEXItiV6gi1vT4Qbhn16BnOgFLVg&oe=6A1D9E88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-MSZHxjIH0Q7kNvwEQxk_j&_nc_oc=AdokB2Y9uUdJVe1nqxu0RbKExljls_l20MetG8NfRMlXvb5yU2HQ5A7cTZFx2NRZszk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v0DVylMq2_9XzLmk7d_a-NQLdepHsXRcejdPz-ak7aw&oe=6A1D910F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpVibn6yZJ0Q7kNvwEER94R&_nc_oc=AdpcR8TQSKtgvfeVMnfs7JIe6ZfNpI1bFhBOhyaI9OOBOH4pRJZrYNg8_FTAphHo9L4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k6GaAKnqT5IWPu8KYi-vHmq_PSoPk3HZEfAhkNIYltA&oe=6A1D7EDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1gD7GTgXkQQ7kNvwEsBzjc&_nc_oc=AdrfFUrrakzBAbSg3P3FxV8P7Q931sUNLZfy1zmoGzRDU9xyQPH06B8_hJkMQ2qJ-Dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TaTnoKRHxdJ_PAdJNeT7VL-JmOBr94yawkkVto_HaDw&oe=6A1D8F58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCK9yrkZowoQ7kNvwFLv7fC&_nc_oc=Adpi1lKsGs40__aJsnexNS5S2WAcvJ3I_HrQ6DIB8hDlhmun5Aa9h4SrDM0gmx2BSbM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X6SxOgr5VyTImwelP3LEPU_V5b2GuqyxKzbP2HHfTAQ&oe=6A1D7EFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
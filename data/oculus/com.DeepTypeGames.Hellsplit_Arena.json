i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzCAxhUJwL8Q7kNvwHDeVje&_nc_oc=Adqia_mFXPjBmNeicK87LW_q7b0-brYeZiETXqg_JaZ2Yd9cxoPEeBU7dzK6d8wdH8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NR97KgDS-43vkFuy8WoB7qpPt8e6XxHDgRrfMT4zXlQ&oe=6A185888"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnADBQwX9_cQ7kNvwEoJZzu&_nc_oc=AdrgMNEDAdjZaXOkWaGzidua3CJ9LXaUaYfmGAtVSjBA8qe6lK-GdfTHSr5JxzU_nrE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ssYhmgR7a6HBs90zgaxqH2FVJkxxWv7gV8ZQzD9avxw&oe=6A184B0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5UovmHAvekQ7kNvwHfItPg&_nc_oc=AdqoiWt4Hwtifq-IkEr8dBhj4bm9gCFR3UWNoprdv0wD7JfKAfdkcb-PZhnGYJnSsAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qp6j3LTLJznCbFwofLugjN2IQswpqcS_zeqnjvaBFYg&oe=6A1838DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWZ27ivW7W8Q7kNvwFojjPy&_nc_oc=Adrqsrzl24ki8gEV0u956vUuwRNlX53wLW_orFvj6rLk2r_2WVlTkvimFvoBn4wQ2eg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T5JJYi7ZzO1Kgg_rmnV4IHEO0bfIELn9lov-vFtr50w&oe=6A184958"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQP_lonxwtAQ7kNvwExE3Gf&_nc_oc=Adqmtbz8bNgK0jFKnwnYkuarIb3se-SCEZV5wTnnEnvOqfyQ6kpVLr3Yv06PNqG0tOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iTWET1M9RIuyt1n2lK9hIAN6zUcTOXEKkxjlEbw7X8Q&oe=6A1838FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
i": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGzNoJKcDgkQ7kNvwE3fwId&_nc_oc=AdpU3kgbKi4LTP26SzvERtz4IUE6iOFMp0SQtvTzr552NNTH4IxVKq-5Ukna0yP31D4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e05ploBj_aSuGdd2a2gNEXnxoy7YF-z_z3cMuSQAAIw&oe=69D91088"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Exx_J4ZRTkQ7kNvwFL3m0w&_nc_oc=AdrLjM2gBb05m8NfTt2_2V2QwxTMgHQ2khtOnI9sqLdSfkhJZs65zRQb-0Yf66wvCDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ir4BEkVdvA-t9mQsy4tK4ikyZ8CHyDad9rM51dB9hzA&oe=69D9030F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6ykMJ-10-YQ7kNvwEpmxOf&_nc_oc=AdoYp2_hp4c5gPW9C4jANM18_7by8HVU3UTx4vxOVdHw5qzQstfXY7wP1BcF15FVCGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B6AOwdxvcyfuAuSLJ1APhohJk0BZXTnKZVX8_9xxcgA&oe=69D8F0DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj2bJ3hpqugQ7kNvwG6tWrI&_nc_oc=AdrRgQEw_HhwjwOX8_-LW5fSCi8r9BCSUtF1-hCA5mo_OAN6PQL0KgpeKvLFYTIpGx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pbKmiTZ58-MP8z3Bo0gbftmf21RlUiIB3wBGSUQutvg&oe=69D90158"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG_efOFGwmMQ7kNvwG--mvH&_nc_oc=Adqtif_vTjA21mtjcBwspq262SNr-A8kqmrUgMvdZh_FLB5MNPXY5I3Pgd1mTWEzTd8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ReXKPVIeSVrc-mcZ0B8VUg0vOJKOt5I2zoBCzDWBrmg&oe=69D8F0FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
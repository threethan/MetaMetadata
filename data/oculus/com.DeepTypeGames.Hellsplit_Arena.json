2395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-docZYHBXSwQ7kNvwET1KA4&_nc_oc=Adl4f0XoP3KGJokca0wMuD027vXSxMXIEhAcuNenjDybGypoMoxokkSSE2FK0Oc-Kk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDQIGF__Bkwb7do_Kyyx4CJSe57hi7yqANAlr35U3S1g&oe=69AC0548"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFDr6GSBks0Q7kNvwFRjstm&_nc_oc=AdnVrDYMfHdAn6_nHR319oxGuNP5PeZdwHbgBpCH89YMU6Deg-mC9moeVn5BkOwdpq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzXTEKlSKnwB6X3D05mwQGwttCsiEfpyTCR8ojKLP70Xw&oe=69AC300F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eISYLrE60GcQ7kNvwG43qHc&_nc_oc=AdnKEQddulc03BJBXcggERnxWK6bG9SFPCXGm6hPlFU8-Ihbtk4ZQnJnt8qxpeoXHm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8y88NjzW0-BUbODP9Yhsz_qNKQQirtgyONbAjU-Z_Lw&oe=69AC1DDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQPfbUYsG6kQ7kNvwHol0R3&_nc_oc=AdnSui-W-foOTJfVy9f_ylnVHzzNIe5zuGk9g-KJWnrpEGfXF9QqkiUNssEX6xYgFs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiaW2cIRx2hsQGloohFK7yKEIMgUwwqPDHPZ7HTcKJQQ&oe=69AC2E58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPBEcxmX8IoQ7kNvwF7h9hm&_nc_oc=AdkFJ13GqOEoq4b6D5tbB9NHlIgoATFeEyBzkyqmFsfp7-yh2sISkzaTKjJqg57CLUQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCVfyo_pZgfJS_D5tylYgjYDcsun7l5FnHlOHtlWor7g&oe=69AC1DFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308
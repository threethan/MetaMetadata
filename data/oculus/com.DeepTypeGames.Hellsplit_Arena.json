i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG0MMTE3eggQ7kNvwFC54Bn&_nc_oc=AdrTRVfV1Bt3HWP8oKzQG-aRjVxKwpeUNlcwEJHeVZxvhILkJUpFI0iZLfFwh62BkCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6awr3bo8rR-M2fGNbwzEhqFEixBKNM8TQx8Xzx0GiDHg&oe=6A009D88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxNeFUQrYGMQ7kNvwGspPoA&_nc_oc=AdrHN1KeO5Pi45iPBgqrdN0-D03K2HzrF2WNYIf3UzA0EaxUGZO0ebXz4NJ9gIdTq-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KC0BV80dJfF65ynYbn9yPwJcGeWn7BObECFIlpfZnJQ&oe=6A00900F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5ThfOJkqvQQ7kNvwHkCGHj&_nc_oc=Ado0TtAM0-rlm6ZAAp7n3FiL2OK7fRYWFT98ViSq2dXqq682Y98ACil3iNaX0NHZxFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LZROmkcpS_6rBiorfz-bzvvsBhPzeyXOJb2po3SRAVg&oe=6A007DDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zH0updgF1wQ7kNvwFUgxuD&_nc_oc=AdqWleLGZYFyrrAN6pvhBPNLm38Rb1HHTQoV9NEXU0rE_xsfUKrymNeV3QFXYKGyDhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6psfBdU8y-1BoeyqWd_Whrp5hWqdH5fpN0RaNXA3JtQw&oe=6A008E58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B79NylKoynsQ7kNvwEQ4eWi&_nc_oc=Adom_snHip00Ydeczmn0yzc6tphwX1bOJhAYwYkKsExgD2JDclBEbRkfVqvxd23KhTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WpQc9pUhlBs8-089TZ0s-RO8MvPnuCMORJOneyOL6iw&oe=6A007DFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
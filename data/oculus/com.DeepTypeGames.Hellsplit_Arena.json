i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-B7ezsHBbkQ7kNvwHTq2nL&_nc_oc=Ado8OBOLoxNScjYIwXwdKiCHH_J47jZeQDbewu8_ykzUK2mHNANHEffzBCyOTAWlAP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-78RTzzJEDPfi6FACA5RDfWAGRaQ4Xy5lz4hZhIWt5A&oe=69E39C88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhVDPw808iQQ7kNvwFKqbwg&_nc_oc=AdosmShJ20QDmiMQUpl_fj1RSDpLrXZmbJ1ZmtqAgF69QjuEi1CQSyxkkH6H5qUHqMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cz5-BdY7nxFbsExWluzWWVuWdOBB8YX4_ywuNSsP6Kw&oe=69E38F0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWJR9_kMu1IQ7kNvwH4wtCK&_nc_oc=AdoWq99hoi9CrFaUM27pDweCGAdqMxE5fz2LhKh8nAk5IkffNwevBK-CG-Kjm29rwg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bhxot6PrnFjWB5p0yy_dzJ2nFL8n0i7iy1bkabprcqQ&oe=69E37CDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSSyKtUxBgoQ7kNvwHG-u3W&_nc_oc=AdpkMCtJ-OS_DHHPBYJGd1eFs0OqTQ4yPzNYNwu-KF9ZU5e3pMYZl7_LnyXHprpkXaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VyFg3Qu1kT2qz6kndZPEF6-baT_sQ03winYykSdPiWQ&oe=69E38D58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxuNI4s1c50Q7kNvwF7alCm&_nc_oc=AdodoPriker9P4kAYjjl6gQIccNAifg2bOoGtV1JtyLn4ltxJ2FGNC7-FOgtb44BFmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03eoiCM_avYb6zxn6gnJPiKKwhFFNcAwkD586lzg5yQg&oe=69E37CFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
i": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCC2kRDI3RIQ7kNvwFpyCYU&_nc_oc=AdrJs2MLmHYy16CjRAH1n8AJG-CSRIQl05_GZJUx12V3oSjh2a_RNPqjplmq1KllR1Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VkaIHxugsmdCHLxg8Nj2Rdn6d3JdBPAjkWzMdCuYbxw&oe=69F36E88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5KKoZoUN0AQ7kNvwFxv7Th&_nc_oc=AdrKG7VFbJkfygbuG-3FuuAoVR5bB56atQdKJLXnfvXNiF5Oy5DTdYf-yiSALJX9P4s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MPgFJybsHOvDEB1_D494q_Yvest665_Z0EhSrNNI47w&oe=69F3610F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sT4hlh0yXsQ7kNvwHUToXL&_nc_oc=AdqozjSdgh5fL8RX1UtEAi3EKbYkQupoFmsH_OhUPoZ3TF2sEkYhV9IfJHHa2ZEY29s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rhdJHDURAM2WuRgN2GU-3zcOpHLZiDveiLoq9HhjOJQ&oe=69F34EDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMZVmI9sQJ0Q7kNvwEyfzbw&_nc_oc=Adp0iUU-U99ycvzDuOJsXCF6rGmKjcVi99vN3XPkcX-kDTcQPED2VoE0SegorLMAUYA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yMk1vvsjJ9vnooS4C5A4e_w44rl8DACSd8k58UlG0HA&oe=69F35F58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7V8Cgn99SsQ7kNvwGaxua0&_nc_oc=Adq-0ksPXpGz7CFTXJ1jU_KCeosWc_TEWmWyDvU1ca6TzoJ9aJo4scTXuxcth7SOg5Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1BqLpGEVnSobwZ2_XRg8NKOvvae_Ff3wP7R8Xkp6GThA&oe=69F34EFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
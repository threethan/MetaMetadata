name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-4jy9czqi0Q7kNvwGkvcIn&_nc_oc=Adn1VNkN8O2wCGc5pPWHvGJPlAF26rZrlm6cIuURXx3tZjqBnD-gp_HquYaCupkYfNQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwldLwlNwAhng3mtgYFxkgJYGcOMdQz9P9LcxviS-6yKA&oe=69BA8962"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_rGHb1vF_sQ7kNvwGF9M6K&_nc_oc=AdkiiRZ4y_m0TNUSI36BqUaBb3DhGmWssP9vmcL1IN40Io1nyTn8JQiIqux1Bz8P834&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwsXKCnxg7NaAos0DbjVXoJZCLzSn6Lcv3MrAAFXCllA&oe=69BA8DE1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_wbNKEPc3AQ7kNvwFokHYL&_nc_oc=AdkQhiaExOuxvaCfrhBVVrF2menES_6QHjqii1k15_E9GuZ6B2zmXJaVcczcUgHLr_s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_rlmr0RVMeF38ejR240DKXP8aUfgsz_BuKgUCf-zvGw&oe=69BA86A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WcdLOHDwEwQ7kNvwFJSccf&_nc_oc=AdmmhxoMvSc0UEtgOwYIbQFVGP8XHG1-2H9PmPEPeeT78Cnl3H7I5tsD4gTrGCrbexw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1Nqe6gG2Wpp3vRGG3wUFDWdWbHy7X-if1UOY3hXiDQg&oe=69BA9087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2MDXEYYGSQQ7kNvwEj8ulS&_nc_oc=AdmLvJkXcks9yCj3h0Txj9xW99tFjvnWZzQ95S8akPHT9bl-xtX42NvVHzuTOUya9s0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3k6Msq6lcLtR6R0dMZ46aAEwsg0mVTVJ6o3mlDczHmA&oe=69BAAFA3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
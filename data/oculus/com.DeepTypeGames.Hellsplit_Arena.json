i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FXf0icxiW8Q7kNvwG_h6rg&_nc_oc=AdqvCqQ-7HAeTLp3h8oW9HxoPOMK7T6K9TnPvUgliJR6HeEskdEKcOwbwqM8P2RfsOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hdrvjFt0R_KsfmmfxrooGa6VH9Ns3OcLF2D8Xm5j2uw&oe=6A3BF108"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX9YL9wF79wQ7kNvwGYjWiW&_nc_oc=AdoOkfIsMKnIkAZ9Wki0d9Zj0cwUMGwTBmzj35qNpLejc_4GKIk1MAdQGCG4tnxdoxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lO1Rn5L_5ygyC1710G4NegcOyf8Zl3gTJ3kapV5S1Ng&oe=6A3BE38F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J06f7SxsCZEQ7kNvwF7YwhL&_nc_oc=AdofBHE-UJOHSwhLw-AR_i4gpGv7iMfc7fZW6b-HcEqI7JrqlYFYS0_cRViEUx0i_3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l19PSogOp-P9sff0-vdlkIA8FKBWrR87UuObbDpTURg&oe=6A3BD15B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHz0c1UU2N4Q7kNvwHQC5LW&_nc_oc=Adp2xaJTZMxDQVWoJ76KSbsX7aMjgXvjvtieAxNQu8GEAlVN-Gs3tdVD0eIhqxNLkwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XQHFqoXwELAgLysfCdur7CkpustljfUTEj877fqeYLQ&oe=6A3BE1D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2vaixQW7dEQ7kNvwHZdWby&_nc_oc=Adr8WqQ7N0GeULuVHnxBWksU32zLev7wze9J-pEhYNingCW1NDCtRNMz1bCbhyAkU98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B9uidEkzEbyw5ZgBrhDaOs_aryWDtyX9G5OrGlfFuzw&oe=6A3BD17E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
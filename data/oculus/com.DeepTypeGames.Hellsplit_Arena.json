2395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-docZYHBXSwQ7kNvwHbX23H&_nc_oc=AdkjAvN-m5FZiM2Ptp2pFgvrAtyV8G2VWKV1ghf8_Y4ka6peRb9Qv1HMgmA9tXhSlDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfulTuroOY6umfddRkNa1VNM1F8F2zlium81GdeVnv9Mtw&oe=69A96248"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJClwtf0mXAQ7kNvwFrci2d&_nc_oc=AdkEnis9n2XWNyQTwEkPmfx1BE6NiuoC1ch9EYR6RGTQv7j-ZSZTQekAYt3lyzPuTws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftGU-2DPjrJr39uVyVqPbFGeetuH699GQgeDiAQJNBeiQ&oe=69A98D0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBXMxF49hFsQ7kNvwEYWvz5&_nc_oc=Adk6LTLcxzqxj4ZGAFy-jrj-cqpnzAWThFVltsmEduS1MGkLYw9Mc5L9WAjiDTMCW0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKg9veLoBuTx3qvZoU44FTPjoyt7BAVvGC9oDmuFcn_Q&oe=69A97ADB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50NADEIl0csQ7kNvwHIWLTC&_nc_oc=AdkOnmxb-B7T-FFv_ME3EgEchX1PHtxMhgM23x5b9ErSxusoLP7YQyXHNfkisWzudZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuxaE7x0UILn1Qsmo1unOXzUPR3kaNgAX8hlDN2HhWqeg&oe=69A98B58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPBEcxmX8IoQ7kNvwGJyJbE&_nc_oc=Adkw_Df4XEbNMd2pPWRI-otIhiwZJRlFBnGu2nszz-KaFvDNguciPHCvcJz7GmRyGd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuCMWpjU-lU8AIjhJ9FefH6MwvL4Kb5aVQbATWC_wWGkg&oe=69A97AFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308
i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftIigVcBYmIQ7kNvwH9qPSp&_nc_oc=Ado-hrfjlFL9PVY8PBYhzcij9fEYf2Jsp5wGAe3_do0wJ0L7NzLma87YmgbZIWj_UWQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nW49ErXu5H9AMumYbAknNLZ_6gYEaxxWrFmV09u0Xog&oe=6A297C08"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT85eG-ZENoQ7kNvwHG3In3&_nc_oc=AdorHnH_GhgOqSsjRsP4Ctt1WlOR2B-IiprL2DVW6QM-oBhBw2yrbIIbY7U1NKpIEYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iYI1Xms-OhYsnn-J3YcShndvBtnwKPoYNC6Z7wSMU3Q&oe=6A296E8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDSwRuY9sisQ7kNvwGs03Kx&_nc_oc=AdqhocbkYp0OCHkddpFOWr_F2tnLLT0GIr4jjuYjDZ8l5NT7RjiMPrad0KOtA2dRalU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tD88EvDIFHkezZhSx_kIO1Na3BAxC_N19CNv3Y8MyrA&oe=6A295C5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=643QRUCAltAQ7kNvwF3eBiR&_nc_oc=AdoLDBrsGFQehlHpq7AnAy1d6YPPwFj2RSufN-NoUgYD7t8WXm9AofEPU4N1fxrhE3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JXSObGqasXTrGjtLpArNSklBCRysdmiV2AbvAXyFl6g&oe=6A296CD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn-V2RsM0PUQ7kNvwGY5wIb&_nc_oc=Ado-sHFLwxRkYnIrV-P7N4b21TNtB8COpyNW49Oaij3GpxFkV91IHVPn1rpYZjfy1rs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M6bzXDeIRoJs_vG19sfF2QD-wjemNWn2hFbXAnkE0YA&oe=6A295C7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
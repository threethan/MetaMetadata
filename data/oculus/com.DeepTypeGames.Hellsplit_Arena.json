sEEl7vL9PELvATR-imQtEr1IsRP5zDArHTP_Lg&oe=6AFC849B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Np2DZ5Me8EcQ7kNvwHsVfP_&_nc_oc=AdqmzJNtEKMiW6LRh7yXTsva8fWM-pPqwpbFzbN9XC0RxhJK8TAp2UwdI1ZWo5pCsYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVYN3reeId2CEspyHdgnUUINXbJPMPBJRAXMy5J0ZaqQ&oe=6AFC9518"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zQ4amNAjukQ7kNvwGKJ72E&_nc_oc=AdrYJdngVTLXKnnYssRieFLAHo0zc-2_TH5kvMnPFKOm3Nfs_DptmzF2vcfDBPi8qAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBumWc7msG6K0JtuAlIytIL0rF-Lx03jFalXpWsiJtMw&oe=6AFC84BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "es", "zh_CN", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28489082004016377"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "28805293522474548"}, {"status": "PUBLISHED", "id": "1122438703636211"}, {"status": "PUBLISHED", "id": "1401044331898202"}, {"status": "PUBLISHED", "id": "1352117130061597"}, {"status": "PUBLISHED", "id": "959200230381009"}, {"status": "PUBLISHED", "id": "891548017080314"}, {"status": "PUBLISHED", "id": "1893951704797416"}, {"status": "PUBLISHED", "id": "1191697309347650"}, {"status": "CANCELLED", "id": "998749161857180"}
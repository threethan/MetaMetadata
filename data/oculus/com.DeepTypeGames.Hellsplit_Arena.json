name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n09n3nZh8cAQ7kNvwEOKquh&_nc_oc=AdmyRnOX6i1ELlybWueQ9YbMV_BG1BRWWH2sHB0dO5BCxaTLTf1Sg99ub7NUX9cZt9w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7QUUW8MuNDa9-Xaxh1xGhC8MQ1HjB0z5HguBvODXlQg&oe=69BD2C62"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_pEnBOn1AoQ7kNvwE9tz8e&_nc_oc=AdmXTVkcHBHXnaNi0jgKcgcIpmSCn5cSXdpNd24EIko-hYBHB9_NPLf6kpqxxlVfboc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnCCQE6paR37K6ZmZYiqMPRXAxvVciBBjYn2cgs5rXiA&oe=69BD30E1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_wbNKEPc3AQ7kNvwH2d2ad&_nc_oc=AdmooXJq4qqwsXgn2xZ62Sh1lnmogyBbeJ1g1iXWqt4mCHLMchaZhrqAfRongWTUK6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMclZvr4Afbhk7SXAlwlcQbLH4CQu3hL555CuyZeEU_Q&oe=69BD29A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WcdLOHDwEwQ7kNvwGPPmEs&_nc_oc=AdnUL3YB-ddoWCyy7mCiEnkbleIrrvgW1CbE4B0qS1n5uwqIPBIpUK3N9jqVUsyRkFg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvkWmlFl6RT-XaD_VgBmSWjMK5eJZHrfrXCZvTToRyxw&oe=69BD3387"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNa7swMePAwQ7kNvwFUs0jh&_nc_oc=AdlHmf4OhGpPBHj7kBc5VXsYxOafWUf8R8EOW_0HMLduotpVAnshHyJTKSCYPj95-Hc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXkdSN8AGgqFkdKUbkJNXuEtmEFQ1xKJQimwe5fgrlgg&oe=69BD52A3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
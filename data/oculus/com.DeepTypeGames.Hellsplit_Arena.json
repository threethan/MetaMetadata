i": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFsijPelfwAQ7kNvwG8ijBR&_nc_oc=Ado-lBCNBTVdzFOFl9LNOttwJAT4QrVQ6cmxml4eZx7HqhQYWRDlE2f3rEJp-O9mfUY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PrH6n-OPudeP0Qp_JWnIAtMaApHjW8GChSnBFuR1A-g&oe=6A413708"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA82ymQLduoQ7kNvwHHqhIF&_nc_oc=Adrqa3DORoAiUHuaTC5uuOScgnzwOsuUFdTC2dLLrkM6JQn8uRFZvy9p5QUVj9lfF9k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fFOwwlj8-CcB7vGwChiXRvhBH0IaAVO3ZNZOQmUWc1w&oe=6A41298F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHdDLYeloxQQ7kNvwEkWXwc&_nc_oc=Adq9nCpsQBfDhWD7AzSRn51jFToEi7YSlD6c1WOKL3HrPjYKZ7HaSQMEnpeSJKx28WI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Wrorbsduc5wZOz8V6g_lC3jYafT1C4tG9UOZLBoeJqQ&oe=6A41175B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdGfqN40LFMQ7kNvwHycm70&_nc_oc=Adr4QOx4o7oBGt8HVZiywM-m7ZqbfxP1NPpnhRpbzUbzQKWIzz1-pVnUBTHuij_S3hE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U6AQ12mxHMmh-N6D9uk79ypfoH_Gs0K8IXg_tYnM1OQ&oe=6A4127D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E8lNPIViqYQ7kNvwH_aT1k&_nc_oc=Adp-rU161aiL-Pg0kTyJBSNBvWNEhLMwW2Wovt7mhl2rDnTAd3vft_6dNi5_Mb8oXh0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wb6UdWeNGZeYvuRJZYkxtxGJBbBBTsiXOdKCkL1Clpg&oe=6A41177E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
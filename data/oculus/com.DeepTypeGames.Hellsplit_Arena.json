i": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DUel7_EiIMQ7kNvwECzF7x&_nc_oc=Adr9q0m2zkiWvHi1KNoAQEkNN4xbpDXaWThn01kTBYPLC-iIpvHQDmejLnIi-D-0ass&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bsbgsUigNKicAhwkEWLBn1LZPi0wa3ifG7wUDtUBLsA&oe=6A15B588"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnADBQwX9_cQ7kNvwFc7fGF&_nc_oc=AdrnqLMIpjRsvlZJhK_jumdut52f1tetF9fWw5rwMS_cSqiAfcq6ditNND-RD8z7uvU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7USV2o27Hhoggek3DM9XO_C0oiyxK1HWzYNCkp2iQUbQ&oe=6A15A80F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEhUrMBE7E0Q7kNvwGfMMG4&_nc_oc=AdrO1vfH8HEHq8FQ1leW1DA1jaNSc7C7hcMw4IuNYdWRN3bDFYRyhAJ8BdOibLJ0rEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PFra99qxTlHbnOfznJLpAB7NdiVNG7BhWSxGaDxauFA&oe=6A1595DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgbe0R-5ID0Q7kNvwHTgdG6&_nc_oc=AdoGrWOxA_4DlUyBPG1d1Xg2p7uMeUsFkw7_5ldkqElpSDEh8POfBE1dY7LyIkBo9bs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IMo48BQv8n61r5-2IX9Fi5sO26fo2eWYMfT8Jc8J4pA&oe=6A15A658"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ml0ejHXhQkQ7kNvwGa9O1E&_nc_oc=AdrDKEGV0U6HgaUHOVIxtiVTOLyd1_QZFaRSjM_T3DcU2F5V5MtO8zWf-SmBMvqACfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ymEbIT9ZHNVYQYSMhyOu6u-OI5rJqIK8-DGXslXCTeQ&oe=6A1595FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
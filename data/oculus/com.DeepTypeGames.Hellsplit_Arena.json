i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MncrgDXghIQ7kNvwHnRuP0&_nc_oc=AdoguzdeYPKHDHgLpLdb4jPVcQA3YK0gJhI1r2qOA9W0e5IYTsl9APCvbP_mKc_ANGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3R2mgiBP4HwoprFd_-TNIz0bBB6qBInzXTcjlsQLgNxw&oe=69F76308"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l00MkzWdYLIQ7kNvwEFHf9b&_nc_oc=Adoh5CFFkupwZJ4flwlrshlwwRSZnqvZMbPOM4-X8nlKLy4qcJWFz49MmyYNr3Z--EY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3uwkAGOpmjAKYEJ7rfCpH7tIQ9QkCdQmrkRCJX5KoozA&oe=69F7558F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqNO0PX6IzUQ7kNvwFmhWfN&_nc_oc=Adox3LpUnJzmg8mAo5VaS75IWkNHi_rT6S0iWNCtJIIbLL-la2157rA0OUsWlBtEuUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dNf_UFj-6JNHza5R-fiw9ma8Pt1vOf3CJv4kkpc_0BA&oe=69F7435B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rom01nYSXQQ7kNvwFhue-M&_nc_oc=Adpx5-Tz6y1Oyhz8zmizBfOB3OiSvoaZ2SbLHudGM5wkFXUjjIo3FADreW750pAfID4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af241GCDsRRO6oNPNgyE_teyQ60NUCT5tWfXzJHbIfTv6Q&oe=69F753D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl4F1oUmaWsQ7kNvwEV5vFQ&_nc_oc=AdpLYzPC7V1rpiR80GDxAvuEh10Fplt_dnTWNx4OG_aAwoaQGxjk8SSjIacTSYQ-Za8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3uDzgd1ARHdFu7MS359weyN-wowSTJ6p1msjb9sbHHUw&oe=69F7437E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
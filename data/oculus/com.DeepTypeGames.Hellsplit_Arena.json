luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z25eer58pJcQ7kNvwFAWmmp&_nc_oc=AdqpPE6MDSPLd5k9BmmJ8YXeUo5EHRFd_oa980kOj_UTvynDfoYOGzOcgzABFYuoLrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3HzPkNJ__rO1GC3pLholszrcnuLBI9UEGr1yIvXt6uog&oe=69F0CF22"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckjWmn5UUBcQ7kNvwHdKXyG&_nc_oc=AdpEZvPDR0dOpa6JPWTD_Wu83LT13E8tKU8a72vv5KKhnIdap0fRMnQOxgnqsiLPPtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af20JoGVjIUqxOQZ_9jcCOWdfbUo_SqEzqxFO3euHABlLg&oe=69F0D3A1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cyt3fzfEa5IQ7kNvwEniXsu&_nc_oc=Adp8i9YM0GMke2tZFL79P4yh90uWGjScDy-RvHH_KCbLn4eW-07jGrS2qJfr-wOjIks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af15MXaBxM-9VGtcFdm_NPVY_DqYUkwgYt0KBr2Fd0qjPA&oe=69F0CC60"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKauZZrL7CsQ7kNvwHVQ4Pc&_nc_oc=Adqqp5Hxu4MYu4OHEtkFV-JwinAOVlCbzc5E5JbnPo-SIasE-jLuaXUWggnfgW5Yq6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0s1B-4VVAmt7uxYYPwEJJhaFja4ZHuiPdRu9-2zgecCA&oe=69F09E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tcKYk2PRm0Q7kNvwFkkUiQ&_nc_oc=AdrfRVzWgpQJRTMRhmaNpp6oPVOX2NQX3jTYggoXnUGl8q_GcT7iQxvBotBkudZxYqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2EV_bVZQPSBfIhKkUGqcD7CeZnMkBhfa0sWHe1Pub9yw&oe=69F0BD23"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
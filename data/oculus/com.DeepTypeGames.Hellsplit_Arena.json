i": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=024fBdVjPYEQ7kNvwEHLxkY&_nc_oc=AdpQ_6MQYSQXjK8rK-5zYrmtD0dIPFmUVLl2HhdIZPc-zykMUiz1UuCZKdvlJg_6YtE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PThwxYrv0vajiujSILf8vW3Y-0jevloX6brxIKoTEpA&oe=6A243608"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLIRNLJILSYQ7kNvwFIKXRR&_nc_oc=AdpDBL9SNp2qcLMR4PrV-gplI-CoH2WFi2NzJ5qBwAoELlhvsx029jxq0U1Y5LJ8GeY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__mZ6tGKDD1h491NMd1XrLmc88E6QVIJmEcpMi_EqDpQ&oe=6A24288F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdIaBg6ZIosQ7kNvwEMHAN1&_nc_oc=AdoCaJn4zNzHKpZiRXYOYdV-e07E6m4desxC10D3ia9Vd9VyunICOMtFMubNw5_BhHQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-63StXjfIiAHhq8Jz7eQ8O_tU8fM6J1uQ_5QG_BlyB3w&oe=6A24165B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmiBxIzm-GEQ7kNvwE3EghJ&_nc_oc=AdojC2kH9r9ypnKYsEjpcRloQ0PqaNglTj0vZNUuCuce4HRhP6IwcIvKuqjPFeygH1U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_jWDeYd5y7R5rw4MdpTTFxcyXq0tJkBQI7Yj8gUH5sQ&oe=6A2426D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4hWNGS8ZuEQ7kNvwHva6by&_nc_oc=AdoDJjonN0kz3Qmcq0oZqJ_H1GA-DicboMr5QjRvn7oXGhEbkXyXM_DrLuDjzD7g3ko&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EjFFhdKoBKXCukFVmVbikShGDYjtv_va9kiDN85Fiwg&oe=6A24167E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
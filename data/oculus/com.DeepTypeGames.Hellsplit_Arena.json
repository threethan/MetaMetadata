i": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZsv-nZt3awQ7kNvwEl3mmo&_nc_oc=AdqwpOdVeJyq4vQzxPM-oKyQI0H00DaXSz0QVwfgxZZGPZYquURstjjjGfMcM4Bf9RM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i5EV-chl0SpAjPN6ZnhDw4RISpSNDTjmWv8SULYeO2w&oe=6A1AFB88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADBLS2-4ON8Q7kNvwH3pyhJ&_nc_oc=Adqd3JdNk5vl2Xyur_1T7K_NdXIwBAbb-xIcLjpJMoLznrtuYLT9LeiEAWQsmIDJ_bY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MCy6Lrd_1ELNL-V_1awMGyp00l_Ms5NiMPK4r-7EI9A&oe=6A1AEE0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpVibn6yZJ0Q7kNvwGOcFMh&_nc_oc=AdooeZsjIJo4Yofqmsj06HONaD6vaLN2ZF5iLxFXDFn5Q3cVxKubMDm-3ipf47FEgOM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CJW56mH5H5PGVX98FXrmQmWEzEtQCbWaKiQs2noEsEQ&oe=6A1ADBDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1gD7GTgXkQQ7kNvwEemtze&_nc_oc=AdodtUrn8mLp-U8s8yZmsA73XCgue-3ZulfbhKs6IG3QjsG00LZEJI4va0OqcuYEXOU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z9HBpPJP4yG1p4yZap5bU0ueCkQgjzDtY--wDhAj5uw&oe=6A1AEC58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQP_lonxwtAQ7kNvwG2FyQT&_nc_oc=Adp2uVJpuXeLBqJaLXduIBCVdHe8YT2l0z4wERykEsJjKos4uH9UqcQ10hhw4MlrlMw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BYd0iM7KAwdX_DS7TAcL375ww7-_Qd0YNgMwc2-w5vw&oe=6A1ADBFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
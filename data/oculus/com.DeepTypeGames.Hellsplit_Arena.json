i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mckJJXekCF0Q7kNvwGXULW-&_nc_oc=AdohxGddoAOyC8v-iKbW_cIqc9SE5dgsO-Tqd0oionVlfZXBtTuDOMWsXvphOKWyers&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X_pGdZhqWck1xDTZRs9LUaERAQo1B1ORofwO45Ugr3w&oe=6A05E388"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZeAhgWeyIMQ7kNvwGHO76o&_nc_oc=AdqdItNh6B58yngScLl0F6tLnuY_rhHVWkkkqHNfeqW7pFF_tKLF35QxV8y7tVpMXMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af447qx0JpIRH-Ddkv_2fvvQVHPDA_xcpIIX9wful_3qdA&oe=6A05D60F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGugw3XcWVwQ7kNvwE-6uFZ&_nc_oc=AdooVlLFph14trSVPKW8KIAFWJRx6QKyz1vzb9wd-O5Qmy_TcbdOBPQo9JryBk_tYK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tNLLm8D8swFz7cL8wJUPNKNdwGUZnqM52uZBgE_r0dA&oe=6A05C3DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjqKIxWj7UUQ7kNvwHSgmN5&_nc_oc=AdrqhcB8xOyzz7cKYr3_LyYMc1P36taBRWmnROg3J-Q-s0l7Sj0Jjfx7ozM4gmTwXhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NfqPk2yEH1Z3o4nz1cTQ0u2ag2Goojq31jgOswBxpsA&oe=6A05D458"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24jClwd_PP8Q7kNvwHf-Gqb&_nc_oc=Ado_o7soeQvP3TEglB-1ALewL9sFQJ_vT7LeT7bhmIW6z3NFK_J6vxHfribJ8nagOh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IFHjVsI4l4qqgDzumtV6SPb8CszWTRSYreF2XS7e_Lg&oe=6A05C3FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
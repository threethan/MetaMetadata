i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymo8A4EdrrcQ7kNvwGdJqLJ&_nc_oc=AdpRXHRqRlexMIMkFp3yu3vfoDbM8y4zKCp36NALl6XqZmVEcJNMBNrR3T2NOrdw0Qo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7CzYi_aXW14KNj8vndi_VpCrOF0LwOG3tnUsUFxpLkQ&oe=6A4A7188"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYTOSQEz7roQ7kNvwG_mh-q&_nc_oc=Adq2_4dDCQeWvhX4UwXeay4c9gEqd3Ehgbh8Y27OwjlTP5Cnv1w2uTbL-qIObeHdBzc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA730tN1vLPqGnMBAl7iiwdvUz15oKxkWrAytrb6sQnGA&oe=6A4A640F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt-ChWCM_nwQ7kNvwG2yVIP&_nc_oc=AdoGOXf5u05N3fXCdhX78I54KQ-LbNQxGgGr031FhHZmeEnBGpGcKWQgG8fWYNmIF-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQOamrCjY6TJSo_1nQZ2e-CrSPju0uSHdqHDLz7lkhRw&oe=6A4A51DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJHaKebBeNkQ7kNvwElANSA&_nc_oc=AdoypGYu_LlMSqgB9yXNuEBSGezvK3C99NoFq-svJ-hU6sN7je4NAxyLGmpa9DqyHXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW89KbcoIPf4tsAKGnpm2xhACIJ_OjVoqAqPT3FAzPMQ&oe=6A4A6258"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQKkawlMSigQ7kNvwEIERCB&_nc_oc=AdpMF7pcHZYDFAjlekTE7dQtZpUK5NtGoi2NiS7NI8ueO58z__JImPxmwUh2Bq0FNBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASXmQIfRdEGEzkfxbmUGvM-CTieRmcR9ytYPgoAKQuQQ&oe=6A4A51FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
i": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNRz5GZz06YQ7kNvwEcRO5J&_nc_oc=AdrmqDaLxJ5tBH-RJmkVRhHdfWribzFBksd0w8j3YFjhZIsER9raSgrsExl10S4Q8mI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUKIWCUkaoyQP2GDBkfVm4q3fZGhCH64PASBzPwk99QQ&oe=69C3C048"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbZPKyOSswYQ7kNvwE0WbZ0&_nc_oc=AdqLOsh-O2n8BPu5QrcA8-KJUrKPzSWMbBvm5taXOMG__IiV7qAciq2IflfJDlpsgNM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGvYx3Dtvlf3XUEk4vzVfbQalIJDCbR_Hj6QYM3S4q9w&oe=69C3EB0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ihKCMAQ7UEQ7kNvwGmPSOG&_nc_oc=AdoD63sopWc0qmH--fTik5YYGLBUN2DopoELhw4u3Jq8AE8SN7rH-8vHaOpgqZb9sWk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysSHKUnHZT-SPY1fiWL5nL20BXbMB5pBr3GEIIiJK_7g&oe=69C3D8DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HGNd-WUhxAQ7kNvwG9f_Qg&_nc_oc=AdqTTryHXhBNSUE4TtSfByDeFKtk6ch3yVoKhKpiOdfM99vcoUYyRilm3wtFMXywCiw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjMg_mpxEe-FFAcpnMPXsJ4g26Ja5cAVjJlPzGo3AGwA&oe=69C3E958"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMhnzWqO0ukQ7kNvwHY27gS&_nc_oc=AdrGzdF5xu4tio_E7936doXA78TbcSyTsFT2ijpWty8-l47AhJHB4X3DqIXmv9iyOx0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyugQewh_dNq8HciTDq5re9wQ8RpGK7g2kXnty8k67wYA&oe=69C3D8FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
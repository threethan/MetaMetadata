luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7NrHPYqZm4Q7kNvwFgU_0s&_nc_oc=AdldWjoCgjf9b-GXEfxUsKH0-jx_s5NnLBVOgcW4rcCgWRCoGke17dRH2gCgn3Q8pHk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftWNKsv4nsETgWY8VYayH562rwtUc5rk6Sv6yELTqf3CQ&oe=699ED9E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMyEvHY2EdEQ7kNvwEO5IsL&_nc_oc=Adl33S0rR-j0t8v06Jsdd3T-UjiU4E8goDK3zWvnisCb8Tn36zkHdrIFkKSMDfhxfJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsQgoDzQKTMoSW2kshK6p06oqe_Z7TRoVPMKnFrTfwm_A&oe=699EDE61"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ8-xAIa1igQ7kNvwESVhIT&_nc_oc=Adktps4Yi4_naKoH8kR7I9DT976nQtEj8LqPSlAP9oJ3Jy7WdyylDr0nJL6P0QR-fvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsflVNFiva7yoKA8BwmF7FVfVwTQrfSqNTwXTiLVclteg&oe=699ED720"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdVLy9dyftgQ7kNvwFPKFDA&_nc_oc=Adktr8YpZunEO-KJP5eyIXRJzukS8FYJK9p5yAQTS-O73o206vFv-M3uU_omqot_AQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvltqpealJRZMFBsaVgc-4jX1nP-8ZUY1uMKIP7VHuRXw&oe=699EE107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJN9bsPsbdsQ7kNvwFlPWEg&_nc_oc=AdlNK_OCuAR3OTzahAJ9Mjaw__1oY1j4EpyP0a1CsFzZS0QMzbtqHBukL9aM62GoAW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsrezgblGFCnRp2O-2EWygUlyolquE2IWXXOJg5nZRjwQ&oe=699F0023"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
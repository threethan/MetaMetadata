name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibVN0GhSFc0Q7kNvwFjsKxu&_nc_oc=Admj_HX3_82x2hjid1Vt3CGPNp9te6GxXEbOkjuh-HlkH2c5abkFBqYDBH-ZRLrp40U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvsyT_vdj_a3HcK4WYl_gZ6rV5BSCI60j-71vMGlRD7sw&oe=69A81462"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9QIpGiGj4cQ7kNvwHhoTmH&_nc_oc=AdlzfDLsJDHlcJOgr3ek0CXjLMn9REHWZRDqMrO-XBMDLq9YWgSxipGz-r-XYDEm1YY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTLZqD9i6Vf9HV_jrC3yG-nwMCA-qpr77uDFKe0YUTRA&oe=69A818E1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YVBO9ZbGNwQ7kNvwHt0SmD&_nc_oc=AdmGnQ5twogXRLEOEzTPgoveHqsMw8tNpULYuMaqMbFUhaWbAD9BFLg6Jxh0ZRTiOHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0443Zl53QW99TA79fEzCBUC79umVRvdAo_slc5RjlEg&oe=69A811A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWBz52BEA1gQ7kNvwFu7ogr&_nc_oc=AdkSWPn5sdHwKRIH3GusyCAsQ4hcy3vS7q7rBykQXs4jzPvnRyEqsMExpvR0IQnCtg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvZ0N5P7-jb2lhftcnE44lm_zEnkLH7h1tz0gLqRF8QtA&oe=69A81B87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxGypSFOg0wQ7kNvwFwJ-P-&_nc_oc=AdmFcqRPxmbOAbPe2H10X6LMA2CMLSoLvjxgS_FSVU5IIFL-1Io3P-OVROxSz0JGUGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu5cjhI2WadHzQKl1SxwIMWXYuMWB5IT2bcQhxP7HwaIA&oe=69A83AA3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
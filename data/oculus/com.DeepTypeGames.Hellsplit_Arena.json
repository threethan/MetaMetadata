i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKtJ-937pVAQ7kNvwGp0Wb1&_nc_oc=Adp4NMiBKXjHJ_o9H5akJEAgL1MlZ7OmBfWFQYktq8-ML1U3vgvBqX85PTxQfow7p6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pqI2rgCblaCDt7m33_F1uH7IcAOvumKL_4Ec_-QcnWQ&oe=69EA3408"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-YmrslMSZoQ7kNvwGt4N75&_nc_oc=Adq45R23BsjdUs3PmS-q-wPOqIwAgwf0WsxeBRCJT8LENfJVjvu0sraJH4YjQmno0eM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A4yoXPQMRU4CP6c6iC3FTDQwAK8WQSfiqC1A49FEsug&oe=69EA268F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q_ioqzrZzAQ7kNvwFPWzRK&_nc_oc=AdrDfkYxhxvpZS7f4nG-MbhZBSRiRQ9lx1TxsvDy6Z336t4LUoWJIfU7N4gND0mnOno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uR-Jung3SSWmLVdvX6yTlHqYfvISbb-laaMV2DKDieg&oe=69EA145B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDY-VH7YrhAQ7kNvwETTSuk&_nc_oc=AdpYdgMFZMBa91zhzP9v12EoNrruuzIi5ffRO3g__xYe-5VHgBOK9L3YS21yfUrrCyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-3hmQbsKhm7ImuTO0G8bV1vT5KFvjp3e3t52AQfzAAQ&oe=69EA24D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Ixyz3Ld_sQ7kNvwGkNslc&_nc_oc=AdoD1jAlLhyHylTCa-agMN8afEr1L1SLv2ejkSF_JnM4giUO81ZcTnA8UTLFVzf2a04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vMpE7juDZVHRpJX4XYDIC6XIF6IaXQck8zoOnxMAQ9g&oe=69EA147E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
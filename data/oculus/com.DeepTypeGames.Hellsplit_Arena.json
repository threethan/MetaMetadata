i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FXf0icxiW8Q7kNvwF4XOUc&_nc_oc=AdrOXdpT4qpqDfhJtHAz4S-Wwb6pLY2odM7jJ6ByX8XahULfAfMskvqZneSoxlm-pUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99VJv0vpqi_Xe0VlVCAOXkqzwhCYEIC9yyqnsTFzD3mw&oe=6A3A9F88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX9YL9wF79wQ7kNvwF2XZvf&_nc_oc=Adpm04bfI_-Vw4guU40R-KE91V-CuZU3LGYJGMVrLBDDo7IHWpRgs5m-qyzMvdJiS9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WhcixeiDcduqegsyNuLoD6fmZ1IciuOugMZAyUh90Sg&oe=6A3A920F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J06f7SxsCZEQ7kNvwEAHT0O&_nc_oc=AdqnOAkMTNfOvAB_nN9TJcqLFULcRTjSXspCHhSPehDmM2QOybq3S5_G8RiL7VM8Beg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96_Md3y1hSfFvd6LVVro8EtP1ucYFcyuHLXZSO1CyA3w&oe=6A3AB81B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHz0c1UU2N4Q7kNvwGElOTm&_nc_oc=AdqbZ4km6sa4nfRfBEsTlY0qCgA1GzahorU1rbk7wd3si0JZsq-5D4au88qPSLWQuJI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YSPjpaE5Ky3F9ZGBO60qYSW90-7w830gBXgifBLNWEQ&oe=6A3A9058"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOIzjH8c1foQ7kNvwF3Weoy&_nc_oc=AdpfPZp5QI34qCC-2UXpavXnBmRgUDIHe2Y-AT8ec0l4mbbhr2ZuP4H8f3G6cHlIKbc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Uto8F-NVSBdg_Xqcibu2HCuSPwwALElM83QjZj9CBKA&oe=6A3AB83E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
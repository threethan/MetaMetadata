i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2VDTIQ4-6YQ7kNvwHVTrOz&_nc_oc=AdrMApcwze8Y_74KBg9P-qT2G-VuGcB1zRuxll13LrJaviJRDKdQkslPSBrb3IifQfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S2tdl0bABOwmfgaazP6tmBGPRpFpuqmC1hWi0IsueMA&oe=69E4EE08"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhVDPw808iQQ7kNvwElrqh5&_nc_oc=AdqFEbb4ser46JlXP87t-21yiwJUgTFNjyd7JGml9zcWnCjp3QYXRY20sB17ekuix0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_fEBF3n7pK3psp6erMDstKIf0CorpqKNy4R0GV2NcLw&oe=69E4E08F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWJR9_kMu1IQ7kNvwFrWVF4&_nc_oc=AdpMnC1SQGhCOpkeXdtEe8N4IeXP5PMaYztkVk_avpN8JcXlr_3C4VOySN5Isl22Y7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RWFs7DGqH6Mj4gB2chbCFrwVkNV45enZdWz_dEmKwbw&oe=69E4CE5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSSyKtUxBgoQ7kNvwE9HQx-&_nc_oc=AdoNpyASNfQpyIkFU-eDxSJYWxUFAnxx9_EOZpFDRANL_2-XcB_ejdgOho2jUK8Uccc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Fo_34PIv1044P1EF9rmF7751ItjkUvSYAYeXWbc4x1Q&oe=69E4DED8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuw91EMSSxIQ7kNvwF0AJHy&_nc_oc=AdpIRosTvSIbm2duo0OKYNJT13OWSkrd8i01qRDvaxmpPg89F7oa5Qs_qpwCob3qXEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pPgbI7b-_eZ3ZKgwXsbDTS-oM5wDBhju9B3__9fB-6g&oe=69E4CE7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
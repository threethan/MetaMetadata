name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n09n3nZh8cAQ7kNvwE42rkr&_nc_oc=AdkKw6-57ZzGvShe6tWwRaeouJaQHZfmku_Bz1aozqlga7YyVReUr-y1x56dSmxPYCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy__JSP2YD2jo0TGk_iEsVx_RL1UaXO4wXc3vByg5U2Nw&oe=69BFCF62"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_pEnBOn1AoQ7kNvwFRm2ym&_nc_oc=Adnfo-BF90qv-c-tU0aBLSAbXTniHCurbPLBVWLoPzxbFip2vFYAprfsF6WlP1zxmWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1_ObgU38G0QOfSA8ZdGe6HkFedQv3m2cLfFqoqAFtCQ&oe=69BFD3E1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JZWJeunCFEQ7kNvwGznAkw&_nc_oc=Adm84qZFrNMpPBTZqp3TbbwnI7OAAcHP7hEjdFrRH39QLkojgly4myGq3USo5pkve4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1gjbX8H7KPlLPbQdYx4vHBXEOyew_mjaXp-U_2g4gRA&oe=69BFCCA0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZOYEdaqdSEQ7kNvwGLKBHx&_nc_oc=Adl0u1XAmPRrpj2RfmbdtGyCGf6sygkvl-Xgjb20oXP9s_KUhYxNh5FWfWjE5wp9Ai0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHvfABRJQ7r-und1NSjbyxeShJtXj_vG4i-DxwoLhxUg&oe=69BFD687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwXbZkGNMMMQ7kNvwE-U8Uq&_nc_oc=AdlBfwd2iYQpwDujvdyFGSzL5cOKKbPZKFJzOjEJ4iwWO55Wda1X-qsZb4ICw1zex6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4hju8ymQAtowAJBz45072EF-unCk95UDJmpTdo_NM_w&oe=69BFF5A3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
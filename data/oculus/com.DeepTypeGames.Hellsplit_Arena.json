luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7NrHPYqZm4Q7kNvwFF-pny&_nc_oc=AdkYigrzX4srD5LCvsi7YvTgiglK8yntL2WTugExgpXLGvoQcst2J9kQTeN40m5C4fU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfushtsW26omAQD7c4EXZiR9lcqcIGSUplUj3lNbTG8Ijw&oe=699D8862"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMyEvHY2EdEQ7kNvwELheo8&_nc_oc=AdmXTh-ft37u_xFwIumiuDMMcs7nUFh5FqpMjFQzphy37e21Ceue2dWmE95aN22tiw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsgU31U7gFk0m4yHRT8eJNYF8GfqL2_Os5ZPO0UJngX8A&oe=699D8CE1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H_a8Fe0uJ8Q7kNvwEpbgJW&_nc_oc=Adm1t1QBXuS3myGR0TwUjiolnp99jecqXoJlC3QChhzOeb2HpcIdKc8-LD64vBHQZwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvqO1WwRmXsvrsIqjDXPZ1ex6fwve5AugmiSSmkhsvGg&oe=699D85A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U26mr-CD5UQ7kNvwGtqndg&_nc_oc=AdmNdiISSykgHwqyTA82R93UxcoKW7VMBRtnje4cxx3vvim7EU-kMiFEQ1ASTiOst5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftcw28Uqms0Jdu6n3tgWRGrSFz-7KorgzMH2dgpqGltGg&oe=699D8F87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJN9bsPsbdsQ7kNvwFHDfiI&_nc_oc=Adkb2zHdtyqWHwx9spM5UmkhVjntUHms_EWtVM6tZ1L_Xg2rOZi9TfbFUVHp8lmmu1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCchWuGmNRhASiPaTv5wFnne9C9aOTp4SP3KBuA7w1-w&oe=699DAEA3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
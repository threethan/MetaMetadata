i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mckJJXekCF0Q7kNvwHvSxuI&_nc_oc=AdrMyyCkAGheJiiV_ywbs3XyfvwpqAna4OsCmQ6MSbHDS9GYBc1GlF9xytRiWxymO-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zDuuQFzDqzLxnVLIsTkhChJZ-HTsnQPEM9K_Y0WvAPw&oe=6A049208"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiP-VmEIBcgQ7kNvwFPEX7d&_nc_oc=AdquTmxS4wjAuS4HS_1ppFPctCGDuPAQs_wQ8INiSuNWWW9ugTwnx6dTjUywpIuMyVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KIxg-thzGpvOBxWFO0dWqJuPIPT-hC3ScSbcZbqZAvg&oe=6A04848F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGugw3XcWVwQ7kNvwHgCE5G&_nc_oc=AdqDjCq78zipxNjKm5FPd5D2NREi0d749_ZnZHnDAJzG81jRw8ehNKqywvo4RqZtPSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xOI2aC1jiwuCaxrohutDmq4VAlYQgyavMsDEmMb8MfA&oe=6A04725B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjqKIxWj7UUQ7kNvwFD7yfG&_nc_oc=AdpiCy2_Bcdvhx5Q5BoBInanOiuUAYxbObaoz848f4oQgHt8-IDFDSyp9q25AR5qV2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79Lx9GTBt1R19r0fwVK4ZwPEPcl8PJqGGSWBthU4aJUA&oe=6A0482D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24jClwd_PP8Q7kNvwFd6RmX&_nc_oc=AdoztJRR_3FLnAEXiUgqbFBdPigPDai2udcyCT2pWkfHAxBGSd8_fYs5E0wG8uqgjh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h2nzK6GpSQX_HX6mKuH0ztokKj6gf0eRgiJoimxFfEA&oe=6A04727E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
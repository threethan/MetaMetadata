i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cxkloqGvTkQ7kNvwGH9pUI&_nc_oc=AdrjcheqICjtFetJzMHAgRmCKGAsSB7UXYUPuV0cw8QjHsjl9wczdjWIwNhb_nr4xcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDy-vT8iwWe51t0jEOmUY6os5bp2Fkdy-izT5Mia9vtQ&oe=69CCFAC8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsIQj5qdx3oQ7kNvwGibnIy&_nc_oc=AdoqVoL1ZYPqozVxms5GvmX0pA6eT8uY5vL_fx5lInBaL1N08Py0-e6M0-1Sw1S1Hoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyeql5r_mI5AbbJReatRI-FvK2cntwqEmxAL-yZ14Wwfw&oe=69CD258F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZcFJGOqp9sQ7kNvwFISct5&_nc_oc=AdowOoDTFBog1pQcx5bWnY1cKtIiDklRrEqjY0EorGhrJwerCYH6_trsLfm6ceCs5J0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1JViSeaLeRymH9KSsGP6S4ctRzVOOYTXk7nvsVF639A&oe=69CD135B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9nqYmTxDjwQ7kNvwEdvcHh&_nc_oc=AdpEAfyA1YU2icTsTwaGCJRvOq906yEYba3ZhzK_QUP0l9RkvqeYrhnxu3nD1Rjj8-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1sqvpa8CXbi8PFFcmubR-WnJXnFlmKrtUOcFs1PL9Sw&oe=69CD23D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmNER0_ZcJ4Q7kNvwEYRzeU&_nc_oc=AdpUlUEF6XDMZEX525XignaEKD1EajOqHt5dS64ZKhx7n1Ov31qa3eH3I71e63n0p4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjgTxzsRC-tufZwhK4eYwLbi162yP7YichPLXtnTQ6eQ&oe=69CD137E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
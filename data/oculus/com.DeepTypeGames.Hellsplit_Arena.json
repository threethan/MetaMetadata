name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n09n3nZh8cAQ7kNvwE783Ls&_nc_oc=AdkxYYLVI5J9JdYXFkUb3FvrNQLx24MyKdg4Fz-vLD4HMSJkXmiYodhlJBi-A71YmtA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztG40vlbqcUZyIfZPwr-SaInXwi8BE3hamCOHtqf8prQ&oe=69BE7DE2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_pEnBOn1AoQ7kNvwG5L8Z5&_nc_oc=AdmLhkrYjpC8L0Y0RnzThwqVez6opxtKnyI1zmb6i_63Ts3zUtpjwMfKiphVS-BRNGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLccpc23QR2T0amfxKzr6Nq-xqr1-xIsP_jxqAa05eHw&oe=69BE8261"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JZWJeunCFEQ7kNvwHiCTsz&_nc_oc=AdlYC8SMe1FMeZdMcpmgaE28DVH3Ks4QrXC1FXV4Kilnvby2z8qBBF3DqM7hQeN9H1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWxEoM6TrZzEUNkchm7gaaBlkLD6oRnbebxaEu4tWyGA&oe=69BE7B20"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZOYEdaqdSEQ7kNvwFt8ErT&_nc_oc=Adk-icJlH-vtbQeL2_Becyk0SOs9WUTzLWeJ8XkHko6HC83r2AuMtl9IfDz7H7MgVxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzStQbJ-ysPmeh0jeK6GtIwV7ZmDgWzs9Jh6pX4qCjeIw&oe=69BE8507"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNa7swMePAwQ7kNvwF6uTQX&_nc_oc=AdnmoVl5kU9EDMcIZSKhutxlTcyq6_28hT4t_Ivwvm8konQ-8wHaTb1h8wp4EmK5ILg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZx4vTj6yONaeDMFS2VYbHH3-_LXb17LS1YPIDkV915w&oe=69BEA423"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
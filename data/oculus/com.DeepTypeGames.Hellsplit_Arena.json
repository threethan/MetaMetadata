i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=024fBdVjPYEQ7kNvwFF6rGR&_nc_oc=AdpHrDGX7Eutt9hcS-MgXYkeMWn_smgSqly6keK3yQZW2RPCWirTHGj0_l1mYcIPmYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G0hAqziRzYPWcgqrB6-WMKVLyatzE4RPgu1vW3FJRtA&oe=6A258788"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0j_K52ZcW4wQ7kNvwHnAlEa&_nc_oc=Adr_RXZvq7NH-jREbrTd3ljE-EilIrPTFjFGo92tBsPJBwTHu_CD8TUELs6CSdtEdlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j44nAhhewqE90qwymlkIH7Y2BiYengG0X0V86AlzMGA&oe=6A257A0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdIaBg6ZIosQ7kNvwFgaWz8&_nc_oc=AdqZHrqpc3kvioBfcEiErBOn97yFYp72u5lRu-_EgL3-EBoZ_o9EHc2_3SLQo-9iDB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C3LEClCdBV85tgnWTVeAbhzR-I8wedOQYdUPeXcMLzw&oe=6A25A01B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmiBxIzm-GEQ7kNvwFf19LZ&_nc_oc=AdpdWu6sU62_2-C8ohlJFtM0qOX9WcngC7fD-ja-bbiRkvrFankE9A0Ik6rWGJMUhHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pei5o5MhCaRBKYipGwbHJW4O0FU7_l6aQ0nluWl1bUw&oe=6A257858"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4hWNGS8ZuEQ7kNvwF_pwAt&_nc_oc=Adq3pvG92Y_KbLyHaiA1tBBgOIiJUfU0efrZhRiuxtSczHIOBzCOKVJkS2TpxAJWQl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MaPrIhTlz6P2gusjdKFca7wWEh8Qb0ewLjluUa96sKA&oe=6A25A03E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
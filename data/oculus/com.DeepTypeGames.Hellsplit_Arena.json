i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzGorBbcLzAQ7kNvwHcny1y&_nc_oc=AdrPSNJjKv1oNa_LVJHV3p09rUjb4qCfcgyYwGdQfdfD_3t17qFP-OBgN191Kov05hE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LpJzkXOQoi515DmRM2ZkPPFaUIeJvok8H-qt4AHWF4Q&oe=6A2D7088"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtcrWkG9GrgQ7kNvwEReOAQ&_nc_oc=AdoCTKiKYUlYH8x0Victd2hkIgW7tNEZiBmE5w-QCsVg5vpbqsmngnC7c_3n-yj07Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TvkXwpIo-rpcaXCdpJPMJzljN81l5UnHDG9Q5_7CQNw&oe=6A2D630F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDjHFjmWDCkQ7kNvwEu3c9m&_nc_oc=AdqcuznHHaXXFWcJKNk13e1bnyrH4q-QKsFTpTBDPxkSfsx8QxkRYyg0o7EVZKoi8p0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e0rXyiMlJdGtDXT5oB9OxUT3tFSxBTUTxCsfvA8a24A&oe=6A2D50DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZujIh3r6BOEQ7kNvwHljqZ2&_nc_oc=Adpv0MwcPqXiaDFTf7pkgle74ARo7RIAnTeX75BpaTy3MMFDqC7D5GjVYyaQAPJa59U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92PiIiFVPmdF0v1txYKr72y-K_ceH65o-azeWxxD6xVg&oe=6A2D6158"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2qTn8vCbLgQ7kNvwGGSHX0&_nc_oc=AdrB2lsgSPORYZelAJKFstYBvpV_iQZtKBJrKDDK7UGz1PrGpeSZ1FY7oXztipPOWrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90Bl74eiNisWIAAjIpOyS25ulzxoP0wfsFwKaQeOFtDQ&oe=6A2D50FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
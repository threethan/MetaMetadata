i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ge3vTjxGLAkQ7kNvwFDl9dy&_nc_oc=AdpPJAavkboepDut-5cTejVR0UTS_TSUjyqG4OphRRFleWbmWET0srOkrPZqYd4_vck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05huD4QEFACxzamq74Gx2HQe-C0nFMrxEddlzDl1HAOA&oe=69DE5688"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOayZ_owF98Q7kNvwEvZxjc&_nc_oc=AdrLb5NxxxE30L3uPD7bpG8CMAypMtveJ-QapC52rWsn39Jv9Bta_WpyUzbc8sKTUso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D949jEcfu8GZuVt_MsZ5ZMt0pVvJdndQLPKMg8urLvA&oe=69DE490F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WbqmRTJvSUQ7kNvwEXVcZ1&_nc_oc=AdpK7NugEAiqC22FiqmSu8-zWhbuCg7hpPoXrFetaBajdDxJT2wQrxfLj12-znymqpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31D7MV8Hhr5kXWcMHh7lk7omHPNv4PMOMm5bAgah-OYA&oe=69DE36DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GM6vOR7MQR0Q7kNvwHTRLSQ&_nc_oc=AdqzW6RnNvCv5VboRg-SrsfA3VUbw8ZsEsgDbJB6kz4tLcZsylaAwaNZ80AJwX2Q9zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UKXHTdGIoz_2p_TgGn1_LLcy8IfxxV8osmS3NwTIP9w&oe=69DE4758"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv48XvmlNZYQ7kNvwFmNOv2&_nc_oc=AdqZeCovn9gKOfnWNaviWmIB7_pbTvi9XuOBnWRMqUyIk8w4yZONnlZbucTy0YS1Vj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QudsX6U89i9PvMwPS1J25rltOsEBGe_YhINiK1DG5TA&oe=69DE36FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
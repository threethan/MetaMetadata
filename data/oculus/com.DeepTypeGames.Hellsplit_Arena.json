2395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYqL4XRO9IwQ7kNvwFGPCjG&_nc_oc=AdlP3pUdh3Xe_kx_6seDBMYxDnW7EFxHqtMdM93YBWLFhWxlXeTKjYju24unEq2Nas0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQnjz4pUjtIaHBmcJr-KBwvWkUWctOl_71pfTzPlHvvQ&oe=69AFF9C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gohivlv_ScQ7kNvwHrA17U&_nc_oc=Adkh8dcznWHIPW5NUTenRVolqTrCpbZ8Sl3I3LX_C82rySMAzeHs0N_1Gz_BYYQ15QU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzuc4nl-I_s6FQ_HYcFAYM5Ou4oWRszGUdGAMyBRKg3SA&oe=69B0248F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLRml0WS2aMQ7kNvwE0hpDk&_nc_oc=AdlYIyLa7qWWbLJRiip6hDD5rw2MgeH4_tDjOekbcPtOizHAgAlqe953XpHWWR2QNe4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCuGLT95s1CC5100SVQO0F_AAzuSaMnZrQwanPtps8CQ&oe=69B0125B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyaX5TCfq04Q7kNvwHSwXZS&_nc_oc=AdlBlqqEXhUYqs9Fjco2Y0Jirq3YbyABwXmV7mPOFIKzkzajMXVMw70HpK0s2E0tto4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLxhYU11UPXTKkzx2vdXOEylR14QW4T5zQYgQggjN0yg&oe=69B022D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AFhxMN_hvYQ7kNvwEoheC9&_nc_oc=Adn8aAjNvCMH2GISKLwPJx937bn94dmbQ-dEGEFleoVnr_z8ObBMz6LjiizKJ1ZVIvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxq7NvF7yKHaoqjCNRGRLC0OqHoOfbJ6CGSb2djsM0nqw&oe=69B0127E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308
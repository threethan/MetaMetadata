i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U1E88GTOAIQ7kNvwEWENQL&_nc_oc=AdosOsfYCLHyiPnIGJC-d6ZibbjfYO4oQ38b2cHnOCTwyZqnvlez2erQysJ5BvhSHTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Bvh-hKROmHQsQuoeHYrxGt2jTVFrVTYKeuhHAQfREFQ&oe=6A355988"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzqAzXjhLRQQ7kNvwF5EWrW&_nc_oc=AdoKi25T_2H4ka8zTXWlA6huK9rDLM78boyUUGn6pNCgAd9n4W7_ZcCAw392RrcOKpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7xrD1eV9pF82zRtYY7Y9vBsNaGjUowi-Q7yuwRx3mDg&oe=6A354C0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-QVFDL7XYgQ7kNvwHXQWDI&_nc_oc=AdoFXKNnPNnvcT1G5nP5lJJEC-HGjmvxgRn8TRxuZCjyghSzN_AsRrzeAnZPnOvPyo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2zqK7BIlqC8mlOJ-KbS3QuzR3OZJr9_qEjtBU_Ala3Q&oe=6A35721B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cBM9AW-LigQ7kNvwGY-O3x&_nc_oc=Adrjmfz7CygcXVcn0B5H6-8tB_zjZSD3RaRLv5UbE5HpiUpT7njkyd1_MzFfzQydSQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NpIdl4ccPXEQ0KNaWc_k5Dy1INkFoz4aj8NxyjXcBwg&oe=6A354A58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNSdH3njQ6oQ7kNvwGiUFTF&_nc_oc=AdqeqUzQGov2OoySAZTFwEU22gXs3PHUGhJH2Oot_LtjtHTKscKoBxRfaONXfmFTzYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d0hjVF5GlfyCxYv6XlGz-lu053VmNzCh86JhzwMnalQ&oe=6A35723E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
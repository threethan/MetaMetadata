i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blhr8_F92m0Q7kNvwGyKDqm&_nc_oc=AdpVexLGsAcJSQ42SzKYMHJrXk3onhLbofoTSzKIVuHyOeejP1mxGavbHLbgRtBogs8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LcT4OMbXmGwM4py_WZLzCuMCPX0YVvBOJUl21znvTPA&oe=69F8B488"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l00MkzWdYLIQ7kNvwFlPFX1&_nc_oc=AdpRWg_ZD25Ys6uCd_wZnbSmg_4tIdhfhjt-26YbKyp2VvbZINlzigtuTQ11qepaUdY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_trJAfm8v8A2Dk0lINmC_RsXWpgENDSp5FdXM3wLE9Q&oe=69F8A70F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqNO0PX6IzUQ7kNvwHB-2yv&_nc_oc=Adq-DCewyv_HNYieg00H_3Sv_a9aXjwfA0O6ltprv6nWwGWE7mxO_2gT0moQ_jyWo10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CdXP7B4AQSYZ1Tn5j6R2sgWSbBigDssONhw1RxydYbg&oe=69F894DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rom01nYSXQQ7kNvwEEOAgB&_nc_oc=Adq7w4rIpmDUbZYmdBCUTpH6-ufR9qYnvNUlsktgCF30l7kHh-E1UW9qMm3cqUwcMUc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SUdEw7o9-JekUBPc4SOMh8YrWa_70xGMv4MfnG9Tu-w&oe=69F8A558"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfVbXZDB85wQ7kNvwHL3Xsf&_nc_oc=AdoKi_MXeLIRIwhfismSkwbZIjyJO6Lz4Pl8iP-vyEEeWdosO4t3aA3iTN4eW1ITRjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qF8MiWuLhxg-fXAjR3aCBAqLxnPfPpvTcHMHk2STWhg&oe=69F894FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
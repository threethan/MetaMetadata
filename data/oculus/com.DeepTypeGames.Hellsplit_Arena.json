i": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyffLgfaC4wQ7kNvwGvm79g&_nc_oc=AdpAdC4RZ7htJu9tpmPCVB64PANdfn6xF3DzLy1BjLRyrMVc3wsmcQACdgGwW2q9wDc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10Vh8DeWtRO5yZErv-rSN4TS1S-st4TBMGL15xGfFUOw&oe=69D39248"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaZ-x8brpZ0Q7kNvwHeelva&_nc_oc=Ado5zs4lIzLJ882b_ZVGggyBd87YU4ba0WU9A53KEK5ZDYTva00pS9-nSeJ0_2nTT1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oFxSU7FrN2-fbpwKyI38V7JZgrshjy_NZXDOZFQ1T6Q&oe=69D3BD0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncaZNmpE2ogQ7kNvwHBhpiu&_nc_oc=AdqW3ZGV0w6uXlcFGRrsrj5JLKJ_U9SJok54GcakQhaAxgbwFVP5cdTSv_gH5WbKI60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nVXkUhAuxiCNL7TArjJx8OKcdH0CfRI459EpAdJzeSg&oe=69D3AADB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8GRFcGK1GcQ7kNvwFU4r-H&_nc_oc=Adq0DWAZCurHO1iYiivtidcWK6k1-h6xpkql1yL4dXt0Ll8dev8lj30NGElYJ8IPQxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z2dbzM_m3AGkoTkS3Xq7dRWPQeRPVgCiIPHQnthaN5w&oe=69D3BB58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiXR27jZIB8Q7kNvwHIjtQH&_nc_oc=AdqhXX5tK-YyzrLXhhN0j_Rs1kGRwtpC1e3BP92dObfzZO-0zTvRZ_IpqnM9ZecGa_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F7zM8hzKgXmwLCfQIgB9ecGqKyq0Bdiem5kv394C41w&oe=69D3AAFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
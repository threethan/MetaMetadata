i": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URTZugA5J94Q7kNvwGAbpRq&_nc_oc=AdrlvYyAkt1wBW9AJ47-xjxc1eYUyoJn21DzT_9l2HtlrcSPocdze-VBgbIlZeaK1ik&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO95BO9VPC3QMEPlX7dbytAUQvaEPrR9e-z-LBK5laPQ&oe=69C7B4C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOuf26cexdUQ7kNvwHnp47m&_nc_oc=Adq63ZiLBd-gsug-3_EOUxtEG4bn9xB28zVXR_8C8oPs2eQ80hrNtK9c5uZNN1IqK1Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4oFuUPTPNZnf69f3VC0IpVg5i8wTFA1Mc59Ie1cWbdA&oe=69C7DF8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7IeqX9BWA4Q7kNvwGLdJMG&_nc_oc=AdrB1O4EBcVlwXXU_GBbYY7mTZeWlx1yTRAt0wdFFCp5JYcgQjlehhHxedvXOA4hVak&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJsZByY2z4EjscTXzSgpmInkQwoOs84W6htmrdJqnlTg&oe=69C7CD5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o57cGis4hpEQ7kNvwHKNUes&_nc_oc=AdqXhX8ctywuMJ2IQ3T609_ZUOvqwEMNavgf_JYjx62bQi-0Mjgv0nTRVx2bcQWqL6w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkWEQv42d-5BcqdmCTsjWgo6hV_rxsc0csQP4_Y-UbNw&oe=69C7DDD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfke2Up8OtwQ7kNvwEa-Z7p&_nc_oc=AdrBX8T8l8tXUuqWUVr9_depfddP71M1_6YTLoZME0h0OP2_MeSDRiYV-_hX_5agxVc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxLo1wk6Vsvgt9UwLUFa2ROkNzEWBPFBdVYpFRTFvL5Q&oe=69C7CD7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
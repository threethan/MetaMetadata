i": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNRz5GZz06YQ7kNvwHrjVn8&_nc_oc=AdrCY7n_GgadbumFgwXANx5Wb-pKr-Wvp7Kc49dfX3HypolzEUwzJ62LUcQBh1bLzcE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzjt1Fb8GOgTKpQDn6mEc6JXMYIpZH_p8h3sZV85Y8xxg&oe=69C26EC8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbZPKyOSswYQ7kNvwEUCAoU&_nc_oc=Adp2mPE_YOKGVUDr-317P9WWFJUIbG_YUuw2l-wMzT-Wsit89d9Umz54oP1vP0KUgrU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx987k3JPd6koAcBAwXvpf3REIWIcYtbigsZVr1YwpXtg&oe=69C2998F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGrKnjkyukcQ7kNvwHN26pv&_nc_oc=Ado8eDxtjnZwxHKtOsfkDH6SCWHiI6ToKi_QnBtLID7uOm9vfgUJQJaxIx1sYoaQ-vs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxbpumygJpaX9hShfLIHQT-T0qN8qlFrFa34OLlfeoLg&oe=69C2875B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jry5POghxMQ7kNvwFp97fK&_nc_oc=AdpR78P9HQbrXc3cz-1BETPeBbg-Ej79vIFyTDc8e2mZTNVImnWnLwgzMW2MGMH1dJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHPbsY2rVoLVteDFpizsgUYOU9hP-Gpqnm6FwZci5DvA&oe=69C297D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMhnzWqO0ukQ7kNvwH9c5f2&_nc_oc=AdruN-iFRgtAwsoDRNt3JDpN33ERLkRMfUh0TI2Nb7zmntfpsU6t26j6jIgMhKPd4d4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNjCtSIfzHzFtWcHAnQ9DNJXzbl9Teet5wN71Z_0YJTg&oe=69C2877E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
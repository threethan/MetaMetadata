i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT359jEJTDoQ7kNvwHb1dg8&_nc_oc=Ado87f_A0zDAKh6F5aZvplJS6eNnQgalqEc6-A0FOBvd6IK_ejf3F74KuWzJXnbeEog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CeHOwd5-42hujSqTpkawPHkS3KDYLZJq01hdsczrlvQ&oe=69FF4C08"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxNeFUQrYGMQ7kNvwFI7W2b&_nc_oc=AdpCfpiESvZMAcKynxTsM0nLsL3toxp8n19JBoobo_tFb_XywrUmTKdVf_stuaYvSZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WsW8su7YyM8T_0L7c-t5GVyNKpQJ7vlGcTLgy9Mj-yQ&oe=69FF3E8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5ThfOJkqvQQ7kNvwHg4k3f&_nc_oc=Ado5Eejy-CAsAEAoG80GPChh_nnocZakcF7SA0ciavmtS_QzcnucY4bwSW8CwNZIxEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-nEPU49Er_HMuG8ZlOFOZo0rnGUkKzyCqglpaXKeqGw&oe=69FF2C5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zH0updgF1wQ7kNvwHJkzT8&_nc_oc=AdpSgXigEH3L2wC4-egtD2pEyu12isTfp7FJbsWcvzf88s4gTyz7uCQ5nrori2Y9UbU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RcMGYEfe3pV-Rkz-QULZgnCKBr23MeD3bMYCa4y-7MA&oe=69FF3CD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP4qIONe_SgQ7kNvwFeuaUk&_nc_oc=AdpQF5bZXK0Kw7dWXRHLZztoxFUDBEtFqtCxIPyOjXUYbXofdiE0enSrjeftbYwQQC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xnwzyhgMVyrc15FYSYsnyHNmdjPjMTVKlMeNmja3auw&oe=69FF2C7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
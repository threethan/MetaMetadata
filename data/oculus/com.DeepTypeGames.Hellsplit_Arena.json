=00_AfsJisyIrKC-A9iNkdUCW-WgeHzY8hpq5LIeg0WesV0Xzw&oe=69A41C48"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QfjDwUGQcIQ7kNvwE_DPUd&_nc_oc=Adlxsg5ju7uKqALAsObZfvw-rqDCDtU1jgyisLt-E29msfsdt_1_pGjeT_u8P7UFDpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0X0XMmEhsoz8Vov0hAZ9Rog_wxXtWHC-QziVIVDKgzg&oe=69A4470F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8bigIWYdpcQ7kNvwG6sm_9&_nc_oc=AdklMGElLN_BVtVuU3wJr5tiNfKmg_l6m8ceIB_A2Xs2mPBd-FpWm6tuonpSX0uhMgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftJcrahRdiiaOz1ZJnLNLUIuQEWxaOUrvyMYmlZhmEoWw&oe=69A434DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtBiCTHOBNkQ7kNvwFSS5vp&_nc_oc=AdmzdWP6zr5vD4qO1_fB_IKv0Rla5qROy0_kYxvF5p3S086fDt4m2PrPxvA3zpVuj-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvMQLrZB_wxVL53yjFGbdi54l14nGSOvy73q81kSrMiwA&oe=69A44558"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sP1kr12bsYQ7kNvwEQnjEt&_nc_oc=AdkUqDJWfMQgmtYDABcg6WC2fDQ72FT5XtaYG5HnYqk9--R-YSXAhS35b6u1Q-Ua4Hg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs4upTSGfpb_XzdMm25UswpdpGUmA9DSCSjb0vBJhbN6g&oe=69A434FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
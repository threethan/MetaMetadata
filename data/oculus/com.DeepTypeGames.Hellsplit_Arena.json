2395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0R_bXxDrIwQ7kNvwFBNF1a&_nc_oc=AdnQmQ2IbUl_EuCh2_YZvCbVy4FPlkTt1fY9-fgJbS2ajrEL1yW442GlPO_IWMUGLLE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxs-xaz-B1F66I9M6JNo_AkhKv7Abj1hxuIp9-Fqd9cYA&oe=69BA85C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT_aC6KngRgQ7kNvwHImW1G&_nc_oc=AdlQ5Qo7_7Ul2ARd4qoJAqEu1W3B2RLkD4yZi1dsXhsrv6nuzZhqE54W4xkb42SV-Ug&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGYsEe3gHFcsi1idHwDa5OgLI5v87f_tB8HNgIJTG90w&oe=69BAB08F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJoB6eeGX5gQ7kNvwG7-U-P&_nc_oc=AdkZ_PkxCXI1BgZm41en4rI4AHbLnsWCjn1GWKF2wisyu6OW0a6w7I4YysL_JltoHh0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0qudA-Zt85B6KxitXPwR5Sf-1hAHhitO-aMLrEuaefA&oe=69BA9E5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ccb3eyYfO3EQ7kNvwFxKRbB&_nc_oc=AdnYPtisrYDTY7PPkbvfE4V-hH-6WRrvImfqcR6NijFbK_jyCzUwe5c4p7dfHbSNYFo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxo4SgGCH_2EtHM0BliCAoDgJAw_HYeJ4ItCxkQrFj1-Q&oe=69BAAED8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcmEstjinqUQ7kNvwGnupBp&_nc_oc=Adk6yjuD2bj2fPy4rwi3WCDF9wLYMqqZc5AqN4qzPNxiZVaGtOe91WQZZ6n6Pu7YPwg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyEKOoJhF5bnQl6RIH5I-d1fb1RLWJ0Fe5nDl-1HCBMdA&oe=69BA9E7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308
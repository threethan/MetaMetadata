i": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cxkloqGvTkQ7kNvwFfOof4&_nc_oc=AdoE8OegKYofU_GCS2Ky038BaqA0mpZfEw6JRoLouTmL2MIYhyIGix6-02Tj50uxQ1U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvsvriUhqGgjTxHVge9_oUigtwAqZ_dd7KeEugDY4xng&oe=69CE4C48"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQDzqsJaGO0Q7kNvwFPOKlB&_nc_oc=AdrRh_ScITa_6rH5m1QQyUeo_RQ8YXBljeNtnJ94AMvXOunbKroziUxSf9ck9HXTc8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwp50KWeSaoRsTBlVqSHigUDp9gbW0I-Zrqj47YU_8A3w&oe=69CE770F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZcFJGOqp9sQ7kNvwFqYLqg&_nc_oc=AdpWYQMnjZo4b7DXZBXK0ZYsJJUFZKPUhQGSgwYjMb7J8vpbJWmoT51oojQpNPPoUfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwg9_AN5pn4t58aBwGoVx5U8ooJDFwyJbwaGgEDWNqfjg&oe=69CE64DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9nqYmTxDjwQ7kNvwEv2ecH&_nc_oc=AdoRvjuQRrQgfEAdb8MK-qvId2L1LTe1ZHEYB_iGuZg7sYuOCxbQAgA9iYbVB0HKtyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIqsrlauZ-vK9jD7MZgUMxr_OTe3T-tFti5TUaIEQ_CA&oe=69CE7558"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmNER0_ZcJ4Q7kNvwG9oVrA&_nc_oc=AdoxIOICRkVjAdZKc9M5DGzy36RTLHg-IJoNgvqFaPCQfs6KV-vwHd9j0jVbMp2mQCs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGZIbvf-9phbqcxxo8HxBNxsUvGaq4jzNznoMEv490eA&oe=69CE64FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
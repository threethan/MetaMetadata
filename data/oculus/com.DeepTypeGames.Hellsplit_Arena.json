i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDev14EEDwkQ7kNvwHwYs_m&_nc_oc=Adofu8W9_p5RFvjd3d0CQkNiCrlVWWG9Zjl0NhpEj6sXLsm2YXmvR33PTKrI4z3NG3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfp4IrufwVUfQFUYy-F0vl0mkJJCzp-a80gHu5zWivkA&oe=6A510908"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a9DZpyOWGQQ7kNvwHHSTPw&_nc_oc=AdoheIX2L9RDv5BC87qn0Vt1neSOH4UcpAJDeN-jX1gA1YFrpmxssJ4jLKDsgvwSbqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd_5ha1zwvW49HZztKSiLZyh3n31Jj0vMiryIEc18e4g&oe=6A50FB8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNuv-v8sayUQ7kNvwFxjqGV&_nc_oc=AdqfaCTszMoMLwPQ_xrFgjeB6g5AIBYFYr08imCzZRRTtSl1U4LTLdheNs7vSHYYHlM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBllIPk_dwoyfgE0lHoDicrGtaunOVbeKvOgl0Z98o2qw&oe=6A50E95B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQI7xuY6Ln4Q7kNvwH8xuWa&_nc_oc=AdrYwJadaAS4YuOGn5B3euk65vv1w2CEx2dj9RqION1Y6DqZieaPiJe_0kyIdlaK8A0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjHxtR2sK6A4mMy9P9YP9h7Sa19CeU0Wyja1WswW8RNQ&oe=6A50F9D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlXVo2gt4i8Q7kNvwEB78zD&_nc_oc=AdoJOU9t7uo8swqJJeBDgD5LwBi1gc_yVxGTD78CL6PRRzd571vSU-J0y_sXbS3OcU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxoyihPnhJes-4RgVH83ZRutXaw9v-AfJ8TxnAkV_9aw&oe=6A50E97E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
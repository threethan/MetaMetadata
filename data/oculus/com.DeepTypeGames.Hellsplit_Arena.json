=00_AfvuYXdC09QlSAuCW1w-XWJ0g4JQsIJAJ8Hu-1R6q_KVEg&oe=69A2CAC8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QfjDwUGQcIQ7kNvwEfZkOs&_nc_oc=AdmwpGGZ2tZ1dpN9r_TRe4lpmrRHTtmpEbqTM1W4ob9h66wlFBJyS6-aSmnGrGl_LjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs7AfVWuavKYdXGNYFPgT-h1e9cm6VfbI3FHy75fyIa7Q&oe=69A2F58F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FklCoGCtbbkQ7kNvwH5Q9Cg&_nc_oc=AdnFMCS2O3q-o_SKD3lEDvEyCbTinKS2AjngDrKjupz2ZRfbRyFAvDI-qGz-DXqmb-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGd2PTmD8NO5fwQjk8z6SqsTkjrIYUrmLgNyPydCQCNw&oe=69A2E35B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNvwRoYyKlkQ7kNvwEgvsPT&_nc_oc=AdkW3gA442Jbo1fxinu6l5HyJFijNr1GxOAXK28UhcsRLRKZr9NLcIP05IKY0UmEQzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjekAdjLDVExsQOJEaO3Ss9gsh0jkk4r83pSe4oKfZAw&oe=69A2F3D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sP1kr12bsYQ7kNvwHmSkT7&_nc_oc=AdmTRq-CJ1Tn8JFzmjpXddlKAbnVsbkQYDcvQ9Z2c6XNRCsyu5PVpO7KDJXgVDMI0ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwNh-DcTiBj05RTuiBslmsZa0K6ffBUPU3MtjV1GWtWw&oe=69A2E37E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
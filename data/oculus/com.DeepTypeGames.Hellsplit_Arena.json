luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p98SyQnuhKgQ7kNvwGWUKCg&_nc_oc=AdlGFoTBKv4tVqpE_kD3qDCO1q1RJUwlbNzH9phE6XeiFv3IOIQV1PHOI0kgd7x8uxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv74dLBZ5l5o-onlNDBVGVvd4TU5_Bvjp3nv0wIbQfqnw&oe=699C36E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l3bxLxUcQAQ7kNvwFF9hf8&_nc_oc=Adn8TSrXi88sW-dDr_umBlCPaBSllZw7N6zLoKsruHqx48LbeZZpGPA4zIUM5-ixhwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afta4Zutj6ejPBkDZMB-kow2bD8OzBFVB--uyuM3UYFOAQ&oe=699C3B61"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H_a8Fe0uJ8Q7kNvwG0ouDF&_nc_oc=AdnZIp9QitjJbHHPwYVc-SMZpMoHt_1tIT2ppuKBwJMTUzDMUv1GHc6Oa0xOwtkocbE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu12OjM7FEJF5Tsjk84T78fdI7TRxrJzjXsL3kKbBojZA&oe=699C3420"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U26mr-CD5UQ7kNvwF5vEtg&_nc_oc=AdmDgLJF38K9vv9ws5WVD5f8dHspCKxTVrNbZlwlLSXgqiVcqSJoEtpZpCqmWHBKHWw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftHetmBTtd0j8EVcRcGkm9jD4Hwf1xOlutPk5QqFGkvuw&oe=699C3E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJN9bsPsbdsQ7kNvwFfM0oG&_nc_oc=Adm_DD16ouRm5Pfc7oskpxdanBZnn0y_K_iDZY1HXv-sxQLorRTmTb6jEI3LMHF71E8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuQvgd1-ABu0xJdRWgm19ZWSgjVcq7nzhfnz1-DTBOyOg&oe=699C5D23"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
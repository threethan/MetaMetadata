i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DUel7_EiIMQ7kNvwGRzOft&_nc_oc=AdrGeB2b5w8hzOK5ta4bEoP8hYjR2bflWQwsVfxyaFuvLe2cE-8pfTc0M3gqd8WpzRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UA9MV5MS-1SEwKYpnq6__PO-yn_6TLLcw62HD6Jc3Pw&oe=6A146408"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdCEj7SfGMwQ7kNvwFmpBN6&_nc_oc=Adp2I0q5R5YAIxqaDoE0MY84MsJZVJeKW7rX_1v6KhdDmXgfFP0aDBgMsd4_Te-HP18&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49SY6bFJYlta59dsKmUFqOBeKYOnSHeBXRajOmSYNvfw&oe=6A14568F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEhUrMBE7E0Q7kNvwECwRDS&_nc_oc=Ado14Wn90ebaI3xANU8ywb79aeqPZF8ZWB7lyt7Qz9K0GlyJmSgDN0gX0kYd20W0n5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_mcL5-jW4NF7udo9-_QLJD-EZUgoF1HY8yp5O17TRlA&oe=6A14445B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgbe0R-5ID0Q7kNvwEFdAIX&_nc_oc=AdpprgOctCu0_Hvo7fEsotu_aZ1dkn7mZIvNtFsJRAgJ3WBVb9E7y7Cz-nAn6T8uaBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zCOLrWFiI-C3QB9pX4cZj6pEgbc4KgRXjMNCtIJ5AYA&oe=6A1454D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ml0ejHXhQkQ7kNvwGZh4IE&_nc_oc=AdrwpqqcgnkumnZ-Y089uwSCDF_--DV7eHtv0edNycL8Aezn8t9-GDdE12k6EkRbSmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JeVx-uCEhe3oa4Cz7n2ycpbSc8ijkKVbkyTMTVSVcgw&oe=6A14447E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
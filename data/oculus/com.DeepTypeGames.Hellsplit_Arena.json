i": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ge3vTjxGLAkQ7kNvwFIO5wR&_nc_oc=AdoN97f7byv4mMR008IBabJGc_v16ww1ebcj2zeY0fiRrZzo3TQmw4b2G60kBsvQFM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wc2Bw4XjZ9G78rK0gm3Uu84bf7_3YsHfwvXNsZE7YSg&oe=69DF6FC8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOayZ_owF98Q7kNvwGdJvmr&_nc_oc=Adpj9rAzYptJNfTIqHFwzwX9gV2-w7MixE-tYu3rhnaffluSNtixxl_vTstlONYeGQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G80JQuN5PGsarrepStpPQ2SCFkqyuSWA-L_p1_-hNqw&oe=69DF9A8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBx_M-nNRCMQ7kNvwFmad-d&_nc_oc=AdrLW6dIfwum4IXzH_TvJqYD9vjVrcZSokd4RvHXOwDsCoHqlI2QwoOJDO3kWkX3J9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xt-OM2h3B9aiA6nnNUQ06pHE9HWU0Ke6Mi9Zxq-V5ZA&oe=69DF885B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THfKib4tHVMQ7kNvwHZSIXM&_nc_oc=AdpTMs5FeSWaxJUfRgr2ey6oAMlGppL_-_WBiEDx6uUdfoBK0M3px_j-6G01BYy4opo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16yRTZhlzZJI6Z08bsc2Ewlhae6eBCTKK4YMSC9QLfgg&oe=69DF98D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv48XvmlNZYQ7kNvwHHm7DB&_nc_oc=AdoAWQdi93-TOmXIT8nYo_TU7F84Y2NCh1-pSCj_cyRz_cZ8YOq_laBM9ivuvM-1Qsg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r1-ESnn_Yh1G-YnLk779v1VQEzbvN6nrW66ZFilnRHQ&oe=69DF887E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
2395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnvhjjyPL7AQ7kNvwFZ84O9&_nc_oc=Adm0L7QqvNgrNhImUIEUkFqzb4SPPTlI_FxVRIMn7BNCEboRuBh5M1trgxdZBQCEH2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvgL7ASRyxSMSlQ7da6iMEJ8WjD4QJ63USUv1pf7o_BVg&oe=69A810C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJClwtf0mXAQ7kNvwEvGXi3&_nc_oc=AdkBUjEe3w87mZp1JC5H2iO3svBfrTnqAsqKGss0FEhKSt8PIx1Sox7NPAHiWGVcg5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu5Zyu5d3ajIy9lkK3f5r5E0_1b0fTGir6ZEBJ-x1FjeA&oe=69A83B8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBXMxF49hFsQ7kNvwHHxTXS&_nc_oc=AdkFghrP8NmYUoVQYvZ1bHley-e3QI8maWDQ2b5vFmmOXy3X_CyuxrF4w9mnOcYWwOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvEtKLVUVgb_0K7GEX0D-nGz9qBxO-HMe96b6lIWBxr3g&oe=69A8295B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50NADEIl0csQ7kNvwFYKRpu&_nc_oc=AdkNi-GMJ8rLHaaBH4eGgbEMqvaRSX4YdzrHouBCoqnqsiXHRlKfR_9QAWReP5rElaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvCou2Sw3PYtlWHv6FvjO8MszZbZtDKW0yHHTN-or65Ow&oe=69A839D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skIkio7hF-MQ7kNvwGn-2zR&_nc_oc=AdkRNXadKJBv_ZOq1ZKsR9g4zzFcoyIq0X9umJN8WBMqH3BhiOKLAPOf2WbgeioP_Pc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuXVsNBUxb3UqDUKwsUi5uP4Ta73oirjZMFuFaHBzKrMg&oe=69A8297E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308
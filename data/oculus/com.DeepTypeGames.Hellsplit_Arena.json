3_kb8DT1x3GlQm7Du9UqP589GBZ5bs-cvldm1QI-ODucxcoChNcgEUw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AihVhhS4Xd3ihSXgA79Wfe2pdsykuN0kS1FGb4hONbg&oe=69F1E4C8"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5KKoZoUN0AQ7kNvwHM1wO2&_nc_oc=AdpkSABGDuGL57jn2YZuZZtH5V7SQVMRdpeZ-iLulHGfSJ4XlPRaTrTVRbCuB5ghiEs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0wWpLZnMIpxjHmHaHGxV3QfgKn6Te6MwCqodjSfPhVUA&oe=69F20F8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw-GFeqT5BIQ7kNvwEhrccA&_nc_oc=AdotIzcTIgB9ME_WUIwrGSKRVIY5YriPaAa58923IDeVpGrsyesajMzF5EgkyV48HS4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3rBph1YZjI4J3942RsIEeS34gsBK4vHjqO-IOlHS2_-A&oe=69F1FD5B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy8l8pwXMfQQ7kNvwFT_q1O&_nc_oc=Adoi4Vd6EVLMQ1haN-uJkyyIytmAq5kjAiGY71CKNJeGIBujm1oGbebDY-Z78RJqD8g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Wjf9facAYaQ9NAJjqc4fhBCH3Vyu2AcVMr3U_zUjkzA&oe=69F20DD8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7V8Cgn99SsQ7kNvwHEw-6w&_nc_oc=AdqUGya9qOr-xuS_CujTMBaHZ2wcfP3FzZbOUT8lMOhBHkN3oxdKS0SPJc6QzShi8Oo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3Bs5LhzqKqW8NrQ66-bDc1wdphS6SL3s373KYjwsZmow&oe=69F1FD7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_
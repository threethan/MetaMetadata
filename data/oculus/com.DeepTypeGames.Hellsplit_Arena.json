i": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MncrgDXghIQ7kNvwGfHBlu&_nc_oc=AdrnweiVb7Hz9NqyJFGucVJLa0X_km7gLlFWZ0qSPGidk46yue_XMFqGRXOhP3kXrlU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qSc0pCZhQnBdacMZzjvJNfrEM_jk1pUdPhPYjOOBS5A&oe=69F61188"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l00MkzWdYLIQ7kNvwHRf2mT&_nc_oc=AdozWQ1TQU1EUwTCz-vHX-71OvJMSx4WuvC0AX1WhQIlPtlQKllIt1HULfvwRBKbJ7o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uBI62Vz2TXsIAf0fqfr3V4YKMyK8p5RaDRCc8SeezUQ&oe=69F6040F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sT4hlh0yXsQ7kNvwENig_X&_nc_oc=AdpRQ3q_4_GjXdNu-H7ICDw04F7RHvpXYg_swPOmRWOH8LzrSvsTLaVoJbrsR6bZSBE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1X1SxOMXaUgk8qC2ZGmRDqMSHAHw08qv15ddQjnAw07g&oe=69F5F1DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMZVmI9sQJ0Q7kNvwE8XlZP&_nc_oc=Adrk-s0zaYUAI2UYJ2Yt8YWfl_poeNGMXGg_FJT4wQSWmwjiePLyeZrhuP90t-AHFeQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KZdi_CRvDTAwrPZPP5Eo3kcK4jbJ99SRebmw7uu0zSg&oe=69F60258"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl4F1oUmaWsQ7kNvwE0GJh7&_nc_oc=Adoc3jpIo--bvRlcZw-aN8Cx0y9xKl1kpbr1LNEQzcT2oadMsDoMntdErIvaWTnPMfM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1r3D_z5Ioq02IgCIRxnfoNcsbnGE8P8MlUPw0UD-G49Q&oe=69F5F1FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
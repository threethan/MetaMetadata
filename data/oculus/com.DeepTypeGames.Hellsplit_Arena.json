i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3khNfznUafEQ7kNvwEk_IRt&_nc_oc=AdoYYw7H8b7GD-e-_u1AAVqLqrg2vu9PLI9FOPJfoZhz1kpWtPVI_fEX_DTHD7Y9lIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OdyaV1S1QJhMzyz4UcQ43iWJpoYv34uYmsOBukOF9AQ&oe=6A073508"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZeAhgWeyIMQ7kNvwENPVS8&_nc_oc=AdoyMGF7TVh7AlszkGTJCUZY8BDzFi3VTH7bsvNqrOMnUwcZ4cEbXahSCn2qrqDosnQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lEUn1ccVxnVFOPhDF76mTC34jyyONLISRake__nE08g&oe=6A07278F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5Yib4Dxve4Q7kNvwG1Jlyn&_nc_oc=AdrQVOUaWSCoGenRyBGZck8RXFPuO2SHZ6VNcZiZF33fEAGKZjiOR17D-Cio0NIWIFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73ABNMbaYmRS4PqSI7M6p3ak4Xjgkm6ZNEWeUEcCw1Mw&oe=6A07155B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq8CQUvlHgwQ7kNvwGNMWyM&_nc_oc=AdoafmeG64s0724PHbTbG90IBrYnC4dzQB5IarUm-7jX-FVe-JWA5FrnE2PbfL5WYLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aGzMqEPk-S_C8BwXa5HSzruQUfj691_KXXjd5fO8tdw&oe=6A0725D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24jClwd_PP8Q7kNvwEBoGTj&_nc_oc=Adpuz0vlx4pIF56ir2TdaEebKOES_P1Kw6-npNQSBAsZPLwLd-al8C94tqWOnVx17dE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gGM0HuI5wTaVEPSPyGmmdrm-IdShKtSZ1xdI9Y4DJ_g&oe=6A07157E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
i": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3khNfznUafEQ7kNvwHk54t_&_nc_oc=AdqGIxrhuv-C45qXzymIoKvPa2wZgZp87X7EmIncf15nvw4bYtsKxGUUFYjUuyvME6s&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PceKmUpLArQr6t2BEoOMBpPakMPLpILECkH0L-lN40w&oe=6A09D808"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tchn61eQ3b8Q7kNvwG2Oetk&_nc_oc=AdoJv6QYSnAW-VhMUfT7tC0ZNDJx-_O2f1asl_wPk6R7hGf5hF2yZVbmTOUzRqdtlSg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vw3l3ZpVKI7KjQoYDmjzGkihGke4wSHNVcSUAG3hOYA&oe=6A09CA8F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5Yib4Dxve4Q7kNvwGYVyHD&_nc_oc=AdohEGmzLWRLIBG3cXl2XKtF1Z9qFd0fx8HEk2zd9aNpCn2N3pHjmZoaa-dHFjLT53M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pm1vMu9U5reurdfrcvGDbcnP61pxjmv0XcRsUrwJwJA&oe=6A09B85B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq8CQUvlHgwQ7kNvwGpsfhn&_nc_oc=AdrD2S6n2ui3AsR9HLu00mwNqdXky3cpC4yumTzUbdIHXpyCC55Y761N2BTmeo45fxg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NBj39KmxXTRjsaRaa7pSdbFDuylzuxMVsyy-hw3XnJg&oe=6A09C8D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtbyUVMdRyUQ7kNvwFY6ahF&_nc_oc=AdreR9ZknFg3Er1oVVecH86izdgc7znhpL2WWLQkOn6hLE9EHo_JXY3lr9kfqaTxOcc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c3PIH57CF7PZpFfKbDRT2rtieMTVyatS01vA6dhEOrA&oe=6A09B87E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
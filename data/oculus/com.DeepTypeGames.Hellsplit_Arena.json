name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRp7KZm1slMQ7kNvwF8o5z9&_nc_oc=AdmpA4yHt9UUVYAtEqZSwYjiVCEKjHlU9k2AK3ZMkBzvFKhkyCMEP_FgWJ43VAeYERI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPpHX_KDiHjBw6YG-oRaGUuQ6zeiu7fH4dc3dZe7Ot8A&oe=69B14EE2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpoY6NpmuIEQ7kNvwHJZXvy&_nc_oc=Adm0nFcsD1nVALPSwndds3dVihL8myzqxRqfJMnNWyhfrAYcUwx4B3sp58eLrgk1sPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnjKYsJBIVRO3XlKo81aSPNT1vpUEHCzyo9R00qurUYQ&oe=69B15361"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5s0N9MTD0oUQ7kNvwEWyPbS&_nc_oc=AdloxCBVa-QFLuPituiZC--qqFWGhST1id6gYm-ol_aD4jChtB6V7t_KWsREr7Y1jv0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjWJkAAOI7znD7zu8m8DkmeEbOJoizfSkjhJALOZVoyw&oe=69B14C20"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KafSznNaf_MQ7kNvwE6REYk&_nc_oc=AdkLbbKq5UOclwfXxR417z3OY-29O93i-VLc83mR7G7rj0wLW0mBzpB8CWikrcxwAhU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfybqoUpnaNHp7mUF3jzbZPq526BXvIQ1SsL3nDH3LVPmw&oe=69B15607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-qlfJStNpkQ7kNvwFMfqcC&_nc_oc=Adki8vIo4UsmNA4WnRq4sAzuLFs20vZwHjACnJtlGl66-pkuhwDUaOaYftZKX3XDNNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvQc190OOCF73AT3INpPUtaXABCAJM8OhBrZplNRHbig&oe=69B17523"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
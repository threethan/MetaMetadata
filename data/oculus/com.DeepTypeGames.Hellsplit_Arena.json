i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUbn_IM1g8UQ7kNvwE7fBYR&_nc_oc=AdpSZRzKY_QAJD5-S_uzR1JSKP_TkHtkxJ37-v3UXr6rrOWECgGq0mFUFJXu6dIB5LI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZLzkiziEFHAKCk1TMI8ruz1epE15tqDCq8Qqea_33Dg&oe=6A37FC88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzqAzXjhLRQQ7kNvwFc6ZzH&_nc_oc=AdqTYgjvM9oa1fqBg0SCbEddHkGyLxogBaMtFK4MgzA2sDQi36g03FnflgDPBJAHkZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YF8oqcRkkeg3BL0FmLtgL1qQSUrqrxjBgMst3e61GLA&oe=6A37EF0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRhiE8FzvQgQ7kNvwEMy31X&_nc_oc=Adp7LrxztP6CXseSPpdsL86-hAzSz4jbyE4JoVRJ3DBfWegj5olqLA1Sajid_UicsHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3w_HSWRGT2aB7_iV4EwdWSnJrtSIkutOBKR7wh_O2Dw&oe=6A37DCDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwBAwUyQjFIQ7kNvwGTFsc6&_nc_oc=AdqBbA_b66-lYjPUCQ6ea5F63I91hTUDF1nPGGlM-PLWj-M4x-KQE1h4XKMfTVyd06o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JZjJfTFclNfDI5cLlLHlWGB3VwRABK0ZKIo-Pz6FU2w&oe=6A37ED58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOIzjH8c1foQ7kNvwFVDBeK&_nc_oc=AdqaUZVNdHpQshPwTP_meo8aLA3b835FTxlvHvClSCoNAsCYR5oCa0pHwUoct-4lxiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jrw-wr99rPchagG5OCy4Cqk9-ZJYJY1OEzadc-4kUzw&oe=6A37DCFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
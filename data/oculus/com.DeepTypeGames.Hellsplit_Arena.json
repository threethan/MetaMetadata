i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuTQqOwUqe8Q7kNvwFIrYi_&_nc_oc=AdpJpe09JiZZ0pEY3fvTvnrLAe-qQ3DjZL21XvwqIWAP15n1rtD00-fHVqqHCe3mlk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XAJ98vL2H3nfa6fmOa07QjREXfuRve0qwi0TrRILzMA&oe=6A0DCC88"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H7RxS6sXCsQ7kNvwE2WP1b&_nc_oc=AdphF9nr34I0bgtEwbdfosm11tQ9hN5oVoLR75JrSeIeEQjyo1HENkljGfk8qjXx4Go&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TeKWgNt4JODtyKv_cyj0aRC0R1LdS9G366yJ1rq8BMg&oe=6A0DBF0F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb6Q6rIXrg0Q7kNvwGXNK0x&_nc_oc=Adofm_qW6zwuW6Zls1gLpui3kdTvzE7lwjCgblf7_dyJqM-xN8HEaqSKRyYVuED6YaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ObratkHfc8-Wshr_OR_zYFQRWjG3s-G5ropBhzEDYNg&oe=6A0DACDB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXTl3hMW7fQQ7kNvwHD7DUW&_nc_oc=AdpM08lIllkUbE7zPjMsMP107WdJ6vg2d43fmFvKaqU5ib1rPqNTK8s2JvjyE0Q_Ksk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R86b2TFEYNuyZwzNw36hfa8pqOYlRvjmkhwGUUiRltg&oe=6A0DBD58"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtQJSDj7-pgQ7kNvwH04JUj&_nc_oc=AdoWeNN-xd3OOwkYVTlg61O4ElnjBKy5gc0LuwU5mwIJ-BfwP5CEn6gsJ63fSYnhckk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71peMMp00ariEuSCCET_DIdqoDfSQtcfq-b4xTwOIX-g&oe=6A0DACFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
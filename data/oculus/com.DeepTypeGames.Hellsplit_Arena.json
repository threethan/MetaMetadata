luscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uZBU80JXCoQ7kNvwFWdoSj&_nc_oc=AdmfZzOXlAspNipiBVUI1Oc7G-Bckd9A5TGVjGu_6QuImyaFcVqR4OAbwJysaBJefsA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucU5ceuqxcWhxlo1FWmJwqJTGgQaNh6oq8KcvI3y1Z-Q&oe=69A2CE62"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_U67-98EfwQ7kNvwGunSMi&_nc_oc=AdkrawT74jy4TCkUNndyn9R7GvB_NZFg2gu-WU769R8gamPGRAlQBJwkDJrwGFIQyfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsec7krZ8sl7XCxa3pNF2uCD4sRwgKLTqwN3Xx9Y8T6vg&oe=69A2D2E1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxWB31ngrNUQ7kNvwEqoiWo&_nc_oc=AdlFuJ_xE4oRdPe12ZzgwMm3gTeToMPKEN1hd6-QRU96AVn3NX_-BVKwz04DyKd-KdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnzpR2LwBfsolyCj-MLnQRh92sZuCdrZUKM8B3AXZVmg&oe=69A2CBA0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=341sbCUnY8sQ7kNvwGkNxHN&_nc_oc=AdnpQbNjodNyY0tOWSZetcYKFYAqujjn-bQvWwUEW-vowwndo60lP944kV5EAtvGdzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvhsWMkSLxdtvUYBiQPw4r7PJpnZEf1G3zaqMLPfwJ1eQ&oe=69A2D587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2yIoQhVpxEQ7kNvwFCXdam&_nc_oc=Adkdohj1xiGdckYFClymDb0z1rlIoKOUSCTEO_TT_ayfrYmkmJ_WXa-FOmTtVItTpTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqRImDrO69yqEIejuG2Q2LTYcDJdPBPays71DCgQ7WkA&oe=69A2F4A3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2710427532
name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VZkZmeYOVEQ7kNvwHN_Qit&_nc_oc=AdkEOoW5ITSIEOXiXc4tqBUTCmZv3lrTQjzkDa38QHkIiJzdDX6i60St59L4GZt-Tkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbaECmod9dpPYUYxiE7rK2v175Qp71p2AinLt6yx-NuQ&oe=69AD5A62"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFajx-put50Q7kNvwFkCARV&_nc_oc=AdlGiuEKK7sed-77Q_lSvp543C6HuX05J51gHpF8P-P4UwIDZCg5aWlItTwmoIC-yuU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIIxeKIlZQDo4PQCBADp9WVcoxrb5CR77zB9RaRLfx0A&oe=69AD5EE1"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsNCCJ6BGmgQ7kNvwF5UBla&_nc_oc=Adk7KFqwiX0WVeIE28gZBxRmHLO7CZXZohpHwnbCNmg4rvh1KV7FOOjNg98K0oJWkSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyunbwidvDojkljWYFNpCSXC49VyhMOEkHDwmuaPy32og&oe=69AD57A0"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLzx6eViUSgQ7kNvwF4_gag&_nc_oc=Adn1gw4meYg00lTfhty3hh-yc5HeoGr7x0CIujajIFWvbG7E51m06np-Btvfskz9qoI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCLHZ7_XoWmPMKX1kFWXkT-v7W8wSiKC4t52bNL_hPZg&oe=69AD6187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzOU434oLhsQ7kNvwH1UpiW&_nc_oc=Adl-6nvifaSnB79oRMyv9xopgJNIBHLJKZl86czsznkjLSmXOLFoOaNKvgg4vjmoFkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSsCWOIJCsG3KfbSrG9w_kpQEiS0uHN1wdw79svJFkTg&oe=69AD80A3"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
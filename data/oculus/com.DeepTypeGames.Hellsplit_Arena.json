i": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DUel7_EiIMQ7kNvwGyGJsJ&_nc_oc=AdrJwG3Hicu-fG3SMdlWMxvoTTxVuK_ruOwAT3A2cW_mj4LO_hHtQQFyHOSFc5WLYI8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QR5rpSTzfxwIPLEHikZohtZwFiz3JUwLbhajETsgaVg&oe=6A131288"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdCEj7SfGMwQ7kNvwEQJFic&_nc_oc=AdpOH5tS-X08GzYUeiN2nCZdCtFZ1fIBluOXM8HCeEP066KsDVV6tJG7HZrA9f1IPbQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vU9kHcf-M9P3-qP93sPrI50kAQFCYO8Wjow4095AgYw&oe=6A13050F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEhUrMBE7E0Q7kNvwGe7VSf&_nc_oc=AdrORilKFbqjwOucQaqgHJE15NaVFzdJQ1t_7QTkfqzdPDQfRe0ZTqUwfoXT2RFoowo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zcbR9Zfz_1XxiTtuDnbUkj3W2rM-lMFRrvByGLNgCpw&oe=6A12F2DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgbe0R-5ID0Q7kNvwEyrn8q&_nc_oc=AdpG5uh0soZzVSxHcjuDidkGFD1C8F--_kz23XvK5ZWQ_PkSaKGb_FMslFTAWRZDvwY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7omQLe3V7em6L816nOXpsPMfohqFbuIWuyyqA3IKZhSw&oe=6A130358"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr7oDRQ7qp4Q7kNvwF0Przz&_nc_oc=AdprirniPnkpi-Eil-CZQNO60xzu-8xQlyj4QPBv9Tp-NBqdZWHID08iM_GbGXy8sDQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t6h32ICQMtl42NpFfIo2STtsThEbiveQh2CzeSg_B1w&oe=6A12F2FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
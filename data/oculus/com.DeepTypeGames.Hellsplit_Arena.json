i": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U1E88GTOAIQ7kNvwHy_aqc&_nc_oc=AdrG8cfeIkWJwKHrdBQST1_2EXz4bMXgSonpmxEWrzdXPyoQ0EknrQ1UHAvwQr_1ahE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BdZkN70l5IgLWMBy7JqOd3hWDCM96K9MdP5lTFSzZwg&oe=6A32B688"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rZSWgZPAIsQ7kNvwFjaHYs&_nc_oc=AdqD1nMY-YKhtoX_qOLCz8T5zy9TSPQ3T-09J_JpK7L_pRDACeO4yQz6MOJXsdsVeFA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B1NAVcRNZqcaTHZgxminDfW_LgG3pY0zS-prix-z3zA&oe=6A32A90F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-QVFDL7XYgQ7kNvwGF_lz8&_nc_oc=AdrNcrlONjRlaa9zP7HbdziOs4rSw6DtjkMw9A3hlpHD1IdxBgn5sDXHRhW_-IFftmE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H5P-6hYwg0NENpIzmsi3tQQ5n27udjMeHLuhLq6qh5A&oe=6A3296DB"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cBM9AW-LigQ7kNvwFkm06a&_nc_oc=AdolL6ncYpXdedCxRbX_BBoZSFa5Cm2C0wegzD6_7I7lMnDXKe_mLuQWIP4Uf-dHi9s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f4ZLk8pA_ufjurbf06F6eVt6cnvx95vYF4qK19MCJzQ&oe=6A32A758"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE-S_RrJK_oQ7kNvwG_qzCJ&_nc_oc=AdoiwgGCpUBjfoafhbKC4yiOA8fKlyDEbL2ySuqon1mWj9DC42Gi9r46zJvWyJXEpWo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OYm3kALH-fdn1TAg0gJryUKrmBz4fzfGHzEc7bmR80Q&oe=6A3296FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
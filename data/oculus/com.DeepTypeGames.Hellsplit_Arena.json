name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkOl9hVbeNQQ7kNvwFTY9GV&_nc_oc=AdppsQobzZcX4O9xyc0hVhoaufVfNkfmXlisMyQU2Ek6nLOOREPBWdu-TfBum1ONrcI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-fhoWwRpJcFfDMMQW2cSdCFjm9S66eU7nTEzUZLy6yg&oe=69C120E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7-EujJSiA0Q7kNvwG93OGc&_nc_oc=Ado8lxz5QM2PfZyISDEyY3IAv9ZIWq6ijYSzLEYP89_7tlBeUbM0Em9rFYiwmFWyJeU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfylJbihDbOpox-LsJx56NXESVHa9HwV-Pyh_K8rp5YtmA&oe=69C12561"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JZWJeunCFEQ7kNvwELLynd&_nc_oc=Ado3SHHh7r0CSr1zNz5SqyXF-ILoIdqIw0Jw__SphtcSclrYhsm-xgS4LybcebqV3qo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwsFubnTzRA0hP0--AtHAISe6qK-mSU8i7bY6rLmr_ocA&oe=69C11E20"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZOYEdaqdSEQ7kNvwHJSzam&_nc_oc=Adr9R9AqRFiFSkYHJu2QWy_ozmEdgKM24BR_IOXRlEOkOJAKu53_alL9pFQ3eweq2fU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxq7lX7GQ8ehFu3u8g29qSqJGtks-wG01Qjk36Wh19ziQ&oe=69C12807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwXbZkGNMMMQ7kNvwF_ooiP&_nc_oc=AdqE5YINEi7Xs3J6p7zvMndb8cq4C4HUgDHcJbx1FPyrZ-6ymsztEu1TAtNIhypKuX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPJtjXVPMDK1U95EEZ5AASKxKaIaOEH5yEuHpeF4HDFQ&oe=69C14723"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
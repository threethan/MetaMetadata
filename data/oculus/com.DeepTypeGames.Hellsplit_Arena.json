name": "scr_2.png", "id": "1950135779129829", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393941_1950135782463162_3420669866492121063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffm8VoeJaJgQ7kNvwEHQ9na&_nc_oc=AdlUEyp0jh8UZqINfLko30l1w4jRTLUBND2EKt31vX7BgHYJmbRGUh6-VCfqxNxSXDk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrRzZASRfPDXXVHvX4MXaX6IFUzBnw--yPQ1qACZL8gA&oe=69B694E2"}, {"file_name": "scr_3.png", "id": "1343894223533454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_1343894226866787_1560943700088043047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8y6c2iYE4UQ7kNvwGQib5O&_nc_oc=Adm39gbtEXkM7HFvKFhHlcCVh_zlUCqnDaZqLuk2I0LOR9VMoIcAkdZ0zOw2RDrzIQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLucE7nAiXqTxm0Y6tSVrIFSzWmhvjaSY5QNbRO4JE1Q&oe=69B69961"}, {"file_name": "scr_4.png", "id": "9334494786605262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392309_9334494793271928_3606284242396094994_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNU8LK-J7uUQ7kNvwFZDrxo&_nc_oc=AdlUiQS-7aJZpYDc6i2bsG8JznxiC85Qv-BGsmCbnv-gEJAUyxZU25syJ1z1O2vlEZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOU06mWJSUTqYn2sXilRyf8Jq5LLmHabf-Br-yD87Jpw&oe=69B69220"}, {"file_name": "scr_5.png", "id": "617912744415865", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393589_617912747749198_2369521961704100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMjxrfHBVOUQ7kNvwGA8B22&_nc_oc=Adl2OUiAKvVNoJMkfoGuiF5q5wt8Ip-3zrOYNMuDJTNoeVJRF6EsNVWc-fBwe1p88pA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWHzfJWOGi2rljamzOxAiEHcCn9b1hyUJF8tplIOQCCw&oe=69B69C07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1174836580961065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1174836584294398_3940276989484749659_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYqvHxJj4wYQ7kNvwG-guY0&_nc_oc=AdncW-Iuqw2dKuw2sMkc4_EX0p6JiyardZFMedQWgerXmkdeHRsj4MOpc7JQssj3kRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZs0sw9qXZhe3Km1J8-eI2Wx3gzPKHP-kmv-cM34XXeg&oe=69B6BB23"}, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
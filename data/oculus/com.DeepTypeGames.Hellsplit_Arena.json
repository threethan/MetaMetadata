i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974733_1318559239313629_7453703982395337712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymo8A4EdrrcQ7kNvwF4LyUC&_nc_oc=AdrKuUhEPEK-hGYLTpPQMCwP-kmxm29jEnib68bEwqhBGyTFfMuuukl-vX5SZpNrjsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2CaXFs3meDPqUp9fctkkPea0D3-OKh7c5egiyK4HsGA&oe=6A4BC308"}, {"file_name": "scr_2_tmp.png", "id": "1226583765074516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65227798_1226583768407849_9001216059786312570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYTOSQEz7roQ7kNvwFYNv_F&_nc_oc=Adq2dvz3YYFEikBUA9s5xTZSNhfHOit28Kjt9SYv3umB78JmQBVUz5c4wGJfy0jl1gk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3nhWl-19_d71rBpiI2oCx0og7aCSYc82kMtAgepE4QQ&oe=6A4BB58F"}, {"file_name": "scr_3_tmp.png", "id": "608555175004300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_608555178337633_3119208113611070037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt-ChWCM_nwQ7kNvwETt5g0&_nc_oc=AdoFQGB3rT3YbCSDmuXGaPSGu5cIC02RVCmkNRfhqB5Egtmx0Q_6wglpCDjV3TU7CMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCafo5eksX-tPgS6Defhg2oBuJNhox0Y7FAn1A0s5IdA&oe=6A4BA35B"}, {"file_name": "scr_4_tmp.png", "id": "8598162190305777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_8598162213639108_8792122052975213410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJHaKebBeNkQ7kNvwEJVEmD&_nc_oc=AdpotdB-vj98JsYj9e7b6JaeVSXJzi5TppwqZEuXeoiA-cNXhKZiYPC9VUqVIF1MYkc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg4Jj-BkNCuSk2m2y2gpnbyNOsXl51hrvsO6Lql8ZFPw&oe=6A4BB3D8"}, {"file_name": "scr_5_tmp.png", "id": "3727577634219967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031640_3727577640886633_8820845227963373242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htiyMbC2tNAQ7kNvwHuHVRt&_nc_oc=AdqMvxEI3YxMJNmrhpM70ZqkKuZ0IveHzYsZqdN8jEO_4XlLF4ds3Eu9VRBLR-4Ywdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8-t2ih6u78iPqZNYGZPrKIkSfB9kuNUbxaLL2ahmFoA&oe=6A4BA37E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellsplit: Arena", "keywords": ["Zombie", "Melee", "Slasher", "Horror", "RPG"], "long_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance.\n\n- A unique gameplay in which you and your character are one and the same \u2014 a full-fledged avatar, precisely mimicking your movements.\n- Physically realistic battles using the weapons and equipment of medieval warriors. The characteristics are as close as possible to real prototypes.\n- Realistic body movements. A life-like injury system \u2014 superficial wounds, dismemberment.\n- Intriguing campaign and additional modes. In-game achievement system.\n- Full-fledged room scale VR experience \u2014 the game requires the player to be in a vertical position with the ability to move in real space over an area of \u200b\u200b1.5 x 1.5 meters with support for VR controllers.\n- High-quality graphics and sound.", "short_description": "A VR horror-slasher in the dark fantasy world of the late Middle Ages filled with the undead. It is gruesome and realistic, with stabbing, cutting and blunt blows, grabs, kicks, and movement tactics \u2014 the outcome of each fight depends only on your skill and endurance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeptypegames.com/hsa-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Deep Type Games", "support_website_url": null, "website_url": "https://hellsplit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
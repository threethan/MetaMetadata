80531", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1386915013547197_3474316754494032817_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaRptt1Iv6MQ7kNvwHj-oeQ&_nc_oc=AdpyFfnO-gHIWuRwmRQt15B3IFQf-OIwD8ADaZX50MvfyvKFsDcHO9NlI-WLMr_p4js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2K1UP3IERCv2kd6sPwtNb-VLH-wW_UYm2lNvWcM6d_Q&oe=6B09AE99"}, {"file_name": "Screenshot3.png", "id": "1035783929310328", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825563_1035783932643661_3354992443371776532_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJR2t0f4Vg8Q7kNvwFGEmRE&_nc_oc=Adrqq4oUM-nSCxstLitwSrC6SSz7qODAGcG52anYZET0Ir6KTjdDhtzRjnBPWUViGyo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvdPsNIYRlA2qhRdB4g1ismiU3rLVEjbtOIpiiKId16Q&oe=6B09B935"}, {"file_name": "Screenshot4.png", "id": "2996297040712084", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_2996297047378750_4204197018642650540_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vowGz5PfkTsQ7kNvwEWacsi&_nc_oc=AdoMJyXm3y1zRe882GXqhnlYEMDmZD7fmCDOc6ffjuEAODuTgCMbCpc9_2OHUx7fUjA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR84QllU-xgrSBiyJjZLXU8kM3SwhV7FbNQnzngw9OHfA&oe=6B099D5E"}, {"file_name": "Screenshot5.png", "id": "1073555088470955", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1073555095137621_4359930917486504277_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTwO-3nB1fQQ7kNvwEoW6qM&_nc_oc=AdpkjQ0q-2pn4kieiu-iE4zJ--6rAHVg9HEhGbCaX2dWQtDkK4LS8ikcnEakHvd_SOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlEVSPwZI9WDBh6VDfP0xHlGCimaNaXSDYWEf2S3uJUA&oe=6B09CA29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Works", "keywords": ["SocialSports", "Sports", "Hangout", "Rec"], "long_description": "RoomWorks is a social VR playground built for playing and having fun about with friends.\n\nDrop into a shared space where you can play many activities, and there's always someone to play against.\n\n\nMAKE IT YOURS\nChange your hair, your face, and your look in the locker room. Everyone can see who you are before you've said a word.\n\nNATURAL VR INTERACTION\nReach out and grab anything. Throw it, catch it, pass it. Built hand-first for Quest, with smooth locomotion and comfort options so you can play the way that suits you.\n\nBUILT FOR FRIENDS\nVoice and text chat keep everyone talking. Rooms fill up fast, and no two sessions play out the same way.\n\nRoomWorks is actively developed, with new activities and features added regularly.", "short_description": "Welcome to Roomworks, the social sports game where you, grab, throw, and mess about with friends in VR. Sports, hangouts and secrets to find \u2014 all in one playground. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/JoyDaParrot/RoomWorks-Releases/blob/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "RoomWorks", "support_website_url": null, "website_url": "https://github.com/JoyDaParrot/RoomWorks-Releases", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1160773630462721"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1206245891667330"}]}, "baselin
RtJsuaBsAk0AETjmef5L876KUj0ibvh1z8tbQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRE6QMfpwqhC1aJ-Epgjl--nsyx3ACCbuwt5bS1-BBC_A&oe=6B0DB4FC"}, {"file_name": "Screenshot2.png", "id": "28237623769237156", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_28237623789237154_6722086056669326019_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OixcRwn6gl8Q7kNvwFE9pL0&_nc_oc=AdqMH1EMunkR_iC9Xx09WIUx7Z2IwR6YZsnpjTG6fzeiU6wIaZwoq_4LFhPGCPr7-xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQz18YnlScVZmcZHm3ExJZRQ7mYGQlsiVxfd64U-GF5PQ&oe=6B0DBA27"}, {"file_name": "Screenshot3.png", "id": "1035783929310328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1035783932643661_3354992443371776532_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfUc1R1n8PIQ7kNvwHWSi4Z&_nc_oc=Adpbso2LFWvmdGmBQaO6e1xXkJhJX2HoGp9iM3RLW9Q2dsuZuW_zdhvBMWiHmGRWW-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSUFFY1C9VdeNKBpaola1V_es2x-Kg5gzVmaWzMMG8Kg&oe=6B0DADB5"}, {"file_name": "Screenshot4.png", "id": "2996297040712084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_2996297047378750_4204197018642650540_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPwa7DRxk1MQ7kNvwHMLJoC&_nc_oc=AdoWXeqoRbX8dQrCIRlApaTJDh-ni7YhoTNSliJrf5DNCK400mhOEGB4JC-XEp1hbWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwoDfI6UYGFMh8na9gkAPJKxRVzn4vBZ1RY4h4bZMWJA&oe=6B0DCA1E"}, {"file_name": "Screenshot5.png", "id": "1073555088470955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1073555095137621_4359930917486504277_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaMPTWnWyPQQ7kNvwEfv7Yk&_nc_oc=AdoCsugV9FZaAfw7y_LOhKbEVeExIB69n1Tm7r6jEBBxF_A8LtnX4-Pp3H1iWtSjj2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5TmaZrxFzBrorkhmzen4oCfLpRmDdkicyl0ri3kOvgQ&oe=6B0DBEA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Works", "keywords": ["SocialSports", "Sports", "Hangout", "Rec"], "long_description": "RoomWorks is a social VR playground built for playing and having fun about with friends.\n\nDrop into a shared space where you can play many activities, and there's always someone to play against.\n\n\nMAKE IT YOURS\nChange your hair, your face, and your look in the locker room. Everyone can see who you are before you've said a word.\n\nNATURAL VR INTERACTION\nReach out and grab anything. Throw it, catch it, pass it. Built hand-first for Quest, with smooth locomotion and comfort options so you can play the way that suits you.\n\nBUILT FOR FRIENDS\nVoice and text chat keep everyone talking. Rooms fill up fast, and no two sessions play out the same way.\n\nRoomWorks is actively developed, with new activities and features added regularly.", "short_description": "Welcome to Roomworks, the social sports game where you, grab, throw, and mess about with friends in VR. Sports, hangouts and secrets to find \u2014 all in one playground. "}]}, "developer_name": "afggorilla5", "developer_privacy_policy_url": "https://github.com/JoyDaParrot/roomworks/blob/main/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "RoomWorks", "support_website_url": null, "website_url": "https://github.com/JoyDaParrot/roomworks", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STA
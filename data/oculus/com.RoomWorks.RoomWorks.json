lX5_FIetzCf0nmgK-3cHD1obgs_DG5U-sctJWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVisp_Fp_fgudGK5nCZW0aMDI8-CC3Ud5_qJlvagyKmsQ&oe=6B0F067C"}, {"file_name": "Screenshot2.png", "id": "28237623769237156", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_28237623789237154_6722086056669326019_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKCrTtTH_eIQ7kNvwHlZtGI&_nc_oc=AdoW1cJt3hpZWm6ATSHs89Bz1E9ivc6tXd12PaIqrqojTxEdC6oGEt9tMtlNSd0rJzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXwn4u6EGoOqsOPwlnr50xH9oLFoCLndyXROUMnIK6Xg&oe=6B0F0BA7"}, {"file_name": "Screenshot3.png", "id": "1035783929310328", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825563_1035783932643661_3354992443371776532_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJWGhOYjiocQ7kNvwGNjb7K&_nc_oc=Adqyzm_qFvxgC-GxhsbZtdjhSLlIhDGt6yZ0cAFuPBtbFSe8LwSq9GPLIOfbonMVbAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyCUqzfdSTQOYVoSPtVgrjDbGvsmzQ0hlbXQvenpbO-A&oe=6B0EFF35"}, {"file_name": "Screenshot4.png", "id": "2996297040712084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825462_2996297047378750_4204197018642650540_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPwa7DRxk1MQ7kNvwF7keZ-&_nc_oc=Adr9BQ0bXn7RsDI3YUV4YquKjrf7BPiPmC7v7Y7ImQDWcw-Awv9LseU2YBOcYAIWTVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXwNH5hk2c1VyI9qoGBfA0t9dJK1gYXdCagvw8yObmo2g&oe=6B0F1B9E"}, {"file_name": "Screenshot5.png", "id": "1073555088470955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1073555095137621_4359930917486504277_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaGm2svpqSQQ7kNvwFr4hIF&_nc_oc=AdpGHNNmJm7pVlr5y75NWPfb4zkkWwWexg_BTf1PED5IZHqxCi8B00UgkyU56Dgkt2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUS7slxdXeAYCQR_jrWcHOi3I_8S5IHFPBycQ-d5mSzZw&oe=6B0F1029"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Works", "keywords": ["SocialSports", "Sports", "Hangout", "Rec"], "long_description": "RoomWorks is a social VR playground built for playing and having fun about with friends.\n\nDrop into a shared space where you can play many activities, and there's always someone to play against.\n\n\nMAKE IT YOURS\nChange your hair, your face, and your look in the locker room. Everyone can see who you are before you've said a word.\n\nNATURAL VR INTERACTION\nReach out and grab anything. Throw it, catch it, pass it. Built hand-first for Quest, with smooth locomotion and comfort options so you can play the way that suits you.\n\nBUILT FOR FRIENDS\nVoice and text chat keep everyone talking. Rooms fill up fast, and no two sessions play out the same way.\n\nRoomWorks is actively developed, with new activities and features added regularly.", "short_description": "Welcome to Roomworks, the social sports game where you, grab, throw, and mess about with friends in VR. Sports, hangouts and secrets to find \u2014 all in one playground. "}]}, "developer_name": "afggorilla5", "developer_privacy_policy_url": "https://github.com/JoyDaParrot/roomworks/blob/main/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "RoomWorks", "support_website_url": null, "website_url": "https://github.com/JoyDaParrot/roomworks", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STA
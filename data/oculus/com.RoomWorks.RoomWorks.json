80531", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823341_1386915013547197_3474316754494032817_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaRptt1Iv6MQ7kNvwEogoaL&_nc_oc=AdpUuWUhnZqcaaMxgKSbn5K_sSY1PC9g5B-juvxNo9c18OFi55_YciQ_F3Ez73lDUdM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7zATNnbIBl9yiJ4aStkEj_Lm4e0B7xrN6RczjQTg6og&oe=6B0B3859"}, {"file_name": "Screenshot3.png", "id": "1035783929310328", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825563_1035783932643661_3354992443371776532_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfUc1R1n8PIQ7kNvwHcStqw&_nc_oc=Adox3qzu3J5hyFyI9NRWwkLTP-uLSPvS2I37glbop6sRpDMONOZpAGNgKs0T4DS4CcI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrI9YUH0r01OVzI2C3sTpdBHjoapoIPAyCFAfoXmmOPA&oe=6B0B42F5"}, {"file_name": "Screenshot4.png", "id": "2996297040712084", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825462_2996297047378750_4204197018642650540_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vowGz5PfkTsQ7kNvwHzA5C1&_nc_oc=AdqkOW5eGnuGHu7e4he3gLVNT3oy4yf0P6o1d0E6wBUqezUWF5ssPefpmLs4b8fnwh0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpd-g3QhQzFr76RzMzfkglWaiToOgpfxSaltayP2B8fw&oe=6B0B271E"}, {"file_name": "Screenshot5.png", "id": "1073555088470955", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825503_1073555095137621_4359930917486504277_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaMPTWnWyPQQ7kNvwGmbdss&_nc_oc=Adoz13X7ftJd9jghjFybVbTE0_OCCwIdoGir-7yhBbnoPR9_uXpwGipTVJfIPcAoYT8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHByGfNM5a1WqdqVZQ4pRsAD-VRfK1QCjI7p_oXjDrxA&oe=6B0B1BA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Works", "keywords": ["SocialSports", "Sports", "Hangout", "Rec"], "long_description": "RoomWorks is a social VR playground built for playing and having fun about with friends.\n\nDrop into a shared space where you can play many activities, and there's always someone to play against.\n\n\nMAKE IT YOURS\nChange your hair, your face, and your look in the locker room. Everyone can see who you are before you've said a word.\n\nNATURAL VR INTERACTION\nReach out and grab anything. Throw it, catch it, pass it. Built hand-first for Quest, with smooth locomotion and comfort options so you can play the way that suits you.\n\nBUILT FOR FRIENDS\nVoice and text chat keep everyone talking. Rooms fill up fast, and no two sessions play out the same way.\n\nRoomWorks is actively developed, with new activities and features added regularly.", "short_description": "Welcome to Roomworks, the social sports game where you, grab, throw, and mess about with friends in VR. Sports, hangouts and secrets to find \u2014 all in one playground. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/JoyDaParrot/RoomWorks-Releases/blob/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "RoomWorks", "support_website_url": null, "website_url": "https://github.com/JoyDaParrot/RoomWorks-Releases", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1160773630462721"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1206245891667330"}]}, "baselin
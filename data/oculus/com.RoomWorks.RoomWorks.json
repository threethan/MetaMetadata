&_nc_ohc=u6M_q_hJ8dYQ7kNvwGWGdwc&_nc_oc=AdpOFwQuAWGVryOqenJ6UTdmZz0uex0jQXTuhoUA5BQ6SuAUqrd9gfpdtxizKwRNcwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUKcuUQcufUxOWNkxkNe8u4IvqqJStejxXvE5Ux4sC4Q&oe=6AF5F2B5"}, {"file_name": "Screenshot4.png", "id": "2996297040712084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_2996297047378750_4204197018642650540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpE4xQhp5fUQ7kNvwEO3Knw&_nc_oc=Adrc9iUHV0Mh8mkK1tr028Ddt2ch4XxGF2ufYvTz29-SjLZTICcNHMmMemESr6dlMXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPVJyX-NclDGOiF5a2P1J93NccUMcDI81P3DpKQeSPOg&oe=6AF5D6DE"}, {"file_name": "Screenshot5.png", "id": "1073555088470955", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825503_1073555095137621_4359930917486504277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP5YLbvDwo8Q7kNvwFRcYze&_nc_oc=Adoiqo8uDGxfOrFxb5W6ag6HjoFjcxOv0JKZ-dGfF9wKifK5xPe-3JwKb2Kan94hako&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn4NhIWN96hdZNPmVDy2JzhLhnBHT45XIS3xpHfcGnbg&oe=6AF5CB69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Works", "keywords": ["SocialSports", "Sports", "Hangout", "Rec"], "long_description": "RoomWorks is a social VR playground built for playing and having fun about with friends.\n\nDrop into a shared space where you can play many activities, and there's always someone to play against.\n\n\nMAKE IT YOURS\nChange your hair, your face, and your look in the locker room. Everyone can see who you are before you've said a word.\n\nNATURAL VR INTERACTION\nReach out and grab anything. Throw it, catch it, pass it. Built hand-first for Quest, with smooth locomotion and comfort options so you can play the way that suits you.\n\nBUILT FOR FRIENDS\nVoice and text chat keep everyone talking. Rooms fill up fast, and no two sessions play out the same way.\n\nRoomWorks is actively developed, with new activities and features added regularly.", "short_description": "Welcome to Roomworks, the social sports game where you, grab, throw, and mess about with friends in VR. Sports, hangouts and secrets to find \u2014 all in one playground. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/JoyDaParrot/RoomWorks-Releases/blob/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "RoomWorks", "support_website_url": null, "website_url": "https://github.com/JoyDaParrot/RoomWorks-Releases", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1160773630462721"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1206245891667330"}]}, "baseline_offer": {"id": "1206245891667330"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786640220, "status": "PUBLISHED", "id": "1206245891667330"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1330957910110958", "version": "0.9.9.6"}, "id": "2048189612440985", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1160773623796055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1330957910110958
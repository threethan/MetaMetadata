80531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1386915013547197_3474316754494032817_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYHh8MNPfKoQ7kNvwHKk_tk&_nc_oc=AdpZZUOzF2p9iJC1cywj5Lzb8Nbvm5D3oMbmbnFjACIDxnq5XFvcsZy5VlCALsssQeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdV_a6RVWwzNTmrBhBsWiD-YBM-9GUZLFEyZRu4zXIQQ&oe=6B104619"}, {"file_name": "Screenshot3.png", "id": "1035783929310328", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825563_1035783932643661_3354992443371776532_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJWGhOYjiocQ7kNvwHYHX6F&_nc_oc=AdoVsTzpdsiVDPuCeKajCd58WnufzmGTbcRB3317Uf1V49NJvqZf53vLOF2QFOBavNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8cfiEeA79pKxV3lF92ZuHV90ayMElXjBhVTT1Tbf1eg&oe=6B1050B5"}, {"file_name": "Screenshot4.png", "id": "2996297040712084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825462_2996297047378750_4204197018642650540_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPwa7DRxk1MQ7kNvwECcT6D&_nc_oc=Adr-uPk5cV6iATM18cZFqfY0Y8gBwcmUyrfyLq_uPdwq-m8HtiIitSSXfPOJmQOWBqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQ3s1Xg3IjNySkK3KXpgyH-Pn9IHSB_qGLPxtoZdPIfQ&oe=6B1034DE"}, {"file_name": "Screenshot5.png", "id": "1073555088470955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1073555095137621_4359930917486504277_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaGm2svpqSQQ7kNvwEGWxNz&_nc_oc=AdqINxGIWRnzu63B9Km-wjA4rYryRxCs7O-paPs-ZaLB6htrOfRnh958F5v7Dypq2fY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXwXwGPKn8cm-hzEih59yHjZl5hnhjyVO2uia5JjvUsMg&oe=6B1061A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Works", "keywords": ["SocialSports", "Sports", "Hangout", "Rec"], "long_description": "RoomWorks is a social VR playground built for playing and having fun about with friends.\n\nDrop into a shared space where you can play many activities, and there's always someone to play against.\n\n\nMAKE IT YOURS\nChange your hair, your face, and your look in the locker room. Everyone can see who you are before you've said a word.\n\nNATURAL VR INTERACTION\nReach out and grab anything. Throw it, catch it, pass it. Built hand-first for Quest, with smooth locomotion and comfort options so you can play the way that suits you.\n\nBUILT FOR FRIENDS\nVoice and text chat keep everyone talking. Rooms fill up fast, and no two sessions play out the same way.\n\nRoomWorks is actively developed, with new activities and features added regularly.", "short_description": "Welcome to Roomworks, the social sports game where you, grab, throw, and mess about with friends in VR. Sports, hangouts and secrets to find \u2014 all in one playground. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/JoyDaParrot/RoomWorks-Releases/blob/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "RoomWorks", "support_website_url": null, "website_url": "https://github.com/JoyDaParrot/RoomWorks-Releases", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1160773630462721"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1206245891667330"}]}, "baselin
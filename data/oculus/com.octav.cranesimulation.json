SS_04.png", "id": "1547675365821260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458097_1547675369154593_6466447254463909605_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD83Hkwvw04Q7kNvwF7rwNC&_nc_oc=AdkRczmOWBSlv2TJGT6iWRsWapSKZkmczoMNCutyZa1My2uOBG6xZhKv9nj7WJ4-8kM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu68ieXBsyuT3_GpHyeOvZJyzwvY9Nr-pgDxPBWx3BG-g&oe=699C30B6"}, {"file_name": "SS_05.png", "id": "1035352231619479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75272207_1035352234952812_2304850879312691575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzQe4VEesggQ7kNvwHKA9Lu&_nc_oc=AdlrOP4zc61AJofjF3gjgMRD92jDg-tjJHUN1GQ0p7ALqz1r7Odx9DgTLiPtcBMjKuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuUCoPICUP_r-m_NkS2tXJ5Pj76SmzS6FjDJ8joYy_N_w&oe=699C4DAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (2).png", "id": "1228861508458093", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031392_1228861515124759_1059678258857403949_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42YKX9o9vh8Q7kNvwEfTRxj&_nc_oc=Adn7oRHTx2CcHu2h1WydqMeYVMwSH5LJujDJhhOLHbwPiLY4D-LwGN8GSh6AhI-jF78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsFqyuqYxpinmCdn5n_2bXXiculGPOySdN-t9gRftuPZw&oe=699C53F2"}, "display_name": "Crane Simulation (Demo)", "keywords": [], "long_description": "Experience the future of crane operator training with Crane Simulation! This demo provides  an inside look into the immersive VR experience designed to elevate your skills and knowledge.\nTest drive the realistic simulation:\nExplore a virtual port: Step into a lifelike port environment and get a feel for operating cranes with accurate controls and physics.\nTry essential maneuvers: Practice basic cargo handling, loading, and unloading procedures in a safe and controlled setting.\nGet a taste of advanced training: Experience a preview of the challenging scenarios and skill-building exercises available in the full version.\n\nReady to take your training to the next level?\nContact us at contact@octav.studio to learn more about the full version of Crane Simulation and how it can benefit your organization.\n", "short_description": "Crane Simulation offers a realistic VR experience for aspiring crane operators. Practice essential maneuvers and explore a virtual port environment with accurate controls and physics. Take your training to the next level!\n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Crane%20Simulation.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8226905614102010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982555_547143624486002_1440483932663534429_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkwrrUoAtmcQ7kNvwFwlg88&_nc_oc=AdlZSh7YsZz6NuPPtx1ryASoznAVMtkdcy0-MYPy4CxW5ITpowh0K3dBKWI8x5Z7tzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvTYFXYaWAPIAKU7pHYJ3jeTQJjb69KOn3ttRa62OOxrg&oe=699C5044"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crane Simulation (Demo)", "platform": "ANDROID_6DOF", "context_ca
_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDmkPBiILDtlMwhD36LmrtxrgVFJiOOXal_TSQJW-3Fw&oe=6AECA3A3"}, {"file_name": "SS_04.png", "id": "1547675365821260", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458097_1547675369154593_6466447254463909605_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMGfCHI5An0Q7kNvwHXCWIL&_nc_oc=AdqciaHVn6huAjvLdTJfCrbpHu98dXkPK-mrZLKOdkT4YhQ_bRmq_yjLwJGAidGtT8Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTaIHTvbW45-x6W9QEbIJSpqNLM6JJ-E7PrSXeQ3MJgg&oe=6AEC9776"}, {"file_name": "SS_05.png", "id": "1035352231619479", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75272207_1035352234952812_2304850879312691575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5lnQRaHwVEQ7kNvwGiP287&_nc_oc=Adqwrf9Kmvt5u81w03OyUXNiHropA6JAGLNyT-11NlxktK23DW7Mg4kRLi8eC2kq43I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_xs48j-LtQ61-rYGXcOqLrhhdyO2plveiI9p5hF5J4g&oe=6AECB46C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (2).png", "id": "1228861508458093", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031392_1228861515124759_1059678258857403949_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFGOOJgkGUcQ7kNvwFB2U-j&_nc_oc=AdrkF1YMBfViptSsk2JgMeX5tF_IgCNvct0qP0GyvqJmKdH9bKKlSamyTzkpAKIekhc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiCQvRcQmpg4z1KJpQm1nT9nJgxWZMqPlwscg0C5kZAA&oe=6AECBAB2"}, "display_name": "Crane Simulation (Demo)", "keywords": [], "long_description": "Experience the future of crane operator training with Crane Simulation! This demo provides  an inside look into the immersive VR experience designed to elevate your skills and knowledge.\nTest drive the realistic simulation:\nExplore a virtual port: Step into a lifelike port environment and get a feel for operating cranes with accurate controls and physics.\nTry essential maneuvers: Practice basic cargo handling, loading, and unloading procedures in a safe and controlled setting.\nGet a taste of advanced training: Experience a preview of the challenging scenarios and skill-building exercises available in the full version.\n\nReady to take your training to the next level?\nContact us at contact@octav.studio to learn more about the full version of Crane Simulation and how it can benefit your organization.\n", "short_description": "Crane Simulation offers a realistic VR experience for aspiring crane operators. Practice essential maneuvers and explore a virtual port environment with accurate controls and physics. Take your training to the next level!\n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Crane%20Simulation.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8226905614102010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982555_547143624486002_1440483932663534429_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngs4bB8tzUoQ7kNvwGN6x_u&_nc_oc=AdoGH3cSSJCg9USFUqS6WJyjfCTgVAeTSv3J2YHKymIrOC7ikhfispwEGbXo3EoeHdA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpwH9f3xIBBFPLNtmVN0lRcVU0TnpF
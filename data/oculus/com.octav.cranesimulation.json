_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeSj-F31v3ut-brSz3p4mbaTAjCZqt1sFSii3DelxWpg&oe=6AE8AF23"}, {"file_name": "SS_04.png", "id": "1547675365821260", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458097_1547675369154593_6466447254463909605_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSBJohsPQcsQ7kNvwGz2ES5&_nc_oc=AdqQFo6sCWPXYaLc2JsvjL--sYmin6z8l0jdpL73-Pogk6vNd2Kvu34285Y1UXEZ77A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx6c6S2voqg9sN2OsEc4amqxSBlbvRX7pMPT-JJq8rFg&oe=6AE8A2F6"}, {"file_name": "SS_05.png", "id": "1035352231619479", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75272207_1035352234952812_2304850879312691575_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z44SYbh-MWoQ7kNvwHNrctM&_nc_oc=AdqkuE7Qq6g5PiEpXqlTjiUv-W22LINa4FtkpUrsTB_ifZznmfGBVw_gMvlhZRO-V5Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Y1Zlcma9SBGS34BsjP5EDepDtgtg98CeX3WvCpvxHg&oe=6AE8BFEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Landscape (2).png", "id": "1228861508458093", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031392_1228861515124759_1059678258857403949_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TN840j8GusQ7kNvwEBWJ9k&_nc_oc=Adr-JExip9bEf9SnT-RKDrXfPhRObbLrR2lg_fQuodo1ELoYxsEQE-GelpeHiceiDfw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlD5YL6p75e6cYwjJwYZ7q_O7EPAW8R7VC_tiA7BjrEQ&oe=6AE88DF2"}, "display_name": "Crane Simulation (Demo)", "keywords": [], "long_description": "Experience the future of crane operator training with Crane Simulation! This demo provides  an inside look into the immersive VR experience designed to elevate your skills and knowledge.\nTest drive the realistic simulation:\nExplore a virtual port: Step into a lifelike port environment and get a feel for operating cranes with accurate controls and physics.\nTry essential maneuvers: Practice basic cargo handling, loading, and unloading procedures in a safe and controlled setting.\nGet a taste of advanced training: Experience a preview of the challenging scenarios and skill-building exercises available in the full version.\n\nReady to take your training to the next level?\nContact us at contact@octav.studio to learn more about the full version of Crane Simulation and how it can benefit your organization.\n", "short_description": "Crane Simulation offers a realistic VR experience for aspiring crane operators. Practice essential maneuvers and explore a virtual port environment with accurate controls and physics. Take your training to the next level!\n"}]}, "developer_name": "Octav Studio", "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Crane%20Simulation.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8226905614102010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982555_547143624486002_1440483932663534429_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYXbue1GwmQQ7kNvwHN5LnB&_nc_oc=Ado6_Qo5Opn8sVPC8bev3rCS_vH76kOOJkp-b4o6HL3Gud9dHapqnE0NXoRyuNy_THg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKPPYS-MhYGfA_AB7PfTHuQFonS2sY
_Loop_V01_Icon_512x512.png", "id": "1084916047699266", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624577_1084916051032599_5525113197902647168_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itM5tdyZmn4Q7kNvwGiXce3&_nc_oc=AdowDB_TtGb7prUT5QFH3cdgUnuksHhAM6BljTJen14V_w5Dp_YLk_HbfOKOOFF2hZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8IHbfrYJg7AfN8iVTULaMHlvYyADgYljSm6R6sJN9Xw&oe=6B045862"}]}, "id": "1382721730514627", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "1782469406344066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623585_1782469409677399_7560182842706170965_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBHHZS_p5NYQ7kNvwGu1peE&_nc_oc=AdrA1YFTJO-ZlkeJAqCM2jrsb2QvC4MOtwKhDbKJMmJb2Vii9746I234brE4kvdV8Is&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI5MVOIr3j91Vsl3g8-ND1c8d8XpdXoGzAib1bwzfeHQ&oe=6B046773"}, {"file_name": "02.png", "id": "1446633677685913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593839439_1446633681019246_6863000315452847716_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWcY0_p0YDQQ7kNvwGbrrz1&_nc_oc=Adrzxpv_vOozv4c5nZ07VUgAp-zxxvnBeCT6EszXWUaeKp8VT2N8t87wmHeNYs5Z9Sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Iop_PyC4miVVC3Wi9igB-RCFvlJ7ZuJ13g1jJFlzMw&oe=6B0484A1"}, {"file_name": "03.png", "id": "1456312936344110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619404_1456312939677443_1771168642530961143_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsLljuOh_UwQ7kNvwHVESkY&_nc_oc=AdrQiGJXbBfjcB3GKv8L8o9qf8j7331ydNbDUabantZJpdFvPg_qJHgdAcajYr4Ynyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY--CquiztMOk642ppBe3KH4_FaOxqL55zcAJ359BDsQ&oe=6B045CCE"}, {"file_name": "04.png", "id": "1352970596706324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1352970600039657_839051556282756434_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCtWfZLzAYcQ7kNvwFqms8U&_nc_oc=AdqFUqZCMo2rJuJlhPb-CD76jjg6Q9N-dJ6QQWXQRuX52pa9PuenlMeQ2enuou-1y_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyMZN94ChOh9q83GwekovsthmutIuXpbviYB3B0pGI0g&oe=6B0452F9"}, {"file_name": "05.png", "id": "1518446763663375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624606_1518446770330041_3250802175080397974_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC48F0gB2iMQ7kNvwFGVUhf&_nc_oc=AdrzEZ7Km2TFK4XIjFq9MBnjLTascSsIuRmt6TgLa2tQbJBKFuOCSA2jrF8gkZIJPLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVhpMWHfZyN4I6PzXg33AwrDgTILrP7Wiy2-dhqxEvCQ&oe=6B048441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2061743771143945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619059_2061743774477278_5973137550377973980_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjMhx1GCCWcQ7kNvwHD1GqX&_nc_oc=AdoPAQ3Juz0YCnFB4uVILgMBIXA4cZw5ZBeuzupOpLAlkIIUmtJ9BDWyFkcEnxtf35A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4TVSpXaVL5Z0AILilF2SmEZDhxLl94UPHuor6y6MNsg&oe=6B0481B4"}, "display_name": "Cargo Loop: Color Sort Puzzle", "keywords": ["puzzle", "tabletop", "color", "sorting", "cargo"], "long_description": "# SMALL TRUCKS. BIG SORTING CHALLENGES\n\nTurn a miniature cargo yard into your next VR puzzle obsession. Cargo Loop: Color Sort Puzzle brings colorful parcels, moving conveyors and little trucks to a tabletop in front of you.\n\n# MATCH COLORS. MASTER THE ORDER\n\nPoint at a truck to release its next cargo group. Match parcels with the right trucks and plan your sequence carefully. Belt space is limited: send the wrong colors too soon and you could bring everything to a halt.\n\n# 75 LEVELS TO KEEP YOU THINKING\n\nWork through different conveyor shapes and cargo arrangements. Read the board, decide what should move first and enjoy the moment a crowded level finally clears.\n\n# A LITTLE WORLD WITH BIG SATISFACTION\n\nLean closer to inspect your miniature yard. Watch parcels travel, trucks fill and deliveries roll away. Simple controller selection keeps your attention on the puzzle.\n\n# SETTLE IN AND SORT\n\nPlay seated or standing, with adjustable table height to suit your position. Step into the harbor room for a quick puzzle break or work through your next run of levels.\n\n\u2022\t**Color-matching puzzles with limited conveyor space**\n\n\u2022\t**75 levels with varied layouts**\n\n\u2022\t**Miniature trucks and automatic cargo movement**\n\n\u2022\t**Controller-based point-and-select interaction**\n\n\u2022\t**Seated and standing play**\n\n**Can you clear the cargo without creating a jam?**", "short_description": "Sort the colors. Load the trucks. Beat the jam. Take on 75 tabletop VR puzzles with moving conveyors, colorful cargo and satisfying deliveries. Choose your next move carefully: one crowded belt can change everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
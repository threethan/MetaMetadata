_Loop_V01_Icon_512x512.png", "id": "1084916047699266", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624577_1084916051032599_5525113197902647168_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8wUbcZVUqoQ7kNvwGsb4ng&_nc_oc=Adrfpbu265NcgWyJDJ0nLb3_DaCUBkqdJ1UXxNbqVdy9K7wHmx7JACo3y56IbNtl1eI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrszHhWOfBgJudf6j-bTfw0zBQh0SbKf7fnGzkoW4pJQ&oe=6AFF1262"}]}, "id": "1382721730514627", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "1782469406344066", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623585_1782469409677399_7560182842706170965_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6kYp7-R9pkQ7kNvwFxKbDb&_nc_oc=AdqGfCWqj48cHUCEygpZGed8PE2KFoxhHtxskrLKNZdqvd_Mrx0L9F8QLVf8S3yIdks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-g8lKizDYYwZlFH8b8FXmzAukHQ5Mq6MGMxDsTwN4zA&oe=6AFF2173"}, {"file_name": "02.png", "id": "1446633677685913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593839439_1446633681019246_6863000315452847716_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XSrYW_ZbnAQ7kNvwGSfwIt&_nc_oc=AdrP7y53tuZFfxZIeR2BijDapK3YgdVaA-SeDIWJt8vnDL97N3Z1wBrXHcE98VrZzvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCNU-dYd8Gds0FRJcRfy_BV5oIzbeFiQ2Ct28GHpN2Ow&oe=6AFF0661"}, {"file_name": "03.png", "id": "1456312936344110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619404_1456312939677443_1771168642530961143_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er10jI8j7bQQ7kNvwFznqu_&_nc_oc=AdqWEs_EzA4fpwnDmZ14RrGwCbkTZLyX10ZaNmQhoEeiA6eKth-n5A1UhwpQRfoDoWg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQst_cS4B6a-g5sp_-UAt1DQg7uCzk25LpEEHlZj3dSgA&oe=6AFF16CE"}, {"file_name": "04.png", "id": "1352970596706324", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623876_1352970600039657_839051556282756434_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmpu-c9dbnEQ7kNvwE_wmLz&_nc_oc=Adpv-aYDohWm2xmrEob6i5246QBhSFVNbNBz7HitLxnfbGPhMDxCNGjRkhryUSKhjgI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROoTBqTVN7O9vK9GRLqOG2FCO13B6SL3mGdAuq5MbHSA&oe=6AFF0CF9"}, {"file_name": "05.png", "id": "1518446763663375", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624606_1518446770330041_3250802175080397974_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNFD2K-f3SsQ7kNvwHs_LBB&_nc_oc=AdqbPQ6eEnQEHxXv5QWKOznxuq1Izm4X7eo98g9XX_FG7T9V_akf3ig6kE5N63xpftA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoZcstNbidRsRrZ0StLaP_RcmSsQeHAALx_slHEgkYWw&oe=6AFF0601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2061743771143945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619059_2061743774477278_5973137550377973980_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcWVwQ7skM8Q7kNvwHZhUX0&_nc_oc=AdrRw3zdbsZOUU6RF9kLkwkpSQp5n8-UlYNd5imbpcHclYIdo94aKlPEpgLFpnuT2jM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5DMLR7_hpYVcvuchOBp0CIsTulvZaFD4OQEjp68UTmA&oe=6AFF0374"}, "display_name": "Cargo Loop: Color Sort Puzzle", "keywords": ["puzzle", "tabletop", "color", "sorting", "cargo"], "long_description": "# SMALL TRUCKS. BIG SORTING CHALLENGES\n\nTurn a miniature cargo yard into your next VR puzzle obsession. Cargo Loop: Color Sort Puzzle brings colorful parcels, moving conveyors and little trucks to a tabletop in front of you.\n\n# MATCH COLORS. MASTER THE ORDER\n\nPoint at a truck to release its next cargo group. Match parcels with the right trucks and plan your sequence carefully. Belt space is limited: send the wrong colors too soon and you could bring everything to a halt.\n\n# 75 LEVELS TO KEEP YOU THINKING\n\nWork through different conveyor shapes and cargo arrangements. Read the board, decide what should move first and enjoy the moment a crowded level finally clears.\n\n# A LITTLE WORLD WITH BIG SATISFACTION\n\nLean closer to inspect your miniature yard. Watch parcels travel, trucks fill and deliveries roll away. Simple controller selection keeps your attention on the puzzle.\n\n# SETTLE IN AND SORT\n\nPlay seated or standing, with adjustable table height to suit your position. Step into the harbor room for a quick puzzle break or work through your next run of levels.\n\n\u2022\t**Color-matching puzzles with limited conveyor space**\n\n\u2022\t**75 levels with varied layouts**\n\n\u2022\t**Miniature trucks and automatic cargo movement**\n\n\u2022\t**Controller-based point-and-select interaction**\n\n\u2022\t**Seated and standing play**\n\n**Can you clear the cargo without creating a jam?**", "short_description": "Sort the colors. Load the trucks. Beat the jam. Take on 75 tabletop VR puzzles with moving conveyors, colorful cargo and satisfying deliveries. Choose your next move carefully: one crowded belt can change everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
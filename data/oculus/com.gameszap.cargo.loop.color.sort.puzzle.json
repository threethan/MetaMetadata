tent-sea5-2.oculuscdn.com/v/t64.5771-25/499623876_1352970600039657_839051556282756434_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmpu-c9dbnEQ7kNvwGGfQad&_nc_oc=Adr-AjLPBl8VkF5S62QXN1ypJQ0Tz4BwkmQykWsxEQC7OYMMYcKaPiC0npTlG3uyTCM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFGHLt7WvJKlcPMsQFI7DG81l49koow6ZytvBOz2T22Q&oe=6AFC69F9"}, {"file_name": "05.png", "id": "1518446763663375", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624606_1518446770330041_3250802175080397974_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr5GkViZk0IQ7kNvwHbereX&_nc_oc=Adr9sD_IMQM9YGEKmLyBgYiliKJpIyddzcWu2eoT-07NQLyPk2aQWdFMEOw7ht8NW3g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvM7h6l8OS97J9Mz-HryBjUuW96JoCThjn0p_HqEgFmA&oe=6AFC6301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2061743771143945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619059_2061743774477278_5973137550377973980_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcWVwQ7skM8Q7kNvwG-cV7s&_nc_oc=AdoHS9W7q9aFyDW93BUSd4LOkU3w0uVXajAKevaxPIlmJPZdhf-qvURlcrhYlqgDsHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYirrv9VtHRRPSI4kfxqEaQ4BwNgrgHshjsbKZ9W84bA&oe=6AFC6074"}, "display_name": "Cargo Loop: Color Sort Puzzle", "keywords": ["puzzle", "tabletop", "color", "sorting", "cargo"], "long_description": "# SMALL TRUCKS. BIG SORTING CHALLENGES\n\nTurn a miniature cargo yard into your next VR puzzle obsession. Cargo Loop: Color Sort Puzzle brings colorful parcels, moving conveyors and little trucks to a tabletop in front of you.\n\n# MATCH COLORS. MASTER THE ORDER\n\nPoint at a truck to release its next cargo group. Match parcels with the right trucks and plan your sequence carefully. Belt space is limited: send the wrong colors too soon and you could bring everything to a halt.\n\n# 75 LEVELS TO KEEP YOU THINKING\n\nWork through different conveyor shapes and cargo arrangements. Read the board, decide what should move first and enjoy the moment a crowded level finally clears.\n\n# A LITTLE WORLD WITH BIG SATISFACTION\n\nLean closer to inspect your miniature yard. Watch parcels travel, trucks fill and deliveries roll away. Simple controller selection keeps your attention on the puzzle.\n\n# SETTLE IN AND SORT\n\nPlay seated or standing, with adjustable table height to suit your position. Step into the harbor room for a quick puzzle break or work through your next run of levels.\n\n\u2022\t**Color-matching puzzles with limited conveyor space**\n\n\u2022\t**75 levels with varied layouts**\n\n\u2022\t**Miniature trucks and automatic cargo movement**\n\n\u2022\t**Controller-based point-and-select interaction**\n\n\u2022\t**Seated and standing play**\n\n**Can you clear the cargo without creating a jam?**", "short_description": "Sort the colors. Load the trucks. Beat the jam. Take on 75 tabletop VR puzzles with moving conveyors, colorful cargo and satisfying deliveries. Choose your next move carefully: one crowded belt can change everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
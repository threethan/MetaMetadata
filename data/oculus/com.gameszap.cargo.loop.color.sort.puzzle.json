_Loop_V01_Icon_512x512.png", "id": "1084916047699266", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624577_1084916051032599_5525113197902647168_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4fdjvdJ-I0Q7kNvwGEMmCK&_nc_oc=AdpJntgTztevTAVqEmLPXKR5rlAXK59xvH3Pk5Frw4jAB9vmgmcSuVAXf1wnpNowT_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs7hmZ9Bik1s3Tyijb8Oi-kb5CjBGicjaq-06AYvNHbg&oe=6AFDC0E2"}]}, "id": "1382721730514627", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "1782469406344066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623585_1782469409677399_7560182842706170965_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6kYp7-R9pkQ7kNvwFE4gGo&_nc_oc=Ado6F9J-vJ3531gf6kCwQDhs906M_A5Zxb3QD34Jt4AWeIuJjhKoqrTlHEoQwezNTOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl5_To073rSAy9D2T5OrFqBqdOyYXAgvv8m5mODldBGA&oe=6AFDCFF3"}, {"file_name": "02.png", "id": "1446633677685913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593839439_1446633681019246_6863000315452847716_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XSrYW_ZbnAQ7kNvwFonfWo&_nc_oc=AdrqMv1Yr2j1kLrPqL4nq7xrjHzN-i1hwmULQrCCahOnswqkqsToGmPfHKRlGVcmqzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSod2vnCRfys6yG7K5cVL7zIubiA6uAnzBeW2FV0mx3wA&oe=6AFDB4E1"}, {"file_name": "03.png", "id": "1456312936344110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1456312939677443_1771168642530961143_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ClrZo2Pvk4Q7kNvwFHy3IS&_nc_oc=AdrOq37qeiqvMGyVZlxqwueyNjWaHzpEEc1cdAFD0SIwR9Xbfd1xlltaIsi9awca-uE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj9wNgstzNP0L8ncexwM_w3ZyE-GQEdiJ4O3gosi5W6w&oe=6AFDC54E"}, {"file_name": "04.png", "id": "1352970596706324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623876_1352970600039657_839051556282756434_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmpu-c9dbnEQ7kNvwFEJgeT&_nc_oc=Adpzei2yQBQ4k-VPog9gNa5B_8I0TdMD6pqyrzKs7_ils9c84qTyfp-ybI32LhmTiy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEtZ3bjI_9Kda0gYc9pTLFtvwe95xltPSOZZaEgOh-9Q&oe=6AFDBB79"}, {"file_name": "05.png", "id": "1518446763663375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624606_1518446770330041_3250802175080397974_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr5GkViZk0IQ7kNvwE7owWl&_nc_oc=AdoQ6P5ApBuFNzTehHPYdCO4IQ-BkmpW4DQQleOHHa4LQGATNNva1X34HN69ES3xgcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTChFacimRJk_MKRctqLJm1GHmxNS1bstGJAh138tY7wg&oe=6AFDB481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2061743771143945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619059_2061743774477278_5973137550377973980_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcWVwQ7skM8Q7kNvwFp-UY4&_nc_oc=AdqpdyC1Nn6Bdu5pL5sdXtnIdS-Qf3EJ1wcf3VePAjUZoD9uCvNAduHZpJAERAU8K9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKNmNeGBzIjAvwvonqkKCcL-MVnnRv4BF8DdX_KAwD2Q&oe=6AFDB1F4"}, "display_name": "Cargo Loop: Color Sort Puzzle", "keywords": ["puzzle", "tabletop", "color", "sorting", "cargo"], "long_description": "# SMALL TRUCKS. BIG SORTING CHALLENGES\n\nTurn a miniature cargo yard into your next VR puzzle obsession. Cargo Loop: Color Sort Puzzle brings colorful parcels, moving conveyors and little trucks to a tabletop in front of you.\n\n# MATCH COLORS. MASTER THE ORDER\n\nPoint at a truck to release its next cargo group. Match parcels with the right trucks and plan your sequence carefully. Belt space is limited: send the wrong colors too soon and you could bring everything to a halt.\n\n# 75 LEVELS TO KEEP YOU THINKING\n\nWork through different conveyor shapes and cargo arrangements. Read the board, decide what should move first and enjoy the moment a crowded level finally clears.\n\n# A LITTLE WORLD WITH BIG SATISFACTION\n\nLean closer to inspect your miniature yard. Watch parcels travel, trucks fill and deliveries roll away. Simple controller selection keeps your attention on the puzzle.\n\n# SETTLE IN AND SORT\n\nPlay seated or standing, with adjustable table height to suit your position. Step into the harbor room for a quick puzzle break or work through your next run of levels.\n\n\u2022\t**Color-matching puzzles with limited conveyor space**\n\n\u2022\t**75 levels with varied layouts**\n\n\u2022\t**Miniature trucks and automatic cargo movement**\n\n\u2022\t**Controller-based point-and-select interaction**\n\n\u2022\t**Seated and standing play**\n\n**Can you clear the cargo without creating a jam?**", "short_description": "Sort the colors. Load the trucks. Beat the jam. Take on 75 tabletop VR puzzles with moving conveyors, colorful cargo and satisfying deliveries. Choose your next move carefully: one crowded belt can change everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
_Loop_V01_Icon_512x512.png", "id": "1084916047699266", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624577_1084916051032599_5525113197902647168_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4fdjvdJ-I0Q7kNvwFSwSzG&_nc_oc=AdpnYJkciAezY79LhzI-C2HwhvBcp8KW0idlytieT-FxdIS-TrUZVG4bFWQes5sp3S8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9A26GgE0Wx0OFoJIGLzs5_bahYeOBpB2zGBWywbbunQ&oe=6AFB1DE2"}]}, "id": "1382721730514627", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "1782469406344066", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623585_1782469409677399_7560182842706170965_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmT5SfsO0E0Q7kNvwGfxuqc&_nc_oc=AdpdyidvDcjXsOgHD_uioGv1eE_8MpoEZBpSenWUb3aNdP9AafH2mWFpr5SAAazoozw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgZ9scsIrOmJJEq_fmpPsr4n-y7mELwhVCPzx47Dzs7A&oe=6AFB2CF3"}, {"file_name": "02.png", "id": "1446633677685913", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593839439_1446633681019246_6863000315452847716_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9Dvsx2bJi0Q7kNvwHWPY1w&_nc_oc=AdrQdNFa-UrmzskVNvR7lmuAtZbXXKa_GCJRY1E7WZXQE56ph6-RYbsmKIklNxC5sKE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkmQL6DSlejv46p9iupNNQ4gbi_l62EiCis5uVMg86LA&oe=6AFB4A21"}, {"file_name": "03.png", "id": "1456312936344110", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619404_1456312939677443_1771168642530961143_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ClrZo2Pvk4Q7kNvwGBzm1j&_nc_oc=AdqKWyID89OTBsGmeI-Tv0XBsFRdxWa9SW1S-sLskNhMaGWuYHniWkLxC42rD6XtrQk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdwznEZEfRkhcrzro1ZB7jZXsJFGaqLt9J6VOmZ-97wQ&oe=6AFB224E"}, {"file_name": "04.png", "id": "1352970596706324", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623876_1352970600039657_839051556282756434_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig4cY6xt_KcQ7kNvwGWjNVW&_nc_oc=AdrYgJfpC2miRko1NCzEHyyvwxgb57KeeRT4y4O5qEzkLMH0dnwL3U4LBexAjIavRAc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXciaQAvYhA_tGXnMF904KfQSOnVptq7vqranOrtNbCA&oe=6AFB1879"}, {"file_name": "05.png", "id": "1518446763663375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624606_1518446770330041_3250802175080397974_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr5GkViZk0IQ7kNvwHam9lf&_nc_oc=AdpGZwjeQfTf8mwif8Gvo_UfEi9dAxCzWh8fsPiPK45dK2HDaz5nfad-Ip1D_4Hdlmg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy_7c8_LyT4UmVwnBhFanl_YU0G1uMXEKZlO6M6BTaiw&oe=6AFB49C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2061743771143945", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619059_2061743774477278_5973137550377973980_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csuahxOySmEQ7kNvwEUw6vP&_nc_oc=Ador6sUUNzshJHPDFH6v07Xv5RV_lLkPAKBNgS8FF-4w754DQUSU6kflwoSTnUADjYk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjyFHOrnPUVEADNCwrYSV08QrviZvvNQpYT1npoU3nQA&oe=6AFB4734"}, "display_name": "Cargo Loop: Color Sort Puzzle", "keywords": ["puzzle", "tabletop", "color", "sorting", "cargo"], "long_description": "# SMALL TRUCKS. BIG SORTING CHALLENGES\n\nTurn a miniature cargo yard into your next VR puzzle obsession. Cargo Loop: Color Sort Puzzle brings colorful parcels, moving conveyors and little trucks to a tabletop in front of you.\n\n# MATCH COLORS. MASTER THE ORDER\n\nPoint at a truck to release its next cargo group. Match parcels with the right trucks and plan your sequence carefully. Belt space is limited: send the wrong colors too soon and you could bring everything to a halt.\n\n# 75 LEVELS TO KEEP YOU THINKING\n\nWork through different conveyor shapes and cargo arrangements. Read the board, decide what should move first and enjoy the moment a crowded level finally clears.\n\n# A LITTLE WORLD WITH BIG SATISFACTION\n\nLean closer to inspect your miniature yard. Watch parcels travel, trucks fill and deliveries roll away. Simple controller selection keeps your attention on the puzzle.\n\n# SETTLE IN AND SORT\n\nPlay seated or standing, with adjustable table height to suit your position. Step into the harbor room for a quick puzzle break or work through your next run of levels.\n\n\u2022\t**Color-matching puzzles with limited conveyor space**\n\n\u2022\t**75 levels with varied layouts**\n\n\u2022\t**Miniature trucks and automatic cargo movement**\n\n\u2022\t**Controller-based point-and-select interaction**\n\n\u2022\t**Seated and standing play**\n\n**Can you clear the cargo without creating a jam?**", "short_description": "Sort the colors. Load the trucks. Beat the jam. Take on 75 tabletop VR puzzles with moving conveyors, colorful cargo and satisfying deliveries. Choose your next move carefully: one crowded belt can change everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
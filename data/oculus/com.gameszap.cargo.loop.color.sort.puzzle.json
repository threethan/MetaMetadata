e": "05.png", "id": "1518446763663375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624606_1518446770330041_3250802175080397974_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC48F0gB2iMQ7kNvwFGVUhf&_nc_oc=AdrzEZ7Km2TFK4XIjFq9MBnjLTascSsIuRmt6TgLa2tQbJBKFuOCSA2jrF8gkZIJPLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVhpMWHfZyN4I6PzXg33AwrDgTILrP7Wiy2-dhqxEvCQ&oe=6B048441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cargo_Loop_Glossy_Cover_01_2560x1440.png", "id": "1086958313964101", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1086958320630767_1752030810609944737_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAx3hx4h0IYQ7kNvwGQQQUb&_nc_oc=AdqrJc87b08pKozQdb36uVMTylbvDkYYkAhdRRM_qa1yX2j4jYPIFXLEb_Wl-X4Hvbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStqn3G5fGqiF4PbWle_KrLtas8QZ1FpE_i-XF12YIccA&oe=6B04525F"}, "display_name": "Cargo Loop: Color Sort Puzzle", "keywords": ["puzzle", "tabletop", "color", "sorting", "cargo"], "long_description": "# SMALL TRUCKS. BIG SORTING CHALLENGES\n\nTurn a miniature cargo yard into your next VR puzzle obsession. Cargo Loop: Color Sort Puzzle brings colorful parcels, moving conveyors and little trucks to a tabletop in front of you.\n\n# MATCH COLORS. MASTER THE ORDER\n\nPoint at a truck to release its next cargo group. Match parcels with the right trucks and plan your sequence carefully. Belt space is limited: send the wrong colors too soon and you could bring everything to a halt.\n\n# 75 LEVELS TO KEEP YOU THINKING\n\nWork through different conveyor shapes and cargo arrangements. Read the board, decide what should move first and enjoy the moment a crowded level finally clears.\n\n# A LITTLE WORLD WITH BIG SATISFACTION\n\nLean closer to inspect your miniature yard. Watch parcels travel, trucks fill and deliveries roll away. Simple controller selection keeps your attention on the puzzle.\n\n# SETTLE IN AND SORT\n\nPlay seated or standing, with adjustable table height to suit your position. Step into the harbor room for a quick puzzle break or work through your next run of levels.\n\n\u2022\t**Color-matching puzzles with limited conveyor space**\n\n\u2022\t**75 levels with varied layouts**\n\n\u2022\t**Miniature trucks and automatic cargo movement**\n\n\u2022\t**Controller-based point-and-select interaction**\n\n\u2022\t**Seated and standing play**\n\n**Can you clear the cargo without creating a jam?**", "short_description": "Sort the colors. Load the trucks. Beat the jam. Take on 75 tabletop VR puzzles with moving conveyors, colorful cargo and satisfying deliveries. Choose your next move carefully: one crowded belt can change everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1376306918900589"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2364324544141640"}, {"status": "PUBLISHED", "id": "1132705502776879"}]}, "baseline_offer": {"id": "1132705502776879"}, "is_approved": t
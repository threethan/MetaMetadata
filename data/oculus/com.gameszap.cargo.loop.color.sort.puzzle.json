_Loop_V01_Icon_512x512.png", "id": "1084916047699266", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624577_1084916051032599_5525113197902647168_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS59EcwvDmoQ7kNvwF55SfU&_nc_oc=AdqKuTNE6VT-o-QgWsP07TUKc35I5OsoigD2RmQrtVupVZeWhtmZSouGxFpkjgL43fA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTnEpVynaALibCUaXSKNKJkZTpTLyBllrM9E5kqf-xvg&oe=6B1035E2"}]}, "id": "1382721730514627", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "1782469406344066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623585_1782469409677399_7560182842706170965_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaJGJQwYPoEQ7kNvwEFnyoK&_nc_oc=AdruO1ZyztnpiG0WRVo1_ry-TleXv67iyLkrnTAl_tdj7gdNtrDHJ6NcVxg3wF0PbMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4BoKv11Lje3SpfK8vcOdHfQ2-kh4ONeI8TS0hDP4yCg&oe=6B1044F3"}, {"file_name": "02.png", "id": "1446633677685913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593839439_1446633681019246_6863000315452847716_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vO4ArDlTsZAQ7kNvwE5xS-N&_nc_oc=Ado3F-O-g6LWiPZr2hU5TRQQkHr0JemtFJ_O5AzwlxbYsfuHF1R3xnTBFKJdNNtEzkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8rDFpZMzvWUOvETAhWShCqe8cNiGsPSngs33-yjYvMA&oe=6B106221"}, {"file_name": "03.png", "id": "1456312936344110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619404_1456312939677443_1771168642530961143_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lk70ZSPZoFsQ7kNvwGSLgRb&_nc_oc=Adq0-p5vPaAGc8c5MxYpZnZe9CY5fcPEyHnTU48ztz2JzyoWGkfmN1Se_r24S6puIT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGYhan_AnW8XLOgFunMGolG4uo4K46dwrC9-f6H3A0Sg&oe=6B103A4E"}, {"file_name": "04.png", "id": "1352970596706324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623876_1352970600039657_839051556282756434_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMtsIvEKVOsQ7kNvwGEhEAL&_nc_oc=AdpwAVAIpNdlklYln1lrGXHvFasyYMJhw4kLp7QygZ_KnlGoNmwCWZxnlnND4mxm68E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhOmlX0ecT0R1buFDuwqpVDvlEQ1u_3USS88ZpmmVOqQ&oe=6B1068B9"}, {"file_name": "05.png", "id": "1518446763663375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624606_1518446770330041_3250802175080397974_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wJUiQOmqLwQ7kNvwHH5hgo&_nc_oc=AdqosLrS1bWnXr6yRHJebksKuHfwcNpzflY2x1powSv-RABsEiwd9hVIvnbx1urHzkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2t3gGADQCp8wZiIIZ9sYOAh01-jOLXfTLoQPTcgdVPw&oe=6B1061C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2061743771143945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619059_2061743774477278_5973137550377973980_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVmxfnO7QO8Q7kNvwHsaA47&_nc_oc=AdrmrltVMCnmL1dSNVniCnFNGLnEr9vzY8q1SlHHFABz_S-8b7JVZfRCbTVA9I586EI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDw4z6kt_m6rcWd1fDBhLZpCgKZn2YVI7kzx3C3h48aQ&oe=6B105F34"}, "display_name": "Cargo Loop: Color Sort Puzzle", "keywords": ["puzzle", "tabletop", "color", "sorting", "cargo"], "long_description": "# SMALL TRUCKS. BIG SORTING CHALLENGES\n\nTurn a miniature cargo yard into your next VR puzzle obsession. Cargo Loop: Color Sort Puzzle brings colorful parcels, moving conveyors and little trucks to a tabletop in front of you.\n\n# MATCH COLORS. MASTER THE ORDER\n\nPoint at a truck to release its next cargo group. Match parcels with the right trucks and plan your sequence carefully. Belt space is limited: send the wrong colors too soon and you could bring everything to a halt.\n\n# 75 LEVELS TO KEEP YOU THINKING\n\nWork through different conveyor shapes and cargo arrangements. Read the board, decide what should move first and enjoy the moment a crowded level finally clears.\n\n# A LITTLE WORLD WITH BIG SATISFACTION\n\nLean closer to inspect your miniature yard. Watch parcels travel, trucks fill and deliveries roll away. Simple controller selection keeps your attention on the puzzle.\n\n# SETTLE IN AND SORT\n\nPlay seated or standing, with adjustable table height to suit your position. Step into the harbor room for a quick puzzle break or work through your next run of levels.\n\n\u2022\t**Color-matching puzzles with limited conveyor space**\n\n\u2022\t**75 levels with varied layouts**\n\n\u2022\t**Miniature trucks and automatic cargo movement**\n\n\u2022\t**Controller-based point-and-select interaction**\n\n\u2022\t**Seated and standing play**\n\n**Can you clear the cargo without creating a jam?**", "short_description": "Sort the colors. Load the trucks. Beat the jam. Take on 75 tabletop VR puzzles with moving conveyors, colorful cargo and satisfying deliveries. Choose your next move carefully: one crowded belt can change everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
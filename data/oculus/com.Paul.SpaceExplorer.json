-7&_nc_sid=6e7a0a&_nc_ohc=fMbwsmlmOsIQ7kNvwEqvT1I&_nc_oc=AdmJYnrFMCO938ur5RQEcUyGVcLeI8aR6fSlhnGbhFC2GIRc4VuY0w5_wMPIJrPxi0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvvbu8xbl32kpdgnQljftF9xxyEr3C0oUTJRDYeNAwsfA&oe=699EEC9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Explorer VR", "keywords": ["Space", "Explorer", "Universe", "Racer", "Astronaut"], "long_description": "Have you always wanted to explore space as an astronaut? Do you know how it feels if there is no gravity? This is your chance to get a great VR experience and join our space program! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\n-Feel like a astronaut and experience space in virtual reality\n-10 exciting levels to play\n-score bronze, silver or gold medals in each level\n-get the high score in each level\n-great graphics\n-Fluent controls\n\nAre you the Master of the Universe?", "short_description": "Have you always wanted to explore space? This is your chance! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\nAre you the Master of the Universe?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "developer_terms_of_service_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "publisher_name": "Paul Games", "support_website_url": null, "website_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL
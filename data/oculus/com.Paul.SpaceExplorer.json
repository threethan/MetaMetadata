.com/v/t64.5771-25/11162788_267569050321433_9051248709911707648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39iO6GLJeuEQ7kNvwHH5kBr&_nc_oc=Adrho78kLhkSIB7-0XpHD6hIOh9WeudlfNd9ZpceqZWKnzDveBBNe79i0PZs-1JWFYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13MchXItgwYjAW6o6FD0Lv9el7md0Bf8pVsY26fPWWKw&oe=69D65DB3"}, {"file_name": "migrated_image.png", "id": "231564721564254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162811_2267534590138555_7220822150452609024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vaKLEfvEr0Q7kNvwH8NHvB&_nc_oc=Adq4uWb3vZsgW0TW5DEKv1q7xzRooabnj4iZgva7KItpWhl8YATfsVktx6afQVZBFfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qjZiCpH0iC4E-C6wlbgXyr1hj8BsDo0Y8jEWE5WBhiQ&oe=69D646B8"}, {"file_name": "migrated_image.png", "id": "140978580652246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162693_118249088718889_4675818534515769344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OV_IBBjX9s0Q7kNvwEOEjFx&_nc_oc=AdrXDiN8cAwmr7glrtiPr5JMCUr3HskjRW9OjhWDpHj83wyWb8zEnFtQxAwbXh4J70w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cnU5rWLDrMaZxjwTb5PZaLpCZW4o7T75TLkBh8FhZdA&oe=69D64454"}, {"file_name": "migrated_image.png", "id": "139399064170314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162823_824819507671119_4318525707014635520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GK3fCe3Ws4MQ7kNvwH7rDXU&_nc_oc=AdoORpC-kQk1l2CL9BIUXAvd4zdfThQyYJnW0OuhnriyKJGdx7fzFzMf_JwiKZy3a44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DScgbC3_qn5NVzpWk8GMjN4t2y34bVVM3yVFmi8SHoQ&oe=69D64B9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Explorer VR", "keywords": ["Space", "Explorer", "Universe", "Racer", "Astronaut"], "long_description": "Have you always wanted to explore space as an astronaut? Do you know how it feels if there is no gravity? This is your chance to get a great VR experience and join our space program! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\n-Feel like a astronaut and experience space in virtual reality\n-10 exciting levels to play\n-score bronze, silver or gold medals in each level\n-get the high score in each level\n-great graphics\n-Fluent controls\n\nAre you the Master of the Universe?", "short_description": "Have you always wanted to explore space? This is your chance! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\nAre you the Master of the Universe?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "developer_terms_of_service_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "publisher_name": "Paul Games", "support_website_url": null, "website_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "626438668411414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727760_1905962123018618_2357
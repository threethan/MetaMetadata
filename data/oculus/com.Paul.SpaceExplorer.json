.com/v/t64.5771-25/11162788_267569050321433_9051248709911707648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=komopImJOaEQ7kNvwH7m9Eq&_nc_oc=Adp0LL-wA5seD2SJj31c9qCVUlBXBaZ6Uc03BOhQqosTqyC8s0vHC8mi8Rppue4BZgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKxvOGlhRxdRDUCcWqHNjqvKmn7UysFD6BYqA3YNeSLg&oe=6A997BB3"}, {"file_name": "migrated_image.png", "id": "231564721564254", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162811_2267534590138555_7220822150452609024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE1nAz49RtIQ7kNvwH-w55r&_nc_oc=AdqanaUvusyRP-8pMBlX7eHG2CfDkXSK0cLPbYvclY5lla1sd3Jg-9zCups8V5cpR24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeylFZXXiUNkyqE8tj5X0M-spDP-ihCY3nGIQsdZRCQA&oe=6A999CF8"}, {"file_name": "migrated_image.png", "id": "140978580652246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162693_118249088718889_4675818534515769344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex_iqCcByTUQ7kNvwEbtAlr&_nc_oc=AdqfTQLKf3NPPZo_N3I68JCXbyrPry7-v6jBRHRRce3Oq2Uxe3-ES9Er_ThjBg9MgoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7i826yzsUuZY55UJbZlLEuDAxU6wDLVZlKKMZVQVFwQ&oe=6A999A94"}, {"file_name": "migrated_image.png", "id": "139399064170314", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162823_824819507671119_4318525707014635520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5Qv5LY--2IQ7kNvwFSvOBI&_nc_oc=Adp9IybifVTYISx94jFvsbuifs_vaZDr67NM5P8GBWI2EukEd7PVGzctvXjpUfwO1tE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAr6tckRoiacy-WdzRBcBJZSLKjBx73PeJycgXbSaDAg&oe=6A99A1DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Explorer VR", "keywords": ["Space", "Explorer", "Universe", "Racer", "Astronaut"], "long_description": "Have you always wanted to explore space as an astronaut? Do you know how it feels if there is no gravity? This is your chance to get a great VR experience and join our space program! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\n-Feel like a astronaut and experience space in virtual reality\n-10 exciting levels to play\n-score bronze, silver or gold medals in each level\n-get the high score in each level\n-great graphics\n-Fluent controls\n\nAre you the Master of the Universe?", "short_description": "Have you always wanted to explore space? This is your chance! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\nAre you the Master of the Universe?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "developer_terms_of_service_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "publisher_name": "Paul Games", "support_website_url": null, "website_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "626438668411414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727760_1905962123018618_2357
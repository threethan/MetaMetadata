.com/v/t64.5771-25/11162788_267569050321433_9051248709911707648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gz9HEPHMiUQ7kNvwF0uYYA&_nc_oc=Adr-kGQOvAUMFguw-xl53YNt8vyMw6Ij2ox5CeB0S_9OiWLF9y_c-YBHXiBkfgO4yo8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7v2YnPSp2BLaZqQAifM4PVoWQ00S7D7j8uoju-4FLXQ&oe=6A58E233"}, {"file_name": "migrated_image.png", "id": "231564721564254", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162811_2267534590138555_7220822150452609024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc-K7bFW80YQ7kNvwGAxznC&_nc_oc=Adpe9G41B4JhDaxLbZpI9eAEN3HSlxLXRwkzk5dL5MJ75d38JtQKQu0z8KbD1p987p8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAE7Me53d-3tSixbzas8BQMvHwfGi69IBIDuKn0gUuVg&oe=6A58CB38"}, {"file_name": "migrated_image.png", "id": "140978580652246", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162693_118249088718889_4675818534515769344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJl2GDRaUp4Q7kNvwG52jsO&_nc_oc=Adoa7o6W7PIR-56U7gNjg8atRywF5RUBpEi18oWlcO13EtkIIF7gdIxUK6XMTH3HMwE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUa0RRKbIv5M7ri02E1LwSUWmBLujGVoLvMkSbh3Yx2Q&oe=6A58C8D4"}, {"file_name": "migrated_image.png", "id": "139399064170314", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162823_824819507671119_4318525707014635520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7J-RzXenNEQ7kNvwEPIrLD&_nc_oc=Adr2MlKg9EgsaGqPKe62J3Uq2Pam-A6GOJa0RBfAOwtJR-CExrMPSEkBojo0cQzTUXs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfKfh2W6V1MR6mIY2BganEaQtuOnrg9v5OTamrwV2WqA&oe=6A58D01F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Explorer VR", "keywords": ["Space", "Explorer", "Universe", "Racer", "Astronaut"], "long_description": "Have you always wanted to explore space as an astronaut? Do you know how it feels if there is no gravity? This is your chance to get a great VR experience and join our space program! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\n-Feel like a astronaut and experience space in virtual reality\n-10 exciting levels to play\n-score bronze, silver or gold medals in each level\n-get the high score in each level\n-great graphics\n-Fluent controls\n\nAre you the Master of the Universe?", "short_description": "Have you always wanted to explore space? This is your chance! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\nAre you the Master of the Universe?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "developer_terms_of_service_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "publisher_name": "Paul Games", "support_website_url": null, "website_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "626438668411414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727760_1905962123018618_2357
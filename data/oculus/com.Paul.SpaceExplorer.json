8_267569050321433_9051248709911707648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJiDDrkTHxsQ7kNvwHeS6ZB&_nc_oc=AdmY26yOOUhGX5JEj-H2iHmdfk8ts5Vp29xOrl2QC4-l9ycVymasi7hFZXHeOVBrkkw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyotrmdAd7RhXfqdkK6JY03eg7zQlVw0DVLOmULqqTrzg&oe=69AADC33"}, {"file_name": "migrated_image.png", "id": "231564721564254", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162811_2267534590138555_7220822150452609024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7CW0tBRMC8Q7kNvwGzVgX7&_nc_oc=AdlY_bavmkna1p2MqvG0qO3iyit7QI60fvQKQQNnrwe9_5kY9QNr4VnWdVUupScsUF4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlBGR6NYtM1fIkkufVPHRzNo9gd2o3BFNJXYVioOpERg&oe=69AAC538"}, {"file_name": "migrated_image.png", "id": "140978580652246", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162693_118249088718889_4675818534515769344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE1KznzbW94Q7kNvwF94cpg&_nc_oc=AdlfwdLgBi1aBveXrkdkw36TU9SZ_Ca1bnma2lvbDwR6qxtd888ZFq2bvZnpyS2HPRk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPRWBvYpd9su2y8mhqYPpznpXdzf9x4QUNHC54DvS9kA&oe=69AAC2D4"}, {"file_name": "migrated_image.png", "id": "139399064170314", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162823_824819507671119_4318525707014635520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYii_BfPkfcQ7kNvwGMG6fj&_nc_oc=AdkMEYZ-I8WOu3wrcVnUp-fPggt4AieQMChslIEsiApwKdGgam8BonJlMV1pNgcyWZw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBqxGsLbsLFQfwHJWW_Bn9kR_v4HEofnrYdP8Ralk0aQ&oe=69AACA1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Explorer VR", "keywords": ["Space", "Explorer", "Universe", "Racer", "Astronaut"], "long_description": "Have you always wanted to explore space as an astronaut? Do you know how it feels if there is no gravity? This is your chance to get a great VR experience and join our space program! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\n-Feel like a astronaut and experience space in virtual reality\n-10 exciting levels to play\n-score bronze, silver or gold medals in each level\n-get the high score in each level\n-great graphics\n-Fluent controls\n\nAre you the Master of the Universe?", "short_description": "Have you always wanted to explore space? This is your chance! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\nAre you the Master of the Universe?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "developer_terms_of_service_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "publisher_name": "Paul Games", "support_website_url": null, "website_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "626438668411414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12727760_1905962123018618_2357174980866736128_n.png?stp=dst-png_s3
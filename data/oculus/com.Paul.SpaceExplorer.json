.com/v/t64.5771-25/11162788_267569050321433_9051248709911707648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es82-o075HYQ7kNvwFuvgU9&_nc_oc=AdrlW9xBKYoiIdelCcD3KzvHvuKEkwcR6ZGPNSxLyG7WB6ZyWXboSvhbA7dkAWJJFZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zjzS8l9t7lmE70p_1lwHzPD9A2HfyGoBGFRXnb4iSdQ&oe=6A2EB233"}, {"file_name": "migrated_image.png", "id": "231564721564254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162811_2267534590138555_7220822150452609024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZER8OpYFqwQ7kNvwGxxjeN&_nc_oc=AdqMmzevsVwBo1nSQdx2qjCIT63yqCZrEneiBidNDS1wClWElgPRfQG_STw2sPeYl6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a82liXvVLHysRC2XhrsaPpnAh-xONrNOa84y5wblNsw&oe=6A2ED378"}, {"file_name": "migrated_image.png", "id": "140978580652246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162693_118249088718889_4675818534515769344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCE2F2XON0EQ7kNvwH8SQft&_nc_oc=AdoajtHVePh5Ga67XKPMdqcjqXR_sI4EIuMEeE_8of-kCMqHC__gLtSVnPXLU2RJ-hs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LiQmZhwJ5s-etcm6hwlpzF6uoWw-XdlvuPskcosYBaA&oe=6A2ED114"}, {"file_name": "migrated_image.png", "id": "139399064170314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162823_824819507671119_4318525707014635520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVgzObmwCAEQ7kNvwHl2cfm&_nc_oc=AdpDWJ3IG3SfpEeaY_9nWS62wDn3dnbLUlUdSNImQ__KqInCpxRwryNUkA9N0wFiHeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v3hoso_DPxTLd4-S2Falm9u5Co75CzlJgtoxNYVGAlQ&oe=6A2EA01F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Explorer VR", "keywords": ["Space", "Explorer", "Universe", "Racer", "Astronaut"], "long_description": "Have you always wanted to explore space as an astronaut? Do you know how it feels if there is no gravity? This is your chance to get a great VR experience and join our space program! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\n-Feel like a astronaut and experience space in virtual reality\n-10 exciting levels to play\n-score bronze, silver or gold medals in each level\n-get the high score in each level\n-great graphics\n-Fluent controls\n\nAre you the Master of the Universe?", "short_description": "Have you always wanted to explore space? This is your chance! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\nAre you the Master of the Universe?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "developer_terms_of_service_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "publisher_name": "Paul Games", "support_website_url": null, "website_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "626438668411414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727760_1905962123018618_2357
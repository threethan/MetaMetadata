.com/v/t64.5771-25/11162788_267569050321433_9051248709911707648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR2ZL0rHK3gQ7kNvwGSsvY3&_nc_oc=AdqBOYhoOvm6mswyihKxHNhCAIYeB977GM28iVmSh0sl04J7dKXxl9naZr2f_1xnG18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKStJTLhcF97W_u2U65Hh-fVq1m29vcD_E7EwpmQ9nVw&oe=6AB52B33"}, {"file_name": "migrated_image.png", "id": "231564721564254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162811_2267534590138555_7220822150452609024_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92w3YKiogOwQ7kNvwHAGplj&_nc_oc=Ado25gDZRvdb3ViPXVmztSSJfrtELqM_3NBSq7D1R3E6b8F-PzWaOCQXRdXzwC3ezas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVJSUX0roI9m6D9QWZJGY4PNhgc_wby_LezlMjeB1i_A&oe=6AB54C78"}, {"file_name": "migrated_image.png", "id": "140978580652246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162693_118249088718889_4675818534515769344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jlq689j795YQ7kNvwEa5zln&_nc_oc=Adr3LrWk0rbe_Kl_Bq1UPQp2oDv65RuU3ItFZ3guu7w_hzAh58HraRzE5TYX76fLlWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6Li0NCguL1n5thRYl1B7qeS-rv_yEMci6g0eiabcGAw&oe=6AB54A14"}, {"file_name": "migrated_image.png", "id": "139399064170314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162823_824819507671119_4318525707014635520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_wEgBp6xskQ7kNvwGL_M1B&_nc_oc=AdpjW96VzdsvKjFPa7PV9FIJmO-s6h4Qrd-erqBwAwry4nUIBFldJ9Ar4upKJax9k2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb0Zj0fr6HHCCYT_dlPZ6TtV0hKDluH0e_LXBGxhsNGA&oe=6AB5191F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Explorer VR", "keywords": ["Space", "Explorer", "Universe", "Racer", "Astronaut"], "long_description": "Have you always wanted to explore space as an astronaut? Do you know how it feels if there is no gravity? This is your chance to get a great VR experience and join our space program! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\n-Feel like a astronaut and experience space in virtual reality\n-10 exciting levels to play\n-score bronze, silver or gold medals in each level\n-get the high score in each level\n-great graphics\n-Fluent controls\n\nAre you the Master of the Universe?", "short_description": "Have you always wanted to explore space? This is your chance! \n\nYou are floating above the Earth where you have a magnificent view on our blue planet. \n\nFly through all the checkpoints as fast as possible as you try to evade the asteroids. Beat the high scores and obtain the golden medal for each level!\n\nAre you the Master of the Universe?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "developer_terms_of_service_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "publisher_name": "Paul Games", "support_website_url": null, "website_url": "https://paulvanderlaan.carbonmade.com/projects/6414941", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "PUZZLE", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "626438668411414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727760_1905962123018618_2357
c=AdrQWvSFDqyRFx4w8EEVXOlIeuwISXs5Vg3jrCdiwjF3SxjMSJBFsXF_RRm0kL5MWQI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyAVUJopu7S_5cH_pHuOGd82jT1sQ625q9r-yKHMwGMA&oe=6B0867E7"}, {"file_name": "03_gallery_in_world_2560x1440.png", "id": "1117961360942446", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620414_1117961364275779_5015018232933314384_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5M1v5b8HrQQ7kNvwEq1tQH&_nc_oc=AdqfO6HM_Vc6xr_k-yWB_bGuQvJMPbZMttD_YIkNqb-HwPUSAXZO9NRC-FxTHh7-X2U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiSB6H2Kbg41Os__hTG47rFXdEJVw9lpLx51_5P5Z_Yg&oe=6B084A52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive Gallery", "keywords": ["Gallery", "Immersive", "Photo", "3d", "Memories"], "long_description": "Immersive Gallery turns the photos you love into 3D worlds that surround you. Pick a photo from your Meta Quest and, in about 10 to 20 seconds, it becomes a world you can stand in, look around and lean into - with its floor lined up with your real floor.\n\nEVERYTHING HAPPENS ON YOUR HEADSET\nAn AI depth model runs right on your Meta Quest. Your photos are never uploaded, there are no accounts, no analytics and no ads.\n\nYOUR OWN GALLERY\n- All your worlds in one window you can move and resize\n- Choose Standard, High or Ultra quality\n- Add up to 20 photos at once and watch each one turn into a world\n- Rebuild any world later at a different quality\n- Select several worlds to delete or convert again\n\nSTEP IN AND LOOK AROUND\n- Tap a world and it opens around you, facing where you look\n- Hold grip and push the right stick to line up the floor\n- Hold grip and trigger to move the world nearer or farther\n- Look down for the control ring: gallery, passthrough, recenter, rotate, previous and next world\n- Passthrough lets you see your room around the photo world\n\nFREE TO TRY\nMake 1 world free every day. Need more? Credit packs are available as in-app purchases.\n\nWorks best with photos that have clear depth: rooms, streets, landscapes, people with a background. Wide panoramas and very dark or blurry photos give weaker results.\n\nRequires Meta Quest 3 or Quest 3S.\n\nSupport email:   info@batlab.store\n\nDeveloper/Publisher: BATLAB\n", "short_description": "Turn your photos into 3D worlds you can step inside. Made right on your headset - your photos never leave it. 1 free photo every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://batlab.store/immersive-gallery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Batlab", "support_website_url": "https://batlab.store/immersive-gallery/", "website_url": "https://batlab.store/immersive-gallery/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1429413126920689"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499620532_3147745428758424_1637094876061369405_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhKkpIH1rpUQ7kNvwGypYHh&_nc_oc=AdpSlg_N7IHm91AQowGV5taj0dEuV04DOnMclTGhe6iQIw6vj2XBYzuguzwT4tHUJ28&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgrpW7Plg39U5Rt-i0ufg5f8ITl7b6DAR52OAb6COkHw&oe=6B086FB7"}, "is_
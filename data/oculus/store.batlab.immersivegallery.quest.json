5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFhu0Q1mBvC5SQi78MOr2WCIkKWUZrQhoFwmrUaDZPxA&oe=6AFF1FB9"}, {"file_name": "05_nearer_farther_2560x1440.png", "id": "1083567444514469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1083567447847802_7921370162822653558_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAcu3yzJH9gQ7kNvwFeL1fM&_nc_oc=AdoK-zVnFe-Q_HWngUn6us_164mQ9G1GK7I0C6_O-XpF19fpck2hPyYhzUKU2pmEEQ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW7IM5fiqIo7_G03W5tHgd2gYWkFBsoEk5TtNjdP0Uvg&oe=6AFF0251"}, {"file_name": "04_gallery_2560x1440.png", "id": "1834617607887181", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499621314_1834617611220514_4204214008730890798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8ccBH1vMTEQ7kNvwEIUd1V&_nc_oc=Adr4Q0aQw0abDlgWXL7ZlmS-71tDR35IVcCIMxe_tf1NluLUxAURILhuQZ6MwGOXP2k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhVybdLppsrp-fo9_Xcu7IR4n9OJXUxWuQ46RJSg9Whw&oe=6AFF2D67"}, {"file_name": "03_gallery_in_world_2560x1440.png", "id": "1117961360942446", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620414_1117961364275779_5015018232933314384_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3QWwyaKOxIQ7kNvwGHkN3H&_nc_oc=Ado9_CmEdV_topaBLsPp25ZpIBahlm6jE3uIIL_fsI5j-Iz1Zf3UzorZ3M351FsBW0Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzmNV7TaI9QGsEI4tfDqYkOoXMwk3DuoWpUAC-ThP66w&oe=6AFF0FD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive Gallery", "keywords": ["Gallery", "Immersive", "Photo", "3d", "Memories"], "long_description": "Immersive Gallery turns the photos you love into 3D worlds that surround you. Pick a photo from your Meta Quest and, in about 10 to 20 seconds, it becomes a world you can stand in, look around and lean into - with its floor lined up with your real floor.\n\nEVERYTHING HAPPENS ON YOUR HEADSET\nAn AI depth model runs right on your Meta Quest. Your photos are never uploaded, there are no accounts, no analytics and no ads.\n\nYOUR OWN GALLERY\n- All your worlds in one window you can move and resize\n- Choose Standard, High or Ultra quality\n- Add up to 20 photos at once and watch each one turn into a world\n- Rebuild any world later at a different quality\n- Select several worlds to delete or convert again\n\nSTEP IN AND LOOK AROUND\n- Tap a world and it opens around you, facing where you look\n- Hold grip and push the right stick to line up the floor\n- Hold grip and trigger to move the world nearer or farther\n- Look down for the control ring: gallery, passthrough, recenter, rotate, previous and next world\n- Passthrough lets you see your room around the photo world\n\nFREE TO TRY\nMake 1 world free every day. Need more? Credit packs are available as in-app purchases.\n\nWorks best with photos that have clear depth: rooms, streets, landscapes, people with a background. Wide panoramas and very dark or blurry photos give weaker results.\n\nRequires Meta Quest 3 or Quest 3S.\n\nSupport email:   info@batlab.store\n\nDeveloper/Publisher: BATLAB\n", "short_description": "Turn your photos into 3D worlds you can step inside. Made right on your headset - your photos never leave it. 1 free photo every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://batlab.store/immersive-gallery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Batlab", "support_website_url": "https://batlab.store/immersive-gallery/", "website_url": "https://batlab.store/immersive-gallery/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
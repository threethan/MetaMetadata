ng", "id": "1093472210130730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623585_1093472213464063_378192423026372968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGMNXOSmCQ0Q7kNvwHVl1UX&_nc_oc=Ado3a_Wf7Ygn-3WAIBvDdps_Y55Wp_VWvBfn7YbBKmbadq0BcMXTRxqIq8oUbgWc0UI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_bLQKNuuW7OYqy-B3h5nnLU1anZdU7n8sp5ytKd2Tdg&oe=6AEA0E60"}, {"file_name": "02_inside_world_street_2560x1440.png", "id": "1419328156453535", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622192_1419328159786868_1908952951381184287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG7Onvkt7rAQ7kNvwFDma1N&_nc_oc=AdpPiEszi5vXn3eyB-aAs9Oifc0ekukjLFU_Y9GimEfp0TaFB678KjbBvmxDYttuzug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSg2LMX0U7tjwA---Uuy8O-BxuLd-R55aOMEc09c7jAw&oe=6AEA07B9"}, {"file_name": "05_nearer_farther_2560x1440.png", "id": "1083567444514469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623131_1083567447847802_7921370162822653558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AotazugnIiIQ7kNvwGz5Z9O&_nc_oc=AdpukRvxgE_6YWMdR-8KWz-SPJKAWkOfwrfroeQeNamSp7dmjl-fE2qz4tEIfxVwYUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNSKhcQGu66T7KPAl3KoQqODbxUKpMfuXXo7Ghy-6Afw&oe=6AE9EA51"}, {"file_name": "04_gallery_2560x1440.png", "id": "1834617607887181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499621314_1834617611220514_4204214008730890798_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71FHMmn37zkQ7kNvwE6XMGO&_nc_oc=Adq4R5gwdBIyuEzcfRYC2l8fDviFQkQ5Ob2K9SsITPYhlP525_dpG6BwU1MIx9RFT2Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbX-GwaJPN1nUk49JUj2QplH8EHjV7MHZA56ria2LBuA&oe=6AE9DD27"}, {"file_name": "03_gallery_in_world_2560x1440.png", "id": "1117961360942446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620414_1117961364275779_5015018232933314384_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOYXMCSqP-cQ7kNvwFIoQqo&_nc_oc=AdrpUiB_BVGFTmMnLpl32CF-POUUgJ3cijfcOBz1C2qkmdc1N4ZQ-Tff3o4Cx476nqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQolGDkj-x7mZKqqm-_A9gmudqPleXrTUQ-iLwsi_buKw&oe=6AE9F7D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive Gallery", "keywords": ["Gallery", "Immersive", "Photo", "3d", "Memories"], "long_description": "Immersive Gallery turns the photos you love into 3D worlds that surround you. Pick a photo from your Meta Quest and, in about 10 to 20 seconds, it becomes a world you can stand in, look around and lean into - with its floor lined up with your real floor.\n\nEVERYTHING HAPPENS ON YOUR HEADSET\nAn AI depth model runs right on your Meta Quest. Your photos are never uploaded, there are no accounts, no analytics and no ads.\n\nYOUR OWN GALLERY\n- All your worlds in one window you can move and resize\n- Choose Standard, High or Ultra quality\n- Add up to 20 photos at once and watch each one turn into a world\n- Rebuild any world later at a different quality\n- Select several worlds to delete or convert again\n\nSTEP IN AND LOOK AROUND\n- Tap a world and it opens around you, facing where you look\n- Hold grip and push the right stick to line up the floor\n- Hold grip and trigger to move the world nearer or farther\n- Look down for the control ring: gallery, passthrough, recenter, rotate, previous and next world\n- Passthrough lets you see your room around the photo world\n\nFREE TO TRY\nMake 1 world free every day. Need more? Credit packs are available as in-app purchases.\n\nWorks best with photos that have clear depth: rooms, streets, landscapes, people with a background. Wide panoramas and very dark or blurry photos give weaker results.\n\nRequires Meta Quest 3 or Quest 3S.\n\nSupport email:   info@batlab.store\n\nDeveloper/Publisher: BATLAB\n", "short_description": "Turn your photos into 3D worlds you can step inside. Made right on your headset - your photos never leave it. 1 free photo every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://batlab.store/immersive-gallery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Batlab", "support_website_url": "https://batlab.store/immersive-gallery/", "website_url": "https://batlab.store/immersive-gallery/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1429413126920689"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620532_3147745428758424_1637094876061369405_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_o0ASch4VAQ7kNvwGm9Njr&_nc_oc=Adr7cYeV53YY8jjfrI9uy_NyVcy3MTq7zB7HhdNZP_FzooTtJf4SPdyIYfDeCNOuB2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRExdFuYCqLKbOgD9Y-K_eCyGrTv4lwDL-Njj-d5-nr5A&oe=6AE9E4F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Immersive Gallery", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1793112360, "lastRevision": {"nodes": [{"id": "1420878354440833", "release_type": "SCHEDULED", "administration_
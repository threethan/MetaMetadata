&_nc_oc=AdoWxR1Gw83iZxTf0Xv_2O4ipCf-caVjhUN4yMOEh0-DtPXylxzaXE-wpfC3c_2MWzo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRyM_GD3X7t73Vk_eqL8WyBrUDAk9OGY-2mUS5lJRvag&oe=6B0B4270"}]}, "id": "2760474957680992", "locale": "en_US", "screenshots": [{"file_name": "01_inside_world_car_2560x1440.png", "id": "1093472210130730", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623585_1093472213464063_378192423026372968_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywldi3wBX30Q7kNvwEK_HQy&_nc_oc=Adr_mIdmqo79iWopncs72OejMHWAYqKr39yKGA2X77ujn9Yw3cerkxU_W0nLObmEcAw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSa-IyIY7civAVOtDMDscsJwBAbNQSFPUrlhhSXfldQEQ&oe=6B0B3C20"}, {"file_name": "02_inside_world_street_2560x1440.png", "id": "1419328156453535", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622192_1419328159786868_1908952951381184287_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-0qB5ktqgAQ7kNvwFWP6BW&_nc_oc=AdoPZZIZEaaKr7D_4GCGCA4CzcJROWaT1csHq6ohyVmk11PwFDVJajPin69suz0w8fE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQB-FRVsHQzKs3S3BGW2qBITwO7ye-TUKrm_O-ox35Ag&oe=6B0B3579"}, {"file_name": "05_nearer_farther_2560x1440.png", "id": "1083567444514469", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623131_1083567447847802_7921370162822653558_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhOYW8NhPWcQ7kNvwHYDVjY&_nc_oc=AdoUzSkh0Wuhb_JgN1SlBd_sFnihGlJxoeHQJIqRnXrCF47r2o-yl0Q38wTFCQXouuE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQY3faSlJYDshK6v7vZPkhrQHQYex9NUNsCtlW4ecqTdQ&oe=6B0B1811"}, {"file_name": "04_gallery_2560x1440.png", "id": "1834617607887181", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499621314_1834617611220514_4204214008730890798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPiAJVcet3cQ7kNvwHSUWBt&_nc_oc=Ado3UAOo5oJ0h7H1zd07ntAMXvwaD7FXoqbeyRxQSe1uz8cipglvnP2YdtGMiKRlKog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQD_nVquuJjlPr2m8tzqwYGIUn88TDuHYeDfBW6XkgNDg&oe=6B0B4327"}, {"file_name": "03_gallery_in_world_2560x1440.png", "id": "1117961360942446", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620414_1117961364275779_5015018232933314384_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5M1v5b8HrQQ7kNvwH2n84G&_nc_oc=Adoa2MtgU9wl3xJM-e7Oe4-6rOnHmWMR28QYQRuxC0K3aonIdS2VX2HU2k1YO3h8VnU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSokuGzdVi8GZvtDoQrDiTVJCbejwhfJAkBBpWqB_5V0g&oe=6B0B2592"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive Gallery", "keywords": ["Gallery", "Immersive", "Photo", "3d", "Memories"], "long_description": "Immersive Gallery turns the photos you love into 3D worlds that surround you. Pick a photo from your Meta Quest and, in about 10 to 20 seconds, it becomes a world you can stand in, look around and lean into - with its floor lined up with your real floor.\n\nEVERYTHING HAPPENS ON YOUR HEADSET\nAn AI depth model runs right on your Meta Quest. Your photos are never uploaded, there are no accounts, no analytics and no ads.\n\nYOUR OWN GALLERY\n- All your worlds in one window you can move and resize\n- Choose Standard, High or Ultra quality\n- Add up to 20 photos at once and watch each one turn into a world\n- Rebuild any world later at a different quality\n- Select several worlds to delete or convert again\n\nSTEP IN AND LOOK AROUND\n- Tap a world and it opens around you, facing where you look\n- Hold grip and push the right stick to line up the floor\n- Hold grip and trigger to move the world nearer or farther\n- Look down for the control ring: gallery, passthrough, recenter, rotate, previous and next world\n- Passthrough lets you see your room around the photo world\n\nFREE TO TRY\nMake 1 world free every day. Need more? Credit packs are available as in-app purchases.\n\nWorks best with photos that have clear depth: rooms, streets, landscapes, people with a background. Wide panoramas and very dark or blurry photos give weaker results.\n\nRequires Meta Quest 3 or Quest 3S.\n\nSupport email:   info@batlab.store\n\nDeveloper/Publisher: BATLAB\n", "short_description": "Turn your photos into 3D worlds you can step inside. Made right on your headset - your photos never leave it. 1 free photo every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://batlab.store/immersive-gallery/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Batlab", "support_website_url": "https://batlab.store/immersive-gallery/", "website_url": "https://batlab.store/immersive-gallery/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1429413126920689"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620532_3147745428758424_1637094876061369405_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3A7b0Zg0zQQ7kNvwH2a8E3&_nc_oc=AdrJaq2UblIcYp9_JKQ15jsqPC1pZUqH9SO81zgTNGvKrObd0GQY49qfZ0cnsLYuDiQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpd38jNhrN0Hc8S4jax_WK4mtyuYEtiio1RsYVq8kfeQ&oe=6B0B12B7"}, "is_
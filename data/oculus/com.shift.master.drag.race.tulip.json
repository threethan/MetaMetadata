183871666484659", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818877_1183871669817992_562244911449039459_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9osisRGKjsQ7kNvwGJ6dJV&_nc_oc=Adq5kTPDMk5vv684ziTf1aCNhuT7_2tUzY3CaYBfS40plodmiexQHo-tkXXu9SwNduk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdMZkzvxb6Hs5ZU-wU9Q-fGZce3lQG5GUFp3N_FyyR9g&oe=6AA56B8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shift Masters VR \u2013 Drag Race Simulator", "keywords": ["DragRacing", "FormulaRacing", "CarRacing", "CarDrifting", "ShiftRace"], "long_description": "Shift Masters VR \u2013 Drag Race Simulator puts you in the driver\u2019s seat of the most intense drag racing experience built for Meta Quest. Feel the adrenaline as you line up on the strip, watch the lights drop, and time every gear shift for maximum power. With realistic VR controls, your reaction speed and shifting accuracy determine whether you win or stall out.\n\nStart with beginner rides and climb your way up by unlocking faster cars, tuning engines, upgrading parts, and challenging tougher opponents. Every race tests your precision, timing, and focus as you chase that perfect shift.\n\nEnjoy immersive cockpit views, powerful engine sounds, motion feedback, and true drag racing physics that make every run feel real. Compete in classic quarter-mile sprints, reaction-time challenges, and high-speed tournaments designed to build your skills.\n\nWhether you\u2019re a car enthusiast or a competitive racer, Shift Masters VR delivers pure drag racing excitement with easy-to-learn controls and addictive gameplay. Hit the gas, shift at the perfect RPM, and become the undisputed king of the drag strip.", "short_description": "Experience the thrill of perfect-timed gear shifting in immersive VR drag races. Master the clutch, hit perfect shifts, upgrade your car, and dominate the strip with skill, precision, and lightning-fast reactions. Become the ultimate Shift Master in the most intense VR drag racing simulator."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32539167215731592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823326_1845611020163210_8043883493870784298_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd0D1aPSWy0Q7kNvwG06cT4&_nc_oc=AdqWKHk8Kx9rNL3ginKAZ9G8EENPN4paKQV9ukT42WIGfafn-AKkHlCoHqEXmpnPD1w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoXXY5sT8rkp_Tjoq7VmqWEPi8sw1ejY0KqrRugt0n8Q&oe=6AA556C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shift Masters VR \u2013 Drag Race Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"
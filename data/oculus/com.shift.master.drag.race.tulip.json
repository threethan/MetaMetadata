opponents. Every race tests your precision, timing, and focus as you chase that perfect shift.\n\nEnjoy immersive cockpit views, powerful engine sounds, motion feedback, and true drag racing physics that make every run feel real. Compete in classic quarter-mile sprints, reaction-time challenges, and high-speed tournaments designed to build your skills.\n\nWhether you\u2019re a car enthusiast or a competitive racer, Shift Masters VR delivers pure drag racing excitement with easy-to-learn controls and addictive gameplay. Hit the gas, shift at the perfect RPM, and become the undisputed king of the drag strip.", "short_description": "Experience the thrill of perfect-timed gear shifting in immersive VR drag races. Master the clutch, hit perfect shifts, upgrade your car, and dominate the strip with skill, precision, and lightning-fast reactions. Become the ultimate Shift Master in the most intense VR drag racing simulator."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32539167215731592"}, 
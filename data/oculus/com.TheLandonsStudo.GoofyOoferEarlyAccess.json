hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NImcdpcFwu4Q7kNvwGJwgnE&_nc_oc=AdrWN0EePVRy9lQzC2wWxIKR0dlbeRTnnfvBQyu41mRsxBsF8Hg93YT9Iu9B67eATSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCMXAfOIJOy2d3E5dOpYwQ_MtZN1XBjqtLhHlImaRJ_Q&oe=6AA812FC"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc_M7bN1_8IQ7kNvwGR2d__&_nc_oc=AdqOMy_ifu-XW1NmudY-TzDhRyg0l1X_hyfO4KXfpGDD9NQKeAXdfBzgsdu0IPoFQck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOCAFeRdUtNsU7Fz2k3Qw8K0ph2GV7aTUUJm1VyrZEMQ&oe=6AA7EB8D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSVmdvU0mCsQ7kNvwEAHdxU&_nc_oc=AdqQVq508C1wNAtYZBAf3b4ah2q_FfzPWlxWsXcBxOlnYKFVA6eFnUPGtvC7ILTaQh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsU7GNKXo2pet1qr6l7xXpZTeYiLTTfLsPikL1I1xzLQ&oe=6AA81C9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_5nY-7gfLQQ7kNvwFHER7X&_nc_oc=AdpVhPB-Dj0gfJonF_bkCK62uH3KvfwO0opWdkrk8JMeGKsRv9mchCeFeBgvn55Xci0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yLI_Tk-kmgCyVQdIpe2_-xF50RoGbddkdT2wUe0Olmg&oe=69D4EABC"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPTJKgmHVKEQ7kNvwF7bPkI&_nc_oc=AdqTodTeeyT7WJtA1avrEwBNUhnxHqEmbOwVeuvDqr7p1f2UuUSzyC9p6A6IkK23ciQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kBHRJ9q5oiGMtLkH62VnFzcUZOCOvN6xn4fi4aIxMgg&oe=69D4FB8D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA1No4_e238Q7kNvwHfjei5&_nc_oc=AdpIqctSS4QXSx7phG4XJIz4g2tb8eiVYPmgYfMmD_YV4w5jHO_-8nE4c9Wtch6zwWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aG9tRvS6Cj_LhmgE5h6u3SpsMeJd9sRaakG1GQYE6VA&oe=69D4F45A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
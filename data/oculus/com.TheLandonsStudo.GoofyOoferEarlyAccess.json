hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNyk6Ortw-MQ7kNvwEvBHpS&_nc_oc=AdpEAKRMReDpz5MXpMuQdi41zIXqZYRhlv-vDB4jvw2QZrzlGd80Q3g2eOKtTQaRgaw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk9DheX-CFV40Oqv0gziCB7IydkJnyIsaJVLl9B8eghg&oe=6A4E6CFC"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Rkzqky2mD0Q7kNvwEzHnM8&_nc_oc=AdqGCD4QDK3VJEyHYcHB69GBTiOPZrIycfEsDoJ6yVaIPkKe53037VJfTtsd9r2YvOQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGC7zBFXsa-oTgn06-30i76JSaJ__pqF6ABkNkPKwDxA&oe=6A4E458D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPw9noxeJWwQ7kNvwHJdT2E&_nc_oc=AdpDlWytsBMgJIe1CsUmKuPyjTxnL1nRllnUe7oIGiAnQADdzWNMtAYvbYgZFLC3fjk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaws5stWAe2_qPnPER3jSjBi388HkknVE98LGVIJWlxA&oe=6A4E3E5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0USIVwPZ9M4Q7kNvwE-5Rcl&_nc_oc=Adp-JAeQ7bvc2w-xfIsgkA0uGfnSKimXsvlFLQPcod7l18f-53rWqsFQh6gR8KepNf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lhRgZBADsK8SQW5lUlODWz1KRxZnlaJImK5T03WNOvQ&oe=6A38037C"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GhOdEAaav0Q7kNvwHJrUNQ&_nc_oc=AdqgQ2G2EKohpxPbgQHJ5QqDwL0W_ldYvFoHAsrsz05n_UE0v7rNi2Mzlo6wwcCA0XM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S58C-56r3pcH7m5hymSGYwSlEPdwAMOylErwZh-jlcQ&oe=6A38144D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k58rd-3OpgMQ7kNvwHgFK4x&_nc_oc=Adpp7fCPalCCoCQUoq5x9jaGTvoNvcsFI1_93v5oPkI7wwHUZBNiocAVhHTz0lE8BmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xP9vkDQR16iYzb-ZyT_TPUUvsV6iMrMKTq4GRDf_v4A&oe=6A380D1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
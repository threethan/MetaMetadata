hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xNH2RZp_1MQ7kNvwGkw5iL&_nc_oc=Adrc276_2ujL0N1ARJefFngowmLC4DDSfjUu83BaoTsGCQIuGW_xLP9Ukhx70KoF7-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaH0rACLXu5UKtZvByA24Fa3_hCtGsKp2qBBKLaBJOKQ&oe=6AC3C27C"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH6r17MA6lwQ7kNvwE7EbqY&_nc_oc=AdrZqKV6bMq2Fh-seXmA_vv4-yYtENLoXKDFznwhCdg9s3exy0wug8PGs0eJjkS_Qsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV3JRN7I8WSEqZS7WsvwFMUmiIoEq9zX4ZuYQbSlxppg&oe=6AC3D34D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv4yuhCavUYQ7kNvwGVOB7Z&_nc_oc=Ado4PbHB2rXjl-KkIr8RXPhpYAnVFcxAohyads9EMD5v7Exunp3hA0IHsQUYeu5jUbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdFNnB6uXKvXuPCOtR57lsbDUCtVkdJ6Np-gycm4zovg&oe=6AC3CC1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
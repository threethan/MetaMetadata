hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NGNOzZtB50Q7kNvwGUHK4z&_nc_oc=Adq6exvOF60OhV2OJ3oIZ6aEa7M2rviLJIhz5wvLOGfzlssgRs89yr8zcYj4ItLooQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQx8GSstPC4Bf7P40v-MuaRTT_iy6mZAovfVGGm39vyw&oe=6A9ED87C"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6G-HOyqC8QQ7kNvwHfnMo0&_nc_oc=AdqgweFqsz8SLxSF1y-xyYHt8B9qSpnqHsCItsZmn9Oric7pT1VZmIINgQOpOTkimXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxNt86HRhs1T3CDGax7o-xPm44xD_C0rFN0uBLSWhZog&oe=6A9EB10D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3jguJ8hR3oQ7kNvwG9wsqO&_nc_oc=AdpIhKBz9B5ECn7rHlpzkC_K0bQf7gwz4RI-eMB6_D37D1YpcS8xkcxaYCXGCV1tn_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbwr9RHYsiu7jJqhfC0dpZnu0EkVCJ_Ve8_zO-A-jVdg&oe=6A9EA9DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aagID4_ts8sQ7kNvwHnVMWm&_nc_oc=AdqwJQM1z_RTVfrAiq7lRqN2vTQFgF3BC-aWELZZd62bnxVXo8xAn2Aoo_L5JPKk7Kg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-LDeGG_mjR43zAtl8-haLNA7gpTBBFDj2v0rCk2woeA&oe=6A26DFFC"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgxvAfIPasoQ7kNvwGwb-gA&_nc_oc=AdpV65kewUJwxQSraHpN7QUYTkM5WsxYpeTXSdKr5RHj3WEi4X7bfRgaOS8lIWBlJlM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ccUeuI1Mj_78zRp4x2_bEgNlk-zgLWoDeBzTeLGa81A&oe=6A26B88D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LjqYhSfkskQ7kNvwFXkOSC&_nc_oc=AdpK0vpQeQvYRIFjmCW1hxDYgsmlq9ifPqlFxC8BfuxcUywcJEXcg_TaZV3HxTzFsu8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RTSuO_GmfrCJ9Hkh9rt3WC3nQ_q-mvj7dABvKLAmS6A&oe=6A26E99A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
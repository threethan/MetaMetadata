hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH_4Utw0nuUQ7kNvwFPkoQ0&_nc_oc=Adox4qCC8ZmzumcACDM6qEr7DEQ8VtrW0afQYPRs72GHOlx9EQpCwjZmEFHvS9TneZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b9uMe8tJfmuJ-uTJ77V3hNCtna86kQULWa_9QTpqmQQ&oe=6A3E9AFC"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxUrYMcaVpsQ7kNvwHgpzjr&_nc_oc=Adq2AyFf0bnFw445kwsGaRRO8GdM3GBNLPOUyE-zTByHk2bFB22iLH2GZwqlWKmTZX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XxIS5ncGSWGLqeWxmo9qhC8WiAYK8XlRbNGWIU1GJ8g&oe=6A3EABCD"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39ltXhcIk9gQ7kNvwEhmRGz&_nc_oc=Adq6-aIckBF_spp8eNVCagTmQ6Kjg7luHfFLMGIJPyjhDdvDv8MFhJ4kEp2RxyA-inQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xFnJrQfjWGVMC8DqUxhOu2HdEebyxzRx-SVzzCocXEA&oe=6A3EA49A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
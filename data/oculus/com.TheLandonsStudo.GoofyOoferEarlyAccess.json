hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDC8E_PlAdYQ7kNvwGav_px&_nc_oc=AdrrzhXatJy7JMDenfxaDtDBYubyg3QaiF54hKRXisE7WaL9fLo8Wh71RyNQ1F91_RY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J3SUn825yQsRQDjY-R1DiFjnAWc2rEaXiPoVZLiWVTQ&oe=69E8B13C"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1F9XyWPlysQ7kNvwHP-p52&_nc_oc=AdraUKTgdR9po_nhgayBhkqEMg1OQjXWI7uUv4h4XNTCsM6Auk73rO7yyJgNOrt2IDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dVN6VUia_7ru4ek5LyVHXdOzKGpcXc9vrtJ5bb2D_AA&oe=69E8C20D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGAOjbfeNicQ7kNvwHjXWsH&_nc_oc=AdrxDcp5MsvAoVVN9INkTtXG43XDq1A5xTocow9cQKiNWEkDME3W70nwAOE3dhwWQmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SX9RisYmtmsLwWvWZiElo5ZGjTzQ77iV_DttMhA_uMQ&oe=69E8BADA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free."}]}, "developer_name": "The Landons Studio", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b1043236-33a0-42a1-b8fa-c2cdd53b0010", "developer_terms_of_service_url": null, "publisher_name": "Jon Landon", "support_website_url": null, "website_url": "https://sites.google.com/view/thelandonsstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9403105783035903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622023_449960574812677_2366275862884993303_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrhjjuSpoN8Q7kNvwHWgR8B&_nc_oc=Ado3IFbCxuNmmIeqBerlnUvn7tOKXKFSLAxu1d7TAD4EhElf4THPMbo_-bZZ1LdB5vI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jYjxL2KeI8zquPejXH5HgVXG--RmhQOPs9ybpbQK4ow&oe=69E8AFD3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoofyOofer", "platform": "ANDROID_6DOF", "context_categ
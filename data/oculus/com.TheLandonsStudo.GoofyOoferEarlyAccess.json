hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5PhwtXiHz4Q7kNvwFCHhYA&_nc_oc=Adq026QQkWDPm5qwkLlno_eCCL-f3fcP-hKqMvYxwBsymS6lpnQ3VOu0J-Nj18d5TUA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiHKyw6NX_UEf6AJImvkLghILTpRu1G76ZxllVLjhl6w&oe=6A819F3C"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=290TA_eQxWEQ7kNvwEL-D35&_nc_oc=AdpIEpW4l_uS-6UeG940luFxTcBBZ5W_koz44AcJSoRhbl4qjRMgPiqfGPwIhrG16Yc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESZsziIb1DBe0NaUMH2PCF1_peQk2tOpUl3SlEXfkWQQ&oe=6A81B00D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHGko4ZJ8EwQ7kNvwFSK4xA&_nc_oc=AdoIYzHU5Q0hgFJPDU_ydZMY7UfQBm2gqMZVz4t8L31MakkMz_Tx1yJZugVmYgTiegs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmVZA5BZkpcnp4_nPi4kEFFWF8liVe1vSBe5Qw1hU16Q&oe=6A81A8DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
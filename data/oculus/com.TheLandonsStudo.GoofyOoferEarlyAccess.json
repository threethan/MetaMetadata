312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmekuPvSW7gQ7kNvwE_Lr3Y&_nc_oc=Adlqtvu8xLTvNd0eWozbjwGa8NRC9QD743GmpH4xP6RYdJtw-Wrc2VYTdMFyR-yU2E0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft75MZ6UjHmHg2LE7Y9U1UTwIn6navHChohv7DibysPqQ&oe=6999973C"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cilo6IKiBJYQ7kNvwGL8-cc&_nc_oc=AdkPr9_HrAlOdjEdz9NEdxhsquYQw-l11ZsrurxSrP9Hi_TVqN3YHJvHJAyABqPJdr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmtV-qvCwVLkK2_XwyrqQsZaV1js3X8BWFRH-qCJvy4w&oe=6999A80D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBwBegDa6mUQ7kNvwETq7EO&_nc_oc=Adlzaww2G_T6X-aNV6kBnEQl26Xf0PJHkHx2d59o_hp5_4RYmNXAQwDt2GL60ckpev4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftp0P2kC7zbwWBhcgd8PgQqcP0cmQrJRHTNXBMWkC_4dg&oe=6999A0DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free."}]}, "developer_name": "The Landons Studio", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b1043236-33a0-42a1-b8fa-c2cdd53b0010", "developer_terms_of_service_url": null, "publisher_name": "Jon Landon", "support_website_url": null, "website_url": "https://sites.google.com/view/thelandonsstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9403105783035903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622023_449960574812677_2366275862884993303_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwvtRzRFR9sQ7kNvwF0NAs8&_nc_oc=AdmE90GywcMbspUeiQARevT_SRCG40oiD2ssn_5HpoTiutEavonJPqlR1M65BfgHICw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftd800K1EVMFGU-v5OB3rZJwsfx_fh5FYR3YHczNHgiPg&oe=699995D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoofyOofer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1733783760, "lastRevision": {"no
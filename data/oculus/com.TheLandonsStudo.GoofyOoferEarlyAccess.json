hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym2NqJzNF48Q7kNvwG8s-BQ&_nc_oc=Adr01IaYR4LLwoGW1WkFkoCTTHIq4kWEKFdrBWwy4DIpvWcgmsExLcG4AfF_C5m5yqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhbiDdLFQPU2LTPN-xlA3NgRelivj1KkWvas2gfaf-8g&oe=6ABA87FC"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z__7gpEjlksQ7kNvwE3o4iM&_nc_oc=AdrcYH71JyJQTeGWVxB5sLWZ5uVWgnMGK-p-b-B-4W8uticpp383QGFoHZ40vJY59Pw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi8sooIwxLVp7xm7jwn8x_LRQ5MzZvKRSzPP2qCYLhAg&oe=6ABA608D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLFb7nNjMNIQ7kNvwHLMjow&_nc_oc=AdrdOrUOV4NdEwCc_TKAdtIIev5d0cCrwYpFVhkqMdd0ql-so1Sc3rakpudO2nla__8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9kg6U3PPv3grLAHdlpjLWp4c3kZ4_4rXt_gEYhbVxFw&oe=6ABA595A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game w
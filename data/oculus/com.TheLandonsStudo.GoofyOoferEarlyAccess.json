hot 2024-12-04 182809.png", "id": "1085149306258970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540506_1085149312925636_6131579653421489203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWqSxPlWti0Q7kNvwGle9qP&_nc_oc=AdrJdguQ6rVuPkSqrAFmxxl8esXNGAY8zm5hweNGa47UtL8T6GKlFesALh0zqXjrs04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r9Q2HYqFh1jFg0oB-7vm8UtKA0AYDsESgXQ-TkhpSaQ&oe=6A088D7C"}, {"file_name": "Screenshot 2024-12-04 183005.png", "id": "4213717535527766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375749_4213717538861099_4020599651298427082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqHDsF79s9cQ7kNvwH8Yjh1&_nc_oc=AdrQLWy54neZ_W5gKCUdzmRvcgRhRDEf5z4ao5_1jBzGN8UAm2ugwFjqIjhQQoVwPxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HDgS0BhqOOJG_jBwo5SR_AcPZ6ck8CPRwAYgK2Fra8A&oe=6A08660D"}, {"file_name": "Screenshot 2024-12-04 183241.png", "id": "499640243131183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569446_499640246464516_3150957488509734960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLI9biWrsSoQ7kNvwFsdA7P&_nc_oc=Adq-comi0M2CcBCwCFFKq8mJN10LU6jkou0DEVVIpjVwM9pfHgJ5EfYEVseUO61AEoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QawhuruFMhHgMuYBANzTXkZ9jr3pCUGltw0IXy4U4-Q&oe=6A085EDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoofyOofer", "keywords": [], "long_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free.", "short_description": "GoofyOofer is a Multiplayer Horror VR Game where you play as a Chimp and can only move with your hands with NO LEGS!! You also have lots of opportunities like exploring a cave with monsters inside and going deeper inside down to a secret lab with more monsters, you can also play TAG with other Chimps! or just be in a casual game mode with other chimps. You can also go shopping and get new Clothes and Hats and More! Welcome to GoofyOofer! Play now for free."}]}, "developer_name": "The Landons Studio", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b1043236-33a0-42a1-b8fa-c2cdd53b0010", "developer_terms_of_service_url": null, "publisher_name": "Jon Landon", "support_website_url": null, "website_url": "https://sites.google.com/view/thelandonsstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9403105783035903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622023_449960574812677_2366275862884993303_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CElHr2ltT30Q7kNvwEUiOpK&_nc_oc=AdpAxIRpfyjae2wxouVytMGSOcdshfueBrG3xSv5gRtAORqdHP2TyxsLEufvOm3hu9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_-eBhhuDVDHcgzipiIyIWTp_buf8vWpLHQscfgB3mgw&oe=6A088C13"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GoofyOofer", "platform": "ANDROID_6DOF", "context_categ
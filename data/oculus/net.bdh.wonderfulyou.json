time asleep, music becomes part of your dreams.\n\nOriginal Music by Timo Baker. Executive Producer Rob Hifle. Written & Directed by John Durrant.\n\n*Please be aware that Wonderful You has a large file size and will not download if your device does not have enough available storage space*", "short_description": "Academy award nominee Samantha Morton presents an interactive virtual reality experience, immersed inside the womb.\n\nWONDERFUL YOU uses the latest scientific research to reveal remarkable stories from the development of your senses; Touch, Taste, Smell, Sound and Sight.\n\n*Please be aware that Wonderful You has a large file size and will not download if your device does not have enough available storage space*"}]}, "developer_name": "BDH Immersive", "developer_privacy_policy_url": "https://www.bdh.net/legal/terms", "developer_terms_of_service_url": "https://www.bdh.net/legal/terms", "publisher_name": "BDH Immersive", "support_website_url": null, "website_url": "https://www.wonderfulyouvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "446246773813725"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_140032856653903_243549513543843840_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkUTX9lEWuYQ7kNvwESucHF&_nc_oc=Adr8ArmzsbcFwz2tBXB-3pts_zb3amXROM0sW39ypUMRt5943TMTrCsmeAPbi7iH03k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_
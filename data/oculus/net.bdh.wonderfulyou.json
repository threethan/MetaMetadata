ERFUL YOU uses the latest scientific research to reveal remarkable stories from the development of your senses; Touch, Taste, Smell, Sound and Sight."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bdh.net/legal/terms", "developer_terms_of_service_url": "https://www.bdh.net/legal/terms", "publisher_name": "Burrell Durrant Hifle Design & Direction", "support_website_url": null, "website_url": "https://www.bdh.net/immersive/wonderful-you", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "310510511093245"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1675092222556878", "version": "1.28"}, "id": "478547315864795", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1458677940864975", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1675092222556878"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "478547315864795"}]}, "change_log": null, "created_date": 1524024909, "id": "1675092222556878", "version": "1.28", "version_code": 128, "release_status": "RELEASE
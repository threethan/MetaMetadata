0a&_nc_ohc=Vpx-B5KICKEQ7kNvwH-agqL&_nc_oc=Adm-S1EEEqRzYPMw4hI9L1OD0h2Vv0tneuKi-0wjday2pyuTOy4Ois6LJzBG0CrSPb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsPZhJ8A8HGUg0C2BMq179ouAcyIE4aNh2Ir02aHLMNFw&oe=69A98E8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wonderful You", "keywords": ["Baby", "Womb", "Experience", "Trippy"], "long_description": "Academy award nominee Samantha Morton presents an interactive virtual reality experience, immersed inside the womb.\n\nWONDERFUL YOU uses the latest scientific research to reveal remarkable stories from the development of your senses; Touch, Taste, Smell, Sound and Sight.\n\nMeet your unborn self. Tickle your feet, play sounds in the womb and release odours into the amniotic fluid.\n\nA few weeks before you are born you can smell what your mother can smell, taste what your mother tastes and you now have a memory for music. And as you spend most of the time asleep, music becomes part of your dreams.\n\nOriginal Music by Timo Baker. Executive Producer Rob Hifle. Written & Directed by John Durrant.", "short_description": "Academy award nominee Samantha Morton presents an interactive virtual reality experience, immersed inside the womb.\n\nWONDERFUL YOU uses the latest scientific research to reveal remarkable stories from the development of your senses; Touch, Taste, Smell, Sound and Sight."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bdh.net/legal/terms", "developer_terms_of_service_url": "https://www.bdh.net/legal/terms", "publisher_name": "Burrell Durrant Hifle Design & Direction", "support_website_url": null, "website_url": "https://www.bdh.net/immersive/wonderful-you", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUI
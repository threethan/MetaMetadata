.oculuscdn.com/v/t64.5771-25/75367587_263168988624628_4279498952983010061_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7BUpt4Ye54Q7kNvwFj0kOV&_nc_oc=AdrYiFI3J3Vin36a-sweoX8-k7oUP0r-KvDp0r_CYhJ0v-HnJWvzO6cFneCH8SLH5do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgDRHHbcE_5GAz2I3aXBhvU7v8J1pJ8Zfavh7YbTXOEQ&oe=6A5E2AB8"}, {"file_name": "screenshots-04.png", "id": "235361545120175", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572952_235361548453508_7721360369209125995_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn6M0-5XtHwQ7kNvwFNQ4CC&_nc_oc=AdrvSpf0Cj8FEV6AI0KFmhkU-WTwSgBLUgVVSf3ezq-rCuL0zQw1KTV0axPDpHJxDHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4XraAVy94eiM3GRW6OvlUhdgffqMQCehtCbOHzmMKLQ&oe=6A5E29AD"}, {"file_name": "screenshots-05.png", "id": "619966682303262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982665_619966685636595_2397008825105073622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltr4S6nkq78Q7kNvwH_AXCs&_nc_oc=AdpHTh44VLJnLXRJxdHmS9JKaQPTRQejv9vM1JCI-e9kp_W0p5A-BcKFnSdvWZ96f2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq5xVZa1zfYez3kcZLz4umfj5hvjaXavqtAoZC5zwyxw&oe=6A5E0B0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart(2560x1440)-01.png", "id": "550421809740361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196220_550421813073694_4775986216480313415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXWBfU06ir0Q7kNvwHrO8Hy&_nc_oc=AdoGWU25m95LD1rxIVF_sLuJd1sToFHCcrJ8uBChCkWdS-ZhapmGHeBbVyHWJnopDDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlLnZk6ndTpZuWtCh-MuUIoCiS-baku8dlBi-HJdwWgQ&oe=6A5E1A9F"}, "display_name": "Cavrnus", "keywords": [], "long_description": "Cavrnus\u2122, the most versatile spatial immersion and collaboration technology available, enables enterprise leaders to empower their people through unparalleled awareness, focus and reasoning to grow together as teams. The result is clearly better decisions.\n\nDesigned as an open metaverse platform, Cavrnus\u2122 allows enterprises to build and share interactive mixed reality experiences across teams for connected growth.\n\nThe solution consists of a spatial collaboration environment, plus voice, video and screen share (video conferencing). Multiple users join the virtual environments from any physical location and enjoy true cross-platform support out-of-the-box with Cavrnus\u2122. Endless extended reality applications for use such as: meeting, training, site planning, live events, virtual production studio, experiential marketing and many more!", "short_description": "The Ultimate Metaverse Builder Platform\u2122."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cavrn.us/utility-pages/privacy-and-terms", "developer_terms_of_service_url": "https://www.cavrn.us/utility-pages/privacy-and-terms", "publisher_name": "Cavrnus, Inc.", "support_website_url": null, "website_url": "https://www.cavrn.us/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9856792221052034"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75514542_1174912756354391_3164469724144764313_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPDsj7dA5fIQ7kNvwE
.oculuscdn.com/v/t64.5771-25/75367587_263168988624628_4279498952983010061_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pYJ3hPl6I4Q7kNvwGKuh0n&_nc_oc=Adp8JukkGN0MKCxXJlCQ1UHeekYhJnninK-lFth8Px9Zg-U_3-v-qgXCkpAhywq0Uys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCunD625FfHj1vePxmH9HDI5pTrEF8UHayGRyZI7-Oqog&oe=6A6A0838"}, {"file_name": "screenshots-04.png", "id": "235361545120175", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572952_235361548453508_7721360369209125995_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hzT6AKs-qUQ7kNvwG7pcsj&_nc_oc=Adrc4o8O1uotsnbuDBQ6Eyctma7Warhik1qMY23aG-YW6pba1Zoo115xquVKDwsFnuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8WfYHnqRQeq1amAkv1Zs4rLLsv2crh2QgZtdwlUBQ4g&oe=6A6A072D"}, {"file_name": "screenshots-05.png", "id": "619966682303262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982665_619966685636595_2397008825105073622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89rHpiehc_IQ7kNvwGPB6Vn&_nc_oc=AdqZU0depWyXKFQz4GJ3DLAFjpmoHlRCTw9PvhuOfWI1yY8HvM_Ur_ovQ1yS93A_Qus&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA93krx0Rpd5Gv6UeTUXQzZ76vpBK70F5RHVeg7DJcDdQ&oe=6A69E88B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart(2560x1440)-01.png", "id": "550421809740361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196220_550421813073694_4775986216480313415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0GL7Hnkk7IQ7kNvwE937AQ&_nc_oc=Adp9hB9k8voiI12b7Z9jC4y9rRCF-sTAyObl02r4_LBmrEYcnxZnOdjO1NrYuRYwCmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCPvzfRf5D3KcX3KIRdmfOjXRX6d9wKdGEKNMUudQZRQ&oe=6A69F81F"}, "display_name": "Cavrnus", "keywords": [], "long_description": "Cavrnus\u2122, the most versatile spatial immersion and collaboration technology available, enables enterprise leaders to empower their people through unparalleled awareness, focus and reasoning to grow together as teams. The result is clearly better decisions.\n\nDesigned as an open metaverse platform, Cavrnus\u2122 allows enterprises to build and share interactive mixed reality experiences across teams for connected growth.\n\nThe solution consists of a spatial collaboration environment, plus voice, video and screen share (video conferencing). Multiple users join the virtual environments from any physical location and enjoy true cross-platform support out-of-the-box with Cavrnus\u2122. Endless extended reality applications for use such as: meeting, training, site planning, live events, virtual production studio, experiential marketing and many more!", "short_description": "The Ultimate Metaverse Builder Platform\u2122."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cavrn.us/utility-pages/privacy-and-terms", "developer_terms_of_service_url": "https://www.cavrn.us/utility-pages/privacy-and-terms", "publisher_name": "Cavrnus, Inc.", "support_website_url": null, "website_url": "https://www.cavrn.us/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9856792221052034"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75514542_1174912756354391_3164469724144764313_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jQhh0iwyqkQ7kNvwF
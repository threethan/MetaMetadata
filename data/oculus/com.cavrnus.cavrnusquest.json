gether as teams. The result is clearly better decisions.\n\nDesigned as an open metaverse platform, Cavrnus\u2122 allows enterprises to build and share interactive mixed reality experiences across teams for connected growth.\n\nThe solution consists of a spatial collaboration environment, plus voice, video and screen share (video conferencing). Multiple users join the virtual environments from any physical location and enjoy true cross-platform support out-of-the-box with Cavrnus\u2122. Endless extended reality applications for use such as: meeting, training, site planning, live events, virtual production studio, experiential marketing and many more!", "short_description": "The Ultimate Metaverse Builder Platform\u2122."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cavrn.us/utility-pages/privacy-and-terms", "developer_terms_of_service_url": "https://www.cavrn.us/utility-pages/privacy-and-terms", "publisher_name": "Cavrnus, Inc.", "support_website_url": null, "website_url": "https://www.cavrn.us/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9856792221052034"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75514542_1174912756354391_3164469724144764313_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC4_EQUayf0Q7kNvwH
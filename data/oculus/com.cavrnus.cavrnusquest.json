ual production studio, experiential marketing and many more!", "short_description": "The Ultimate Metaverse Builder Platform\u2122."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cavrn.us/utility-pages/privacy-and-terms", "developer_terms_of_service_url": "https://www.cavrn.us/utility-pages/privacy-and-terms", "publisher_name": "Cavrnus, Inc.", "support_website_url": null, "website_url": "https://www.cavrn.us/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "522701053331562"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "3620245804912172"}, {"status": "PUBLISHED", "id": "2165071713663016"}, {"status": "PUBLISHED", "id": "915143053153281"}, {"status": "PUBLISHED", "id": "5836525913127522"}]}, "baseline_offer": {"id": "2165071713663016"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706817600, "status": "PUBLISHED", "id": "3620245804912172"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9856862751044981", "version": "2025.1.0"}, "id": "805131986842142", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4331
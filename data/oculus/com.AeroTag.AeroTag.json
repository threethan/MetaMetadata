keywords": [], "long_description": "Aero Tag takes the classic Gorilla Tag movement you love and pushes it into the sky. Built for players who crave speed, precision, and vertical freedom, Aero Tag transforms every surface into a launchpad and every chase into a high\u2011flying duel.\n\nUse your hands to run, climb, vault, and blast yourself upward with aerial momentum. Whether you're racing through tight corridors, scaling massive structures, or leaping across floating platforms, every movement feels fluid and skill\u2011based. Tag becomes more than a chase \u2014 it becomes a test of creativity, control, and pure adrenaline.\n\nPlay casually with friends or master advanced techniques to dominate competitive lobbies. With smooth locomotion, responsive physics, and a clean, atmospheric world, Aero Tag delivers a fresh take on the VR tag genre while staying true to the fast, chaotic fun that made it iconic.\n\nRun faster. Jump higher. Fly further.\nWelcome to Aero Tag.", "short_description": "Aero Tag is a fast\u2011paced, movement\u2011driven VR tag game where you launch, climb, and soar through the air. Master momentum, outplay your friends, and rise above the map in this high\u2011energy Gorilla Tag\u2013style experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1RoWDavtPvtUPyt0Z7cSISwtnXpcGSGEFBtcu8VkMOVs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RoWDavtPvtUPyt0Z7cSISwtnXpcGSGEFBtcu8VkMOVs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommen
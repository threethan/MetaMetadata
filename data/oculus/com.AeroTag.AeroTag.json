ag_2026-01-27_15-59-33.png", "id": "1382823986486483", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499304162_1382823989819816_6875502407240212743_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNsLlAHfj34Q7kNvwEAa9s7&_nc_oc=AdqkHVMSjNwzgbNNl1gbyUhHxD8jmQcZeh0Zvj8fupVik3Gbxm48avOgHSJqDh4eOoA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRubPmGVKyAIVyqvNVTQ9OtLF0X29WASEF-DPUeXysnpg&oe=6AFC917C"}, {"file_name": "GorillaTag_2026-01-27_15-59-20.png", "id": "888893860551595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300993_888893863884928_194420821829893871_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo4TxrF1u-YQ7kNvwGGju2I&_nc_oc=AdosRq6yybn3SmiudYSBQ6IpjFeDJTu34eRflMXO14LG-4PMHk_W1riwKL-EovJwv6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsYSKSr9x0FjpRLzDoWaxZGkbP_GbycRTTwydBe82nMw&oe=6AFC6907"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aero Tag", "keywords": [], "long_description": "Aero Tag takes the classic Gorilla Tag movement you love and pushes it into the sky. Built for players who crave speed, precision, and vertical freedom, Aero Tag transforms every surface into a launchpad and every chase into a high\u2011flying duel.\n\nUse your hands to run, climb, vault, and blast yourself upward with aerial momentum. Whether you're racing through tight corridors, scaling massive structures, or leaping across floating platforms, every movement feels fluid and skill\u2011based. Tag becomes more than a chase \u2014 it becomes a test of creativity, control, and pure adrenaline.\n\nPlay casually with friends or master advanced techniques to dominate competitive lobbies. With smooth locomotion, responsive physics, and a clean, atmospheric world, Aero Tag delivers a fresh take on the VR tag genre while staying true to the fast, chaotic fun that made it iconic.\n\nRun faster. Jump higher. Fly further.\nWelcome to Aero Tag.", "short_description": "Aero Tag is a fast\u2011paced, movement\u2011driven VR tag game where you launch, climb, and soar through the air. Master momentum, outplay your friends, and rise above the map in this high\u2011energy Gorilla Tag\u2013style experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1RoWDavtPvtUPyt0Z7cSISwtnXpcGSGEFBtcu8VkMOVs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RoWDavtPvtUPyt0Z7cSISwtnXpcGSGEFBtcu8VkMOVs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25816322284669505"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25816584861309914", "version": "1.1.76"}, "id": "1582311473020214", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25816322271336173", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "
png", "id": "25617759777917369", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499303198_25617759781250702_657289331065826912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x56j-t9MkFUQ7kNvwEvcFWv&_nc_oc=AdrsREIcAPpqD-o_r7KqUzoqRnLloy2TUpckGnhlyMyV-hxLNOKl3cCE1LBh6zjvDI8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG_4eNKpB6TePqU_8-39SZRNxvkb0FN-fdy53uwpyimA&oe=6A9406E0"}, {"file_name": "GorillaTag_2026-01-27_15-59-36.png", "id": "862564146603458", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499300678_862564149936791_743811074723648426_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7iMMbgnyFcQ7kNvwFgQsQT&_nc_oc=AdoIojKVebdfh5LlK4p5wkNVhW98HD-az9TALr_CBuReCBKwiDQA2WIfNXHY118XrX4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAV5mCsvc7oDk2iO7jf0BZu0ykcQ856MSdV1H_L6qseQ&oe=6A940848"}, {"file_name": "GorillaTag_2026-01-27_15-59-33.png", "id": "1382823986486483", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499304162_1382823989819816_6875502407240212743_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxkM3AoBmJAQ7kNvwEwmrHa&_nc_oc=AdrMrYKfMG5f7fGYKyEsvIdBVxxVQmrD2BAZG4MOkhZ52X8iul9mlOoiSXBIMjQKRzs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy597KzXFsGpd663BuH2LEsKg00roQBW1mn4VK4FUT3g&oe=6A9432BC"}, {"file_name": "GorillaTag_2026-01-27_15-59-20.png", "id": "888893860551595", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499300993_888893863884928_194420821829893871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pQHSJRTXAkQ7kNvwHG18xc&_nc_oc=Adpd1NJEa8xVNAD2207vVwL_zyMUUpwQCQghLkwd1dqXTSA4ZDzGINc3kW1VJ6h0Cwo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoN4hwJnx8t8zzFsrzklkC-zROny8nQXbWnOav2vbflQ&oe=6A940A47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aero Tag", "keywords": [], "long_description": "Aero Tag takes the classic Gorilla Tag movement you love and pushes it into the sky. Built for players who crave speed, precision, and vertical freedom, Aero Tag transforms every surface into a launchpad and every chase into a high\u2011flying duel.\n\nUse your hands to run, climb, vault, and blast yourself upward with aerial momentum. Whether you're racing through tight corridors, scaling massive structures, or leaping across floating platforms, every movement feels fluid and skill\u2011based. Tag becomes more than a chase \u2014 it becomes a test of creativity, control, and pure adrenaline.\n\nPlay casually with friends or master advanced techniques to dominate competitive lobbies. With smooth locomotion, responsive physics, and a clean, atmospheric world, Aero Tag delivers a fresh take on the VR tag genre while staying true to the fast, chaotic fun that made it iconic.\n\nRun faster. Jump higher. Fly further.\nWelcome to Aero Tag.", "short_description": "Aero Tag is a fast\u2011paced, movement\u2011driven VR tag game where you launch, climb, and soar through the air. Master momentum, outplay your friends, and rise above the map in this high\u2011energy Gorilla Tag\u2013style experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1RoWDavtPvtUPyt0Z7cSISwtnXpcGSGEFBtcu8VkMOVs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RoWDavtPvtUPyt0Z7cSISwtnXpcGSGEFBtcu8VkMOVs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
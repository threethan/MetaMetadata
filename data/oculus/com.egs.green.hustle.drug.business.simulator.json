XAQC&_nc_oc=AdqUlII3dcWgXQHtqX-2WBMwaThnHkMDiH7l-IA3wlhzeuu2ARQYajOXiquZYhOqmNo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkvQCJq2QOnQ2M91ddYH6XXXW7ZQeXzBi_lb6Jpuu5yA&oe=6AF32552"}, {"file_name": "3.png", "id": "2976525516019818", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_2976525526019817_5555385247235631858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzCyANLP4woQ7kNvwGZ7EK5&_nc_oc=AdoXLS7EHyuZNP5kzt6GWE3mZr3kMfaa_W0up7dy4JLZAL5fZfQphrynhkFY0Ua6tVY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6TTx0gcNH7_3P-7T5wadglNpS6FP-CBIIs8SE2QyJAg&oe=6AF3376F"}, {"file_name": "5.png", "id": "1053722204093591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825497_1053722207426924_2299468056144082916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-iAfzZMwUsQ7kNvwES51Iv&_nc_oc=Ador_NngtpkUyR_c3iBzhWC_xbQznW18Sg1SkgvgGEHB-6gAPNvJ4BgsCqCQ577T2sA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsKFJFIVw6flVwRntnaxWiDGMiCXTQglVSnTDrpvZZVw&oe=6AF3550A"}, {"file_name": "4.png", "id": "4423026351245585", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824741_4423026357912251_4520353405711594156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_roRXTH7EUcQ7kNvwG_Rmqj&_nc_oc=AdpaZlIJzRa7Wvl4Agz5oHJTejitHlqJkyZ7CpkfJnO7hZVhQcSTAJFl89T14hM-giY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLnM2u_7lD4cZ69HVEjPKjpXbd3q9RcX7GNIfAkyq5eA&oe=6AF33480"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Green Hustle: Drug Business Simulator", "keywords": ["dealer", "crime", "tycoon", "underworld", "management"], "long_description": "Begin with a hidden grow room, a few plants, and the ambition to build something bigger.\n\n**Green Hustle: Drug Business Simulator** is a hands-on underground business game. Grow your product, make sales, collect cash, and reinvest every profit into your expanding operation.\n\n**GROW IT BY HAND**\n\nPlant crops, water them, apply fertilizer, and manage each stage of growth through tactile first-person interactions.\n\n**MAKE THE SALE**\n\nServe customers, complete deals, collect your earnings, and decide what to improve next.\n\n**UPGRADE YOUR OPERATION**\n\nUnlock useful equipment, improve your grow room, and turn a small setup into a more profitable business.\n\n**FACE THE RISKS**\n\nMost deals are peaceful, but an occasional encounter turns violent when an aggressive customer attacks. Grab the available firearm, defend yourself, and survive.\n\n**GAME FEATURES**\n\n* Hands-on planting, watering, fertilizing, and selling\n* Physical first-person interactions built for VR\n* Cash management, equipment, and business upgrades\n* Customer transactions and progression\n* An occasional self-defense shooting encounter\n* A fictional crime-simulator setting\n\nStart small. Grow carefully. Sell smart. Build your green empire.\n\nThis is a fictional entertainment experience and does not teach or facilitate real-world illegal activity.", "short_description": "Build an underground drug business with your own hands. Grow, water and fertilize crops, sell to customers, reinvest profits, upgrade your hidden operation, and defend yourself when an occasional deal turns hostile."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVE
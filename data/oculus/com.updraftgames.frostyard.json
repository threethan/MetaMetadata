kN7pltQmvBkIRqvSIKjj08-SbHMvfOwj2UMzTCV3WpEln7Zn6FbHvg2OE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO339wBrcqM6OwZ8iKTfzH0FIyh9J8GAY86vXNL4i-Qw&oe=6A8EE1AB"}, {"file_name": "ss5.png", "id": "2150041255836992", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619485_2150041262503658_6891929872540475416_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0NLFt3PbLkQ7kNvwHanipo&_nc_oc=Adr4cUtPxNJuglgnV4m2x9yfpA9lzT_IKJrNJWYzNkBE-PMLQdF-WD7ZS_bbYwztlYw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmOCKzCK_n0SEtcHYSIt90P4GeKI4b-EGXXIJnRiCBKQ&oe=6A8EE648"}, {"file_name": "ss3.png", "id": "1008623985444776", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499623345_1008623988778109_6902178711883487478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BUqvgptqg4Q7kNvwGCuW8n&_nc_oc=Adqua7p4It9mpeyyHb9YTMm3uG4JwRZ9jkdV-eGvuz3L_jx1kaUVXxeR5Ad3zzqZjQM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBrYAxgSEBFLstROeZYfS8B5u_cf4K4vm11rpnBruGpw&oe=6A8EE9FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fymain2.png", "id": "1493291438648759", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619588_1493291441982092_1145326189730200642_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYgBlkl4krIQ7kNvwFiTc30&_nc_oc=AdoF5bMmUc5Cxxh1HbkHdtEu341qS5_Y-UgnwuDtEzIBEtT5I4jiuPuAKYE4mw062Uw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPSIFoCL7sXD2jXQOLkQwm-BJwu9vK9ZnGo82b_Qf_nQ&oe=6A8ED996"}, "display_name": "Frostyard", "keywords": ["winter", "snow", "family", "playground", "cozy"], "long_description": "Welcome to Frostyard, a cozy winter VR playground where snow, stars, and frozen fun come together.\n\nThrow snowballs at a moving snowman target, aim for the hat for bonus rewards, and collect stars as you play. Glide around the ice rink in a timed loop challenge, follow checkpoints, grab stars along the path, and try to finish with your best score.\n\nUse the stars you earn to unlock new attractions, including the ice slide, skating area, and special winter effects. Each activity is designed as a quick, easy-to-play VR minigame with simple controls, playful audio, haptics, and a relaxed snowy atmosphere.\n\nFeatures:\n- Snowball target challenge\n- Ice rink loop race\n- Collectible star rewards\n- Unlockable ice slide and rink content\n- Cozy winter playground setting\n- Simple VR interactions built for quick sessions\n\nFrostyard is a small, lighthearted VR winter playground made for players who want a casual snowy experience, quick minigames, and a cozy place to mess around in VR.", "short_description": "Step into Frostyard, a cozy winter VR playground filled with snowball games, ice skating, stars, and unlockable frozen attractions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://updraft.art/#privacy", "developer_terms_of_service_url": null, "publisher_name": "UpDraft Games", "support_website_url": null, "website_url": "https://updraft.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1168230866373573"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2079613316232374"}]}, "baseline_offer": {"id": "2079613316232374"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781810640, "status": "PUBLISHED", "id": "2079613316232374"}]}, "liveChanne
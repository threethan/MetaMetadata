2MNQgDqBpaqAPBQ2jL4osrjH7E8unmfq1ay0wWOL_jhSpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGk2t87S9Mf_tSUzfJ1EOcYG-MVsYA3w9P0cN95nnRhg&oe=6AEE05EB"}, {"file_name": "ss5.png", "id": "2150041255836992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619485_2150041262503658_6891929872540475416_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PrN_syE8p4Q7kNvwFWok2x&_nc_oc=AdpGPy90hC1sZaXQUpwfnwCoEvWZDj72JcAH9fX2fm5RdTzBQQpVDblO195PtJu9Hd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7cWFYhK8eaSiw8igGUtcQrKdtRStAplDyHNyznrQTpQ&oe=6AEE0A88"}, {"file_name": "ss3.png", "id": "1008623985444776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623345_1008623988778109_6902178711883487478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz_6ZdpVFN0Q7kNvwEDIttL&_nc_oc=AdoxrhhrfqgiwaqQhvGIok7jgXYg7KlY1P32O38GsN34GeZkrWJKOw0HaB4D6M4jw50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLTg97dfEEJ10q0fV16DqeyZh9daI-v4LXCS_8Atq89w&oe=6AEDD5FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fymain2.png", "id": "1493291438648759", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619588_1493291441982092_1145326189730200642_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9ZKn9NEI8MQ7kNvwFQLdGM&_nc_oc=AdrWwMonGyjhVyy_Wc731YSgluBAq_x6_0SP_dGBVgOcSlgtFNZzUML0AkPn-AVQ2j8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkwDK38AwgyLrzYwwxUkrL5j49byYepVIpZDWf1nqWZQ&oe=6AEDFDD6"}, "display_name": "Frostyard", "keywords": ["winter", "snow", "family", "playground", "cozy"], "long_description": "Welcome to Frostyard, a cozy winter VR playground where snow, stars, and frozen fun come together.\n\nThrow snowballs at a moving snowman target, aim for the hat for bonus rewards, and collect stars as you play. Glide around the ice rink in a timed loop challenge, follow checkpoints, grab stars along the path, and try to finish with your best score.\n\nUse the stars you earn to unlock new attractions, including the ice slide, skating area, and special winter effects. Each activity is designed as a quick, easy-to-play VR minigame with simple controls, playful audio, haptics, and a relaxed snowy atmosphere.\n\nFeatures:\n- Snowball target challenge\n- Ice rink loop race\n- Collectible star rewards\n- Unlockable ice slide and rink content\n- Cozy winter playground setting\n- Simple VR interactions built for quick sessions\n\nFrostyard is a small, lighthearted VR winter playground made for players who want a casual snowy experience, quick minigames, and a cozy place to mess around in VR.", "short_description": "Step into Frostyard, a cozy winter VR playground filled with snowball games, ice skating, stars, and unlockable frozen attractions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://updraft.art/#privacy", "developer_terms_of_service_url": null, "publisher_name": "UpDraft Games", "support_website_url": null, "website_url": "https://updraft.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1168230866373573"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2079613316232374"}]}, "baseline_offer": {"id": "2079613316232374"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781810640, "status": "PUBLISHED", "id": "2079613316232374"}]}, "liveChannel": {"nodes": [{
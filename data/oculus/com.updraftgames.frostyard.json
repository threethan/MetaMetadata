"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620875_1540861960901881_6599858586196909484_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OACg8F2uT-8Q7kNvwGXOq8P&_nc_oc=AdpflMSdXmKmT6idAbEOGBTbd1usyihinczmklyd2mHapT39urMp5gSV7yJOX9nlpRE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG3zoH36V0L9KMrrXB_967dvkZU93pnjKBR8d0CfIg3A&oe=6B031DEB"}, {"file_name": "ss5.png", "id": "2150041255836992", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619485_2150041262503658_6891929872540475416_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egDwHHT5-FQQ7kNvwEuKzbP&_nc_oc=Adqhv83M0keyD48E8pfrcxpnAXigyv_gPgpSmZRY_wl-G2RPvON4if2QLBIcWBP-Bns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUJB0AbLyYMZCImfdKwoz7GXECgRDVW6zS3qZGzkz8Nw&oe=6B032288"}, {"file_name": "ss3.png", "id": "1008623985444776", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623345_1008623988778109_6902178711883487478_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_LOJ1xuEeoQ7kNvwH_ajCo&_nc_oc=Ado0TyLBfI4rxxO7ovoWH4FOH3pkWSukMOUkbPsSGFJ46uOSCpGsohdJH6983Hfd3WQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWAeK5RVTnSIX9NU4uwCipHzAA0eOqm-mmMomd76Jhpw&oe=6B03263C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fymain2.png", "id": "1493291438648759", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619588_1493291441982092_1145326189730200642_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1ccpVczmnIQ7kNvwFOc_MP&_nc_oc=Ado01s700njAjXkkE3vnXGLGFtZICVa3hQFkBbMpHvdVY7zaFF_Emvqs_pf_Kk9nkBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4QDZjpAM8xgPIpOOafYlN-Ypzth1DC4PWh9pWovz_Jw&oe=6B0315D6"}, "display_name": "Frostyard", "keywords": ["winter", "snow", "family", "playground", "cozy"], "long_description": "Welcome to Frostyard, a cozy winter VR playground where snow, stars, and frozen fun come together.\n\nThrow snowballs at a moving snowman target, aim for the hat for bonus rewards, and collect stars as you play. Glide around the ice rink in a timed loop challenge, follow checkpoints, grab stars along the path, and try to finish with your best score.\n\nUse the stars you earn to unlock new attractions, including the ice slide, skating area, and special winter effects. Each activity is designed as a quick, easy-to-play VR minigame with simple controls, playful audio, haptics, and a relaxed snowy atmosphere.\n\nFeatures:\n- Snowball target challenge\n- Ice rink loop race\n- Collectible star rewards\n- Unlockable ice slide and rink content\n- Cozy winter playground setting\n- Simple VR interactions built for quick sessions\n\nFrostyard is a small, lighthearted VR winter playground made for players who want a casual snowy experience, quick minigames, and a cozy place to mess around in VR.", "short_description": "Step into Frostyard, a cozy winter VR playground filled with snowball games, ice skating, stars, and unlockable frozen attractions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://updraft.art/#privacy", "developer_terms_of_service_url": null, "publisher_name": "UpDraft Games", "support_website_url": null, "website_url": "https://updraft.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "11682
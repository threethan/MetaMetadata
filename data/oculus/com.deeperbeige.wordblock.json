4721184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_738448038054517_8319233969549787171_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTXNJ6_y_LwQ7kNvwGXo_5O&_nc_oc=Adlg_BnJKafaAZ0qAJUgp4--3zbMDBuPP8sZ5-GzGTZFXGSEn52y6afiTOtxG2mgGgE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfunKpS8Yf93uRF4pTotLbXKWOVSxr_dXrQg_BmCLH0C7Q&oe=69A6DDE9"}, {"file_name": "AOWB_Screenshot__0002_Layer-7.png", "id": "1516537762246406", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001654_1516537765579739_4871949579833868510_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6YBopIjcTMQ7kNvwEK-H2-&_nc_oc=AdnGhluSymKYAOYVt_Y-JjF-hbtMXs9kp00b2cgV68BvqRNTaD3kX38m_2Ehv_8z5dU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpTlBamXp_0cheAT2CMK1mi89AerKvaELMaOakSB3z_w&oe=69A6F0F2"}, {"file_name": "AOWB_Screenshot__0001_Layer-10.png", "id": "730877722445491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982724_730877729112157_3368435981660093747_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZO0kIJpSZgQ7kNvwElDlxx&_nc_oc=Adk2m_yc4kOhG9DhPt2RVpAJY0vYD90gN6jPB3hEcDA0Vsjt5WAXhOClRnzXo4kk9cI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftA4zlo3-qf41hFdgBW-rEo1GFAmzo-styf7owIK3emIQ&oe=69A6DE25"}, {"file_name": "AOWB_Screenshot__0000_Layer-11.png", "id": "2132171110471297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566685_2132171113804630_6020297435780050098_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3UeSpFNutkQ7kNvwHUE5_2&_nc_oc=AdlBH8aKIbg0p3qN3-_i2db2I710jJymL8UTBTMYcmM3PRcMeMR2azTZbxXewkyHYN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmxAob0B1uW_lssbmNRX_oKy9NVIYh5CqNokbVkYUlUg&oe=69A6D4CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Word-Block-Trailer-Image-2560x1440.png", "id": "1613346342808754", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003253_1613346346142087_2107283030342275446_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl7_Xy7384MQ7kNvwGtbLoG&_nc_oc=AdlYxGNdP2qtVJV3gwSfzlWf8jJ-qajvX-pwGh0Ct5AXDE7Pe40TiaE5AFDe6XkmoKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHI7VtDNeA-kYJb1vY_owYgc8ZXW3a0A49pFP7IWmZCA&oe=69A6D08D"}, "display_name": "Arthur Owl's Word Block", "keywords": [], "long_description": "Let Arthur Owl guide you through this blend between a 3D crossword and a category quiz. He's on hand to help you learn the ropes and give you hints when your vocabulary fails you. He'll even teach you how to make your own puzzles.\n\nIncludes around 300 free puzzles and a fully featured editor to make your own. Submit them for inclusion in future user packs!\n\nThere are six premium-themed puzzle packs available to purchase for a total of over 400 puzzles.\n\nFeatures\n - 400+ puzzles, ranging from trivial to taxing\n - Hints for when you get stuck\n - Fully featured puzzle creator mode\n - 7 visual themes to suit all tastes\n - Fully adjustable settings\n - Personal puzzle statistics\n - Over 25 achievements\n - Meta leaderboards for each puzzle\n - In-game store for extra packs and hints\n - NEW: Unlimited Hints DLC!\n - NEW: Daily puzzle mode\n\nJoin the Discord!\nhttps://discord.gg/VmA5fWPryw\n", "short_description": "Meet Arthur Owl and his clever game Word Block. With around 300 included puzzles and even more in downloadable packs, you'll have plenty to do!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/k7bxbiereh7x0liq094u1/PrivacyPolicy_TOS.pdf?rlkey=g3v0s8py80d7hzxpnfnjth0uk&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Deeperbeige Games", "support_website_url": null, "website_url": "https://deeperbeige.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
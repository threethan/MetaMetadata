6", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001654_1516537765579739_4871949579833868510_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlRKop04-I0Q7kNvwHb9gtB&_nc_oc=Adk_hEM1FbuhrHKypv99heO_kLVej2H1rSxhrr240mDP3tGlilos9EqFZPwmknjMniI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft64hTYJDA3_7K65092sVXZl8CsRkxr35tG9rNN1hldYQ&oe=699B1372"}, {"file_name": "AOWB_Screenshot__0001_Layer-10.png", "id": "730877722445491", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982724_730877729112157_3368435981660093747_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNTC-TDpo28Q7kNvwHDOgTM&_nc_oc=Adlr7iQPJzPY7f9J4efQpfSbCoX7ait-WCFlKxgw_M4V2wtS6-1M6ab_SwRnyGLoVsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv2ujr-stkKbULwZ5whP_RIfXiyrnWbAu9dmERMK51ceA&oe=699B00A5"}, {"file_name": "AOWB_Screenshot__0000_Layer-11.png", "id": "2132171110471297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566685_2132171113804630_6020297435780050098_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR3wHzPRGjUQ7kNvwER2pZv&_nc_oc=AdnErLRyZfN7NubcrE4um6i4_L_kNleWkN8KhUTrnrbBmBY0wjctJunyTzyNa5uS_OI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftzRrDlmU93AHkkzOsEWZm4hox6ezBEm_gLBjU7eNW2_Q&oe=699AF74C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Word-Block-Trailer-Image-2560x1440.png", "id": "1613346342808754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003253_1613346346142087_2107283030342275446_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Boop3G-BSEEQ7kNvwEqxBL3&_nc_oc=Adn1C_PjJ4j5qiZL4oPyVDajFnRylYYsSC1u_ElzXc1p-c4oZNAFi8b5HZ0vIwHow28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftgErynIdp-OEsBEHLIeq16uNYWgQ-U01jIqgd5VOQ39Q&oe=699AF30D"}, "display_name": "Arthur Owl's Word Block", "keywords": [], "long_description": "Let Arthur Owl guide you through this blend between a 3D crossword and a category quiz. He's on hand to help you learn the ropes and give you hints when your vocabulary fails you. He'll even teach you how to make your own puzzles.\n\nIncludes around 100 free puzzles and a fully featured editor to make your own. Submit them for inclusion in future user packs!\n\nThere are six premium-themed puzzle packs available to purchase for a total of over 200 puzzles.\n\nFeatures\n - 200+ puzzles, ranging from trivial to taxing\n - Hints for when you get stuck\n - Fully featured puzzle creator mode\n - 7 visual themes to suit all tastes\n - Fully adjustable settings\n - Personal puzzle statistics\n - Over 25 achievements\n - Meta leaderboards for each puzzle\n - In-game store for extra packs and hints  \n\nJoin the Discord!\nhttps://discord.gg/VmA5fWPryw\n", "short_description": "Meet Arthur Owl and his clever game Word Block. With around 100 included puzzles and even more in downloadable packs, you'll have plenty to do!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deeperbeige.com/files/PrivacyPolicy_TOS.pdf", "developer_terms_of_service_url": null, "publisher_name": "Deeperbeige Games", "support_website_url": null, "website_url": "https://deeperbeige.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "923467478661540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "740728558007830"}]}, "baseline_offer": {"id": "740728558007830"}, "is_approved": true, "firstO
4721184", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974473_738448038054517_8319233969549787171_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naNGuOQeJU0Q7kNvwFCtZDL&_nc_oc=AdmBsMXCq5QR-KdRzawJ7jFJOQlZVscrM6TR_IvlDbB5Jns2X-BGOO8JZuAf6mq32Ac&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsBN-kgoA0jt_C37lto6PIGdZv66j7t6XllLEUwOK07TQ&oe=69A197E9"}, {"file_name": "AOWB_Screenshot__0002_Layer-7.png", "id": "1516537762246406", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001654_1516537765579739_4871949579833868510_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzAUoeFkGDsQ7kNvwE9DU-T&_nc_oc=AdkbfV5lUExE9Vs3H9lTTkn2XlBaDgsZbgpghuhvFgtQBz3909gxarwREAw3zEtYCoc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuRB9W_S32UIUaZ5bKChsaIg5rPL42hTeDYiiiZ8zAskQ&oe=69A1AAF2"}, {"file_name": "AOWB_Screenshot__0001_Layer-10.png", "id": "730877722445491", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982724_730877729112157_3368435981660093747_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCin2unAJOQQ7kNvwE3NYiE&_nc_oc=Adlgs1hVtQpci7tCScJn9eUWa8YjT7IWl8a1RTdxtGkAcieccVBQ6sfqdjh7Y92LXEE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftDeqA8hB2epy9avP4SVx-BiP8JzV2dR2ucsWv3rJmcxA&oe=69A19825"}, {"file_name": "AOWB_Screenshot__0000_Layer-11.png", "id": "2132171110471297", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57566685_2132171113804630_6020297435780050098_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXkYqxU32nYQ7kNvwEq5qE2&_nc_oc=AdlloIjGBwuEJZE_eAuZPaHxMWCBxueHiEttiKtEAUXjH9x52fDBAHo3TW8u6wC-D0c&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuolVdlqX-gIfsb1DtCwFAkhU7HNmu0O-Wprt39AIMt6w&oe=69A18ECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Word-Block-Trailer-Image-2560x1440.png", "id": "1613346342808754", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39003253_1613346346142087_2107283030342275446_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX6NkQyLjfwQ7kNvwFmvyJJ&_nc_oc=AdkPPQLwnSMFhbKI1AqGD4zK5LYHwcwIz9wCto03I4fMa5karM2-n68oDfYw2zA9jYA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft2h7KruZhwgckeAx7mFR9EUj76smd0_xQi4jSzu7OLKA&oe=69A18A8D"}, "display_name": "Arthur Owl's Word Block", "keywords": [], "long_description": "Let Arthur Owl guide you through this blend between a 3D crossword and a category quiz. He's on hand to help you learn the ropes and give you hints when your vocabulary fails you. He'll even teach you how to make your own puzzles.\n\nIncludes around 300 free puzzles and a fully featured editor to make your own. Submit them for inclusion in future user packs!\n\nThere are six premium-themed puzzle packs available to purchase for a total of over 400 puzzles.\n\nFeatures\n - 400+ puzzles, ranging from trivial to taxing\n - Hints for when you get stuck\n - Fully featured puzzle creator mode\n - 7 visual themes to suit all tastes\n - Fully adjustable settings\n - Personal puzzle statistics\n - Over 25 achievements\n - Meta leaderboards for each puzzle\n - In-game store for extra packs and hints\n - NEW: Unlimited Hints DLC!\n - NEW: Daily puzzle mode\n\nJoin the Discord!\nhttps://discord.gg/VmA5fWPryw\n", "short_description": "Meet Arthur Owl and his clever game Word Block. With around 300 included puzzles and even more in downloadable packs, you'll have plenty to do!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/k7bxbiereh7x0liq094u1/PrivacyPolicy_TOS.pdf?rlkey=g3v0s8py80d7hzxpnfnjth0uk&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Deeperbeige Games", "support_website_url": null, "website_url": "https://deeperbeige.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
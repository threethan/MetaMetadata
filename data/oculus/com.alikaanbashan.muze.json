64.5771-25/491820387_949838151084652_5583989023877711536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rCUCFnSeqAQ7kNvwHD0Wbz&_nc_oc=AdqWs-ZDAo87Q5kbz7TTGB8Zf0eFOOQlK8EhdrsBVZ8M3vQxlQTgH9f4QfNNZ44q30Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwrB14nlzri4szEtfUW8D6qQ28GBb57A79qmzAFxd4FQ&oe=6B0B3AA8"}, "display_name": "VR Museum Tour: Historic Rooms", "keywords": ["VRMuseum", "VirtualTour", "HistoricRooms", "ArtGallery", "MansionInterior"], "long_description": "VR Museum Tour: Historic Rooms is a calm, self-paced VR walkthrough set inside beautifully detailed historic interiors.\n\nStep into a collection of classic rooms filled with antique furniture, paintings, and atmospheric lighting. Use teleport movement to comfortably explore each space, take a closer look at the details, and enjoy a quiet museum-like experience with no time limits or pressure.\n\n**Features**\n\n* Explore multiple historic rooms in one location\n* Comfortable teleport locomotion\n* Rich interior details: antiques, art, and classic d\u00e9cor\n* Relaxing experience\u2014no combat, puzzles, or objectives\n\n**Controls**\n\n* Right Thumbstick: Teleport to move\n\nPerfect for anyone who enjoys virtual museum tours, historic houses, art galleries, and calm exploration in VR.\n", "short_description": "VR Museum Tour: Historic Rooms is a relaxed virtual walkthrough. Teleport through beautifully detailed historic rooms, admire classic interiors and paintings, and explore at your own pace.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/4_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368
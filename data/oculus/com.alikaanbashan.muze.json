/t64.5771-25/491819239_1202467648233688_367699410224573721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Pm3Ha8Gk0kQ7kNvwFVv812&_nc_oc=AdrzTkaTGB4_WJa_bBOpFoBVopeaOQ1T_wXlIvIlbcWxa7pdelJ-2HfCdCZmOpOcbl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3GMopCmnLa8tyT1urUjCWeZEZCjPryiTmxe2Eup8abg&oe=6A897ABE"}, {"file_name": "Screenshot_4.png", "id": "908024118375664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821081_908024121708997_8504698480392552515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cAbm0Q-KIcQ7kNvwFbP1lT&_nc_oc=AdpZ3qfJgICb8ExOeIjM5zBfx0OquI5JjqgzL4-WIz3RmSpQb7ZJ_S4eDC2Aq2rTZjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK60ObOW5gmUP3w9Yoth-58KrjZ1zhM5tsKu27Ao1aaA&oe=6A897FB0"}, {"file_name": "Screenshot_1.png", "id": "1920916518522998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820855_1920916521856331_8872042797834718434_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLX7NwUz-F0Q7kNvwHMrzKA&_nc_oc=AdpTKNEf8kCCOn1ip5LYzrT8cJS2kqx5-az72FasWpDycnTrp2vUMLkoywWDvVwOFoM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXD7vyR5wZFaTeg7eSpSdNj9YNcomTjXiNbwpna4Ot8A&oe=6A89A4D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v1.png", "id": "949838147751319", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820387_949838151084652_5583989023877711536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ItuT_nhZ4QQ7kNvwFGkOIu&_nc_oc=AdqfLIkc0ZaKDgUzH9yOZBDjPRv-3w5CJwPsKzH93fyg6gLxDwDBmfBJETcFdOGvhi0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi8UuoDAsAzegjEWAx32xuSIQzaqrL8X1zgUoTJ3E8mQ&oe=6A899728"}, "display_name": "VR Museum Tour: Historic Rooms", "keywords": ["VRMuseum", "VirtualTour", "HistoricRooms", "ArtGallery", "MansionInterior"], "long_description": "VR Museum Tour: Historic Rooms is a calm, self-paced VR walkthrough set inside beautifully detailed historic interiors.\n\nStep into a collection of classic rooms filled with antique furniture, paintings, and atmospheric lighting. Use teleport movement to comfortably explore each space, take a closer look at the details, and enjoy a quiet museum-like experience with no time limits or pressure.\n\n**Features**\n\n* Explore multiple historic rooms in one location\n* Comfortable teleport locomotion\n* Rich interior details: antiques, art, and classic d\u00e9cor\n* Relaxing experience\u2014no combat, puzzles, or objectives\n\n**Controls**\n\n* Right Thumbstick: Teleport to move\n\nPerfect for anyone who enjoys virtual museum tours, historic houses, art galleries, and calm exploration in VR.\n", "short_description": "VR Museum Tour: Historic Rooms is a relaxed virtual walkthrough. Teleport through beautifully detailed historic rooms, admire classic interiors and paintings, and explore at your own pace.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/4_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26733208326292146"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823930_2432431183882493_1411477948819336526_n.png?stp=d
/t64.5771-25/491819239_1202467648233688_367699410224573721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUoeCbWwUnEQ7kNvwGoSkNd&_nc_oc=AdpP6OMiGvZzVSLpuCmfbanUPOnV1ZdZa1gRNvy7WWc1kziLnMG0vRGyREtt1A3LCBg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBW-6M6MxWNi3NBxi13dgZRnEtv-5_uYgutiasM1otug&oe=6AA01C7E"}, {"file_name": "Screenshot_4.png", "id": "908024118375664", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821081_908024121708997_8504698480392552515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meTWvDUn0mgQ7kNvwEKgUfm&_nc_oc=AdolVhbRiew5orjy9YEC6G3YShYur0qVYELtAG2yKtyTjgUAs43jdXFsqsa_7M3dw6o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2KYmUU6FZgqczOekEDW0l_5Cx9pgorOZtd9obU7D5Ug&oe=6AA02170"}, {"file_name": "Screenshot_1.png", "id": "1920916518522998", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820855_1920916521856331_8872042797834718434_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaHHcgdAXZsQ7kNvwEdAwYp&_nc_oc=Adqt8LHu7r6KO7OPrzcMDRrEU0Fji-IOcpV9g-fg5WX4p8iNzY_IMXwTlpOI3h4YPwU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjGOJNfd_tljbSM8w7luTjFH-mWl9Ktf3d9nSI1ndW6g&oe=6AA00E59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v1.png", "id": "949838147751319", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820387_949838151084652_5583989023877711536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41pCtjuVMvQQ7kNvwGVnKjm&_nc_oc=Adr6mema3b9YUEkBIZkkCzHRH64IogbiLRrtYPEwjTUVjqnvaStoSuRiSeOIfJMym4A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVY3XuHt5LNNyDVxh5y0TICUJDTvG6WQAoIa1ObZHqiw&oe=6AA000A8"}, "display_name": "VR Museum Tour: Historic Rooms", "keywords": ["VRMuseum", "VirtualTour", "HistoricRooms", "ArtGallery", "MansionInterior"], "long_description": "VR Museum Tour: Historic Rooms is a calm, self-paced VR walkthrough set inside beautifully detailed historic interiors.\n\nStep into a collection of classic rooms filled with antique furniture, paintings, and atmospheric lighting. Use teleport movement to comfortably explore each space, take a closer look at the details, and enjoy a quiet museum-like experience with no time limits or pressure.\n\n**Features**\n\n* Explore multiple historic rooms in one location\n* Comfortable teleport locomotion\n* Rich interior details: antiques, art, and classic d\u00e9cor\n* Relaxing experience\u2014no combat, puzzles, or objectives\n\n**Controls**\n\n* Right Thumbstick: Teleport to move\n\nPerfect for anyone who enjoys virtual museum tours, historic houses, art galleries, and calm exploration in VR.\n", "short_description": "VR Museum Tour: Historic Rooms is a relaxed virtual walkthrough. Teleport through beautifully detailed historic rooms, admire classic interiors and paintings, and explore at your own pace.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/4_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26733208326292146"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823930_2432431183882493_1411477948819336526_n.png?stp=d
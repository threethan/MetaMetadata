Hk9aD2&_nc_oc=AdpGWErqoJazMViKH3s68euG7DRC-ztflM2jT6he7s1rUHycebV_2zKNiDCVFzJT-00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHrF7BzJsNrp0HTgF-APZWwJEsEnM2TzOrTccbvdw9Fw&oe=6A4BBC7E"}, {"file_name": "Screenshot_4.png", "id": "908024118375664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821081_908024121708997_8504698480392552515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u-RgJaFLSgQ7kNvwHwHhE3&_nc_oc=AdolTslungnxTRUYO0C47A6Ns7Cghat2SsAC5f109Ixb9V_DqZ93v6y2wMdaiihEbG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3gjYN9SlZX4Nq-DAEbmJeZW2VEWXQzYZzkkam_KNnDg&oe=6A4BC170"}, {"file_name": "Screenshot_1.png", "id": "1920916518522998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_1920916521856331_8872042797834718434_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKmOplQ2VWYQ7kNvwFbNZ4p&_nc_oc=Ado0d19d-aGShbvU0BJ-_Axi-h3MUzWNqc0XJ-ucv0B0QyrccG47JiK47wOSD4jIfbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyCxUcbyx5ubZAfdBpp6OhWeXXhM8KF4245bTll8Iz1A&oe=6A4BAE59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v1.png", "id": "949838147751319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820387_949838151084652_5583989023877711536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXFm0TFUgp8Q7kNvwGRZK4A&_nc_oc=Adq6SJlhHM_xSClSztpvI7WfCsilhoe0JAepegqPzPSX8Ct5uEEb2R3M8CFqOFKvckE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDywCXUs4QR7X6a6au_KIaaZ1TEMcJn-n23g6sVKI7yTQ&oe=6A4BA0A8"}, "display_name": "VR Museum Tour: Historic Rooms", "keywords": ["VRMuseum", "VirtualTour", "HistoricRooms", "ArtGallery", "MansionInterior"], "long_description": "VR Museum Tour: Historic Rooms is a calm, self-paced VR walkthrough set inside beautifully detailed historic interiors.\n\nStep into a collection of classic rooms filled with antique furniture, paintings, and atmospheric lighting. Use teleport movement to comfortably explore each space, take a closer look at the details, and enjoy a quiet museum-like experience with no time limits or pressure.\n\n**Features**\n\n* Explore multiple historic rooms in one location\n* Comfortable teleport locomotion\n* Rich interior details: antiques, art, and classic d\u00e9cor\n* Relaxing experience\u2014no combat, puzzles, or objectives\n\n**Controls**\n\n* Right Thumbstick: Teleport to move\n\nPerfect for anyone who enjoys virtual museum tours, historic houses, art galleries, and calm exploration in VR.\n", "short_description": "VR Museum Tour: Historic Rooms is a relaxed virtual walkthrough. Teleport through beautifully detailed historic rooms, admire classic interiors and paintings, and explore at your own pace.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/4_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26733208326292146"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_2432431183882493_1411477948819336526_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-ZON8blrx4Q7kNvwExvK6c&_nc_oc=AdpRXBXxIByJGhlf0Co0OHuIBCvDKTsa01f
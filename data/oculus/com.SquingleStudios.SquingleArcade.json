F5Xu1MKyRYqOHwOKoKbHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEAkjCbHEBRnX9ErcxI7yynPlxjRnj3cLyItNzEPNewg&oe=6A6234D2"}, {"file_name": "squingle_3840x2160_2026-02-24_15-28-13.png", "id": "2162600617847050", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619148_2162600621180383_1100377248887852558_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGiAUKizdysQ7kNvwHMuPxH&_nc_oc=AdqPnzUHrjmhoOtdeJafKMbDHfcn0sjLY7vnHWcmeW3a5tULe3q_877xl0fx0KaYWmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQTPNjtBAfgav3lQwJFGvHG5QiSXKSx9opFRctKR6-0Q&oe=6A621D63"}, {"file_name": "squingle_3840x2160_2026-02-23_16-19-36.png", "id": "1231595479162839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622334_1231595482496172_4109549677493829964_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TMp0HwBR0gQ7kNvwHCt_xt&_nc_oc=Adr-zFMs5vXOCCQxd69C0FJ-9_Bhx1_z1DR2Lsr6DhF7i2JWDJs88TQzyLIX3uj0o9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBoDFVPBu4W1nCv9ucY4m-r0AD8wI8ERPwbcf257nSTQ&oe=6A621C03"}, {"file_name": "squingle_3840x2160_2026-02-23_16-20-53 (2).png", "id": "771750535593732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618432_771750538927065_6179157374667723566_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgKJFuqZGQgQ7kNvwHTEGEu&_nc_oc=AdqH0TYwsFENNGo3suDaD7KmtWM3-nRxLvUCm2HDBXYruVHiTf5EPv3eP5H7MhlVhc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK_K68xqf4YzIBRsS0daHvw_UbQvDyAYm6OelXP61Gww&oe=6A62277E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Arcade_Cover_Video_Trailer.png", "id": "1909009776454210", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499294644_1909009779787543_5789072338823332337_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQuCUO4Wg8kQ7kNvwFsQChW&_nc_oc=AdpNaOul_xmbptksaWoCln8DowR26nW48bri29hNBtqqegiyTDeGu4X3uv09sWx6GLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW6MqmY8pd6U_cy5aOh4JqwWSdqbjdHlxh64n6eYppAQ&oe=6A62213B"}, "display_name": "Squingle Arcade", "keywords": ["Puzzle", "Relax", "Casual", "MR", "Arcade"], "long_description": "Squingle Arcade is a free-to-play spatial game designed for relaxation, accessibility, and endless replayability in VR & MR. It offers blissful, satisfying sessions you can enjoy seated, in small spaces, or even while traveling. No room setup, no pressure, just seamless arcade flow.\n\nPlayers guide iridescent orbs through prismatic, abstract 3D mazes filled with color, motion, and ethereal visuals. The controls are effortless and natural, making the experience ideal for new VR users while still offering layers of mastery for puzzle lovers. Each level blends nostalgic inspiration with modern design, combining time-based goals, light enemy interaction, and rewarding progression.\n\nThe game draws inspiration from the timeless satisfaction of classics like Pac-Man, KuruKuru Kururin and Candy Crush, translated into a spatial VR journey. Levels are designed to be optically stunning yet soul-soothing, creating a hypnotic, transcendent rhythm that helps players unwind and relax.\n\nSquingle Arcade is fully playable for free, with short-session gameplay that fits naturally into daily routines. Whether you want a quick mental break, a sensory visual escape, or a familiar challenge reimagined for the spatial era, Squingle Arcade delivers a colorful and approachable puzzling journey!", "short_description": "Squingle Arcade is a free-to-play spatial sanctuary built for blissful sessions. Guide iridescent orbs through prismatic 3D mazes as you master a seamless, flowing rhythm. With effortless controls and radiant visuals, it offers perfect seated play where your world becomes a living canvas. This is a striking sensory escape for fans of classics like Candy Crush and Pac-Man, reimagined as a glowing, meditative journey you can enjoy anywhere!"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26960920460192028"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2479049712569359"}]}, "baseline_offer": {"id": "2479049712569359"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783615380, "status": "PUBLISHED", "id": "2479049712569359"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28293073006976760", "version": "6.5.1"}, "id": "859704267067835", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26553242190959859", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28293073006976760"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784302907, "id": "28387755210841872", "version": "6.5.2", "version_code": 1117, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"
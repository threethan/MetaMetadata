-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCTttF0Wl5jX9fKJdSaVV2405FYk-16seeuclthMBmXQ&oe=6AA3F820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderglade Trailer Cover Image.png", "id": "279778984832369", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003227_279778988165702_594290286273076364_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E04sFXy4tB8Q7kNvwGg2O6Y&_nc_oc=AdpR50Wt0WpyVnXABoDWRCxfEAZodIx1w2QOaF_hkiSjqOsjkQA-1E-Dj84JneTT5Z4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsQzjwxqMRfj3zv-G06mQt6ZCv3SgIOXMKYrw-epW9vg&oe=6AA414B4"}, "display_name": "Wonderglade", "keywords": ["VR", "Wonderglade", "Themepark", "Resolution", "Carnival"], "long_description": "Wonderglade magically teleports you to an ever-growing theme park where you can enjoy carnival-themed classic games and totally new experiences with friends and family like never before. \n\nNow available on Meta Quest, the game taps into the benefits of the headset and Meta Quest controllers to add some hilariously entertaining moments for you and those witnessing as you putt, tilt, spray, spin and laugh your way through all the levels. Once inside Wonderglade, you can play six mini-games, enjoy a pass and play mode, and earn tickets to redeem at the Wonder Wheel.", "short_description": "Wonderglade taps into the Meta Quest controllers to add some hilariously entertaining moments for you and those witnessing as you putt, tilt, spray, spin and laugh your way through all the carnival-themed classic games. Once inside the ever-growing Wonderglade theme-park, you can play six mini-games, enjoy a pass and play mode, and earn tickets to redeem at the Wonder Wheel."}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.co
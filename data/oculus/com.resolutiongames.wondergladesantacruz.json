humbnail": {"file_name": "WONDERGLADE-QUEST-THUMB-01.png", "id": "2940575876156351", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75280977_2940575879489684_41651847109195125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWtM-817ursQ7kNvwHTIdQr&_nc_oc=AdrVoHTsdhFZFgzvu4XcYPxzgH4_DOQ7vBGWk4XMYBY8YMLVcnmVwa1qHtS6IncbdJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4Y0hY9DmgYTp3Bi1hDxl1D9Inx-DzP-vwwDoyWY1a0g&oe=6A5255B2"}, "display_name": "Wonderglade", "keywords": ["VR", "Wonderglade", "Themepark", "Resolution", "Carnival"], "long_description": "Wonderglade magically teleports you to an ever-growing theme park where you can enjoy carnival-themed classic games and totally new experiences with friends and family like never before. \n\nNow available on Quest, the game taps into the benefits of the headset and Oculus Touch controllers to add some hilariously entertaining moments for you and those witnessing as you putt, tilt, spray, spin and laugh your way through all the levels. Once inside Wonderglade, you can play six mini-games, enjoy a pass and play mode, and earn tickets to redeem at the Wonder Wheel.", "short_description": "Wonderglade taps into the Oculus Touch controllers to add some hilariously entertaining moments for you and those witnessing as you putt, tilt, spray, spin and laugh your way through all the carnival-themed classic games. Once inside the ever-growing Wonderglade theme-park, you can play six mini-games, enjoy a pass and play mode, and earn tickets to redeem at the Wonder Wheel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/wonderglade", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/wonderglade", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "cont
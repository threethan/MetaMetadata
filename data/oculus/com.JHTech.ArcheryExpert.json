tent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lpjla8DTYxyiqRqvRQs4yuIZOTrlQndEjxo1WOaClvg&oe=6A3A8E09"}, {"file_name": "com.JHTech.MRArcheryShooter-20260508-094734.png", "id": "1493771862238669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294711_1493771865572002_8992139884739279961_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55EBKZIShyYQ7kNvwFUqV4-&_nc_oc=AdpT5Y8i8WKA3av6dn71G5qgPE4KkjspxEilCE6H7Iba8yGmG80t4rVr18W12stS5Ls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88MSl44aXeZG9droamOU40YwXYcB9vH7-2JOI385KObg&oe=6A3AA14D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u00d71440.png", "id": "1006483325246781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1006483328580114_6595307855869227220_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9-IyAErI2cQ7kNvwHch0-z&_nc_oc=AdpfS3bkNIqamh2d-6QFCj281Rlax66HZ-H-YzG3pTh0HZcc0VakdPAmCqDr4x3WLKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3au-ZYBQtd2qPU_ftftjVmF8hpeHDkgpMMHr-etzh2g&oe=6A3A98E2"}, "display_name": "Archery Expert", "keywords": ["AR", "Archery", "Game", "VR"], "long_description": "Archery Expert is an immersive archery game designed for Meta Quest, focused on AR and VR archery practice with difficulty-based level play. Real-time arrow physics make drawing the bow, aiming, shooting, and hitting targets feel natural, clear, and satisfying.\n\nIn AR mode, you can turn your room into a personal shooting range or step outdoors for more realistic target practice. Shoot static targets, moving ground targets, and flying targets as bows, arrows, and targets blend into your real environment for strong mixed reality presence.\n\nIn VR mode, you can enter different virtual environments and practice freely without physical space limits. It is suitable for relaxed training, warm-up sessions, accuracy practice, and players who want a simple but responsive archery experience.\n\nFuture versions will also add multiplayer, allowing players to compete in archery matches in the same AR or VR environment.\n\nKey Features:\n- \ud83c\udfaf AR and VR game modes\n- \ud83c\udfe0 Mixed reality archery in real spaces\n- \ud83c\udf10 Archery practice in virtual environments\n- \ud83d\udd79\ufe0f Realistic arrow physics and intuitive controls\n- \ud83e\uddd8 Relaxing practice, warm-up, and accuracy training\n- \u26a1 Lightweight practice plus difficulty-based challenges\n- \ud83e\udd7d Designed for Meta Quest controllers\n\nThe current free version mainly provides practice mode for players who want to experience MR/VR archery. The paid version will add Challenge Mode and a complete new VR scene with more targets, richer levels, and advanced gameplay challenges.", "short_description": "Archery Expert is an immersive archery experience for Meta Quest. Practice in AR by turning your room into a personal range, or enter VR mode to train aim, rhythm, and accuracy without space limits. This free version focuses on simple, repeatable archery practice for beginners and casual players. A future paid version will add Challenge Mode, a new VR scene, more targets, levels, and advanced gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.wy-sci.com/ArcheryExpert/ArcheryExpertPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "wy-sci", "support_website_url": null, "website_url": "http://www.wy-sci.com/ArcheryExpert/index.html#/MainIndex", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"
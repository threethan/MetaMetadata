893973_2907629285315371716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysED8vF7Ux0Q7kNvwEwDjsc&_nc_oc=AdpMbihDA0q6qUszviCk8Y1yNvOANjsuW9un_9MS1Igtg2If51zmiOWAgRco9qWtiLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSiIwGNuQwdVa4blZpACksZiZKXDW7ORL_3UzWBFL4Nlw&oe=6B0C75A0"}, {"file_name": "New Project (3).png", "id": "28070102305920906", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831569_28070102319254238_8640735871645426245_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7P9zLeJUZoQ7kNvwGSBuaN&_nc_oc=AdoXI8ZRUVPVbQkgAUnmZwqUfwb_ZmIF2BhQ3E2cBeR-Ik0f6PlR_4ZdFmEplyGAeSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9fKh4oUYeYMR9B4usMqtqoZm5kIEgJ-_Fkz9OPiMF8Q&oe=6B0C62D3"}, {"file_name": "New Project (4).png", "id": "2150191525562225", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619485_2150191532228891_268327087765946138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GAikacg1tsQ7kNvwHvduI1&_nc_oc=AdpA1bnA3ZMMXL433k1nST-06oFMncZlhtPSOhdsuj93swmMVWcmh8PfDAtULpRgWEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQOpyhCuc7wfGTIbZRarWIgl6Wasi0A1pMpR5uJNPAnUg&oe=6B0C4E8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SlendyMonkeys", "keywords": ["gorilla", "slendymonkeys", "fangame", "ape", "monkey"], "long_description": "Slendymonkeys, a game based around terrifying mutant creatures who hunt you down to prevent you from collecting the custards that they protect in each map. Every map has its own size, but comes with it's own eerie uniqueness with the monsters and placement of the custards. Every map you complete you get a certain amount of custards, and you can use those to customize your body, or use them to get cool and useful gadgets! You can find different modes that have their own goals, such as survival where you fight off zombie like creatures where their only purpose is to harm things, Sandbox, a mode where your only limit is your imagination! Make monsters fight each other,  or simply fight against your friends or monsters you spawn in! Versus, a mode where one person is selected to hunt down everybody while the hunted have to collect the custards.", "short_description": "SlendyMonkeys is a scary horror game to play with friends!"}]}, "developer_name": "Jaxson", "developer_privacy_policy_url": "https://sites.google.com/view/slendymonkeysvrsite/privacypolicy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Jaxson", "support_website_url": null, "website_url": "https://sites.google.com/view/slendymonkeysvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27799674362978804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1492525361844503_4589988237929622460_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xAFLZF1KuIQ7kNvwE50Pim&_nc_oc=Adq30MSaz0eyvvaExE0JyMkHHMF_TqDbYLA93dcFPVQyd1e2m7wv6NRJhCsu2LBQJcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMiCHOpQ896fCsZJ1o-jcuZv3Ct6ZhwDsJToyOQyyGCQ&oe=6B0C51A3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "S
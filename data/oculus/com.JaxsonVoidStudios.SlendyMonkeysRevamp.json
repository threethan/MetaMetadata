893973_2907629285315371716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysED8vF7Ux0Q7kNvwGLLUV1&_nc_oc=AdpgTfZ_-kzRBBwfLCgW6rfUkLvRv2HypmMQulNGtA0si5toJIN0phUmX45siVnwUCo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTv3iQGCHbQRvgt1wf8-kkArQ_OJ-qHojy2WM74OTrzVA&oe=6B0B2420"}, {"file_name": "New Project (3).png", "id": "28070102305920906", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831569_28070102319254238_8640735871645426245_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7P9zLeJUZoQ7kNvwEJ9zPf&_nc_oc=AdrZpHJZLopozojP6V0EWDHqXfOfFv1AONHL6C5lb96ZFVfeCkP_xo4H_48-aJMP2As&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUmOQHmlYfKNhWoWrQi3cgw51rQKYdQ1j8lIrFK_EdBQ&oe=6B0B1153"}, {"file_name": "New Project (4).png", "id": "2150191525562225", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619485_2150191532228891_268327087765946138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GAikacg1tsQ7kNvwHP1wWU&_nc_oc=Adrg__OGOjJiyOkK4VcWM49EJhZDIDVRW3poUxEE2qLbr1sp0bTvg4-m4BtfyQ9_1GU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbEtyRtclHWOMkDM31Z-48QgEpRb9cIqVCD_hi1OSwLw&oe=6B0B354B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SlendyMonkeys", "keywords": ["gorilla", "slendymonkeys", "fangame", "ape", "monkey"], "long_description": "Slendymonkeys, a game based around terrifying mutant creatures who hunt you down to prevent you from collecting the custards that they protect in each map. Every map has its own size, but comes with it's own eerie uniqueness with the monsters and placement of the custards. Every map you complete you get a certain amount of custards, and you can use those to customize your body, or use them to get cool and useful gadgets! You can find different modes that have their own goals, such as survival where you fight off zombie like creatures where their only purpose is to harm things, Sandbox, a mode where your only limit is your imagination! Make monsters fight each other,  or simply fight against your friends or monsters you spawn in! Versus, a mode where one person is selected to hunt down everybody while the hunted have to collect the custards.", "short_description": "SlendyMonkeys is a scary horror game to play with friends!"}]}, "developer_name": "Jaxson", "developer_privacy_policy_url": "https://sites.google.com/view/slendymonkeysvrsite/privacypolicy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Jaxson", "support_website_url": null, "website_url": "https://sites.google.com/view/slendymonkeysvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27799674362978804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618297_1492525361844503_4589988237929622460_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xAFLZF1KuIQ7kNvwFcEM1Z&_nc_oc=AdpaMJ_0TC6BzsdG1nqm3moRHhcfOSM1174_6TrCWjqdA6W2fotCJ-7miJoXbNI3Dj4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSekjh9EAwhggU6dNJYgIkUFO13HfZNxv_q2KFXclcKkA&oe=6B0B3863"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "S
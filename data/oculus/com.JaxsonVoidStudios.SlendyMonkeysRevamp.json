&_nc_oc=AdrzxzSC5uLBLcu1x8y7M-zG5lXZqkSDnVCfz01bmjRnQoOW--1rS9RALJcIQLMWQ1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlbcGMDTgJHb32UTv7QE1TmXhejfvFXuQouYmRQ_NMBQ&oe=6AFDBCE0"}, {"file_name": "New Project (3).png", "id": "28070102305920906", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_28070102319254238_8640735871645426245_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTJzNHkvkLYQ7kNvwFMG6uI&_nc_oc=Adq0ZM8xwEKzhMW9s6P1_og2mv1Dz2A9wtxTiIGi-fK2q4kRIfoqd_NfEZ6pVy0wG-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgkIsCl4Xz_zCj-1wM07PF428SGTijBjkfhN2cPFr1WA&oe=6AFDE253"}, {"file_name": "New Project (4).png", "id": "2150191525562225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_2150191532228891_268327087765946138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwDXbAqKtUYQ7kNvwGqytMU&_nc_oc=AdrJLGYkfJKMk_xFJTFkkecN1mQ9bHUXNuJLDdaGRIBShVeWwUsrCfnxBB7u4xGe-4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Yz-otYOoxIw8YJCjF0zN1SgbjUP8WA7GEctSKwkacQ&oe=6AFDCE0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SlendyMonkeys", "keywords": ["gorilla", "slendymonkeys", "fangame", "ape", "monkey"], "long_description": "Slendymonkeys, a game based around terrifying mutant creatures who hunt you down to prevent you from collecting the custards that they protect in each map. Every map has its own size, but comes with it's own eerie uniqueness with the monsters and placement of the custards. Every map you complete you get a certain amount of custards, and you can use those to customize your body, or use them to get cool and useful gadgets! You can find different modes that have their own goals, such as survival where you fight off zombie like creatures where their only purpose is to harm things, Sandbox, a mode where your only limit is your imagination! Make monsters fight each other,  or simply fight against your friends or monsters you spawn in! Versus, a mode where one person is selected to hunt down everybody while the hunted have to collect the custards.", "short_description": "SlendyMonkeys is a scary horror game to play with friends!"}]}, "developer_name": "Jaxson", "developer_privacy_policy_url": "https://sites.google.com/view/slendymonkeysvrsite/privacypolicy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Jaxson", "support_website_url": null, "website_url": "https://sites.google.com/view/slendymonkeysvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27799674362978804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1492525361844503_4589988237929622460_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqT3LZOV7qMQ7kNvwG67gu7&_nc_oc=Adppdt_VVLA9qrsr9O-iiDmerDlfh0wV3XbTUi3-4daRTSb_7qWpRAr_2b6_48Z62oU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL1Ni9BBwjTnZChWTYQaYW33AzfxlalrJCdtQtWZm9Ag&oe=6AFDD123"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SlendyMonkeys", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
s!"}]}, "developer_name": "Jaxson", "developer_privacy_policy_url": "https://sites.google.com/view/slendymonkeysvrsite/privacypolicy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Jaxson", "support_website_url": null, "website_url": "https://sites.google.com/view/slendymonkeysvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27799674362978804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618297_1492525361844503_4589988237929622460_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7-0iQp4Hm4Q7kNvwECV6Wm&_nc_oc=AdpVhNYx4uIcE0GSZm9m1Ys5J3k2Y-Zg_mkRbVAeppS5hb60Q_OXmW-oelaJsWMs1aw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgHTXGnUc-wONDLVT7kyaHj_PdS-qWn8PfVWR1hyM2rw&oe=6A5CC1E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SlendyMonkeys", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1769724480, "lastRevision": {"nodes": [{"id": "25922752454004347", "release_type": "SCHEDULED", 
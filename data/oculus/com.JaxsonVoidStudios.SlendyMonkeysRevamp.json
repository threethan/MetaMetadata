&_nc_oc=AdoPejo5tWMy37cowuIv1mHe1kYkC-cYDVXepTi6GtjFjUKSVzVRHWxD_dNSocMU5NU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfsRP7eM2h43TLWTaixJhjIXhNI95SfWgszOUKZoTHLw&oe=6AFB19E0"}, {"file_name": "New Project (3).png", "id": "28070102305920906", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831569_28070102319254238_8640735871645426245_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpsptmdsCqEQ7kNvwHMiLde&_nc_oc=Adpn7_eCEsVj8H3GsNsTy8n_VnVSdGdSk8IL48Dx0Lqzm2LSe0ehsdQI2b89yH1KJpQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0e23biGyNVdrWGxkwauUqWZugzoSFfe1IBtslADwaZg&oe=6AFB3F53"}, {"file_name": "New Project (4).png", "id": "2150191525562225", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619485_2150191532228891_268327087765946138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwDXbAqKtUYQ7kNvwE-OTIx&_nc_oc=AdqQIUyPxTFJMPifBiYVUIjUfqdKtfX8q0h5zSPIm1dn_wcpyDlRmsC_yH5gBORPOtY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwh7xpCRynXIYOnmU40sOVAKEkEf-ws2iEdZsd_4K_qA&oe=6AFB2B0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SlendyMonkeys", "keywords": ["gorilla", "slendymonkeys", "fangame", "ape", "monkey"], "long_description": "Slendymonkeys, a game based around terrifying mutant creatures who hunt you down to prevent you from collecting the custards that they protect in each map. Every map has its own size, but comes with it's own eerie uniqueness with the monsters and placement of the custards. Every map you complete you get a certain amount of custards, and you can use those to customize your body, or use them to get cool and useful gadgets! You can find different modes that have their own goals, such as survival where you fight off zombie like creatures where their only purpose is to harm things, Sandbox, a mode where your only limit is your imagination! Make monsters fight each other,  or simply fight against your friends or monsters you spawn in! Versus, a mode where one person is selected to hunt down everybody while the hunted have to collect the custards.", "short_description": "SlendyMonkeys is a scary horror game to play with friends!"}]}, "developer_name": "Jaxson", "developer_privacy_policy_url": "https://sites.google.com/view/slendymonkeysvrsite/privacypolicy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Jaxson", "support_website_url": null, "website_url": "https://sites.google.com/view/slendymonkeysvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27799674362978804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618297_1492525361844503_4589988237929622460_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqT3LZOV7qMQ7kNvwGsf0CV&_nc_oc=AdpJ6b5CB6-SU7aJM8qANlVI9HcVDotxQ3v72dqaQ6Q191It-pObBhacAb7PYpfo98E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpYSNEQ2TvXrVZ6BMrLDVG7gbWyiZKbFJ-i9CnqPZgqg&oe=6AFB2E23"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SlendyMonkeys", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
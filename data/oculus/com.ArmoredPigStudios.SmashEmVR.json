f&oh=00_Af58-sAWgUJtHT6F8-JVqA3amrhXHh6k4XFMqoutsilrWQ&oe=6A09BD49"}, {"file_name": "Screenshot4.png", "id": "4272784382996680", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499304162_4272784386330013_3803988112701125888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYuxEYpWDE0Q7kNvwEm279L&_nc_oc=Adr622j5mZf3rt0ATgqqr-kvPxKjlLsnKOD4o_qPeVeznB5an4J11OaXztpFdCXoIJ8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47zJMLB1IpAE1j9MbSR1y-gOh5zOeUhZFnVD86B-DedA&oe=6A09C5DD"}, {"file_name": "ScreenShot5.png", "id": "1465352845378270", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312422_1465352848711603_7165067803835392538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xauc8sBiHocQ7kNvwHEYpJ4&_nc_oc=AdqfvfM19ZYQqvsqjOlxmSwH0dlPdcWS9LHqEd2uCq2X_C9Tp0hVQgYmKieFr45hiKo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q3YaJIO49z-bVik-_O7OYopWG__DSHabY0V0I4x7-Rg&oe=6A09D146"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Demo-NORAT.png", "id": "1470659484514971", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303672_1470659487848304_3599128002048278709_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8mOt_MIRwsQ7kNvwGfBaex&_nc_oc=AdpMhIG-V6lPXUhHV7dm9CoHf7uWmgf1ozPP3bm5KAwOx2RX0lRdb03SzHj4HDgTey4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qtNhsFPAIon7n8NQoXuKqJdYVq_zoQD-c_rGY0r-l9g&oe=6A09B508"}, "display_name": "Smash Em - DEMO", "keywords": ["Fighting", "Smash", "Gnome", "Punch", "Boxing"], "long_description": "**SMASH YOUR WAY THROUGH THE FOREST.**\n\n\nStep into a wild, fast-paced VR brawler where your fists are the only weapons you need. In this action-packed demo, you\u2019ll fight your way through a mysterious forest filled with strange, aggressive creatures that only get tougher the deeper you go.\n\n**Punch. Dodge. Survive. Repeat.**\n\nEvery encounter pushes your reflexes and stamina to the limit. Enemies evolve, attack faster, and hit harder. Adapt or get overwhelmed.\n\nBut you\u2019re not alone.\n\nBetween waves, a mysterious angel appears, offering powerful upgrades that transform how you fight. Boost your strength, speed, and abilities to take on increasingly brutal enemies and see how far you can make it.\n\n**DEMO FEATURES:**\n\n- Satisfying, physics-driven punching combat\nProgressive difficulty that ramps up fast.\n\n- Upgrade system guided by a mysterious angel.\n\n- Stylized forest arena filled with unique enemies.\n\n- Built for high-energy VR gameplay.\n\nThis is just a taste of what\u2019s coming.\n\n**How long can you survive?**\n", "short_description": "Punch your way through a dangerous forest where enemies get stronger every round. Earn powerful upgrades from a mysterious angel and push your limits in this fast-paced VR combat demo."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26852477837704298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499312422_3167916056729705_34404236779921080
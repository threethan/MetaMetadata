ERATION VR Live\" has been updated as \"YOU GENERATION LIVE VR\" an application offering the same features as the smartphone version of \"YOU GENERATION LIVE\".\nYou can download it for free at Quest Store.\n\nCheck an official site for more detail.\nhttps://colopl.co.jp/yougeneration/\n\nThank you for your support of \"YOU GENERATION LIVE VR\".\n\u203bThe App Lab version of \"YOUGENERATION VR Live\" has been sunset the service."}]}, "developer_name": null, "developer_privacy_policy_url": "https://colopl.co.jp/app/privacypolicy/yougeneration/vr/", "developer_terms_of_service_url": null, "publisher_name": "COLOPL, Inc.", "support_website_url": "https://colopl.co.jp/contact/", "website_url": "https://colopl.co.jp/yougeneration/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "MUSIC", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "991177111588807"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001673_492724225357351_4500691902980180307_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9gkUhhIIswQ7kNvwEl3UUc&_nc_oc=AdmniMmpC66YqDOkl36MlhO0jetBkJ5WHG1MikC9zL4Be8z2EfouUISk3B7dBL94PwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afse9GoiOeBRGZBaUR6VXQpmyn5dZT7hNQ5OHb0OwUugGw&oe=699AF037"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "YOU GENERATION VR Live", "platform": "ANDROID_6DOF", "context_category": null, "context_topics"
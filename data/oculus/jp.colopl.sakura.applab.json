44978530_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSDsxRUukAUQ7kNvwFGNeQ_&_nc_oc=AdmJKlojZXBDf8mo17pgIpiwCB3LGHKFUf-hQkSYCwcOE1w4_ZFPNa309Zixpqodtao&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLtH0X_6zKbkLguDFvoEILGhquIV6jF1-q8UFQBXxgug&oe=69AADAD9"}, {"file_name": "YOUGENE_VR_Live_2021-01-21-06-14-52.png", "id": "1447445905633558", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982721_1447445908966891_4418220725667453705_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5JMae3NGewQ7kNvwGoMqn8&_nc_oc=AdkgBY3qUXOhdoEe-6QNND9sFeeBr2gmmPl3Tkf0uq9aLqPPDpvK7JgsUu9PqckExW4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBInYw_4SbElofcWOGI5GTQPvjRKI7bu0Dd2Q3_0Q6aw&oe=69AAC8A9"}, {"file_name": "YOUGENE_VR_Live_2021-05-07-11-39-09.png", "id": "631238641610808", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974466_631238644944141_3686562071584313653_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzPIRFTXT8UQ7kNvwFvwQK2&_nc_oc=Adk8go6nPq9_AuNAsI_NDX0QjKOJmA09SM7xtdOetulnWaXMQrsOSzP6xAJ13A0ZBl8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwwl9cW99CcxrBVJ_P5AMdsZQcZdI15IiC3H2xaveF3FA&oe=69AAB665"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YOU GENERATION VR Live", "keywords": [], "long_description": "App Lab's \"YOU GENERATION VR Live\" has been updated as \"YOU GENERATION LIVE VR\" an application offering the same features as the smartphone version of \"YOU GENERATION LIVE\".\nYou can download it for free at Quest Store.\n\nCheck an official site for more detail.\nhttps://colopl.co.jp/yougeneration/\n\nThank you for your support of \"YOU GENERATION LIVE VR\".\n\u203bThe App Lab version of \"YOUGENERATION VR Live\" has been sunset the service.\n\n---\n\n\u201cYOU GENERATION VR Live Beta\u201d is an unique app that allows viewers to participate in a live virtual space program streamed by game characters in 3D graphics. \nThis live streaming program will be the world's first interactive entertainment experience where game characters interact with tens of thousands of viewers in real time.\n---\nThis app is intended for residents of Japan.", "short_description": "App Lab's \"YOU GENERATION VR Live\" has been updated as \"YOU GENERATION LIVE VR\" an application offering the same features as the smartphone version of \"YOU GENERATION LIVE\".\nYou can download it for free at Quest Store.\n\nCheck an official site for more detail.\nhttps://colopl.co.jp/yougeneration/\n\nThank you for your support of \"YOU GENERATION LIVE VR\".\n\u203bThe App Lab version of \"YOUGENERATION VR Live\" has been sunset the service."}]}, "developer_name": null, "developer_privacy_policy_url": "https://colopl.co.jp/app/privacypolicy/yougeneration/vr/", "developer_terms_of_service_url": null, "publisher_name": "COLOPL, Inc.", "support_website_url": "https://colopl.co.jp/contact/", "website_url": "https://colopl.co.jp/yougeneration/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "MUSIC", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "991177111588807"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001673_492724225357351_4500691902980180307_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slazsGOHD1sQ7kNvwGojsWV&_nc_oc=AdkzWHg8e6qQDmes8NjVEpMM2cRfKJ14tARHpqNP5Cky3iS48CCpA6aVX8LQzgfSxYo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_A
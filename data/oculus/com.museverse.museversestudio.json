DZvICLjI4Tcxz0WLRf4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaJF-tsAxYWXGymCPgFiET-B2bp2IHq5mzRw6NZITkHg&oe=69AACD46"}, {"file_name": "Image 1.png", "id": "4349849878674392", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821755_4349849882007725_5333125967480716956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rHpfI8MzfkQ7kNvwGuVsiE&_nc_oc=AdlnIhuRJWAo5CLbNmFpzgIlRWo5b5VZ1JfGkiQ6UWleyaZ7aD_c3TQBoGLW2b1diYs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSW_CGd7g0vmZU0YGcbk1Pdkv7Mbg2W_1iL87bjlmNPQ&oe=69AAB81C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main Cover 4.png", "id": "1611733016743178", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491828008_1611733020076511_6368373947427456710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkHdNcllP9MQ7kNvwExhU2W&_nc_oc=AdnKK20TVH5TTn67fkYIQbbndRF6AMivz10MrXzODtsW7UtRESQbWFJCWiPony5Amt0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRjKtvuGKniLWCLUll9kNgEOnGNW3-Icnekqmw-EizPw&oe=69AAE304"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn Piano in VR!**\n\nConnect your real keyboard to your Quest and learn piano with 36 guided lessons from beginner to advanced. Keys light up as you play.                                                \n\n{923212016737307}\n\nPlay drums, taiko, and marimba. Our lessons teach real music skills \u2014 rhythm, melody, and timing.\n\n{786945063863308}\n\n\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.\n\n\n{1494111258450091}\n\n**Try it now!** \n\n$7.99 one-time purchase. No subscriptions.", "short_description": "Learn piano in VR \u2014 connect your real keyboard and play 36 lessons from beginner to advanced. Includes drums, marimba and taiko."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
FyA&oe=69F0ACC6"}, {"file_name": "Image 1.png", "id": "4349849878674392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821755_4349849882007725_5333125967480716956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKBev2sLw6wQ7kNvwHWbFrq&_nc_oc=AdrEzOptQYJBtjzM-P0DIzV6dcGi2_e7yl23TH6prV7j1k3N9sexzugRJYJN9-SSg8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0J8Tc4IHtapLFBBOuWHeQ0z3plAbv7ziawaQ16f12i9w&oe=69F0CFDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main Cover 4.png", "id": "1611733016743178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_1611733020076511_6368373947427456710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE0wWjkXpJIQ7kNvwEryXbX&_nc_oc=Ado5Q4GAVjMT5cfJeepMvYGpMhbJ10AJE8A2gbU-2Fi8uTyBzP_bH8Yd5HXrL72DhW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1xha9Q7RDMZQe7Hpy_xNc5w-t_LtWI-VFY-sPrFFVSwg&oe=69F0C284"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn Piano in VR!**\n\nConnect your real keyboard to your Quest and learn piano with 36 guided lessons from beginner to advanced. Keys light up as you play.                                                \n\n{923212016737307}\n\nPlay drums, taiko, and marimba. Our lessons teach real music skills \u2014 rhythm, melody, and timing.\n\n{786945063863308}\n\n\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.\n\n\n{1494111258450091}\n\n**Try it now!** \n\n$7.99 one-time purchase. No subscriptions.", "short_description": "Learn piano in VR \u2014 connect your real keyboard and play 36 lessons from beginner to advanced. Includes drums, marimba and taiko."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museverse.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Museverse Labs", "support_website_url": null, "web
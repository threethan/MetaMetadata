t-ord5-3.oculuscdn.com&oh=00_Afvy9WLpFN0ZM5PwwtnPGsYkuGdURoq2fWut7TDX8fG5Zw&oe=699C5870"}, {"file_name": "resized_c0d2f0aa6f164d16950d942bcd94669e.png", "id": "2524536737922320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620368_2524536741255653_344216170589422503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9ppSy-IGhIQ7kNvwEqEhRG&_nc_oc=AdmgEhDUf6_rbXUqYvKEuiaflWKCpeB9nDhwQSRFD5QAyr6EYEJU1fgIDrvIqdYaqXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afve2TdRXR1mCis6Zke3DdXK2PdG5BLNgWIAmq0Y0GYvsQ&oe=699C61DA"}, {"file_name": "resized_2bca4ffeae854816aeed10750ae80faa.png", "id": "737740005467662", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308026_737740008800995_6908020680289576793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P56G9Iyv4bAQ7kNvwEp_NDp&_nc_oc=Adkqno5A1gWjSPy_HURB2C1uRaJ0TnktH20lgSXjGhvTd3pBtKqKhp5oVwE240V7AWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft-sIjYijDhRMcFwdwlTeNIBjCBzipXCwptJigpL9FL7g&oe=699C5EA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Museverse_Banner_Cover_Landscape_2560x1440.png", "id": "1388406682217015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823878_1388406685550348_4461689847965399829_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBvafBHUM0sQ7kNvwFaa9pz&_nc_oc=Adm-aKngjUkdoFgMveW0yVUOilqzfFUUQQpbfTdahknp725ubsM5_2CcaT76DgIZALw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsD8pIwHHrgiWCH5GPkmzXob8dNJyx2q7QyntdQLite0A&oe=699C3D3A"}, "display_name": "Museverse", "keywords": ["taiko", "music", "drums", "marimba", "learning"], "long_description": "**Transform how you learn music with Museverse \u2013 the immersive VR platform that makes music education fun, accessible, and unforgettable!**\n\n**\ud83c\udfb5 Learn Like Never Before**\n\nExperience bite-sized, gamified lessons. Master rhythm, melody, harmony, and basic instrument skills through interactive VR experiences that keep you engaged and motivated.\n\n**\ud83c\udfb8 Virtual Instruments at Your Fingertips**\n\nNo expensive equipment needed! Play realistic 3D instruments including drums, marimba, and taiko drum. Our instrument-agnostic curriculum teaches universal music concepts you can apply anywhere.\n\n**\ud83c\udfae Gamified Learning That Works**\n\nShort, engaging exercises build your musical awareness step by step. Visual, spatial music theory tasks make complex concepts easy to understand through immersive interaction.\n\n**\ud83c\udfeb Perfect for Schools & Families**\n\n- **Students**: Learn through exploration, not pressure\n- **Educators**: Bring music education into the 21st century\n- **Parents**: Give your children an affordable, safe way to explore music", "short_description": "Learn music through play! Museverse transforms music education with immersive VR lessons and interactive virtual instruments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museverse.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Museverse Labs", "support_website_url": null, "website_url": "https://www.museverse.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8440983902630057"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1285003676562967"}]}, "baseline_offer": {"id": "1285003676562967"}, "is_approved": true, "firstOff
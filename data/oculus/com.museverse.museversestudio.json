VY10GVNUfd-nULmDdagQjiNY8ZA&oe=699D9B06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main cover v3.png", "id": "1443317180238856", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1443317186905522_389950487421059264_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uthj0sLI4FoQ7kNvwEUPNNW&_nc_oc=AdkA9RL89ygzfx4h4IS_OkGqlg4wv5eie2lTimBaLc2IW0kj36XfcljwVz6rfh1Bups&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTVBd8WmzUSeoSvV-86dASXPFLha-Ev7-nY22bvMIW8g&oe=699DB5A2"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn by Playing!**\n\nMuseverse makes learning music fun and easy. Play short mini-lessons, follow simple steps, and grow your music skills while having fun without needing any special equipment.  \n\n{786945063863308}\n\n\nPlay different instruments, both for rhythm and melody. Our lessons teach music skills that you can use anywhere.\n\n{780838137763098}\n\nStep by step, you\u2019ll move from easy exercises to playing with confidence.\n\n{1494111258450091}\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.", "short_description": "Learn music through play! Museverse transforms music education with immersive VR lessons and interactive virtual instruments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museverse.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Museverse Labs", "support_website_url": null, "website_url": "https://www.museverse.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
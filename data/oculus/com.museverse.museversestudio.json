t-hkg4-1.oculuscdn.com&oh=00_AfuyhhYkdm3s_SV2ZJrLJxD6-aG6RujNNEb2VXji5O-wEg&oe=69A19E70"}, {"file_name": "resized_c0d2f0aa6f164d16950d942bcd94669e.png", "id": "2524536737922320", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499620368_2524536741255653_344216170589422503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RtaUCGLGxEQ7kNvwH5tc2W&_nc_oc=Adm_a1TQJW7jJtP3NAzBPc744xcrUpk9ae-pcDGyaxylleTjzPKyoVfuPLnexhkTCKs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft0smBMV10KrpYX4E1ZbMMcFX8bPZtrkQifgmTMqEuZnA&oe=69A1A7DA"}, {"file_name": "resized_2bca4ffeae854816aeed10750ae80faa.png", "id": "737740005467662", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499308026_737740008800995_6908020680289576793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hncpnUVxzHEQ7kNvwFZzqtt&_nc_oc=Adm-KyicjNlykUuKXVEqVYd7cfh9aM2guvep8xH-HpVvrhZZjsCm9t55YFJj3J0q7cI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuGdBBjDo2s4IWKUTvT6ETR5AWw-3W1rL46VvCCBMuzCQ&oe=69A1A4A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Museverse_Banner_Cover_Landscape_2560x1440.png", "id": "1388406682217015", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823878_1388406685550348_4461689847965399829_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zip1sbWhGQMQ7kNvwE01RK0&_nc_oc=Adkc8zyZZCZUCwvINJyAKWb4zoQHVDXj8yivYHKNQ7OHbu9pabdbV7MCKqMwBFzrjhs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftF1U9lB9l1QLFb_CDUPuGD6F39Rn_9g1CiwlAWTcaZ_w&oe=69A1833A"}, "display_name": "Museverse", "keywords": ["taiko", "music", "drums", "marimba", "learning"], "long_description": "**Transform how you learn music with Museverse \u2013 the immersive VR platform that makes music education fun, accessible, and unforgettable!**\n\n**\ud83c\udfb5 Learn Like Never Before**\n\nExperience bite-sized, gamified lessons. Master rhythm, melody, harmony, and basic instrument skills through interactive VR experiences that keep you engaged and motivated.\n\n**\ud83c\udfb8 Virtual Instruments at Your Fingertips**\n\nNo expensive equipment needed! Play realistic 3D instruments including drums, marimba, and taiko drum. Our instrument-agnostic curriculum teaches universal music concepts you can apply anywhere.\n\n**\ud83c\udfae Gamified Learning That Works**\n\nShort, engaging exercises build your musical awareness step by step. Visual, spatial music theory tasks make complex concepts easy to understand through immersive interaction.\n\n**\ud83c\udfeb Perfect for Schools & Families**\n\n- **Students**: Learn through exploration, not pressure\n- **Educators**: Bring music education into the 21st century\n- **Parents**: Give your children an affordable, safe way to explore music", "short_description": "Learn music through play! Museverse transforms music education with immersive VR lessons and interactive virtual instruments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museverse.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Museverse Labs", "support_website_url": null, "website_url": "https://www.museverse.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8440983902630057"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1285003676562967"}]}, "baseline_offer": {"id": "1285003676562967"}, "is_approved": true, "firstOff
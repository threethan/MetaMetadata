=T0sMZvhEbNIQ7kNvwGozpgC&_nc_oc=AdpfUmQ2hEcPwA4vgbQvw6Wj1RM4vkVtHJjRxw7wCMJqBAVfBf_9Uh8SRNzw81gykO8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH67wWglJ_7upF32autHE0lnBFkb3Ick7dCg73FklNlzA&oe=6A8AD71C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main Cover 4.png", "id": "1611733016743178", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828008_1611733020076511_6368373947427456710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc0fvoFfdn8Q7kNvwFzSTk7&_nc_oc=Adpa2eMSCssSd8Fi25__SjVPAfiOoT71GdPi_civs_WSnKVjQM-Kr0cWRfQseAML3oE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMi04c2kpmZc1eoloedZtlcqz4zDRZv3KueibqbVydjg&oe=6A8AC9C4"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn Piano in VR!**\n\nConnect your real keyboard to your Quest and learn piano with 36 guided lessons from beginner to advanced. Keys light up as you play.                                                \n\n{923212016737307}\n\nPlay drums, taiko, and marimba. Our lessons teach real music skills \u2014 rhythm, melody, and timing.\n\n{786945063863308}\n\n\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.\n\n\n{1494111258450091}\n\n**Try it now!** \n\n$7.99 one-time purchase. No subscriptions.", "short_description": "Learn piano in VR \u2014 connect your real keyboard and play 36 lessons from beginner to advanced. Includes drums, marimba and taiko."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museverse.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Museverse Labs", "support_website_url": null, "website_url": "https://www.museverse.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
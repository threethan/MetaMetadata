8DXhdZxRHyWE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZLnNBPSK9F01DtftpItoq3WMY_bU1HdI-LIbctLYxTw&oe=69B94DC6"}, {"file_name": "Image 1.png", "id": "4349849878674392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821755_4349849882007725_5333125967480716956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPjHM6pU02IQ7kNvwHBENn6&_nc_oc=AdkhLDQ3gvgpaRV12tml5DCnBhn0uFt7vagH1_VpETDbJQJuS8y77c5ff7GjUpX9-8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfydkYrs6JA46SJRq0oHU2qyyJ2Vv050RkBBx0SJZGrisQ&oe=69B9389C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main Cover 4.png", "id": "1611733016743178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828008_1611733020076511_6368373947427456710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixdOKf2FC7kQ7kNvwEaizSv&_nc_oc=Adl58v36pe2W7Xex3KO0af8MAn5KHBIS2r_J9sVHJ-yovagwv85KRuJNx-Sgo7gl8L0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2RVR-fvxWfzSCGR9_jollD6aKCXw1Elr6ImnEMC08PA&oe=69B96384"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn Piano in VR!**\n\nConnect your real keyboard to your Quest and learn piano with 36 guided lessons from beginner to advanced. Keys light up as you play.                                                \n\n{923212016737307}\n\nPlay drums, taiko, and marimba. Our lessons teach real music skills \u2014 rhythm, melody, and timing.\n\n{786945063863308}\n\n\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.\n\n\n{1494111258450091}\n\n**Try it now!** \n\n$7.99 one-time purchase. No subscriptions.", "short_description": "Learn piano in VR \u2014 connect your real keyboard and play 36 lessons from beginner to advanced. Includes drums, marimba and taiko."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museve
4358f719bca5.png", "id": "9668730889893688", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617786_9668730893227021_4098647199070989236_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkTgbTLb_8cQ7kNvwHpD9IC&_nc_oc=AdqW4dRO5o1PM_qzQM0ID1sDDcuKo7T-bDrs6D_H8s-VRu2aKw_ngF7ugRSWQnLZFes&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjQoHCd9UUoV-vD5yxxr3Hs4EEQO-yWE7Dq87XSHp47w&oe=6AC4F9F0"}, {"file_name": "resized_c0d2f0aa6f164d16950d942bcd94669e.png", "id": "2524536737922320", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620368_2524536741255653_344216170589422503_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFZrpi_yw9IQ7kNvwGtL_Ar&_nc_oc=AdrIaNVCtNTrhP0RGdyNjrLG1c7bAOx3E5Y6QQTWfCRfh-_FKNdg0QhI-hDe0cBW7gU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoDY-TLDj8eVPmSVy4mUE5UbjsfHOKRTJ2rNzaPljuZQ&oe=6AC5035A"}, {"file_name": "resized_2bca4ffeae854816aeed10750ae80faa.png", "id": "737740005467662", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308026_737740008800995_6908020680289576793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi3IZ4HjJosQ7kNvwHDo4Hh&_nc_oc=AdpJo7hU7_jyb9vGKNeED-zso-WibeJfY7GavLQz-67V_p_ZsqLKLLioJKGuqpvU5Ew&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG-OF3wemjZf8UqOWSvZtTw-1vIO9Y9BKxS3AfuRf9AA&oe=6AC50027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Museverse_Banner_Cover_Landscape_2560x1440.png", "id": "1388406682217015", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1388406685550348_4461689847965399829_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZbKM_pQjRAQ7kNvwHlFLrv&_nc_oc=Adpsm0JR6HWoii45DZTm6aEakdW5O1KuDBeZEW0ALnD6EsuVisfIkSgwbxCE8fznBZw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4oj6WrOLSrTzuTlvxXd-D1TFAYzYZWwhzCNcidwJQuw&oe=6AC516FA"}, "display_name": "Museverse", "keywords": ["taiko", "music", "drums", "marimba", "learning"], "long_description": "**Transform how you learn music with Museverse \u2013 the immersive VR platform that makes music education fun, accessible, and unforgettable!**\n\n**\ud83c\udfb5 Learn Like Never Before**\n\nExperience bite-sized, gamified lessons. Master rhythm, melody, harmony, and basic instrument skills through interactive VR experiences that keep you engaged and motivated.\n\n**\ud83c\udfb8 Virtual Instruments at Your Fingertips**\n\nNo expensive equipment needed! Play realistic 3D instruments including drums, marimba, and taiko drum. Our instrument-agnostic curriculum teaches universal music concepts you can apply anywhere.\n\n**\ud83c\udfae Gamified Learning That Works**\n\nShort, engaging exercises build your musical awareness step by step. Visual, spatial music theory tasks make complex concepts easy to understand through immersive interaction.\n\n**\ud83c\udfeb Perfect for Schools & Families**\n\n- **Students**: Learn through exploration, not pressure\n- **Educators**: Bring music education into the 21st century\n- **Parents**: Give your children an affordable, safe way to explore music", "short_description": "Learn music through play! Museverse transforms music education with immersive VR lessons and interactive virtual instruments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museverse.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Museverse Labs", "support_website_url": null, "website_url": "https://www.museverse.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
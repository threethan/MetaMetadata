5TdOP0eSuw88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuo8tWnVBPFYWZV-H7-TQRoQe_JNf4AsX-A-QxmPd5SNg&oe=69A97BC6"}, {"file_name": "Image 1.png", "id": "4349849878674392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821755_4349849882007725_5333125967480716956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rHpfI8MzfkQ7kNvwE3Uw4E&_nc_oc=AdlmyaIwPl3Y6LWwkERi4JLQB79_MtuandeX4yg_WJ34-Hxmt1OSzK41xC6knacQwO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftSrLz8xQmDAvCOvCGFsnkEe9CSvfbAtPdyD5M4AKbuEA&oe=69A9669C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main Cover 4.png", "id": "1611733016743178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_1611733020076511_6368373947427456710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkHdNcllP9MQ7kNvwHuROoZ&_nc_oc=AdnKMtW4_1TulSWzfX6lIusE3jzPqOBGfIXoOl69ajjDTzBf11dTP68FzttAZ2RWnyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsNLRYPgaxalR3_lIB3KhcbZnZ42mGI0976ThZ8fR-W3g&oe=69A99184"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn Piano in VR!**\n\nConnect your real keyboard to your Quest and learn piano with 36 guided lessons from beginner to advanced. Keys light up as you play.                                                \n\n{923212016737307}\n\nPlay drums, taiko, and marimba. Our lessons teach real music skills \u2014 rhythm, melody, and timing.\n\n{786945063863308}\n\n\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.\n\n\n{1494111258450091}\n\n**Try it now!** \n\n$7.99 one-time purchase. No subscriptions.", "short_description": "Learn piano in VR \u2014 connect your real keyboard and play 36 lessons from beginner to advanced. Includes drums, marimba and taiko."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museve
dZWZlIFL9MyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvPWPmjP0LvcsE1PB7ir5qUnsMGLbhtINDb5XJYyRy5sw&oe=69A82A46"}, {"file_name": "Image 1.png", "id": "4349849878674392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821755_4349849882007725_5333125967480716956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blzzk5aOoOQQ7kNvwEYkSZg&_nc_oc=AdlRLqRsU1Nji0Z0JYluZDX6kOIOsuOQI3XTE4D4z5CAv_8C9aq7DrYF306eWsWt7S4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftJz1XOrNPvYtPvFSrKPRNm1VTfG-0wBiZfpGioYN-6lg&oe=69A8151C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main Cover 4.png", "id": "1611733016743178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828008_1611733020076511_6368373947427456710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIkelMbwnJkQ7kNvwFYaQe3&_nc_oc=AdnumfTNxcrI9mOhngJa98rYysb_MeCMXGep2wPlLCjC8PBbS4r5vBpwxeku7MsafgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuiRBwO6x-eB2bJbffOM4VZs_46GKUnMnhHk2DlczX1FQ&oe=69A84004"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn Piano in VR!**\n\nConnect your real keyboard to your Quest and learn piano with 36 guided lessons from beginner to advanced. Keys light up as you play.                                                \n\n{923212016737307}\n\nPlay drums, taiko, and marimba. Our lessons teach real music skills \u2014 rhythm, melody, and timing.\n\n{786945063863308}\n\n\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.\n\n\n{1494111258450091}\n\n**Try it now!** \n\n$7.99 one-time purchase. No subscriptions.", "short_description": "Learn piano in VR \u2014 connect your real keyboard and play 36 lessons from beginner to advanced. Includes drums, marimba and taiko."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museve
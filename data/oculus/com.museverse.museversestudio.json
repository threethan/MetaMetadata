content-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1I-hgxxLzjidVn6f_-XAcJj6uT4v1WvAG1ozbuV6KJVg&oe=69F1FE46"}, {"file_name": "Image 1.png", "id": "4349849878674392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821755_4349849882007725_5333125967480716956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKBev2sLw6wQ7kNvwGvKfDo&_nc_oc=AdoltiXyFTP_3UH1Fw2nRHJgB0SAu2zyEuMeTq4ZpwCxoAzal4cdnjpdPoxMtW1R_Tw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1v7pauTRtf7VQcRW3M5mFZ7dWqUOwa8hMI4l3rOnKGXA&oe=69F1E91C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main Cover 4.png", "id": "1611733016743178", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828008_1611733020076511_6368373947427456710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE0wWjkXpJIQ7kNvwEpXdlo&_nc_oc=AdqqTUcY855C91wDBpCwd4aCrrueCbTR2G364X5dcuno271R1NvjgHCBWNop_mt_IB0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af239cNB2pOd_E_zluUeafQ_duDu_Nx-jwrzvz4OMqEoWQ&oe=69F21404"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn Piano in VR!**\n\nConnect your real keyboard to your Quest and learn piano with 36 guided lessons from beginner to advanced. Keys light up as you play.                                                \n\n{923212016737307}\n\nPlay drums, taiko, and marimba. Our lessons teach real music skills \u2014 rhythm, melody, and timing.\n\n{786945063863308}\n\n\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.\n\n\n{1494111258450091}\n\n**Try it now!** \n\n$7.99 one-time purchase. No subscriptions.", "short_description": "Learn piano in VR \u2014 connect your real keyboard and play 36 lessons from beginner to advanced. Includes drums, marimba and taiko."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museverse.xyz/privacy-po
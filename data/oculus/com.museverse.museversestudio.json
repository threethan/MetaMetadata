6kzr1LOU-iiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkzhrZ2Gk7Nm9hOVwlLLOTDQebPicw9wTk0dHBG26k0Q&oe=69B164C6"}, {"file_name": "Image 1.png", "id": "4349849878674392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821755_4349849882007725_5333125967480716956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jak7xA2o6lAQ7kNvwHZBXUn&_nc_oc=AdlB3JVvwvRjhcv35vPf6S3LlwRTMQnEm8D6H2wYDU8GzIJNWVOgvmH6yC46SbJcIZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6B4oGM1KwNdLcW6jgZrVVbqn_QvGlxSDs1LdzPnu89A&oe=69B14F9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main Cover 4.png", "id": "1611733016743178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828008_1611733020076511_6368373947427456710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhQv3KdQmW0Q7kNvwGY-p0y&_nc_oc=AdmdduB5Vr6gEkkkpSGcdHFZ95QZwZ6kjLZborXF0KEl3jF3c5mb2tbYh60wG_SrUec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwXou4jhE4VotA6wFfTThH2lLE0eGQ1ab4MGlZXdiBZQ&oe=69B17A84"}, "display_name": "Museverse: Learn & Play Music", "keywords": ["music", "drums", "learning", "piano", "create"], "long_description": "**Learn Piano in VR!**\n\nConnect your real keyboard to your Quest and learn piano with 36 guided lessons from beginner to advanced. Keys light up as you play.                                                \n\n{923212016737307}\n\nPlay drums, taiko, and marimba. Our lessons teach real music skills \u2014 rhythm, melody, and timing.\n\n{786945063863308}\n\n\n**Perfect for Schools & Families**\n\nKeep your child\u2019s creativity growing. Fun for students, simple for teachers.\n\n\n{1494111258450091}\n\n**Try it now!** \n\n$7.99 one-time purchase. No subscriptions.", "short_description": "Learn piano in VR \u2014 connect your real keyboard and play 36 lessons from beginner to advanced. Includes drums, marimba and taiko."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museve
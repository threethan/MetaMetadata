cdn.com&_nc_ss=7f20f&oh=00_Af7Jnp3WiF1BO1DnnhpMEZLkJ9QUPcyxPaE9cJq5qB_dCw&oe=6A0D9FC5"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MoP6QLh_LsQ7kNvwHiUZNj&_nc_oc=AdrnSoVQ1I6gDDS-KTnRtLqZRrhxkt1bMaU_zI6L72wpyWNkoHTiP6WNUJRpTdc4dtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G4Qbg6nx9tD_uWJ77XccmHT4AuyNnEAfMNA0z8GLKaw&oe=6A0DB05B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L6Isdxp-PwQ7kNvwGHFTHc&_nc_oc=AdoP-6TqCSY3JCW6nSypKlErv5xauMt6m9DkvNyMdKlonzB-KtITINxMjk7qafBW4Zs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zvwG2q07J1-57xwxocYDMR8wloxSO1nt0LGp77AH4pg&oe=6A0DA396"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHWWj-r-nAcQ7kNvwELP76o&_nc_oc=AdrmCyuS3vztOSedUUTp4WqICfrnUbcm_2YNG1TArE2TzWkcyvlwvxgNtnt81jAMtik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i0YWiRGRG2tI_DWB5N9h8akH1eJdCSe9xlf4jw28qwQ&oe=6A0DD526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpvwBPFuUU8Q7kNvwF_i6y_&_nc_oc=AdqOLUMgyyBmBXsurQObwRPgUv0ZEnMt0OWQElFjq_XF_tFoBDHtFUZWMZV5fWtTXZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51o8UC5qQWDIpvRhjbLpsMN5EZeaXtLPV59MJ__nkcDw&oe=6A0DC39E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
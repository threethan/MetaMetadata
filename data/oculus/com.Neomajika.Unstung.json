cdn.com&_nc_ss=7f20f&oh=00_AQD-nRrCdP3Uk9R0yqMPS4O8Rjy1oNqUtg3O2rVYNGPziA&oe=6A5B6845"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OqIhVS4IpQQ7kNvwGgEI_X&_nc_oc=Ado_5pUKkIBs3XleKqTnOmxfG8C3XkZeh9CsHc_d26O7HNE36T15kD4U9p_8chvTZoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkEJ90K22tFWqNvPlx7eDen-qjb0Kdck-s3xW34WCIsQ&oe=6A5B78DB"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMA-a_K6NKoQ7kNvwEqRgaI&_nc_oc=Adq3NVYokfXyAokL7pkxWCn_fc1sjJpWNnXMN4NDIS7_PjQxi9OpEMK_l915adnrQrA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA96htrsF8SOaNFuRfvDNu5FC8pJugTXgj37BzJkJ-gxw&oe=6A5B6C16"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qawZyIcgIw8Q7kNvwHk-ne6&_nc_oc=AdpxUrAW8Kj4NH_4Jc6gMiJIM8dWCpQF4L0cuCDFTOQ5Qmwjz69NDyWWomIYKJJZKho&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx3zn0763P_UpRB7Iyv-o-RrQTlEHdk98486FtZ8yzNw&oe=6A5B6566"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWHHmByyeI0Q7kNvwEalRWh&_nc_oc=AdryhucgLcbq-wxBFwez1S537j8DdqYEt35hWE7NcRWZ6k6zQ6PRnVd52SW6B1riVH0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp8Q-VHK_nUUXvzINhkwpt0oeJhnvW6i1X1LR7jVvpeA&oe=6A5B8C1E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
xx0mpow&oe=69F8985B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwikrd5sc8oQ7kNvwHGXRJk&_nc_oc=AdorzfRPjg3cMeoc_zyqeOifotmTmVw5I9bH6L1CIi2ZiO0-s8qF_CndIR0idlgGYDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1blKW8SV2C_oiMgZyxzSqh3zKYsy77-9-lmz9T1ikycQ&oe=69F88B96"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzwZgIvI9ykQ7kNvwHo2Er5&_nc_oc=AdpQ8CyAMTxFTm7g5nVlOrhrVwib1vxuBG62Oec1kk50ptBx__N_HngbOwm4hUwX4tI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y-dY1R53m2W6fXvRsyO5LRZnrDpvlsRQ0W8aTXIaSeA&oe=69F8BD26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=817P7T1VWjcQ7kNvwGiZTey&_nc_oc=Adr7yFym3qqjz_4c8W7cRWTniRHoX0ZWHxv0rFRUwd-voAofulwz4gFiLwbtSRwHi5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i-DcxHX7EIbQnA8lC1CYvojgQHZzSwtsFVcGKpKIxnw&oe=69F8AB9E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neomajika.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Neomajika Games", "support_website_url": "https://neomajika.com/support/", "website_url": "https://neomajika.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "899672407413233"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "543518261339589"}, {"status": "PUBLISHED", "id": "643184704278445"}, {"status": "PUBLISHED", "id": "669826550657482"}, {"status": "PUBLISHED", "id": "3811518062219191"}]}, "baseline_offer": {"id": "643184704278445"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726765200, "status": "PUBLISH
cdn.com&_nc_ss=7a30f&oh=00_Af1FHXEXBT3J4RKi7u2RYsC9G_5wT8XKkANqSq35SKz5ig&oe=69E8B5C5"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm5Bm4N6FEMQ7kNvwGIZGTQ&_nc_oc=Adp8rn1kuvcZUKeSxACmtK0-yd8vQ8epBRYRoouxX7uSZfzfyKtoMEGBn5myTPGnkcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sVhezg0BsIyNE49-A5-JKDiusZEwI15Xa4UKlBZAq3g&oe=69E8C65B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibcdGzNQ_ogQ7kNvwH3yTtS&_nc_oc=AdpKa2zSvpDbAlN0S_VESKsZKbVDhDj2lP8wcgxHizHyXdLDpP2BXUA2bD6HzcX2NE8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ff9jGpLgjoWHevVrSoXVEeYaQmuL9Rwr4HQBaY2rRdw&oe=69E8B996"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxSzuzICqosQ7kNvwFgtdy3&_nc_oc=AdrpIGiGVS8hGnB1Hw8_zgIcjQ5RIj0h0HROtkNfoy9rj7RTxD4kPL-tPoRksH57Tp0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35tJV49hQGssOUhLBSy_pBLzyecbjuJCUITGypJToh_w&oe=69E8B2E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RzoHkyD_8AQ7kNvwEuMeGl&_nc_oc=Adq4t8Q7kTraTMY3Bgh4ZI-LfMDOn4IVzNu3Sqi9XhwfYkxL4eMN9JJfJ_gvXCCBYis&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lq9-bImFA_RB4dnvTe0hqE6FmDEhP4NKLdPXQGF6NMg&oe=69E8D99E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
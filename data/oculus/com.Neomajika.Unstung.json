cdn.com&_nc_ss=7f20f&oh=00_Af6txS7oow2_yX9iXOcPaD2jXUob4aofmoKpc6pVxVAmJg&oe=6A034C05"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ya-tYLwIEVAQ7kNvwHPfw_6&_nc_oc=Adrd4KYH_sh-OKg-DtpbNNQpBZu5ogMQy3WChyUOKUeaXFlEU50SWa1j7pW2yL-8yB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H9MmOlEmjMIrt9TSj3JyRs4Lzc0h2YVybnNGjuLnV9g&oe=6A03245B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22bwlrsV27sQ7kNvwG_R2Gq&_nc_oc=AdpZHnPHeZd8T7_i8tdY5NlIfak1Z5ZsZEY1gO4ebKGuVpPGtSrTqExeK54_I-zCU9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aB4_ASzejC89ZzDxNdXem0c9o7LMy9p0HBPWahvpqng&oe=6A031796"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx6JFOFZ-00Q7kNvwGQyoIi&_nc_oc=AdpDnzq7h-LEPzLkVMuhMIys7BszS05cLnww0VHPYIyElIF1hAlQtiSqCe58H4LPjHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AcNCOe7vNqQFj3kUp_AoQXm9QjAL6CPu0XJlHJU0TaA&oe=6A034926"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox60GYzb3E0Q7kNvwE2cHL4&_nc_oc=AdrmyucoDw6xL-DDMOv7P_p9PkzpRT_pSXi7Bb-4oeq8B2qvVGWstFVpTlnW4pNNgvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73a2H0rBmarnJGJxDSyA_9w0oWwvgSp9q0dkU40uTzug&oe=6A03379E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
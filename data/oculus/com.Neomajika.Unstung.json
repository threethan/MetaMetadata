uscdn.com&_nc_ss=7f20f&oh=00_Af_29W2KGz5T3025lMNOyqV3NShCg7QBQDYkQ69zLgdSFA&oe=6A22F005"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt7-JxnUXDQQ7kNvwGSEv-W&_nc_oc=AdpyTofyyCR9zXsfLUdGZ0mCZeVD0WplHxeXmsVgHrfNez4TQlJ3bSbCnOzXCW3X-7Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fJAkxE2h1k3MWyRVizIDzvzB_GJKbuL6FMQQvJVv5hw&oe=6A23009B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERCU56RBd8AQ7kNvwH5ovY_&_nc_oc=Adq8HkLhS-v3XQAAC7TuMQYA99sVOF0EO4omMgY3RTKavsbkoykZI-VNDOCDbP4TX8g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CC_ah9HMHP7HaK2x-q_-wzRLZJpQorpKjmg9padrdhg&oe=6A22F3D6"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hTixEsgnDMQ7kNvwGaV4lR&_nc_oc=AdpsOnUn2PzEKTa_XzbZfFC6UqESwid2FAs9rw-6jkRnoE8CUU3FlA0nJ0Pj-2s9gZ4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dGtvmrPoydsb8Ud3gkcPSo4FyBBub72aTrO6po4vHlQ&oe=6A22ED26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2fieyd84E8Q7kNvwFdeBCJ&_nc_oc=AdpthJ_JqEfHWKBPfwj4VOdzrGHCgLe_b4xQh3dUpU3mKDHyJQ6yWjWy_WFIWo8f1PE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_epFFu8kh5xzXHfJfkCEF9dgh8vhmivVGmKJRayMdF0A&oe=6A22DB9E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SI
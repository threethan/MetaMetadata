cdn.com&_nc_ss=7f20f&oh=00_Af-HqIFHh1MVolKl_1cIRoWXOyyeWjinCvB5sShctyQmBQ&oe=6A3E9F85"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15KUZYchRvgQ7kNvwHILTti&_nc_oc=AdrCsQ0OJwxux028B6a8HRnC0U1TniYX0VC5xo0OSrOEW6T1Tkmd33qbDwu21HhkCds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aMpbu4W8Fw0Fch5_v-rclP7hmd97RauLzTgBRVtHGbQ&oe=6A3EB01B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaxVhFD2n6kQ7kNvwH_Tda4&_nc_oc=Adr94IRkBHbPXJ4ofUdWoxhNfDbPEsV9R6VBB2YeJOuPNDvjqpbDx84CYmkCd4YOz3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UrgvmRHMkjGAxTAFS0jQVsQwGxScmBsvD-Fl_4N3ivw&oe=6A3EA356"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38jKSRmk4I4Q7kNvwG4-d0z&_nc_oc=AdrGPnCYZyjvd6LHP1qNNz6EaDiIomnHR8bI3ZQrH_bIm-Rdf7KvgeA7TMfH7bimsOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cZN6kBrnpHI8dF_Av2Lffqv8I-8f9r-stWS8DkBz5OQ&oe=6A3E9CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiaxEiIQfwsQ7kNvwFGY4Rl&_nc_oc=Ado7LJYb8X-NzEkcR0_csGgLGRApMMpdCxMzCMtaLAtCCLeeccKzqNYTJQ1VYw5TS0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8fAxF6tcDeyu10PsdCl9u0I7rzlAnVJhCx3UHsf4qJA&oe=6A3E8B1E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
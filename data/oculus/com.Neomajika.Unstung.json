cdn.com&_nc_ss=7f20f&oh=00_AQADgQl3tU7SRY9ALLGh1mYqixobVW4uLpvQ7KO9gkSsAA&oe=6A511485"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27FWbmNc9woQ7kNvwHKnkwD&_nc_oc=Adr_SER761EdSkeqAdwjUl042kWpgYEY9z03eNReUJFoF6hlaNVBAbbc_JCUHxm68rQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-Vz4Vc7cogSoHW0qTaAek5g5RWKC6s_mieKfmUErPQg&oe=6A50ECDB"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkDDP-XAZT0Q7kNvwGNxvL4&_nc_oc=Adpx0psA_0EBHmf02ykHd3UkeqAaq2jMt1TGqMc3XF4-6Al-zKYyJ8bb-rW6EnoGLJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm_nUXfA6u62_8QvpX0YJwknuQid8_B3nu88F0Vtu44Q&oe=6A511856"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmvLT16fCToQ7kNvwHk2uw4&_nc_oc=Ado2xep_ItiE_0nvdJ5cX_tNtD8Qh9S5iyeHNIzFAX3ufDH1_TtMXb9TzU4lKhKCd1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgfyAWnS4Kex6qAqU8dVhK_hw3pGCHE0rAjqK3HJfx7w&oe=6A5111A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt2WexMJSDEQ7kNvwFZXoYI&_nc_oc=AdpAxjCIEKiDjEAlViXb5y0XQh-doAC7UGWBFXSLWkImYdPqXx9gQl7Mz_EmmCo-Hew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz9YdBYZJfbFvn3qMT8pQh6tbsj8EWDvsuaclnV7ok-A&oe=6A51001E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
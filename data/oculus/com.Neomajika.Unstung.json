cdn.com&_nc_ss=7a30f&oh=00_Af3_9cFTR4lR2Nol_Y0pl6JkgHLYsIaHdXza4mq4yJeiMA&oe=69E76445"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm5Bm4N6FEMQ7kNvwGVylGz&_nc_oc=AdqgHnuObewAUa_lveEo-UBfHDoh96Q0DgstQCLRwV72b9Hn_iTnZzMgMLoT7XAvq2E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09oceqCz4vw4dew7iibCvSnlg-wxtgoQ2Y7KWiXbAVSg&oe=69E774DB"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibcdGzNQ_ogQ7kNvwEmZ2jH&_nc_oc=AdrXeczTvQ6WD3oZ_ou71lBZM8CFvfxn0jLiOgFtvOLAfOBQMecWjEqGo2XJy__ZfHQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b9_Sz5N3HBsKCjqYrz-E1cWix5apusKLiqj46INhKvw&oe=69E76816"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMxid-bubbkQ7kNvwFkGbjs&_nc_oc=AdrvkRLZcaZZIoVxhwroz3Kt15dmWPXe5LZNK6qvGKDA5Ty6698mSbi8MqMgdTSJCSY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m5Rl221DN4h4opoXMi-3MzT0FN56u04iYfQQHP0pzxw&oe=69E76166"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6N59RPo0pIQ7kNvwHvnppt&_nc_oc=Adok8zS7MqsoPwhmDRuQ6Sn6r1W654rz-Dwua2fryWLMyCdhl4ZE2ibT2m8Vy1__fLo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H4wFixP-7A7VE_EI3xfyFo7pI3gpsIWCPo0FpDvGBWg&oe=69E7881E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
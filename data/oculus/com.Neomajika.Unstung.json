cdn.com&_nc_ss=7f20f&oh=00_Af77UDHKNH1Xrg2Eic7aeoDnpMQ0cj7MCj-u6bGDCFJnxw&oe=6A146F85"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai_IZlNM0XYQ7kNvwHxQPSU&_nc_oc=AdreBd-rqzH_EldfThZXRelwoR-35LA6zjxpl3txx3aeMuHH5c_kv2kLY6NW1HYZTd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c0HufsoRpTmKw73BMzIeOwTpDot5if-LX9muI6HC4SQ&oe=6A1447DB"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb46ieJn_r0Q7kNvwE3Kpvy&_nc_oc=Adr0cQ2GyUwyWFCVr2Vos4mqNKuVp6rUZPa6AtjH9Timy7X0UHrKtDjyxf1p71lPrO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ct4Hv4kqt_m1AgOjSM-IVh0Hz6rSjIq0BSZF2rIMn8w&oe=6A147356"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA1M91589aYQ7kNvwE0u1Jv&_nc_oc=AdofcemuC3-eKjh6i4ndQbEc8jL749n_HCrM6wUEdrm_3jnQxdGqwbu8AqhjgkxqihY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DmNb0dP0lDLcWySjqrBOngG5aV_qcVVjoI3YQ2r5I8A&oe=6A146CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQLyCkvoyCMQ7kNvwGplI9Z&_nc_oc=Adosb2fW_TKGO58kwymc5DdVrdNnFlnTi74bC6SdSz395W0Yev1MaY1E3GqW8vO6ykU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lxND8cn2mvOtwmBHHNUVF8i8IF9po8pTEYltHHKwzDg&oe=6A145B1E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
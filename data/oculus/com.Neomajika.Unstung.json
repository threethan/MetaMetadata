cdn.com&_nc_ss=7f20f&oh=00_AQC_ugkGpveqLV9vti7DVOq6rSz_-XoNX7u_v9_Civs-eA&oe=6A5A16C5"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OqIhVS4IpQQ7kNvwGwge-v&_nc_oc=Adop2_-f5SpL3GYphpBd4uzaoZy_adruKmmvpe5ZQbBnmIV26aqbi2DEhsTQngtmxyY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZhv29x2s2QX0iuDIkGugfHPdR-WJxkopTCQETwn3Q1A&oe=6A5A275B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMA-a_K6NKoQ7kNvwHbQldE&_nc_oc=AdrxCrsfCmLekIJntHVoTAT49UbgLV26XhJsp3OTdqYZ3UUnFAY9tVvd43Uv0uIdA34&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM3lhZo7sLLSxM2m3vWENJi-RUvVrYZU0A0yMnQ3gSCQ&oe=6A5A1A96"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCoff-cGIacQ7kNvwECY62w&_nc_oc=Adr-XRu1WzRvOSnAUs6oHODTGCEn8_SAI6Aj5ux8mcMyRpJ9OWPcuCfCoyXPzTrMkhE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcacuI8Sz1T81BiQsZZL4vCRECDG9Lj87Pxn_BfP4NdQ&oe=6A5A13E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4ooiUJkAZAQ7kNvwF9F1rp&_nc_oc=AdqFBVMjB5NIjL5F36O1fsbpe1jzWC26BBiCwA2PycKW1zeD9KPgkZfF2RGNHapb5Ng&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKdn1VdPhUzFWpFykLMs-PYSTTmrliEhbAuCV8iypHtQ&oe=6A5A3A9E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
cdn.com&_nc_ss=7f20f&oh=00_Af-tzdWzcNBXuReiHkmCa9RPU0oPMRsLLmZKd1JcqGVsCg&oe=6A317085"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYTjudNi6nAQ7kNvwEm8ov2&_nc_oc=AdoyvRGln39OIi1yPrXMED0zHRnLhIqJwgb2EMLw8uIoULNFz47MEac_fjVxVMdm6Xg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lb2uJtlAO-SzJtWncZAdsHqlZLx_jcxVG2K0ojiYdQQ&oe=6A3148DB"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km3jMx7HxfoQ7kNvwERLl_t&_nc_oc=AdpdSgj52iwWEK89YFDwy5ePLW9kMHfPpXwbjHEmqKcIoTZ0__LIyqIomqNJyPz_ZE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rAX67HUFTJsBytYxENrrxoh5vrpK2hJLJyeiE8bjRaw&oe=6A317456"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqcj08eeXpEQ7kNvwH-gXjc&_nc_oc=AdqM9mahF211KMfuePixYBWfmkxr4Jx-dhyWDcsvNIZqHM4TUjrExfHYR7J9fEKD584&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r64-fOBUEFgLDrqNZLTp6MPqjVfPtAVqEILgkFg-FNw&oe=6A316DA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMQjHF9F9PwQ7kNvwEry-qh&_nc_oc=AdqA6rSu7ra5qYGbIQ8eyAHe7xwoYCdl3SVFwy4Qd_KIhZcYc9H2gSIjSi1xggoiLi0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NAMiyzD1FGQsR06htc4qtcC2XoWSf6DLODldKWWjeqg&oe=6A315C1E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
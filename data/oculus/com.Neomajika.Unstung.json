cdn.com&_nc_ss=7f20f&oh=00_Af_kojokT0MreFA_RDepwNgQ8yqUeK08a7FSfg1_ws0Peg&oe=6A3D4E05"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15KUZYchRvgQ7kNvwHVaqiB&_nc_oc=Adq2_7_0EdsNboZYkyDg-hdn1Rhl1nb7xXPRvK4KAjhRwgvRFKV076wWYwx018hEM20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d52PVvgsSEpCwCzfTswuVKSRgGzBor738a4PFhKwq4Q&oe=6A3D265B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaxVhFD2n6kQ7kNvwFUwJVr&_nc_oc=AdqzkCVZrPqcwRSXo1N65SRUwhgUGiPUJx_5wlGEmbc2jPodN68yhS8HCTS2MxwdoCY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K4xcAhMpkRGULWYIkAx5iXumAoohsNUdJ2IfoC1nCSA&oe=6A3D51D6"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38jKSRmk4I4Q7kNvwGvpGWf&_nc_oc=Adror16FltKZ-l6c2-PhrHDjUXCcxceTz6_un-NNRlmMOzyRrbB3oxWgg14eu47oLIM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WhVwaEKJEN4RB9Jy1fXEpcgJmrjqvFbcCTLhHBl7HdQ&oe=6A3D4B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiaxEiIQfwsQ7kNvwGLXskb&_nc_oc=AdoT2U-PKWKDCPM4vIsWDAKhaObGdZKcGPGfDNsUj6ejf7RkGdyg2HuAYoBAS0STWRI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jMQjQRlOaeVBglTLQG--_IixKhkhJ9TK9STh2dqToVg&oe=6A3D399E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
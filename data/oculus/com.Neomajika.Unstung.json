cdn.com&_nc_ss=7f20f&oh=00_AQBt51YqYkaIc7gFe3ftTR7TsVA-hHB5fRpxUSQi8CVPfQ&oe=6A565A85"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1-5IUkRa28Q7kNvwEU60ao&_nc_oc=Adr31MQhRc9HbTQJeibrRYg3yQ5z1cUXAa8jhJFtfcftMRBaZ4QyOtgtcDA9BgSEi9o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp-Y7j8hWdv0fRB9gygi1x398bAraeRw8kP6nV7I-Lpw&oe=6A5632DB"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3jquHrGqrIQ7kNvwFJELIc&_nc_oc=Adq0JcP38XFeoLTSz4iQepDiizr_SN95BHPOGcX_TWSgRW155-XvXvf8SfHLuCJn_zM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5srYseUp5tExoPItlz6puejFLCOp4UJB0WFDRt-LgrA&oe=6A562616"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euS9uSTGjjkQ7kNvwGzR_k7&_nc_oc=Adr4fVH9lCtq5L-yb18FPD-oRIl33AH8yshEpgUTKk3O3w5_JixPyqwi7k2VSFTDAIM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQxwDIO96NNOW2RXvlKp3GcpCSJDuSQwz8Xm86NYzUdA&oe=6A5657A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16RDKgLmFOYQ7kNvwE6wM9h&_nc_oc=AdrZ8VbEImA55nkF9i18NDNqxJs8kyPvL2YN3l56KE7qDjKQWUtdlsc3cSLanlFeI40&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuE52AYldTMu5_inMfMqTMOhiRG6wBwhIfxiSdpLjrTw&oe=6A56461E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
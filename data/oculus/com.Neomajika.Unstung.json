cdn.com&_nc_ss=7f20f&oh=00_Af7XsLCj4Goe-zwoTsPaXyQokxQzUUiHmXWn0tqwXVMPgA&oe=6A131E05"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cY9GDFXYfekQ7kNvwGLKs1F&_nc_oc=AdrgTqbPNep825P6r8IYTbu3e0cUSe259s3PKHiGpM3ra4TwyTjIPfyhSO1WC-Bz2A4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lNsDg6pGIw_6LBSUKqxjvfrIzi4mh0m34DXqX5-xCjA&oe=6A12F65B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb46ieJn_r0Q7kNvwEQwy7a&_nc_oc=AdoF9YvIjtdSmI2K34N3oKtZixOddzWVDk6pZEfDG2mZ_2xeL9lrbkV1wetC4mGrK5w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50t9XUwhTJSSrYR4_Os0wkjnHUNhmC9phqgklyunuXgQ&oe=6A1321D6"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2SNwCc5weIQ7kNvwETkOSE&_nc_oc=AdpwpjwSr1LmvJvISVjkeq_WmiXAWqpPLpiI7ZON67IhvDPX8sIFkYLNH8177Rq4kaw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_tfTTlbVW8y2J3RfPYwTFjVkgmKipArzqLD268yPPrA&oe=6A131B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aqdfRxUcX8Q7kNvwFP_HSF&_nc_oc=Adr4vjkcGyqyEkcZbXIe1BaStBrT_SZd-8E1IOxQdGX-YYtnwFrvCe6V-vtRVEoZUHQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63GD5H1e_wkwIZXzJomCqRqKlBhGK8dAX5rdOXvsK0bQ&oe=6A13099E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
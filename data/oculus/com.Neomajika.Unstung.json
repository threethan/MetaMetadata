cdn.com&_nc_ss=7f20f&oh=00_Af8KuEbu4I8k3ihs6u8xlhn4x-om2P9DiuSKd1UkUqMy8A&oe=6A219E85"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt7-JxnUXDQQ7kNvwEnID7X&_nc_oc=AdozYsQli4zRw4hsUE2i-8ArQZAfQXIXf6qxRFldQ6d8W5xw_5Podfk-E0bxrwGgu8E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3pA7UbYykjwSdli_J2jzrr5N60j5o21ZS2UgUWkxSug&oe=6A2176DB"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERCU56RBd8AQ7kNvwGlOG7L&_nc_oc=Adpm7Kp5sUIegBK_hoWt9wNDyOaLRKEf_nOFxZEsP5Q6IgJl1pCPjsG5MA3-dOM7_tc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8klRnKpj3CQIzWZICbrCjH9eAmGohWMycC5Yr_PnXQbw&oe=6A21A256"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hTixEsgnDMQ7kNvwFRAhjo&_nc_oc=AdqawHC9NkGDVfw0Oozze1HzrGUC-NjXjcuPaBydc2Qn570Nc07zFvjcoUsblPHJSsY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YZ_a6Nkj4SgDLd2bua0kZ1nH8eKepRYA96FLhHITitg&oe=6A219BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2fieyd84E8Q7kNvwE4_nht&_nc_oc=AdqCYvzQ4r__G_y3QJjM-CS8owTYGGAyb7tNkXFT4WzThcwJYCC3mk5vxDk7M1Ttrbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91bUl9fUcybs0EP4tGuX13wXVWU6Mw6sYKNIKI7ueGmA&oe=6A218A1E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
cdn.com&_nc_ss=7f20f&oh=00_Af0Buf6pn3jRPnEfSap4vA9x9eG28EQ6BsaFzy_ksN8bqg&oe=69F341C5"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1ex1U9_pJIQ7kNvwGR_8b9&_nc_oc=Ado1S5vyyLmPShg6f3frQasiwzwvLyMo3Wijw55NeiLuakLtqbAomWHzz51hy9pUzik&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1p1n17ibi86WZJZZe_tNVfyhCWajVR-HF0WsppMI_8nw&oe=69F3525B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpAt8d2f3hgQ7kNvwGKnUOR&_nc_oc=AdrX5WRaqPPhCDEVB6Su5nWSjQ_BYVGgrAsRGYrm3yf2xLfPhfkEAyLDeWLZF0gz-EA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aF7jGQf84jveSp4NNPKlLoxHVrK-2dYBcHLUv5OojsA&oe=69F34596"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvWCucXEJn8Q7kNvwEBvO8r&_nc_oc=Adrf_XbdkJOMvFJd2JzdCdKAzHTKczAvdj29B3K1d1MNBTqSr_izOslHS9Pa-dxzsfc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05YoDPIXZqZUU74omtwHX6eCG2A7OC1PRnRbeFiCZQdA&oe=69F33EE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUsdtzva8JYQ7kNvwFX-1Sv&_nc_oc=Adq0Zt6Tnxu0nSjav5Z-d3SQTOrc4aLnqd32hw3rpOBXeubJAcoE3eK7UEYs3sHAjwI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YUSEpLm4xxAPanPsD_FfiH16ifXijuAuNGZtmT45SvQ&oe=69F3659E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
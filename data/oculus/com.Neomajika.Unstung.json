cdn.com&_nc_ss=7a30f&oh=00_Afxoe0uBJNxjU1nALG6mTMEhmuS4_8lzuEw7M-qZxv-kqw&oe=69C7C045"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnxdgFhHpnYQ7kNvwEsTnUO&_nc_oc=AdpqPPw5mogSW1lp3z2iWE5evAr4pD18UTLmRRenXybh6yL5xSkR16MET5QB_Ukr50E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDC_a5gH2s6c0-3ak75lMoOUWa_8fPSI1hVDFZcRu2tg&oe=69C7D0DB"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGKI7HjYMm0Q7kNvwHPJmI7&_nc_oc=AdqqLQXG_Ui0IwP_jbfaYbx4TLQ8vlMjK98NOy2XS1UnsNn49UzSaC1_jN6z7_QD55Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjJjB5Bwx6MvnByD_t7-UbCFeWJ1zO17AMSUDIo_KSZQ&oe=69C7C416"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDN0wmVei9MQ7kNvwFKCg72&_nc_oc=AdqTgt3KMQ6M7VQcQt4rZnqUaS5xPNPzSbrjbn7wXNo5Wj4PyntcV7du_tibnz3ztgw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytYAkOzsNZ_Kv4zJFwDPZBWJtTJPmydlYmMnMblVamug&oe=69C7BD66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-pj2VVobVsQ7kNvwGdF0kr&_nc_oc=AdqKGjU2D3CWNkLkelEn3HzIn4JjuC_3xHfa-D2nf8GFaIrm2WQGJRjMCf1Nci5J7fI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykAoTiJHdHkxxjG3JRXDH2Q3VzgPKN-jTwLYg-i9HWkg&oe=69C7E41E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
cdn.com&_nc_ss=7f20f&oh=00_Af5oBknENerZDDYe1Zo6p3z_2bs_iMgr2x8m0LuOS8Jaow&oe=6A15C105"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai_IZlNM0XYQ7kNvwGy9y0x&_nc_oc=Adr-4bdUl7ON6cy284Xti6GfUXOq_bAaIP1Bs3uo2FtQxYoqvrpI8lXxH9O0WpuVXf4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-N5FXdNVs_T3VnL5_0JRif8Wr1QZ-CvlnppSC0N6wpQ&oe=6A15995B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWw0-z-zjdAQ7kNvwHG5bnF&_nc_oc=AdqGJCCMyZRy6B242Pi-okIiNJACxM474Y9EF-pbXWrtl1Yh74UycHUwkMrDgDZel4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xN8F0hcjjLMICyjMx2IJ1LesdXQleNezdKMFyg8EcEA&oe=6A15C4D6"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA1M91589aYQ7kNvwEAUnQl&_nc_oc=AdrlKvzIXBWfDj7l6kt7ncu9EAkj1X35XGCczvp2CdEQxTqZLni8sOF7XM07Py9M8ZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oUlpybd1xaxMAo7mvTb8JS_fmn3Un1OPebkz2_J0l9A&oe=6A15BE26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQLyCkvoyCMQ7kNvwE3xCSJ&_nc_oc=Adqj3AOO6uQ9Rd7wUMp_TubryXuEUIRFmxpFApklU924Lqa2iEGjUdWdzEsR6LXWu5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e4zVzW2Cnvoj_7S9BO9nzi1faxg7dUYX1MSxT5IITJQ&oe=6A15AC9E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
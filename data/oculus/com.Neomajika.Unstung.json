cdn.com&_nc_ss=7f20f&oh=00_AQAW750ss_wff9vvJhbAszUWNaf_sPPqTYSbJLX3STgrwg&oe=6A4A7D05"}, {"file_name": "screenshot_3.png", "id": "447581756388355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195907_447581759721688_3344386886265952175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy6nOrjePfEQ7kNvwFaI4ci&_nc_oc=AdogaanrXqdn26WWS5qSKGqn0u9-syG9hSJIa4gNZEjZCM5R4kQ-1qzW-WD3gezqTYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD5Bj5AnlPwAjflJpCiHKoQDC9a2pjPzf0YgL1GJ0fUw&oe=6A4A555B"}, {"file_name": "screenshot_4.png", "id": "1350226062000830", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_1350226065334163_1065864042677638636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K8-Gy8oex4Q7kNvwGQp3vB&_nc_oc=AdpmhHkvsAWvHJNc6nnM7Ml5-8CvPSfZbJRKIICP1nkwLOWOo3mIxyZb60tTvDSNySg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBORUz8w6MXi7jk24KVD8Ni8p6Gv6Jqgu09aBG3kzL8kg&oe=6A4A80D6"}, {"file_name": "screenshot_5.png", "id": "3754276174640638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_3754276177973971_6300334187211752958_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFbZSXL7kmkQ7kNvwEVCqLC&_nc_oc=AdqwesltF1CE-1y4A8PwpJfXvtCJzoDPU2OPyPw51xcxUPoYhUN75s_Lu3yeHpbTU_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpQ-9QUkNSR1HYJrVQiPVsa8JzAcf8j6w3hBwxnYfJEg&oe=6A4A7A26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover_2560x1440.png", "id": "763112647971999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_763112651305332_1577427146239561671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApPZVIUDBtoQ7kNvwG1BOaF&_nc_oc=AdqEbRB_nt6Se6G0ow-tp2dQIsoA9cqJaZcYd1wQLGUeBIhxMGgBzcGs96VVdagPQRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2cOl-z4nuIw9ssNgLL1aTwRX4u0h5o_sSbTfX_rzaqw&oe=6A4A689E"}, "display_name": "Unstung", "keywords": [], "long_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!\n\nUnstung will make you feel like a really busy queen bee! You'll be buzzing and zigging all around the meadow to keep your little bees working. There are many ways to play - you could collect a huge swarm of hundreds of bees, and zoom around eliminating bugs - or you could set up a busy network of pollination to keep your flowers in tip-top shape!\n\nWell, what are you waiting for - the bees need you!", "short_description": "Command a swarm of cute bees as they grow & defend flowers against an army of hungry bugs.\nYou control the Queen, buzzing near bees to select them, drawing zig-zag lines through the air for the bees to follow. Help the meadow bloom by bringing pollen to flowers, making new bees, and always - protecting the hive from the evil, nosy Lord Mothmer and his bug minions!"}]}, "developer_name": "Thaum Games", "developer_privacy_policy_url": "https://thaum.co/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Thaum Games", "support_website_url": null, "website_url": "https://thaum.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"],
_image.png", "id": "211253409965231", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138771_514471178725512_952740508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60TLdshInlcQ7kNvwG3WZ16&_nc_oc=Adpl9i1ObFtGsDto0w1VLYNqcReD96GNVRros38ADNP_KuwY49T5Kg6ZdSwzudKn1Vg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1Dpu77MzGwpfmGSpfUZH6W0abmobQCwV6HgeOlcHogQ&oe=6B0B29E0"}, {"file_name": "migrated_image.png", "id": "223165219069760", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12448838_1263126450368390_575334927_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWSxqIM-iMcQ7kNvwFDpJS_&_nc_oc=AdprsIBbF5YbcLETVvN6WYacfbHr-j99kJb-cHMq90xhiyNovzhIBSDyh44uQ-Dpmrk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTigtpCDJc2JkoHDuvb0Va75EbJeIAbRlhESHyouMQh4Q&oe=6B0B1A9B"}, {"file_name": "migrated_image.png", "id": "199957148003938", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139059_920851024701169_277313017_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pV0qb6-2efoQ7kNvwGa93qb&_nc_oc=Adqgi6PhYuF3dQd0c5mR5a0IKCa0jVT6qSLrcONYfVFdXAyAOFd2-2qgEG0RsknC7NA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuAVzZTLV3kPADNrAM1Yt7BibSbfjz91yqR9RYTwppdA&oe=6B0B2DA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovr Egypt: King Tut's Tomb", "keywords": ["History", "Education", "Egypt", "Tutankhamun", "Discovra"], "long_description": "Explore the Ancient Egyptian ruins to see what they might have to say about the life and culture of early civilizations. 1323 BC:  a time when Egypt is a recognized world power. It's young leader, King Tutankhamun has passed away and buried in what would become one of the greatest icons of Ancient Egypt. The tomb is littered with treasures and artifacts symbolic of Ancient Egyptian culture. \n\nCenturies later the tomb is uncovered by British archaeologist Howard Carter, and now you too can explore the tomb. Look around and learn about its contents Discovry Mode, or take all the treasure before time runs out in Treasure Hunt. \n\nDisclaimer: Not available on Note 4/Working on a fix for bug on S7", "short_description": "Discovr Egypt takes you into the ancient tomb of King Tutankhamen, where you can not only learn about some of the rich history surrounding his legacy, but also uncover his treasures. \n\nDisclaimer: Not available on Note 4"}]}, "developer_name": null, "developer_privacy_policy_url": "http://discovrlabs.com/", "developer_terms_of_service_url": "http://discovrlabs.com/", "publisher_name": "Discovr Labs", "support_website_url": null, "website_url": "http://discovrlabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_CA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1004050176866419"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138771_1076673669021066_708249292_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLHcOvNsK2AQ7kNvwH0DcPw&_nc_oc=AdoGoYpKQK0vFjWBVt6i3eq4JQk9dNxWbAufZdytu3HFbu9AnmjLkYO3Ngam4tKrJzM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXChNKosXshqDCjPomUwo5ZC8t8Y9FiGv_evrdXOo2fg&oe=6B0B1148"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovr Egypt: King Tut's Tomb", "platform": "ANDROID", "
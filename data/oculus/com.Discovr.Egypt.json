.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X86FYuzfEYIQ7kNvwHzBlHj&_nc_oc=Adq_WXVHQr-vIekL7ZyDJh9Q1VnWTw0HWxOgRBzl2OzDGcFO3e9n5Dieak8ObuUUBYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVItZmmlWzI9ot36riPuic69ZT5yf9uHXymQofQNxhvg&oe=6AFDC663"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovr Egypt: King Tut's Tomb", "keywords": ["History", "Education", "Egypt", "Tutankhamun", "Discovra"], "long_description": "Explore the Ancient Egyptian ruins to see what they might have to say about the life and culture of early civilizations. 1323 BC:  a time when Egypt is a recognized world power. It's young leader, King Tutankhamun has passed away and buried in what would become one of the greatest icons of Ancient Egypt. The tomb is littered with treasures and artifacts symbolic of Ancient Egyptian culture. \n\nCenturies later the tomb is uncovered by British archaeologist Howard Carver, and now you too can explore the tomb. Look around and learn about its contents Discovry Mode, or take all the treasure before time runs out in Treasure Hunt. \n\nDisclaimer: Not available on Note 4", "short_description": "Discovr Egypt takes you into the ancient tomb of King Tutankhamen, where you can not only learn about some of the rich history surrounding his legacy, but also uncover his treasures. \n\nDisclaimer: Not available on Note 4"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Discovr Labs", "support_website_url": null, "website_url": "http://discovrlabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_
_image.png", "id": "211253409965231", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138771_514471178725512_952740508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vnbGKte6E0Q7kNvwExfF1i&_nc_oc=Adqby3Z8rcVh_N4c4IW-iKbnvEGB2VVwKDGPfocj1rLp91vgw04XOkT-4OObLC8Y_v0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAmBf_TrQKDpXgziBFoeNORNrjxUMqUlmPyUD7Bl0jgw&oe=6B084EA0"}, {"file_name": "migrated_image.png", "id": "223165219069760", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12448838_1263126450368390_575334927_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njpkBfcfMroQ7kNvwF9lRke&_nc_oc=Adp0wmownsmWOzO7c3dXNu5SFZotWmU3c30jruQZiZL02WEQjv4WaaCY-cZJRPTOrDA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrP8ZPwVtSCOumwbETSnkOQX0L31IEZdizYo7KUxT2mw&oe=6B083F5B"}, {"file_name": "migrated_image.png", "id": "199957148003938", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12139059_920851024701169_277313017_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pV0qb6-2efoQ7kNvwHHSB6t&_nc_oc=AdrvCAVnSYN-L2KLJ9Y4nBnmR22fqfzL6fqNbBeiXODOiMT2p43n9rst2QwdVmJFGXI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUI8lg-cH4H8oagg9ibQIC4lPvYZNHdSpyOpLnxiu7sA&oe=6B085263"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovr Egypt: King Tut's Tomb", "keywords": ["History", "Education", "Egypt", "Tutankhamun", "Discovra"], "long_description": "Explore the Ancient Egyptian ruins to see what they might have to say about the life and culture of early civilizations. 1323 BC:  a time when Egypt is a recognized world power. It's young leader, King Tutankhamun has passed away and buried in what would become one of the greatest icons of Ancient Egypt. The tomb is littered with treasures and artifacts symbolic of Ancient Egyptian culture. \n\nCenturies later the tomb is uncovered by British archaeologist Howard Carter, and now you too can explore the tomb. Look around and learn about its contents Discovry Mode, or take all the treasure before time runs out in Treasure Hunt. \n\nDisclaimer: Not available on Note 4/Working on a fix for bug on S7", "short_description": "Discovr Egypt takes you into the ancient tomb of King Tutankhamen, where you can not only learn about some of the rich history surrounding his legacy, but also uncover his treasures. \n\nDisclaimer: Not available on Note 4"}]}, "developer_name": null, "developer_privacy_policy_url": "http://discovrlabs.com/", "developer_terms_of_service_url": "http://discovrlabs.com/", "publisher_name": "Discovr Labs", "support_website_url": null, "website_url": "http://discovrlabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_CA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1004050176866419"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138771_1076673669021066_708249292_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yNaBzhgVtYQ7kNvwHmW_Dk&_nc_oc=AdqxsFFGyquJpBeQOWmfnF3gL239HHCUnhbzaF6WMT-SUid8HzMmV53RqMJp0YVgV04&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrRCOykHkqoOSq0mcgGA1iwbRsKNEXWMZHuMX2qG9Itw&oe=6B086E48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovr Egypt: King Tut's Tomb", "platform": "ANDROID", "
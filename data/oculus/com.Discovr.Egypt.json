_image.png", "id": "211253409965231", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138771_514471178725512_952740508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Lqn7k0aFl4Q7kNvwGFplxP&_nc_oc=AdqbV0xuXW1Sp_OlpXNbB4X5aLyQL-gDLHLoAnMRi-2TF7-A85JeDbRCJBItEurJMuI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKA8nHsot-yhDpkvd2z6R5E-Uu6y4iyA-eyUakIt2Cuw&oe=6AFB1FA0"}, {"file_name": "migrated_image.png", "id": "223165219069760", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448838_1263126450368390_575334927_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tx2fxLWTJpgQ7kNvwFqhO30&_nc_oc=AdoUmklQfLsnefXfa2P4SwpV7e2DNmh8kqe-sDHZiLp81mhoRYGCNcVGDrlFZfyvVSg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlLpVOPPrCtgBKDTiAO-uIfAUyO9iJEwRR-9xSAvaN7A&oe=6AFB489B"}, {"file_name": "migrated_image.png", "id": "199957148003938", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12139059_920851024701169_277313017_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATH3xc4BSWcQ7kNvwFj22Ek&_nc_oc=Adpz4N9wcJ72LAzfyux3z6aVZaaw2qE1fcSsDmdTbOgKYv8tVKtWZN8lY4FOUw_5egg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIwb_b1Tjg0M1NjcT6URmBFRZKA-WxBN9KlqfPXrspAA&oe=6AFB2363"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovr Egypt: King Tut's Tomb", "keywords": ["History", "Education", "Egypt", "Tutankhamun", "Discovra"], "long_description": "Explore the Ancient Egyptian ruins to see what they might have to say about the life and culture of early civilizations. 1323 BC:  a time when Egypt is a recognized world power. It's young leader, King Tutankhamun has passed away and buried in what would become one of the greatest icons of Ancient Egypt. The tomb is littered with treasures and artifacts symbolic of Ancient Egyptian culture. \n\nCenturies later the tomb is uncovered by British archaeologist Howard Carter, and now you too can explore the tomb. Look around and learn about its contents Discovry Mode, or take all the treasure before time runs out in Treasure Hunt. \n\nDisclaimer: Not available on Note 4/Working on a fix for bug on S7", "short_description": "Discovr Egypt takes you into the ancient tomb of King Tutankhamen, where you can not only learn about some of the rich history surrounding his legacy, but also uncover his treasures. \n\nDisclaimer: Not available on Note 4"}]}, "developer_name": null, "developer_privacy_policy_url": "http://discovrlabs.com/", "developer_terms_of_service_url": "http://discovrlabs.com/", "publisher_name": "Discovr Labs", "support_website_url": null, "website_url": "http://discovrlabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_CA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1004050176866419"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138771_1076673669021066_708249292_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqna4INTzWcQ7kNvwFOeAS7&_nc_oc=Adp-aFUfM7j_nnBSgss5WM12JfjEpZwaSdFJS3m-HLUN5pWpgwBshQW62QfmW1yit28&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs732BDMwE8Lc7uVz1weBmDy3j_dWO9ahzpc4uY74P4Q&oe=6AFB3F48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovr Egypt: King Tut's Tomb", "platform": "ANDROID", "
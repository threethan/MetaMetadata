_image.png", "id": "211253409965231", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138771_514471178725512_952740508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60TLdshInlcQ7kNvwHoIj6l&_nc_oc=AdohXLue8yTCMlreEeYta-x6BeMpmu3saD_m_ItbHYA8pBPIRbLRSSsyNhFr3ajjEbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToF-cOTtaRF08RJ0X9gJ_O6BIPcw3II9ZkRfvrn2dceQ&oe=6B0C7B60"}, {"file_name": "migrated_image.png", "id": "223165219069760", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448838_1263126450368390_575334927_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWSxqIM-iMcQ7kNvwFPFREy&_nc_oc=AdohiOo2EEy045oKfzUx_-7SdBantaZw3n_KUkbDLRaSPcrm5Ohz2RBTN60PPODoIs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTenSrpIdwm44MhRlCKLnsdg3zawqKN3Ro5Nf3mcpPEyg&oe=6B0C6C1B"}, {"file_name": "migrated_image.png", "id": "199957148003938", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139059_920851024701169_277313017_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtM8bLxuNakQ7kNvwFmwFwR&_nc_oc=AdovfVxGxmz_ZfnrE-e2Af835gDL_4TXqidjey2oPVIE_xZ6IalSN6RySozQ8jSqlHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVmyPUXuDmTkb_jYVqF7gAjE8qrW6cujt7XpF6Gb52SA&oe=6B0C7F23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovr Egypt: King Tut's Tomb", "keywords": ["History", "Education", "Egypt", "Tutankhamun", "Discovra"], "long_description": "Explore the Ancient Egyptian ruins to see what they might have to say about the life and culture of early civilizations. 1323 BC:  a time when Egypt is a recognized world power. It's young leader, King Tutankhamun has passed away and buried in what would become one of the greatest icons of Ancient Egypt. The tomb is littered with treasures and artifacts symbolic of Ancient Egyptian culture. \n\nCenturies later the tomb is uncovered by British archaeologist Howard Carter, and now you too can explore the tomb. Look around and learn about its contents Discovry Mode, or take all the treasure before time runs out in Treasure Hunt. \n\nDisclaimer: Not available on Note 4/Working on a fix for bug on S7", "short_description": "Discovr Egypt takes you into the ancient tomb of King Tutankhamen, where you can not only learn about some of the rich history surrounding his legacy, but also uncover his treasures. \n\nDisclaimer: Not available on Note 4"}]}, "developer_name": null, "developer_privacy_policy_url": "http://discovrlabs.com/", "developer_terms_of_service_url": "http://discovrlabs.com/", "publisher_name": "Discovr Labs", "support_website_url": null, "website_url": "http://discovrlabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_CA"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1004050176866419"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138771_1076673669021066_708249292_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLHcOvNsK2AQ7kNvwHS14xG&_nc_oc=AdoAYLEj2pDEyMiG2uivh2DM1ftAzCEC62mcDDR8WWqDNo9Rmlzbkx8Ox3ao5MzN94M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfb5tm-NHdQ7J5zWm8vTTxYEB1b2GxmoM0hnOieUT4oA&oe=6B0C62C8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovr Egypt: King Tut's Tomb", "platform": "ANDROID", "
_name": "002.png", "id": "546068903409635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFAfFPEyWP4Q7kNvwFbfK6w&_nc_oc=AdpAFe9Hlj0hmSsiL-SsHhSdPWEu1NdXLklFcEFghSQ4XSqca47xopudrIixDRjVPrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWXmY-WXuvmuWw4nD-Cqgv4Q9-ZIN_yT23ziCIbIriEA&oe=6AEDE04E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk6wGDcRxFQQ7kNvwGj6m_l&_nc_oc=AdoApFVF0Ch5LT2EhkC_gHeAQMMFpzJKa30BGR9zuETULfQyZfA14HdcDobsZmnunME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGKlEK7B1D4U-BuEeXzg7c_0vXgNmNLB-ac_uU0ZfB6g&oe=6AEDD5FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73oC7kMihGUQ7kNvwGorzy-&_nc_oc=AdomXROQk-niyG0E7vTsE6TNKWARLNjRBFPHfvSnHvZUZIWYbj-aSRn6Kk39Ojoi3nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTU6eoDfq-uMrVjIpVU_7tJWojDVs-TGOs_AhEID7-Mg&oe=6AEDDCB9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "388334342827104"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "335548512062870"}]}, "baseline_offer": {"id": "335548512062870"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1653665460, "status": "PUBLISHED", "id": "335548512062870"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5157828360943789", "version": "1.0.1"}, "id": "734559787532511", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename
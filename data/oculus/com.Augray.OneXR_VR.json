25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOGQSbLcrbgQ7kNvwGWmA01&_nc_oc=AdoyZsOR2bfdBpxcxQNG-zC-fCirQT4c12yOeK60LfNgUCusBVH59oCd_pYbGiI7iU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLW9Tawquxr7BnU6du3yu-cA4ntJfBI2AJDjihJPFP-w&oe=6AF5C2B9"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGlUy6KgESoQ7kNvwEJeEHs&_nc_oc=Adpv4OUim7K1Z4B5-bZgv7nRd5eUg3h2yWkPb4RdXuc55jCx-sV3-nHymPcWCel8-vQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_rnlvtdS1UIireAbng-UONIe-jQT0EMfgk3u7lXQGkw&oe=6AF5EBBD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PedEDOnaXjoQ7kNvwHB13f0&_nc_oc=AdpQIhjynY6TGTaiGoO1lTQe21gPfTV30-sV0BmSi6eYFoRG3Uev7BY471nfGNEwA7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4PfzorE3rABjtVz1U7mGe8Lra5nTavh6zJUhYoipROA&oe=6AF5C94E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0q-laLXZ4IQ7kNvwEYTRmd&_nc_oc=AdrSZPSyoW6Giw5JdTGmKnWUlrJHlMojRLB4HS3q5KIIXC15qXwpChHkbvJzO-x_AWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6GMpUGvdILTzXUCqWEsPz3gxP7q3bgqZEoIKU0rqJ4w&oe=6AF5BEFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAprwu_nsdkQ7kNvwHpP3eC&_nc_oc=AdqRWxHiQfWIThsxqb4vNuOqv0hJ94CmqmFQ63bBI1CTYSLTM6yxQYOvXtUZDXE9hkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Ax_Wtzr8IXTxszEAoTlRiMgP-84_QQ6QtgEhF45hVA&oe=6AF5C5B9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JZeJvcRcdEQ7kNvwFWLlxg&_nc_oc=AdpBr0YizrPteqvfzvlm_WBvvNDk2OP5PUvuez17Pmikmr6zToyDO8QBA-tQfeIZVxs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm7ByrSWU4nQsM0u7QbmroHe_LaueFMkc_yIMb-wg2WA&oe=6ADCB639"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOKunq0i1HAQ7kNvwHnLjKM&_nc_oc=AdqNColqz4qbBecOe9bNnIn6ta5u93kpCKjLCXINc4AR-9xUKcQ_wckRo8glzB1jKdE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNClyWYpB5JWJweEdZMa7jt84dCDco-_NJbJSGdTMqWKw&oe=6ADCA6FD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqJRWWleMFIQ7kNvwFr8rTQ&_nc_oc=AdqeVt3QZ7QkFc9KR40yZ61A_Vn3tCI1haf8k8LMYHJWDxUl8udfiYZ2bIxYvfGuGEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQSQRw7dY0SDU8DzITBk8iGHG-Yr0M28md9fI6dxdwrg&oe=6ADCBCCE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VWXhHYhBG4Q7kNvwEgSc44&_nc_oc=AdqJTnh-_6zkaDk_xDQr9qDmhHx4C1syeF_j98VWYDzcdGxgaGcPFvWLM-iMylpRKak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjFm0FHQk1axbxbEv9PgVSMjPCIGRdK926nL9v9mBlDA&oe=6ADCB27F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gH60BaiFCcQ7kNvwEmevyj&_nc_oc=AdrWpmX0QSkx8da1QhxiaSGdlf_rYijaBDY2VTEjO8UjbExCPbVC4HxHQj-I5Gheps0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4APNu3HWpd49mScYxburB462h3EBrMAYUahSiUrpuyw&oe=6ADCB939"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
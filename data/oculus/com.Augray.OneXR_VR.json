25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0gRzwssgGoQ7kNvwGyeQbk&_nc_oc=Adp104A7-VzE6zesPRUCXjWeyzFweR6_F67oEEKJ1U_EVIAkVna-8wchGoLpFWp5aJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdU80u_zs55AWj5G1N6Tjs6d9f5keGnyg47LFyFuKA0w&oe=6AE5F0B9"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R76jClYuPWEQ7kNvwEYTm1A&_nc_oc=AdpmWDafc8tZbl5Z5DWFWPDh3bI8uoWs0bqo40kPI_veJiDoy-3K_eVsguJM68CiR3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZiTk_WrqgJp5eE0UYZTW-IY0JMSb9QwBNVQ97oqL2TQ&oe=6AE5E17D"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6UQ600xQ4sQ7kNvwFehYqK&_nc_oc=AdqIPFk0s085JzjjvhyzoAg4wDqVJXhWp_1Ho3ksWsmewqgVq1kjfWXSky9SDq4OFOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFiWmzEtajzOUtUmq-q5TpJ1-QOlM29zTDGbVfpEr09A&oe=6AE5F74E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj8HEYEtnzAQ7kNvwFhLUKw&_nc_oc=Adr5-m78cOHyEwMNFoGV42xn2a-EIOYIiXs3jyFNtGAjdb808fNN7pyaKAdF9jDSOZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxDdCqUPWGVwCqx3SUOFK8E2lQLg8hvwxgJtBvX2In2g&oe=6AE5ECFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjTZZlTFH4AQ7kNvwH-fSXB&_nc_oc=AdqDcGu7JUXcork6F3A6Wja3I9-19EVajrhJfrLfjSmHcFgOG_EO9ONO2tajxs0cI0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWorMrDzWWxd4IsQofLKfjr02Ny8q_cpbrTRNx-BeB7A&oe=6AE5F3B9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO0ut1WckC8Q7kNvwGB0Ivu&_nc_oc=AdrOXlnEXDWRa_BEfKqAn9L9NNaJRrRSv6CAOH_ew4wnNipPR6cjVFojLhABwvkfPWc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxdbMgaosUHnq40YJEpqaXGH-YezQ0-mwTgaAjA4MMlg&oe=6AD3B3F9"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OJ29GUQBGQQ7kNvwHJZCSW&_nc_oc=AdprfUUO7ybmIClSzW7trmCPyrjKsE8QJ3k7_P75RKH1cnE-VwZvRYs70MUQXl-RMPA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu0c5CVpAwMAmJ83HyIvE4XyQcovaDlJaLFwhSd-5X6w&oe=6AD3A4BD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9KI4OrdBWEQ7kNvwE7zR11&_nc_oc=AdqMs86Nebmirp87nXjf3EjZS_WLcmZ57aeGOPxHhHilLvJymSSgZuRXSibkILsocmQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO970Y6SeMmwRhkfbklvlVHTmvhmFKf-aQ7jwSp1OycKA&oe=6AD3BA8E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8wtiRijM1UQ7kNvwE84WmE&_nc_oc=AdrgOVa-inXAepVQ_5F0pIAP7uQ8RF4CYd4jZIpqUx_M3oPQtVY1GZ5rlBRHDyVC4g4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9pjSP0tSBQSmWBG6LC791BoSgVjJG8HBa5cc98mxrDA&oe=6AD3B03F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF7INZ5F5eYQ7kNvwHeVUqb&_nc_oc=Ado5p97CfwbcCj0LSukWwF9BpzXP-7P51vlj_mJUmLxEuyMz04yAt1pGZm3Q_moK13E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9DjsJH8GHrPuqy4SjekR_cQXCW_l-EbYTd06O9EA3dA&oe=6AD3B6F9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
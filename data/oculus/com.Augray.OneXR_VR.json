25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOGQSbLcrbgQ7kNvwH_JmEi&_nc_oc=AdqscU7259MqVN3mx2qDSC2Qy-nVpplOjPE14y-RaL43evUYnzKCh2mVwlFDnrY23SI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDlB3fh0dYy9zlUpH3RRFAYph40e9-63ymmB7OX7c_Qg&oe=6AF89DF9"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGlUy6KgESoQ7kNvwHMkOwg&_nc_oc=Ado-mLRFMYXUcQtwQALaKrh0KeR1kMGAt2i8Gw-hWA-4fOVRr_JGcXbW-6xtoqxCzY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg6bPVJzVkJP1IwJqzW2Q8kjApnzxnhfNqJ8n41GOsnQ&oe=6AF88EBD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oa1c0C4mNIQ7kNvwE0kUCl&_nc_oc=AdqhsCiWEX9I7vHVnRW0U1Mw9psDje4IYkSoQFnpDJFGgCPHDoTCoCASfWyM2hXW-ts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLSxlaSpp4nehkE-WuVv5T4dAM9IkiNm9CMnUvD-wGig&oe=6AF8A48E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFN9qlfE0OcQ7kNvwEpkL3S&_nc_oc=AdoodQtKjhgRarWJxaLr3dyAT0179JkpEaWzlmKGoQ72MJ1rRHhpwIeLXF-MPrkj984&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcviL3ts89ITW7bbKKeS5SA-jK6E1PgxFnV7t2MqIEGA&oe=6AF89A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UpDzEdGKPUQ7kNvwHuYwsW&_nc_oc=AdqXXxwJv0Pr-e0awdjVGOXQViV8_bP-zGFXE6Q4XNGETB8KzDS1P9cAREBjoBiFd1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsyRI_raDHp6gv6NBS5w9K5uJ8dxCBpJmTVqSEnaA5DA&oe=6AF8A0F9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
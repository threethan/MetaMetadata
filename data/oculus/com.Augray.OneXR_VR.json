25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxA5JPwiGn0Q7kNvwEXIYax&_nc_oc=AdrHdQtDgKM4L7OuRf2wVZh5pjIMahDYpk3pGH4Z3b7qb8dq23w-wAHuPVSSnFMRLDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMiGgmUFZ3gaTaEAspaGwra_Q2XK_J8R88Vwmrc9QwRA&oe=6ACE35B9"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wDsPpaTOewQ7kNvwFC6tJJ&_nc_oc=Adpl64kic-IGfiUotv22y6vodVI-OQElbfqSHIqWMFe-g80SjMDzwqJmFKztJiMBthw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMThcdgA8LGMUV_hhQld1hlMNMPTXPBIwRBqWozMNlPqA&oe=6ACE5EBD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfnz7_PL1X4Q7kNvwFEftG-&_nc_oc=Adrz4gnvdeazrC3WR0asn4mareS1y5f4-lgNvpInZeSRZ8o8TIiaKRce42ViQSoXDSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOatbFZg4bqe4WAsO0OXVrBBk-Ov-lRcuOrF3Y46mjNqA&oe=6ACE3C4E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emAIKrPxdkMQ7kNvwEaWajP&_nc_oc=AdrOO2qZD_Gk_sTbNbbwuiVMvN0K4ggzP3mytj82Pk_pwAwuEyA8r8H5p2BGMJ_TSgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDuBReC9ARmGLqTJJl9EWo3M8CKhEF-Ei9vNM73x431w&oe=6ACE6A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAbZnLptVLIQ7kNvwEz4E9n&_nc_oc=Adopi_VEAd2TH8fKYIiE4zhxDO2zpPBctLiA8bqsYScN9EpQoGRJswuBCKtgO8Kaa6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxsj6zyNXLGYFi1AAs-RQw1IdthNkwQOleTlCtTBABnQ&oe=6ACE38B9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
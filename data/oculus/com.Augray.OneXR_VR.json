25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEfnCaNotb8Q7kNvwHcjUnN&_nc_oc=Adps6adRXpFPRpFuHfYrmIgv5ApD0FvaUhWI4KJ8az14_BjpEPKq2ZPfPiNeA1EwI2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9fkSDTjHuRUtLW6CaNxBqqEAspk1tYBGTrOzHNBCFiA&oe=6AE49F39"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVUl-aRVFtYQ7kNvwHHVYQT&_nc_oc=AdqmgEZ8Wi4LTNJ1PdDvkOUhQPr9WiY7Betis6I1I9t_m0pwxhNJd6tU7Z1t46S8Yo0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOXsfJeo1J87rS2EdRcBYXMU-0mIQhmL4NjdeNXepS6w&oe=6AE48FFD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6UQ600xQ4sQ7kNvwGlmfy8&_nc_oc=AdqkFV1AEX5C0zqUG0kiXT8HZSzPex3-r8bu2DaCBZsJHN9ubknu-0slKMWWQUqAqUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjqlcOma8vSqoxB7be6cmyMMMIq1jkAXLfufBKjz140w&oe=6AE4A5CE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj8HEYEtnzAQ7kNvwHy9irr&_nc_oc=AdoyYgHbyc8Ub1uP299iDLxOTyLjTmop4xpvmaU1tstJC3t6xC7oAT1eKTb0g19S4gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN-qYxY1MoWXPkL3VY87g0UcB2R64v3DjFp0_H9OyOgQ&oe=6AE49B7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjTZZlTFH4AQ7kNvwFzZdkl&_nc_oc=AdoqQjruD_W5t6CKloJPhN8b46t6J8oNBFA-04fx8N7jMHhWdyA4srmtIBhCERlEVDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpZW4Bi4u0N1ZrPUT-61z9KQj8M9fW4s8-bzH4q9kvfw&oe=6AE4A239"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
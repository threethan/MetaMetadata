25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zf5Se3tfTD4Q7kNvwHIsI6o&_nc_oc=AdrXGwFb_QJna1m1sQSqQkDEIEBWolfglcDojWbyTscnnxp492deyipwqFqm3AmjCsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT075RjY_W4TKLJbRvwZ02PSYf4bSXvKHFB3BXGf08s1g&oe=6AEF6379"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2awgfaQG5VQQ7kNvwEdsxxR&_nc_oc=AdpDPYKSHZ8B9JTivYr3sqUsnIDnzJ_ehmiOx0uJHKF9q1KIAGJn2Jp9RciN-H7uKKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqbKGJ9XCF9vM6vnyoZK_osEhBZz0AHQuF6qWjOWV8rw&oe=6AEF543D"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-JifUkCmtwQ7kNvwHaRRRY&_nc_oc=Adr6ep7i70_NZtctIrINUUdPzVP2qm4paEUKd1A52dcUeapwPU0x5Uo0gxuF4mVXlzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtbd432kKPXB6S68o6pAFkvBen0WaNAnRVMlsroVaOBA&oe=6AEF31CE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj5s2YX8UDQQ7kNvwFsbTGO&_nc_oc=AdpHGtwrLo_h67pGZWS4X54uGXgHY-eF7ZLdgp1Fg-PxvBEwmTSXKgL7NKqNqeg7knw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVkfQOC-sMtdTP7YkKbiYvjfJ0Cghtc9GbSSrAYA615w&oe=6AEF5FBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDUK0z-OMxIQ7kNvwG-LlQ1&_nc_oc=Adqfv6mkX6gV3qrATPoetBu_VW3JjLa3tw4tIrsVisARRTaBCgXTkIOezMyYIAOyvkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_vG7J7QoL5UFGa-aNSo8MIBxuvVkR1EhdGWFY2Y8xRw&oe=6AEF6679"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSDkpEGkleIQ7kNvwFGqsKb&_nc_oc=Adqp7j3DS2y9CYth1Um7L7yg72CcB_BYySItYoufmVSYsDa5wNpWUOJhM3snxj6NCh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbameoYfyXTNvyBuOk0fc8_vvHYLCQoL-qnOqp5a1xFQ&oe=6AF357F9"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUd6qzGZMeEQ7kNvwGJ2HKj&_nc_oc=AdqWJ1D-kYEawuPLtTXvYWWrvrm-CD9gjO2SFLDGWC754OPPYG2mbjAaQ6brDWsDqQM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8xY3kzjsRcyWjJt7c-uSWy8WtoeB_XioldPlKhC_zdg&oe=6AF348BD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PedEDOnaXjoQ7kNvwFNs8wA&_nc_oc=AdqO95LKVMsF06M9iBKYYH_55ueq4Ek02W84msRV7gsD8g_0xHw9YExUSwnrT1rdO5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE8oz0WZqroA9unbuJQKwwcph-damMAPy31npQRoyAwQ&oe=6AF3264E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0q-laLXZ4IQ7kNvwEF22ZY&_nc_oc=AdpID0ecZ9mdDvKwjsp8OR90_SNZplcDr52n9KhsZcLmRGMyEQU-IjToguQZkqTisCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEDl42uz54uACXVd8LodxS5SqU6jmhW-9F9q4fmn5BLg&oe=6AF3543F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAprwu_nsdkQ7kNvwH1TeCO&_nc_oc=Adr8x10yJ1YaGjK16TI6N6-AD758QQD2q6Je1lD9nErJ_WNvDvX4R805SpApNFf9taA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToOAUXjPj41LTLzYze0QvEV9YBn9vBdHfjJAQh_ZtMoQ&oe=6AF35AF9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
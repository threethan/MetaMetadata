25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2AQKnfwRJQQ7kNvwGflFx8&_nc_oc=AdrOc4w6xuvP1J52O0syop-NmcsLjhmDHNxxBVF5xtE-Pp1fLWhNdwGC24Bw2uviDj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKx2Aez0Fi08pgtgHd3R4hq6XUk9Ag1tsxVY5P9wURgA&oe=6ADF5939"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waun2ehlo8kQ7kNvwGIQLR0&_nc_oc=AdpiU49i6f2UWm-VYnS2HNyu8NkOD9wpYvA9B_YoKi7krQTuAvrIfe-xcxKORasxzd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGISVcGU5RBzvyPNxX8f_UNYtXKj55B7JIwRYJ4-aC2g&oe=6ADF49FD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG7Ru0Vr4M0Q7kNvwHYBaKH&_nc_oc=AdqYvQ_62a42K9XcWWZjBDTEsE0jKZDxfaK4vu9lLbXw6IR4PbAM1IoOeeZaONLEsG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPejl3AShCaXYO8RB5cMPjCHRnZQsvDhNeOd6LZvtSCuA&oe=6ADF5FCE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VWXhHYhBG4Q7kNvwGv3-c2&_nc_oc=AdoZ0zQkQ3Q-nKK_Xeb6U_wB3pGGAUlaimoMpXh5WCj7Py1ZYpge7sc9N9ZEUHo27JQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-_MXY83d4Lcf1acBBVGE8Xu7aYBWrFDbcHmZs2MFEyg&oe=6ADF557F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGfqIkoBKbgQ7kNvwFM_yvF&_nc_oc=AdqlbhnSIylYBsLw5GUkWuKvz3JyjiGI9N2R4I12xkUvxIT6bDDumYEa7gSNeQ2vPQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9Ieqo1zFepncFTew-B24nzJ3ml2SMl-ZwFlXgIU8emA&oe=6ADF5C39"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
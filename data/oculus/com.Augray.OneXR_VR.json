25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOGQSbLcrbgQ7kNvwGPyuoj&_nc_oc=AdrGDf45vuA98mqrFG8lKdddv-SdkdcgRBZuoPACxIkmkrMNTnjXxzvGyBnJ0XnPlmI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOM6_32dUv1OErcY6uoCUWyjhr7SzDP3J0BduB6Cztug&oe=6AF74C79"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGlUy6KgESoQ7kNvwFAse8H&_nc_oc=Adr3hpljRg4aBOCZunJ66Sk9IDnIYYTb7hTdN1X6NUA-CHaz54uS_VIpX-6YsarQPr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSW0Zzd28M6jaW9fba-sHHZHX1hDucSZdQ-BdFYdzYrw&oe=6AF73D3D"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oa1c0C4mNIQ7kNvwFdWNxB&_nc_oc=Adr4DLkmifnL3xQwcxYL4epUkR6Xz0YHE6JzXhQV3i-nde4MfTXWFPaDNMttr8svr2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwzvwCx3Gz5USbCzTyUDjReixouGRtz90jiT_zT06EAg&oe=6AF71ACE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFN9qlfE0OcQ7kNvwGdukjO&_nc_oc=Adq53wQuUjBmEY72cVPngAOTrs39ZnDDGgmcwrCUW6iKONr2Uxtr2AJayYCWnlZMA_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyOqh8lBt6ShQ6QMG96B_6qqKFlgD_tPwnvA9pz8O4_A&oe=6AF748BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UpDzEdGKPUQ7kNvwFlFsH2&_nc_oc=AdpqDlEPTfdSaB5XdUWqmuaEUp5yqAZLqCCfK5XSP62WbLe7XnQkwzsGNyPCyBESU3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmAR-h4NnHG2Qj6bla8NEOAR_Xz5ifitJhVsVbtLmi1Q&oe=6AF71739"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUAErtCq25wQ7kNvwESYBwz&_nc_oc=Adock0NfCUhN8lqENp7-eZGcxMEDwOQbKh8CPFoiEzCwtuBPBIUzqPZhtz-mALUHfow&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVmAGdQceb0anAIGJ819PTiXBIkpi1QGC9mpX7Hw3TyQ&oe=6AF9B739"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXPqgK9PTuoQ7kNvwF-aY9G&_nc_oc=AdqSe_pJ7kOJFQ0zQ8rXBr9-eNEn3_iUjmIC2hS_U8Pt4EmrO_ZKFzLvkFavEnZ_62w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9m8jfeez8cCPmrXNCZNUyFjP_RCSnas27NZbI9EQMtw&oe=6AF9E03D"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oa1c0C4mNIQ7kNvwEHDFCH&_nc_oc=Adq2e-UWrcnFQjrK-l6OGEMOuNf86iqvKQZgfKx3QA0qjVCNx1nPFmNmDx-wCz6nJx0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXJS_gW-hHnZZbD2gAm1G89_yfTxVqVfOTtGni1gwEhg&oe=6AF9BDCE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFN9qlfE0OcQ7kNvwEGEjJ_&_nc_oc=AdqBV5vSyY0lho_fZIo-5b9lG7CmolacU0KxR_l8ObRc1DBO09xTSJIXCRfWlgx9S_E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRZoLXZXpEHipcsTUFFnduJRpkUEk_EJZHNDgC06A1ZA&oe=6AF9EBBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UpDzEdGKPUQ7kNvwHX1RiS&_nc_oc=AdoARamFnh04SK8HAnyVyc7AU4GKbWFraw9h--P0RX0-ZYItIfvzf5ZUuu0fDEhRbe8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9UyxPrQG9vY0YJs3tcUD0rlUKmjgYvbl1WJ4M2QRnKg&oe=6AF9BA39"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
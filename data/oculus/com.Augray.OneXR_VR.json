25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zf5Se3tfTD4Q7kNvwG8MWpf&_nc_oc=AdoSfyZVqCqylMs7GQS6wj0gq6aHKG-ai4WXXVNNGC0ySCnXA8tARKoGFiw7m3LsL9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjpPmrZr8koLggzJiJup0x6s7Ku1Nz13_bWYIKnMEe_Q&oe=6AF0B4F9"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2awgfaQG5VQQ7kNvwH_ogf4&_nc_oc=AdqW2o-PjCNEV9F4L1VIpUC8OwihG4GjGEZubWSui6BIjNygulQ3kiuUqh5MqEOr4Zg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgHDafCmnZ6e93LH2MXTR6vEAH2cOtcQhWS4JXxuPVQw&oe=6AF0A5BD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-JifUkCmtwQ7kNvwEMn7R9&_nc_oc=Adq8JaE1bTjJpDHERloIwJNzLNaPwrS61YEW3pNZtefyvNhttV48QyU-sKyuagi_BVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2lnVZFhQnYsR4brTNHfc7IJtFAkeVV59LKJjmDmrr0Q&oe=6AF0834E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj5s2YX8UDQQ7kNvwEw8G0r&_nc_oc=AdraMTbjL5Ikz-Q4sx8XscRu5tNrbEUt3YKUySOtFLIzeA5qUOynvJcLIpomYDLe2Kg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlqy3NGe9rpU3f7f1wwU3hwmsxIXO__LgMfDNns1jphA&oe=6AF0B13F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDUK0z-OMxIQ7kNvwGR_wkz&_nc_oc=Ado_6SFixhGeXE6BpGY6SwxuJ31yMcJh7d_KVZSHkK7bEm6g6Vhv07lKG8qzlom9HDA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKVto9pI7IWzpqzUsrbQEGIb9z1pPVdYtEsdxQlAB42g&oe=6AF07FB9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO0ut1WckC8Q7kNvwETI_6e&_nc_oc=AdpAan0zlnKmgIf6sWpoxoPSeSIpB3QJx5NgDw6Ks9BQeu1qnkOYlOri2pNUEJhIb1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1A6JagrLH_v9FyXBsSmAtayh5Q1XM9ginZijPLztTuw&oe=6AD22A39"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OJ29GUQBGQQ7kNvwEQGbtH&_nc_oc=AdqIi890O7Vcg_9pKRQyFF8Jx19ackut3fUVyPw4OHC1meHD2pjaZ5cBSKLyhjnzuL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYU-fezC4HWas2AUbd-FSFdPzyN5c8xxudsON8oQ-5fQ&oe=6AD2533D"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=an8D55qIDeEQ7kNvwEiMCmD&_nc_oc=Adqw7YoxTPyKDyffV2pIFXAevzG0Um14hvtZBMjazGVySpBU3yg_7sd9uZ1w4MnYz1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM61oK__CHMtk3eDanZUBDXZKhsJjLPQ7w3TIS4grx0ww&oe=6AD230CE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lATVdKy2F48Q7kNvwGyuWvx&_nc_oc=AdoG332KiNckpYqLSAZYIvPwgVL2L8E08l0FrZDsAlYD6Dvk9NvS7aPMNzMrefRWlsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBf0cgVe4onMOG7xSe0kAXQgsPlVhTjQuKGSMpTyx3pA&oe=6AD2267F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mlYU9MwdjwQ7kNvwEwHXs6&_nc_oc=AdrQMWNnUH8r76sUS4yADCZ0yyGz62KkgpCkmEuLhsLKzU6w-pp8IrCOrPsbV_zbC0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyLQ-MzZQBp2xata8K6zKud80ygvHf8qHVNtdI5p4X5w&oe=6AD22D39"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSDkpEGkleIQ7kNvwHw6oNY&_nc_oc=AdqJDLHv1PWVihSRibOaT4HsTsfmdV2BeiOmKK_FjlNINBZ4s13cGVglsWxGCzah_Bg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJb0Krbhy0y_bQ6VZZ4bAJiV_mBJHnH_S_MLS7jeQERQ&oe=6AF47139"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUd6qzGZMeEQ7kNvwEx2-Ev&_nc_oc=AdpnNbtyUuLq0a965TIE2YW1jRfvg0zYa5e1Onsb_T8Zk1uVo3gdo78oRHkigQQ_gUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6CRXhs-xyGdeAb0sLSrAbuXgzm-xXAnuOvOTDke3vBw&oe=6AF49A3D"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PedEDOnaXjoQ7kNvwGTotyk&_nc_oc=AdppJgVF96XCBmJ8F3ciQf6kR7cv_dSEt2LPMalx5RwWV7ebQyd_Ds1Y7Pu-fwhvGW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXmYUjfZaLBPdrCniLwdCyTAaJPq2CRxet5-7DJR7EVg&oe=6AF477CE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0q-laLXZ4IQ7kNvwGaSQb_&_nc_oc=Ado_W64gMKmpD18Q32UNE2zCS2uOSxc0VJ4bcrn3L9e2td5GQUQSr2kERtAhnV8lQZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCKgXsho_ClDBuHTnJegc7DtUw37ciDzmsJWdUiKG5nA&oe=6AF4A5BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAprwu_nsdkQ7kNvwFkhTvd&_nc_oc=Ado6WYg6NsvSSqwiSINcAh1i4MvtayBGejkO_X8erX1q1PCci4yzOIKvgvnoyNuFeuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKDBm3TJeDZwyQEx_XQgwXZ22FBKm9qwZpoOXUK91eqA&oe=6AF47439"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
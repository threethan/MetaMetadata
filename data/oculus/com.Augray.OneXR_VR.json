25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEfnCaNotb8Q7kNvwHqCykQ&_nc_oc=AdqBTwQ0DaguzseGhoQskjJuYyj24B_fAff3aVsw-BClRXNjWGBHB3dKTE5JPxqqG-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsppz8ys-77TWMVZN9y0YRHcU3jfD9pzKlc5TzEaO4oA&oe=6AE1FC39"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVUl-aRVFtYQ7kNvwEei7W9&_nc_oc=AdqM54CPlgvytVbI-lePnOhYIQ1UfBUzoW1u8uukyuwEh7DoIFQznTCp9SS-LPDc9g0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpa-lxFaatwPoKrqNDAsuBgYwEDO8iof3WZWKAeSCjCw&oe=6AE1ECFD"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG7Ru0Vr4M0Q7kNvwGkgNiv&_nc_oc=Adr0xp6hxawgOWVQxaNcxXn-7s_7nBGbw798rAf-dcD8pSjpu8Nb1qlpGxlMV-TGwVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfCEnVwQAzsCuxtQ8IFIFu7-m6mRkcTedviqfDZ1NU3w&oe=6AE202CE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3j9Pda01EAQ7kNvwEzMrLU&_nc_oc=AdotmmUOP12WhW0_4mYrdEsqRelxw4KmQ3xWI0ER1ytOFvDpUxGC77mpXPOf_I-mafM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRg94HyxtAic-pxdjaohD0G4l1EdFwqjQiUWKzh2u5TQ&oe=6AE1F87F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGfqIkoBKbgQ7kNvwGj5jB5&_nc_oc=AdqSuBwmlJEmjpAL1EqajpXGZfHt5Ox0kLzyRH91y4YVFjmgOcwQLA7LvWJZtD7DPck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM21vTUqlY9op1RDFn02gcLpeHP4tkZMAgp_5vaCsu0oA&oe=6AE1FF39"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2AQKnfwRJQQ7kNvwHmjgQp&_nc_oc=Adr8H-3Vm3w_xafymBSjzUEw0X1xGt0yYQCM6cAaETmoeVidJ-etOmHvfS15HlOBhyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqL0Arg5oa49SOmZR92Hy2Bsp7nDwUgF0p6iGTgplqag&oe=6ADE07B9"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waun2ehlo8kQ7kNvwF4ba5w&_nc_oc=AdrREAlomh2VsqHT-7mSlAcuMCuNWYPADjOaHBl1ROA9c5pfAAfySqhlLtgnGMpLvwc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqa-eV-EXtKfyyc6917hr0bN30nxKMw-odyXz7d_ds_Q&oe=6ADDF87D"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqJRWWleMFIQ7kNvwF2yBUk&_nc_oc=AdqfOQD6dIZEJtgsTsVjAnKf-qMyP48d5pqb_wPlEwBvyaOKaDOOwbbVuqLP5sA2AZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVjii6DJMQqPkN-fLN9PAgsg2wd0fzwFc7xqmIfv7Ebg&oe=6ADE0E4E"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VWXhHYhBG4Q7kNvwHZ7oyu&_nc_oc=AdrbHk4K6vSjWVL5fXoaqg_fZSOYsySTAS2I7iAXXXSgKmgMcZ3WZZOW_vgURr8cmww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1ZTneAUmGNAIpAB79HYsStahWc5d7x5K_qSV8P3XtfQ&oe=6ADE03FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gH60BaiFCcQ7kNvwHUEecT&_nc_oc=AdryGg4L2U4Hv3vm5_lxtLrIfqyahJmXfV5lFh-aaCGm9XBbaSShdS506Ejr__Roh8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAIH8PPQIRo5LTXdD7YQJm4WpC6OB_I1-HAP2Stw_fXQ&oe=6ADE0AB9"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
25/39031613_3238561673056633_5802899788671604440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxA5JPwiGn0Q7kNvwE9tY1H&_nc_oc=AdoyKH0sCHbXrKpyJAqqJhPcR6U-eisH_ci2MPzi9v8ih9OUqjF0mX5ITVKfDjEpT_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy-9cKTYUPaA7de8xd8OEmqrMagUZdH5I6cxQ-Xieuzw&oe=6ACF8739"}, {"file_name": "003.png", "id": "514243190284457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974817_514243193617790_1470558102250277932_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wDsPpaTOewQ7kNvwHT8X-m&_nc_oc=Adq0M_DJgk2xLM_vLL3RBRmBjnw9mAlnFXJH0AOQDN-W9iXxUvMJhV80Fv14IigVi0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqcpiQAhw7CgSciKjMixJ3WXPW6v_cGnbsYIuJ8obsTQ&oe=6ACFB03D"}, {"file_name": "002.png", "id": "546068903409635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/227894858_546068906742968_6026268973108230598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=an8D55qIDeEQ7kNvwGRFF_Z&_nc_oc=Adq4yCZw8HKjUl4gtwkFPWZFFsWVyn3db1tUINqguDvR0j-kZGulDGh-YYeXe_3w3LU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuGZ9_V_ZGZv6yJBN6-m_oHh143CoJhcxYRZ-CoxOFyQ&oe=6ACF8DCE"}, {"file_name": "004.png", "id": "645222903228387", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_645222906561720_795668184174669480_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lATVdKy2F48Q7kNvwF0Whvd&_nc_oc=AdoIbGHKi2MCs2N16-U4t8X7GdAW4dxm_42WFU-Vvsbbw3GG1cWt_o1DyZw94DxdKUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp22AD6JoJnOgUk1eHSg64rH76ZO-GAVfDGobLSEwGvQ&oe=6ACF837F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6_b_Cover_Image.png", "id": "312168831019492", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982568_312168834352825_6277306082782742390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mlYU9MwdjwQ7kNvwEU8XJH&_nc_oc=AdoOjKkh7n7XUgB9w1sVTphrI_kQ45dQk8FUNH494TGiVXS_sqbqeIXn07nEnI1DZFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBLcG4ZpjY34vUJ4Fg0xwEdXE1Wq-M83O96oZxj19Whw&oe=6ACF8A39"}, "display_name": "OneXR VR", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nOneXR - VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Oculus VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nOneXR VR app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the OneXR VR App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16ckK16yi2MAV_WXHjqlY2TthQnm9spIUs9UTQdj80zI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
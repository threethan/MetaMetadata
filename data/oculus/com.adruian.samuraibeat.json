&_nc_ohc=XorFZOZPe-sQ7kNvwF-_9jF&_nc_oc=Adlo-L5Z94AZSh0JHg8acqySv-zYG44b5ueQff89X5mR0lmOuf8xr7ADE1CJZ-Ex428&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftQBIdgTvq4hKDyhIF1iclAIi4FKLrswVWKsH_7TiswjA&oe=699C4F04"}, {"file_name": "ScreenShot1-00001-00001-00001.png", "id": "1727235967721295", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003225_1727235971054628_4166078730741304269_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF-NKB0RaTkQ7kNvwG5NMIj&_nc_oc=Adn0PEpm-LDfli9lNPSW8rwCMmcL0qjEF2RLRQlugVvmi_eJlo3br_3_9HIPioEs7hk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv0x31Kg_4b5mCNq0DuGqWfbEKUg5CHDqT0b-ROeDY7ig&oe=699C51DC"}, {"file_name": "ScreenShot1-00001-00001-00001-00001.png", "id": "688651613027035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568679_688651616360368_5282574286227163013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yz1IZVptRDUQ7kNvwG4s0PY&_nc_oc=AdkE0AJZKCw-OdYBGb6AzCoy0NBMRvUCv4nFQND3XKdWyXFC6ScjdGu2dC0ck4u5cW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv5KPwI4y9OH6hc5oFDHrcDPViNuobjtOudlfvn3A6miQ&oe=699C307E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Samurai-beat-2560x1440.png", "id": "1017727499238624", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974518_1017727502571957_6682344747682186393_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7mhS9iQDawQ7kNvwFgqt6q&_nc_oc=AdkUbgvmtx5wZ5xHdlJ9AVBfq2ZajYNQc3akp1ljkDzvxCazpvlLvtOGoBdNE3V2_Dg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftth2Qx3xjuvxLu_emPfHi5rUaqYujWPUyu5c0byzAuRw&oe=699C48E0"}, "display_name": "Samurai Beat", "keywords": [], "long_description": "WANING: This app is in Early Access. It lacks songs and difficulties that will be added in the following weeks. Also, every level may be change or redo in the future.\n\nEmbark on an experience where ancient samurai traditions meet the pulsating beats of modern music. Samurai Beats is a virtual reality rhythm game that puts you in the shoes of a samurai, testing your skills, reflexes, and sense of rhythm like never before. Are you ready to step into a world where harmony and precision are the keys to victory?\n\nThe game mechanics are designed to keep you fully immersed and engaged. As the rhythmic patterns flow through your ears, it's up to you to synchronize your movements and swiftly slice through the bamboo, matching the beats and maintaining an unbroken flow. The seamless integration of virtual reality allows you to physically wield your katana, making each slice feel exhilarating real.\n\nBut the path to becoming a true samurai is not without its perils. Beware of the arrows that rain down upon you, as a single mistake can prove fatal. Dodge, sidestep, and maneuver your way through the storm of projectiles while never losing your rhythm. Let the music guide your every move and lead you to victory.", "short_description": "Slice bamboo to the rhythm while dodging arrows to maintain your flow and pace. Will you conquer the beat and become a true samurai master? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://adrianbotana.github.io/samurai-beat-privacy/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Adrian Botana Perez", "support_website_url": null, "website_url": "https://samuraibeatvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
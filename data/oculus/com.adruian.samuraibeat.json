RFKJHQmL_Ig&oe=69D64C64"}, {"file_name": "ScreenShot1-00001-00001.png", "id": "629424435750687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_629424439084020_2253705338990676185_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2y-_JTi2bcQ7kNvwHy_gj6&_nc_oc=AdpwkSU62RDg2WL8r2z2GTIvYmJsQJSu6z8R9ySd_3DIRCzxCqkMl_A3H-SrR45PynE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B8OsSEolQlyjhf2-DvYMUtyluMJ5-4eEUsXlpkLfv0w&oe=69D65104"}, {"file_name": "ScreenShot1-00001-00001-00001.png", "id": "1727235967721295", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003225_1727235971054628_4166078730741304269_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkhXDeG9MNIQ7kNvwExzJBX&_nc_oc=AdpGxpmQ2C16H7Aqemf6OXHxbRTtCC8Q2Ba5tdPs2xJfTJkOy8GDpyUe0N68u-q1LJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tUMHqaAxjRqMvLUkzgBf5Oa_MvG7g-dIW6S7xUvwvoQ&oe=69D653DC"}, {"file_name": "ScreenShot1-00001-00001-00001-00001.png", "id": "688651613027035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568679_688651616360368_5282574286227163013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PODDRMQNFUoQ7kNvwFGx7CR&_nc_oc=AdoFsJzrNWhOe_voCRZWD2LSFikcm_0ykdwxzjQer_qCuBUITvYxr7LoiG_2OmyhggE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CWag0kyPKjUPz3HXWWDhd9IofnwFC-Xizk3UzGXsIdQ&oe=69D6327E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Samurai-beat-2560x1440.png", "id": "1017727499238624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974518_1017727502571957_6682344747682186393_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScqkP3y_Hi8Q7kNvwG5wvVr&_nc_oc=AdoAj5Dv2p2kwuUJEjdh_aZ1SjR437HIIW47mQBjAqZXDFszt0uWkNHvg71SvVuQtC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bG1YmKKU6nYCQ2vNBxAO4BtyfDNqPjZGyEgSzugnOZQ&oe=69D64AE0"}, "display_name": "Samurai Beat", "keywords": [], "long_description": "WANING: This app is in Early Access. It lacks songs and difficulties that will be added in the following weeks. Also, every level may be change or redo in the future.\n\nEmbark on an experience where ancient samurai traditions meet the pulsating beats of modern music. Samurai Beats is a virtual reality rhythm game that puts you in the shoes of a samurai, testing your skills, reflexes, and sense of rhythm like never before. Are you ready to step into a world where harmony and precision are the keys to victory?\n\nThe game mechanics are designed to keep you fully immersed and engaged. As the rhythmic patterns flow through your ears, it's up to you to synchronize your movements and swiftly slice through the bamboo, matching the beats and maintaining an unbroken flow. The seamless integration of virtual reality allows you to physically wield your katana, making each slice feel exhilarating real.\n\nBut the path to becoming a true samurai is not without its perils. Beware of the arrows that rain down upon you, as a single mistake can prove fatal. Dodge, sidestep, and maneuver your way through the storm of projectiles while never losing your rhythm. Let the music guide your every move and lead you to victory.", "short_description": "Slice bamboo to the rhythm while dodging arrows to maintain your flow and pace. Will you conquer the beat and become a true samurai master? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://adrianbotana.github.io/samurai-beat-privacy/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Adrian Botana Perez", "support_website_url": null, "website_url": "https://samuraibeatvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT
mXI&_nc_oc=AdrQii1zTMOFLbLm9uypwEfP2SriM8rR8__gTdLTSdKXGf9N3dPvNZuqEJsY2g2gjvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPXUOTlXtNU7nAR_xoO7hXSdMDJMN58wlX5H8FPfYWqg&oe=6AB7D2B3"}, "display_name": "Alien TSA", "keywords": [], "long_description": "You are a lowly TSA officer on your first day in an alien airline. A new law just went into effect that allows anyone to fly if they can make it to a seat. YOU are the only thing between the airline and complete bankruptcy! Use your stun gun and computer terminal to identify the paying passengers and TASER the rest! You're also free to answer your cellphone, although you probably shouldn't. Try not to get fired or your parents will die of heartbreak. ", "short_description": "Blast Colorful Aliens to save an Intergalactic Airline"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.worldwidechaosinc.com/PrivacyStatement.html", "developer_terms_of_service_url": null, "publisher_name": "SideQuest", "support_website_url": "https://sidequestvr.com/app/610/alien-tsa", "website_url": "https://sidequestvr.com/app/610/alien-tsa", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1062875347619015"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003269_1727621524065220_5493845982790730498_n.png?stp=ds
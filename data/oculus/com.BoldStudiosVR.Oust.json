lPvnbc-nNcQ7kNvwHE6wIw&_nc_oc=AdrDSAkMeduoG4e9g8oqGQZpDlO9BckegOk3iirLMrNQoJ1CL8El6cfi0qY2zFcq6R4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0G7-0rz34K6a8DEFSA9GLPdiH1YlGPc7iTFsgZ7Z3yag&oe=69F09D64"}, {"file_name": "NewOustSS3Resized.png", "id": "1249430366700875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499347616_1249430370034208_6855215765421517658_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuxIXjUlg4oQ7kNvwF1vPH5&_nc_oc=AdqSSRE9DtEa4KzmGoiDzbmE6tPLjIyhh9oygRnecirj97hxghy6J7FIK3Cqbd6LS70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af09wkxYiUjJ3CJNQNb0xxQV7oI8YFP4iQlN_Lxqu2ksRA&oe=69F0CF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file.png", "id": "1363711768166753", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499329478_1363711771500086_6693313216330973020_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4sU3rTF-P0Q7kNvwGpxMdE&_nc_oc=Ado28SGSDZLdx06Ts7h0twslPQS4dgrs11atF12oPcwMzq5jUixLwFDAyt3Mz4Tqzjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3VJRxVa60uGTiNuF2oEFe2awKUTDc-E9spGcoC4TkLrw&oe=69F0BC5C"}, "display_name": "Oust", "keywords": ["Dungeon", "Sword", "Action", "Adventure", "Medieval"], "long_description": "UPDATE 0.2.0 - Fight Grukthar the troll and steal the mysterious relic that lies behind the guarded doors...\n\nAs you begin your journey, you will find yourself transported to a dungeon of stone corridors, caves of no end, and shadows that seem to whisper. Equipped with your choice of weaponry, you embark on a perilous quest to uncover the dungeon's secrets and confront its dark inhabitants - but most importantly, escape.\n\nMore than just a VR game \u2013 an epic, action-packed journey that throws you into the heart of thrilling medieval combat and adventure.\n\nDEVELOPER NOTE:\nThis game is still in the early stages of development, with many more updates to come. If there are any bugs, issues, or general areas of improvement, please feel free to contact me on my website. Your feedback will shape the future of Oust and help me push my dream game in the direction it is meant to go. Thank you for your support of my game, and if you have not yet purchased Oust it would be greatly appreciated!", "short_description": "UPDATE 0.2.0 - FIRST BIG STEPS\n\nA heart-pounding adventure set in the depths of a mysterious world - only the bravest and most cunning can escape the dungeon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boldstudiosvr.wixsite.com/oust/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoldStudiosVR", "support_website_url": null, "website_url": "https://boldstudiosvr.wixsite.com/oust", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24271723305818861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982470_3754621304827425_7346867070462862406_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umh4G_sw3r8Q7kNvwHTkFF-&_nc_oc=Adqr24MGk3IxU6uQ4awngSS5Icf3NJGlrfWm34GNxe5VQ_VVvfYIHP8aKkhMOPTWk1U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2-_Jl-JenXJe78dm-hyQT3TVs-vQWv_d7s4slp8WQJ8w&oe=69F0B770"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Oust", "platform": "ANDROID_6DOF", "context_ca
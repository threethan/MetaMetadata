ent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKjzaVFHa5Bmq_b_6yDpml3_JaqP523Y9ZE0l-Q0eXWw&oe=6AA942AD"}, {"file_name": "OustSS8Resized.png", "id": "1176967686768497", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974457_1176967693435163_254779059912352317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kk9HmBo1tT4Q7kNvwEcQxAa&_nc_oc=Ador8gJZ_HewQm8pdxFDGUXuVWJfSIp4whjaacoeTpwTWzD4KjFLc8X6tyoSJk_jcxs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtJMl3M-1-lusn_UD3oq1fFivvLV8f58R7vDy2E-fFDw&oe=6AA967A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oust", "keywords": ["Dungeon", "Sword", "Action", "Adventure", "Medieval"], "long_description": "As you begin your journey, you will find yourself transported to a dungeon of stone corridors, caves of no end, and shadows that seem to whisper. Equipped with your choice of weaponry, you embark on a perilous quest to uncover the dungeon's secrets and confront its dark inhabitants - but most importantly, escape.\n\nMore than just a VR game \u2013 an epic, action-packed journey that throws you into the heart of thrilling medieval combat and adventure.\n\nDEVELOPER NOTE:\nThis game is still in the early stages of development, with many more updates to come. If there are any bugs, issues, or general areas of improvement, please feel free to contact me on my website. Your feedback will shape the future of Oust and help me push my dream game in the direction it is meant to go. Thank you for your support of my game, and if you have not yet purchased Oust it would be greatly appreciated!", "short_description": "A heart-pounding adventure set in the depths of a mysterious world - only the bravest and most cunning can escape the dungeon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boldstudiosvr.wixsite.com/oust/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoldStudiosVR", "support_website_url": null, "website_url":
67693435163_254779059912352317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE-bp3sRp-sQ7kNvwHO-deR&_nc_oc=Adlnn0SxH1z8Ws-LCHHmQbcRU6F5GmfxbS2_qLp00IyARZ1ZOPKtOs-o4CD6slrMy_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvA3XPw-_SfjdCbYRpW1pNiUdiACXMNYjOzRDdk_SpIiQ&oe=69A96C64"}, {"file_name": "NewOustSS3Resized.png", "id": "1249430366700875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499347616_1249430370034208_6855215765421517658_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-_NbQqk3RoQ7kNvwHrhBbE&_nc_oc=AdkJBiVRA2fnvxH-g-ZbXxZ6St8I3XPL82rdZ23PxbZ8AK7cTyGn7QceWtOGBDc6Io0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvILFE2TWgEguCi-ItkEac3YHD25rkrCn9X_p9AZSPGPw&oe=69A965D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file.png", "id": "1363711768166753", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499329478_1363711771500086_6693313216330973020_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OGqv0Sx3vcQ7kNvwELM9vw&_nc_oc=AdkjSKE0oh1xhYt_-lqk0fPoU7JztoSDv5lTOUOEEyNxt7kOCuV758gX9fmpLUlItM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfspGnRmQhuTY1SrtZUWpnAvf-mS5-0o5tiBB0FxWEDbwg&oe=69A98B5C"}, "display_name": "Oust", "keywords": ["Dungeon", "Sword", "Action", "Adventure", "Medieval"], "long_description": "UPDATE 0.2.0 - Fight Grukthar the troll and steal the mysterious relic that lies behind the guarded doors...\n\nAs you begin your journey, you will find yourself transported to a dungeon of stone corridors, caves of no end, and shadows that seem to whisper. Equipped with your choice of weaponry, you embark on a perilous quest to uncover the dungeon's secrets and confront its dark inhabitants - but most importantly, escape.\n\nMore than just a VR game \u2013 an epic, action-packed journey that throws you into the heart of thrilling medieval combat and adventure.\n\nDEVELOPER NOTE:\nThis game is still in the early stages of development, with many more updates to come. If there are any bugs, issues, or general areas of improvement, please feel free to contact me on my website. Your feedback will shape the future of Oust and help me push my dream game in the direction it is meant to go. Thank you for your support of my game, and if you have not yet purchased Oust it would be greatly appreciated!", "short_description": "UPDATE 0.2.0 - FIRST BIG STEPS\n\nA heart-pounding adventure set in the depths of a mysterious world - only the bravest and most cunning can escape the dungeon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boldstudiosvr.wixsite.com/oust/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoldStudiosVR", "support_website_url": null, "website_url": "https://boldstudiosvr.wixsite.com/oust", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24271723305818861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982470_3754621304827425_7346867070462862406_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp1vOVqtyvoQ7kNvwGFeoli&_nc_oc=Adkm8VdMNROeSfwOH_XTSjXjWR0238HDua6L4xBpBYPY7ZvefhMNAoo_ODtEeFEgeoo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftxWwHU-1qcr4tw8_ikj4TeMYV3BIC83MBWZw7DwhPVEQ&oe=69A98670"}, "is_concept": fa
cdn.com/v/t64.5771-25/38974457_1176967693435163_254779059912352317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3JxGQtnTfoQ7kNvwGNoBXN&_nc_oc=AdqKBsVLUqK7nIY1Br4ORwvuK7IFWCzzcYbysvmyGigkyng_f3u5Ih_QZ_KKE-0NATA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxUZn7KaWHKSewKkQLc3OkTOA4nKJJs2zEFTnnLRZeyQ&oe=6AECA424"}, {"file_name": "NewOustSS3Resized.png", "id": "1249430366700875", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499347616_1249430370034208_6855215765421517658_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJV_SjsXW1sQ7kNvwG5L75H&_nc_oc=Adrat9AUb6rKEg9zTnEeCsqNDuk4kYjvvlUtAE15Hc1A84Wj8ffUCSyLuSip19NI6f0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgmAdxo9xSpJLR9ClYjwJKWJa0Q0VBDfZO9eIrDX8ovw&oe=6AEC9D90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file.png", "id": "1363711768166753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499329478_1363711771500086_6693313216330973020_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEGzn6SUWIUQ7kNvwGITrWV&_nc_oc=AdpwkHDHXkgGQg3oAaSrO3WRTI4eludGIV93DSPV_Bj_wwfof39ZvoVwZ6iy4UHDd0k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRMy6TRrEH1fiXaomjA6V9SbQgDgeNkhBCBFu15-Q4YQ&oe=6AEC8ADC"}, "display_name": "Oust", "keywords": ["Dungeon", "Sword", "Action", "Adventure", "Medieval"], "long_description": "UPDATE 0.2.0 - Fight Grukthar the troll and steal the mysterious relic that lies behind the guarded doors...\n\nAs you begin your journey, you will find yourself transported to a dungeon of stone corridors, caves of no end, and shadows that seem to whisper. Equipped with your choice of weaponry, you embark on a perilous quest to uncover the dungeon's secrets and confront its dark inhabitants - but most importantly, escape.\n\nMore than just a VR game \u2013 an epic, action-packed journey that throws you into the heart of thrilling medieval combat and adventure.\n\nDEVELOPER NOTE:\nThis game is still in the early stages of development, with many more updates to come. If there are any bugs, issues, or general areas of improvement, please feel free to contact me on my website. Your feedback will shape the future of Oust and help me push my dream game in the direction it is meant to go. Thank you for your support of my game, and if you have not yet purchased Oust it would be greatly appreciated!", "short_description": "UPDATE 0.2.0 - FIRST BIG STEPS\n\nA heart-pounding adventure set in the depths of a mysterious world - only the bravest and most cunning can escape the dungeon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boldstudiosvr.wixsite.com/oust/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoldStudiosVR", "support_website_url": null, "website_url": "https://boldstudiosvr.wixsite.com/oust", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24271723305818861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982470_3754621304827425_7346867070462862406_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZMcoanV1gkQ7kNvwFBt7t6&_nc_oc=AdpxMi1sVKkr7vKTGhdAmPdxt5k91sMyyM37lIeROEb_YM7mZBUNofH_nXxjt6SnLJg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjIdWGvzm2CpbGFjrAFHzaBM
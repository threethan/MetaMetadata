hat.\nTry, fail, repeat \u2014 that's the game.\n{715570327942189}\n# Careful or reckless \u2014 your choice.\nThere's no wrong way to conquer the course.\n\n\n{1652090725308581}\n# Each spotlight reveals a new trial.\nHow far can you go before you break?", "short_description": "99 FAILS is a hardcore VR parkour challenge where failure is not the end \u2014 it\u2019s the beginning. Leap across deadly gaps, balance on narrow foothold, and dodge searing lasers as you push your limits in brutally difficult obstacle courses. Each fall brings you closer to mastery. Courage is your only path forward, and failure is just a step on the road to victory. Can you clear all stages before your 99th fall?"}]}, "developer_name": "Bit Bang Studio", "developer_privacy_policy_url": "https://univrs.jp/privacy-policy/", "developer_terms_of_service_url": "https://univrs.jp/terms-of-use/", "publisher_name": "UNIVRS, Inc.", "support_website_url": null, "website_url": "https://univrs.jp/en/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30263770063214335"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "933494816004689"}, {"status": "PUBLISHED", "id": "1808782553337668"}, {"status": "PUBLISHED", "id": "1544690129866545"}, {"status": "PUBLISHED", "id": "1072290408205674"}, {"status": "PUBLISHED", "id": "1425696201909939"}, {"status": "PEND
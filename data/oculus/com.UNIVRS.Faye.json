3153204665303919_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2x7dJR1eiYgQ7kNvwGtfj2D&_nc_oc=AdpCHqmmobeO874ITtDd5_f9hJ_kPHbwgqYHluWX--bTrRTT26a1ZqRNVGgdmoDiTbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWBr9AwzgCqxVrA7jndHsC5Y0VV-dVLg-toyjYPwV5spg&oe=6B10452E"}, "display_name": "99 FAILS", "keywords": ["Parkour", "Action", "Gorilla", "Animal", "Beast"], "long_description": "-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\n\n{725727173370722}\n# Missed the jump? So what.\nTry, fail, repeat \u2014 that's the game.\n{715570327942189}\n# Careful or reckless \u2014 your choice.\nThere's no wrong way to conquer the course.\n\n\n{1652090725308581}\n# Each spotlight reveals a new trial.\nHow far can you go before you break?", "short_description": "99 FAILS is a hardcore VR parkour challenge where failure is not the end \u2014 it\u2019s the beginning. Leap across deadly gaps, balance on narrow foothold, and dodge searing lasers as you push your limits in brutally difficult obstacle courses. Each fall brings you closer to mastery. Courage is your only path forward, and failure is just a step on the road to victory. Can you clear all stages before your 99th fall?"}]}, "developer_name": "Bit Bang Studio", "developer_privacy_policy_url": "https://univrs.jp/privacy-policy/", "developer_terms_of_service_url": "https://univrs.jp/terms-of-use/", "publisher_name": "UNIVRS, Inc.", "support_website_url": null, "website_url": "https://univrs.jp/en/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
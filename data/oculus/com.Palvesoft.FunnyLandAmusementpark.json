rTY4hMd2IdQcqVtW5XNg-KXK7fadaLPMoDY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJobuR1o0UEDg5Nq0sS6arncZzI2XRRvMYFr0hP_wqedQ&oe=6AA021FD"}, {"file_name": "2.png", "id": "564071298460294", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297580_564071301793627_3850473617177132865_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXwjbQ8LLZcQ7kNvwFBP595&_nc_oc=AdoCELzEI_f68pNEPY6cYu5-PTVnvENoFANgX2nGcL8SSF1cBMmEqIaln9lSe7g2saA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIa64tIGfx1nA3gh1g1DRAQ_zgZ98qCo75LVJk1_otzg&oe=6AA00F39"}, {"file_name": "3.png", "id": "1069197383709248", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75307246_1069197387042581_4400974593825124469_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFLTdORZDEgQ7kNvwH9nHQh&_nc_oc=Adq0duBZOCCOSBFWZngUJ3KQ77-KvI_pvdAFS3-k4butylIUaGeJxVtiUX2kQgIMgSk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdRbAOa3lL-HZ-vZgTNC8E1DUTisiymWOY0Y5bjvq3kA&oe=6AA0166F"}, {"file_name": "4.png", "id": "410390784339195", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86610706_410390787672528_7667958606258645385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjFjNrtG9y0Q7kNvwFAopA4&_nc_oc=Adq1lkrfsbhbiy35CuqKmUkgRCmCRvJF7GBDkr3lqo-VUmRfE9qXVHMJwl-ubiQM9uc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlAcxsTWPofSvUnNuTh-uNmj7mBG5gCDXBkITBIOAfWA&oe=6AA00E1F"}, {"file_name": "5.png", "id": "1189249798477774", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031629_1189249805144440_9006964949742231760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bChXAeeauvwQ7kNvwHWi9x2&_nc_oc=AdrRWmgok1o5CPfxH_nf7VOBT0N8gNa9BjKV87ZsnaP24rMAc367kiFpwOThyMiJQJs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrz6fAqB_P4YAQ649uVlXw5OciRzws2wZ6J7gfxH6DPw&oe=6AA0074E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FunnyLand: Amusement park", "keywords": [], "long_description": "Enjoy thrilling attractions such as the Twister, the Haunted House, the Octopus, the Kamikaze, the Viking Ship or the Roller Coaster. There are also less challenging attractions, such as the Ferris Wheel, the Balloon ride, the Free Fall or the bowling alley.\n\nFunnyLand is a magical place where you can feel each and every attraction thanks to the power of virtual reality.\n\nThe attractions available at the moment are as follows\nCondor\nKamikaze\nPirate Ship\nBowling\nFerris wheel\nRoller coaster\nHaunted house\nTop Scan\nFly away\nOctopus\nBooster\nFlying Circus\nFrisbee\nFree fall\nBalloon ride\nSpider hands (Throw spider webs and move around the park as if you were a superhero)\nIron Hands (Put thrusters on your hands and fly like the legendary superhero)\n", "short_description": "Welcome to FunnyLand, the amusement park where you can enjoy a wide variety of rides and attractions . Get ready to vibrate and feel incredible emotions."}, {"images": {"nodes": []}, "id": "552341719942021", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FunnyLand: Amusement park", "keywords": [], "long_description": "Disfruta de emocionantes atracciones como el Twister, la casa encantada, el pulpo, el Kamikaze, el barco vikingo o la monta\u00f1a rusa. Tambi\u00e9n hay atracciones menos desafiantes, como la noria, el paseo en globo, la ca\u00edda libre o la bolera.\n\nFunnyLand es un lugar m\u00e1gico donde podr\u00e1s sentir todas y cada una de las atracciones gracias al poder de la realidad virtual.\n\nLas atracciones disponibles, por el momento, son las siguientes\nC\u00f3ndor\nKamikaze\nBarco pirata\nBolera\nNoria\nMonta\u00f1a rusa\nCasa encantada\nTop Scan\nVolar lejos\nPulpo\nBooster\nCirco volador\nFrisbee\nCa\u00edda libre\nPaseo en globo\nManos de ara\u00f1a (Lanza telas de ara\u00f1a y mu\u00e9vete por el parque como si fueras un superh\u00e9roe)\nManos de hierro (Ponte propulsores en las manos y vuela como el legendario superh\u00e9roe)", "short_description": "Bienvenido a FunnyLand, el parque de atracciones donde podr\u00e1s disfrutar de una gran variedad de atracciones. Prep\u00e1rate para vibrar y sentir emociones incre\u00edbles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.palvesoft.com/aviso-legal", "developer_terms_of_service_url": null, "publisher_name": "PalveSoft S.L.", "support_website_url": "http://www.palvesoft.com/contacto", "website_url": "https://www.palvesoft.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ROLLER_COASTER", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4656912371075682"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1030787666065923"}, {"status": "PUBLISHED", "id": "2419246205164220"}, {"status": "PUBLISHED", "id": "3059157644274338"}, {"status": "PUBLISHED", "id": "863285286573903"}, {"status": "PUBLISHED", "id": "845019255066815"}, {"status": "PUBLISHED", "id": "1564552488068954"}, {"status": "PUBLISHED", "id": "1806373686938184"}, {"status": "PUBLISHED", "id": "1881367855770669"}, {"status": "PUBLISHED", "id": "1285843933148465"}, {"status": "PUBLISHED", "id": "996554235791285"}, {"status": "PUBLISHED", "id": "1118785823592661"}, {"status": "PUBLISHED", "id": "1116118486192865"}, {"status": "PUBLISHED", "id": "596812384970913"}]}, "baseline_offer": {"id": "596812384970913"}, "is
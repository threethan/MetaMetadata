c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu0taprRDSgQ7kNvwHxr9ly&_nc_oc=Adog2QnjlD9NOzzaFpjkYYUIjYzmlZIDHuLkg64QESaVo8uC1PXhcL1enQ2gsCbn3VE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPGC_3JqvPMYVAzAWdLaHylaxLPOtpbTe3nuGj0czUxg&oe=6AEDDDC7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_mJDGb1ZGYQ7kNvwHTVTmp&_nc_oc=AdrmXC_1JkaKIILfh6ozU4YEvt6eS571M6NobQrfBx780ao7IZplQfg4llrQYsK3kV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzhJN9z_Y3psWlqVzc45grBb2ri0K3cR-cGrajlswogw&oe=6AEDFFD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfeyOo3gfEYQ7kNvwHUvROb&_nc_oc=AdpU5LisXfAdeJdUAsbhXCokp6df8uO7ony-mmJ5jLqsJ3JDAWbf5RlumAvz7qncoZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYfUBt8ItcDPgaaKd6a9h7_b6WDdU1eXXWCNeDI3z0Gg&oe=6AEDF6CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I19wUW68S4Q7kNvwHvH0EW&_nc_oc=AdpAkk41rSOVQ32F5wN7wVNhyeiwQLjwgTbN0deh-pDLvt6TUcc8e2-hahFOufDrKg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKM34HmZSln_DeimyQmdu_PPaogNjUOlI3tU6yzlGPMQ&oe=6AEE0035"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1_o_mb9tVMQ7kNvwHUlv69&_nc_oc=AdoTKHeJwzETiyfTRPH0S9skiUWq-dfQttyAodFCsZ1SE2UCNKqQ-YaxuRwMuaXpQVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYe_E63DpMa8FFMcYe5MsK6Wdbyya2Dt66tybvvmfnpg&oe=6AEDF985"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TiOIoGr0PQQ7kNvwHMb1dS&_nc_oc=Adp08YCXhm4-1--U9pnx-t9IReZbPPK_i48GP83NJXvEuQjEbF6WKPpkMZDSx2PlyWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdu_kyjrQ7VYCRp4J0AaYU95IcaZ_1NuREFT73LhyYBw&oe=6AEE0161"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGWCZL1p8nAQ7kNvwGg_-dZ&_nc_oc=AdodTqp59VPZ1a1rPfZOBMK1THuuqBhzE52MfMFB2wqDhX6LwpCw_O6EcJGrgq7dUek&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAH2JvdttVDXUl2qu6xkb2k9PfgGzKdx3GfMnTM_yfBQ&oe=6ADCBA47"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMWg84g4oj4Q7kNvwG2LdEF&_nc_oc=Adrq5J_gdjJAkn0Uy4zZZfWZva2TqbFMEfAhcGwq34ZDQqc-yHWZ6x51AFuRoC0PDNo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKjEPc4cGdhq9XNQJiJSqT9WQiTXwaQybbXhaapbVLog&oe=6ADCA417"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy50tdFmPrwQ7kNvwEh9R5o&_nc_oc=Adq3JP0pYK3XFv76kBWZ7Nm84Hh1HbipnGaeOw_T31713Kvp5X3nANLfPhYVLB_kR2o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaUfB4MDk_o6G-H28R0nKAY7HYOQpqp0s2Uey8oVKSXA&oe=6ADCD34F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhnjpS4VS90Q7kNvwH_LOnw&_nc_oc=Ado2hFHqb8wJJpZDiWMMrL6KnGVysuLRMNghcTs0flUKGEeit1tQ8-TEMezZ8ohBd5A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPul7ToJahdm8NQX9qDN_hPJqpLrLdjqv2nwX-Qi_IjJw&oe=6ADCA475"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YMlKM-sE5QQ7kNvwHR3StC&_nc_oc=AdrlnBZ86dK9MCqov8x8aytZjyfalXqmDb_OOnC3UvgWQuht-FUy3-QsHxNnXjD9DX0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJBNeOR804oEYGGC56QeD6xuB22ZEq6RDMllRxY_vPgA&oe=6ADCD605"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbNFbs1UJRcQ7kNvwGBtsrp&_nc_oc=Adr_pAQUwhaoOUOIesWobL5DfWntmyOUKpQ8nl1N0Uy2rxaZtxKPzlGdUJFeH3piGW0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBc8o-3-zDhYlyfMjiVnIe6qEcdIMCMODsEuv53RPSxQ&oe=6ADCA5A1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
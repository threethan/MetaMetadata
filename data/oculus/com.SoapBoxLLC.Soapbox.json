c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkO4dye3vPIQ7kNvwF4KEeL&_nc_oc=AdrodlfXGWqz9mYOxBNcd-3uGqBh6zG69eRZCStLSAwa_m2ltbBzUlCcZSkFDkcGudM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHC5zU88aDoQKU6uKC85eMu9g5BV9sDX5LmWXX3lYKCQ&oe=6AF47547"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzNo8cq0lAgQ7kNvwGNFK8w&_nc_oc=Adrw3NuxsDGZjkAKDG5JJCxUavehrij05Jbdi1mbDXdmQdZqD4O1KEjwzJGIB-arxfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSybVv9RIHk_xhYATgV53ppPikekctyT13fyeHh0xUBZA&oe=6AF49757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMCYuzwuLIAQ7kNvwEJW55T&_nc_oc=AdqiU7rpIGDQawcCgC-0MNeuoxTO0CqnYJBkDGICpTlHTX3VWoVCQXlxFovYHxEFch4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSATTIlZU52pTr8OWqc_AYS7SCjIwMQXkt1k9LTv-Cjaw&oe=6AF48E4F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBe8XEplcfQQ7kNvwEg4Iix&_nc_oc=AdoZ4yM67Fw2Vo-jBHwd_SL8NNzYnuySZqwHRpNqrute1vZnF7of7hzIY-GFGY63zr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWiTGEHC02dG1f12abMKUdq2FKZhHFzdjLJobcdu5C-A&oe=6AF497B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnQ3-bcFGlcQ7kNvwEQITE7&_nc_oc=AdqJW4C693Y1hmqTNn6Tp41RYfX40h-AQxAZ6eKFPzbk6vnjZ5sQgPGAucwwTCtO2cM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUl1BJ50GRZ9zGGAKYSsthQPNheToz5TZzFY_4tqJT2Q&oe=6AF49105"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEjFO74V54kQ7kNvwEJss8j&_nc_oc=AdrTR8-Y0e0VZdXInNc5epBGepMHhJ7PQ6yqVoIOmftiFdMDb54MaVH3WaCt64-pb84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDr6WnARciFUjeCc4f61Ds6qRHuDXvUY89kgO1LTd9Iw&oe=6AF498E1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
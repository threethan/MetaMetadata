c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyUYhx5pXD8Q7kNvwHAgXMJ&_nc_oc=AdqahPS_vbIb99fwbeX_vNZk8jxXvcA-yDFxvv68c7SKP34w5WqysfCqRSW6h9G1FWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFfepNy8fSPcvyUlNlrwuBMYaEZLwGMU3pbAzRasBR9Q&oe=6AC3ADC7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMGgWI1HDqEQ7kNvwHu9viR&_nc_oc=AdppYnNbxUFHb1k5u6UWa99WyNqEm3aOocJS2X05B1e7P3kDVJf6neVo73EUCz_-uWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOXSyHIYQwTYz_HdQPyl46uPEQZ5NcGrHcronTl3-QZA&oe=6AC3CFD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Coh3cr4eFfgQ7kNvwF2yKjI&_nc_oc=AdoylxtYv0Md0TnT5WhN5C8mBNWQQrh0agLMpQLeoWDCuLhn8IH3tX9yagoKgfSUJ7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhoNiYAlos1moqKX4J0I8q2JQ3rZ6TmH32UxfstUQZiA&oe=6AC3C6CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmx7F66mYaAQ7kNvwFtBL8a&_nc_oc=Adp0p9mEMbJ01kmfZuI2R0a8UJ49Wv-SwRC3DPuPlM5Hc6V4mpcaPrHzDPfKRDcoTH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdIlzdp8HfwFHT_5yXMh7PL7ggCo8sT-Ser1c56kW6ow&oe=6AC3D035"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN2-2rslcM4Q7kNvwGvTJu-&_nc_oc=AdqHJL0ctGMlTj_0p3KwjTypyWriN0tNHPc5a_y5TlQMuO5mVjcPej470plL1Jfg7mU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOasxJ1M8dfuvgsrtgf5HOj6HFBHJlLL0tJae-oI8ZsOQ&oe=6AC3C985"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxipmmjke6kQ7kNvwFgvv_l&_nc_oc=AdqQewYNA9yaUkUYuQwNzFOfHUkXZS8L5atoFB9UlfcfsIA9WIsZ_dQ3FEq_9HxdiaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzSA20-nh2IXLJf4pktEH-rXlhj5ypZpuyRvhQhipdeg&oe=6AC3D161"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
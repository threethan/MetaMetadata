c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B184fYb0Z5EQ7kNvwFtIh1F&_nc_oc=Adquq-q8g_WcNvBftZHtvtVaPReSWPSLgzvZ7KhI5r0EhAUcmF_xZfGeIjarc5UoVJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQztJYb6vPXKVvk1KVljkW_WOjlopypCS3cmJS8CrBYTA&oe=6AEF6787"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpwrKjAbHrAQ7kNvwHNqjqY&_nc_oc=AdpzrEqkyX4qnGryfQlzHlq32Hi5VrLsTnJ3syFI-iE1S_WyvQZ50jELwp1VioZUBGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbDL3YbomviphcyoN_PpHbfFVP-oahA9EMXBw9nfne5A&oe=6AEF5157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfeyOo3gfEYQ7kNvwFSOpw7&_nc_oc=Ado28NyR7eHawkpJffZyCI-RycOk9BXgjHzJyx6J2p-XDxXOHF5jkNKoKDZ5VME3GiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3n9WoJfH7nIqCbZ8H68kAkAlEP5eRZRvNFTShVuMS9g&oe=6AEF484F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I19wUW68S4Q7kNvwFStEyc&_nc_oc=AdrB0A9PNNi5pSyTMVeHYVPDncA-8aZ7qduAokeUcK6Yxp6NE4zPfBifusMzZ7eeqXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAtaEsjIWck82cJfCV-8ZzFcOKXH_8KOrZoFZW3nxCkw&oe=6AEF51B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYKV8bf55DwQ7kNvwGQxaoX&_nc_oc=AdoG4jOd2Cco7xUGRzxLuv6ATU7OVrUAfGh27unl0CwGxwNWo3t2gpPM0JgNEE7RLsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcUxovYQ66XUpi4EFfHtkZInmVfAH8nCTxm0lQXlKgVA&oe=6AEF4B05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TiOIoGr0PQQ7kNvwFFh83p&_nc_oc=AdpnN5WB0_7-9M8x9ktBk4F-LEoB1k8_zwDjAPbr0jFwAxaShSrxiSE2O02y3ncoS1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREFkYFGP1Zo7i550wyj4jARiL1f8Kt8CsVF5SIjz837Q&oe=6AEF52E1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by7tuGSaSUcQ7kNvwFJ6UyY&_nc_oc=AdrLS3W0aTH9agUNxOUtOHJcCzcRhadC7lRYVnh28Gs4STi3mbK3FsyJhckt2u19WUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR41oMCeuYWUBShEt_LEmHI5RU9F2QC1npxM_Pf2os4bA&oe=6AE9E947"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0EcWgzOwRgQ7kNvwGpA_r4&_nc_oc=AdqQv1kneZfCPa2lOSj2MapmlYnsPBP_rzAz8SC-S7KKdXgBhoQozsGLHAr0t_pz0Ac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy3_D7R9VFgqPjw9SGXrY9jks67xelNHo5EeWdILN_qQ&oe=6AEA0B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYoCgk40rZUQ7kNvwEhczO_&_nc_oc=AdoAG5HdrJHYga7nBp6_vohDrxw1RTUJ1Wj5M_Km644Y7olzQcevpHiz2TN1GvfJ89o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStN35Q2b_U6AEzXVjT-kxhpuBZsuK9wypuY0QJ9qLR8g&oe=6AEA024F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz1_pZjo_GcQ7kNvwEwowTm&_nc_oc=AdqY4faFXVPcex_wXzro8boBCfwFJPMPHcSWDM-uAWVjFGgSoNqEJMdY92yjhWvOeWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfGJoKLQnrndPpholENYeyW97SJIa94vKYNDMl1mfN5g&oe=6AEA0BB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30ZM1J9Xik4Q7kNvwERgRbD&_nc_oc=AdpxYigBzE5E_o79P5Hci7egNtq_zcXxO5CkDZSjITUvuXxoIfOX1grY_9ree-MLJtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlH0PVwqIS9p0Kd6BzpwnEcmJ1Y6HFjCVYaEOCWO4cYg&oe=6AEA0505"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okH6zhCDpaEQ7kNvwE9nN7C&_nc_oc=AdraC4PcOBjOH1DX105KeBqWFvcszTzXxYcWDn2C7Zp8ibia1fl11vrbyYQrYONAT6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf2Q3b89ORviQEzIC0I982PlsmNW0YMv3SlcVyMwCD2w&oe=6AEA0CE1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
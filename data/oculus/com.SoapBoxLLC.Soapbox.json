c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkW2ZhTLdokQ7kNvwE5_uYh&_nc_oc=Ado7Cc0q1G9meWfTcgKQvz52EZQKmDD8bhhRGwF2mcD0Z3IIqAUyKbyWXxPmRNMD50M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGoLu_n6_pYtmk_RuI-EdL5Q8PuHlH-6Vq27v_5XlLKg&oe=6AF9BB47"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KISGdZyVqQ0Q7kNvwHzZxBt&_nc_oc=AdqqHfIATvhje5wWUWmWt_MOLwgF0UQPELFARpHr8O9s6jF1Y-eOYX0ELPr7-wOWkNc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Rw1NcyW-3xrr_sSKN_Tc95gl29JXOsBF-z0eHcq80A&oe=6AF9DD57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue3kqc3gvOIQ7kNvwG1mnzi&_nc_oc=AdqyLqJQE1-TULf9zp_ECgp1vfnniqVggv0Nd_2BoONE-dw85JwMSBE-0cL7JFGpOfo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLgS9JjGWsWNrCobWIkgFQ45MLW7KNir5eVg8gVeZe0w&oe=6AF9D44F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zb-QQpd2QIQ7kNvwGOVpyM&_nc_oc=AdoSxcFSYQoaHcmx8lLonzMJCiXY6NqiHF-Ahq0UQhuQqR5Zv3Ld7CwTXj3wraliqMY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE6yD3Ur3DoaxIEceOdkn-p_OvW60XlcJbiti3-tftcQ&oe=6AF9DDB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4tPnNV-t8QQ7kNvwFq_tgw&_nc_oc=AdqgTkA3wckwCtZBwk-e8bdutIcjGyyrLHGU70l6AB-VxpGv4HLSdrE5QXPQoMwr_mU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzJMGj1x5ZX621BhXWdzAPTWpLR0Z8v66yQOxMlI1uuw&oe=6AF9D705"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeSQAn8yiLkQ7kNvwGRFHaa&_nc_oc=AdqRa-61tB80nWkVhL2_yvRaRlJDJKZ8EEFUy7rpe9XHzakloSZSvE4mvoZ-QdeqkVE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ3wbCD9Rb0rGrKCdgz6NeJWdfKQ1Dch7P78BFz3aO1w&oe=6AF9DEE1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
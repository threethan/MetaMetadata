c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Buv-6dOQlGgQ7kNvwF448L_&_nc_oc=Adri76joiGNiN7nYi40MgoODBciBIoCVSdNmYgQkmL9yhpLbGUh6Wu9HjMg97PZCmuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJvBOiQwO_SpJv7um4lv3vH1vJmiTa6ATVJs29OB2vNA&oe=6AB921C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKEwfaiZw0QQ7kNvwHdjdJ5&_nc_oc=AdpXe-d6si3Ka6GvXqAS6CAchFDRYnx5Qz7Nb-LY5ywJd4VPZwvAs5JisxlbkhaeCP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTBUvZ9nUR4GXUBf8P7eSFJenal0oNfRZrzLHfzhTkAg&oe=6AB90B97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIOFxKO3h0YQ7kNvwH8NOsa&_nc_oc=AdpAd2KRhvcdpitZge1F7KuLiZcl_o3EsixNtRBfjjXZ39sFDU9mhLhs_Xzbr6vUOBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5ZdtGRjQ1FAvlGEUWM1RiiYGba7QtOt89Q-_f49boiA&oe=6AB93ACF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_ZZyXzLKeAQ7kNvwH7kVc6&_nc_oc=AdobEBYzSd5oKeHcM4HTp67eC-cB8mxjnjSaPi07coVvqBt_6EMCHigfhZpQL2rhTc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-QfPGMG8SF6SjdQ1MjODe5JlBjxDop2DJa8Ik3wZwZA&oe=6AB90BF5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxp2m9XwAw8Q7kNvwHIxEnB&_nc_oc=AdpYKSxy1St1pTR-EsQBTJuHWzR6DIJ5SOIqp5Z5vnmabjI5hESKxxAzlvWxWHF1JAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq6k7yr6pPFMWvbw8vs368tYG78mm3w6xVRRMi8vn5Zg&oe=6AB93D85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phmU8vjKPHYQ7kNvwGEDzvR&_nc_oc=AdpPuXaI6PYNQo3yfbHS-VgD-hPZqnQCPZyV2UNbxYvbAY1uivKRNtRqITeW0lkUEK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7dSQGgPAZ5xnvf3OdtMU20074-hZrK7J6711MN-rH0w&oe=6AB90D21"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
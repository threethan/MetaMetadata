c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu0taprRDSgQ7kNvwGfToIQ&_nc_oc=AdoPzX7Ajzou0nP7dKuFD0NZ3iilOMVUY2u-1YYLbmxD467UqYVlokK9gzaVLFd6_qs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3AzbUSfHTHZDDE8enhDwPRmZRTmJBIZ33PD1HjlLgiA&oe=6AEB3AC7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_mJDGb1ZGYQ7kNvwESrMYz&_nc_oc=Ado3YEE_ZzTIOCYcnruWuSux3fT06COfl1l79HKG1DylODXO2lVT49Xue5hq-emCWN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdFOdPv_cvegLdpD4Sna_S7DJlZ70sxlGczKSL8_JSxA&oe=6AEB5CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYoCgk40rZUQ7kNvwGMHZgu&_nc_oc=AdqBr9pgOdIBjlMN8M20_VtWTE6sEO-ri-UDpD7rDztr8pavuTWHm_XRFPoRR9lC_wY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXEZtmuImmSGWk695Y0aWfBGCtsrLLcYd7Jo4agzrqEA&oe=6AEB53CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz1_pZjo_GcQ7kNvwHIX4p_&_nc_oc=AdrRjpHd2wiIhn_y3F1jNXzdlzQyrVHBGm41RaY4dcd_HYKr6J122eqy0B3YvXR41KY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3jB_iVECL11MK5EIvhkMsNlFkaL8jD5QHVh0MLx7qrQ&oe=6AEB5D35"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1_o_mb9tVMQ7kNvwHLMdYf&_nc_oc=AdrjBobMpG7oRqZbGgMu67W6OQpfCp9kIKdsJTJ8bye_tN0wfTmK3-hmCwtYbfZMwpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGC1SIyM-sMGjK5P8Eh4tyw8C-c1OpE_8KkD7RwEpHDQ&oe=6AEB5685"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okH6zhCDpaEQ7kNvwGJEKEw&_nc_oc=AdolEfqH2-ZlpPl302DnI3M_1QbEfqHSahaTuRhJ7ANag8HkVy--zN9YEs699dgFUHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEzDhEUrx8kkZk7biiDO__o0_uyObqQC02xHRpxj9Mnw&oe=6AEB5E61"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
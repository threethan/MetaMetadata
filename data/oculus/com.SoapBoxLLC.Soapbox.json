c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0nxX3H_iQsQ7kNvwEaqYrK&_nc_oc=AdqMbzQ135WWUcBaRs-ZR9JbmsgFt2pNh8l-j5307KCnH1eGMchBJHEyWk-hEORVK5s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy3LggKAXDKUr3gaJuFjFdkGlw5012u15MKaNSDl7THQ&oe=6AE351C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0Jz7yodeWgQ7kNvwHRv_wV&_nc_oc=AdoBNLwogJwX8MD3N5fv8-Lx-Nix6AG7xYEjsoW-hWca9z6yTogO8ZVy3JcnXJSYD18&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ3w1HtrCWFMOtSjeqQJFGsSFDXdeQoVsY8j38-twfag&oe=6AE33B97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jy7afjgsDYQ7kNvwEimq1g&_nc_oc=Adrx1HVO9aroTXnbCi5TIbRhYzIPlptXQzCJVyOtMH8iXekHWTvyEFVz7UW1k7kFYCI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWQIYo68hzDmvy3brrQNjyit6LZ2hGOAuXuqRTH3Kv3Q&oe=6AE36ACF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFL-uLZdLecQ7kNvwF_YGwq&_nc_oc=AdrLD8nk91FsgEAzk2EhWohEMlc_e3YuuXfPvKSN7FxIqpebeddWjegTxYY3ccRcsRo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVFftU6onEKhqOAXdEv5J8OiWh1d6WrGrFyoxPR7RN9A&oe=6AE33BF5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFjMda5G5kAQ7kNvwG61gtf&_nc_oc=AdqJn45xpBfPbL65djyc2vl97GOVJ44L067ubUPSTB-ip5lWjWmj0mGfth0wB9riCE8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmgtvbSFrf281mZqXTKAsDeKMKB3K7QWg9D0yoPf8C_Q&oe=6AE36D85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmJ_jACRrxcQ7kNvwHQBXiy&_nc_oc=AdpGHM1A7HzsnHB2kCvxzZj3AVH66iP-tlQRZm1KYvH7Yti52zvwJ9aNT8fz1CgEYOk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl5aBriqGCH98scUDBp3RxpUy2R6NciRlhta_n3Iy59w&oe=6AE33D21"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
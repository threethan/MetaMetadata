c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zEqY1OCqXoQ7kNvwHIYoVa&_nc_oc=AdrDww5JXJyixDqNiiSVS_CIddhaWHLyRCSSlN_Bdyrtrqh_OrjYvkJvJ0Bhj4KIMRs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaDJFBDjemcj8wSP234sxbH9e0HP4cEehQYAAsDEgQ0w&oe=6AB67EC7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7pWeaaniicQ7kNvwFyBoL7&_nc_oc=AdqMj_6F0r6quh_kKekUBne47iCsGT7ZDjb8Ryn_sdlrtbm1m1ebP6ctILfRCs0jfdc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINeUuAKjCGufnhgUYubN9rEkqToqmidfFBVF5tR2XBrQ&oe=6AB66897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRb29kjrKnUQ7kNvwHiuNk6&_nc_oc=AdpLSRPQEcl8udxCEpIM9a5tjmUd4HcBucceB8FEoj2iqvBGN7_LLcDLg7WEoAzXPio&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHzlmF0GD7ze9SroXycZH7ryPFcoVvutl371UD-MPCMA&oe=6AB697CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA80IElG4v0Q7kNvwEiLYB-&_nc_oc=Ado33D2rFXU7F1QXYPmDS_olwb58YLCZTovGg_dfndMncu-OxGUCyfprs7EyOpIYMUQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInHX1T4Dz01NMWAYlvjxVBjAz1ehlrbdhfrfduNk17VA&oe=6AB668F5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIivdiPe98gQ7kNvwF9XBNM&_nc_oc=AdpeRV_rzGIPO8dg43isbuchAMfHu8yxT3OXRMEMAqo6MBrTSuyC8yG3j3Vlx4ooG_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL06E5e_piuKraW-WqQZeDpCK0r5mAAYg3_VOMFhqw4CQ&oe=6AB69A85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuDF4b6uPkAQ7kNvwF5uCxu&_nc_oc=Adr2PbUAGzMhTF1EHhBjxsX0ngfwumt1qQw0MMC9P7ob55LfgwCzrNSy8xn9w3swXWs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRkYI3217viHK_9-4QAAVPo9sOp6LUeFqxOXe5Ki7JVw&oe=6AB66A21"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
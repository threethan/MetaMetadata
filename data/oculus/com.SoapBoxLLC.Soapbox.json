c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Buv-6dOQlGgQ7kNvwH-zjJe&_nc_oc=AdoRPtyWeypspkyxHEipLr6W-gsLDvKGDo269OZx50ou-1NfV0olx3xQV-oazK-MQYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1n7nlrpnvwnNdxuiZGKdiyVtrU7vA8nWejtjOwgspRA&oe=6ABA7347"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKEwfaiZw0QQ7kNvwF69nwc&_nc_oc=AdpxfSc65l5xfH_NsE1-i-NudvdsJSN5FaPk0uRQAjcK9ZXH3wXvrcm_aMzSXilt0rE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID4ICHM4cdkHHl6w4pQ-7edR6YJw26gviA76xIBc_fGg&oe=6ABA5D17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIOFxKO3h0YQ7kNvwGYfNwp&_nc_oc=Adq53LWJAXgxX4F2RHLusl7FxAjBalKj7H7kO2BFqueOZIg7d5NLbWPxm-OnE7apcOo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3_esUwhV7CLxWl487JtZKc6QjaVK6kYxGZJjwmjIziw&oe=6ABA8C4F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_ZZyXzLKeAQ7kNvwG2uOe6&_nc_oc=AdpGRUf8gdkBNlg1aFvQB8Rbuo8b5d7yrdk-ypaF8HmP9nhSmp7LJTFMykPlHXBX_-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIygOG6uggiYLdeEdJZ6fb51FBmX_bAmpD0bh2dsHohVg&oe=6ABA5D75"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxp2m9XwAw8Q7kNvwEkvLsS&_nc_oc=AdrurswERkj6AyhV90Ee_NvOcnwQoXdsiMpY7CJMJ3Gs1pO-CPaBbKArsGty_SqQtc4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1QIbplMslTXcg6fjg1I_cdM10EgsGiiG-kNtWB48pzw&oe=6ABA8F05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phmU8vjKPHYQ7kNvwEdFe7c&_nc_oc=Adp6x_woB-fBDimSaoQXM0Fk7jF5vZ7LSOAZYKMkBoyfYJttLVE6Kf-GbYXwL6JeMks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXQjLY_lNE2dqvq7Px9p1cnb9NQQuQDRCcUI3znkd51A&oe=6ABA5EA1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
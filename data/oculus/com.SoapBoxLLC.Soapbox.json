c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Buv-6dOQlGgQ7kNvwE6PQ-O&_nc_oc=Adr6IMCMHa3OtlXtlnlmgGmBKdHS7AvERpqgUqZChPrrJ5p9BYi4mc93o5NlEZHnUf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh_GkDex-yBtKinDbLKr3XVCeQ16E56eLMLPGV0oAk0Q&oe=6AB7D047"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7pWeaaniicQ7kNvwGiooMp&_nc_oc=AdrmEDeZwgVPWDPT5MABUw-2dRNG4AePfR_3V9yJP3ig1neYlKAQSeXMsxTNiSHqVJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMxGhfNMGtRr3rObpVDhdHweg9vj4rBJ6GvC4wqoJJXQ&oe=6AB7BA17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRb29kjrKnUQ7kNvwGgyhRa&_nc_oc=AdpprQIQ4abWV6BNMMEeyb_iSK5LF8k2vMKVcFxgTOR-NBujnGo78PXKu3In9WrNo2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvswKfFa2D2MQmogkSzYaTR1lgJO37mDU7HHBcKVIB3g&oe=6AB7E94F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA80IElG4v0Q7kNvwEIr1vD&_nc_oc=Ado5bp3g0sugyrucIcmPe1TBzKO3F5KDVZE-qTigg85eIsJelWEb7EiVxNoJmPj6tx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZMJmXHu2Zc9P37s8zI8jvCYFjDwGrhGuWq80BNtcf8w&oe=6AB7BA75"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxp2m9XwAw8Q7kNvwEyZyF9&_nc_oc=Adr4_NiqrIFRjqdghEM0XQcWXlx5ZGMSetmyvjfp7IaM_9h-KYk8PXjZTwuqWBKeGd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOxZiJcpYu2WRLT6qRmEC_G-mXbxTAcLHFNNqiy2IIEg&oe=6AB7EC05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuDF4b6uPkAQ7kNvwFH5IJP&_nc_oc=AdpkJsi873wF-SVNBPgpPUooM-748eJqr1fripzIAHK5SPbVcZIzyYp1SYsrIp3YGSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGkEDWY8R7GGAzSLsHQLqYX9E_uDqy6AcgmcZZWKmKRQ&oe=6AB7BBA1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
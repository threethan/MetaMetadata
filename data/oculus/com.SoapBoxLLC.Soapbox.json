AQTgIsMcZuC4pKXduyn79j4sAmEZkamgSYic4YnfbptcMw&oe=6B0063B7"}, {"file_name": "ed roland.png", "id": "1047067571263658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1047067574596991_3545592460762382153_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVAojnR4MlwQ7kNvwHFl0Im&_nc_oc=AdpTfRlPvbKsrphki2lynbpXcBVG3BDcTJaX-T4zmYbASswbd39T-f1g76kjqBXy2MY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9oTtpOs_K5MQFXAY9I2XVfnFzJ0k1dN9T47FbCdPbcA&oe=6B0052C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpX74m37Uk0Q7kNvwEGR5aX&_nc_oc=Adq2zjR3hX_WQtrLtLcIiGCgw9WVXBMucrFO_ysvfW5G6dMh32jLqbPKmSn2AaLlN6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQKEBLK4OVSu0t33UWVtwH0h7iqHURdmM1W0UmwAILDQ&oe=6B0074D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJn4-KnuPLsQ7kNvwHlWhyG&_nc_oc=AdpOqP6dcCZlZvvbm3mzNw8PMFugyHS-a8G5YyiykYX6plg_pHjhV8VjOZa-LssX1B8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk06miS2UHk13663mQL6YAE_b2FLC7Sa25gHHjOFnvgg&oe=6B006BCF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE4bgSoxCo4Q7kNvwG4i_cK&_nc_oc=AdpMn4C5WkwwAx79DvrnEdcVf2WpY5yFIGm10DJtLsfOHw0Xdq66jhu-ispiMMHutC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUH9WJIoRRiWQo55tS-z8kwr9HSQ5TTtoghKpJtLHCTQ&oe=6B007535"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QS1qI2aXTQQ7kNvwFw3zxB&_nc_oc=AdqqWB-wlNpOx8iYoQdW2rid0LH9PdLm3ieSnhXOupWNdVyfJ8F9UnM6fmHmhUM3ng0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyMFIGHsSPxMcKqlSbShc0KneuBc6LK9-q-lgA-XTwcw&oe=6B006E85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_ca
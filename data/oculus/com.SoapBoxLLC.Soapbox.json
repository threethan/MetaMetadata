c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-QvR_ZwfjsQ7kNvwEVfrlx&_nc_oc=AdqHfcqYc42oBafxAKDs_qj7OK88FrKtMA5bC50kmnyX0sHdROSn3u2o4nqGC6myb_0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUYOWJQf5r64rIEnK-Q-Qv57fMpCyUpfqRh6jhtAxz1A&oe=6AD3B807"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRYCq-VSUeMQ7kNvwFriSns&_nc_oc=Adp-WfuvAYgkQmcCPX5336J-d5FXeC2Yd-C9XLxyI9cfm90JQsnuXZevNKpewHV-TPk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrtDCLox-gjmqNjLn3hOfoVu8i1XmAa5WAp1HI9OkYlg&oe=6AD3A1D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUuyXK2KGoUQ7kNvwH-YurR&_nc_oc=AdqJj-hsTbSZ9SjnE6-MdE7SawitXqFU8zgB2ByeIiTJyO4eif9vesFn71QpBDoCE7o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvo1_Dmxprom2WWeUMaykFy6pynFIIFxEkGKyd5mkPPQ&oe=6AD398CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7GgzSCkkswQ7kNvwGQjJsk&_nc_oc=Adpv4R4TFzAxyNms8GpoEdMKdLQSHcCQinTJXFIo2k_An6CL3uVZt997mGRdUkEM9mw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp72JPbKo22W1XNguyI6ebmnJWIjhgYxMEpiuj_ZaIbw&oe=6AD3A235"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z1ESweTP_QQ7kNvwFvNMB5&_nc_oc=Adr7MM6pk31Lmh_YZ0BXg3t-4tpgd2HRajS_ve1iGCjJax9MxwIWy_waFjO2g8ms69Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6pOuA_cjubxIOy5h04p1glP7iQQyjiVrWBGXYCxyLVg&oe=6AD39B85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-bXQnkdsAcQ7kNvwFWZG5r&_nc_oc=Adpjv7-LtaPTLDNmAEJpNYdb3OgVY4fQ7hOI4EApRVmxbyMoHaAuTVyentKM4b_Yybw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0J_TD_twnd-IrHQaQ_SCbOGVYOxbHgPyVkO_8KfWFvg&oe=6AD3A361"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
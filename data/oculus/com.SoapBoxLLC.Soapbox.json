c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyUYhx5pXD8Q7kNvwE1woNB&_nc_oc=AdrnbkloUrll089NBjxLEf1gx5775Mk26g8IDilHIGEPXChrbfbtzoOuQS4UYMCDv_A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOouJp2OSJxbxvy1_5qJzKCj4URgHOXWtdeB8c5IiMKRQ&oe=6AC4FF47"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMGgWI1HDqEQ7kNvwEA796g&_nc_oc=AdqTZpgOMfvdPU3y9v0DNb4xBSgSdey3Tnx7eh4jJ9Eb4C8HHtaNUSWlUzzA1tCkJvA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM2p3P9ULYykKN2a3M3XISFEt2GU6Cc_mWvWrJf-fL4g&oe=6AC52157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfn57ROaL54Q7kNvwG0vQY2&_nc_oc=AdoEGyuOSFnpkgjwG8MFQ-qPv0rBAEBZdwQeLIjami6wdU5sJ0Sh64d93DbLdGmKhKI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPakyRieJb-CsSWmySocTYYlKVD3AGpjKc94ded_HHfJg&oe=6AC5184F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3F7OM-r5LsQ7kNvwH-vfkD&_nc_oc=AdoL1nLkErJZUZS7LujqvK7uhqcif37dVCHwbblAPzS1w1d75OJA2B1VlyoEpRqn7sI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXmR3uQMvcRptnp6QoMrI6p0aWf_CA8SievR7ZU1cMsw&oe=6AC521B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN2-2rslcM4Q7kNvwGXQ07c&_nc_oc=AdqMejOQ-9g6BINtg1H9X29g8ca-lC7VNpcaOHGnDgYyuTV8H448OIccBulGPGa1DbI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRjSKxRMLxvx_kVq9EQgu_jYWSK7hYezZIw9T12Gm1Zg&oe=6AC51B05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQBnQ9hz19kQ7kNvwGUihBV&_nc_oc=AdoNqCe2nFUl9nPfqbbAqo03E2STAd8ELbBQRMfniTPCo2KsSRbD49pL3_4YBoLPoxM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUwIHs8AtrHwjzqqObriaI3uNXCHpu_JS3PykwVqe73Q&oe=6AC522E1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkO4dye3vPIQ7kNvwGh6JIV&_nc_oc=AdoLiAmXVjzGFnF12H6dymUvOQYuzRNWnImGToSTaHOWX4KqXsKN6UTa3RnST7zNfZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1sXVfbSu5hIWRdtIVusDTo_FqbyIn0XeD34HWkrlGUQ&oe=6AF5C6C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzNo8cq0lAgQ7kNvwF-w6g4&_nc_oc=AdqPxi6qZW9-azGrm7iWLcDPEQaRFAmZNwef9WjlZPq8HD75CTJtkkceFKS1P2c-qh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUpccFZlCt7k4JwbZLJ4QjWKh5Ei9BBgnlu_7hRkn5MA&oe=6AF5E8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMCYuzwuLIAQ7kNvwEHHxXS&_nc_oc=Adrs9DlLlwfEv1o4QRlKpwJHWsNmVgbmWPeEmfUAiUiUKLOwKif31YMxe8dlgtmvZ8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP4F0BIBWsZCUkfIc3ZLC91owzFakxLTiOPuwKNkgirg&oe=6AF5DFCF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBe8XEplcfQQ7kNvwFHsBDf&_nc_oc=Adpxrefvxmfo5ms9nzSAm_-FZ9a0jYhuKm9P5EYmWOU3pF0KGbvUMqgZk8GCuB5ujI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNgScBVgq0Jt9D8ndDxbh99tT-RK9dM1uUblcbi8W7BA&oe=6AF5E935"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnQ3-bcFGlcQ7kNvwH81Iwt&_nc_oc=AdqdkX30f_-jM_R3-UOAHrahtRT_xB7DyIepkFKXzaxTs231iVRuYcn5TUo4g91Ii0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTqPPsNpgWJhPpzvMhhCeYHhjKtWXqyL5wgU5-1BTFng&oe=6AF5E285"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEjFO74V54kQ7kNvwGBDZ6B&_nc_oc=Adordq_mfk6CTW_rdfXe5xc05nyZ8WZw2_dqWj55PJRxgE4J14Mu9hFA1Mnf4nCtyvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6b6-jRXSrfdDbLq27RGFolFQp2MsUIJQ6Bd--oEyzRA&oe=6AF5EA61"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
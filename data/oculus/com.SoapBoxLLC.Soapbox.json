c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu0taprRDSgQ7kNvwHtVvLm&_nc_oc=Adq4NbKNrxMyWdaDX6OngZ6jtQ2fFw2X-nA24Va9u1Z7CcC6iYSjbLUOXbiM2AyxubI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCCyAsmpFcEIxX0GU5szsT0cL9tRGz4kjKlAd4yyairw&oe=6AEC8C47"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_mJDGb1ZGYQ7kNvwHquYmS&_nc_oc=AdruXxnVLOYrYm4OT7oE34KqKhabjPaBLRv6SBxdXmolXyJD7RHVKCYHiM-6XtYC4z8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfWAzU0FOZ3I4SqnmGTsB-wgeW2kcNWMVDZLp6lHVNEQ&oe=6AECAE57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfeyOo3gfEYQ7kNvwG5UaQR&_nc_oc=AdqHRO2WJGOpWz_SsLBBssassS-b2jdo7foRexp7RAvSkj6__qpjG-Q-NlldyimVeNE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ4maDjKcXetIyv63q00x-ZAlFE0ZsyRgxoPJrnvir6A&oe=6AECA54F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I19wUW68S4Q7kNvwHkTxUy&_nc_oc=Ado-iL1fzMM3n4ixM1p6R6j0W_42ABc85dzEnOXsvID4XIBda1DdIcqWALC3w8wE1_g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSOWTVKLCJ1m5N6p5ZBwgWnHmVpMtFYFxQvfx0V3rJZQ&oe=6AECAEB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1_o_mb9tVMQ7kNvwFfxeFw&_nc_oc=AdpVYkDYDbIxPbe-7XfHoj8mzUKGWQk-89fEX_eiLWQaasfPxtnozfYN7MtZuv01COQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxLaOo9LNq_bH-yBSNM2stC4T0Eh8BzNDyTxLA2hmATw&oe=6AECA805"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TiOIoGr0PQQ7kNvwE6x6gU&_nc_oc=Ado4MhtT5a2oChUpF_KHEaArJRairWQhCEG0hvl-SRlf1TocpOvS7jI6rNHJWvHWM64&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTdmgwgLnZz_gIsXoFYIl6gXWlzE1PWrxbmGBQyZFMNQ&oe=6AECAFE1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
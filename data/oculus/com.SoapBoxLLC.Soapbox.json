c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyUYhx5pXD8Q7kNvwH3MStv&_nc_oc=AdoIvMJVuRafTb8LHLawYDiGuHUmN0CEI1sdWyAHe3vi8iPwrXyKAZRlgY3NuHmZ6Lk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzHoc-go8H1iKD-Iwg8z2-E_N-dc1C1AUiJu5TUuIF1A&oe=6AC650C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMGgWI1HDqEQ7kNvwFQgtwC&_nc_oc=AdqbjpLMb26bKgKk36CsPAlbtBiuLp2ztl1wUiLVhnkppLBpM_s7JqdyxELESeYrm8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7HFIaFiWbLHXV44Rog9E000oZG0RIyauApXd_JMITEw&oe=6AC672D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfn57ROaL54Q7kNvwGKv6LX&_nc_oc=AdpU0eHFQYnUlJdkLQKK-pwAOT5gMpr_HqFujVVca_RIsEl7fn5X6mhEjTIbtY7ushk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-DPN_mi8fRNiIgFXCRlZaTJSJwhxemyookPDJq-I5mA&oe=6AC669CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3F7OM-r5LsQ7kNvwHhapBk&_nc_oc=Adpfp2dWmFrxF6uO2aAXCV1KOqypZKeX9t-V6n9Q-LbBfm0D1by6mEzzNVVj957Idpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4V_OFRjV9sI2TstevkCcR5r2qEJxhrVd1x95V7nC_YQ&oe=6AC67335"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN2-2rslcM4Q7kNvwEyz4GU&_nc_oc=Ado0iu4_5CFDCovMbRfmce5uXfGvyPuplYmSG8P400XQ8xkIzokV2V1g6ScA32OIqSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYMyEKwyvtAjXSrmDZ499Jci34MjmiClKS0k0hM9lJYw&oe=6AC66C85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQBnQ9hz19kQ7kNvwFWIEWp&_nc_oc=AdrOmfpzrVPwS6BM7XjR0rg1gyy0SDvMFv4PH1vLDcTc1mg2cRXjAolDX22hV4vhxZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrBHhvHQIt1YUHlATwDub6fH9u1Xh57PFC8nLrA2jw8w&oe=6AC67461"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
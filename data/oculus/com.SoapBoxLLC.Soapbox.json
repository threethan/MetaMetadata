c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt85ZvGPhIEQ7kNvwETmjjx&_nc_oc=AdpiRQ0w5eVSmULPuPG_M1ulsYU6_g6erNeVoPh6Le4svg9lDhYY8AyAQaOVfV4jlu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPB3bl6W4ycsWKpLvNBe8fSZ4PK9l92VeIrQS4QWUWIQ&oe=6ABD1647"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW32wXg9f54Q7kNvwEXym_3&_nc_oc=AdrxxvdrZLvBiIp6UyRu7r0yfaydiNgLvQLd6Fw7pPsLx7WIubY5713Oo02gZ-yBYKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZGzat_wR-MHpo-6pHp8IDrWINcT-F6aq5xBMeH6Zwdg&oe=6ABD0017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5klR82-rr4Q7kNvwGKN8pW&_nc_oc=AdqWGqt2zjd4XoIhv9irtqXkZdeST_rj7KVzd2P5U0JUJAemeP9aQB3pKsiOticZda8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-XoVoj1KKij_DVuF0zN9z8-ygm5iF8ATEWyTJ44HhKg&oe=6ABD2F4F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cA-rjLxBa8Q7kNvwEjz4TM&_nc_oc=AdpGUsBBQFpOTBjPmHJXRjU9aBJS1N74KqQdp3md_3X1E_rcO-7WU_asoU-RSRFFDqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeg_mx49PkfSUl-72TBuuNVBafHCS58UpbFcKz6qoWXg&oe=6ABD0075"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNeoNjC_RjcQ7kNvwG3m0FH&_nc_oc=AdrfDlcbQ-dOoPwuph2PnX_IPHuzx2xrhpFOWD_eUWbfwWrPonP-8gmmPfp19zxs5DU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJI24PktTEOl2YpBRy4vjSi-xgBrCGsubI-Fjyr2F3AQ&oe=6ABD3205"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gug8b7RuftgQ7kNvwE9Tp1I&_nc_oc=AdqEr1u2sUIoEMwW8bFZdfbvLOtU6W6Kw3DmR5FpGRXNYjwVzF_8Uqok1dPo8djBlZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO0oGWxU-5gXuUGWBuUaycejOQ2hBTe3sS-RkVdCGPDA&oe=6ABD01A1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
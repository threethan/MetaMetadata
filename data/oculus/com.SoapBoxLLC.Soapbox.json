c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_cFduMFnDYQ7kNvwHAJfTH&_nc_oc=AdrZIsqqHOEq2rrx-NYTA8ZbWqI79nTSwcYoCkatWpcEJVcQjK6e-TOGqbGZ9otGJb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-JHFyp69iFoGSWNoMsDrMY11nCZ2oII5X1RGs3I0HzA&oe=6ACF8B47"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpEqvpTgYloQ7kNvwEmaHEw&_nc_oc=AdqKfYrAZZq5hOrUgjMP8ErzIVw4eE-5vX-MFhrAQAnUQ1ePER4z6I7qwPaqBokgOg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ8L3LXe7DPH2NTqg25m2xAmZTAace4V9mYV6IzsBZ9g&oe=6ACFAD57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnsrUy3F1p4Q7kNvwEahAov&_nc_oc=Ado75QEzgX1fJcNPTFEM9YQO_O0NXundk6Q76nuEea8rlKCB-awaMM5293-DI7CUZmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx6JMg8Fff2W6oeKfbu30cM0CPxCIK-5j7tYxd-sv-uQ&oe=6ACFA44F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks1R7V1YFaAQ7kNvwE3OX5D&_nc_oc=AdqIxM0eYGyu4Aa2iAFtEtQtssplpXAb_LlX2N7zobOSVGwNpvhXa3lubt4XPwGheOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcBPp8taEpPNUzK7wll4xUlyLeZBwMIBKttX86jzFn4Q&oe=6ACFADB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2cIJdNoYMYQ7kNvwHwBwmN&_nc_oc=Adrv_ZN71fSK4cMeO3bgniv-tgD0eV46ByM2eR76-7ZjxPjKq40a8UWjf_vP-RFWZTU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJNQWtBNBFnudc6VYcrcGU21Ou6KCVbkBqqJGjIMFOBg&oe=6ACFA705"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfe60W9mf8EQ7kNvwFfTkqG&_nc_oc=AdroTf3KBN9Fd1nI_FLZ83zLClKuEIcECHmLxajY33ZX-5bmvOzOqZs2C4a-RiMEKis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtaZV0MaeRdyxLK1lxEQHd-na8eluV2kve8cjWZs4-bw&oe=6ACFAEE1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
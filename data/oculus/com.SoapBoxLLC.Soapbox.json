c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkW2ZhTLdokQ7kNvwGmIsyw&_nc_oc=AdrcvytwXtVHV2Z0Pr9Pim4Uu4SswMw58GeHib0XRbvgOR9v77cSrmbNax7woGmQv0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoEy9Z01pT6_yqEg6DAdyygdyBSUvpszruADoRAWTAMg&oe=6AF8A207"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KISGdZyVqQ0Q7kNvwGnsl3J&_nc_oc=AdokRo4aCToNVxo-A78fZfB4BZT3hzqfpjD8O6aFBkEfzInyR7Aaf8XU7rbRJVbU7kY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR7WUEBPCMsGsQfLeBxqGs6ZsjMS1c9Cnu8KVcWaU87w&oe=6AF88BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue3kqc3gvOIQ7kNvwH1Q6GX&_nc_oc=AdofeThZ-VCFsWhicV7l6MHt6_bUnDpxDOK6iG3mnBsj7v3uc3fdn64OzkaT56Mem0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2ndJ8KBqCPXVHETP9va9rCBVrIbc-kWCyKZN_WGjKDA&oe=6AF882CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zb-QQpd2QIQ7kNvwFsZjK5&_nc_oc=Adp4a21vSajU387B3xvut6ePHj8oQUrnoM9lZrkr3koYUmwGAQiNysQ0zuvtfuw-dsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm-m9pFIM6hicLLQ2Gg2z5B1DY1hbLxouL-I6Ry3-KXw&oe=6AF88C35"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4tPnNV-t8QQ7kNvwGeX8Gk&_nc_oc=Adp02zgerPHAnf8lRJzsz8dRzqIcFZxChdExp98AICP6o4bZc8Uymsn5hqrGMdp01Ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1pcJYc4EwowYdk9Z6GBB3k80KtuoIRIPqQfjIyESzow&oe=6AF88585"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeSQAn8yiLkQ7kNvwExgs5L&_nc_oc=Adr9zIRbnR4PwxKavLoEuSgCq6n_PRVqZhcdOYxRcQPrnig1USIqRvlqdUVo7P5ff_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJEYmzBz1Weltp4PGXJsPPhkLBW7jN3b31teQNu0lN3Q&oe=6AF88D61"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
mKY58fVhB103Bg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRoZTm6dgEpSssJ8IR-IGRkY25D-IfB4TrQ0KbtpjtGQ&oe=6AFB35D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "4093972847556752", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827703_4093972850890085_2002232691968348363_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8Qb6YzI0zwQ7kNvwGuc9HG&_nc_oc=AdpCBQPZmIplqRHX3kU4bOveSDZaLnMp9RMLHmVPKtYt9MgOKHzYnrTOHE6lDMw1mFc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9wIviEdWy7ecK-QlO9GnAhS8v2la8v3kdDpF2HmHIPA&oe=6AFB4B26"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["concert", "hologram", "comedy", "music", "lineup"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soapbox.us/privacy
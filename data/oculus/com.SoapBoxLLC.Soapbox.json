c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3mre7_8OQUQ7kNvwE5ViLd&_nc_oc=Adr6sY4ljVgUpMMboVwy58L2VuY4HDjCEkacxo4UhmRuX4WO5ll5SrnD3AWeAO0oo-w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkYrqsoRUO5vmfxBpMxIw9UgajJdbM--w0zM6c4Uo0Mw&oe=6AC7A247"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkJSumMjUGIQ7kNvwEZ-7FK&_nc_oc=AdoGBevr2f9KmoGx8op7p3jLOlbICImIatIEzB2kDRDlTZ6uOaJ4DFZd50iyScbBYn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeNbvC6AYsy3XEnUq2SC9g2oaJccJ_rxxEzCflvUcPNQ&oe=6AC7C457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfn57ROaL54Q7kNvwFHym1f&_nc_oc=AdrEZ3LvVRKALnvVsD4ZOPiNLGnyA1_m1TBNd0F3lQN8asPPbl2TY8VQ8-v4pfgKzYQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2LyHPjGsJjaO_l8qTquOe_dk-oVsaZiCNob42xv0O6Q&oe=6AC7BB4F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3F7OM-r5LsQ7kNvwH2qVgs&_nc_oc=Adp4WFkHHH6oOIhDOcpNAC-pyZUrUpAvnwkrD_JYfT91h6FSbed528nxCLyUv3TOM_A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqVirxD-q3f-nS997P0mZf6kLh1aUCP8ch9VfX0vD_0Q&oe=6AC7C4B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agvyZm-gM1EQ7kNvwEpKVxH&_nc_oc=AdouqmLZEeb0Qp2e-y4dt8wcZxoAOtYN0nWmy-_fqnUqTQKjSxxXhnXYD_2TZWbfaWw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOvhg0LxiUs6vDq8-i7MBZbv6UFjrfhlt2krMJK77liQ&oe=6AC7BE05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQBnQ9hz19kQ7kNvwFqDFUK&_nc_oc=AdqlTYkiNPN0w7EUsGUrvaSFPrBVXIsCP1isdUtBZQCPYoRgfAbTHVe-iFxVjKZ4S_k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqYfF_ibTxEsfMiiITFwOyWAZlI1t_V_ROmFxLj8Qw_g&oe=6AC7C5E1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
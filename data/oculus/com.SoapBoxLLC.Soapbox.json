c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWk7eIIjo3YQ7kNvwGtNm9O&_nc_oc=Adqub2dIF8ddJAitn9JN9ZeBfP25AcZ4CuEE9gSbR6UCkCLeYnDUCc9EOSCfkm8DB6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFDbzRH9uDZkKt-Qxaw9CUAzpfo_lMFh52sFlldOiWJA&oe=6ACCE847"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qtRAzjMX0sQ7kNvwHYhxek&_nc_oc=AdrFe-YxOU-p-BIVSvHS5tbbpJ2-pxE70jhmMqBind2Fjt_hIXogwqkV65W-nqEl4qg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc6_I-ltIINg53OYFeq05Dnmkhtn7Shk5vVEU2zLQW1A&oe=6ACD0A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnsrUy3F1p4Q7kNvwHF2tsv&_nc_oc=Adp9JDD1jqV3ji6ERkQgBu7nvSW4APpwNuGcT-XRXrOrwnFy1d8-DXwChxuiyhinSz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJX5W5xwqVJGqIieUnEO_cIc0zQj7QLsc3wq-MK4tQ7A&oe=6ACD014F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks1R7V1YFaAQ7kNvwF2baY8&_nc_oc=AdpQxFEDRXmkoHcIYIEBwFJGJS3W0cNeSXL9DGzC5O02z0rE08MKEfBabmdZKHYPY78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTJ8126jI1sYMDrcvKgi8n11wbmxCFl88rOZwrjqUEeg&oe=6ACD0AB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEbO8CRN2jkQ7kNvwFx4TEf&_nc_oc=AdqiLIGSy0mh1wvEIru_Kax-iAXqJ4osk0SeRv0Z6mDVlk3qMqoz4Pa9XFtlcoULLGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5m0f4LAq8tnBUm6vhJMpP1KF5HAuK4DIgrcXxFPQ8mQ&oe=6ACD0405"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfe60W9mf8EQ7kNvwGavbdF&_nc_oc=AdqQTZjSzczZTNNnsDkOwjPnt30G2tCXDkA1vC05rECyeOupVFc3F_m1gtDJOWnQU3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcKeu5jAQEnFG74L7zLCNnYNHYlPH5wTTD3Cu7lBCwGQ&oe=6ACD0BE1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by7tuGSaSUcQ7kNvwG_y4DX&_nc_oc=AdoJP7OxjZubwYd06JRHosLHFEbFHaLQKJrYG07Nw7N3QrFjww1CnBnwKqor_uH_8bg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjDT04Jxa12fyveffUAZ0chA45Uo9mcEd1zRgLf_Blvg&oe=6AE897C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0EcWgzOwRgQ7kNvwHAiZz1&_nc_oc=AdpCgNt2jor4oY5tQvXCNgvQzpPdHiw0RHzDyvR5QeSEj0IWXd6b1Xpm9wcVkm09pa4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFFdPJeGV5mhF1xyvSwvsHSRjz_COEci_p29hQpJ45Mw&oe=6AE8B9D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYoCgk40rZUQ7kNvwEC_aum&_nc_oc=AdoHqG0iGNRzbF1mzDDz0xu2gT4G_S_2lVxJAZ1wr6NtgJ1UrKgwRqNPBrkxTs9FvtE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9-ophevLc0STi0rv_dPkHHYPxfHFVPW21DdJ-hKIehQ&oe=6AE8B0CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz1_pZjo_GcQ7kNvwECEVom&_nc_oc=AdoifUHNlmObXdreV3TaYYKxPZwmqzJkJTreqR49kFBXGG7cFFr6WALu2Ew7AdIvlaI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR60m4vFJEASAOYHbKgLs5ITXB9Lm_qj3JcZlrki3CQ8A&oe=6AE8BA35"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30ZM1J9Xik4Q7kNvwHrB-Tr&_nc_oc=AdpeuvN6XpxL70jq-O223sMWAQSpGfMLdD2RvWyoO8L86sDr9s29ikNl-Ojwb-LcmIE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHuJlKgnrPYnCcWJIBa_GdVruaPTcI3rlBIhJrj0LGLw&oe=6AE8B385"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okH6zhCDpaEQ7kNvwEjmK05&_nc_oc=AdrjiIGzt43vg8_WoAeo-XIlcBZchbljH0siuXrHkCXHhet_ZHWV8mnZZGDJo5OoBu8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM6bNMb5Jq2MMfnQOWakbfCZjAlb-xVnTmxTfc_wgv6Q&oe=6AE8BB61"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
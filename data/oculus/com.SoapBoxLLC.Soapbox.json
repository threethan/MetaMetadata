c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt85ZvGPhIEQ7kNvwH8tbpf&_nc_oc=AdpIpTGnr7YGjPNKIBC92bqAILWrqZXbOYB4Fs2CvrmH1gA18w0o-7m9-HNbEx2A5wA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBdiwIqyWASY50-ngrWBvxFzurgA5KjBF6Ip0RbuL5KA&oe=6ABE67C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW32wXg9f54Q7kNvwGP-pKL&_nc_oc=AdrLbZh0uWeuz1Jik7dB7mVD3Sk2n373HvkZBa2sV60Zw6uWSYoaD4B96XKQTpm2nME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4CyWGRFIIN62N1ejUOry4MEwemd_mc_gL_CYOgH-3pA&oe=6ABE89D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5klR82-rr4Q7kNvwFK38wI&_nc_oc=Adr6PNa-c5vqxnEufjjbzWsckheNVZgDFVWO8ItZE4RRto7RD_lNZ5Fp5qcQxRM9Jg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtoRvEp2hb_U9BxWygX_X8CNDtJTVHa3x69YEVP8dfYQ&oe=6ABE80CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cA-rjLxBa8Q7kNvwFpD-SA&_nc_oc=AdrN793lvGq5_2Vojjk3UWX20x4c7NFWH-F0Xrm1Ia0VzysVt28e2wp2LQPhwzPrl4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9UrJqeG7ObaqqbvAO7lx_KZA5xSDSQC-FGKdMj_tX1A&oe=6ABE8A35"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNeoNjC_RjcQ7kNvwFO4JJW&_nc_oc=AdrnrDr23J99wAAwjnS69eSEP1CbBD1Djf_n5WlVVeUT-jrpLTg_6AoImlMP5GSW3fs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmgMmo2qEnOvpkKCoVSX-wRzzcGw4UIwv-lWZd2OLjyA&oe=6ABE8385"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gug8b7RuftgQ7kNvwFGMi5m&_nc_oc=AdosuLE2rx-r1tH6qu2Kt0qCB0tl7wUANq2AEhdkibkrYguEFgxLBAJ4ZTo_tnTu10I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK65fHkuVZQUiXNtsJM6YpKrukRZiSl4lHaPutnNUF9Iw&oe=6ABE8B61"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
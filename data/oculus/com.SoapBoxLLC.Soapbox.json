c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-YgFs7lPMkQ7kNvwFWnEGV&_nc_oc=AdojhVieU2dq1lMKyPxuz_cKLOMHSVur46ACfjveN1R_BK6_UQ-xmxS7NI8ToSHnwJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObk57yOzJyxdK0hIaXPeWLCNqG0_63u8Wp7pka198zIQ&oe=6AE0AEC7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0Jz7yodeWgQ7kNvwGHOP66&_nc_oc=AdpuaDFI9D_baXiYAlzqMJWFWMEHSvEAR-svHN0rF58leD_IjQfSJdEPRS44R94vQLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbI6PC3D0xqj8d3G0pXC76QMJJe5KK7pSb1IrkiMejww&oe=6AE09897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jy7afjgsDYQ7kNvwFDcQRl&_nc_oc=AdpCip21d_XE61GeRGKFCdJVH16IczovFRJzzhqpSaoTWColnoNvf6pIeyZfosz_eBo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2-NQF3DO5Co29f4f3pGKvqmL8hNY8MvjKELPX0mGhNQ&oe=6AE0C7CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFL-uLZdLecQ7kNvwHwGoRa&_nc_oc=AdpHcnpCX5OUD3NzzJdNZlo5a6I9LZ-LKeB7-wzL7yeqqCMlnrPEi2tEeXop4Fkr2EE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAicIgN76X_CoZXeGTp02GMVAxnl4WzpDt6mXDp8r5XQ&oe=6AE098F5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psJDftSgISIQ7kNvwH2x269&_nc_oc=AdoSHHrtb3H4HRtIQB0N64hLkZRQDSXQ2gbVmT8miZrObHEp4UDh_XnKInG-_aTyCBQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKBrXmQ_pnQJRKjl_VBbxExeTyxbyzyXFju4QhhztRvA&oe=6AE0CA85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmJ_jACRrxcQ7kNvwFfpEx0&_nc_oc=AdrmY9n-dghjLg_RkHrvuod3eYmbsZtmtJRmXcGPg2510cnhmB5wXK_HQ4FUfdZ5r0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm21hjCK9O1UcA7v4WtLj619mDgKYG8mogpxmguJ-YAA&oe=6AE09A21"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
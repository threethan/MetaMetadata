c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkO4dye3vPIQ7kNvwGzRjPD&_nc_oc=Adr8wUn1dASPuGsZh_jIRp1t1IaEJCUenkNmsYFUk3RGrOGe-GTi2xnvXmP5kqPVIU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSafNCCtlq8so-f4Oqn8s-yR5Mx6iTRAi9P4I3MTyQSQA&oe=6AF323C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzNo8cq0lAgQ7kNvwF0kfR4&_nc_oc=AdrEXhWaSIvfa3myJpM51bMLvaZtlK63DGuLoqcUPWtksPDTJRoxx2xqtd3-4dR_Oww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjrnQArXu-T5DSs1JZmcBBY9PWgpidH90XVUZRSwMO6Q&oe=6AF345D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkJZe0z77cEQ7kNvwHVzLyK&_nc_oc=AdpG29_DkUC00wc7NUAV4qAVGpos2f7NJqGcSBFi0ijqyFtD38QhjCYEVfJJcrrd_TA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv2lpgNyX4jnpKAlfzz-zffVJYhMt9IdPOqeuWlYvSIg&oe=6AF33CCF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqZQNjZ0Ih8Q7kNvwESDYGz&_nc_oc=AdoIRf9Oiy8vSygYPfMI4jZ7BdschbG1KYrsm_POwzJuJna2gSxDyF0asze8zaBWNw0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrYIyPKd6TtDFIGg3SEcZheqYsSbfaEFT7pX0m92oZ8g&oe=6AF34635"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnQ3-bcFGlcQ7kNvwHj9HM5&_nc_oc=AdqgZyvL6Igo8YkkIIWCT8WPme1eNGoJPfxZONOMLQVeTRdcFWIl6sRYc-SWntbdNxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPSiwiDtG0k9Oy8CjrOxaMGxUM59JR4a4ZCAp4do06pA&oe=6AF33F85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edA6JtsudKwQ7kNvwH-opst&_nc_oc=AdocNxvNAX6KXhTSnf-k57-Doh4kEyBsQja571c6Gqh7oi2azy7qMuDgnsZYDlW0gos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJziDIiRzf8jPbU0rBn2I8GMs0L6T6mevcueIa6MaoqQ&oe=6AF34761"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
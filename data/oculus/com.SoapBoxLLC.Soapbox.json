c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt85ZvGPhIEQ7kNvwERmA0n&_nc_oc=AdoRRwmqLQ7evB8yezBF0iKLZKpKSjogx8H5hShalodN_qcU-RIErtrCehjBsncG3n8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEA-XyZdewauUx7fvl2wXYmlN-2lEtZQ3e3hSemKsh4Q&oe=6ABBC4C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW32wXg9f54Q7kNvwHxdg39&_nc_oc=AdquhD93NbnUVfSHuKJ5lrZXexngA9pCulaXDzxqjbiiBTUD_cyLvK1t_oGe0USU_QU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw2yHUKRZpyGEQ8LpBGm7psi2y_onJMRayS_SVf7_feg&oe=6ABBE6D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIOFxKO3h0YQ7kNvwHFEHoP&_nc_oc=AdpCAhOQ0KrOCjMB1HRuxgxSVoQmnyLTjUL2Q10b_zoSHf-x7hC4rHJaZp-UvpYhccA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIASJQkujOXbTCbt4LXSUUSoK--ARvVtfPRYkfcQAWjJQ&oe=6ABBDDCF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_ZZyXzLKeAQ7kNvwE7ukIe&_nc_oc=Adovy4UUfyWOaoBeo6oamFfx9sc-5n6rEuS79Qj6WL1NnJEbWorBL1nYkraIdkMCh3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUcew7Kia15QOp-F02bXXIT6nXNaBIn7w2dQ1D3yyvsg&oe=6ABBAEF5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNeoNjC_RjcQ7kNvwHbBnj-&_nc_oc=AdpdEp5ORme6vANoj7AYc6bw9LxZc_U9zEuCiRqRtAnzvSHXKhiXkHiPCpc1F_Xy0PY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6chbrEWAGNpVSVu9JRft0a3ZZl5h8lgA-jidbUYv9dw&oe=6ABBE085"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phmU8vjKPHYQ7kNvwGcpQEE&_nc_oc=AdpbolWAbtm_ZrDle9WxSlXDdYKRoY00Qt5PWEsSxegOA3VkP8UeVumvUd62iUnq3w4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS0DHtjPHf94OuXH9qURzMF17b6BAMBAxGjoMAqDBKHg&oe=6ABBB021"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
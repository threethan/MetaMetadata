c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3mre7_8OQUQ7kNvwEZW766&_nc_oc=AdqSyhSMbRhe2Q64uzxCO6a9KKhT9hJ8-hygw6BD9W4OtvLMA1S3HJ4ZpZXwj5J5Pk0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODGukI9j8IN7-JY5JGMHmepiU8K0SD3mDMQMmNvwpqIA&oe=6AC8F3C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkJSumMjUGIQ7kNvwFlTV7f&_nc_oc=AdoJUBoAU_HrDcbwZTBSCKcKgDx8IMzbisADgYlqEl2R0uInscwjQ2jXj3SSz9_5nf4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1S80KjNvmk9kdD9vSEUvaHX_yNY2luGHdh1YE1exp-g&oe=6AC915D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_D5rUroyUgQ7kNvwEgCuSx&_nc_oc=AdpT2t7SpLg91PUmNT3h16t39Wlh-BP_J3gGJ-Vo2rUTS5TLxwiJX1IOFm1pChtH_k4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgK6bZS6ISVUp01b4M2SjT0zJvyWj3jzKN6CjnfRXmRg&oe=6AC90CCF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtGJ4Y1Cv6QQ7kNvwEIEKum&_nc_oc=Adoo3ccAxQ9H0dPXd50bYbd-e6GsM6CsIOiG12453d6N9dVjebkzysZjpXx0mBum84M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8bZOLliF3v3dndEbHX4nFqeeL4Hk4m_mz2vGreKxMlQ&oe=6AC91635"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agvyZm-gM1EQ7kNvwFDcp7Q&_nc_oc=Adr-5ObJ4u7Q__UbaOwOV7SiTE9FbRIqwqNemkkpfoY2CAobd75OX1SggNaxgPUqqkU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPff36sxXUPo5ANCYD4GlMhma_KdH-p8rWCDFmTjBzbgw&oe=6AC90F85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ixuuLb3SfYQ7kNvwFShLni&_nc_oc=AdoUmWZw8pRtaOrLN06CmHIFqnDBU24eCx8cxMmn6-xmaQIHliHBMgX6UGL4ytSgpZw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFw8u5N4YaBv9nlDBborWiIv8HlipbWsJreOqg-IG7VA&oe=6AC91761"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
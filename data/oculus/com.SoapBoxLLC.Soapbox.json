c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_cFduMFnDYQ7kNvwH91vJH&_nc_oc=Adp1zEc3fhkv_ICDee95oGpG3p4r3iMKWiCTOgVF8wf7_LrP7RILxLzEEApe4ZpcH8U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH8SZt92hi-cV0kgrRcRdBchUfYqJh57UeXXD0kipaFA&oe=6AD0DCC7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpEqvpTgYloQ7kNvwGZ5ibZ&_nc_oc=Adr67X6NtEwZJhHR2td2BJFPnVBBccJFQHv0HBe0dK3yR70yx4u59_YyPFS5J8sU1vc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbdyFfGnXJDUgZFntfiMV_B9nT_PsQXsjDKpfKPf_wpw&oe=6AD0FED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUuyXK2KGoUQ7kNvwFmxmfm&_nc_oc=Adrz3iGZ69yGjzihnal-Dq_0AJFF609Qiojh11ziwPDLotLB4B3flZdxdBTwBDWhIjI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMWSDICcY5b0aaJDSb191ppsXdQm8jlJZpoxwZPMTehQ&oe=6AD0F5CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7GgzSCkkswQ7kNvwEIZFMp&_nc_oc=AdpAdsN3d-oRYHqv2IiFKZfTHc9mBqIJ9ACTc7AUv5Mb8SmdgdfW3Xn8DPqG1Ya_8Fs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqdqn4JlzT_BN6JyDYvNE19IuJh1ExYfGYG2R_1lHQxA&oe=6AD0FF35"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2cIJdNoYMYQ7kNvwGN0Yps&_nc_oc=AdoyvaP-i1xt0WAzakdlgQIFn0eo3LmDb58UzGwIchjtrM2c4qo5LIoT3cKRLX2YzeU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE36JUbYGYiNP39azB2Dvkw7zwK56_j8xwhAOAF802Bw&oe=6AD0F885"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-bXQnkdsAcQ7kNvwEAfokI&_nc_oc=AdquZUE5dZ-td5wrwkyM5YOKyEUJyqPQOPwbxY_7oJojMJsTZoDrZF5oM8JTRbeuN5c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY6xoE76jD0HywI9xftAMvFMsnaA35APeHTIx1x5oQ-A&oe=6AD10061"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
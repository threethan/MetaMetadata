c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWk7eIIjo3YQ7kNvwHd2YSi&_nc_oc=AdqUbA0783kVlSwPikPG_PT5vULOURFyhigV2QbAiHePbA8wxC5gKPlLxv1XGgaVdBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM31T8LHLbgP25O1-5gJ_aR3QDrPwG4Am7lgRY2gYmo3g&oe=6ACE39C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qtRAzjMX0sQ7kNvwEhbQV0&_nc_oc=AdqiRMEHdLJgFOsB67jQs-KClmQ8W8Kdyy7IY1rjnEAAOBrgm6Nnlz0e8DvEqH9XuV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwOr9lvAo6kIwf9I8wYXM7Wg-jgBgrxoofr_0j4A6T-w&oe=6ACE5BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnsrUy3F1p4Q7kNvwG7D92x&_nc_oc=AdrYkaDmZOmz2dveFe6cfGTRFRUsi6bK9CBvdZ_7dVgU_UdxKDAsWEq1ZzAzRio8_KI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBteBfAA_cm5XfMCjf5BxR13NIGU9TLDR4njG-HtYUIA&oe=6ACE52CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks1R7V1YFaAQ7kNvwHBdJNN&_nc_oc=Adpn7acrbtaUUVA8EAtP-e7ZxYQYmFVcRY9UI1oXM0Epvr9fSyfsLHd85unYKRUBy20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqBYQt5S18jamH-yvy34WSPo0ERKGs58uTgO7Db3R9RQ&oe=6ACE5C35"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEbO8CRN2jkQ7kNvwHYMxI0&_nc_oc=AdqkwCFg9EgQP17KuMw0HM04knuN1PY5vek6W6UQpFnW3zp6Frjs_w-qLk4Fd44BB3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6vR8px_PY3C4jKlZI1iAFt-_i97IkG8h5n5tsA4OG0w&oe=6ACE5585"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfe60W9mf8EQ7kNvwHtAG8m&_nc_oc=AdrN1tr-oRa9FIhSyfuwmKe-2cZ6wReWRDRTZ7-Tja95P8kmMmv4CaFiQdoT6mvncw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8W7R7h4Uke1IlyxfJfoamtCygYFZRKlOpITe4U4F-GA&oe=6ACE5D61"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-YgFs7lPMkQ7kNvwHq-fd7&_nc_oc=AdrY5qRy1GiY_oN_5QXAmrKsWSeL2pqBB-QTtGhRauMs0qqdO2qgctlg9cLLZNN3gXw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Ol_jZtS3u7BcBAAqTRifAkkzznD78_aguSMDVvOpbw&oe=6AE20047"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0Jz7yodeWgQ7kNvwENcThb&_nc_oc=Adr8TWr9_1rUVM6LA6v_-3nJbSHv3mmGfo1Arw2Hs2KgkU80FXgHG8khftiH2CDRz_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNegJnO_oqSKsreD0Ilj11Lq0xcRoZAy6FVuTswwiAhlg&oe=6AE1EA17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jy7afjgsDYQ7kNvwE2v2wM&_nc_oc=AdoU5rSOiNzJUvZ8feHP66WJ7I-RgNBSjIP8DKzz-E-kTSnq9sooS0UMLXZSb0OKBA4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8940Fbc-ieI3LMre3o4nFyR6KizXPZX6wemfDLxhCeQ&oe=6AE2194F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFL-uLZdLecQ7kNvwFk8SNm&_nc_oc=Adp0oYCJj89C_l6khGMJPe1t36dpQZi1yIw_EcpoZnXoC616Iw0l3MMzNrUUABLasSY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYDRea_3ULlBThmy_5xtoqkXt20hwzhVcpb2QoKTNdJg&oe=6AE1EA75"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psJDftSgISIQ7kNvwFH-RaU&_nc_oc=AdqvmAsWwal-crR6tbamWd2WYzbRe6pARV7wnhDDQPXXf8_uf7P9B_y-t9W5Zj17dRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFilt9vt84T4ANDfNwHKn3CGUFHxdSQTbWxHqvVWoQuw&oe=6AE21C05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmJ_jACRrxcQ7kNvwFCNCCY&_nc_oc=Adpn9bQNbHrBq69OhWSmfeUGodqMqy4nieDH_JGnjapb4oFn-QiI27t1HhUu4dpDhMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1T3titkKt3xIWd6HzuytYPy5PcYTu8KTAWG7l3nYqoA&oe=6AE1EBA1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3mre7_8OQUQ7kNvwHzUyiC&_nc_oc=AdqJpm3kkqqyfOXHKTyRHOdIO2J46YSBGjxYLW92Z_Yn5Grcin68l6wsHVWBzv2h9sk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP931xMoYMdcK6jIk9fXcUNbVzsOJuJ0oKjWM1GpgptrQ&oe=6ACA4547"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkJSumMjUGIQ7kNvwH_FylP&_nc_oc=AdpSperJ_CoIwNHGO0ZSSsuvRxWk5eRbYNoVuEjzmb3QyaJu8hADtWHo3pXnbcbp_Xg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP7jrKfmOh3Z9F0zabvCkvvwjKv_G4jq3yLeFmM6FlvA&oe=6ACA6757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_D5rUroyUgQ7kNvwFm90qc&_nc_oc=AdpRgF9vseMsHK6b6akvuqG7V3qCiBVPOR1I3XgbDlq6Qi-1mlD8JVQrnpSsBv57Gjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgnAtHSvjzXfURTSpgMekfG_hFr9QscK75Jfcp6CyJUA&oe=6ACA5E4F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtGJ4Y1Cv6QQ7kNvwEWqA-B&_nc_oc=Adpmf7SzosENl7Q_5bHYTdKXTiFKI_wlB5T8-4FSLRVm4ezhl4XGJrmuJG0VeoBEHTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIcwopPha1zxZCZyJowVRjZ0FIVG4FiFcOAffUt1iX2g&oe=6ACA67B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agvyZm-gM1EQ7kNvwHqzvGy&_nc_oc=AdptpkYvSUkFZbnQHTS0jEo0QNSdBIsX_24KAHTStdelTEOb7W4K-VPhyCQeMDA8OrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVpV1sQB-BThpfbYToevEcItCY-ZHFkec2cB4tXOefdg&oe=6ACA6105"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ixuuLb3SfYQ7kNvwEq8uJ4&_nc_oc=AdpmpbZnA6LFSf3wNZysPEfTceY3H-m2M3NVl1uJ-F_yfQ8AGLps2NCTlwyqQEMmJIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPibTORaZht9dnWmyr8XVU2LCe_FAlVSiEzN8cVhRVEFA&oe=6ACA68E1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B184fYb0Z5EQ7kNvwGF985w&_nc_oc=AdpQz-hRD1bIG0lcGR-kwP7wefdpSHYx3vddg0mSw9hd0VQPhXRSiQYpyIqFS-Lcs_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS67nKHl4tevQiyDmpR6bSXo2Kjb2dXJAIQInXnANc-2A&oe=6AF1D247"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpwrKjAbHrAQ7kNvwEE-V8m&_nc_oc=AdoiZqS8a6deWMbxVSdVe9Pp_8Bit_6cSd16Q7h-DJXLaD677onyv8j6A0FY40XEz4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFt7m5wiLyw1L5urIFCsukfj61k-7makcVyvj3MMAtAQ&oe=6AF1F457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkJZe0z77cEQ7kNvwFDrsiu&_nc_oc=AdqjhYxI7jsc5-2SXq2N9YejJXBjk-iltcjayFp-mji7MtjsmfWUmB5aCkCl8XFivos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsHPpbusXbnroD3ftITo2TgaeL_FIATIlqfR2c5RJMYA&oe=6AF1EB4F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqZQNjZ0Ih8Q7kNvwHTOUgk&_nc_oc=AdomscDB5_dztT7UrZC2f82oU4jrMHWlrnEpc6mlkqag_ZOp9V07bZSRREs7vOnHQro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwHDd5i0M4exDTvtEXWzoBEZcSHM80WjeahmIxVQ3xYQ&oe=6AF1F4B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYKV8bf55DwQ7kNvwFCwDQR&_nc_oc=AdrZwXNTuifT9Yly00tv8Ub45zLI0bpPV4uyu1RKzHrODJ4AXs_ZwmOD4qnlHnU6zvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsJ_A2LVxiNLfQZWr_QxG6RQIjrb654oVdF2IhM7rS5A&oe=6AF1EE05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edA6JtsudKwQ7kNvwEyxNYD&_nc_oc=Ado7xvivDMfwqh63zJJlWixJuO7abiZ2EUrrrXcc6tBJobPXYX0-bRlcXlmPgHEgnd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTepdfdtE_yaZKnX78kq4sf6erEWZhPxP3StIEBBFmLg&oe=6AF1F5E1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
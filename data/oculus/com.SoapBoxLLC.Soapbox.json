c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkW2ZhTLdokQ7kNvwE1TpcP&_nc_oc=AdqpdxSMcKPVt1I14ghf2rDFl7dgxbD8TLoRfnuEZIHkxfQcdPY0uqmd3VkwaBOTiCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQseURwcobjXtI6mfucGPYVRtUPz0ApIXr5teLclV_BbQ&oe=6AF71847"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KISGdZyVqQ0Q7kNvwFuOF_I&_nc_oc=AdrGS1b7rUAIiBC2QwvaxUivDxfHs6SIY4cDdZ3iiWCbGi3k8j5ODdCIMx3oXxt-GlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQns8oOuwhqPWmKKdzCZM0WO4quZ41DtTNgDL85csJ-ug&oe=6AF73A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMCYuzwuLIAQ7kNvwGmcgTT&_nc_oc=AdoC6t8r18UzzOY0PsoUAaAPhwrYrWb2PgTYPrNwT_FXoObnVqhexj-CSA8MedC8x4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRE_N-DtNjnCYzb3WZwvTtEuC5Z5HO9qg-Gjr8QmJLxA&oe=6AF7314F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBe8XEplcfQQ7kNvwFBUowl&_nc_oc=Adpu4PZBKhyZ4eb9GNpG-91GcAOfo4hj5X3_PQHasK0r8ONTJeuirLrPXXAxJFsqqKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQhBTHffyQPQlSlbiN1lSKHYZhQwWoVYpB6OQemqtUoQ&oe=6AF73AB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4tPnNV-t8QQ7kNvwFMqSnh&_nc_oc=Ado49PWjT84hUwpJYeDvaLL2UPp500RxalK6bRupH6Qq4M5lJnY5_zhuXM-Vo2D2nWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBbOBRBFWdqNbC5DV1fvIwV9nK9-S-hqNHnIspyJ0oFA&oe=6AF73405"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEjFO74V54kQ7kNvwHmJr9M&_nc_oc=AdqMLnROupmAPKbgHoDViweom2xsoYWqVVypPcIOYOfm_x4fUBWTo8lKT511qK7GWzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnzPKsEGboVPMSBMgVt5JZQpS7ydoVDHSzBvocwur2OA&oe=6AF73BE1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
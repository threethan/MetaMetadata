AQRKgUy6si5E3gjmq9sZTMAheuDmLaHwMMtqHHHAwI-Hog&oe=6B099E37"}, {"file_name": "ed roland.png", "id": "1047067571263658", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312454_1047067574596991_3545592460762382153_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBTxnqWfmMUQ7kNvwGi6uvQ&_nc_oc=AdpGI6eWsHLChryAYBVSHOhR6fXRGn7E7HwvEics_LmaKhFFLBrbpNLvqQVWY9etkhg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNGghDYJSWpnru0hjfc4nhU8T1KQnjMb7bUxU7jKDgZg&oe=6B09C587"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csuy3nouqXUQ7kNvwEt95E1&_nc_oc=AdrJt2QRP9icMlZFVdV1M_xoE6ArjwvJUyvpxtuvJ58NTcVq_v-hyOhR6uZs7svlex4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS29Djw2VJNUplVR0tFuluJALrhTEA_CD55QXYUMSm28w&oe=6B09AF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOCKnd_t7A0Q7kNvwEOFRrA&_nc_oc=AdpgLlkBStPxwXCIUiJMOfuwcY59Xj1cK1lXGddX5cmABpyKWjB9U2PLcK8Omz57ftY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi67vsu_H9SDHR9OPZ9FSFfGwKrErmJQgtJDKQAE968A&oe=6B09A64F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfmuFln_42MQ7kNvwH-IXIe&_nc_oc=AdrQoVufTuFH3Yg1zHkQ0CGQhQvRJ5I7hiHQhiqRIk7pd2kHuIj-jISt8zn3UcseYWA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe8dGELkactWl1iNRfGr2C2vnAQUh1_rzkf1fO6aAdDg&oe=6B09AFB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBQp6gD9BU0Q7kNvwFw4ZeI&_nc_oc=AdrXByOtrSmA9f20Fcjpw314jnDegL99w7UCx4ZdzWJh81LSFFFU5ccowNNLu59iLM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvExw8qjbZNHisz_WhSr-GQ01e5ZvS_A8-TJb95DfVLw&oe=6B09A905"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_ca
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9l1xpGSZoMQ7kNvwEDs47h&_nc_oc=Adpkidonw3NfhgUa0488JVhvBWdvEuiUnk8LGXdHWJPzDIFF4lzud3O1FHQqi5HAack&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVeeSCSudzyozG-BMYT7muD4tYvuzbPbO5QiX0yARVrg&oe=6AC25C47"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vesIyvWPMXwQ7kNvwHZABcM&_nc_oc=Adr4938IJ40GA6KAYjUjtjotq4QjHUtQU0YDAdx4AZ3BeZOf9sh5IN5OQBSU6hyM-Xg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuh08Vv1gC46T7bIUtIYZ2gx_imnLOmvw4r3GBQMBxHA&oe=6AC27E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Coh3cr4eFfgQ7kNvwGMBA2W&_nc_oc=AdrnD3DFTR-x-SSWFqKHVfxxrFH4Mz-xkMa100oiqAb09fftVATOQ4BdDgq3g9i5vOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc8JxPPtKWJwb2Zb4UI0W9fS3yIIG-JS_S4ymBPWdmmg&oe=6AC2754F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmx7F66mYaAQ7kNvwHSv5xL&_nc_oc=Adrw3N7dxeILimXlB8mYwHiumJNknVu4RhDno1wOIrFaECasAwxUP0seREO7UTWJIxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjgf3kpajVMZvdy_Y_q6haxCyqKzHmeHgUToyCVA_nmA&oe=6AC27EB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4ahiUVl5MYQ7kNvwH5Nthm&_nc_oc=AdqyDHalTABsUjWFTAN3QzePl9SmrkngboEGHTONLJy9-EiH_OXroGknnwOa9wJwmxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEn4tQ16tDqbqkduCucL5qHtJC2deVjDAGv6JffAEpSg&oe=6AC27805"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxipmmjke6kQ7kNvwFCvyan&_nc_oc=AdpcwuSL6bwACFQGmoePpzdatlmscWliNFanZAbTLsqLJU2kkI9pzrlXtFImhfBsICE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1giSwlyoLfgevLtUeklH8fY-qVQMXC9fXnHObZN2-EQ&oe=6AC27FE1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
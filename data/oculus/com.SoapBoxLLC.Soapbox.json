c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9l1xpGSZoMQ7kNvwHMqxZ4&_nc_oc=AdrQWzmYMZgvcIUBxHW9nGYy1oqWo5_QLZnQjG_pQSI7omZiS0HKgLeMzDSPbn1u5M4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWyiPgr3a8RVKH1jU0VR8XM_PDcC9ZFH3n9GxUGwviNg&oe=6AC10AC7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vesIyvWPMXwQ7kNvwEFg2Y-&_nc_oc=AdqL4dDfXa6ICkrqGVWslJ6YDOKz2jb4RRMjtl60E_1Dp3gobmJrjENcK5EJzq-5ZAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAGw6mXLrrWK7bvEXD40sFq0xUoVO5Jevqb64uMYJGlA&oe=6AC12CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Coh3cr4eFfgQ7kNvwFfbgIU&_nc_oc=AdoohZbBOPGEQkTZjZL-w8ITem47oRbJDBznc1llKVno2FJYA_U7ov5cbDSo5Ut3gmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMKFn5tp8bYBxO3M-qDcUDHmxiSYPW0oKhGNfJC3UuvA&oe=6AC123CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmx7F66mYaAQ7kNvwEguMot&_nc_oc=AdrbkxK0EKSpLhFCSOg43FVPElsWxdUNIvB0sVeWkStHtbqE0sG-qepp659kFfVHHXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3gC09uSxGWEmQ4v-TAk846_D27NTdOy_ERjUTKtrBzQ&oe=6AC12D35"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4ahiUVl5MYQ7kNvwGDRg1X&_nc_oc=AdopzxPdUgqUzrqYtU3VEaGO0B2Bs5WzYWoB57rEh90L1zPTAENYMfIbGrxnB3eY46Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyBIUQYho_ZX90hf2YTQWfa9KFKdNEf7Rw7may1z4kjw&oe=6AC12685"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxipmmjke6kQ7kNvwFPaPwj&_nc_oc=Adr4a_qPBx58OKWb9n4P7bTYLdGC0d4ms8740SgaC6xqXZIge9-9EPWdmjRqdScVNJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJNlklZImpWr-InEhOu47B62_2_YXoGCA8-FyuGPhiCQ&oe=6AC12E61"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
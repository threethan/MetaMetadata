c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGWCZL1p8nAQ7kNvwGjoS3V&_nc_oc=AdrnNMrZtLdz_2f47Jfu7yuIBVvFmU8WE2kUMYMixyaZBU8Zl8WlCDiDPSOx-BFLqU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUMlX63leI2BhSf6-xbwTOn6rxZV8xn-bcKu7HTnPVQg&oe=6ADE0BC7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMWg84g4oj4Q7kNvwHuukVF&_nc_oc=AdrzjQ426WZjuRNwMqdbjnh2_H354BOw-PhoLoAybuiyHsCtN4Z4zBOyI6NnSNYmXgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx9z9J2vkp8Z02fsny9TcCie_xFR4aVtv7wFlpJqKlyw&oe=6ADDF597"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy50tdFmPrwQ7kNvwG22qg6&_nc_oc=Adpeaug_JAWT3bbs396UwYnXUjL3jFBKeaw4u0f6gtsjQCktUKW-o0lOzPJL1JQwiaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJoARuNYxC54RPb2Q_IiriC16YSJgYsQ4R0DH7iaWZzg&oe=6ADE24CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhnjpS4VS90Q7kNvwFt0m8p&_nc_oc=AdqUksj9LPC2ZVtz39CMAFnlLkWSKg-VrK9eRV_FOToro6Ik6ZVpdBLJx66eB0_MgLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfCgyV076p-LRKfgaEkiPs3pvD9iWrad0qstA3MkrTLg&oe=6ADDF5F5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YMlKM-sE5QQ7kNvwG5SEVC&_nc_oc=AdpBM4SyCZmwzyJmQI2AomnlcclR1k8hLHI4Sf2Pa85BREdT6E87-aeyv0rBxbBVvxw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqrlMpzGZEvnsK5aw96NepIG6pnPLawxScnbH1v8eFyg&oe=6ADE2785"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbNFbs1UJRcQ7kNvwGnbetL&_nc_oc=AdrhYwQvoQPwP5tTT8LzxkhNRv5qRD7LvuLdt4sbWUwTylNtPB6YayZA-Md8gBIrIuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0RsjeyxBH0cpVb6Ebpq3Xlr0aAKnUV466nzToSIywPA&oe=6ADDF721"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
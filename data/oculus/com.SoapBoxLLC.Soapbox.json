wPd6rC72t5b04w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSniVpvu5NUctC476vr7aXLBh2dSxzxXkn6FJb22uy56g&oe=6B0DAAD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "4093972847556752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827703_4093972850890085_2002232691968348363_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8mEYqoNFsQQ7kNvwHIrpS_&_nc_oc=AdqH5Yn08L6pf5QUx6QwsdjhrzOQmWmWPTwuTY2M5gco3n7jJ2MwbZZwYnOOlxr4PHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQD1jiRwNmV8EbFqNw1wZK-WWhAn5qorh4TNRCMPwTxiw&oe=6B0DC026"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["concert", "hologram", "comedy", "music", "lineup"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soapbox.us/privacy
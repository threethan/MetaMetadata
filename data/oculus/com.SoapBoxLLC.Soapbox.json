c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_cFduMFnDYQ7kNvwHHdkQ7&_nc_oc=AdpYJlRj1_nEFcL84ath6URVJhlbgBcRfBWyUxeYw7L8ZkegYkYqz_eUvo3ndgR7BqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU4K5acIz2VT_8S9Df91r1-V3juAOx2ezcF0TEQ8YaOQ&oe=6AD22E47"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpEqvpTgYloQ7kNvwGw_G86&_nc_oc=Ado5niDRckMXDIvB-__8qjUGqGLtiMCcwmJ_KdIRr4MgvIpuYBQ_lvIEHyrsRQ33S6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6FthCqHDGjLJdJ56uzLUFd_MtvgVFjbNY3XCyHjpv3A&oe=6AD25057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUuyXK2KGoUQ7kNvwGpor8l&_nc_oc=Ado0r4XD2g4TC1dYF1MI-zE2TC5mYRpD_m54ZE8zhc-e10cN8JCNXegrlT47BDKhZis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiIC6hc9F9en4Pp66EF6FfVs7eUKqtq5QIYL_PfXGjAA&oe=6AD2474F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7GgzSCkkswQ7kNvwHXMq8I&_nc_oc=AdolViW7qyHm6QZsx6UvIaiTNi34W2Z03ux8SXKnfDI7lCjT0x4yC2OHcRJjyw5AszI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOOjLD0807KpSvw5XgfMytGfB_NbLJ93L4o6hy1LxTeA&oe=6AD250B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2cIJdNoYMYQ7kNvwFSmpl0&_nc_oc=Adr7PK5zeyIyw9sb8szGuftoBoiNZXt5b7zpggJ1ahNPEoM-T4XmqCkiRobeitlvcv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2JmOMca9i2_qdNw6QvfjzOK7SvjFjKIv2G1BqrNj1Bg&oe=6AD24A05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-bXQnkdsAcQ7kNvwE8JEqC&_nc_oc=AdomUEMV0aWwJUHEbmjZAC9NigKPVn-qrClacdiOczT4bOdkgCXz1YdHQcFhdRPcOU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0EjSxEpWs56Jp4WqMHzc1u-9lrUnh2GmFz-xlxzMpsw&oe=6AD251E1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B184fYb0Z5EQ7kNvwHNtqNw&_nc_oc=Adqf25wm3JVW8LbQcg-TqmrAyiVG7GvrVjO7rc2ZDFE0NsH8QN4J415b1eMf23P5GlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9mw2Fa9Qc6NMaFanjdbDUOwh2RNJGZArJGzvAzK0X2w&oe=6AF080C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpwrKjAbHrAQ7kNvwHmBFEV&_nc_oc=Adq_CQ7D_LRpmYe2umy42en2QDWKePaOgG7t2_25j_7azacdmpaLpN4egWAxNWCxkbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREz5R4N_DUypnGM6Pd8Yri-HFsZIpeuJzEDvsK7TVS-A&oe=6AF0A2D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkJZe0z77cEQ7kNvwGEfuow&_nc_oc=Adp-zXfOgZYIhHzSVochlteFh-T8hXrvT8MSB5vVKJIwkEQ_wcw5RXBdsOnQhV8FVWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-bljn7wxPVXPVpFBqf-6vq5AKqIovAah192bo09zYrA&oe=6AF099CF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqZQNjZ0Ih8Q7kNvwEP04CF&_nc_oc=AdpiUse0yy96t98tVH3Z44Gi6PeT7FJELBZajEFHoxYu8jORBSbrq-w3lj2GA3GYwBM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPQmKbTkE_yHL6ha0_H-d6PR6g-wV0tJByok_tfQnTsQ&oe=6AF0A335"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYKV8bf55DwQ7kNvwHZypRB&_nc_oc=AdqmA0SuWoFJnxzeSTplDTRP3XtUYswmHwOXJlQ87a6TItwncIOEXxN_ZJLf3pYX7qw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhXisGfkgqnACktghsmjAfP-VA1rbMGsRdZ77NUz6Uxg&oe=6AF09C85"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edA6JtsudKwQ7kNvwG-e50W&_nc_oc=Adrkqb8ptXe1D1I3auKPhQcbUaar9PYXU_qprGWfT4wnZO5S9WEon2E7LXjvb_bvtXc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ611cHmqw-q_X85dQ2wR06hdWvlxoAggHli1Ln5Q0e1g&oe=6AF0A461"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
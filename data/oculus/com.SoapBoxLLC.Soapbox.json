c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9l1xpGSZoMQ7kNvwH_Qs4k&_nc_oc=AdoaVdxzXNmB7iHtxS4wcs4wN145itN7zFJgiEZ-MSUYwkWSujpk-aCZinFGufhP4Lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4qzHvyUkVZeQSbKvaBLxUJySQ9MrbU0XJhhs1gy8-Uw&oe=6ABFB947"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vesIyvWPMXwQ7kNvwEJoXZ5&_nc_oc=AdpJDcvHR2ADmC05nfQVbjZwhbUvEte4V5ThHAnKLS_T9mUsHlHEG_TQlyBp_96C4B8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaWRLMrXnGTIpCxxpFi56ddij6E8QhKLUDplbl1U7rYQ&oe=6ABFDB57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5klR82-rr4Q7kNvwERLIq2&_nc_oc=Adp5iN2G9Vh5id8CyLSY6U0DaDKIYdjXEI2ozz59cU0l1f3dUvXVo93Y3k9f9CbDzfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQI7EFSZU5jEO7I4ic0xEppQff-V04d81FU2Bl_8_MWA&oe=6ABFD24F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cA-rjLxBa8Q7kNvwGfwVIh&_nc_oc=AdoC6gLkQlWH59ipZYlv5HW5agptxxkzyzyAHYVEYkcEtJs7WdMAzvVlsaD4v3o3n-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBQ9hSTmkl1siCQ7xwAxAU3eagI_dmmIylasoeshLiYQ&oe=6ABFDBB5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4ahiUVl5MYQ7kNvwFPWw2d&_nc_oc=AdqFNWr5jPG0A0hyJ0AVWo7NxV4sOl_xiK6RFY6DE0Q5XMcol6O-uKFMIfuosxqAysE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyzBeVy3w-Oev-fdnIfKxLI4zHzIYflR505Ji6uempmA&oe=6ABFD505"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gug8b7RuftgQ7kNvwE0baEv&_nc_oc=Adrpwxke897m8fANhkzW6pNxrbeET5WQ0Ptu3aHghdl8xmS6ojlTtqtg8WFUAEZCLBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlyw_GKf20v7Nk5lt3NivCHqjCGo_ZmrhywMK9O9ZqaA&oe=6ABFDCE1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
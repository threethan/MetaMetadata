c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0nxX3H_iQsQ7kNvwG82WLk&_nc_oc=Ador5qQov3_yJ6LrVqyr-0mCUFocCSnGkvliQLHiyIL8aWf2105qmLSn4iTUk63oKaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0eQe2jW0e6CNCnpOgiUOASvOBLp6a28_hEYQgVJ-ceA&oe=6AE4A347"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ7aqkhvA_cQ7kNvwGXuLNe&_nc_oc=AdrpidqJnGQpo-F8Nv-wQjfbndCyxHUqz5KuOTxXt-4sK5u7V5rM_C8YneOEnlEiU_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHwpvpIar8KZhGZfOeIoZ_UtYnaOaLagBVpSst67rpNg&oe=6AE48D17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTexUmKUs40Q7kNvwGzMXsl&_nc_oc=Adr_xgmGuzS78KlUB6ScRDmTyfpnD51mlpggg62Ck-aYXis6kWDcfMI8PrNU4w_6ZNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr7TVQDDlvzeRNi3Zfg85NBvkodPSjzDdigXKjAANaAA&oe=6AE4BC4F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13RIjcQE1ecQ7kNvwGicY4J&_nc_oc=AdpzOnj9SH9gX3Gq_Cy3CTeEIiS3yWNQpQ1O5t3GT0bl51AyrAVRFGcqI0P_MzP20dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNrKB6-su5PtQlC5862pogRG7Z88fWKo2wXOVXyouFzw&oe=6AE48D75"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFjMda5G5kAQ7kNvwGHe5rO&_nc_oc=AdpaOQie-wh1JZydPlocluaYxMIjQljj3n56XkoAR6tl1OQAOHL24YXh7d2bE0CFPaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtGuvfXHD8-njeFfTEOj_3G9P8bWdZQZXuye8y-lGTVg&oe=6AE4BF05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=808vyGQBjHwQ7kNvwGsCkOr&_nc_oc=AdoFMdjGWruwyZQOcr5SHw5KjJkzsV65p2FSjBWwrT9OsGiXw6FZFaR5hEnai3Dvu5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn3fZaLms0asxRIJ5vZfFreKQXDZ4UQ3txGhlg85xJ_A&oe=6AE48EA1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-YgFs7lPMkQ7kNvwGn2CFQ&_nc_oc=AdoM8u4DsyNcI4VYCirWCwUg7wsR7_gOIszqO4oWLbEX4fVeJ2F3kXpWa-wmEMafk4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAleAvkDz366kIl0uXueknQl697YWyzoFIVCSXgOYClw&oe=6ADF5D47"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMWg84g4oj4Q7kNvwGSqh_R&_nc_oc=AdpQwEJiXCkY6yD0gdE60SLQ5zVR6EURR9iZ_isniSJRfdF6rf5WS6ZihAype0dQCd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEbBsNRu9BY_46fJgI5bbo51QoAbVNwIPVexCWrPwHag&oe=6ADF4717"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy50tdFmPrwQ7kNvwER-Xe4&_nc_oc=Adq7j2PmXCIZGDdsDJYCJQak5K6he47Xb28Wk_snoRpzrN7gxqYgQWyEJyYD4vbhpKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOIEJkNwFM0WVdVjr9WmlQcVvtYDk6DMQwUmvGwWIzOA&oe=6ADF764F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhnjpS4VS90Q7kNvwHMWECo&_nc_oc=AdoH2IIsXfcJSCLBzk7KEh2VMR7hSVgG1LMZplPCEfzBSCR1tWW4ed96d0L8Dh_OotY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB44-_li2XIcsFDKffdS8i2mASa_zmhyiFJW41e7MlNQ&oe=6ADF4775"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psJDftSgISIQ7kNvwGaYrhM&_nc_oc=AdoayqUn14QZqwk_JSnksv1j3UshwbbuzARlBoOojP4UwESVWzCNefge91ZBVU9yWIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-e3tHdwoaFf0lKSGxU20Wa3WYEBZZ8XN83vqEUDQ7JQ&oe=6ADF7905"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbNFbs1UJRcQ7kNvwERLajP&_nc_oc=Adpb3_w-Q4eMCYrJ-gJ7qDI3U4gBHkh83eHLkiT7S6s2uRMutFjHIbMutPiVTP1lgjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDPt8eEQ7nLwf_w9XyO4--vlGsbNjll4oxHo7Dwfvp4A&oe=6ADF48A1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
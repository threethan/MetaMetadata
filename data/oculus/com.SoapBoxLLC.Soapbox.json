AQQs7imrz6nL2IVclRedqtrEbt3hg8rgVL2cw3nsMCQ5Qw&oe=6B0C7977"}, {"file_name": "ed roland.png", "id": "1047067571263658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1047067574596991_3545592460762382153_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbZv_GiU1qwQ7kNvwEUlyJq&_nc_oc=AdqQk7y_PgSO2WaFnXaM8jwL3RhRR2Uk-ct0EyZ9DeoCw-tZa1KJPHp2SN7Q55w5epo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjmv6C4J765Ju9xi1huC6_lseNuUXH4KKgjJZ7o-kS_g&oe=6B0C6887"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6RGfPLpbzAQ7kNvwGA69hr&_nc_oc=Ado7-uwBbLBQ33L9UwU3KmHqCChshsNUi5Ift6K_CZze1vjaGmv5-d5tKLHbEv0t3ZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVXZDUMK2ZgkjLNSJ4jqOTuWJsL7-cnPlkoHUKelaWaQ&oe=6B0C5257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRrFtfF1xJ8Q7kNvwH236qc&_nc_oc=AdpjcCptqNnO7TJe63JwJS8l2vqPT6gw-Bl5rVHqAA61dNASgn7lB5jvmcIFswlibN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQboQZ1SxWsipXDbR5tK2SG6lYVZc3N27QISL3X7u3dww&oe=6B0C818F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_qbGWG_rScQ7kNvwE3OI7D&_nc_oc=AdqBhS0LnAZggDmEZa7lJPCKSXBIMcRyhv_OnIhqBj1WYqe0G09_-qoDWMIQ9Lnb5Os&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhfgM7I_-YxdLUoBymptQgKvsfjKVtwMtOR7ZO_Eno9Q&oe=6B0C52B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xj8T100mIQoQ7kNvwHKxAsF&_nc_oc=AdruzvD0oLYc2L6eZaM-u92TYYm66B-ZCcCjPdMFbx918bxr0M5Xdj8qiVoRAyOUTxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYl7cZvd1HD900FXDs-zuOH-vDB1NoO_cqGIlXM1lOMg&oe=6B0C4C05"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_ca
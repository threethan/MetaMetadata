c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by7tuGSaSUcQ7kNvwG64AAI&_nc_oc=AdotijdPloHZ0-HXiHW_njGL04tP5lqeTutCDN93u6CWZzDIDeGOY_MXDXEfmywXIYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZawAysPcXPma4KGofartj5hCn-TT3Canb8GWLcwPiUA&oe=6AE74647"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0EcWgzOwRgQ7kNvwHBme3N&_nc_oc=AdrFPQkTDoSycxedHMD-DyAgu22EtSiQlKu0JXhVL9EU73Wyqg-hMdgWZGnARDyZh9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_y5spBV_0Obg8r7JQiAOFKFyhMbl5fvYCbYAdbfYjQQ&oe=6AE76857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTexUmKUs40Q7kNvwHaiEg_&_nc_oc=AdoNxdNhBpHsjg7OJ3W7fSRsFaU1t7z0sFyoYz_-dhJ6qVe8B6lLNdaEm0TAQM7rwis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4qEmgekCnBA3Ngrq2TctcGQ-KZsfnAStWrx3QwWm2Ow&oe=6AE75F4F"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13RIjcQE1ecQ7kNvwGYeXi8&_nc_oc=Adprk2Asca_jQmZNdEnORyHffZ80oAO4xuBLc6INpFfu6S4T6T1nCs7e_2AAWOwR1Bw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE8X9PmhhTbH-duzXZDK8hlLX_5fspFNJjieMOwpOnKA&oe=6AE768B5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30ZM1J9Xik4Q7kNvwHLgXkI&_nc_oc=Adqo4HBayIGfl1KMumoUWR_z-6c16nNv4qaLflavbLDlmZiVD81NtWc7mCQAXizqv3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9J6fk3QqrhVa9TaKCK9_tI7zrWCCybb7O4mHTjP3jBw&oe=6AE76205"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=808vyGQBjHwQ7kNvwGzb4Fx&_nc_oc=AdqOt4r-MyPR7-xmPIVSkeM15zVT9boJ1Ek6JLm9YiUDtXU6WKLDDp2InvYUuR0NFCk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReYNlRYnvCLmKUFoAlUKFeZ2RFjelmlgp6WwInhmMzEg&oe=6AE769E1"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
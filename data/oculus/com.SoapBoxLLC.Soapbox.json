c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0nxX3H_iQsQ7kNvwHjzzQE&_nc_oc=Adr1oL55bXPzfZ682dHY1O3ObGYtie2L9u7r-ouXNsyyP8FejZuWLgt_fdy-CPHZ_EM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBqjc_xDV4lAWpNz-QdxB106V3MUYh762axdDiLaLq-Q&oe=6AE5F4C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ7aqkhvA_cQ7kNvwFgWxyu&_nc_oc=AdrnaiG79HBnH7S6HG_oarD63bYdwocynrDuMWitPU35TzfOYt7nTAme_ColUWvbGVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgzhiJiKz6hh2ugvPMNkiF29IQsqwsV5Rt881IFva_0g&oe=6AE5DE97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTexUmKUs40Q7kNvwFTRM-E&_nc_oc=Adp8VTkrI6DRXPTzyID_9AkpDFVzqLYfBYaMVo92ujdpPG_ffFBRTQEctnbHHKlPdxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvmyecMyC1nzFeABZNWSPFFOAO860OiqIeGD5xIlm0zw&oe=6AE60DCF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13RIjcQE1ecQ7kNvwG_VUnK&_nc_oc=AdqTi6Zw1m1zJec4yWZS1s7nD8FzlsSJekP5pNLVDNnsOquTu3wn6i-y_t_MyjeaUts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUBfMQwqzS31vKprFHqJnj6IXTlipU11ZvGSgVlzCcJg&oe=6AE5DEF5"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFjMda5G5kAQ7kNvwFhZ9jC&_nc_oc=Adqp_2E6UMb9xhfHhqLXOVaKfoJ1-ZDbpiBbbyu_dLHAF0FoYnRZUmchC5UDdkuzC1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHm-ZY4XCm0Q-TtxbXo6DZXWNoj8uhbQh56NLAvHx9UQ&oe=6AE61085"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=808vyGQBjHwQ7kNvwEmFCnr&_nc_oc=AdqGZY7uhhaic7FUHdZph6XZWQNArOD2IuPesefNrcaBlX5mU9iU0TkYbACOnh1XPFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRJwArFAGyqL97nOOMl34ORFq13D7L1NRiNWiawOmwAw&oe=6AE5E021"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
c_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWk7eIIjo3YQ7kNvwGPDKuc&_nc_oc=Adrp-BKS59Mhs7t3nvWY9qJT7Bl_ZoJJ7XMetiZo2-3XcXVidRqZq9XdM2vrf7nAtG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCeLiAenJQEt2wMRwvBQZ-LUhUwoPnlcU9ZmLxrVP29A&oe=6ACB96C7"}, {"file_name": "1.png", "id": "1592824024803033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1592824028136366_2785707857221777252_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qtRAzjMX0sQ7kNvwHTa44B&_nc_oc=Adp-uKQ-T3YgIbhDZ82wzha0lhS8tPh2aU7mTYKAwPwNThUR4UrPd1-UpUGX0GQc6TI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5OI4ke-oGpoY3kVwXX6vhzSLelnShQD78SZBQwoYePQ&oe=6ACBB8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_16-9.png", "id": "1819072665376918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1819072668710251_7353430703769565817_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_D5rUroyUgQ7kNvwGjgxRX&_nc_oc=AdopvmIVS3hW55atLyhjAUdWJEoj1bX2_ST2n5Zj4C-NVyB9CBY688ZKig92NGO3u20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG5sQTxsJxzuStCIzzzjMvQF5XOykgz7RAza4ORI_lcg&oe=6ACBAFCF"}, "display_name": "Soapbox - Live Performers In Your House", "keywords": ["hologram", "comedy", "music", "lineup", "concert"], "long_description": "Soapbox puts life-size holograms of real musicians and comedians in your living room. Walk around them. They are volumetric captures of the actual people - not avatars, not CGI, not 360 video.\n\nBuild an Instant House Show: pick a lineup, queue performances back to back, and watch them appear in mixed reality (passthrough, in your room) or in a full VR venue.\n\nThe catalog includes T-Pain, Buddy Guy, Yelawolf, Soulja Boy, Jim Jones, Waka Flocka Flame, Norma Jean, Tank, and more. Plus stand-up you can put in the same lineup.\n\nFree to download and explore. Unlock premier performances with one-off purchases or a monthly or yearly subscription.\n\nSoapbox is the only way to have your favorite artists appear life-size in your space.", "short_description": "New users get 3 days free!\n\nLife-size holograms of real musicians and comedians in your living room. Build an Instant House Show: pick a lineup, queue performances, and watch them appear in mixed reality or a full VR venue. No avatars - volumetric captures of the actual artists. \n\nFree to download, with a catalog you can explore."}, {"images": {"nodes": [{"file_name": "splash_portrait.png", "id": "1770420413866405", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_1770420417199738_9163659578469219972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtGJ4Y1Cv6QQ7kNvwGKZLAx&_nc_oc=AdoeRnFX1OAVlpNxSwH576JtAa0Tq2D755CunLsn49aPwQR7qZnp1XJVRiMEQYm_DWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKOLp2GPJXFBVc80OcmoSR8W4pII00RVEuiwi0sjkmEg&oe=6ACBB935"}, {"file_name": "splash_square.png", "id": "1433199797716384", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1433199801049717_1165102973676556133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEbO8CRN2jkQ7kNvwEFUkbc&_nc_oc=AdpO9TZ3z9L7MeL7YMmVtFNr7wgVVF_OvVZdbkFF2-MW5jMUz7OyueZyQoNGdveRpSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd7qwM7O4Nct4iNxoK2zK7_U25m6RK74e9XNauVaGbTA&oe=6ACBB285"}, {"file_name": "meta banner.png", "id": "1408416804241288", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305071_1408416807574621_5283805827554035897_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ixuuLb3SfYQ7kNvwEITAYR&_nc_oc=AdqimQSWCI64GzlcR-vZ3stqg2ypBGdsUGD7Xc6sFluULa746tCP6OpVz4Aaed7akgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9iCQ1aWsBvjxGdkbpzK_7W63d1xUpnhnQrX0tA1LeGg&oe=6ACBBA61"}, {"file_name": "SOAPBOX SQUARE.png", "id": "1104510041591102", "image_type": "APP_IMG_ICON", "uri": "h
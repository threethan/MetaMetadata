nc_oc=Adoub_1uV2wvJb1tHKknMb1f8v3tWT4i323G6QG8tjC_G3RKNLGsjyFMYbtDZckKbqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnqSonM8XZwT1Bb9whzYAfhERfZAbpLPO15dTIK0EuSw&oe=6AF5C7F9"}, {"file_name": "Picture2.png", "id": "903067866108988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_903067869442321_5144318187613777870_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66AmzeS7SN0Q7kNvwGPWnFC&_nc_oc=AdqsgqO4NTjHsHoe8XhXvjSByoBrUxSysjUaT1U5FsIUFP4lRK3AFCrBcABbf7bLD2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScja7Evt0ABZ8Zc9loChHCjzcWrxCRbY1C5p7DvXueTg&oe=6AF5D1DE"}, {"file_name": "Picture4.png", "id": "1027974809914580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623295_1027974813247913_4654330529916905080_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSBiLbJUmjcQ7kNvwHHKL4W&_nc_oc=AdrIyTSLvIY29dG8nBYlqbkh_vhuwVgFz45_r-12t5XYYZBH-NmyjUooehTwCHoM0qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIGoxltVB5rAlLTxz3Un8SSRamOHkil5qCw1vUrC1BHw&oe=6AF5D578"}, {"file_name": "Picture1.png", "id": "1654115786221145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310819_1654115789554478_646590424254145239_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NL0Aj5YLT8MQ7kNvwGVbUk8&_nc_oc=AdrURoClQp_Twv3wFYOus7ltV3ZlvPWh71ZOgGFmTu9QB2goCVCwid0aCYQcvklStUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYa_bv-6x935-pdxCemeqP1tUhf9a2AGAaSyVD0DkhMQ&oe=6AF5D0B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "InfiniteDoorsCoverArtNONAME.png", "id": "26464258156609552", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820058_26464258176609550_3227176034539966226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS0GAeuvHTMQ7kNvwGJc60I&_nc_oc=Ado_nblqD0CXSS1IZMncNMAWE9d1sQIAVS0Xk0SqZjHNh9gNw22i_X5pD43ymdzech8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShMlTJR8VY9B6S87VVz2q0N1ZJTH8KRXF6hgK4jymREA&oe=6AF5F080"}, "display_name": "Infinite Doors", "keywords": ["doors", "door", "infinitedoors", "doorsvr", "games"], "long_description": "# \ud83d\udeaa Infinite Doors\n\n**Infinite Doors** is a multiplayer VR horror game where every door could lead to something different. Explore randomized rooms, find supplies, solve puzzles, and try to survive all **100 rooms**.\n\n## \ud83d\udc65 Play Together\nGo solo or team up with friends. Use voice chat to communicate, warn each other about danger, and stay together when things get rough.\n\n{3673385032824172}\n\n## \ud83d\udc41\ufe0f Watch Out for Entities\nNot every room is safe. You'll encounter different entities with their own behaviors. Some chase you, some hide, and others require you to pay close attention. Learn how they work to stay alive.\n\n{28687845117576769}\n\n## \ud83d\udd11 Find Items & Solve Puzzles\nSearch rooms for flashlights, keys, tools, and other useful items. Unlock doors, solve puzzles, and make the most of what you find along the way.\n\n{1738863793895972}\n\n## \ud83d\udeaa Different Every Run\nRooms, items, and encounters change from run to run. One door might lead to a quiet hallway; the next could put your whole team in danger.\n\n{1610060823355010}\n\n## \ud83c\udfa8 Make It Yours\nUnlock cosmetics, earn rewards, and discover more items as you play.\n\n{1843431020128329}\n\n## \ud83d\udd26 Can You Reach Room 100?\nThe farther you get, the more you'll have to deal with. Bring your friends, keep your flashlight ready, and see if you can make it to the end.\n\n**Just because a door opens doesn't mean you're safe.**", "short_description": "\ud83d\udeaa Infinite Doors\n\nInfinite Doors is a multiplayer VR horror game where you never know what's behind the next door.\n\nExplore randomized rooms, collect items, solve puzzles, and avoid dangerous entities as you try to survive all 100 rooms.\n\nPlay solo or team up with friends, use voice chat to warn each other, and figure out how to survive whatever comes next.\n\nGrab a flashlight and see how far you can make it."}]}, "developer_name": "RomanEmpire22", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Tu4PihuFZZ6RNw0V1I5v9cacKZ6dDIEFWxHAQ1DiqQI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ExoPlanet Minus 57", "support_website_url": null, "website_url": "https://exoplanetminus57.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28660933570182501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622162_1504320567909149_8707363057272655240_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rl923lIc8VYQ7kNvwHMqYeN&_nc_oc=Adp2tXDkX1Qheuqq_aRvEhkob05kBZ7WkXqJ2F2fJSt5MIFT6_sFuBRFLfcmD9JPpas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSugNthz9d9kKZr4gBk5U6GJSWKI27Yf6L5GO7Ojo7bbA&oe=6AF5DFFB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Infinite Doors", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name":
name": "Picture3.png", "id": "2386888718461154", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_2386888721794487_8454748081722757585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdf0QlGZ6AoQ7kNvwF9-tAQ&_nc_oc=Adoub_1uV2wvJb1tHKknMb1f8v3tWT4i323G6QG8tjC_G3RKNLGsjyFMYbtDZckKbqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnqSonM8XZwT1Bb9whzYAfhERfZAbpLPO15dTIK0EuSw&oe=6AF5C7F9"}, {"file_name": "Picture2.png", "id": "903067866108988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_903067869442321_5144318187613777870_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66AmzeS7SN0Q7kNvwGPWnFC&_nc_oc=AdqsgqO4NTjHsHoe8XhXvjSByoBrUxSysjUaT1U5FsIUFP4lRK3AFCrBcABbf7bLD2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScja7Evt0ABZ8Zc9loChHCjzcWrxCRbY1C5p7DvXueTg&oe=6AF5D1DE"}, {"file_name": "Picture4.png", "id": "1027974809914580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623295_1027974813247913_4654330529916905080_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSBiLbJUmjcQ7kNvwHHKL4W&_nc_oc=AdrIyTSLvIY29dG8nBYlqbkh_vhuwVgFz45_r-12t5XYYZBH-NmyjUooehTwCHoM0qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIGoxltVB5rAlLTxz3Un8SSRamOHkil5qCw1vUrC1BHw&oe=6AF5D578"}, {"file_name": "Picture1.png", "id": "1654115786221145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310819_1654115789554478_646590424254145239_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NL0Aj5YLT8MQ7kNvwGVbUk8&_nc_oc=AdrURoClQp_Twv3wFYOus7ltV3ZlvPWh71ZOgGFmTu9QB2goCVCwid0aCYQcvklStUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYa_bv-6x935-pdxCemeqP1tUhf9a2AGAaSyVD0DkhMQ&oe=6AF5D0B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "InfiniteDoorsCoverArtNONAME.png", "id": "26464258156609552", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820058_26464258176609550_3227176034539966226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS0GAeuvHTMQ7kNvwGJc60I&_nc_oc=Ado_nblqD0CXSS1IZMncNMAWE9d1sQIAVS0Xk0SqZjHNh9gNw22i_X5pD43ymdzech8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShMlTJR8VY9B6S87VVz2q0N1ZJTH8KRXF6hgK4jymREA&oe=6AF5F080"}, "display_name": "Infinite Doors", "keywords": ["doors", "door", "infinitedoors", "doorsvr", "games"], "long_description": "Enter Infinite Doors, a multiplayer VR horror adventure built for players who love suspense, teamwork, and unpredictable scares. \ud83d\udeaa\ud83d\udc41\ufe0f Every door opens into a new room, but you never know what is waiting on the other side. It could be a safe hallway, a useful item, a locked path, or an entity watching from the dark.\n\nPlay with friends, use voice chat to communicate, and work together to survive each run. \ud83d\udd26 Search rooms for keys, tools, currency, and clues while avoiding dangerous creatures that react in different ways. Some may chase you, some may hide, and some may only move when you are not looking. Stay alert, listen carefully, and keep your team close.\n\nEach run is designed to feel different, with randomized rooms, spooky events, interactive puzzles, and moments that force you to think fast. \ud83d\ude28 Whether you are opening doors, hiding from monsters, exploring strange rooms, or trying to reach the next major encounter, Infinite Doors keeps the tension building.\n\nCustomize your experience with cosmetics, discover new items, and push deeper into the unknown with every attempt. \ud83d\uded2\u2728 The farther you go, the more intense the game becomes. Darkness, sounds, and sudden surprises can turn even a simple room into a terrifying moment.\n\nDo you have what it takes to survive the endless doors? Gather your friends, grab your flashlight, and step inside\u2026 but remember: not every door should be opened. \ud83d\udeaa\ud83d\udd26", "short_description": "Step into Infinite Doors, a multiplayer VR horror adventure where every door could lead to safety\u2026 or something waiting in the dark. \ud83d\udeaa\ud83d\udc41\ufe0f Explore endless rooms, survive creepy entities, collect items, solve puzzles, and work with friends to make it farther each run. With voice chat, scary surprises, and unpredictable rooms, no two games feel the same. Grab your flashlight, stay close, and don\u2019t trust every sound you hear. \ud83d\udd26\ud83d\ude28"}]}, "developer_name": "RomanEmpire22", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Tu4PihuFZZ6RNw0V1I5v9cacKZ6dDIEFWxHAQ1DiqQI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ExoPlanet Minus 57", "support_website_url": null, "website_url": "https://exoplanetminus57.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26477098968565983"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1864570321110139"}]}, "baseline_offer": {"id": "1864570321110139"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780678800, "status": "PUBLISHED", "id": "1864570321110139"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28772625795679944", "version": "1.2.0.2ab"}, "id": "24832541573066062", "channel_
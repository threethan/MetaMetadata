88333116759186_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sao_Bc-X8IIQ7kNvwEVC7AJ&_nc_oc=AdqQcaNccmLYgDiQSYHpEoiWLA1DwpFB9i71Qm8o9EabK42d4qWuSSIokQs5Q4OmZME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoBExRqwoXZbF6rHZQI8q5uZMolVWyngiQTpoviu0GCA&oe=6B01C5FF"}, {"file_name": "fireArea2560x1440.png", "id": "4320093054920613", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_4320093058253946_4233111400272070185_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac5OWsSbC5oQ7kNvwFQssko&_nc_oc=Ado-IRBNhoTfgzgitkr21sNpyRjCzNukfc8xXXf6VGy9IlnGJfZsRCsH6lQbNYh6IZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGjc_xHR8m8ws1BnCePcqwmfLXWIYagmZgNp37a5tHhA&oe=6B01E0AF"}, {"file_name": "GunTables2560x1440.png", "id": "1318482140469735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673522158_1318482143803068_8363564202732718787_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI0jK48QFmEQ7kNvwFjtiGz&_nc_oc=AdqIjf5nv42RJpKDIfWc8t2wGTt4yocVvmG076v_Kj0ZjEsUvohkwhhmqPAcdx54JEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH5UzBKq8SpMGjqsob3kpJJD8uSytiuB65DIo6MYQOWw&oe=6B01ED74"}, {"file_name": "gorillaInFrontOfWeapons2560x1440.png", "id": "1359645336144847", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1359645339478180_6600311528602736260_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ab3Bzh51a4Q7kNvwEz5jWm&_nc_oc=AdrJKDNDNTd-3RselC4FxNsGkHCcD9TMGbYDAwg2DVIDrYOpXLWKRy8BXC-PgEzC3nI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn3sBr8_ZoJiN0W2ZaahIOVCa-w07KsDKjzBM8DfyQxQ&oe=6B01EAD9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Team Racket", "keywords": ["monster", "creature", "explore", "scary", "multiplayer"], "long_description": "Step into **Team Racket** and head into the **Dark Forest** - a tangled, secret-filled wood that no one has fully explored and lived to talk about. The monsters prowling the world aren't just obstacles. Defeat them, win them over, and they'll fight at your side.\n\n**\u2694\ufe0f Battle & Recruit** - \nTake on wild monsters in hands-on VR combat, beat them, and convince them to join your team.\n\n**\ud83c\udf32 Explore the Dark Forest** - \nPush deeper into a mysterious world that has secrets that have never made it out before.\n\n**\ud83d\udc09 Build Your Squad** - \nCollect dozens of unique monsters, with new monsters being added each update!\n\n**\ud83d\udcaa Train & Power Up** - \nLevel your monsters to take down tougher foes and help take on the bigger mysteries waiting in the dark.\n\n**\ud83d\udc65 Better With Friends** - \nTeam up to explore and battle alongside other players.\n\n---\n\nWhat is the Dark Forest hiding? Suit up, head in, and find out.\n\n*Play free on Meta Quest today.*\n\n\nTeam Racket is in Early Access so updates and content additions will be released frequently!", "short_description": "You're part of Team Racket, and the Dark Forest is calling. Battle the wild monsters that world, win them to your side, and build a squad strong enough to join you on an adventure deeper into the dark forest than anyone has been before. Explore what this new world has to offer. Catch monsters. Uncover secrets. SURVIVE the mysteries of Dark Forest.\n\n\nTeam Racket is in Early Access so updates and content additions will be released frequently!"}]}, "developer_name": "LucaLlama", "developer_privacy_policy_url": "https://teamracketvr.github.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "LucaLlama", "support_website_url": null, "website_url": "https://teamracketvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890
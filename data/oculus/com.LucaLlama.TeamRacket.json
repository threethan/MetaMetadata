pcUpIylLZNYsJuUu_-yLpg&oe=6AA9393F"}, {"file_name": "fireArea2560x1440.png", "id": "4320093054920613", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619751_4320093058253946_4233111400272070185_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11KcEHp_vZ8Q7kNvwHs4v1d&_nc_oc=Adrhc9G2vxKsa2JMsybAaYYf2f72vFBfFOA_ev9LhTNG1xcozuNcK7PI5yrB6ZSZ-54&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPt1fSq7rY7VlC0SLF1JuiDCKHaM2h95o3j5yEAVtKyA&oe=6AA953EF"}, {"file_name": "GunTables2560x1440.png", "id": "1318482140469735", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/673522158_1318482143803068_8363564202732718787_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLHWXsYenTMQ7kNvwFgFtMC&_nc_oc=AdpD9vlbwEuhrhHPpE3mWjzCLnlUdTzN2n3n6h0GnwhktcwbuMUhtffpITy_km4ZFS0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3iGb7va1TjW2B3EFTfJmremCr2GrzM4ZwJ3Ol5AMQ-A&oe=6AA960B4"}, {"file_name": "gorillaInFrontOfWeapons2560x1440.png", "id": "1359645336144847", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619681_1359645339478180_6600311528602736260_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkh_Zljvk_8Q7kNvwFmIYam&_nc_oc=AdpdSg5n0cUGI9of52IjNRMEVT69YbHvI0rQ_-FO-hqmxqgwBG8MLL2g6OxomOo13lo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNgWTu-BmskhddWBOIyql5GMe47Mr9xKvLUTmAuS0oRQ&oe=6AA95E19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Team Racket", "keywords": ["monster", "creature", "explore", "scary", "multiplayer"], "long_description": "Step into **Team Racket** and head into the **Dark Forest** - a tangled, secret-filled wood that no one has fully explored and lived to talk about. The monsters prowling the world aren't just obstacles. Defeat them, win them over, and they'll fight at your side.\n\n**\u2694\ufe0f Battle & Recruit** - \nTake on wild monsters in hands-on VR combat, beat them, and convince them to join your team.\n\n**\ud83c\udf32 Explore the Dark Forest** - \nPush deeper into a mysterious world that has secrets that have never made it out before.\n\n**\ud83d\udc09 Build Your Squad** - \nCollect dozens of unique monsters, with new monsters being added each update!\n\n**\ud83d\udcaa Train & Power Up** - \nLevel your monsters to take down tougher foes and help take on the bigger mysteries waiting in the dark.\n\n**\ud83d\udc65 Better With Friends** - \nTeam up to explore and battle alongside other players.\n\n---\n\nWhat is the Dark Forest hiding? Suit up, head in, and find out.\n\n*Play free on Meta Quest today.*\n\n\nTeam Racket is in Early Access so updates and content additions will be released frequently!", "short_description": "You're part of Team Racket, and the Dark Forest is calling. Battle the wild monsters that world, win them to your side, and build a squad strong enough to join you on an adventure deeper into the dark forest than anyone has been before. Explore what this new world has to offer. Catch monsters. Uncover secrets. SURVIVE the mysteries of Dark Forest.\n\n\nTeam Racket is in Early Access so updates and content additions will be released frequently!"}]}, "developer_name": "LucaLlama", "developer_privacy_policy_url": "https://teamracketvr.github.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "LucaLlama", "support_website_url": null, "website_url": "https://teamracketvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "2710427532541308"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
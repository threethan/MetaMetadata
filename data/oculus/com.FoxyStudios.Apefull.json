UL3dooRjw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7xEx1doOf0FDlEW5jE_BUmuhBBCLoQ8dRcyJ2qYYNbQ&oe=69C7B8F7"}, {"file_name": "Main_Scene_Custom..._23.02.2026_18-02-42.png", "id": "1444770727340395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819859_1444770730673728_1131919456479355254_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVg9wtYhhlgQ7kNvwEABJrn&_nc_oc=AdoHLpJRJOlHxi6sElJ4EeKt3ciYSLgEMpQOmUdr5whaENbvUn3T88niPvcboWD-xxY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymRfVFGF2pwERsE7bElGun6YTG98eZgTpPY01gDoNWbQ&oe=69C7E2AA"}, {"file_name": "Main_Scene_Custom..._23.02.2026_18-03-05.png", "id": "2288903711605395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824700_2288903714938728_3468143241416084399_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5wjhc24EVkQ7kNvwH7stbV&_nc_oc=Adqr_MMGFHkX4EnfnAlfSi0N-E4PEUlEySQPr0Xz0LApoMG_cPBc-a_SeDEW83dDj7o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzuaZwT_ZZB6nypBUea98eLUS19nUs5e7fQDoTWjyPIg&oe=69C7DC4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apefull", "keywords": [], "long_description": "A heart-pounding horror experience where the jungle becomes your prison.\n\nHigh above the forest floor, beneath endless layers of tangled vines and rotting canopies, something ancient stalks the trees. You are not a visitor here \u2014 you are prey.\n\nUsing fast, movement-based traversal, you\u2019ll climb, swing, leap, and scramble through dark branches in a desperate attempt to survive. Every creak of wood, every distant howl, and every rustle in the leaves could mean it\u2019s getting closer. The higher you go, the less safe you feel.\n\nBut the jungle isn\u2019t just alive\u2026 it\u2019s watching.\n\nExplore abandoned camps, forgotten research sites, and shadowed clearings swallowed by nature. Piece together what happened to the last troop that entered these woods \u2014 and why none of them ever made it out. The deeper you climb, the more the forest changes. Paths twist. Sounds echo in the wrong direction. Shapes move where nothing should be.\n\nIn Apefull, survival isn\u2019t about fighting back.\nIt\u2019s about moving faster. Climbing smarter. And never looking down for too long.\n\nBecause up in the canopy\u2026 something is always climbing with you.", "short_description": "a fast-paced VR horror experience where the jungle is never empty.\nClimb, swing, and escape through dark canopies while something primal hunts you from the trees. Every sound could be a warning. Every shadow could be watching.\n\nIn Apefull\u2026 you\u2019re never alone up there."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/apefull-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "FoxyTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/apefull-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "34030207649958653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822327_1395843259006186_234258871450070572_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YrbpT7pKq8Q7kNvwHq-bR0&_nc_oc=Adp1DD9SIXnSmw1gccwYu-WGOGODyOfZcoQ8cpe3QXfeSiIZLrDu9l71U1d-Av4Deuw&_nc_
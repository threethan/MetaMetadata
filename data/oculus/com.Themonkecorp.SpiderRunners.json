07852_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hSXm9ZlAOcQ7kNvwGqXU2Q&_nc_oc=AdqfSUhgi7TMg8uhRwHO6GqznLD0MuY02ESUhZ9t5R_AL9kuM-ZOuYcUp2-_fF44yZU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtQ6gda0b7916xXoAzeZcEPtuHqOpCVFZlEw3JJvpdHw&oe=6A9751A0"}, {"file_name": "Main_Custom..._14.05.2026_23-08-25.png", "id": "855167670360743", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499298248_855167673694076_2980234742768372037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdArCpfPYugQ7kNvwEkUcMG&_nc_oc=Adpa1hvj8qlt28omz9wJetCicbMR5gjloVduTNM0PF0wjU_iEpnxrRP2wFnz3yrbXIk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHjf-KM4QT-0m1NtO_D7UpNLi3t-CG8cF7C06H9AJYkw&oe=6A974410"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spider Runners", "keywords": ["spiderwebs", "fangame", "fun", "hangout"], "long_description": "Spider Runners\nSpider Runners is a multiplayer web-swinging adventure where the city becomes your playground. Swing between skyscrapers, wall-run across buildings, explore hidden alleyways, rooftop hangouts, underground tunnels, and discover secrets scattered throughout a massive open-world city.\nUse smooth physics-based movement to build momentum, launch yourself through the skyline, and master advanced swinging techniques. Whether you want to race friends across rooftops, practice tricks, or simply relax and explore, Spider Runners gives you complete freedom to play your way.\nJoin public servers to meet players from around the world or create private lobbies to hang out with friends. Compete in fast-paced races, challenge yourself with movement courses, or explore the city together during dynamic day and night cycles.\nCustomize your runner with unique outfits, masks, web effects, and trails unlocked through gameplay and events. Every district in the city offers a different atmosphere, from glowing downtown streets to abandoned subway tunnels and industrial rooftops.\nSpider Runners combines fast movement, exploration, and social multiplayer into one exciting experience where the city is always alive and adventure is around every corner.", "short_description": "a fun game where you explore the city as Spider monke"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/spider-runners-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Themonke_gt", "support_website_url": null, "website_url": "https://sites.google.com/view/spider-runners-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27050198837951744"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/595143057_1374014944542627_3297455521410606664_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ox_5al3w3UQ7kNvwEbpMBr&_nc_oc=Ado6_l6SiulvcGOWJGiXs-GDbNuesMw9wTrgjhSBGp4fx7nI8u20Bmwd_RvT4IGtIIQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjuLDNrlkt9RFqI3WPq3q0vcpKKxWvlpwFZtya8STa9g&oe=6A97410F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spider Runners", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{
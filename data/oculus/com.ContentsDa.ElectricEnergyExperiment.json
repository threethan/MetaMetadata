{"file_name": "09.cover_image.png", "id": "1777943506053012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031319_1777943512719678_3622191862329269715_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tKL_uKi6kMQ7kNvwGtxw6F&_nc_oc=Admy6fYkCgEDOS87Dp5ttEedwHMQnPwwPfFhk1Tn8hFRtdQC_OtABlkiezn-BUTlx98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsnNq5iTEuaGb2ariAT4XgmnTk5QqewrRMoB8vo4D6dkg&oe=699B0E5F"}, "display_name": "ElectricEnergyExperiment - ContentsDa Science Experiment", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_sub
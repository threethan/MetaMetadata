0_8926146676426698665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cHS5ZZUQ5YQ7kNvwEzxhh9&_nc_oc=AdkdC1gak72B3mliHMMEjN5pupt-OuQpn2oCwU06mOgqTydkTmADOBAAgGw8LjXAQSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCMJRv-6u1bOSha0_EgaOhdaiLG1KGooCwrBfAJhPIBA&oe=69BEA99A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Electric Energy_Landscape.png", "id": "711709724426306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974713_711709727759639_1489015113912306727_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBmwHgTPi1AQ7kNvwG4dvtS&_nc_oc=AdkqcHT8_jUkcCv5gvDVdKBY4L0Qjjlg_3NBm7yN3o5CG5F_Y0OONlUCUzoayJCJUJI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7dcJ3jlyYMLrpsvcu928I-LO4OUR7DTMasjj3SDC_Qw&oe=69BE8775"}, "display_name": "Electric Energy Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "physics", "electric", "science", "contentsda"], "long_description": "<Principle of Generation of Electrical Energy Experiment 1\n1. Get the coil from the place where the coil, magnet, and fixture are set up. \n2. Assemble the coil by placing it where the green hologram is generated.\n3. Assemble the magnet by placing it where the green hologram is generated.\n4. Take the fixture\n5. Place the fixture where the green hologram is generated to complete the assembly\n6. after completing the assembly, press the yellow button to start the generator\n7. turn the water wheel to draw water\n\n<Principle of Generation of Electric Energy Experiment 2> 1.\n1. go to the place where the materials such as magnet, stopper, and light-emitting diode are set.\n2. pick up a magnet and put it in a plastic tube\n3. Close the stopper of the plastic tube with the anameled wire.\n4. shake the plastic tube and observe that the light-emitting diode lights up\n\n<Result\n- Understands that shaking the hand generator causes the light-emitting diode to light up\n- Understands that the light comes on because the magnetic field inside the coil changes, causing induced current to flow\n- Understand that a generator is a device that produces electrical energy using electromagnetic induction.\n- Understand that energy is converted from kinetic energy to electrical energy.", "short_description": "Illuminate the principles of electrical energy. Understand how electric energy is generated, transferred, and converted, highlighting its importance in modern life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27386063251008570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035420_723782319945113_3315799240367045911_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_KCtgGfo3IQ7kNvwGocNR7&_nc_oc=AdkSHXZYydLVFftzypc_uVvkyxP0-C4XbehpKu4krhwppp1RHXU9cMHu0NXMsuVAI7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfydkbwnblB5MOACduI9D54JhIQs69RHskhDBjuXqvAY9w&oe=69BEAB80"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
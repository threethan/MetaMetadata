186030840286494", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818885_1186030843619827_6188590631678668241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DydmPKf3-iUQ7kNvwGPASuU&_nc_oc=AdpShuR4PGh3b-PIoLP5-KwK_sKL7LSpZf4PP5rfJDCh6yK93KthqQiDUv3KAuSAXIc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_T2ruAt_aQFpFaJ1VmgNOfvbHpRQMgH2lppfbhkdBpw&oe=69CFC4A6"}, {"file_name": "5.png", "id": "2937426169782949", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818885_2937426173116282_3489592528918433030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAexNlmkOlwQ7kNvwFG5xpg&_nc_oc=AdruBMbGG3bb_4dFo0I2c2BY1aXB8M7It4dn82VjRPj8w5rcKbyS8Amv6mdqgUHtAXA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjXSWuJLmVvFwMMxQ-DAgvSDp2mJumTMdtZVxerIY8iA&oe=69CFA183"}, {"file_name": "6.png", "id": "1172250738446813", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824322_1172250741780146_4649988757586744025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4XN5T8Pl8kQ7kNvwFlspQC&_nc_oc=AdotgZdQwCFW6hWE8h8Vcvk4UbT5qYFWN4tNJLqvlIg5_DyonQW1_YJsBW4HAb4Pmew&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIuDrMV__b3DTrbbOmghs-kYwyE9NWKUv1Fu13UnDL6w&oe=69CFB834"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War Tank - Tanks Fighting Game", "keywords": ["tankbattle", "tankgame", "tankshooting", "wargames", "shootinggames"], "long_description": "War Tank \u2013 Tanks Fighting Game puts you inside a high-intensity VR battlefield, where survival is the only mission. Designed exclusively for Meta Quest, this game delivers immersive tank combat in a hostile war zone filled with relentless enemy forces.\n\n\ud83d\udd25 Endless Survival Gameplay\nFace continuous waves of enemy tanks that grow stronger over time. There is no finish line\u2014only your skill, strategy, and reaction speed determine how long you survive.\n\n\ud83c\udfaf Realistic Tank Combat in VR\nAim and fire powerful tank cannons in full virtual reality. Track incoming enemies, manage your positioning, and destroy hostile tanks before they overwhelm you.\n\n\ud83d\udee1\ufe0f Battle Arena Experience\nFight inside a dynamic combat area designed for nonstop action. Enemies approach from multiple directions, keeping every moment intense and unpredictable.\n\n\u2699\ufe0f Optimized for Meta Quest\nSmooth performance, intuitive controls, and immersive VR visuals make War Tank a perfect VR action shooter for tank and war game fans.", "short_description": "War Tank \u2013 Tanks Fighting Game is an intense VR tank combat survival experience. Enter a battle zone where enemy tanks attack in endless waves. Aim, shoot, and survive as long as possible using powerful tank weapons and tactical movement. Built for Meta Quest, this game delivers fast-paced action, immersive VR battles, and nonstop tank warfare."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513858498240248"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.ocul
_nc_ss=7f20f&oh=00_AQDI2LpEVPHTBCu51mocLJIDcTZiMRvK_sBTm5N4GhZmYA&oe=6A5F60F0"}, {"file_name": "screenshot3.png", "id": "1724923015600954", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828087_1724923018934287_6265087736612232122_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKQLkoDA3JUQ7kNvwFJGFb0&_nc_oc=AdoMSaCLXPSClxfqIkRuopwm1T7W9bDXxvbsONixGpzIswcpdxvuIuGAEoCT7E6crYs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0mDVxKRXiIFHRzf0vuum1UMSz4xUWX0-39USTIZeN0g&oe=6A5F71CC"}, {"file_name": "screenshot5.png", "id": "1674866583459536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823279_1674866586792869_1717154607692985332_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6lOoxKCimEQ7kNvwG_jsgp&_nc_oc=AdpdS7XgVswZD8hQFKJZ8JxWvEm1q6SOzvABd-Z796ZeIXZ-0EWZjKsQmpkRTxUt-5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI8J4uULr3vvBkhrEqvSK6_i5Kq-m5-hIlbLTVagg02w&oe=6A5F69F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Taggers V2", "keywords": [], "long_description": "Welcome to Lost Taggers v2!\n\nLost Taggers v2 is a multiplayer VR game focused on movement, fun, and fast-paced tag gameplay. Run around with other players, jump across obstacles, climb around maps, and try to avoid getting tagged while chasing others in exciting matches.\n\nThe game is built to give players a smooth and fun VR experience where you can hang out with friends, meet new people, and improve your movement skills. Every map is designed to encourage exploration and creative movement, making every match feel different.\n\nFeatures:\n\u2022 Multiplayer VR gameplay\n\u2022 Smooth running, jumping, and climbing mechanics\n\u2022 Fun and interactive maps\n\u2022 Public and private lobbies\n\u2022 Social gameplay with friends and other players\n\u2022 Regular updates, fixes, and new content\n\u2022 Easy to learn movement system\n\nWhether you want to relax and hang out, practice your movement, or compete to become the best tagger in the lobby, Lost Taggers v2 offers a fun experience for all types of players. Step into the game, explore the maps, and enjoy the chaos of multiplayer VR tag. Because apparently running around screaming in virtual reality became a full genre now. Humanity is fascinating.", "short_description": "This is lost taggers v2! A game where you jump and run around having fun with others! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1vcOoNFFkB71LN7-2QYjDvd_Zncg1wNNogTkYlxYc1cE/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "JustOneOnTop", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Yrxu6NPJMlIf2nD8_i2_QTBBeOtZ7IjWWnXmGEjFieI/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1134754796388088"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1170074822856085", "version": "3786"}, "id": "2375731899572552", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "
c_sid=6e7a0a&_nc_ohc=xP-l_jFYt9QQ7kNvwFAO9f4&_nc_oc=Adl9ycFmYxm4NGV4nN1FbdlTyUegrwGbnKZET5fNHSwdLmPA2uFThb78DWsAnAKKL7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCLKM3Hpk1rtrxMOEE708Zrpsl4x0QiSKU4-X152PMUQ&oe=69B0220E"}, "display_name": "Temple of Herod", "keywords": ["bible", "jesus", "homeschool", "temple", "herod"], "long_description": "Herod is considered the greatest architect to ever walk the earth and the temple created by the Jews at the time of Jesus is the ultimate testament of a nation and people's faith. \n\nIn this free roam VR experience, your AI tour guide teaches you about every room on the temple mount - the Holy Place, the Altar of Burnt Offering, the Court of the Women and hundreds more. Visualize how they lived and worshipped in an unprecedented immersive experience. \n\nExperience the mobile phone version outside of the headset here -  https://immersivehistory.com/projects/#bible-apps", "short_description": "Walk where Jesus walked! \nIn this free roam VR experience, your AI tour guide teaches you about every room on the temple mount - the Holy Place, Holy of Holies, the Altar of Burnt Offering, Chamber of Oil, Armory, the Court of the Women and hundreds more. Visualize how they lived and worshipped in an unprecedented immersive experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersivehistory.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Immersive History", "support_website_url": null, "website_url": "https://immersivehistory.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EXPLORATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVE
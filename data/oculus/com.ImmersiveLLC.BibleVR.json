937457894428141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeuM7qC0Y8gQ7kNvwFuyNtX&_nc_oc=Adp1mu0KxJI3VWSKJdGb9i_cFn5li-aFHUTQevW0mjRCd_F5KFEhUVlo7lEtJwQ6NC4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KeIVVTNFrh1e0AGOUJ3JJStZVqRG6ZBhdnOqhsR-yoQ&oe=6A14540E"}, "display_name": "Temple of Herod", "keywords": ["bible", "jesus", "homeschool", "temple", "herod"], "long_description": "Herod is considered the greatest architect to ever walk the earth and the temple created by the Jews at the time of Jesus is the ultimate testament of a nation and people's faith. \n\nIn this free roam VR experience, your AI tour guide teaches you about every room on the temple mount - the Holy Place, the Altar of Burnt Offering, the Court of the Women and hundreds more. Visualize how they lived and worshipped in an unprecedented immersive experience. \n\nExperience the mobile phone version outside of the headset here -  https://immersivehistory.com/projects/#bible-apps", "short_description": "Walk where Jesus walked! \nIn this free roam VR experience, your AI tour guide teaches you about every room on the temple mount - the Holy Place, Holy of Holies, the Altar of Burnt Offering, Chamber of Oil, Armory, the Court of the Women and hundreds more. Visualize how they lived and worshipped in an unprecedented immersive experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersivehistory.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Immersive History", "support_website_url": null, "website_url": "https://immersivehistory.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EXPLORATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_co
null, "display_name": "Tail Sprinters", "keywords": [], "long_description": "Hand-based motion controls for locomotion and object interaction. Photon PUN 2 handles real\u2011time network synchronization; PlayFab manages player accounts, inventories and cloud saves. Lobbies support up to 10 players with matchmaking and join\u2011by\u2011invite. Gem\u2011mining mode uses a pink cave environment with physics\u2011driven gem nodes and dynamic lighting. Forest map provides a social space with interactive objects, ambient audio and dynamic foliage. Collected gems are stored as currency in PlayFab inventory and displayed on global leaderboards. Modular architecture enables rapid addition of new modes, maps and gameplay features.", "short_description": "Hand-based motion controls for locomotion and object interaction. with a tycoon and mining mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tail-sprinters/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sprinting Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/tail-sprinters/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9989227187853539"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel":
home_2_2560_1440.png", "id": "371436955756039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982492_371436959089372_9180641870378311084_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtTn2zAo9dQQ7kNvwHLqf55&_nc_oc=Adq9eGdzuA4Yo8BA6TNg957kIp7ABGBoGNSR7jJlUX4ONsJkhn_Bs_9rtk609-U_abU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSkYf8cxswinLPn572K2Qcf1tooeFxXamjjxYH-UhFYA&oe=6B0452A2"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbWuxGiwHvIQ7kNvwEjZLNa&_nc_oc=AdpTNJkhKzNIGYooBphpaZ17JkuzNS9Kjoc4um4AETzN3xRW4Ogbt6eQ8z9KiX4TdRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRujLtt_9ayQVfWrMF5dqbjbO9jd17C7X3IH6YH_1JT_g&oe=6B0458DE"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IH4AyEoXdEQ7kNvwFJkr2U&_nc_oc=AdrGMpNRR-UncrJedCrgwlDvPehXmIC-i0pKeAtXdRxq9WHdYGokIU8oXlkPcP3I62A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmtq2uTOJksFlLe5jT1ZP5ftnfd6Zu2yLyyqIduc3Bmg&oe=6B045D0F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuQUCnZX1hEQ7kNvwEA0e0k&_nc_oc=AdrOtAVyHaMEOeohvn-kL6BhJ9_pjJn0bHfRVssm17h6Pm3kDRpU7s0SZfO7Bf6N3bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxki6dgGCjh9SwXPFsC0BSAfI2aErEumM8tgXwT83ixg&oe=6B0482E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNmd92gvQzYQ7kNvwEuDZH-&_nc_oc=AdpaqJwPm8zDm6PRTSn5FMDusVYQRbahY2JTUtSseFFWbAq3F-_2l9cd_vVToRqck9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6_n4HKReuBqvVoUWZu99z4ub4ce_5HG8Pm8Sipvtwsg&oe=6B0488BB"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6486171448152754"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221315_936183591447912_916723933801928713_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diCSQgbLMjsQ7kNvwE9K6Ie&_nc_oc=AdoxcRNZwsf4EVXezLx5WCovDLYKFHbOOL9-H4-zn96TPgzRr9concBa-w3bCLBZpu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1qSO2js1KmGyweyWRziwrUxZD2gmjVQI1PwNOfXxdmw&oe=6B047AA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Divine Art", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Events", "id": "2687655338230691"}], "release_date": 1711388100, "lastRevision": {"nodes": [{"id": "6455861001183799", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6455860987850467", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "7364229656970188"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "hero.png", "id": "3762944900592192", "image_type": "APP_I
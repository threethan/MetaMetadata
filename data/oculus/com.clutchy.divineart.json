jRX0cQ7kNvwE2EFgm&_nc_oc=Ado0RsKm55r_al38afmZYbfr18ldk_kWpdvqe3nHoepEmPME1dT8PfL0k9dLLTYrs_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95PNiViMaT5W2pHViQcdTrz4MwwcWoos1WSEAEhjmSdw&oe=6A355722"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soZ19nlqOzkQ7kNvwFoqok5&_nc_oc=AdotRmGy0RcUhVxfxRkSJ6lfmwmatCc46cKJVQlwX4SGstoOulUkwJMyVZ-b8H8EjTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83BTbxSn2oviNWThbKIK63CoHcLaIJrvtMqzjNfOmgIQ&oe=6A355D5E"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFkfroV0AjUQ7kNvwGrYjUk&_nc_oc=AdqiVrHHxRrUvij0D9Tjbbdod_k8yPLjG7rtel7oTA87-tyhPnlehvh8-JjySWC2H_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FnUNPeuokup95djMtZyjkXuJbXFEOeSRJL9JP3qIP6g&oe=6A35618F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG82OBcqUp0Q7kNvwHAt4i1&_nc_oc=AdrCaJHEwCNJ_sLGbH-jsefN14og2yRd5i7rDnANEzhCXFTZClK--YUu7AgXuSHldxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gJ8syAdAfuZ2WLlxr6oDOE6_eudSJeHSL0IDXkdBcYQ&oe=6A354F29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIm_tmYQgXcQ7kNvwEk-bs3&_nc_oc=AdqJtnfjuVB5Kdnohmi3KBOKFhaCLCIzPDQHCzNZRURYw8eTw_f_HveYuF9QxClEgfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DIdIg182PcjWGQBOhW2MluLPjaV9arwa_PcT6QQvMUA&oe=6A3554FB"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
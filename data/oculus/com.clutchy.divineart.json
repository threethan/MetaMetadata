4467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeDTSH64GFEQ7kNvwFgu1MY&_nc_oc=Ado_k5FrK_L-QF7cJAuBiVhr_dH7rjpvbxWpSHrcAGkczkrAhX6-fknUvuca0562eTg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrGaebj-Ny2fqKQKEHbrJXSLLgoLwqB9RJ7z8KsZI-SQ&oe=6ABD27DE"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c4fy0ToUJoQ7kNvwElxZ24&_nc_oc=AdooYfyJ1sBfVE5EUgKQiIbdzHFVmOayLLooHoXqbErSkuNkxhuZ-HqJWUkqRB-ooG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7iBbBtA_iblQahQf77TS4JV3ymXGYr70Z9npSjbj9qg&oe=6ABD2C0F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06iYYy1ocRoQ7kNvwEbBVNC&_nc_oc=AdplWWpYYrxtGtiAf_Xr5z-sDmgliRK5wq5jgJVX9GJTq-vn-ND4YhnN9_bBNO3OSC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm5XgDUtAV2yZoSs07ZIHYhdOr-19fGTLPdV8qiDbD6Q&oe=6ABD19A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hv22QZRsbOcQ7kNvwEsdC24&_nc_oc=AdpXo8G2TlUKJMAqrr1KszS2kCoHVwEKskI8jAEC5ei-FfF4_k5iMflSCd_cNYms1t0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkLlwqkUeJhZ65NGycYZA-A899P2Hp_8BA3Te7qQfA8g&oe=6ABD1F7B"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "648617144815275
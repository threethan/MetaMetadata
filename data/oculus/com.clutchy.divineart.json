AwqiQKtN7V_3Oujv4RpApbApY_saVpy_vKRsy6pCSw7WZSwbtiCdXMdx9WFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsXoDS_uUt3jfrdEg0Ih93K4ahpEDNkVz6QQ5yoA48SMg&oe=69A95FE2"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErK91bAv7tYQ7kNvwFxmX8r&_nc_oc=AdlB5t4-dfsW2h72g2yLRfP9ewqxAgJ7VYeuhRWcA6-tj5O0EKE50HNEdTMjIvBYoyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftj0cKcA-hx1_ucorYlQJEU5aKsfvnD6lGqnrU6P9qZPA&oe=69A9661E"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R05zzqOzO9MQ7kNvwFRffah&_nc_oc=AdlEBle-2ver66BnnxByAI4aKXT2CRErcbSvgxwKsEfOHmOMxt0PlTWenqKpaqAl9RI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftt2i55f1acMD79fJNgiQUYbKgUr9vnD1PKSvlNgMMKcw&oe=69A96A4F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r40RHxbgkmkQ7kNvwGQj0dG&_nc_oc=AdmjHKbO9BE3N4fpV2CtPGZnKDtLLSsQ7wYvJ7H-K1EYEJ39evyebd6AcILKFbhNiMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsBPrh0kQ-6TrlvCtL0iw11Uyk4zcA3_6fgD2_zUGMeTg&oe=69A99029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Argx8Ex7YXoQ7kNvwGgJrfs&_nc_oc=AdnUNiqvNHewdJo0WuYozxPLEKipffUi9w5qJbmaAGlHStfoPDuukeP5obYtCUdv5Sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfudavQcsazYny2cKtY0hmLXAHf4VkOSerWpXzxaEjCVIg&oe=69A995FB"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
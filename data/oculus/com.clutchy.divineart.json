dsNnnhGGBugp3h79SEtLNN4ILKPPa_3mk4cF2eLZXyM3_7ViK4iGx89f3RuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAFxo69KlzLHqD4ya0AW-FL1dNWyRRu_egBtqhz4hDNA&oe=69BC0D22"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm80kCycfOIQ7kNvwGQZfCv&_nc_oc=Adkm1pigDnkIzZsJj_Rwvcsx3-cstx1oB9wWT14DFubwfb-A-Zmm-wx4CQF1v14sVXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbH9ua5V-g-R_3OTESxpLJra0Le5nbAE0nULE0O8Tt_Q&oe=69BBDB1E"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhBtjVpc29gQ7kNvwHXPlj7&_nc_oc=AdmcPDMbfcR_03St-vpTHkYWGEK_MiRJEHXmBUFIi2hMNtaSVTeQsTcydG3a5sk1ew8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwIY4USmtwIpG8CUSa77jxCpYX1Gn63if0OtD5QDQx5ug&oe=69BBDF4F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAmR2QoYFOMQ7kNvwEbBlfM&_nc_oc=Adlb5fXCaL-U1Q_gZZWKrjjQMrL00j-PTUtLbVCb4vUXeyBc90agBdLNCLR6bfUqWV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzknwZCXwjQDLyVSDMnMu0C2_b8ecqN6AQr4yjTiAjmEQ&oe=69BC0529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3icVVQoBEhgQ7kNvwGfkyk4&_nc_oc=AdmHpj2o0RwP8TY7uquEwLHOTbErC253dYkkBFrqcbctQepKvefDEw18VkyIf3tRIa4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5O3DaQ6hPSP0zye68uUR3ZeEH_kyA_vJXMv_6aB4AMA&oe=69BC0AFB"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
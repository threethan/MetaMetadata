home_2_2560_1440.png", "id": "371436955756039", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982492_371436959089372_9180641870378311084_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkATnkq2oeUQ7kNvwGFmlME&_nc_oc=AdoyCZtqMLCNpPt-5Led0EkuCkhoIZX9H3TNR-GfhdHoHbIfq9UMErveCK1zJ7fT2_A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK-nl9CI9UEw3C2_WQHSxNCzGP0tsxOjxPdq4gKYdyVg&oe=6AFB1822"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAS8HD5t0dwQ7kNvwFQY4-K&_nc_oc=AdqQiadP6buKImldQCAP9lPb0M35nvY7anKEVOp0izUk-iWTBsREk7_Nmsb2dC69BSI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq61nv-JfFjRnLdqkdpHr49ML2hMHUuiwOfVA7VT3yaQ&oe=6AFB1E5E"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6cWvET-pjIQ7kNvwEHq5nf&_nc_oc=Ado90Yxobo53tHKSRNXuoFPr2lcLYPszNNQpULP-jrK4bQKELWXGDc8BJMzkVKxutlE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQebfsaok8pgyXsNHAP86q4HEOJySHkKbdropF6ukqCBg&oe=6AFB228F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NErvBzgIl90Q7kNvwElXWvu&_nc_oc=AdqO6fTxvVpJj0LfT8kT3UlqbT_9lZQYa0kAj5wKY7WVqkkZ19meamkCL-NjU-gPFXA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtyNRnK53YhuD2QdJLm_1rTzMSGUwryirR5potAGzYog&oe=6AFB4869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rHfrAMOM2IQ7kNvwHgg_VP&_nc_oc=AdqU3euke-EIm74zZJGrt46wHN_t_v0DzB5GvXA6_T3rU-0dx08Xzqc5XubVZQYGft4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-PpSoqzsLLp27PgMoh1rAD2B6vhXW8uI7zFCJhma74g&oe=6AFB15FB"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6486171448152754"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221315_936183591447912_916723933801928713_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_xB3qkeIZ8Q7kNvwExkC6s&_nc_oc=Adq7eOrSBqXJdYvGkQBTViPN1HsdDn3RvEwXBrBQw4NHpB0FEOQjJ8yPqbN8judRyl4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKLM22_KuH_BHNa71VzLE67AgIV0SUFMQx9VeULVAj3w&oe=6AFB4021"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Divine Art", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Events", "id": "2687655338230691"}], "release_date": 1711388100, "lastRevision": {"nodes": [{"id": "6455861001183799", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6455860987850467", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "7364229656970188"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "hero.png", "id": "3762944900592192", "image_type": "APP_I
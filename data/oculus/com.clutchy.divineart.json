738299732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rHfrAMOM2IQ7kNvwFKe9PZ&_nc_oc=Adqs4HndrOXjYoBCDKgr83HzXRJogQycgfwwaTju2BvqZNCTiDQKGBmXTwvKcRHWnb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxOwD0W2G9RkO1W2zNjuhMpDSWJ2l8mTm9KEkM3n6qFA&oe=6AFDB8FB"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6486171448152754"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221315_936183591447912_916723933801928713_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkD2s3bGp1MQ7kNvwHhsXrj&_nc_oc=AdpL1M-3GhtqnYzVooitjJDsbxRIFQdh9plmV-OZL29B7JxRmPA9i52En07tECSSpxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQImyJk60Tw6RDyaw1RaLGncuBbCuMEp8dhruMBw-JMrQ&oe=6AFDE321"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Divine Art", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Events", "id": "2687655338230691"}], "release_date": 1711388100, "lastRevision": {"nodes": [{"id": "6455861001183799", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6455860987850467", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "7364229656970188"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "hero.png", "id": "3762944900592192", "image_type": "APP_I
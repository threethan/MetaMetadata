-KWUO0s6S69NQKOSnYjZbtUp9CWNg_F7LvcwYsdDhKosFOQvn1Z-t7bk16N8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxs4irM_8Di5i23gONhoLWG8KNTYL6_cJlRFP7a_Sz-eQ&oe=69B29A62"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPh-wWK8BQoQ7kNvwF_hWJo&_nc_oc=AdleSitxiNRYwlBotu0q2ubG0B8AOBgynvjeVd7MjVoH3TwxSnI5-fxtmrlTQaPjJek&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7ja29MxjF9E_bT8lduK3tcwcMfepFx-T7oiS80DU41g&oe=69B2A09E"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NufXxiWDTTcQ7kNvwGQ9QfP&_nc_oc=AdnLjx8UZvr9fMQo8y_lrQRZmhz1TujRXMNQqNMqmzxcC8TO84u7PPwpekYpnHQTL6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLkAmtYT8Q1PAqpQxBUQ8rpduYqkDCvGq1vD4Z_gRJzw&oe=69B2A4CF"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuoV86_r3dIQ7kNvwF_9SsE&_nc_oc=AdmUyS2BT3ZoaxBXFN2wiEZgSqqsgIT5Dwv7ADMm5dZ5GTne6NFvwjsprVe9NcQltfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaG1Yb6HBtXGeK8tLzaxHlKzswOOk7FNuYyn439yCL4g&oe=69B2CAA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qe-ghMz8PpUQ7kNvwEP0XJK&_nc_oc=Adm09CT9QWkLICA5E8iEmxA4pm69yRR_IG0lzlPN-7AT0ZMYHuv4S1YLwSbTfkEy0YM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afze49k8kFmr0hxutNp9ZxIA9qoDLrYADyLevTsVz30OvQ&oe=69B2D07B"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
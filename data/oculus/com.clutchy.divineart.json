4467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soZ19nlqOzkQ7kNvwHq2B-_&_nc_oc=Adrf6tBm3R2mYjofYgz-tioSsFMvfhgD1quIvWqgo4YwqKqn8qZBZ20cMU_crgawOmg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DQI_dbWb9Fjw_T2-H5hzt4FphxJEdazaKgFwAM018uw&oe=6A340BDE"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFkfroV0AjUQ7kNvwEwVEU1&_nc_oc=AdprP6GTBq_N__lK1-kIlB8U77jvOc88WmxFXi1x4OHP2HKWuOgamZHG9pLD3wnfOSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ARl9qXV7bqiumKr05M0AFyvkYbYH1CA0qGdOZx7rnzw&oe=6A34100F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iI9Qo6i_JEEQ7kNvwG6b1CX&_nc_oc=Adpz5pkdFEVNVCYvj_M11lLLxpXwG_1fPQMYWIDsaLsXACB834c1VZrhi4jcrIyj6ZA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vJU_tDEboNDqeciRxSRw7lhaVoEJqCaAM-1WjKudGJA&oe=6A33FDA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4QOgd-5PtIQ7kNvwEx2NJv&_nc_oc=Ado_hx5eEvcRwi4p7jORzLBIdgjDcV7OYc37ggqbZYoosNHlfMzs1-nYBsLIK8vfor4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YNHGCjLcmK4VVgonUZ16ZQelqSrnc8lGLkg6GtDr9IA&oe=6A34037B"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "648617144815275
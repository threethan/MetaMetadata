uscdn.com&_nc_ss=7f20f&oh=00_AQHqmje_08HPOpp9fVd8t2xu4d7f788zWQgOdCi7u9HAjw&oe=6A8D713B"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "p
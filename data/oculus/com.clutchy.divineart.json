_DboMQ7kNvwFPqPCH&_nc_oc=AdryUtDQXR8RQnXYYZLi1bGfFMxr2m9zFdwWBqRNVQdD1A8WeAExXV_yg705pvX18oE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnFQ7TTvF3Hl1bIZ6EtpUum_mKvPqVZ3s1ruCDME2Fsg&oe=6AA809A2"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nriD98bh4zMQ7kNvwH04DJo&_nc_oc=AdrIH3cIAxJu1zPuEbSHsTbjgb1GVfcSRlcQ-VikGqiCnSpzWVvl1kFY7mzd3e6fK3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH1oQGliGn5HT5bsW64VaZsif5N3fKgCBWVlYCkmxB4w&oe=6AA80FDE"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjxQNa9v16IQ7kNvwEEinvB&_nc_oc=AdrEj3S2D7jlb9QrJyHNNf_bOL-RCLJqooCRNB_sNDSjQyr_lK658RpTl-yOA8RxCIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVleXlQ4q59prnoWweDZhc8QLVz05hNlmvvsAezBzirg&oe=6AA8140F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7X7DvPQnbgQ7kNvwF4lZpl&_nc_oc=AdqU69ccjzDvnJUF525KyctoZ_ZRJBb5Y5DNQg2arEAIHACVUOtwllkR3CXfSAG8IqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd2wRdyoV9mqbpXl4ZCpU2NGf9Ob8ZFijjxp-aqr6xPw&oe=6AA801A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTjdiwbcVbsQ7kNvwEvjyWF&_nc_oc=AdozwyB7LNHqxJfc7h8yFkgOkJma9j4gdeOr78gr_gDyiE9wxuxEDrdDRGDtLvY5WSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXodJE0sqJ_zCLUFO9LYNmDxa1ZXtLEAxhoIn1095hbQ&oe=6AA8077B"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
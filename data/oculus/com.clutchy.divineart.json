1Esm4GsT8-VyKS0uTUnRD_uNRHT5xovw2DGYS866LCefv9Zt--Qq2X_Yj83Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaSb2423GANu3ozpnl3Nrmq8-QTztnMAt2FBZkP6sB7Q&oe=69C11AE2"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL9TmoV0dMAQ7kNvwHIvRya&_nc_oc=AdoxnKR8-nKnhrwQYQsgwcUHCW0oxxRgzd9F0g5FAUUm4hC6BYyUUIt3Y9IXOvRFXvc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXKv4EfKQdjFdHo4Tr2vVklVQD9aFP3oo6A6RH02y_Gw&oe=69C1211E"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvu-IPZRYqEQ7kNvwEIPQBc&_nc_oc=AdoEHvEGWZHaYF1Wq3pJP8VPp-vi7eu3dxiyogmzmWnqxLj2F8VTBezpQI-BM1ymYo0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyW_OiCwTNsoD8JpkW9fREF4tk2UffErvrd0w8OvCeriQ&oe=69C1254F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-yihY85Z0EQ7kNvwH-O-B9&_nc_oc=AdokNAolLp-x1OZdDkNVnToT6DLXjNmP49WpWR7aQ00unLX_mv79YkAfLTIB0M44Dng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwX6lvWB78UanjRlboUwvJ22DsBFVE7zWuEV0XxdubMQQ&oe=69C14B29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w_fX4FH83oQ7kNvwFNVFon&_nc_oc=Adry4_woJl4dyxgvULc7nPuiTH8HZFiyKZqzGeV4diJKRK8zyPfIiaGDxigTuxDwpqg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyG9eXY1AlpyNhPYE0_LalWnJfwLRWFngPyuV1b6y_tsA&oe=69C150FB"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
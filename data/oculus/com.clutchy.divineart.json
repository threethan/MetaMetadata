jqLb-PeSZqM6jQuzu-wa8_GTBRie73rt4FQfLl7Pd6lRfXV7yYEp6KZXOxSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7Q98YRPd4qgXzQxuvvK__s8WwjZPc8rl7vKVmBh5NmQ&oe=69B53D62"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LjknTObwnkQ7kNvwGqQ2MP&_nc_oc=Adn8c6MOsaRgyKt-xret70n3-vfvPZp1kFUhwyqva6lD76lMMHA2hw0rLQrhCVsYYyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuYj0nzUaBL-8wi4pnRLGKpvDlJJuneYdxrTAQOk-c8g&oe=69B5439E"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ4nexTXmfMQ7kNvwGr-XOH&_nc_oc=AdmIsc1zUu3cBkQCh1inwOUgX8-ci8PsB5MciZa3zbf9q0SkB6d3e4ShbRc1qQWFIH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwlYlygokf6ReM4ONAhbgrpTDprLPQ4ufI0ZDmPvwJCdQ&oe=69B547CF"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuoV86_r3dIQ7kNvwHfhxhD&_nc_oc=AdljHpSfvNMAFEK3VTkDzXp7gOV2lt4u09Wj5rfg8KKiBCUvBJWUVqxcwc-o2B3z1R4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUk8xU0sxaM_-EQu0w9VAcr3O7EmMH12XHC7j6Fkp26g&oe=69B56DA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qe-ghMz8PpUQ7kNvwHKqiqk&_nc_oc=Adng2jONmxA3WCd71qe2kpKvXbQhDGgvMvy00fVEfl4jaFQeYYmqtBknjJRQpB24aAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2PGTcqBfB69AJNE5_urbMnOMzQqjzKU8fa_4SPQdIVw&oe=69B53B3B"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
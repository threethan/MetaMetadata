vRfy0cHpLAK87_3fLhNXGgP7gC3dLdYBtGrVzeqY5PIj6zroOXNiH_XszIuY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwjx_XpOS2TSvUI95e53kfB64xSOQ-_m4kxy2sh1MmxsA&oe=69BE77E2"}, {"file_name": "tradingfloor_3_2560_1440.png", "id": "1105137487491134", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1105137490824467_4773080604748269562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QSVV_MJDgMQ7kNvwGAMykN&_nc_oc=AdlLGmyF-uw6VybJLHXaceUeJ4fsrmyzfiK7cc3z0C5rws2CnGBrrwcowWqBi2pXyjc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyw9gspn1UittgDuBx32uKT72QWM0lWxjsSiKh7qBbLwQ&oe=69BE7E1E"}, {"file_name": "tradingfloor_2_2560_1440.png", "id": "658438736349059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982697_658438739682392_5441542860751680717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPTAS2E1M0wQ7kNvwHZmif6&_nc_oc=AdkNAP7aoUvEerXupc-8VIwJDt-GGgGpVYbCQsSMpqZF8y-h-J7vaH_CAL0G5o1xhjs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVhEPy2az803KHxInSso3MP1X8uxNYPlvx_3g0ZJmZVg&oe=69BE824F"}, {"file_name": "tradingfloor_1_2560_1440.png", "id": "7180776475363345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_7180776488696677_5417721752751823816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-yihY85Z0EQ7kNvwG6gqAY&_nc_oc=AdkUkxXTPktTxr9yH5QI4un2bLIRz6QsXoGZiocTHKmfV308xAWHNLVQg_XnFUSFQTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZg2At2uCLoTnGQC29HLN3eslo962soWZnmqNP3EJ8xQ&oe=69BEA829"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tradingfloor_2_2560_1440.png", "id": "1096831738299732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982672_1096831741633065_3096867970045124730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w_fX4FH83oQ7kNvwHJ5O4J&_nc_oc=AdloXnwBspqFqUBQgs2FU9-lNCA_M17VTo7Lhq5vaaYOAi8n9xipt-9JNVqrVBsLgAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzba1NEofyw6zSgrz3dfWkqAXm0bWXMegK2mu2VQp_g9g&oe=69BE75BB"}, "display_name": "Divine Art", "keywords": [], "long_description": "Dive into the cutting-edge intersection of Web3 and Extended Reality (XR) with our revolutionary virtual reality application, designed exclusively for the Meta Quest platform. This immersive experience is not just an app; it's a new realm where digital collectibles and social interaction converge in an unprecedented way.\n\nCelebrate New Collection Launches: Be at the forefront of digital innovation by participating in virtual launch parties for new NFT collections. Experience the excitement of each release as if you were physically present, all within the comfort of your VR environment.\n\nOur application takes socializing to a new dimension, offering a place where you can meet like-minded individuals. It\u2019s a vibrant community hub, all rolled into one.\n", "short_description": "Experience the future of digital collectibles with our innovative VR application, blending Web3 and XR to bring your NFT journey to life. Celebrate new collection launches, socialize and personalize your virtual space with your digital treasures. Launching first on Meta Quest, our app supports intuitive controller and hand interactions, making your immersion into the NFT world seamless and exciting."}]}, "developer_name": "Clutch Tech Solutions Limited", "developer_privacy_policy_url": "https://docs.google.com/document/d/1oAB7LB791FEcuVzIaDawvXNf3or75HD4VDS920kATRE/", "developer_terms_of_service_url": null, "publisher_name": "Clutch Tech Solutions Limited", "support_website_url": null, "website_url": "https://clutchy.app/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
ne virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Advanced Tag is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "This is the by far BEST Gorilla Tag Fangame, it uses Gorilla Locomotion like the hit game Gorilla Tag! Download this game today and share it with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1z4oUTnAb339LFuYZ5-TwAtmDTga113KYbc_OulQVvlg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Kinetic", "support_website_url": null, "website_url": "https://docs.google.com/document/d/10EAdRzzPhLk942fpE5tPRyW5XbeLWun6FkgGMWGwcR8/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9725579217567678"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499340280_1004942635032476_2450371989262252537_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GZDeZ9axwoQ7kNvwFJ68UZ&_nc_oc=Ado6iYb4B1EmqJETkPyGkpP1gyz0hH3VHVRK5DttqbHYIoHMUqzRzbyI29WQzF677t0&_nc_zt=3&
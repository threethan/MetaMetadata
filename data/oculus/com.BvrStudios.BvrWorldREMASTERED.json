cdn.com&_nc_ss=7f20f&oh=00_AQMnvy7Ndpbc7iyq9x7XDC63Yf5M3JadPzBqGZiVB6N9iw&oe=6ACE63E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bvr World REMASTERED", "keywords": ["COOL", "FUN", "FANGAME", "VR", "REMASTERED"], "long_description": "Welcome back to the world of BrassVR\u2014built bigger, smoother, and better than ever before! Bvr World Remastered is the definitive multiplayer social platformer where you throw away the controllers' joysticks and use your real arms to conquer the environment.\n\nFeatures\nMaster the Ultimate Locomotion System: Experience the physics-based hand-tracking movement that started a revolution. Launch yourself off walls, climb towering obstacles, and chase down your friends across massive, multi-tiered maps using pure momentum.\n\nThe Ultimate Monke Hangout: Meet up with old friends and make new ones in fully interactive open worlds. Join active lobby rooms, customize your look, and engage in chaotic community-wide live events.\n\nFace the Horror: Ready for a heart-pounding challenge? Step into the dark and see if you can outsmart the terrifying threats waiting for you in the revamped horror gamemode. One wrong move and it's game over!\n\nBuilt For The Community: With optimized performance, crisp remastered visuals, and lag-free multiplayer networking, the world is smoother than it's ever been.\n\nWhether you're casually swinging through the trees, executing flawless parkour lines, or fleeing from terrifying monsters in the dark, there is a space in the world for you.\n\nWhat are you waiting for? Grab your headset, call the pack, and reject humanity. Become a bvr monke today!", "short_description": "Reject humanity and return to monke! Bvr World Remastered brings back the ultimate community platformer and social hangout, completely rebuilt from the ground up. Master the high-speed gorilla locomotion mechanics to run, jump, and scale massive structures with nothing but your hands. Hang out with friends, join live events, or test your survival skills in the intense, spine-chilling horror gamemode. Are you ready to claim your place in the pack? Become a bvr monke today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforbvrworldremast", "developer_terms_of_service_url": null, "publisher_name": "BrassVr", "support_website_url": null, "website_url": "https://discord.gg/kgnygbbxHv", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35924950603818819"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1878564419504142"}]}, "baseline_offer": {"id": "1878564419504142"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780322400, "status": "PUBLISHED", "id": "1878564419504142"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37838101155837078", "version": "0.3.0"}, "id": "1659637302026841", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35642217498758799", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37838101155837078"}, "release_status":
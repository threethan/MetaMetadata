7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chernobyl VR Project", "keywords": ["Chernobyl", "VR", "Movie360", "Photogrammetry", "Thefarm51"], "long_description": "Visit Chernobyl without leaving home!\n\nChernobyl VR Project combines video game mechanics with the educational and movie narrative approach. \n\nIt is the very first virtual tour around the Chernobyl and Pripyat area. You may wander through this hostile environment looking for the story clues spread all over the site. All in beautifully rendered 3D photogrammetrical scans some of the locations and buildings, that are basically digital copies of these places, combined with spherical photography and stereoscopic videos. \n\nBesides of allowing you to safely explore the radiated Exclusion Zone, we are telling the stories of people who suffered from the catastrophe. The application will be continuously updated along with transformations in Chernobyl Exclusion Zone.", "short_description": "Visit Chernobyl without leaving home! \n\nChernobyl VR Project combines video games mechanics with educational and movie narrative software. \n\nIt is the very first virtual tour around the Chernobyl and Pripyat area, all in beautifully rendered 3D photogrammetrical scans of the locations and buildings, that are basically digital copies of these places, combined with spherical photography and stereoscopic videos."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.chernobylvrproject.com/", "developer_terms_of_service_url": "http://www.chernobylvrproject.com/", "publisher_name": "The Farm 51 Group SA", "support_website_url": null, "website_url": "http://www.chernobylvrproject.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "MOVIE", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
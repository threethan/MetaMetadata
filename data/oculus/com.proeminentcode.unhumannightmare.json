c_sid=6e7a0a&_nc_ohc=UN3jE4d3hGkQ7kNvwHVyqjc&_nc_oc=Adnbc8vLl020M_tHVhyGWD3UbL9NnmIAgMGUtWmZDAek4_9u9wD5FrPkvFiIwi48-_w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv79IU4Io7u5ewYwTe6GGMbRLGmYcm0nnxnAOK_r9GGTw&oe=699C6028"}, "display_name": "Unhuman Nightmare", "keywords": ["horror", "unhuman", "nightmare", "thriller", "ghosts"], "long_description": "Unhuman Nightmare is a 4 player online co-op game where a team of thieves want to steal items from haunted places. What they don't know is that the places are full of traps set by ghosts. Chances are, they'll not escape alive...\n\n{527913049825827}\n- You and your friends go to abandoned places in order to steal goods\n- What you don't know, or what you should...\n- Is that these places are haunted\n- Worse than that...\n- The places are full of traps and moving stuff in the air\n- No matter if you choose to play alone or with your friends...\n- You should get out with as much stuff as possible and preferable alive!\n- Your life insurance may not cover this event, so take care!\n\n{924107876225417}\n- There's too much danger to go alone and steal stuff from haunted places!\n- Especially when you know that there are random traps!\n- Why would you risk your sanity and life?\n\n\n{605097505326159}\n- Pick up your friends and play! \n- Don't miss the opportunity to laugh or scream together while being sweat!\n- Live together, steal together, die together...\n\n", "short_description": "Unhuman Nightmare is a 4 player online co-op game where a team of thieves want to steal items from haunted places. What they don't know is that the places are full of traps set by ghosts. Chances are, they'll not escape alive..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://proeminentcode.com/privacy-policy-for-unhuman-nightmare/", "developer_terms_of_service_url": null, "publisher_name": "Proeminent Code SRL", "support_website_url": "https://proeminentcode.com/contact/", "website_url": "https://proeminentcode.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "8056943351061771"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "880159148179075"}, {"status": "PUBLISHED", "id": "1239829951486817"}, {"status": "PUBLISHED", "id": "1356335959575563"}, {"status": "PUBLISHED", "id": "826543783438011"}, {"status": "CANCELLED", "id": "1270976761499685"}, {"status": "PUBLISHED", "id": "1236443787644145"}]}, "baseline_offer": {"id": "1239829951486817"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "880159148179075"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25585804724415696", "version": "0.0.41"}, "id": "1294037788235044", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8056943324395107", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25585804724415696"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1294037788235044"}]}, "change_log": null, "created_date": 1768039369, "id": "25585804724415696", "version": "0.0.41", "ve
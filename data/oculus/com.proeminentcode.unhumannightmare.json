lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHbxiJW1y2PYzeQMUUDy7PyYi9MdHlS2msjI7Zj9okog&oe=6A8EE3A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "end_teaser_banner(2).png", "id": "861364526131253", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031492_861364529464586_4621012514357551804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd3BSjdcUBkQ7kNvwE1VFj0&_nc_oc=AdqeoxQ7UzCjj5q65wySOiK9QVhGAxNZ4VyUuPkGN6tjYaUoeROAuVALRS1L4xA3AN0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG343BOYDTMGhBFyZGqhngI2jFBXu1Rohm4_9LQssh9YA&oe=6A8EBBE8"}, "display_name": "Unhuman Nightmare", "keywords": ["horror", "unhuman", "nightmare", "thriller", "ghosts"], "long_description": "Unhuman Nightmare is a 4 player online co-op game where a team of thieves want to steal items from haunted places. What they don't know is that the places are full of traps set by ghosts. Chances are, they'll not escape alive...\n\n{527913049825827}\n- You and your friends go to abandoned places in order to steal goods\n- What you don't know, or what you should...\n- Is that these places are haunted\n- Worse than that...\n- The places are full of traps and moving stuff in the air\n- No matter if you choose to play alone or with your friends...\n- You should get out with as much stuff as possible and preferable alive!\n- Your life insurance may not cover this event, so take care!\n\n{924107876225417}\n- There's too much danger to go alone and steal stuff from haunted places!\n- Especially when you know that there are random traps!\n- Why would you risk your sanity and life?\n\n\n{605097505326159}\n- Pick up your friends and play! \n- Don't miss the opportunity to laugh or scream together while being sweat!\n- Live together, steal together, die together...\n\n", "short_description": "Unhuman Nightmare is a 4 player online co-op game where a team of thieves want to steal items from haunted places. What they don't know is that the places are full of trap
JBCn5JqSCrn2YVrW1jU0DaQ&oe=6B0F12C1"}, {"file_name": "ss_5.png", "id": "27083063488004882", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974560_27083063504671547_6288918888953961205_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm1gxIwv11sQ7kNvwEstGqR&_nc_oc=Adp1UPaXrUx9q_3nRUV6rUJDJQFRa60F7C1v6ycZC7yjuumMyv7RNUgwPeM0DjS_RTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVUt7AleKlrDQ_vvNZLxgOeT7FRl25B3Coi0uxQFXtWYg&oe=6B0EFD64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "end_teaser_banner(2).png", "id": "861364526131253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031492_861364529464586_4621012514357551804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9xfFPJmwD8Q7kNvwFVxZL5&_nc_oc=Adoreq2lwjYxqearO-F1qh7O0Crbg_5ky6h4fksxlW1-slt-1yqnUSA4Pck2flJW4Hc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUaDfwx3FN8vRwxZnnn-xJtC_Opu2kY20Uip1JARGJzoA&oe=6B0F0DE8"}, "display_name": "Unhuman Nightmare", "keywords": ["horror", "unhuman", "nightmare", "thriller", "ghosts"], "long_description": "Unhuman Nightmare is a 4 player online co-op game where a team of thieves want to steal items from haunted places. What they don't know is that the places are full of traps set by ghosts. Chances are, they'll not escape alive...\n\n{527913049825827}\n- You and your friends go to abandoned places in order to steal goods\n- What you don't know, or what you should...\n- Is that these places are haunted\n- Worse than that...\n- The places are full of traps and moving stuff in the air\n- No matter if you choose to play alone or with your friends...\n- You should get out with as much stuff as possible and preferable alive!\n- Your life insurance may not cover this event, so take care!\n\n{924107876225417}\n- There's too much danger to go alone and steal stuff from haunted places!\n- Especially when you know that there are random traps!\n- Why would you risk your sanity and life?\n\n\n{605097505326159}\n- Pick up your friends and play! \n- Don't miss the opportunity to laugh or scream together while being sweat!\n- Live together, steal together, die together...\n\n", "short_description": "Unhuman Nightmare is a 4 player online co-op game where a team of thieves want to steal items from haunted places. What they don't know is that the places are full of traps set by ghosts. Chances are, they'll not escape alive..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://proeminentcode.com/privacy-policy-for-unhuman-nightmare/", "developer_terms_of_service_url": null, "publisher_name": "Proeminent Code SRL", "support_website_url": "https://proeminentcode.com/contact/", "website_url": "https://proeminentcode.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "8056943351061771"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "28516105238091312"}, {"status": "PUBLISHED", "id": "5587218954858216"}, {"status": "PUBLISHED", "id": "1385013033469797"}, {"status": "PUBLISHED", "id": "1543089887422132"}, {"status": "PUBLISHED", "id": "26407609712264142"}, {"status": "PUBLISHED", "id": "1438086257700300"}, {"status": "PUBLISHED", "id": "1224437579344944"}, {"status": "PUBLISHED", "id": "880159148179075"}, {"status": "PUBLISHED", "id": "123982995
eKhmdEiA&oe=6AE49E28"}, {"file_name": "Modding Car 2.png", "id": "2482921428868965", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303790_2482921432202298_8377252120234429994_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HjI3uKMoJkQ7kNvwF75Q1E&_nc_oc=AdoSpYzjNGGVcKSs8xXXN0J80ry8MkRTZF8Y6U4mc0FOWz-iT6ln-JZEcmt39t9JA1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCvQWrXOueAUPiGMvb04kWr3mW-f91CdJPpuaIhQFHNw&oe=6AE494E8"}, {"file_name": "Godfather.png", "id": "2284114725670963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2284114729004296_5512178144555942600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qs8ga4ZrMsQ7kNvwHeLMlM&_nc_oc=AdoOIBPHH3nBAXJiEsJ87639fkCtLsoIeYmKJl9i2K1pntIAjLspLsxICiEICf6VPAo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_vc9HVEyqE8C3twHEfQ476KR5QvFn7b_C7Hm_a7KG4Q&oe=6AE4B6CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shiesty_Keyart_Launch_Sunset.png", "id": "2323455281722572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/742308944_2323455285055905_5122063640660435985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrYkstPA6bUQ7kNvwEa5FW_&_nc_oc=Ado0NL7pq-fVwgFPxnyIfD6NywOgL-ON3qUIxeFuW1JXmF5gCexz3evuWAUV_zEEfh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG-wix5u5jXW_kAQRreIQwJApD4fjQJuday83R0UmvZw&oe=6AE4BE3C"}, "display_name": "Shiesty", "keywords": ["GTA", "Animal", "Gorilla", "simulator", "action"], "long_description": "# Welcome to Hustle Rock, the city of crime!\nShiesty is a free-to-play open-world crime sandbox in VR where there are no rules. Steal cars, rob stores, and climb the criminal underworld with your friends. Just watch out for the cops!\n\n**Key Features**:\n- \ud83d\udcb0 **Rob Anything & Anyone**: Hold up stores, lockpick registers, and point your weapon at any NPC to make them cough up the goods.\n- \ud83d\ude97 **Steal & Customize**: Collect every car and gun in Hustle Rock, then customize them your way.\n- \ud83d\udea8 **Wanted Stars**: The more chaos you cause, the harder the police come after you.\n- \ud83d\udc51 **Rise Through the Ranks**: Fence your loot at the pawn shop, then pay the Don what you owe to level up.\n- \ud83d\udcf1 **Play with Friends**: Call any player directly on your in-game phone, complete with a mini map.\n- \ud83e\ude9d **Move Your Way**: Climb, drive, zip line, and grapple your way across the city.\n\n**Free to play November 5th, 2026, only on Meta Quest. Ready to get Shiesty?**", "short_description": "Shiesty is a free-to-play open-world crime sandbox in VR where there are no rules. Steal cars, rob stores, and climb the criminal underworld with your friends. Just watch out for the cops!"}, {"images": {"nodes": []}, "id": "1651538756324218", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shiesty", "keywords": ["GTA", "Animal", "Singe", "Action", "Simulation"], "long_description": "# Bienvenue \u00e0 Hustle Rock, la ville du crime !\n\nShiesty est un bac \u00e0 sable criminel en monde ouvert, gratuit et en r\u00e9alit\u00e9 virtuelle, o\u00f9 il n\u2019y a aucune r\u00e8gle. Volez des voitures, braquez des commerces et gravissez les \u00e9chelons de la p\u00e8gre avec vos amis. Mais attention aux flics !\n\n**Caract\u00e9ristiques principales :**\n- \ud83d\udcb0 Volez tout et n\u2019importe qui : Braquez des commerces, crochetez des caisses enregistreuses et pointez votre arme sur n\u2019importe quel PNJ pour le forcer \u00e0 cracher le butin.\n- \ud83d\ude97 Volez et personnalisez : Collectionnez toutes les voitures et toutes les armes de Hustle Rock, puis personnalisez-les \u00e0 votre fa\u00e7on.\n- \ud83d\udea8 Niveau de recherche : Plus vous semez le chaos, plus la police vous traque sans rel\u00e2che.\n- \ud83d\udc51 Gravissez les \u00e9chelons : \u00c9coulez votre butin chez le pr\u00eateur sur gages, puis payez au Don ce que vous lui devez pour monter en niveau.\n- \ud83d\udcf1 Jouez avec vos amis : Appelez directement n\u2019importe quel joueur avec votre t\u00e9l\u00e9phone en jeu, mini-carte incluse.\n- \ud83e\ude9d D\u00e9placez-vous \u00e0 votre fa\u00e7on : Grimpez, conduisez, filez en tyrolienne et utilisez votre grappin pour traverser la ville.\n\nGratuit d\u00e8s le 5 novembre 2026, exclusivement sur Meta Quest. Pr\u00eat \u00e0 devenir Shiesty ?", "short_description": "Shiesty est un bac \u00e0 sable criminel en monde ouvert, gratuit et en r\u00e9alit\u00e9 virtuelle, o\u00f9 il n\u2019y a aucune r\u00e8gle. Volez des voitures, braquez des commerces et gravissez les \u00e9chelons de la p\u00e8gre avec vos amis. Mais attention aux flics !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curlyblue.com/privacy-policy/", "developer_terms_of_service_url": "https://curlyblue.com/terms-of-service", "publisher_name": "CurlyBlue LTD.", "support_website_url": null, "website_url": "https://curlyblue.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29482589141334037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303864_2050502389223959_3614438278630288526_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STlLUxHRPQgQ7
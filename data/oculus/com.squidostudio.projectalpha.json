es": [{"id": "8213236728778802"}]}, "id": "501409392588154"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "6859397944122034"}]}, "id": "1181735076547542"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "5446476285387663"}]}, "id": "463985305463838"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "4317356281612249"}]}, "id": "3799404183428618"}]}}, "firstRevision": {"nodes": [{"application": {"id": "23961251736801166", "release_date": 1749751200, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29785401177719497"}, "id": "9667095586712466"}]}}, "binary": null, "live_binary": null, "created_date": 1793385384, "id": "29581211501471800", "is_initial_release": false, "name_with_fallback": "v21", "pdp_metadata_with_fallback": {"version": 21, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29781201594806122"}, "release_status": "RELEASED", "id": "23961251736801166"}, "id": "29581219174804366", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "23961251736801166", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1667200711421966"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1612967656406402", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shiesty", "keywords": ["GTA", "Animal", "Singe", "Action", "Simulation"], "long_description": "# Bienvenue \u00e0 Hustle Rock, la ville du crime !\n\nShiesty est un bac \u00e0 sable criminel en monde ouvert, gratuit et en r\u00e9alit\u00e9 virtuelle, o\u00f9 il n\u2019y a aucune r\u00e8gle. Volez des voitures, braquez des commerces et gravissez les \u00e9chelons de la p\u00e8gre avec vos amis. Mais attention aux flics !\n\n**Caract\u00e9ristiques principales :**\n- \ud83d\udcb0 Volez tout et n\u2019importe qui : Braquez des commerces, crochetez des caisses enregistreuses et pointez votre arme sur n\u2019importe quel PNJ pour le forcer \u00e0 cracher le butin.\n- \ud83d\ude97 Volez et personnalisez : Collectionnez toutes les voitures et toutes les armes de Hustle Rock, puis personnalisez-les \u00e0 votre fa\u00e7on.\n- \ud83d\udea8 Niveau de recherche : Plus vous semez le chaos, plus la police vous traque sans rel\u00e2che.\n- \ud83d\udc51 Gravissez les \u00e9chelons : \u00c9coulez votre butin chez le pr\u00eateur sur gages, puis payez au Don ce que vous lui devez pour monter en niveau.\n- \ud83d\udcf1 Jouez avec vos amis : Appelez directement n\u2019importe quel joueur avec votre t\u00e9l\u00e9phone en jeu, mini-carte incluse.\n- \ud83e\ude9d D\u00e9placez-vous \u00e0 votre fa\u00e7on : Grimpez, conduisez, filez en tyrolienne et utilisez votre grappin pour traverser la ville.\n\n**Pr\u00eat \u00e0 devenir Shiesty ?**", "short_description": "Shiesty est un bac \u00e0 sable criminel en monde ouvert, gratuit et en r\u00e9alit\u00e9 virtuelle, o\u00f9 il n\u2019y a aucune r\u00e8gle. Volez des voitures, braquez des commerces et gravissez les \u00e9chelons de la p\u00e8gre avec vos amis. Mais attention aux flics !"}, {"images": {"nodes": [{"file_name": "LaunchKeyart_Wide.png", "id": "2232111354409517", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/790754744_2232111357742850_6396463789462686679_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqbtKDB-k7sQ7kNvwEIS8AU&_nc_oc=AdpScgOhOz06E4rBblgxhiAjij4kxrzA1geXJiGQlWKH6wHENcOI-53LYaGVGvp1NCU&_nc_zt=3&_nc_ht=scontent-iad3-1
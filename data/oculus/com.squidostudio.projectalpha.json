5_aI96PA&oe=6ADE06A8"}, {"file_name": "Modding Car 2.png", "id": "2482921428868965", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303790_2482921432202298_8377252120234429994_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJh6fptHtWUQ7kNvwEpn30v&_nc_oc=Adq_eqLeWzJLTKZRJ34vyHwH7fm1HHfmh_qKjFVtBN1Im-wCcfoKMfha4HvbME2Drpo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNxWsegvO9r5rxQdXHB-9g8abI6sGEOJbOjg-2xhNLEQ&oe=6ADDFD68"}, {"file_name": "Godfather.png", "id": "2284114725670963", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2284114729004296_5512178144555942600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRHsUO0F4iIQ7kNvwHiKDXC&_nc_oc=AdryfFuoRpI7eS16GLdtLQTCmmp9NLs-wTrmK-5uiOmj0NbqvfO3dv8CnEPb087ielE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvHkDUHd3Rx86VVN_35Q70sVgxkxrBbbpfAo5t8P8Zig&oe=6ADE1F4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shiesty_Keyart_Launch_Sunset.png", "id": "2323455281722572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/742308944_2323455285055905_5122063640660435985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xnHfFtD_s0Q7kNvwHxQVOj&_nc_oc=Adq_kmPmqG7rvkiMEaeYsMWXEOy9ChIc-KZvc5jiP3amalR-9y_3cmk9hPk72IG5nZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUKBfbcxfzQdz29F6uexw1O9cnb-0s7OE7LH8imKlSSg&oe=6ADE26BC"}, "display_name": "Shiesty", "keywords": ["GTA", "Animal", "Gorilla", "simulator", "action"], "long_description": "# Welcome to Hustle Rock, the city of crime!\nShiesty is a free-to-play open-world crime sandbox in VR where there are no rules. Steal cars, rob stores, and climb the criminal underworld with your friends. Just watch out for the cops!\n\n**Key Features**:\n- \ud83d\udcb0 **Rob Anything & Anyone**: Hold up stores, lockpick registers, and point your weapon at any NPC to make them cough up the goods.\n- \ud83d\ude97 **Steal & Customize**: Collect every car and gun in Hustle Rock, then customize them your way.\n- \ud83d\udea8 **Wanted Stars**: The more chaos you cause, the harder the police come after you.\n- \ud83d\udc51 **Rise Through the Ranks**: Fence your loot at the pawn shop, then pay the Don what you owe to level up.\n- \ud83d\udcf1 **Play with Friends**: Call any player directly on your in-game phone, complete with a mini map.\n- \ud83e\ude9d **Move Your Way**: Climb, drive, zip line, and grapple your way across the city.\n\n**Free to play November 5th, 2026, only on Meta Quest. Ready to get Shiesty?**", "short_description": "Shiesty is a free-to-play open-world crime sandbox in VR where there are no rules. Steal cars, rob stores, and climb the criminal underworld with your friends. Just watch out for the cops!"}, {"images": {"nodes": []}, "id": "1150542257630141", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GRAND THEFT ANIMALS", "keywords": ["GTA", "Animal", "Singe", "Action", "Simulation"], "long_description": "Explore les terres de DOPE CITY et r\u00e8gne en ma\u00eetre !", "short_description": "Explore les terres de DOPE CITY et r\u00e8gne en ma\u00eetre !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curlyblue.com/privacy-policy/", "developer_terms_of_service_url": "https://curlyblue.com/terms-of-service", "publisher_name": "CurlyBlue LTD.", "support_website_url": null, "website_url": "https://curlyblue.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
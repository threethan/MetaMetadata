oculuscdn.com/v/t64.5771-25/499303790_2482921432202298_8377252120234429994_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9mzp4kowMUQ7kNvwERJ_qx&_nc_oc=Adq3wMQEJ661GtifxxGsYgBz5U5ZVeovlcP7GMV3_6gylaX7xAyt7SeLn6JIlQHUPaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKJD_qCTDQULTeGu6AgvB7nUFaQu-Lt7tQ1SxmbtqsaA&oe=6AF893A8"}, {"file_name": "Godfather.png", "id": "2284114725670963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303445_2284114729004296_5512178144555942600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iwqq4OIY1uUQ7kNvwHYVHb7&_nc_oc=AdoD9RAkrearDyclhkYzcDfCFuSZoLgzBPtJPGRthIGHOe5-VsWmX-Pe4sCBIcplS7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYJzUDj_OsD-_d7LSFwy2d7cy_GcQcY4Qdm_VZiH8WzA&oe=6AF87D4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LaunchKeyart_Landscape.png", "id": "4513024582290936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604306524_4513024585624269_8059739039163825062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9W8F3tJJA4Q7kNvwEdjmXm&_nc_oc=AdppBjOxAsS5RPdIe1V9DdeF0hhIqBfw8-DmOD8DqlI835YMMLm3OLEVcHcEmBRGpMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTydwhIypPekMuBAp9FUcJxjQyqXwFWnlAERfTgvVz6tg&oe=6AF89151"}, "display_name": "Shiesty", "keywords": ["GTA", "Animal", "Gorilla", "simulator", "action"], "long_description": "# Welcome to Hustle Rock, the city of crime!                                                                                                                                \n                                                                                                          \n{1153854583685959}\nShiesty is a free-to-play open-world crime sandbox in VR where there are no rules. Steal cars, rob stores, and climb the criminal underworld with your friends. Just watch out for the cops!\n{1113456481541042}\n\n**Key Features**:\n- \ud83d\udcb0 **Rob Anything & Anyone**: Hold up stores, lockpick registers, and point your weapon at any NPC to make them cough up the goods.\n- \ud83d\ude97 **Steal & Customize**: Collect every car and gun in Hustle Rock, then customize them your way.\n- \ud83d\udea8 **Wanted Stars**: The more chaos you cause, the harder the police come after you.\n- \ud83d\udc51 **Rise Through the Ranks**: Fence your loot at the pawn shop, then pay the Don what you owe to level up.\n- \ud83d\udcf1 **Play with Friends**: Call any player directly on your in-game phone, complete with a mini map.\n- \ud83e\ude9d **Move Your Way**: Climb, drive, zip line, and grapple your way across the city.\n\n**Ready to get Shiesty?**", "short_description": "Shiesty is a free-to-play open-world crime sandbox in VR where there are no rules. Steal cars, rob stores, and climb the criminal underworld with your friends. Just watch out for the cops!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curlyblue.com/privacy-policy/", "developer_terms_of_service_url": "https://curlyblue.com/terms-of-service", "publisher_name": "CurlyBlue LTD.", "support_website_url": null, "website_url": "https://curlyblue.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29581219174804366"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-2
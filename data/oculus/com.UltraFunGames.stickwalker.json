Af89ZyFYZ3qBRbkttZtskbEvby8d-C41H4vSPJrfd6w34Q&oe=6A32C813"}, {"file_name": "StickWalker_16x9_2.png", "id": "951633914315799", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823341_951633917649132_2833773676177760528_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiPPZwYOI04Q7kNvwGL9fqC&_nc_oc=AdpTNSynRJw2prrLloz7yD78mCwrvuS5WCVe63q2djVVxk5FNgfO1Ad6sqoQ-0R0-Fc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-06cyzzp8nZMjR5gOfnIJC2X5VheRcilUQQM0glis9dg&oe=6A32AF95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "upscalemedia-transformed.png", "id": "2104933976738573", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618442_2104933980071906_4629651452680378869_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6mGuPU5Nw8Q7kNvwHd_yve&_nc_oc=AdqLQghKfzuVBBUBpBY_5Emaw9eCp2qiM04D4ttZwAUB4Xlcjip_tSzR0kVEf1OJfpI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3HjWVGfmcUio0bxDK2COCpnaeSHsw6H8rgmBOreQ-7Q&oe=6A32B455"}, "display_name": "Stick Walker VR", "keywords": ["difficult", "obstacle", "physics", "walking", "challenge"], "long_description": "Stick Walker VR could be the hardest VR challenge ever created!\n\nIn this intense physics-based survival experience, you must learn to walk using only metal sticks while navigating dangerous music-reactive floors, brutal obstacles, moving platforms, and precision balance sections designed to push your coordination to the limit.\n\nThere\u2019s one simple rule: DO NOT TOUCH THE FLOOR.\n\nThe moment your feet hit the ground, it\u2019s game over.\n\nWhat starts as a simple movement challenge quickly becomes a true test of skill, balance, timing, endurance, and focus. Every step matters. Every movement can save you or destroy your run. Master advanced stick-walking mechanics, survive increasingly difficult environments, and discover techniques that separate beginners from elite players.\n\nCompete against players worldwide through global leaderboards, improve your times and scores, and prove you can survive longer than anyone else on Quest. Whether you want to challenge your friends, become the number one Stick Walker in the world, or simply experience one of the most unique VR movement systems ever made, this is a game designed to create unforgettable moments, hilarious fails, and intense victories.\n\nFeatures:\n\nPhysics-based stick walking locomotion\n\nReactive music-driven floors and environments\n\nInstant fail gameplay with high tension\n\nGlobal leaderboards and score chasing\n\nIncreasingly difficult challenge maps\n\nSkill-based movement and balance mechanics\n\nHardcore gameplay designed for mastery!\n ", "short_description": "Stick Walker VR might be the hardest VR game ever made. Walk using only metal sticks, survive the reactive floor, and don\u2019t let your feet touch the ground or it\u2019s instant game over. Master impossible balance challenges, climb the global leaderboards, and prove you can survive longer than anyone else on Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "Ultra Fun Games", "support_website_url": null, "website_url": "https://www.ultrafungames.com/#hero", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1672577396871977"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_
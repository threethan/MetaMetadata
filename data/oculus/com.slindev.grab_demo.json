0f&oh=00_Af2lMZlQe9XLWk3ohHpaD_vVp_uAVQY4T5feu5uD7rirAg&oe=69EF80DF"}, {"file_name": "4_big.png", "id": "193667932815084", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035387_193667939481750_4800023452492680439_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_vpExrBXm4Q7kNvwHF5GOC&_nc_oc=AdpURCY0gD-iX7Uupt_U0mldW6IBU_lscaeJ6znuIxO5Rk3JZW-XOwFbzOty-SUtAAo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01A2nnQ2h0ljLgijKkdidgR0EGfgZRURLBG1Mu727XAw&oe=69EF74E5"}, {"file_name": "3_big.png", "id": "522687855471572", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031312_522687858804905_8145332485232666619_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmnsN4PREpgQ7kNvwGzzttG&_nc_oc=Adr2a8QQoJizc3MS-NFPYqdxismnsktdncVuZes2rx9Mq7g39koNoZmFXj3DrvfRkXs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qkO2BNRWT03XrlYZosIBYtLa0YsMAadKCmsxHoaNBCA&oe=69EF7C23"}, {"file_name": "1_big.png", "id": "199568998897145", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031400_199569002230478_2678784042357543218_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvavzdxSBsYQ7kNvwHg-ZS0&_nc_oc=AdqctGkzdhXEq8AsCtZl-srGZQM__Y6wNIQa9xIOYZvfmZXseNR9ZgrgKofLdCpPwhE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00cvzeGDLhA9iRPHQNFEC_bmdETgph7z3GzYhL6ToiuA&oe=69EF7305"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "247676503873355", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974632_247676507206688_6297495042000249873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPBVkO5lV_sQ7kNvwGFaJ7l&_nc_oc=Adqw87dyETxsS5pIlyFZfa_DSjIhcQg1nola1LaqenQQmFokf1wiBnjRsHTRAbnr0mY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fKVy87AvOnhCNhVtAlHZSpu5FuJ__vn9daTKAZF3srw&oe=69EF70A8"}, "display_name": "GRAB Demo", "keywords": [], "long_description": "This is the full early access version of GRAB, but will eventually become a more limited demo!\n\nGRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!\nA core component of GRAB is the level editor that lets you and your friends create your own levels together and upload them for everyone else to play.\n\nFeatures:\n- Active and fun physics based controls\n- Play with up to 16 players in cross platform multiplayer\n- Built-in tutorial levels to get you started as well as some more advanced bigger levels\n- Built-in level editor that lets you build levels together with your friends in multiplayer with quick switching between testing and editing\n- Download levels made by the community and upload your own", "short_description": "GRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://slindev.com/grab", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "630351748179695"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "473475945549280"}, {"status": "PUBLISHED", "id": "222566259952082"}]}, "baseline_offer": {"id": "473475945549280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723136400, "status": "PUBLISHED", "id": "473475945549280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26123207624017428", "version": "0.75.1"}, "id": "1974803902687197", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26123207624017428"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775437444, "id": "26123746983963492", "version": "0.75.1", "version_code": 3593, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26123207624017428"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Fixed a bug that would cause grouped objects positions to not update correctly in code.\n- Color previews on hover are no longer networked, hopefully fixing a problem of other players seeing wrong colors.\n- Implemented a GPU performance improvement, resulting in a higher visual quality outside of the screen center.", "created_date": 1775432316, "id": "26123207624017428", "version": "0.75.1", "version_code": 3589, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26123207624017428"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- New lobby!\n- New time limited items in the shop!\n- A coding tutorial has been added.\n- The code editor now shows tooltips for a lot of things.\n- Code can now check what player part a trigger was triggered by.\n- It is now possible to add and remove objects inside groups without ungrouping first.\n- It is now possible go into physics groups and make changes.\n- Things inside physics groups that are passable are now allowed to be animated.\n- In code, it is now possible to drag and drop the program counter on a DST slot to write it. (but does not show in the dropdown as this is a more advanced feature)\n- Light properties can now be changed with triggers.\n- Sounds can now be animated.\n- Fixed a bunch of issues around groups and enabling physics.\n- Fixed a bunch of memory leaks.\n- Reduced undo to only undo the last 2000 changes (it was potentially using too much memory before at 100000)\n- Complexity is back to normal.", "created_date": 1775093981, "id": "26079469331724591", "version": "0.75.0", "version_code": 3579, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_releas
_name": "4_big.png", "id": "193667932815084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035387_193667939481750_4800023452492680439_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGtWdOIyUUMQ7kNvwHDhmMU&_nc_oc=AdmLnMxZgjVJ6aXHqV0LpM33dn6Tf_ZgR0z2gydOp-JQIhUr05xL6hO1EwiGOb133h0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3C6IL8e8OJ4ApmgKcy8eaID3n_NRchTe0IkuVprvbEg&oe=69B815E5"}, {"file_name": "3_big.png", "id": "522687855471572", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_522687858804905_8145332485232666619_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jboq_09d-YQ7kNvwHrArdH&_nc_oc=AdmFalWVnMtbLYMCwGrtRuTslXFFmWllgFbZfs4DCnfwyZu3YdsJoq4nLR7uEfcL9zI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXHlFsgekVpsD71149Iy9p7OWqcbv-FFGOdllHSpWtUQ&oe=69B7E4E3"}, {"file_name": "1_big.png", "id": "199568998897145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_199569002230478_2678784042357543218_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxrUdiAOJOEQ7kNvwF1X55h&_nc_oc=Adk4VoZ5W-UiU6UxwgYtuLLnNlJdMmE7KiIkDIutbvnVKGLGh9y9nJZHjOt8IHU_6BE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4jIlYVWp68aRW0iXVrn6ay5dqDKqHEovmMyLRhM1SMw&oe=69B81405"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "247676503873355", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974632_247676507206688_6297495042000249873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhETngViI1UQ7kNvwEZEajp&_nc_oc=AdkZ6eTfkduLRGL6IVb2B_m211NjmA_vQPIiEN5CZ-Ojw_qjsW3Yoghw7nBkqZ6aot4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzkcnwm--5jPQ7t3R5SIwLzxrVs8wGyMTe2SZC8fs9dLQ&oe=69B811A8"}, "display_name": "GRAB Demo", "keywords": [], "long_description": "This is the full early access version of GRAB, but will eventually become a more limited demo!\n\nGRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!\nA core component of GRAB is the level editor that lets you and your friends create your own levels together and upload them for everyone else to play.\n\nFeatures:\n- Active and fun physics based controls\n- Play with up to 16 players in cross platform multiplayer\n- Built-in tutorial levels to get you started as well as some more advanced bigger levels\n- Built-in level editor that lets you build levels together with your friends in multiplayer with quick switching between testing and editing\n- Download levels made by the community and upload your own", "short_description": "GRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://slindev.com/grab", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "630351748179695"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "473475945549280"}, {"status": "PUBLISHED", "id": "222566259952082"}]}, "baseline_offer": {"id": "473475945549280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723136400, "status": "PUBLISHED", "id": "473475945549280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25816501728021354", "version": "0.73.0"}, "id": "1974803902687197", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25816501728021354"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Lights.\n- Light color, range and brightness can be controlled by code.\n- Color blocks now have a gradient mode, making them blend between two colors.\n- Code can now disable the physics of physics blocks to be able move them.\n- Code can now respawn players without the help of lava.\n- Code can now remove just the last character on signs.\n- Every player now has a \"Statistics\" screen with a bunch of numbers.\n- There is now a global \"Top Players\" leaderboard. The more harder levels you beat, the better your score. Your score can only improve or stay the same and never get worse. Only recent plays count and lose value over time so it's possible to catch up for new players.\n- Added more settings to the level ambience settings to directly control sun color and brightness and to directly control the levels ambient lighting (the light that is always there even if there is no light).\n- Updated the design of the ambience and trigger connection settings.\n- Hovering a color on the color picker for color blocks will now immediately preview the color and hide the highlight.\n- Various bug fixes.\n- New lobby.\n- Updated shop.\n- New cosmetics.", "created_date": 1772826492, "id": "25816501728021354"
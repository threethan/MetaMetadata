P12T6XkhTYtAvmLY-S_6MdhpQ6OHKHQ&oe=6A1DAF6F"}, {"file_name": "3.png", "id": "1805259886561544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982453_1805259889894877_326132498281152252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM8CDTjUBlMQ7kNvwF_T35x&_nc_oc=AdoYW5qSlcBt5K7BCu9G9AwFXjFK1U06Jlh_G_mZD2F58IHih1qeS0IfUjRl2ribjjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75AtKQM6H1xZmd4meTyT_dR6rJ7jvs0nTSQIpqy82DPg&oe=6A1D8FCC"}, {"file_name": "5.png", "id": "1350175522351080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982626_1350175525684413_2966819136963002345_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhOylSy64v0Q7kNvwGDgf_2&_nc_oc=AdoaK1E5RDSc9qRDj8lLm99PqP2Thn_BYtJNVMbmhFtuR-UY3lI5fql4a8gic2i6sm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jsG-JS6IqLn12zQhFf10LpcRJ0WYuZcFyjeG2UtIndQ&oe=6A1D87B3"}, {"file_name": "4.png", "id": "339393762340623", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_339393765673956_3885185240601273819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5DMkh8gTdYQ7kNvwFnbWKo&_nc_oc=AdosYGtg6-_hUYlqsmVLP3xTBze0AuKi4YaEwdBJWO-bQbHIBsgnD14QZP-1P4oti1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NpnhObgRIOrB-u5tJQ_U6cIxJ-DsMk5DOPQHCqyDg5w&oe=6A1D7DD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverQuerformat_2560x1440_Mai2026.png", "id": "810565105089750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_810565108423083_1224889280969542300_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRIJOfMaRusQ7kNvwGL0v70&_nc_oc=AdraXjHn_WdWJgmVH3j0PtAY8JyjZtOaZBGK967etl-UiHp3IMGKbtxp2mOgwm6rH3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ngqbq4xL-UzrPK8atNY-C9NmsE45WXUiJ5jYuYfz_gw&oe=6A1DA9C7"}, "display_name": "GRAB", "keywords": ["platform", "climbing", "grapple", "grappling", "creative"], "long_description": "Ready to become a parkour master with your friends? Dive into GRAB, the coolest multiplayer platforming game!\n\n# \ud83d\ude80 UNIQUE MOVEMENT MECHANICS\nGrab the air to launch yourself in any direction. Swing with grappling hooks, climb impossible walls, and fling yourself through space. Master GRAB's innovative hand-based controls for the ultimate freedom of movement.\n\n# \ud83c\udf0d ENDLESS CHALLENGES\nWith over a million player-made levels, there's always a new parkour challenge waiting. Race against the clock, solve puzzles, or just enjoy the thrill of motion across a variety of creative courses.\n\n# \ud83c\udfd7\ufe0f CREATE & SHARE\nUnleash your inner level design genius! Use the intuitive level editor to bring your wildest ideas to life. Team up with friends to build in real-time, then watch as players worldwide attempt to conquer your creation.\n\n# \ud83e\udd1d MULTIPLAYER MAYHEM\n- Be part of an active community with thousands of players every day\n- Parkour through mind-bending levels with up to 12 players\n- Race against friends or work together to beat challenges\n- Build and test levels together in real-time\n\n# \ud83c\udf08 EXPRESS YOURSELF\nCustomize your character and show off your unique style as you swing, climb, and fly through the GRAB universe.", "short_description": "Experience the thrill of VR platforming in GRAB, where you can parkour through user-created levels with friends and build your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://grabvr.quest/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED"
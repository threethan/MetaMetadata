1-25/39031312_522687858804905_8145332485232666619_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8viR095YtBIQ7kNvwGXP_gs&_nc_oc=AdobW3pUt950eFmqdFw2L0P5ES7w4dnma-XfnELXUj9xSMq_BKgWw1HimdXn0g5BxsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwogLKjGN9kgDNddnddc57t9ID6-2d8RMRcUe8pNWrU-A&oe=69D0F163"}, {"file_name": "1_big.png", "id": "199568998897145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_199569002230478_2678784042357543218_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJS2yI1Tw14Q7kNvwHqwm4V&_nc_oc=Adp-7A5IDU0TBUdeYmkNYj-08Zf1h75rxxyL2WCnUawvzOiEW4Ap4stg_D1lUCL2tw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWXyWowzzZc4MLuLG_p3G4rGD1kPCeWEvTM5CQ_olphQ&oe=69D12085"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "247676503873355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974632_247676507206688_6297495042000249873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7neQHIWFUAQ7kNvwH9ONFv&_nc_oc=AdoVBAdjYcpkZQyJ1xSaEI6rt3E4YZ4moa68I2ZZnZ4T9EB8NF1CVSQX7FuFePHuCYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9t3_gW1XMJ92Z6FLijNRMBAeYOmldpD87qSPfNlhAdA&oe=69D11E28"}, "display_name": "GRAB Demo", "keywords": [], "long_description": "This is the full early access version of GRAB, but will eventually become a more limited demo!\n\nGRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!\nA core component of GRAB is the level editor that lets you and your friends create your own levels together and upload them for everyone else to play.\n\nFeatures:\n- Active and fun physics based controls\n- Play with up to 16 players in cross platform multiplayer\n- Built-in tutorial levels to get you started as well as some more advanced bigger levels\n- Built-in level editor that lets you build levels together with your friends in multiplayer with quick switching between testing and editing\n- Download levels made by the community and upload your own", "short_description": "GRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://slindev.com/grab", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "630351748179695"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "473475945549280"}, {"status": "PUBLISHED", "id": "222566259952082"}]}, "baseline_offer": {"id": "473475945549280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723136400, "status": "PUBLISHED", "id": "473475945549280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25998604389811086", "version": "0.74.0"}, "id": "1974803902687197", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25998604389811086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774628474, "id": "26022279160776942", "version": "0.74.0", "version_code": 3563, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25998604389811086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774526532, "id": "26009130445425147", "version": "0.75.0", "version_code": 3559, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25998604389811086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Sadly a lot of modded versions of GRAB has been spreading recently, so this update is an attempt to make modding a lot harder:\n- All new bans are now device bans, so switching accounts will not get around them.\n- GRAB will now crash if it detects that the apk has been tampered with.\n- If the quest entitlement check fails, GRAB will now close.\n- Implemented quest attestation api to validate device and app integrity and limit server access if compromised.\n- More symbols are now stripped out of the libGRAB.so file, making disassembling a bit harder.", "created_date": 1774445638, "id": "25998604389811086", "version": "0.74.0", "version_code": 3553, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25998604389811086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774442555, "id": "25998201803184678", "version": "0.74.0", "version_code": 3549, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25998604389811086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Sadly a lot of modded versions of GRAB has been spreading recently, so this update is an attempt to make modding a lot harder:\n- All new bans are now device bans, so switching accounts will not get around them.\n- GRAB will now crash if it detects that the apk has been tampered with.\n- If the quest entitlement check fails, GRAB will now close.\n- Implemented quest attestation api to validate device and app integrity and limit server access if compromised.\n- More symbols are now stripped out of the libGRAB.so file, making disassembling a bit harder.", "created_date": 1774385475, "id": "25991587397179452", "version": "0.74.0", "version_code": 3545, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
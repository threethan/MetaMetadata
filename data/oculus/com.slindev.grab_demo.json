_TGaF808jr2rUnW2Z80n38zhCLnzg&oe=6A08976F"}, {"file_name": "3.png", "id": "1805259886561544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982453_1805259889894877_326132498281152252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqKI8bwM3PUQ7kNvwGTfdPM&_nc_oc=AdrqKXw2Sz9AJ4kTvKkoD9t6kvG2N-wTJgOU-7lGu9Fi_J7EO6YWmkVnP-U_DL9WONs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CJxObpNjl3FH2aD5Ke0D-uv7jdk4rKPwcqdKEbITtPg&oe=6A0877CC"}, {"file_name": "5.png", "id": "1350175522351080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_1350175525684413_2966819136963002345_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVaIs6k3lbYQ7kNvwHTXKoT&_nc_oc=AdopQCmn-ihbAMT9sa9J2unxnRyktAKwD5MYCORHMnpSHFIvEbQcJixCfwKzZguKl0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6msWk9Oe0izKZ0BKS7CS1VJGhZwaigxqy4_O6cAEM9aQ&oe=6A086FB3"}, {"file_name": "4.png", "id": "339393762340623", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_339393765673956_3885185240601273819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKwv8WmqdqAQ7kNvwGAD3aX&_nc_oc=AdrdH-as_mCSfJIFKWKHkH2Q2Hv_5SDoUJwpLgb2NFi8uXJvheuRmZKW18viHE8Y_SA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VEf9m8nab1WYHle5JqD_McSpb2WsGPA4HUff6btlhxw&oe=6A0865D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverQuerformat_2560x1440_Mai2026.png", "id": "810565105089750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_810565108423083_1224889280969542300_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_BSp1jhVZwQ7kNvwHHsHQc&_nc_oc=AdoJqCHqtERchMe803gKYtm-dVVUnNwIy8EaapxHwr4rYy02_TkDTTUeNShUPoPZbBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VQc2_PzYmhea7sK53zN0HvJZtdH8PtSbyPbh6reBf8Q&oe=6A0891C7"}, "display_name": "GRAB", "keywords": ["platform", "climbing", "grapple", "grappling", "creative"], "long_description": "Ready to become a parkour master with your friends? Dive into GRAB, the coolest multiplayer platforming game!\n\n# \ud83d\ude80 UNIQUE MOVEMENT MECHANICS\nGrab the air to launch yourself in any direction. Swing with grappling hooks, climb impossible walls, and fling yourself through space. Master GRAB's innovative hand-based controls for the ultimate freedom of movement.\n\n# \ud83c\udf0d ENDLESS CHALLENGES\nWith over a million player-made levels, there's always a new parkour challenge waiting. Race against the clock, solve puzzles, or just enjoy the thrill of motion across a variety of creative courses.\n\n# \ud83c\udfd7\ufe0f CREATE & SHARE\nUnleash your inner level design genius! Use the intuitive level editor to bring your wildest ideas to life. Team up with friends to build in real-time, then watch as players worldwide attempt to conquer your creation.\n\n# \ud83e\udd1d MULTIPLAYER MAYHEM\n- Be part of an active community with thousands of players every day\n- Parkour through mind-bending levels with up to 12 players\n- Race against friends or work together to beat challenges\n- Build and test levels together in real-time\n\n# \ud83c\udf08 EXPRESS YOURSELF\nCustomize your character and show off your unique style as you swing, climb, and fly through the GRAB universe.", "short_description": "Experience the thrill of VR platforming in GRAB, where you can parkour through user-created levels with friends and build your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://grabvr.quest/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", 
piwQ&oe=6A9D7AE5"}, {"file_name": "3_big.png", "id": "522687855471572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031312_522687858804905_8145332485232666619_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6xWlhqa1BcQ7kNvwHo5G8m&_nc_oc=AdoEo_V5T8iqX4BLa3WptCky0VerwJuU8Xe65uslu86Dx6E7WU5Njx-uLvYEr5hRKeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9TZQKX-uvl05PW8xZrxGYsRn0aIBWxLWfEBQygL-LGA&oe=6A9D8223"}, {"file_name": "1_big.png", "id": "199568998897145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031400_199569002230478_2678784042357543218_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv5sEGBBHlEQ7kNvwEdC0qS&_nc_oc=AdpFOGUF_vuCFXCMSmQFm7Czx482ryFdSoEbwIxJfBfhNk_MpdUBwhNgcmTV3VwfduI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGnCjOg2EVJiQzyqlMy8u7MKPqGFQuafiXdKkvN5Buhw&oe=6A9D7905"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "247676503873355", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974632_247676507206688_6297495042000249873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sg6PzpqlFb0Q7kNvwH105Xv&_nc_oc=Adoxvu8Z2qOMUWByKR5LCHFkRZfVQhPRpntjCEfY_RbWoaqf9pMSQxzuTUKNZbO_ZaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJZNvpt1HYQqR-Qk6YrrvLfdNnDsFbjKY-EUwMOzq96w&oe=6A9D76A8"}, "display_name": "GRAB Demo", "keywords": [], "long_description": "This is the full early access version of GRAB, but will eventually become a more limited demo!\n\nGRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!\nA core component of GRAB is the level editor that lets you and your friends create your own levels together and upload them for everyone else to play.\n\nFeatures:\n- Active and fun physics based controls\n- Play with up to 16 players in cross platform multiplayer\n- Built-in tutorial levels to get you started as well as some more advanced bigger levels\n- Built-in level editor that lets you build levels together with your friends in multiplayer with quick switching between testing and editing\n- Download levels made by the community and upload your own", "short_description": "GRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://slindev.com/grab", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "630351748179695"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "473475945549280"}, {"status": "PUBLISHED", "id": "222566259952082"}]}, "baseline_offer": {"id": "473475945549280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723136400, "status": "PUBLISHED", "id": "473475945549280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27549642974707212", "version": "0.79.1"}, "id": "1974803902687197", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27549642974707212"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Practice mode is off by default in lobby settings. If you want to use practice mode, the host has to enable it in their lobby settings first.\n- Practice mode lobby setting is now saved, so you don't have to change it all the time to your preference.\n- Practice mode no longer allows interacting with any shared things in levels (shared triggers, shared code, shared physics).\n- Fixed a bug that would allow code blocks to break collisions in a level.\n- Fixed a bug that would allow to checkpoint while leaving practice mode to skip parts of levels.", "created_date": 1786041574, "id": "27549642974707212", "version": "0.79.1", "version_code": 3763, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27549642974707212"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- New lobby!\n- New cosmetic items in the shop!\n- Added a setting to disable grabbing other players.\n- Instead of a checkbox to hide other players, there is now a slider to change the distance for fading out other players close to you.\n- Added a new practice mode: When in a level and lobby that allows practice mode, you can now become an editor player, move around freely and practice sections of a level. While in practice mode you can not finish a level and any progress in the level is lost.\n- Added a setting to hide other players that are flying around in practice mode.\n- Fixed two handed scaling of sound and light range.\n- Fixed a bug that would prevent a very small number of players to connect to the servers.", "created_date": 1786023576, "id": "27546674951670681", "version": "0.79.0", "version_code": 3756, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27549642974707212"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Fixed several memory leaks, hopefully reducing the number of \"out of memory\" crashes.", "created_date": 1784287263, "id": "27315601708111341", "version": "0.78.2", "version_code": 3739, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27549642974707212"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Fixed crash from code setting a very high yaw teleport angle.\n- Fixed crash from duplicate code connection names.\n- Respawning / Restarting now cancels teleporting if both happen at the same time.", "created_date": 1783594591, "id": "27232171523121027", "version": "0.78.1", "version_code": 3733, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27549642974707212"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- New lobby!\n- New cosmetic items in the shop!\n- Added teleport registers to code blocks to teleport the local player.\n- Added velocity registers to code blocks to change the local players velocity.\n- Added several vector instructions for code blocks: VEC_SET, VEC_ADD, VEC_SUB, VEC_MUL, VEC_SCL, VEC_LEN, VEC_DOT\n- Added a POW and ABS instruction for code blocks.\n- Added a horror tag for lobbies.\n- Light and sound range can now be changed by scaling with both hands.", "created_date": 1783084032, "id": "27168914329446747", "version": "0.78.0", "version_code": 3723, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
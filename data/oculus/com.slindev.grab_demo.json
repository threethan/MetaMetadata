itpQ&oe=6AF08965"}, {"file_name": "3_big.png", "id": "522687855471572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031312_522687858804905_8145332485232666619_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CBDPIWqkSgQ7kNvwFJEjx9&_nc_oc=AdqIA73v368ho7QdZ629BURIeOhxUoQn1pg42jjSVfBmbf8pYlhTXWJVvVV4xvPiH9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt0caz2Kpauza_ZF-_1IIQiwm5L7eeSSMoSkEYUrEEPQ&oe=6AF090A3"}, {"file_name": "1_big.png", "id": "199568998897145", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_199569002230478_2678784042357543218_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_JOu1y3TVgQ7kNvwEa8EtI&_nc_oc=AdqylPob8RbIQHGpZ_azhFR69DqpdbF1u6Nhv_pQEF4lwrQYH6JALiwMw5aIDKbIRvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAn1H13mushQS4ERKZFWOF08pXk6bocqzf71X9-Yidsg&oe=6AF08785"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "247676503873355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974632_247676507206688_6297495042000249873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4YG6sZzbD4Q7kNvwFvbPVv&_nc_oc=Adox3P4kdcYputZb9Akgg2N9jQLvYgessY5Uoh6FyfMwls29mx7pyWDwXdyFRpXEXq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkS3MJJ4G_95StjWk6V7TudG7_iYAaTg0Ads3zYKYdJg&oe=6AF08528"}, "display_name": "GRAB Demo", "keywords": [], "long_description": "This is the full early access version of GRAB, but will eventually become a more limited demo!\n\nGRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!\nA core component of GRAB is the level editor that lets you and your friends create your own levels together and upload them for everyone else to play.\n\nFeatures:\n- Active and fun physics based controls\n- Play with up to 16 players in cross platform multiplayer\n- Built-in tutorial levels to get you started as well as some more advanced bigger levels\n- Built-in level editor that lets you build levels together with your friends in multiplayer with quick switching between testing and editing\n- Download levels made by the community and upload your own", "short_description": "GRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://slindev.com/grab", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "630351748179695"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "473475945549280"}, {"status": "PUBLISHED", "id": "222566259952082"}]}, "baseline_offer": {"id": "473475945549280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723136400, "status": "PUBLISHED", "id": "473475945549280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28290813233923512", "version": "0.81.0"}, "id": "1974803902687197", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes
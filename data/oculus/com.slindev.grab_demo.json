YXyhHEpmtVXmO4DrAeS-8pjqfb2gQO6ZN8OLCiw&oe=6A3175EF"}, {"file_name": "3.png", "id": "1805259886561544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982453_1805259889894877_326132498281152252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAffAArpWC0Q7kNvwGiF1SG&_nc_oc=AdpDgcSVRPjpdeeYUm973RYJxLcdqWvQyzx4eHudtbZjMXzGmiyJ3-kWZV0fg1OV5s0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZjtkipR3QFf9SqE-u3p6NlyHbAunuBNqfUtmZwvYVDA&oe=6A31564C"}, {"file_name": "5.png", "id": "1350175522351080", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982626_1350175525684413_2966819136963002345_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGQ5G683k8MQ7kNvwFhz1Ow&_nc_oc=Ado6M6XxbXuUxVz3X11hHhIbxdLxI8T_lYKyXfvybogJ1Bf7ORul5NEpgMZD9qVoMN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a8maYr8vFss5FHOEiunP2IN-j83bKMmm75BUU-mFrOg&oe=6A314E33"}, {"file_name": "4.png", "id": "339393762340623", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982548_339393765673956_3885185240601273819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Pd6z7WOSkoQ7kNvwEhklTM&_nc_oc=Adq6tPicCmsbADuq27NFSRn59qjy2rc9Z44TK5hRznT7yjpfyUOpnjry5icPV6RLsIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_67mqgvg4SZP01wVqU7Nz1sannYbnAEkZ89Pa95AYyNg&oe=6A314456"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverQuerformat_2560x14402026 _Juni2026.png", "id": "1493106022272939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823746_1493106025606272_1184643714601440240_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52FpI0AzagsQ7kNvwHFcA_h&_nc_oc=Adp9OA3v4lArUUxo5F1lpJ3sX16VfW1wV5ILNnYOSC6aGyLfXX_0-BkQdrL4Bllym_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8zAMxAvf3mZp2B9yNVmB3kZ63bUMo2fSI3CLWd95qgQ&oe=6A316EFC"}, "display_name": "GRAB", "keywords": ["platform", "climbing", "grapple", "grappling", "creative"], "long_description": "Ready to become a parkour master with your friends? Dive into GRAB, the coolest multiplayer platforming game!\n\n# \ud83d\ude80 UNIQUE MOVEMENT MECHANICS\nGrab the air to launch yourself in any direction. Swing with grappling hooks, climb impossible walls, and fling yourself through space. Master GRAB's innovative hand-based controls for the ultimate freedom of movement.\n\n# \ud83c\udf0d ENDLESS CHALLENGES\nWith over a million player-made levels, there's always a new parkour challenge waiting. Race against the clock, solve puzzles, or just enjoy the thrill of motion across a variety of creative courses.\n\n# \ud83c\udfd7\ufe0f CREATE & SHARE\nUnleash your inner level design genius! Use the intuitive level editor to bring your wildest ideas to life. Team up with friends to build in real-time, then watch as players worldwide attempt to conquer your creation.\n\n# \ud83e\udd1d MULTIPLAYER MAYHEM\n- Be part of an active community with thousands of players every day\n- Parkour through mind-bending levels with up to 12 players\n- Race against friends or work together to beat challenges\n- Build and test levels together in real-time\n\n# \ud83c\udf08 EXPRESS YOURSELF\nCustomize your character and show off your unique style as you swing, climb, and fly through the GRAB universe.", "short_description": "Experience the thrill of VR platforming in GRAB, where you can parkour through user-created levels with friends and build your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://grabvr.quest/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "528142316460358"}], "external_subscription_type"
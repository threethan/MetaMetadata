pj-IJ2Sc2mSJ2N9NJsJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-yk6llAJTZKDyyTFrWHM1bc3A1c1ggbGi9BvNWABm5g&oe=6AC1296F"}, {"file_name": "3.png", "id": "1805259886561544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982453_1805259889894877_326132498281152252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkjaaOh7qTQQ7kNvwGXqaOX&_nc_oc=AdrJSysCVlgV5mgbJE8nGjYV1FFY4eeAYZU84JDhS9rdE9idJcU0DS9xrJOUkTQIHkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo9cgby2PgVElBRiPwWPRi-J-cP6c3bEm26LFfCBirLw&oe=6AC109CC"}, {"file_name": "5.png", "id": "1350175522351080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982626_1350175525684413_2966819136963002345_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX8QE6dM9RkQ7kNvwE3T83X&_nc_oc=Adqo4qC01sgYTFQS4hm4bCg7xHB54GXIC2j0IkDhh3ntQplu_5pyDYXqUSjzchxemB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP5nPnxPC4s8bqYS-nM8nmcnFj8YsJQMeqLACx-POxCg&oe=6AC101B3"}, {"file_name": "4.png", "id": "339393762340623", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_339393765673956_3885185240601273819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrq131GR55kQ7kNvwG4OKML&_nc_oc=Adr97ElWZzsbCjoc-EcaV_SGNLHLs3k5f6s4Ou4kz4PYVopij1o6CHajuLeCEqa9c5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbxDBGl6oboTCFulT45gJDemdTfWGo2BI0U7OO9dejfA&oe=6AC13016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverQuerformat_2560x1440_.2026-2.png", "id": "1719995536005066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673751957_1719995539338399_6406133431116160006_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpaCsXOAvzMQ7kNvwGziAFb&_nc_oc=AdoStaHs0GIUYGA1myc9AOWscKGbOeau8gj2OPD6nTrRGgo7djbZ7k7Xh9QkCesZpXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSiHfybHq1jbb7SGg-WhP50UevTVLgJD56U_vQOwvEJQ&oe=6AC10833"}, "display_name": "GRAB", "keywords": ["platform", "climbing", "grapple", "grappling", "creative"], "long_description": "Ready to become a parkour master with your friends? Dive into GRAB, the coolest multiplayer platforming game!\n\n# \ud83d\ude80 UNIQUE MOVEMENT MECHANICS\nGrab the air to launch yourself in any direction. Swing with grappling hooks, climb impossible walls, and fling yourself through space. Master GRAB's innovative hand-based controls for the ultimate freedom of movement.\n\n# \ud83c\udf0d ENDLESS CHALLENGES\nWith over a million player-made levels, there's always a new parkour challenge waiting. Race against the clock, solve puzzles, or just enjoy the thrill of motion across a variety of creative courses.\n\n# \ud83c\udfd7\ufe0f CREATE & SHARE\nUnleash your inner level design genius! Use the intuitive level editor to bring your wildest ideas to life. Team up with friends to build in real-time, then watch as players worldwide attempt to conquer your creation.\n\n# \ud83e\udd1d MULTIPLAYER MAYHEM\n- Be part of an active community with thousands of players every day\n- Parkour through mind-bending levels with up to 12 players\n- Race against friends or work together to beat challenges\n- Build and test levels together in real-time\n\n# \ud83c\udf08 EXPRESS YOURSELF\nCustomize your character and show off your unique style as you swing, climb, and fly through the GRAB universe.", "short_description": "Experience the thrill of VR platforming in GRAB, where you can parkour through user-created levels with friends and build your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://grabvr.quest/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"
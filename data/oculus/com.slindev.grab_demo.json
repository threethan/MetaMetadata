d7FmCH46Ltlw2aaF8YvUHofb0yeRBo791llyG2cDA&oe=6A1DA55F"}, {"file_name": "4_big.png", "id": "193667932815084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035387_193667939481750_4800023452492680439_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLBz3DaWOJIQ7kNvwEg0Mgz&_nc_oc=Adqxsp0OwTtPZxlLUuYk_gc-tiGq8b3GBlDHTZWKAFq-5XZpL0JSW5IDiFe9kTr1ot8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mKJH6zlv-3sc4ngNpb4jwK1DpXPjR2Hu3a6T9D-RfMg&oe=6A1D9965"}, {"file_name": "3_big.png", "id": "522687855471572", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_522687858804905_8145332485232666619_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADuNE5LDGfcQ7kNvwGV4aRz&_nc_oc=Adokj7jQP5e-D8kJbpFkncfpn0tF4MH36n-E3L2ZHQS3AHi2sIu7HXsgfP2QjdHEItk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WUM9HCCeQXVSV2V462vrNltcmFvKZyvHlbLZVGqgYLA&oe=6A1DA0A3"}, {"file_name": "1_big.png", "id": "199568998897145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_199569002230478_2678784042357543218_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvVivjFFNZoQ7kNvwH5p3X9&_nc_oc=AdqHRPgvShZEReJszA4kC5p45TMYnav60TJQQ5vrgbVauLSrqxE2-_QVxiD3_LSqfic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LTMDUAzcqG2Ptkv0kKQzACeCyGRS9BTlp571vEc1aRQ&oe=6A1D9785"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "247676503873355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974632_247676507206688_6297495042000249873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW_-GtDfMKkQ7kNvwFy-OlM&_nc_oc=AdrBZVsDXpdSelxOGb2FjlaDAuOYFuM1q4RIUkS1dkXCSak4-mbxBy2jgkXXai1QKrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SDr5K8FlTVZoCXTyWrdNb-c7F10xPoLdCghy0JNI33A&oe=6A1D9528"}, "display_name": "GRAB Demo", "keywords": [], "long_description": "This is the full early access version of GRAB, but will eventually become a more limited demo!\n\nGRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!\nA core component of GRAB is the level editor that lets you and your friends create your own levels together and upload them for everyone else to play.\n\nFeatures:\n- Active and fun physics based controls\n- Play with up to 16 players in cross platform multiplayer\n- Built-in tutorial levels to get you started as well as some more advanced bigger levels\n- Built-in level editor that lets you build levels together with your friends in multiplayer with quick switching between testing and editing\n- Download levels made by the community and upload your own", "short_description": "GRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://slindev.com/grab", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "630351748179695"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "473475945549280"}, {"status": "PUBLISHED", "id": "222566259952082"}]}, "baseline_offer": {"id": "473475945549280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723136400, "status": "PUBLISHED", "id": "473475945549280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26583375894667263", "version": "0.76.1"}, "id": "1974803902687197", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26583375894667263"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Added a volume slider for player voice chat.\n- Added a volume slider for your own voice on recordings and live streams.\n- Made your own voice much louder on recordings and live streams.\n- Added connecting to twitch, which will automatically fetch the stream key and display the chat in-game.\n- Fixed camera rotation tilt following not working if the camera is minimized.\n- Made recording and streaming work on windows.\n- Increased maximum number of code block connections to 10.\n- Increased maximum number of animation frames per object to 1000.\n- Made grabbing non-physics objects no longer delayed by one frame.\n- Fixed a very common crash when closing the game.\n- Fixed a very common case of \"Looking for destination...\".\n- Fixed rotation speed calculation when letting go of a physics object.", "created_date": 1778944284, "id": "26583375894667263", "version": "0.76.1", "version_code": 3661, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26583375894667263"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778938099, "id": "26582345694770283", "version": "0.76.1", "version_code": 3657, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26583375894667263"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Added a volume slider for player voice chat.\n- Added a volume slider for your own voice on recordings and live streams.\n- Made your own voice much louder on recordings and live streams.\n- Added connecting to twitch, which will automatically fetch the stream key and display the chat in-game.\n- Fixed camera rotation tilt following not working if the camera is minimized.\n- Made recording and streaming work on windows.\n- Increased maximum number of code block connections to 10.\n- Increased maximum number of animation frames per object to 1000.\n- Made grabbing non-physics objects no longer delayed by one frame.\n- Fixed a very common crash when closing the game.\n- Fixed a very common case of \"Looking for destination...\".\n- Fixed rotation speed calculation when letting go of a physics object.", "created_date": 1778877082, "id": "26573487172322802", "version": "0.76.1", "version_code": 3651, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26583375894667263"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778874262, "id": "26573052429032943", "version": "0.76.1", "version_code": 3647, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26583375894667263"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Increased complexity limit: default to 2500 (was 2000), verified to 3500 (was 3000) and GRAB+ to 5000 (was 4000)\n- Rebalanced complexity: triggers now cost 3 (was 5), lights 5 (was 10), particle emitters 8 (was 5) and signs 10 (was 5).\n- Most rendering work now runs on a separate CPU thread allowing the next frames game update to run while still rendering the previous frame. This cuts CPU time almost in half, massively improving performance in many situations.\n- Quest 2 and Pico only: Reduced MSAA and anisotropic filtering quality to keep performance stable in GPU intensive scenes.\n- Occlusion culling is now much more aggressive, which helps with performance issues in some case.\n- The in-game camera now supports live streaming through RTMP and RTMPS (tested with youtube and twitch).\n- The in-game camera now keeps the audio in sync with the video and should no longer have the audio cut out.\n- The in-game camera can now see all UI (but it will get very blurry if you are far away from the UI or behind, this is expected and not a bug).\n- The in-game camera can now show triggers, lights and other previously hidden objects in the editor as a setting.\n- The in-game camera now allows to hide all players when used in the editor.\n- The in-game camera can now be triggered by double tapping the A button while in the editor.\n- Code now supports 5 per player shared registers that survive sublevel changes.\n- Code now supports 5 lobby wide shared registers that survive sublevel changes.\n- Made other players see through when close to them.\n- When you have issues with the game, you can now send logs directly from within the game. They are only helpful in combination with a support ticket or bug report on discord though!\n- New lobby!\n- New time limited items in the shop!", "created_date": 1778115096, "id": "26462189390119248", "version": "0.76.0", "version_code": 3637, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
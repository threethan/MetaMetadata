1-25/39031312_522687858804905_8145332485232666619_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeaN3cenbTsQ7kNvwEXRFJ7&_nc_oc=Adrp9n4kjSaBHMT0iXlekWylWeays9rQyHyzC4CoyTGIrlJjIyksknkVzQGMvPtat3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALkgsuiFxeJrEm_uk_sXyhbvGyVcyOWu9acQzL5bENJg&oe=6A4BC523"}, {"file_name": "1_big.png", "id": "199568998897145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031400_199569002230478_2678784042357543218_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZYDiW9x2k8Q7kNvwFG7mmh&_nc_oc=AdoQRcxgsi8L84rpebPv9tXUGCbv5z67cqc8GhPHhr-ZAKBTAnx1WZkgCWG3aCCluTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfSSsTpnNyhtwElinXIvbob7XESD1EAqzFPb4GEXEFnA&oe=6A4BBC05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "247676503873355", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974632_247676507206688_6297495042000249873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRUptbQOFA8Q7kNvwHV0GII&_nc_oc=AdoAhUBaAzWFSLgbfgWtVSRfKe8aIwEgZJBwwkwarCYRS_U6xOv85Zv04VL7YLjKQR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMC4twBRMI2_iFOB8YUFxvJBfJ-uWvG1QO44PElwY89w&oe=6A4BB9A8"}, "display_name": "GRAB Demo", "keywords": [], "long_description": "This is the full early access version of GRAB, but will eventually become a more limited demo!\n\nGRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!\nA core component of GRAB is the level editor that lets you and your friends create your own levels together and upload them for everyone else to play.\n\nFeatures:\n- Active and fun physics based controls\n- Play with up to 16 players in cross platform multiplayer\n- Built-in tutorial levels to get you started as well as some more advanced bigger levels\n- Built-in level editor that lets you build levels together with your friends in multiplayer with quick switching between testing and editing\n- Download levels made by the community and upload your own", "short_description": "GRAB is a VR multiplayer parkour game. Climb, jump, slide and swing through the levels to reach the end, but don't fall or touch the lava!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://slindev.com/grab", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "630351748179695"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "473475945549280"}, {"status": "PUBLISHED", "id": "222566259952082"}]}, "baseline_offer": {"id": "473475945549280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723136400, "status": "PUBLISHED", "id": "473475945549280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26987427757595406", "version": "0.77.0"}, "id": "1974803902687197", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26987427757595406"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- New lobby!\n- New cosmetic items in the shop!\n- Lobby tags to let other players know what to expect before they join you.\n- Made opening the level list in the editor faster.\n- Another attempt to fix crashes when closing the game.\n- Fixed several memory leaks.\n- Changed the new player flow a bit and fixed some bugs around it.\n- Potentially fixed a common startup crash with the Steam version.\n- Sorry this update ended up a bit smaller than most, but somtimes life gets in the way and some features just end up needing a bit more time to get them right.", "created_date": 1781728145, "id": "26987427757595406", "version": "0.77.0", "version_code": 3690, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26987427757595406"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- New lobby!\n- New cosmetic items in the shop!\n- Lobby tags to let other players know what to expect before they join you.\n- Made opening the level list in the editor faster.\n- Another attempt to fix crashes when closing the game.\n- Fixed several memory leaks.\n- Changed the new player flow a bit and fixed some bugs around it.\n- Potentially fixed a common startup crash with the Steam version.\n- Sorry this update ended up a bit smaller than most, but somtimes life gets in the way and some features just end up needing a bit more time to get them right.", "created_date": 1780584552, "id": "26822773607394156", "version": "0.77.0", "version_code": 3684, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4104088956355944", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26987427757595406"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1974803902687197"}]}, "change_log": "- Added a volume slider for player voice chat.\n- Added a volume slider for your own voice on recordings and live streams.\n- Made your own voice much louder on recordings and live streams.\n- Added connecting to twitch, which will automatically fetch the stream key and display the chat in-game.\n- Fixed camera rotation tilt following not working if the camera is minimized.\n- Made recording and streaming work on windows.\n- Increased maximum number of code block connections to 10.\n- Increased maximum number of animation frames per object to 1000.\n- Made grabbing non-physics objects no longer delayed by one frame.\n- Fixed a very common crash when closing the game.\n- Fixed a very common case of \"Looking for destination...\".\n- Fixed rotation speed calculation when letting go of a physics object.", "created_date": 1778944284, "id": "26583375894667263", "version": "0.76.1", "version_code": 3661, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinar
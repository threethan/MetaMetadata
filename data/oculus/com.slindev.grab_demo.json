UHMObVy2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp07FkGoDQ9y1I4abkIy4j5T7RDY100aANxxEiQxlVXQ&oe=6A71D72F"}, {"file_name": "3.png", "id": "1805259886561544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982453_1805259889894877_326132498281152252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTn2MIaS8MUQ7kNvwGnek7a&_nc_oc=Adq2av0jlxhGK071qwy_TgJH6FBBQq8_9VyIcKlvBh4C5z7Z-MWV2malae6yBApyR1k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGL0giz5A1rtilq2NTOqBW_dwGUynQudCiADpjCV7EyA&oe=6A71EFCC"}, {"file_name": "5.png", "id": "1350175522351080", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982626_1350175525684413_2966819136963002345_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xP1d6oHDlDIQ7kNvwFBvaxy&_nc_oc=Adp8WLYSzr1i8TGSXwkmeYTId1fu7CF4BD4mA8rn1_FbmkCcawld5t_UFh31ANPoLxA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqPq5DoMHqXCvNG5x02jcTQTR6XR57wBugjN5R4vM1IQ&oe=6A71E7B3"}, {"file_name": "4.png", "id": "339393762340623", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982548_339393765673956_3885185240601273819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlI8dV8wMfoQ7kNvwE2SDfr&_nc_oc=AdoVTGDkNDkFInCPOHTo7vOPwwgOQBMVOdlz39v3oKXzc4cDF4z0tuuYlRPcTlsKffM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6BWfO7jRRuvp4QFarHtOOT9mL2ZRshoH4Rp_4POKDXg&oe=6A71DDD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverQuerformat_2560x1440_.2026.png", "id": "1490325805742726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/646413489_1490325812409392_8906679501534857426_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIzQfv_tw9oQ7kNvwHRMo5s&_nc_oc=AdoldQUn_eZs2ytoW1sJ8O5JPZ4qGWn4hCdqMd9p-PbD2c5SUyvdJbL5Whot47D1aEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvEOPO3-vY8CXaTRhzdQxTi20448R8TPFDX437CEGqhg&oe=6A71F1C0"}, "display_name": "GRAB", "keywords": ["platform", "climbing", "grapple", "grappling", "creative"], "long_description": "Ready to become a parkour master with your friends? Dive into GRAB, the coolest multiplayer platforming game!\n\n# \ud83d\ude80 UNIQUE MOVEMENT MECHANICS\nGrab the air to launch yourself in any direction. Swing with grappling hooks, climb impossible walls, and fling yourself through space. Master GRAB's innovative hand-based controls for the ultimate freedom of movement.\n\n# \ud83c\udf0d ENDLESS CHALLENGES\nWith over a million player-made levels, there's always a new parkour challenge waiting. Race against the clock, solve puzzles, or just enjoy the thrill of motion across a variety of creative courses.\n\n# \ud83c\udfd7\ufe0f CREATE & SHARE\nUnleash your inner level design genius! Use the intuitive level editor to bring your wildest ideas to life. Team up with friends to build in real-time, then watch as players worldwide attempt to conquer your creation.\n\n# \ud83e\udd1d MULTIPLAYER MAYHEM\n- Be part of an active community with thousands of players every day\n- Parkour through mind-bending levels with up to 12 players\n- Race against friends or work together to beat challenges\n- Build and test levels together in real-time\n\n# \ud83c\udf08 EXPRESS YOURSELF\nCustomize your character and show off your unique style as you swing, climb, and fly through the GRAB universe.", "short_description": "Experience the thrill of VR platforming in GRAB, where you can parkour through user-created levels with friends and build your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slindev.com/privacy", "developer_terms_of_service_url": "https://slindev.com/terms", "publisher_name": "SlinDev", "support_website_url": null, "website_url": "https://grabvr.quest/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "17
c=wZxmEupcj98Q7kNvwHEd4Jw&_nc_oc=AdqDWWlnw-kCi55aEntGA4qWDWlh15Sq2f6FQiEkLv6HomUK-k27evoVqjiPiV-ZsfM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFXPaVOo-Q4wrZgDEPKpJiqrQ-UkAN-WQw5-XPwobaCA&oe=69C29DFF"}, {"file_name": "green room (1).png", "id": "1212275726417673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575356_1212275729751006_735127710695002637_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wraJ05tLggAQ7kNvwGYcgr0&_nc_oc=Adpo5XwElanx5hUbnzLeg0ptCg-ovz86to1uplR-_oOTjtqoB5lO9w6Fohuvr3Xb4Bs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMyk5mlW0BvZC9BIlN-scKkZHxcNGwRbMqLPzdf0j3SA&oe=69C281E3"}, {"file_name": "big room (1).png", "id": "1349893879056936", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1349893882390269_274947222899376311_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbIg9Rhs-9oQ7kNvwGKXS2H&_nc_oc=Ado5pKse5MlWGfFRaSQnNQ7vl3cjVBwePsol0fd0LAQcwtmmOfDPmCJwQEkpT9Yg5JE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzj2V-fTDp9s7GxtAd-Fdou0V7lDauvAcznx0rKz8sYew&oe=69C2A0F0"}, {"file_name": "slope (1).png", "id": "7132238946897144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974567_7132238950230477_7234507103669748885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llIxvZnCIrEQ7kNvwGfG004&_nc_oc=AdpdXvCBNZUZuPPm8PDUfOA1Cm8Oxx0pU9K2cYuc6qoSVesTKR8GzyE8QswYHlyv2Xk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQXj-k_oTCBdHHrC0Z-0KwKxoqspV2wd3Cy3X00u941Q&oe=69C27AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "silence banner (1).png", "id": "712284707752735", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75280979_712284711086068_2007769893002839802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka_Ipvx-jGAQ7kNvwEq8tQR&_nc_oc=AdrcpwOyQocdC33ZO1n6BJMYiSsrFStVeOowbXr3FFhb4GhzApOL-FEjDKx7w4qa2VA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyE-WTB1NplA-nF4rr402GYYc0gMn0N8D99kfmd_gkfzw&oe=69C2A291"}, "display_name": "Silence", "keywords": [], "long_description": "Silence beckons players into the vast expanse of space, a desolate canvas where the echoes of the cosmos mingle with the unnerving stillness. Amidst this emptiness, shadows dance with unseen horrors, lurking monsters waiting to pounce on the unwary. Piloting their spacecraft, players embark on a perilous journey, navigating the void while battling these cosmic terrors.\n\nAs explorers of the unknown, players confront a myriad of challenges, from navigating treacherous asteroid fields to deciphering cryptic signals from distant stars. Yet, the true test lies in facing the horrors that dwell within the darkness. From ancient aberrations awakened from aeons-long slumber to entities spawned from the depths of chaos, each encounter threatens to shatter their sanity.\n\nArmed with advanced technology and unyielding resolve, players delve deeper into the mysteries of the cosmos, seeking answers amidst the chaos. Every discovery unveils fragments of a larger truth, revealing the sinister forces that lurk behind the veil of silence. Yet, with knowledge comes peril, as each revelation brings them closer to the heart of darkness.\n\nSilence is not merely a game of survival, but a journey of exploration and discovery, where every moment teeters on the brink of terror and triumph. Will you succumb to the overwhelming dread that pervades the void, or will you rise above the darkness and conquer the monsters that dwell within?", "short_description": "Silence thrusts players into the vast expanse of space, where every breath is a struggle against the void and every shadow hides a lurking horror. Navigate the eerie emptiness, battling menacing monsters that haunt the darkness, as you unravel the mysteries of an abandoned cosmos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/silencevr/privacy-policy", "developer_terms_of_service_url
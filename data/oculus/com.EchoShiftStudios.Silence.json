_1sVAX-4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-1mxDdFdXLEKkndYfNjoW1Ap_qEYfdU39jSM1tRSAoA&oe=6AA57518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "silence banner (1).png", "id": "712284707752735", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75280979_712284711086068_2007769893002839802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7XNs1KF0_EQ7kNvwE7qSJ0&_nc_oc=AdoSmwKSL03z1BbOggSGc7BEP7--5Gl7tqt83f8IwhLxh5tr_9MCCuzppYIgYyfE-b4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvQIOH6rNN9FMvapql6LE0kh-cGpHjLFFRctGla6gdIg&oe=6AA56491"}, "display_name": "Silence", "keywords": [], "long_description": "Silence beckons players into the vast expanse of space, a desolate canvas where the echoes of the cosmos mingle with the unnerving stillness. Amidst this emptiness, shadows dance with unseen horrors, lurking monsters waiting to pounce on the unwary. Piloting their spacecraft, players embark on a perilous journey, navigating the void while battling these cosmic terrors.\n\nAs explorers of the unknown, players confront a myriad of challenges, from navigating treacherous asteroid fields to deciphering cryptic signals from distant stars. Yet, the true test lies in facing the horrors that dwell within the darkness. From ancient aberrations awakened from aeons-long slumber to entities spawned from the depths of chaos, each encounter threatens to shatter their sanity.\n\nArmed with advanced technology and unyielding resolve, players delve deeper into the mysteries of the cosmos, seeking answers amidst the chaos. Every discovery unveils fragments of a larger truth, revealing the sinister forces that lurk behind the veil of silence. Yet, with knowledge comes peril, as each revelation brings them closer to the heart of darkness.\n\nSilence is not merely a game of survival, but a journey of exploration and discovery, where every moment teeters on the brink of terror and triumph. Will you succumb to the overwhelming dread that pervades the void, or will you rise above the darkness and conquer the monsters that dwell within?", "short_description": "Silence thrusts players into the vast expanse of space, where every breath is a struggle against the void and every shadow hides a lurking horror. Navigate the eerie emptiness, battling menacing monsters that haunt the darkness, as you unravel the mysteries of an abandoned cosmos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/silencevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vox", "support_website_url": null, "website_url": "https://sites.google.com/view/silencevr/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "6578564918842345"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "743291187779684"}]}, "baseline_offer": {"id": "743291187779684"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1709918880, "status": "PUBLISHED", "id": "743291187779684"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24228883866717178", "version": "0.128"}, "id": "418630543980024", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "
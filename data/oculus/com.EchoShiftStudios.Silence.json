06_735127710695002637_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buLK5O52-0IQ7kNvwH_7q3c&_nc_oc=Adp6qadSOv2EZvFzsBfFJJNsi4IXqIjjR_PA8YmungYskNw-AdG2JbkAEtKfYgF8pOQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzB9ObSNWKe0qCbdA5gjgsgquB-wHdAE5ok3a_BpbVpMw&oe=69C67663"}, {"file_name": "big room (1).png", "id": "1349893879056936", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982522_1349893882390269_274947222899376311_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6UaDPLbPOkQ7kNvwGiPxLb&_nc_oc=Ado4J_iredwQM04hEbUcL2RXgnkVkV83gqmVYSq_5R_QAVAEtczv15yKfmO_yRevPT0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUrVtnk8dgCMeJzgTZ4nKaxuS8MTy8j5-i2q1vjw0exA&oe=69C69570"}, {"file_name": "slope (1).png", "id": "7132238946897144", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974567_7132238950230477_7234507103669748885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5rrZNc65SMQ7kNvwFzoEY-&_nc_oc=AdrlnNxprlCs6DqxsaldSOYJwt32O3_aBRrs4N4kkvevomgYMlV5mQgjTWR6dhZDCVg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzof4roaYV8-Kz-Ea3XifeqfN6hNJEIFw2maYUdkDpvxw&oe=69C66F58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "silence banner (1).png", "id": "712284707752735", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75280979_712284711086068_2007769893002839802_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7ALL4CUTUcQ7kNvwGndAd-&_nc_oc=Ado7Jh70FsMmRE5QXIHg5sJG-anpAUjm-jeNto0ZC6upJ-0iK2R8itJnF6Wprs1wv-o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWd2Mh1IRKvK-sPWyixmkt9BCWXtretS-jUXGUAE06ug&oe=69C69711"}, "display_name": "Silence", "keywords": [], "long_description": "Silence beckons players into the vast expanse of space, a desolate canvas where the echoes of the cosmos mingle with the unnerving stillness. Amidst this emptiness, shadows dance with unseen horrors, lurking monsters waiting to pounce on the unwary. Piloting their spacecraft, players embark on a perilous journey, navigating the void while battling these cosmic terrors.\n\nAs explorers of the unknown, players confront a myriad of challenges, from navigating treacherous asteroid fields to deciphering cryptic signals from distant stars. Yet, the true test lies in facing the horrors that dwell within the darkness. From ancient aberrations awakened from aeons-long slumber to entities spawned from the depths of chaos, each encounter threatens to shatter their sanity.\n\nArmed with advanced technology and unyielding resolve, players delve deeper into the mysteries of the cosmos, seeking answers amidst the chaos. Every discovery unveils fragments of a larger truth, revealing the sinister forces that lurk behind the veil of silence. Yet, with knowledge comes peril, as each revelation brings them closer to the heart of darkness.\n\nSilence is not merely a game of survival, but a journey of exploration and discovery, where every moment teeters on the brink of terror and triumph. Will you succumb to the overwhelming dread that pervades the void, or will you rise above the darkness and conquer the monsters that dwell within?", "short_description": "Silence thrusts players into the vast expanse of space, where every breath is a struggle against the void and every shadow hides a lurking horror. Navigate the eerie emptiness, battling menacing monsters that haunt the darkness, as you unravel the mysteries of an abandoned cosmos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/silencevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vox", "support_website_url": null, "website_url": "https://sites.google.com/view/silencevr/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED
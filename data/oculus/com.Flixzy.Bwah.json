061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6KhEVYFjcoQ7kNvwGvXW3E&_nc_oc=Adr4orKcBzZF2Z5b8T_95FleysPqe1WCdGcVEsGjDbWWCDvY9rVT-IkAa4II7l4a1aU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4T7GZidRssIZs-LZPRau2uBg2oeIGxlAJiWPZ-gT3Kw&oe=6A5B6E6E"}]}, "id": "1781956922651452", "locale": "en_US", "screenshots": [{"file_name": "Bwah2.png", "id": "1715477449057735", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_1715477452391068_3554849862578957890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSyIrmO7FEAQ7kNvwGx20Kc&_nc_oc=Adp9qyg-zOzYBvVqsYsLJ3VEmwfZJMnXCwyUBZ1vGKq9z7r7ZOqkz9wPToKyAWBzyTg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMRwpjMEAsLzZ9tmMcZ5pn0vr_lsbSBa2I6xqN52PEpQ&oe=6A5B8305"}, {"file_name": "bwah1.png", "id": "1381628853021410", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_1381628856354743_499863310032098936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH9x8Ul_uccQ7kNvwF72a2m&_nc_oc=AdoV6ZzORd85N2i1l1gmaw77gBm_xNDMZ3RlusqkunZjfUOXhDZdEt-N5d9QtpcAtng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHJsbqhyTu545-eKdJx8MbVeGkZaMBLQ-oZ7ZEwOjCfA&oe=6A5B82A8"}, {"file_name": "Bwah3.png", "id": "2408811942845043", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391952_2408811946178376_3849616786061894126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4utCrlES67YQ7kNvwGEtzRn&_nc_oc=AdqKzRw-drtLHQEuR9ddIKtNKg7ElHFATW50sxsOqXy-0jM9P18-AR8HmoqQ_tlkrKM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf8UyQYgTLEZGwXvkSPM-laXDQFtjY_XPqIKBNCscCRw&oe=6A5B80B2"}, {"file_name": "Bwah4.png", "id": "1289058765913341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1289058769246674_3998892010612422005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJXX-gmIgdEQ7kNvwEz7HgN&_nc_oc=Ado6Hd7kpNL2vdR6n6PNnWWv6uwiMwjuJYh10sQ8mnfoi_QIYdfwQdcg_wACrxMa8L8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbWHryYcZlcm0ckC6QsOFiXJBP-cq-cH0bC0LMiUQdRA&oe=6A5B90B4"}, {"file_name": "Bwah5.png", "id": "966959772293057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393956_966959775626390_6042396183174735659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRemGtydopIQ7kNvwE2I8db&_nc_oc=AdpLqoEm1Pi4jeAZE7TnDFW6mb-l_kZi8Q-UsI52KMvk8m-GWL1lWAaZHd6rRBH-p04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBemTjTjRZfL8XpBySAOphxbTbQAThEOesgE5SvuncOyA&oe=6A5B8A26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah", "keywords": [], "long_description": "Welcome to Bwah, the ultimate physics-fueled playground of chaos and creativity. In this bizarre and unpredictable sandbox, you\u2019re equipped with three core tools of madness: thrusters, grenades, and the almighty tool gun. Whether you're building wild contraptions, launching yourself across the map, or causing spectacular explosions just because you can, Bwah is all about unhinged fun and unpredictable outcomes.\n\nThere are no missions. No set goals. Just you, a world that barely obeys the laws of physics, and the tools to break whatever laws are left. Fly with reckless abandon using slap-on thrusters. Stick them to walls, objects, or even other players\u2014because in Bwah, if it sounds dumb, it probably works. Lob grenades that send props flying and players flailing, or carefully (or not-so-carefully) use your tool gun to build, modify, and manipulate just about anything in the environment.\n\nBwah thrives on creativity and chaos. Stack cars on trees, attach thrusters to toilets, make a flying couch, or send your friend to the moon with one well-placed explosion. The physics are wacky, the possibilities are endless.", "short_description": "Bwah is a chaotic, physics-based sandbox where mayhem is your playground. Strap on some thrusters, toss absurdly overpowered grenades, and wield your trusty tool gun to bend the laws of physics (and logic) to your will. Whether you're flying through the air like a maniac or setting up wild contraptions, Bwah is all about experimenting, exploding, and laughing at the glorious mess you\u2019ve made. No rules. No limits. Just pure, unfiltered Bwah."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9756772114346156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "908433411290665"}]}, "baseline_offer": {"id": "908433411290665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744074420, "status": "PUBLISHED", "id": "908433411290665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27783679051228853", "version": "1.1.1.75"}, "id": "1318240299460519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9756772107679490", "is_concept": false, "latest_released_binary": {"__typename": "And
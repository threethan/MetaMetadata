162261061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t50fpnjLiBUQ7kNvwG-xCWx&_nc_oc=AdqUsx2KcYUgioZL0VCji4MF7P2aOOhXySQXPrkZtbApbfLz716MCyU4ESHCCx4agJU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8tI6dDUb0Z0UpIW7AWBkQSE7-9MZeUc0-a9R2PhQMrw&oe=6A395FAE"}]}, "id": "1781956922651452", "locale": "en_US", "screenshots": [{"file_name": "Bwah2.png", "id": "1715477449057735", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392016_1715477452391068_3554849862578957890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VyFVQjB_EgQ7kNvwHPdGAw&_nc_oc=Adr_brHBkYZQg8YPGWuV_ZuQWkOkcjUfut_z5SDSpvikR6YUamwa7E1YYpNYl3nhelI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dDHzFHTO1-RNtIHRVuj-Zv-GZj6tWASHMamOgSswnYQ&oe=6A393C05"}, {"file_name": "bwah1.png", "id": "1381628853021410", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393444_1381628856354743_499863310032098936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6EQ_Zhdhh4Q7kNvwEiJYPO&_nc_oc=AdoZjudwdOtU74lTqmyF2FqhsgGtja_h0R0VCzc7FNDvz5AsrNWbfisnl2LKADNZATs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5kLOs3NS-dsW3yXCXLGeXTkXKjHSIQsS9bOkU_Fouaw&oe=6A393BA8"}, {"file_name": "Bwah3.png", "id": "2408811942845043", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391952_2408811946178376_3849616786061894126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yz1KVC2dwegQ7kNvwE9J4kc&_nc_oc=Ado-ix10OKzFkd8nblez2txGJ7JLVCii7-JCACt--kAI9pUB_WdyweMXhMg6R2lRRg4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90hCaKnFEkHDS6ygBbVW-jyCGOdTLUlLxGmeRKSgF9DA&oe=6A3939B2"}, {"file_name": "Bwah4.png", "id": "1289058765913341", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_1289058769246674_3998892010612422005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_KnlGhOf24Q7kNvwEYdDmr&_nc_oc=AdpyrYO5yZqFG29o5WA_Gp9s-UN8dj_bmSc8v4HagYeTsZ_sFDdggMHJt0PVZO2bPng&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YXXCBRmuxqzHoXEOEgnJ2Xlc7DEj0nenznWGoQTY8wQ&oe=6A3949B4"}, {"file_name": "Bwah5.png", "id": "966959772293057", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393956_966959775626390_6042396183174735659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wggm7C-5Rk4Q7kNvwEnvSCO&_nc_oc=Adprij-UxldFDOV-ec0ywmhSluISzsVX74kOHE6nQwhWCWGveald7shW7hxFvtHar0A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sz0X-s4HGszN0PFxTZ9mBaWKq48y9mjyVjB_JLTLLzg&oe=6A394326"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah", "keywords": [], "long_description": "Welcome to Bwah, the ultimate physics-fueled playground of chaos and creativity. In this bizarre and unpredictable sandbox, you\u2019re equipped with three core tools of madness: thrusters, grenades, and the almighty tool gun. Whether you're building wild contraptions, launching yourself across the map, or causing spectacular explosions just because you can, Bwah is all about unhinged fun and unpredictable outcomes.\n\nThere are no missions. No set goals. Just you, a world that barely obeys the laws of physics, and the tools to break whatever laws are left. Fly with reckless abandon using slap-on thrusters. Stick them to walls, objects, or even other players\u2014because in Bwah, if it sounds dumb, it probably works. Lob grenades that send props flying and players flailing, or carefully (or not-so-carefully) use your tool gun to build, modify, and manipulate just about anything in the environment.\n\nBwah thrives on creativity and chaos. Stack cars on trees, attach thrusters to toilets, make a flying couch, or send your friend to the moon with one well-placed explosion. The physics are wacky, the possibilities are endless.", "short_description": "Bwah is a chaotic, physics-based sandbox where mayhem is your playground. Strap on some thrusters, toss absurdly overpowered grenades, and wield your trusty tool gun to bend the laws of physics (and logic) to your will. Whether you're flying through the air like a maniac or setting up wild contraptions, Bwah is all about experimenting, exploding, and laughing at the glorious mess you\u2019ve made. No rules. No limits. Just pure, unfiltered Bwah."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9756772114346156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "908433411290665"}]}, "baseline_offer": {"id": "908433411290665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744074420, "status": "PUBLISHED", "id": "908433411290665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26523347783928659", "version": "1.1.1.68"}, "id": "1318240299460519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9756772107679490", "is_concept": false, "latest_released_binary": {"__t
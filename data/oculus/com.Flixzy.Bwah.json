pLCWMWQOiTciDGMOg&oe=69B7DE74"}, {"file_name": "Bwah5.png", "id": "966959772293057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393956_966959775626390_6042396183174735659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCD7R5eiMyQQ7kNvwF_vlZS&_nc_oc=Adkectdly-LrV5u2Bl9PBXj3Dd_audAak1XHpb6mFJwAxVEBzHodDYeBWAXzXVtbj4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsOLX176wlb5VBG-54-HKfYuzsFvClmlzZBRDsKSV6Zw&oe=69B81026"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah", "keywords": [], "long_description": "Welcome to Bwah, the ultimate physics-fueled playground of chaos and creativity. In this bizarre and unpredictable sandbox, you\u2019re equipped with three core tools of madness: thrusters, grenades, and the almighty tool gun. Whether you're building wild contraptions, launching yourself across the map, or causing spectacular explosions just because you can, Bwah is all about unhinged fun and unpredictable outcomes.\n\nThere are no missions. No set goals. Just you, a world that barely obeys the laws of physics, and the tools to break whatever laws are left. Fly with reckless abandon using slap-on thrusters. Stick them to walls, objects, or even other players\u2014because in Bwah, if it sounds dumb, it probably works. Lob grenades that send props flying and players flailing, or carefully (or not-so-carefully) use your tool gun to build, modify, and manipulate just about anything in the environment.\n\nBwah thrives on creativity and chaos. Stack cars on trees, attach thrusters to toilets, make a flying couch, or send your friend to the moon with one well-placed explosion. The physics are wacky, the possibilities are endless.", "short_description": "Bwah is a chaotic, physics-based sandbox where mayhem is your playground. Strap on some thrusters, toss absurdly overpowered grenades, and wield your trusty tool gun to bend the laws of physics (and logic) to your will. Whether you're flying through the air like a maniac or setting up wild contraptions, Bwah is all about experimenting, exploding, and laughing at the glorious mess you\u2019ve made. No rules. No limits. Just pure, unfiltered Bwah."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9756772114346156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "908433411290665"}]}, "baseline_offer": {"id": "908433411290665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744074420, "status": "PUBLISHED", "id": "908433411290665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26343171871946252", "version": "1.1.1.65"}, "id": "1318240299460519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9756772107679490", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26343171871946252"}, "release_st
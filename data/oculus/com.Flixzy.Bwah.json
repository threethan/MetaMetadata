061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBne52vrS5sQ7kNvwE7A2bA&_nc_oc=AdpmuUDs7JgdqC7A-q9_20tHTjnV-ieBR91A0vVRjuHFQP7Xk4wwWMuilDg5xFD-hL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Anb7wd0y0pKIr0DEZ9IczxTG6vX4DgCj4I8ebhV3KKg&oe=69DB8CEE"}]}, "id": "1781956922651452", "locale": "en_US", "screenshots": [{"file_name": "Bwah2.png", "id": "1715477449057735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1715477452391068_3554849862578957890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMVEV5jOXAEQ7kNvwFAKi8F&_nc_oc=AdqstoLPmIxKa6Eb4NP7XBvzKP8YtcAUrOCiVxC44fiKtbihL6_wZHiOJgLVIdZvClo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JX9kwGFbQSFigcJweK2kNYxd-e791fQAT1EsdVWSz2w&oe=69DBA185"}, {"file_name": "bwah1.png", "id": "1381628853021410", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393444_1381628856354743_499863310032098936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGPH1NpG0e8Q7kNvwH0382C&_nc_oc=AdorJAaYwFozSuBrWoY0fKd0xImCRvPJok3aemRkWLJ4sHLdXaHGw4TTfmI0YF2vipU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28wh6a0RsM5ZCCY6YOVY1KpLzMZ_IU7mmhXelrlPOX5A&oe=69DBA128"}, {"file_name": "Bwah3.png", "id": "2408811942845043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391952_2408811946178376_3849616786061894126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zSNFACKOoUQ7kNvwF9F9J8&_nc_oc=AdoRJaqyW7xrKijUADMW0LPqam21N1aRKiLYOlOg_4geirYBj7RdLHtKnG9tpSoxKe4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N96UQNRDZ_6rGCuUVpiVvAZQYh59PqM2-u_0OH54TAg&oe=69DB9F32"}, {"file_name": "Bwah4.png", "id": "1289058765913341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_1289058769246674_3998892010612422005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4ZULVg9d2QQ7kNvwEVL93E&_nc_oc=Adp9HmFMXeI0NUqZgZoGm2B8y3EdodKQJKrdkgNjQocIXDjdbczDUScbNRylLxPzUAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28PyeKddKrIGFmqqEIzXU0btO7QirCR8BuVcIanhYZmw&oe=69DBAF34"}, {"file_name": "Bwah5.png", "id": "966959772293057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393956_966959775626390_6042396183174735659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv9W_udbyLYQ7kNvwHpX_og&_nc_oc=Adrw_Oz9EWD1DhDBFSzuqNeYw9d8awaAsgqmIT-CgTutIrpTrOclKT2CQY7hHm_ZFco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A5jZRl0UeBfk2IbJRuZYzL8UNqgPGmWaEBxvbVTAvGw&oe=69DBA8A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah", "keywords": [], "long_description": "Welcome to Bwah, the ultimate physics-fueled playground of chaos and creativity. In this bizarre and unpredictable sandbox, you\u2019re equipped with three core tools of madness: thrusters, grenades, and the almighty tool gun. Whether you're building wild contraptions, launching yourself across the map, or causing spectacular explosions just because you can, Bwah is all about unhinged fun and unpredictable outcomes.\n\nThere are no missions. No set goals. Just you, a world that barely obeys the laws of physics, and the tools to break whatever laws are left. Fly with reckless abandon using slap-on thrusters. Stick them to walls, objects, or even other players\u2014because in Bwah, if it sounds dumb, it probably works. Lob grenades that send props flying and players flailing, or carefully (or not-so-carefully) use your tool gun to build, modify, and manipulate just about anything in the environment.\n\nBwah thrives on creativity and chaos. Stack cars on trees, attach thrusters to toilets, make a flying couch, or send your friend to the moon with one well-placed explosion. The physics are wacky, the possibilities are endless.", "short_description": "Bwah is a chaotic, physics-based sandbox where mayhem is your playground. Strap on some thrusters, toss absurdly overpowered grenades, and wield your trusty tool gun to bend the laws of physics (and logic) to your will. Whether you're flying through the air like a maniac or setting up wild contraptions, Bwah is all about experimenting, exploding, and laughing at the glorious mess you\u2019ve made. No rules. No limits. Just pure, unfiltered Bwah."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9756772114346156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "908433411290665"}]}, "baseline_offer": {"id": "908433411290665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744074420, "status": "PUBLISHED", "id": "908433411290665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26523347783928659", "version": "1.1.1.68"}, "id": "1318240299460519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9756772107679490", "is_concept": false, "latest_released_binary": {"__typename": "And
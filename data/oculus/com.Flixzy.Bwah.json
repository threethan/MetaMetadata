=QazDWsVnwZ8Q7kNvwFU-2Fv&_nc_oc=AdrcHahF8B5RZlSIQE-K34-OBTxoMVdYSPYm9UJ1nn_5ATeelInTZiizx0uWNWb_ruA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9t_NqOrrL6nH1jYF3Obj3hQeETubLOSye4kwpsKt_hQ&oe=6B105868"}, {"file_name": "Bwah3.png", "id": "2408811942845043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391952_2408811946178376_3849616786061894126_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQnNlvWo7SIQ7kNvwHexupa&_nc_oc=Adp3fcKnNkPnalaWEMtJTIEcRzI_OtR8cmPWulIUMHyl_cOEybWGBEL8TBYWHJCz2Io&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3p8QgCdIaMzTqaF9PvYvE9ecT7gitV6Mhmeiwb_Xfxw&oe=6B105672"}, {"file_name": "Bwah4.png", "id": "1289058765913341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_1289058769246674_3998892010612422005_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdWnBxyyWIgQ7kNvwG6dkX-&_nc_oc=Adqt06MMsSARmemS3Z7cMmFHlher-_iOoGnxSXAsU8_9r4jt6g_jmisOtYwG9ZthT-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmqEf5Dz6Tno7h-Yg6bsQJjcjT-V-XohTdAhk0jyUvpA&oe=6B106674"}, {"file_name": "Bwah5.png", "id": "966959772293057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393956_966959775626390_6042396183174735659_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0y8Q3maCgkQ7kNvwFXtlMb&_nc_oc=Adq0rBs2i34pDG177l36sKsO6EoC5n_wPRMBuifezJE1DBKMDu_TuM7G9cAAGGK7mRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXrLzj6HJVFV69p5qCDd-RJGP18UJERixgKj1zfE49Bvw&oe=6B105FE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah", "keywords": [], "long_description": "Welcome to Bwah, the ultimate physics-fueled playground of chaos and creativity. In this bizarre and unpredictable sandbox, you\u2019re equipped with three core tools of madness: thrusters, grenades, and the almighty tool gun. Whether you're building wild contraptions, launching yourself across the map, or causing spectacular explosions just because you can, Bwah is all about unhinged fun and unpredictable outcomes.\n\nThere are no missions. No set goals. Just you, a world that barely obeys the laws of physics, and the tools to break whatever laws are left. Fly with reckless abandon using slap-on thrusters. Stick them to walls, objects, or even other players\u2014because in Bwah, if it sounds dumb, it probably works. Lob grenades that send props flying and players flailing, or carefully (or not-so-carefully) use your tool gun to build, modify, and manipulate just about anything in the environment.\n\nBwah thrives on creativity and chaos. Stack cars on trees, attach thrusters to toilets, make a flying couch, or send your friend to the moon with one well-placed explosion. The physics are wacky, the possibilities are endless.", "short_description": "Bwah is a chaotic, physics-based sandbox where mayhem is your playground. Strap on some thrusters, toss absurdly overpowered grenades, and wield your trusty tool gun to bend the laws of physics (and logic) to your will. Whether you're flying through the air like a maniac or setting up wild contraptions, Bwah is all about experimenting, exploding, and laughing at the glorious mess you\u2019ve made. No rules. No limits. Just pure, unfiltered Bwah."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOV
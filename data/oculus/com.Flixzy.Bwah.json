NhmhXwcQ7kNvwE7IYJG&_nc_oc=AdpfhOxSu17iq5b4PWCCze5g3u1rvVcYmvCEAnTTcYq7kRdyf8F6Gka5szNNhOfEx1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUT0wZT2pqUMnvHs6lm2A1_cqvMAqiArS8ELHnsCHVp-Q&oe=6B106818"}, {"file_name": "screen4.png", "id": "1581169576837920", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1581169580171253_5367533431658882193_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv6lKjaUCEQQ7kNvwEHInuC&_nc_oc=AdrcDd-GfzZq4hfMlP512nSABmECWdM-HuhY4zlqj1mVpEvOt7a9IzUT-iZAHOIxDFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbqWlYf3pDsJNFlpNvrsCZh1d_IyhxrmvKCiG0fsVYNw&oe=6B1047D6"}, {"file_name": "screen3.png", "id": "4547974722109965", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831569_4547974725443298_4183703747450965396_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM_248AVtgcQ7kNvwHO5q7L&_nc_oc=AdonFMWiC4L2RwikiVRkYN3iPhqOmGf-gkQfCK23j2orNsO-P2e8yjBFS2UkHVbteNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpai5sWqHn91Opf2CYPHE_Kl80LaDBYV7ZBJD4XuvE_g&oe=6B104BE4"}, {"file_name": "screen5.png", "id": "1243847007929916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/756589809_1243847011263249_5585316754685200550_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUizh_xfncUQ7kNvwHG7k-0&_nc_oc=AdraFnNInSruReQ7lE0Fgfe8Ti62FsCB55HkZUZiHufGz71VEtLEtJe4_8bp3-MtF70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJi5YXTwyniNQI-RAINVn9qeoX2d_Dy4Gak0aWblE-Fg&oe=6B1060E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah - Grows Offline", "keywords": ["baboon", "Garden", "Grow", "brainrot", "steal"], "long_description": "\ud83e\udd83 Bwah Grows Beta: Thanksgiving Update + Seed Trading\n\nCelebrate Thanksgiving in Bwah with new seeds, a new pet, and a whole new way to grow your collection!\n\n\ud83c\udf31 NEW: Seed Trading\nMeet up at the new Trade Hub and swap seeds with other players! Place your seed in a chest, press Ready, and watch the energy beam connect your chests during a 5-second trade. Once it\u2019s complete, collect your new seed!\n\nBoth players must confirm the exchange. Changing a seed resets the other player\u2019s Ready status, and if your trading partner leaves, the trade is cancelled so you can retrieve your seed.\n\n\ud83c\udf42 LIMITED-TIME: Thanksgiving Seed Shop\nAdd two special trees to your garden during the event:\n\n\ud83e\udd54 Potato Tree \u2014 Legendary\n160,000 \u2022 Grows 4 potatoes\n\n\ud83e\udd67 Pie Tree \u2014 Mythic\n250,000 \u2022 Grows 4 pies, which sell for more than potatoes!\n\nOnly 1\u20132 of each seed are available per restock, so check back often!\n\n\ud83e\udd83 NEW PET: Turkey\nA new Uncommon friend is wandering around the main area! Find a Turkey and buy it directly from its price tag. Roaming Uncommon pets now appear much more often, giving you more chances to find your next companion!\n\nGrow, trade, and celebrate Thanksgiving together in Bwah!\n\n\n\n", "short_description": "\n# \ud83c\udf31 Welcome to Bwah - Grow a Garden in VR \ud83c\udf31\nGrow plants, sell for profit, and build your dream garden! Hunt rare seeds, unlock wild mutations, and flex your ultimate garden. Stay tuned for weekly updates!\n\n**\ud83e\uddd1\u200d\ud83c\udf3e How to Play**\n- Buy a seed and grab it\n- Place it in your garden\n- Wait and watch it grow\n- Harvest and earn BIG\n\nRemember, your garden literally grows while you\u2019re offline! \u2b50\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "ENVER", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
14162261061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf3bQlohs4cQ7kNvwHdTPTn&_nc_oc=AdpDHSpBqdn1AqVCXiO6wz3Rsg-BdRPTcVjDkv374P72d_0aDzCfnIcKvlqpcDi9QMU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLcU7AZARzhxLCTjMRUXZcqT9YTdx1-oml-DEh_eId_A&oe=6A8D876E"}]}, "id": "1781956922651452", "locale": "en_US", "screenshots": [{"file_name": "Bwah2.png", "id": "1715477449057735", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392016_1715477452391068_3554849862578957890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCS_7P41IAkQ7kNvwGa2W1P&_nc_oc=Adp64atZ_1fI-uhaByH2t1uzdO_F2GJtvQnjON4y0k1ESy7lYc3MkWXqbxn2W8F44Fk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETXew_rDprzvJtFT_wgvFkpM85GUmdHeAAot3QioYHtA&oe=6A8D9C05"}, {"file_name": "bwah1.png", "id": "1381628853021410", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393444_1381628856354743_499863310032098936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPPU3fUEZM8Q7kNvwGt7Wgr&_nc_oc=AdpXJFpcNmzLY85htj7eYqMKmwYCu0ZoH4x4ylGWLrNbIqty7jnpTsP_pFOQ6tcJMXI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz1u2CUYIRS5qOH1EXp7GjpxykF34zsiGF8AqAnDk_Lw&oe=6A8D9BA8"}, {"file_name": "Bwah3.png", "id": "2408811942845043", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391952_2408811946178376_3849616786061894126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssa9JsaTNKkQ7kNvwFRoGdg&_nc_oc=AdpL19uDOBxBR1wu2fehtUsoEtSxGob2nRRlFIop0T8owUZNV8dODum7T7904NfE3P0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrY5DI9gbDj9oiRwPnHu_WKYwu6Gth_o22lcIEhI6okQ&oe=6A8D99B2"}, {"file_name": "Bwah4.png", "id": "1289058765913341", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393425_1289058769246674_3998892010612422005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFlrFKtriCYQ7kNvwGomgWT&_nc_oc=AdpQfsxzSYFswwwOpAyaVkMet88OZeyoXqweZZ1zXOgSokYDhHjHbH7OmL4-cjxPrsU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNoYyKHXQjSplcnENkfhhYGb-AEIyMxYPcylrx06R-zw&oe=6A8D7174"}, {"file_name": "Bwah5.png", "id": "966959772293057", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393956_966959775626390_6042396183174735659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J31my9Wiy9gQ7kNvwGm2xkg&_nc_oc=Adp_lkdW7ftjT4T2OgXftydPJrf0p5Be-x5t3KOKJEytqr2edFMk9mCEJHsazcfFrJg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGufjs5LftpyY-pF37MYIfAOCAOq2hBQkK7KdYWlZACnA&oe=6A8D6AE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah", "keywords": [], "long_description": "Welcome to Bwah, the ultimate physics-fueled playground of chaos and creativity. In this bizarre and unpredictable sandbox, you\u2019re equipped with three core tools of madness: thrusters, grenades, and the almighty tool gun. Whether you're building wild contraptions, launching yourself across the map, or causing spectacular explosions just because you can, Bwah is all about unhinged fun and unpredictable outcomes.\n\nThere are no missions. No set goals. Just you, a world that barely obeys the laws of physics, and the tools to break whatever laws are left. Fly with reckless abandon using slap-on thrusters. Stick them to walls, objects, or even other players\u2014because in Bwah, if it sounds dumb, it probably works. Lob grenades that send props flying and players flailing, or carefully (or not-so-carefully) use your tool gun to build, modify, and manipulate just about anything in the environment.\n\nBwah thrives on creativity and chaos. Stack cars on trees, attach thrusters to toilets, make a flying couch, or send your friend to the moon with one well-placed explosion. The physics are wacky, the possibilities are endless.", "short_description": "Bwah is a chaotic, physics-based sandbox where mayhem is your playground. Strap on some thrusters, toss absurdly overpowered grenades, and wield your trusty tool gun to bend the laws of physics (and logic) to your will. Whether you're flying through the air like a maniac or setting up wild contraptions, Bwah is all about experimenting, exploding, and laughing at the glorious mess you\u2019ve made. No rules. No limits. Just pure, unfiltered Bwah."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9756772114346156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "908433411290665"}]}, "baseline_offer": {"id": "908433411290665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744074420, "status": "PUBLISHED", "id": "908433411290665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28122467970683291", "version": "1.1.1.79"}, "id": "1318240299460519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9756772107679490", "is_concept": false, "latest_released_binary": {"__typ
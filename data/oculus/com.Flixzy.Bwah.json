061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sWIpB0rpuMQ7kNvwHfmWGM&_nc_oc=Adr-2HXnsg4_Jd6Shc9AXiNQZ1emfb4IcClVnGrb_ZjmzTeQX79lIDHErQkiB492mtY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqJsLCurWGxRLPxQJJJ8_uy5kuZWjOA8qdtz3mj-POYQ&oe=69CE5DEE"}]}, "id": "1781956922651452", "locale": "en_US", "screenshots": [{"file_name": "Bwah2.png", "id": "1715477449057735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1715477452391068_3554849862578957890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPqlen-WWQ4Q7kNvwGzfrzZ&_nc_oc=AdqsMauyWlP0HPx-gaiw1voS6GZjJ4yH_CDOxjLJK0zvDIj4TOy-1vYNESyk6eSJKDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxA_sl8prlDOg4-_JCi9tKhQvzJURQSLxKMi6imojnFaQ&oe=69CE7285"}, {"file_name": "bwah1.png", "id": "1381628853021410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_1381628856354743_499863310032098936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyKcaa1VsRUQ7kNvwErF5SU&_nc_oc=AdqAqKzKcIdhyMBTxc5Y2bviUlyiBtFWlvVk6YLlUxxEx3X8zyJzD-4KfmIyxja_Mjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzloM5iX-iA1KjiwZAqSM34ARGIbNeaiXp9Jr8mcwM7gg&oe=69CE7228"}, {"file_name": "Bwah3.png", "id": "2408811942845043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391952_2408811946178376_3849616786061894126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLQzKy7OamsQ7kNvwGjRK0N&_nc_oc=Adq0iqdRwmTknw2QSGfnoCV1owKlaX8D4ekG3ID_-KPY7pfK9rBLoOOjV4B02H_8Nv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwmKTizJBuAFLIfS79YQOXGP6T3jxvn6xjZEZAbAn_kA&oe=69CE7032"}, {"file_name": "Bwah4.png", "id": "1289058765913341", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_1289058769246674_3998892010612422005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UY8hRyfsFroQ7kNvwGT43ve&_nc_oc=AdqdHPB2wwTozj9Sj1reNRViop1JIAAdFtjmRCSG6OWXVAo1u695ITN3bq3a8uhO8Uk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxjlzsd6dmvbYoYjvzkcj74rn-OKSrufdc3fixGHqcPLQ&oe=69CE8034"}, {"file_name": "Bwah5.png", "id": "966959772293057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393956_966959775626390_6042396183174735659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5zcFFzte7cQ7kNvwGKkwpj&_nc_oc=AdoB3MNNWsKFszlQJNwsS-nCHz36ZPsj52YggmEdBa0nZWBSfVCrSBcihTzBVn7gmhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsJknmyzs8GdDRPNf7_kQcDzW9lysGX9Rjf-P4lSfonA&oe=69CE79A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah", "keywords": [], "long_description": "Welcome to Bwah, the ultimate physics-fueled playground of chaos and creativity. In this bizarre and unpredictable sandbox, you\u2019re equipped with three core tools of madness: thrusters, grenades, and the almighty tool gun. Whether you're building wild contraptions, launching yourself across the map, or causing spectacular explosions just because you can, Bwah is all about unhinged fun and unpredictable outcomes.\n\nThere are no missions. No set goals. Just you, a world that barely obeys the laws of physics, and the tools to break whatever laws are left. Fly with reckless abandon using slap-on thrusters. Stick them to walls, objects, or even other players\u2014because in Bwah, if it sounds dumb, it probably works. Lob grenades that send props flying and players flailing, or carefully (or not-so-carefully) use your tool gun to build, modify, and manipulate just about anything in the environment.\n\nBwah thrives on creativity and chaos. Stack cars on trees, attach thrusters to toilets, make a flying couch, or send your friend to the moon with one well-placed explosion. The physics are wacky, the possibilities are endless.", "short_description": "Bwah is a chaotic, physics-based sandbox where mayhem is your playground. Strap on some thrusters, toss absurdly overpowered grenades, and wield your trusty tool gun to bend the laws of physics (and logic) to your will. Whether you're flying through the air like a maniac or setting up wild contraptions, Bwah is all about experimenting, exploding, and laughing at the glorious mess you\u2019ve made. No rules. No limits. Just pure, unfiltered Bwah."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9756772114346156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "908433411290665"}]}, "baseline_offer": {"id": "908433411290665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744074420, "status": "PUBLISHED", "id": "908433411290665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26468520302744741", "version": "1.1.1.67"}, "id": "1318240299460519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9756772107679490", "is_concept": false, "latest_released_binary": {"__typename": "And
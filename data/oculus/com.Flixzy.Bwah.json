061_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwIxKsK8eosQ7kNvwHoB0cF&_nc_oc=AdpRwoE2iZVASz4TUW_SmCnV_VV7K7JrUnTR9E4YH9Otgh1lFxXXI202ZmDhs1ittko&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK7JeV0FjrjVn2FNBhGedpYWT4PWvSzXiTLdZyvFd8KA&oe=6A97326E"}]}, "id": "1781956922651452", "locale": "en_US", "screenshots": [{"file_name": "Bwah2.png", "id": "1715477449057735", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392016_1715477452391068_3554849862578957890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD1NgKg90poQ7kNvwHrNIku&_nc_oc=AdopmLhx8D8EXjCsnHJa38RaYgNKNP286lyzQ_0_DuNKzrTqevzFGhZL3ckcXQSoHSQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHVxaWF3LUSK5TwE1NCPzS0ACsO9xoPzqfCtZV-Iq8VA&oe=6A974705"}, {"file_name": "bwah1.png", "id": "1381628853021410", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393444_1381628856354743_499863310032098936_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyovMdot7FoQ7kNvwFExZ9o&_nc_oc=AdqdNoLrJqNKrDdP2g9IonazxGyKEl4wjbu3TN09dn7sscpHCIqKcj5aoSC_5Ehozb8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlG8lKP1xUTBITN1gksF2GsbVYxNYYZD9rRPA68YKWlg&oe=6A9746A8"}, {"file_name": "Bwah3.png", "id": "2408811942845043", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391952_2408811946178376_3849616786061894126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Hb--SgfrQwQ7kNvwH1As_y&_nc_oc=Adr_Y_-mklL9z3Z9m1sWddRU-blQeUsRvTHsqU-jjX9PSPukQbolaB0GhcVUgWSZY1c&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBv8kLa65y9ADPUCRg3KyKCTOFabjIc82v61Su7FO1sQ&oe=6A9744B2"}, {"file_name": "Bwah4.png", "id": "1289058765913341", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393425_1289058769246674_3998892010612422005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lOTWL5z4asQ7kNvwFojZtE&_nc_oc=AdovWnjvMJnchVRuSTX-WvYeLO5bi_EmnnwiEGrE0J9LVP7CdoNoVYMa3vTqvGqL2ms&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfjYcUi72_pS-xBMZo5hUDj0vHeahSzNgceMjP_pyiJQ&oe=6A971C74"}, {"file_name": "Bwah5.png", "id": "966959772293057", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393956_966959775626390_6042396183174735659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auRkFdIjYgEQ7kNvwHUle5c&_nc_oc=AdoM3NSBM7Nk1rmd4oI9pUXPPsTRWGRWdM8fd9_ys6kIwLL5uRZPjfNNLfyM4TqDIeg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgOgdkq00rnsfPr69ISy35I-vrTNSeng-C1ZLnMDXWzw&oe=6A974E26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bwah", "keywords": [], "long_description": "Welcome to Bwah, the ultimate physics-fueled playground of chaos and creativity. In this bizarre and unpredictable sandbox, you\u2019re equipped with three core tools of madness: thrusters, grenades, and the almighty tool gun. Whether you're building wild contraptions, launching yourself across the map, or causing spectacular explosions just because you can, Bwah is all about unhinged fun and unpredictable outcomes.\n\nThere are no missions. No set goals. Just you, a world that barely obeys the laws of physics, and the tools to break whatever laws are left. Fly with reckless abandon using slap-on thrusters. Stick them to walls, objects, or even other players\u2014because in Bwah, if it sounds dumb, it probably works. Lob grenades that send props flying and players flailing, or carefully (or not-so-carefully) use your tool gun to build, modify, and manipulate just about anything in the environment.\n\nBwah thrives on creativity and chaos. Stack cars on trees, attach thrusters to toilets, make a flying couch, or send your friend to the moon with one well-placed explosion. The physics are wacky, the possibilities are endless.", "short_description": "Bwah is a chaotic, physics-based sandbox where mayhem is your playground. Strap on some thrusters, toss absurdly overpowered grenades, and wield your trusty tool gun to bend the laws of physics (and logic) to your will. Whether you're flying through the air like a maniac or setting up wild contraptions, Bwah is all about experimenting, exploding, and laughing at the glorious mess you\u2019ve made. No rules. No limits. Just pure, unfiltered Bwah."}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/bwah/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/bwah/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9756772114346156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "908433411290665"}]}, "baseline_offer": {"id": "908433411290665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744074420, "status": "PUBLISHED", "id": "908433411290665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28292333497030070", "version": "1.1.1.80"}, "id": "1318240299460519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9756772107679490", "is_concept": false, "latest_released_binary": {"__typename": "And
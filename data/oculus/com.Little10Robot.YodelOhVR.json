03225_754498756090742_9176038424597096458_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=258q8OEKQeAQ7kNvwEV0kiV&_nc_oc=AdopmP3O3PPy0DF1S0xpzLeOUo7ychDkDcNt3246TLiDI8p2dmAIapO7dROyVr9hqhc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1GXu8rd3LuFnO5HM7OcugQGutl7q4Bbs5Tov0NlvmwzA&oe=69F21AE7"}, {"file_name": "Screenshots-5.png", "id": "1417257629078259", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031444_1417257632411592_4723288161038408063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CwzRPR_wboQ7kNvwFd28dp&_nc_oc=Adp01fc8GNuD2154tTtZwr5Z4SI3Gg59hyRbeZm6mgDrjgdN_s5ZHyClj09nf7DhLMw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2D0-3n42I-ukGoNeB6GAtDi8yi0yD1jkvOwML_PfunSA&oe=69F1E836"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage-Video.png", "id": "604010614966356", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75318183_604010618299689_244255611400115931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZo3QDJip9oQ7kNvwETw-RI&_nc_oc=AdoIbHpiZW2WwaOf_GDJ5y61U7sqoSO0NCjWTJyrhJf16UzAACH5Wrqj4PY1R6MYAUU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1leg0a8nPKiEUSWNlVkWkwur1_4-oWdtiy7ECszFnY9g&oe=69F215E0"}, "display_name": "Yodel-Oh!", "keywords": [], "long_description": "Take on Ram-Bam, Lamb-Bam and the whole bleatin' clan in the exciting Alpine climbing adventure that pits your wits against the meanest sheep in the mountain. Loaded with half-crazed herds, twisting targets and awesome fairway sounds, Yodel-Oh is guaranteed to have you lacing up your lederhosen and yodeling for more. Download it today!\n\nFeatures:\n\u2022 Fast-paced, target-plinking fun!\n\u2022 Original polka music and genuine yodeling!\n\u2022 Plenty of ducks, gophers, rabbits and mice (Why? Why not?)\n\u2022 Swiss maidens\n\u2022 Unlock fun trophies\n\u2022 Fun for the entire family and great for parties\n\nMade in the USA by Little 10 Robot", "short_description": "Take on Ram-Bam, Lamb-Bam and the whole bleatin' clan in the exciting Alpine climbing adventure that pits your wits against the meanest sheep in the mountain. Climb every mountain. Watch every turn."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.little10robot.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Little 10 Robot", "support_website_url": null, "website_url": "https://www.little10robot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "914637366629034"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "564406025539128"}]}, "baseline_offer": {"id": "564406025539128"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681319940, "status": "PUBLISHED", "id": "564406025539128"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6170214263027238", "version": "1.0.3"}, "id": "1338277970346989", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6111428018905863", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6170214263027238"}, "release_status": "RELEASED"}, "binary_release_cha
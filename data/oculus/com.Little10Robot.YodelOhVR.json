"https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75318183_604010618299689_244255611400115931_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cizJG3bFf1YQ7kNvwHBrYfp&_nc_oc=AdrxMy8PytmJjw_X8JnnQoHKCBRs4KRt83yDL_0yCk57Vo-ReWDqPNbcVR3-gk00bxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSttZg1xiqw03SArceAaCBz1-13yXF-jnYZ-GggMJVwtg&oe=6B0C6F20"}, "display_name": "Yodel-Oh!", "keywords": [], "long_description": "Take on Ram-Bam, Lamb-Bam and the whole bleatin' clan in the exciting Alpine climbing adventure that pits your wits against the meanest sheep in the mountain. Loaded with half-crazed herds, twisting targets and awesome fairway sounds, Yodel-Oh is guaranteed to have you lacing up your lederhosen and yodeling for more. Download it today!\n\nFeatures:\n\u2022 Fast-paced, target-plinking fun!\n\u2022 Original polka music and genuine yodeling!\n\u2022 Plenty of ducks, gophers, rabbits and mice (Why? Why not?)\n\u2022 Swiss maidens\n\u2022 Unlock fun trophies\n\u2022 Fun for the entire family and great for parties\n\nMade in the USA by Little 10 Robot", "short_description": "Take on Ram-Bam, Lamb-Bam and the whole bleatin' clan in the exciting Alpine climbing adventure that pits your wits against the meanest sheep in the mountain. Climb every mountain. Watch every turn."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.little10robot.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Little 10 Robot", "support_website_url": null, "website_url": "https://www.little10robot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "
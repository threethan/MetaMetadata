ve5Hfrim98japCTIoeJeoK81S7LM-zGvA&oe=6AAE9303"}, {"file_name": "Screenshots-4.png", "id": "754498752757409", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003225_754498756090742_9176038424597096458_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imXEw0P2tRYQ7kNvwGCuj8e&_nc_oc=AdpOs1BkI85-6Yi3OQva_Yes3ai5VZElj4w9SIxRuh6DAuStWyjX5yAxNOsDfxvzdHo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJQAj4z2TrNtxJ_oeN4FdnsIqIDmqlnVKtypCMZawwCA&oe=6AAEA167"}, {"file_name": "Screenshots-5.png", "id": "1417257629078259", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031444_1417257632411592_4723288161038408063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzln0zoe0lYQ7kNvwGq-gfS&_nc_oc=Adrp4j02CRlhmqjN3gR3g0F-575bPJtD04ejITxcmCf7uBpfGVkmHyxpMDbfSoTqk24&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYxoieygSxF6LXut8l6H0jqzi7OOs7mTd6higRb1CqBA&oe=6AAEA6F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage-Video.png", "id": "604010614966356", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75318183_604010618299689_244255611400115931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHctsOdyeSEQ7kNvwFv-hDS&_nc_oc=AdpyqRp5aQxsa9ALa84uRDwdl-U0hE9IFDbZUag6LGHGRrZnfFzA183VFzoZFyaVD90&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoKYLHBvInXD90nQokxVLOUrD781rmYyILhCD79rp6NA&oe=6AAE9C60"}, "display_name": "Yodel-Oh!", "keywords": [], "long_description": "Take on Ram-Bam, Lamb-Bam and the whole bleatin' clan in the exciting Alpine climbing adventure that pits your wits against the meanest sheep in the mountain. Loaded with half-crazed herds, twisting targets and awesome fairway sounds, Yodel-Oh is guaranteed to have you lacing up your lederhosen and yodeling for more. Download it today!\n\nFeatures:\n\u2022 Fast-paced, target-plinking fun!\n\u2022 Original polka music and genuine yodeling!\n\u2022 Plenty of ducks, gophers, rabbits and mice (Why? Why not?)\n\u2022 Swiss maidens\n\u2022 Unlock fun trophies\n\u2022 Fun for the entire family and great for parties\n\nMade in the USA by Little 10 Robot", "short_description": "Take on Ram-Bam, Lamb-Bam and the whole bleatin' clan in the exciting Alpine climbing adventure that pits your wits against the meanest sheep in the mountain. Climb every mountain. Watch every turn."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.little10robot.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Little 10 Robot", "support_website_url": null, "website_url": "https://www.little10robot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "914637366629034"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "564406025539128"}]}, "baseline_offer": {"id": "564406025539128"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681319940, "status": "PUBLISHED", "id": "564406025539128"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6170214263027238", "version": "1.0.3"}, "id": "1338277970346989", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application":
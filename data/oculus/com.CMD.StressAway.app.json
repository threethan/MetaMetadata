n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RndNGKYCP6oQ7kNvwEIEYEb&_nc_oc=AdrQzFy9HJYZEN_yIva_jIwaPWYaX35IeUkhPwLiGX2Blnd_VU6H33KkkVf-FrsmQG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz20YdZ7QLH2AMe1iXrzOGs43XuXzXcB972U4_6qXrPg&oe=6A4A5F0A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3p_nJ-VuiYQ7kNvwHYAlVk&_nc_oc=Adqi_A7YbF6ny93FzwpGQAFveMwfpHnYFWadc51xf5BSJdG5VlnNcabC0_50FfONsvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVqIlnuzonp4ozYDzX_LDjeIL7msPVN5vek1WQHCJL9g&oe=6A4A4FF7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7F-j9pZ1w0Q7kNvwF5oLZZ&_nc_oc=AdpK3PzxDC3eISEnOzY8XlJDgxldq-xjjbCySfe9NstRd3nnAkZV1M5uIisnwLt9JO4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_wFIs8DH9NPIBQgYScb_EudAIsWoVVDZtay-Gb2h_5A&oe=6A4A8304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQVzILMTwy4Q7kNvwEpIk6g&_nc_oc=AdqJVA4ahvcKPgIlWFfK1rBWJ5wjtceOfLNsw4qeW10k6zSfsoLDGNNKPRM9N_R2Xo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpnPNWZjLV0KXAWdK_FUfOytveEb0CJFJLb7fpBlkNag&oe=6A4A7598"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdKnH1rLuBcQ7kNvwFEi4jW&_nc_oc=AdqllWRUAF4y_jNBlkDTndyNsBSVEhi03aYgxEo8XuNKIGMFdCX_UUo65Wva4COOnUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIjn8beQg4qCRhbORycyd28GdxNcL7zx
n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrZggf0afXIQ7kNvwHkiyKD&_nc_oc=AdoJvlF0_dS4tBeB5ZhhoYQ-k1IKbY-CwMdnstC0HFzU7jhKXuj9IKk20f8G3d8K8mc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTpaJSdJnUHht0bGyKI7lkVBwWaSlCxLjwENKFvv8GSQ&oe=6AB5288A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E_SlaePfDgQ7kNvwExH-TX&_nc_oc=Adqr1vTqwZaWcbSbZXpwE0jmtn3YP1Cd87MzbqhqlzEqkdPB10ciegt_4-0DjC_yhO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvkjbaIKD5S-_7SC3tp6xMaDaqFeQkoNwNZK-V1pGw9Q&oe=6AB51977"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUZrN_aTHGQQ7kNvwH7-b1N&_nc_oc=AdqRc8RWPe4U5YUUQJ_Yi_MRVvqJxXZS7DgqFtQVyzgkrUGD7zRIOoUKDlm4n3BWSPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHV9Y8UjZ1PR-NeILpm4dRzSSXBKIUw12aMuj32S-ljA&oe=6AB54C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy9IqcmKbyAQ7kNvwH3jEqW&_nc_oc=AdoPvSqsOOakDLM-N7ztKPK1f9R7LTeSLQn6rsEI6LKV-fTOdlN3LMmidA-41J5Z-xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqJRXoM8OM6QUwsLee2pPj49BHdL88yhcCF7JxJllRHA&oe=6AB53F18"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IATfLcbprLAQ7kNvwEblioy&_nc_oc=AdoELuiHuIy1xyRYNqHW9jTW2DSwG0IbJImGXBS6lFVBquAMrhffHpZeVAbScPyPIpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKh2RvZxL4-gEsAFgGfzczn6HfpeI4oo
n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nvpioe0FsdwQ7kNvwFryO97&_nc_oc=AdrzKcNaMwNCjHW23ujn6F-BPcxH-4biHUutj-P9vz7y6b0AnixMU6s5beAhMfl3jjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ht1yMAh3rN-MuafKfF7R6URrG5oA2flaBDLQeWtN0Ng&oe=69D8FE0A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgzFQ0Jtd-cQ7kNvwElY7ht&_nc_oc=AdqFEFWaXYGYOSDqOuYJt8MFyudLyQZhuqI9CMCMoNg5Ezd1ZN3cfIwOo23A2fR9hEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02zz8e-HN1zeoPmX6XDVsFYWtt4f1uEpSZlY2er10F-g&oe=69D8EEF7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkSHV78WxQYQ7kNvwF_eJEp&_nc_oc=Adov8ggnBaTcTiRrNZvGmvedy_SBfyi4xm-OP3DiAI8_CRuvpHPbf4oiUKaHXDxdfOk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_1S9P0a1Zy1XFngDBYFDbBqur3LjpG-2puY9hWjojDA&oe=69D8E9C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQM49yCWGykQ7kNvwGFD-aX&_nc_oc=AdqQYhOoJBsG7xU7fVzKRKIAXxmkZDffswXSIfGW3f5Jlm31U2xm3FO_llzoBMNQfAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jjg1asjufS_h6jM-XRCCZ-WwV1ZK4gfC01NZULf4c1A&oe=69D8DC58"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tG1Vj_8LUQUQ7kNvwHqEeaW&_nc_oc=Adq19dFzoZnUip-Jl2W19or5tzPPpHe5z8_luWEOeTTBMQF-vOGK4oNVDI71ISm59tU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mM8VjXy7E6xIOAqqXtc0bFYb7j75oIA
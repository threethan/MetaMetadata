88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0o6qcYmGAMQ7kNvwFZrHcL&_nc_oc=Adm-GqV4-l2ijdz40TXc1GNJHijCAqQneZUk22ZOXmqArfYTyDQZtF3TzuN8PLYTvX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfweqNH2HC7A4vG_xUkgeNSsjUcr4a-P6wDyLBetSCltzA&oe=69B6B70A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CWMrX5He28Q7kNvwGIyBEw&_nc_oc=AdlpLEEs7D7TD50IVuqq0cga_nM-C_odriJbsSTJotV7skIuGmbKl4nBkILEvP42OjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYrkbHSN1A0IGftUXi21lAhhrituts5J57b180Ab3TBg&oe=69B6A7F7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik9KiJGkkrEQ7kNvwFvInbT&_nc_oc=AdlRrO5pYdz2PCtHHa0jRj18uHy0Zyn40nFqExBjsMGJ-Q_2mCc5lqRu_EmsrtHcyhs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyC3DUW4Rl6NEsHPwMVORrZarFvEJ3bzXHCVYYA28IpdA&oe=69B6A2C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y37hr_cRqBgQ7kNvwF6EJWP&_nc_oc=Adlc2z3oxz-i3cUzcZliI-QAqS7bU-k18bFwpaiNz22YiuuoxXpGc8ZgvKL0lLayA1c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8MaHrP_bgAMY-41IF4TfVam1Rf5YNIw3YfmjcKBZ1qQ&oe=69B69558"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxgkEIP9sycQ7kNvwG_VPb8&_nc_oc=Adm1eYm-VEdAUqWnotVLKhJjmjsDJABiFIPpv4QEw2UGXEgvAwwKk9jozS0BqiidrFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzReDclEVnPRgUiU3h6C38KrDgwrwhSJEFYomE2BWqSNg&oe=69B690D1"}, "is_concept": false, "is_tes
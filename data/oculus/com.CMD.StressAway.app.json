=00_AQSE5qqPdHVbX6VNnALIYXxE56JDmfhoKPwx-nwLiPG_-Q&oe=6AFDC198"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
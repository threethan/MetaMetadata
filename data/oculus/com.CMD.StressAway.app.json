88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgTDRZ4q3UkQ7kNvwE3beMc&_nc_oc=AdmPRGQ_sGuou7EPAeLxTUe9HXDAy-XYTLxoNugDggxUhuECStIrQqnB8d8Shta9lqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfylLzRhXKSxPGfiywmwtAAh5UvQKJjyTcsK0qpuCtyPlA&oe=69AD7C8A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-kbS387jSUQ7kNvwF-Qssb&_nc_oc=AdlhPgfZplJzvLOSHrzv3PlEaQfmRAaqXWROQMy4Ks52Aqa48pwkMy7tFqMOlT20lDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0DegFjkDd11hvApF06MWStSfJcgfenMstzFdaut-9pA&oe=69AD6D77"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTpgpq4SricQ7kNvwGY1HmB&_nc_oc=AdmBSF8a84jGyjXfXP64mPyqCmpxwJvbMtwRzijYPAsfmd-aDyr_k9eYMENqpfyCqCU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzzt5Ldqm0l2GWZNyXpbTemMxlno4JWAVZ7J9wKiKH7UA&oe=69AD6844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcwVTIjrwl4Q7kNvwFOqAvG&_nc_oc=AdmiOyvYiCRF7OfG8JkSE9hARVCR5AuukxN6GkFWiF4SOVnfyel6p-QrfR3TF5lJSOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2KGdtbxHW0mOPiQqJ3Bww1mKT-xPA9OOYaUoNw6mNXA&oe=69AD5AD8"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75rpgnAMf0IQ7kNvwEkfTAn&_nc_oc=AdmPPZNs58-QEqj9vjuM8-svukbbKLB6BXAkkWb0JpLZ4amM9MDsM-NHJysW-5ZAlc0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyGeh0RpV85BumS8pktXirpJzeTCooXZIjDM5LMw-FqQ&oe=69AD5651"}, "is_concept": false, "is_tes
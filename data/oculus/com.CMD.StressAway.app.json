88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyGxxjfF_nsQ7kNvwEiMfgW&_nc_oc=AdkuRTl5nUZESSGGbRCAFfiYvAr7X3fN3IRa1L48N2ymiT0EQVWLEnLnq3YPRub2OlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkMl42oMPSZ5V6v3uiVymAYcEx3FBGIy38seJTgauS8Q&oe=69BFF18A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHwTiPzqKAUQ7kNvwEPApym&_nc_oc=AdmZaxL9qs5awKLsMDlEmmkMv5jcnEoCgyQazplq-UcIjsoYxI4Rp0-qhNyK5jdap6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiFTTVtJuKBZ1lyyOIRcyGscFruDUtzxZLCgLkZenCEw&oe=69BFE277"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BTLrg5UWm0Q7kNvwG2tQL-&_nc_oc=AdmUKt5528YAnKxZJ1PgffgQTFKwOmxo9iKiQL7fp26fv25MbiIYBdfKjpxWnA8Ib14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVk92GpaceNNBoVOSWPH4khozxUebt66p6ylWBL68FsA&oe=69BFDD44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kokFwsuYkRwQ7kNvwEl22Zh&_nc_oc=Adn8ZayMSJXJJDDTn-x3aDuNMvM05iBqrf1812fVaNvAX5iqy-qFGIzPPfbNnpAJWss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEOhXCRBWMxFR_Dro0iUlugz5gxypyH7M6akGv1Z2fbA&oe=69BFCFD8"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0gSO8YHvaIQ7kNvwEUP8Ry&_nc_oc=AdnJiTYXutu0FY_G3f0YNLyBRdcgESSHh3d4Xft4-ObjupIPhHT7jHjp4VAdGugsezc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3NjKRKIm7gD6NAAYQKLAKNeyK7KSamffatZFO0_vajw&oe=69BFCB51"}, "is_concept": false, "is_tes
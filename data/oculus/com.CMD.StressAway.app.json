n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERMAjkYWmc0Q7kNvwENZicD&_nc_oc=AdpVd0KzSgD1itN22KhCgj3RvZmaa7HZ-EUUdyYCi_FzLI8jyM8BKGkBFN-hdkPnre0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jSrngE1m3X0PgWkaL8VYjoJ31z-aYxJQ8mXktrby_7A&oe=6A08740A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqwYcafzyEUQ7kNvwEu0fJ0&_nc_oc=Adpm3FV_AKD9ohBH598xJZmgUfbXiqxmu4_ZFpJLh-XcgwBYNmg8Wjn-CxTdxgykmOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Iy8iP7ZHq9ndUB93UEUk8A5RJOTow2b-a--gnCu1Xvg&oe=6A0864F7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bWvOtZebYEQ7kNvwHe66TX&_nc_oc=AdozhMgiOTf80RBd0VK7Fwnp79nQsbuDKknSGT1QvU6kJFvwS67O1teSW1rstIvpL6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65CVjLg9gXlwEyf9HQ3ncz6ZgBX3AJMIJMWDy_S1iWVA&oe=6A085FC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laQeWwfogzYQ7kNvwH6rZVR&_nc_oc=AdqmuSacilLjwo8_5ZpdXr_ORpGAH4HfU-kYEd7pI05VITo9RxkyvwF4O1tGj-zkEq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zUN15efiayrzPHxI9vc2imcUNJFHRY0xECQ2fXOwI1g&oe=6A088A98"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ituqJL7_D0Q7kNvwGxuDUu&_nc_oc=Adqox3W2QU1zZshp1UU8PcaPzY0mNDcr4YPFmQoBQ0O2Uie8NbiccN9fCNeWalPrBj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NK-3TYg5CcvS-6GL8ALu38GQrZbPr83
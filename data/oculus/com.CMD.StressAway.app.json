n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXdbMOU7S1YQ7kNvwFnP0Se&_nc_oc=AdrQZ_we5DqETe6fxLrdgDtHHZTKV-K_ZmSX3sWuHN_568d-U4m7eVUcS6YxoK4LA64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlMslLR33tnifH-YSc9wyU1TdWOsQlqj4QfSbqKfTBLw&oe=6AE5F00A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JOzlqgI3U0Q7kNvwFWUcpe&_nc_oc=AdoCLcz0Wgg840L7FzRR0eVBcSYYFOLygldhwDpPKsBiZMfi51d4J5S0oi8hSzEkouw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFLJcqmDJ1r7UA51sNjP2FN1EWOWdkn8mF4YmyavHx4Q&oe=6AE5E0F7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlkVFqlMnP8Q7kNvwGg4W7N&_nc_oc=AdrqGtDXulYP-VGFEe-GJcZqYIA__IErlLzkE-401QoaLI4sp9PJG5h-_wRBJ59wPRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7Ifrsye7SdVEmlX5PifpWOdJC2z4H5MGW3e7XyhuPrw&oe=6AE61404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_HxyLf5d3AQ7kNvwF91Hpm&_nc_oc=Adrs2I6ZJAPGCFt3vRw_Bz2YCy9pzhaYZh5-FcXJtFSrQ--4oTFft3WaJ3cdBv5yB90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZOqUShouKcDolZCnrwdtEM7SLAIFBM2upD8VSXfPyMg&oe=6AE60698"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28QCw8REUrQQ7kNvwEQlLey&_nc_oc=AdpLlj95iUvJUXX5ss1iNT4wmaOTxCL-3PHJ6v0lvAyi5t0k2qj4US43HQMiiy4ClG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNgF_-KLoQymdgqgTMPTRK_8wfgEscSJ
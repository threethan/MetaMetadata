n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7WiBqu1ItwQ7kNvwF8sCZV&_nc_oc=AdrFUTkKMYK_Y3Ko3kz-h7ehi8Igp-H1fnsTurw8hIFulRhCCny8g3R487Q9VZ-1gdQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_90whiE8yeG4RatgvaI5-pHHZea4O74J1xPNcZH1GRQ&oe=6A1D8C0A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oX2U94qs4wQ7kNvwGW8IfQ&_nc_oc=AdovUUYgMR1Pwt0xhYMfTWtoxF_baVo1_BxHSO2iX9wNjLYRKbM1gz6WW5r_V4J4xB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aKw0ybvSsnLfl5kdHpH3XoKr4R4PdMdZVJtWeLQoing&oe=6A1D7CF7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIUU3RUS65EQ7kNvwHuMi6U&_nc_oc=AdogHmKB4eRuV9ad4580aKv8sGSO5R5V4hG6g3QgL4WViicBSkn80MKBUeRUe8FuiCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TjHhtllkaElsqOgkfgr7-KQKZ2Qya-kbXJrzXsyRvgg&oe=6A1D77C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WST3LFQptsUQ7kNvwHIrwLm&_nc_oc=Adp-SWo6jc8xQCqjwBaf_ch0as9-XvLi5OoaDzSHwyyYPF8DaRjPlTtjNoSAPR7NK2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54Lq9vKv6IoHZbFcMBNUJy0Gx9qik9fCPg_hHt-sc-2Q&oe=6A1DA298"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3BCaRTNvFEQ7kNvwFDIvQr&_nc_oc=AdpnCWXZzsSSwKOH3t85lAqgHvMi27OdDUnaobIYaT72vJDOPEfHBWwFYZeLxVDHVOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Oc8RmO6VGHBfagNTQ8hd9MZGunMobGQ
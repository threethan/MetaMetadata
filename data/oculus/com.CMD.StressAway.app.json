88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tse8xEp1TO8Q7kNvwHA7jSo&_nc_oc=AdmpisdLPE2SkaIHmg8yUjbdLiGa6so3YS0TGzBo3-cegVMzkKu_dmqLiRPc-mXH-RI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-J5b9dF2bkO8n13YWseMbwllW_TeLDwuZPt3jVrF6mg&oe=69BEA00A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azvMSeupxnEQ7kNvwEzz-C2&_nc_oc=AdnnJ_RidpQBfGZHJb5YVmJTNbRnqny2RiwoHFG83fc-q9Nuk4lHOwWPPqrk_Ba-Q3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1baHdr0Zs6Tm5Z14-7p18-bq3WTUkJ5SQATo1w99AsA&oe=69BE90F7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAtKNm34LAoQ7kNvwEWPhIf&_nc_oc=Adl094dV4rmQ_sttCBCmU4ilESxg3I0g7LHMMlMR2YFx9xs3YKuYxBvYi6oyHAXjfAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYwFj_l9q81_WS9o4jU1-8feZ29LBxkXsTP1RTQffFBQ&oe=69BE8BC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3ypVi4Ty-EQ7kNvwHf_Vjx&_nc_oc=AdnsaARDcFqmx6XcoiE1A2KijtHpWq-JPwDlKnOYQtMOk1ofLNptGdORNqB4ttaXpOI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiX4RhVRL71c9NP1aRwa8PwOM0IraMLWM5K4gd61aHvA&oe=69BE7E58"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0gSO8YHvaIQ7kNvwEYEHL8&_nc_oc=Adk4C02-yPiUNq5W9o0aH2RT042coBxn9rsLIZk8qZ1jm05IlxmSENpJoi2O2NvsBiM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxm3_WjRBIE_FAfcFXET_BlFl9phTux8E3mGS2AOwS9dw&oe=69BE79D1"}, "is_concept": false, "is_tes
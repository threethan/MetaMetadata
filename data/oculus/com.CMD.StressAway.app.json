88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYPIuhLP8AoQ7kNvwGQH_km&_nc_oc=AdmUsT0mWNyxzEs6TvUATMM6AgsDngjf4SROOkFz6eBb8fyo2F_ZKCNXGj5RDaPdHKw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwfrzsv2q3rpH3B3vYMyI3wLwSudBLkc7sCD3pk04DHew&oe=69B95A0A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ki0fWAT5psQ7kNvwHb8YaL&_nc_oc=AdnbSv4D-wWsXSqZz3S2OYuXvr4uVm1ZKPvGbGkAIcEMNYSVwilEkv9U6YSR0Qr2AMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS1tGfdA7_nY-J762vs_VTHLBIxhvcYLenZRkf4cqMjA&oe=69B94AF7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgb0WVYTCycQ7kNvwGKzKRr&_nc_oc=AdnuEA_OT1hflr8O4kUnNzk92Bc4peFwZcX9fBsAB1VVDAW6F8M6sJTz9zwF46_FS0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzMbEGkxQUPSVAJXLvgrBfiFa-khS9JQlvpjuq-tHxt0g&oe=69B945C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im6WwvIzKzYQ7kNvwHv88I9&_nc_oc=AdkpgmxBmGnYYCIYno1H3-8HjqB_QWyLKOt_qX_6DIty5sd2bxXj07TggY1P5O0StJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzF44Xtug1_iVcO66ngrs1PUDWjmZCAHf5RjgiHflaVsQ&oe=69B93858"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxgkEIP9sycQ7kNvwF3QDAC&_nc_oc=AdlA37H16mfZYsLfpH2f1MC5fcg5EIS3SM9mFEMK_eo-dJYJBdk7H2gVZwmxllnM5kw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyuFiYCxFXW1l-6OyST4-V1NbsLqita1VHgiIDpL1lzZg&oe=69B933D1"}, "is_concept": false, "is_tes
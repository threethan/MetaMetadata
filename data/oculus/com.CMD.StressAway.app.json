88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tse8xEp1TO8Q7kNvwGb22rd&_nc_oc=AdnkF74ru5JhVcNeL2Uu0Op_oDI2lowX5zRU59McVe0EFN5D6zXjSFzyeHCOFrwxoMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpHLofnSRaruIUIbHDRxMNP7CEb-Deyn11gRkX9u7BNA&oe=69BBFD0A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azvMSeupxnEQ7kNvwHIjpW7&_nc_oc=AdkA-JmKY2GQqY1dS0wkANT_CtIlnw1BDoNpQOgIw1WtA4fFjFeFLR0UVZv_EOuMNQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDfDbL3PAJgpgd6abzvXjqUY8IphXjMERkBvhXLuqYSA&oe=69BBEDF7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAtKNm34LAoQ7kNvwFPRyW2&_nc_oc=AdljkSoF-DmImXiF6ZWZq0t08lPWk4ASumFVc4LuWv3c7kDw299kftZMpbinPAUyiKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhoDnT87nMf3icKsQr9YeCJfA8nJh7IJLZ-Ox8UrL4FA&oe=69BBE8C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3ypVi4Ty-EQ7kNvwFjl_sO&_nc_oc=AdkjUPgnoMsodT-CBvWfI8jfXfQR7CGCphJfc9s6W_pjF2IOnohGQr_tZyG17ZSW6FI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBdsrOFtNDLkCQJiGRghejPuvsqYAhXlULw4dHy8o2_w&oe=69BBDB58"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joRPhJjkw6EQ7kNvwFOP3gM&_nc_oc=AdnA8IfCjs0nbfPs5AjRB3h5YitWRXkmhWZtex7Gxqmxm_rgKXA7RcN_KwD1Tmfyxrc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7UHcXC2bkWdP5AbgB5Qx-7tDX3JuETWvlIjl299SJog&oe=69BBD6D1"}, "is_concept": false, "is_tes
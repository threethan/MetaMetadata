88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tse8xEp1TO8Q7kNvwHKn5j4&_nc_oc=AdlHp0aUtGhK_AnQ7Rdui02aU-3qo6-UkEGfo_xx7J9fon_5KBNi8tffOlEV_YwTZTw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQGhzk_Y5Ta6VhWaBSccoCGp9OfqOhZRjMbVxh1CZTtw&oe=69BD4E8A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azvMSeupxnEQ7kNvwHI6vGr&_nc_oc=AdlUK8Bx4O5gLh8ZAcn_J91I_WKw7pYvLvAD8W1FqanFi3Tn2Li_dQO_fwOhxoO4RQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWU3vXQJ9X7ppSdsgX9Pfcd0o8Arp5nEo0qF8Kbae9Bg&oe=69BD3F77"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAtKNm34LAoQ7kNvwHLiU9v&_nc_oc=AdnztNOn4dv9WlN1UhUcwFlc6znr3OWX6NIKNBPZb1KcaXbTZvsW3l5XrzOdlHU7AYc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxrsa93jQEU91zOhLeaczY75xzVUDTSJTeFat4FX1hrnA&oe=69BD3A44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3ypVi4Ty-EQ7kNvwEH5jRl&_nc_oc=AdnSiWr6jkafL4v8ZjRQ87PHgq-gYrrAaHCL3_xzZENMydjSzrgYJOw01ETUJhzxZfs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCI1AAd0vdhBIQAwY6dk8o_AkPbQMtSEVGaM_x_5wd1g&oe=69BD2CD8"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joRPhJjkw6EQ7kNvwHqKI3K&_nc_oc=AdnX-YVU-fDQwR6SjsmSFjMu3B2i8R1hHoTk9mibpZhb-9eCkvCuGZqvmxo40zL89os&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvToNiffJcIJNyDIS6xk_Zn8WyzRXt_l7VEzipmCGNzQ&oe=69BD2851"}, "is_concept": false, "is_tes
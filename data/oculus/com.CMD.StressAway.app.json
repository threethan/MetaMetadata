n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mI_GWwAyHoQ7kNvwGCTJ-o&_nc_oc=Adrdtj2lSuyzisAijLAq2ORyQrGNaM6P5ZZA-Mo-JGLf0ng0ZM0swFOjM_RrWh2HilM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmUl3BnhT_oYK_t0rzQDUDPD4nOof8DlImwISDjFhfTw&oe=6AEB360A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9xyTcmc44sQ7kNvwF-KuMY&_nc_oc=AdoGfM0fKvRcBD4sX9STzzjuGzfTf4W6bWrTrjK1--YQz5MxpSKMFa9eM-E2zsvIJ78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVT9Ar21U68WQ-DiGmaygK8UpGh-Ii9dPzDLHrylL2eg&oe=6AEB5F37"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5AphC8TDUAQ7kNvwHk33BK&_nc_oc=AdoDoM748oEdZiz3TX8we9eqBDI3izYZnWim9vthYG-j-xBMH2CSQ3Xp6fu_tZgIUXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4TSAHkVv_zbj6ay0OyB0247h5AU17AmFgMyYChoJZQw&oe=6AEB5A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKT-VA--QSAQ7kNvwG_FrOG&_nc_oc=AdqGs6PI8_aDvr7X9ZZdQvAuHXzyYuS0bqND6bAcBW3yZBHpe_eyPA6WKrbtxHgoprM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDD-0DGWdIWBEqc8EVKqwvKTfDQqlT_gKb7SCmERKYnA&oe=6AEB4C98"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7uZ-Y2YppgQ7kNvwEwegfl&_nc_oc=AdpKdTRLPCQnPyYI9AE_ZR1iYs4BYYreeY9jswLNguYYmKK9rU8j2u7dG5PXd4P0tA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpbbLjmVbC3qSLwe8HbXCxv_BEiuvwUP
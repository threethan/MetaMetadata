88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYPIuhLP8AoQ7kNvwEyfFwp&_nc_oc=AdlqUkB3Dw_MqzPRetBXFmaenatyKPc4Y9Sh-8EF_bOwTylDa3DI_NLGy1V19oagTz0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzdyoWWKAgkNaSf2Z2qTyawpzxhGxELP5MJC1haM0S2oQ&oe=69BAAB8A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ki0fWAT5psQ7kNvwE5r2KB&_nc_oc=AdnBwFB5nZTPPGXv0h4IIL6NBe1JAi-rrq5yu7DXPqK04PE7ITClnv8Ykfp_wqo4yPM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyegexv6s7LJOdrNZ9_eojbQJ2xE8x5bXhUng1tNYBDBQ&oe=69BA9C77"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgb0WVYTCycQ7kNvwFMAkJT&_nc_oc=AdnB2rlpqyD8lIDqI3layyHl7AgziLe0okspKTXVsn9w3kiruFasJD965-AcyMTr8cQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4Hvy3_98uWEf2VcKFlwmSeceoYGrXwyO5kGaXobxDOA&oe=69BA9744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im6WwvIzKzYQ7kNvwE1vW0U&_nc_oc=AdlTn7AWSfEEJ-uyocOwDx52BMCm88BHjLaUZjf8_mVd43UaPblp0an6nM1_BB8AabE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFanMBo3fgWoP48W3ZMmOEsJXTBxe9FGRr1JSgrwGWmg&oe=69BA89D8"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joRPhJjkw6EQ7kNvwEOwQ9n&_nc_oc=Adl6VmSjFvVWF18j-wKezN8M3hwg7SrrNKLVu0MjB5lQMvrbI5lVvKWnRV4JJQBRgOs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyunF80ipmluihEA5HuEmQ3ms-M3-Jh42RSuvJlJW9QPw&oe=69BA8551"}, "is_concept": false, "is_tes
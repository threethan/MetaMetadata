88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgOeS4N8nYMQ7kNvwFjq2P8&_nc_oc=AdmlbUq9dzMly1Qg04gMr7EX1SgrMXXQDu6LtZtkk_uzenYXlNlHeP-cic3_CxRNosY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxmc8UvJgtANZscBEZFkDypH5J3lCr2-Ev-7w-3waZcXw&oe=69B1710A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocSaHiipeIEQ7kNvwGyKEa8&_nc_oc=AdljqScoUVCFOAi8Wwd2-xgD4_3HG0LERPBY5c9WrrnXyxsGYBQfVonY_tlp7WzGPiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsDhTUmFBLRvQV2bZRbMzR64oiQs_1W1yT8edFJ33zIA&oe=69B161F7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_sD4nxujMIQ7kNvwEQGXNr&_nc_oc=AdlBXc6qsnXT54LQs0tlr7Rix1i70vydFzw_6j1HM7WYo21cjXN6sbnrWIQtPrq_Uzs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDvJck9iwPDv89oBwuekpG-B0GrTnlaxfpvUThSuM_sA&oe=69B15CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9SDxKi4Zd0Q7kNvwHezbH_&_nc_oc=AdnngGtOFx0wNCRd2kCaxqJKWHzgbwXGourGY6B7wpw1NlopX3ib5x39PGwp3B1VoVo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDdRAsBDLROiki4POEnSiknpVot9k7iUxp9KTqoAkQ0w&oe=69B14F58"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZqSUT6JNZIQ7kNvwETmEnj&_nc_oc=Adnh2bsblzqayzIX49ZGddclNubA5gZOKB-aRjdFD1BLyMG11UC0y6f73ThHrx3VVyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdimjQgY8QG7DRg_kM766hULz5ZXj8SAvkG73Ox7oX1A&oe=69B14AD1"}, "is_concept": false, "is_tes
n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3WZ6Aaa_PMQ7kNvwEOwgJF&_nc_oc=AdoG6cwypTh5xQLppsGRdSn05-XwygDObGX8yQhFI7Jtlicxb6iSRpEq1G8hVWDwCmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81Ii2eZUYOjEKR2OWpTIWbTpKOqYg4Fe13d0-AVCCAPA&oe=6A25750A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofQDzLPZR8AQ7kNvwGitys2&_nc_oc=AdqwZBjAz0Hv7qR_lleL0XXtT53R5SXc6KVn2uF9MFct9SxLnLcCiU1TjNPfKmmXv0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XnBUehPJrkvfFb4vCNlQTV9rbostSHAiqHegYuW8_lg&oe=6A259E37"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHNcTNoK3KIQ7kNvwFZjNa3&_nc_oc=AdqclPWnzV1Jrf7sPm5wUP3j_-HsniLY5UXlAqn6BamYOe0kYITlqwBhPJXfk60Y3nA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cxJRJN5YguRSIX0GsUpXWM7EfYR3D5Di3hm9rcfbCzQ&oe=6A259904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrP4OjEOln8Q7kNvwH_t9p5&_nc_oc=Ado4Qj6LJNpWUNUcZpeb7R0ayXd4YrvAEGoeLigcF4CGrsxyr65A7q-2Df1sFJ-pfxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6rSpYcBxT_vebrHy_PX_RFhNefYtiYyxdn0A6SARDIA&oe=6A258B98"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRHYqUXfxLQQ7kNvwG59vPd&_nc_oc=AdrLiBU6ZwyUD8XIf4BF2ZNku5enyqI9PGTYK47IgswdQyDa7hc3aSN7TntqwufYiZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NDPkFPcr6wniznUhlaqQD3qnZ0I7P-c
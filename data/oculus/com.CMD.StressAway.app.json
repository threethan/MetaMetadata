88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgTDRZ4q3UkQ7kNvwFhCqMg&_nc_oc=AdnWo3jCxWfYb9bVplXNm7t_HAQsWTz9wjuVKQ-TdcOvLOKA4qsfjUxgHivPjBqyj0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBQiU2EVdYBJg72quj97gKb5Len3IsygewA9En7cWUDA&oe=69AC2B0A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-kbS387jSUQ7kNvwEWvkiP&_nc_oc=AdmnXBNGObvKOUMa5ON6MYPLyGXorw58wlB-hqSKR0Psqu7dKiwZD_4KZ38csq2axMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRNzHqpidYrMA78eNBd5siNGKR1xXBHtlL49KB7KbodQ&oe=69AC1BF7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTpgpq4SricQ7kNvwHy46MU&_nc_oc=AdnEH9W_KneFhoj3TXscN_JHi43MmEpEdKr5GT4F6ovSir471Aie4G_izZy21ipTSn8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwjfmi6LPafRxr2TPONSa3PM1vpyJruy_Se87aJGbhKPg&oe=69AC16C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcwVTIjrwl4Q7kNvwFekZh6&_nc_oc=Adkd-YEy6wD-hsjHUk1KXaIBOBs7Bbf79E4Azd1k3YTQZ5qOrT5suTgyXp1akk5kcI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzw9HNMD5yResdcLecehc7BbCIg_yN1nkeNKEFAeKjFrw&oe=69AC0958"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75rpgnAMf0IQ7kNvwHHXsBt&_nc_oc=AdlKqC1X1e5EXvmC1feWPYPQgW3RH4JV_xKsyZFJOhsCKkLW3icFPAirPKk12trhnag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_gflTKeONm9MMBVM8jxUMo5kcxrnsz-hLEWrpLkqtvw&oe=69AC04D1"}, "is_concept": false, "is_tes
88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0o6qcYmGAMQ7kNvwFZ-t55&_nc_oc=AdmxEuCS__oICiegdfr5BOvt8vJtl8stAcXexnxYaxHyOwYlkT3scjudG-pPege84sU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK1w0b32iWNchjwO9qfC8wCbkVk8aqmFawCg2IBS8KLA&oe=69B5658A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CWMrX5He28Q7kNvwER1rA9&_nc_oc=AdkEDjC2FbEDEcByYQEu9UKKCMvtb9DrY3NOMNpjaqrcTthSCUzPQ2G1l-oPAi25-NM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6vngq-kNrIuEooE_r9iWNbwfL7UmflU_8Ve2TqicUaw&oe=69B55677"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik9KiJGkkrEQ7kNvwHfc6Zq&_nc_oc=AdmEuZndAlaI8XqkEZ_dzw13KeeZgRFFlittzsKbd972wgU1aH4V3I4qsaTjTZVIM_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUsFtfmIbSQMln6YNuAwu1_DJ9kiDV2N5igIAq0UCt5g&oe=69B55144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y37hr_cRqBgQ7kNvwFenOhZ&_nc_oc=AdlRui8Mu3Cmpso-XVZjaPtDw6Uytc7IlqA0p9jYMVIgY3X924hD97efpvKpbR8A9Wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqblqKN_mJcSfw3H3iU-6Fm-F403pDYzjKcocbvF-HJg&oe=69B543D8"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68tzUGhgEisQ7kNvwEIijuX&_nc_oc=Adk4XUoLu7qQXYBNQSnEtrW1E9o8waRlrOQHOjZNugYe4z2BCLJ__Uczlcykv_MUbeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfytjiryemnUkgk6D91ZnD3mfAgqaNljIogfmE275Z1BBg&oe=69B53F51"}, "is_concept": false, "is_tes
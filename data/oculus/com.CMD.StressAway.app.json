88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYPIuhLP8AoQ7kNvwGNty4h&_nc_oc=AdlFqLoc7HvwQxMRBFVpMmFNM1w2kiTcAHS7ouafnvHkf60aLC0-Dbk3cWZ5LP0FOsM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKW4GxPc1akzDKkeXflHVdj5XgjmCtoi1XRJCWmmQB0g&oe=69B8088A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ki0fWAT5psQ7kNvwEC3hf9&_nc_oc=AdmNCc0exwD4mb_5K4IUpkYpUs78Sr2BQX4jXFWC0jnxOUtWbZHqdFhMJ0h8JxtiwWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxF2zrlZIkeJ5o5VVE2bMvzCqLjR-zZ6G9-i_hoLLuFuw&oe=69B7F977"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgb0WVYTCycQ7kNvwHNwTIb&_nc_oc=AdnfJZz_Td8yTdKWOP7meIC9PvBPCJ2XR40UyzbxVaYFeCsSFZuhhTEz3w53J0B30Yg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6t7CwcxaarGD4PTVJRGygaHVs1VD2KZZcErfv6a2xAA&oe=69B7F444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im6WwvIzKzYQ7kNvwEmwseD&_nc_oc=AdlJ4qaqXwWL3XKTz_-IROBpk6BP08IPhbHBNerGLEGhsojMilWWWPDz-MMUEc1iC0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytiqT4FY2RZAZYRIvfx1vHbM-8Pxqrn1J9GhsOX0UiWw&oe=69B7E6D8"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxgkEIP9sycQ7kNvwE2_vO-&_nc_oc=AdkIloRpT3JKsti1uGqPcxrS9-Hr2m82sR_Da2U40ae09XGFlJPUkxqHJhuSgwEzNZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFRRVG1_Hk5desKRgrzw84_V9b5kNnVSyrCaW607ow7A&oe=69B7E251"}, "is_concept": false, "is_tes
n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP3NqkaI94IQ7kNvwFgYB4b&_nc_oc=AdrdhuE2lqWNBrHwlQN6bE551OkGvlp0ETY8XnZcrciOt3a-WccGBywt40BEINjtBMc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW-BpQBDWvkbiSxYbTBj7joOc__9xLffdztq6CR1HdOw&oe=6A660E8A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7IS6UFJo9kQ7kNvwGuBvVW&_nc_oc=AdrLX0DZSzCz1SLf5Bzj5wlA_pkLwmbPKysv4JUE9uivBwBD-OFRsMSg7Uu0ef2ngL8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEqhTOOiE2jNivaUzgEtvl7vqyizxvbbmZkoWl9fiQAw&oe=6A65FF77"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwLKn21vHa4Q7kNvwG7d-30&_nc_oc=Adofg4ZaZIlec9EObLp8V3bYXDCcIwCT9Q3wD6WpiiTiXrTSfKGq4C8LWnGT6uRhy18&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkpsB_ofJNfoHTFubQ5yA8_61AxwBSMFjb-OT8U265ow&oe=6A65FA44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWEnnoITT3oQ7kNvwGk5s4a&_nc_oc=AdrbWSxUC_ISrp08CRYngWMLZyyehAeVOXayX0jLKV700SnAq50wEvhaUUMEZCao9Ec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8czbdmu3bWzkW5jsAFLBoa3dsxmX5cY5ZK6gg9qYEWA&oe=6A662518"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtQ2bIKN_tgQ7kNvwHV7ldZ&_nc_oc=Adqglme9tJzMiEl46zDpx0JJr5RXIE1SAUqkDYeTRFubl6uIGxyaUj9uf0F3OIUlih4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzO4ibJ_PzyjuLOFME-frdHkF-9iTGO4
88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNkDOzWRdLcQ7kNvwGBIetn&_nc_oc=Admx662S8jZu1nO7ZmzlzdVrLDtnQwhFF9VlZJJhEmno-ndRnULjwKLhcWzOJBD9xow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvD6snaeAuhAc0V9fU3oaNB4ytckLqBcQasO4nX1I9qgA&oe=69A8368A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAXR5-K1OUIQ7kNvwHaHV4R&_nc_oc=Adk7sm6Lcw8I5U_0V6X1X9hKq-Rr52dtlSC4a0UB7EaDKJUm666LNAe17V1jmudSEnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvacv0ebjbF9NjsniaYZdRgi1wmcJuKYYQJ96fHao6IUQ&oe=69A82777"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ayvKbWdGwsQ7kNvwGKgj-N&_nc_oc=AdkCIcOmF4K8TOxT9G6pw54CA4RreU4hwf85BJ-00cOFMwg95siNpvWk01nd_BC08u4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftcQNHU4jrkGtc0wnwcBPAfFsyQy4S4rz5PFacV-CmKHg&oe=69A82244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN6bglejPWIQ7kNvwF8AEpY&_nc_oc=Admz69Jue8_VJ5vDiVoN_FaAnbI2-MHYsMbH5QhN4Zh5xjPXq1hiiLHhy4r9r87b3BU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv2UmxsSyjrBIr3kI9nSlK-3g5O7V_Rw7WP8zbubK7Z3A&oe=69A814D8"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRLFSw6T_7cQ7kNvwHTNqEu&_nc_oc=AdkLGTYUt69hbhOUJsyYmHJ8cG6xLkYW2HRg_M9tsqrCTZ8PbwP8Vxd9Pt8K2lC0DhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvlaqV_ARMF6ZVd78g8C-nuL6exFjZb5HtLrsbnwanBvw&oe=69A81051"}, "is_concept": false, "is_tes
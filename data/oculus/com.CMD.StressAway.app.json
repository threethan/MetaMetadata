n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmE4aglQINcQ7kNvwHnkchp&_nc_oc=AdqRnHG_nW8OQ6IFPsJrTVP4Sa_R-SPupcHdsIZuCtxrK8SU3VkViWVKL04efuCI7tA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gN7oyBFHrKZiThTc7usCHwIfPBS3KMg7440Y9XCm77g&oe=6A2ABB0A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDpDcM8HGeYQ7kNvwE3fORR&_nc_oc=AdrdNnJwCmahRbtXEYTKCcAbpIMN1rGxxCKIy-ZD3d8sOcXjqrkDsCcm1--LezcNEkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rRxgfs2T4dEnZb6t9OqccJJ9M6qDxwuZS25SxSeZV4w&oe=6A2AE437"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdRJoh4_kGEQ7kNvwEUhaMr&_nc_oc=Adp4_-nzWHU0epHAPKMgkhab_Hq7PlJ9v4j2lZPCwnU1PXt57oecNBmimSiLXL2yZQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iVbKDA_vGF4ylp0ZDeHGOAemBgZnNN6IYZgXWG6G9JQ&oe=6A2ADF04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_ueG2mhDSoQ7kNvwHhYEg5&_nc_oc=AdrUIrZPpy_377ck2bJm4ZgH478-c4pI15w3tRuHw6OeV8SOxxnGSpCf6WqBpaHGXXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CmLUYsjGs02PB6Ds1EzHN8kAlAnWOvsAaBb3JU7F24g&oe=6A2AD198"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysYlu95jnZ0Q7kNvwHTxPiH&_nc_oc=AdrG3STkVR0ZyHYsMDeCkSjk_kYAdp4ro9PcplmaH691vAmHgBcVsyiVqRwNguRJDgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8miC4zm7AmEIVTd3E_mRe-OGFR8Y6slj
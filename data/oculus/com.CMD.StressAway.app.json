88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNkDOzWRdLcQ7kNvwFiXnv0&_nc_oc=AdlV8ufmVAbBe5TDpcFe9ksgcFrqnXKZyYuhfEkzi3RmbXTHDJ0RTg3eFWNrvHHoyYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsiJSfTKAW4xNbMkcdGq1lur-jSrAQrylcPuwPRrP0pEw&oe=69A9880A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAXR5-K1OUIQ7kNvwHjcWDR&_nc_oc=Adm1-kfKhFs0G-OHD3ZaDpR3mwERYXavu_dWWQf8ix2uwqbuw_9dwy8aCg5rlnHel9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsEVuGzUyS7UDdIFJcgWjuBq50OtUls-XAhGQmJmCV5bw&oe=69A978F7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ayvKbWdGwsQ7kNvwF2Nt2d&_nc_oc=AdnuFMiPBMuBBMdlWDvVVN_MK37MNQirNfgZQCQEW1RCcyA5VjBCTpLtd1EKaqejyy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft95E9Uouy59eWEM6JfnndZ-LNruFbOfSgUMaPIa_ycwA&oe=69A973C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN6bglejPWIQ7kNvwHT-MoR&_nc_oc=Adm7Ln5j5o1hyPL5sWD4r5E3yg_Bghyc04psbkte9dlKuTLXmmOSD1Xco77VqwAQDBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5J6O5x9K1zH_g_EWfXXHVu9O96AH9zT58gcER6Wq8Nw&oe=69A96658"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRLFSw6T_7cQ7kNvwFpGUjP&_nc_oc=AdmCV0jmBOV6cE68_hfQH_bq7Ns2LxzQh3cQvVGG8rVaf6h3WoYWVZQ_njjsx0B_BgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvRsaKCThfo44cLMdfEqC75MUWhRzyvHneYJSCsqRxMCA&oe=69A961D1"}, "is_concept": false, "is_tes
uluscdn.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=350FW8bHVSYQ7kNvwEJMgNv&_nc_oc=AdqTLsVrqnsfapf3RdI-FjS1aRNAUcPUtoNOYEVmFTVXLnfvVQRMCMX0nu76LtTFTkI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NgQhzWV4v87Tp0UMLPRTkTCHcsPHsq0IYKuH1BUpGNw&oe=6A393B8A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZVwRSKKr-sQ7kNvwH8hC0U&_nc_oc=AdqjQlAT6dvd7xLGy3MUj75N7xnuln5m9RgX3TwZu_xWT7rtp6DjuMb0bRZysBY-ZZI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vbRXei2nJPU5PT6Sx3K8PH5L4BnO74FmRJsR0lS7fPQ&oe=6A392C77"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg57IU66yFUQ7kNvwH_eI_a&_nc_oc=AdrUHlMX5woevDAAKyTE3r4N35HByeJpICmdIpZtOPlvCDM3JtDVkNGBr5ouRscoNPc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SpCHLKYVLu5TIoKIYt06jiCggVoglukKeqXGP_c_lzQ&oe=6A395F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUHtK-fIKaMQ7kNvwFHg7sK&_nc_oc=AdqO4SVx9-b3GBz7sJPQZshKUNVrcyx-kdNuAKtVM1RM7XSm1wvS9WcQ5ZbJ7aQ85FU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tVzB5HEo-0FaibM0sMpduN4btmSEA7XUwGTEwjFgl6Q&oe=6A395218"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9RRWpBe0ewQ7kNvwFbNNdm&_nc_oc=AdoIRelKfZf5IRR8-rkz_TheEGUgbzhylT0Eql7s2vfFV88tC1jivtEx_WcCVKghSu4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K6fTNoF3e7NGpAyZE1Yr1
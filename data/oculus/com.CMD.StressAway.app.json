n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neViNskci2oQ7kNvwGQMan6&_nc_oc=AdrQlsH5z3zq78oS50ICFaTweQKx1Mk042T68GVCVB-B_2rvQ-AyVZprMBXlD9jCkOw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af397jRTjSegAy9OVk0fNWqASaI47O7Mnl9tPfymRNakDw&oe=69E62D0A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1BvNmIuqGQQ7kNvwHpAHfk&_nc_oc=AdoCvJ2dCKBjZRXyz9rCFtgblAmyP94j0sMH6G40jvgbf18uono_ALWUM590YrLXMCk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fAqyoWrYu6nEaajyT2qSBTRa1YDRlYpjz8Muvm-6aOQ&oe=69E61DF7"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cxlgV0upMAQ7kNvwFUN17O&_nc_oc=Adr7rezJ_CeD8VqaF5o_8IUzwfkOU_H96Zl8CVDFEvP16_LlELxLuIZ6AXrJgcABo2M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35QbGeuUnWreWNKePICM8bOazrPFadEeN2CP90vVfG3Q&oe=69E618C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAZ8pXeBMOkQ7kNvwFc_Uqe&_nc_oc=AdoIm_yc1CyqaEcrR1M9v85KpjKlDuX52kxLhpG_cKnOiXHxRxyKFzEIt9CkSVXH74M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af208eSVXYei8tNpYyIdeKCelkr09qPMhXWPlxQEU5njiw&oe=69E64398"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQfzWeMkB1MQ7kNvwHH5nLa&_nc_oc=AdpsmmVm8FB79RwfAcKbAjlt-3uIZA1td-f4fD0xreFRfksJvgpI3lPZfcHrkG_il3M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZoB2cOk6DUN58-IZiVOUanMLZbpGetN
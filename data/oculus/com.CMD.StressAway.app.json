88565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgOeS4N8nYMQ7kNvwHHiKy-&_nc_oc=AdljTxzd7Yy_lYYfPNK30e5L0V7f0MAS3BuYFeFdhKNRV0lzJao-_A95jueXYON6iig&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSqLv9MmKn18yMFVrlPoPs9krYGWCg5kQczjRTpdq5EA&oe=69B01F8A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocSaHiipeIEQ7kNvwHUTz60&_nc_oc=AdnJAVqlOQXVXUhfUnweOCUmmVMVgvc2x96_Xs4Avv-BozX9ZPb0AVuaPL1Pno_eHGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwM6MP3pTgxi-GXpGBqvthpfV7dtVxCJUwfyT96AXswUA&oe=69B01077"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_sD4nxujMIQ7kNvwE6LO19&_nc_oc=AdmO_VTXo2hjVa8ICxupWP_gy4xc2avYeQzdaWGLAZAkkyqtId_cfqGKkL84RH5Cv6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvDFUIeHWcf2OVdXo4VJxaHuYhKflFXqr3RqY-RIWRAw&oe=69B00B44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9SDxKi4Zd0Q7kNvwFe1H3O&_nc_oc=AdlrIEA-ogXNDGg4htIpG3z9o743dRKgLGCqDzyLbcg4brve0dyq9EOu5bRgzrsF_pA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5m2yxOxrpDYQNCc_tJLa17rg3mw6_kJ3lOsWnDkJIoA&oe=69AFFDD8"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZqSUT6JNZIQ7kNvwFVvOob&_nc_oc=AdkrF_W1ZwLM3xl_MRD4w551Qs9TBEa2EnfovAzGazOyxS0d4rnYlcLvKnQwcIwjun8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3iw4nNRD2N3hQKfIXPu2BSSOvUQGAtdXYXh7AtVePQw&oe=69AFF951"}, "is_concept": false, "is_tes
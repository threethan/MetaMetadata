n.com/v/t64.5771-25/75375084_508077188565094_534023000621153687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GERYqocQxC0Q7kNvwFEL0-T&_nc_oc=Adphh5YvHIYXJtT6uUhox7wNpiArbsiUDTt4OgM8LKfX8_YBABQ7KFkhTaE2Fm7Fquo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UgHLX0xZcVr377sSQZ9V8aHXUiaMV5Pq_-rtOWDw5Bw&oe=6A0C688A"}, {"file_name": "environment image.png", "id": "989442436295949", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572921_989442439629282_4128141107732756727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teVqf4OBBPkQ7kNvwEazW0Q&_nc_oc=Adr4sVly41wpeQKRo5V20YAMswMSwpzO8JWolqJBEF9bgY7Bylb8A2zggvneaNUhAX8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JrCdZjwKZUZ4MimyMhmzPFjLVdXI4Ga2mFqblO2QC2w&oe=6A0C5977"}, {"file_name": "audio image.png", "id": "880536184104644", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/228954782_880536187437977_8718583437464764526_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDg38FXR54AQ7kNvwGpzJ3s&_nc_oc=Adp1UH8QPzplh66G5kuI5lUu-YSWLxSFQbIA2wBT5wYStdj8dn5jyC2MUxb6q0ciVWo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af493Nxq_BZgk5RDoGI6jbO8eEpJXD3V4swA5XeIAHfUcA&oe=6A0C8C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Landscape 2560x1440.png", "id": "1007637527354535", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/228943078_1007637530687868_939697514511640557_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfRJaza4AQQQ7kNvwGVQr_R&_nc_oc=AdpENbel8qYGWz_hNDsof-i4-gqqAGmjldnjWFlzCGZrItDx-ApbV4OnxuG_Kur7ZxQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jM-qzgSWXIQxAxSro7tpmmViaszkBAFMzuJuI49JU7g&oe=6A0C7F18"}, "display_name": "StressAway", "keywords": [], "long_description": "\"Step into a tranquil world with StressAway, your virtual reality sanctuary designed to melt away stress and restore inner calm. Choose from a variety of breathtaking sceneries, from sun-kissed beaches to serene mountain vistas, each carefully crafted to transport you to a place of serenity. Whether you have 5, 10, or 20 minutes to spare, embark on a guided meditation journey led by soothing narration, complemented by gentle imagery and immersive sounds. Let go of tension, breathe deeply, and emerge refreshed and rejuvenated from every session. StressAway - where relaxation meets virtual reality.\"", "short_description": "\"StressAway: Your virtual oasis for relaxation. Immerse yourself in guided meditations, serene imagery, and soothing sounds to unwind and find inner peace anytime, anywhere. Escape stress and rejuvenate your mind with this immersive VR experience.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stressaway.app/legal", "developer_terms_of_service_url": null, "publisher_name": "StressAway, LLC", "support_website_url": null, "website_url": "https://www.stressaway.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278857041760462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974517_379778438148779_8051449419240208812_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IugjWoMnCL0Q7kNvwG2A6D0&_nc_oc=Adrnf9kTlyT-p8EPLjw0RuMbaRMjdfZdGfj3mAgH6poRAAuWd-v9Ra76qhPfhZrFuZQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WbJitzfkgGBwDaizPwKcbuz2_4KQbA8
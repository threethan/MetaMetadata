Bcp2bEQ7kNvwGaFzTl&_nc_oc=Adpk5IFDUIloGcXfCPGxCLgFbUiSkD-DwK83WyEo3huzmdKshybN5EV9Q0LPRZlliNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUTiHGcCXzMdOvV4E_zyEbOxKlAjA3IxjzJ-TbYHSbrA&oe=6B0466AA"}, {"file_name": "appscreenshot4.png", "id": "1428585471358402", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001678_1428585474691735_1305051783794883617_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPxDY6zDPG4Q7kNvwEsc4WL&_nc_oc=Adq-Sldvzweq6nzsJNInWHJVqPGMJPzmTtAUPn-1R61DoB-qgLfCKo41mMSfIY7L7LA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-O2QFgcWrehR17WPMw2BO0rLKIdP9-_ecxGRKkwWdkg&oe=6B04816B"}, {"file_name": "appscreenshot5.png", "id": "805072234853626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240105_805072238186959_3233277692936223411_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjvYRlT9DLkQ7kNvwEItNgU&_nc_oc=Adp0-oqHDcoWoBVwSpL-IPxlYPTJwLXQQDu6f2ne0THrs_9tpXrEJMo8GeoFw0nGpKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs8d_m91FpFFrfLUHmTJ673uBKKeqG0BZD4dyP7apSVQ&oe=6B048354"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Macaque's", "keywords": [], "long_description": "Experience the world of Scary Macaque's, where you can run, hide, and jump! Step into the world of a monkey species that we've created exclusively for this game. Embark on exciting adventures across a variety of maps, including the Forest, Shop and even a Horror Mode, which will be added later soon! Engage with other players through our multiplayer feature, fostering a sense of community as you explore Scary Macaque's together. If you prefer playing with a specific group, easily join a random server accessible from your cavern!\n\nExpress your unique style by customizing your appearance. Personalize your name tag, choose different colors, and enhance your character with cosmetic items available for purchase using our virtual currency called, \"Oranges\". Head over to the shop to browse a wide selection of cosmetics. When you've made your choice, buy it wisely so you don't lose your tokens, equip them conveniently from the same place!\n\nScary Macaque's is updated with fresh content, including new maps and cosmetics, ensuring there's always something exciting to discover. So why wait? Join the adventure and start playing today! More Updates Coming Soon!\n\nTell us in our discord if there is anybody violating our rules! https://discord.gg/9SQEt8JuGu", "short_description": "Experience the world of Scary Macaque's, where you can run, hide, and jump! Step into the world of a monkey species that we've created exclusively for this game. Embark on exciting adventures across a variety of maps, including the Forest, Shop and even a Horror Mode, which will be added later soon! Engage with other players through our multiplayer feature, fostering a sense of community as you explore Scary Macaque's together. Have fun the mysterious like horror game in Scary Macaque's!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scary-macaques/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "C0m3tVR", "support_website_url": null, "website_url": "https://sites.google.com/view/scary-macaques/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "73
ng?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9AvFZXMq4cQ7kNvwEMSy08&_nc_oc=AdpTBfwNTbJi4KP2GPm-UaA3iEE7xIUYT8PRoRsZm-yBM7QMCQ3HUWDlSBl4gGy4Na8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIcGGjrAPQbnaPJFuYHcWT-aJZQvQZr1wjG3K3DBmfRA&oe=6ABBD9B2"}, {"file_name": "Strayed2.png", "id": "297870826462518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422386_297870829795851_7736641547917921088_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVXTbLZ6_J0Q7kNvwGlRBYE&_nc_oc=AdofJnNfl1p7sWuVtaNsSVTwvrwkCBqxa1ENEpIuhGUjP8ITqhr7_4QBGw7YRXZEO_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS-jMJVeEZR8hHOIc0KiPl1QFF8L-u0ybNeyHz6WqciQ&oe=6ABBDCDF"}, {"file_name": "Strayed5.png", "id": "914326683637479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75314850_914326686970812_4002687700566610544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvVjoyn5QHwQ7kNvwEmvcrp&_nc_oc=Adpm8Em4ilM1DnFt_7kTR0iK4qKuI82_alEYTfcauHW9xyujxYaTYStXwZl37nU6pT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuuH3oL4kwVNvitpTRwFU6wQ0wGyu1ucmTBwpf_EyEzA&oe=6ABBDD2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "377980611238932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569473_377980614572265_981640232484657509_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcF6Da0WZ84Q7kNvwHnDUMP&_nc_oc=Adpo_tROp4eadAeC31xkmPvURb5ABr2-hzQ6KSA-gxRVVrtUoKu5nfeb_0GMs7MmKkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8KstEWfzwqJlAdoV7TzyBJYT3qsuz6QoJu7sVIMYUZg&oe=6ABBDD3C"}, "display_name": "Strayed", "keywords": [], "long_description": "Strayed is an open-world multiplayer VR survival game focused on player vs player interaction. Explore randomly generated islands, abandoned structures, and the vast wilderness to gather resources for survival. But be aware; There are dozens of other online players with the same goal.\n\nYou and dozens of other online players all share the same goal: survive by any means necessary.\n\nYou find yourself stranded on an island with no recollection of how you got there. With no means to escape, you must learn to adapt to your surroundings. With only a rock and a torch at your disposal, you must gather resources to craft tools to improve your chance of surviving. Crafting tools such as hatchets, pickaxes, or primitive weapons will aid you in taking on your surroundings, but be warned, you are not alone.\n\nBuild a place to call home for you and your loot.\n\nUpgrade your base with new materials you gather while in the wild (Wood, Stone, Metal). Start by placing your core foundation, from there you can expand with floors, walls, doorways and ceilings. Place deployables in your base such as storage boxes, furnaces, or beds to help you store your loot, set a spawn point, or make advancements with your materials.\n\nDon\u2019t get too familiar with your surroundings, as everything will regenerate weekly.\n\nProcedurally generated every Monday, no two islands are the same, meaning you will never play on the same map for longer than one week at a time.", "short_description": "Strayed is an open-world multiplayer VR survival game focused on player vs player interaction. Explore randomly generated islands, abandoned structures, and the vast wilderness to gather resources for survival. But be aware; There are dozens of other online players with the same goal."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.strayedvr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Crustacean Interactive LLC", "support_website_url": null, "website_url": "http://www.strayedvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
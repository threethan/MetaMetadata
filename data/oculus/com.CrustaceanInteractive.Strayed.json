iYNVQwQ7kNvwGVS1Bh&_nc_oc=AdqvUSE7k8GunCQX3ri9nlIE5Uhai9sn_zNyJ6zrhs2fArli5la3ymbhZEoUAfcxJOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrUzg3xpdEmGkoZLolo1duF1EQkxtazt04S5mYz-I8aw&oe=6ABBDA95"}, {"file_name": "GearedGroupOverMountain.png", "id": "28280545021588616", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303088_28280545028255282_7259741307297849587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YSBqYeH_94Q7kNvwHiAR4O&_nc_oc=AdpO_8LlsY--SLILTYJttUBhZA2fBavvrtaxczsZAowPqeiHxeAqtjlBw7BL1r69h1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7nmGH7ayrhUqeyFJwB6DrrDiomWLbovnX-SpUvM8aJw&oe=6ABBCCAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1596102041551235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819464_1596102044884568_2607266454817363830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kDlEUpDZJ8Q7kNvwFt5yrh&_nc_oc=AdpXtMA2QJtJeJ65MRT5a9-Jj5GjTEpGN4ki-ljBCMLtFN0WvWZw81N8e6k488PXR5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv30UBAcqco-3Lt0YVcsiCowOwen-0oG8kbGAjivYOQg&oe=6ABBE548"}, "display_name": "Strayed", "keywords": ["survival", "multiplayer", "pvp", "crafting", "basebuilding"], "long_description": "Strayed is a PvP-focused, open-world multiplayer VR survival game. Start with a rock and a torch, gather resources, and build a base to call your own. Go solo or team up with friends to fight other players, raid their bases, and defend your loot.\n\n{1963858617642738}\n\nWash up on the beach, craft your first tools, and find somewhere to build. Store your supplies and head out for better gear. Other players are after the same loot.\n\n{2421117155089519}\n\nExplore randomly generated islands with forests, deserts, tundra, and vast oceans. Search abandoned structures for supplies. Travel by ATV, boat, or helicopter.\n\n{2369165543616451}\n\nBuild a hideout or a stronghold for your team. Set traps, upgrade your workbench, and install electrical and irrigation systems. Stock up for your next raid and prepare to defend your base.\n\n{1625795362554394}\n\nMake friends and enemies through proximity voice chat. Most players shoot before talking, so watch your back. Who you trust is your call.\n\n# Key Features\n\n* Persistent worlds with scheduled server wipes\n* Guns, bows, melee weapons, and explosives\n* Craft weapons, tools, and armor\n* Base building and raiding\n* ATVs, boats, and helicopters\n* Animal hunting, fishing, and farming\n\n# Early Access\n\nStrayed is in Early Access and has come a long way, with much more content and better stability than at launch. We're continuing to add features, fix bugs, and refine systems as we work toward 1.0. Your feedback helps guide what comes next.\n", "short_description": "Strayed is a PvP-focused, open-world multiplayer VR survival game. Start with nothing, gather resources, craft weapons, and build a base. Go solo or team up to explore procedurally generated islands, raid other players, and defend your loot.\n"}]}, "developer_name": "Crustacean Interactive", "developer_privacy_policy_url": "https://strayedvr.com/privacy-policy/", "developer_terms_of_service_url": "https://strayedvr.com/terms-of-service/", "publisher_name": "Crustacean Interactive", "support_website_url": "https://strayedvr.com/contact/", "website_url": "http://www.strayedvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
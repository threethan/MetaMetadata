f20f&oh=00_AQRkpiWEt7MVdK3pRk7DzXywoG5k7CJvBfgI4XSTGZilNA&oe=6AFC8A8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAF6i6b5l7AQ7kNvwF-Bwkm&_nc_oc=AdqDqvs1uBgqxeX0_HnCvye58rqm4i-ktutYW06iWLDcHkki0KXz--1arRyDEBp6Y3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRpZAhC0l0Fkfw0dp2z-tJ5iEUI0hsCClZ1horAN7v6Q&oe=6AFC73BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7817449928379505"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391959_999718448725765_5015023777950136377_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ib47QV6GlkQ7kNvwEuJkic&_nc_oc=AdrehlvPb0ELmmeiSenMu8BALHUiNt5e_VPtlJVv5kaHOaSjqJx-pI9g4SoPhUnuLn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1G_BJhpHk1ohOPUZkL8k9nTObEBa629cdofJrtlCOsg&oe=6AFC76DD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aerodrums 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1740562800, "lastRevision": {"nodes": [{"id": "7791101414347690", "release_type": "SCHEDULED", "adm
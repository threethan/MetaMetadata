_nc_ohc=iQ9-x9cnYD8Q7kNvwHFHbaL&_nc_oc=AdqRMcFX_ceCKnZ8ilx3CcBw42Tzz5rFXRl1yNTMsVuhADau83Zg07YOliZj8uchEsA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOe8njNqnfInKFpKJ-swwXhC3wVjGEIhR7WbzQdqveGQ&oe=6AD0EC79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnsmZyVZpRwQ7kNvwFt0bCA&_nc_oc=AdpJ4pNXwhtYumPJZttcc6F_atpW15yQGelhFwdEXm9WhQmpY4nv2IjkZIv7ByhQQTg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqBjeq3_J3acxetN4TjkxmgS4smvfRYJNvlEpPP3RZNA&oe=6AD0FC13"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAeeXt-urxEQ7kNvwH-g8IR&_nc_oc=Ado2dWySAnmb5Pb9I_tKmGwXRR9hAmmfJq37EjlKFGplILSF1ONYqFJOTL7jsS3HP8E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQo84kbQEa4kfS-OuF0h6FmTqr4WzCp0ShB8MW7yZ8pQ&oe=6AD107BB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz2vFG-BGp0Q7kNvwGpx6pn&_nc_oc=AdrOyKCkdhB8SGGtxziJy-cDAoavbHI28zOTRylJZckgX0PP6JvV9Uif-047oWrx6JQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN63sG8Gm2E08Kp2fx4-JnIoqoNNOpzjrLnx3hheHnH4g&oe=6AD0D0CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XZyXMDKA1oQ7kNvwFCI6wR&_nc_oc=AdqdbPbdvYXr8UQVHXnzELReDv1G57waEv8EwfpjUAbO8pWTWF-ox7shgh0Vc66R_1o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlpjvEX875C_J-l-nyZJupmDHJkZsNurA1GdYJ_EN7ag&oe=6AD0F23E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
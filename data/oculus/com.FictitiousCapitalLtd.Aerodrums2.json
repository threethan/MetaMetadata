e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzRQzJnZUCcQ7kNvwGNHk-Q&_nc_oc=AdryQe_-hYdt3WPNVAWpsnckXrynycZ_MhUuvzXExpN28lZqLSfsEBuvjjqkmakMDcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j0QtQWAyWIcNn7xBxPO42d1tvdA_3VdjWonW2ee8RZw&oe=6A204379"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keygGi0GBGEQ7kNvwFOWTOE&_nc_oc=Ado8vKXdbb2kOqgOO7b1M97hotSi-6b4li68sQyE5yc8OfMXYPVwTC4FaeTTX7R3DMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tkgrBUT7HF7Ze6pLOYMk-u4bwYP0dUxesCX3I6jSlHA&oe=6A201AD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWaU16jiwpkQ7kNvwGeo28E&_nc_oc=AdpZwfwScbsjB1X30kn6pJQG0Q5vyNuIYVD7Hb8PY2yacAt3h1KS75DcBrkH2Vkjo_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J-6a9ELysudcBMg02ILuDO4-AAenSnqSFGW9UObhwlQ&oe=6A20267B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LW5m5jk9XzAQ7kNvwGaCJzs&_nc_oc=AdpKHNZ5L-MubG-yRzjfutkXTW5U9Wi6_W_XBNU33FbwOfWB1_IbhK3wgmmsOOLYFjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JWq-Ssj8zehDh-zMlVZ4wCrq4-pIE_fUARC8BJ98Ocw&oe=6A2027CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7_E0vogh-YQ7kNvwEbZtt1&_nc_oc=Adoe-A-Cnvg9hMyx9eKFXTp-RpfkatMzxr-J6pveH0dPBq-ggqQRv58NwgBuZiOwIDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wrmbkQGZEsUpmSClFKFcTL4vdLREu4UqvCuj7i4Nb1g&oe=6A20493E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
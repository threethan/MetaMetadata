_nc_ohc=Gmbab9a1UuEQ7kNvwHuWBUk&_nc_oc=Adq7BEBvRRU3By-Y6KFSmA5p2Z31FWdcm5lfLHAr6O6gJT0ROfr8dkFtEzZlvemmXEA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPZO6OL2cR5fOzDTKSIThC3PLSHU6gAr-_qu06qrQHIg&oe=6AEC9BF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyTR_YG2yZEQ7kNvwGzHODC&_nc_oc=AdpwvdqQQqkiSwrw-WCiDx84DxmB4Z3zXdJzYrZEVppXzGd_-WEYPj8yKG74bk3eg6M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF41XYiQdAOrvHWn3LKoGd1qnFeH5fmVPRJotu8Qc4rQ&oe=6AECAB93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtLbQ-rcWgIQ7kNvwGcslBD&_nc_oc=AdoCEcryc7Zab1u7p8woLSxbTsOXTP2MDtp_loYRK8Qs7D5DaYP2q3NoSsYCGolnDCA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR364GuiV4TsiBq3eMM9BmlGnAjIvckb2cC3raGQxe-IQ&oe=6AECB73B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rxKSE5enAUQ7kNvwGpUgDN&_nc_oc=AdqXJ5xaCQNfKJx2g0f75brhnGL64KOV6TEtdxOi7r6qgkpeNUaEsAena7FcbTOL41g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlyjmB9T-5fcD7qZPDwZraPPZ9qo5CAvRz6Hgu6xr31w&oe=6AECB88A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I11XATw7FA4Q7kNvwF2rbZV&_nc_oc=Adq1ShEVeyxcObuKzeEIZQwK0YAhRMMpY8pGol1LJZIRi1XOmvSPfb9D5NwbpQ8CyeI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG33A-vhlwuxIWcx9uAfY_Xs8RlCmuM-7du5V4_QnSUg&oe=6AECA1BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
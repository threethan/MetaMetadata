_nc_ohc=mZQ3U3LQGM0Q7kNvwHCsLpp&_nc_oc=Adprd3XxAz-DjoYAfHX9F0JcKukf-feyMAjjiUj60uyhS0hjliFHyEZKbScwR1DlYu0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EvqoJa7V8xDOWTP1iJlOD8KxxOWXTTJWeKkacTGeSbg&oe=6A0C7CF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7v63UckJgUQ7kNvwEXYrKR&_nc_oc=Adp57_XQq3jp_skFMi8WMGJuZrPDghw2ZRi4gEOGt6Sff1dIX0amos29PNRH6oPBh_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zQDrt4Sl3XCk3Kl0skr3uhwo6d-F6fUB_MTYZtQgWEA&oe=6A0C5453"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22ih-wqm-LQQ7kNvwEgMq1R&_nc_oc=AdrSl9qS8NYaRmcCQ4OQqwDOoYaC_TbWXw2frYdjYy-dqfDerqtLbOM9aYPnSFc2pCU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71ywkLRWu_1CF1BlW34WIUDeazAPdqtgy8yRZeyA8a-w&oe=6A0C5FFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCSqyUznPToQ7kNvwFaGz6G&_nc_oc=AdqzSy12BTwkLY8GvTFGdil2SDv3f1tfBRLkdh8J7hnq4-7EwDXR-8h7WNWByrdaBwc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gwdULL4BcasUA478gDDiTifk6dAVNtlQmUaeLwj3xlg&oe=6A0C614A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0MYYCQjjHwQ7kNvwGITGbY&_nc_oc=Adq-n8CFGjQfCZH8XMLkA8qeo01R1f3FlADh4YQYSlQhujqISVm8NBO_rsnDBvM7sjQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48si2xz5bCLpzER-6zD1_059n2xCxjQJS2HdZfnOEhhQ&oe=6A0C82BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
AIQRMvXFg8hOpW_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6lY3-r2164hnxWBLRyVfsGAsAhVAKZU9x5IHO6IP_iA&oe=69AFFBB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ENbcM1LbjcQ7kNvwHmubpR&_nc_oc=Admv0RmqxT3Cs-ZhFAZ4XQsI9LGEZ4vZzSEOs7bCpmqixTDX3PgSBlHEIOKhdk9aTZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDAJ1uEqZ-Kd2bbjrLrFe5lwdgqZogQGK4K7ciHUmROA&oe=69B00B53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcqzEvte8WQQ7kNvwF6fhqc&_nc_oc=AdkFPQZosyZxSJxDzzclFCIOT-oVy0KovB89qOTBBXMRrTORAw9EsJvERz7pDjB8-e4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyB-cGgWr3QxQWMn5laB3Vy1zCExlGDjhm7ZSBVSiKG6A&oe=69B016FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZqGLAIdcKUQ7kNvwHHu39h&_nc_oc=Adm3pWIC9mL2eHuN5HPTGBsPDkGcGQb17TCtglWiYwlIk91UpOpqin7vXf_uYqMpcjs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLtim4byAiiohLSF6X5qVs-I2EUtpOYlEDkXdPw9v4bg&oe=69B0184A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZxdyNbiCPwQ7kNvwG9ayEP&_nc_oc=AdlDUMxMUBBj1TW-fhPNwLn5yx-TByxRPX-C-E7EJG86yIqRxWpiZYHpQQWaskCK5z4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhtD5JDABfszMIDeGn552EoXY73Azt3jhOGiWveVrfDg&oe=69B0017E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488
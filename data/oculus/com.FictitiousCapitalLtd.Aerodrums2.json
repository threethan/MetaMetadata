e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdx2H5DQeccQ7kNvwFAzilt&_nc_oc=AdokCR8ugQkrOXmbKZxgksIO9oFpgvh3ZWephdrJJab--q1TUN29fhMOI1FCk2zoz_Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ERTMu-zLOXfqhKvX2SXs-A0bkG42CO9qBuI2NPhYV0A&oe=69F61379"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ0kqsqB9QwQ7kNvwFvrsFv&_nc_oc=AdplApzVv-4TEwMgjOuyso60tHT968WS1Ta_05St6gNjpOIuda30anuN2RRYGZ-2AA4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ROskXAJG6yVnViRj7oCatQtSBNmekmCnwIZnPTYOx1g&oe=69F5EAD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jM5TpQwpXcQ7kNvwE71fX_&_nc_oc=Ado4HOEW7yfAL-Gl8yoEpCpaE16m7m6eUQIkJw_qiTQ665PBdRrFfzpoWKBgo8Un1lo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2npBpnJECzOlfQx8r5vSD9R4fxKAFHjER8hR-XXVWslw&oe=69F5F67B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3xHjp6Ws_sQ7kNvwFMmaFb&_nc_oc=AdrhKUNMDzL_dH1I-4eA92ExQJak_pUNJH-9zZ-Jm0RDFF8sH73EYGYwsk__oqKes-0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rVj3ldgQGfL_zlKMJZxx2A1KvRMG1q-r0KBMXH3FZnA&oe=69F5F7CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5xV_mlsE4YQ7kNvwEoroiN&_nc_oc=AdoRL9i-OfsZeqbt5LXxOEsimG3u5EJqQ5dvF_3mlTo-Xz7acgBA_AoYHl7fEPP6vaY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dxHjMzQNOhjopge9cB129qNQKATmWWOFurx2N7NoXCg&oe=69F6193E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
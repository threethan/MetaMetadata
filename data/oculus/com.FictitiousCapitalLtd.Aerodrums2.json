_nc_ohc=WChxObyG7aQQ7kNvwGQjXYY&_nc_oc=AdoWe0vKOAc1P05ClWd1A3OeNu-e1dfTT5ddShimh3UBbQFeP4UgCi33lUV8ZCdh8P4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvPY-1sY161VwnpPpDQfkTgEPj0RThXXtB9FZ1RD8Lvw&oe=6AB68E79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7HLvu_Kg7MQ7kNvwEtOrYN&_nc_oc=Adoi3xcN8m1TT3bSZveNMVk1plbs362g-s62Q-o6_1Vn1YqFbYyWwzwGnc_9OWsxPmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkhnPae5iqCxoz0DlwvrerYBNqzzD36fORTtae6ZDeSA&oe=6AB69E13"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5Mcoqz6opUQ7kNvwHgqi8x&_nc_oc=Adr0WpzONDDFXGRrbr2zovDzT-L-3InfZ0N3UmkAk53wYtFZ4Ni-AXlJP1TgAVPCW2Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf-tMz-VqEAQCikKdHuu87CB3p6JPlgITg-TITOLa-Xg&oe=6AB6717B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW82DrSM9FcQ7kNvwH4l-N0&_nc_oc=Adq0OpIH29hRSC2B_X-l6mg-Cg69zGI4Mn6fUGwUQkDdKkRrP-KC9rCOsQb2d-H3-3k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVwhU8OY0m-SqMUYmMwL5YJbtlGHUkBhM_Oo7FNmTzEw&oe=6AB672CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uin4fqS9v2EQ7kNvwGafZJk&_nc_oc=AdpaUpLlkakHo1zeNam9Q1lLcSQnn6LXK6fzzi98gDVLcaZRhzaQpcxqEqx7yN228ng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFVY4BUdgje-SQNFXnACePL0Hc6RkS6UCO49yY2uVRnw&oe=6AB6943E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
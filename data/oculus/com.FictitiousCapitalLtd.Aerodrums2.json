_nc_ohc=V8ZaDaYos_sQ7kNvwGO7ivv&_nc_oc=AdpLNlagtW149xlYEQkim79nWDQPaj2TPj1RKYqecBr5tBsIVxmGC0VRMYgwEqr1ijM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ84iJ-gJ9y4V9-RHWECRlws5_vKz5WvhHQt9bb5FxI1g&oe=6AF1E1F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv-l6Jjx204Q7kNvwHaoaZT&_nc_oc=AdqUy_rpnSjZfnCRZ9yt1wQHxc8owCG3tgfKXoeR6mWRUm_zcvEMC7OjchLMYqlyx5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjOTiDQrDAcRE-Npl1neIcKdG0lodyai3nx_Fj17Vnwg&oe=6AF1F193"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEXVbPxZL8QQ7kNvwFGQ2Aj&_nc_oc=AdpECIl5liaQLFal10sPKhXALHdwejolIkktYO4DQ7gmb8QngFE6yiP8fgy9S8Bun4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmrHQEAwz8YHJJ07e1BinyVDzhbzWZGhcwnje4efxK5A&oe=6AF1FD3B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2bumBpMMiMQ7kNvwG6kdyF&_nc_oc=AdqBSXpXNqUg40wcCqfgDJh4SZLeNjbXhu-UKp-0MSGsauN_1pgPNBxw8a5hKz-3PBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-IXRsfsQ5JTfF5I6oV-LJHaDFxh2NH97qgodVGCStng&oe=6AF1FE8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYntubJKuW4Q7kNvwH8shCK&_nc_oc=AdqtC1zigxpXZ15m5nHVzeL0uXTwdMqyBuax1oeYdubKxf3ouJk5l0JLc2xrNiONxOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1QfKXeUWFv3llN6nP_jR4AHlP6gq1j2nkmT1mb2if8g&oe=6AF1E7BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
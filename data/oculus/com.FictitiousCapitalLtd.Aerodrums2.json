e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSi-4-hNN8MQ7kNvwGOucyH&_nc_oc=AdpqDPauYRLh54N8qa-VeMAGcYOGg0vxQrUB9UWSkn2bzyXc9lHtvhbLImXfzuw3AwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYkJDMVnW-EnvKGySYP-Ay_vSYNtdSCU73QiTcPLxmLQ&oe=6ABD25F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd7_TvVK7OsQ7kNvwGAkU3W&_nc_oc=AdpohHixbh393TRYrfmelB_k0yDw-DYY98TkSqoY3c-u6ngIpB4-ktoK6tjxZQXelro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLewCXDAps5fzgNRlzAQFWoZl8JfIRyoJQ5z2L_f3b0EQ&oe=6ABD3593"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puCnfvnZLLwQ7kNvwHZJLUe&_nc_oc=Adp2nnZiE000XbTSh6DHUKxSeGi8JWXRXhXyCCC3M1gEZ2AyTO0I-K6Fw9aViWGU6ck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_JCoIVfWz8OQQEzt6RREY3-ccJYYZIi8b98SZHPqAqQ&oe=6ABD08FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SUqtqxzKUYQ7kNvwHy80Bu&_nc_oc=AdqHYjSYANEh6cgNWTnAyr_yGnZMReVmT4PnzY8ZHvIFKOA3T3KsSse6W_Y1KWwKg-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlVW19w6xZEILbrKVnAW7xyx3bb6mFfhFUM5GIzdRKuA&oe=6ABD0A4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQvmuMOw8SAQ7kNvwGsASQZ&_nc_oc=AdplHDxTd5tDDhCyDp2OmAcVuRy9nmeCzNHCm8MllCyrCcrqJo3oEBykh0fVI3go9ps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdjYTvKiRr9I2lX4mGiJWu0pTAnLUTMTfC0IITgb7Lyw&oe=6ABD2BBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
_nc_ohc=Ceo8JXPNyjAQ7kNvwERCqS5&_nc_oc=AdrPSQMXCVPEHKsHqypWp2sJozQ-L0lnd7EPy0tnBAqUKBgntZRXwDcAZkW6REYBZfY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwP6FSLTUx3dKzRv-Go9RxLgDglZj_u0_qIkVlGwc9MuA&oe=69CBAB39"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1sTu2vU9nAQ7kNvwEeSG98&_nc_oc=AdqORQo3uF0UbomJ6vaxVcFIkc3-QnJOIPIi8cS7ZXp1nF9F5unzyMW-VcIf2Wy8GgQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3aUd0METP3sjOUQqhZ09e2Kh7nqV67OKyuMu0IAGYBg&oe=69CBBAD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNg0boUJtUgQ7kNvwG0u7zK&_nc_oc=AdpMSSqYeYZHT-3iE8XrBPBLDsZtcDEB_6WFk85GMXxUsSJLf82Lob5-tl76kKWTzuM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyf_0A-sDWhfpveiOkwhqC2q395KnMq7WAh0JoN7za_Gw&oe=69CBC67B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-OvaHsUvJgQ7kNvwGaDqGb&_nc_oc=AdpmscrECR59o4rQu4c6WyCMfJyI3QUSRC7bQoTBJaSyZ3h7dBB0Ampp5dd0ZKnqazo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZKiNLiFqYVeOr-BqGIW5dpe7z5X4QrOMyrpNavEHc9A&oe=69CBC7CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8YiVpdVMUkQ7kNvwGro-Mi&_nc_oc=Adqtr4ddO99VijhPcXxlluwkvUAkRb5aLDPlgE0JQTSs2L2MLNO_KWjj0t--rxaDtQ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO6AsLFcbu1_jdRgkw0zOMsaksXbUOVHg3EHu_fDonCw&oe=69CBB0FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tWGK6DgPXsQ7kNvwEOcagK&_nc_oc=AdoR7WOISgsGpReN-Qz8pEofl4j6jFBcpNuxa4cDqsEizUSqbRfcsQ9XCB3Qe89a8UA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IcsiV_MbLfi93TVSEsYT6oYqOkWqmusVw1ZkHio43gQ&oe=69E4B7B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbxeK6UqF7AQ7kNvwHZ8CG3&_nc_oc=AdoGqxKBwheJXPkXC53XQy0ZYEfPHieqOfoRKuGVgIti2dNhNKl2qc2LibVigh7m1-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-QiUN3VyD6nUW59FZtLsS7zsCcVNFaGT8zibeqAXdFQ&oe=69E4C753"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8vKGiUdnfwQ7kNvwFIpyP3&_nc_oc=AdpUChbDEPUdaPzpkBUIH1VH_bfoVtg6HaX97O8nSdIyhXN-TzV51mxp9CGh-TVbnGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VP8OHk0LMWNEnuJZS_3Y_iWhedxlBM9pgxMkEaC2EGQ&oe=69E4D2FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS8x_9ctetYQ7kNvwGo9NCP&_nc_oc=AdrO6riUbaUOso4-kDQxaK91I3MFKuZ_lUZ5S7DOQICLMGX-7a1n2vgbrDx9kRfb2rg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15z64ZCQtQ3gOY33v1Ig3PgBHKLuCS5ImiyaJjfT1Vvw&oe=69E4D44A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A881a4RIuNkQ7kNvwFeINzl&_nc_oc=AdplYJUXUNwJxc9ARV877K_aVf2zAEaC6awUjCFkk7OqdJzk6Mdjy6B_mFNwoKlVuHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LB_3hiX1Ha31rrwvS7XWQsGrBSns5nz1-VPtHuoR6Aw&oe=69E4BD7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
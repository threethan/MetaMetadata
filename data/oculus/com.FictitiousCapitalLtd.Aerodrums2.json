_nc_ohc=u8AU5O_16RMQ7kNvwFjbGOV&_nc_oc=AdopB6sYOlm7lc8WyII6qX66dNFBT--pCIOpxiWDkFv7Fsx_4RdooiHqmvUzY4p52LY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ozzpcKAzK46EjncSDSWFBYDC3vtwrbNeEY2XlA2jcKA&oe=6A3FE779"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZBL7b9mYwEQ7kNvwE3qU8m&_nc_oc=AdrHMmWXtKMTEIqA9YzIAOzlgRjAHZ3rDbe9UoHSzFaIMwpunbjc2NMjB2p4yEgl4ps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lLUT3dgN68_GjQ2nyLCxIX1cCWRyFK_1r8vDfij955Q&oe=6A3FBED3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9kxjmihI8oQ7kNvwHXIBOO&_nc_oc=AdqNb0MUrBpHNnix-KE5_SK7X0DKZPUltjgvjbJT4SHbzHHH_CAiIXTrU6_zUXyjlxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ivgssR-1Pm-0pHeEwEe-GxcHwFj3ntH6gqBI6yMz1WA&oe=6A3FCA7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqWAGCHEBN0Q7kNvwHMwBAC&_nc_oc=AdprjGktpqCGA-goU3b7bnD8QoAIjE8muF-jGhaqPX3__deNB5xXoKhIT0tN0RNsvhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VXXt9GO4-hO8IKW7t0EpGJUE0lN8ig2HpcFsKnTZzEw&oe=6A3FCBCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQOkzFCjoakQ7kNvwHsCKMr&_nc_oc=AdoxXydMLjNG57RY_AxzuepbabbzfMYCdKkaYrjf1rlTwA1SKo4lBAX9Aq_54q2dplc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MImpGTxFDJR0_Sq8ZakqkvgJbOOMBwukpv8tVDWpbSA&oe=6A3FED3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7_pR_KeKykQ7kNvwF1cGHI&_nc_oc=AdpCW5yoOTO05MqWZXNRjwmjaaXkrC9rwbk54LOmHCiBDOXTFeQB7lPCOH8XdLem5qA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4IQJ6USAVr65jKxtEg46un9ycPKYD8SdADhCp14pSbQ&oe=6A898339"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YERNmGJyQy4Q7kNvwGG-MWh&_nc_oc=Adom47ELV-am0XA9_q564pblThKFHDdK6Cvey1l5Yv-1ymSRhBya9G7Roqe5uQBskNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEguUxLdk-S9Jq_TBBTH5tUAixQFW5k8T00ysXQIIwnsw&oe=6A8992D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD-16W_QlE8Q7kNvwEkRaTB&_nc_oc=AdpsmkMWxBT1WmBKyKKRF-g55w7n_YQ9NkkuIMup8aQwojcFOgQudXyS84q2HKT3ZM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4b3e6am99OTpUhkzsdg59gTDLkLjmQY0eEsmR9Y1u3A&oe=6A899E7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GorjGQX0BaUQ7kNvwEmppP7&_nc_oc=AdrNT1n5t9cmKbWfSCzoOcABhnPgSGGmbVj7YHvb2OyEhHG--TfqP63q_1KX9hBPu38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlQSWVc6oGC3emGkvOHZyE7D3s5_ZTkut8yJ8wcEL5dg&oe=6A899FCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nx33CJVg4MQ7kNvwGcdidi&_nc_oc=Adqxmn6ARglk2uWQ7pn8DRlSbfyTgG2JMb0yNPNW3vSP2rxKV0HkySnNuk7qIL8NXf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTvhjgMBO4kCX9K8P7yKS405B6OqQ5YV30StkyqUfy3A&oe=6A8988FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
_nc_ohc=zABEzi--ZsMQ7kNvwFXOzkH&_nc_oc=AdoWPytQyAve_6UDLtlSpDzDPOysqcDK41gKL46ShMrZzGPbALnlIFpQ4CMLLFwcRz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ByMSjEn4U9PVAjtRaYwlBASqnNnjzbMlyutdUTxAMhA&oe=6A088879"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ-LR37254kQ7kNvwEU1djf&_nc_oc=Adpsp14zWskf_V6wblXw6SBy1KEnB4-jUPqGQOdU2Zya0Qk4OabSzd4o_ghMhfo72Ms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XYeuRXwCLOhej6uC5ekYAt5sfWNe4N8SZOsy5AA06eQ&oe=6A085FD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHmkHixgmFUQ7kNvwGJyt0J&_nc_oc=AdrefS5PuXu56w74WMPEq8tXG-DszHKJS9zYM4IaNwktCZdNTQ3t8DYzTI5_xgwaCUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fcXlIjEX7xEzXntrXOIEvJsrJoSC3eGjZuLdeENi0_A&oe=6A086B7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLcLNvhJCS8Q7kNvwELaDF_&_nc_oc=AdpqANe_7r0MtJYBKP27Wrc4sdCYfq1XK3fBHavCVUMZiZHJ-f2eKLfkHd1jNpbhEeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af516hgCtfGwaik0PyuHd0q3UFChE0cglmTs8a0Y75cwaw&oe=6A086CCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0joaG-f-Q_gQ7kNvwGTHYHG&_nc_oc=AdoWBA5THtxdTPNyV_LTXhBcKjR8nZjjVeUgtNnj6SsRqQI9XwkrXudd76mXl7OATNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d3lzpWMFFb0UZ37v5xosPGbRaXMafl8RPB4HKGyipsQ&oe=6A088E3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
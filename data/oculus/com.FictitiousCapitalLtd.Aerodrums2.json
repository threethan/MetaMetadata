_nc_ohc=ocjMLr53MzIQ7kNvwEjeVcl&_nc_oc=AdpKeQuuVWinaeQU7cb9u7B6PTCwAEl3aVcDQR3mnxgR9rDjySePCFqYXP_MaR9JjkU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PMVa2uCtp1pFjefoNYVg4H0P-QXN7lk1jYaJ4PPa1LA&oe=6A301579"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrKmYX-QlrgQ7kNvwF8LLU9&_nc_oc=AdqDjBl3HkUrHbj4-RNMNnK5vmLWZtmtcbPZt994ZuVwRE7R-O_FrxbOiDI7EO9hdCk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5H4Ycc57Hw4jUWjQreN_O7O09iaDAlvJldScxHb9RMg&oe=6A302513"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za13ERDJy7wQ7kNvwEUY2jP&_nc_oc=AdpkKa0FaFZ3yrpyKThYOaXvVET9iIsNnpOUvIBxmJ2jlyMCv0jwgCNCtXVIoyV2c6U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b7ox3Dh9wDbRq1qcVN69PbFKgYXL4bqd7TQoGk88rVA&oe=6A2FF87B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfJU4G3Wsn4Q7kNvwHY4ZNV&_nc_oc=Ado__OLzZW0zJax5FBtfIpiS0h3dxuMGoKEqXILCLYte0xDI2rQfzZtjtqnrI-w0hUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fpSeAyziSNR3j4E6BLaucCftOBYdrJUShQkJXguup-g&oe=6A2FF9CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYQO6GmcHnkQ7kNvwHHI_CE&_nc_oc=AdqhPfaGP0I4gh6KB26CA227DiSe1uEwQ4l4vgDDY54epj41z8k7Km2P8cfIFpbU41A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yrpdntheUFeCKPdmy2v32uLAaMRL8Z7A2-MsEPNLCdw&oe=6A301B3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
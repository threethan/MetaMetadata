_nc_ohc=6DRmImW-ZPwQ7kNvwFYWhQt&_nc_oc=Ados4b3w0vlzTgCPe40D9nIi7_PIqBSF4y-KLVk6aU_GgdlAwXIKj10NqY5MKSC504k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-eC7pqK2k27SuJFN6VGYklDH-FIc7hxcCdDbqDM4IbQ&oe=6A258979"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWO7CXr-JNQQ7kNvwGlWHKT&_nc_oc=AdqCBzHKBjHNxSmUwE_WRAtniDXiTfzRonVR6w0_mTJWKZatLl83aKxYoQnvEFMJRf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GWS0ZJKZ7IoE6dCj4cMzX_FW8c0LBFCOTUAEDo-mGfA&oe=6A259913"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJQgtRU1bOQQ7kNvwFqGeC5&_nc_oc=Adq38JnLC5Ni5-O2r8ZoBu6k_VPFt061XrU__fIRThgode9vf4BL1951gkFNKbzNGGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OCJ7TD_bDyBl7x0DDXy9sTrPMhe23c7KJ0imLOgwx_Q&oe=6A25A4BB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV9UT2_SsMAQ7kNvwEWyhIK&_nc_oc=Adq4f5O5isJZ6F-BGvBMYL9Vpefnwmzma5ehBzqQoFnjgyOi7YjDOReQfwUXph-wmjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vwkGGErrQq88yPA252ZWUPtodEDAUAY9TwnMsMH9Srw&oe=6A256DCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WemGcXr5BVgQ7kNvwHe0Cm_&_nc_oc=AdooyOx3__i-vMpba8vOjqTxnY3MLw2xmXjHG8ur2kYmOJaIpLpQiq-yxbVx05ndzOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86oWmCHdW2GZBAuZr-R5ZIAsjDoGWt46Mqzu0iEmrQ0A&oe=6A258F3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
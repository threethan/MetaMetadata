e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCkobVBtQ0wQ7kNvwHj6l9z&_nc_oc=AdrKupjVv_ixGKBKe2ta2UnF7RSp5ZXi_67T6Urtv995F6UB9QuFMtaTBtkSmNTj428&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1kV1B5GrgzARGwNGmF9O4RbboCvVGlnBsVcPEbSMyYg&oe=6A5CB039"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6OkUMMrvHwQ7kNvwF9I4Wm&_nc_oc=Adq2TOto554vIdvLucwOv8fG-ANrA60ZF8zyQ1uFB8gAnLKR3t7pkg48sqKyy2oTCas&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB-8l4ZcerOGrFqMhrbx12pfwprUnxMu21I7ITn4fgng&oe=6A5CBFD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa3QrXtNC2IQ7kNvwGJ7v07&_nc_oc=AdqpGerieIEGp8YiYbaKsTkotGWAvTzB4vqrWzTTmAq3GFw4cs49r3dUXrdgWEOxdBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyt67D7m3Qgi4wT9iN7KPMLpfBjaqrq5AhNWIS5nlYfQ&oe=6A5CCB7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPDYzklrCAgQ7kNvwGyys0R&_nc_oc=AdofWHar5qLd3c7Ns6JCSVrviymDnBavXYdgK3ddkchJk6ZMx46fXdjnsARJZd-cmuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs7aYj9PtlrjacaUKQN-HS4aJ9AnTtztNeXzJJwdTbVg&oe=6A5CCCCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SCEt_XaC80Q7kNvwG--Ewi&_nc_oc=Adr92bvxHWb9y8DdpeDv_2WOnefu0BoPh_ZnAvaPtDFiz9FSBRgLp9ihWKfA3P3JuJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyfEDkOOTwB1XaPggyfLRioexoKJTIzf3CxMj9g8rFKA&oe=6A5CB5FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
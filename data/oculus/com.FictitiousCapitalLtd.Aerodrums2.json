e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sojdkhISv-4Q7kNvwGIoXsB&_nc_oc=AdodqrYKCs-8lgQSUcKRdJTRtov-i7U6uK-Hp51qYF49pMYtH9K5sYQC3YMFNU5cXF0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp5Bn8TkJhcAQnqUYx6epHX6CWX6qjguFfZ8BcC4xmcw&oe=6AA17679"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5HTWcgIEbMQ7kNvwHhsQ5F&_nc_oc=AdoqEVf4aoqi0LzBW1rAhrVEma03hL8OZD2xBpQQ7Zh8GFJwovcC0KxfcEWvVpr8LLY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUHe396AtV3fODHg_joTIb0BhBe1KNAdfbLKMkHqlPTQ&oe=6AA14DD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5jxFdkqql4Q7kNvwG79TZk&_nc_oc=AdoRyTYZqwtsHs1sMFuLm5CU6dcpZueiruKBe6fiFpGq52opEDFctZ8tSno0LIkGZzs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVsqGpCoebhs9EgCgLzKAnjJbyjRdM00jwFUx4sPK9OA&oe=6AA1597B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d82ZCisR0YcQ7kNvwHADjlc&_nc_oc=Adoj1oXO3XUGRXaGViII1_ZRsdv-SY3OQLUpfJYF3ofVNilLqovtpK6NYAwPCoecGfM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbmJcz8LEwkTsbHN2cXJuIHlT-nk-re4xLD5ZqeqWQng&oe=6AA15ACA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hduDb2TjKigQ7kNvwHb3Xdi&_nc_oc=AdqQdeR_yUnBko9rX-7Ji74Ix6aKXIp7h42CHXHjK8wBA_HisiLWfygj5HYar1SMbKI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC7bgT5O6CX3jlgvPtiVDS9iQUb0_pdEzQ55lOn4bv6Q&oe=6AA17C3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
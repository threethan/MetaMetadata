_nc_ohc=MNLBy5_oc9sQ7kNvwGp3fI2&_nc_oc=AdoDvNRbvBWUuVISXOkmvCvSNQ5Pb_ltjaHPR-1d5JoKb8Mt8v-PCtPwV4Bxy0XC5w0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWvv9FpdFJgDk4VALolYhUJ2IqWvhIDZTaE6j0FDJhaw&oe=69C513B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYOdw6DNOcEQ7kNvwHWEryw&_nc_oc=Ado2nKQ44RLykLXCNbevH3rKZQPc4k_2OEQ7E1J7DA3pvNqtNaXf1pNdQhJpyxzCinM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzv3GLt7uQdYVC4-2G9hmzPjEj8COYO3r2AWPNg5jI5hw&oe=69C52353"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMCE5bgtPFAQ7kNvwHBWtI6&_nc_oc=AdrFJEpN17NuOzOFfLF0pDq8ssiulxjhb8IDozqY_SsqGyKuFc0uUkHo617JgXS-xEo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMJXtPvVFevLiFmm_w1lnC4NvsHxef-rSUu5GfEP4fJA&oe=69C52EFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yos9gCRsc4IQ7kNvwG268K5&_nc_oc=Adq-8X8Pw7y5OGtWDAz1iikCum5QhDfVNeDWwHc53Xni1X5-Q2kIbOlQqAKRGfai_oA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_MCQhXn_kasER-P12k6RRkZNn1obc6kDC0lhzasncYA&oe=69C5304A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsJBrWz-8MoQ7kNvwFdLFtR&_nc_oc=AdosvhvV_s55vRF5El1cp_kSluJ0vBHwKi79pTF0TtqgqfJ86bWjS-5bQy2ULZ5kvGU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzDBSntxBrAWFg8lT4DvJWoMqUtpZGPVV0F8-cU6HAjg&oe=69C5197E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
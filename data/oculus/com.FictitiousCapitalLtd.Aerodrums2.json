_nc_ohc=YwLT3U78vVEQ7kNvwEe6Ah2&_nc_oc=AdoQnhVr1LJTrFW_mIQLqSJV3JemyLvjGY0E6y0yi8M6uiDSc8qVBYA4TqoAA33amy8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_vBPqnW2mLX4lskGUXmi_lnqzTLPT3j-zzxMhcHgmhQ&oe=6A819A39"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihjAQllLs4kQ7kNvwFg8GG5&_nc_oc=Adrtx2ang4GLU5DIHKCXzz8aOYumca4HdsaOu_qJG7QUfsnnjAJJjM1F7PaHtNDwbYI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPxRlzCPU4goZhZpY3VTgDm-fvryG8Z2enELef78KErg&oe=6A81A9D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inHgZVzbqJkQ7kNvwEf5_ms&_nc_oc=Adq7L62r_GtIDWOEVJnWvayG9Kt7SyQHxM175tJDPX1_D_mfcWFCYkTyG2Z_1_5855I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzh-P6IbLqTIUlKERRDMm5UFvrLpqHvhFGg9BNHVH1Eg&oe=6A81B57B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_P7A4RpkWMQ7kNvwFYrS0J&_nc_oc=Adpygd-cexE54Y2m6jYTpYGjogdVTRB9wpJix-qDBEWuaditr6GrzZAgimpuldwP_iE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEug2Clp3A_o5hQ50JgYh1L8uyBtU06-0S_MEcSlqJXmQ&oe=6A81B6CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT15q69de7sQ7kNvwG5uZjO&_nc_oc=AdoObBirfQr-TyeMbWVIY33sCpFATrmFDv9c5Tq9h5uLDIuEDEqW_TSdj-6fyFNLu6E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi06T51jewgd0XkdTUgxrKT1PPDtCLcKXpNukFTRXo4g&oe=6A819FFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
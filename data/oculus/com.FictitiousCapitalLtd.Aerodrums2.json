_nc_ohc=HAcys8N34VEQ7kNvwFuW03c&_nc_oc=AdrSvAMDYKVoeH5cY6IqUNg9ZkLH6eJGmG0TfWJTqPS4RCqGhw9BtWBl92XXYLnd0aY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK_w8_k19QIhkG5uu4syU2aFDUIpCN1YWAfhBekOAYZw&oe=6A637FF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft7oN54e3A0Q7kNvwElASFG&_nc_oc=AdqOoITOExMalEkncyq3poyM5YYmOuJ2zCnMreNZwzAB_5qHeWN_t8UHiArItfC2z2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzjZr6M0aIivff9k9IIMur0PAFG_8w1P86MHm81lFVfg&oe=6A635753"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiLok3_hLfIQ7kNvwHkMHPQ&_nc_oc=AdrZUtx4jbpdhHqQ7nnteX9U0Hoel9QPpo9NJkFXv_B_VRplbmqgpcBVYK6-eaTI5rE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFeEI5kX54Mh3jgPT2OtbV01XTbkGoOcqAHOx1u0UXSg&oe=6A6362FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkdjFxbcIeEQ7kNvwF7vANx&_nc_oc=AdquP0ev0MpIswV8K4RywUURTYRgs2pX48Q_tS56sAa2PA9ec_spMvatTPEZ8w_aJ5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmkccUR2clfIGILNyx74QOTIt0Wfk8CcFv94RNPvcZ4A&oe=6A63644A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QZ2BbjS6K4Q7kNvwFUTuVe&_nc_oc=Adq0_JKUNKhkWprITZIbWw_whxrUVkQeZAyCaCvAp6A4ZJBFF2GWs1n9lcv_4_TaiNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs-0nQeEyzYoTt4bJF8kjtbOSeRC5UZtJFZ6qfy1RsJw&oe=6A6385BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_nc_ohc=zABEzi--ZsMQ7kNvwFuPRJ2&_nc_oc=AdpUUX9Mjyuh13QhWX6txp-9ixBfJAkAzEC0CI6zzA_MQTRxvf5CjBWFcfZi7ei9q74&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HwHD8-NWzvm3M_6w4mVbYNplTkypKAMdH9nBqGLeNNQ&oe=6A09D9F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ-LR37254kQ7kNvwFbax1y&_nc_oc=Adq1veygBrPsHAr3r3L0ZQZCW_gCmN_bPuuUHgnQnVe7TOLjRMZvWsZb22tWTBfG914&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kcXrV50xSJQ6aR-FyntuJ6_yVFeNoWzL1ZSvXAuuj7g&oe=6A09B153"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22ih-wqm-LQQ7kNvwHbqsk0&_nc_oc=AdqEJx5qMMaDZlBtWxmnERJagWP3CTaNik7SIUL0u8YV-_TaF4qgGgED0hNRIGv6BAM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n5Wyr3cTmekFrk8e_RjIrVGx00mMWhHLWNrF5y2-MAA&oe=6A09BCFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCSqyUznPToQ7kNvwH1PMKf&_nc_oc=AdrTKUmkCS6XRIPiFG4xFserhATT25XQYqsZeJvfVZJJLqeYB5xGJ6EEyVa95Lp30WI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jo9j8sEKlUihLA48xCDTvydbkJgdNpBcIDJRNBT9_AQ&oe=6A09BE4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0MYYCQjjHwQ7kNvwFzdtNw&_nc_oc=AdonSKsEFD-T8SyTZeYPvyDHwlBFJuO1olJhj4dPFD5sBuB_2slP1Jrj8QG3wSRizO8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PV3xpGhD3aD6rVjnGOJuNZleOEG2HRV2KEearJuvM3A&oe=6A09DFBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
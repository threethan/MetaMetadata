KVdH3Fg2sd8gczIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxsaHegV9Jev8P_us2cVNtdI2FQSCh2bMfXT4ZqA7foGw&oe=69B7E4B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZxmxJdq_OAQ7kNvwHyp-E4&_nc_oc=AdnmSfimDWIeYoJRurbwa8mi8_IvvH339PWS-AtI1Ky4kHZ2GFQs4YAeWeee6P8t38c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxy8Hw2CGaEx_fVbVRv3PKBhMANxD2NZcQBdBT6xcig8g&oe=69B7F453"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmExEAAHkewQ7kNvwEzA7h6&_nc_oc=Adm53RygXMEF9bbUeRjxQwBLnkOzdOtiZj0bQ4GHisxk9E7uAWS1301BuRvb5DsMg4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyAgyF_4nPJEEpkHocZXn4wCLOPOOHQjS7BpUufOv7Blw&oe=69B7FFFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3G2VoAM3jAQ7kNvwF4omay&_nc_oc=Adnm0xSvIJCeAGLOD2ySQyXe_FHjn8VZu9eLUHTUCWKegeSZWxIJ_Xw5F4qywvKAj0E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyxC6nQ8_nLqDjESSpzu0Mwn6omOI33PM3lK_MbIub-Q&oe=69B8014A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-lnIoh9T1QQ7kNvwHDTU6i&_nc_oc=Adn1-Z56jcECIkfSFTE4GuNy7s3FnmEi479GlQSnBlXQw1GS6ANTo5qmEH9ewSyGtp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw25qxI_ZFeGFak9xEIrmSjYuPXpn8wVmX-LSG8rbWq8w&oe=69B7EA7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488
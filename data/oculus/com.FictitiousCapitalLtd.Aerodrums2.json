_nc_ohc=kbqpRSPfvUwQ7kNvwExgJFK&_nc_oc=AdrYM5NhS9M2fkgxYU6HBhnbM_R4wr0xqVi5CcqIUjU6C4CiFt1BGfkLtIMHQpkfqhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqMlWhDdhUxAqjEBSzy0JPfWTend93gztP5PpBYo5S_w&oe=6AE60479"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rvjdADOo5cQ7kNvwFavHE4&_nc_oc=AdoLka4YHZUUCnvnNx8QFjuUkUFByNHN2DHoKqHiOWJnhrAPjxKBMq9GnP14FWLX56w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrb9VH5uFEawFOHDUEQQyCu-5sRDxY8Sara_V23fYPcA&oe=6AE61413"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6JPSsX997IQ7kNvwFaq3qT&_nc_oc=Adp_NZg5PPjxZ5B7b2jsMlG5nwJakz6UfhA2Dl3MvOI_PmSddc1Sm_pE2MzcCHbLPz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2oYpy_Hm89ogEQFaH_Qb_qrVt-1c_Jolr9GknkhOZOQ&oe=6AE5E77B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAY-dBLZIQMQ7kNvwGoy0hd&_nc_oc=AdrqBpT-6qm6_yBa3iWmP5rUecs8_13GV8H26x6q2xGP1jDBh5AaX9MijN--HSynfXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh-09BZAY9Igufy5YxIyA9k-upwYQWdZP7G-I7n5MCIg&oe=6AE5E8CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0P_6uWRxGwQ7kNvwGEkqdr&_nc_oc=AdoS3Bbl8nn6kKL6kla5LXtdshWGcdgOORpEPGDDsOJp6-Q2y1ft4600U1Eg0b9ZPqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO94NgU_dzgGIAXQCdaRSAVoeAGPXo2xSiBg9KgBLLebA&oe=6AE60A3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
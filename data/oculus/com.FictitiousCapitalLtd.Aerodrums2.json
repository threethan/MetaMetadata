_nc_ohc=3fHARoKp_q8Q7kNvwFXymHI&_nc_oc=AdqAs-r-ZUW3qg8ThyZQWxYm1nIWfcPUgqUYtkUf9KQagBkaTLnlSsIbETODqQTIEb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMW0jgKhg5EU9mpmn9iFfDwK_98UjW_9EHUGEX12E4cA&oe=6A53ADF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhvH_9hxzsMQ7kNvwFuVPsp&_nc_oc=AdrCGt6YHK0HnigU5IACTbLhTmvZ1tiips08YY7bPO8HU-kTDcCgEx7YOSvCrhJa8Eo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr2QY9xvgO_juWUGOs4_HmEanlkxFr_6FCOaxkyz0BtA&oe=6A538553"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpwFLxYrZzQQ7kNvwHgtRGD&_nc_oc=Adr5_yneW3ge6qOdRo6e_CySaSvgdvNpR94vyXrFITYwHA5cd030nY05Bnq-Hztr85Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuxTYtaSxsGimvQ6i8aKbJuYlVGC-HxVtWMJSzsq_eHg&oe=6A5390FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxdQOzQfdtsQ7kNvwFPC8kE&_nc_oc=AdrER8fdSRfhlEL3F2ukQ81y3yv2gkukue0v9u515nrjJ7KJokbM63hfCcZqRO1g7PI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvLZlCPrA9q4SDodSS9080bg4-sU4QWJW3cUOn7vxrgg&oe=6A53924A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcNtPS4yP78Q7kNvwGzUa2R&_nc_oc=Adr9ajhrGQrirIIXG_2JzX2J4DvP-1AUQPUX5wLYzanC2mIl_h1_gCPJH2jccz3S2dE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs7R6RNby9pvSrzv7ideJpEU2lpbFH5qFEPTBl9XSfNw&oe=6A537B7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_nc_ohc=3fHARoKp_q8Q7kNvwGCYK09&_nc_oc=AdqQGNj5ZVm5i3dd2GLyFfgG8eUQlvSf6Pf5DV0J0ZLK8vEErulXLCeBDSlFYIApJoI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4u27iBbCpc9LvSV7ru4OO79AXhLEqzAypzWQ9jdk53Q&oe=6A54FF79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhvH_9hxzsMQ7kNvwED8Uo0&_nc_oc=AdqzquOkbYNCv4macW3hDl1EgT5l_fNDSCyGgd0ILmgMSYaosAMxssoRXjZZ4vclebY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEZxA1fuTo6bpG3DlYHfDXQgwshgBTLCJjJzgj71Rccw&oe=6A54D6D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EniyMJozHkQ7kNvwGjGN7G&_nc_oc=Adrl5v0ayMbA6NkTtq0U4WV0VpwwMK4_J9BwO8mVYRQor19NnXOFKhW3kEuqJLLyrbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACNChO46G0czlSRBhaExSt5JUW_tuGdsYaXtUxsp80Xw&oe=6A54E27B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9kZZmTOGpEQ7kNvwGnl3Wh&_nc_oc=AdqRHr8ylAzZybahi-LkQPeZx3b98Jdg10vG4sTlS69f00N8mIUmSyPNnMEdl1icfws&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY7Tqz3lXwmSXr0ln0fgXyftdlcf3sCLz5wnYOflfmnQ&oe=6A54E3CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWdW15Kbeq4Q7kNvwHEZ-4S&_nc_oc=AdrSQrstMTRm7QDt15D5gzo7KTfmMD1-Pu1OTLJ9cI_ZVxthorhmXmev1YmH9oyoRlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7kVFEx2KUgyX3qjgXbH4CSOFLXSY3GwD08XgwY2hD-w&oe=6A55053E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
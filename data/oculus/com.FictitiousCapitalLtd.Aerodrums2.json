_nc_ohc=VKfQLzpvXwYQ7kNvwFl8UIA&_nc_oc=AdqFN7eBxVFRlIVkp41amt7tI8kI4k2H_3d5uBYDaKGrfXNxlKm3t3gEq8zWQQ_3Jiw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8V_8n_CKLKiBpDA7yeBtMikROw9JXhE7OXdanU0AIvg&oe=6A92BDB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN4jPKYttCIQ7kNvwEAjsmp&_nc_oc=AdrjnN5b2GzkkIPhyfKb_qgWyO8X8ukg6QTY2ofEKKjbt-zldDiW9zBgn0JV1vm-ZAI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmrDWZuDeVa0rweaUhi5n1j9P6d1t15QD_i9pWlC92aw&oe=6A92CD53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdgG_JmxMpsQ7kNvwHoR0BZ&_nc_oc=AdpHcx1MeFFzg9YNBcL6SAI1xXx9wsVhJVq6Wtlefxt9O7-uFUV4qKdlKah6ZKHTKwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzMtoWrv9mNh6H6jcqFuf4EOMil0_7uyIo3fbH6o-prA&oe=6A92D8FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxqYmkiTkhYQ7kNvwFKQoQL&_nc_oc=AdrnKWnSpjcNWvon8N6_jRY33bOLaAxlXuBoCuYkgekITlIG7_tJY20p4uvkJnv7gbo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7QNOA0IIOTw3wkLoqlQDsFCrutj0SMBM_mTeCRnwbCQ&oe=6A92DA4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMDQJzfEZwkQ7kNvwGaAEhS&_nc_oc=AdpPpwjOHML6zJAInXTEm4W1ezXs-poVlCnRmZc2kHt84Raugiwr-5Mc-z7xvEzsFVo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET_3bZoofNYoga-VXb6Vuz270q9t0K5wH67K90FLB9Rg&oe=6A92C37E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
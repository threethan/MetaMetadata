_nc_ohc=uF2r4DNOlUYQ7kNvwFQLaBB&_nc_oc=AdrHUzrk6DTjerZQHmKHLqYvRsuY1goTZD4iqs01Y6k4A_NUpj8lMEyt2hgEDILn3R4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiLUBXJkpIJnXa_V9gzby67VkFeNhZIlc2mDtyqR0wbg&oe=6ACCF7F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeWLEXxUPy8Q7kNvwE981mJ&_nc_oc=Adp8aCIpW7HN9w_HFbPskEtbVv02iatyCudjpa-j-cTUVqNc1IgCWVDLehqB0USIv3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1p2LOOw_2j7BpsG8gl8UODqcVBDKTmuF0xrxeNOGFVw&oe=6ACD0793"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_1rluwHhFkQ7kNvwG_F9Jh&_nc_oc=Ado4oab1vpb9BZSbE1vcmnFwxc82-9on6WtDbTHvfcLmPMh1fazugRl2J4dnHuyTVSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFJaTUZH1VMFHywdwB_QLoQBBh0hSB_6-RctJ2VSXpdg&oe=6ACD133B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rEm7Ls1f7AQ7kNvwGdgJty&_nc_oc=AdoaDES108yUHlp72jF44LL4g-90kaNfKX3ZzdhFnPyszaymYS9GRUpBluZ3sns8vRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNabdWw6hTbv463FP3XspYaHSErLLnKzQNnjX6BFHGuDw&oe=6ACD148A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qv9tjsGgs78Q7kNvwFZCTwy&_nc_oc=AdqfkXYMom8jknt4dCd3KYW9AA2C6rq28QEacQYpkVMo_qOMiUSgOWLaRC9JGMVz4Qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAHGAVHM4ZpQlQeAwFmHdZ816lcpItJ3hbaf4VUKfZ0g&oe=6ACCFDBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_sid=6e7a0a&_nc_ohc=6DRmImW-ZPwQ7kNvwF_tBNz&_nc_oc=AdpIKDjW67n4OQGZC9xDbah_2JN_LoGz4_0zgJou8xOqRFFOK-5UTZdc6GVLynYVV2w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kfjGAT3_ZY8s739-thbv2w4mSMivCB3KB1GAsmwXmkg&oe=6A22E679"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWO7CXr-JNQQ7kNvwGBgtxP&_nc_oc=AdqpjZz5FtCE3xyT8ZNb9YROVrM5y5stESsKf19PoFFZ63lnqNKnKKF2u1pKV9m16nM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kYtJnkdwLgkYmujwrHlYpe4HQzOZZZOOVXWvKFlx4Vw&oe=6A22F613"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o41sTYQnUdIQ7kNvwEBh03z&_nc_oc=Adod6FhpLTzBwEijCp5Ghkb20tgYa4_o9KAO8W6PiAVae2iH-cZo26vFdg3GX8RjXS4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yMgltSOAEiBEQWOnc9HU5PaikgBvs3iOYbPX19QULHA&oe=6A2301BB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=992eBwDbPmMQ7kNvwG0qlzv&_nc_oc=Adpycpufbq2F09C9ccLKCAMRETcN0YooqGr2i0-xlSZUVarMv3p3RXK61zxXj6CXawI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rNtc8ABNB2mc8tSOc3sgo4DeelG4EQZa-kPunEiyjGg&oe=6A22CACA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RupSgA95AzcQ7kNvwH7EYed&_nc_oc=Adr1IBgGJli-KFDVAuwdBeq-NNv1uttUGTqRIHMkdyf4-JZcVnoZLcQB78zr3pZWM2w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cVTk8RHnsYzE_Ac1Dr6Lm-wqEcdJPpP3PDukoUadpEg&oe=6A22EC3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
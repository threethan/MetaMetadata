_sid=6e7a0a&_nc_ohc=QovK3wql4hcQ7kNvwFEpfdH&_nc_oc=AdoEmk2vHNskz5Au3GNXmX9lvMvgfeLBlhHZni72Q7Jrs06jA81W4Gkn78WfHNUpAOc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhCDwnDfcGmmImeJXqU3p7kVMooU7WiaTd-xF1XFinww&oe=6A7DA5B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CqijZ5wm9UQ7kNvwFEuqwv&_nc_oc=AdrwCUxgIsgZhxL0CXA1FFyMtrQPmn0K-QhwgqGaQVq8WYjCBdpu2kPYEf9Ex3BS_hc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiydn5bPdXGqNBiBFRWyX4e8aVd9_qyVpfz_taNBXiyg&oe=6A7DB553"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia6vRjw0jk4Q7kNvwGCYU6l&_nc_oc=AdpVWPw3djeH1eYWtzoPCwIXb_PaCguY5eSf0VwFk7FX1Q47yxmq7FVnCBK8OsQ97I4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-_mIr5y_w6D6b-79lOXk_kiSiICY8cDJWkDV7rw0lGQ&oe=6A7DC0FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T0sKZfmKH4Q7kNvwHGpOwM&_nc_oc=AdqLiBVMe0ufGYXulW4lNHLk59LIp19nx1inUhLFQBgncRO7vdzN7ZYO0Qe4LBK6dV8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYr7Hmlq7wEgzogH7QMuH2WMQma5vtSSl0RaV1ySYcKg&oe=6A7DC24A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxE-hxsiYJoQ7kNvwEPyjnp&_nc_oc=AdpBsX8NQWeWscTXeVLXtTtZUFxD7VpBNp8mAuiiFDRGoFv8F9Qyq8IKmpSyzDDhhBU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDkkCTdnIz6bwPy6SMHGlBFMqQrWGcJGwhNAr-T9vHOA&oe=6A7DAB7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
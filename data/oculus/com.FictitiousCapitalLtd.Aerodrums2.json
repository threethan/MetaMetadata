zdS_Jn9mbxsaetmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfusPoKQXFzISgvbNBKaXcPXc__8vc1EY-1rovpWW9wOkw&oe=69A96439"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs_c2Sktm7QQ7kNvwG3YVsV&_nc_oc=AdkuNt8WsXno20bVZhs3prsfW1IVr1LlD26UUPtXy_I2BXl1JlHsM-8IgXdSX63E7z4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsR9gXgMiKB5szCqvT6ddikZBagMNT17wU5ooDgnlJ15w&oe=69A973D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_7iSVhPQ7MQ7kNvwGDSKYU&_nc_oc=AdmIkXLrgTo-__eEFlD-e4y_GN878QizsKy_dyyxDvZQ1HjUbP99ZC0FLyOs5tG8dWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZbGGpLp-exxIBiuWSDGGEKUIxFU-h447LUaIl3kmb0Q&oe=69A97F7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQwoYWfJpREQ7kNvwEza9dc&_nc_oc=AdkZ73MBMJGfo50h3W9G4O5_PCQab2tvShwPz_Z7ovMyBagdPNZMVgBaCOQB3JTnajM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvIwyXb3TkttuFsZQXePKQNLvpcHJKuL9gf-nq90EhEpg&oe=69A980CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn0SwdYQf4MQ7kNvwF6jAcq&_nc_oc=AdnL5YBQH4NbdDl1gv5Uh6AHWbGUoEgimEoY-saASwuSr1UrLcF4D3IZ14jW0iUAXOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKGhRrMCEuB3dysy4TF9Fs4EHMZq1-Jso7NkvHZmMjhQ&oe=69A969FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488
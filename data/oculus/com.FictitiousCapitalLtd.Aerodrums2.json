_nc_ohc=F7Eg7M-URToQ7kNvwFX4e3g&_nc_oc=Adq29FCKd4_cm4Z6y_3n1VAJ2YB_iEH49rnEdQ6Of8fagzYOVOHtr3AOSc0IZAYtZvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr2xXq9MH3cyZ8Zcs6JVZUYLJe8xZkcTydbPDyWwN4-Q&oe=6AE0BE79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-ylXZ2e260Q7kNvwHcPKOZ&_nc_oc=AdpUmQJ-Nx7vY12TZSzgvtOY4ScWVOthe-hVP5QoVFHvtp3bLVmeY-zwVcvUDILrCOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdhiXjVVAhLxZd8K4Uuq5xjyF_s-NjSdggaFc1H3IhrA&oe=6AE095D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDVcRxKZQVwQ7kNvwGTChCe&_nc_oc=Adpe553Wgvp_1QT41a-WkdDkXjAnCH8gdwghjhSgXOXZb781ShNIsM4C0D-z9ZPbSYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONbndtd8w-zO3za3vX86kqCjabOXV5TWn9hLk8uQMXvw&oe=6AE0A17B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-emGfD5KLm0Q7kNvwF79pSA&_nc_oc=AdprSCPJSVm4tF7lkC3EirJ_65pJVv43RxaghL8Fm3ioS6eHYqBpZFp3h-bOjxQ03eI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmP3NhsDK02fszsnDf4v0NKIKxWsws0YqxYU959h0XMQ&oe=6AE0A2CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucIPzOiXp4sQ7kNvwENK77e&_nc_oc=AdrwIZlsXeT3dtMV7dvd0Y8Al3Pf4fVmYAkMX9biuoHjUeGNAy-yx52AElDOuXUygug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvGDIbROeLgj2zczDm1O_Fj14i-ZRvZXm8dXBpb64rrA&oe=6AE0C43E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
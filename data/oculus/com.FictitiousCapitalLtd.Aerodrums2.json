"https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpYFoL7na9kQ7kNvwEbgV2f&_nc_oc=AdnEQlJdoqV1bKyiy8x8IQbXmUGQ1KqTm8PSpTjAwhs6Z4N9ihCSuNK_K6QFWJg6Qas&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftqKJfUlGEQk0gbTzCi_nmsLIuwZTiTllRkgV41YgiJUA&oe=69A18AD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHvKr0F_s7EQ7kNvwHJB-au&_nc_oc=AdkFtZrCuFUsHpdHNJLVdT3iDR_1QYHmNbLGYUJ8QwK65Jj7M_QawHHK465Zvi2bv0Y&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afuy-rq6f3L-rwzGWOAtBYUpRypi5IpivO4bPewcGbMR0Q&oe=69A1967B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIz5iYtQryEQ7kNvwHz2U5T&_nc_oc=AdnUBbCl5hfHX3XtLqhVKuqv7eDmt7YmRImk5Y8dZ-rtscKN5V_Bg8Dx_df7D0Ieab4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft4qM7042rUuN56aMymtA385GaP7DOgJrRXW38Sh60qkQ&oe=69A197CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUxCsZ7QNywQ7kNvwF_bl7a&_nc_oc=AdkaaILYTVkOLREat4ISrBmVWDI74cboI5f52I6mN3J2WK-Sx3ZZdwTJljFYv6kEk2U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsmrDdSgvwwlFGfoEzX0fyVJreIiQHXR82V1ifz6hmsAA&oe=69A180FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor
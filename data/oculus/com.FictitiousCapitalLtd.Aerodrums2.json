.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkHuWZeDXzYQ7kNvwEbpqC5&_nc_oc=AdkruPgzx5O4lwqS_TOYC1q8IYTSe5EKYZbbWKHS_pxO1eKEUpdE9AZOKwG2lDoXRio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvAd4IfYD9W3m1d522HF1ute9EoOEleALQlFE7pAhAaPA&oe=69A41E39"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg1s0wCk3mEQ7kNvwEw9ich&_nc_oc=AdkOmQx9D0RnQ6UjUXmuw7s_LFS3CcU_en_phk7romJzIgv6w6PnLjFLGhoSCRc2gmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsrsGVrIBonyDs5MY556y_UyWXIlgrCS7uR8wAnTaC1tw&oe=69A42DD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6enR7dJZVpsQ7kNvwEz6a_4&_nc_oc=Adn5DfHjsRkU-KhgDv-jdNzcGQGXpncN3ww6hl95hLYwm5s8u03Mdbhtrm3rsJG_Rj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6PVorLls9AHUsOWj6GtcOVpGRVIY_DTl6MWltIgRDNw&oe=69A4397B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZahKpWr1HUQ7kNvwHfdy5h&_nc_oc=Adn2Zmyq3WayqF2AV30pijYucv6QTfC854-X0uxQ7_S4hDJkh-zSg2RM7MRr7SN55RY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6ksJD-CpASGd9333c_fNLnmICoKoDy1qNHBs91MwvmQ&oe=69A43ACA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNHureDjk3YQ7kNvwEeXvT9&_nc_oc=AdnAc79NVNLaG5b6nRx7r6rhuim3u9F2mCHPFKat_ckks23xJzZXARCZisHW03AFttU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvGAMK16GujbpC27cys0fiMqoPe-6oMesN6FSDmJkkK6Q&oe=69A423FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7817449928379505"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_999718448725765_5015023777950136377_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHb82ul-QBcQ7kNvwHIxpW8&_nc_oc=AdnWfLWIoU1iRpLl_qDUDDmOWlHVVl_S6QBLFK7KnbNC-VjEFTSzT6n9WmQ2WCQtBL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsAGMEpwHzheRjIK0Nn2ibZnTTWgZfOz0bOM3WZz4_bEA&oe=69A4271D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aerodrums 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1740562800, "lastRevision": {"nodes": [{"id": "7791101414347690", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7791101371014361", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "641137765058673"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "logo.png", "id": "9875363755824721", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391949_9875363759158054_7798703332122508540_n
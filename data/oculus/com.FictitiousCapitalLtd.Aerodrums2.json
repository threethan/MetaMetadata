_nc_ohc=kbqpRSPfvUwQ7kNvwGQWjmP&_nc_oc=Ado8IisZbB7TYFA1_k7g8DFu9c_usmwPqxvqtvlXKtA2YTKQsF8yPXKAOrrDbpwgdz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVtEXXb7ejHjvz3vzjZKeWBUTY-jUCv64Kk_F7_Z5gxg&oe=6AE4B2F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rvjdADOo5cQ7kNvwHVCAof&_nc_oc=AdrhTaw8IpHdg274J92eTGMOcU2tnWNpwX0ucFp2c7uz7zaYCMwkN-p-2pKM4Z4VkTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3-04iUhHH4BKanPHIRkxHNmSE5QK7LKpMQ-35HPzIaw&oe=6AE48A53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6JPSsX997IQ7kNvwFZiYpF&_nc_oc=Adq2pvMBh0EQuDyG_ybHQjJC-DoWTF9Kf3mlnGeRXDIrLCIH8fuiEggP3Fdl3HIOXY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbW11NVBbZ_i3bHcyMZtc3Go-DTYNIGkcaZoSF8eK9Dg&oe=6AE495FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAY-dBLZIQMQ7kNvwHZAGzM&_nc_oc=AdpsjkDAyQE-kGTpOhJ6b2w2wcirCovi4xONs1z7UYpJTMIioFVd9_YmaJxUH3cIdxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQkYwrAILOHaDhHKQTT73Cv0km0TiAcjaEyfKZpfcAsw&oe=6AE4974A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0P_6uWRxGwQ7kNvwHmtWAW&_nc_oc=AdrEtKXCl3eQBgvcC6939X-ppo_8zNLF5omc1VIdG8HllYUyw3zbRmvLDmP9fpTvDYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeCZyhl5uG5_xYk6o-2KuXF1_wBgCQdi07-LAqh4rO_w&oe=6AE4B8BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
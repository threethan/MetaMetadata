&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyAWcy3DGCcQ7kNvwEXJqgv&_nc_oc=Adot9a4qD24Rjj_nc_Qci-59XMmw0EPCTy9e9biJmcPbE6y0crl9fBeC69CIXMbL9JY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7e2PPjSheZfcAgEKGQapxoHbBAokLV6fKf394DqtgzA&oe=6A858EB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYgYZAgjjDEQ7kNvwF7ySed&_nc_oc=AdpgsUKgK_pkItpPYChq-vyvKir8BGvx7isDoeIiO-u6vjWyzCqc1oYTVILY9KpSK50&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG54HchWkboe9hJCXHtSE9MoYm9C5VL4KXJ-AsoJMpJHw&oe=6A859E53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGzErAcdjXsQ7kNvwF4ijZ5&_nc_oc=AdoHAaW0oHPB7NUuRrH-MUIRwnpHBb2sOpHNrPfjP1jfkqFkorFQe-UTfCU4m5JmM8g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuvPhBQympLXPTNNuEWHM3Nzyfa7A3fvnx3Z2z5r_sSg&oe=6A85A9FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HM-yrahgA2UQ7kNvwH1L7Gn&_nc_oc=AdqJOlNTCFPn88PCEtaD2_UoOnN_9nW-FyCjoBSciSnIDrSUxE6UA19xKwt--BronQo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2Dc3A6K49oU9M-l6s0hZ4fdJT3FNMWYNbJzI_Ip0EnA&oe=6A85AB4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHEecl3LCl4Q7kNvwEf9sXN&_nc_oc=AdqTGrTVJaHwQ3aq0myxA4GGxv1HW0utwDE3smsWhc6PBBeELY2uq1j-zWG-E4kpaFk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF38WqgBp7BvxdUrRY_l6DosQ9UrnlBLvCGCV0u4PPstg&oe=6A85947E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST"
_nc_ohc=KomyN2wvRH8Q7kNvwFXikyi&_nc_oc=AdomA5yF-GA5Z8FcKgj3NcYZ5MMFJwXIT5FyJwCniTd2BpUhjLVIAWgcvVlP0XHmVOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32OBqn6BMQ9kY9gJdjcB7yCgcn5nZx8qqwTy6y_oK_bQ&oe=69D27AF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_y3tfKOVZgQ7kNvwHnVAnK&_nc_oc=Adq05Pvgj9ocdkZr4dQg3WEPlHq_8gF3ItdoPZZ2M3PllrPD8vn4dSwAZqqtt2VOVdc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qYE7Lm7gumfB19xMZbEJFOVEsaoFsa6VHKNuWxhlPjA&oe=69D25253"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxDk7XhamK4Q7kNvwFYikIN&_nc_oc=AdpjaW4CT2sEPZY68JBzdwuIWl5AETh4WgJzubtUVyVc8Lydem7kuBu80DssD42NNL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bv2nvJg-BQaF7mwpr2dngaH2Uq-zh_kfgLfTqXjG-vA&oe=69D25DFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAzA2QZE5HcQ7kNvwGr0sf1&_nc_oc=AdrG7sfKDCN-AI4dJDSXA-Eh4wIQNkoV8VCuoSj93fmieUoYNOu88Xh-rkvv0pJm_7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GZWWbtWxsjZvvKdY-yD51r70bNrhU2K2tkN0RpdKuLA&oe=69D25F4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otdkI6KNLYsQ7kNvwHE_OSi&_nc_oc=Ado4ZgXUknevOcxLkbu-R2xk6u0cfeXkVvvALdgWfXfsMc7uTuRmG-gV16XbuR7i7nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Vbjm6g6ah3BIzMyQQM_239W7b0L4hWB9kq2ZK0fgNaA&oe=69D2487E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
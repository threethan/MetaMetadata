_sid=6e7a0a&_nc_ohc=Tpz3h8PDleoQ7kNvwHwLMOQ&_nc_oc=AdpeFJopJYHD4GilvWz_0UGDmuvicvcCwYGz41qN9wHnjZmrzK1EkguRRGt1zpocmn8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FKjOT8FvYWgYkFm0mo4W5d3Aet22PI0benjDeAQ2UjQ&oe=6A11C2F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MotC5JTg8PoQ7kNvwF5S7Id&_nc_oc=AdpJ6ZZpSGejRzd0-PJvLu9YfywquseqvMkAs_TkZUeORAQJSlFmJnVZmLRJezT8_vI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z5xSSxsiZzIu9jH5MhapqvDPRyOn-PJ4yLljnan1o4Q&oe=6A119A53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaPgKVbc8UIQ7kNvwEnhw-w&_nc_oc=AdrCLppmC1M223IhomAC8aXYlHTfBO37cOi5W6lj0ZlQXzSqVLh7zkoB-lBXeTQWukA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FYK22fNxCqfqJ4usAkmEwpXhbOevEsr3-DqSM550PKg&oe=6A11A5FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2F_dnXmYIMQ7kNvwFs58px&_nc_oc=AdqZVCRVyujCyBbX0wUoh0e7_qgQYG31-XTfFwLVDPx_BApB9ul1p2C4FNicra68H3U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EXr48bHXQTWohes9uYUxpsgBRqas8CKaLB8jMXND0ug&oe=6A11A74A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytxyNtbECRIQ7kNvwFdQAUv&_nc_oc=AdrSYQeL7M732wFok-NaO2Aebgf5qdHoa-E0EyVDUJRZu_qrugsF7v96BsVZTe6LclA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dfh34rTAUXFT3rWBTxEd19lADCtPlSgiv52DG5j7Uww&oe=6A11C8BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u032ISkRx8oQ7kNvwF6wCmd&_nc_oc=AdowRBu62NpTooqSX_DbridjAzbPrW2nt2XTCumOj0GKgihx-wVP3Q5nBwqgbow9sJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaXg51dpZ1ey16Jyw4olorlJkWOAssIHFjm6vMlpzU7A&oe=6A4921F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WATPRXriHzsQ7kNvwG5amab&_nc_oc=AdqOSJ8viFPgEGZ22vFchNh-svWIMa2lfjJ-IMCobgcUVZQRgTF5vh3POqd5beuS7c4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqNnqxQjKMyqPN1ImJXQOaPyGNyBE3JmOPBSz3mFqXRg&oe=6A493193"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cmXlrl49c4Q7kNvwEKK91S&_nc_oc=AdpwmYFkuy59wij9QKe5jy9RvJ4X6WOwO6CEILHK5uG39QqYDO__yhjkl3i9vfofqhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_Vf-94N-uTVabGdLWTMEgMESyKOH8ZNgfuEy9S5vITg&oe=6A4904FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exh7jYwBuUEQ7kNvwE6OMag&_nc_oc=AdoDUNKica-lwcwHbUVhAZ5mNGv3vQid3-RUMo7cQK4HTCX4FdXFllMyJjZx0wqaw1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArsBV3UK8mj3kdb7OskfVqZmdI9tli-u6jRjLIrls5Sw&oe=6A49064A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl6vhwbpuhgQ7kNvwF1l4jD&_nc_oc=Adplj5E76mV_J86aVrqgGVZEEdCzG7rc46Svg90_1NQr2qCHViYR-cfJpze3ioSnO4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3akxBnQt7b00bDMQ7gwExZHIOaJZ_VE4Jlk1CKHCsZQ&oe=6A4927BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
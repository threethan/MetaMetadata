_nc_ohc=7gBMoNEfQkEQ7kNvwHYl0Pf&_nc_oc=AdoBoPoB0D2LcQ1xhuOmBA-hiO1EdXcf6_K0963KSmYbWn2OiYaSoiIQfVxAgjx0pCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16IFBaBAmkVHBTnFO2znFaJ3PimJjGPiccxSdwtFY4PA&oe=69DE2039"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt5IhUnrOtsQ7kNvwHcotZs&_nc_oc=AdrEb1IbhOeuY72llsyRTi9bOHHxDZ9G2ASE1g1d8BMPO1XvUyF25NJ5k7s2Cj49xmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W5JRpFoLDdRdd-kM74DiCbr220kXoA6y8gr5AKk0j0w&oe=69DE2FD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOtvkqUj-AgQ7kNvwF94Btd&_nc_oc=AdrAidyt5KhdAxMlgK9Y-Gm7nSX_lPJhjQaH_z2L8N79KZvbCDgvhYEAQvOzzoqatGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3URKCzwYIdl7zSWwvzI7eOSAEu0xmiud70OrulroETmg&oe=69DE3B7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1mMg8X3nVgQ7kNvwFraUDf&_nc_oc=Adozy9BD__iIVessILGGQv8slyPIpd3hvY4Fu4W4bTJWEtVDQvIgVydVd3ntMEnCOJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UrhRN-Gl5lkltnPuU3CbU0zkogVrd0G0lHVOctyzUNA&oe=69DE3CCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPhN-ISHbj4Q7kNvwFHXVtp&_nc_oc=AdreYNwgckpHl7pODqtLrEasMdyljivDF8C8r7PGfnzKvX94uAR5Kjk8kI9rGlSrHz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38XxlCHXUw0_VuLsidM4Y8IgHiRCxfvyvt4fIywTiZQw&oe=69DE25FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
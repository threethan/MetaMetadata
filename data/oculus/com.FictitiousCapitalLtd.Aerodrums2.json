_nc_ohc=ZK6wARejqJwQ7kNvwE6tAT3&_nc_oc=AdqtX1SA0OcEhxXS2d4NKA4q169erZFKLi4I0zS4DcktRecgf3kOryyVJhRmymxDdqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7noym51HvTQTen0EidUHoBk59NPBhPI-JhW8Yar0c9cQ&oe=6A0493F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRpOTLyYvrQQ7kNvwE__tv2&_nc_oc=AdrhyvgwaNuQrOEmmAxIMzO7K5x0p70uJEGqsj2Q8SIElsEssUEPBEagJeiU7J2Wknc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lPJ88mDu2iK2rUTZk-PNV-Ud1n7KQtDk5Iil2aNfskw&oe=6A046B53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_8PKrTlGf0Q7kNvwHm23pQ&_nc_oc=AdpsTpBlvdS-Mo4B86J7GeY24YlGyMw0NBmp3DAwv_TmqE5Nevg8h3PPaGAow_TzJxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E2kCoDXBQHPT5TSqs7dUUQxh_wQsx8-d09qEm_N2Zkg&oe=6A0476FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNIBYaddqKcQ7kNvwH_2M-M&_nc_oc=Adr5uom8l7JRKQMtERG9HJ_JLvI0OExcCPUqv6ZuRYP0AXU2QrBYqv7E2UIZemd1_jk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69KqabI0qcIq6Vh62JpSVZK4NRCNh3KlyZoRagPVIEIA&oe=6A04784A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX5Fh2m49vAQ7kNvwFTdzGv&_nc_oc=AdrPxbNPbXeJwwO9OjRRQnQsuYG84GxlTrKKkHJYIWNqYizP8UyL-4EIhFpSONLLpms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40EbYrsrxAQ10hr9c5mF1ExUZkOB3TQO_HDR5KxqqtYg&oe=6A0499BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
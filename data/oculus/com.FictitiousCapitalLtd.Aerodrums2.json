e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvzDo5Y_YQcQ7kNvwErVZDZ&_nc_oc=Ado-OOJcNpijxKcEpjGM3U0coxIO8A0-DaPGeeJBy2trM5VBH7GKePs3g1LTZCYhLXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKosD0Ba2WZFWpYbweqlH5KN9-0yFRBpumOiiAsLhNbuQ&oe=6ABA82F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok0on6O87lgQ7kNvwFfUT-6&_nc_oc=AdqXr_LfH0x0GEY5mg5VfypZ9nl5b3FcVhONkRdZDJwv-Ttj9oGHJ37J_zU1tN4vJsk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5BtQG0r9uCo3vFF032ihPOomngweO-_9i_AhruNQkaA&oe=6ABA5A53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am_jXsTvruwQ7kNvwHUAonE&_nc_oc=Adp7VsiBbit5xAKyRmLfubFZAP0MkSWTd-t3EhmErKzjuGwVoYbIqNHPZ4MUIjrHtOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbUWwSAaGdx3pOsKZUYr9IFiyBhRTkADd9woH2e65G1w&oe=6ABA65FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8fZ2hqSj4wQ7kNvwG9B4Hz&_nc_oc=AdrEeAGYNV8gPCFVhsGCQuIe5UbXIuC__hiivGu2Cnmu0wpsfaFZS0ljnx36GmLDoEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZbnA8eZGgqhDxFLHZgMY61O1_fgQw64-LtEO5f9KTEQ&oe=6ABA674A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLA2SZu6Nb4Q7kNvwEskFkh&_nc_oc=Ado4_LMpV3Aj-44pXy6Z2K7BEmuO72brAwTFUXJW4jClPhmTZf5eYSeByOhW0h7wBWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeOHQHUoNuYz-_r-XSH2f5pIvCIUBTeTY__HtADptHkA&oe=6ABA88BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
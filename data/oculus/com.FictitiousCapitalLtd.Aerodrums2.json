_nc_ohc=qdx2H5DQeccQ7kNvwGQXFJ4&_nc_oc=AdpTZow6iAMY55NMxE9oH50ncKDKNjk9nv3Ilrj2tqnm5wTFGbfRDbf05ueLMcSEU4I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-61y0e17cS0AqgS_K6N1TPHZYytOWc6il9oCkR0XxrA&oe=69F37079"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ0kqsqB9QwQ7kNvwGZwD4q&_nc_oc=AdrUnVTFetwsldmRCgDbQ2fmqF70pc8x2VnRfZ3pO32eyIZrHm3KKwofoZ5dXiypqS8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KtZHT0ewlCBXL_No7VLcc6ekWaq_-wME5xNAO_7S8FQ&oe=69F347D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEBDkuYgw8wQ7kNvwEmqpro&_nc_oc=AdrfMJrtt8BE9M9dg7pB72UCUkelF0Rt_DZtdFw4vM8zuRGLumvPjDzxYRR3qw_4zKw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1San0WSjuygcZGd2DVx1A8EDqDMMyGLCENtBNNwJ-F_g&oe=69F3537B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBdeUfXTA1EQ7kNvwFQkcbE&_nc_oc=AdrNavErD3uLyD139j_QjDd7WfzoOown63Xfu8la-BuCPR0duFVY59fDk_ux6vOkm38&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YT9-nAGVCT_i1NSCJ8EX5nJOWa4dDUHrw8AJfg4-a0A&oe=69F354CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2oaTuhJt7kQ7kNvwEAXKdg&_nc_oc=AdpE57o2MAGwK7kV7Knt3rlVAMOv3GTE9FBtxfSaifqKSvRl_04VpHU3bYB3VBCEXO8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0E9Gc_sT4m-qYenEK-x6rVbtye8-H60QPqkt4VKO3MgA&oe=69F3763E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
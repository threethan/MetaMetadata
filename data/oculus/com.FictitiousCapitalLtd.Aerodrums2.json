_nc_ohc=1xfAz7QlPOkQ7kNvwEqXm3j&_nc_oc=Adraa1sNCIPyktXtzCR_XrsbDnzQNItJpyAbDlKXF7rBEnSIQRXm3_oCYRN4rL5sIWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12iC_PzYxr6vTy2PIHkNNkDdaX-J9Yn7ufrM7OtKgvrg&oe=69D4E5B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHC3akZXnZkQ7kNvwGYItNZ&_nc_oc=AdovJiopkLOjOteoMGstM7hpmaHEflNh1Yn7CrEZs-vJLm03a2PcCT-BI66goU2wkRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0djlN1EjZaQdhfacwqMn5Z9mQBgb3bJ9bTnRzI2PmzRw&oe=69D4F553"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxDk7XhamK4Q7kNvwFpWs-0&_nc_oc=AdrISgHqUhxGuZZ16wfH5tAtUCCjs5oCIdsCHuYUpbGyPMO2HTQH9B-1-x0hkuNfowY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uoMa2Ynrwc2DGB857dcIp8XU1Abki-lSRRz8U9GZpzw&oe=69D500FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAzA2QZE5HcQ7kNvwGRSxp1&_nc_oc=AdqQdOuEieuOKCm34SF86JrotGKLWBwW_bQQQyBrTTpopFL7bIBa04drEhGFoBMDcog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uHd6S3r2TwzH33G2Y7sLakuI42cdJTcHPYr9pjuV2dA&oe=69D5024A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otdkI6KNLYsQ7kNvwEONye0&_nc_oc=AdqeFmiO2NWz2f4ZAqImQ8jPguae1BSU9rHX7j_gL4Y0AKUsBHtfhcuChQKBSDFHljA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OaDmOJjRipbdJeZksBCwfqYRvvQjIfxnd6aI_Pt63LQ&oe=69D4EB7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
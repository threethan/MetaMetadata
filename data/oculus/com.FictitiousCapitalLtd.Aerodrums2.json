_nc_ohc=yalozcEhJ2kQ7kNvwH_AE89&_nc_oc=Adq0Bpj7Pss9oOGvJ8F23KMwn1HMHKIvRAlbTvUSfDfWg_x_hI6ykitVvD0wFJRLkiM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH5AlzPKIiozMNfCgAwiNxma5e_g0Ww1MNMID_2B8BEQ&oe=6AC50EF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMj0oZZDVhsQ7kNvwHZHIBe&_nc_oc=AdrDiAEqtjRDQTxtTDzBGfAkVSbb7U7VF75hjsatwjzf4PZYgUrjHErTqdqkBOj1JNI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqafpY_88taH-BR6ALnlU_5MflpaF5sf0gwkZ3RCjLsQ&oe=6AC51E93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu4HDfu_0rYQ7kNvwHzNJ5F&_nc_oc=Adov6dYjyPKAKE7Q-nKXwvejVzm300v2CdrAumu7M4J_4HC5qC20aOaavd-KEOyVRDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7BY61DT86TA-5vJTMrexlimbatl_gMpUgJK7rjxUOsw&oe=6AC4F1FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZCDfMa9qDwQ7kNvwH86pCU&_nc_oc=Adp56L8l-WH1eoHeqo143ZzYcEHxvczD7KrMwHir2PDqAeC-tHVj0b4WmK9Li7y1jTI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9CMT3j39lPoZFQNgAUZao4z7v-jZJK4V97elvDXWX4Q&oe=6AC4F34A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YjLtXAzRw8Q7kNvwFGZDai&_nc_oc=Ado89zpxAmCuCEksw8W3oqWrpxkObdctWJnlag5gFHwDZI6GkW0CnHIgHoAEJgquwJg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd9GEo1ii0SpxD1Jtl2-DFKTDQFMWkqkTP3hOKQhAKig&oe=6AC514BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
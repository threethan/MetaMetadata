_nc_ohc=V8ZaDaYos_sQ7kNvwF5n94N&_nc_oc=Adqeu_1s0lB9id5l5sBtWto8cNoLB6kbgqYJ4uutviWwUp96D4Uv4x_Oz-LFF6ucUC0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV9P9JA_HyK_1Zw1RibX-Oy4JD4Lui5aWeL7OvA-ga1g&oe=6AF33379"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv-l6Jjx204Q7kNvwGms07_&_nc_oc=Adoq6AsaiJgZ4omjdAJQrGFEVBOqf-ny5YK_CgGapvrDKtKeTI-WrP-UKOxbp4DaVkY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Qa4zQOgqNCMBwLrstBK19KnwfWwm5xZFXY1PhMZhfw&oe=6AF34313"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSMEtXLericQ7kNvwGGo6fN&_nc_oc=AdroOpftswB2Sqykt_-equXoHbCvL66m2jIMkBc5bwGUdH_kwRSl_6MN8T0Yuwvz7AQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRerS6YjwGeNOvpB5Lt_qrQySSAl738NOpXJEXFTEEFeA&oe=6AF34EBB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH2aiUGREeUQ7kNvwH_RIak&_nc_oc=AdpmWOexiFy2ec61ncZyU5eXrQDvHa907YDUXwmONGn5DaFXedJsBzlg_ejUjltnHNU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1jqsBNmoDiRUxyOwQA07IU7GN2jBp_-7rg0oZl3ltjA&oe=6AF3500A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYntubJKuW4Q7kNvwHQPGRA&_nc_oc=Adp0pdjA_BgxUv4T0adb1RXnbB7vgGPYV2cnU17eleVYPFohTRuanCd3Aq0Tbv_8BJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ZcK6JdwmdisuSTupSTO0QkMlm31G7KfUUzv-Jn7d7Q&oe=6AF3393E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
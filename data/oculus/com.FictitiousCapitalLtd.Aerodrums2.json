e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uF2r4DNOlUYQ7kNvwHiGOtY&_nc_oc=Adqpe-Cr8_fojtf6rF4SUg_s8_5mabuTdiYUH-H6qhER7XCMmJmqkAo8OkDl-Ch4WNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1BWzO2FNBZCennI8gV6UlOzc2XJp6Xa539vx2y9ojAQ&oe=6ACF9AF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeWLEXxUPy8Q7kNvwEeIrT8&_nc_oc=AdrEUJHVV81hpvCIjTQER68GLLg6Xfxb3BM2NrVxF3vWL6lWYbrQEAD9ubhpByUK0rY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjmsfDyKgQCkKcCO60opHN9Io35fxw-kKAylqKHRcXnA&oe=6ACFAA93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAeeXt-urxEQ7kNvwF73RFQ&_nc_oc=AdoXaWw8n4-Aa9C9faGpiLa25RTwj66uMW3DK3dpRdimKEABtpzQKM54Sp-NPYeSxOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLiDuTlwwd__dr_6RHLeGl56aMzji2Cc4tKsyfkyeL6g&oe=6ACFB63B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz2vFG-BGp0Q7kNvwHmudDH&_nc_oc=AdoP83xYkaW0fdX-P2t9DGw2Oq_Aj3T1gZAKmKwliiUuqb1sm_5N9LugV2lkTPmcUbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlRnp9v6IvoSOaQ47ERLwC84THSvqSRuQvgaKw5K3yFA&oe=6ACFB78A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XZyXMDKA1oQ7kNvwGiG7AN&_nc_oc=AdokiDd43dlCvJ2EKP9g3IHPCQUldvDjQ2Gm9K6s8_4H3m6BqXtnWCm9iscx-A67ixI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFMTZMw1L0-XNfNk7x0aH9TCZSe9IUiv7bDDYPyyWwaw&oe=6ACFA0BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
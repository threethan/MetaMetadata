e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spyrxHU3LjIQ7kNvwFGA6rx&_nc_oc=Adrmgb_As7a1cyhR1VikERCXnOJmxRAdXmTlxFF-lulyolCJCgtoAOG4AgsyCH0TxzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dZyNoM_7POhcAgonB4WKFMESOza7QpzI3HojF1gazig&oe=6A43DBF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3c402P3BTkQ7kNvwH2q6Xk&_nc_oc=AdrS6yz4kHZ1TazG7J8XMjt8kw1vWz0UdCNLFrmA7j7ffh90cIC56rWUYwPNM8ZDEyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qv7UlD4cc64CBAfjEAd9RpgGpb-H0WHDXGE6RFxOr5w&oe=6A43EB93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1w7OWHS9jIQ7kNvwFGZTl-&_nc_oc=AdrIDzdvdfJxnN8A8wpmuNJTEYut69nUtljadf_Xd1mlIRFLWLhRD74P1k53mgEEw60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QWcr9MzVsDjeykjB4GNwghbTnJjJ2WWuL6HnaI-mbjQ&oe=6A43BEFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBH3UJBZ2OEQ7kNvwEcCOv-&_nc_oc=AdrFjfB9kMbfOtrNU1h7EMv1oXypMw5sNkv-ck-ptRVv2nl_lGTEMf-7oqfllVlcgyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hIK4iUbudThgz4y2x4nN37_dov4iFesm2JKEvOPEw2w&oe=6A43C04A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRRPjErjkOkQ7kNvwGhBSk4&_nc_oc=AdpD5dK_snF3pybtbiWgqUqSn3YFm4UTcyLK5gW_dV0FWeYO-zte6cwMK9O2i9OltLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fpf6H6RuxePG6UhGosOYTPKIdL37A_W9IgXrxzdpaSg&oe=6A43E1BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
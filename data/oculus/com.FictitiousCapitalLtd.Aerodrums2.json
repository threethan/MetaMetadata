_nc_ohc=i6g1KN8nglUQ7kNvwEy0xoD&_nc_oc=Ado4sQOTaqK2B7zvTeiPfFVKkYlDXMnyOpF3o8etLUOpHU_OJIlo1ybes45c28c5gLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RfAMMo-FOioi83as0gl2r4IkCr_r5i3eDjOkRhTa9Hw&oe=6A355B79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGTLZ8_V4cgQ7kNvwECn9x8&_nc_oc=AdoeLnJ_duwgzCPN8hqgrhZ-HcPBG6Bp5AXjitCdQeZr7-flo2Y3mSIhJFXMg0r-PdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95i0pWbs434U0hll9rvXYBisz9rWB7BKbprNlwL7MPCg&oe=6A356B13"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FLJjRscK2QQ7kNvwFVbH3w&_nc_oc=AdoCgO20PgKTffNyddU7_NWU8QIvLd5622arbWaN311PreVNfKx1tjhWZsXV-SmmXwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CHVLlcBK2MpOliiSAY5UxcK5dvAqItL2qKujUYGME9g&oe=6A353E7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUQeTNNfGU4Q7kNvwFKPCbo&_nc_oc=AdqnaQ9o71DeHzq13W8xZqDcOlcqubSpSDBZsiwY3xuSv7KSCYZ2KHDAEEr1G6AIUHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D6Clgq5IaXLhzWlRe9r5P6v8YuIz6S7-BkfU1vixtSw&oe=6A353FCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTGHaMxe_Z8Q7kNvwHgyag8&_nc_oc=AdrVstGwks0BPLIBTUO2gcxxtXzL5pfNFL_GMpeeZhSRwiq8MCB4WcMm28AUPgWGOl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C_5yL_-ngDrhGcwBD4HQ2LV2-27SD8eavmhkI5G9b8A&oe=6A35613E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
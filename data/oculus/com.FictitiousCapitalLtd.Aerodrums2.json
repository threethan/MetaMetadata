_nc_ohc=HAcys8N34VEQ7kNvwEzz392&_nc_oc=AdpvWYbN6XAWMeRtMuo9i6ptGRswvNprQixIBlL_c6emXcSekxaAPN6kKTfQ37sbGXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8nopmF0ygQUPquyDKy6QMx6326iFKdab2qUDhQzRBUg&oe=6A64D179"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft7oN54e3A0Q7kNvwFPzkHF&_nc_oc=AdqdGxWm0Z3eQ644vrW6GWfrUTXkRGLPYuV2uMPQCbBjAWZ1IHcCN3g3T4st3-QoKzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLLrOlzd47_G9yAuScC_07zmXWPUAlar9qUNNqVvMxCg&oe=6A64A8D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGs83Ot9Oe8Q7kNvwEys_rX&_nc_oc=AdqgYufSEg14mL_PICBcqKM-WOHV-LtQsHtE3PUZBTGQL3VEPWL9kPDQJFtLKytU_GE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvhWdFliZpeHguajbvOrumWmKVJxnn194k1_lo45EyDA&oe=6A64B47B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=susUQ8YLy4oQ7kNvwFVvUN2&_nc_oc=AdrLsK56AlpK49IUH4I_HKpuhoMMnuqcQldovK5BtIbu_QkZR8zLrkYETpz6A7SXYR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLB57K72gWmi8ylYpDsOEIZ3zFD6Ws8hGrjXwV2m62-w&oe=6A64B5CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1phkHNE_vIoQ7kNvwFN-lhX&_nc_oc=Adq6OXZJiY8FPhESoRkXefeL8tAqUwp1Ku8jt2NPsWtkQehSGkIH8P9ZZSCx9nnlnWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX7Ozu995haO9KeXLO17QOSZAnuy4BAEHRXNjjvarAJw&oe=6A649EFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
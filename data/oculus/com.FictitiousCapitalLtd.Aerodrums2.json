_nc_ohc=yalozcEhJ2kQ7kNvwHvSOai&_nc_oc=AdoQ6tOw0795BI4pcOKaBxzsI5T3XE_hKG4-smtU0v3HHlslXma_Z6gXevhCi4J-0jU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfN5UhaopDjdblGo24B31ElzNCtDt6El4Ny7uAB484ow&oe=6AC66079"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMj0oZZDVhsQ7kNvwEeaBRj&_nc_oc=Adpl5JHZL-F2oYSSxliNKPiVRhQY5Arv2jfwn21gD2BLTWtMoFvYnroFqfJFcY65pFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfBmJoKvTLZFVDX2AjkWiG7vFWnAXWj6PEL7xP3JI48A&oe=6AC67013"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu4HDfu_0rYQ7kNvwEJfd3R&_nc_oc=AdqZ3HS52hEFB8qY89dHbAQuXC-gWrejwTrUmTr95uJXHuSgHTqOkT1c3_h_l4yXfpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd2r06jEZ2Ey42LviE2E1B12lY9qRIBN4nCR6c8omR9w&oe=6AC6437B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZCDfMa9qDwQ7kNvwEI-Fsc&_nc_oc=AdqfGowHrSHb_2FWCwxkvaHRLJLCVoE7DZ0zwDiEHW_19rHkoHNSHjcTv9ZD28Zgtc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONPKI8cyfe8DG8Du26rHIl9sJ-H_uU1CA-gkM0nQUIiA&oe=6AC644CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YjLtXAzRw8Q7kNvwHQPZQ5&_nc_oc=AdoTq1qa6CwSOVE2Rz93-jLpl5JaTN8L7pEdf3WAemlsjPuvu4L5xKFnRZjQvSJNer0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMRowpNcs5xL7O07Kz4fSm8YkXK-n3hf7IqdJrSjmR4A&oe=6AC6663E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
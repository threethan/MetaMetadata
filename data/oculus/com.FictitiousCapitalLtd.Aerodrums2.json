e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbqpRSPfvUwQ7kNvwFEuVC1&_nc_oc=AdoSc_o_oTGhRRqtdE7uZcnu7OCKhglBUWNubWDfz2eIl1BHwC7YpMTjapziNu-2ibk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0i6xivTXfe2Snsi_G1EuL_Ks0JC2iVpW2PgGb71rmQQ&oe=6AE755F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rvjdADOo5cQ7kNvwHWHsGd&_nc_oc=Adpz0Oi8xhdU8lQHSIrh5g19WXI-R0NDYuQ0dwCUKl5emzMT1eP5YljIoa3bMQ7HiMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_FLtN-c6gzwnudIbGuGiM3KDgbOLHP3Plmrci_61s-A&oe=6AE76593"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUGk0nvBP-QQ7kNvwHd5ocE&_nc_oc=AdprzoZqg9VMcfByl6dXfO8_3cYrAe4gWikjR9wHFEVapqjy2IuBmbgZQyRqlGi-a9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgopsbGq1M0N3jYrb3GM2lj_oAHIlvIkHoqZ_CcFSuGA&oe=6AE738FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTHUeIJB_gEQ7kNvwHpiWoI&_nc_oc=AdpqomYXd-nwMooUKkmRTPJuqk--0pNCIHlALpMPfQC8vck9vITErkTF2MU9Cr786B4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdC0YBYiFF8XyaKUgbsQAlt88WxFax8aKFmtre5A6_Kw&oe=6AE73A4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJIeV6QzE3UQ7kNvwEOyGqo&_nc_oc=AdoSj0LPTPqJzJ0VH4xb3ORH7Vit2bOTpiNd3mkOo0t-sQXo3HI3ozpQLm_sHlM3RZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZcXeXE6OOIdYQNasLy5fmZHuQZ01M810tLbyW3TGw2w&oe=6AE75BBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4jX9cPWkbQQ7kNvwHXDyRY&_nc_oc=AdrfPYGdrViR5U8-g5kbZgruSPs0UW1RZz_dP_VAD0nSIHWms9MXydY92HcLG891M-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IVLPtkqIa6TZwwUXH1mVCDS_rSbfGa2XdXI14s-IiVg&oe=69DA2BB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBFxzff1VE8Q7kNvwEW2F2D&_nc_oc=AdpHK0VlsIsXKFTCW1Oc1B_1CKZmjv-bI4dF4cFSwznXhJU4HY1SMNgaEAe1l2hXfPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R2-zuyjs4FV5c_gXNsgfchrW-VMlSCl5j90TUJZJMTA&oe=69DA3B53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cmeSd3--lwQ7kNvwHrFbVX&_nc_oc=AdpFDIpFZc6aMi85ZxhAO4U6vCrgFGO02jBW_H6p5nSkneDjenl0ZXkRAqKBc_PCz0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k968LqjB1G-8Ejf59Qpb5YoN83F96CHGySXNdzhhnTA&oe=69DA46FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSKzdNBq_iwQ7kNvwF89pCY&_nc_oc=AdpFswE302nJEnpsyAITo_nDPhf2v-X7NkVcdvmAhLTlXExCJRplCcRghNo8ARvyVNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cG3BF_dRFxQ5m4lCQYsG28sh5Z-L--BNYAG8omIiQkQ&oe=69DA484A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usOFgPRA09sQ7kNvwGgUcQg&_nc_oc=Adov_3OOvZDuoF9O_YA8496OnAngQG5DDVhnohAEFsfO28xJlQ4zaFX2HcOlO1z-P3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hib0QiFKvvixDmzulLLynHFnGHtkjVsemECZiQiRDKg&oe=69DA317E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
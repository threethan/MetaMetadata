RGUjaW1mqEMedz18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfhGd6wa4TKQcu-FEeyYzNozgzaVV5EdIOdkjd3eLKJg&oe=69AEAA39"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v786hzfNU_cQ7kNvwHdq52H&_nc_oc=Adlxw5k7KWhcZ6DtEZ59Oq4IVFSnWtyXhVRalTf3M_yhTaq51TLGT58Nkw_CV6aUink&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9JiRulsOMI5bcfoHG4fH_1nFthRLoGaoX8Qv9K9lKrQ&oe=69AEB9D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcqzEvte8WQQ7kNvwGmn2cA&_nc_oc=AdmewKoxFlInRerW3URFFwSqCqcdTeo7lM_C2FP6gcuC6TXJ6mLI6AY0yVhhewaEOow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqMfYTtB2Yh4WcczX1Z7LbeiXwOjLAbBtSsOIdvFFMpw&oe=69AEC57B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZqGLAIdcKUQ7kNvwH298zu&_nc_oc=Adn9uhVppoDexMCMxzJL3-zE2xtZ0CAqurU1u-ez0BJimBlOvb3LVJNj_N-VA-Fx7Rc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5pqg7fDEO0OoSRXvoJFvEwIs1lW5qorzDQ7kbklHp6A&oe=69AEC6CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZxdyNbiCPwQ7kNvwGYSymm&_nc_oc=Adn0PbFagQayWKAjcqo1Q4BcA7U0uRvVxJHsrGL5MARZ5VoW8xHqIgIT0TramfpJ6wA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTl57CbmGLAFm-GMKahwhO5-AGBoH7NcvQPFU3aFWKhA&oe=69AEAFFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488
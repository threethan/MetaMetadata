_nc_ohc=5yPsmlGqhZAQ7kNvwGZRh6g&_nc_oc=AdrOm64LdvTr3h5BrOSarQ6cVKXFhXkbAnfFlNr1wGTrumgX7Iu9yFdpY9CgPDcEbzw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgzqQ-8sjp4GquuyMA8q5_dne68_eWTW9vrF9-h57EUQ&oe=6A9722B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPBLgdYKVncQ7kNvwELqkst&_nc_oc=AdqvT-juv6IMiWvBvCre-o94_11BQfbiYORULbooA6X4a77MwdTTeVeSvf37YKqEE0Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOzVeHPfGLrzZWqzsiVbXL2uVw6m6T3JSQsZdA8sAuDg&oe=6A973253"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeO69pknCYsQ7kNvwF47DNb&_nc_oc=Adqe6oQLvgiXqxU5cMpDR8FztwoHwkoydmqQuCd5OGQx-pcM_iktJhsgf7UNGF2VIQw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN1WQ0sF1k1zW69QzXU2Ct947BxLPDUoBu-HSktT_MPA&oe=6A973DFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ2PoHGtkZkQ7kNvwE4QTSa&_nc_oc=AdrfWCUK8nhXDvaIFWGh04tFCWJ5QIEGgr1Ec4Hs5xENKQwXTihbHpZcMkXgMR_zj2w&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLvkALLfmQ1vbAPj6EPMtgKPgg389YJuBhhkUrEtAwNA&oe=6A973F4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r4h9kJIL-kQ7kNvwGTycRs&_nc_oc=AdpSNhp5J7du9jzB2FokPhvC7upcHn-4qBXM0Jgxn1tvXMc8AzA_soxjxQybym2IVmk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyLDHOsMohBGELilHhQRE7dJHX23yTU7FoF4msxL97kQ&oe=6A97287E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_nc_ohc=GvzDo5Y_YQcQ7kNvwEcoutC&_nc_oc=Adp9gZycD3slhgJEhYf7R4kOOnYAiMr911PS42jBe_MDBOTskcd_mz0CnAEGzvUQdEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0rAFyMPSSs7Kdec7hv9fSCKWiXlvzQ_7l3OLSirT9Ig&oe=6ABBD479"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok0on6O87lgQ7kNvwEBO3mi&_nc_oc=AdqvagcwZvqdv5RJKOGtz7y-4g8dqCMKywDjJYw1zreKMG-Qvmum3sW-PEsQRqk6LgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0WzgwatcXiKnFL4MwNHCRVjF8HIj27_IduZd_a9PEPQ&oe=6ABBE413"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puCnfvnZLLwQ7kNvwFGCVqd&_nc_oc=AdpVP0d1AqTJvZZW7xwNm7tmxQpyh1uerR8mCeKRj5DocukxETPOtd1K2F7eeau9jk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSJ_3Y0mw4GIjcoqIHU286fICNz8WDs7an2EwtBJmXMQ&oe=6ABBB77B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SUqtqxzKUYQ7kNvwHSPCXl&_nc_oc=AdrCBSqcUYvQbPpJeFjOCCrytwHy9Q_-x4pttqRlAKFE8DCQIFhtpIdx4C5SlnHweYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFOxDSj_qg5PHMkFUhCbILC6i67vInZ0Xz8V33-5WHeA&oe=6ABBB8CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQvmuMOw8SAQ7kNvwEWDIyC&_nc_oc=AdooYP0_EV1Rqt7OTkJz5TwDpunNIGjCv0IeCKQJLYpsNIwSplpZF1QFaT_-uFNIL3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHyMZAeq_MA8d9Yq-CfB4RvjX3MjJLPUGzfVxBZEDEHA&oe=6ABBDA3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
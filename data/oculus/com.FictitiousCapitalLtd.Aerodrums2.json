_nc_ohc=7gBMoNEfQkEQ7kNvwFWCQaX&_nc_oc=AdoAGECjCE0qGffsrqB0GpR8FOItb4WkmI1cUX8hhgI4YmjXr-6VtrkQ3p8hVv4d2sI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nXHRX-KuFXLzQx_oU6qHzCZZSBfe1Y0BbgN8-ORiM-g&oe=69DCCEB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt5IhUnrOtsQ7kNvwEZIdfz&_nc_oc=AdrcaoywuQ-rfBeuo0BmHxlp0HXXx_FiNnWdcfVdX-QlhEtFFVtjxvozbwx55gjqsOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vlBI8TCJbKriooIL9N7xTk4GvjbRVUxv-c7o_FV5KpA&oe=69DCDE53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cmeSd3--lwQ7kNvwG50IBZ&_nc_oc=AdpxP4EOJM9o1LzQ8XLz5kwMM_BJ6M1S0LaQOEsfKAfQqVeOefXU1QcAhfgcrhPD4qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DwlEZWosUeiixZehHVGvuScgErWSoyvcr9GiVNW0IiA&oe=69DCE9FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSKzdNBq_iwQ7kNvwEtgFUI&_nc_oc=Adp-CIsUO57pV0si0eB_cwv57xtGE8rIqd6qw-igUcKyhyc-fZR2ualq9s7vdK4n-P8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-n64tZSuHe4jB2MEuYB-fXK0Cc3AfC6gCAona3r4emg&oe=69DCEB4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usOFgPRA09sQ7kNvwH-As2p&_nc_oc=Adrsi7owpX_vwqyAvfkPSrC_DmoYD1rSLhWTT-qPjHuDT3oFxNqYvIVaXmA-EGIDBcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bAyJd84ivmgbt1Ou1w1bPykpAMtLGs0A6ZzyZbYYLog&oe=69DCD47E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
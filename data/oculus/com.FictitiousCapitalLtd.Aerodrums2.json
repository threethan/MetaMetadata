"https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVClXJgjW_YQ7kNvwEasjsU&_nc_oc=AdlHJGsML_NONLIaC9rumdGdQLJxIcG2taSA6tQ5DQGOW3NI-rgeAEgjlI7di8s3Lpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGrFa6hPGzezM-ZLw8oM4NCQoNs6rBY0UREC8bYF_DMg&oe=6999A1D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn5kHtcHQhMQ7kNvwE8peyD&_nc_oc=AdnkG4De3CMtc9QlxtZVQM8VjXdjuB1y1jMxo53bkv6_p2hLk9qyNl6p2gK2H5rG3mM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs7cwe9pgdknkj4B59FUG_2Ec3EeoYNNlEOY0tJ8FWhmw&oe=6999AD7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAFK16VI9bsQ7kNvwGGwLQk&_nc_oc=AdnxlrqlaOCOdldJRo6fiiTQAxkQM_-T49lm7EiG8RJQHNtwsDmxvp7NQ0zCW4Y1TWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsSBp1baEU2UvANfOg9w6Bh8CKGwt3i8cLILzyBjyhLeg&oe=6999AECA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4ARrdClxUgQ7kNvwGKdTkS&_nc_oc=AdmceIhchJg8Yr_TCAdNIGT4YLmq_JgFm_jSnOBwFMrcUwrBfBa3YVHUQYeKkI6i_ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft0pUUDF0SF8NYq_JS3DikNNF6JOreEFUjvQoGz1eHpxg&oe=699997FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor
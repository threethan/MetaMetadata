_nc_ohc=Ceo8JXPNyjAQ7kNvwERKvnv&_nc_oc=AdrvBvLQZFSx0Tt17zgqJx0HvG1Pm6KecxddXxmEPe6tudq40JP7THcIhqwW04hd2D8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRyHuZXk1-GnBuejRQNHolsFFAqjM8k2R2LHG7op4c8A&oe=69CCFCB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1sTu2vU9nAQ7kNvwGOEo6M&_nc_oc=AdoXWmNmIkbX9GeNoaEEAa0tcnuueeBocBYDtJFTO0u1M5eJDTHKKCHq6rTl0FKwSy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcHXouaNLfpRrRJCu7CP_hdQhEaovWtoC7pegiD0jw3A&oe=69CD0C53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNg0boUJtUgQ7kNvwFN1pzD&_nc_oc=AdorLgyLgPQgof9FgjKadQ9mU0UlmE3gV7ewW1JvcbQkM6IGvt0MihkruK-28bEN_F0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFWOckLQW9K05Yy2AEx294UL0fR2Ot6-R0WCbKa5DGew&oe=69CD17FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-OvaHsUvJgQ7kNvwHWL5ke&_nc_oc=AdoieWcYDPSmw72mVj44rzhRYiHX9y4jYCr5iwJgZXccMaDnv-kDiV62VFB1_9OLtcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpihXhoOZG74CK-2QsA7Nbu_61zBw78Hl5DsUhvhbeew&oe=69CD194A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8YiVpdVMUkQ7kNvwEDMJRG&_nc_oc=AdppWkAnRVtErPFri04ScYeFY2R20c8NNdEwqvne1T5hrus12I0p_S8WZCnv9Exj4s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgjUQffjmIgtvGHgVrPX_75FU_WZTQun5qUp2xdnFmnw&oe=69CD027E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
5"}, {"file_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZjM3sdTG90Q7kNvwFPOmJn&_nc_oc=AdpbAidxAsZD_W34wjatdQB4o3ECfue8NC8J-tqw7qG5U8aKNpoZQs547mxJd0B8Yhk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwPGDmLMKuDImjkkJh7_rvLDZVTosBUSzOAR7aEk964w&oe=6A8EC939"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVWadgW0v-QQ7kNvwGAOOXi&_nc_oc=Adp8lG51H-HsYRedagfHv8hS759rRZxWVQ4IY4ZmzL8OLbrK3teRBuY-28oadm5gng4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9YUeJF46rfM2r1JF4Jhg_m5Pmeh6kegVVxiVOXgu_JQ&oe=6A8ED8D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBwSxXt5BRsQ7kNvwHdnAxi&_nc_oc=AdpM3WKEzm7maUZVmLqNSzGwo_4nAzq2tvZEL-lfHMbIwtXQKxhtz7np_LVm2X7m9A4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDATg3ch5xfao2HqFnYgKU76I6QHeuwYIj6E6XcDYRlQ&oe=6A8EE47B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AY4e4CiXrz4Q7kNvwEHOQxS&_nc_oc=AdoHe2nN0wY50Tm10ntwp2sWHWGAwX6qs77GD49hz-TjxCgtsiy48xBIKJcDcS0C5Xs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuZgV1odWWtZVS4Rer-FmaPVPXuHxGNAIDyeU3TQJWQw&oe=6A8EE5CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL-4m7dOoM0Q7kNvwGEKt_k&_nc_oc=AdqLp0KBypIWOnDrhdY0nZphBo2n7a2oAVB6x8fjNIJLXE4fzp76nSfv-BQOacHtPKc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj_iXIvrrtoSru6ezVWtzLSKimTTqPQA7KD00gPmz0ag&oe=6A8ECEFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer
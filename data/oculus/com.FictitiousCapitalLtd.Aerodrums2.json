e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KomyN2wvRH8Q7kNvwH4-qU8&_nc_oc=Adp4Q8OwsZYiyXI-m6xyuNKX4rCBN2Vzcro43DmwfuW8Lo7sVhls0wqc1kHWqbj7U8E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhZ2katVglvYoWvdxmRCczGASOILi2GlU3cvIXeMgrWQ&oe=69CF9FB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_y3tfKOVZgQ7kNvwEThEj2&_nc_oc=Adqzujzd50f-kdGSwmPWPtVNxhkEzInflvTjWnmahN6c2VaJTEOKlNvIhdx9-ndn2UQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMrOKS3n6KSZG7C1M7Pl5hLb-oeDYdpJo96JgMP1P0ag&oe=69CFAF53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEYmWIIruUAQ7kNvwFFmcpH&_nc_oc=AdrpDCpt-C89s33zkrhMWAX7Cfp2WydBU-7kojPLjkOYETpgh72_Q7MyvRS_-U-f_hM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyD9RWSNpUylFxyhzg8d4xUR1U8buVmgDNxfJI4a0OBSA&oe=69CFBAFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1piEkGtFKYQ7kNvwGJoe6p&_nc_oc=AdrbKvpyeJEaoWoOI_V9yTDh52WZnM_1D8DTah5QPVihn-jiZwFYQHs_7_s3XjZd0vY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvYF64_gPj0K46DbAfKIaVt6zpZuIjqdUJKHm7rR8XXg&oe=69CFBC4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl1U7rYTvaYQ7kNvwHi02vm&_nc_oc=AdqyFHahEhxMx5Le4ErkM7WBl30vAMFOQQ0mQaiv2opWpxg6dfZfKz2Ua7VBznjyvSA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz04o9fdhf24wnKmYdl5g0nTYGnJKRtKqwtO2HwxJ6GYw&oe=69CFA57E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
Ex-x-jzSKFun0kxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVJDw_KCjeYlh-D5hf4JV224n1lIFjPNEkkr3qmAh1bQ&oe=69B3F039"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnEOcLUgYcAQ7kNvwHzRN7z&_nc_oc=AdkJ68LMq506Zub-QjzkmM3xltT-4S9Di9k2Td9MQKav_H7Wg11Bfa1oCq4C3DTntlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3hU6pZakWu0wgmTc8SoZh9mLhsMhmA0IGOiXWrpX0QA&oe=69B3FFD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LB6vkdYbjkwQ7kNvwEC_zzJ&_nc_oc=AdnCKENW2fcgi3x1kGW_mXicASjgv6Rx-2npLnnvyj42gDLdNdfzk7KDf0F-6Osmb74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzletOCreXVPAoMyxhKe70WSffPPRIOF35zZzpNBrxyKA&oe=69B40B7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZt2jujFfJUQ7kNvwEAoENm&_nc_oc=AdmHr2gCliKquXq8N-QI4QHa_y6p18xuSkiNdN_cz45EVZ5ECrqN737_3MaGREqS7sQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLrcAB2xGFV7rlENa5mPBCyAB6Y_TZG5qax1XYyoFvyQ&oe=69B40CCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b72zF8AJ8-cQ7kNvwGPsVOB&_nc_oc=AdmbHB9JBMC-R5x-PHPW6ymgrosmleLst8xSsbrzTBnYTDtxAGyHYG3OXfA3Y2DmTfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8D9h_z0dkrfLP_LeKbKkgTJPakijLC8kUDBoeuuJELQ&oe=69B3F5FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488
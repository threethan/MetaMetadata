_nc_ohc=KomyN2wvRH8Q7kNvwFEPAOE&_nc_oc=AdrrVH9O8mE4_BDdrQjsqF3IpoY_gc5vsmvPqQpvONWQW21M_MBEcojlX8jNcFhDNYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0miqiXKoOejQM_-cHc8lICa9yFRZYJzfbM0Fn4YvPZg&oe=69D0F139"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_y3tfKOVZgQ7kNvwFR45z8&_nc_oc=AdqXoQa6gMiaLDGqavoETyA2h9XOrHtszClsilCqUAIZBem0uLci1tEqlV1PExZIvFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8g2LBrZoixws6wMNMMXY4BPBUKvbnAks8jbbdhV2N6Q&oe=69D100D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEYmWIIruUAQ7kNvwEUa0M0&_nc_oc=AdrVpiWppqSYpIDefUshtvja6FG8YkSSKthkoqNvhQAP1szyZyzkzgKItOQY8kYx2y4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDLTEezwIwCBgMWMYBTKYjXHMeVts1V8H_wZVxuS2zew&oe=69D10C7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1piEkGtFKYQ7kNvwEnzYE4&_nc_oc=AdrD8yCt3m4vfGTqRIJv7zBuqhDZ45u5LCOAT6notGRhPqQCLIamkzR4KS8vcPwRbTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxc6fWa09wacqSK0dXCLVuDr2Sufoyjq7hkWi7KfQvaXg&oe=69D10DCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl1U7rYTvaYQ7kNvwG6JtNo&_nc_oc=AdpWl0wvpMOEC04G0KU2qdDa0-zf9WEpxo247ZvtdEeuFjgbjf8WEYg3dJ89RdzjtkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOlZcssAY8x_2y0_JKm7Qt4OXJLev6MOMehvwp6etfMQ&oe=69D0F6FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
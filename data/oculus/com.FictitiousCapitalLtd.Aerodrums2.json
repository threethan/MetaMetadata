G8D0ghpEHx1bLyJM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzcg8ijSbhxzp9coybj9rKS9gLmYYPvUAckMLTQSfWAIg&oe=69BD2AB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDcI-Egfn3QQ7kNvwFTv8ha&_nc_oc=AdkRx1cOH6Bivham9PlHItkhTyatjzO96i783KXSnHH0wOEPHMNZbX9CmVvn0mAKi2k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmqSmGM-QBtuJ_oInSR0AVeoU_JB3f2Tu2l_kCcaFQ-w&oe=69BD3A53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJnL1qRLQhIQ7kNvwE28bQn&_nc_oc=AdnPvNt-Gi6tVgY1k2yS6ewSJNF1Avd61I1UIJDp3TJOB2YJ3MVnCI9CpDLcJ5ylLNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz18CtbrPoqrRoEOPtCxpEcD8W_95pacphx0Agml_nkSQ&oe=69BD45FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiISM47EALUQ7kNvwFE9FWZ&_nc_oc=AdkyO--o0jdwobZa-0XWabTNwnNUmbfaqCozsJppxj7VZjoarJEVUj-OQpL-vdPPrDE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-MNZFSNHdkhzd7BUREG1xYEH623G2mR3TPbUm4QDzAQ&oe=69BD474A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNxlrWRAZFIQ7kNvwGrJqdg&_nc_oc=AdlplwH7zczdsoH1rrU96YOk5ZZyrLhtJKpqsSImdSueVFALf1mlMV-L0QkBQGTuPIY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoW8jQOKCISrrDJhFkPB8mG5wxGyXjnEASwJVeQg8FMQ&oe=69BD307E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzR3YHw4ukoQ7kNvwEZr8GH&_nc_oc=AdokheN7tWhIrJgPS7c-pBdYjSVRtTBKHMRW3JOxeg3k5kd16otM_W8JMA8b-ZAKUvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK1nki2gEp1_qAUqWw2KyEMUihNmEX9tdCqiblRgZzmA&oe=6A510AF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxl2HFpLatQQ7kNvwGovlB4&_nc_oc=AdoPwNWPVoR-0rFnj-i455YTtuY9OgWjJecWn2WETQZVfUobsu3kx-7_41ZC2O0zF2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwJ24ZNRHRmuU9Jx8lxs-fw72ddw5s-6wQlUJwVSBjkA&oe=6A511A93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpwFLxYrZzQQ7kNvwHH6JyA&_nc_oc=AdqFUnxavFrHFgawPa-2jQJ97GdSSVBAaezBlLX7Wbfnu5D9Bw1XSyYavy8q2Mt_g8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAafs0aoFiC4NS6T6R9_2VPiFTdsCI0EEB-hl8mQExqzQ&oe=6A50EDFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxdQOzQfdtsQ7kNvwGqoqnz&_nc_oc=AdrG8qD1Y5jKEoEi0pKyKvMX5VeLdV37B0DQDebynNGOrUe6UvCY0pQ9RhTkYIfkAGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVhV8itEQh5Mf-dT3HW2Ii_GpsqYrbWIUBuvsLki_6Dg&oe=6A50EF4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcNtPS4yP78Q7kNvwGFOJFd&_nc_oc=AdpkR83WpjKmZurobOn5eoTG-2gw3vrux4pk_Kf08BxgbCcdjnssUKbCZ6e2rxKmvKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg5UV0St75qtA3i9Opv__bett2U8AXqHvvRMit-weEUA&oe=6A5110BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
_nc_ohc=yalozcEhJ2kQ7kNvwFbe-h1&_nc_oc=AdpxXMV6BaUivRiqmgwhYZvp5TzRBi9bjodfP4UElmQfl-qjWVlQvq_iS74QZCQmt-o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWRtp1X8X6eGn4f-YbVDhZ69O3UM6JvMFCOCXUJpcLeg&oe=6AC7B1F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMj0oZZDVhsQ7kNvwEJx5eS&_nc_oc=Adps6UkPT5mu5DefI0rDnmHffvu6-qOG7CxVOOcLAqz3MjV0KaZh5nKXC8bY1H2TPn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6PoequenOhOvXNPofqDjTiEpYhTQu6vwnz9c4ecpfKA&oe=6AC7C193"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrzQtZ7-iLAQ7kNvwGD3FBY&_nc_oc=AdocV9Fev_53Y-qwQM2q8ddttrbCskh1G4spIZ0y9y17oEOWJH-TR7w0xa4I3_3F8zA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX7uXLLbTp1pZMAq_ck7aZZGTe1fpcOfyrQoNoVgs0mg&oe=6AC7CD3B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2PYtlx3L-4Q7kNvwFj1EUa&_nc_oc=AdoxKLkJCF08b8hHo3TeXWAS10en9gtycvdx-LV05ejxLByYV9o6WV7syypAtS0fCcE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-uXWb4JBOlx3PcYzXJa5iFghSXaekLs4jYwEWZpJTKQ&oe=6AC7CE8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YTBJYk5b_UQ7kNvwFPH2Zd&_nc_oc=AdrCH0yx9TjHxU6vrBeVzghHEZQ3Xt336FvzdVrjSzJ64HrMzD9Sqlu2TM36pYhS_nM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNofmvvxjOtnbVfYBh0FhPP584yiBkApV3ThpkjkgZ8Ag&oe=6AC7B7BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
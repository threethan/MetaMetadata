e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyAWcy3DGCcQ7kNvwElIGZ2&_nc_oc=Adqa9KX9zlpuxues4QmNq7ojSI94XxWiEfr2LoEOFZcxv0TsoFZFYYQCzsMSDl5_Ufs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_OVRL2L6ybeudcy2iLlBs5ERaSkH8KrVENE1So8S6Hg&oe=6A82EBB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihjAQllLs4kQ7kNvwG3fKWD&_nc_oc=AdrivEfrySbVRaJ1uWqlbBTJ6jv7N47ZujnIHxoMOpGGWM_fppiT3Alr7t4w_M6DgKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGABldFIhCzb-vyALty4GqGf3Py0MlAFBbMM6T9iZ5Shg&oe=6A82FB53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inHgZVzbqJkQ7kNvwHPRjs4&_nc_oc=Adqy2GODv7tLb_YHpShWqJlVVpnuNV8AWAXxe_TOjW8pKUU7Q7pOHL0Hm6K8PUioP_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLWWgP1kv0QhPPbBMVd6AgP-Brf-6UOOYm9XlWwX6VEA&oe=6A8306FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_P7A4RpkWMQ7kNvwGIfB3k&_nc_oc=Adp_IWy7Iq34bwzOCvklN_y5N1AxpkaecSbhnVH_Af6r_qYjAsIQiWfhpu_x47wQjiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEubZUrJab9QWYZvBXDXk2TgpS4wnIYASyFKAnlrc4qQg&oe=6A83084A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT15q69de7sQ7kNvwH_SNNi&_nc_oc=AdrG_iTMg1Y6ucTYhYh2e_aPTiqXEvE9yjJyQeO5TLqYRNg6RFJ7zS3Y9E4XbabWKbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8LCjVXEhNIfFMEqoWsnpBugvJDwOYogsYttISlG0lTQ&oe=6A82F17E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
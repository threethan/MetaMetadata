_nc_ohc=e0TRYOOXm3IQ7kNvwEGneWE&_nc_oc=Adre8rGoLKwydZolb2utQMp4dgC-ROCFotd6U6vXMUr1149vwcxbGsT0O--lCLVxxfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLm6f_CQv_myJ9FKC-cKH559UWYYLDrdCIlgDf76NSAw&oe=69C90839"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=378uJTGD0gcQ7kNvwHl5SX5&_nc_oc=AdrxYVuOwujghyVMbywNwfspvfKMffNpkEqUDZvhUMSf8i8ekli0jTQ3U2CJwQ7id4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afww6LWXc1lsEpmCLgakcFHKcAIRDEP9tTlna4o5DX_5XQ&oe=69C917D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgGIZfOi4zoQ7kNvwFk0-B1&_nc_oc=AdqB-yjMstKIS5bVbxiS8ebBXjA7hZFpapBCu2wJMgEguzXT0EDUPjzNf2Q6w2Pe_Nw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQShA1VFPkVOwy5GPnHCl4lUix47ce-pSMk9cNkBp8pg&oe=69C9237B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lodSokkHS5AQ7kNvwGT-teX&_nc_oc=AdrqFpJDn0lgs7UBCdztWQFZQV3OhkjWOGC-iKOWCzPMqscMhua6nZ9eNXMLcCNrevM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtXmYUz2HK0r5tyCCFLi-nKaFWcdQRjAB0O2e43JOa4A&oe=69C924CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvmlhApfGOEQ7kNvwFSVMOF&_nc_oc=Adpt4QHYGAwYkQ4kpO5Os9IV136u-g4E6c2s12-ZiS7BX6udpoY1o_1CEqNwgfmb6cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEPuaiivNBPJOTxoWbiQ3jMA2LYKR1BpnQ-ykujdDZjw&oe=69C90DFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_nc_ohc=sojdkhISv-4Q7kNvwEA7vRU&_nc_oc=AdqL0QMUhsdyCYZGbo4ZSaZa4eOKi-68Z20esigapSwTe5nWAOOjlnpTCahKKjKpM-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInUWKqMEoIlY3eTE25DjV8ryLVbacNJ_feWYESZAVCUg&oe=6AA2C7F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5HTWcgIEbMQ7kNvwHef1E-&_nc_oc=AdrpWMKMN0TjqwtmmdBcOC-JR-RUQyW1sjSMTgq4NciFx-yIyzZLGiTTe4J1nVVWjpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfSpVimrJ2sEVGC7UOoP2j6fqD9miuoVDE1k7R7PbG3A&oe=6AA29F53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5jxFdkqql4Q7kNvwGo8wg6&_nc_oc=AdpnA2-Gjx8n7bsRzCCw6eywC7IuNvHmYQzxLG8wcsFQVGsm5_0uZ-CMb3yDal7iwqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1pRW4DJA2jWseVFKQkzsGUeMe9LLx_TTz_1AEhG7Bpg&oe=6AA2AAFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d82ZCisR0YcQ7kNvwEplHzA&_nc_oc=AdopqW4ov6mL-g1nwQsjYihf21frlmiRFFJgqPB2uCPHqIs0PLCay7HsdnafVdnU8mI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUwgfk46tl9N11A7fP0yY1gw5FDFfVDLZBSvEh1Xpjsg&oe=6AA2AC4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hduDb2TjKigQ7kNvwHQiOLz&_nc_oc=AdqTUeu1QZhcHrlvVvn9QKxaKFjN9TMlP99r--1CsqjYd0ntgclSCN6iEO7tm64ey6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy1f_lH56dlrhZs9tR6RL57rrdgBwmmG5ZJ1EuSxNlAQ&oe=6AA2CDBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
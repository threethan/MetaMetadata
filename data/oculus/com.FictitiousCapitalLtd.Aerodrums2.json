_nc_ohc=5jaOJpaaNUgQ7kNvwFLrd2S&_nc_oc=AdossckrW8ItkHlTUz3pO4kZnK18uD86eXqaOYPrPCZXZzDdJvMJ6O3YJatFohjDba4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrjCgBm4qiu7Lb43ywAH3peOfdaMyISTlEAGMQ8kmxFw&oe=6AC11A79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUfCYy3HeIsQ7kNvwHE8GHU&_nc_oc=AdoWP4hUAr75gQ1_xe1a28v4nNqtUqOZxzmgMG14ckw9GFmLNN6KXHVTMIx9VW9KZvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVWZkj__VvOfhnEMSKtKudhBXqLljG7CGsQyNYgv2g4Q&oe=6AC12A13"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfYvLU6JLxYQ7kNvwHWOvuN&_nc_oc=AdoSdvsHqkwQjkR7eILkdfAFTtyDc5RnYhTN6XlxYa2OE-BGdG2uTIebFQi6dIBbVBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUelZKvdzQAGh71XIlZi4upkCpspn0IohjEjuojS0MuQ&oe=6AC135BB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zbiWfwssYEQ7kNvwHd0X4U&_nc_oc=AdqEP1n6_59ezt1YOzgtddhnHqC2_WXfM8mDDWxH0CJ0vJMjtFs8o-cqY1vsDChNxAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxZb7u859w6BfKQpSfmNnZzR_vu_objGb14jL0CJ91xg&oe=6AC1370A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rWG4q3yWmQQ7kNvwEaFgtw&_nc_oc=AdpnaExQSmcDD8kVceyg_P20YBfeXS0022i_-xXRN3i1HzjWrDPnXb-FAj7YB1GowGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8x1beCRF-4fRPsMP7nUOM0RX0VUMP2CiCDyqx0zPphQ&oe=6AC1203E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_nc_ohc=YwLT3U78vVEQ7kNvwGQCIQC&_nc_oc=AdpfY99ohwVu-aJ4IVqmOgNfriSNPwmlU99DuMv6fzaHgqCK9cR6EqjXMwHvhOGlIww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETvHhgeCkS5Wp5sWXnzUSBcBZgvn__uRFzpJ_KlelH2w&oe=6A7EF739"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CqijZ5wm9UQ7kNvwFlu7Ka&_nc_oc=Adqi-yHxirb6vBpdUgSEcVGzSn5oT-YOcHqnQtiJaOVJb3NjgfSFPAWAZKQwJM3KUxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGgkvIEFtvzWnh13jkv5BHGmuQFIJwvKrPqRZ451Y_xw&oe=6A7F06D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia6vRjw0jk4Q7kNvwEG7QNv&_nc_oc=Adpumago_-znxUrU3GwMDCA-ARd2drLnpik3hLJCDlPsCXy1nnHhJ3DvVYGfXmSK-JE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4g6J7q7tpJzCYznXmYmmkNE5seL3WWv4VlwmmnMRHwA&oe=6A7F127B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T0sKZfmKH4Q7kNvwGn9zWe&_nc_oc=AdoneQ3aiWbWDyobCZtCZuxWrV7ZMyGYJn2ROulGNRFSqQgZxEag2n6yd0m1Pby9Ts4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkQNHohVs0X7eU3gvo1TeUl7txr-IfuhPEQ56rwAFY-w&oe=6A7F13CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxE-hxsiYJoQ7kNvwGnhK7c&_nc_oc=AdquD-47yimYhOGbJ6aXBrG_1BPWon6xxQdPLNN3GyRo2BXzVo7s_KgQBF_DKZYdS9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP_UyQUASxmvfCqWpOgah0UC7Lq9pUme7LtRg7MyQRbQ&oe=6A7EFCFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
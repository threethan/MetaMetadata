_nc_ohc=DoHHGA5XOL8Q7kNvwE5Hgfn&_nc_oc=Adqarr3lVehTzCwu5AA0D_ZoB52A24t6MZzN6XTDMOmM7o80nZrmfASSoi1RLPF6634&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rrmBv4YuPe_kk8OV72f3To0I_ItUQNy9h7pI7FKT3HA&oe=6A15B779"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6E8l4rq0GkQ7kNvwG-NRFB&_nc_oc=AdqkPQydwfQLIDAJMvW2MtXmSeDR-8HzSSyUqG6HXPgrv_s9hpsaK9ac8FUILUEf9Qo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FVFqWQE4AU3PnWE3UHhfCJNwUrfRMCagzsVTdvz4wXw&oe=6A15C713"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6-Q9BI6IaEQ7kNvwE_inLc&_nc_oc=AdqHY0ADA0EK7jwsk1-_v_ZuJuighoMdiB0EEdeqiq9ZY51RGt07rzQwtdni93ONGVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z8zDKdi-CVbkLsaLhX87mQkVmcrOzKR3KAcMu3pB7pg&oe=6A159A7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXPu5D1TxFoQ7kNvwGUZRVS&_nc_oc=AdpLSs6PoIG2B2dB9rX5dL4ReIH1Zt75OAtzYhVIdh5w6GlioUWlCVc2Jr81xm86Dbc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v216bDmRXfMI2HulB4TTjX2ntKNnKvdSkEkMD8D5GMQ&oe=6A159BCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hilPzkUi7oQ7kNvwEOivhH&_nc_oc=AdpI8LFsHbmj8tyF2rEVVMwi50-dPRfoMHC1FDmR7vGaDO1OtlMOGQnrqHj3Yuu_pxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47cUbi98gZ6OVhhjh7HvS47htFIhs45iuI9vtmlNv-bQ&oe=6A15BD3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
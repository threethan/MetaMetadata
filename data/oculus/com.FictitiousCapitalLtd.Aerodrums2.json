e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5Asv4s3dP4Q7kNvwEq5DB-&_nc_oc=AdrLnGHXydGlZbDTw8zm-pZS8OcoXwbdQDhPcLbi0HBGU2Z3v1jwbC_ER7Fwqp5By_E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3C28gUSy_8AmVRCPYzhSB_XkZrwm9_97oSXaEX_7TTpA&oe=69E24CF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41oqh78RDvoQ7kNvwG1T_5o&_nc_oc=AdotTxzzm-9vug-vcdDGAj8_2RukppcqaTRBOpjvJDxsLEjfw8x60ZbJKedqJnW2ya4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mitK0jGh9MDw1pCIUwMik_oKe1YgMoCZ9nMQM3NoLwA&oe=69E22453"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8vKGiUdnfwQ7kNvwHI8BCY&_nc_oc=AdpWFxzRQ9idt-fcd2p3CWN7X5B5bvqhreG9-NI9goizXol6B2X3F5S5Frf6taeb8Zk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U5hMy43_edIIncL6i9BYmH-0voUfvI4BgALlvxpS0SQ&oe=69E22FFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS8x_9ctetYQ7kNvwGGeepe&_nc_oc=AdoXEIszTDyDT6kr4v64d2KodlaGp7WMSqualDRzYkpE9eftwessdyrVfG-1Mht2okE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06i_o8qjG5CmdA4coLtMoC-h6vNhtmZcCavOrf5ki76Q&oe=69E2314A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A881a4RIuNkQ7kNvwF2uJDL&_nc_oc=Adrt9IlU5e9kZYIdG36MFMblhGY7tRlUbGCxkYDKkyGk8Jc_OmzrhQ0zTTuYB6bQqE4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d2BGzzQRtOgAwXYzmoztFhBvUOX_1M1guFXJG9anz_A&oe=69E252BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
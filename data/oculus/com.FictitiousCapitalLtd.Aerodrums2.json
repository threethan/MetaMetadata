e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RQtzZSfpQsQ7kNvwEoKYPh&_nc_oc=Adq_NgxAiLu-OtYa0abig1TnPm6LFpcZm03rAJI4UAFWa3gcMIL5lFLhyePe6W24Dr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPxvdQ6ugaa4kaefwmAto4ZtO0HEZcb0Ioawhw-22zyA&oe=6AA80DF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cD88j9tDrPwQ7kNvwGwC0JH&_nc_oc=Adp3oltAMwpZeRXiIbmFTFDCLUflHY4CR6xcqin5pyYBI0W1PuvPD8s2SVWHnplLa8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIchFoquZtO3bvKqCANITcW6CHj3NQESbF90vqoRt7RGQ&oe=6AA7E553"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu_YN5UKtmAQ7kNvwHN1RsR&_nc_oc=AdrVc7rcRh12arayDDcXNgIPfoXn-EwIuuj2WIvhEhMjTNixbcki3V7TSFE8Sc7OyQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxu1p4P2OknX15oPk7FxUymXPYwhIKED0sC_K-e2fdCg&oe=6AA7F0FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT7K6_gOtxMQ7kNvwEVoeFM&_nc_oc=AdqcGLPz3200Az-jP_cx-OnBMVhRQuPfFH6PfpLM3CY-3nYiAy5G5Kl0yKJsPycY3Co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIls80Pa1x83w7jBVQha0o-D5ztMQc8QlHacpP3TaImQ&oe=6AA7F24A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcmhL944vqsQ7kNvwH5bLwl&_nc_oc=Adq66kRwhvMjdCzwKBSLYol1L8VAmssGn3pfzRiSGSkLxQVKct9GIKjelfTGosRlsg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7wOL0y__B0266YJ3q4rvBfTziJ0G3o2awRez6EVzmVQ&oe=6AA813BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
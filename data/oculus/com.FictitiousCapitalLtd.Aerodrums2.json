_nc_ohc=CbJ_jfAjC_EQ7kNvwGwhGAG&_nc_oc=AdpJnmD0qLr2qq3EDilKT9pOQdwPI_uBUgeJGuEijHeiYPTOFD6S8BV_wuaUzjqspJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVaUz8LvZZ2Tp_H00eKJeXdyZAQIPiMezH8S1BmGdHBg&oe=6A5F8B79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebt4qS2Ak88Q7kNvwG79I_t&_nc_oc=AdqwFCQdPJzbyohwEzsXEReqZUdzlMrhquUOp_VL-EAXFfA2pn_e0UI6VJ-1jSbByQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVYCaQ2_nMF8eUdPJeePJ_xzZPFVLQp9xBRqUF-WDjuA&oe=6A5F62D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa3QrXtNC2IQ7kNvwFOa9NR&_nc_oc=Ado6eGc_wvSJQQSi39A4avQghL2bewFbGs4x9Wbdx8yyD-wXui5si06eX7kiU5UoXtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlaSS51-0TUsVKuDvyh_Fl_kvnQRiByXrKcqa03EtKvg&oe=6A5F6E7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPDYzklrCAgQ7kNvwEpBBMA&_nc_oc=Adr9HWVT8UHex9Km6-dEOZ92vtg3oqQQh2Z9MUS8yOJxs5CXaH5TxC2AKJIbNqukFGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFR-wODbcpxludWc82Zta2LqJyyESTZqxHqfn_X6ib-g&oe=6A5F6FCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SCEt_XaC80Q7kNvwENIU-s&_nc_oc=Adr1dMJ7e4StGp9D2yG8EWtE8PxDPbiWqrwy5YMMVlSmpwy-wTyAsuuU-Tu20DGqhRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo9rZKj-k3ug2qMZHyOjGgPiIOj4L_auJe2hEAygXFgA&oe=6A5F58FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
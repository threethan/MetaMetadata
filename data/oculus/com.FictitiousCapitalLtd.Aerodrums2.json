_sid=6e7a0a&_nc_ohc=BRszXqPGODcQ7kNvwHySoBY&_nc_oc=AdqMgFgpMfcGU01-nMf86YDYi5qfO5Ra5WWY-ZnbFU35SnonPrhJu-PEasm4opx_euo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VHp5bKru0SoeG0yVWS67dgD_FFnrpp0LSlNqQbwmoUQ&oe=6A36ACF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOuR0jGNtRcQ7kNvwHhQ4yy&_nc_oc=AdomeSNqSLP4DuMe83dPETYHBmd_14EyGBD0id3WqUiIwW4P-TJrWV1fTK_OOJOZQ_c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wpaNfI-4qCG_2u-_2gaRKEMyHHQ0BHGl5eMw1jyDdJw&oe=6A36BC93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FLJjRscK2QQ7kNvwFfrCbF&_nc_oc=AdrHbnGGui2x5nrso_fzgnTPUOdou9AHKVfzLS2_pLMAdvgTcXiipOydgZpIqu4VHkU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JjOMvYud558xk7fNDjV1gygwkyqKQJURewpVqAJZDag&oe=6A36C83B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUQeTNNfGU4Q7kNvwF9Mqg2&_nc_oc=AdqTV9l0Xjs06ORjMXYnO-zjVjB0dmWzrcsv-kDuPoSBB3h2frKuxH4HMuJfKnPNu9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WjxLhJGVrUtwCd_LC2Eqs5xXDHcA69dxXMt6wn7tPcg&oe=6A36914A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTGHaMxe_Z8Q7kNvwFuZsLj&_nc_oc=Adp4U6OAiCCOWBXfzuIEYplcd14CKNQFksZuBKM4Q013UpsTH62v_GoNksb3tJe_F-U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0yYqmB2zIR3Dm7MkSTcIVIsa7r07CZaSWTui31rKwkw&oe=6A36B2BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
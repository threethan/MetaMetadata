_nc_ohc=LzRQzJnZUCcQ7kNvwGZrsdq&_nc_oc=AdqQds6sElqAGCMfd2DlOj-UHWEcUXCidZ1tdaQJBpfqlKgIiY8-YxCzTzrnzHDTgC0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IM-bJxVEjx7_FTJFRvGjNcVzWCtPKFWQ5_4p6E_ZGeg&oe=6A2194F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keygGi0GBGEQ7kNvwEb2qHL&_nc_oc=AdoVEeP-yT3L2nKdNKYNghiH5bM8B0I8evgg9UdzK0xqQwul2jwgjYIIi6tQqCHQv0s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--9eYn1YEFTIgdq0wGp2qeFHc5sp24f4cDImRu9G1Zww&oe=6A21A493"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o41sTYQnUdIQ7kNvwH4U3sS&_nc_oc=AdrnIdkdva9eDHRPGBcN2POkGRMsmdqxG2XA3b_fx1vg9bFzkWBg-BUkaqVkGXNe3R0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TT4DkQ9mrf5_03bkN-qRXUv1II5xG3pJpbzSTajqDhA&oe=6A2177FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=992eBwDbPmMQ7kNvwGDCwPz&_nc_oc=AdoMYH2Bo6w8zkBzLK8RbNxTXJnHp7MvcAM0FmK9i8xtkPMsK5ZGHmrkSGtgu1YaUc8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uEdho2VxtsK0_vAPSB4LLTG47z_6tMvrSStEHE8CTwA&oe=6A21794A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RupSgA95AzcQ7kNvwENPs0S&_nc_oc=AdqnuTAU_8UjhmwTCO6HNr_wJvNdteso8_Nb0lqm0RyLdcgAjH4bk05mK5rwu2prshg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q1HXXbqd1AkCXlu3pxAO8dBck9blqdmqs9oTnMKzPLw&oe=6A219ABE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
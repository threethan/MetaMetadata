_nc_ohc=LzRQzJnZUCcQ7kNvwE666_q&_nc_oc=AdoMAGAaC1CRaefus79-GSDMD14l2uQFNw-0KUB1i3uuMwFCHHu9xv_mbHjSqtRFzMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FFkjwRVflsQN6VHz1phIJmZ-lxNYU_AAVUMMuNpN6vg&oe=6A1EF1F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keygGi0GBGEQ7kNvwEjbZir&_nc_oc=AdrQMr85EtJaTT39eQndxyrIe-F4s5UcX10wVxsiF94bBYt5zwsyOg8ZRs0Dhk5pcdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FEc_K2cy0IEuMYM0f6t47ifZOA6-jNRHOzZJeO87Uow&oe=6A1F0193"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWaU16jiwpkQ7kNvwFuF8UM&_nc_oc=Ado8Pe0QDcxs7kSbf2Ek8Ljv1SKEpU-fIQr6w6zeAK8Glm5r_2F6FOua3_j_9Lk0sGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72qeNPy90Dmmz6V_CXI2FE5JZJKPZnQyncZPSf3nSMtA&oe=6A1ED4FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LW5m5jk9XzAQ7kNvwGmIqck&_nc_oc=AdqHPOZWDTDGKm6mIkZ6xBtWWt9TcgkHNou-osHre90y67DDmuNgkA3WpTQYwD1lij0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aTRc-vUWG0W6130twAPOBMlUWmYlfLg9cfmGNUhcuGw&oe=6A1ED64A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7_E0vogh-YQ7kNvwFkpCQ9&_nc_oc=AdqgLUd3HFtZhlQ-5ppjyCwBBtRXrGLR5OlkJbzYdEfr0Z_GlyFhd9U5RDoR31XP2Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vnRcmGsIKxoV50z6xhfOwgC0pN2KrXZgfRIr_JcODAw&oe=6A1EF7BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
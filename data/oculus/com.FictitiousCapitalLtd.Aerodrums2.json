4csDegN44JjGJS6wG3Zi3RDENCuuAxWC0lc-NQ91Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23YCTKQ5mYOraUNweHuwtvK7Q3o1EFfOtun7FerJXCrg&oe=69F1E6B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxwwEQTp2VwQ7kNvwELPUvQ&_nc_oc=AdoW0ee8RU7QIOD9Y4-N6DJwlvH6RmS7a2xlpl3uVuHMFr630rilxlhPJ88hOYW1tyw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XBW_oKCk1av-K6o2qtH5x2E0P9PeVQeMMfk5n1pb7kA&oe=69F1F653"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEBDkuYgw8wQ7kNvwFhtC9i&_nc_oc=AdqpUkuukAew4524c7zc-DgcOF15pUdBxlCDoVR4CY2QQPybfTyDRy0bBdIK2owuVXU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af06einDOHbW_bUg-rg-tJZSUIz12ZEyeEEHi64fRO3BzQ&oe=69F201FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBdeUfXTA1EQ7kNvwGwrHgk&_nc_oc=Adrl01rTePFOkcJ5DS-F2hPNoyvo1MkK6uFeZ4PeWnYf8Syp0Toc_Ji_t_y7X7BVhIQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2P0IjWk2dflD_CZxydAp0QPB2wNlezSEzvhNg3h7mCow&oe=69F2034A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2oaTuhJt7kQ7kNvwF3KxcK&_nc_oc=AdoL5frEp0_HIHwbijNc3VBs8YGgKR9BHkqPujclDs1mirugMyznneWcL4JUxH3yYtc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fjtj1w8zs8DALTlqVSjSsAK5MfzrINYhC8YEd2jkXRA&oe=69F1EC7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
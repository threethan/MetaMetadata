TuiKSSHCQ01Jho94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGk2D1Uvq9ERY7vshnW8fGD1Vn-u8L8cUIBpLU_qxQoA&oe=69B69339"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnEOcLUgYcAQ7kNvwEmTKY5&_nc_oc=Adm6uiapufZ-zzTnT4R9H-qsqbCKE3WoXoqFoKHHPZO0k7aGuv-q6uAU7527x_EoP4Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycO-dR-VhZdIwC-lyJBQonhJFy1ky7itNpIzOnKhsG4g&oe=69B6A2D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmExEAAHkewQ7kNvwG9C3Nj&_nc_oc=Adm6zxuFi9fm7iiJb5KWxwl1Z61EbVwru-J4chaMrv78Vy560_grE1HOqpM5bovy7tw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFzQDLUCPLF9QJDPuKTwb2oAEZY2PMdFrCc6XjvSrJbw&oe=69B6AE7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3G2VoAM3jAQ7kNvwETyJdj&_nc_oc=AdnR2kXUfyKUI2fSDQpTGU8B4u2aTo1R-78ryFTyHWHDsYN2IzZ05nPE4-RSL_SAQkE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrWuF_dPxSyjOAI8U4RHF5HFgjv3rssrp0AFbLFx9hNQ&oe=69B6AFCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-lnIoh9T1QQ7kNvwGsKS2V&_nc_oc=AdlSeM-o9EQAE5V_kg8ki4TpIPPg7k9upzgAGeo-40KDhPvRryXDu16LtGDaqjjdqoc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEwRESKc1BmE46DTSsNGgcV6S2k_0EdQ9y7WZ-u9diGA&oe=69B698FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488
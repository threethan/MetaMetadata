_sid=6e7a0a&_nc_ohc=RiLrcHSgPtEQ7kNvwE1XFBA&_nc_oc=AdotfFxaVENShfxCYLADLclu__mMYY2FEIpM6AanZ3I6YvVYin6bRdVEfMRixbQt2Og&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIynK-Kc-UjcCQOV-DbOP0kYRiKX_FVlkziGBA5nIsCA&oe=6AAEA579"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EhhGLJVzkQQ7kNvwHV3LJY&_nc_oc=AdrRLd8BP-CDe3WrnD_pfdo8looevn0NsAiYXpHjolpljj66B_mgufmoVKkvT9o3-LY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs0loazHb3-WT9jEmZUykWfnd3wVsjOOXII1dBYjNGhw&oe=6AAEB513"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoa_QXiCQn4Q7kNvwGwzlze&_nc_oc=AdqjWKochK8mYmaLF8I8hrcllasCOAPSDMHD82S101sIGtB9fqB5vJb_55q7_lE6R1s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTmCkvs8gJeDfEVwyVqftoYVUUKU7p-dhw7S33pkLYzw&oe=6AAE887B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yyc-z1tLgFwQ7kNvwF49E8u&_nc_oc=AdqLFqCfkWg8H-I_UswExn_IeFTRpb7jex5lCSnaj78yfbpR6R5JmKnsqMn-UfwrprE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzbtibCfYjVZeyEX5ph-l4slwq7CV7dPifGnf7UnWzCQ&oe=6AAE89CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUkEmnIk7CQQ7kNvwH1l_2m&_nc_oc=Adrl_nZ5fE-yID6hYq0r8beZAhPzAgSoF7Z3TIK2ovfCF9IKzjfKXCYvjdQHtMCFjE8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJllETvdxmn_VPVeaSxc-YP_WQNun1fBGfMEcE8VoYF3A&oe=6AAEAB3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_iQeKdhRt0Q7kNvwG3XZLN&_nc_oc=AdrOBR_2RKlkOy2PI741a349x09WZhTrs303z-sww72Bqz2_9_0k6jaVBq-Gdrosv1Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4TAzPwx_Doyn5C22I8ZqT6bvXCdN88FIW5uV_AVE_nQ&oe=6A5650F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEc0H7QPu-cQ7kNvwHrisIc&_nc_oc=AdrG5RY9QB7M-Yqri5i-i938x_R281fLd3Y9ACNXsYwDjIiqcVbh4eqFP_jNqIsUD1U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4L12a-pQKR8tWKREYc0z-imUTBoiwolIzUbeiTZ8H_Q&oe=6A562853"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EniyMJozHkQ7kNvwGfE9Rq&_nc_oc=AdpJFU9lA4Za3OtPCbz4Lj0t8zF5XiVE7d0OUNdO8WIfXPloGBHL4IENevKWoJWrO3k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfe-AlCAB69zx2_AEC-ccrzrmZXfZogF6VVp817FBJ1g&oe=6A5633FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9kZZmTOGpEQ7kNvwFFSR95&_nc_oc=AdrkekHqEntoTFLllErRvUVuVAm0t-grZd7zP5L1Sk-YWSuWROAUKJrcEmV1a-NSigg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8-qO2QhQOqmSMznCeG2L6Gk3ASmIOuxFMFHPYA3i57w&oe=6A56354A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWdW15Kbeq4Q7kNvwGGblr_&_nc_oc=AdpUKDRtA5qbHY2Ijv5zqgUazWrcwZlLSFIv5kTtgrdV4C7P46SZAULy8nyQrPy0sDw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2t3bcGBKG5DH-aODHUktgi61Tlluqd-VTKVPuWMiE6g&oe=6A5656BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
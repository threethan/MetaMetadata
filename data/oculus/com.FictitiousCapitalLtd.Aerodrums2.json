.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkHuWZeDXzYQ7kNvwGfO1qA&_nc_oc=Adn6UkenGgpmBCwI534RNHvNfOXhxjXcSotifRM0_PHebWbMqq10sY7C9qF_X6MlMvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afty8km8flAkU8vCcwO2VUUHjbovFrgR0MHgrteRBeo5VA&oe=69A6C139"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg1s0wCk3mEQ7kNvwEA7_Yz&_nc_oc=AdncMGKtlzMdjstYJ-aBlio3d6uxB84Te-usob8VvnmMwKaW5zTQ68eBDOc6EZT1tK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsP7hunEsGkZzc1jhou_Pv8mDHbf5eAww98b5zTbKL16w&oe=69A6D0D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_7iSVhPQ7MQ7kNvwEpHl9L&_nc_oc=Adkttr9C8O5J9-_ufJgESczGxzTnyPAav-6MGFYnZRQK1m10aHmZnc7yhTKbLJh8Ajg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs79tg_9xeCNYLvWyLHF4gAKMwvgJW4ixRFXJ0VvnT5sw&oe=69A6DC7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQwoYWfJpREQ7kNvwE33nYd&_nc_oc=AdkKuVPAFCSZKvPpKjClMMVkGDynGq4oMlR1JzTcqHX9U1iictiJXRInbjDVQFX8E-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqwKRXVbHTZAMkB1P8WfBl4JfmrAUVgzk8r3u38x_CqA&oe=69A6DDCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn0SwdYQf4MQ7kNvwEKIpbe&_nc_oc=Adl4QOilBWsNOrfx9nvAyNltqP1ynSjuEwS-PlAY8dfgn4fgYFj1Vlyhrj3jfJi2z1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLy2UpvSwKKtaA6oaT9VY9SpBppc3hDBVHY_w3jarS_w&oe=69A6C6FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR
_nc_ohc=RiLrcHSgPtEQ7kNvwHvRagp&_nc_oc=AdppurnZa3DHlWvLH4dC2A6RrE4M7CvXaLxd3JNBUkuXAdCXZuiz5abxmTpGeysdfr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9g36ncABbr9FlvVzuZG2yoDPhXMeyhUiZMzmtDxvr9A&oe=6AAFF6F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EhhGLJVzkQQ7kNvwHuxI1a&_nc_oc=AdpiEzILqqFR1RlIIb4svBEk-Mu75OQABwcwkSw7lFbGs-kslHDiWCXDjFiMN8_WV2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW5qJRNRkyrtFj7S1JWns2_Jphb46KCkr7werC1F4X0A&oe=6AB00693"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_LJHdYR_rIQ7kNvwFDgu5_&_nc_oc=Adpj_OBy8dZ1RjaWWGD9VypRS_ux5yUmDuw91rBrjcNOPhTjCLbNrLjpi_deC_Ya5v8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2SCyCMn5mg596XGlOSdXnZ1HsFEh2tX76jDTIgmqulA&oe=6AAFD9FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ar6oyPrBns4Q7kNvwGxhpsN&_nc_oc=AdrFa6m55rwFQ97Ist6n9v4xxlehnZ_Rp3NdmDI6ccEBdAB0fnVl9tXkHSl3kLQ5V-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv0pMPc6bqqnN4HrzRRboNo7IXvz58CxCWFMtyFahSvg&oe=6AAFDB4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZRHg1bQBv8Q7kNvwH2TLjM&_nc_oc=AdptZITxD5MteIrAmICD2PoztLnvgGQ9D6XpbgxbA-5h-eGByENknl47S7lmacp-Sog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPz0hS7lLnVJe9B46vjnZjAtxB0lGhgV23AhmyCMagBw&oe=6AAFFCBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
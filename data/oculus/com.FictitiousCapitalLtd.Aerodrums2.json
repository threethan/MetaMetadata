e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RQtzZSfpQsQ7kNvwGSUh3f&_nc_oc=AdoObgIkeu1RjVbyAmoJbh92toQaR4VKZ9laa0vt8SinrySwYtLebSHm_v0DxgFeANY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxS_N0CoqdoUwlEzTiEvA0t96Eqqeq4zsXTB3ZXHYO4A&oe=6AA56AF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cD88j9tDrPwQ7kNvwGSSAVY&_nc_oc=AdqcBFAFANLzoAHDpu-uZ1yPxAVAhj9pqUzSbK13tb2LolVqLYHwCPzuW_tkN89xCoE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzq_6g0qS9AR0rXVDIIMRSEIVz0ml8rzfAMvKCu8hd-g&oe=6AA54253"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNnNeZ6JCJsQ7kNvwENCdnK&_nc_oc=AdovTzUGC6HQRWeLTApEGaOHM7mphABqpZnlH1-y39LkFgC2JSVGVRt2hFqdLH6Z-Kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhrRnfxF23LZrytVJgNORTh6gxjpTs1jLrxjfxppvQag&oe=6AA54DFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnTi-8A4kDUQ7kNvwE1C-iZ&_nc_oc=AdqVuAsIWY6xk5X8pJeGp-qpGXkiipAjIslaVHxRUrb-dVb-bg5dTX_HXMiHA43wyKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWbStTAHirCtCaBOX29myfC_ObRU2UIDmUDU_bCZXd8Q&oe=6AA54F4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0glbwyCL9EQ7kNvwF-FMzB&_nc_oc=AdorDRxmVxe9I7QjHpF0yEpmr3RoEydYbWtqPaoGgvSwrnOkYVurcCy83uO5fGyf-EM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHQT8hD5ELFyjlE6JCM_qu_opkRZeAxIG1lhPT7AZLAQ&oe=6AA570BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
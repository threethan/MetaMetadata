_nc_ohc=XKCPMJylFEgQ7kNvwHYzUSo&_nc_oc=AdqSG18Nt1GE4vEdkSFqvdkoADecppaf-2NrjJFyTdBv2dIdB-TRRzLUqf6sFgdIxHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk6CT0s9OwH5JeLwvFHg5mU1iWnF3m84yOnq45gXY93g&oe=6A8C2639"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YERNmGJyQy4Q7kNvwGwX1HY&_nc_oc=AdpHf8_DUa3KRzzzKyT6zp621X7PzgAqyFoSRZV8dEr5QncmrUjdqCQhQwZmAeLRPNI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN0hU2r7JV_3vjF3tc2H2XdWMDMbpES2xaYWi7V4tMkQ&oe=6A8C35D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD-16W_QlE8Q7kNvwHYiMEU&_nc_oc=AdpuvePOKBmacKBhvhOQGMnuFexNf55vy88bz61tCg2vJUalVI1P5ZA_FHP5GW6npvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkEB7PDUeBOz45PPyUczBshSzifw1Z2OG5yLXxFPsIAQ&oe=6A8C417B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AY4e4CiXrz4Q7kNvwEkuaJj&_nc_oc=AdrwHEkOJdcil1JLBiFCLSium6wh7LF4KZYdoIAv_wf2uBv_03tofe9KjewmB-2Plg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPmtZ-nGkNhKBcOS8_RN7j0-2X5nS4_VxsrzWsYqi6Ww&oe=6A8C42CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL-4m7dOoM0Q7kNvwHW8uu2&_nc_oc=Adr2Ccyu6w9zsVcoGOA9oA7x0cNwGKm5l13DYocipLPms2s-UelD1SzTZfaoOIAWj7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-9AfxOSONzZjqNZu1YW8lx95uVhLmB04BPYMX9SCl0w&oe=6A8C2BFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
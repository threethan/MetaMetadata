_nc_ohc=u8AU5O_16RMQ7kNvwHRz3Wa&_nc_oc=Ado9RSMCVkfeTveSQibdZnwbQ3V-K7iWQKXRiFsM1F55QOQwc-SVSj5b7Aslr9XuOzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81lhFSO889ZDdeaNSmubi0CTTCNlCSFPmeADi5MYbyHw&oe=6A3E95F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZBL7b9mYwEQ7kNvwHpcECW&_nc_oc=AdqviCfkrKTGTuHYBTP3S3fAiwQMNbwr9mP2KAWzfMn5HRlbORqBBUy7bkTCwiXxaDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88et-stvCE70hUWJ20HtJ60wYvzUKGFY_5Q8J20ezRcg&oe=6A3EA593"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9kxjmihI8oQ7kNvwHwAku0&_nc_oc=Adq3HKz5FyjfrDyK7WzBmPxvRMnlKfTfT5heABLfL4WB-mw74tSZ3UdAGAg9QeW4XA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-49kRczuCC2q3VthfNm8b7-sW2En4hAAX4eZGSfu24Rg&oe=6A3EB13B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqWAGCHEBN0Q7kNvwFcoDBo&_nc_oc=Ado8wx7E8jtT-pzfc26EElVA5DEt5TCiHhuMt3c2EAAewWggI09jgVk_nwN6WS7wXLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kF8WQDEItqIGenXVeb1tbjUml8vwis45aWvpQ3YR5Xg&oe=6A3E7A4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQOkzFCjoakQ7kNvwH-xwnw&_nc_oc=Adq-4RfEOGkSjgdcHQ4qbM2K4-vc_jO6LyfabbsQh9kRgnVVPARZBfbCc2s-unyWa9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aPfg_yrlxwVJtjeuS0WLY70ZMYno6OpxoStuBDjRtjA&oe=6A3E9BBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZjM3sdTG90Q7kNvwFK77FP&_nc_oc=AdqhZLVh4uqp6u5oaAwgOLhGqE2F7OEYTE8TMmBFJUK8dPC7a9WI18lYtRyRo9Zi3CQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFYLmcjfJGGJ4vm_CRm_8kjpQh6sCnY-gv2eH0Ri2DIA&oe=6A916C39"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN4jPKYttCIQ7kNvwH-oAVp&_nc_oc=AdrCh4w5RlFmcbRbCR4fw6SKjyCO3z6WtU_ePwoykZZKIYVD6wuFqvyt4qjbdO_MqXQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNg9sTWyJNXfGQl_SZ8OAMIQB1zzo5As09_tZ7VRGs9Q&oe=6A917BD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdgG_JmxMpsQ7kNvwHBj8iW&_nc_oc=AdrVV_E0gGx4J3ThwJahQ-Uulp6yQAMDSQz0ApeAAmCenPpBPDrpyPMLUawStuhCHSw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG0o-B8mOOM6DX609w8mGOV1dAbBiuQhSLON08SkesbQ&oe=6A91877B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxqYmkiTkhYQ7kNvwHB6L7i&_nc_oc=AdoKy7MpIGJ3fZLLLS8I5ZpYQ8g8__gjqf1RPQQpCulgUFJAUQy-xqWw0tQ8VLpGAqY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELBHSV8o8okcBrkKjL5xZ-s4Nkfat9PLdo8DFD6H4N7Q&oe=6A9188CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMDQJzfEZwkQ7kNvwFYXhNd&_nc_oc=AdqOiBoHKafsq47a8oen4AJkzetofRHAD_Xe_miBQ13fRs8b1yZ0Eef_HzvHiuV1Igc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY3XjHK0OdJx1eVH55p5Km5H_tcAHheY1Evzgumq7Oxg&oe=6A9171FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
_nc_ohc=BKI_j0vjcxgQ7kNvwEtgaas&_nc_oc=AdrJ5Hdvlm2BoExwFSVQ7E_ebPXanKNmL_IY7SXIcUq3HGWtjjY7Q-OjXqs7mWeFTFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LxIhGCwAK9DymN0oDRYKib_YOIS-vbwNoFHARBuce7Q&oe=6A2D7279"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOeu5BFM1lAQ7kNvwF-kx0s&_nc_oc=AdowDMRyMIUh8eMwfSYl4OjvbCyhsC6OzqMLmeoRIWGXwSu2N7zd5hCcZjvGAAds9vk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a4ZwoNi0q3kdPG9Za2wI8wuxNUDofZide7ziu_jqnmg&oe=6A2D49D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za13ERDJy7wQ7kNvwHfhAyn&_nc_oc=Ado6Y29O4kmMhFcTFoYu_FGqCd9Jm1sVcsMfdgc9djC1jAY3gjgNt5mOyYwPqgSqVX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x0FdcLNvrokEJC6pH11pKUgRNDIAfsvF0O5vU2kQCuw&oe=6A2D557B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfJU4G3Wsn4Q7kNvwGDwIoF&_nc_oc=Ado-erzX40jbCa8l-z8F1laojuebsYDEmAfQsrUQ2J9Ssv9RZZJqszAYW3D5VQ4q48c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HYynXkzPo8UTZRahab2CNxrdSlxBS0wUnYUyVmRW7QA&oe=6A2D56CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYQO6GmcHnkQ7kNvwEyJ-mE&_nc_oc=AdpPR-hNd4XEqXnX1xb6_89KCFhaabiK2ixf52hd3UWGU9udAXIiA1nqvAgBN_9azdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iojUp8uA2CL5Gb9ar7amase5jjyw-57YUE5jKWfb7Wg&oe=6A2D783E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_nc_ohc=XKCPMJylFEgQ7kNvwH850_-&_nc_oc=Adr_irMWUE0UvRkEDIUcnVcRKgzrzRcWdaW0OjTuWb9kn7VJC28JdQ_AX0SJDg2nwF4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrWDz0wWO1ANoQurqQoPJlmvPfVzQj5ZLu5R1RX_Gknw&oe=6A8AD4B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YERNmGJyQy4Q7kNvwF4wLAl&_nc_oc=AdogomF60BxFUOU71eIZ9_h29HoUoPxSDtomha7HoNHv832zIBKhL9x-iQxX-ccqmMY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLV_fAPBoS7xKdcPm5rbwVce0doMb_EPPugrELQXdi8w&oe=6A8AE453"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD-16W_QlE8Q7kNvwG0kCeP&_nc_oc=AdogcTXCR1paY_o95v-_sAfkbEy9aRSjyuccMV6HuSznuWDOhpIC4mOATxNTUDloX9I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjPsUoDykQpMlvdQUGFCIE8L2ca6SOUhdJhbP9B7GDSQ&oe=6A8AEFFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GorjGQX0BaUQ7kNvwGAdtsy&_nc_oc=Adoq4alJA8oyDFZyGvL8GVCafK6wQxUXhrtKDT53UfyRDdDeYXjfEXKsA3HipYG8qM4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNXssPNuAGgXnFGGrQFZ4cMECQoofQgToGeR6LZRlumw&oe=6A8AF14A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nx33CJVg4MQ7kNvwHDMYjM&_nc_oc=Adpygix8HByo9m3ZilQv5KfZ_bFeSblJOT2sjD8rRaNWPyMOaxCes5H6AmQamaOSNL0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXaMeJnzqxI33aC91CK_Rf--z-C1SSEGyozfMA0k-nRA&oe=6A8ADA7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
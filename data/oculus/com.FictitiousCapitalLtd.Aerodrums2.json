_nc_ohc=DoHHGA5XOL8Q7kNvwFECZKP&_nc_oc=AdqF3O58xeXG77jS-RAqt8ncdhFrItyd3R1X7Bip1C_KSnWsWDNL5tgBZ5PzqEeDEgw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-HYNNoApO5_jl405L0_yax93dCPegzJgE6Q0QS4bCTg&oe=6A131479"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6E8l4rq0GkQ7kNvwHSCXCv&_nc_oc=Adqxjg9coYcImGlB29Qi8o421n5NQUG8o_bWQ7Owmj3tQFTvgwXcr1aTGq0ILroFxbc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wjw_rksCZYiS9d_u0hbYJLSuzAf6xWRa91EDCAN6PEA&oe=6A12EBD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaPgKVbc8UIQ7kNvwETLJVE&_nc_oc=Adry07sqijR0dmk8T2kqkwC01K3MdT9JJv4KdaQF0lwNC2QWUuYfgJZNJoqaW8M6ylM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68UgoguSqgy_VnlZ24EkVSiWJSz8lMQH58aAnWVCR-Yw&oe=6A12F77B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2F_dnXmYIMQ7kNvwFx-8jV&_nc_oc=AdqjPhOFiffCOp8i7JitlesRvgmtSnOH3mKSh7gzaogSWCeDN2jOwC-hwOGQx4c6K1M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fs7JMiDGpoc2_f28-E1tF7GvzZJ4JCMzT9NMHclJWxg&oe=6A12F8CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytxyNtbECRIQ7kNvwEfmh7m&_nc_oc=AdqLgbvtSlx2hihs13aZXYdxI3wtcIrkhlrO3KqGUgqLtM8BXzMbBqGVq-ADyV11EAc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z8lybVaq3w4FbJESXQOo7U_gfyZoFfBUXZGmC_Q8VaQ&oe=6A131A3E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
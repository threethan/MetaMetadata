e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRszXqPGODcQ7kNvwEr6vhS&_nc_oc=Ado38JYduWAoPqSVmUfPr01x4-GX-oQse_jQqdkja-uHInaBho9FvrQ1RaFjqDhqEtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Go0d4fhvokbO6hDsdJfK64uOlIhPDQEFGgac5jDKzWw&oe=6A37FE79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOuR0jGNtRcQ7kNvwHb_ql-&_nc_oc=AdpzdNWEdtQ441RhnjyBmO47TrvAZfpDxIgXus5kN15TiS98B2gVk1oGWbUIxiM0ERU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tLFrRIsjs8be12b3nocyZwnfo1E6TQQdLDtcok0uO1Q&oe=6A380E13"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FLJjRscK2QQ7kNvwFKL-gR&_nc_oc=AdqNrWhAac_jNGTLsqVVsurpuiD_LDvbA_4V2tfV81oQaPxRiIVx94alMRm9meYipDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aCVpa5fpHnWmH8u6XmOp319xQYGzX6y9SPiAyKgRpcA&oe=6A37E17B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUQeTNNfGU4Q7kNvwFou5Up&_nc_oc=AdrsqZQWk3GQDJ7rYtw9zGfnrKU2GCXTwjVIcLa3mna_jTeYmhtVTglVqk2Umc8gJMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ft8wF_vBGDvi2hzG5JcYqtuIh6uib2T_-cEqDqbtFdQ&oe=6A37E2CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTGHaMxe_Z8Q7kNvwH-bvOF&_nc_oc=AdqRGKNlaadjlmU2LQdayQa6RaFANsyC_NhUoLMgTt4a0wAaALSiwb0MlcxuA8wshX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d30eoKV-nS19y_vF9dHiwbT4Dbjz8KEvfXfwqYeAJOg&oe=6A38043E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
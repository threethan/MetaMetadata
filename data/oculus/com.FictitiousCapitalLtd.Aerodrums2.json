_nc_ohc=ZXsXXvhugwYQ7kNvwEPWwYz&_nc_oc=AdpHAkVA9xedNaC_9a0ipJLzokBBYJfBhdK46HSeuldYfw4pcN11-VshcpqUKmux4PQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CVxYLlom5B20p62uu-EHGRcPHtll_ehjw-Vr5zg-OIQ&oe=6A1708F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpXS0cq1_AUQ7kNvwF1aZkL&_nc_oc=AdrDEO6DxxqyfdTDzxbb2WC6YXJxt0nW6ntYnvWwVfj1PaMm-_NC5kScXH8bfsXubzA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TX8tMeUBy3i4DfcOgbaopFBXrXin_3TKpp9_GAQf6Ww&oe=6A16E053"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6-Q9BI6IaEQ7kNvwHJJc-S&_nc_oc=Adq8mFsvABY-tck_2OymC95fYoPu6lEG1c3aSRH97nPB-vyo3yBydhglzPO7mT77eG4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EjMvEKtZpkYC90w_SmzI7aRRpGW82l5341XM6em6wEw&oe=6A16EBFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXPu5D1TxFoQ7kNvwGHrdWJ&_nc_oc=Adouzwms5QxctBrbbfj5_5vdXU_58KAjvWc9GCHBZcEolKwNbibkSkagLCwNFm-TFfE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47WFaGe1m6_Yn7FIX8xccbmUWhMRXDLNein4eukSkKrA&oe=6A16ED4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hilPzkUi7oQ7kNvwFj9vAC&_nc_oc=Adpoaup7WWkcKavGB-6iIYC-NMkFs753uXJEwHNsSAr7v_8XyM4BhVtax4MpIwLC5IQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PSiYVe-QKf46M8r8ubOgga7vGWpeNMXwZmV7qpwgnug&oe=6A170EBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
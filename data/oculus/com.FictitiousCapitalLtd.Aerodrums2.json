_nc_ohc=Ceo8JXPNyjAQ7kNvwH691fA&_nc_oc=Adp_cNG2_fJQ3cRA-T_kP8nHn0FELY9pUQPSdHmw6H35yt9o64-y7qBeUOVW-fNwfMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyM-ItMjCT-uWdMI01Ob1Rrs9JuMsx9HNr2yXCNWVaC6w&oe=69CE4E39"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1sTu2vU9nAQ7kNvwGsBLN4&_nc_oc=Ado8BhSKI-JKMsPjv1--_pn0cLZvFdWA_pNuMga8RDix-B8tAvWAg43YuggxiCMAGhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMy2wWmnuOw_Kaki5WEUPqSBzyHnSIphHHV0701Bbbhw&oe=69CE5DD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEYmWIIruUAQ7kNvwHJGPjP&_nc_oc=Adr6dwC1aXbaBemApAfl90vapSLkdDCGovEAyyoq-wi4IbVYbijmxSRDyfrOialVqSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxS0AEuXnMWwxahfGdOVXw_72oKqhw4E1qvIdOte41l7g&oe=69CE697B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1piEkGtFKYQ7kNvwHTofZA&_nc_oc=Adop8Z2IQh1kTggyirdyOpLCnRCHRc2Ql-r8KmTRgv2oqvGw4tTj6E6ovmDpvEf9gbo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwvc4c8XdMpOnyItoeJJzlD8p5wIuezxRMla8Bmv1FG-Q&oe=69CE6ACA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl1U7rYTvaYQ7kNvwGNiu72&_nc_oc=AdpI6qtLXAcufBt2c2z-YiuzGReIJ014iB_y0iwqFC9gZ8RMBFOPaBIaE6Ki0SvKI2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAtePYC9gaFqmyfhF1AqclYM5_oS3ChLd0urNu6oKlZQ&oe=69CE53FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
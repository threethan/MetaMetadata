_nc_ohc=NwH2LSxaH7UQ7kNvwEIJVa3&_nc_oc=AdrA0ZRE0e_ZC-REy61vgcInxoGflgIy6AsLbaaOcoWCb0O862MATvg0oZw2TdUGxsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7EqYPDAu2Onf0iNEy8M2Bs038-2EAzljiIjTTnMeHQA&oe=6A7076B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gxj4nrNIrEQ7kNvwFi235o&_nc_oc=Adog9Sp86ugZ94FmZHe58RZ5DQUWyw5O5YNZctY5rN7tAnNXepH9fne8lF9rrcYvz8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYK_QuqIYC1TkyKDyJJgrGsOYTxCSWmDYOR3j1jpEP6w&oe=6A708653"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQ9tVxTXGukQ7kNvwFBGzFa&_nc_oc=AdqdHnZUSJ6pHfYfuTiNs5vwaCELqucD2Ry_qvqzKbZgNAm-5bjyZhS9gyrszom3HOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi4NACx_SGznu7z6ZOj41A1MNORKhSipfD_dt7by0Wqg&oe=6A7091FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a5nrY4D_LcQ7kNvwElh5wT&_nc_oc=Adrh7PlFwWOmUS4sxC8B9TV3f8iJ8TdSgvhkPw_redL8SWZKO_5-k_rbEHEPUodjnvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_m7TQyRLSWvsf9fnjVhLhGnBjNfdHh9K3rO_nOb7Ukg&oe=6A70934A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01bcBwIcz78Q7kNvwG9LadN&_nc_oc=AdrTINIPBxEkefOciOS6O6yjgeRXPm173czr8gTzeWeu-op2KFjLAeakd1veELRowoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM9puFA8cobeWfPWp8n7_GYkJcuFtwjSiv5NziuyqRuA&oe=6A707C7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
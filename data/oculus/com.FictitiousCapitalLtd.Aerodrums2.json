_nc_ohc=fWY0dso-oiYQ7kNvwG2T5iC&_nc_oc=AdrmX3w7GAcl-MtwU_MJH1rtTuh8uASIShgNqHBPIGzfs_FyyU47FeKsNIlRzGjBWQM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe8iT3ZEuHFQ-yjAq-rp64io1yVYZl-Ol0XHyVcmVqAQ&oe=6A68C5F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euQqOpAYuLAQ7kNvwGkDOyx&_nc_oc=Adp6FdWh6nccUTSeD02YML6C5AxkR64vRBBMTXnCFTuGxAaRHPBqOaLDmUiu2ZrWIy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAohelzmGpTQ9Q_9DiSYnOyxNWrH_TKOL905tE3rhBSqw&oe=6A689D53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pdu4wsY5u4MQ7kNvwFNmMrM&_nc_oc=Adp2y1ztQLlpc8abdUnG0V4rRvnmIKE9D6h-u8p2TLE3DFNox2fJxOVbfrlqFUrvniU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC934Sdt-C3F2jM7nVQecZo4WUtQJVdih6JWVmP-SgVw&oe=6A68A8FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuCRZJCYwlkQ7kNvwEphQ3z&_nc_oc=AdqBfU_7ajKkqnEnQ5lJy43_WBsNe8skjVsokMvrW_uqeYzI1MaRYAAeXiPlHF_pbv8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4I6Uq0SFMUeSXyyJuea410ElLcIMjB3oQ2N95ahCR5g&oe=6A68AA4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgI6jX34gi0Q7kNvwFzgDDA&_nc_oc=AdoazJzUSoPBWuST1WEGe4UpHLa1IfxkM2s-TSTmUR8X8yVHUPV2_bS2G99D3kkv_yQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs4xzfv6ncd67KpZLohNlyf-EBkvlXN3I1of-S12cNxg&oe=6A68937E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
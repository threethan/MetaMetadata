_nc_ohc=yRSL603RmekQ7kNvwG2yHJS&_nc_oc=AdrPcGf44QuDtOg-zWYCtP9Q_qQi4SF2jPvVM91CCsKo5f6O-cBgBqLUW7qcW66-Yv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgI7r1OZlyQ3fEX3lVoNl_HfQ1YBRvbz19_O_dzbMf9w&oe=6A9C3079"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLWUDNd6w3IQ7kNvwEmdHa-&_nc_oc=AdrCIeOnsoaKoz7rW5LQN50K3kH14fUQSQAXi_sLYCcXlFt01TLeeCLZencPTLCv_VE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqajZHtV9TJd7LaWEN1BdT6xflaKs5xp1DQVw7QUQXPQ&oe=6A9C4013"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pz8DURsxfvUQ7kNvwGNTaZo&_nc_oc=Adp6mZypRO42Ase1zQ_ZQJHn9zI6Axqnz6xqFSdwjKgqRFf1cNHfvFnXaksLOTCgEaM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ8frw5nVvUkexfTfk1ryKC3ux6yrDjkUbi4sNH5kn3Q&oe=6A9C137B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvb7UmKYaRcQ7kNvwEgHQkK&_nc_oc=AdqpdG4ZEolXDslUXk4bqvns7lC5iusW6FIven1yjo1qhi-z2QMuuE6YkAomTX-PSd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjSbdtJ7E-2mxv6sIi929dvisicIoa8n0Rg8txT1UrEQ&oe=6A9C14CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtEm3CQmBn8Q7kNvwG3TuBe&_nc_oc=AdotHw7beP3pHj6z17Dj04AHoIio34tTEJl4kFH6-Hpx8gDxiRjzSkAdsp6NkG1r-zc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU-bTIymBW7Qtsa3wz-b2acqL-4B_1w2CGpnbgw9OR2g&oe=6A9C363E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
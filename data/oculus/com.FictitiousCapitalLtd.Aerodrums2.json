_nc_ohc=DoHHGA5XOL8Q7kNvwF_Hr6X&_nc_oc=Adq5m1Kv0e5HY4haZMKvZsncDj9SSfKp4eNjm0DrY6GPSVerJGxiBPQxzMxOdqv1OMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DHHcL0vzWCsDGYG8c-5pdtpITOlZKuwphVjQXKSBM1g&oe=6A1465F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6E8l4rq0GkQ7kNvwGQqVXR&_nc_oc=AdrGC-ctsXEVe2Rn-tCXAUXPSvE8BKG15KC-20f_szMCkn0Cptp4f4YK_3dJ9rjEBOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EQhtaHGBtcmtrU5FzuFP4VnONQi-9T-JJsdOREqQCVA&oe=6A147593"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaPgKVbc8UIQ7kNvwHTyiuQ&_nc_oc=AdoVouBWnz4cWyP3Jr1uDGrXKdisdvnmlwjknFRXYIEIR6yN4l_Az00SVSr0xYLpFMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jfU2GMiskOHckamE56MOsNeqTbHyBwNECbllTg8NWkA&oe=6A1448FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2F_dnXmYIMQ7kNvwFuGOsG&_nc_oc=Adp6pt2H9-SUgyI3vUSEvUcD5rcNV3ZUiZReKCd-_Ii-crbIj6ai4in-hShK9ZP7l2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41Pm_QFI97eBwX2_x3hjd8de6JVFic7IyClXk-uYZG-w&oe=6A144A4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytxyNtbECRIQ7kNvwGhGGXm&_nc_oc=AdoJ_rf2ne2LSF1_jys5izHweGL313WRbIQIzIuFzHMkAqPfetSoj7Z0yupiYThHvhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af697YfTNGNlhIXKvaBqc3NhxcqtUD4uURbUBMV3qXDR8Q&oe=6A146BBE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
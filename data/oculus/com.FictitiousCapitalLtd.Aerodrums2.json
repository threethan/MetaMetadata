e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrnr18uaDnEQ7kNvwHWL0oh&_nc_oc=Adr0qMUzC2UMp3ihGByqvUEezN4GO449BehT372d3CMUtaSROe27zZc1dhv34suU81o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X420JaFcZKi_KWJqeD1jILaG0DEFEng85dhVvydn14w&oe=69E8AC39"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ht0nq8cC3QQ7kNvwE7uJkh&_nc_oc=AdqeAwu3g1-SVqgaum72kblZlewsVgAvepZnL1jwd1YgVpZLD0-cv0iP7KRGJBib_r0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2On1gjgUNaY6u0t8yILn3lmzKtdEdNS4oQQL8esGuVMg&oe=69E8BBD3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=819UEtKPzScQ7kNvwHdrLVF&_nc_oc=AdrS8aHmOPvf9rY-JwWV3-NG-VbrjKOwwDtUP_xx5vEt6LK1hhdzS3d435NxP3SF0Vo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UEfrm_dmHJBupNwZKOn5bwL4IsGRfyGCZK6YwYlzLJg&oe=69E8C77B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM5E_4bR2QgQ7kNvwEYfm0N&_nc_oc=AdoYji8R-A-0A5WfMPwq9VJjB3l6peLxjGwHyiYlxu1K-TsGur1PweS2K3TJ-nJyiB8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ymOzcKO_HRB7m-15xMKhtXJUqxsDepNGZJUXrttpjaw&oe=69E8C8CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVSE20BFOdAQ7kNvwGhlRzc&_nc_oc=AdoAf6MAhrYJn4PmG4ZJfP9CCjdJx8Z65iFF9oUJhgv1LEFc6eaNQJVdODEWCancuwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AkM7pJqa7YJwpGhSiuqlU_kxLxgn-aVM7Aq90rw_NMA&oe=69E8B1FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
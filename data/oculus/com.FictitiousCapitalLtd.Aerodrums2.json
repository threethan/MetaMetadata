_nc_ohc=mCkobVBtQ0wQ7kNvwHzdeAm&_nc_oc=AdqPmFlauUrxccnaQcjuCmf7TcDj7FDiK1CQ8k3WHltUpLDk4MOf6hJRaZuA-yXYtgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtN8jWGlNcFRG_XjEji_P60f4d6n1zh0mEhDoFzI5xRw&oe=6A5B5EB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6OkUMMrvHwQ7kNvwG3Q8NG&_nc_oc=AdrOBRMvdNHlsMI4VDpctJJ3vV-iHobDTkvkR_MMdeHYdkzYDDQvZbzOOHltekv3HeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBk13tUlx7VLPFeGELQGYJkw39Ku3KWUwfYUFONmir1g&oe=6A5B6E53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIona-hL1hoQ7kNvwHf7AGq&_nc_oc=AdoACZG4K1XLTCG5tt5QQn-KnDa3n868qOBeGMyq9OdpeF6XnucVObCLM2bh_8stkiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyShK0mAOZkvvd5pTxShi8z4dFXP0Hcsxisu4uWV88DQ&oe=6A5B79FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PM-GbMxJ0MQ7kNvwFB3VNg&_nc_oc=AdojVf9yYkU7Kzn5PtVbNwvyS8ptJuBvFk0vTRZago1R942LCLqHlNVyGSL35CXycmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx9gioq5E_C00U_hvOr72TceQFE9yk9BEoMpAUcx45xg&oe=6A5B7B4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qslGsU_fiGAQ7kNvwHJA2ZF&_nc_oc=AdrsZm7ooJWjayATNHh8oWabJCmPog0ppAWSRU5VJmkZvgWM9zFZG1ozUAVsJBGY-8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDbGO4FA4FS6pGywtn5FBw3lbhielqrQGRvro5GnEJOw&oe=6A5B647E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
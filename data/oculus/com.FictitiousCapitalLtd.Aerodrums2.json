_nc_ohc=Gmbab9a1UuEQ7kNvwGGuBmg&_nc_oc=Adq7Rgx8AyIQJkjZHgK022KlRZqsw8KJvKw9nL_e_WmiqzfO3C3-R5vWt86XH8qSEE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUxmfn7PMgwZvEJvLTrefJ8j3GWiR__swO8iOXqVOn5A&oe=6AEDED79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyTR_YG2yZEQ7kNvwG0ree_&_nc_oc=Adob1aP-hzX7P6sospFJJcYCoX_x46sODlIWcLquEHyzHk7lOZJMarS-aZWwserhVMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw7poaBtm23w6wc0KIeLba4pbIHiVs-mWBIPoTqf41_g&oe=6AEDFD13"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtLbQ-rcWgIQ7kNvwG7FCrl&_nc_oc=Adotg40VC-nW4I7qaQ6TeUGd9QQutDPJKvYxDeUR3R9HClpUeUkR5NKQE7--pUcXbQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGRtF5kRAzlqbuRnAQQkEsY71XbWHRyEU9d0Ckrc7fLQ&oe=6AEE08BB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rxKSE5enAUQ7kNvwFECNG1&_nc_oc=Adofy-7li2ZPabEf-agBFqdvc0mnFGDwDqyLm2eVmCevnKdxPR4ggmwEmFhwiIswqgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO3F432FxGv14igxWQyl5BgU16dlmF8wq8Y93ufgEr0g&oe=6AEE0A0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I11XATw7FA4Q7kNvwGF71aJ&_nc_oc=Adr4mHdJdQ7r09Npl6o3fLvJp1uFJG5vwJ7rkcatujtuyxnEZtRMImg2LOvHx0rMLRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS6T7exixaMQPH0YS4EF1ME19_DViNtO7rY8x4qAhOSQ&oe=6AEDF33E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
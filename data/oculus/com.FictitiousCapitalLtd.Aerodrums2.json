_nc_ohc=fWY0dso-oiYQ7kNvwEGy9eS&_nc_oc=AdqR3NR0ft56QSCSFMaa2rvcOM2uBOkdmifLW-Y9l6L9sIbkL0EIoGtbcTtILJmbQUc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy9Wlu6jc9tR8CsbuW3r303BUcpAXFCpRbOuXZPRw1ZA&oe=6A6622F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euQqOpAYuLAQ7kNvwFvKkcb&_nc_oc=Adre7fUmBWkH6g85ktDfRL7_6diVyld2ixTouQNnW20LWuahoigZwLXRhQtTxRxgQ5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBjvJ3lPRRRRnKBxW4D2UdOhiFEl3XcVeLwx2WDFwr2g&oe=6A65FA53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGs83Ot9Oe8Q7kNvwG-A9o7&_nc_oc=AdqN7W77vbxxkPhBFGWNaTdd37YuUyywX6dWFiut3XzpzBGIgtD5eY6ZDN7wDi8Aj3c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzVycPpb4OhiaHtAwzZOJjy9Z9AL_JieFEUMJPLaKHyA&oe=6A6605FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=susUQ8YLy4oQ7kNvwFW_qC9&_nc_oc=Adq5WSWANx12NakfLExzZJTS54waq5BCy6WoasDA4VJREQ6goS9MebyelEJLurraYGE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKYlcSnFQxGlzLKxmnd92UKoCfisVNwgl1tBf9Xa3sYw&oe=6A66074A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1phkHNE_vIoQ7kNvwFfkNxJ&_nc_oc=AdodPQxtGPvJQ47dqGPi1FO0ZqV1fSoLy8hpSSdnEpFInUswSRr3MwlcyQur__BHwmw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIujD9eMGWXNPcjDi444fsdNRlAb8Y55m4NzFG74KMKg&oe=6A65F07E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
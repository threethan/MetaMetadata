vqPPQ_q0FZbdB8wmkKVlOaf8tVOI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLV4Ebs3WUzK9Z7Qq_gOsDxLytU49e8NY7kIvoxzBJLA&oe=69AAB5B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs_c2Sktm7QQ7kNvwGSl5ZW&_nc_oc=AdlmBYw0cxYHhvQIsW7hnSMYvMNJ1Iao5q8aLd4pVmTvO_h8-cnSBUTd3c_novHHS8c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRZUXm8BDm8kIfFk2if9-ckZzgvT35pglCS4zxwVvwcg&oe=69AAC553"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0iGwp34M98Q7kNvwEXoo30&_nc_oc=AdkC-9pFdhWTZj66b3Kov6IUw9SiNotbliVM4QT1d5X_pZcxhIsD0dYZJ3lP2dIUV8M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfziuxkaCdjSoZwvyetNcOabzvB7tnmrqvN-dbw4PTzLiQ&oe=69AAD0FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzROl26gkyEQ7kNvwHPwxPx&_nc_oc=AdkD37L3ukbnzNqJOoFfxoMTUhJW5skzflTs-RkdRf-7AohrFcGgHzPCLLyQGaTWpBQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqWgQgxgZOW_0K2MYgoEMAzdROnAqlo0UhwYeNXQdgUA&oe=69AAD24A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXwUf3WMp-kQ7kNvwEOp1iy&_nc_oc=AdkMYIhM_nmLTIKksWaAdYV0nUTGnQkRZrHBefvr_xi91IHA2M2LghK9MovZBUuXye8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz43B025JL8myrDDIiOHKEkSAE3vr0G-uqj7YGwSEs5aw&oe=69AABB7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KomyN2wvRH8Q7kNvwHmULQv&_nc_oc=Ado-OC_8VwwujeYYC7dtRC_IaNhtv-h5Lnjj0x1jVhSsvW95jLzn66ttquD-ZLzTBF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d3PRUsc99CfqJzbIRl5lFUlnM78Rhut7HsthAav3Eww&oe=69D39439"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHC3akZXnZkQ7kNvwHxBBRW&_nc_oc=AdqoQZiEI6xKN5hAQYMp87OT2LnuSRHTTAnwE6VHBHGp2l4LOwYi1LP9e97a6EldC3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DIj7nDkkp2UrGUqLu5mXFpE6a4krkfhMnkJlsNPIFww&oe=69D3A3D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxDk7XhamK4Q7kNvwGxPGg9&_nc_oc=AdonchmVIMJiAssGvbsClFM_CJB8FUFj8I2nZFrGnq9qc9pRIyRsGMzIN2zDbb7fjv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JpvYJOygCQYUdP3mrO4S8o2TkLpP527FuLHpywobSGg&oe=69D3AF7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAzA2QZE5HcQ7kNvwGAlnAc&_nc_oc=Adq8aSxfHcjWBKGjc2NoJLdPHNjIJ1AcciXaIcZ_FUk7RQVSSN1icMXMyDarXlrhvLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1woUAf5xHAcaunYlw5a8MfD39SSXtxK0VHRQ1kiO5KZQ&oe=69D3B0CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otdkI6KNLYsQ7kNvwH31HpF&_nc_oc=AdqmjbAKm8XmZHK050t7mtEikw3YOCz7twr5prP9v6YfWksBl7nutKRmtqb53qXQRmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h0Ry4-ZcCwxWm8evBy5vOn9dhpv5WXiPEHek5aWYCiQ&oe=69D399FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
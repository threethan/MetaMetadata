_nc_ohc=n4eWnkt65jUQ7kNvwGZKGO2&_nc_oc=Adp2ezz5F0DjiSE5gx7pOa3bnCjiLXnHFl0mWGGPxizbs2mo97vvqgCvuQ4UFnzLb7k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6ILMEY674xnajy2oDZDbaeTFXXjZFPj3zc8LcolzuaQ&oe=69C3C239"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYOdw6DNOcEQ7kNvwGLnNQD&_nc_oc=AdqTE4V1IKc27hL4BWBkq-FLWMThc4QPvAQ50zXsuS7tQ-VjJXl6sZ8PmFA_8uYMwTU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmgZcxEGh8BFvhtm9ez47yGD-iYUNnGej7i-pEiTCWAA&oe=69C3D1D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMCE5bgtPFAQ7kNvwEof5xd&_nc_oc=AdoqC9TEjrK30YxP6Mawcwb91N4i9YsiaWJzRFaSkHPo7vKE2kuNNZfKnPf-bYqf4_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGrsCp0LcW-rvCDti0PLluGMUZRxe_0hhJDLEceKD9ug&oe=69C3DD7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yos9gCRsc4IQ7kNvwHlpePP&_nc_oc=Adrav7pSb2cBibkpnQ071rz0ocjPLgWtNcn158h3iXdiyhl4w1RP7-50delR9Y7W56k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsfQqiitXEgp69QNh4JmlJgdAjexYpttoL9qSNkDjoGA&oe=69C3DECA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsJBrWz-8MoQ7kNvwGGSdnO&_nc_oc=AdrmbC5IKm1ixd6NY8Q-N2C72mU1F7IrXEC7ITIAH749bxW_jsPeIXN7DupfRFqUNzY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwW987qKYDQKbJ5LVGg0AG0qksiGJnXuSyJJcICLiqwtw&oe=69C3C7FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
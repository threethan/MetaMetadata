_nc_ohc=ByLu487UCbAQ7kNvwGvPFtX&_nc_oc=AdqqIpVHUyYL6kdp_QSd4JZD-9zyZWOwe_mJBQzj_bc_Xdw_du_-kpCtKBlSoFehjdc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GZgVwsAxRbQ6SaZWPPZ3sV2-LT1U1I5AlhR-2hyYpng&oe=69FDFC79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZYcsq89vPkQ7kNvwELGvBt&_nc_oc=AdqRYnGGYegRDsj8Dj-yKIjXnX124NjdW07yMGv9UIE4FObm25p_Ae_aKCh7kwvOJAM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a2aiSpmmRlft5tgU5hQ2JrskEvJRYjNE_RC28han7bg&oe=69FDD3D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uN32I-dxhhIQ7kNvwHlKkbS&_nc_oc=AdrNzJriWNdZG6-FIWsyYMITCHXQpQn3orfpdQ4OGSLNkFnrMeMUFHiMBQVP4ie7ycQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5naC0bwFOVuT9RuTKPmQsep_a5nWxk0Y6Kbj_2V4Yohw&oe=69FDDF7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtTgr3a1-0cQ7kNvwES6IR8&_nc_oc=Adq7R_qCPSzW6tn26MuMH9AqfLuNr01009b82zivKEezfnVgG8qaiXZKlBF3p-1zzaY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q5wPOwsehDZxDreDAcHpNE6HxBUMH9r94txEVqs60pQ&oe=69FDE0CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMIqpdO2w_MQ7kNvwGWNRtP&_nc_oc=AdoIIFagG13E16XNr5pl0caTJkumBf7xy6ZlnTOkGkxtHWc00GMfmONpcuhekk1kTII&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LpEo0UAECVnxoQU3lqq9fkTSKI87neTIL4VWpC8VqDg&oe=69FE023E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiLrcHSgPtEQ7kNvwHjPk94&_nc_oc=AdoitoldAblBfyfBqpcen37EWK6Rq2L_psUPCGyZzXY4h2B5aTm1whh0i_ffUmXah8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuUYZJcGNj-ueV3p90TDiuqkvkPwiIG2OCsl41hS9xQw&oe=6AAD53F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EhhGLJVzkQQ7kNvwH_Xta5&_nc_oc=Adoo5YfTbvPcyAezTYslBhNe4PvyygRBZuqYMGRwB_e1ynS1kLuBwGH5GXY_l4t2nqg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-UNHVG7dOG3WkvDiXuKoYnPgUR4fnYKGaO__hNhGcUg&oe=6AAD2B53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoa_QXiCQn4Q7kNvwELshgG&_nc_oc=AdrxhyJunq4k7LkXTm4V9zdNOH9t4KJQqpwyrd-oUSnSncukXiwWTGSmyX5fVKKhnIg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-i30wq1FAQqwR2ZAy91WYz1PyDvukvk9_1cvV87bhCg&oe=6AAD36FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yyc-z1tLgFwQ7kNvwGYNYi7&_nc_oc=AdqBBkmSpiG9kvvl8HrhloVdt5rojomyABovoODq4n2PCd01Kxf-wcQkgcr7aFytx2E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7iFOiVbznO2ab0sNicZRH8JUX2g0OmNA7R3d-yqA0FA&oe=6AAD384A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUkEmnIk7CQQ7kNvwEbSs9I&_nc_oc=AdqB06k1-WRr6DaH458-YewSKGBwwU0QNN1Fp7RYvR1ATEUlJtWfzBLbWCDReQ564KU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN754XtyjobfMrpQRK1jxx0gdiO3h4ggPMo6n36MDWrg&oe=6AAD59BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
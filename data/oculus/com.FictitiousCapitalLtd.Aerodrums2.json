e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4jX9cPWkbQQ7kNvwFMrtSi&_nc_oc=AdrIkX4o9Q_R2bnUEalWAxMtF_QDABR6V5tz8RVmN7m9iIrdjcbeQuJ3BsBvp4Mrv1g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eyi3iKFyfPPcd_U_SgLc5ciBhdsycC3KikfULF8s5Jw&oe=69D788B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBFxzff1VE8Q7kNvwHlrmjM&_nc_oc=Adrez3nSIrOf07NBXSQut1rksU9xNEmNRUCqfDeJ-_-g5hYmYxIypAbair1LQ3KsMmo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UY0CoARkgzT_Dyp6fT36mTJIst3WPGAa30WcNoou-qw&oe=69D79853"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNBAIf-7rDgQ7kNvwHeP872&_nc_oc=AdpmAPgAp-R8SZRrZNt6wGedaOQVCdEZY3FOS2Ab2CvroW3P0KIKKAkLENrmYtLhVLE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2W8dLOfj17fgbEdTa_ZrCbpQGYZQNtda459OnHMkBkfA&oe=69D7A3FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2slz5N2R3IUQ7kNvwF-x-9O&_nc_oc=Adoss2yhzKDZ8esu-M53vrAxTiVUwSDrJO8abVakLZZbcmCRz3C-gTh4MfJB5jvASc8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af203rS0gBk3ysnD6Y45oVjpliztxMauOkbK9APHd6-1sw&oe=69D7A54A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4dnib97vD4Q7kNvwHDKb9S&_nc_oc=AdqJa70Jlz9ODH3XQzjUVrd2h4cOndBjqUPQWcjGN6CcQZRiq68yMtdw-XzXY3GtfNM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rt-XTsjhuzI65sq_rJNzQHaZEiRL1pnflwUMKZ5f3bw&oe=69D78E7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
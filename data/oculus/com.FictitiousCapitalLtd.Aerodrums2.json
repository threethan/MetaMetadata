_nc_ohc=wQtSoJ9ToGsQ7kNvwH0V_Mz&_nc_oc=AdqKxh0o_LpoKjjnUGGmCT1ewpjvF6mPoym1HsfM-ky_O2dPWlm54VxFn_4JmW6NyAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8W4Gi6FJ_VMhdp0nTt08OXgNG8f0zMqsHqACC6-1uZQ&oe=6A7897F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDAX3-KT0jkQ7kNvwGhCfCk&_nc_oc=AdoWwFMaArtUN7tOmvGAVv6cqWS0A8Z_TpXwIcAUfMI1tjS2RMnricbRAAuejpca_aU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsUKGYlPlPrha5XFBYuqeOPYZIssf8mU5TQ8oCjLJ9Ow&oe=6A786F53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XMKaCOR5pQQ7kNvwEWBn8s&_nc_oc=AdqSbJ44z6G8zH6ZpryEZKISVvWARdu9W977bzdU8uRE9k7Au7gIANMfF4M3qL_m1XE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_hE4H6s88vrDviRTmm-kvx7T6SbkD-Y3RcIxPS506og&oe=6A787AFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZOFAT_yLEAQ7kNvwG_5j7J&_nc_oc=AdpSsdv2xQL0eA2bY-amyjoG1TEPqqZ9P8rcYLO5xQFeuqVx9Vvj0TP2JLODQVkiXaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC0rlEwtX2__rDGqD0cPsEVFAgz6eu421AEY5n-de67w&oe=6A787C4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpEMhjmnq9kQ7kNvwG3YeTd&_nc_oc=AdqV-AIFy_ylfXt1Unvj4NscDTYWhf0kkWfzdzcXXtuBigrys0C0qWwqKpzoerKXcKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKu7LT4gDEA1G8fefonHNp67qTozM92jqyEPtD-oaNkw&oe=6A78657E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
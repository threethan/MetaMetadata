.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkHuWZeDXzYQ7kNvwFB9uhJ&_nc_oc=AdlDVAkW7KdPGSmee-xQSBYIGlsCeHP8HQPfTqjOgUXA0qRxl3EBuc7914atN6IGE0w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvyN1I-VeYEhHKhhH6Iime1BbtlndQkMNFLexiWI8winA&oe=69A56FB9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg1s0wCk3mEQ7kNvwH5amL9&_nc_oc=AdlBZM0JQVRhKmeY1tMgIwyhVTazLom1B-vokvcQLF6wGaO7Vs2f5ACgxG71R3PTYeY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft9eEZcv7oVArQzqwNnQPlN_-ji-jLiBr6nM3SLdDbfbw&oe=69A57F53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6enR7dJZVpsQ7kNvwF6BYFT&_nc_oc=AdmfM_2wAfIOqguORW_BC70TeR6_EXKwcE8bPYxnrrPON67LnVC2ErIWRMcfriPGAvQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft46OgxB6YzDQ4Lx9ftk5fnGipy1MvgRb9XbMxxgYVhhA&oe=69A58AFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZahKpWr1HUQ7kNvwHnidr9&_nc_oc=AdktmtY87rbsmaSN_FBPkOw-zK3zVTjKqJpiNpdFRgmrf_wrZvd_KJFlxmU9-Hp-aGA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft4k_YiclkbJOhVgoIcYqOct--EojmX0eJ_SGKtY1usWA&oe=69A58C4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNHureDjk3YQ7kNvwF0OWBD&_nc_oc=AdlkR69Bn6uO_EXk0spvmu1_gRwE72kYuCMJmoV0q1gGksZEYT-gbeKHOwZ6VKyLE3k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft1R_iRipM4lcrmsREIp7jl8hCUoSAKUP9jOVJlxggKug&oe=69A5757E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7817449928379505"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391959_999718448725765_5015023777950136377_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHb82ul-QBcQ7kNvwGRH6Tx&_nc_oc=AdmxI-A5-Iid3DKgog6zUT56caHY27RKO9j7a20_f9a9EnlzK1PGCcQw29C2o2-idkc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs3c4t5XbA8MGIF6uaG7Douk9PeFFGpVBEDiDeEcLMi5A&oe=69A5789D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aerodrums 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1740562800, "lastRevision": {"nodes": [{"id": "7791101414347690", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7791101371014361", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "641137765058673"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "logo.png", "id": "9875363755824721", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391949_9875363759158054_7798703332122508540_n
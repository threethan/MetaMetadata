_nc_ohc=ocjMLr53MzIQ7kNvwEoevYf&_nc_oc=Adr_eXEN0RFRyhkXwxiadQBcFJ5X5uboCqNYEbWLwa0OBx7ldf2TFKp_6frDXwdryn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ir3GfW9P30yqbfbEU8sTLy32hc5OfUx_CF7yJqh4J4w&oe=6A2EC3F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrKmYX-QlrgQ7kNvwGhwqBr&_nc_oc=Adr-hlmgkv32NQAiNNDpm1N0nPY4ZOcvZ3DtKg77KfNnIg_yYxuw1CsN_wO_VuH2ki8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sGPi-nXl5nU_fJrAcLL2MMOuWz90QoERIMsf815A8nQ&oe=6A2ED393"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za13ERDJy7wQ7kNvwHfqyoY&_nc_oc=AdrjRSnJ_6Y9zmpOFekqoD2nn2LSimAII_HHAQhPCrUDEUMX0bfaWEZrm-0JYRZupRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87qV4lpj5ZncDR56Ms8X9-uIZNTgiGKqEEUMcaE9CiJg&oe=6A2EA6FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfJU4G3Wsn4Q7kNvwHTu8xv&_nc_oc=AdpKlsnyBnvW7PL3kSfyOQz1kkU9M-eMoNgC_2ulm17K53j_nIjIM70oFA7sEXHW8JY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bGHOc3V-7B4Mcf-mufIwSokRl0Hv5awyxyp04Lmvwsg&oe=6A2EA84A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYQO6GmcHnkQ7kNvwEChbrE&_nc_oc=AdrhWtR8LajUSG1IbwN7fSm4pX50pJDU9q3HAfR8KcSD4vdpo-jCGfn3vGM6LyMRiGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9feK9YlHYghmBIER392gkmFBBfAfL9TDKkc-jvDqOMNA&oe=6A2EC9BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
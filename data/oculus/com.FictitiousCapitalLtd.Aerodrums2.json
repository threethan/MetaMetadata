_nc_ohc=e0TRYOOXm3IQ7kNvwFCxGdT&_nc_oc=Adq-MOZ0KsWupygpK_RmJ8qCpgKYyNQ5m_oxMR_keQ5Q-4zLvRKy3xgLqJGiZQy87Mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN79yiqW3nMYXQhXRrgeMS5itDPWcdrdP2PyRAGMr_8g&oe=69CA59B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=378uJTGD0gcQ7kNvwH2Ae9S&_nc_oc=AdpC2y12ZHY9sVYMfAw5_fuFK1XX8uuc0ky-VHSqaMIdnVV6fd3NH3SijN-rQVrQ188&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaAOXsLJKiupa464F7H4ZbtEld3mBLIRn-4fkiodlGbg&oe=69CA6953"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNg0boUJtUgQ7kNvwGDHRQ0&_nc_oc=AdoM6i4N8vm2dYel1GV9Y__k3xrojxGb_rMTR_OMA7uESjahXXYERkb7JOZ9cD3Jdcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkYDCR4WUyAMV_BTb31RhyG92fKg5qNFfZ5560wv2eHw&oe=69CA74FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-OvaHsUvJgQ7kNvwEnm5Y9&_nc_oc=AdoAhnPh0p8hWKgNFzBdqh0AqyzTgDrRC8KYcIx28I74E2SALbOl83tAkSzAqyudGQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlAvIG-yas8Nt6e5DtvekGAHdDiQcbsLLUy8ERxIQu9Q&oe=69CA764A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8YiVpdVMUkQ7kNvwF1jFT-&_nc_oc=AdqpdL-KGeM4iWiWa-oMIR0B6TN2iY3cci1t1GTKYXopIMeu1gY3dHBhN1tyY97NMoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj-nGvfjIV0zleaODd7FLYNJ4MPM9gnu0EHJmhlCcf6Q&oe=69CA5F7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
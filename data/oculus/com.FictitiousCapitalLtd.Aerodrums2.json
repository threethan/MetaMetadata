e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbYcbEc2IYQQ7kNvwGr9ylY&_nc_oc=AdqdTohvlmlihRAD8W1h6KT-_QduvhyNbpZeg_4xxdKOcP2xbypE6eUdMdCsN-8pnUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YmytzJ9MnHqa9NI-wnTL9M7dLxuZJIuG6tbJzi6BYaQ&oe=6A3AA179"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWVtxfdpPuoQ7kNvwGC8fQW&_nc_oc=AdrgPssbnFM52JNxVtAzDBn7kyk9FCyn03S0R3QTi3Yd_ZHyZIbpFY70UOfIQ1CLYOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NETAnRGUyoxg60f3ZOz79NvtFu_8Y3YX6fIqQ4AcAkQ&oe=6A3AB113"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wQNqewDr-kQ7kNvwFLgN9E&_nc_oc=Ado0VSgWv2fv64f79d6LeZJI2HhSmTo-Bg7f6TRCDqnXbMaYcgxdIz0IWqaRpOc_BC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yB82G87sccnmtZHWWE11U2GyVgvdRw6kOIjwKg8N4JA&oe=6A3A847B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPSgj5gaFXIQ7kNvwH_liQx&_nc_oc=AdqMHkH-n5Kpgrr0Qacg6ZjFAPCQi5aupsaG02LZv0juvhw4AQGNn6nO4HzgZRiYH5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tK4k-VjBJJZWm2VXlX0Yp-C0CyDc5gAI97Lt9mEXI1w&oe=6A3A85CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tVDCTbgz4AQ7kNvwFNv1Tb&_nc_oc=Adrx2-XsZffh-fXXs88mvBSsGNKmbrGIPGk4i5ggHuUHw8sHVnTf76hmq3WPGW4nCak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z3eO9uG3TZlh0BFlsQE6yVEUNGbMLPJxN3F06Ihq7jA&oe=6A3AA73E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
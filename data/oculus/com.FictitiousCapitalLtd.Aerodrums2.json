_nc_ohc=7-fqFmHFwUoQ7kNvwHQklNS&_nc_oc=AdqHwNQ_kWW6ptlTEEkH28GZXnRCSdANVuHqbwJtE0mBpDTt5yi5VJte31v7xfAI2gE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dmBbTJG82fL1oHhjcj2hMDeeGl3VdU_m_knt4rxEWaQ&oe=69EDF239"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OoUYu5PDvUQ7kNvwE1A_nd&_nc_oc=Adp4q2XdlBxncIULdi52RNr8l3KZlt95q5qdIhYnQmmePrPnKlJ4GWcRYIRfo5qjemg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28AMb95lSuDOkj1DamLOwHJInE9HI7ZaeBo8fl8Qs3rg&oe=69EE01D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjE37P9HskAQ7kNvwFEOnjw&_nc_oc=Adp6G3eI-Vcuvp5h9PEznNIdA30tx1Ly5vmZxGZEcrPAuk2CJ2Z2TEh6aNYxrqG25c8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fsTII-WpniTHZlgVO7Kdy-xSGCj2sc4Og89Xjtk9VMA&oe=69EE0D7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_z0GWiQkfUQ7kNvwEuZLA2&_nc_oc=AdpQfefezaLw8M3Z0QzvpldQ2TYRIPNBFozKnJ22MVJjKC6Q-7IJfdepCNCAbCpiFqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2s38BoGEp00mSAiDFpSu9tSCXG7dqtQvZVh95htn1AXQ&oe=69EE0ECA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGa2zqITMzEQ7kNvwGP0qCP&_nc_oc=AdrVdccFDuC5HxRnfPloj1BmKr97mLQJCBRNeU0f7XfTOTrF5lmJLKm-3qsZEH126n8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X3cOrt1ru-3xe0D25qphwUjXbhKgy_ObF3Nzhxm0HkQ&oe=69EDF7FE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
"https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpBDQrSYgrUQ7kNvwHGXhn0&_nc_oc=Adn9f28TTda9etzou9MD97bTELXXJ4lpEkJGFuEHFxpNq6KD9tZQ2DrCKpyef6pq4x0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs_hCm6TRlg7LXib5tFQJ5UpkKkaMq43th-geFvQreR8Q&oe=699EE7D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHvKr0F_s7EQ7kNvwH8I9vc&_nc_oc=AdnO4ilv2iji1YoU3P6n8w2ORCVoqgTL-JY-BCfFo6Us1ea410n7Cb7Px6eFn59OrzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afusex3CzfqtIzg3FZCehiBF2mrnj9WFZg8HOnB3iF9HWw&oe=699EF37B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIz5iYtQryEQ7kNvwG4yP1x&_nc_oc=AdmuMkJuCJbgvrdcWkznW-32NceWRi1SFi-9vWcun4Pa7KnSV-7G9O85MdtYxAo_ISs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv97okuNOtnhrofoXrWbT_VM5ZizXdB8q2MRIOg4f_keg&oe=699EF4CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUxCsZ7QNywQ7kNvwGjU-Fr&_nc_oc=Adn4DKvkuRWGhEvm5moGazg7420OKkSrMrSCjqsXl515SmLrhHMIbaGwXCl30YzDiAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftgmV5rliVqKn14hVEcXA2Jz8qqf_gs8Nj9Z6vIcqa6Bg&oe=699EDDFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor
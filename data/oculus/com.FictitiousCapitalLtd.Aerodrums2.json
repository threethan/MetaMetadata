_nc_ohc=Nrnr18uaDnEQ7kNvwGRlB_m&_nc_oc=Adr2DKpgfxxUoiZ9pSyQLnB77WNBoLV1GB1TBdlUU5Qj1ncFxhyOROS7hJW-fg2XPl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YRBpZM0epXjuJu6c4RacMCWyTa2WM-4t6Tcka3srFpw&oe=69EA35F9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ht0nq8cC3QQ7kNvwFAj2k6&_nc_oc=Adpgmcx1QjbzI_xqb6lYaImZWlIX_ctg2qDJFI66tidz6jQTIvzQvPvk2TfuafPBGlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2umNPKFTrkgf6T8DakUahrYii3cXURGPgJqE9HeliMcA&oe=69EA0D53"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5VOK8r-1ngQ7kNvwG2MX4C&_nc_oc=AdpDnu5i1ruSX-r5gBWpj-2J11uqr8botr_WD6mDN9Hh4sN0bhhZSoe9wQg6-k-yoH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13ycSQw9WSHZ-EuYZ5gKPCFjfSw3GAeFtt6QfQ6LR0tw&oe=69EA18FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YCvzjKjGUAQ7kNvwGhIroS&_nc_oc=AdqUBJIctQVlRpHlb1XjOFHMINLxC0cQPKCsBUcwfRhBd9fPq_cd4NFIQn9QwP2TjYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZOMDkH4m6SvepnOlJbCnEK_XitdNCVx4ZKLo8gDlD8Q&oe=69EA1A4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE38edyojfkQ7kNvwEM43sk&_nc_oc=AdppETg3N6sEL9BBnDxpIyO7CpinO3L4mnt7vFDTEvodzLtAjPiUjwWtaUdnqlg3OQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uvc2DEe64bRgGXXry0ktZ_74VZhC4Fc4coctV9qdmXA&oe=69EA037E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lIvVAJsGxIQ7kNvwGUgsPd&_nc_oc=AdoModLvFPBBESQPIC3EuDmQ28BOQenC8lVHPxquVIPCAvhVMuz78Zb4Ht8VRZkynxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIntlZFBVhcJloNAgKZoXZk2WMzjBry1N7EoQgLhSN7pA&oe=6AAC0279"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTj4aFNvJgUQ7kNvwGv2iT8&_nc_oc=AdrEqGYcRgOzDMs-ndJ0-ldytRqm37LgLOeG-e6jYOjVdSU2WzOvNfMXZ0ocn53trwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPMtgjNssR22PrjkVtU8cLL1IofaPxt_tV6-RxHy3XkQ&oe=6AABD9D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoa_QXiCQn4Q7kNvwEY3PC6&_nc_oc=AdpSS0KOYbX9-9AILwqE0yXlXkDowP9MPSNm2qJqtV4RCI6MOxAdov1FwwG-BWayMlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPTgB8LI5UqVt5BH58xD4Pw8m1gHledZAfc7U_mcBWug&oe=6AABE57B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yyc-z1tLgFwQ7kNvwFaCAQJ&_nc_oc=AdoDSFZOI6IjziqB7ycUVSP8kcHZStjt_sQ1Y1KgfZ5qiELrlb9NaCzlptxYS2uYLhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqhwclJ5lwRt-WGKdQVsGk9NLNl6eHl5lM6YznWQ2fXQ&oe=6AABE6CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUkEmnIk7CQQ7kNvwELRhVW&_nc_oc=AdoBfxKkj5nMepLchkMlJb15ocdwvprPmKQxFaR8cfaywsPkFDGOVk4F2TlH9B8kWKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkClFyGw3L3EmijsY0b4GinyUBz4rTsZJ-Q2019pguEg&oe=6AAC083E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
_sid=6e7a0a&_nc_ohc=u032ISkRx8oQ7kNvwHcySoN&_nc_oc=Adp8PzA_QC6CAdZsbEr1gpzGNCZlMV_gIooreSP_y51WGT_WwUeVnOFMCll5U9p0dco&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96sGCxC1OqkVqNBSzkpiNXwpakTCCqDsdPvUn-nxzwUA&oe=6A467EF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WATPRXriHzsQ7kNvwFheaAs&_nc_oc=AdrNQVlfCcwwHJXQl1ztMHo2nfeeobsbDjnZZaaxSHlh96SMirrDgDhCC9J5WfDnJLA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__qLvrnDm6h0jSRO7Wbv6j_UotKxLYTAVRyD3FXbWQQg&oe=6A468E93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z59F3hjU27sQ7kNvwFFZ7BW&_nc_oc=AdoD61qhKdFjWvj4HHJU-E903ve0bOA2fMXygtKcOSUHSkmn-eHWUEUCjuj3c2uF5IU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ktf1z_qESPCzWi2RJa8HsIvzCsa20QSih8k1nzyq3jQ&oe=6A4661FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL7t1IFYd_8Q7kNvwEyMw4P&_nc_oc=AdphTOShw1_5V5WT6vm4jhEy--X7YBQiFy8Hr_1yhyuYI5Ul2IFfaIHSvYpGlWR_gfg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lg9OCBDLQptWzxWiLx9yjH2k_fMOviTW6qa9-rTZMHg&oe=6A46634A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vISRBrcHLskQ7kNvwFMJMpJ&_nc_oc=AdpyHtxNI9cqA0X9znCBNITnEPm-GJ5BgL46E8BLnsQiD11H0WJAsEH93t7sN5TKBeQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xu7z7Rh5V6c2CXdFJihALhLigEz53BHeYcotbA8QWyw&oe=6A4684BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
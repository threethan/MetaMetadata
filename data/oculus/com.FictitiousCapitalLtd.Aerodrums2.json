_nc_ohc=yRSL603RmekQ7kNvwGcOCZL&_nc_oc=AdotJMaKK4LSefc5_meOS-c1HSTVAq1Jtip6qXbp7qLR1M-L3yQ8F19hcxjy4zax7Ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvvwoArYVomJkkALhnNCSS_nyWwUwk6B_y1YJq_2RDGg&oe=6A998D79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLWUDNd6w3IQ7kNvwHAVv4a&_nc_oc=AdrmLREti3bbTn9QjRIra5_ixWcRC7oj3UANy_jWivQHwh4flebElDRjAv0r9xgp_Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILs0PEkHSb7Jubyfk2enb7yyYnwQD3mfJ64Fspel4taw&oe=6A999D13"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhA4nTxkdqcQ7kNvwFFl7og&_nc_oc=AdpEY8qLWF6ZzlgocwUBIK832QrRGhn7t6_msXNRxwQT5-SlITMdaprmHtzNKSTT5gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyeHkEmjb6FvUdFqFn4UIC9mh3sSvrGY3wMwrUpivk8g&oe=6A99707B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npmjVxu42YQQ7kNvwHnQZYG&_nc_oc=AdpqeNkwm7OohiTTZS1u7PlkCWE3XuwsJn3VoW6Xv9olMEOqfRYZdKuX6QOcgSMDhmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeuO9T7idvbmEy-fFv4VZ3L9Yhr47UreNc0B6X8V_BVg&oe=6A9971CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r4h9kJIL-kQ7kNvwH03PWn&_nc_oc=AdrVjOGVCrCqxYThjlfvPCuEa46WZ2wZkCBOCoVj74NJkttoV1dMphtGihxj7TV27hA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4eM3h75Onc3ZF0h9VmfMeXZtqXvt8fb99UrURwGPocQ&oe=6A99933E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
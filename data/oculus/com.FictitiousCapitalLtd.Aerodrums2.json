_nc_ohc=7catPr3SJ78Q7kNvwEcYRFi&_nc_oc=AdqOvlw8SdCKRQAfmKx7L_nOf_8sAUsVoBIPYVRl9MXL1quoJ3QI1Ty_Vx5ihjgufHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgVDC8LAIHpRqwqhlvyceGsg28MsGhqznaif2Ve9BTFQ&oe=6AB3EB79"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zH1lHi8FYQQQ7kNvwGRrWPy&_nc_oc=AdpeQsHMOQpIWjiCmAZpYHOn3ilpOicH6sNmgdRbzK0LTsP-lILxzXFcp2ZRgrF0X10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY6ZgnpU1kwlM0aPA_UdpINGntm5wc0_T1jUHSaaVutg&oe=6AB3C2D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5Mcoqz6opUQ7kNvwHcBr7G&_nc_oc=AdodR3yMwgbOz5UOp426mDr8tPfw0LmfgirSeIHbX3zO4azRmHSSawHVM-8mJvKa3ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1yid7xJbDMOo_gagz3QSAxX7VXfx4TIMNNc7-QJWiyw&oe=6AB3CE7B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW82DrSM9FcQ7kNvwE4De7n&_nc_oc=AdpVAN5Qy8xAAC10NeQmh_gUIQnZvcqhD1RCqKgWwhd-H4D45ieXYTa0CAMFEbrjn3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINAlQqavMJcu2S5tkidl_P6h8_kBy0-jOilFITUwnMxA&oe=6AB3CFCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uin4fqS9v2EQ7kNvwEIdkYY&_nc_oc=AdozjeSrgC7tCZiMjKxXjTCH9qnekzYCJjA_BMfjwDZZE0TjbeyRTy_sFzKGkw-0Ny8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_W1w_aYIC7whGWZAHWge5KSvWqRu94Iv6MkehfTe-WQ&oe=6AB3F13E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_nc_ohc=qi_O7udKmUsQ7kNvwGlYzHX&_nc_oc=Adrr7kWir4kytfJcYx11Dq-hnUotC-3yXWtznGlGfNHj3j6sq7wDUhJogN5FvOm8Kko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT85PsrQuMwVhcjTzWSXRbd8cSt6xxJb4CXDrB_KJb5g&oe=6ADF6CF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hniVvAzMfcQ7kNvwGPjvTo&_nc_oc=AdqwLC92QDPAcSp7oAHQ3dOP14T0sUizZCsBeihQrEbBSe-zYH8D31vFUPqWcasXaW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs6-KGpQqUPGUtsw2AlitMcjGXFNE5mdLWlp_eRpxpzA&oe=6ADF4453"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDVcRxKZQVwQ7kNvwH5TZiz&_nc_oc=AdqJ7EkqZXu2hPnOhH2I7y4s3OhIjFGjUmxtLGIQWwKoGA_SaQ4qFZFEl7QXslPwi38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYAa3PXNADaM8R0Ffr5uOWMd1540k2CebwmBDLxKLVdA&oe=6ADF4FFB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-emGfD5KLm0Q7kNvwGHTEvP&_nc_oc=Ado5kOnS9pVHjwoWPBOxkGQghJsg4FIHYBfExOpZfvm2V-POpTgLnlR4aEz3PaZAIdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBRa-djfAH6B3N3hUoNkdbwekXykbE7S1KirctgW6Bew&oe=6ADF514A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucIPzOiXp4sQ7kNvwGBxhu4&_nc_oc=AdribWB5LDvYE-w3rQgXmmXnKGJwynM49pZO6k1Uxs7OU90trrnxmzSVm2XEBwzAEEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsvVBILNTeBLTpvB3X8dnBlwIyMjmO7pQe_0n0ssV2Rw&oe=6ADF72BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
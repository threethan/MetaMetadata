_nc_ohc=yRSL603RmekQ7kNvwFGA8zI&_nc_oc=Ado11V9hK18DtiXCBcxvzEu0kB_fBHyfItUQ1VI4pB7IQwoBtBWAW2-PMc4u12yKTdg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCuvlwvgOaC9u6oScyH3Rn54ydrmKsK2CEE4Uet-llJg&oe=6A9ADEF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLWUDNd6w3IQ7kNvwEPoMP-&_nc_oc=Adp-V87JNDhXzgSuwguUUPLD2yWr7raU1PjNReNKFaMvvjQzA63FB7ZoePwWSUe3Hw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX_mRptzcixJQmCw_Cy0gVBcHD8l8SiMdeQtoZnJQgkg&oe=6A9AEE93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhA4nTxkdqcQ7kNvwGa_kjL&_nc_oc=AdqjuhJ4gdYm9k7XYcJaAf5G3tvuxSJKq5Wy0rRfIfy-GXQyU_RDCzIATYy-_UtKPWA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIKcUuS-JSsqOeca2dHy8N45LhzfkSed-uYfM8J8Subg&oe=6A9AC1FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npmjVxu42YQQ7kNvwF12-yq&_nc_oc=AdrsYf9b_zyV9hkvGhl0dQtkOcFiwccFlBZSfHcT7-wX9e_UhJvhbXGlqarrQtlhbMI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRIVjpFkUd9BhCmG6kXkqwRV6mgHqDdMOYr1lpqF8Bsg&oe=6A9AC34A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r4h9kJIL-kQ7kNvwG0-Pz3&_nc_oc=AdoybUp1ZKaudkteSYpGNxpjIi0w82bD7MwMryyDrh-bspjbrV2TXsSrHbkEkrW1fvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6kUlK1pA2_4Bx_5HaCYA2szB3Po92AzfNC1cop8a1WQ&oe=6A9AE4BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
_nc_ohc=MNLBy5_oc9sQ7kNvwGm-IMq&_nc_oc=AdrTxRGUoPxHHC06ScyssgsJOP-pK0PUUVbrliwi37eaXn_28YAVxi_bkM3pWleBJ5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwM9c1_SN1QVGISnbV3_T0i5eupyAsVGvrsKv0I5GUbVQ&oe=69C66539"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYOdw6DNOcEQ7kNvwEiAdFq&_nc_oc=AdqJU-BFo-TIjJooaCxTBpddfbVDOPyKOpH6axxzL5yCreLnz-T1F-lae58JXYW8hwQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afytt7Fs8SJfo78NKsydBOemwOgGeHdOEl5j-dur5c3nsQ&oe=69C674D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgGIZfOi4zoQ7kNvwFpeaao&_nc_oc=AdqYcq1AaeKVGc7ExH4sHo-1PpbHxhJ5HT08AGj0tTSBXCd-z031y7cYsOQnE9W3wUw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHXXsBkn_TNDS1gyZ2qRu2fK-j-J7KZL-dN1MGdHY5LQ&oe=69C6807B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lodSokkHS5AQ7kNvwHoIsgE&_nc_oc=Adpgxkxl5BoXMn0i9d5t2VC515QK-q_4JEiXpeW_iW-hOmQLlp_T_XIPIU8S-16ssus&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwcHZsn77v0NUVCWhyNNzcIQG9n_6bbChrzv76dq4bkQ&oe=69C681CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvmlhApfGOEQ7kNvwHWbbJW&_nc_oc=AdpdYHuPME299grPmR4oVg0W8diFKc1naR8Q05MZjwTn1Jo06SGcdHBOYCWG_7FIrfw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1G6MFKOp0saM_JkjaVDr1g3wltFLzkGFv62OcboMMYA&oe=69C66AFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": null, "website_url": "https://aerodrums.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
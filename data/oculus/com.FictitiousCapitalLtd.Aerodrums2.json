e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fle0VKF-asgQ7kNvwFYRky-&_nc_oc=Adr-F9npGMcZBv-DyBTqV7F40DWLLuUiIt4pszXOMkUtR_uLwUGRSweTlaI8V9QzGa0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhYf6XEHYNV6HnAZwbJAom0d8le2JJmQMKSeIaMz75DA&oe=6AF9CAF9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woQExM5wnV4Q7kNvwFkbyCm&_nc_oc=AdpWSRaQ7n6B_p4vV1P6tAEln8t4ZCg2E0sM9k_ilDzXxSFQezO1hk9N8emmHnwXXj4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnuaEMv6SKh2w9Yzcdkk1YqWTFBZ2RSYUDzmEKV_h4cw&oe=6AF9DA93"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oY_aC5ID6YQ7kNvwE6KEml&_nc_oc=AdriG1S8-GdNZvkBaEyH6gX9EhkdIyoY-9B1wUBW6uJOR2XcAa0d8l9FNb1I-xhnwLc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSfFpr4BcmLSKPC2MUDSaGLR5PyFb9pVAruMhHyNBXjw&oe=6AF9E63B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lH_-JPfa8fgQ7kNvwG517_V&_nc_oc=Adq5Eh4n33uyl30pturKrGaAsFVIRrElUuUPBAMPxXRAB3fJuDb1evphPn4Lmj-B_A8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8_RgZiYVn9nENsXsdAydjuBnkGyXFshfhBSc5D-zQJQ&oe=6AF9E78A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVgTlyVRbCwQ7kNvwGDmfV-&_nc_oc=Adp5TWohAzioPeUZGoRFygHkO43iQm44gwjnM-aE4-zxev64lK9BrEDH0t0QHBHaELo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsVDxzoSzh1Wq7lSzIH1kzfG36383Bt1r_z-rbQkdaRQ&oe=6AF9D0BE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
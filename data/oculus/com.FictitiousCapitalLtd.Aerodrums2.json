e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNLBy5_oc9sQ7kNvwFRbkKt&_nc_oc=AdpWC-qAfRQ5my6qHxXKcfYq1D_qu2JgrybQM6XaLgT_CmxyonFX9aQvdLRKrnrgaao&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBrpmiCnaB4u9o4mAPtrrbszdT_-yygRD_QxWExxpXOQ&oe=69C7B6B9"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=378uJTGD0gcQ7kNvwG0c8vi&_nc_oc=AdrJ8JE0oQ2J8yi-pGCV4FghuNFzLzNKLcQSacVm5Rd5C7yVyDzTH25TkYBcNZWl_UY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHVGWPN534iCrbzw5yMAxwE58Cbt6JE012Wsu0SANBSQ&oe=69C7C653"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgGIZfOi4zoQ7kNvwEThwmq&_nc_oc=Adq9083cw7a05eLG5lelFP4I3azQBrAVDWq_xNo5ARySJhcdiok_jTvOSk9j99gjRZs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8S64KsQdl6LZ0qE7nElB8VjJeMTT4KPoSrAcU1kZWKg&oe=69C7D1FB"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lodSokkHS5AQ7kNvwE2m3gD&_nc_oc=AdoIwk5OURMUavsT8d05v7kWSnfP3FsrfeIey4M9B-bVzTHS6lsrGZXLEUPVzCANhmo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxU9TIeoHUxma3DfHn6KXu7WZMSKakA3bQZP0dNpXvTPQ&oe=69C7D34A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvmlhApfGOEQ7kNvwF8yk9A&_nc_oc=Adr1iTSu-3zmBQssWeZvypZBCKC7bnVcdaou1h4fYKkd5pcuvezAhSpaR_iGXl5WWuk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAAHW-LnZdGcikonZY_pIYxL1BGcqZhm-_kZ0qll-mNA&oe=69C7BC7E"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
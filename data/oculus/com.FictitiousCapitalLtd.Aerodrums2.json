e_name": "screenshot02.png", "id": "1167270421589414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393425_1167270424922747_1907140739452079368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4jX9cPWkbQQ7kNvwGq9RdA&_nc_oc=AdoYJIyiH7lJH6RbT6PVr1FBCgxXNjOoTfDi2CF3krFGzH_qLhz-y4PXR7Ry-C6A1yU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uq0OiBXRsAlJXzihr7iIVK6aDDUS17whu7Em7m3HY3Q&oe=69D8DA39"}, {"file_name": "screenshot03.png", "id": "1320236425766559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1320236429099892_7026969068655260219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBFxzff1VE8Q7kNvwHBswrQ&_nc_oc=AdrfAr6s5JpYwmWg52ndq8dHVgm37TbTCw7sxl3ptMGElCQSW8UFS4Gldn-4lJl5fnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vl1bxRVZoAtQfEq3KLSHCv_kYqEUSe4JrrVT_qxLbBA&oe=69D8E9D3"}, {"file_name": "screenshot04.png", "id": "1408931723813604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1408931727146937_1574658016866773147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNBAIf-7rDgQ7kNvwHUJRaN&_nc_oc=Adqnoxvjc0qQkBo4vfyAFRdK4ZlSLHbkSR3GNdGLkGefHn40nhmezlmBUw2oMocuNHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dG4Sb2rMaGtFUt0Va1FctUWt47bIa1miXF1MQIvFRRQ&oe=69D8F57B"}, {"file_name": "screenshot05.png", "id": "418176134719567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391998_418176138052900_6204508764481913331_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2slz5N2R3IUQ7kNvwFtiGAi&_nc_oc=AdohtFqzlzX2n9a30pxZ_m7xh_PpHBFKoM-vkASKzBQFq0MGf5aRRpb3txTX8Pwabds&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YbU_r7Q25rBIL1puMkpMUIDJDdDUzZlKfy5AwHa_7RA&oe=69D8F6CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1152565683077389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1152565689744055_250834400001166292_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4dnib97vD4Q7kNvwFL0KDM&_nc_oc=Adpyu-FgxhlomJgnOQO4eQnnh5ORsrCR-ww6geMJVcZeuT_0kDA7WUeeI7zr-FEG8o0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af245Tuljt_pM9wL14VgRJ-PnHs1v7w7kyTPS_vxQlVTmg&oe=69D8DFFE"}, "display_name": "Aerodrums 2", "keywords": [], "long_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking.\n\nAerodrums 2 is an expressive and versatile air drumming instrument. It is a standalone device that uses high-speed optical motion capture technology to accurately track the position of your drumsticks and feet in 3D. Unlike acoustic and traditional electronic drum sets, Aerodrums 2 is lightweight and portable, it is silent when used with headphones, and it takes up no space when not in use.\n\nPaired with Meta Quest headsets, Aerodrums 2 offers an unparalleled drumming experience. Passthrough mode and depth occlusion let you see your real hands and drumsticks while drumming, while hand-tracking is used to further improve stick-tracking accuracy.\n\nTo learn more about Aerodrums 2 visit aerodrums.com", "short_description": "This is the companion app for the Aerodrums 2 air drumming instrument (sold separately). Seamlessly connect to your Aerodrums 2 device over WiFi and see your drum kit materialize before your eyes. Choose your kit, jam to your favorite tunes, practice with a metronome, or record your performances. No Aerodrums 2? No problem! The app will let you play a basic drum kit in mixed reality using hand-tracking."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/privacy-policy/", "developer_terms_of_se
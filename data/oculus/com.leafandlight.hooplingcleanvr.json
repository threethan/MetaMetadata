m/v/t64.5771-25/499314657_1515547867000452_58035367467471486_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=2vzqL1i5vnwQ7kNvwHrUwbj&_nc_oc=AdoT7AyzFime4_1XLSywMm7INEv4FL6o4fgV4WFktaHVj5OME1ihNi5Bj0DTz9HyFyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6uUMjgr_5XI2j9AqnrzgRF_bCu3h4R6Yo1ybhHRG7Ew&oe=6AFDC6DA"}, {"file_name": "Rumblekin_20260925_152520_523.png", "id": "1702676500802272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831964_1702676504135605_770159655932258609_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrKJ-IHWFwcQ7kNvwHzh6qK&_nc_oc=AdoPPWiuSSuowCnSoHVU1y9IXH8L2z2F8qdDuRVQu01RsvLresB_efabfvun9bPPbDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY2Bcju22fCg7mfu4nmh3l5w9rUNCOrGjuo8LyMRLvWA&oe=6AFDE1A9"}, {"file_name": "Rumblekin_20260925_151242_637.png", "id": "1606698784193880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604375581_1606698787527213_6359872122970545543_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkO6MakEiZ4Q7kNvwGCKtFq&_nc_oc=Adocpbs9TzH3b9iDtlFy48WLF6QWyT5tl_3j2TzfkGLUsqYtGbgWUjAymafK5bf3CKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqhyejlmNXfij1NAkC5xVPr2ehQKMTnSmTEPTTLsxmCA&oe=6AFDB2C9"}, {"file_name": "Rumblekin_20260925_151910_325.png", "id": "1782542582819831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673745728_1782542586153164_2474830738934956598_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6k_-96i2drkQ7kNvwGel4qB&_nc_oc=Adq5F52frHOuwKavWihUIl9Hn4cEsGZSrsUwqR7hd8z0m0p86vpCaXpHejKTpYYXaMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWqzfxkty3w8nMFM52-E_tf5G94hlSxQ8yez1AX7qGBQ&oe=6AFDC486"}, {"file_name": "Rumblekin_20260925_152449_518.png", "id": "2917061832003378", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_2917061835336711_8748008804381621692_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdG-rzXAJ_YQ7kNvwH_G0gy&_nc_oc=AdrzNJbhnrm4W_7a8Wilq_fiGXWl5n_iEjzx_QqgcK-eDnjVt4M5bFwxX2EFaWJa2mk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiObc3Jp6irLbGWMsdVHk8QgeAJEEbTj9k1wV844ht0w&oe=6AFDBB73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "exec-2572ce49-11e4-46ae-996d-2fb52b997651_upscayl_2x_digital-art-4x.png", "id": "2394502111382802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/795000614_2394502114716135_4708479858430498170_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xViELTrV_vAQ7kNvwFl4vey&_nc_oc=Adpz0YZ5TUkhiYHE7UIHIURQSFtibytyg0YZeOJyiENu75yIZ3OiPHLVbFq0BdVG3SI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8fawfipQJm8Mlk0eLPWdAS8LuiW8M7pCOSyP8LpgH-A&oe=6AFDDDEF"}, "display_name": "I'm Monster", "keywords": ["destruction", "rampage", "monster", "physics", "kaiju"], "long_description": "I'm Monster \u2013 Kaiju City Destruction in VR\n\nBecome a giant monster and go on a physics-based rampage through a stylized city. Everything you do, you do with your own arms: punch destructible structures, climb buildings, grab objects and throw them at vehicles and anything else that gets in your way.\n\nWhat you'll do\n- Smash a city full of destructible structures with physics-driven destruction\n- Climb buildings using your arms\n- Grab and throw objects at vehicles and other targets\n- Fight back against the city's defenders\n- Grow into larger, stronger monster forms\n- Unlock special powers and unleash arcade chaos\n\nRun after run\nStart in your lair, enter the city, complete missions and earn rewards, then return to prepare for the next rampage. Your wrist interface shows your status, missions and powers at a glance.\n\nSingle-player. Physical. Arcade.\nShort sessions, big destruction. Made for players who want to be the kaiju, not just watch one.", "short_description": "Kaiju destruction in VR. Become a giant monster, smash a stylized city with your own arms, climb buildings, throw objects at vehicles and crush the city's defenders. Physics-based action: grow bigger, unlock special powers and unleash arcade chaos in this single-player rampage."}, {"images": {"nodes": []}, "id": "1804349303988257", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I'm Monster", "keywords": ["destrui\u00e7\u00e3o", "kaiju", "monstro", "f\u00edsica", "cidade"], "long_description": "I'm Monster \u2013 Destrui\u00e7\u00e3o Kaiju em VR\n\nVire um monstro gigante e saia destruindo uma cidade estilizada com f\u00edsica realista. Tudo que voc\u00ea faz, faz com seus pr\u00f3prios bra\u00e7os: soque estruturas destrut\u00edveis, escale pr\u00e9dios, agarre objetos e arremesse em ve\u00edculos e em tudo que entrar no seu caminho.\n\nO que voc\u00ea vai fazer\n- Esmagar uma cidade cheia de estruturas destrut\u00edveis com destrui\u00e7\u00e3o baseada em f\u00edsica\n- Escalar pr\u00e9dios usando os bra\u00e7os\n- Agarrar e arremessar objetos em ve\u00edculos e outros alvos\n- Enfrentar os defensores da cidade\n- Crescer e virar formas de monstro maiores e mais fortes\n- Desbloquear poderes especiais e causar o caos arcade\n\nRodada ap\u00f3s rodada\nComece no seu covil, entre na cidade, complete miss\u00f5es e ganhe recompensas, depois volte para se preparar para a pr\u00f3xima destrui\u00e7\u00e3o. A interface no seu pulso mostra status, miss\u00f5es e poderes num piscar de olhos.\n\nUm jogador. F\u00edsico. Arcade.\nSess\u00f5es curtas, destrui\u00e7\u00e3o gigante. Feito para quem quer SER o kaiju, n\u00e3o s\u00f3 assistir.", "short_description": "Destrui\u00e7\u00e3o kaiju em VR. Vire um monstro gigante, esmague uma cidade estilizada com seus pr\u00f3prios bra\u00e7os, escale pr\u00e9dios, arremesse objetos em ve\u00edculos e destrua os defensores da cidade. A\u00e7\u00e3o com f\u00edsica: cres\u00e7a, desbloqueie poderes especiais e cause o caos arcade neste jogo para um jogador."}, {"images": {"nodes": []}, "id": "1637165121382753", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I'm Monster", "keywords": ["destruction", "kaiju", "monstre", "physique", "ville"], "long_description": "I'm Monster \u2013 Destruction Kaiju en VR\n\nDevenez un monstre g\u00e9ant et ravagez une ville stylis\u00e9e gr\u00e2ce \u00e0 une physique r\u00e9aliste. Tout ce que vous faites, vous le faites avec vos propres bras : frappez des structures destructibles, escaladez les immeubles, attrapez des objets et lancez-les sur les v\u00e9hicules et tout ce qui se trouve sur votre chemin.\n\nCe que vous ferez\n- \u00c9craser une ville pleine de structures destructibles avec une destruction bas\u00e9e sur la physique\n- Escalader les immeubles avec vos bras\n- Attraper et lancer des objets sur les v\u00e9hicules et d'autres cibles\n- Affronter les d\u00e9fenseurs de la ville\n- \u00c9voluer vers des formes de monstre plus grandes et plus puissantes\n- D\u00e9bloquer des pouvoirs sp\u00e9ciaux et semer le chaos arcade\n\nPartie apr\u00e8s partie\nCommencez dans votre repaire, entrez dans la ville, accomplissez des missions et gagnez des r\u00e9compenses, puis revenez vous pr\u00e9parer pour le prochain saccage. L'interface sur votre poignet affiche votre statut, vos missions et vos pouvoirs en un coup d'\u0153il.\n\nSolo. Physique. Arcade.\nSessions courtes, destruction massive. Con\u00e7u pour ceux qui veulent \u00caTRE le kaiju, pas seulement le regarder.", "short_description": "Destruction kaiju en VR. Devenez un monstre g\u00e9ant, \u00e9crasez une ville stylis\u00e9e avec vos propres bras, escaladez les immeubles, lancez des objets sur les v\u00e9hicules et balayez les d\u00e9fenseurs de la ville. Action bas\u00e9e sur la physique : grandissez, d\u00e9bloquez des pouvoirs sp\u00e9ciaux et semez le chaos arcade dans ce jeu solo."}, {"images": {"nodes": []}, "id": "1428042275964905", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I'm Monster", "keywords": ["zerst\u00f6rung", "kaiju", "monster", "physik", "stadt"], "long_description": "I'm Monster \u2013 Kaiju-Stadtzerst\u00f6rung in VR\n\nWerde zum Riesenmonster und verw\u00fcste eine stilisierte Stadt mit realistischer Physik. Alles, was du tust, tust du mit deinen eigenen Armen: Schlage zerst\u00f6rbare Strukturen ein, erklimme Geb\u00e4ude, greife Objekte und wirf sie auf Fahrzeuge und alles, was dir im Weg steht.\n\nDas erwartet dich\n- Eine Stadt voller zerst\u00f6rbarer Strukturen mit physikbasierter Zerst\u00f6rung zertr\u00fcmmern\n- Geb\u00e4ude mit deinen Armen erklimmen\n- Objekte greifen und auf Fahrzeuge und andere Ziele werfen\n- Gegen die Verteidiger der Stadt k\u00e4mpfen\n- Zu gr\u00f6\u00dferen, st\u00e4rkeren Monsterformen heranwachsen\n- Spezialkr\u00e4fte freischalten und Arcade-Chaos entfesseln\n\nRunde f\u00fcr Runde\nStarte in deiner H\u00f6hle, betrete die Stadt, erf\u00fclle Missionen und verdiene Belohnungen, dann kehre zur\u00fcck und bereite dich auf den n\u00e4chsten Amoklauf vor. Dein Handgelenk-Interface zeigt Status, Missionen und Kr\u00e4fte auf einen Blick.\n\nEinzelspieler. Physisch. Arcade.\nKurze Sessions, riesige Zerst\u00f6rung. F\u00fcr alle, die der Kaiju SEIN wollen, statt nur zuzusehen.", "short_description": "Kaiju-Zerst\u00f6rung in VR. Werde zum Riesenmonster, zertr\u00fcmmere eine stilisierte Stadt mit deinen eigenen Armen, erklimme Geb\u00e4ude, wirf Objekte auf Fahrzeuge und walze die Verteidiger der Stadt nieder. Physikbasierte Action: Wachse, schalte Spezialkr\u00e4fte frei und entfessle Arcade-Chaos in diesem Einzelspieler-Amoklauf."}, {"images": {"nodes": []}, "id": "1173897171870000", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I'm Monster", "keywords": ["destrucci\u00f3n", "kaiju", "monstruo", "f\u00edsicas", "ciudad"], "long_description": "I'm Monster \u2013 Destrucci\u00f3n Kaiju en VR\n\nConvi\u00e9rtete en un monstruo gigante y arrasa una ciudad estilizada con f\u00edsicas realistas. Todo lo que haces, lo haces con tus propios brazos: golpea estructuras destructibles, escala edificios, agarra objetos y l\u00e1nzalos contra veh\u00edculos y todo lo que se cruce en tu camino.\n\nLo que har\u00e1s\n- Aplastar una ciudad llena de estructuras destructibles con destrucci\u00f3n basada en f\u00edsicas\n- Escalar edificios con tus brazos\n- Agarrar y lanzar objetos contra veh\u00edculos y otros objetivos\n- Enfrentarte a los defensores de la ciudad\n- Crecer hasta formas de monstruo m\u00e1s grandes y fuertes\n- Desbloquear poderes especiales y desatar el caos arcade\n\nPartida tras partida\nEmpieza en tu guarida, entra en la ciudad, completa misiones y gana recompensas, luego vuelve para prepararte para el pr\u00f3ximo ataque. La interfaz de tu mu\u00f1eca muestra tu estado, misiones y poderes de un vistazo.\n\nUn jugador. F\u00edsico. Arcade.\nSesiones cortas, destrucci\u00f3n enorme. Hecho para quienes quieren SER el kaiju, no solo verlo.", "short_description": "Destrucci\u00f3n kaiju en VR. Convi\u00e9rtete en un monstruo gigante, aplasta una ciudad estilizada con tus propios brazos, escala edificios, lanza objetos contra veh\u00edculos y arrasa con los defensores de la ciudad. Acci\u00f3n con f\u00edsicas: crece, desbloquea poderes especiales y desata el caos arcade en este juego para un jugador."}, {"images": {"nodes": []}, "id": "1128751129733496", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I'm Monster", "keywords": ["\u602a\u7363", "\u7834\u58ca", "\u30e2\u30f3\u30b9\u30bf\u30fc", "\u7269\u7406", "\u66b4\u8d70"], "long_description": "I'm Monster \u2013 VR\u602a\u7363\u30b7\u30c6\u30a3\u7834\u58ca\n\n\u5de8\u5927\u30e2\u30f3\u30b9\u
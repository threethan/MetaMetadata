{"data": {"node": {"__typename": "Application", "id": "1377354358785453", "organization": {"id": "919132067941020", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1377354358785453"}]}, "id": "1060716770158444"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26991548930529478"}]}, "id": "1339450051414657"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25657930913826702"}]}, "id": "1235050165175740"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "32367249162920119"}]}, "id": "1261889409314525"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1377354358785453", "release_date": 1792079400, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 7}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1468614626326092"}, "id": "1627385322305534"}]}}, "binary": null, "live_binary": null, "created_date": 1792712481, "id": "1472596065927948", "is_initial_release": false, "name_with_fallback": "v12", "pdp_metadata_with_fallback": {"version": 9, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1472606925926862"}, "release_status": "RELEASED", "id": "1377354358785453"}, "id": "1472606925926862", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1377354358785453", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1059804890133401"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "29337693852514840", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I'm Monster", "keywords": ["\uce74\uc774\uc8fc", "\ud30c\uad34", "\uad34\uc218", "\ubb3c\ub9ac", "\ub3c4\uc2dc"], "long_description": "I'm Monster \u2013 VR \uce74\uc774\uc8fc \ub3c4\uc2dc \ud30c\uad34\n\n\uac70\ub300 \uad34\uc218\uac00 \ub418\uc5b4 \ubb3c\ub9ac \uae30\ubc18\uc73c\ub85c \uc6c0\uc9c1\uc774\ub294 \uc2a4\ud0c0\uc77c\ub9ac\uc2dc\ud55c \ub3c4\uc2dc\ub97c \ub9c8\uc74c\uaecf \ud30c\uad34\ud558\uc138\uc694. \ubaa8\ub4e0 \ud589\ub3d9\uc740 \ub2f9\uc2e0\uc758 \ub450 \ud314\ub85c \uc9c1\uc811: \ud30c\uad34 \uac00\ub2a5\ud55c \uad6c\uc870\ubb3c\uc744 \uc8fc\uba39\uc73c\ub85c \ubd80\uc218\uace0, \uac74\ubb3c\uc744 \uc624\ub974\uace0, \ubb3c\uccb4\ub97c \uc7a1\uc544 \ucc28\ub7c9\uacfc \uc55e\uc744 \ub9c9\ub294 \ubaa8\ub4e0 \uac83\uc5d0 \ub358\uc9c0\uc138\uc694.\n\n\ud560 \uc218 \uc788\ub294 \uac83\n- \ubb3c\ub9ac \uae30\ubc18 \ud30c\uad34\ub85c \ud30c\uad34 \uac00\ub2a5\ud55c \uad6c\uc870\ubb3c\ub85c \uac00\ub4dd\ud55c \ub3c4\uc2dc\ub97c \ubd80\uc218\uae30\n- \ub450 \ud314\ub85c \uac74\ubb3c \uc624\ub974\uae30\n- \ubb3c\uccb4\ub97c \uc7a1\uc544 \ucc28\ub7c9 \ubc0f \ub2e4\ub978 \ubaa9\ud45c\ubb3c\uc5d0 \ub358\uc9c0\uae30\n- \ub3c4\uc2dc\uc758 \ubc29\uc5b4\uad70\uacfc \ub9de\uc11c \uc2f8\uc6b0\uae30\n- \ub354 \ud06c\uace0 \uac15\ud55c \uad34\uc218 \ud615\ud0dc\ub85c \uc131\uc7a5\ud558\uae30\n- \ud2b9\uc218 \ub2a5\ub825\uc744 \ud574\uae08\ud558\uace0 \uc544\ucf00\uc774\ub4dc \ub300\ud63c\ub780 \uc77c\uc73c\ud0a4\uae30\n\n\ub2e4\uc2dc, \ub610\ub2e4\uc2dc\n\uc740\uc2e0\ucc98\uc5d0\uc11c \uc2dc\uc791\ud574 \ub3c4\uc2dc\ub85c \ucd9c\uaca9\ud558\uace0, \ubbf8\uc158\uc744 \uc644\ub8cc\ud574 \ubcf4\uc0c1\uc744 \uc5bb\uc740 \ub4a4, \ub3cc\uc544\uc640 \ub2e4\uc74c \ub09c\ub3d9\uc744 \uc900\ube44\ud558\uc138\uc694. \uc190\ubaa9 \uc778\ud130\ud398\uc774\uc2a4\ub85c \uc0c1\ud0dc, \ubbf8\uc158, \ub2a5\ub825\uc744 \ud55c\ub208\uc5d0 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc2f1\uae00\ud50c\ub808\uc774. \ud53c\uc9c0\uceec. \uc544\ucf00\uc774\ub4dc.\n\uc9e7\uc740 \uc138\uc158, \uac70\ub300\ud55c \ud30c\uad34. \uad34\uc218\ub97c \uad6c\uacbd\ud558\ub294 \uac8c \uc544\ub2c8\ub77c \uc9c1\uc811 \uad34\uc218\uac00 \ub418\uace0 \uc2f6\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uac8c\uc784.", "short_description": "VR \uce74\uc774\uc8fc \ud30c\uad34 \uc561\uc158! \uac70\ub300 \uad34\uc218\uac00 \ub418\uc5b4 \ub2f9\uc2e0\uc758 \ub450 \ud314\ub85c \uc2a4\ud0c0\uc77c\ub9ac\uc2dc\ud55c \ub3c4\uc2dc\ub97c \ubd80\uc218\uace0, \uac74\ubb3c\uc744 \uc624\ub974\uace0, \ubb3c\uccb4\ub97c \ucc28\ub7c9\uc5d0 \ub358\uc9c0\uace0, \ub3c4\uc2dc\uc758 \ubc29\uc5b4\uad70\uc744 \uc9d3\ubc1f\uc73c\uc138\uc694. \ubb3c\ub9ac \uae30\ubc18 \uc561\uc158: \ub354 \ud06c\uac8c \uc131\uc7a5\ud558\uace0, \ud2b9\uc218 \ub2a5\ub825\uc744 \ud574\uae08\ud558\uace0, \uc544\ucf00\uc774\ub4dc \ub300\ud63c\ub780\uc744 \uc77c\uc73c\ud0a4\ub294 \uc2f1\uae00\ud50c\ub808\uc774 \uad34\uc218 \uac8c\uc784."}, {"images": {"nodes": [{"file_name": "exec-58ed04a7-52c2-4b90-bd81-e257a018d019_upscayl_2x_digital-art-4x.png", "id": "3199317210270618", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604375581_3199317216937284_3947376750743276168_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SCAajABeTgQ7kNvwG-lR8h&_nc_oc=AdqRqvRYkNBNMNRcfPsU-QYU4WShCpTnvo6z_VgO1eEMAp15IItgN98SVnZ2MCrYaf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy2Gguqm2S6mHbdWmZZbQkpk2GVMbGnXUXpD5Qkjr_Cw&oe=6AFDE363"}, {"file_name": "exec-c3dd0dfc-3230-4181-8872-d03cd071ead1_upscayl_2x_digital-art-4x.png", "id": "2120402225515036", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_2120402228848369_6056331316571967336_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sdJnSX8KPYQ7kNvwFyhjLX&_nc_oc=Adrlruw2gqE4qzdliqO71tdbPmzo21Eu10N-6MfoUAYTd1250zQfWhBr0tr7FAZ0vRA&_nc_z
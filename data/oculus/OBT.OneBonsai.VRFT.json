0064061026994", "version": "1.12.37", "version_code": 102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25320061491027251"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3908803442579699", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25320064061026994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "840093856620110"}]}, "change_log": null, "created_date": 1764863809, "id": "24995341636832573", "version": "1.12.5", "version_code": 99, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "24995340236832713"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3908803442579699", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25320064061026994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1764584124, "id": "24970274352672635", "version": "1.11.44", "version_code": 96, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "24970272656006138"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3908803442579699", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25320064061026994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "840093856620110"}]}, "change_log": "\ud83d\udd25 Virtual Reality Fire Training \u2013 Release Notes (v1.11.13)\n\ud83d\ude80 New Features\n\ud83d\udcd8 Updated Fire Theory Scenario\n\n\n\ud83e\uddef New Scenario: Fire Hose Training\n\nLearn how to properly handle and operate a fire hose.\n\nInteractive practice: extinguishing a cardboard fire using realistic hose mechanics and physics.\n\n\ud83d\udce7 Trial Access via Email\n\nNew onboarding flow: users must now submit their email address to access the trial version.\n\nStreamlined lead capture for demos, events, and outreach.\n\n\ud83d\udee0\ufe0f Improvements\n\ud83d\udcbb Instructor App Stability\n\nStability enhancements for both tablet and desktop instructor interfaces.\n\nFewer crashes and better performance during multi-user sessions.\n\n\ud83c\udf99\ufe0f Voice Communication Reactivated\n\nTwo-way voice chat is now back online between user and instructor.\n\nImproves real-time guidance, feedback, and emergency simulations.", "created_date": 1750675248, "id": "9850514361741881", "version": "1.11.13", "version_code": 91, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "9850512851742032"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3908803442579699", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25320064061026994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1750328854, "id": "9820424454750872", "version": "1.11.11", "version_code": 89, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "9820422508084400"}, "asset_files": {"count": 0}, "debug_sy
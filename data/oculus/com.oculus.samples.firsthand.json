LslpZ1y75K8MosZntbrem2ypR3g1cQhNhrGM5uqUW9PXjBXQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEmY-Geq-xTi_M_rU9BFQxqBjA_w8WVjkeMrdglbBc7w&oe=6A9AEA69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FH_CoverartLandscape.png", "id": "585882610542833", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982719_585882613876166_585649627631976085_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cuyb_WFdrCYQ7kNvwFmJAti&_nc_oc=Adqz5bC5vU2ctfx5kGB7K4zxKcIV6F4WJbNhgyb7RVjd4fob3q3xTFeuLO4aj0hBBeQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKrz4weKOWqqGpzPC3D95a_jeYUVJkW1qIsDQZXNT6NA&oe=6A9ACB06"}, "display_name": "First Hand", "keywords": [], "long_description": "First Hand is an official Hand Tracking demo built by Meta. Experience the magic of interacting with the virtual world directly with your hands. Use switches, levers, virtual UIs as you solve puzzles to build robotic gloves, and then experience their superpowers. \n\nWe built First Hand to demonstrate the capabilities and the variety of interaction models possible with Hands. This demo is built using the Presence Platform\u2019s Interaction SDK, a library of interaction components, gestures and tools to build magical hand and controller interactions. This demo is also available as an open source project for developers who would like to easily replicate similar interactions.\n\nWe drew inspiration in this demo from First Contact, the original Meta experience showcasing controller interactions.\n", "short_description": "An official Hand Tracking demo by Meta.\n"}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/terms-of-service/", "publisher_name": "Meta Quest", "support_website_url": null, "website_url": "https://developers.meta.com/horizon/", "category": "SYSTEM", "comfort_rating": "COMFORTABLE_FOR_MOST", "co
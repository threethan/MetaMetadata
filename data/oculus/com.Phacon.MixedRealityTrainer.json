sid=6e7a0a&_nc_ohc=GKN3d4j_bzoQ7kNvwFgtjpG&_nc_oc=AdokuafiWo0Qs9YnuAXN33IYyR_mLSOjY49MHsx0mMDQYmTC1xOuubm1N0t6zTQOsj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8SutL60p6VLiagXQgcLcEJEtYEn6VlSUCdQw2_RFsig&oe=6B0DA4C8"}, {"file_name": "Screenshot_VirtualSurgery.png", "id": "1549587919909508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_1549587923242841_7182008548297222635_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ya0fBf0pPXEQ7kNvwGgiky3&_nc_oc=AdpPI0zAi--BjbGT9p-rFQskqCewYibBGnVRf_7YTCZ0B2Z8756ScQ_pD8AArdF9uYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyYRW2K_bKB9bGOCQNNngl9doYXdA7i4sFSvfBEPb_Dg&oe=6B0DC7F8"}, {"file_name": "Screenshot_3DMirror.png", "id": "1566489145087990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311597_1566489148421323_7907375925164610113_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZXeqCGZTcIQ7kNvwFyz28j&_nc_oc=AdqHYSF7YPa4fc06AbL3me47YWFB7pv7tEBzG53rVlYYCpYDwsC2tQRXKEh6Qut21sE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQa2JodTmOvoeGAEdsB0iteOBujzOLv5oPb6Xt-2T48mA&oe=6B0D99E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "4376964089183892", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311585_4376964092517225_6913497553562190900_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nQrLM6RSakQ7kNvwFbaLEc&_nc_oc=AdrIVOM4-nlyuk_xuAVFZu5dY9CPcRCgq6r7mLzdu6E_vqrgMXhAIehg0tTZAH3rk1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkK1USt3oluf7U9963J_RbyisatnklqrA-8Fg_96lDsw&oe=6B0DB530"}, "display_name": "Mixed Reality Trainer by PHACON", "keywords": ["medical", "surgical", "trainer", "mixedreality", "simulation"], "long_description": "# \ud83e\ude7a PHACON Sinus Mixed Reality Trainer\n### *Advanced Training for Sinus and Skull Base Surgery*\n\nThe **PHACON Sinus Mixed Reality Trainer** provides a highly realistic, hands-on training environment for medical professionals and trainees to develop crucial haptic skills using real surgical instruments.\n\n---\n\n### \ud83c\udf1f Key Features & Benefits\n\n* **\ud83d\udc65 Lifelike Patient Models** \n    * Crafted from real patient CT data.\n    * Accurately reflects human tissue characteristics including **bone, cartilage, muscle, skin, and nerves**.\n    * Handcrafted from diverse, high-quality materials down to the smallest detail.\n* **\ud83e\ude7a Diverse Clinical Pathologies**\n    * Train on various anatomies and disorders such as *rhinitis, sinusitis, deviated septum, and nasal obstruction*.\n* **\ud83e\udd7d Immersive VR Technology**\n    * Combines with cutting-edge VR headsets to create a true-to-life operating room experience.\n    * Features integrated navigation and patient-specific 3D models for precise orientation and guidance.\n* **\ud83c\udfa5 Real-Time Endoscopy**\n    * The integrated endoscope provides a fast, intuitive, and realistic way to operate, closely mimicking real-world surgical conditions.\n* **\u267b\ufe0f Seamless Workflow**\n    * The trainer is easily replaceable, ensuring it is instantly ready for the next session. Many compatible patient models can be reordered at any time.", "short_description": "The PHACON Sinus Mixed Reality Trainer provides a realistic training environment for sinus and skull base surgery. Using PHACON Sinus patient models with different anatomies and disorders such as rhinitis, sinusitis, deviated septum, nasal obstruction and surgery, and more; trainees can develop the haptic skills required for surgical procedures while working with real surgical instruments. Easily replaceable, the trainer is ready for the next use."}]}, "developer_name": null, "developer_privacy_policy_url": "https://phacon.de/en/datenschutzerklarung-phacon-mixed-reality-trainer/", "developer_terms_of_service_url": null, "publisher_name": "Phacon GmbH", 
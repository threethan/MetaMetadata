id=6e7a0a&_nc_ohc=BZDhbko7vbMQ7kNvwHS2WPk&_nc_oc=Adq6clLzUS2u_XO5-4rY7PYNLEcUfBnieOt_PBct6aSrd_0Ai0QVRtqF-3zYwv3PZ1Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6l8B2ek0UEr3vBUPf65PmdjrxKPfGb_3OZNsdr-JXkg&oe=6B09B048"}, {"file_name": "Screenshot_VirtualSurgery.png", "id": "1549587919909508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_1549587923242841_7182008548297222635_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t86oe5meTesQ7kNvwFszAYK&_nc_oc=AdptDu2dkVM_SvZPFNYSOORYrCf4eR1-2TP7Bnho6KRvtQYKxIB_36rXd07A8ejRHRE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfitVoh_sGBzZdArtbCmthTskB-JTMTvQfLbxiNSOqLg&oe=6B099B38"}, {"file_name": "Screenshot_3DMirror.png", "id": "1566489145087990", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499311597_1566489148421323_7907375925164610113_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olASYFARK-YQ7kNvwG5EqNf&_nc_oc=Adpasn0ELFgttqdNsdL1OCqFhbmbrz71cf9cj9SN9ojyak7SfDw1G09ihZ18BfxI_vk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYqFsbgxbl57tcebmUe-hSfkoFnK89NST52YhpYTal5Q&oe=6B09A562"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "4376964089183892", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311585_4376964092517225_6913497553562190900_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkvQxF91V4wQ7kNvwEm35vE&_nc_oc=AdqhtP8VbyN194pPBFB3-BN9UA8g4Jz2w2ouu-xx1qCjC0BEc-ez-UNnQMOWRmK71SI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfX1LuPSqSilrouRVWRNhbDKCzPyKY1Vc5EblDznKF_g&oe=6B09C0B0"}, "display_name": "Mixed Reality Trainer by PHACON", "keywords": ["medical", "surgical", "trainer", "mixedreality", "simulation"], "long_description": "# \ud83e\ude7a PHACON Sinus Mixed Reality Trainer\n### *Advanced Training for Sinus and Skull Base Surgery*\n\nThe **PHACON Sinus Mixed Reality Trainer** provides a highly realistic, hands-on training environment for medical professionals and trainees to develop crucial haptic skills using real surgical instruments.\n\n---\n\n### \ud83c\udf1f Key Features & Benefits\n\n* **\ud83d\udc65 Lifelike Patient Models** \n    * Crafted from real patient CT data.\n    * Accurately reflects human tissue characteristics including **bone, cartilage, muscle, skin, and nerves**.\n    * Handcrafted from diverse, high-quality materials down to the smallest detail.\n* **\ud83e\ude7a Diverse Clinical Pathologies**\n    * Train on various anatomies and disorders such as *rhinitis, sinusitis, deviated septum, and nasal obstruction*.\n* **\ud83e\udd7d Immersive VR Technology**\n    * Combines with cutting-edge VR headsets to create a true-to-life operating room experience.\n    * Features integrated navigation and patient-specific 3D models for precise orientation and guidance.\n* **\ud83c\udfa5 Real-Time Endoscopy**\n    * The integrated endoscope provides a fast, intuitive, and realistic way to operate, closely mimicking real-world surgical conditions.\n* **\u267b\ufe0f Seamless Workflow**\n    * The trainer is easily replaceable, ensuring it is instantly ready for the next session. Many compatible patient models can be reordered at any time.", "short_description": "The PHACON Sinus Mixed Reality Trainer provides a realistic training environment for sinus and skull base surgery. Using PHACON Sinus patient models with different anatomies and disorders such as rhinitis, sinusitis, deviated septum, nasal obstruction and surgery, and more; trainees can develop the haptic skills required for surgical procedures while working with real surgical instruments. Easily replaceable, the trainer is ready for the next use."}]}, "developer_name": null, "developer_privacy_policy_url": "https://phacon.de/en/datenschutzerklarung-phacon-mixed-reality-trainer/", "developer_terms_of_service_url": null, "publisher_name": "Phacon GmbH", "
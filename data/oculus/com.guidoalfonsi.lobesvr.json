ri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoEn0ciJP8gQ7kNvwG2YBOH&_nc_oc=AdoRtYoS2uyADJHFYFMngQI087gw_UjGhCbid5VqcKV9n6d9oDgp-81J4fhzXMWiLKw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3qx-XI1MnDJZ8wqPA5QKAZh30r6g39YzpkVnsWVZG1Q&oe=6AE3395D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnU1GrxS1oQQ7kNvwFDETt1&_nc_oc=AdphTC3K6MhBI4otp-BY7r66rRiMVyUXccb7QCerVjQi1BXzMM3tsULt6P-nPDEnNYY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4VBSDUz2TgKBaseTuWdzIFFplj2kMEZXL5nkmU2y3vg&oe=6AE34729"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwOGfErsHkoQ7kNvwGw-HPh&_nc_oc=AdqJNBRhPhXdA8ZUtHLKKq6i-6nBDMMGgw0V4xPTGpcKflUA70vVrFKutiL1smWOkTU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpp6vjlhs2AAhyFYeObW__NlSKsBYyvOMyioTOSBc1Zw&oe=6AE35187"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4oL0QILQA0Q7kNvwGn04go&_nc_oc=AdoO2ewOSjQojOP0H1sMHNZGGcA9I3pxOWVHmQM89da3YcuiEaNxeA2XbcKZr_ru8uo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQPlAc3He9MrrvtECRgV_BaSUcpDasv4et7xbCNCboJQ&oe=6AE33BE9"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161539443705585"}}]}, "scheduled_offers": {"count": 2, "node
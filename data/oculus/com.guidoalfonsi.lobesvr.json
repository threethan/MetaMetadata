XwIrdefIQaZ9C7AKLoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREeZbGnHkYSCByfMSj2iUD73GxgMkm2qxT1x0VE6oUsA&oe=6B00799B"}, {"file_name": "Captura 3.png", "id": "28134120369551014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqvhCRnwgq8Q7kNvwHj9Iwt&_nc_oc=AdrMKMnc0lmACXnxnCiWAZ6rVrOm1ECW-wuGxHIAmgRrZVyWiey-avVv94ixeRSAYlE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVPfsIl_JKCyib-U3T2DgJsY5x7Jm1JOlauyhfXbut8w&oe=6B00729D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHvnYiRqA00Q7kNvwHj7X90&_nc_oc=AdpOlNpgMz-oj7T3bojYhhJfV2cM-uwEIO58ESbYUOwB8f7uyo1xy3szmLLX3fhlMd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQORYX3XFtZ7hdscM-aTIJLHotjRzpWu_zDaFz7pnoFNQ&oe=6B008069"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srkeZQB8hO0Q7kNvwEek9Hp&_nc_oc=AdoQDVDAK2WNFhDAQeF5bCzjEjBD44HMQWACpQ6gvZ_1QCD8vB35po29RW4cpsN7RMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt6CfeEfrXnOT_VrMu7HAfiUGDbXJLZlPoVGJnooJo-Q&oe=6B005287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaBdFTqshowQ7kNvwE-lGms&_nc_oc=Ado__PxfdSOfDXbDtNJN8zD_FIBa59voLIdltaMmHb4WWU43wTQt1UhMw5iElDmPT0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyeS5wbKU6uEG7k0OvW6rYZjccwEGdcaxOMSJZajE84g&oe=6B007529"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
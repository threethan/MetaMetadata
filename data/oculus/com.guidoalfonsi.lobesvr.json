zfk0pb8LxIiXtVlA9CU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrkYh8STdYrV56fBDGUEZvdedJKn7Qw473kUcGQhtdOA&oe=6B07111B"}, {"file_name": "Captura 3.png", "id": "28134120369551014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgSDmbUMh6wQ7kNvwEHiPuz&_nc_oc=Ado_5u_Xp0YNdTsW4PJ-HC5b9NNInpW-MVdl7ZeyER0-oAfOBhpwM2Uyh-feaaituyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6TLvXz8ShcEd8SDzJJOixB7crjfLPtP7s8vCAklbeUQ&oe=6B070A1D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSlN0OSFEFcQ7kNvwEiQ_6b&_nc_oc=Adrk5NiLp1Zpo4dX8RafKBly502VLCEuyB8eq2CSdXN6uMSjOZX6ICD8h0gLbbmTfz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnywH7PTt81Z4108FD_t-i8ZoDn5h2KxCTMJFgOarNwg&oe=6B0717E9"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyg_hH7J51MQ7kNvwH0Q7xZ&_nc_oc=Adrlyjz0n-eA-QCUdgF8PU6FtfgGvwz4tLjtTdlX4Xq7UlkuseioZEnmCHZTd8Il7Xs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbyb8WRHsXu-liKza8uMs7Fmp_olJbSmMDxA3r7XRg8Q&oe=6B072247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JX0Q9vWxzYQ7kNvwHjOGrI&_nc_oc=Adr5iA5AhnA2yF7mPtXMydqOFYA_h9auu4KxHg28zAHeUHVG8d1aHujeAGbx_7Uv7cI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7XyGc9mMrPegj4WaHM0RrgvApAAl3vVhFO26HK9rdkg&oe=6B070CA9"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
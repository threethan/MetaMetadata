i": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g59B6RYP7VkQ7kNvwFl2xJk&_nc_oc=AdqDWs8X4vOi3RIEfN2L_dcLwT-IGRm4PEFxIMLKmXuHdfgtMPUfbC_dXTxpF-7nmLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK23Cm7qyBE7ODpAGp4kPNeb-Ng4kJQrsLHPjEfxDJ_g&oe=6AF5E69D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yw47WrpENsQ7kNvwFHOE9C&_nc_oc=Adq8tD2pt_Zq3wT1deziWX8WyQ2ml-RqJbPD3uC8J5_0M3Uiz_mKqxnndbJy8gZpvOY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbj_gFO7wq9HYKpJBFFkHWKlewhufLLvjUixTapZLTHw&oe=6AF5F469"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITx6UUYD_b0Q7kNvwET3xfP&_nc_oc=Ado9VbaP2gS9w-Qf-Z4pJD8JF4Cf7Ey0q2pCpJ3uAWc4F-EIIrjxFBc7u2bQi1TySjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk6WkDgJ3CJj5-EmLcp03NZc1vtpK6LeUGgVd4X7n7eA&oe=6AF5C687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unVZ6Ge2zF8Q7kNvwEddI-d&_nc_oc=AdriK_Y1wapWLdVNyymzUDKjtSK2RxDFo6UCkrrBb0OkHlC-SL826UNC1-9npHdSEoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS6XCcKQ8XWz9Zl43wF_SCvzcp0sQTiSU_ZnWY5Y3_NQ&oe=6AF5E929"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161539443705585"}}]}, "scheduled_offers": {"count": 3, "nodes
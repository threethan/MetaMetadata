ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBAz8fKoxB8Q7kNvwFyLZT9&_nc_oc=Adpu6KA0OtGnP1TznHynoHs6noaWKH7KeIhcyMkFyuJwejGS9bX5mNjXqI-XZLHY2S8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf6K3meqR5P3j8QQFDjOGk37xmFiotXFwB2XOGNPA0kQ&oe=6AD24E1D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwIUr3RWlV8Q7kNvwGe6k7W&_nc_oc=Adr6QBC5g9XVlnUpfWPvGyIGAkLytk1z5y5qRQb1CPek2343NrwWozODT2HSyw2N06s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP73_pLMfgi_H0eCjuO3-_bG_IpwiDQNkjKhis0muzMUA&oe=6AD25BE9"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KpIX81hqrYQ7kNvwHgacMB&_nc_oc=AdrHJioxWjW82znFxv1Cb_iQQ9UuTsZdt6aBbKdKMdwNE4KiVjJP3xQDTgLQ1QacHkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS_ExJ4rd_5zlYNPpzoRFYQuLwARV26hd1O2rjmG-kPg&oe=6AD22E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LN5FW8WmQMQ7kNvwFhUtrt&_nc_oc=Adq3HOUHgT8DyaJUu0vBKxtHXK5Ea1vmjMd77xXsHfjyHzfMwzd8OMB5A5ZI3wKKi3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJbI-lK5BtgyJ9NvL0CqGFBJjGaTjS7KCsP9UmzPzzIQ&oe=6AD250A9"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161539443705585"}}]}, "scheduled_offers": {"count": 2, "node
ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b3wevP17PIQ7kNvwHkxbIA&_nc_oc=AdobL4Erx3SQPAul4_b8ihtD0bRB6RYvY8jlWAWyV_hxi5ex7BB5wDlgfc8qN0mDtfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlXgybt_K5VCSa8CRpU2002qvuQCL8zbeU2008I6RrbQ&oe=6ACFAB1D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwIUr3RWlV8Q7kNvwGib-O6&_nc_oc=AdotxGlK9K2jS6pW9i5zIAJ6BOdDpj1mE8xFHFYJdsYaVdSJwomlFSAU__guBIyCkx8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOThFvHoz6qHecQ7_woEgGUt7y4KG-hJsJzcO4zBycm7Q&oe=6ACFB8E9"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avvjErdZhawQ7kNvwFg56-r&_nc_oc=AdqP7GKdK5OWjxMSL9R04Rn01pDZvC3kpYLm9o2VkwEvCZW-O3pgJkgLPS6Q23QqgeY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoeDiLWR4_3larMfTz8JWYSucetdKdGxur6f_HJYFeFw&oe=6ACF8B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7kZNLBf57sQ7kNvwGHeWK3&_nc_oc=AdrBYPWYYwxaJp4D4Y36n85K-yb252bz81lvB0wfb9T6C0oA8E6Q1nDDed0txn1uhKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNv2WfFWHP9hX-5spYZJHB3z0i2QWWkvCMWTVTUWXsJA&oe=6ACFADA9"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161539443705585"}}]}, "scheduled_offers": {"count": 2, "node
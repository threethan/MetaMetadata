RYFmSxh8pW2MlCkzKjjA8_1t5MQVtpLdDx0UCjxndNIA&oe=6AFC80A9"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
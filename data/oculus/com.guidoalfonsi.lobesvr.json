bxYhRJPLSIdsN-Jrfn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYuRU5LMfoKbu5Xgyea1oQ5HUcjakBdBxXxJLbApJfsg&oe=6B0EFA1B"}, {"file_name": "Captura 3.png", "id": "28134120369551014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6LjbquD2sUQ7kNvwHWPN2r&_nc_oc=AdrDRlHOKTb3hU10StIwCCVi4x44mGlR7KH9zTJRXDUwkLvzeFyi6TXnk_24Evpxii0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWE8CJpqT7LcvrAjD8DHzsFhO4VxHMGMrts3RoTk4SYCA&oe=6B0EF31D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0zBQxJJ7wAQ7kNvwHVH68Y&_nc_oc=AdrUcqLpAnZzzN1Z30-IId5llYoDrfvdo_eYG66cY1zm9nEefcCG5-4-q2PuJ7tTw1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWv2DtUJBIqniSmeOIfYV--pTTmAuUD1aZQ4t7g-z7QoA&oe=6B0F00E9"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESjqkd5G17AQ7kNvwHPCtW0&_nc_oc=AdpLguNaJkpZCLkAZuABZNCXowRW-iQJmva7TFE8ZjOMz6IsDsYGduJHakx5rC0p8ZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXcrKcuY22tF8JRfqK2v_SovxZ-SYe1PU5N3SudUwkfag&oe=6B0F0B47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja_cdtS5iM4Q7kNvwF0i07H&_nc_oc=AdrUfAZMMGgVxD3SEGGBn-TkpbB5sWHJiQMK-iTZaeW-vuTbd-ozH4o9L4hfv9_MMTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUbwtrcenNxPkS-PJGpsyvZM81rATJN4UgtEYFiW3YDw&oe=6B0EF5A9"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWQz6nyYpUAQ7kNvwFL-TuH&_nc_oc=AdpZYHzV9oW5Da8Fnr6LImx81YYPYnKV1i48_uBjMy_kafLT42RL8y88r2uHZihLeUg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTSaeehWlEnJoFkgEm91FJMKC9glcJsO90loQ6jxNnBw&oe=6AC3CD9D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac1VH3FyZBUQ7kNvwHcQ6Fj&_nc_oc=AdogZ4r3F9otFQtxTPNGZxP64XJ8hzeLiqveWI367LiBrE_J8n_ozT7uas8XCVjp_Yc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk20haknmyyV1NCHiZEaqXY7zl8GoYSq5oeVcsWRGvPA&oe=6AC3A329"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N21FY6M3h7YQ7kNvwFYIxDQ&_nc_oc=Adrv2uyIex5CwYCjbi7JqJRZXpWCa6rGIHAbTr-Ss7SvZWGRciXxlAENxIsChVZ6iqs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlHCrFOGB9tQMHqN6aKneflBaHl1uw3BB1PQueABmJ3Q&oe=6AC3AD87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2aBfkpk2GIQ7kNvwH7Et8y&_nc_oc=Adrf_jRE-xA1haJCDGaIRNP59eV0lhTrDNeLBZXiXYfkEqmYJrLstWGdTqYo3UueK8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAh4O-Fq_ySxUFPwIrzUUcoL2gODWdhmhuitW6nJMQlA&oe=6AC3D029"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161539443705585"}}]}, "scheduled_offers": {"count": 2, "node
-ABl9zpX6iweU6WCx_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvJtgBJ4l1BymdJQeDLIU4hyvjtX7vpMafXf3KqrUkEg&oe=6B0DA89B"}, {"file_name": "Captura 3.png", "id": "28134120369551014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6LjbquD2sUQ7kNvwEEpJYK&_nc_oc=AdpqhDPrfc-07npsdU4_zfASSL_c3kwr-fzBw03Uy0EWXw6lh-2hsKnMph6Pe-rFqac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkz8yEEAg5wg59axacoK3Dy2B9UqSouvcxVSzbhWaoGQ&oe=6B0DA19D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8vxwvmqJZsQ7kNvwFcdt5k&_nc_oc=AdrTGVkzWYsQvghr8IypGBi1Zf2JXBJs77xvy8vjAETwjr9yigClIiyV_yzs0th5ofY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTwnjMx_zs_6jpGe0XzKYhDmbMct0THCu5LyBX3xUOy4g&oe=6B0DAF69"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESjqkd5G17AQ7kNvwHppdY3&_nc_oc=AdpWXnudYnS4lyHQpgQVchWZbMdVmQ-oRdlGgzaigYQt5w1qDUserkCk1haRQx2-Znc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6B0CBLm2sVLxp1iX8FaEzg1xIEsF4rIGhIaStNE_5Bg&oe=6B0DB9C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja_cdtS5iM4Q7kNvwFvIgTw&_nc_oc=AdrYP_1SfcbOMKaUHuu2WW1ySsxvhTL5ruJ7Ovqc8RDzmGoHPU8gqZ9SQ8BBs0upD8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdzFiEvD27PrHwF3DvupuapLjtbDsbrSRgxZjyE5EOTA&oe=6B0DA429"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
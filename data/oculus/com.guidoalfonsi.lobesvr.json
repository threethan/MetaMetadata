RJzL9Ilof9I1WRdMIeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTH-m_QgXazoMldXUrF2-VsPdPGVcZ0FMPhssJw42n8Q&oe=6AFDD69B"}, {"file_name": "Captura 3.png", "id": "28134120369551014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_28134120386217679_8858562158926486618_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44w87qPIgQoQ7kNvwGPdjqe&_nc_oc=AdrlF2Ag595iaBvg6THqBIYdbVweyETQHglOJ4g6Y0fs-TTH_7NIYz4PMbF__FFDmXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnKF9dE8wfptH0GbTjC156GCihEYvtN79kty4smSdH8Q&oe=6AFDCF9D"}, {"file_name": "Captura 4.png", "id": "2205441703586094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310731_2205441706919427_1672894671402244514_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8MtinFR_aQQ7kNvwG07fre&_nc_oc=Ado9PAPAt_iZYYvnwUBmeO7dQMTtFTS7PDRGMu5tqW3P52Toni-B2wR69p-Tg5sKvF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_UnedPU7841vMT7sdkSGPTDnMC48n5_el3sCdXRMsag&oe=6AFDDD69"}, {"file_name": "Captura 5.png", "id": "1358931295740641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_1358931299073974_2269180434541030913_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srkeZQB8hO0Q7kNvwGut5gy&_nc_oc=AdpIb9U4cUmLc8oWa4yh7WuqKMwm-OVn0Khpo-4JhzzSZ5791HP1Snzk-wFM0Bhq8ZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzhLYySXlL-lDRkIdGNYHyH8NHXolnnrQFOJCbdF1F4A&oe=6AFDAF87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "1071960402151520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312454_1071960405484853_6202798188422353644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaBdFTqshowQ7kNvwFLJtoJ&_nc_oc=Ado7Wa5Gp4NZXkZEo9nem8N467fcmJnNQiZgoE5St2qyNbzF3mhF5IlXLK_T_t0yrIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMeuqWY0ddax114l0RRWiEqBUtuwBAiat-Y0yx-Y0TCQ&oe=6AFDD229"}, "display_name": "Lobes VR - Audio Coverage", "keywords": [], "long_description": "Lobes VR - Audio Coverage is a VR/MR educational tool designed to help students, teachers, sound engineers, and audio technicians visualize how microphones and loudspeakers behave in space.\n\nThe app lets users explore microphone polar patterns and speaker coverage in an immersive 3D environment. By placing and interacting with different microphones and speakers, users can better understand directionality, coverage areas, frequency behavior, and the relationship between sound sources and listening positions.\n\nLobes VR includes 6 microphone models and 5 loudspeaker models, making it useful for audio education, technical training, classroom demonstrations, and professional sound system planning concepts.\n\nWhether you are learning the basics of microphone pickup patterns or explaining loudspeaker coverage to a class, Lobes VR turns abstract audio concepts into clear spatial visualizations.\n", "short_description": "Visualize microphone polar patterns and loudspeaker coverage in VR/MR. A spatial audio education tool for students, teachers, and sound professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lobesvr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Guido Alfonsi", "support_website_url": null, "website_url": "https://sites.google.com/view/lobesvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
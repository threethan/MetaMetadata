85142644625_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3iJQaYVFwQQ7kNvwGKifia&_nc_oc=AdrnkvLaw9B1mdVN6hxF2erUEv2VPJLnmAJYkWYC8PW8NHdpSyvcqidQBdiaLqslF-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e5LEuFUXIhoTyWZiw9wxn4eT6BUD_zug9xxBKs8cQIA&oe=69FC831E"}, "display_name": "Stupid Chimp Slop", "keywords": [], "long_description": "# Stupid Chimp Slop\nis an in-development wacky horror game where you and your friends survive as goofy chimps in an eerie, sprawling network of halls and tunnels. \n\nThis game is an experimental project by XORWIRE, the minds behind BreakoutVR and Chemp Physics, playing around with locomotion, online, quality, and playerbase capabilities, to help us learn how to make better games in the future.\n\nWe have an active community in our Discord server, join at xorwire.com/socials. \n\n", "short_description": "High-quality generic survival horror game."}]}, "developer_name": "XORWIRE Games", "developer_privacy_policy_url": "http://xorwire.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XORWIRE Games", "support_website_url": null, "website_url": "https://xorwire.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24990582773973012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/
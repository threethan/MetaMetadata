Rc_RvtWyoZqXQHuSn4FQLpZ6sBosZf0e-VkiPzrp3MI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2dciULzE0qW-Vjctjkl3W58GJXn7bZTcFsnCHOSMo8w&oe=6B0C4CB4"}, {"file_name": "Screenshot5.png", "id": "2111126399659861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619774_2111126402993194_2809162121741556993_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dKT7Tfvm90Q7kNvwHeroI3&_nc_oc=AdoAU_bsIbchaNJWpESPeozRpcFllCK715FszFkw1L_YQPGSWHYgYps3R0fkX__e5Bw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8kZ8ZG3U9BNsG1uuWden8Tkiu8gIJKqDTehsMEwpUuA&oe=6B0C5D88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master Image 16 by 9.png", "id": "848024484474998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_848024487808331_1383981991559403973_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bs5lM6yse8Q7kNvwEfex_I&_nc_oc=AdoMsHITxK4eaiHUvLpQEY78RbdrxD0qpXBybbRVarZCJnW-GqG3ifg7oDCZRvMCY5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRjJqA63j6xQQZRk4rzL_GQVQ1xUjNnpB-ga4YYOQf_g&oe=6B0C5760"}, "display_name": "Chaos Method", "keywords": [], "long_description": "Embrace the chaos. An experimental game exploring a variety of VR control schemes. The game is designed for VR first-timers and is made with extremely accessible controls to allow everyone to join the fun.\n\nFrom precision chopping to city-smashing mayhem, every game offers a new way to play and learn. Short, accessible, and designed for VR newcomers, not veterans.\n\nFeatures:\n\n\u2022 Built for VR first-timers\n\n\u2022 Varied controls teach core VR mechanics\n\n\u2022 Quick sessions (minutes, not hours)\n\n\u2022 Chaotic, destructive gameplay\n\n\u2022 Progressive skill-building\n\n\u2022 Zero VR experience required", "short_description": "A beginner-friendly VR collection of 13 unique mini-games that introduce virtual reality through pure destructive fun. No experience needed, just a sense of adventure! From precision chopping to city-smashing mayhem, every game offers a new way to play and learn.\n"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "https://tonicgamesaustralia.com/chaosmethod-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25869935665943903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825083_1066535432205853_3313662588276030757_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fev4fI0FIPQQ7kNvwF1vkOh&_nc_oc=AdoHauCqjWidVCpfh1ekOcuSkFQMq__FBVHzNCdfL6CifEtBBkf-JhQbsOImWSCn0yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4cmDI6cckUZm4GzJsq7Rtce5I-3WB_4nece8XOB_4Cw&oe=6B0C76C2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chaos Method", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_nam
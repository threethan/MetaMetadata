=fpjIe5XPZQgQ7kNvwG23-TS&_nc_oc=AdqNPWquJTNfgFs5flaWKQpwevDJhvX7vJaJKZhXz8_GYcnv-lamkAGPCX-tNXJ6hSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3d4WUQ1sYn59XhpDChwVyVN3z8hgy8E7SVtc9nUnInw&oe=6A5CCDC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master Image 16 by 9.png", "id": "848024484474998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_848024487808331_1383981991559403973_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlEvGllBqVsQ7kNvwEhGlkx&_nc_oc=Adr-685Ar58RYhnz2bWMBdnoUh_MiqUgUqrjgE0INv-RypkTY9ZjAY4cIaE9DvDFe80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZw1RRWtVcYHgN4m1eR6OL_6_x7pgcJ340zmyiztDPLw&oe=6A5CC7A0"}, "display_name": "Chaos Method", "keywords": [], "long_description": "Embrace the chaos. An experimental game exploring a variety of VR control schemes. The game is designed for VR first-timers and is made with extremely accessible controls to allow everyone to join the fun.\n\nFrom precision chopping to city-smashing mayhem, every game offers a new way to play and learn. Short, accessible, and designed for VR newcomers, not veterans.\n\nFeatures:\n\n\u2022 Built for VR first-timers\n\n\u2022 Varied controls teach core VR mechanics\n\n\u2022 Quick sessions (minutes, not hours)\n\n\u2022 Chaotic, destructive gameplay\n\n\u2022 Progressive skill-building\n\n\u2022 Zero VR experience required", "short_description": "A beginner-friendly VR collection of 13 unique mini-games that introduce virtual reality through pure destructive fun. No experience needed, just a sense of adventure! From precision chopping to city-smashing mayhem, every game offers a new way to play and learn.\n"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "https://tonicgamesaustralia.com/chaosmethod-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaus
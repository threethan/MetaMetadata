=FUVuYCL9FokQ7kNvwGxWryQ&_nc_oc=AdqzC3YJxuca2ZgpjEDV10bdUsjlZXAVDRrzJR0n6VQJaQMHHZdtJBdfmZn9F8xlgKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBJ4NdObv0R67NX8QecUAIx1_VxrMwsYdD6nMymh3cUw&oe=6A6DF148"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Master Image 16 by 9.png", "id": "848024484474998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_848024487808331_1383981991559403973_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5Nn6qShhxgQ7kNvwEW4rfL&_nc_oc=Adq8wym5P4uVLppfPuDDR89_gtN9fTW59wRzn6WclMF_xaRxhxKioJIc9j5kZ07S3WA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPQSq0t0ioVaNpoZRekYgGHfs51mOrTRwVHZ3kS89AAQ&oe=6A6DEB20"}, "display_name": "Chaos Method", "keywords": [], "long_description": "Embrace the chaos. An experimental game exploring a variety of VR control schemes. The game is designed for VR first-timers and is made with extremely accessible controls to allow everyone to join the fun.\n\nFrom precision chopping to city-smashing mayhem, every game offers a new way to play and learn. Short, accessible, and designed for VR newcomers, not veterans.\n\nFeatures:\n\n\u2022 Built for VR first-timers\n\n\u2022 Varied controls teach core VR mechanics\n\n\u2022 Quick sessions (minutes, not hours)\n\n\u2022 Chaotic, destructive gameplay\n\n\u2022 Progressive skill-building\n\n\u2022 Zero VR experience required", "short_description": "A beginner-friendly VR collection of 13 unique mini-games that introduce virtual reality through pure destructive fun. No experience needed, just a sense of adventure! From precision chopping to city-smashing mayhem, every game offers a new way to play and learn.\n"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "https://tonicgamesaustralia.com/chaosmethod-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaus
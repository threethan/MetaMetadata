7051427674_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhTy4z6X57gQ7kNvwE9MiDA&_nc_oc=AdoW8Gma96DrQdUniyyiz25Luasx_BOO0BPjw8aaNTb80up8GP26Clxjg4XcR8GWAaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwUCjfLyiFga5q6uBLCMTmKV2MGvQHL7aJ_EmUGyg9uw&oe=6B0C5602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover(2560x1440px).png", "id": "965420814821487", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974892_965420818154820_186090445619327461_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhr0Lvd9QI8Q7kNvwF3Koz9&_nc_oc=AdorO9d4zTN7aSykg1IQGrwlHiaQtN8CR_YDLGKEnvP1fyawC56FIQQ0_1R0Q104wKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTA4Z4hmCFqeZ5CaFjZbbyTzAnRJKn7mv_SzHqcpb52xA&oe=6B0C697C"}, "display_name": "3D COM Simulation", "keywords": [], "long_description": "3D COM Simulation provides space for effective education with an interactive, fun way.\nThis application incorporates numerous features for efficient learning in many fields, for example you can develop health care skills using own mobile VR with unlimited access, anywhere-anytime, using hand tracking inputs to practice in either guided or expert modes.\nIn the guided training option, you must follow along instructions to complete certain tasks. When you get more confident, you can complete the tasks again and again without instructions.\nHighly advised to all medical students - or even for enthusiastic amateurs.\n\nUp to 80% more effective learning - focus as much as possible on the task at hand, which changes the way you learn.\nUnlimited access - the cloud service allows you to conveniently connect wherever you are, whether at home or at school.\nSimple control - from embedding sounds, images, PDFs, links, YouTube videos and much more, each interface is 100% customizable to your needs.\n", "short_description": "Immerse yourself in the inspiring environment of virtual reality. Be captivated by the various instructional environments. Try a whole new perspective on education and significantly increase your knowledge gathering opportunities. Develop your thinking, decision-making, language and communication skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrhighschool.at/privacy-policy-and-cookies/", "developer_terms_of_service_url": null, "publisher_name": "WRDATACENTRUM", "support_website_url": null, "website_url": "https://www.vrhighschool.at/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "hu", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "582988643815262"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "907069797063939"}]}, "baseline_offer": {"id": "907069797063939"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1684263461, "status": "PUBLISHED", "id": "907069797063939"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28022078677493270", "version": "1.1.12"}, "id": "238593322031580", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5970335196427601", "is_concept": false, "latest_released_binary
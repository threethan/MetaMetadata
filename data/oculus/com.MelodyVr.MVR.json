ony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality."}]}, "developer_name": "MelodyVR", "developer_privacy_policy_url": "https://melodyvr.com/privacy", "developer_terms_of_service_url": "https://melodyvr.com/terms", "publisher_name": "MelodyVR", "support_website_url": null, "website_url": "https://melodyvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1283433625510522"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031598_1304862569672823_15671936231145472_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvEuGEMSbCkQ7kNvwGfQFhT&_nc_oc=AdrIeS7yuO40wj_rABRQ66D9WQ34UNkVDlfvpldh5MTNG_71K5Z6eE4zC05sFiSlB_U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD_i7GqQB78Iz6pC59TFFGSLsZNII6Z3n-qLfEr2Z2xQ&oe=6AAE8E05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MelodyVR", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1566493200, "lastRevision": {"nodes": [{"id": "2309327729288060", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2617356444966011", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "243387684667
54194384904_4554366419982090240_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGVfjaWovqoQ7kNvwFVNbsp&_nc_oc=AdrCJzw_M0_QteoZqeA7bNBa29of3w5m1eUaE4fIq2KFL6gmP1GaxznypOkfRiyILJg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUFGI9-cGh1yZfqX0zLD7VJTrWJ72IrD_PYqfQeSiF4w&oe=6AFB1B57"}, {"file_name": "migrated_image.png", "id": "2949895651903436", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982669_720439648370979_1361819836186886144_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_QXLJd13DkQ7kNvwFnev2t&_nc_oc=AdrAU9Mcd2QVgPSX0JfqG9vp0kJc6F5RnjMwMcDXmQQ6u4qmxCXEyf2K_rO2fBvqPI4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrsCE2ak5B0qKL_KDfulIXtAWD4wD-MlPwDPPF6QBXUQ&oe=6AFB417D"}, {"file_name": "migrated_image.png", "id": "200204301264584", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974545_346747069283441_4872124030573871104_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I9UUEBhXe4Q7kNvwHIHCz5&_nc_oc=Adp_qBe4xZnwB0AFiVsNFFyurCaVT0_Dtvi7RjdxubKOrRdnyGB7vtATTNWU8p95Gmc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxo66uptWAaMNsS9X_ZutB1bA64TiL_ooR9Iu8Em5Khw&oe=6AFB28B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MelodyVR", "keywords": ["music", "gigs", "concerts", "melody", "liam"], "long_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality.", "short_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality."}]}, "developer_name": "MelodyVR", "developer_privacy_policy_url": "https://melodyvr.com/privacy", "developer_terms_of_service_url": "https://melodyvr.com/terms", "publisher_name": "MelodyVR", "support_website_url": null, "website_url": "https://melodyvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1283433625510522"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031598_1304862569672823_15671936231145472_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flnwDhh-QWEQ7kNvwG-Yt3z&_nc_oc=Ado1hfmRcWLDqFSXEzej4vhmnWRKjR_UfemCCAHu6-usjJ2eKkA774rdSswUUt-U1bY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwT-W-6ad9rVKK_BNhBGtY_LP_Rp8K2UPytDbyerSijQ&oe=6AFB3D45"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MelodyVR", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1566493200, "lastRevision
54194384904_4554366419982090240_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCY7Y3QfHIkQ7kNvwFMhK0A&_nc_oc=AdqDmOry8ellTUrA3D9Yjb_a_SchMaoHz_InnOPrxcg2jeLRCx9Iw9xx5wBuQDF4q8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMujL1Ofe3shQGFQgE5GnOC6frp0QktiD6laA4D2uOjw&oe=6B030457"}, {"file_name": "migrated_image.png", "id": "2949895651903436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982669_720439648370979_1361819836186886144_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLYu6GXLqjYQ7kNvwE5IbPv&_nc_oc=AdoEmRYz1fb52iUX-yzFfk_M8oqq4TggBq88e9hfWYeeC35D1QTEpQmG4md1wDsEMg0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxDZPXZOaXrYQx22RIWCEsSY6JKhDXUiMMsoVpRisWYg&oe=6B032A7D"}, {"file_name": "migrated_image.png", "id": "200204301264584", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974545_346747069283441_4872124030573871104_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcmyKh7gtGQQ7kNvwEJqMJK&_nc_oc=AdpHcgBbTPgNboPiOzsF0-e2O9QHPs0eDvdYDRuD58fumvtY30oBNPqPa4WlgI4wZyg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbNUxmXDNqJ6pH9DgTZVIsbNE16qXqKMixR084aoLjuw&oe=6B0311B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MelodyVR", "keywords": ["music", "gigs", "concerts", "melody", "liam"], "long_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality.", "short_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality."}]}, "developer_name": "MelodyVR", "developer_privacy_policy_url": "https://melodyvr.com/privacy", "developer_terms_of_service_url": "https://melodyvr.com/terms", "publisher_name": "MelodyVR", "support_website_url": null, "website_url": "https://melodyvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1283433625510522"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1304862569672823_15671936231145472_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57ZGejTquGMQ7kNvwEnY9W3&_nc_oc=AdpmuxoYIacdum1IWIfsk7PdfUlr3WKd1Ue1GwpI-DeNi8KjuIbJm1YzuXvQz29BmyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCeqmE6gchvVn8cCc6VzxkSiq1WBtO7JclV-BTumxXdA&oe=6B032645"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MelodyVR", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1566493200, "lastRevision
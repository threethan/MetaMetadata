cdn.com&_nc_ss=7f20f&oh=00_AQEVIIDdBN1KL6RAp_VRbDuB--IpfNdPjtbkXRT6lV_G2A&oe=6A8D7697"}, {"file_name": "migrated_image.png", "id": "2949895651903436", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982669_720439648370979_1361819836186886144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCB6DtScSacQ7kNvwGouus0&_nc_oc=AdqvijhDn83BKpm8elWJ9_csOz3KQiyJZoY4I9WdzfSsRNkri4HNc4O-VQ35FJidFmE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtholN_hU0NA7na1381e6tyu4zrqK_FLEdWh5HrF_jFA&oe=6A8D647D"}, {"file_name": "migrated_image.png", "id": "200204301264584", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974545_346747069283441_4872124030573871104_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taP_PPuF4ZwQ7kNvwFG7ZDI&_nc_oc=AdqhVqWvfqPT1L0aMZHTtQj2ahxNY7uZpRBp-3_xT3om2wn-J4ggL1a8hAcjoM3W9dc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5nZ1te7xjDQIjAPBdgzfY7jBjMa3v45qkLNRjIE2Ong&oe=6A8D83F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MelodyVR", "keywords": ["music", "gigs", "concerts", "melody", "liam"], "long_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality.", "short_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the Lo
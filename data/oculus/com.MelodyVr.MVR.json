54194384904_4554366419982090240_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eH7T4HbdejUQ7kNvwGZ3im_&_nc_oc=AdqWc3DL_BGEWMla8hDPM-EE2TxlSaWwdkjzKvSaeAZV4nYqddyi8jvsEyPCrdXbeSw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ648bnZMsfhqylGz58OJTDoJ01endBfaJy7SOu18ulAQ&oe=6B084A57"}, {"file_name": "migrated_image.png", "id": "2949895651903436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982669_720439648370979_1361819836186886144_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6ohzqpCEusQ7kNvwFnrM6p&_nc_oc=Adp6vGJhgF52LbLLTebUbvJfoL7QIvrYeN6B_JRcPixenAQU_LO07bb1ggRiorHV1e4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmdhGF8o-sJIde0Eq6f4DGOuEK_2x-Sl8r2mAlmUI5nQ&oe=6B08707D"}, {"file_name": "migrated_image.png", "id": "200204301264584", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974545_346747069283441_4872124030573871104_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU3Ff3hp3FgQ7kNvwErWpO5&_nc_oc=AdqQ8zxhjK8Uuyv9Lhn8ZKRrYAaN4-CGYa5uFyPzzEKWJKhq-JwlUKpK97ZhFtvVBsA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGyL4f-e_IXXPil8QhBM4yeY-1gE4q_GLf2KEFXFk9tw&oe=6B0857B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MelodyVR", "keywords": ["music", "gigs", "concerts", "melody", "liam"], "long_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality.", "short_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality."}]}, "developer_name": "MelodyVR", "developer_privacy_policy_url": "https://melodyvr.com/privacy", "developer_terms_of_service_url": "https://melodyvr.com/terms", "publisher_name": "MelodyVR", "support_website_url": null, "website_url": "https://melodyvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1283433625510522"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1304862569672823_15671936231145472_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V4biHL6XaQQ7kNvwHWkoUk&_nc_oc=AdoQfiUL_p-huFuueZVz0NJxgbrFEfHBYQyNADdiQHHql57l4TS9WF-3Zu7U0O5V-lY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzOC2TKHdH0hQeJwAnHseeqmyEfz3McuagEIUDzRXbrw&oe=6B086C45"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MelodyVR", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1566493200, "lastRevision
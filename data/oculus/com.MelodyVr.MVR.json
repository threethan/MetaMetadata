54194384904_4554366419982090240_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsVjOxvgL2cQ7kNvwHhK4qg&_nc_oc=AdoxBr5qtACIRGC9u61vSmhYnSKtnnOTMiEBFUbrcLLi9REGn3POm8Z23LtWqKKwKpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPw6YFtQ-LBfKzT7nMnzgYsM_8W22hmiFdOBa1zxGFYg&oe=6AFDBE57"}, {"file_name": "migrated_image.png", "id": "2949895651903436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982669_720439648370979_1361819836186886144_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fvxx30npl4Q7kNvwHqv9o3&_nc_oc=AdqeIlyUsQ97CEI7tGS1zfMOTQDhjrWuuc-gmrpPzBDvn-YVKtkTQwQGFAxJoL7npbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkvAhm6rIglsJJPEtiT4aeY2cs45d07pbQ7khF2Os44g&oe=6AFDE47D"}, {"file_name": "migrated_image.png", "id": "200204301264584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974545_346747069283441_4872124030573871104_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNziiOXiNcYQ7kNvwFU-fl1&_nc_oc=Adp7tPZYzbKWJl_QIYvBY4LvPKmizI4rctzAL5MnjgyVcuuCQMm2EuU5yh2DSMSVCLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP5sBAWGrBS-ZduEFXohv6SSssNwI56HFPU25pwXOTCw&oe=6AFDCBB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MelodyVR", "keywords": ["music", "gigs", "concerts", "melody", "liam"], "long_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality.", "short_description": "Jump up on stage at a sold out show, be an audience of one at a VIP performance, or catch your favourite band at a festival on the other side of the world. Transport yourself around the venue, from jump spot to jump spot, so you\u2019re always at the heart of the action. With an unmissable line-up of artists - from Bebe Rexha to Imagine Dragons, from 2Chainz to the London Symphony Orchestra - MelodyVR is your all-access-pass to live music in virtual reality."}]}, "developer_name": "MelodyVR", "developer_privacy_policy_url": "https://melodyvr.com/privacy", "developer_terms_of_service_url": "https://melodyvr.com/terms", "publisher_name": "MelodyVR", "support_website_url": null, "website_url": "https://melodyvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1283433625510522"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031598_1304862569672823_15671936231145472_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flnwDhh-QWEQ7kNvwEeR3fi&_nc_oc=AdrC_DRjGhLa9HztvIxLA4CVbBDfq8SAoNBZM1-UJhfKX89tKU3YZe67yKdSAL7E5Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZVNXpa1fI_xaqo8oHqXCVMaaQSUFdCvbdrq6JZU6Syw&oe=6AFDE045"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MelodyVR", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1566493200, "lastRevision
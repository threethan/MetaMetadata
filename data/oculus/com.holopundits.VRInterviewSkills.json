tent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZtSuMHv5Qk4TZMPyGliyW54mqwU8ss6xRBD-mx0c6rw&oe=69EB5E8E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WBhnvB8O50Q7kNvwH8wfvi&_nc_oc=AdoewgpjBRgBRdfPd3UqQdUqEFiyJbFIeBCvpQ8TFSKwxY0JQ-WE8LvIxmJwETDo6x8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z5X85NTJLeJ4BCVO67Bwdb4pmydwMwjmSDhyEjsZNDg&oe=69EB5608"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj885dPBVsMQ7kNvwHUkm1B&_nc_oc=AdrP4F4wD7b34TCalA1mrJTjeRVeC2oRYNFtI3x1Xv8NG0wIDgngBWwr6bt3dOYbpAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X89ehOmeDmogXHocwT3I7iC54SdKlf-Tda23IOiy56w&oe=69EB82E8"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xONwwT2TW-EQ7kNvwGT5nBJ&_nc_oc=Adrf0L2ig3U-N8PUPqYm20LQhbS4DZreIV8m7R6a0V1YOH_5iN2-ZpCrj5MlgzQZ6sE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eEgQQvcVZ0o2XWUbXmb7C-GA-6RZiq-4RQ9qpm1X8_A&oe=69EB7754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FDzkw8n16wQ7kNvwFyMtqQ&_nc_oc=Adot9ydJeDaJJ4nscMuealSfMgcuptDe08q48Gr_4C31jKE1MMznwBg9rg65GBzyVa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QjMq40OyX6NG35h7wEXBmv6AZSwC95KHBCKbV-1pHQw&oe=69EB8683"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
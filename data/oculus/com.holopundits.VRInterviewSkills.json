tent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af636dhd8h4tEHYmzSdhVCAy_azbN2tJ-XOedKcCQu0V4A&oe=69FC820E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDeexgarLt0Q7kNvwHYieX4&_nc_oc=AdoohY8dqDW8ubOUjusN7zfJGXnmLW0IKQgjFlS4IYtOiftzRrLKGjR6Oa-fnXWh1yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jdFAfo3kyqkV6Vx0FT-rb8iw6SL2oGPQ8h0lhKvkx8g&oe=69FCB1C8"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzRkumiSviIQ7kNvwEs1kaT&_nc_oc=Adq0_EBP85ytLTnVc8qbitpC6fxWANk5tuDzPKp9GXVzH6KrinxZGOxNo5xG-vzTx9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J40rZ6AdauM7JOV8yHYKxdH3Smy0FyCVxpUWm4_1xQA&oe=69FCA668"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K26Mva5QQzgQ7kNvwEShIkn&_nc_oc=AdrvL3qUfxgspb9qkBTtuc3gRQ1SwCzKwtkQVNpfz1IHvOSaC8WVMurWhM9bOm_ReeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YQBkETLn9KHhaBistNGJM-5Por67o-hBgnjgtP-uxfw&oe=69FC9AD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9dAqsjsEPMQ7kNvwFpTj-s&_nc_oc=AdqmhXyJz_s5qiTfjqlMGKAKx7V6GW2Q-Ue8RyYeBIUBsEqc97AuQXu8yo2osBzyAqQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NDS5ibmmZx8vefbcka-MiM0uWwnLSgmxwTjpArg7ZPA&oe=69FCAA03"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
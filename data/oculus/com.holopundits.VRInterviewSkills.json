tent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84MVbr7RfTpv8DOm0566ObitJ6W4Bf2xp9KqFJwwpiUg&oe=6A3FBE8E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7opz-Rfiz4Q7kNvwEg_-H2&_nc_oc=AdpUMC2G9Ce4SDq780dQdPLDjWKZ47JMVgrotwmQQ2xd9j0jCDi4Wumlssn4usLPtPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tJoUN69gyD0igwKp1Srgee5KIo4xWUDAEaueiqRin0w&oe=6A3FEE48"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPPtL4TOR9IQ7kNvwFoTPz4&_nc_oc=AdpZVzwOIBxql1JqeqGlIQwAkOorZLkR6KZV-hDn9xVCmdwYPCcAnT-5DcxopymkRpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PLXudsyYalCvrBvHmjCv6gBkjkdoSM9TGknyrI4ZkHA&oe=6A3FE2E8"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzKGxMTFTh8Q7kNvwH6-ltG&_nc_oc=AdpfKTpAxh0WRSz1C8iv5REBsB0jaEW4KGMCw5ZzU-8-2_ui5XGcBcFHx8aWGKL4FD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_zPBx00pCffbjtYdsEs5dwiuanMQvEgwPUZLQrqI7hw&oe=6A3FD754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUmx3-8aOKAQ7kNvwEF3sNi&_nc_oc=AdrBKjJ5vnS4stkCF5pQePxQpsAxFwQlrKcdBhMgkP4dPIwPqpvuEFmcrJszOYRcCOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aoyALnzvoK9mlsy3jI6Lm5tsSWGIo--h_lLnc0jBEqw&oe=6A3FE683"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
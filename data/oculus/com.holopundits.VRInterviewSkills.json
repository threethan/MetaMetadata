tent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkyjAHYKtZEMxALyVHv5JRulMH-pX-H9IrAoB4Qqrciw&oe=6A984B4E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOCBznEYeBUQ7kNvwHq6G9y&_nc_oc=AdpV5yvnAtJUvLK2m2mWcWqjuURIJ-pYwyIsN8jyzyM9CgJAJh4PDNoflBUVFZupwQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ2kcg1xCvBGpe6FnOi2EEW7KgUTIBFGTXkrdPqdT5LA&oe=6A9842C8"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LILxCV9x8PMQ7kNvwH65sZ5&_nc_oc=AdrsGksKaOU2ll6wEpRogMT61egI1MFdsgeiEo7VahcQy3T3y_cmD55hCbHkVPJU84k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8yHSZ1lf9hX0-MpAawQfjzdeBdlUpxpVLetGKDRlcQg&oe=6A983768"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82vxI_hJxrAQ7kNvwHzOMI1&_nc_oc=AdphWf5r1j-vNXr78C9NnXyYtrEHhlTytJhFGzzzIeeViwlRO4Iq-FuDjqy4jYhSnQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyBxW3r5YqxN6q77iUPxFl08bOof0DTSzur-lTqr5VcA&oe=6A986414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCKBNZJNuIkQ7kNvwGzQodG&_nc_oc=Adr5FOH_tgIS9zKZ7bcBiesCD2mll2HxYGQG7bdqa-Yig4Mn8Kry6shOcivb16iHD2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKql8dU1L6_Qz2IKPi9X6k6k1_7jnzGdZNws8oAdjqVSg&oe=6A983B03"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
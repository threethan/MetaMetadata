tent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUXi8pRmKqxYkwI-BLKivlyqrBmiYHdB5eSzBVJ6cgVw&oe=69CD0C0E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fxj-zsszu0Q7kNvwHJtiQe&_nc_oc=AdqI25FWd074Q11vuDFW6ozAMxq5qliczHrraifW-P1JMR0f2c-ri6AqeOVziHhuw0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxF2kvA4vrmENKxg6-fFEPDVIYWiYhJEqjETiTXQe8D2w&oe=69CD0388"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKuMm-uCQSwQ7kNvwGSBFYB&_nc_oc=Adq6aXDIKiYxyhTV8VpEKP4nHRQgcVU8OKA-GCUOiiXGDAOuInycO0wEHUXXKlO8rCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuVjb_6qnmrUCukmifQcgWC0O1qcmf0mh99I2muQXDrw&oe=69CD3068"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8jqo6EntigQ7kNvwEjNqp2&_nc_oc=AdpgLKrlZ-y5Z8V16auRhztuKrM8KhKX__2hbXGh3WyWtAO6-j-IGHCGcFUBCHQciq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxpj8hSbVt0ZH6M4kdhKWk0xwyfLI-PDNrzL2CpcYGO-g&oe=69CD24D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYcQkg2vNcIQ7kNvwHhyo72&_nc_oc=Adqwx76VApdJWPVnpPo7ZV4n_PYW5F3dh_dXnY0lO14dyckjPy9IaqFrxnzhbcm9DTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZqUtI-zPQt7xkT0nrA-l_9CFy1zZNgJTUXGhTSWiRGA&oe=69CCFBC3"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
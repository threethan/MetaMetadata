tent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-B0N6jJouUoX1up_wKVCkuOFSXq6nDeR_CAJ8txI4ow&oe=69CE5D8E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHIpbVSiQnoQ7kNvwH_Ap0Y&_nc_oc=AdrTsW0LuJ8ZVsbWaceA5qSZw_2bBMQFFXUO7xVVHpMI4NQlmRpB0hawoVLnRHjppG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxtycVul1vKkqdgTyYp1WzJBVJuIvIufxHHfFvMEMnMQ&oe=69CE5508"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKuMm-uCQSwQ7kNvwFghVMS&_nc_oc=AdoWExPu7RD5EAYCtjjkAxRkO35nNpJNN7dFAom3cO89IHPyZIu77fhbZpFACw4xkbo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPO3uRMVa_nkXkm-7pthfAs9I13LRPLE8FLn2jGUYyiQ&oe=69CE81E8"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8jqo6EntigQ7kNvwGuqMmq&_nc_oc=Adpv6inO8eH7wezYQbHJmZ8ReWOjRaDsVa7IH3jLJFHbRGEg7jJYXUHjEAxYocARLYg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyv-PTg98AznkzaBrEEPpY4q7hAJ6unqOJ2ZWhDS5nOAA&oe=69CE7654"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYcQkg2vNcIQ7kNvwHYK4eo&_nc_oc=AdoA43o3C4l_eUpvNntrgjk1doZJnMVbCqV6TRtwM2dUCGrv4P43Vx8X97mTx_pxhCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyx0eOJE3DTz9KiYsRNjFHLep2r8KTBzunheIVyqImQAg&oe=69CE4D43"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
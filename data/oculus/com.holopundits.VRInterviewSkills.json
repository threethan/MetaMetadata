tent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwpng_VJvYgWGxQJOytoU9GKcYfv_kj9_Mp6zF6e-xMg&oe=6AB3C28E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=193XUQUXSaQQ7kNvwFc26e5&_nc_oc=AdponmPwWSBDn39u6VPqgfFFWsFOJoPL0urO5axTXDRa7Km95xebUH1ao28X658Kj3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFblWuFg6AjmkTxEdNhNHHXbgOKUNb3stxBdFMdvTQZQ&oe=6AB3F248"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN3ZXpzkWR4Q7kNvwEFO1zV&_nc_oc=AdrjE8Z1gURdcx1-TWnNFm2wmgsqCBRvoPs-Xu2X9qP5hPwV4GTUDQNcRW7otDgoCjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk-j2GnAc6E4WHlUI6kqRUHgLaE_Mi9dmzb64_2FD0hg&oe=6AB3E6E8"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6193ZZhY90Q7kNvwHcylwO&_nc_oc=AdoEO2ftlFDfay4gKG4Mh7CGQaYBcULMO3FPeckTlwt4RuFOV6haGzaVXwyG8GwsmuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf3LlvTf9gLxswB8Cqk8BPosxYlj51R1ONgsCl-Gd-_g&oe=6AB3DB54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVPh3su3Y60Q7kNvwGVFMyG&_nc_oc=AdqTWunHzHhP7Qtoo4vNsqonp2Ol6O7SeEYSr9Zg_vRXmhZ8pMryQJEAKUX6SqYkQ7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6zTi3snH__vSN2VUdfVc9Rt9WImIvHNMjudvy-Lp_Uw&oe=6AB3EA83"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
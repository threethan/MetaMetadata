tent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QYKv97kEyl2KQglJ_RA06IimZcrNc8plq7kj60_ngYA&oe=6A32C7CE"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3c1IQFvdToQ7kNvwE90aRo&_nc_oc=AdoZsKKVxM0yOtGM1PhnFLtcXUKkW_nrQUTN7AQtl04umn9mUKr2wFOt_B1LS97CdIQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8kvKVayzONQia-91XzbEF7_hqIMUqQq3iMurL7Kv_CA&oe=6A32BF48"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP0MtUVcTc8Q7kNvwFDqc5w&_nc_oc=AdoMwtyK_y7gvxhRYYbRHSFHwGOF4nYV0AQ80DXxCBV02AgfiEnzI8RS5vc4IH2NKGg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xGODorH619M4DdCzN3xVIdXZwp7pVPCmBVzbCBSrfcQ&oe=6A32B3E8"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI0hMi0luEAQ7kNvwFrw1BH&_nc_oc=Adoldsbz9gnX4uRVQy16XRfYJoNYNy1YqbFHDG3mGekcJpVfjiS-r-yVi-MBdOlcq-s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TOawKEFfIuQh4xA__VN6gjH_9Ztd17lHpxC-KhOwaRw&oe=6A32A854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGDfzQHripIQ7kNvwEFZJ5U&_nc_oc=AdrgpRJg9sBDirWpbWC4KoR5deBzNJ-lK-K69iN4W9ouJg9jxomSPjyW3unHWCIrGzY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5bbU3MMckMnhQc-07OO5h1E1_AnCIty26VRi8b1YDqw&oe=6A32B783"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
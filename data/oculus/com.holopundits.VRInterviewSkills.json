tent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pWnnr9KhsYa1_GcdTjRBOdq8sXD7GtiDEAP0KMELhog&oe=6A19BB4E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cu92RqOi-GkQ7kNvwGJt3ct&_nc_oc=Ado3aP9lIYTR_D5iz9uQi5m7eEgFaWX_CU-KeInzcIrkpOVNMvkgHO9YyRWoTKyeG30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qfw5_LEjcU1N-BlKDUUtw0V4fbwTmUL40csEPt64gIw&oe=6A19B2C8"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHbaya8EwjQQ7kNvwEll29_&_nc_oc=Ado5HFpLjVGgtnPNRkLoQUNFZxseM2tHepPF3CHU7S84Zy-IKpv8a_8SklElP_yonow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AE2lcSmG1tDo0ANSBLK6Kl4ZViyRRMj4aaGxPO1y_Zw&oe=6A19A768"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0uv8g81nYQQ7kNvwFA2b47&_nc_oc=AdpQmrrb70AJOmzBaWBcnt1PpW1a0fwfRL6Qd0xf1bThxFs3q01fi84yNg7yKcz6gE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ka0tS90siG0QS5EKE-XN1p0ZxK8qogat_nl6hJmFBtQ&oe=6A199BD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQcfms8lYQIQ7kNvwF4JzTF&_nc_oc=AdqSrrfbmmwJ5h8wUmPRrlSE_t6qnMOCaBw_Y3lK7zJXxJm_d0QiclmCE_rEZSrKpoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o0rDgsmMfBbiT0N8mKIdQBvfaxK_Gv0ky3C52mzCycQ&oe=6A19AB03"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
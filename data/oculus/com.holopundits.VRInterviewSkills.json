tent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_CJdYt0kACtZcsFnsuJoPidJkkJqHLSQKotfTlLnQIg&oe=6AE21F4E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE_1EjRMIMIQ7kNvwG2MsdO&_nc_oc=AdqmdgXnIxeyZ_ydP-NxrvqY7vYnIhbpaDKzFZmwqfqcp6879wjvBnLeEXS8Ok7Dk7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObAQtTTNXg_CZbbhu0Vb1FTnzU5Zzs2g7_MkwqSYBMog&oe=6AE216C8"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C0gQISNVhcQ7kNvwEbetJF&_nc_oc=Adpy0H_YjrszffDdBFXbMvjT_b3ZzFjQjc97jfbErKQUuHT3vnwmFI5fgr4YBPcbH2w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxkbLeh8HExa66FsvFdebjLpUhOhDUkY49ONStECq0eA&oe=6AE20B68"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD0eTySmncMQ7kNvwECaXtN&_nc_oc=AdrfY2KOc8kJ7Gp0Dq57mCrtE0XDE3DYDAtlT6zoc1ZRYX4YtNM-WseCukGQUJKtd2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2fkrCW_DzNc-4q_LpUBImEBNFbMPykafe57_vDQzxSg&oe=6AE1FFD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CvGDOfZzX0Q7kNvwEROoDb&_nc_oc=AdqUWE1YVXsf5iXJGa9pVuyNna0Rm8lTDh2-vJu5XnLFQUHXw8nzqN7f5mLJaQ_4RJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1IK6KjhuNMieAwgHh458Ge1sKS_o7AVmPoOzYeTKhpA&oe=6AE20F03"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
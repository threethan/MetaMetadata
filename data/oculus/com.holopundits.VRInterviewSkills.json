tent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xxGfqLss2l5SraX6M8n-2OAHRnOX8Hp9hCUQzs7rUnA&oe=6A1080CE"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30pDbfywECcQ7kNvwGYd7K6&_nc_oc=Adq6OYOV92JiD_SXflIzf5n-ToUhqHcbxCjKXQTS_FjyiCZ6hUEj-G-sdj2KIQoN-Bo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rfU8RmcT3Xf-hZYREXDAC4VoCYGFrwpyyKIT-foz5SQ&oe=6A107848"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVZoKMiRfMIQ7kNvwFvjFfq&_nc_oc=AdrzvpBf6kKh4FLdhuxiKPl_wS_tWUKsmXGvlhvdjv6UrBv0fZZWXv8lnB8s6VPHFfw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56vKnI6O0OZS3F9SJ1bBO1nFT90miTI7sDPebx47j66A&oe=6A106CE8"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VldHe-COhp4Q7kNvwFw0B7c&_nc_oc=Adp1tJ3_qdDeI5iwCCUX6I9dMJuSNkayxmT9f3xwsCiR5GvZQT3Da9yIj05fa-hbzqM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IuDSmEUrt78KHJp19o6oSiIjwc6Z2RIQMU0bxF2YARg&oe=6A106154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5n1EVErqaEQ7kNvwEsQSpT&_nc_oc=AdodxY5byCRE8J_Nt-cbrf-1SMY0z1PGu5-c7vk5uc_usbrwo975L1Ke_S6XZsAtrmY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Nm-UP1VOuEeTqMWSGqaXrAmSuxiJmp-zLkkYx8QCwlQ&oe=6A107083"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
tent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlPVWw2b1O4xWOnKXzni0UdU-l0KOMc1pkcwAgsPAYEw&oe=6AB0064E"}, {"file_name": "Interview_skills_Screenshot_03_2560X1440.png", "id": "1002386077791873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982603_1002386081125206_5702072810957381411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWVcliv5MicQ7kNvwG9fq8p&_nc_oc=Adq5RNdBfgbCX2FW5lcJeEvhTP3CmLHqK1y-9UtZtrTwi2ZI8dlkcMn2X2EnW3aVZRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-3Plip1SGuwBxkp5itHsGzkgY_JS0qZNeWwoPWltdeQ&oe=6AAFFDC8"}, {"file_name": "Interview_skills_Screenshot_04_2560X1440.png", "id": "1352903858985422", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974527_1352903865652088_5199668828185934014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0MT0DIviQAQ7kNvwEC2OuU&_nc_oc=AdqydaejBQD_i-rh89qnWIjFF0ZuVhCxHZAuRkZkBYak5UPgf0XyE9_3UMFvfouyOVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIWQI1wF-1Lt_S-_XjAlF9zwAKQF7TDfwDG77xbNxRiw&oe=6AAFF268"}, {"file_name": "Interview_skills_Screenshot_05_2560X1440.png", "id": "6388885501227348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974788_6388885504560681_5773199120977009194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm2wuIPfN80Q7kNvwE06mF1&_nc_oc=Adrd6sWznRNfnJvJAtJTXBniLjuOXq1UCX4O5zSJ8TKxAwynuTvr9XiU4i0X7kkYBds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWvL8wSBt6d4l0T_VY60v6WlEuDaedMS2sRJsPIneUIw&oe=6AAFE6D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Interview_skills_Screenshot_01_2560X1440.png", "id": "307703721692608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982516_307703725025941_2021162934857628277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtkUzTeKW1QQ7kNvwH9Cs8h&_nc_oc=AdoMRWZNos063ptN8zH5j-oW17suT4cIgcvxoSnIOZByq--taQ_8arjkalkwrCNSSXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGgxg_OgptWA11cabmZ90pJagtJVluDqlxq32VR6ZOSQ&oe=6AAFF603"}, "display_name": "VR Interview Skills", "keywords": ["interview", "training"], "long_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews. \nA comprehensive pre-interview checklist initiates the process, guiding participants through crucial preparation steps. This tool prepares candidates for real-life job interviews. Real-time feedback and auditory cues foster a continuous learning environment, and the ability to revisit the VR interview simulation reinforces the learning process.\n\nKey Features and Learning Objectives:\n\u2022Two Interview Styles: Practice both informal interviews with one person and formal interview scenarios with two people.\n\u2022Realistic Interactions: The simulation incorporates a realistic question-and-answer flow that emulates real-world interviews. \n\u2022Expertly Crafted Content: Material researched and designed by subject matter experts.\n\u2022Embedded Learning Objectives: Ensures participants can recall, understand, and apply the necessary skills for successful real-life interviews. \n\u2022Seamless Navigation: Hand-tracking and voice-to-text are the primary navigation methods.", "short_description": "Our Virtual Reality Interview Skills training package is designed to help candidates seeking employment significantly elevate their interview skills. This immersive VR training provides a hands-on experience for mastering interview techniques while building self confidence in the process. Participants can explore the VR environment at their own pace and engage in one-on-one conversations or formal panel interviews.   "}]}, "develope
00_AQUypFtgFJVg3CPzaRZcPTqppDvOnSUvSAGLmZpGHirHKg&oe=6B105272"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SOW_2560_v2_2.png", "id": "703921520492035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_703921523825368_3154800761755179954_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es9l2vhxX24Q7kNvwHG8RSt&_nc_oc=AdoHKdU0ZPEbFSQ4zJWzJ0w64QEy7AO2q6rC4W-tdx_yZH4Xuabj7qX-R3fG9QHcEhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXY2AHnf2C_AcEA0Cw0HxrMNH-5B0tZ3I_HJ7R-lA6iPw&oe=6B10443D"}, "display_name": "Solicitude Wake-up", "keywords": [], "long_description": "Solicitude Wake-up takes you to seemingly abandoned research facility. You wake-up in a dark operating room, laying down on operating table. As you start finding your way out from the facility, you start to hear voices coming from other parts of the facility and face all kinds of disturbing things . Your only help is the flashlight, that you found from the room that you woke up, but unfortunately it is running out of batteries.\n\nExplore the rooms around the facility and collect batteries to keep your flashlight working! There are key cards to be found and you can access more rooms after obtaining new key card. Avoid the monsters during your way and learn how different monsters work to make your task easier.\n\nWelcome to the VR horror in 2021!", "short_description": "Solicitude Wake-up takes you to seemingly abandoned research facility. You wake-up in a dark operating room, laying down on operating table. As you start finding your way out from the facility, you start to hear voices coming from other parts of the facility and face all kinds of disturbing things . Your only help is the flashlight, that you found from the room that you woke up, but unfortunately it is running out of batteries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jrissa.wixsite.com/solicitudewakeup/about-1", "developer_term
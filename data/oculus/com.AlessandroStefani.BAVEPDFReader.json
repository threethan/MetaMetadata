nt-sin6-3.oculuscdn.com/v/t64.5771-25/38982588_923182286521868_6760010413303055883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byfk4ljZL4QQ7kNvwHN7nxM&_nc_oc=AdqT60wV12iKLKc_c_TS9Msv3WQLoSKIYMmORIMHN_59wSRWhtw7jZ_LkOSWhBOymG0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TFUWIqtdH6QZYiQ2dZpVSaBD-MGcFRMyX-RwbONitCg&oe=6A3951AC"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quk89GgsbF4Q7kNvwE_aPmL&_nc_oc=AdpcLbMp-VBQNTd_qh_J1YNUKq2sHnFN2CMAaFxZmeMKrcbibF8K1Qh_OMeuSU_cue8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GsoTCBd3t6mDNnLeSCUDT_Xw3f6j_nBiXav8TAAH_xg&oe=6A393696"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_TDzfPdUh0Q7kNvwHHD9In&_nc_oc=AdotlNvP9xgtCXaSIvvivbDc0ygL6ZDgTU-vy29mBw4mpAmtjuGCREfH0jrcSu2y7jQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oa40BD_h7Kr0y6lpUkvq1w_RvphEmXyQ7_2zRqgSCyg&oe=6A3934B3"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3R814SvGQgQ7kNvwFzok99&_nc_oc=AdrL8UOh4OqZk0h99mWfZRmsxRhMuj1_Seyoy66o6ENAXEhuA2cxZmlrqbl-0JzC3gc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BCScVEXxwn1uk9TpsYAC0RsLwOcivnGK1CRnvXCMOVg&oe=6A395B91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
jc3-1.oculuscdn.com/v/t64.5771-25/38982588_923182286521868_6760010413303055883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ6_zd0y9YwQ7kNvwGRFCjH&_nc_oc=Adrrj0TFgbLUKXihj_-9iMvEH2GRrZjiCtoBN76Ib4pDngIpa5eBruxO6c52-idxUAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7D1G9WvbR6g4JR0_FT9u9vC4VccH4Y1iutzz8CJ0Vgg&oe=6AA56CAC"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvOne5Ehm0IQ7kNvwF-QMBC&_nc_oc=Adq1UpN2SO8DZRsdUoiIsGRgDRHYirHtnYh2vSJ0GS0XP6BIsXmLRzX6I0VpBf2uUjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEhdG0DDR8fb3LbFRDsawUgqB-T6STcsfv4Rk6GTQyjw&oe=6AA55196"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZv87rmhiswQ7kNvwE0YurG&_nc_oc=AdoTIKUJnK0sLZLtOww2NSGz2cgY90IsKgxGuKi0bZKjVmnDO8utfXcAUdR3tNx0nBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5zDp61IhRpzEkN--YnvWDZjVo1gJID3pKTnom27yi3Q&oe=6AA54FB3"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrBuQEPEfzYQ7kNvwEUiMzC&_nc_oc=AdrZTimgXuoLj0dTo-9Ab9Sl9eRV2WEzfUr1DJHmP0UY5B51np1WcuS-mmmE-eKOaxM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlEmkwn6fiYRzECML2EjmJuCLBoXHveUcGT8bLofPkpQ&oe=6AA57691"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
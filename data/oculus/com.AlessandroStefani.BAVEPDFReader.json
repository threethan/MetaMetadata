&_nc_sid=6e7a0a&_nc_ohc=BtBrTga7--YQ7kNvwFk9aUI&_nc_oc=AdlJEqtoQFZIl33zP7RZLbf1xwzfZJSqMZmYbeQJ-WFpqys-_yq5r_iiyrg_9_9KPQc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftwc6dvyALIuvvM11lXiElwMw2pfbDy9LIxiIZZF9Z4qg&oe=69A17CEC"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO6XUdbtiFAQ7kNvwFjSD1p&_nc_oc=AdmlO3kwwm1argFeTrqtEWlsd8KuDO-gfpnDxKC92XusbQe2awmUx_5DP93Gg74xPuc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsX0U6gSo2PABoamB0--WaCvRv_6uxbN8FHplZQmYNv9A&oe=69A19A16"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW8yvFhtUaYQ7kNvwG3sNUR&_nc_oc=AdlH6l_Oep_sFCfE0Srd7S02ZoRAgxDldjZVD76wmOg9WKANErZEgPnSQ0_bSx67DiU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuaaEm7PSb0iJ10XCVaRoqdiWG0H8IY94mIS1rpXIZqCA&oe=69A19833"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIt43BeUoBMQ7kNvwHahJxD&_nc_oc=AdkUaGEgZ8DQnkkmGwBdudAV3KOa6ZmaIKtfoGKW-xpg9cSkshWnhN7p2y2Aa9sBG2I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuithHpxWvP8KpGx6ZILCA94sJ2bggZiF2H1FRK-ctpYw&oe=69A186D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWN
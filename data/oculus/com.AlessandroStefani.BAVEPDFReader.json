ms2-1.oculuscdn.com/v/t64.5771-25/38982588_923182286521868_6760010413303055883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu68GSzURrwQ7kNvwHRyeZ8&_nc_oc=Adq7O6R_eYeTBbzQpiOYz68aabzPJhcrAh35Gd8emduo48oHmIZQ_XgqKEyNQP6i70Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q7FP3X8BRbrzlTkUQHfWd7P7lLO2D_EP-DNkLvFue6A&oe=69DE21EC"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtkBfnY5oR0Q7kNvwE9imhy&_nc_oc=AdrnweVCD5IZphf68qxX0V8NPOVYy_qyq6vB6p-aE97NDmjrhynMLiP8QQ218RTxTv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EYMApfaLaHbdGRrHPD8ZcNZShleqmO72p1Pjs04AwsA&oe=69DE3F16"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhw101OSHhQQ7kNvwH9BoVN&_nc_oc=AdoshnLGSf8TIs7dgdxdt-OvQzmCaHYlJrsRCrq9EM0a1kKzlAVqcXDywT_s96cYxuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07vli8LXVFPWRs170vnD5k-_1iW7Abxmd5p8uF1DdZFg&oe=69DE3D33"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqQOQm-SefkQ7kNvwEr-jEE&_nc_oc=AdpWL1ALTjua-HbaXR2IRTwYLCqxJJBUP4JU_VVxp8qTu7kTs1rSdBt-W95ueyXZnCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y1vLfnB-d-TFUhBW0X-bzPdR3tVLb7UPLu_o2rByxgw&oe=69DE2BD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
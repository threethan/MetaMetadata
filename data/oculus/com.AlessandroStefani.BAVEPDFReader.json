ra5-1.oculuscdn.com/v/t64.5771-25/38982588_923182286521868_6760010413303055883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EjCDYm1gBQQ7kNvwH2lpZd&_nc_oc=Adpt5zcGZxn_LGeNCW9whTnblLK3RNYo9a8E83vExJhE60c-UDmKT4nd6_kR1FdZ1-c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqivuGFlj18Zi4xGChDXaztalHl1JONlKQxCjaXyWtJQ&oe=6A88336C"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIWb9xvobpUQ7kNvwEwXGPY&_nc_oc=Ado6EDYheynGgtiKn5BsS4O_EVtWRp42GSf6_gs4j9YujouVdJWKXsd6Ns7UBhFNbf8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV2GuXkBNJ5GGWbpaAmUCGjc0YGNk6NHQeEo_C8hB_Lg&oe=6A885096"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0_JIjWPCSAQ7kNvwHgk06O&_nc_oc=AdqOX-95M2arfPEP8aCtSkeADsrPXuefAfJv1ICBAZxmWgiBi6sEQ-qgAPb5_n1WptE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcDfJsPDNgOTBzpu_wKbltBIsdkRgdtMqBqOB0OHzVjw&oe=6A884EB3"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YjVVuR12z4Q7kNvwF98Zwa&_nc_oc=AdrceszsJGBYd1oAdSriOLWX1AFrFlyl5VlFGV_mCWyRBHvhQjRlBvaYK1znj3o5AyQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVbCtrruafpw84SJoTHpso97Xq8Eb4bm6-d0hwZAYFdw&oe=6A883D51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
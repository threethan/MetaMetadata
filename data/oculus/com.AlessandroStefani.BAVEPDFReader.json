fw5-3.oculuscdn.com/v/t64.5771-25/38982588_923182286521868_6760010413303055883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85c5Sarn9QIQ7kNvwHmshBk&_nc_oc=AdpuC3guKVrVd6V5AJ25_MdhYuGZDDFTlk7rwZzBsOULJ7AQdVBTepq__fd-sGEfvQ4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gWo-kqDuhnFJmPyRRnQbZJO-42zJArAn7ZuKoushlRQ&oe=69FDFE2C"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUab77vbAowQ7kNvwFYrOQT&_nc_oc=AdpA0wSyoQIvb5G2FE-6CrMMDg0D-WRC_owrVfCKHdF4NmTulwIUhqnY-uYpVYLUxqY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af579v6mEAGw3EECtJEOUCgklsN_pGoB_GLHA3fNoRyIJg&oe=69FDE316"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBEmj7UTG-YQ7kNvwEPo_lZ&_nc_oc=AdrdH8dw6xg1YPfYwZ1j6v2Nz_-jlSAkgmnaUNIKptCamlyix8Yjm6envAupXt9JOIs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mDSInW6_NqCKvskT9eFTdGvEVnyV74gImj1dTQHZ6fw&oe=69FDE133"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLvp-0dpI_0Q7kNvwEJ-QNy&_nc_oc=AdqQrSKcSKd5M3Nj4x6pQpOsyCKwK-k5_AftzirjNovRO90dzDRzZy87-0-oip16MYg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fwx0CQ0VYpCF49ZxNEn1OJm6nufnPctlK3PIr6NFeDw&oe=69FDCFD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
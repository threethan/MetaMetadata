&_nc_sid=6e7a0a&_nc_ohc=6fZvEPnPyEcQ7kNvwEcohdb&_nc_oc=AdmmlfCz_M4_guWKmEFQR-nlgwgCVYh7cadNXUp9l3lrZEXLi_Z2NQ7toJZLranLBdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvzgMdYmOMhurBqBia3Uo5SC9XAx9YiInQjG4tlbACiXw&oe=699ED9EC"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7c1dezUA_4Q7kNvwFrkbQW&_nc_oc=Admwr8d3NeEThC2yQkshBwmqAx5e9cjWIcqpFWVHhQok-cbtLHiakEW8Y6tmZncVbhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvBnuiAn-8-LGgBUxmm9jy4L7ZnJbXIQQqp6-NNX0-ZQA&oe=699EF716"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW8yvFhtUaYQ7kNvwGjmq16&_nc_oc=AdmW-IOpRTW8z1Q0C3GA_P-eAY1Qc-Y1wluM-8AeHOJrSUlrk74petECsJy1nZWmv9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvQFolWI2Nf0o_S9LIBgDjfCpnkAzqSx-_bQd6EEqT61w&oe=699EF533"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJv_P_BxdZkQ7kNvwG79JCx&_nc_oc=AdmEDsKCih4iByzZaQb-nnDcKR2qckGMlnU4TlpmVYyoMewY9YXKFj8MtVS1iw0lVP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuM72vQJyeSDfjxQe1XrCh7THqQgw_jLlWLKfBPqvwgvA&oe=699EE3D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWN
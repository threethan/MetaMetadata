ga3-1.oculuscdn.com/v/t64.5771-25/38982588_923182286521868_6760010413303055883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQDqTDINP5EQ7kNvwHlpd5z&_nc_oc=AdptXk7ucHnXepTui0K18-QOC8RDN_1hgScpai2h3fncFITKuDWCQc-HNcVMFsCVA6A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSAXAYPCH4Oi5LoZ8YWPrFvBrLh-e4c8v79a7qFksyqw&oe=6AD0EE2C"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YypoMgzPBQQ7kNvwHryXJ2&_nc_oc=AdqSuX2cZznKnmxxhYTGAGDpCpcEHIk7Q0SHHhv37ts-KBjZ_S2SobNa6IdL5wuf1pc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp610dpXa-HBqmzAMsoSVYChRzNvsqdwgE66E3FLMCuA&oe=6AD0D316"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsitNJNzKTcQ7kNvwG3tSl_&_nc_oc=Adroq4FDe13nzkTj2lQkiQFMNM_n750mzPoPfTvOeWqKugt8xCAVVWRT5B_v5cz0Rug&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7-9egC8h8c51u0M8cuwMdJ9WxNi-VoChfx1WM96Gapg&oe=6AD0D133"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb_2CiOcA6IQ7kNvwH9mFye&_nc_oc=Adq34yug_jmQLdXUCyDsl9UrgrhRbgYEGFO93QpMrDw-ReyT52sPowdKrjVzDutF9Gg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEnOopiHW8D70DnhM7dsOgdVCtrM0UaKK99z4igAxlKQ&oe=6AD0F811"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
5/38982588_923182286521868_6760010413303055883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ySxU4so1JIQ7kNvwF8PHvd&_nc_oc=AdlA2f4W_oeqS7kYb_X_-Pi3q96MJ0jgN2wL4dPCkAcWoH7W8S2rSyQzhuit6yD00Dk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvTdjRA-oDbJM8p-TYrt7Mj0MtDltl2wfp7g6I7Kb-nUA&oe=69A8146C"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNnfOG_DIswQ7kNvwFnFZjt&_nc_oc=AdkyGnT5XPQKTOV5iwKiloTZkV4WkO9LwUlul4esdfdjuHdlB9zTFunsII0XCpTpLJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvWw_CuFue4osv8u6nYQ9Vs56iztsVOH45qZHurBICBdg&oe=69A83196"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL3vAH0uY1oQ7kNvwEC3gu8&_nc_oc=AdmmE1BDC4G2SlhvQ3kzCxbyoymAFG-ApNbiGpwDCfParJNqBNqTtiC67BFGEH0cyCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftFbli47gJeTGFwuXksCp1aSDDl2YPhuTRTMp9zu-5zyA&oe=69A82FB3"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5bKFOqSQmsQ7kNvwHkoCgy&_nc_oc=AdmcdaHzYoCd6nTzCLCIa2r2au36sZPAd4chPuwi02J0oxtLMf9q1ucGMH8g8Oeyw5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftUBvSB8Wd1tRM0gbG_6ozroTPEQZ5KCetwm2ebr1V-rg&oe=69A81E51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscri
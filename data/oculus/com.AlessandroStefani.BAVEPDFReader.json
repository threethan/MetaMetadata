o_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "This free PDF viewer can display PDF files in real scale in passthrough.\nIt's mainly intended to display documents in real size (A4,A3,A2,A1,A0).\nUseful for creatives, architects and engineers that wants to visualize the documents before printing them (save the trees!) in a fast and easy way.\nSimply drag and drop your PDF files from the PC to your quest via the USB cable, or download them with the internet browser. \nAt the first app opening, remember to grant the permission to read your files when asked.\nIt does not support advanced PDF functions like password protection, fileOpen etc.\nThe app is still in developing phase, all feedback is appreciated!", "short_description": "Free, simple and fast PDF viewer (preview)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7982077921840915"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1154017133015650"}, {"status": "PUBLISHED", "id": "11802062
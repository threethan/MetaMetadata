ra5-1.oculuscdn.com/v/t64.5771-25/38982588_923182286521868_6760010413303055883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp3BE11izo0Q7kNvwHCJV4M&_nc_oc=Adp40PdpHzIMiOcJJ_6S4B5N_hq-jrPq7CuTi4DwGuiWlUwE72kDrX-8cHgJ6nhP4FE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJM7jlUOFKp3wgGsV0JWtej44U_8JzVMCpauvBUiZQvw&oe=69C7B86C"}, {"file_name": "Screen-2.png", "id": "955080459783476", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982687_955080466450142_9142050175833428486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v88uI5HJzYQ7kNvwFU2Wfw&_nc_oc=Adq6e4DPnqTkhGW6XMVw6iLniEkugngmCvzlqgH7LDJU9div3A4rW3yzrBKZoYQmVas&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKAAIsbWZz6IHti1Kgk5satfoKGbUCEhqyRTv0VyJ24A&oe=69C7D596"}, {"file_name": "Screen-4.png", "id": "578777174502591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031456_578777177835924_5647234019236652575_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z1uGzjLvwUQ7kNvwEr7IZu&_nc_oc=AdpEhRHyRQQlhqiru3zV3D5w7dAvNj66o-8epybIxUt5_44uN_2qbp8dImKUorg_wLM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxsgFXLT5V2QFFRb76UzmcHNXFPs5ACycHfjk1V2ygNA&oe=69C7D3B3"}, {"file_name": "Screen-5.png", "id": "1744410642996406", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031339_1744410649663072_9038105118067916280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VFklu_p6g0Q7kNvwHhGZ_H&_nc_oc=AdrNYv5ZQ3JQPJ8ihotKdYi5PPDbOdTax0BntJKvuZj2_sK4NJfLlCrcRtHpc_WnC80&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywAOODreSJJm8nwYNtBUQdtNWR8ryCojFe-RNyXtswtQ&oe=69C7C251"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PDF Reader", "keywords": ["PDF", "reader", "document", "office", "bave"], "long_description": "**Mixed reality real-scale PDF Viewer (with passthrough)**\n\nView yor PDF documents (A4-A0) in actual size using mixed reality passthrough. Ideal for architects, engineers, and creatives that wants to reduce printings and save paper. Supports for controllers, hand tracking, and Logitech MX Ink Stylus.\n\n**Getting Started:**\n\n1.  **Load PDFs:** Use the headset browser, PC USB transfer, connect a USB drive storage, or try the new cloud transfer (currently in closed beta).\n2.  **Open Files:** Use the left-hand menu/icon or grab the yellow sheet.\n3.  **Annotate:** View, draw & save ink comments on PDFs (free preview module). Enhanced with pressure-sensitive MX Ink.\n\n**Compatibility & Features:**\n\n-   **Reads:** Standard PDF, signed .P7M,\n- **Reads:** Comic books in CBR/.CBZ (free beta preview)\n- **PDF Annotaions**: View, draw and save INK annotations\n-   **Kiosk Mode:** Showcase specific files locking the app functionalities (free preview)\n-   **Add-ons:** Expand features like multi-file viewing (sold separately).\n- **USB OTG Storage**: Read the files from a connected USB storage device\n- **Cloud transfer**:  upload PDF from a webpage (free closed beta) \n\n**Important Info:**\n-   **Limitations:** No encrypted, password, or FileOpen DRM PDFs\n-   **Privacy First:** Files stay local. No cloud processing, no account needed.\n-   **Permissions:** Grant file access on first launch (use settings button if missed).\n- **Kiosk mode** To exit the kiosk mode, click the controller thumbstiks.\n-   **Development:** App is evolving, feedback welcome!\n-   **Support:** Issues? Contact www.bave.info.", "short_description": "Simple and fast PDF, P7M documents viewer with annotations. Free base usage with premium add-ons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bave.info/privacynotice", "developer_terms_of_service_url": null, "publisher_name": "Alessandro Stefani", "support_website_url": null, "website_url": "http://www.bave.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics":
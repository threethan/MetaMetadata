_oc=AdqDCPhjud1xsBipGixNjLgozEXYutqPgDYA4jAa43uv32lTFLPqaR2eFhDLy5MO-Qw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x3e6ke89pdfuZgFuwl5KDLakM5z7BCg3XDyCOHRkJtA&oe=69E243C2"}, {"file_name": "Screenshot 2025-10-27 204317 (1).png", "id": "1541157153564320", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821782_1541157160230986_6370470084530155977_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr6FSjBWz4cQ7kNvwHre000&_nc_oc=AdoN0cAcxeqDk_Q3iSxLnMwyt3LPQu-bufa92cx9n9rSI4Cf8wqjQDrp9_VFX2INnik&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KC-j-UA3Ie8ZqXGVdWj7VcIUq-c1B7PsVuMG6xtvqGA&oe=69E22CF2"}, {"file_name": "Screenshot 2025-10-27 204534 (1).png", "id": "1564813354959035", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499300678_1564813361625701_8124988142769682505_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW2QJ19G5SAQ7kNvwGHBss0&_nc_oc=AdpQLD_7St5ugY5ZG57iBnu1yFQiFsl2HPMIvt-kMj0Cxvxg5omKyAHg6BYj-hmeJjc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GrVdcQ3sxzV9O_0TpjN8_l8Nv14NmIQSau-xCH2XO-A&oe=69E23A50"}, {"file_name": "Gorilla Locomotion_2025-10-27_20.png", "id": "1165682872318286", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491821568_1165682875651619_6205320667049523505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcmB4W-aqFYQ7kNvwHOxsnv&_nc_oc=Ado8NyDBLR9wQ_TxCMMN902xTOpbuquDfb1DtdZ9lQKd7tJ9-5EmMugOK2e2C59S9BQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LsG4jnPLsR4vIcrUCsjeMQAnXkPxNl0ZCXcEbpDR2Rw&oe=69E23367"}, {"file_name": "Screenshot 2025-10-29 162848 (1).png", "id": "1270872168413343", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491823351_1270872175080009_9116934693699291443_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbUOtLq4a5YQ7kNvwFzqt07&_nc_oc=Ado-UotkbKi5pVtcr2ggPL0CivUKHn-lEa4qJMRbKIDlKCzHZbJyGlML6TJY9ZH12vY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lRErxR2_XBifbyZTATdJkTi_m5nnmYXPGxBKid_y8UQ&oe=69E22391"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Canopy", "keywords": ["horror", "fun", "hangout", "sociable"], "long_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f \u2013 Long Description\n\nVenture deep into the Cursed Canopy, a mysterious jungle shrouded in darkness and legend. \ud83c\udf3f\u2728 In this Gorilla Tag fangame, you\u2019ll use your hands and instincts to climb, swing, and leap through a haunted forest where every sound and shadow feels alive. \ud83d\udc40\ud83c\udf12\n\nExplore towering trees wrapped in twisted vines, ancient ruins lost to time, and glowing spirits that drift between the branches. \ud83d\udc80\ud83d\udc7b Each area holds hidden secrets and unexpected dangers \u2014 only the brave will uncover what lies beyond the fog. \ud83c\udf2b\ufe0f\ud83d\udd25\n\nChallenge your speed, reflexes, and courage as you navigate an environment that changes when you least expect it. \ud83d\udd78\ufe0f Whether you\u2019re racing through the treetops or exploring the cursed depths, every movement brings you closer to uncovering the truth behind the canopy\u2019s curse. \ud83c\udf32\ud83d\udcab\n\nDo you have what it takes to survive the forest\u2019s grip\u2026 or will you become one of its lost echoes? \ud83c\udf00\ud83c\udf19", "short_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f\nEnter the haunted jungle in this Gorilla Tag-inspired VR experience! \ud83d\udc12\ud83d\udc80\nClimb, swing, and explore a dark, cursed forest filled with eerie sounds and hidden secrets. \ud83c\udf3f\ud83d\udc7b\nTest your reflexes, uncover the mystery of the canopy, and see if you can survive the curse. \ud83c\udf12\ud83c\udf2b\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/17h-8rdchqhtvtqtphtaml8xpnk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ThatWhiteDev
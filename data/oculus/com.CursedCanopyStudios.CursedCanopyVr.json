_oc=AdqylsESNiU6MGz6hhAFXLPYkNK56DsV8LgKA57qVUIc5XxPsuv3egJGrazTQWB6SQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeTvAKsEgmbLmVF4dpszdqv0ozmpBZufxU5TcprE4Leg&oe=6AB7D6C2"}, {"file_name": "Screenshot 2025-10-27 204317 (1).png", "id": "1541157153564320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_1541157160230986_6370470084530155977_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U9Z3OFpJi0Q7kNvwGgc6ab&_nc_oc=Adqc_jWn-DTcosMLmQ-sbbJsRZgWr0R3rs_iIg-_B-nde9tLDcgywetmPxfXBHkcvD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4ie86n6VnrS4_PQJwQtl7aHfxYyl5_T8GIYYeY7XDZg&oe=6AB7BFF2"}, {"file_name": "Screenshot 2025-10-27 204534 (1).png", "id": "1564813354959035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300678_1564813361625701_8124988142769682505_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGmZznAPlZQQ7kNvwFs3nWd&_nc_oc=AdpZYUSlVmTrkt5_auElFq0XJHTSrb8ES0U0c3BwQqxbNbZFeddQEIk6jgXla1f66to&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz8BoaWx8-3fyS3phFwArfS9ITJbkT_CWAuO935sMmmQ&oe=6AB7CD50"}, {"file_name": "Gorilla Locomotion_2025-10-27_20.png", "id": "1165682872318286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_1165682875651619_6205320667049523505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB2bbVrFwYMQ7kNvwFqfivx&_nc_oc=AdpfAxM7ys1MRTQqgeJz--wrxRtlyOhCCab2R9pt_GJWwo9KIkjRGaSh7GLXCIol7hA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbHS814SE48bYQBclUhmRcbdvjL07Z53OmecTLYDdKzQ&oe=6AB7C667"}, {"file_name": "Screenshot 2025-10-29 162848 (1).png", "id": "1270872168413343", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1270872175080009_9116934693699291443_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YksvOhEc5-UQ7kNvwEAbQAy&_nc_oc=Adp_5gNGzMPP_Cvm0H1YOeLkK41hL1PD4CBqBH1uUy5_Yc-U17AMwX4AR4Cc803fp8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe-5aYnu484qLo6vkF-it9LW6vl6Q9jBxjgNhNr4a_iQ&oe=6AB7EED1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Canopy", "keywords": ["horror", "fun", "hangout", "sociable"], "long_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f \u2013 Long Description\n\nVenture deep into the Cursed Canopy, a mysterious jungle shrouded in darkness and legend. \ud83c\udf3f\u2728 In this Gorilla Tag fangame, you\u2019ll use your hands and instincts to climb, swing, and leap through a haunted forest where every sound and shadow feels alive. \ud83d\udc40\ud83c\udf12\n\nExplore towering trees wrapped in twisted vines, ancient ruins lost to time, and glowing spirits that drift between the branches. \ud83d\udc80\ud83d\udc7b Each area holds hidden secrets and unexpected dangers \u2014 only the brave will uncover what lies beyond the fog. \ud83c\udf2b\ufe0f\ud83d\udd25\n\nChallenge your speed, reflexes, and courage as you navigate an environment that changes when you least expect it. \ud83d\udd78\ufe0f Whether you\u2019re racing through the treetops or exploring the cursed depths, every movement brings you closer to uncovering the truth behind the canopy\u2019s curse. \ud83c\udf32\ud83d\udcab\n\nDo you have what it takes to survive the forest\u2019s grip\u2026 or will you become one of its lost echoes? \ud83c\udf00\ud83c\udf19", "short_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f\nEnter the haunted jungle in this Gorilla Tag-inspired VR experience! \ud83d\udc12\ud83d\udc80\nClimb, swing, and explore a dark, cursed forest filled with eerie sounds and hidden secrets. \ud83c\udf3f\ud83d\udc7b\nTest your reflexes, uncover the mystery of the canopy, and see if you can survive the curse. \ud83c\udf12\ud83c\udf2b\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/17h-8rdchqhtvtqtphtaml8xpnk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ThatWhiteDev
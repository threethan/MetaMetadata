_oc=AdpQylkZy1xWJjrVtf2ASKMNKhlnDdmCR2s_-iSzic7ReaAskUYAjjm65hJ4VQGiwKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGGqv1bm2uSakq5c3BKGTaUqVuBaG-gR1-03apLmlLsA&oe=6A64C842"}, {"file_name": "Screenshot 2025-10-27 204317 (1).png", "id": "1541157153564320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_1541157160230986_6370470084530155977_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WwC5lFI4noQ7kNvwElTMo5&_nc_oc=AdoqRtb5wuLOGhHoSmlZ_74OgmKYXodysqwmG4HX-7-o8I6Bi5BvJR77379HmjcGF18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAATUK6AXAofYSYJtWXNdp5jYhpsesJ0TV2vadwVVrASw&oe=6A64B172"}, {"file_name": "Screenshot 2025-10-27 204534 (1).png", "id": "1564813354959035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300678_1564813361625701_8124988142769682505_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUYadCPkHS4Q7kNvwHJ6Gnz&_nc_oc=AdqQ5m1u6nlTzHgMOmN-Hu-KUvulgULD66CKswttK129XjIb9p2nNtHPQx77nAnJG_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANQdr8T_aYecjKh77IZu34Ds8WNFG3y3Ws1NMGUiMlhw&oe=6A64BED0"}, {"file_name": "Gorilla Locomotion_2025-10-27_20.png", "id": "1165682872318286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821568_1165682875651619_6205320667049523505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCpMGv1ELZMQ7kNvwF_mqtb&_nc_oc=Ado2xezp__PdEn4YgzmWl-VEsnztWgtBxOMXnTm63PKz3CV5lTZG9PAwIxIkn2nhnGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5o5iiOuzfJ1OP_jzsCl9GBrMOOBa1loBhqCdUfuPEtQ&oe=6A64B7E7"}, {"file_name": "Screenshot 2025-10-29 162848 (1).png", "id": "1270872168413343", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1270872175080009_9116934693699291443_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpX8LByr5aYQ7kNvwGQyBxd&_nc_oc=Adp-8-IgYaClLygCbwpedLwPOhOIHntebm3oAliHIR3fSmp79Lsqr9iJRLkjqHKe6X4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaj_yYFtImNwAwUwDsGoqZQJZp6myw1vvk3avetj8csg&oe=6A64A811"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Canopy", "keywords": ["horror", "fun", "hangout", "sociable"], "long_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f \u2013 Long Description\n\nVenture deep into the Cursed Canopy, a mysterious jungle shrouded in darkness and legend. \ud83c\udf3f\u2728 In this Gorilla Tag fangame, you\u2019ll use your hands and instincts to climb, swing, and leap through a haunted forest where every sound and shadow feels alive. \ud83d\udc40\ud83c\udf12\n\nExplore towering trees wrapped in twisted vines, ancient ruins lost to time, and glowing spirits that drift between the branches. \ud83d\udc80\ud83d\udc7b Each area holds hidden secrets and unexpected dangers \u2014 only the brave will uncover what lies beyond the fog. \ud83c\udf2b\ufe0f\ud83d\udd25\n\nChallenge your speed, reflexes, and courage as you navigate an environment that changes when you least expect it. \ud83d\udd78\ufe0f Whether you\u2019re racing through the treetops or exploring the cursed depths, every movement brings you closer to uncovering the truth behind the canopy\u2019s curse. \ud83c\udf32\ud83d\udcab\n\nDo you have what it takes to survive the forest\u2019s grip\u2026 or will you become one of its lost echoes? \ud83c\udf00\ud83c\udf19", "short_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f\nEnter the haunted jungle in this Gorilla Tag-inspired VR experience! \ud83d\udc12\ud83d\udc80\nClimb, swing, and explore a dark, cursed forest filled with eerie sounds and hidden secrets. \ud83c\udf3f\ud83d\udc7b\nTest your reflexes, uncover the mystery of the canopy, and see if you can survive the curse. \ud83c\udf12\ud83c\udf2b\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/17h-8rdchqhtvtqtphtaml8xpnk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ThatWhiteDev
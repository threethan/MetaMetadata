_oc=AdoIEIZYJUR-Yny_PffXhsKwjEQn567jU7qooXekgDOjOvE30_C_hHoiA9zA2F3xNW0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bgGAm5lxr9NXACcIz5mRsnzlPmcf5MQ9lpYSNwjEmbg&oe=6A2C17C2"}, {"file_name": "Screenshot 2025-10-27 204317 (1).png", "id": "1541157153564320", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821782_1541157160230986_6370470084530155977_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry6Fc4O9yWoQ7kNvwE2yMFb&_nc_oc=Ado9OIS9wvY88No13Fas-1oZyVkWOztXLasBOSRHy5ENufrpp9CWn8BJ-CaAbL4AU70&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9agIF_sh9YQMzsz1w9_w9vTo8u5CpkCtMT_qOpkGSmIA&oe=6A2C00F2"}, {"file_name": "Screenshot 2025-10-27 204534 (1).png", "id": "1564813354959035", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499300678_1564813361625701_8124988142769682505_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXFIAuEeYy0Q7kNvwHI1XXB&_nc_oc=Adrs1R1_2JjDQAzSaATUhyNpv2yed-FLU40-XfKRuA4BRi5-Uj_KMEBzKBOxrPc5mgU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__CU6yB09toKTegTUbfL3sxJxZPgUToVWk9M6pWUtHqw&oe=6A2C0E50"}, {"file_name": "Gorilla Locomotion_2025-10-27_20.png", "id": "1165682872318286", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821568_1165682875651619_6205320667049523505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBk-0j_0pFsQ7kNvwEABd8u&_nc_oc=AdqSyPB3HWBZfUCIBHjJD3ERn-hrMJpNzq9Am2CuymAJ0cALNzISz6618km63b-wW3M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O2DhFAhnBLTolb003q-nmZIT_c11KmVTx6znr-whtcg&oe=6A2C0767"}, {"file_name": "Screenshot 2025-10-29 162848 (1).png", "id": "1270872168413343", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823351_1270872175080009_9116934693699291443_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2yeAp9kAaEQ7kNvwGku_05&_nc_oc=Ado108ET3exMOQT2jCVL3C0lmCS6r6ydO_NfTmUxnWxT3l5H9940qp_403fVFRxPUis&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YJu5Yh3w_TDfTkHcCMgba4ag_wMN5pmLJ-fJzKCboBw&oe=6A2C2FD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Canopy", "keywords": ["horror", "fun", "hangout", "sociable"], "long_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f \u2013 Long Description\n\nVenture deep into the Cursed Canopy, a mysterious jungle shrouded in darkness and legend. \ud83c\udf3f\u2728 In this Gorilla Tag fangame, you\u2019ll use your hands and instincts to climb, swing, and leap through a haunted forest where every sound and shadow feels alive. \ud83d\udc40\ud83c\udf12\n\nExplore towering trees wrapped in twisted vines, ancient ruins lost to time, and glowing spirits that drift between the branches. \ud83d\udc80\ud83d\udc7b Each area holds hidden secrets and unexpected dangers \u2014 only the brave will uncover what lies beyond the fog. \ud83c\udf2b\ufe0f\ud83d\udd25\n\nChallenge your speed, reflexes, and courage as you navigate an environment that changes when you least expect it. \ud83d\udd78\ufe0f Whether you\u2019re racing through the treetops or exploring the cursed depths, every movement brings you closer to uncovering the truth behind the canopy\u2019s curse. \ud83c\udf32\ud83d\udcab\n\nDo you have what it takes to survive the forest\u2019s grip\u2026 or will you become one of its lost echoes? \ud83c\udf00\ud83c\udf19", "short_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f\nEnter the haunted jungle in this Gorilla Tag-inspired VR experience! \ud83d\udc12\ud83d\udc80\nClimb, swing, and explore a dark, cursed forest filled with eerie sounds and hidden secrets. \ud83c\udf3f\ud83d\udc7b\nTest your reflexes, uncover the mystery of the canopy, and see if you can survive the curse. \ud83c\udf12\ud83c\udf2b\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/17h-8rdchqhtvtqtphtaml8xpnk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ThatWhiteDev
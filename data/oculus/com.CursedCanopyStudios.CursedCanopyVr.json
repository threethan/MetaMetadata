d&_nc_oc=Ado0lYY5HgBaNeQ75wkEOI0J6StarRIRemyfzPHxphN-cPBqFaCBEcFuBHE0mywDVPs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rSCZc34OcduMu8pzynyx9Y3MIVUGN0OwZ_TmbqkNowA&oe=6A3946C2"}, {"file_name": "Screenshot 2025-10-27 204317 (1).png", "id": "1541157153564320", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821782_1541157160230986_6370470084530155977_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3XHus0gIscQ7kNvwFo6ZAz&_nc_oc=AdqjnOw4fngI75WJpVgtesPRGQLnp72lLA2wh5DkcrNrZR72YiWrWzjeg-pYOFQVNm4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D5yAQUtQ-B1dM64hh3N23sBMomDC6v_18DPSuVjL99A&oe=6A392FF2"}, {"file_name": "Screenshot 2025-10-27 204534 (1).png", "id": "1564813354959035", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499300678_1564813361625701_8124988142769682505_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUArubHU5VwQ7kNvwE6OK3f&_nc_oc=AdoI7b-g7hPr7caHjkSMz58n9AZJ_DiyoV19ZyYvIrGK3FSKdBcameQCA5X_gJVRhkk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8tSfrDmn8VYlbWmpwLA-fo1cphmGdX4FeLdejPSdMOg&oe=6A393D50"}, {"file_name": "Gorilla Locomotion_2025-10-27_20.png", "id": "1165682872318286", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821568_1165682875651619_6205320667049523505_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Beergo-txY8Q7kNvwG9uhrj&_nc_oc=AdpwOxVDBpH64Do7nD6dLYuaEtoxDzpb1gxUCxPGJrKg97Ohy_UUwhMOwaT0exse4uQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z_8b5VkN0dhzYOEjCgpLxIWeVfrdvzj6O10Au1w6alw&oe=6A393667"}, {"file_name": "Screenshot 2025-10-29 162848 (1).png", "id": "1270872168413343", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823351_1270872175080009_9116934693699291443_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0Roj_m7bBkQ7kNvwGyH7Zf&_nc_oc=AdpmVRvchhhdJtPPevQSGhLuWedFiq1Q0Bva2_kC5qwsAiDbe8u8UC5ZzMibC-RSE2g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1_II5u6X2AUeLJkt74xHvhu4UAVPf4FGn7DQqcKdGSA&oe=6A395ED1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cursed Canopy", "keywords": ["horror", "fun", "hangout", "sociable"], "long_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f \u2013 Long Description\n\nVenture deep into the Cursed Canopy, a mysterious jungle shrouded in darkness and legend. \ud83c\udf3f\u2728 In this Gorilla Tag fangame, you\u2019ll use your hands and instincts to climb, swing, and leap through a haunted forest where every sound and shadow feels alive. \ud83d\udc40\ud83c\udf12\n\nExplore towering trees wrapped in twisted vines, ancient ruins lost to time, and glowing spirits that drift between the branches. \ud83d\udc80\ud83d\udc7b Each area holds hidden secrets and unexpected dangers \u2014 only the brave will uncover what lies beyond the fog. \ud83c\udf2b\ufe0f\ud83d\udd25\n\nChallenge your speed, reflexes, and courage as you navigate an environment that changes when you least expect it. \ud83d\udd78\ufe0f Whether you\u2019re racing through the treetops or exploring the cursed depths, every movement brings you closer to uncovering the truth behind the canopy\u2019s curse. \ud83c\udf32\ud83d\udcab\n\nDo you have what it takes to survive the forest\u2019s grip\u2026 or will you become one of its lost echoes? \ud83c\udf00\ud83c\udf19", "short_description": "\ud83c\udf32\ud83c\udf00 Cursed Canopy VR \ud83d\udd77\ufe0f\nEnter the haunted jungle in this Gorilla Tag-inspired VR experience! \ud83d\udc12\ud83d\udc80\nClimb, swing, and explore a dark, cursed forest filled with eerie sounds and hidden secrets. \ud83c\udf3f\ud83d\udc7b\nTest your reflexes, uncover the mystery of the canopy, and see if you can survive the curse. \ud83c\udf12\ud83c\udf2b\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/17h-8rdchqhtvtqtphtaml8xpnk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ThatWhiteDevvv", "support_website_url": null, "website_url": "https://sites.google.com/view/17h-8rdchqhtvtqtphtaml8xpnk/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26052661194333847"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1591735108655485"}]}, "baseline_offer": {"id": "1591735108655485"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763580120, "status": "PUBLISHED", "id": "1591735108655485"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26510917871841508", "version": "0.1.5"}, "id": "1578765126340025", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25992704690329498", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26510917871841508"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1578765126340025"}]}, "change_log": null, "created_date": 1766424036, "id": "26510917871841508", "version": "0.1.5", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "ob
220"}, {"file_name": "3.png", "id": "926571933702811", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820923_926571937036144_8537818762220471983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1h6i66EOpEQ7kNvwFXdebK&_nc_oc=AdqgxJq55Zdd0cpTw52D-6_IATPCoREkEVsyCl-Sz8mL1p0db7JVrZ2J5x71ugI-axA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mcv88fqGMs3sh94ZxZaWRUg4xzTl1TrDGFz_Da_ixVA&oe=6A204D2D"}, {"file_name": "4.png", "id": "4249651035312111", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_4249651038645444_1032732143067941831_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBylbrfjQJgQ7kNvwH5YQV-&_nc_oc=Ado-0vnwhEIPpU7xmz2gKN0DN4IaRN6fKXyM44nEyJHii5AOx10R-Fsfj_0EHA7CmyY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51Vm4YSXuN2pQr_od5g-J97XJGEQJ5KOVVDZUsKlQlMw&oe=6A20304B"}, {"file_name": "Screenshot 2026-02-27 230442.png", "id": "1644573759883851", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_1644573763217184_1088988818825972695_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2mJ0bnyto4Q7kNvwFgfYpe&_nc_oc=AdojG9AxVYjM84ieWBx1AwDkALt9tAKj3tmOgDmvHgHIxwRMv5c36lS8mu0l4qX9coo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5in11MASONnAg3BwmoY1KyAm5KlB-ix9FLwQcr9G3sdQ&oe=6A202F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ComfyUI_00241_.png", "id": "1652252112615804", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_1652252115949137_1187018090799640971_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y8nJYGXKFEQ7kNvwHNkUhD&_nc_oc=Ado35ngsvtmmT1lnllWjus7bUpg-mcsyT6xlvFUBBxQqGRlYJ05leC-BlhopbnosciM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kAyuAYoMN3BXD1Xyv3dhiNB0ELSvgKKn4MUefKWw7iA&oe=6A201728"}, "display_name": "Yoga Pass", "keywords": ["Yoga", "GuidedYoga", "ImmersiveYoga", "Wellness", "Exercise"], "long_description": "Discover Yoga Pass \u2013 the ultimate customizable VR Yoga app for Meta Quest!\nImmerse yourself in fully personalized virtual reality yoga where you choose everything. Pick from multiple serene virtual environments, a wide variety of yoga exercises and routines for every level, and soothing background audios to create your perfect VR yoga session every time.\nWhether you want beginner-friendly flows, strength-building sequences, flexibility-focused stretches, restorative poses, or mindful meditation sessions, Yoga Pass puts total control in your hands. Pair your selected yoga exercises with calming audio tracks \u2013 ocean waves, gentle rain, forest ambience, soft ambient music, or nature sounds \u2013 for deeper relaxation and focus.\nThis Meta Quest VR yoga app transforms any space into a private immersive yoga studio. Experience authentic VR yoga in breathtaking settings that enhance presence and motivation. Perfect for daily stress relief, improved flexibility, better balance, enhanced mindfulness, and overall wellness through engaging, user-driven sessions.\nKey features of Yoga Pass:\n\u2022 Huge selection of yoga exercises, poses, routines, and flows (beginner to advanced)\n\u2022 Multiple virtual environments for truly immersive yoga practice\n\u2022 Rich library of soothing background audios you fully customize\n\u2022 Easy, intuitive controls optimized for Meta Quest headsets\n\u2022 Personalized VR yoga sessions tailored exactly to your mood and goals\n#VRYoga #MetaQuestYoga #ImmersiveYoga", "short_description": "Immerse in ultimate VR Yoga with Yoga Pass on Meta Quest! Customize sessions in multiple virtual environments, variety of yoga exercises & routines for all levels, and soothing background audios. Ideal VR yoga workouts for stress relief, flexibility, mindfulness, wellness. Personalized immersive yoga in virtual reality for beginners & pros. Yoga Pass: your Meta Quest VR yoga pass to serenity & strength!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lnk.bio/YogaPass", "dev
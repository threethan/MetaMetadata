Z-DlGyukK1OMw5HPAr5qvXi8TwGig28s2L4sJK5SPL8ea35hfUkxt-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg4U6Qxy2W9Dt7MVCc6TpFg7Xf_WP05-OhEHl8Aj93og&oe=6AFF2270"}, {"file_name": "app_lab_ss_03.png", "id": "904614171500785", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974827_904614174834118_4263280454662726585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkpiGHWW1zwQ7kNvwGR5-tQ&_nc_oc=AdoZqLSOUGkw8tS3cYMXORhNw1asxcV_oDNDctJVXTDhNPdQzQVl_rqJDVhlU95IChY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6I1dl0qPLWpz_GuF2-4UlPJ4PVsl5Nt5MrIiYV5LRdw&oe=6AFF22FF"}, {"file_name": "app_lab_ss_04.png", "id": "417319648035180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75500286_417319654701846_596995164343041410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLeKDGRnlW0Q7kNvwHMTKvH&_nc_oc=Ado7Ej9N0FqP6O1bMnU_Tqv242hwtZJPyujEwsmuT3u-XIKr3hsopY45m-eFgfKr_-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLXuTrkq1AwbRE5BD6k_OXP26kT2w3WTzQOlGFGB4NKA&oe=6AFF1944"}, {"file_name": "app_lab_ss_05.png", "id": "459319860311989", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974679_459319863645322_39085037076051007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv2Lr-dgfLsQ7kNvwGbGcJu&_nc_oc=Ado0N03c_eln7lfVg6RQKCT8pcQYDpoSP5PDCNnSDk6xfCVVaphlUzKT8TwpXS9rNj8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRARbLA4nE6GUAGjPn1R8fFwCBKuK8N9sNKouL43Pv4Pw&oe=6AFF3730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1303628217678705", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86683377_1303628221012038_1221446130680594701_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDsAj507oJkQ7kNvwFI0hdh&_nc_oc=AdqKtSdkqcmBfbpntjlqSVqMmbc-AlKw067Pt6bGT3yyIxsuBirVsd-jQ0hx-hnHYEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPQ38j5GHiT_tpv2aqn0ASHDvzbsn4UkP_qQgVJegF1A&oe=6AFF18B9"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
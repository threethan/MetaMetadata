yGVFC6ugwvxTY8LMtSRSK_Wb5790rmZvvMDgJUVVIoML9QFLGuiH3tY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0MIUiKIdyI1EGUmaER0rmu-Gx-uFzFtKyEwBGZIxxdA&oe=6B0DA2F0"}, {"file_name": "app_lab_ss_03.png", "id": "904614171500785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_904614174834118_4263280454662726585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ22woMFH38Q7kNvwEouaY0&_nc_oc=AdrE9Y98-dBxmgAg058W3XLRq3w2fLuzxtjGfZsmO5_YAHWh0RHo-Aqp8rF4N_XqM1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJcb0deweNBpYbba0APNBy5qar5hL9MrxmyXWX52ib6Q&oe=6B0DA37F"}, {"file_name": "app_lab_ss_04.png", "id": "417319648035180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75500286_417319654701846_596995164343041410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mexvxKYs7MEQ7kNvwF-XpRb&_nc_oc=Adq3wDObkxJnlJTNQmHb_TekqGDXqGMRlQIel2LHSI-z6l8IxmdR03aILaje8Jc86fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROfVn6KQwvXUOGdyM_d6PKn1pdo7ZOyH6HrZw2vyOlmg&oe=6B0D99C4"}, {"file_name": "app_lab_ss_05.png", "id": "459319860311989", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974679_459319863645322_39085037076051007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MdoCCsrF48Q7kNvwEPyEwH&_nc_oc=Adq6qVYzAahdBwucySSBQ-Cd-J2P3AAhYObHyB9OU9816uWGUduZDLqKkZKFeD56mO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTr4Q9s70Gc0dQkRslmMKW5zoeY46quZI08Y_og7oQnOw&oe=6B0DB7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1303628217678705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86683377_1303628221012038_1221446130680594701_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emERevYO-YIQ7kNvwGhbj1I&_nc_oc=Adpx9qb8x_5xWz75PMnGIqoUy3NQOfZf-B_F_GF0_d675LxV1FK26NsH0bx1uy9TrDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSd-6QkDk5QzvCnVeQOEPMrACxTI5VLIanDdRAzl5J24Q&oe=6B0D9939"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
rD6Oh7YyJkXOnu90TnFd8LjXDtYBn6zz2ZazKBpXZm-hAR1qVP9REQs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRIdwmlb352PISMa4xNKM133-sV6tmS_yeTfKS4B3ZZQ&oe=6AFB2DF0"}, {"file_name": "app_lab_ss_03.png", "id": "904614171500785", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974827_904614174834118_4263280454662726585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9abDfU9FdSEQ7kNvwH7tHMw&_nc_oc=AdrBBxK3_6lAKC3-B8EnMueEp-jWJlVsBmf5Zj7OjYSZWteyUrk3LSqwHRXzdpJEEf8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvStk1u0m3xXJYBuBsN7MREWwND_u1Kh7sNBn6--vjIg&oe=6AFB2E7F"}, {"file_name": "app_lab_ss_04.png", "id": "417319648035180", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75500286_417319654701846_596995164343041410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSUiYXY9nDYQ7kNvwEcdTP3&_nc_oc=AdpKr4W0Ge8gsbbgh4ktXSfkRVGlyWhE3SykyksEOaKU5c_t738ATV_efxJ9emdEVHA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXIzLdSJAeY2fwMoM4sAMi7Eb800_WcKQu0Y4LIQONQg&oe=6AFB24C4"}, {"file_name": "app_lab_ss_05.png", "id": "459319860311989", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974679_459319863645322_39085037076051007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2vlzZeFIR4Q7kNvwFj7LOX&_nc_oc=Adop6TlgVpEVCzsv3n-Xo3Z95sthMQsen5h1VX9wqA4H9EAt9fUfEx5l5CeMwz40yJo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQezGpcQs1EsStuLZ_I4fcCZOr7G2IOOGJP5LZDk17Oyw&oe=6AFB42B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1303628217678705", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86683377_1303628221012038_1221446130680594701_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1gyiOV67PcQ7kNvwHiil9p&_nc_oc=Adpj8TIqWXVgqf2PfIT0uk2CuV-d68wUU-h9sqaX3IdZKBqgB_3HcSnBm7Kz86sw73k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqNkzYMvTEdEV4eUd9BHrh5Oxk_NNy_NYLO3gDkECEGw&oe=6AFB2439"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
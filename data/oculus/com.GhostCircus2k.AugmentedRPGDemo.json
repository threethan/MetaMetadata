hmIIpVR8zfhLAjvSm1gXkDAc6mPeitlkjnJv-K-hvD8dgIrYQqZ9Yw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM0FWLP0088hXr20mbzOrIz0bHM4d1U54khO3qzLpxbw&oe=6AFDD0F0"}, {"file_name": "app_lab_ss_03.png", "id": "904614171500785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_904614174834118_4263280454662726585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkpiGHWW1zwQ7kNvwGED0z0&_nc_oc=AdrDqswGpXpTNbOBq5ytYYTkT-lV0NcWin2solD2C9QJf8PKf60KTqhM0wF4Ehpxwzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7aZG_uzx4hWJY0rheHqhIfzCl_HwpZ7OOJ-iFqE_WPQ&oe=6AFDD17F"}, {"file_name": "app_lab_ss_04.png", "id": "417319648035180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75500286_417319654701846_596995164343041410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSUiYXY9nDYQ7kNvwEHeVid&_nc_oc=AdpLWfo8ViZQqk6LWQlN54HAEZcT70fcQJZ7VaoKo0XaULZbMakE7oRW1rEvnr1fvgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgYC2Owr1FxdrLR2u5-G-iiKx9lR8vyVfZgdfC5a1Row&oe=6AFDC7C4"}, {"file_name": "app_lab_ss_05.png", "id": "459319860311989", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974679_459319863645322_39085037076051007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv2Lr-dgfLsQ7kNvwEOjjbn&_nc_oc=Adp-Sb3CSz5XzMp5PYliBf0I_wxdJaf6bFBezv7JtHUmPd-3X8z8X1UmfH1TOHe-Zys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTEmXRPmRMaSpiAlTDvqi1FWQXZh-xCq2rpmJnrt9F6w&oe=6AFDAD70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1303628217678705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86683377_1303628221012038_1221446130680594701_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDsAj507oJkQ7kNvwG6T0ji&_nc_oc=AdqFKHVFIybf9bUQy7VMVfROSUiSyt44qux_e4cc1qHxBm62zhWJjedDnHzl11f4u3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzehPAcaTiZx3ss9ZxGC4PdHpJoyiVjqcT9FbtaoVyqw&oe=6AFDC739"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
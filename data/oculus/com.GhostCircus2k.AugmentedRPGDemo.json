gN0WrgPtZ8csiUluDXQlirzGl5Ar92zwh_0bGVIqcTP4w0y-It_oqXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSahO9qKpoMKmqaCoKhvNqdIZnhet2JOjX06BRsUYyVoQ&oe=6B0073F0"}, {"file_name": "app_lab_ss_03.png", "id": "904614171500785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_904614174834118_4263280454662726585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKwa0BO7GfMQ7kNvwF7ArDj&_nc_oc=AdroN1k_TvjQo3DG0r4JcFH0O38um3uGBlpHSwNsNU9MuioY8cmqandvZndczTld0rI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScF4f4fg6TSGJU7MXR1mbr7yHZvI1Y3pCdXb2BzLsvMA&oe=6B00747F"}, {"file_name": "app_lab_ss_04.png", "id": "417319648035180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75500286_417319654701846_596995164343041410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLeKDGRnlW0Q7kNvwGkZyGj&_nc_oc=AdquIksn6qtgLdSxxUKrw9J5ldnnX0xeZREvdX6eItWa4v4iezw6VcKNlgodtCxwg34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWxN25MZ3JgU9f565At4ziWBkeJHJW60ZgFxcnpE3xNA&oe=6B006AC4"}, {"file_name": "app_lab_ss_05.png", "id": "459319860311989", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974679_459319863645322_39085037076051007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sUIUIh7laQQ7kNvwFWI9O8&_nc_oc=AdomjxM1Lh4_4r2JO18vxP8qBowVxvQIiulgEolpkFNLewiEc7fyd_k02FU4get8ERU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjN_iOi4lEVX2D9uLRQPJFElYA4BMRUDDBfNsh0oiUwA&oe=6B0088B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1303628217678705", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86683377_1303628221012038_1221446130680594701_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YVUNPs9_qAQ7kNvwGPLxhv&_nc_oc=AdpDdmlum4qBiN8edCg-NQtW8Gw8Q853i-LI4Igopy1qNL_Tp2fa3mn4r7vNezOWNY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToCc_gF6wYpGK2WPcK3o7miJJz_aP1ZYV80nSFOXzUxQ&oe=6B006A39"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
IhAjz_01rxH0nXIVYXiQjdRkXhWTF1V36iMlqNjrCSD72CUmOB_BKPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-2GzEWSwAqo9sRNd0x9eo03QMQrNx5sJGT-rk4K3G7g&oe=6B05B9F0"}, {"file_name": "app_lab_ss_03.png", "id": "904614171500785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_904614174834118_4263280454662726585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-ARhMB1C_kQ7kNvwFYSvUJ&_nc_oc=AdoltAkTxLMBEBmsnVxxHF4n5dMRdlPMYxerbDQN520oLEIZyfa3pnxrl44ugzRp07Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBaMBy9RwKW1OfM0M91BPs44curnjYENjvmwPt2KBCkg&oe=6B05BA7F"}, {"file_name": "app_lab_ss_04.png", "id": "417319648035180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75500286_417319654701846_596995164343041410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl0IDsqh5hMQ7kNvwFrUsNp&_nc_oc=Adpu8uRYalU17uSjETjMvPHiojCsg-d0iTsXpSW_csq0a_3drwE7ybcGh_nHf1iAP8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzWhemLACXE68P7d4jHI5amzYHu4MgfVEV-Jude63C8g&oe=6B05B0C4"}, {"file_name": "app_lab_ss_05.png", "id": "459319860311989", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974679_459319863645322_39085037076051007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z53KsYJW3AoQ7kNvwGFH3YP&_nc_oc=AdrEPqVgfCy5ntLZHQe9xNqYgAHjkYmjSnuZ5toW2s_MVeGJG9HsH13Qlgw_ZeZvKuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWS48qj3vVlsah8pH5lbuJQQwOn-jOnWRxQzaRgbdfpw&oe=6B05CEB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1303628217678705", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86683377_1303628221012038_1221446130680594701_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jitn1l4gT1UQ7kNvwGFbU17&_nc_oc=Adq9JjiN8p6zXQPN4t25CvhC5kpFzpO9XaXmfDhvvZc9Uj9KN8NLbyJg17SQAfVXi1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIw4ttjW6KxBAVliy7cyn0PfyoJlfzKh8ajmeUAgphTQ&oe=6B05B039"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyUBFBc2qe2jAQessqRXG4AGQNeqCFUY79PwoDdFfiQQ&oe=6AFC75B9"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
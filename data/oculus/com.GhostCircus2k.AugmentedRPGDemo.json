JFnclzN6_ih7D1fdCyMe31AxRnWuvbUgolIbJb6z7tFBS7MViL1S_Ic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBLon4JdpJ9SeMOEQGr4qljkxcTsXlsvg8w_5BCtDM_Q&oe=6B09AE70"}, {"file_name": "app_lab_ss_03.png", "id": "904614171500785", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_904614174834118_4263280454662726585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KT8OAYrcIUQ7kNvwGxm6Qs&_nc_oc=AdpFzT4p3MD30QFFU81xw9DsvkZpVS1oPkYQSCE6PBmK7PN343P9qNo1uuQezVL46Kk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWWdreKClRcCawhwgXr90YAXsx0pkUEYTETT4iVnHohw&oe=6B09AEFF"}, {"file_name": "app_lab_ss_04.png", "id": "417319648035180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75500286_417319654701846_596995164343041410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue4oJc3JaRoQ7kNvwG7blRK&_nc_oc=AdrwcXpyVQpRO3s4WZWY1jvTMa_5pmeLE5dmbMXTXnqZg4uHldoHZ_AdA9Wbbpq6jOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbvNGzDMZlpbUYLropNpfFSsfvqedl7DJDl4ILieBScA&oe=6B09A544"}, {"file_name": "app_lab_ss_05.png", "id": "459319860311989", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974679_459319863645322_39085037076051007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpP29iVyoBMQ7kNvwHGXFol&_nc_oc=AdqlAi0sIw7KuirHVGztNv2ks17Ul6tlGQ9DEZwZUjtnCiFirXuiniRc0kMHSCE8bto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1tqApbKn3jYIaq_4ud34MwwD7Rt8Kz3Uf1wqRyvm3XQ&oe=6B09C330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1303628217678705", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86683377_1303628221012038_1221446130680594701_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuaJK6aNiNYQ7kNvwGAogrL&_nc_oc=Adoog_ccz1k2a9v6nnTDflhdbrbb4s8o5-8qrYVX75QxOHTnlPVRHoU1ea86tKto4fA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJS55Qeb9eMm7PEbJ58aHl2dpo2MBKMQViy_L1yYZTTQ&oe=6B09A4B9"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
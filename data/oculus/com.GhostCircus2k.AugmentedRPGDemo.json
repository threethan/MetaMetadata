epMcLwLpvebW9VWo2AxVIXjHIIo1Y6VPA9cL47EOY3h963n0nsfmrIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQu2Rw0JUhTJSO1OGwlpmb1mmhO6_LpZ6cJmKgaCGnEg&oe=6B1045F0"}, {"file_name": "app_lab_ss_03.png", "id": "904614171500785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_904614174834118_4263280454662726585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDxhBwO9v18Q7kNvwHxcDnF&_nc_oc=Adow8OkPnO3Lr2T2iZlRkw6TVrXK0pHu6pGOCh_2jvh34LF7FGuA_D4vQzZWQuOoQ34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4jHkPvxLO8wNUEaRUOlev1aviAM_sTtOFwINMt8m9mg&oe=6B10467F"}, {"file_name": "app_lab_ss_04.png", "id": "417319648035180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75500286_417319654701846_596995164343041410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKQlUxNWLGcQ7kNvwGI8frJ&_nc_oc=Adoz562IkeIopEKmmxjBl4PB_LrSeyRaMHQjYoBbXZ5bB90xOeioxkhpNIKC8gz9Spc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYpZS7-EnvVAK82cdxaEkO1IrHsjIgvTkvNfs8rM7osg&oe=6B103CC4"}, {"file_name": "app_lab_ss_05.png", "id": "459319860311989", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974679_459319863645322_39085037076051007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwS0RKdiojMQ7kNvwGk4q-G&_nc_oc=Adok0_rOvdnxB-ciXc7W53n85PaRVge_VmQeAdwfGFGhjDKjPoCBgNZSWzXWlfUsNNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCzImPAgvM5AjGwDPEh2oJznwQm8PpDtbtQVliImY3eA&oe=6B105AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1303628217678705", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86683377_1303628221012038_1221446130680594701_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJhoV8soHKwQ7kNvwEuOor9&_nc_oc=AdqQ4LZxzeUxe93tLucSVMx0_N_hBIxb00N8nwGlrcWghuzaNLbdpH2055jqHMFuJwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDI8jthuFwWSiLxXCLmQRK-KYkcT-VDIGGf_TRRbPiCQ&oe=6B103C39"}, "display_name": "Augmented RPG \u2015 FREE Demo", "keywords": ["rpg", "ar", "adventure", "story", "casual"], "long_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by '90s console RPGs, this story-driven game delivers a nostalgic experience with an AR twist. Your family just moved to a new town, and things are not quite as they seem.\n\n- AUGMENTED REALITY \u2015 Grab, rotate, and move the game world around the room. Explore from every angle!  \n- TURN-BASED BATTLES \u2015 Engage in tactical turn-based battles with up to 4 party members.  \n- MODERN WEAPONS \u2015 Use baseball bats, hockey sticks, boxing gloves, and more to defend yourself.  \n- RARE ITEM DROPS \u2015 Enemies have a chance to drop rare weapons and armor.\n\nThe FREE demo lets you explore the story's beginning, battle, interact with characters, level up, and manage your inventory. Complete the tutorial to learn the controls.\n", "short_description": "A quirky AR adventure awaits in Augmented RPG! Inspired by the charming console role-playing games of the '90s, this story-driven RPG aims to deliver a nostalgic experience with an AR twist. Your family just moved across the country to a new town and, shortly after, you begin to find that things are not quite as they seem."}]}, "developer_name": "GhostCircus2k", "developer_privacy_policy_url": "https://www.augmentedrpg.com/privacy-policy-augmented-rpg-demo.html", "developer_terms_of_service_url": null, "publisher_name": "GhostCircus2k", "support_website_url": null, "website_url": "https://www.augmentedrpg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
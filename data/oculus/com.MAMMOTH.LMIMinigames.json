o_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/H0Nt3r", "id": "3686544358086980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540499_3686544361420313_2819309656575311872_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3LgeSMn9B4Q7kNvwF_9bxF&_nc_oc=Adk_OOE7HVZvNBicS9FD09DQ3oNp_edV1nY7ciYdrKjS8CGVboG70CAc2nB0U_sG2Vw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbZc_t3JNk4Zam4ocg2MylAmNM77jQweiOK8Ap2_xTrg&oe=69AD65CF"}, "display_name": "Experience the Energy: Take the Challenge", "keywords": ["Oil", "Gas", "Energy", "Employment", "Jobs"], "long_description": "Experience the energy in a whole new way. Do you like working with big ideas, specialized machines or doing work that is physical? Take the challenge to see how your skills align with 10 exciting careers in oil and gas. Try your hand at drilling, adjust valves to maintain pressure, and send one-of-a-kind robot assistant, Appo into the field to look for hazards. Test yourself to find out which occupations are the best fit for you in the Canadian energy industry.", "short_description": "Play a series of fun minigames to see how your skills align with 10 exciting careers in oil and gas."}, {"images": {"nodes": [{"file_name": "zrCSk4.png", "id": "4063630166988432", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75302218_4063630170321765_6375374794765893632_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_ZLdPI4aWMQ7kNvwEXYqbI&_nc_oc=AdnNhrxvgfHvZzEK1IOck-ZGB6QuJRrFjuwEvDqnBntTtk2mYzwZe3HbjZh5KcCNric&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXNWd1_mlEFepIwcTH-O17diNKGWs-GtP5JkyrcMoVyg&oe=69AD72EF"}, {"file_name": "e8VF1M.png", "id": "3135744106458490", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422372_3135744109791823_7820085300742324224_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRYqjJgzBucQ7kNvwFUT8SU&_nc_oc=Adnv5YaICnFMmDX4
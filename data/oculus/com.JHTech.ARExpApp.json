64.5771-25/473393320_1367064081116668_7990826423846765177_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkP6QKRNy2cQ7kNvwGOQanB&_nc_oc=AdqU_faNVpB-XIOZPV_AvvkjMNRBvDeJEfPmPRmzjxNiTSL53ACDA77XULehk7MpV-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21864715EzLqiT0aNY10QyFS_8xrGIf1VTycSiECdlIw&oe=69E382F3"}, {"file_name": "3\u670824\u65e5(6)-\u5c01\u9762.png", "id": "683568507360124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_683568510693457_4299647420523838861_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O39iQEvZfjUQ7kNvwHgRjh7&_nc_oc=AdqEpKAHlFfQcdARf6kJwIdY666uko2bTvSbsESrA7MPk_fJZXiRwB2Kly3ljeOMo3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Nxclmi7DBiSCZMllSvIKNcm0zEBbkKJg0ZFHfAXKqqA&oe=69E375B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u56fe\u6848_\u6a2a\u5411.png", "id": "547589111308182", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393560_547589114641515_5621051061401434090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fG77B8rm7sQ7kNvwFNqU6c&_nc_oc=Ado-hEgSE76a0Gpkk2M98XgWlOlIqIUy8uYMWptIDx18zYtBqVzWiahY54AZuh6rnE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QcYgkt8q89zw-2gZ5ueDTknx2zaHckA7TglrwX_tkOA&oe=69E37213"}, "display_name": "ARCarCraft", "keywords": [], "long_description": "The ARCarCraft is a car model experience demo, it is a mixed reality app for Meta Quest3 that is awesome, because you can interact with virtual cars in real environments and freely adjust the proportion of the car, up to a maximum of 1:1.\nThis demo includes the following features:\n- Layout: Arrange the location of the virtual model in reality, you can place virtual cars at will.\n- Interaction: Just like a real car, you can open the car door, start the engine, use the steering wheel and more functions waiting for your discovery.\nSubsequent versions will include more features, such as car assembly and more car models, so stay tuned! ", "short_description": "This Application ARCarCraft is a car model experience demo that allows users to experience the various functions of a car in a mixed reality environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.wy-sci.com/ARassemble/Web/ARCarCraft%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "wy-sci", "support_website_url": null, "website_url": "http://wy-sci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9353977241386192"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3277240169097016"}, {"status": "PUBLISHED", "id": "2348187575581393"}]}, "baseline_offer": {"id": "3277240169097016"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756689480, "status": "PUBLISHED", "id": "3277240169097016"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24996920753331922", "version": "0.2.0"}, "id": "651665530955695", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9353977231386193", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24996920753331922"},
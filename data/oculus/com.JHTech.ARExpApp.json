_sid=6e7a0a&_nc_ohc=X7MB3A1eHKIQ7kNvwG9Zu2S&_nc_oc=AdpO-5-EudtXRefrtcxVORmDtFRIwtx9sD8qJRIpVWSjQYJ7sY214uUf3kwSztJeK_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kfGbG1vKUWKAnvurzICayq1lSPD-922cB46GVazQ9iA&oe=69EB7567"}]}, "id": "1181786767095486", "locale": "en_US", "screenshots": [{"file_name": "\u8f6f\u4ef6\u622a\u56fe1(2k).png", "id": "743357491666698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302527_743357495000031_2016937374264589905_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=YtYGHRpsTdoQ7kNvwHNL0q5&_nc_oc=AdquRmW4H78cr-dgWpy1FmnCkW8u5eL_P8K387B44YACtFMQoo7ohgJtnz2vqD6idJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QaYlzZdw7c0THO25mLvrRHe6UEDvGoJM27GFnSNWVZg&oe=69EB6C08"}, {"file_name": "\u8f6f\u4ef6\u622a\u56fe2\uff082k\uff09.png", "id": "1312534657174218", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499313107_1312534660507551_2329613936076107133_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qxz1acWhKQQ7kNvwFEpqBn&_nc_oc=AdoaXpoGDAFUcrNWWzJzGIgHxsH7m6UlNx3-c5FYQUt7BH_jUFwdFRWeIftRVdXXtXo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X5RL8r4SqEaZ50rQ-1_Nk7XUqoCHc2XvW_EkL5__jhA&oe=69EB63B6"}, {"file_name": "\u8f6f\u4ef6\u622a\u56fe6\uff082k\uff09.png", "id": "9882727051827123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299789_9882727055160456_2816902975567420974_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCl35WHyDEYQ7kNvwHjDk7T&_nc_oc=Adom4qq3obw9dJidDByZUHuDcOpT9AqjFrougMf8S2Zfnm5bGHX4WOBhO4IE2SMRaoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PtojdLX8wE_Hu8jCbXYj0Z5nVofpw5nmQnq3GvH0HJg&oe=69EB8AEA"}, {"file_name": "\u8f6f\u4ef6\u622a\u56fe4\uff082k\uff09.png", "id": "790658413492800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300725_790658416826133_1643567078895891149_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kwSgW8cS-8Q7kNvwEhNm9P&_nc_oc=AdrPg1SHsH4vcHUHCgteY6H3lua5L4ZXjgJmWJSEfo6AY9EXEtPMreDt2oI4fqG0RWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dzFPaUildVsJyot8MZ0rHun2heJOf3WL7zNaYwao33w&oe=69EB5DEE"}, {"file_name": "\u8f6f\u4ef6\u622a\u56fe5\uff082k\uff09.png", "id": "2177692509418767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499293732_2177692512752100_2851060940298468412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5unUah0yrNQQ7kNvwEZxL9D&_nc_oc=AdruRHNzyvvOqwc-L1h4c2Y7SfjmxPk-x2thbdSK5DOjZ0zqz3SS_RGPIGsppt7d7Qo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BHwcct9k37lFSW0PGbvAojaMuEo9Tpv0WkwYdj1zWJg&oe=69EB7B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u56fe\u6848_\u6a2a\u5411.png", "id": "547589111308182", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393560_547589114641515_5621051061401434090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOt9MiOYUnEQ7kNvwH9qC8W&_nc_oc=AdrpXB3i2-TiFOeBhammkkuK1FeLkl__C1O4OHtnVAw-AIQPF-YFleYyPggx73-3YSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U31rsRee7ahOom4xhLkja5CPgMO8EOaoWcLCZC-OBiQ&oe=69EB5B13"}, "display_name": "ARCarCraft", "keywords": [], "long_description": "\ud83d\ude97 Assemble a car with your own hands in your garage or anywhere, and get inside to experience it!\n\nARCarCraft Car Assembly & Experience is an automotive design experience platform specifically created for the Meta Quest platform. Through immersive 3D environments and advanced MR technology, it allows users to conduct 1:1 realistic car assembly and operation training in mixed reality spaces.\n\n\ud83c\udf1f Core Highlights\n\ud83d\udd27 Interactive, Immersive Assembly Mode\n\u2022 High-precision 3D car models (GLC, SU7, Tank500, etc.)\n\u2022 Authentic parts assembly experience - every component matters\n\u2022 Visual process diagrams that make complex assembly simple\n\u2022 Intelligent assembly detection ensuring operational accuracy\n\n\ud83c\udfae Interactive Experience Mode\n\u2022 Real steering wheel control experience\n\u2022 Interactive functional components like doors, lights, windshield wipers\n\u2022 Engine startup simulation - feel the heartbeat of the automobile\n\n\ud83c\udfaf Smart Guidance, Progressive Experience\n\u2022 Three difficulty levels: from beginner to expert\n\u2022 Guided mode for quick onboarding even for newcomers\n\u2022 Real-time progress tracking with learning outcomes at a glance\n\u2022 Multi-language support for barrier-free learning worldwide\n\n\ud83c\udfa8 Audio-Visual Feast\n\u2022 Cinema-grade visual effects and dynamic lighting\n\u2022 3D spatial audio for immersive sound experience\n\u2022 Rich visual effect feedback\n\nDownload now and begin your new era of automotive learning!\nMake complex automotive technology simple and fun, master real skills in the virtual world.", "short_description": "ARCarCraft Car Assembly & Experience is an automotive design experience platform specifically created for the Meta Quest platform. Through immersive 3D environments and advanced MR technology, it allows users to conduct 1:1 realistic car assembly and operation experience in mixed reality spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.wy-sci.com/ARassemble/Web/ARCarCraft%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "wy-sci", "support_website_url": null, "website_url": "http://www.wy-sci.com/ARCarCraft/index.html#/MainIndex", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages
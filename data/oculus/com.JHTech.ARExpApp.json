{"data": {"node": {"__typename": "Application", "id": "9353977231386193", "organization": {"id": "526078207263684", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9353977231386193"}]}, "id": "1867652674038708"}]}}, "firstRevision": {"nodes": [{"application": {"id": "9353977231386193", "release_date": 1744849920, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24996920753331922"}, "id": "651665530955695"}]}}, "binary": null, "live_binary": null, "created_date": 1758692559, "id": "24587104974313504", "is_initial_release": false, "name_with_fallback": "v4", "pdp_metadata_with_fallback": {"version": 4, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "24587154887641846"}, "release_status": "RELEASED", "id": "9353977231386193"}, "id": "24587154887641846", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9353977231386193", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "9711992248866777"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1449360766116422", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARCarCraft", "keywords": [], "long_description": "\ud83d\ude97 \u5728\u60a8\u7684\u8f66\u5e93\u6216\u4efb\u610f\u5730\u70b9\uff0c\u4eb2\u624b\u7ec4\u88c5\u4e00\u8f86\u6c7d\u8f66\uff0c\u5e76\u8fdb\u5165\u8f66\u5185\u4f53\u9a8c\uff01\nARCarCraft\u6c7d\u8f66\u7ec4\u88c5\u4e0e\u4f53\u9a8c\u662f\u4e13\u4e3aMeta Quest\u5e73\u53f0\u6253\u9020\u7684\u6c7d\u8f66\u8bbe\u8ba1\u4f53\u9a8c\u5e73\u53f0\uff0c\u901a\u8fc7\u6c89\u6d78\u5f0f3D\u73af\u5883\u548c\u5148\u8fdb\u7684MR\u6280\u672f\uff0c\u8ba9\u7528\u6237\u5728\u6df7\u5408\u7a7a\u95f4\u4e2d\u8fdb\u884c1:1\u771f\u5b9e\u7684\u6c7d\u8f66\u88c5\u914d\u548c\u64cd\u4f5c\u8bad\u7ec3\u3002\n\n\ud83c\udf1f \u6838\u5fc3\u4eae\u70b9\n\ud83d\udd27 \u4ea4\u4e92\u3001\u6c89\u6d78\u5f0f\u88c5\u914d\u6a21\u5f0f\n\u25cf \u9ad8\u7cbe\u5ea6\u6c7d\u8f663D\u6a21\u578b\uff08GLC\u3001SU7\u3001Tank500\u7b49\uff09\n\u25cf \u771f\u5b9e\u96f6\u90e8\u4ef6\u88c5\u914d\u4f53\u9a8c\uff0c\u6bcf\u4e2a\u90e8\u4ef6\u90fd\u81f3\u5173\u91cd\u8981\n\u25cf \u53ef\u89c6\u5316\u6d41\u7a0b\u56fe\uff0c\u8ba9\u590d\u6742\u88c5\u914d\u53d8\u5f97\u7b80\u5355\n\u25cf \u667a\u80fd\u88c5\u914d\u68c0\u6d4b\uff0c\u786e\u4fdd\u64cd\u4f5c\u51c6\u786e\u6027\n\n\ud83c\udfae \u4e92\u52a8\u4f53\u9a8c\u6a21\u5f0f\n\u25cf \u771f\u5b9e\u65b9\u5411\u76d8\u64cd\u63a7\u4f53\u9a8c\n\u25cf \u8f66\u95e8\u3001\u8f66\u706f\u3001\u96e8\u522e\u5668\u7b49\u529f\u80fd\u90e8\u4ef6\u4ea4\u4e92\n\u25cf \u53d1\u52a8\u673a\u542f\u52a8\u6a21\u62df\uff0c\u611f\u53d7\u6c7d\u8f66\u5fc3\u810f\u7684\u5f8b\u52a8\n\u25cf \u5982\u540c\u5728\u6c7d\u8f66\u5c55\u5385\u4e2d\u4f53\u9a8c\u771f\u8f66\u64cd\u4f5c\n\n\ud83c\udfaf \u667a\u80fd\u5f15\u5bfc\u3001\u6e10\u8fdb\u4f53\u9a8c\n\u25cf \u4e09\u7ea7\u96be\u5ea6\u8bbe\u7f6e\uff1a\u4ece\u5165\u95e8\u5230\u4e13\u5bb6\n\u25cf \u5f15\u5bfc\u6a21\u5f0f\uff0c\u65b0\u624b\u4e5f\u80fd\u5feb\u901f\u4e0a\u624b\n\u25cf \u5b9e\u65f6\u8fdb\u5ea6\u8ddf\u8e2a\uff0c\u5b66\u4e60\u6210\u679c\u4e00\u76ee\u4e86\u7136\n\u25cf \u591a\u8bed\u8a00\u652f\u6301\uff0c\u5168\u7403\u7528\u6237\u65e0\u969c\u788d\u5b66\u4e60\n\n\ud83d\ude80 \u524d\u6cbfMR\u6280\u672f\n\u25cf \u7a7a\u95f4\u951a\u70b9\u6280\u672f\uff0c\u7a33\u5b9a\u53ef\u9760\u76843D\u5b9a\u4f4d\n\u25cf \u81ea\u7136\u624b\u52bf\u4ea4\u4e92\uff0c\u544a\u522b\u4f20\u7edf\u9f20\u6807\u952e\u76d8\n\u25cf \u771f\u5b9e\u7269\u7406\u6a21\u62df\uff0c\u611f\u53d7\u771f\u5b9e\u7684\u64cd\u4f5c\u53cd\u9988\n\u25cf \u9ad8\u8d28\u91cf\u6e32\u67d3\uff0c\u89c6\u89c9\u6548\u679c\u5ab2\u7f8e\u73b0\u5b9e\n\n\ud83c\udfa8 \u89c6\u542c\u76db\u5bb4\n\u25cf \u5f71\u9662\u7ea7\u89c6\u89c9\u6548\u679c\u548c\u52a8\u6001\u5149\u7167\n\u25cf 3D\u7a7a\u95f4\u97f3\u9891\uff0c\u8eab\u4e34\u5176\u5883\u7684\u58f0\u97f3\u4f53\u9a8c\n\u25cf \u4e30\u5bcc\u7684\u89c6\u89c9\u7279\u6548\u53cd\u9988\n\u25cf \u4e13\u4e1a\u6c7d\u8f66\u97f3\u6548\u5e93\uff0c\u6bcf\u4e2a\u58f0\u97f3\u90fd\u771f\u5b9e\u53ef\u4fe1\n\n\u7acb\u5373\u4e0b\u8f7d\uff0c\u5f00\u542f\u60a8\u7684\u6c7d\u8f66\u5b66\u4e60\u65b0\u7eaa\u5143\uff01\n\u8ba9\u590d\u6742\u7684\u6c7d\u8f66\u6280\u672f\u53d8\u5f97\u7b80\u5355\u6709\u8da3\uff0c\u5728\u865a\u62df\u4e16\u754c\u4e2d\u638c\u63e1\u771f\u5b9e\u6280\u80fd\u3002", "short_description": "ARCarCraft\u6c7d\u8f66\u7ec4\u88c5\u4e0e\u4f53\u9a8c\u662f\u4e13\u4e3aMeta Quest\u5e73\u53f0\u6253\u9020\u7684\u6c7d\u8f66\u8bbe\u8ba1\u4f53\u9a8c\u5e73\u53f0\uff0c\u901a\u8fc7\u6c89\u6d78\u5f0f3D\u73af\u5883\u548c\u5148\u8fdb\u7684MR\u6280\u672f\uff0c\u8ba9\u7528\u6237\u5728\u6df7\u5408\u7a7a\u95f4\u4e2d\u8fdb\u884c1:1\u771f\u5b9e\u7684\u6c7d\u8f66\u88c5\u914d\u548c\u64cd\u4f5c\u8bad\u7ec3\u3002"}, {"images": {"nodes": [{"file_name": "\u5c01\u9762\u56fe\u6848_\u4eba\u50cf.png", "id": "1829707294616949", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618432_1829707297950282_3066005064232733845_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRUUD5wN99wQ7kNvwGXIg8f&_nc_oc=Adr8ZhOpH05DFzUe_z3gEOWzPwSwpoQnUkOqq2yHCIkmVexHipWMzKzaBBhoR4pYo94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af018J-4D22J9r5b2GsYRRRyqOPIC_JOKv047_MzXVgSxQ&oe=69EB8480"}, {"file_name": "\u5c01\u9762\u56fe\u6848_\u6b63\u65b9\u5f62.png", "id": "1809332700008458", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619447_1809332703341791_68
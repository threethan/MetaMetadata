58416826133_1643567078895891149_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0nEhAS0koIQ7kNvwFZZZVJ&_nc_oc=AdqlKr8lXKS1t1t6-F3U71MtMG7AzOxSP5_ZzC_frPBlmAJajRNCf3gBICGpedyRNmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0rwl18vg08VWUYguLWh8gO1FnYZQqn1lsLhkhob-MgA&oe=6AAD62AE"}, {"file_name": "\u8f6f\u4ef6\u622a\u56fe5\uff082k\uff09.png", "id": "2177692509418767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499293732_2177692512752100_2851060940298468412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4SJODfO-tEQ7kNvwFDhL_V&_nc_oc=AdpXVItm18XqIC36zrPax5UBg3FNrolEk6LWcRKrYQG90PECFFW2KS1oahiNpxy00q8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgBWHerVy82CLwfQzRNn3omkCNSqkORH8JANvYggHj5Q&oe=6AAD47DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u56fe\u6848_\u6a2a\u5411.png", "id": "547589111308182", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393560_547589114641515_5621051061401434090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I09I6M41HokQ7kNvwGuiA5_&_nc_oc=Adqn4_0x3glBxQ6Wf3NlEYBik3sx0WQNXWaZY0-HScxZRh6631VB8b57sr-vuGlAf2k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9PT6-AhzepG5IWEUSxa1cf0bRkXXppAobgIL6LmXTQw&oe=6AAD5FD3"}, "display_name": "ARCarCraft", "keywords": [], "long_description": "\ud83d\ude97 Assemble a car with your own hands in your garage or anywhere, and get inside to experience it!\n\nARCarCraft Car Assembly & Experience is an automotive design experience platform specifically created for the Meta Quest platform. Through immersive 3D environments and advanced MR technology, it allows users to conduct 1:1 realistic car assembly and operation training in mixed reality spaces.\n\n\ud83c\udf1f Core Highlights\n\ud83d\udd27 Interactive, Immersive Assembly Mode\n\u2022 High-precision 3D car models (GLC, SU7, Tank500, etc.)\n\u2022 Authentic parts assembly experience - every component matters\n\u2022 Visual process diagrams that make complex assembly simple\n\u2022 Intelligent assembly detection ensuring operational accuracy\n\n\ud83c\udfae Interactive Experience Mode\n\u2022 Real steering wheel control experience\n\u2022 Interactive functional components like doors, lights, windshield wipers\n\u2022 Engine startup simulation - feel the heartbeat of the automobile\n\n\ud83c\udfaf Smart Guidance, Progressive Experience\n\u2022 Three difficulty levels: from beginner to expert\n\u2022 Guided mode for quick onboarding even for newcomers\n\u2022 Real-time progress tracking with learning outcomes at a glance\n\u2022 Multi-language support for barrier-free learning worldwide\n\n\ud83c\udfa8 Audio-Visual Feast\n\u2022 Cinema-grade visual effects and dynamic lighting\n\u2022 3D spatial audio for immersive sound experience\n\u2022 Rich visual effect feedback\n\nDownload now and begin your new era of automotive learning!\nMake complex automotive technology simple and fun, master real skills in the virtual world.", "short_description": "ARCarCraft Car Assembly & Experience is an automotive design experience platform specifically created for the Meta Quest platform. Through immersive 3D environments and advanced MR technology, it allows users to conduct 1:1 realistic car assembly and operation experience in mixed reality spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.wy-sci.com/ARassemble/Web/ARCarCraft%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "wy-sci", "support_website_url": null, "website_url": "http://www.wy-sci.com/ARCarCraft/index.html#/MainIndex", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
X71rRDOrp8fwE1_ofHcasSYVlNBvjWzPujM9o9BRtFusiC_lOlQ1g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VDUr_ZzPcZ-q7KLBWBasfOi6zlqvCIP1ghFSvL9DPKA&oe=69F4986E"}, {"file_name": "\u8f6f\u4ef6\u622a\u56fe5\uff082k\uff09.png", "id": "2177692509418767", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499293732_2177692512752100_2851060940298468412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMo4Tt9phtYQ7kNvwHkRTXW&_nc_oc=AdoQ1hNgwmEjZu6zRcCwLWY0KzScKTWJSJJCADL4GzMX2naQSn4YD2-jQqPDsRz_tHk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MzYRhwGoSViFatpQGPCe4fyzG4KAHVm-6EqfiwXVJYw&oe=69F4B5DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u56fe\u6848_\u6a2a\u5411.png", "id": "547589111308182", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393560_547589114641515_5621051061401434090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2hWVO88yrEQ7kNvwEbLK8o&_nc_oc=AdriCvcTM5tEiJuSCaPsS3a05cjAbRH3Im5vPR5oNPEZUbHWrt64g2wYDHNdyjxELPI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qv7YvT5tZlaLRphpuWmNedQB0dS3Ao5KXPes3ctzJqQ&oe=69F49593"}, "display_name": "ARCarCraft", "keywords": [], "long_description": "\ud83d\ude97 Assemble a car with your own hands in your garage or anywhere, and get inside to experience it!\n\nARCarCraft Car Assembly & Experience is an automotive design experience platform specifically created for the Meta Quest platform. Through immersive 3D environments and advanced MR technology, it allows users to conduct 1:1 realistic car assembly and operation training in mixed reality spaces.\n\n\ud83c\udf1f Core Highlights\n\ud83d\udd27 Interactive, Immersive Assembly Mode\n\u2022 High-precision 3D car models (GLC, SU7, Tank500, etc.)\n\u2022 Authentic parts assembly experience - every component matters\n\u2022 Visual process diagrams that make complex assembly simple\n\u2022 Intelligent assembly detection ensuring operational accuracy\n\n\ud83c\udfae Interactive Experience Mode\n\u2022 Real steering wheel control experience\n\u2022 Interactive functional components like doors, lights, windshield wipers\n\u2022 Engine startup simulation - feel the heartbeat of the automobile\n\n\ud83c\udfaf Smart Guidance, Progressive Experience\n\u2022 Three difficulty levels: from beginner to expert\n\u2022 Guided mode for quick onboarding even for newcomers\n\u2022 Real-time progress tracking with learning outcomes at a glance\n\u2022 Multi-language support for barrier-free learning worldwide\n\n\ud83c\udfa8 Audio-Visual Feast\n\u2022 Cinema-grade visual effects and dynamic lighting\n\u2022 3D spatial audio for immersive sound experience\n\u2022 Rich visual effect feedback\n\nDownload now and begin your new era of automotive learning!\nMake complex automotive technology simple and fun, master real skills in the virtual world.", "short_description": "ARCarCraft Car Assembly & Experience is an automotive design experience platform specifically created for the Meta Quest platform. Through immersive 3D environments and advanced MR technology, it allows users to conduct 1:1 realistic car assembly and operation experience in mixed reality spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.wy-sci.com/ARassemble/Web/ARCarCraft%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "wy-sci", "support_website_url": null, "website_url": "http://www.wy-sci.com/ARCarCraft/index.html#/MainIndex", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages
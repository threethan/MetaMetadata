=2v-yyAmX2cUQ7kNvwHzXP0U&_nc_oc=Adq16Eg2RNmGnMK6UYHmAn4ps3UhREnZZdvUhnHb-uy4MgHbLIpsF2kd3v3lTgsjijs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pOIHzCKXpLAjkpLzw3hsHUEfn5aJbxrugiErEjUcMUQ&oe=6A22CBC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image (Desktop).png", "id": "529473078197702", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974891_529473081531035_6256113112150572613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz2-BxaGw6QQ7kNvwGDoMAR&_nc_oc=AdpNFuM1RmcUiDi4P-xxd9si0PtXMAaNzu__gTzFn7KE-BTtEzdaQ6T1W6DPTPGWuV4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mWQcYEvKRvgIpEjt3jKTBmcUJaHYHu0buN5p4QAW2iw&oe=6A22CC80"}, "display_name": "The Gift - Beta", "keywords": [], "long_description": "Let go of negative thoughts with empowering self-guided coaching experiences.\nTry the beta coaching experience: \"The Gift\" now.\n\n\u201cThe Gift\u201d is a powerful VR coaching experience based on the world renowned Dynamic Spin Release (TM) coaching process developed by two of the world's leading coaching experts: Tim & Kris Hallbom.\n\nBenefits\n- Release the source of your anxiety, fear and stress from your mind and body\n- Release negative self talk that keeps you from having what you want\n- Find answers to your own personal problems \n- Energize yourself when feeling tired\n \nWhat people say\n\"I have been far more at peace about the path I am on and feel more \u201cwhole\u201d despite the losses I have recently faced\"\n\"I feel like it was a weight that lifted from me by the end of it\"\n\"I truly feel both relaxed and invigorated\"", "short_description": "Let go of negative thoughts with empowering self-guided coaching experiences.\nTry the beta coaching experience: \"The Gift\" now.\n\n\u201cThe Gift\u201d is a powerful VR coaching experience based on the world renowned Dynamic Spin Release (TM) coaching process developed by two of the world's leading coaching experts: Tim & Kris Hallbom.\n\nFor the first time ever you can transform the root cause of your anxiety, fear and stress and find answers to your own personal problems all in VR.\n\n"}]}, "developer_name": "HorizonMind", "developer_privacy_policy_url": "https://horizonmind.io/notices", "developer_terms_of_service_url": "https://www.horizonmind.io/notices", "publisher_name": "HorizonMind", "support_website_url": "https://www.horizonmind.io/", "website_url": "https://www.horizonmind.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1121225285320581"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "1181177913713472"}, {"status": "PUBLISHED", "id": "1835882623846570"}, {"status": "PUBLISHED", "id": "922477345959676"}, {"status": "PUBLISHED", "id": "407716170913499"}, {"status": "PUBLISHED", "id": "272273472588758"}]}, "baseline_offer": {"id": "1835882623846570"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1181177913713472"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9173119202723441", "version": "2.1.9"}, "id": "797271737812021", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", 
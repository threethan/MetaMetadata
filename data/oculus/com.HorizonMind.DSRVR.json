EvI1NkQ7kNvwEcbcr6&_nc_oc=Adq_fmRDbF9M1tNYSEuO_UMydKALjCsPdkyY-nDFpMVRU3aplKaNgVJ2L0zoJ_xQEPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeuLCzGWXOorkvCC-q5z1y6Lf92S42KMzVdWtQ8McFBg&oe=6A9972C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image (Desktop).png", "id": "529473078197702", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_529473081531035_6256113112150572613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm6XcAxnLy8Q7kNvwEvJg7x&_nc_oc=Ados3u4pFaUK4KWVlrKl9a0htjhlmwXAQ9ogM0ZXHv09_999NS-H8AQHlAg4QZ3hxpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIomZNWBTM4g7dChEbY1NRqFO-kl41BZ8RIhYA7bNtw9w&oe=6A997380"}, "display_name": "The Gift - Beta", "keywords": [], "long_description": "Let go of negative thoughts with empowering self-guided coaching experiences.\nTry the beta coaching experience: \"The Gift\" now.\n\n\u201cThe Gift\u201d is a powerful VR coaching experience based on the world renowned Dynamic Spin Release (TM) coaching process developed by two of the world's leading coaching experts: Tim & Kris Hallbom.\n\nBenefits\n- Release the source of your anxiety, fear and stress from your mind and body\n- Release negative self talk that keeps you from having what you want\n- Find answers to your own personal problems \n- Energize yourself when feeling tired\n \nWhat people say\n\"I have been far more at peace about the path I am on and feel more \u201cwhole\u201d despite the losses I have recently faced\"\n\"I feel like it was a weight that lifted from me by the end of it\"\n\"I truly feel both relaxed and invigorated\"", "short_description": "Let go of negative thoughts with empowering self-guided coaching experiences.\nTry the beta coaching experience: \"The Gift\" now.\n\n\u201cThe Gift\u201d is a powerful VR coaching experience based on the world renowned Dynamic Spin Release (TM) coaching process developed by two of the world's leading coaching experts: Tim & Kris Hallbom.\n\nFor the first time ever you can transform the root cause of your anxiety, fear and stress and find answers to your own personal problems all in VR.\n\n"}]}, "developer_name": "HorizonMind", "developer_privacy_policy_url": "https://horizonmind.io/notices", "developer_terms_of_service_url": "https://www.horizonmind.io/notices", "publisher_name": "HorizonMind", "support_website_url": "https://www.horizonmind.io/", "website_url": "https://www.horizonmind.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1121225285320581"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9173119202723441", "version": "2.1.9"}, "id": "797271737812021", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3755672191134863", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9173119202723441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "797271737812021"}]}, "change_log": "Minor bug fixes and
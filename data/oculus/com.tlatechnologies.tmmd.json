908"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SQwW3Z-X30Q7kNvwGErH15&_nc_oc=AdoSU3BEvZ8biw0f29KRlBy_34K8u3A6hj3ZjNi5obBypBArtgZEY2uSDVMV4_Xp37I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx82e6yUle_IDeaZxWU-rj1rW387qrJuVsIlemY2DSC2w&oe=69CA6A2F"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-iLS3aK8h4Q7kNvwGkNmpT&_nc_oc=Adoc86dWLOj2md47B5ZoDlzDowr5LzkeV-FbhgYjY5CNNuUpVy5kgVKxuqhC6e48Kqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhugFeaj5vSayZ4xOuYr6PuMAclgsh3atxE1Z5nwWFfg&oe=69CA569B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR6D5Q6ekEEQ7kNvwGsRDgF&_nc_oc=AdoDg6x3vj153M0ak-a4m0Rf2TJwii7xWTjjKyunEVoFja0nAIUV-Uv8hbcJLBm0wZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_YV2SGwBxCbXgh52NKe6NmLCawNF1T_WQM0UL4gY3GQ&oe=69CA79C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCtZYFEX06sQ7kNvwFjdN4F&_nc_oc=AdoWNEafQJbUOyVMB_VAg-k-dL27BVqtdZbsw7qnzV0wsj2LJ_bsTr8uWcD2JjtEfwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQtov_77YnLRKcoXd3xQP3fS7mJMwxsoVlHpR_SH-4yQ&oe=69CA5DF4"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
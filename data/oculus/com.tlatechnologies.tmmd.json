508"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYSEEywCqG4Q7kNvwHe5qGh&_nc_oc=AdpWQKGtKTcXaKCw9CIxX5x0FNkPPhePas6afL2ZnSftqt-_iE-OHGty3rCWMLRJ1D8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g5pD_PHuVp3vqfNTLYib4eE2xJjsXKjzJZumiL-OoKg&oe=6A29562F"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCE8uWcWN6EQ7kNvwHe8VNk&_nc_oc=AdohNP-XjwEf4Pr_-qWKNtCMmSEe8VD-y-jeO7zvUEvMUFwk4hP8t91pOSRNgmCIhT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y-dQZC79D7x207txlpNSAwxlCEucSzgzQllX5pA8qyA&oe=6A297ADB"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucK2Fso026QQ7kNvwFLudTe&_nc_oc=Ado2bUoFYPtl2-XtcuZEoGA-7tnLuuN0oNLnc4G_oR709ZTrSNSF2KLBawNAyIOHTrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94oIQ51Z_hQqkrLIZB4vcBtrgbP1kTY_SXpPdiQl8PKQ&oe=6A2965C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YPDDvVZyOQQ7kNvwF5xqmg&_nc_oc=Adp-NxC4Ucyi_96nXO_XkxOWHA0FEPRTRI1bVCr4gGGsSBCQWjJvRAEa5xL2GW4wU_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H5GP--aEVbRKD7q53qF--d8XN69cd0jvBzGFf0Cnv6g&oe=6A298234"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
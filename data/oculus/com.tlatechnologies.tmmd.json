788"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rshiTYUUOYoQ7kNvwFjYlP6&_nc_oc=Adp0CU9zm4KdVuA6IcBnwvjsw4mcxOip9TEy3iuHUS5LIQGYSzxcAWc7hUOZWmEXDBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L-WeuP-Sf19OcoILFKNukhs0LkgbeqWawgo3m4mZh7Q&oe=6A47E0EF"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EADfbb73sLAQ7kNvwGNhWKr&_nc_oc=AdpvMKHhhnJF6fB4IhNK_QAa2wq4l-mJexO3duJ-lcYnrJ90BP04scRrBJBfOPwPNbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G2WB1VXUFzDdhLl78TPIhpdbP4HdAysEZOxcgpcmIvQ&oe=6A47CD5B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_Hk9PReUeUQ7kNvwECX3uq&_nc_oc=AdpodyMbn_sLBPoU_E9uegNY52AdxBG-2SCgRkeeQEW2ZM7lK_eelElla1o6YlklYdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XVdI8wVYpa_uIJ0cxcrUVTtrP1e6X-1ySiQZF6nifZQ&oe=6A47B842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc2QXDxZt2EQ7kNvwHkbgAp&_nc_oc=AdpRIDNOe8CvfiEN6lAIIMiYciQTyCADcP72utfSHr3YJxWATHWkAuOk4mcRbAG-y0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5UaOaN7wH7iEx0iNPJPi9t2YSNouE4tslu26q7pBMzA&oe=6A47D4B4"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
208"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3IbfV8z8h0Q7kNvwHKUHSO&_nc_oc=AdrYuy-VITkCPZn6ZQ9BPy_OXxiiudtsz5N-dsIBQ9Rl2Xm7sBJJcwxb5Ykpmrp-DlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYwCulgHkqVj7AtGd5wko3zhqCUneSglpHnEGcvhPqsg&oe=6A50E32F"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SXoito1vZQQ7kNvwEXPNao&_nc_oc=AdpelX_zsMtW9X0EVr1E8PtmpcklZbgYCTYhujUNgsuzok82yoYyLZwZQfkFahs3qB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9QRpzs7c0AaBwJMj0sP4N-Ql3EXTzWV7tg9eM9xQ4EA&oe=6A5107DB"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KiHB85TcNkQ7kNvwE1KRTh&_nc_oc=AdoOBwlDMxJVep2VqAW61mbKlze5V_5dXfMLDghX6fuop-2txyipghQwUdkCAv9pIjs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6hxGEAAVpcgwTiNYDbBU_n8ETAJK--8eDFg9qyBnXyA&oe=6A50F2C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuAAV-p6YGgQ7kNvwEcX9Sp&_nc_oc=AdpePCo6c7ipKgGM2Qlm7mvWIrNR_12VKKn9eTDIFY-e7JInVYKdo1TZfen_mC9jTf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlkPyAPVtcL6ayM3xdq2qx_fwpj3Vc4OYFzxHmbjA4RA&oe=6A510F34"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
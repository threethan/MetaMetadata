38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-t6FYvRyPjoQ7kNvwGFj3X1&_nc_oc=AdnSPKY_nhaN-TM6LnQd8ebDME--H_6fUhvSiNWTcxRDLgsffF3xbCIBlhP14sUcZ74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuY7aysrYb0l1ws50JjebOklac7SPqaEZh_W2XSdGEPzQ&oe=699EE8AF"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txFp289GrbcQ7kNvwEMND8t&_nc_oc=AdmAJxbfnvgA8zOm1vOdk7GdaSGXjIuZwTiOOdNcnZeVK8KlsJGZydA-2m1adIgwXW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuRDu8QwyHx_0XUX5MNdQxksDSz5yzuU4elOAqsvKosOw&oe=699ED51B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncrWJb7Pq-kQ7kNvwEabX6Y&_nc_oc=Adm1V2ftrsSUGN0muDd5YmuOqLEXTGLshtwtRA9UIDYMEjl-T225SSFHhkZDjEeeCXk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsWSNeMyciJvmv4e-bk4ZERpqtusAkmk_AaucsO32D55g&oe=699EF842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbHrXW0qYFMQ7kNvwHO5epw&_nc_oc=AdkLgK0LD4Y86d2wi-LO-2yN0BMrvVl-O6gMRTVU8OTAF83go20Gc5tO5KJhzz2BUaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft4c8zzd4S-lvjGIFFTtqvos5tTQvVYqT2o1PCS3mFSrg&oe=699EDC74"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677261559022912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_1322715901714458_7457104381727058986_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDfliZW2jRsQ7kNvwHvhQuZ&_nc_oc=AdmH2p48ZhKdPxfcoArpc057aWeRuhRVOjB-FMk5BlI_v2tvCs22mewDi0k1gpkW5Us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftFElEOix-BG6B6vsMKR5cdOVUmzOwS1YgewWL88HdVHw&oe=699EDED5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Talking Mimes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1624462512, "lastRevision": {"nodes": [{"id": "4089777794447724", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3968804079868707", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "735553843466983"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "TMMD_Oculus_Cover_3x1.png", "id": "1903835209766849", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458091_1903835213100182_7321004210439756143_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o19FvE8SdzkQ7kNvwGBUZAM&_nc_oc=AdkWSYTwmVCItiys-BW_cR3FhExEXSsbi6ZWFotu-ExnjwdER88-awClUXL-35x_Zhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuXmyswELPKm-LU8hSAuyFACfMGV9qjv9WstFhpxOp0tQ&oe=699F00DA"}, {"file_name": "TMMD_Oculus_Cover_7x10.png", "id": "530847088086261", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-
38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doaTbWHck2UQ7kNvwF1f3NK&_nc_oc=Adn50YNwIbdCSqAd7InBoSkJ0sjRl3mZZoEof4L0JhLNFL6ba9snPXz81MPswYp9PtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsj3xA80qzZpOeGs3NLBUIsLV4b0TrmwFruzahC5W5OhA&oe=69A42EAF"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ci2LJ1iHB24Q7kNvwFLbZ-M&_nc_oc=AdnqQ0dADQA5udz_RIXoQmG45e5fsisG5DWMEKlXztD559akcFG9IhtosJDtRHYSxFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvZrjM2zJ3SbyhHCODFtpTYruux4h-D1pB4ZCEmxxHevA&oe=69A41B1B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqaeXxFzQpIQ7kNvwFuUAGb&_nc_oc=AdkpdD53NRIdmxIFHj7LGwhdJzPS3UDhjAIu4SetKuv5Ao6NO1IsBFlJdYwsDfb2C9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvCa9xyd47yw1n8uVu-n7rXQH9t-D0KuJlWy8-27wR2Xg&oe=69A43E42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J07rwsoFXdcQ7kNvwHD1iwb&_nc_oc=AdmlqPta-TyeGg3S99Tug6fxPWmEt-GA0HCJ3pfTJqLuPkPSQEldMAHKhhnfb2lGet0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs-6qum-T2N3KCTWmaPB7CB-Ka46z4MXcFu62tH5MS0Aw&oe=69A42274"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH
608"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7z-tRal3hsQ7kNvwGQ9gZC&_nc_oc=Adr-B_tWvwfeghnGXrohZYU3y_MyloSmb5DfKdzp6-8gVwNmcTJWgpYRyTCYuR0x1-4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGSQnj0csR5jQkBMB-P0d-9qzG9N186EL7syZshmK7Jg&oe=69C7C72F"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EikS03uTfZUQ7kNvwG-Lcus&_nc_oc=AdoDQ_L7GVMp5rf5lYoLwVNA4_69qkaTlUBjCREbCKFiL7eVwGmOnI8vWsXHj3ClaLI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGvjNuFLjZ0Qz-5qTgrZqgDU9EISXfUqe6_wRMnrtpfg&oe=69C7B39B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR6D5Q6ekEEQ7kNvwEbOQXs&_nc_oc=AdoOnUJSzGwe5ANEX6xSQNxOJVbBR-2bqOT3LWzaWpgJxing6SlUZMW0QEkODRlcbOw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnFAsbdnGUzJOenlPMmeYBvbrwXanlxn7_KZpXcqC9qw&oe=69C7D6C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCtZYFEX06sQ7kNvwEBVSJ_&_nc_oc=AdpxwNFG7b4iwM-RvxUZQ-8pUByqYQ6lN8Bsv1ARb0ciY0ru2AkZBImvQUnKUAe-rw8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIUmNhgOpoa1UsM99m_PT7lXg7OY570HyZ-e9EKyZD4w&oe=69C7BAF4"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
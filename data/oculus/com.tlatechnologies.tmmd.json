38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-kyLAgFv_IQ7kNvwGwHaJR&_nc_oc=AdmoQAIUFboLClf08w0wxz2Q7wL-WL--grc5PIRrSn9m326-bCdeDNujBY8GqGIJEIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftTi8y7Qi4wj3IPmK8Gmve9O9I3IP4h5l04-dMhZ035Xg&oe=699C45AF"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UcooPLCN2AQ7kNvwHlVKKl&_nc_oc=Adn3NDGaMCsBIngK8qgJ0qHYo9blovEfGf45thwqzCpFLOr4io0Gh_5PvVOJn0ywcRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu7u2CRreC1VFAj0loMxLTuKnO9A9C-4eZP94pFMVZ7Qg&oe=699C321B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncrWJb7Pq-kQ7kNvwEMHgNc&_nc_oc=Adng57qIKHRTpCzniqZm8yp5I0sOosisXPjcYp3AfXHipvz-2Fzz-lWsGz-EziwoPDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvjbgecRHqPPLfSGXgvEoYNv86YtLTzA9fgQHTtbpFWfQ&oe=699C5542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbHrXW0qYFMQ7kNvwFz0l9p&_nc_oc=AdlwziB96sDTbkYwwvWWH9yHOtmOifLW4TlmUhnFAls4NkUSrGaW0V8K1AetgAVP938&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvrART2kQGcLqzMZqK7PTiTE0BFk6R1Ezz9_2Wm0LHyMQ&oe=699C3974"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH
808"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P79INFBlsb0Q7kNvwE_dImR&_nc_oc=Adr2KSvNXCVGyTzej68YFbJzmek5-Ip48rpyWKX3ccJu_wT2LH9x1RkUIssyIOqONtg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xPcFf_ZviqyU_ldZMTVdnV9ZpGecdd2HGefLIZMDwoA&oe=69D7992F"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY3EldUMMQUQ7kNvwFCYAXh&_nc_oc=AdoIVdGEEFM0Kd7_sGk7ZNdclC0xScTLswIPP_Cj2i9W_g52LnGMvLcdP9WYIKhXp28&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ehYr2EAjvIlWyTp-3o0CB05qsuvjBhThN7PNK2gR9ZA&oe=69D7BDDB"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxBnupazoxMQ7kNvwH8-8Jq&_nc_oc=Adqv0nkVIdv3yMMigPpwpvIEZDxt2srYJmQ_vNv21Hkc7czmjH3BREdIjfJQ7EzwihY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24i4w4-HwGzJL5e912g6Mg8M4E4emMfbaJYFH5_IejUQ&oe=69D7A8C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjw1ivt9wokQ7kNvwGnEjFb&_nc_oc=AdqkFXALIKUys3mlFa7lY9TW9t2xyPpzC_0vOd17YMa3Wk4k_uH1YcyrHQVLgpXJ1h0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TPhnPrbK6FbTq72vD4zH3-9uIrKYAPr0ML-tEG2NKnw&oe=69D78CF4"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
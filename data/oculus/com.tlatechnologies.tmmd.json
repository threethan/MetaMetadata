D88"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY-Pnn3OsoQQ7kNvwERvuUe&_nc_oc=AdrSLp-05etdl3rorT7NEpQeFhpIORVGvD4ImJ-53bb4fgct8qhLNQjsnFNjAflVrU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaH-QIxLPhncjls3zN_TwJlBTWwlbSUd5BERPQ_WJ5pw&oe=69CE5EAF"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oYAd7O3WdMQ7kNvwHMBMbY&_nc_oc=Adqc9uWDrc6HnVZw8ZiYea9bx8aGDvS8eWECG8MXHaMM2vNpnQP7UOnQkt-mg-UwdFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ9LekSUxPQuI64AQWguGKD8K0MJbf2WcmEQfUbMoH7w&oe=69CE835B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0bZgufwCcwQ7kNvwE0Kxd1&_nc_oc=AdqgTRAnm0HiQZ8zOeao_48DqXXo2OD5yDJUDVXGGOwUqMnbcpKCgGfC1X7wM5TK4bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4bje81KiA-QTsBk70zwEYhRDIR9Md0AoMu58dqXAyYg&oe=69CE6E42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JFtS2obmwoQ7kNvwEcb2Uq&_nc_oc=Adq07OGlY5JlwwKynFDHSkrqLuE6Cp1vLF2nDJKM0ocoE8h-RF2IlzqRyKqhrAKITk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyFgYoB6Um6zGIdeXpEuXQM4lFt_J0T2fpeRwtMatTjA&oe=69CE5274"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
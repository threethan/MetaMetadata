008"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tKBXjkBGJUQ7kNvwHNp_gV&_nc_oc=AdpZWsq_PK2UAnjlXUf4TD9HUkMEhFFx7BcchnPugBpxKW7u9YRWrNq9s4yiHlf3LRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyqrg0PTbY1-IN1FBMk4Rat6mFYJKehXTrJdGGMW9r4_g&oe=69C2812F"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iouLa1wMtJIQ7kNvwF5SoR8&_nc_oc=Adr-3NI8w5gTNkZl7FmU4V-URInmn7TeeelB6BeMNTZAT3eq-HW4x-npQTOt_AD3aY4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7erBvY1lCduvsmPr9YvhzBZ16MQfFH1vaGWJbHg6z5g&oe=69C26D9B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryT1qJW9HOsQ7kNvwGl53TG&_nc_oc=AdpTExG2Q1m1-gbLJGma8GStA5aKHCAO4I2XrMLXLMyCUuZK1-TeNGe4WohUp4WV3Hk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynbKZrplY7EI02yNkXKUx8AV8vMi5ZU2X0lehkMKGz9w&oe=69C290C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYmLBKqeI9oQ7kNvwH4kVVV&_nc_oc=AdqDh6CGmpMBY65QOfo_URa4jQR9QVT0cWd_8pgaYoolWFN5jS5TUfmQJeeeudje0s8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDVa2zs5eLrKIN8s9uFMraeuPdp6yBYe8VxFI4CXLQjw&oe=69C274F4"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
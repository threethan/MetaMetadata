588"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unfCPMgRJ-gQ7kNvwHYXrgC&_nc_oc=AdpeVWimgeHmfCFMIDoSQO9_OT4MgkflZKaMidRvk5bL3LsDI865DkINybmbU-AlJNo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOql8prfoMOatzL_hyNeFabQiA7PXTTKojHYvAFyLfaEg&oe=6AE096AF"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxTUMCZJ50MQ7kNvwEF9tYI&_nc_oc=Adq-4Ljn7e6-uNTfq2wFg0THePUvyfNxt4w0AbjNtqtrVC_0vR0ZI_qs55rwNh5GWT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0egQsHXE64DQZzDjS3q9P2ufuc-ZWOfnIeRBGE-SlYA&oe=6AE0BB5B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLs7cdhB920Q7kNvwEs5jZT&_nc_oc=Adp3CTulDKeXmHRl7hgh8tUYY3BhiaqohDomuZbWKybU4an3sTjajKbjWwoSIjppgxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBPPGFbHQ_lyL_07saufV9I5zQk4bITjgx9tTzn4yAHg&oe=6AE0A642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHN4gIELS_YQ7kNvwE8-wNU&_nc_oc=Ador1NN37WUGAw8Jld_8jj-U16woAJ21xYCqBVYQzNYavxwsbYCaG9C-DcYhlFZeMQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTdV_sep1A5IQQxObKAZZaOHyYA4Xw3ZyHAW3px77FbQ&oe=6AE0C2B4"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
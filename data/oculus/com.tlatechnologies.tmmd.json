808"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQ7YWmi9KkMQ7kNvwHQyRaR&_nc_oc=AdoG1o3_OfKWWirdJVGuclCe9tgtmsjaAp4ISOJIIFf2ZeQ0hmo22DxBnz2U3LX-yNg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK1pEAQaRyGoASiC6u_ijLXMTmlE5Ban9wfCcf68HSPw&oe=6A80592F"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naDCAdOrYwsQ7kNvwHKfhoa&_nc_oc=AdqXuu3PIUz7VDnNDKuneGRcW35QlsBAf78Xn2U_-RjxgpFg1FtTPxspOGqPYM0NlCg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd5ca9DnMr3sSo7m92Q5PbXotDYEYZ9CY2TzBTMrNpQw&oe=6A80459B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Odd_6hixi4Q7kNvwFs9OWK&_nc_oc=AdpbKyQXV4hH0lCoIDhgWl1A6Q56PwkZdNIJSDLPmh5JArjcE5zdTZ74oUmd6hYP6TA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnoo9JfMu03-uyxFoo6QXT549AccAH91MupJI-sKY01A&oe=6A8068C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CQaBVy7SKYQ7kNvwGsZFRT&_nc_oc=Adr4zXeRVYzi6GZsVSP0kz07MVA8spW3tBtWXu0LS1htlgA_0b-Kyi5I3Rk2gy-luKs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgRiJ-hlbEE-v0nPcH68GRahuJ4T2qWhVhCAhoS28V5A&oe=6A804CF4"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
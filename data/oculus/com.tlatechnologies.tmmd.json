288"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffyUkkeQkCYQ7kNvwF6EG9z&_nc_oc=AdpvwK8fuDPeOxj1_EfSf42o8TIXKpXBqXg9X4gxdUi9F603Op0_DF9tNPRrVJqwpzY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJNLm2pa3zsZnbKbeLUZdimcG_ASrJd-yg8YwsVabhQg&oe=6A8993AF"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gsmI6a3laEQ7kNvwGQ7i4R&_nc_oc=Adq4QSjT3HtOqsIRFuOhdReDJBLr-kZAwzqQSZT7Rm2UdOhQZBxfvGq-5mOi9drF3hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuYPMNjCBUsudJPrf9AMpAihVeQIUHwlLImK7p3B_Big&oe=6A89801B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLfer5PN-2oQ7kNvwHdd-yY&_nc_oc=Ado993bO0HbmZFV3Cz1IBEpcn_xdXNCYsiGmiPn-vsIU3hxPGmNOfeCs7dU2AUb7fMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwTAlknjkdupcTDNOxzNa5QaDbECvAx0fVagT1_6ktlQ&oe=6A89A342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1DeYWffC_EQ7kNvwGx-2Ek&_nc_oc=AdoVwo25HaLD2hWPiEICQtrrFASl42EnoWt3d15OWcK8ODFKMEfezF3xdfpq0BCLfxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm_6fF4_YdczZcit-TUl2Vd-SycFyogGfC-AbrNT6J-w&oe=6A898774"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
408"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfUmzb22ajAQ7kNvwFgNKAF&_nc_oc=AdoxWQPuf6HVVduH9pGve2o9fa6mEJS6y2k5TU84uscreka4L_fbMd5bRKxT2Y7rOwA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LGPPsOlxsZrg2P266DCI6w42sW4x00rEsAfmgmnySOw&oe=69E2252F"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8XBDLTpS5EQ7kNvwEQVJNk&_nc_oc=AdoaFcHuG-WCGeFBLv0mP11dxC-fZBcD1ZBLca58ENVSqkWlRnNuGSA1Rrk9lIuELvA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08GTilK_CGAuFT8qnD9nd6FQYUFO4Oa-qoYavSF_biag&oe=69E249DB"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLwMGtgr0J4Q7kNvwGekPjK&_nc_oc=AdryZQfqBu_pephwS-6Q3FFs4NO4WYf_MMdJ7SXGMuT5S7K_rPUmQljDt-S8POSU3Lo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VowpD6pT51oW7ky2lVOlqkiffkF4MjxKK6H16F7wrIQ&oe=69E234C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnq4cx6zaGEQ7kNvwFJhHDX&_nc_oc=Ado02Vp5SShhVYpB_Ako5ZdF4gyJ4gdeBp843RWgARIdeOBLsPuyYl6e3F7TfGEjc1k&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ci1X05shVt62QxUhzzV9uyYUY9W57qRiBAuC5tSPp1g&oe=69E25134"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
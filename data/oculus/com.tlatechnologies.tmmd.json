F88"}, {"file_name": "Joy.png", "id": "570749138837384", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974589_570749142170717_7945449402635154239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gJEtRuiPkQQ7kNvwGZMcoN&_nc_oc=AdruCQy7khZk1bsnTe2GJPVZRPFj3GBKFR_n4AE-zUjGcc9CZKW_5Dli9TCOQNfDCVs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ng-KIgPmODCE39ujMDw53onNvmUPV4y7j9t2UITp0gQ&oe=6A3290AF"}, {"file_name": "TMMD.png", "id": "912385050398953", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982524_912385053732286_2802365454437087428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mQ-CSgy2CAQ7kNvwEYn0K7&_nc_oc=AdpHYTDaM6qg6srAP-UwNt7s8MWF0coR4D4Wl6k1lQ8gS-6LTm-eC_Ttm0-JyDrxeYU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kTyFvJuk7rMx17chqBXf_pzFwliRGxGZq68QSLYTu1Q&oe=6A32B55B"}, {"file_name": "closing.png", "id": "1317920312917677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982571_1317920316251010_8408194208831164109_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQA9lVzFVHMQ7kNvwGyV8Lp&_nc_oc=Adp8eLBg7MpGr8HXQ0ZUJET9HV4KK4J8uqJ5A1Jl3eG2nfffZwhf7AShbl_vTv1Ow1c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IB-y7PYdmDgTVv00ZMolxSxj2fdlBbx8SjMDD5Kw53Q&oe=6A32A042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMMD_Oculus_Cover_16x9.png", "id": "1239254960080580", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75254876_1239254963413913_6147596762429332943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pseVpmOXxbgQ7kNvwG7Y0rg&_nc_oc=AdrxH7_JDgnXgy_PfrER-k7Zvn1gDhVxnrCOglXeWRcY9QlXcACvFcijWHWL7-b7xlw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JC8VhQp5yeUpL36Ii6yUjd2bFH2fCl3gskhvF3oD6_A&oe=6A32BCB4"}, "display_name": "Talking Mimes", "keywords": [], "long_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n\nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience. A virtual reality narrative drawn from true stories of people with profound physical disabilities. An emotional education piece developed for everyone - whether you're a caregiver, teacher, support worker, health professional, family member, friend, lover, hater, or total stranger to disability. \n\nAlmost all of us will have an access need at some point in our lives, and we will be at the mercy of others. Talking Mimes aims to better inform our behaviour towards those of us that have these needs now. To start a practical conversation around safety and respect. To actively reject the soft bigotry of low expectations. To peel back the layers of alienation and teach us how to be less accidentally condescending arseholes, and more on purpose good humans.\n\nClosed Captions and Audio Description available in English.", "short_description": "This is a narrative video experience (not a game) with a companion workshop available from https://www.talkingmimes.com/#AppAndWorkshops\n \nTalking Mimes is a touching, funny, infuriating, harrowing and ultimately hopeful experience, drawn from true stories of people with profound physical disabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talkingmimes.com/TLA_Privacy.pdf", "developer_terms_of_service_url": "https://talkingmimes.com/TMMD_ToS.pdf", "publisher_name": "TLA Technologies", "support_website_url": "https://talkingmimes.com/#email", "website_url": "https://www.talkingmimesmustdie.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
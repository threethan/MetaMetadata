, "id": "1159442426940938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/753032404_1159442430274271_7128181106600464598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lNFxOyd2m4Q7kNvwGhQeW4&_nc_oc=Adq5hyTPEKUSO9RDju-7W_wTQLUJC1lt_lRf_xs53Ld0RY-Oie2K8gHWLMlBBFcr4a4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUsTvMso728H2BV3dcaMF180qOqa45pD9SZOuScTTztQ&oe=6B06F70D"}, "display_name": "Resonaut", "keywords": ["music", "visualizer", "trippy", "psychedelic", "fractal"], "long_description": "# A Musical Experience\nResonaut is a highly customizable and feature-packed music visualizer built for VR. Play your own music files, stream from your home media server, or discover something new on 60,000+ radio stations worldwide.\n\nExplore a wide variety of live, music-reactive visuals to match any mood. Drift through a sea of glowing jellyfish, fly down endless fractal corridors or stand on a moonlit shore with crashing waves. Customize any look, save your own, and set comfort exactly how you like it.\n\n# 20+ visuals, 100+ looks, and growing\nEvery look morphs to the rhythm, and when the song changes, so does the scene. New visuals are added in free updates.\n\n{1949008266264996}\n\n# Make it yours\n- Tweak colors, speed, shapes and more in realtime\n- Save your own looks, build visual playlists, or let Resonaut pick for you\n\n{1694673068990476}\n\n# Music your way\n- **Your files:** MP3, FLAC, AAC, OGG, M4A, WAV, gapless, with optional crossfade\n- **Radio:** 60,000+ stations, and save the info of songs you hear for easy remembering\n- **Media servers:** play from DLNA/UPnP servers on your Wi-Fi\n\n# Comfort\n- Lying-down mode for watching in bed\n- Sleep timer that fades the music and the view out\n- Comfort presets, vignette, snap turn, a no-movement mode and reduced flashing\n\n", "short_description": "Resonaut is a highly customizable VR music visualizer. Play your own music files (all common types supported), tune in to 60,000+ internet radio stations, or stream from a media server on your home network, and watch 20+ visuals react to every beat, build and drop. Fly through fractals, drift among glowing jellyfish, stand on a moonlit shore as waves crash on the beat. Pick from 100+ looks, tweak any of them live and save your own. Lying-down mode, sleep timer and comfort options included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infigmentstudios.com/resonaut-pp", "developer_terms_of_service_url": null, "publisher_name": "Infigment Studios", "support_website_url": "https://resonaut.userjot.com/", "website_url": "https://infigmentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "it", "ja", "ko", "pt_BR", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28858647260497574"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654877283_4774725452760848_5735362943522453898_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7KU9x2kyLwQ7kNvwGcixSt&_nc_oc=AdopWOpLvha5gRseZSasNADdAQHyqaiK5kGLrHjtA0WkSAe9Nr-BZ70g--nH3xPFrqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoySAXyAGdTeZetAENf9drSsTwgCNrRRRVGQTLuMB1aQ&oe=6B072015"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display
.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUfK74FONsoXsk5knZPjglTsvVo-y38FMqgeEOo1RnpNA&oe=6B1052CC"}, {"file_name": "Screenshot_Tendril-Drift_Tendril-Storm_152454_2560x1440.png", "id": "4762464857368406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302374_4762464860701739_1875568425819816061_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fEPXF366H8Q7kNvwG5fOpp&_nc_oc=AdrWEscbc0qmXoANkfNAW1LcPnxEAXXCDLw3K5dwLGoNdbBtSJN-ftcd49DlSS3VtbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXuyYS83PTUowg6NSHuSvSncy4qvJHnmJw3xBf59GziIw&oe=6B104693"}, {"file_name": "Screenshot-UI_Hyperspace-Halls_Mirror-Serpents_154233_2560x1440.png", "id": "1767572694352999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298329_1767572697686332_2017950588995467937_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA__dX6fdB8Q7kNvwF_2X4p&_nc_oc=AdqAuP_hrji8EQOQUP5mLCSaEywwAc3atPB3YECNCQpVVzC_E_LgBzpvjz8DEPfHiII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwNF4oB76nmycqs5pt3i78OeKW6n8dWwchj9O8x_cnBQ&oe=6B104977"}, {"file_name": "Screenshot_Codefall_Code-Tunnel_152118_2560x1440.png", "id": "1040417865745888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307920_1040417872412554_5296533593038436927_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_bnXpADVUUQ7kNvwGYyP7q&_nc_oc=Adq-yJB8gpR7qU75yzlb-KWgWrv2XeTWwDn9YL1Bg1TahLPN3U5mDKtfdYW2rQ-0Hso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWI-hpkVKA7PKR9BnuV1ZgbfdjXSZsAEwYELi2XKLTNDA&oe=6B104705"}, {"file_name": "Screenshot-UI_Lumen-Sea_Night-Rain_101327_2560x1440.png", "id": "29902119022746126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830576_29902119029412792_9014660982366393349_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tzixv4qEwoQ7kNvwE5xmtJ&_nc_oc=AdprD8l-6cWSolprDZvfGvUB9I6NMtRCugCU53BgiTIuMyEn1dwzqOwd5jlZPigdtx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXYpJLTMzBm7G2FkGgc4Emo6fzrVHdAWTGCXNYyGd53Ng&oe=6B106447"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1159442426940938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/753032404_1159442430274271_7128181106600464598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFEIL_a_HbcQ7kNvwEXkgt7&_nc_oc=AdpxkU_bET3FDgLIpRyMqK2yeOUiJh_izLwM6aE4RC8Vud83z8f-8Tx9i-33BxLps50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrJ6Eq-ULp1IQA1bvGflBXmcbcIcnnGREHw3Cg5DkUVA&oe=6B1069CD"}, "display_name": "Resonaut", "keywords": ["music", "visualizer", "trippy", "psychedelic", "fractal"], "long_description": "# A Musical Experience\nResonaut is a highly customizable and feature-packed music visualizer built for VR. Play your own music files, stream from your home media server, or discover something new on 60,000+ radio stations worldwide.\n\nExplore a wide variety of live, music-reactive visuals to match any mood. Drift through a sea of glowing jellyfish, fly down endless fractal corridors or stand on a moonlit shore with crashing waves. Customize any look, save your own, and set comfort exactly how you like it.\n\n# 20+ visuals, 100+ looks, and growing\nEvery look morphs to the rhythm, and when the song changes, so does the scene. New visuals are added in free updates.\n\n{1949008266264996}\n\n# Make it yours\n- Tweak colors, speed, shapes and more in realtime\n- Save your own looks, build visual playlists, or let Resonaut pick for you\n\n{1694673068990476}\n\n# Music your way\n- **Your files:** MP3, FLAC, AAC, OGG, M4A, WAV, gapless, with optional crossfade\n- **Radio:** 60,000+ stations, and save the info of songs you hear for easy remembering\n- **Media servers:** play from DLNA/UPnP servers on your Wi-Fi\n\n# Comfort\n- Lying-down mode for watching in bed\n- Sleep timer that fades the music and the view out\n- Comfort presets, vignette, snap turn, a no-movement mode and reduced flashing\n\n", "short_description": "Resonaut is a highly customizable VR music visualizer. Play your own music files (all common types supported), tune in to 60,000+ internet radio stations, or stream from a media server on your home network, and watch 20+ visuals react to every beat, build and drop. Fly through fractals, drift among glowing jellyfish, stand on a moonlit shore as waves crash on the beat. Pick from 100+ looks, tweak any of them live and save your own. Lying-down mode, sleep timer and comfort options included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infigmentstudios.com/resonaut-pp", "developer_terms_of_service_url": null, "publisher_name": "Infigment Studios", "support_website_url": "https://resonaut.userjot.com/", "website_url": "https://infigmentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "it", "ja", "ko", "pt_BR", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28858647260497574"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "934509306282538"}, {"status": "PUBLISHED", "id": "2347359666051041"}]}, "baseline_offer": {"id": "2347359666051041"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797278400, "status": "PUBLISHED", "id": "934509306282538"}]}, "liveChannel": {"nodes
.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQmtrE7MMn3yPdM0PXyhsJlZTsCSxVcw8DspDjo03lGA&oe=6B0F014C"}, {"file_name": "Screenshot_Tendril-Drift_Tendril-Storm_152454_2560x1440.png", "id": "4762464857368406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302374_4762464860701739_1875568425819816061_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wWR5MJmmx8Q7kNvwFd2WNE&_nc_oc=Adr9n4Oj2M1hHZpG-JxQpsxdXIAyyr-4kXVkviAPvBp2puVFt3UCgd6QXuHeZ8THkxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUq9sarU1w68Ko-FVIZizJiki5wOe-ESdWFdTBiLvpG9Q&oe=6B0EF513"}, {"file_name": "Screenshot-UI_Hyperspace-Halls_Mirror-Serpents_154233_2560x1440.png", "id": "1767572694352999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298329_1767572697686332_2017950588995467937_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA__dX6fdB8Q7kNvwHsfUZO&_nc_oc=AdqbS_x0z-iqRfQTPryjsm4eO34sJuNpjAnN7wmQIeYckRIZM0sbw_9ow-YZt4BAavU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuI4ZSE8RsxKQb01cMWoixer6wUt3rRVTZfRNbIVFG1Q&oe=6B0EF7F7"}, {"file_name": "Screenshot_Codefall_Code-Tunnel_152118_2560x1440.png", "id": "1040417865745888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307920_1040417872412554_5296533593038436927_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_bnXpADVUUQ7kNvwHRKCwU&_nc_oc=Adp0HgET5Puq1qyK39fQMGO9HqY2Hb3irIRyUoJHvzzSJsLUQgc4efx3Nal-k84VAok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFT12cGeLzsCcHdhE0S8UTSdBDIJgd7e3dlKWtVqgckQ&oe=6B0EF585"}, {"file_name": "Screenshot-UI_Lumen-Sea_Night-Rain_101327_2560x1440.png", "id": "29902119022746126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830576_29902119029412792_9014660982366393349_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaGbCTPZHtEQ7kNvwGDAvxV&_nc_oc=AdrSPOg2QyIg6x3__iOiqO5m0StlnT469R_ubYZHJrZOi34-mSpnB2Nei3mFmUueUT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUspaLGp2_dcgiNckmIUGDz8KWPnR4O07ZvXufSTGvEAg&oe=6B0F12C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1159442426940938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/753032404_1159442430274271_7128181106600464598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFEIL_a_HbcQ7kNvwHOeJl0&_nc_oc=AdrXp9CKIqWa-FBu7J_PwVhYFYtr82GE8qMN0pgt291LteqQ-ZhDYrPZIlSZM-bR1xc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWiGdns1roYrkljnFCczaJuFOo2-LyR03Tr1o6AOCVfSA&oe=6B0F184D"}, "display_name": "Resonaut", "keywords": ["music", "visualizer", "trippy", "psychedelic", "fractal"], "long_description": "# A Musical Experience\nResonaut is a highly customizable and feature-packed music visualizer built for VR. Play your own music files, stream from your home media server, or discover something new on 60,000+ radio stations worldwide.\n\nExplore a wide variety of live, music-reactive visuals to match any mood. Drift through a sea of glowing jellyfish, fly down endless fractal corridors or stand on a moonlit shore with crashing waves. Customize any look, save your own, and set comfort exactly how you like it.\n\n# 20+ visuals, 100+ looks, and growing\nEvery look morphs to the rhythm, and when the song changes, so does the scene. New visuals are added in free updates.\n\n{1949008266264996}\n\n# Make it yours\n- Tweak colors, speed, shapes and more in realtime\n- Save your own looks, build visual playlists, or let Resonaut pick for you\n\n{1694673068990476}\n\n# Music your way\n- **Your files:** MP3, FLAC, AAC, OGG, M4A, WAV, gapless, with optional crossfade\n- **Radio:** 60,000+ stations, and save the info of songs you hear for easy remembering\n- **Media servers:** play from DLNA/UPnP servers on your Wi-Fi\n\n# Comfort\n- Lying-down mode for watching in bed\n- Sleep timer that fades the music and the view out\n- Comfort presets, vignette, snap turn, a no-movement mode and reduced flashing\n\n", "short_description": "Resonaut is a highly customizable VR music visualizer. Play your own music files (all common types supported), tune in to 60,000+ internet radio stations, or stream from a media server on your home network, and watch 20+ visuals react to every beat, build and drop. Fly through fractals, drift among glowing jellyfish, stand on a moonlit shore as waves crash on the beat. Pick from 100+ looks, tweak any of them live and save your own. Lying-down mode, sleep timer and comfort options included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infigmentstudios.com/resonaut-pp", "developer_terms_of_service_url": null, "publisher_name": "Infigment Studios", "support_website_url": "https://resonaut.userjot.com/", "website_url": "https://infigmentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "it", "ja", "ko", "pt_BR", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28858647260497574"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "934509306282538"}, {"status": "PUBLISHED", "id": "2347359666051041"}]}, "baseline_offer": {"id": "2347359666051041"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797278400, "status": "PUBLISHED", "id": "934509306282538"}]}, "liveChannel": {"nodes
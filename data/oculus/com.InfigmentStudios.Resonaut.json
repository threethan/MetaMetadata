file_name": "Screenshot-UI_Hyperspace-Halls_Mirror-Serpents_154233_2560x1440.png", "id": "1767572694352999", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298329_1767572697686332_2017950588995467937_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mM0SRuHGYfcQ7kNvwHpZYHJ&_nc_oc=AdpBCK8TkfxCClKxVLG1suDLxbUzfnWPPYCMYG1WW3tb5JtPNqz2rfGeMMnUuhLE1RY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnHXmFy8t7hyFDfHl6RLORQ3RnwF0hU-E-97KPB7oZrQ&oe=6B09B1F7"}, {"file_name": "Screenshot_Codefall_Code-Tunnel_152118_2560x1440.png", "id": "1040417865745888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307920_1040417872412554_5296533593038436927_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBTbBerBVEIQ7kNvwHbAAhm&_nc_oc=AdrmRCkU8LCorWcZymYWq27m3Ub2dmvy_QoU3jCLIm2g-Xewo9YdvKIjZHUJA1i9Dro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRmi4BizLrr55As2tY7lIl7dKpOiDuzoOq4m8s1dK-Tg&oe=6B09AF85"}, {"file_name": "Screenshot-UI_Lumen-Sea_Night-Rain_101327_2560x1440.png", "id": "29902119022746126", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830576_29902119029412792_9014660982366393349_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=830E0OejJT0Q7kNvwG1BrdF&_nc_oc=Adoe3wNmG2uo0-64tbxfwU3zwNfJSZTQXHMyBBT5SCHt_tOkxbsznsmkByWtKX-yBg0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhxhZYMu-hKMjJctwHlLRW_a5v-Q5j23xgOVHfuXyboQ&oe=6B09CCC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1159442426940938", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/753032404_1159442430274271_7128181106600464598_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUo64xzd4q8Q7kNvwGIPbJP&_nc_oc=AdpjnB8R4OTIzcA1lOrKMNidj0b0Fk1TVX8c0NQ7GJIZc24oOfgRnPFyYUxh2Zq0DsY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd0xzRvt8-X3CHWts5z_NnksTwB2DgXDrkYmvrkOQPCQ&oe=6B099A0D"}, "display_name": "Resonaut", "keywords": ["music", "visualizer", "trippy", "psychedelic", "fractal"], "long_description": "# A Musical Experience\nResonaut is a highly customizable and feature-packed music visualizer built for VR. Play your own music files, stream from your home media server, or discover something new on 60,000+ radio stations worldwide.\n\nExplore a wide variety of live, music-reactive visuals to match any mood. Drift through a sea of glowing jellyfish, fly down endless fractal corridors or stand on a moonlit shore with crashing waves. Customize any look, save your own, and set comfort exactly how you like it.\n\n# 20+ visuals, 100+ looks, and growing\nEvery look morphs to the rhythm, and when the song changes, so does the scene. New visuals are added in free updates.\n\n{1949008266264996}\n\n# Make it yours\n- Tweak colors, speed, shapes and more in realtime\n- Save your own looks, build visual playlists, or let Resonaut pick for you\n\n{1694673068990476}\n\n# Music your way\n- **Your files:** MP3, FLAC, AAC, OGG, M4A, WAV, gapless, with optional crossfade\n- **Radio:** 60,000+ stations, and save the info of songs you hear for easy remembering\n- **Media servers:** play from DLNA/UPnP servers on your Wi-Fi\n\n# Comfort\n- Lying-down mode for watching in bed\n- Sleep timer that fades the music and the view out\n- Comfort presets, vignette, snap turn, a no-movement mode and reduced flashing\n\n\n# Made for Your Hands\n- Bring the menu close and use it like a tablet\n- Stop, fly, turn and switch visuals with simple gestures\n{2038517210142960}", "short_description": "Resonaut is a highly customizable VR music visualizer. Play your own music files (all common types supported), tune in to 60,000+ internet radio stations, or stream from a media server on your home network, and watch 20+ visuals react to every beat, build and drop. Fly through fractals, drift among glowing jellyfish, stand on a moonlit shore as waves crash on the beat. Pick from 100+ looks, tweak any of them live and save your own. Lying-down mode, sleep timer and comfort options included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infigmentstudios.com/resonaut-pp", "developer_terms_of_service_url": null, "publisher_name": "Infigment Studios", "support_website_url": "https://resonaut.userjot.com/", "website_url": "https://infigmentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "it", "ja", "ko", "pt_BR", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28893552830340350"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654877283_4774725452760848_5735362943522453898_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo9dhLSvcK8Q7kNvwEsAFAP&_nc_oc=Adrupz-yp8vQ1f0Na_SX2kJhUnc9tNLI7Hogm1OUNFpDegRpbrApkdBx_CCfKwxCOT8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9dziH1PkzdLN4DrSnPevvsRVCWbbaadUr82GFezqkrQ&oe=6B09C315"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Resonaut", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1795191360, "lastRevision": {"node
creen1 (4).png", "id": "2202920313483268", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819934_2202920316816601_302461982376722953_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xivQ1Cq4QlUQ7kNvwGLmKeo&_nc_oc=AdpfwzyvptNyDPoL6rrQFbSneD9Ys7Y4aTFev24mAM-4nN6Ah67qDeKww0ZX9xO1eN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oB3E9BrdhfubColhRJSYpcjyuwv1DXlMjXtiFxsFszQ&oe=6A3168C0"}, {"file_name": "BIM-screen2 (5).png", "id": "691818080312397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312287_691818086979063_6991494212943406109_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1Fyt94YWREQ7kNvwEMO3aN&_nc_oc=AdphgmmIP6W0EDf13YhcsldQumBnDDOZjGUXC4sTnDKKU_fFFtpl9RKJrugjJwuwM04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95fz8fTXbButnOA5BUnf1qvHBLVF3Rl96ZUW_h7vQUTA&oe=6A31796C"}, {"file_name": "BIM-screen3 (4).png", "id": "1229883361604776", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308002_1229883364938109_3636719465995222951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRXboPiAHGEQ7kNvwEZXiWQ&_nc_oc=Adrxq2Fdj8xoEDXsDybE1cFG_1JT8tKcmbbwlQqonE-oFB6T2V_mJL_-aT1pwxJT6JU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IJc_z8pJFnCXXDiTcurMwM9Wc9lgmTMnSypxyHcOW5w&oe=6A3160DC"}, {"file_name": "BIM-screen5 (4).png", "id": "720240493915627", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295661_720240497248960_856486923542619954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbNWvisPCMoQ7kNvwEV64yM&_nc_oc=AdpSULVGTTL3JaoTf5iHYvPu2sF59TuLON3CczbCW2cMjyrsYubAFRVIXrw4-hi90HM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m6u5E4JzWDMpez-Kc_Zi1UkKO6Dyj087WPllTD75Png&oe=6A31578D"}, {"file_name": "BIM-screen4 (5).png", "id": "1395968661658130", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819934_1395968664991463_6051137748661535289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY1AvPu9DaIQ7kNvwHD3uQO&_nc_oc=Adrywc6pHGJ0CWSZsJRB-_LuH1SsvP99pPtrNg75WOh2XYkBSc73i3jtCORnMQDKzBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sI4WMTR14S1FHpHLVr_XjMqdTY-9dJFZtagQt64zenA&oe=6A314CC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape_2560x1440.png", "id": "1222882949628908", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823431_1222882952962241_5952028104832100515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGJ5c0lEWbkQ7kNvwHihj1e&_nc_oc=AdrMTC63k6jbf-G3P5wAJj9cx9twE_xBWt6pkWmlRAMWNqozkl5YU_LrEkECyzlyfzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BrVN8xWCt-cZQFvVGBP2X04XZqnu-ILrF1H5lMj62ew&oe=6A314D91"}, "display_name": "BIM VR", "keywords": ["collaboration", "construction", "BIM", "3D", "engineering"], "long_description": "BIM VR is a powerful tool designed to bring Building Information Modeling (BIM) into the immersive world of virtual reality. It allows architects, engineers, and construction professionals to visualize, analyze, and interact with complex 3D BIM models at a 1:1 scale \u2014 providing unprecedented clarity and control over every detail of a project.\n\nThrough VR, BIM VR transforms traditional BIM workflows into engaging and intuitive experiences. Users can walk through models as if they were inside a building, explore architectural and engineering details, detect design errors early, and collaborate remotely with teams and clients in real time.\n\nWhy BIM VR?\n\nReal-Scale Immersion\nTraditional 2D or even 3D screen-based BIM viewers limit spatial understanding. BIM VR solves this by placing users directly inside the project environment. This immersive perspective makes it easier to comprehend scale, proportions, and spatial relationships, which is critical for design validation and decision-making.\n\nEarly Detection of Issues\nBy visualizing models in VR, teams can spot design clashes, inconsistencies, or construction conflicts long before physical construction begins. This early detection minimizes costly reworks, reduces delays, and improves overall project quality.\n\nEnhanced Collaboration\nBIM VR enables virtual walkthroughs that stakeholders can attend from anywhere in the world. Presentations become more impactful, and communication becomes clearer. ", "short_description": "Explore BIM models in true-to-scale VR. Detect errors early, collaborate remotely, and streamline project reviews with BIM VR, immersive visualization for architects and engineers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jetxr.style/bimvr-pr-policy", "developer_terms_of_service_url": "https://jetxr.style/bimvr-terms-of-use", "publisher_name": "TOO JetXR ", "support_website_url": null, "website_url": "https://jetxr.style/bim-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24010764411944653"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "723326320164497"}]}, "baseline_offer": {"id": "723326320164497"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750678500, "status": "PUBLISHED", "id": "723326320164497"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27440126135675113", "version": "1.4.0"}, "id": "1490492985659440", "chann
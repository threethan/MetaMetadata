channels": {"nodes": [{"channel_name": "LIVE", "id": "1490492985659440"}]}, "change_log": "Features: \n\n- New avatar system: we now have custom avatars, and each customer has access to a starter set of 40 avatars \n\n- New transformation: The interface for transforming objects (moving, rotating, scaling) has become much more convenient, and the ability to freely transform objects has been added (grab an object with your hand, move and rotate it simultaneously, as naturally as possible) \n\n- The system keyboard has been replaced with a built-in one \n\n- New set of palettes for repainting objects \n\n\n\nFixes: \n\n- All interfaces have been rebuilt \n\n- Interface edits throughout \n\n- Fixed rendering of overlay objects \n\n- Minor bug fixes", "created_date": 1772782406, "id": "26386205177733886", "version": "1.3.0", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23884099377944491", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27440126135675113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1490492985659440"}]}, "change_log": "Fixed rendering problems", "created_date": 1769410821, "id": "25996429973378077", "version": "1.2.1", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23884099377944491", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27440126135675113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1490492985659440"}]}, "change_log": "In this update we added:\n \n\n\u2014 3D drawing. You can now sketch in 3D with both straight and freehand lines \u2014 perfect for quick markups, notes, and clearer communication with collaborators right inside the place.\n\n\n\u2014 Performance improvements. The app is now faster and more responsive, with smoother interactions and more stable work on heavier projects and 3D content.", "created_date": 1765522406, "id": "25599479493073129", "version": "1.2.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
40497248960_856486923542619954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3Z-AeWrdnEQ7kNvwF2QTHh&_nc_oc=AdpLwPVKu85qnooJ52LOffiuFKXw4VLYpwCHoJirPMEvxvNMipd7_qt992DPXPT-Xuo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGePEuugF8Z2ozjbZ71NNBuZZWn4cL6XebvwRKwvHJIBQ&oe=6A88224D"}, {"file_name": "BIM-screen4 (5).png", "id": "1395968661658130", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819934_1395968664991463_6051137748661535289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itlyjimSrWcQ7kNvwEE1HHW&_nc_oc=AdpsQZkcei3PsSF5LGacdCQOt0hpiyoul8_-I9FIyN3CtN0Xk2GHCQMcs0GUwDBT3y4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE13qTsFdTVkqFF8n0g0Vv6PBKY85JSaCk04L5hnHvD8w&oe=6A884FC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape_2560x1440.png", "id": "1222882949628908", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823431_1222882952962241_5952028104832100515_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcfVTv-6XD8Q7kNvwHv9uU5&_nc_oc=AdpmyBfjMA4c1YsYPNq_TumII1R_Ys2QLIr6D_WtFg41Hm0ykD1forKycDiEmCcm5YM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT-0rnPnHRZf-8vYfg6KP9iJmD920sGOcebAzMBw98lA&oe=6A885091"}, "display_name": "BIM VR", "keywords": ["collaboration", "construction", "BIM", "3D", "engineering"], "long_description": "What's New in This Update:\n\n- fixed large lists scroll issues\n- fixed minor netcode issues\n- fixed keyboard visual bugs\n- fixed hints on controllers\n- fixed name bar behavior\n- fixed snap modes on model preview slicer in lobby\n\nWhy BIM VR?\n\nReal-Scale Immersion\nTraditional 2D or even 3D screen-based BIM viewers limit spatial understanding. BIM VR solves this by placing users directly inside the project environment. This immersive perspective makes it easier to comprehend scale, proportions, and spatial relationships.\n\nEarly Detection of Issues\nTeams can spot design clashes, inconsistencies, or construction conflicts long before physical construction begins. This early detection minimizes costly reworks. \n\nEnhanced Collaboration\nBIM VR enables virtual walkthroughs that stakeholders can attend from anywhere in the world. ", "short_description": "Explore BIM models in true-to-scale VR. Detect errors early, collaborate remotely, and streamline project reviews with BIM VR, immersive visualization for architects and engineers.\n\nOct 2025 Update: \n\nCustom properties overrides & recoloring\nPassthrough login\nOptimized streaming & faster loading\nImproved lobby experience\nUI face-lift: \nUpdated minimodel in the lobby\nController hints\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jetxr.style/bimvr-policy", "developer_terms_of_service_url": "https://jetxr.style/bimvr-terms-of-use", "publisher_name": "TOO JetXR ", "support_website_url": null, "website_url": "https://jetxr.style/bim-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27976674742020247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307435_936902628470008_4638587649734104132_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOxwI-8dguYQ7kNvwHRbFtM&_nc_oc=Ado232zq8Mi_1hl99E6Uo63Eyf1MNa4UjDbmGnNYJUS-VwvhqV8fis0thh_gyyi1Oqs&_nc_zt=3&_nc
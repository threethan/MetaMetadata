AEB41A5"}, {"file_name": "05_ftp_auth.png", "id": "1775244693519700", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1775244696853033_3770637480311411171_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHjzVUY1oV0Q7kNvwEa8nRt&_nc_oc=Adpa6p5M2qA5sktoO_pvm22ODp6XZdNPtYVbdddOXJtzoRaDR1uPam0rZRNWW_I7I10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkrreOFBlPTX5dgv7R2xd9y1nakz0u3l_7cS0xXpsZag&oe=6AEB5B80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EZ File Server", "keywords": ["wifi", "webdav", "ftp", "files", "transfer"], "long_description": "No cable? No problem. EZ File Server puts a file server inside your Quest.\n\nTHREE WAYS IN\nHTTP: open the address in any browser on your PC, Mac or phone. Upload files and whole folders, download files, grab a folder as a ZIP, create and delete folders. Big buttons that work on touch screens too.\nWebDAV: add the headset as a network drive in Windows (\"Map network drive\"), macOS Finder (\"Connect to Server\") or any WebDAV app, and work with it like a USB disk.\nFTP: connect with FileZilla, Total Commander, Windows Explorer or any FTP client. Interrupted uploads resume where they stopped.\n\nONE TAP TO START\nChoose the server type, press Start Server and the address appears in big letters. Too long to type? Show the QR code and scan it with your phone, or save and share it.\n\nSEE WHAT IS HAPPENING\nEvery upload and download shows live progress, speed and time left, right in the headset.\n\nYOUR RULES\nPick the port and the folder you want to share. Turn on a username and password so only you get in.\n\nBUILT FOR VR\nA clean, dark panel with large controls for controllers and hand tracking.\n\nPRIVATE BY DESIGN\nFiles travel only between your own devices on your local network. No accounts, no analytics, no cloud in the middle. HTTP, WebDAV and FTP are not encrypted, so use it on a network you trust.\n\nSUPPORT\nBugs, ideas and help: https://discord.gg/hf25pdr9BH", "short_description": "EZ File Server turns your Quest into a Wi-Fi file server. Pick HTTP, WebDAV or FTP, press Start, and reach your headset from any PC, Mac or phone on the same network. Drag videos in from a browser, map the headset as a network drive, or connect with FileZilla. Scan the QR code to connect, add a password if you like, and watch every transfer live. No cable, no cloud, no account: your files go straight between your devices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/ez-file-server/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": "https://discord.gg/hf25pdr9BH", "website_url": "https://f1tt0n.github.io/ez-file-server/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1325909983943247"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1752021626095473"}, {"status": "PUBLISHED", "id": "1637890827971068"}, {"status": "PUBLISHED", "id": "4613243955561664"}]}, "baseline_offer": {"id": "1752021626095473"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793115600, "status": "PUBLISHED", "id": "1752021626095473"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []},
_ohc=vwAJv2iuCnwQ7kNvwF9hFcv&_nc_oc=AdpiMsgrj1X8Rod-HxDdB8A8EX8mBpZAXoqzjRyyKRhWmxtOUPVwrDNL6fvLFxp1ulk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf8KQ-HTNH8HWgtgCQJuhZpx23nWWOwELI4qWiWCaPWg&oe=6A9AC37D"}, {"file_name": "5.png", "id": "911980914631032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296069_911980917964365_5942001399510804173_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mvc4_Zv6Q8YQ7kNvwF8roSS&_nc_oc=AdoHfkN3t-ZpjZwv4y6we5NRthdIkIyrC04nTn9sY1DikcpaQiVa4knSqcaCyYOcS9Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-xoKMnS83-k-6HTzCKjJklWxuos8v2rUTQaptwSzaXg&oe=6A9AE62E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image992.png", "id": "1358010712983924", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/646448363_1358010716317257_8130705741320389108_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFhAkX3K-lcQ7kNvwE07QTo&_nc_oc=AdrAK9pRdG5X1fPQxJeGZ64lUs33XCgUQdUfP_D1ikLgFr5X6yuSjUfLldnB3mLKDII&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFS4bzZdgubrTZPZmg9IFtbtqrT6Gr5KxUc5S9Y8NE7g&oe=6A9ADA66"}, "display_name": "Resist The Wave", "keywords": [], "long_description": "The world is on the brink of collapse. Wave after wave, nightmarish creatures emerge from the shadows to destroy you. Your mission: survive, resist, and fight back.\n\nIn Resist the Wave, every shot counts. Aim precisely, dodge attacks, and use sprinting to reposition yourself while managing your arsenal. The action unfolds in a vibrant, top-down 3D world designed specifically for Meta Quest.\n\nForge your path through 8 (Early Access) levels of increasing difficulty.\n\nDevastatingly Powerful Special Weapons: Purchase new weapons in the shop between waves using coins you collect from enemies.\n\nBetween levels, invest your coins in permanent upgrades:\n\nWeapons \u2014 Increase your attack power\nHealth \u2014 Survive longer\nStamina \u2014 Run and dodge without limits\nMedic Kit \u2014 Restore health in combat\nEconomy and Rewards\n\nEach defeated enemy may drop coins that fly toward you. Use them wisely in the shop between waves or save to upgrade your equipment. Bosses always reward you generously.\n\nKey Features:\n\n\u2705 Immersive VR experience for Meta Quest\n\u2705 16 levels with waves of enemies and final bosses\n\u2705 4 unlockable weapons with different playstyles\n\u2705 Shop between waves: weapons and medkits\n\u2705 Progressive upgrade system\n\u2705 Automatic saving of your progress\n\nDo you have what it takes to withstand the wave? The battle for survival begins now.", "short_description": "Resist the Wave is an intense virtual reality survival shooter. Face relentless waves of enemies\u2014from skeletons and golems to minotaurs and slimes\u2014as you progress through eight action-packed levels (in the early access version). Purchase and upgrade your arsenal between battles.\n\nEach level culminates in a boss fight. Earn coins by defeating enemies, spend them in the shop between waves, or upgrade your health, stamina, and medkit as you complete each level. Can you withstand the wave and emerge"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1vIriz_JZtB3xw4yMjxhQXX2E5TxSwayKkGNk8xSBWXM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/resist-the-wave/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
L0RuIH4dpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHiMFkH1AC5VRgt58DtNbScWWvFY72ow3GF_5M_lol8A&oe=6B05A562"}, {"file_name": "Screenshot_9.png", "id": "488615829018273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031391_488615832351606_8780358266402379255_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZE3DpxcvCwQ7kNvwEwK5k5&_nc_oc=Ado8oc9VBQ5IsltW5cFb4jiHC8p1jcdzfa5_BUxuFWA_Pb3vnWYRIC6wF1n43RLENKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS62b_69TY8GL0VOf0wEWe_bj0_I7660gyIFbNnWvN40A&oe=6B05ACAF"}, {"file_name": "Screenshot_7.png", "id": "311764160408823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566677_311764163742156_6354851173974657435_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5ofEm86kPsQ7kNvwF87xkO&_nc_oc=AdqiVGeZI3SHdU8ttKDSg8KxlR3DJFRrFz-_CtRjXZ7y79U28T0BSasR8WtmDF_rCJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5wDOaVRKWs-DQFwwzvgvaTacCHYmHyXCBHHLxiJ7OfA&oe=6B05B8BF"}, {"file_name": "Steam-Screenshot2.png", "id": "515575053121672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_515575056455005_5034961616916098855_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85q7zEwzjj0Q7kNvwHdmNFy&_nc_oc=AdrTgdorcJ919EPQC-onNNXBuN-Qe4uwZRfKX77eEIXFQoeyD3NV_zcLZDLBkbAky6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSse5RcK6AFi_tNdePph0b8DuTCk6BTsCYxA3tsjYG8w&oe=6B05C7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover (1).png", "id": "319098836717241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_319098840050574_1723902986571985662_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9AAuJBro5gQ7kNvwHWniPJ&_nc_oc=AdrraeivECvhOraHHkIzI1hyCDuku3A-7E4kgDF_vs0X6xwLC92SAhOj3TEDbSzZD1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_z-NpVziJXF-fIaXeK0f-FZBuMS6xlF8Czdrs70u61A&oe=6B05A32F"}, "display_name": "Potato Party: Hash It Out", "keywords": [], "long_description": "Welcome, friends, to POTATOPIA \u2014 where you can finally paint your mashterpiece.\n\nIn this quick-draw multiplayer game, it's YOU (the VR potato) against YOUR FRIENDS (iOS and Android potatoes), as they race to be the first to guess what you're drawing in three dimensions.\n\nUp to 8 players can join using the free mobile app on iOS and Android. Watch the VR potato draw on your device or on a stream, input custom prompts, make your guesses, and use special powers to foil your fellow future french fries!\n\nAs the VR potato, choose your medium \u2014 3D shapes, air-painting, or canvas drawing \u2014 to dazzle your fellow spuds with your artistic prowess.\n\nDraw your worst, guess your best \u2014 just don't eat the artist. Please.", "short_description": "Prepare to laugh when you and your friends gather (virtually or physically) for this quick-draw asymmetrical VR game! Be the artist in VR, or guess what's being drawn as one of 1-8 challengers with the free iOS/Android app. Just don't eat the artist."}]}, "developer_name": "Fanaticus XR", "developer_privacy_policy_url": "https://www.fanaticusxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fanaticus XR", "support_website_url": null, "website_url": "http://potatoparty.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
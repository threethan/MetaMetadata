scdn.com/v/t64.5771-25/39031391_488615832351606_8780358266402379255_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fToSnMavMHEQ7kNvwFGwt9a&_nc_oc=AdoP4siRQuB0AQB4Ch0aVR_6haen4i3ADprfRMKKghXPy2q8h8A2ojK1C9k6RrJnRUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0b09L_TDPYcrmGYnLJ1B0JFOzC5DhRq7zuNsAT_YRSbg&oe=69F7692F"}, {"file_name": "Screenshot_7.png", "id": "311764160408823", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566677_311764163742156_6354851173974657435_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51VzDSlerIMQ7kNvwEk0i0S&_nc_oc=Adr_gGDZwgmzf-dJ8bWMhvfTjGOmrOw4B4p-7DUECIUqsKpQfpAE5XCiBJIB502uMyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NHXJeecLgV4d2SixXrxw177dr9J5rvHeyo9V0GR1SAA&oe=69F73CFF"}, {"file_name": "Steam-Screenshot2.png", "id": "515575053121672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982660_515575056455005_5034961616916098855_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldgGVdqpXKAQ7kNvwF3VW8e&_nc_oc=Adpr08rUWORDIvkfAMWqWloI15Zj1ZznWx3nP6CY584MYN95J8cx-kOBChjXuqzGeAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zrAd7DwIwR4MvG1ZibDUgxnZH1VWyQMcPRNBhSgrsGA&oe=69F74BE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover (1).png", "id": "319098836717241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_319098840050574_1723902986571985662_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiRC0-Q7zHIQ7kNvwGDnLPr&_nc_oc=AdruM4NCW4cQyQdgz2WQdvReUNmfaRvNeBwxvfBZaa0Jr_Rnw5QHJGohOXWvODCCMwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mIKljOjtmcEyVZa4jaq39_XpKIz14WubBl3OkyyAvBQ&oe=69F75FAF"}, "display_name": "Potato Party: Hash It Out", "keywords": [], "long_description": "Welcome, friends, to POTATOPIA \u2014 where you can finally paint your mashterpiece.\n\nIn this quick-draw multiplayer game, it's YOU (the VR potato) against YOUR FRIENDS (iOS and Android potatoes), as they race to be the first to guess what you're drawing in three dimensions.\n\nUp to 8 players can join using the free mobile app on iOS and Android. Watch the VR potato draw on your device or on a stream, input custom prompts, make your guesses, and use special powers to foil your fellow future french fries!\n\nAs the VR potato, choose your medium \u2014 3D shapes, air-painting, or canvas drawing \u2014 to dazzle your fellow spuds with your artistic prowess.\n\nDraw your worst, guess your best \u2014 just don't eat the artist. Please.", "short_description": "Prepare to laugh when you and your friends gather (virtually or physically) for this quick-draw asymmetrical VR game! Be the artist in VR, or guess what's being drawn as one of 1-8 challengers with the free iOS/Android app. Just don't eat the artist."}]}, "developer_name": "Fanaticus XR", "developer_privacy_policy_url": "https://www.fanaticusxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fanaticus XR", "support_website_url": null, "website_url": "http://potatoparty.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "4854591554633040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_777975326212114_2622217636817396423_n.png?stp=dst-png_s360x360&_nc_cat=105
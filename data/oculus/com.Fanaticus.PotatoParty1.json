uI5Nh7SDcRKfINe3RNDBjtgBTEYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzie8kynpq01q2X5Lf1l_ICks8kf4Rny3HWncLLkJJwQg&oe=69B2AEFF"}, {"file_name": "Steam-Screenshot2.png", "id": "515575053121672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982660_515575056455005_5034961616916098855_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8a6rk_Qop8Q7kNvwFPK4jq&_nc_oc=AdkAMpGjZyBzVm4F6VDm-Bo2QcxYBpXbEOq-3u47RT1KQRFmPFKJOwXRHYgnRWmJVcM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwT3HTwsw-15ISi0rnrY-W1I9yocPlEB_GMlFdM3T8uLQ&oe=69B2BDE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "297797048751157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974493_297797052084490_301542806537151089_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwVul9xnbx8Q7kNvwGOGL9S&_nc_oc=AdlwRqp1tQQ0Bb4a9NJQfCcSqGS8LE8ZbcOqHq4k2PYNcjFEfbJ6D_HZSVWSt0pgaKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8IESwNqMFZdooK9mGjuPXI-QjiUqG-NdUeycGVaTNMA&oe=69B2CF31"}, "display_name": "Potato Party: Hash It Out", "keywords": [], "long_description": "Welcome, friends, to POTATOPIA \u2014 where you can finally paint your mashterpiece.\n\nIn this quick-draw multiplayer game, it's YOU (the VR potato) against YOUR FRIENDS (iOS and Android potatoes), as they race to be the first to guess what you're drawing in three dimensions.\n\nUp to 8 players can join using the free mobile app on iOS and Android. Watch the VR potato draw on your device or on a stream, input custom prompts, make your guesses, and use special powers to foil your fellow future french fries!\n\nAs the VR potato, choose your medium \u2014 3D shapes, air-painting, or canvas drawing \u2014 to dazzle your fellow spuds with your artistic prowess.\n\nDraw your worst, guess your best \u2014 just don't eat the artist. Please.", "short_description": "Prepare to laugh when you and your friends gather (virtually or physically) for this quick-draw asymmetrical VR game! Be the artist in VR, or guess what's being drawn as one of 1-8 challengers with the free iOS/Android app. Just don't eat the artist."}]}, "developer_name": "Fanaticus XR", "developer_privacy_policy_url": "https://www.fanaticusxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fanaticus XR", "support_website_url": null, "website_url": "http://potatoparty.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "225521983125352"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "CANCELLED", "id": "3095726030661207"}, {"status": "PUBLISHED", "id": "352912733075911"}, {"status": "PUBLISHED", "id": "571911057427525"}]}, "baseline_offer": {"id": "571911057427525"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1635203280, "status": "CANCELLED", "id": "3095726030661207"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4955128081243946", "version": "1.00.4"}, "id": "291734968999877", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3955311561225608", "is_concept": false, "latest_released
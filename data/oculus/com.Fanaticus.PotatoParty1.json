_OClab.png", "id": "368383651381546", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982538_368383654714879_8726600682362520434_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MiPCDVl7scQ7kNvwFp_Iff&_nc_oc=AdqBsxv0wh5uwFQooAt-tQMoo2ZDAXyL5gcy_8WDXAHpLCaxS-drxdqLRrsnhJf7_Js&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68ITPQna9_JfGN1ecCTxT0OX05JV0n_A6Gq0kDi0Jy3g&oe=6A11D081"}]}, "id": "744865416066777", "locale": "en_US", "screenshots": [{"file_name": "Steam-Screenshot1.png", "id": "3007686869515473", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984470_3007686872848806_4397603710793672857_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKVScBky1e4Q7kNvwHbu9sE&_nc_oc=Adr0b7GhXX0O2QegNBze2-comNHoUfkq2nVpDLPK_OWcFCRhTtPASajG22ueEr-wRXo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61-Ekrqltk4I55iwPtVVSfWU3PBBAbOW1EIthTST542w&oe=6A11BAF8"}, {"file_name": "Thumbnail.png", "id": "1388801444836746", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036645_1388801448170079_5679514271888723200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfYBczhuOeQQ7kNvwHrCbEa&_nc_oc=AdoZ_ws2FIFTzrFlgi4mwCuDh_kiXybnf59I_ByXuHWSxS6PP-srhBHcIz7yr2JZO1k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pYE9sKpyYP-KzkwupcbdTvVMJ6RyC7qeitciuOK4bAA&oe=6A11BFE2"}, {"file_name": "Screenshot_9.png", "id": "488615829018273", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031391_488615832351606_8780358266402379255_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jTfV4M_sb8Q7kNvwELWJ-5&_nc_oc=AdoKU3ikl6WkGx0zU55mqOL07ba2Q2rD-HMezN32TujzQKGtUAmmuPquOZxXcJAt2hQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41QXuXNYk7tCmic05VZn_hmPzyNxf8qOVCgAIA7SR3Tg&oe=6A11C72F"}, {"file_name": "Screenshot_7.png", "id": "311764160408823", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57566677_311764163742156_6354851173974657435_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVFAgjgSX_kQ7kNvwH3e6iN&_nc_oc=AdpPgEXQMD2oap9o6l2tZIm1JWafZgjhZZeyB4Z8Cz0SZhYyocwthGQTfKal6wm1EYs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55IBxMwNY9pqK8iuuseu7jDUmZvL4gMfc3Ws9qPgEMFA&oe=6A119AFF"}, {"file_name": "Steam-Screenshot2.png", "id": "515575053121672", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982660_515575056455005_5034961616916098855_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jN-nbkgRZwQ7kNvwGNNkv9&_nc_oc=AdrbtsIiNRYZP7pO9Fx9zsCs_k3Tx8xlW0Ctt9es84OMQmg0cgYpYAJ1-q2ydmupNro&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CYFet23aLHs1Ig6mNQT-sdknnfBJhmSBPtnYQZ0Pdiw&oe=6A11A9E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "297797048751157", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974493_297797052084490_301542806537151089_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcZ-qCHptHEQ7kNvwFF7sJL&_nc_oc=AdoVWHYfXUjPyTwgN40DSmyS1UpH9UaMppWr7tPgxphH6nD-F30lwkHouLIB7O70tOA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ad0eHPVo-KHn6rCipHa2XXwpHOZpgWXBCAQ99R3QORQ&oe=6A11BB31"}, "display_name": "Potato Party: Hash It Out", "keywords": [], "long_description": "Welcome, friends, to POTATOPIA \u2014 where you can finally paint your mashterpiece.\n\nIn this quick-draw multiplayer game, it's YOU (the VR potato) against YOUR FRIENDS (iOS and Android potatoes), as they race to be the first to guess what you're drawing in three dimensions.\n\nUp to 8 players can join using the free mobile app on iOS and Android. Watch the VR potato draw on your device or on a stream, input custom prompts, make your guesses, and use special powers to foil your fellow future french fries!\n\nAs the VR potato, choose your medium \u2014 3D shapes, air-painting, or canvas drawing \u2014 to dazzle your fellow spuds with your artistic prowess.\n\nDraw your worst, guess your best \u2014 just don't eat the artist. Please.", "short_description": "Prepare to laugh when you and your friends gather (virtually or physically) for this quick-draw asymmetrical VR game! Be the artist in VR, or guess what's being drawn as one of 1-8 challengers with the free iOS/Android app. Just don't eat the artist."}]}, "developer_name": "Fanaticus XR", "developer_privacy_policy_url": "https://www.fanaticusxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fanaticus XR", "support_website_url": null, "website_url": "http://potatoparty.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "225521983125352"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "CANCELLED", "id": "3095726030661207"}, {"status": "PUBLISHED", "id": "352912733075911"}, {"status": "PUBLISHED", "id": "571911057427525"}]}, "baseline_offer": {"id": "571911057427525"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1635203280, "status": "CANCELLED", "id": "3095726030661207"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4955128081243946", "version": "1.00.4"}, "id": "291734968999877", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": 
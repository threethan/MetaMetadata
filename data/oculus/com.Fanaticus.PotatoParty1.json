GFXCB7NesU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb2LdIe8_26lMozm6gJbZOTHcfoXsskxitrQqCLVxo2g&oe=6AFC6AE2"}, {"file_name": "Screenshot_9.png", "id": "488615829018273", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031391_488615832351606_8780358266402379255_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkFZXC_kKA0Q7kNvwEPVL_P&_nc_oc=AdqId_3IlliXO_kimGMD8MIZxCoec15kGTwrZckKsaT3C1kEm_SDS98g6AvPwGsunfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY7LFbl25gYQm3D6hs8GqF2rvMlWitYpK1lG2k7LD1tw&oe=6AFC722F"}, {"file_name": "Screenshot_7.png", "id": "311764160408823", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566677_311764163742156_6354851173974657435_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78xPd1EleWoQ7kNvwGeKoBy&_nc_oc=Adr9S0emFApH91bkF6UKLMkPcAO0sbr-y_EetOyUR9IVcqf1iyWRBN5QijXZ8_33Ivc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRUcO46Dvq_dIvh9r5Cbxf3cD8dagn3ChBlxd9MPR3xQ&oe=6AFC7E3F"}, {"file_name": "Steam-Screenshot2.png", "id": "515575053121672", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982660_515575056455005_5034961616916098855_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ojg8BjgApdwQ7kNvwGfpe4I&_nc_oc=Adr2cq8JFaZZvhp0mlzpIkXRiXfHBQqj_liflNlCoVUWVgd3EZ13Gbv7zmB-LVl-QiI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj7b29CSre2sSW6k0G-wl7ee1nTxGnrJfZV7lJSswvBg&oe=6AFC8D26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover (1).png", "id": "319098836717241", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974671_319098840050574_1723902986571985662_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smuQiNXrFoMQ7kNvwEtP9gH&_nc_oc=AdrRcCyS0NsCP3SMrf2d476gbDBtukyxydAM3gONchFx-99ej6mxuPq2ZW-ELjBtz_g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAIMwMivNkrg-lkYhcySWI8pshheJr3_P9UwQA69cQrA&oe=6AFC68AF"}, "display_name": "Potato Party: Hash It Out", "keywords": [], "long_description": "Welcome, friends, to POTATOPIA \u2014 where you can finally paint your mashterpiece.\n\nIn this quick-draw multiplayer game, it's YOU (the VR potato) against YOUR FRIENDS (iOS and Android potatoes), as they race to be the first to guess what you're drawing in three dimensions.\n\nUp to 8 players can join using the free mobile app on iOS and Android. Watch the VR potato draw on your device or on a stream, input custom prompts, make your guesses, and use special powers to foil your fellow future french fries!\n\nAs the VR potato, choose your medium \u2014 3D shapes, air-painting, or canvas drawing \u2014 to dazzle your fellow spuds with your artistic prowess.\n\nDraw your worst, guess your best \u2014 just don't eat the artist. Please.", "short_description": "Prepare to laugh when you and your friends gather (virtually or physically) for this quick-draw asymmetrical VR game! Be the artist in VR, or guess what's being drawn as one of 1-8 challengers with the free iOS/Android app. Just don't eat the artist."}]}, "developer_name": "Fanaticus XR", "developer_privacy_policy_url": "https://www.fanaticusxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fanaticus XR", "support_website_url": null, "website_url": "http://potatoparty.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
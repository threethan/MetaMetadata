ZSaXPiwKPJMQ7kNvwGqLn8m&_nc_oc=Adn7Kuj60fgtMx21F6pBs5EcF3x7u7L5ID-UcifhiUD358ync-LMJdvKQE5HaWAV4_Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfssipSg-WjwbQS2nUq1zW6xudIGhAW-mcm4sHHcjMB_vw&oe=69A573EF"}, {"file_name": "Screenshot_7.png", "id": "311764160408823", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566677_311764163742156_6354851173974657435_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3Owq1ZTAxAQ7kNvwGSCrx9&_nc_oc=AdmT1mH23krJPX8eWpq1oQX9Sur-r9j-gK-A99O1HHGdCbxSiqwHw81uEzHtRAiEUg4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftIwWG1_W10knNgAoRxyjHfSyvB7CseHIYyydLggYVjLA&oe=69A57FFF"}, {"file_name": "Steam-Screenshot2.png", "id": "515575053121672", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982660_515575056455005_5034961616916098855_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJIW84OfO_sQ7kNvwHyOez_&_nc_oc=AdmYcqWUQjZe1koJpAwQVdANbGOGlskPyGkX7hP4KPuwt3OEkjpFDuZf_cHiJHIdI0Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftbKpBU2pf-RA_O9G_GRCGKCqW2KXTCuZm9tjobeOlMRw&oe=69A58EE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover (1).png", "id": "319098836717241", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974671_319098840050574_1723902986571985662_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NSKAcVERTgQ7kNvwGQqXMH&_nc_oc=AdnGoJWN14pyKpinOqY0aRW3voHjHZBXQeL-YD_15aAC04Uc-QiKM2nqEc361Pg_XF0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfusRh1X2diOgUqPEY0Ckvm311_kkipzfHqjrM2zMLgvSg&oe=69A56A6F"}, "display_name": "Potato Party: Hash It Out", "keywords": [], "long_description": "Welcome, friends, to POTATOPIA \u2014 where you can finally paint your mashterpiece.\n\nIn this quick-draw multiplayer game, it's YOU (the VR potato) against YOUR FRIENDS (iOS and Android potatoes), as they race to be the first to guess what you're drawing in three dimensions.\n\nUp to 8 players can join using the free mobile app on iOS and Android. Watch the VR potato draw on your device or on a stream, input custom prompts, make your guesses, and use special powers to foil your fellow future french fries!\n\nAs the VR potato, choose your medium \u2014 3D shapes, air-painting, or canvas drawing \u2014 to dazzle your fellow spuds with your artistic prowess.\n\nDraw your worst, guess your best \u2014 just don't eat the artist. Please.", "short_description": "Prepare to laugh when you and your friends gather (virtually or physically) for this quick-draw asymmetrical VR game! Be the artist in VR, or guess what's being drawn as one of 1-8 challengers with the free iOS/Android app. Just don't eat the artist."}]}, "developer_name": "Fanaticus XR", "developer_privacy_policy_url": "https://www.fanaticusxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fanaticus XR", "support_website_url": null, "website_url": "http://potatoparty.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "4854591554633040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982660_777975326212114_2622217636817396423_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAGT6hChyvYQ7kNvwFZ3R3r&_nc_oc=AdlMx8SeOPBrTugI6ZI5usQjXnjrIi1TDi46NhIKJpFC5qwhWMQpcZjIyz9X3RzpzRc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculus
png", "id": "488615829018273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031391_488615832351606_8780358266402379255_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lvFyrjxyfwQ7kNvwGpVtSa&_nc_oc=AdqL2RWYlH5C9NpVDSu3XE1F0LP8gas3VBHHSnF78C6NBs_tc-eSnj4gjEAeiKCTIZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRL4G4waPwb3eALsi8aK4q5sGprxVZL16rZ5QmUm_v_oA&oe=6B0C7C6F"}, {"file_name": "Screenshot_7.png", "id": "311764160408823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566677_311764163742156_6354851173974657435_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAeJCHJNI84Q7kNvwFfCaGW&_nc_oc=AdpBKqujyq8veZ3_8mFkaloDzATes4VFc2-TuqKhatyQApyCP8J7aVi-z2KgUiCvDSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrralW_r1oIKRvTmGtE97MKrKIAxw9Lh7VBCNV0aWdIQ&oe=6B0C503F"}, {"file_name": "Steam-Screenshot2.png", "id": "515575053121672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982660_515575056455005_5034961616916098855_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykqrnuM_xocQ7kNvwHiZK3p&_nc_oc=AdqiBAc3gGp7CLu8YcZ26JioJts-BqWe8gYcHtQUAfr939Kpo5Jb31NJOHiKRb0vHXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPVq23JjQx6-TQHUnyjlE4Kt4VNt0Nh4krBHvJu6yBZA&oe=6B0C5F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "297797048751157", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974493_297797052084490_301542806537151089_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUQZ6VEQNgwQ7kNvwHW4Bzr&_nc_oc=AdoDSTZZgGp2y59a_-6PuOn49mwpwzKvv_N_eILW6EKqng7WCMV4VA3jTvUWiSHpByI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMg0E_5UHoySmJpleww9PEWu7NjZdCbWEhD6XNSRAaMg&oe=6B0C7071"}, "display_name": "Potato Party: Hash It Out", "keywords": [], "long_description": "Welcome, friends, to POTATOPIA \u2014 where you can finally paint your mashterpiece.\n\nIn this quick-draw multiplayer game, it's YOU (the VR potato) against YOUR FRIENDS (iOS and Android potatoes), as they race to be the first to guess what you're drawing in three dimensions.\n\nUp to 8 players can join using the free mobile app on iOS and Android. Watch the VR potato draw on your device or on a stream, input custom prompts, make your guesses, and use special powers to foil your fellow future french fries!\n\nAs the VR potato, choose your medium \u2014 3D shapes, air-painting, or canvas drawing \u2014 to dazzle your fellow spuds with your artistic prowess.\n\nDraw your worst, guess your best \u2014 just don't eat the artist. Please.", "short_description": "Prepare to laugh when you and your friends gather (virtually or physically) for this quick-draw asymmetrical VR game! Be the artist in VR, or guess what's being drawn as one of 1-8 challengers with the free iOS/Android app. Just don't eat the artist."}]}, "developer_name": "Fanaticus XR", "developer_privacy_policy_url": "https://www.fanaticusxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fanaticus XR", "support_website_url": null, "website_url": "http://potatoparty.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "225521983125352"}}]}, "scheduled_offers": {"coun
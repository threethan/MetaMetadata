scdn.com/v/t64.5771-25/39031391_488615832351606_8780358266402379255_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQEJTdM0SaoQ7kNvwFh-yfL&_nc_oc=AdrY7HncgNpzqURNF7GEHvu5ISRQGbeKJQpqNS6vd-oIQ9cdpfKdQE97XGgzrccb0I4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtovf3vK5cV15SbsF31CFXhPI4HUQQXvWjXt4CPkHavg&oe=6A73562F"}, {"file_name": "Screenshot_7.png", "id": "311764160408823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566677_311764163742156_6354851173974657435_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNnC2k1I3IMQ7kNvwFZhiPZ&_nc_oc=AdpCKTmtX-P0TlgI-pJtqvkw5LAx6778k4-VHo1zBYpA8uiJu1vYh1wFDo5HBPVhzSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxuiYCjZlovB9qDkitjZm9j5RtRqceDG_OFpQczqPZMg&oe=6A7329FF"}, {"file_name": "Steam-Screenshot2.png", "id": "515575053121672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982660_515575056455005_5034961616916098855_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3ENJ3DpKvcQ7kNvwHeUfI1&_nc_oc=AdpdkGOShTO4aQUx-6e-D6ErFW-8Ex0oCTOey4r5WL-bJURytJFyVxHluz22nGHxb-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFki9CZOnJJHgSU4bO9ACDOGwdnODBnRQyuoKGEHkVxTg&oe=6A7338E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover (1).png", "id": "319098836717241", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_319098840050574_1723902986571985662_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACdo2n54Oc8Q7kNvwF7Q5Q1&_nc_oc=AdpnjwJZZI5nLQovsOwHpxBasy_qb11Tqh7t8Ed6jhzoj5lbcXJqFTQYiyY2CiwEpDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW1sRF9D-9G_MO8LhvMdssfAr5BDQiXdMw6HKzrLwPbg&oe=6A734CAF"}, "display_name": "Potato Party: Hash It Out", "keywords": [], "long_description": "Welcome, friends, to POTATOPIA \u2014 where you can finally paint your mashterpiece.\n\nIn this quick-draw multiplayer game, it's YOU (the VR potato) against YOUR FRIENDS (iOS and Android potatoes), as they race to be the first to guess what you're drawing in three dimensions.\n\nUp to 8 players can join using the free mobile app on iOS and Android. Watch the VR potato draw on your device or on a stream, input custom prompts, make your guesses, and use special powers to foil your fellow future french fries!\n\nAs the VR potato, choose your medium \u2014 3D shapes, air-painting, or canvas drawing \u2014 to dazzle your fellow spuds with your artistic prowess.\n\nDraw your worst, guess your best \u2014 just don't eat the artist. Please.", "short_description": "Prepare to laugh when you and your friends gather (virtually or physically) for this quick-draw asymmetrical VR game! Be the artist in VR, or guess what's being drawn as one of 1-8 challengers with the free iOS/Android app. Just don't eat the artist."}]}, "developer_name": "Fanaticus XR", "developer_privacy_policy_url": "https://www.fanaticusxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Fanaticus XR", "support_website_url": null, "website_url": "http://potatoparty.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "4854591554633040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982660_777975326212114_2622217636817396423_n.png?stp=dst-png_s360x360&_nc_cat=105
ps://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974841_352326989180470_8013296384304375991_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vz7E3u8zjEoQ7kNvwFgkHQU&_nc_oc=AdpZEHnDQW-XNBt6XKZG9A5j3OUDjHMePCkTvrfbB6cg-d56erhNRJ5msiLfhwUWFiM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7HVk7XtVNtiCAPuTc6u79H0Di4rxH461UC4r1Xm3bNA&oe=6A7DABE7"}, {"file_name": "Cat-pack.png", "id": "1366881923662436", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982699_1366881926995769_8928939619934386809_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5ameVzBSCIQ7kNvwF7Z2ml&_nc_oc=AdpwefaP5iMFX4PuKR0E9ZZrKJJUz_oxVxF98MuUQsIduRllz7SRuHhl4GPUE08FCXc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGONWMj_gPDnXdxZUWgUnyIi_UoNBHK0TNJ_odNrTEhnw&oe=6A7DA145"}, {"file_name": "shot-mine-1.png", "id": "414227042979761", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031496_414227046313094_4141483907284156248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etujZwhyqAYQ7kNvwGT-eBb&_nc_oc=AdoKxeT-fe7O9d1oXfKG5xUeVDSeZjzIuK2mh9w9Iqa2bKCw96_befwiu3PwazCUydY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5g3fWQlxsGPfGpLfVE1xTiPVtZihctuAJCuHYHXR-bw&oe=6A7DB85D"}, {"file_name": "Level-Select.png", "id": "120573576611631", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982648_120573579944964_2284771346909181658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzMjgQfpMcAQ7kNvwExjoOn&_nc_oc=AdrQy54kTIEr7hE5I_dVKZrg8MXD__szsKr9ei8i5tJY_n2T2PPjl3cXhEqjSg0K1Ao&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8yufwhPnspNO0UWYH9YwPSMCACsdM3VLAy3oivFJFPg&oe=6A7DAE54"}, {"file_name": "Options-Screen.png", "id": "926423671427692", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035425_926423674761025_406414394539326364_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxFe-piDMF0Q7kNvwGg34N0&_nc_oc=Adrf3auUt-bbiaFSFCufWzfVuoHhvX4SqX_dclleNr22ltgvJ8OOvt-AUWDGi_e_Uco&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1oBbJjICbjBYPwyGZKI2mMQqkwMrL6gWX3238ubZ0Dg&oe=6A7DAA99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumb2.png", "id": "433609974614894", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031493_433609977948227_2942055885985246762_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eshc5aSBbHcQ7kNvwE0oYdj&_nc_oc=AdpCL_U4QPw9u9cipDCkIjjS9_66Al37e0k5s6Y18yc42WfZSVZd2fQHdwGCKGncGTA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVhsypTYfrlrnAGUphioSEXAhdQrMMOGKPycRv6A9fBw&oe=6A7DC927"}, "display_name": "Roll or Die!", "keywords": [], "long_description": "In Roll or Die! you are in a giant Hamster Ball that you spin with your hands, and you need to Escape each level as fast as you can, grabbing as many gems and stars as you can... and hopefully encountering as few cats as you can! \ud83d\ude09\n\nEach Level Has 3 Stars you can earn: \n- One star for collecting at least 1 Gem.\n- One star for collecting at least 1 Star.\n- One star for collecting *all* Stars and Gems.\n\nSome gems have side effects, so pay attention to their colors. (Specifically, blue gems will give you a speed boost -- other gems are planned for future releases.)\n\nSome levels also have giant scary cats (also in hamster balls \ud83d\ude40) -- and if they notice you, they will come say \"hi\" to you, ...and probably kill you by accident. So... you might want to run from them!!\n\nNote: Roll or Die! was first developed as an entry to the the very first Metafest VR Game Jam, and it did so well that I'm going to be actively developing it, by fixing bugs and adding content.  Stay tuned!", "short_description": "Like Marble Madness or Super Monkey Ball, but you're in a giant VR hamster ball! -- Collect those stars and gems to get the best times for each level!\n(More levels coming soon!)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BrainSlugs83/
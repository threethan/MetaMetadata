me": "Options-Screen.png", "id": "926423671427692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035425_926423674761025_406414394539326364_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFTSCiO1ir4Q7kNvwFUm2p4&_nc_oc=AdqtVYqvCwL4yoPIXRTnP-Av4rmJALm-MuG5LQ4CnfL04cctLf0OvcR6r9yTBKdNoS4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwgQScb8w_O39ok86fu1hrB5-Na8_39Ylfhs_V8_JqDw&oe=6B0B2B99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumb2.png", "id": "433609974614894", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031493_433609977948227_2942055885985246762_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zry6yZI0yisQ7kNvwGYNGhX&_nc_oc=AdpCZeCmKvvePNTwy1VOyK6PxfDON_3LjQW_LQiZ3qTz4tuc-b1H9jOPv6GoARPxS5w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRH9GtkT_vDRpsAIIfiUu8cyvgkEe66Jeat_joDmkVmQ&oe=6B0B11E7"}, "display_name": "Roll or Die!", "keywords": [], "long_description": "In Roll or Die! you are in a giant Hamster Ball that you spin with your hands, and you need to Escape each level as fast as you can, grabbing as many gems and stars as you can... and hopefully encountering as few cats as you can! \ud83d\ude09\n\nEach Level Has 3 Stars you can earn: \n- One star for collecting at least 1 Gem.\n- One star for collecting at least 1 Star.\n- One star for collecting *all* Stars and Gems.\n\nSome gems have side effects, so pay attention to their colors. (Specifically, blue gems will give you a speed boost -- other gems are planned for future releases.)\n\nSome levels also have giant scary cats (also in hamster balls \ud83d\ude40) -- and if they notice you, they will come say \"hi\" to you, ...and probably kill you by accident. So... you might want to run from them!!\n\nNote: Roll or Die! was first developed as an entry to the the very first Metafest VR Game Jam, and it did so well that I'm going to be actively developing it, by fixing bugs and adding content.  Stay tuned!", "short_description": "Like Marble Madness or Super Monkey Ball, but you're in a giant VR hamster ball! -- Collect those stars and gems to get the best times for each level!\n(More levels coming soon!)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BrainSlugs83/Legal/blob/main/Roll-or-Die/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "N/A", "support_website_url": null, "website_url": "https://linktr.ee/BrainSlugs83", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1180547689446789"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "489170730596308"}, {"status": "PUBLISHED", "id": "467331824535445"}]}, "baseline_offer": {"id": "467331824535445"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "489170730596308"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3787093478006613", "version": "3.14159"}, "id": "3702364759846850", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3556030631112900
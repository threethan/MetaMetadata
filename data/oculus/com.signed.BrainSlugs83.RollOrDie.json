ps://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974841_352326989180470_8013296384304375991_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ9f8HkyrrwQ7kNvwGfAJY8&_nc_oc=AdoeOHwDqZCjJVoqgXot_4qSHI6FjfJIhQSPq6_NTqEmX8A8M-8lMl8T65bPJ7PM7y0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bX2NDMf838Mn8uH1gQXGXu5RJLib-ulXwoABwHV-VPw&oe=6A395627"}, {"file_name": "Cat-pack.png", "id": "1366881923662436", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982699_1366881926995769_8928939619934386809_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YJsTtbd1JwQ7kNvwFcx0RA&_nc_oc=Adp3VLnKJnDTnGDfVXQ7VpFaEvfsZBxCIaZgxLhs1H22uCS_UmsI-R1g45NNujkSeQU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j9XJgjBVjuVp9sVSYaZWDlVh0CgcKICbqFv_jux7KIw&oe=6A394B85"}, {"file_name": "shot-mine-1.png", "id": "414227042979761", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031496_414227046313094_4141483907284156248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvoMGf82MoYQ7kNvwFINdPz&_nc_oc=AdoM9EdLEfwMpEcXCjUnhv7t6XkI2xOCGENs_gM_N-kXPScAFt-FGJ_LuTVGa3tgXEo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ScItfcH8OhM1SDO-aYkylEC1txgxHOJT650xzQ6tGBg&oe=6A39629D"}, {"file_name": "Level-Select.png", "id": "120573576611631", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982648_120573579944964_2284771346909181658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HisUCrOa4X4Q7kNvwEOmjpy&_nc_oc=AdoYpy0DXXCjmyWi5NyLLfRNVevVN0BV_7NKf4RUWFXqS3nSJgP3cjdbRN9_POxbFgw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DRXnZ6JSeliUUxxNvJMUO3cDU99CwzkJcVcxUHBH8FA&oe=6A395894"}, {"file_name": "Options-Screen.png", "id": "926423671427692", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035425_926423674761025_406414394539326364_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tAK5qv2-6IQ7kNvwGgqD7H&_nc_oc=Adp0wExYE1_TpwlTJKM9X9dimeeiW_vg8BzSPCdF85-uvOKTE9EvondPzoYT4IuL7tg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W8s4cTEuhpFeLJM6W8RYuPK0xHCOG10o8DUclQfqgpA&oe=6A3954D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumb2.png", "id": "433609974614894", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031493_433609977948227_2942055885985246762_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cY13tdTAET4Q7kNvwGfS_PR&_nc_oc=AdoAYgBWW73LkcwXksp2u2bAjgNg0zCqnY5R1MCUyoCh4I0JxFTlFO_ncCJDU465JrY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bjx70mJEvDF4wZQehR3FzLg1A9dikRqrUXJrn16kSXg&oe=6A393B27"}, "display_name": "Roll or Die!", "keywords": [], "long_description": "In Roll or Die! you are in a giant Hamster Ball that you spin with your hands, and you need to Escape each level as fast as you can, grabbing as many gems and stars as you can... and hopefully encountering as few cats as you can! \ud83d\ude09\n\nEach Level Has 3 Stars you can earn: \n- One star for collecting at least 1 Gem.\n- One star for collecting at least 1 Star.\n- One star for collecting *all* Stars and Gems.\n\nSome gems have side effects, so pay attention to their colors. (Specifically, blue gems will give you a speed boost -- other gems are planned for future releases.)\n\nSome levels also have giant scary cats (also in hamster balls \ud83d\ude40) -- and if they notice you, they will come say \"hi\" to you, ...and probably kill you by accident. So... you might want to run from them!!\n\nNote: Roll or Die! was first developed as an entry to the the very first Metafest VR Game Jam, and it did so well that I'm going to be actively developing it, by fixing bugs and adding content.  Stay tuned!", "short_description": "Like Marble Madness or Super Monkey Ball, but you're in a giant VR hamster ball! -- Collect those stars and gems to get the best times for each level!\n(More levels coming soon!)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BrainSlugs83/
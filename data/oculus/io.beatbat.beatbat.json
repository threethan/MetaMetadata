{"data": {"node": {"__typename": "Application", "id": "25851784914426238", "organization": {"id": "899882569878080", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25851784914426238"}]}, "id": "854308374131258"}]}}, "firstRevision": {"nodes": [{"application": {"id": "25851784914426238", "release_date": 1767879900, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28749243301347037"}, "id": "1865768920721234"}]}}, "binary": null, "live_binary": null, "created_date": 1769856206, "id": "26196959749908751", "is_initial_release": false, "name_with_fallback": "v6", "pdp_metadata_with_fallback": {"version": 6, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26196970159907710"}, "release_status": "RELEASED", "id": "25851784914426238"}, "id": "26196970159907710", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25851784914426238", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1612531100166998"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1558790305192770", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Bat", "keywords": [], "long_description": "\ube44\ud2b8\uc5d0 \ub9de\ucdb0 \uc2a4\uc719\ud558\uc138\uc694!\n\uc601\uc6d0\ud788 \ubb34\ub8cc \ud50c\ub808\uc774.\n\n[\ud2b9\uc9d5]\n\u2022 \ub05d\uc5c6\ub294 \ucee4\ubba4\ub2c8\ud2f0 \ucf58\ud150\uce20\n\u2022 \uc644\uc804\ud55c \ub2e8\ub3c5 \uc2e4\ud589 VR\n\u2022 \ub9de\ucda4 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\n\u2022 \uc9c1\uad00\uc801\uc778 UI/UX\n\u2022 \uc990\uac70\uc6b4 \ud53c\ud2b8\ub2c8\uc2a4\n\n[\ud50c\ub808\uc774\ud558\ub294 \ubc95]\n\u2022 \ube44\ud2b8 \ub9de\ucd94\uae30: \uc74c\uc545\uc5d0 \ub9de\ucdb0 \ub0a0\uc544\uc624\ub294 \ub178\ud2b8\ub97c \uc2a4\ud2f1\uc73c\ub85c \ub9de\ucdb0\ubcf4\uc138\uc694.\n\u2022 \uc0c9\uc0c1 \uc77c\uce58: \uc2a4\ud2f1\uacfc \uac19\uc740 \uc0c9\uc758 \ub178\ud2b8\ub97c \ubca0\uc138\uc694.\n\u2022 \ubc29\ud5a5 \uc77c\uce58: \ud654\uc0b4\ud45c \ubc29\ud5a5\uc73c\ub85c \ubca0\uc138\uc694.\n\u2022 \uc790\uc720 \ubca0\uae30: \uacf5 \ubaa8\uc591 \ub178\ud2b8\ub294 \uc790\uc720\ub86d\uac8c \ubca0\uc138\uc694.\n\u2022 \ud68c\ud53c: \ud3ed\ud0c4\uc744 \ud53c\ud558\uace0, \ubcbd\uc5d0 \uba38\ub9ac\ub97c \ubd80\ub52a\ud788\uc9c0 \uc54a\ub3c4\ub85d \uc6c0\uc9c1\uc774\uc138\uc694.\n\n[\uc8fc\uc758]\n\u2022 13\uc138 \ubbf8\ub9cc \uc5b4\ub9b0\uc774\ub97c \ub300\uc0c1\uc73c\ub85c \ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\u2022 \ucda9\ubd84\ud55c \ud50c\ub808\uc774 \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uc138\uc694.\n\u2022 \ubc88\uca4d\uc774\ub294 \ube5b\uc5d0 \ubbfc\uac10\ud558\uac70\ub098 \ubc1c\uc791 \uacbd\ud5d8\uc774 \uc788\ub294 \uacbd\uc6b0, \uc758\uc0ac\uc640 \uba3c\uc800 \uc0c1\ub2f4\ud558\uc138\uc694.\n\u2022 \uc5b4\uc9c0\ub7ec\uc6c0, \uba54\uc2a4\uaebc\uc6c0, \ub208\uc758 \ud53c\ub85c \ub610\ub294 \ub2e4\ub978 \ubd88\ud3b8\ud568\uc744 \ub290\ub07c\uba74 \uc989\uc2dc \uac8c\uc784\uc744 \uc911\ub2e8\ud558\uc138\uc694.\n\n[\ucee4\ubba4\ub2c8\ud2f0 \ucf58\ud150\uce20 \uc774\uc6a9]\n\u2022 \ucee4\ubba4\ub2c8\ud2f0 \ucf58\ud150\uce20\ub294 BeatSaver(beatsaver.com)\uc758 API\ub97c \ud1b5\ud574 \uc81c\uacf5\ub429\ub2c8\ub2e4.\n\u2022 \uccab \uc2e4\ud589 \uc2dc \uc774\uc6a9\uc790\ub294 BeatSaver\uc758 \uc57d\uad00 \ubc0f \uc815\ucc45\uc5d0 \ub300\ud55c \ub3d9\uc758\ub97c \uc694\uccad\ubc1b\uc2b5\ub2c8\ub2e4.", "short_description": "\ube44\ud2b8\uc5d0 \ub9de\ucdb0 \uc2a4\uc719\ud558\uc138\uc694!\n\uc601\uc6d0\ud788 \ubb34\ub8cc \ud50c\ub808\uc774.\n\ub05d\uc5c6\ub294 \ucee4\ubba4\ub2c8\ud2f0 \ub9f5."}, {"images": {"nodes": [{"file_name": "TitleLogo-square.png", "id": "3329325973891950", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_3329325980558616_7126640779831874924_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_dTEx9O2sQQ7kNvwFYw7Ae&_nc_oc=Ado4ekGb35OokxJtdHvJwl4vyXy16vHdrnEs-ZMxmMSYiJSRkybawzmJmFu6RMFu3L8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ72cohe9qUgJeCcRlzG3QMuGDAaNOJaFVE76zfkkgwYQ&oe=6B01DF51"}, {"file_name": "AppCover-3000x900.png", "id": "2995463960648616", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_2995463963981949_8343157658001324427_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgnTTqkxQZkQ7kNvwGs6hZ-&_nc_oc=AdoZQByM-JPM0JPNLUQOUifeyg4wxYgc11vRYX8CyM89VekrQLpCn3oJVWiPO_FUA9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEVH3FKQZZcOlkOP67fWYB4orW8D-6pZJhcFe_7A0q2A&oe=6B01CA41"}, {"file_name": "AppCover-2560x1440.png", "id": "1939305093674481", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822737_1939305097007814_2113315898475978199_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKgdhHjabs8Q7kNvwFSQKf7&_nc_oc=AdoD0DkgqyBjInBso_ioYpdccTPZX241SciEdlcZ7106bhPw0Doipqd_yLQ38RgePnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTfE8iHH3iu023ss9BRU_pKOQsNU1DG8IIMrE2zUhmSg&oe=6B01B818"}, {"file_name": "AppCover-1440x1440.png", "id": "1415992689879189", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_1415992693212522_755785755843997449_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRwaTTcQuysQ7kNvwG5FtkU&_nc_oc=Adrlo5n0ca4xAhUzws2XRi
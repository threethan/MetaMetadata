1-25/499619145_1215850546880586_4290713283956200046_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6o6GGcArWkQ7kNvwH0rCVy&_nc_oc=Adm5wQZYoFYsKrOcspYle_5RItnOcasug2tW1GJHbleJfSZHC9Bs3kIwW9fEVfMB0ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvP7j37M_0Q2Ob67AYmzbaTZHnn6c5RTIEdBarVgR3d6w&oe=699AECC6"}, {"file_name": "ScreenShot-Gas Gas Gas-Tunnel.png", "id": "1679059916587933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_1679059919921266_3533990836652592688_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1DLD2QgybUQ7kNvwFVHJwR&_nc_oc=AdlX6SgrPiU0kX7P3tbcWHrg_-ZJGc6OEv_RrPV9Z64DCxNGKL_BfJ03aNl9JTCIUeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afso0aieSRhfN96KZfT39R6xp8l4UMYNwSaiayFbaEdrAQ&oe=699B0AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppCover-2560x1440.png", "id": "2067703980661887", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618103_2067703987328553_6089335288352987054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHF1T__IJvEQ7kNvwFpR8Us&_nc_oc=AdmLSMPEQ0b4wR6AKFj21rRhhfQ4fbedyXBCU9uVFks8xhbMNOMcKwGLC7rmO7EQtJM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu8-HtZjDuQ6bfmXkPz8E8lGloEnxzDU0D3MwC6G935lg&oe=699ADFAD"}, "display_name": "Beat Bat", "keywords": [], "long_description": "Swing to the beat!\nForever FREE to play.\n\n[Key Features]\n\u2022 Endless Community Content\n\u2022 True Standalone VR\n\u2022 Customizable Playstyle\n\u2022 Intuitive UI/UX\n\u2022 Fun Fitness\n\n[How to Play]\n\u2022 Hit the Beats: Hit the incoming notes with your sticks to the music.\n\u2022 Match the Color: Slash notes that match your stick's color.\n\u2022 Match the Direction: Slash in the direction of the arrows.\n\u2022 Slash Freely: Slash ball-shaped notes freely in any direction.\n\u2022 Dodge: Avoid bombs and avoid hitting your head on walls.\n\n[Caution]\n\u2022 Not intended for children under the age of 13.\n\u2022 Ensure you have enough play space.\n\u2022 If you are sensitive to flashing lights or have a history of seizures, consult a doctor first.\n\u2022 Stop playing immediately if you experience dizziness, nausea, eye strain, or other discomfort.\n\n[Community Content Usage]\n\u2022 Community content is accessed via the BeatSaver(beatsaver.com) API.\n\u2022 At first launch, users are prompted to accept BeatSaver's Terms and Policies.", "short_description": "Swing to the beat!\nForever FREE to play.\nEndless community maps."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beatbat.io/#/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "Beat Bat Studio", "support_website_url": null, "website_url": "https://beatbat.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26196970159907710"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617831_1415992693212522_755785755843997449_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9DbCgelv60Q7kNvwHLxn6R&_nc_oc=Adnpf-D8XE3zbF86paH3wQMUpNuWB74OKCDbKjBU1SyLcURBjgUqJl2WK3HLn1XUEGw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afux8ORjHlnE30W5EoLQI0zB4ml5hcXvYphEieLrEK5fKQ&oe=699AF0FC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Bat", "platform": "ANDROID_6DOF", "context_category": {"co
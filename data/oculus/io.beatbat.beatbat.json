U1B5eNJwKaQo216RvGnCW3eIY3FYubQSHkvNwuyyP5zaynhuNvitBG0qSaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9jQXffCf2XYyCmviB4IVLoDkNhAp-5EHLtovc8cGQoQ&oe=6B0DA988"}, {"file_name": "3 Beatmaps.png", "id": "1228068715911529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1228068719244862_3457893230332533051_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xZcvM4HT0UQ7kNvwEhIxwB&_nc_oc=Adrzo8dB0qzJSgRf4-gLO9n9H6AuiTCqODt_GmEGavaBMLLhpZBEJk2XwGviWeEkzjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSngYn2CJy-kRbuJMsh-oPOBtowz1aIwb9gZiQZd05r8Q&oe=6B0DB42B"}, {"file_name": "6 Palm Trees.png", "id": "1608213737297654", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619646_1608213740630987_1379449767891673171_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVxywZNF2ToQ7kNvwGvEYQQ&_nc_oc=AdpD3mcqYe5UUBH-myNb--sR5kGdVy7_-VJH9Gr5XuEtob6O6vxs9JZ_UN_jl07QMiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrbpqdPC_u2J1XMqN9_fssQCavmFf-3ympIKpBHJFUKQ&oe=6B0DBA6B"}, {"file_name": "Screenshot-Palm Trees-Piggy Bank.png", "id": "1567030467972829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_1567030471306162_7573225991804600108_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAaHu4WbmuwQ7kNvwHtDoJc&_nc_oc=AdrnjXAB-KoV5Jum1_Aj73Wb5sxrN8QCioTx8F763Sc8MWMKArLuCibwciRFT2aZXAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ89a9DD6_wzyFfsbWd4gZQjQep2r0QtjGBHWPJ8hYsKw&oe=6B0DC915"}, {"file_name": "Screenshot-Real or Lie.png", "id": "798478373211815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_798478376545148_295190902507972601_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl1xCKx4XCgQ7kNvwEBALRF&_nc_oc=Adq_mNhZpi9-luz13pLHj9RN87ubetu8ZeDgHM5F75lCHlg4FoHMcDw02UMQIsRlJxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzNs2AkMQO1RLlQZCl3lnroHytAZ-CMOe4C2VE4hsABQ&oe=6B0DBA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppCover-2560x1440.png", "id": "849236431064178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618442_849236441064177_3614078310531316436_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggVy5bwArukQ7kNvwEjAaHL&_nc_oc=AdrG3BOoP29eOUFt6DuGqtTDLYPSeg1Sq9NaOdolQkj2ESC4xLGr4UUIS1dyty34W1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtU1-YlLC4Dfoh76fBJ3tHU5EgGo4IFHW9D0BfqRRFKQ&oe=6B0DCA2C"}, "display_name": "Beat Bat", "keywords": [], "long_description": "BeatBat: Community Rhythm Game\n\nBeatBat is a free VR rhythm game that lets you enjoy countless beatmaps created by users worldwide, using just a headset.\nJump into the world of beats right now, without any PC hassle!\n\n[Key Features]\n\u2022 Endless Community Content: Experience countless creative maps crafted by a global community.\n\u2022 True Standalone VR: Download and play maps seamlessly with just your headset.\n\u2022 Varied Play Styles: Enjoy a fresh play every time with various items like sticks, stages, sculptures, notes, bombs, and walls.\n\u2022 Intuitive UI/UX: Easily manage profiles, search maps, save favorites, adjust settings, and more.\n\n[How to Play]\n\u2022 Hit the Beats: Hit the incoming notes with your sticks to the music.\n\u2022 Match the Color: Slash notes that match your stick's color.\n\u2022 Match the Direction: Slash in the direction of the arrows.\n\u2022 Slash Freely: Slash ball-shaped notes freely in any direction.\n\u2022 Dodge: Avoid bombs and avoid hitting your head on walls.\n\n[Caution]\n\u2022 Not intended for children under the age of 13.\n\u2022 Ensure you have enough play space.\n\u2022 If you are sensitive to flashing lights or have a history of seizures, consult a doctor first.\n\u2022 Stop playing immediately if you experience dizziness, nausea, eye strain, or other discomfort.\n\n[Community Content Usage]\n\u2022 Community content is accessed via the BeatSaver(beatsaver.com) API.\n\u2022 At first launch, users are prompted to accept BeatSaver's Terms and Policies.", "short_description": "BeatBat is a free VR rhythm game.\nEnjoy countless community maps with just a VR headset.\nDiscover, download, and play!"}, {"images": {"nodes": []}, "id": "1144076024592766", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Bat", "keywords": [], "long_description": "BeatBat: \ucee4\ubba4\ub2c8\ud2f0 \ub9ac\ub4ec \uac8c\uc784\n\nBeatBat\uc740 VR \ud5e4\ub4dc\uc14b\ub9cc\uc73c\ub85c \uc804 \uc138\uacc4 \uc720\uc800\ub4e4\uc774 \ub9cc\ub4e0 \uc218\ub9ce\uc740 \ube44\ud2b8\ub9f5\uc744 \uc990\uae38 \uc218 \uc788\ub294 \ubb34\ub8cc \ub9ac\ub4ec \uac8c\uc784\uc785\ub2c8\ub2e4.\n\ubc88\uac70\ub85c\uc6b4 PC \uc5f0\uacb0 \uc5c6\uc774, \uc9c0\uae08 \ubc14\ub85c \ube44\ud2b8\uc758 \uc138\uacc4\ub85c \ub6f0\uc5b4\ub4dc\uc138\uc694!\n\n[\uc8fc\uc694 \ud2b9\uc9d5]\n\u2022 \ub05d\uc5c6\ub294 \ucee4\ubba4\ub2c8\ud2f0 \ucf58\ud150\uce20: \uae00\ub85c\ubc8c \ucee4\ubba4\ub2c8\ud2f0\uac00 \uc81c\uc791\ud55c \uc218\ub9ce\uc740 \ucc3d\uc758\uc801\uc778 \ub9f5\uc744 \uacbd\ud5d8\ud558\uc138\uc694.\n\u2022 \uc644\uc804\ud55c \ub2e8\ub3c5 \uc2e4\ud589 VR: \ud5e4\ub4dc\uc14b \ud558\ub098\ub85c \ub9f5 \ub2e4\uc6b4\ub85c\ub4dc\ubd80\ud130 \ud50c\ub808\uc774\uae4c\uc9c0 \ub9e4\ub044\ub7fd\uac8c \uac00\ub2a5\ud569\ub2c8\ub2e4.\n\u2022 \ub2e4\ucc44\ub85c\uc6b4 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c: \uc2a4\ud2f1, \ubb34\ub300, \uc870\uac01\uc0c1, \ub178\ud2b8, \ud3ed\ud0c4, \ubcbd \ub4f1 \ub2e4\uc591\ud55c \uc544\uc774\ud15c\uc73c\ub85c \ub9e4\ubc88 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\ub97c \uc990\uae30\uc138\uc694.\n\u2022 \uc9c1\uad00\uc801\uc778 UI/UX: \ud504\ub85c\ud544 \uad00\ub9ac, \ub9f5 \uac80\uc0c9, \uc990\uaca8\ucc3e\uae30, \uc124\uc815 \ub4f1\uc744 \uc27d\uac8c \uc774\uc6a9\ud558\uc138\uc694.\n\n[\ud50c\ub808\uc774\ud558\ub294 \ubc95]\n\u2022 \ube44\ud2b8 \ub9de\ucd94\uae30: \uc74c\uc545\uc5d0 \ub9de\ucdb0 \ub0a0\uc544\uc624\ub294 \ub178\ud2b8\ub97c \uc2a4\ud2f1\uc73c\ub85c \ub9de\ucdb0\ubcf4\uc138\uc694.\n\u2022 \uc0c9\uc0c1 \uc77c\uce58: \uc2a4\ud2f1\uacfc \uac19\uc740 \uc0c9\uc758 \ub178\ud2b8\ub97c \ubca0\uc138\uc694.\n\u2022 \ubc29\ud5a5 \uc77c\uce58: \ud654\uc0b4\ud45c \ubc29\ud5a5\uc73c\ub85c \ubca0\uc138\uc694.\n\u2022 \uc790\uc720 \ubca0\uae30: \uacf5 \ubaa8\uc591 \ub178\ud2b8\ub294 \uc790\uc720\ub86d\uac8c \ubca0\uc138\uc694.\n\u2022 \ud68c\ud53c: \ud3ed\ud0c4\uc744 \ud53c\ud558\uace0, \ubcbd\uc5d0 \uba38\ub9ac\ub97c \ubd80\ub52a\ud788\uc9c0 \uc54a\ub3c4\ub85d \uc6c0\uc9c1\uc774\uc138\uc694.\n\n[\uc8fc\uc758]\n\u2022 13\uc138 \ubbf8\ub9cc \uc5b4\ub9b0\uc774\ub97c \ub300\uc0c1\uc73c\ub85c \ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\u2022 \ucda9\ubd84\ud55c \ud50c\ub808\uc774 \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uc138\uc694.\n\u2022 \ubc88\uca4d\uc774\ub294 \ube5b\uc5d0 \ubbfc\uac10\ud558\uac70\ub098 \ubc1c\uc791 \uacbd\ud5d8\uc774 \uc788\ub294 \uacbd\uc6b0, \uc758\uc0ac\uc640 \uba3c\uc800 \uc0c1\ub2f4\ud558\uc138\uc694.\n\u2022 \uc5b4\uc9c0\ub7ec\uc6c0, \uba54\uc2a4\uaebc\uc6c0, \ub208\uc758 \ud53c\ub85c \ub610\ub294 \ub2e4\ub978 \ubd88\ud3b8\ud568\uc744 \ub290\ub07c\uba74 \uc989\uc2dc \uac8c\uc784\uc744 \uc911\ub2e8\ud558\uc138\uc694.\n\n[\ucee4\ubba4\ub2c8\ud2f0 \ucf58\ud150\uce20 \uc774\uc6a9]\n\u2022 \ucee4\ubba4\ub2c8\ud2f0 \ucf58\ud150\uce20\ub294 BeatSaver(beatsaver.com)\uc758 API\ub97c \ud1b5\ud574 \uc81c\uacf5\ub429\ub2c8\ub2e4.\n\u2022 \uccab \uc2e4\ud589 \uc2dc \uc774\uc6a9\uc790\ub294 BeatSaver\uc758 \uc57d\uad00 \ubc0f \uc815\ucc45\uc5d0 \ub300\ud55c \ub3d9\uc758\ub97c \uc694\uccad\ubc1b\uc2b5\ub2c8\ub2e4.", "short_description": "BeatBat\uc740 \ubb34\ub8cc VR \ub9ac\ub4ec \uac8c\uc784\uc785\ub2c8\ub2e4.\n\uc218\ub9ce\uc740 \ucee4\ubba4\ub2c8\ud2f0 \ub9f5\uc744 VR \ud5e4\ub4dc\uc14b\ub9cc\uc73c\ub85c \uc990\uae30\uc138\uc694.\n\ub9f5\uc744 \ubc1c\uacac\ud558\uace0, \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0, \ud50c\ub808\uc774\ud558\uc138\uc694!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://beatbat.io/#/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "Beat Bat Studio", "support_website_url": null, "website_url": "https://beatbat.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25967435482861180"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1218216323530958"}]}, "baseline_offer": {"id": "1218216323530958"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767879900, "status": "PUBLISHED", "id": "1218216323530958"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28749243301347037", "version": "0.26.091122"}, "id": "1865768920721234", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25851784914426238", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28749243301347037"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1865768920721234"}]}, "chang
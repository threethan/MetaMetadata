uluscdn.com/v/t64.5771-25/75361351_607514414609952_3443036293318161553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74damnn9Q-QQ7kNvwE5CGyH&_nc_oc=AdolrqI709dbBCGqA1_fcAyucEIFm24ja1lCuhnVownLbiAkuHZJV5Gq5Bn3vIh5vCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af17fC6EIvtggoZE1s-yLVPzB4-91PejYakZuIC_zrNpwg&oe=69F20EE1"}, {"file_name": "VRXR_\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_2560\u00d71440px_03.png", "id": "1607093043136805", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001681_1607093046470138_4978276037280053473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6kyB-7FRnsQ7kNvwFwp2-C&_nc_oc=Ado9armFyHTWn0bLgL86W92aUBRijVlbgL4JmUlCWfEAJXwHB4T0uyQcYknhgMpgfGc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SZFDDKQPN6LED2XI2UDIzulqoi8KaVPV6gUie-mTfdA&oe=69F1F719"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR CLOUD", "keywords": [], "long_description": "Events that can be participated in regardless of region and across countries, and events that incorporate the \"realism unique to VR\" that cannot be achieved with streaming live broadcasts are being organized.\nWith this app as the entrance, you can find and participate in a wide variety of virtual events, from entertainment to official events, from small-scale to several thousand to tens of thousands of people, including conferences, exhibitions, parties, live performances, public viewings, and more.\nPlease experience the unique spatial design and production, as well as communication methods such as voice chat and using a full-body avatar for reactions that are unique to virtual spaces.", "short_description": "XR CLOUD is a virtual space creation platform that allows you to participate in virtual events anytime, anywhere, from your own devices such as smartphones, tablets, PCs, and VR devices."}, {"images": {"nodes": [{"file_name": "\u30a2\u30a4\u30b3\u30f3.png", "id": "3471547306495684", "image_type": "APP_IMG_ICON", 
_02.png", "id": "607514411276619", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75361351_607514414609952_3443036293318161553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9MqY2Vvb60Q7kNvwHxDe2c&_nc_oc=AdrMYT5t51ks6pfpReW_I6igBpcFC_YZA-0TcisCrvKDyYrz8HwCv7DqXNQZqDtv6s8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XuS7GA7lXENJO__y9y7OtR4FmgvVYQLZBETzzU3OIEQ&oe=6A22D661"}, {"file_name": "VRXR_\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_2560\u00d71440px_03.png", "id": "1607093043136805", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001681_1607093046470138_4978276037280053473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff40b7oJv30Q7kNvwGkqOvw&_nc_oc=AdpQ9P_wTvA7QksbG1j5JZu4sylNVXSwL3oFBM5feFiOOvOdDl3lXXDVeUocQlE5F2s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kT4GRlaTHc0Tt3Kcj5hMJOUQYcTc9TKzjfjN9tsXUew&oe=6A22F6D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR CLOUD", "keywords": [], "long_description": "Events that can be participated in regardless of region and across countries, and events that incorporate the \"realism unique to VR\" that cannot be achieved with streaming live broadcasts are being organized.\nWith this app as the entrance, you can find and participate in a wide variety of virtual events, from entertainment to official events, from small-scale to several thousand to tens of thousands of people, including conferences, exhibitions, parties, live performances, public viewings, and more.\nPlease experience the unique spatial design and production, as well as communication methods such as voice chat and using a full-body avatar for reactions that are unique to virtual spaces.", "short_description": "XR CLOUD is a virtual space creation platform that allows you to participate in virtual events anytime, anywhere, from your own devices such as smartphones, tablets, PCs, and VR devices."}, {"images": {"nodes": [{"file_name": "\u3
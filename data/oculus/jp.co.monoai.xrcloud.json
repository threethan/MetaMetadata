_02.png", "id": "607514411276619", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75361351_607514414609952_3443036293318161553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v4HnzXD1DYQ7kNvwFo24p4&_nc_oc=AdouFnKnQAb8MpJ0qnHPdnirhwAB3jb_fL66fTTiTvF-6vqMiMsun_DkvEHbXJ5j6Ig&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gOs8MzTj0xjYyP89iUC_q-WDAIA0poS7FOXl3kGayKA&oe=6A369CE1"}, {"file_name": "VRXR_\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_2560\u00d71440px_03.png", "id": "1607093043136805", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001681_1607093046470138_4978276037280053473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zRUwuYQd7YQ7kNvwHaxY7x&_nc_oc=AdqwQiQvz-8uGROXMsswkY15Y4umOVsxt3RxtNEyaoqlnXER_txkre49EmTlhB5Mf5M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xsicgDLQ_xPP7jDGinlCOtXu03PLgyppDxsPwvhXuVA&oe=6A36BD59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR CLOUD", "keywords": [], "long_description": "Events that can be participated in regardless of region and across countries, and events that incorporate the \"realism unique to VR\" that cannot be achieved with streaming live broadcasts are being organized.\nWith this app as the entrance, you can find and participate in a wide variety of virtual events, from entertainment to official events, from small-scale to several thousand to tens of thousands of people, including conferences, exhibitions, parties, live performances, public viewings, and more.\nPlease experience the unique spatial design and production, as well as communication methods such as voice chat and using a full-body avatar for reactions that are unique to virtual spaces.", "short_description": "XR CLOUD is a virtual space creation platform that allows you to participate in virtual events anytime, anywhere, from your own devices such as smartphones, tablets, PCs, and VR devices."}, {"images": {"nodes": [{"file_name": "\u3
cFUhLFt1qAwgOZ7HK-jzY69SiouIsGzevL_Ag&oe=6AFC6E29"}, {"file_name": "Screenshot07.png", "id": "3214880022142591", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031448_3214880025475924_2802035069083036213_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Bn30W3mwYwQ7kNvwGpdYWd&_nc_oc=AdovmkdD-WNGA4h-9FgNGQN33_Sf-UMljYgjxHm4JocZrcJ1vUgWwOzRT3HIB0DdaqM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTez8YHo1ANcKKk5q6MMhVVKA2drd3RALhR3M3xDVGjlA&oe=6AFC6605"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prT_vbMACS4Q7kNvwF80hpZ&_nc_oc=AdoyYrwGwkKizBKcbwsw6JmApPTu3gCdm52pGE0ol81KWM1ziMwtZ4m97AQZROBj-gE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq1uOEfHCmmY80VS-yzVCUB4nhRzvjK-IRODlMuSbfbA&oe=6AFC7783"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmIH5LFLnRMQ7kNvwFTvFu_&_nc_oc=AdqNpzjsHxy0jhMeKL8_Nnhz-6jbPC1exiGngn17DWj3LmwULSgDv0S2wVKd-imcJQ4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgSklKnSkQqG8d_dTZuTV2IjXrLkgRn678x8213STWtw&oe=6AFC79F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lth8tnU6AbYQ7kNvwG3EhDW&_nc_oc=AdrTbrG7sGnw2unWt5ZXUKbVe0-dfRtwU9PpSEXQvh6JItIF2m7BYyub8jhYu15odc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPp9F_UJo2_CJnG7IGoJ95aujDSbrqwONfHtCKMFko_g&oe=6AFC69C7"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ryg1TWQuPzcQ7kNvwGImfGJ&_nc_oc=Adp-EN4dZQyS1RZrNiwCGHFx3g4mifT-jkHnrXELCzdfISj1diDIWA5UZtW-WOTSydk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXJBLbckO-XYPL0-G3XNZI6pBK2_o83j8NlRGvzW9uaw&oe=6AD0E485"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C9-5qEtJkcQ7kNvwFLMXyI&_nc_oc=AdpUWdFl5HaDIf8aKbuZxa7P84_IANbSKxYrqLvwfn4PqO-UhUx8qJ-hXz1dmco5FII&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-JfMrbR5uyB2KCh7Jm2-DJhn-c00sJY2Psy9WPvXQQg&oe=6AD0F603"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IynNbRnldBcQ7kNvwEFFroP&_nc_oc=AdpKdFjiKUSgbVGRWiCPamctshIUx2TQgKIBvZVubA-LbDHxP9oOSVIWPlNfbFhcW7k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJG-sIgwFUTmtIyEl3-1IX8PWV9s94Y8zl9ZwRdYH3Tw&oe=6AD0F875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c92uYNUjAmEQ7kNvwHMvDsr&_nc_oc=AdrHsJjoLgLBNQYx2JwGo_Z4tiz0HHHHc_PdKUGSY84TLbGzOHd_YwpI1Xy9XcXUOeo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP29GBTLhTq9EbSn9mh0jFVjVQ9vTdywEQtfnyQ8RpL0g&oe=6AD0E847"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
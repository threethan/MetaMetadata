03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_QnIHKUG-kQ7kNvwHYIB9G&_nc_oc=AdrIJ-ezwLpNHF-gm4OX4-cMhNd8ckUd5UwQXuHhOO-1aWj1A23-u-Q-XoV3lz5X8m4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JaJlsz_x0w0hl-H02Gb__B52Sa4aXeQfrok76RP7DLA&oe=6A106985"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ9W77bjqC0Q7kNvwHFFBGI&_nc_oc=AdrFsw-t-SmEC_zpP8QMpwZFqNALxtSbPJIOQSiHnBy4jXCx6IlrS6ot1zKtPfFc-B0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Bq55tQz1T6H1y60SimfqySEmwAH5bB_DzKQXmpiynrg&oe=6A107B03"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK5EVgaK7nMQ7kNvwHpZ1PV&_nc_oc=Ado-XWDTbujUOjQ9l-hZM0ibcDqDqDwg2HZOVVl4mGn0y0AhtQVVQ-GY9hS-YP0h5rA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77HkTOniB2r_Eg7WLT1wiU4kLHLTZ40LnivMVZeA_Qgw&oe=6A107D75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqZlo3fdCvwQ7kNvwEXGZH2&_nc_oc=AdrC0tzXJrWuDKwr6lF2CmObzFdw-4Q-ch46NU12qszL-XDhZ_-1GF6Hp8b-XlWFlFY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y6coaQ0OtDXl0AJPh2JpFLiGIVDShHhIIbcQHPEC1ng&oe=6A106D47"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
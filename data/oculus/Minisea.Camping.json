03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQuD_qV1X4wQ7kNvwHa-n5a&_nc_oc=AdpfL2ylgnlCsUpEYogShsZ73WKYR8kpxLZIL6zmx7r2ZmEBRrUzrFAZuhKwBA5C6do&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVuKVKDoX-JPc31ZT9IaxnrS_z14JI1XumtVN7L28i9A&oe=69C54405"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVKE2IQEWl0Q7kNvwGN3lYt&_nc_oc=AdqK2g9Lldupoe7C8EI5qsZCsz7x4-vWHgSAziK3K0vjLQmLPCqniMx9Q_zln7fzDSs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZqbE3enYSiKfOrwtQSoq_eTcJm2WC0j_uoTByODlUBw&oe=69C51D43"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6ICMaZY6iIQ7kNvwG7w7a4&_nc_oc=AdpZ7ZqAQR_waIf8sA1zcF5w93yi8RO2b-qiMdSYJXr5TqWJZWPh34UVqxpgKFW5yW8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3GLS0Jw31QHpwMOQo2gWY1WK0DSDWcDdYo7qE4X1ryQ&oe=69C51FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mx_tNjhy9UQ7kNvwEoIhzJ&_nc_oc=AdoyZ7d8xgIKIM9US_zWB0BrQjFs_eEDISONCqCcDBsyo30tZNIvRV8ynA56Fx7R0qg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyh_XxYy3vo2IsP1tRY51MweTFc7vHJxUThIrlrlfmv-w&oe=69C50F87"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
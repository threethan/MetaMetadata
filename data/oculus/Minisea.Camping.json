03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YLCYdxcgcEQ7kNvwF_QdV2&_nc_oc=Adq2F6W83v8IliWujqd4b1S4iE4r7rNPZ1mHsS_CZpaNUqOpO35xE1_VSJZkTg2-Mxc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY-m2dmnN2XVPzV3tzL2Sf_vQbYTgLfOewY3rIxbshmQ&oe=6A971AC5"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7H1_c4gVOsQ7kNvwETdPhH&_nc_oc=Adq1mcg1f1OUT25KHR9zA6rtM32WGjy_PHgkbSglCk78n5DYwcbqN1iMxmoCNCgqqIs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYI4HS5np-ER1Bg2e2w3ry3Vy8Yd5q52DwdJCK1OuEOA&oe=6A972C43"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2frVTZXGg4Q7kNvwHesa4D&_nc_oc=AdqTO6Yd35FQso7QF1uT8F92a6XWr2QK6DfT6oZ_iOCAWyxwrxerLB90quz1a4wWBw8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNQt_1nQnSfPIkymQ2yPmMT3Gs0d9hCWtatYAq_Qh5yA&oe=6A972EB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_RvXT6nORMQ7kNvwFpBDvL&_nc_oc=AdoHdmjE5oJxEHNl1FHET4sYGtpA1fGMCAZwKwwD9-IMdg3vvx7LQOpFgW0xsZDAGRA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhudwKDBbyv04qPzdlJRwfDRwrdhWlfiLKjjNzZ6YPFg&oe=6A971E87"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
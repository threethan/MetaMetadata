03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9WlsbvzFCEQ7kNvwFYKB6n&_nc_oc=Adr-I86GJPUuCINN2FgVgd_rsywP4Dro7aWkPE_PXSF4OXCV35dSs0SrejlbaaMT0Fc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yQp3GHz3wbbh7gpglWtvgONYXozEPnh-lefm1OYPExg&oe=6A3A9985"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0iVHKdYyfsQ7kNvwFjptEG&_nc_oc=AdrLgIAZKlsQYYE5Rweyjew0HyLjBmpE1VfQ-amLzS7-4_Ib6BK0HhAfzm_IOMXZK8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gzEAyKosaVLFuacQLU8MRGFUvAZAfVD45IFIWPibEYQ&oe=6A3AAB03"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lIyQaErXokQ7kNvwFAwvIZ&_nc_oc=AdrSIbkkYbT7Vr3La2JajL04w49h99P5O2kgzQgf4k9kVWG58webfu99_GXrsFWA9f0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SKxdxJw3P3KRraQZ7R6S0bT0AGmD5LRwtzjSMh0FMfQ&oe=6A3AAD75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd5C6pb7rsMQ7kNvwG5Nts3&_nc_oc=Ado5l7mm7gFI99NcBzNjr1baT7KBpd2ua7wDUJ3PcojXE0tdA7EAifmHmG7LB1kHSfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94dsO-o5CEE8nTKO_8tcCAmChT4AzLI6Cx8C51xIQKow&oe=6A3A9D47"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
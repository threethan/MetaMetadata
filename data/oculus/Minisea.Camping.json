03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz3Ri90TGxYQ7kNvwH1v8zu&_nc_oc=Ado_z6iXnzASPXcwuenv2QNXojpkBBedq3ooOBqhsq00vdz7BirHREHwF5vsdBoaRNE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCisUmnKLgKD09nu_SZRU8D4Gr93LOiwc9aI39ZkwzeGw&oe=6A54F785"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UnwO-7cooMQ7kNvwF3s8r8&_nc_oc=AdptacWBsVjq7S3zzdDPaNkUMdgJt8kptvdjXU7WkAcmY241UuSge3qUghksm-tlRDs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKUeNWUGNFgS8HeGSfDHXw_4uL_IcQQHQekCK9R2o2Uw&oe=6A54D0C3"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgO9LqJO6qwQ7kNvwG0_Vhx&_nc_oc=AdoHpCUFv1b9c2GXkc7VRaBPUspw7RTvS61l7wTW0MG9xg1TVz18aAD0VZa87fPbeuk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfMkHltk31UkSD6Y_qqJFuYB81ubRYcH8_uBVtJvm3uQ&oe=6A54D335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fx9n5lIBK8gQ7kNvwGg-UHr&_nc_oc=Ado3e9Q2-lMQ7CxoS2laKLKPgnDM77739LcKE1O0ZZa8EaoaBxRAiwNDnBqK8p6CJb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8Z0EeFhsbVHHQjRYklPhBWgLVr9W-EbF4WweiKxv3Wg&oe=6A54FB47"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
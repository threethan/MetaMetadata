03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLhAvFOyn8QQ7kNvwEqXUUz&_nc_oc=AdolnlbXOvemKaZBttdQy66OHqEpWsZRLIVfzgj0OCKe1D1aqSnRZl971zCuqsh19Mo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aulLtbNPth0vbyhH18Ew_IC64Bsif2FuQ11pwUw9Tzw&oe=69D27305"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_mdnZXiXioQ7kNvwGH79HP&_nc_oc=AdpETwlhPH3Bhh4e4FakWUCIP_hO55jL9_YzkiheLM0uF1ufu8fQUACjY0Tr5oQ1W4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MMytyXX_OpGE54v_zOCqBStiiCNa4sDYsFooLkrtaSw&oe=69D24C43"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMRtvHI_0q8Q7kNvwGoGFMn&_nc_oc=AdoQ0YogD1PZv12BKWd6oSlCgDyVqVEDJPQ9UCnzUFXAtPZZ4DxGRScRc9lG-Zrvvhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T0x4ubnwkej9vEfe5fB0qJNw9Xj5MEJS5lTKNKIrpdQ&oe=69D24EB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhp1Y5-slFEQ7kNvwEcnJtQ&_nc_oc=Adp7cC26Oo_vmbcdIZ4m4dnP9fNOw6VTwNADZUcI_Ul6RMsIvG-Yzluj-2oLnr5M_6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qVAPTsF6t5AQeTfZICdIBT8Vp_stduPcEbRwjd3BJ4g&oe=69D276C7"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD948YJgsmcQ7kNvwFY5uV1&_nc_oc=AdrdyGQF1P1BK_GgvMSLuzQ-H5zN4EwSTaDV3V_kDft8l87sJTwB7vliSzhKw9BYuBo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoIzjZLQj7hOdsLS0xrxAgY_nVo_ALCqOY6VtWgrx44Q&oe=6ABE6F85"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOAsf17yEJ0Q7kNvwHDlplp&_nc_oc=Adp8CefOhi521b3keRJt0rSOi-jbiHoHyYz_rnzb6rtk3Z5NGCBrBIYjJmiZ5zLNE40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5FX0RtaaB52IDWRap7AN1fcu4mRPzm9_gMJ7ugrw6fg&oe=6ABE8103"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5EX4-OdGgwQ7kNvwE1tvnV&_nc_oc=Adoe0_mvWPWdfgQVK5F1s_afJN0QRsgnJYoQqbLzmvo0cFKZzRXdwgVBx7ALpT-OQno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxHYMwSHDYuptDjygNANtkmTMll91D4hyUJimPaiFDUQ&oe=6ABE8375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASsG5y5p9g8Q7kNvwE58fu1&_nc_oc=AdrAqcMabxca8g18JbDyA0imqIEhXxr6ljdi07pwFY-JoevY9zhDsR4VxM7TGeJl9LU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuQxrHy2DJRTfMLfiU3gCQma-BOfdFfHf8gOaMlumzOA&oe=6ABE7347"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ik_Oa6k76awQ7kNvwFlnvJv&_nc_oc=AdpikyqYMWiLjfvjRpfRP15TiXTdYord50BDKGTnL7VDHy28tfexJztZ3f9TX31Xsrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtpH0ccQ4Rz3VKkanNjtn2oYQJn7YKnnmQzLC7v7eR-g&oe=6AA6B485"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFHQd6BeycgQ7kNvwEBJqtZ&_nc_oc=AdqHMk8ilAH9vElefWBKb4X_3KD7rfPuzJ6bE_WZyEh63XLDFk4zzpDkKCf-B1ade5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp-FIJQNo2IzaQIz_un9RbGpmMsOmhOU4BIgZg8zBEJQ&oe=6AA6C603"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw8AWbQTmmcQ7kNvwF0ISWS&_nc_oc=Adqq13_LrBV3Dtqfnp5YXmYX2EkVgdrqfdVfkTEqv7OlnrZo0uzhbk1lTOI6L3urkiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-yiNgHgXJy3tSYOS8yC3pQX2fz0Z0pix2tkXQx8mr6A&oe=6AA6C875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clSvMIlh5vgQ7kNvwGjDJEG&_nc_oc=Adpa0dSqlIu7bs7lvv3xa3JHWGw5urwCT_dZ3BDZIEtQIPmrxqDVya0LH3zmDtl6LK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOlAOoX912vyX-trNgn3l-gLDbGGrIG869KQ-lIhF2MQ&oe=6AA6B847"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80gPIfTYGMQQ7kNvwGtZRF7&_nc_oc=Adr9I4ep72eEB585IOrCZlVtkTUyqBo_pyEki2uoa98H5CdWO8Q2QT94GPnvim13woI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Rb2pYvBR0z2d2fVX5uUBhTsarVw5XP_GSa0Z3nX2Xyg&oe=69EF7405"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXWA1jsD0dIQ7kNvwGBgMIy&_nc_oc=Adq4GDj8Tj6YgSKDykhxjP7oUVLjka-D-L2AtwqoNsjxBo3dJd7nWeWW7qLDHytIc7Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32DnAmCzHTWJ8UlcyHcP6vTQPgVtPAmp1ZD0ENHfno4w&oe=69EF4D43"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ne5cB5Ux7oQ7kNvwEHFKHH&_nc_oc=AdoMtY_1ciFvM2tC3zrY2BWdGJCrgufwsI_eMAXI0DEn12waITQXXDdgn5dLDQnr854&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WQfGokdn8krGkbkAT1xOifXo591RHfgR1eZ4B19toeA&oe=69EF4FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzJuiBT1y38Q7kNvwGNxUw9&_nc_oc=Adp6am36tuj8wf9v_UpNKL90eiVYfQpACPX1FUOrThogcO34MC4F6MB1pQQDRaZ1UAs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uwDUzuGs_7KhkvlAMn_74L-vtelwy-BS8KIY9KO2MGA&oe=69EF77C7"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
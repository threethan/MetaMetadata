03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9WlsbvzFCEQ7kNvwHMYYxZ&_nc_oc=Adq1a7TCn-cUBjljItYhPzEFA75Oc90-P9lpjBgLhSWimpVAbOvZ4zOMqvhBNAjEJLI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-UT-a4iWiAhQBWIAbcQOZ2GbB1A4Gj4qx91UMYp3pYA&oe=6A3BEB05"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0iVHKdYyfsQ7kNvwHu8aBd&_nc_oc=AdpRPBllFE_EF2OvrkWDNw9-rABPrS_1VY9PIYYM8keAALKkgYt9x-NF50b2BccbTGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RgLeFuyU9-1l-41rsu7YIxbMdmn_Bapw8Kqv457MXXQ&oe=6A3BFC83"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luhnd1WFyUcQ7kNvwG9RihF&_nc_oc=Adp_4Toe5jySmPn5-0a5cOK9rlcFIrGdRGUtqWQkDyQ9wf-7rOKw2auHglVTNpz74IY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ui0QdLKFXcnkzH7HRG8vr6gukOahfaoG-jBZRXoi0Bg&oe=6A3BFEF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd5C6pb7rsMQ7kNvwFCcjDr&_nc_oc=AdoVKCX0GX-ZxH5I8dgR88jVYaxhXl8_XyzrWseSo0_AnTBntI0JbwWmold8MSD0HCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wWt2hpShVJfzRKsFJFA4T--rN7e5AwU339vif4orfBA&oe=6A3BEEC7"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
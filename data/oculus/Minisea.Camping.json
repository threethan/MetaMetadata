_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4IOaopg7gUQ7kNvwF9Mvwy&_nc_oc=AdoO90-I6uMXAQWYA6zrr5Nuu1P2XRnWktjN2CjTr84rFLMRv87_ye5WzLiFvtmChDY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcQsSBWOYQ96rYedrMyk-n8ucrt5eHvaA_GR0BBLEnvg&oe=6AAE9D85"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5luFyfcMVAQ7kNvwF72n-4&_nc_oc=AdopUt9fYmhSJJhL2nLVTEz50LTvSYdFK6J0cZeHg-RLUHIA3scSSKlqJtS6ecG4dEg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL114lsrilN1Rf0k2uxuEoLC-MahFTJWl2MSCqA662BA&oe=6AAEAF03"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXxXpFz4p2AQ7kNvwGQLrC1&_nc_oc=Adod-abn0-zq3WZmD0RpxGW-8AWvS4eGP8SIiwEMdp6QHnZalTe8GHa74eIMFpao16g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPleIDgvT2vKihsw8C7Bu1WVfe3ZQ2O8qRCjieAGTVdQ&oe=6AAEB175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWH4X-61M7UQ7kNvwGeYZ2Z&_nc_oc=Adpoh33a6I1zXgoys2imM4FJ4iwv8_WP-30sRIP6zQWQqOhqNoExOG13rbwr8afjuHA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpZHgGTCgvFfmvhu2LgQQE7N_VhRvnceCFZv0dCzfQWw&oe=6AAEA147"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has
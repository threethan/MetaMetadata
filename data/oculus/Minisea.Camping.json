_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5GUxQB0PRYQ7kNvwFMmHPK&_nc_oc=Adqa1y5XfZ2EIzkAcJnNMzFvSyfiv0ArMQwqEZpqJVyFLckJzvkulkiASNe36Dn7xoA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z7ZFRVKHXGRxnd_wLpn1HNuVhVppbSKrPTq1dbh1S4g&oe=6A36A505"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Ue1r50hfYQ7kNvwG32fzT&_nc_oc=AdpubylOyh1b-M5z92uSMzW0ey2_kTt0kJ-IPe8I8nEyj_IRXtADlTCRpUrrJ7Jd9pQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UQZbtg9nSCZteVT4NDwQ4HBna1MZGWUM3g-cqdzgatQ&oe=6A36B683"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRHbG9OOavAQ7kNvwEaLOM8&_nc_oc=AdqhT9FkrkjkamF90fs0LFMT_xp-eb46tMyL7_ZJbrzk1raHYB4uoYUrlr9BzW-aAGA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CfDLC6O9eRAzd7yTUfdXzQYJGyr2Ym2Z5866nHFX5Tg&oe=6A36B8F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qQp8k6kMxQQ7kNvwFWAHtJ&_nc_oc=AdrnJvmnXRmBx7YRHOor15xuymJQBLlwxhKKtN03cNPkX8ih-Y1PAtVQCnEXD74VCW0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yM5ZNlGROPb7RsMdKzE0z80h4Oya6DA22Q2AvIW6HzQ&oe=6A36A8C7"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has
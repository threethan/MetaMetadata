_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRiY16DxngkQ7kNvwHqbpEz&_nc_oc=Adptf3GVXTLOX1JfQEqEVrOIhyV6MCCvSESTRL7vAP2VgiD6n0K2zqFuXuRNTp7QK4k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2oFsaBwtMD--3f14QC71Tpi-rDc6NQ0C40y6RzbjYNQ&oe=6AA95785"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8BDoFg-6OgQ7kNvwH7EDLh&_nc_oc=AdqV9aSfgbZ2Vdwzn5_W6jfVSxVMFO8tQj5mQzaopwOUe_chxcyciw6tlbN9maccIm4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpsEhhvM2cQ6b0qOrimwpOiGitfjHllaYzZnXEOYqEig&oe=6AA96903"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw8AWbQTmmcQ7kNvwFweTIQ&_nc_oc=AdooFfcFdKbDUhNGoY0vTCrkFW3wKeN4MjabDk7w51psA7SucaCFxBDAp7irI-he4Kg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEV7xh-A8_lut3ymUilfG0OrLoMsNC2cdKl02LzqUN0Q&oe=6AA96B75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZm3lqxe3CIQ7kNvwEjpGVA&_nc_oc=Adrfp8yLLd32RyXF75UH4qU8g7ynK1Q0UsWhPysnt2Zfy8q8JqfFPzGXr7xZtxnY7mY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeEgH4pR_u545TL9axljxUjmDEU1HYIkraqQG_L_S4sg&oe=6AA95B47"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has
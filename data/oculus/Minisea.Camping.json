03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Du7SL8q_N7wQ7kNvwFV9uMp&_nc_oc=AdpzSY1xe9dE3kdik-p6--A7wygGMIMWs55fAlWDIHLn96n2scGKM1SYXkLrJpmxmEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnORkDoepDpN-yhOGBqxSt8J80zvB7AVKkw84WxkKUmA&oe=6AE74E05"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uoty7Q0D3cIQ7kNvwHh6baM&_nc_oc=AdqEi2dQOa55Mc56CSqXh1tYdYQPw8HmjJdWk1os7UEOCcGdbTy9iPQ8Ki1UQRTqqfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC-MlJi7frYZXP9xxpoElzq0_qmwL-6k71LitSSXlfmA&oe=6AE75F83"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCj7DmIm4L4Q7kNvwFai-i0&_nc_oc=AdqeGEDk5TYwp9UYIiz_LENJkrBHY4sFjK0Y7F7oH8XXamDiHOAsUczFkAo65_3C9OE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxi28d0_hSV5Ax8drNudzE-jl4UzlF-MR8vlBVzqaU5Q&oe=6AE761F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdBWS_NwixkQ7kNvwEDiq2_&_nc_oc=Adq5rTF8rzK4JAYXLm_RZvS_3KkhcvK0xHMpnc_wp-AipVghuAUxV9ZkD2WPRwwtNNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVI04thBU164MqOAJnkGfycx4JwfqCMLkIuVqkvR5JxQ&oe=6AE751C7"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
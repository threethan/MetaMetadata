03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Du7SL8q_N7wQ7kNvwG9fL03&_nc_oc=Ado1v-WiY-X01ihLb3UEE5OTcLwnpAdNTDT2hADzF5e3VK1e8d6tZ0vXEcs4jGE3Muc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9FlEn1a02JfwuD1eADrsm_YVCZa9-LzE3pkp4Xwz-eA&oe=6AE4AB05"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ukc3pMgzfgQ7kNvwEVu0vV&_nc_oc=Adp16flwY1Nb2hJJ5h5PI9HcwrmNoSi9uvyIo_0uKgVSxwTVuSNhSMXGysS3JTkUz98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3UnCyEMjGleSWHABa1hN2JfbJtGJz7fhPO3-vaFdX1A&oe=6AE4BC83"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYh__vixF5cQ7kNvwGqw3E3&_nc_oc=AdrAi9jWlCYF6ZzBME5NH20RmOI8tOMV1row9LUuvZDF7UH6jBIfIZgggqe6kaVeffM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP34yhOcqbLIgN78nP0Tvp39AxboyKicGXDSao9bKhSg&oe=6AE4BEF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP1Rzaj2WMQQ7kNvwF8eA6_&_nc_oc=Adrufh8SVCHM-mmUOLqJ0z6U6MNH6nJ30snmCYX56xHvZfrEoFBGPX9Va7DseGmK8BM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgDZ8HVCX1F7pW0ZYZbEKmLJNAKACEvZ0bBHuvRw1v3g&oe=6AE4AEC7"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
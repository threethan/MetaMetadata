_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlVBuMbQzQwQ7kNvwHsii6V&_nc_oc=AdqsdaVMiGnH5cyLiNy3MJgg91VrOkWfK3F21uILuvq3HGQ6EY2pjW1ni1z_i4OJ-XE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG07Y7j0bM_OABblMFG6ea9fghDGLJLdtT948gR5FNRLQ&oe=6A8D6FC5"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-wAK0ZV5u0Q7kNvwGRFXE2&_nc_oc=AdrnlAe4jtYVIdL-kgfuh62s2kj011xKZvugHQCs_BhG21FaoshE7xiGsySMxiC56Yg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWIAwH-UobEsaqCOED1EEroAMN2QGa0tuxW2YRgqgejQ&oe=6A8D8143"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCpnhNDsq-4Q7kNvwF2cqoD&_nc_oc=AdqM4El8hPiqxuro0NtCxJaXv42u8z_ID5-vfosjt1xXzu-UYnlJbnVPfQ_Bf4mMKbw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn_3OU_xMcd3dtLe1vWXFpDYYPOTMLz80m08UrWCR3qg&oe=6A8D83B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNSbgBos9QMQ7kNvwGZ6uB5&_nc_oc=AdrRGYApX6IgkHM5JP5xpIUfb8iJRIm1ApG-I6jPta1nKpukiopygM8URAQG3fhROS0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVs6aSGamD7kk6MmX79j-GFExCk2F5_ajgcFsY4TIKIg&oe=6A8D7387"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-_ILPDxW8YQ7kNvwGX34zf&_nc_oc=AdqkQjYTjzQEVRYyritAh6LeOwbLQYozx1Mw5OKP8A8wx3UzhR10DaPa9cSusUEArk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SUEL07Roa3rro39DGxVzyi8dbmd9bw60uOgbdjIs-7A&oe=6A452585"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_BflH0sZEAQ7kNvwGcob8b&_nc_oc=AdrUP6ET9QMpbdXi0MjNyfXf3wa_HJpmS6glJmJ62ZpE4t7LNhXAtLSvmPwa6DTGJMU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-83mhFO656QJWa0V3R_2kKXqaWtg3ZRtJDY5vRfvHMKQ&oe=6A453703"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6ucVdND9rcQ7kNvwGHRNXi&_nc_oc=Ado6hRJyTyNGQ5b5AG-ahT3W03PsQz0RCKjDU9_wlnG-p-he2BOaR0ANxlzYTjCDMNI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wG050PYVRWXj2p8LADbgjRDjrvgRXQbkz2vAT7gJY7A&oe=6A453975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR5s1nlcK_AQ7kNvwF6Iy5c&_nc_oc=AdqKn1iBawvix5Uxue9xfQ1L2oqM2Ov1P0Osp8Iz28OjQtu03EB-F54tkRSX8UbZ_9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E4Vo1XbeJ-31Sp2BdWgT0j7QK6FHE92e-yBqfWHUSLw&oe=6A452947"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLhAvFOyn8QQ7kNvwE5ZBrG&_nc_oc=AdpxnZiNl-w6AuMSocIQ25VCIFgTub5HELll8ZZ9lTP0MXepDeWTNUHwJ1CF49YImeI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC2bwbndwo7hoJ15IE71fOzu6o2BMq6KIx7aro1TtW8g&oe=69CFD005"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WXfx9aFRNAQ7kNvwFVgA5V&_nc_oc=AdqU7-r755lVoYGjKrf-EUHGDTS6EeYaTagARQRduIUzYBaOFTm9_dsVMi6BuyqfkQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzorjXYS56nIMWvwKQ6GSec57W9LncEFNWSlXYHxDE8UQ&oe=69CFA943"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2zDkNcRl1IQ7kNvwFfyrc7&_nc_oc=AdqhNbk5L7v9yE_0PD1jFRv_AJDb7-grw9zhi5LJgYKVznTM7n8gYlnjAmDVGPj6KO0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7r2syiWQBxtzdR1BLm6HdFNNZ0A-NDMuxJwn1Mxa47w&oe=69CFABB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z47fuLxGieAQ7kNvwEHYW2Q&_nc_oc=AdoiiBYx5IKmTbnUDg_0rtzVfmffEhVwX8D4vLIPDdpWXVQ5RVKdzvscd9vEmjNrzVI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaS4chC417uGM3Yn8-Csyn2_hGUM5HBNOJf2lcq5fKrg&oe=69CFD3C7"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
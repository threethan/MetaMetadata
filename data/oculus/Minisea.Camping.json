03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7x5ZyohpMAQ7kNvwFudD-e&_nc_oc=AdrKXBZs6_7URdycAw8mXTkCtZs_Edj1lYP6DxIfCwMsMqmO6GGyNWUShhMMXyGM77o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1O3HcmvXo7ppumsW1fGWCMglBuBeN_CzII6kmekmqvQ&oe=6ADE1385"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oS4tYyuFzmEQ7kNvwHqc-pX&_nc_oc=AdoA8-D6JWrrgnKDVXtXfTgQlyge4o_8v5ShLm2PXZMZ81pLTlAxDl3-Tf48hc4xAeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFn6Jjsn5lDZlF3ABtxhZs4pRjMd-kKM7F8EtYJuxr3w&oe=6ADE2503"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btweNacmu5sQ7kNvwFmr4h5&_nc_oc=AdoeR4FuatUZwpGJdABW1Y2i7LhFq4VDMTNnZA9LsfPEsv5dv7TyAKLj3TEUcfEppEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM37eFz0gqMvWYjASJvzCVKZKH-kHxRuDdJw-tU-bA7zQ&oe=6ADE2775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulvxS-yLXPIQ7kNvwHy2RJ0&_nc_oc=Ado7DzRyDGuOFaCNe8INDDr6aXrhQVI_inQuJ-XfaNS56fw8exHVSpUdeEHWHir1YeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEdo005_bZFz92g2WXIS33QVafcQfS6SOwfaudGe3dOg&oe=6ADE1747"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
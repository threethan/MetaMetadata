03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsrSlH38DK0Q7kNvwGaawLm&_nc_oc=Ado85lWn_RF2l8v2nLrdc_Lfu9HHnKBFpnWtRO_xh2-6otAv3kalGFomhNXof3OPp54&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUCQUu-ZmfsvHnh33lGVKsx83ybhiQavOTOXqpnBDbTA&oe=6AC8FB85"}, {"file_name": "Screenshots11.png", "id": "536463812327357", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031420_536463815660690_4205572921357731376_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRs9110wN0UQ7kNvwFSe_UK&_nc_oc=Adou7bFDqvJ0Czpw4AVZzfh56xkJh32ZgaQtj_AeQpE6BbUSlhlbPnC8lhBXoY5DGpQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj85naYLmUAXByv2Irhkm_9rLsD65Mtt_6RjI-m0161Q&oe=6AC90D03"}, {"file_name": "Screenshots12.png", "id": "1560796581187636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974635_1560796584520969_2062098560627593709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh6pGCg6Qx8Q7kNvwFu9DTN&_nc_oc=Adq4rD_3MX1PHmdR4UVfvtyVSL37C_H6QrMVI7GZcCNT-fzwT4P3fV9eSH-LjUP-bjQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjOrHm5NYnuqmLs6dbHu3e6lVqMYDR1fSaf1_cqlG3CA&oe=6AC90F75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "466071935668646", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974459_466071939001979_9192732191311141222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFHBTB1d3CEQ7kNvwFGR-uO&_nc_oc=AdqGZVv-75QJHO8UJ2Tu43sSLS7XgPNuo77q0CHqzEpb1DrL40kUgaTGIMNQ0e966ig&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVOmguyo-lHnXV6db9BJaDorPEJ9UTHsS8Y0Hqow3DlQ&oe=6AC8FF47"}, "display_name": "Camping", "keywords": [], "long_description": "Make camping easy for everyone! Hello everyone, thank you very much for waiting for the past six months. During this period, we have also received many inquiries. When will other maps be updated? Today we finally bring some good news, our second map: \"Beach Map\" is finally online! I hope you will enjoy this beach camping trip and continue to enjoy it and find inner peace. Thank you again for your patience!\n\nCamping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility.\n\nFeel free to join our developer community and collaborate with us to enhance the application experience. Your feedback is invaluable to us!   https://discord.gg/kfb2NATEfS\n\nIt is an honor that \"Mindset Camping\" has been nominated for:\n1. VR Awards 2023 Best VR Experience\n2. FIVARS 2023 International Virtual Reality and Augmented Reality Story Festival", "short_description": "Camping is a highly popular outdoor activity, but for various reasons, many people are unable to easily experience the joy of camping. Now, simply put on a VR headset, and you can immerse yourself in the pleasure of camping anytime, anywhere, relax your mind, enjoy leisure time to the fullest, and experience wondrous adventures that are hard to come by in reality. This meditative-like experience is expected to bring inner tranquility."}]}, "developer_name": null, "developer_privacy_policy_url": "https://campingvrgreatsite.wordpress.com/2024/11/24/personal-data-processing-policy/", "developer_terms_of_service_url": null, "publisher_name": "MiniSea", "support_website_url": null, "website_url": "https://www.minisea.com.cn/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "TRAVEL"], "has_in_app_ads": nu
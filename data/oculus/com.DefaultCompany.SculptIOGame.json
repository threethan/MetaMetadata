43", "locale": "en_US", "screenshots": [{"file_name": "703d067ca0224578a0ea26619a75f79b.png", "id": "2357671221394385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303672_2357671224727718_2334545695234413720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxZaqeE4CSUQ7kNvwGyIQno&_nc_oc=AdrvUZVz2Gh_P2R_rHPwbHpPd2cf7WO9LS3aay62QlKzCoYlF_Zsc78-KziDidJjCcU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ApXEGiXjc5UJgB3qPl03qUg1QvHqvsb1rcmf214Ey6g&oe=6A26D68C"}, {"file_name": "64dd1733170f4b388cb2cccbcb02d628.png", "id": "1499937881532165", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304162_1499937884865498_8111613517000634770_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LhxwaOYFfkQ7kNvwEFsh1u&_nc_oc=AdqY7csddwiU7AO2xTZCwYIGicizkTxCCMrOtvJgT3b-2ZSseTONtXHI5dPxQ4nSnig&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_znG1UlwSUIZJ96iYmcbtaIFP6BhFTwVi93wUEc4Bkng&oe=6A26D60D"}, {"file_name": "53467e41f1cd4a72b9766d065689a341.png", "id": "1488038436155480", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304952_1488038439488813_8830845362534519457_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZoFRma-TKQQ7kNvwGL_MYb&_nc_oc=AdrEctrMqtzJUdfDhZtuPYWML0ve6mlycony5368U2q1AOLSHrTRNaILvZkQAKsbI64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rt0PzaZd2KO68uMnJjQgGsLnjADjHSKR5pmAxGbxPhg&oe=6A26BC3B"}, {"file_name": "9f7f109d58f74cbabf829af06d916ea4.png", "id": "1193497182796720", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304764_1193497186130053_1984571114036074440_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1-zh2G2y4YQ7kNvwHzAvSr&_nc_oc=Adqts4Gn7ULficun9iEpbzgFg7LweL-7ApigEe23hriu78waRF7VsURCgnLJ5OQC-j8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85mutI1C0vr7xUgKwEPUig2NSZzIerbxtKKgDGEa1w0Q&oe=6A26EB44"}, {"file_name": "e8aa36d8b4c24d649b28b5fc7bf033e6.png", "id": "998338965993011", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308090_998338969326344_8045061657753469328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X7RJsdbCnwQ7kNvwGhLqUR&_nc_oc=Adoakn9Juj0--molsDgNz7roN8ErbUXUwiZBdaaMaJgP-b4aaEvRZqwEUwZdR56YTJ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mwwsQMzBfnexSlgYcFpCOIvzNXL9Db2IQPN9fHPB0xw&oe=6A26C38D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-05-20 at 11.12.56\u202fPM.png", "id": "2177160016460417", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499313074_2177160019793750_8922202654458173207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LAjCPM8PyYQ7kNvwG9k_9A&_nc_oc=AdrytX5t5yHE15k8SNMrCMqW7MEgsq_C6CJzvIFzIlsRtV-jbgroaDgu_CYrsJpbw44&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7uI5Sl_Z7_cQTcRnKGYdnj_LU_ab1wjaSyq2OoKlaXA&oe=6A26C308"}, "display_name": "Runaway Sculptor", "keywords": ["party", "sculpture", "fun", "puzzle", "social"], "long_description": "# Runaway Sculptor\n\n**Pictionary meets VR \u2014 build it in 3D, and see if your friends can guess what it is.**\n\nRunaway Sculptor is a party game for groups of 2 or more people, played in person with a single Quest headset. One person sculpts, everyone else guesses \u2014 then pass the headset and do it all again.\n\n---\n\n## What You Need\n- 1 Quest headset\n- A TV or screen everyone can see (via Quest's screencasting feature)\n- 2 or more friends in the same room\n\n---\n\n**How to Play**\n\n**1. Cast to your TV**\n\nBefore you start, cast your Quest to a TV or monitor so the whole group can see what's being built.\n\n**2. Pick a sculptor**\n\nHand the headset to the first sculptor. Everyone else gathers around the TV.\n\n**3. Choose a word \u2014 secretly**\n\nThe sculptor picks a word from the in-game menu without letting anyone else see the screen.\n\n**4. Build it!**\n\nThe sculptor puts on the headset and starts assembling their sculpture out of primitive 3D shapes \u2014 cubes, spheres, cylinders, and more.\n\n**5. Guess!**\n\nEveryone watching the TV shouts their guesses in real time. The first person to guess correctly wins the round!\n\n**6. Pass the headset**\n\nThe headset passes clockwise to the next player, who becomes the new sculptor. Repeat until everyone's had a turn \u2014 or as long as you like!", "short_description": "A lively VR party game where you sculpt, friends guess, and every round brings laughs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://runawaysculptor-webapp.vercel.app/privacy/", "developer_terms_of_service_url": "https://runawaysculptor-webapp.vercel.app/terms/", "publisher_name": "Belebek", "support_website_url": null, "website_url": "https://runawaysculptor-webapp.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27454291027511308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299922_980657598244750_6777824031990595275_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG1Dx19OLsEQ7kNvwE_LIcx&_nc_oc=Adp9t8LkA2ZvX6fi46jRT9RzR-V7ZnZGRJ9_1IuEwHNWlxR5hc6nTm8aHnjRgUXFMBg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89wDcwuuMXO6jWX7NlapT3B8o2dtGNyCOt-S5jizR2xg&oe=6A26BC48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": 
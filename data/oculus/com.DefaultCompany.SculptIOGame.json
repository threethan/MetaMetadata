7f20f&oh=00_Af_znG1UlwSUIZJ96iYmcbtaIFP6BhFTwVi93wUEc4Bkng&oe=6A26D60D"}, {"file_name": "53467e41f1cd4a72b9766d065689a341.png", "id": "1488038436155480", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304952_1488038439488813_8830845362534519457_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZoFRma-TKQQ7kNvwGL_MYb&_nc_oc=AdrEctrMqtzJUdfDhZtuPYWML0ve6mlycony5368U2q1AOLSHrTRNaILvZkQAKsbI64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rt0PzaZd2KO68uMnJjQgGsLnjADjHSKR5pmAxGbxPhg&oe=6A26BC3B"}, {"file_name": "9f7f109d58f74cbabf829af06d916ea4.png", "id": "1193497182796720", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304764_1193497186130053_1984571114036074440_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1-zh2G2y4YQ7kNvwHzAvSr&_nc_oc=Adqts4Gn7ULficun9iEpbzgFg7LweL-7ApigEe23hriu78waRF7VsURCgnLJ5OQC-j8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85mutI1C0vr7xUgKwEPUig2NSZzIerbxtKKgDGEa1w0Q&oe=6A26EB44"}, {"file_name": "e8aa36d8b4c24d649b28b5fc7bf033e6.png", "id": "998338965993011", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308090_998338969326344_8045061657753469328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X7RJsdbCnwQ7kNvwGhLqUR&_nc_oc=Adoakn9Juj0--molsDgNz7roN8ErbUXUwiZBdaaMaJgP-b4aaEvRZqwEUwZdR56YTJ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mwwsQMzBfnexSlgYcFpCOIvzNXL9Db2IQPN9fHPB0xw&oe=6A26C38D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Runaway Sculptor", "keywords": ["party", "sculpture", "fun", "puzzle", "social"], "long_description": "Runaway Sculptor transforms your living room into a creative, laugh-filled VR party. One player steps into the headset as the Sculptor, while everyone else gathers around a shared screen to watch the action unfold in real time.\n\nEach round, the Sculptor picks a secret word and rapidly shapes it in 3D. As the sculpture takes form\u2014sometimes brilliantly, sometimes hilariously\u2014the group shouts out guesses, racing to be the first to figure it out before time runs out.\n\nKeeping score is simple\u2014just grab a piece of paper and jump in. For a consistent (and competitive) experience, try these rules:\n\nThe first correct guess earns 2 points\nThe Sculptor earns 1 point if someone guesses the word\nRotate Sculptors each round so everyone gets a turn\n\nRunaway Sculptor is easy to learn, quick to play, and endlessly entertaining. Whether you\u2019re creating masterpieces or total nonsense, every round is unpredictable, energetic, and fun.\n\nKey Features:\n\nDesigned for in-person group play\nLive screen casting so everyone can join in\nFast, intuitive 3D sculpting\nSimple, flexible scoring\nPerfect for parties, game nights, and casual hangouts\n\nNo artistic skill required\u2014just jump in and start sculpting.", "short_description": "A lively VR party game where you sculpt, friends guess, and every round brings laughs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://runawaysculptor-webapp.vercel.app/privacy/", "developer_terms_of_service_url": "https://runawaysculptor-webapp.vercel.app/terms/", "publisher_name": "Belebek", "support_website_url": null, "website_url": "https://runawaysculptor-webapp.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25995391986734560"}
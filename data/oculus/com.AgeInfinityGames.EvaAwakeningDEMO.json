12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMKEDsrSVr0Q7kNvwFpiL5O&_nc_oc=Ado72hyTEUfiNtLhSR-EmMFCR6uPDmO-B84x9QBjfeUmSzQOdqcKQZBH3v9CpPproEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx63JPsDD4Oe27Okr7fJ1ey8iRo8lZffPJIx8DBokWWA&oe=6A9EAF75"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdYnBDN3Y40Q7kNvwH9rWO-&_nc_oc=Adp_OkS5IkfSWL43eAaecdh63IVP0-lMcgJhl6DAlNAaF2GyKd0Q3mO8ZjJu72dSORg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJWo2g5qxutNBRoWCvz8pspkj2qNtif8tiYQjHqpcPgw&oe=6A9EC069"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWEsKOHEGooQ7kNvwEFw5aJ&_nc_oc=Ado9rmLABFItFhLksyVc3YC00Zv0mMrJoWvcAgnP25Xwq5LXVOnxlTSBz_8MV3Bh5Xs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDKoUiUEh9xVQ8PktBawzfPcuCdAUvddM3XLWH-VP0zQ&oe=6A9EBA57"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObDXQBo9BCMQ7kNvwHSH3dn&_nc_oc=AdrhMJJ57XNKimJqkAROvMN7N2WCjYCFHIGBPC0THhr86goVEHTAd9EaxXQ_Wlm4Gxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvkwYDtrFnqho6ly3tDcI1pJkmSYUlJ5ZY2BgV9Jt6hg&oe=6A9EAA7C"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDdPDs7Ivt8Q7kNvwGIdKX5&_nc_oc=AdoC66E8ztvkBeyCgWwTQ3VDleFTtCL2Va2cj0ZqJVmADuvb8m_jNh7CuseuZacVCyQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSOKlwqFzoGHppc_gvWAEkXrVJpAs09VBRpiKZuiOuBQ&oe=6A9ECA57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUVrGIQpzhAQ7kNvwGj-LRz&_nc_oc=AdoGyjEH0iuQaPcjTRWsKTN9C2kqYhQB03hVRf2IH4yNm5J9fIpAL4BiQ-oXl9ifz1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWnIeY92VPdeTG3OGa1y6KFD6zwOfsFL_7UqE2uuUNjw&oe=6A9ED84F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrDp79TMdBEQ7kNvwHg-FOF&_nc_oc=AdpTGTffLJGO1g8hhb93dpTIFoipiHhWLG4xAiQ1ZlVJFigkvaJljhZPgp3Cz7FSuRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrUcRVxRLTiPVvtxE1K_epWOcxY7RbCsnqoUJ3VEYbvA&oe=6A9EC798"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kruikpRuuKAQ7kNvwHJIaPC&_nc_oc=Adqsa8KEDWInVS47DbroQEV0mcnWkuPCzh2OeR6aUJsDKmZ63jxe8lWi__PLVEPZuGY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8WzywR04zvGXqKIi8HhdD3Knewj5ZJ_CEkoOovdGWqA&oe=6A942375"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwdgelnNG1AQ7kNvwHqROcJ&_nc_oc=AdquU7mP3E4sZmvc053uQDGa-zTWOZm_0wgCtbpOv1heANN0yqEi9OY-jjwL76oNaeY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETKtvRXSGD_GsYYMzpLlAefCA-dXJ2iGRXv9wVtJGBMA&oe=6A93FC29"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TLzhXXIpowQ7kNvwHBlOe_&_nc_oc=AdpIWHDiz7iPwfp0xDnH6ryn1FXdQlawwfvaNHrjZHNeYA3hVr6IiDXkaE6tE5y9Xgo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1MGuP6cENBPETadMpAV-maRYWxFCu1FTTgiud8WRilg&oe=6A942E57"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnbbUYXa9IAQ7kNvwG9oFpE&_nc_oc=Adr-6RSKMcWBREimaNlb1BEbDjaJt0aYbCfGLdlD6HKjjxIw_Y_1mE0xwsUPQtLJ2H0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw0sYp4zQ96_SJWqRamN9fZ6F7jezr_hnGp0-VJffzmg&oe=6A941E7C"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qn6WsII7IgQ7kNvwEyblhu&_nc_oc=AdpRgw7dB2mzB18rLC_3PF7KxKobFdq0BwcpqhNEwQ2CgW_bYMrXcK1JPL0LUzgnclg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXJDw8YmTjKPBGLK_aTSoQe5sa1IBYX_3NvC7KEShKug&oe=6A940617"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTK5CyMDfeMQ7kNvwGGl1gH&_nc_oc=AdrzN-OUv73tbQQcBo63jXtG0OjIyv2MQYKXwUfb0R5gP4JoFXfC9TEVlVvxMTIfvlk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElzfLbWeVp7tr2tIlsq_pTQgPl_wNF-j1neIzXBF6C7w&oe=6A94140F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7JMa_AaRMMQ7kNvwE-xdKD&_nc_oc=Adp-vy_zDuJkJ1UP4-Ql7epaegnE_jWQ6hptmKvj5-WNO2bV6cRFuYL_d19a_1Y38z4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMTZZgNEXjtf2jERX1q8sPKJiAdvcONkDzdjZ8Om8Azw&oe=6A940358"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeyVIm9izUoQ7kNvwFFz5ce&_nc_oc=AdoVs62vW6yxmbpw9trZS-9bkNvDTh6oUv_hqK69zeJSoqWE97FfbJyvINkqIiX9JzI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvHCyszB7rkb9nYAgt25n7NYWufhvo1vm2rJe0u5qkWQ&oe=6AC7C635"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tl3sCsIifIQ7kNvwGlzYCh&_nc_oc=AdqOyy7Yshxpqf6JC93USxY0oA1R4ei_WzHDmtcLSU1M1cz3Bfwbq3bqLrQfbdxNdrA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ3n3G27C8OC3NTu4Q1IYjTVXghtJse0ZyBaxLsteNoQ&oe=6AC79EE9"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zn82p9nSLMQ7kNvwHeLCNH&_nc_oc=Adq23XCZJ36S6N_x2IH32hCcQcObGy8ImJ7Sn7FnRTT91tjC5Y4wDjcKNj9nrD__VWQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRPi21sOq6FIxyaG1eZsjSG3KWCzI_mQH7zZQqBvNbWw&oe=6AC798D7"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMh5SnEdVsQQ7kNvwEUhA-g&_nc_oc=Adp66gq3OyqPS1yZ4iFCu2ih4oM28fbyVEZSrb5j79sMdOJmXQXBp29cDNYldKTwpRA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGvS88RC53GbOH6nM8HVLVm0JxMFp4NjoRhdDn3BYSVA&oe=6AC7C13C"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scCfZ2Klz7cQ7kNvwFQA_hd&_nc_oc=AdpzBMSm1veCC31AZg1LhXAwMeAkNun8sk3WQBl_aaYQqbp-NM9DkSzMTvV5GGffztg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYRIateLdsF7ljbNZr4JUxE1M5V1a0z00vEniWh7_6Xg&oe=6AC7A8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1uhaboJNaEQ7kNvwGJ_ovg&_nc_oc=Adras-iIQt0HwsBPmIIKUMvdua3SrbdOoX9PM5HO5bV19N-ZROrP5qTbUE_vi9gWFNY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLir5udN024LZ0TWAdfXQO4-sD2jnMxs0cJc2Vm0pzJg&oe=6AC7B6CF"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jf2jaq3MkUYQ7kNvwHs7G0i&_nc_oc=AdpfTYTacnH8Qej2NPZyHTbdsu4HFDHNUV6Cf43c-XdIYAOiwttj1RPOlAiMu7yQTQA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqXdK_1xCFChzKHFlATu_Zsna-p36w0flpy43jOxnWmQ&oe=6AC7A618"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
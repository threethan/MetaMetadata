12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpjlH4zMA1YQ7kNvwE7Oq9p&_nc_oc=AdojY2hCuSazpgwwG8b3HXMv2MXP8vNyi-sBZZX2eBQ6C17J8HqErG4_NwEU868jpRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8wGyRuSpBUq0JRKTyDH-FiFma-emsTJyFKbWHe0MKvg&oe=6ABD01F5"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbv9bXGOBFoQ7kNvwGmVisO&_nc_oc=Adq44VmYz27h376kW9vGVfO_SZCh0Rki71vhQd58j8AqahZ26f4XvDZUDnImeMVvHps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlnq8GlRj4ZVEcA3t8GhhO4aYV1efArUsXhRcNXGUkhw&oe=6ABD12E9"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G-Qa6UxRxoQ7kNvwF1W_0p&_nc_oc=AdoKxJYIVH677Dt8TKhRLer2OrdLnBoLZwUiMpPiXMwub6A4TqasHvXibxqSEjGu0Uo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJubdUwZCey8eUOGlEfJyE7M9K7EJS9j7SIS5FAVeKgxw&oe=6ABD0CD7"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pji4L27n6vcQ7kNvwHJpKhG&_nc_oc=AdqPTP4iH4h3Z0hgnRb-q_wTMAsYxnDn73x5YFDkQau57ZhUUMipIkCwa1mZ9JX0fKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ1nnDijYyCEAbVa_TJWUaImj-bytMifOzmbLPOMjR1A&oe=6ABD353C"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuH0knCedcoQ7kNvwHkQSQ0&_nc_oc=Adq-aek4WMkC78tKVplm3XdRbgfl8JkW2UCM4VGpfCL3d81H_QYL0zx7PNCPOgvwYmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA1-dN2ZJLW5Qw884Lb5Vk5DZW6-ML0zo1uD7f102eVw&oe=6ABD1CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG6WjYOsSXQQ7kNvwEMzBT4&_nc_oc=AdoLCeRPYyhze_iXIiCXh2DOTfGSsW1BxgqqTxJXOWusjwO3KW3K1SCcYVC4l3jNFrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIufg76fBnwlcUTenaAQ0R-PA0lzlO5WoCWJNsBpYzXNA&oe=6ABD2ACF"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUzTJU7bOzcQ7kNvwEu-zWV&_nc_oc=Adq1iqWZYe-gC0S7P8lQh0eKLAXHENxknmyqR9jfk14F8tOdE33xPAxotOenI-EjGnI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLrJxdiUCjV5gPJa__Ce6boLj3xnJsM7nqPzN33mOrgg&oe=6ABD1A18"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
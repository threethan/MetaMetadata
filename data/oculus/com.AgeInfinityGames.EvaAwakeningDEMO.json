12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpfwBIl41asQ7kNvwGgeS16&_nc_oc=Adrzh2RQIVmKAg_fu-lyXg4WwbmIH9obt_pkFtNlynoSfq1NTAcLbZNbxtYyBSnc8bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJISoL20n3Am4_JaNH_zQUXqq0qzQZBSSij6DO1cgnVGA&oe=6AB3C775"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xADuR1gYR1sQ7kNvwF1-599&_nc_oc=AdqCH6DcfirNY_LH14YZduvRIb4EazGJokPOIkxuZPKWbFoDE_VYVwNc_Ygpe9PMVkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBU7q1tEI_yGaKaMe4bB6gICL3ANZafhFal7JMVPHRhw&oe=6AB3D869"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knNWmZJPFEoQ7kNvwEfgyPN&_nc_oc=Adpu968mkduKiiqfEjMrhT75V32Yx5jmI5QDeSZUevUMm6KH8W40Ue4_xirtFD8SFrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK2IW0Bk1dLjYBZseZnYWeMtC4q3-gbGzRWtee7pt8Rw&oe=6AB3D257"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUDH8-QLrikQ7kNvwFKWomw&_nc_oc=AdqPmE7yXH78daWPQ9XYl-FXakzOT2svrp3p8Zoej_YbC9nrAYfy4H5J2hWVqwPlc_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPmqgtBz6ctRJ6uOlSlNVgZrJs0fA_GrmVoyZjhJzLrw&oe=6AB3C27C"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Grv7tkV8IgQ7kNvwETP0c8&_nc_oc=AdrgbPxrfL7Rm5V-iI4LU2ZKEEXHT7BO4W4a6N8Ov7kTuvvZJMWacxsvIdzXu2_oLNQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXvo7XDksMFN0r8uRhrdxbH1Y00DuvsDpeqQz9HMqVgw&oe=6AB3E257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6a3LcSWESkQ7kNvwG39Q_h&_nc_oc=Adou7ehLDBO3ioU59btRBhMdJENXw_Orm2fC88QkJfVlOGJ8S_8e2Vux4O8rjdV0BVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgM9s6ONjzdgY_8i-gchs2K03bPZnwLZjLE4PtolvoxQ&oe=6AB3F04F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUxR46ZBBxoQ7kNvwEjbIfu&_nc_oc=AdoWotWjlLMO2HyJ5mf-blt1uZgAVsX22Vz8AbshtlE4HdyFhm9ZTn6ukMoWHuYnpHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjK6jjvMzeVIA1VRFsyeg2JAefhxeC_AafzWGxhVjt4w&oe=6AB3DF98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCqRCl2JiFgQ7kNvwFDdy3f&_nc_oc=AdplJKWCuk-4LiCXTCNwJAiyGzZLflGQyRJpN-id9kPZE6Ki_dhCqGvJAwa7pZz9i68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPhnVhVh2orAA50_TAlxUyFQqCGS4bOUVB9hLqrAB0DA&oe=6AA69875"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPMKnr7atIkQ7kNvwGeSgKh&_nc_oc=AdrCWgewd6e4H_gUjuwF7ly4pJmroKDeBzIwUTsrGUtjiV31F1dObsSf9-iBWMi37OA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyijM-42pQpj8VoCb1TtHlfIJHja4p9KxyxZQAmfP5zg&oe=6AA6A969"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9LW9pzLZWwQ7kNvwElr9F1&_nc_oc=AdrwNILYoTg4qOjA2TVhKIhTrUW1RGG2ik2JKV1VvFtrB3HCvcqyaY6cdc4UbSXX7F4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkhX-15RUr9uO93Ll8eLLxmdOycLluarKJe78MKpPLzQ&oe=6AA6A357"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKbNN35vV8wQ7kNvwEfxOog&_nc_oc=AdoeiZh1RG8Pbo3x6K3HilQG0CVJav8e1AYnUSnK0ecZER7DiE0GMLRp3rW9HwIgBKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICqj97FDzN_6ggk-sKocnh-VfL4xLagdH3kvzMSuY9Ew&oe=6AA6937C"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19tjo4h_WFsQ7kNvwE598N-&_nc_oc=AdpWBL2-ioNdTMhQTb2Mo8q_S3fV-8ha9ILcFo_HNqubYk5IHUsj5vjdn8v1DAJ9qFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvGwePRH3Yi8y7zxXYKFbS2D1bpTRM5qc9KngJW8PDyA&oe=6AA6B357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk7D19JFTqAQ7kNvwELlphE&_nc_oc=AdpSzipe9prlFNCS6MV4FVVOlOvlHSUvLuazp6EvPooogmPmgoNU5SFkWYn1lXedqcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyNNuNKRZ7mOghSbQ_mGelN8m5RQbrLXhRVcbd2lsamg&oe=6AA6C14F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwksiSYBv-EQ7kNvwE1lcK1&_nc_oc=AdqQ7MJMHk0hmZM80y-1pEVop5cmzwQrkwvHdMAy9Xn6Nk6tPEkMKcDRy_gdTISRVhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN26kQWUaipmBiCaYhsfCvZIYe1j3kDBdCt7aCBVQW9w&oe=6AA6B098"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhEXCqSPOkIQ7kNvwF8nRHi&_nc_oc=AdorYHwWfRTmVSSXJgKlvy6-vV9sUHDSSXKkj2NXPqSmCf1PVolbiFJHB5D00kMMGSQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXze8wKhgODlKPdq1pX6y3wYQvqWapD-S-FA2mKjAQJg&oe=6AA15275"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fxN7aOcmh8Q7kNvwEQtq_K&_nc_oc=Adq7Tu7ULhjqQ96-P2UNLbxB507ITWbCxEmifXRSPIX37nz47xg8yCt9b2XbN8ZrIcQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwF2CX80EEKEdHX-9HzYQh-e39o5EDjlzRTWOMiedPwg&oe=6AA16369"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWEsKOHEGooQ7kNvwE4xr3U&_nc_oc=AdrHsTDyoGDlGPaKOjGhlfCkEseY3uU9_c0VR2LMAyfcqiZCq2apyoa8Ee1pq5M49hw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2aqiZ6nSqqKgS9M6xrM3wpPYsdj-KlHmoRNjhGOdi5w&oe=6AA15D57"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBmuG7Au7c8Q7kNvwGAgiDW&_nc_oc=Adq2HLji93eworg5wiQKdBkJ9VjCa4i607dsivxRpS3gBN-uPNB2zSCja_x8iE1jSvQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSugxGjk2hn9JOLQnJeqz-F7HbAR503Nl1FSnocUDLOg&oe=6AA14D7C"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDdPDs7Ivt8Q7kNvwF8daNj&_nc_oc=Adpqb6HNpHWnf0jDHngufXa5vyTG7WdmTtUPXOx-2YbTqaYvy_aM9_ZQvSTcPR7r3ms&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1S6xLBeu1cJ46T_2iaXayxWDqHogidIwb3ECrbeaJ7Q&oe=6AA16D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEKvfu7nQ_IQ7kNvwFJCiWX&_nc_oc=Ado3xCS1wKSaBVfnT6b6Vv8dzSuWS_24NNAFEzMx5qStd8IiIeZgauZj2PMlxORuWSE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXtW_BHmbVNZ6dWHn8-D_HWBtvrZVsgpPgZYhwqKZUcg&oe=6AA17B4F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mn2YS_UCJNkQ7kNvwE9549W&_nc_oc=AdpxeecAKLgh9zqyH0E3TrSCUQ6jv4mMuDoQ_QWr_KlC2p8VbRpilGAleydwTwx9RII&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMQgelBcnmStTv2nUxockWTT4JwE5SLwqU5XQaTdjRXA&oe=6AA16A98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
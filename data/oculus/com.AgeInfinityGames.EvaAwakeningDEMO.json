12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eeJBJQOMy4Q7kNvwGR-sGU&_nc_oc=AdoNPcf2xZD_0wG8LDGnHFpQ51L2NPQVmctZ_2sQXPXDfTIO8f-wT5RIZpVCz4DJWwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_lncKgwVLLunV6smP6kYdKVWc8HVFCcDn-Zcl4DvbMw&oe=6AABDE75"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eHqoYv-bJkQ7kNvwGZ83Re&_nc_oc=AdrYA_edIYxy2Tyu2iug7SyaBi4Q1k224nRw9RAqcKXV0eKRXfSLip1cqVfm1rpf9cc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZYMkB-RqpFzdTHw4mgS1m7ISNUZo6YIqX4WpBuPUZSg&oe=6AABEF69"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JTH0oLxjf4Q7kNvwGeFz-T&_nc_oc=AdosDlHBZPNB8MnjpsG5bpiVjWnD4AVYHuQt14hL1RKckNrQ3Gj9FuGDBdDDdbdUkgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkqV1GhfvzfFrnimrflPjcwqWrAfam94dpebm0aLDGvA&oe=6AABE957"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDrvR_47Uy8Q7kNvwFmC1tI&_nc_oc=AdrfbvRxFysXC4egZ7DujGZFt7Izlv2lUxhb6YX3bpsjgfquEHMwLITHcmyx-CoaYuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb6-j0QazCG9atXRJyEq_N6g76DLuRuDS5ooK1cyGELg&oe=6AAC11BC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pi0qiGFO6d4Q7kNvwGAwTnc&_nc_oc=AdoRrE17Rne7t1ylYSXEVq4tHeXIP-0SmYDPxtkTYGJqCQckJQX6YVDyyYErAkf9njM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFrgWQq5doDEoMsZe2omIRqj7ixKi2KuUZixVuovpeow&oe=6AABF957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u_GIgTdICcQ7kNvwHOPi4p&_nc_oc=Adof1BMi1Kza19wcNeKyQl09ALne-yyLFsTFjCnzmCBoCfRPxUrxgr350yFSiBi7GZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4nmveNFdFDGV1q3O_t6PXPUIOIHX4QwEenweUuMB63w&oe=6AAC074F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThlhSbIVRWEQ7kNvwGIs8po&_nc_oc=AdrLJ5FYvVwXRMDjA57PrMiUQIg9qHDkgcA_oKmUM-52fB803pWkoK5AFjOOHFtFcAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZULSuc2Y4wjFH1GGHw9MQ8vvjYT0uAdLoxllpdFhYxA&oe=6AABF698"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
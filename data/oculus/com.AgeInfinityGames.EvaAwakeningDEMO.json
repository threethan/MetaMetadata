q0F7LraKbzi4oUkuTE3WC0O_Hk7FZD41PKqNaVcsXZ17PxiWIDYZ6OHgeYmXIDckk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5-cg2lV1nHgbBXs0_zKcSnvQtRzPA5aeKa3qkKZzbxg&oe=6A9029FC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg6k7khACCUQ7kNvwE5rL13&_nc_oc=AdpVHFHQ1FXkf1ZCNxidln92G_rwdwK7p3OVKHmUmpYLW2SsDJLX6ZA8uD04QoUqZxM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5VVSfSmgTvsjyoe79AR0xsLcJbbmDPmYN_jb-kunB8w&oe=6A901197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jZfPYRnJqYQ7kNvwH2s_bS&_nc_oc=AdrvyyB-Y5mkVcDLVfKkc2Mk6Mb15isLiarI0CCUu7ilZzJ2QPz3Nv4tdfQ6H0RVRho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ7gsAQAlji4oiKXUI_d2raxnKPMQtxiy9ql0XQjMtEQ&oe=6A901F8F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1739918377023550"}]}, "baseline_offer": {"id": "1739918377023550"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784758140, "status": "PUBLISHED", "id": "1739918377023550"}
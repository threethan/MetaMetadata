12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFhw74aajwcQ7kNvwHg270O&_nc_oc=AdrUpMaWfEVslB0a1wp5naW6GUwtLLT6LJlZzj6ACAYRf51sagkiSZOgdhoxPQUMmrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInef1yfc5hzsIt0G2wImvwjo2-zUu0282Ed2hb7csz7A&oe=6A99A1B5"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgJD7-7QP5QQ7kNvwHF5ymV&_nc_oc=Adr_NwH7l9DpC5fINmy2r2oMooQm1wmcA7w0MM2kIHy6GHb2Q1_sQoWwhtCBM2fvLD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr2ejsRvink6G8ARzbNsk72sznT2sYaF80zF3pEEWL8g&oe=6A997A69"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUNG-rm425cQ7kNvwFuT3xK&_nc_oc=AdqTBcsYWD5DtjGTtGM4-TcaW4K-5AJpeUvbk9QWfeE7taOkOoX1GguLqZsJgdq247M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIalz3qb_sAR54oFWZlCFwh4_NIXKEUfSTGIhNCheReFQ&oe=6A997457"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLlHfWHp5VMQ7kNvwG3A4XO&_nc_oc=AdrbbwfXAycR6rQThzxGVEkUmzSFhRA73-Jovpzn_4IwcId9lhLiLCqXoA6sOCtfeoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGMLsGi3zdCcpZKdSWY8MZ9lL11o-NzuOH32fQDAd-cg&oe=6A999CBC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHZJCZ4dc_MQ7kNvwFfDs7v&_nc_oc=AdpXXibf4YsNpWwlMiWWgLpuArzLLM_Pj7p5qw2zhE-HuNuGnhszlgfablIRjbaivjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMsu2RLPAkqXBWFcL89sD9L-RN3pYnHv8Hx_lJ94GDnw&oe=6A998457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvCLkOrGHLIQ7kNvwFcwGuh&_nc_oc=Adr9k4SR01v-jGHspulV9sSJSwEf6JPILEO1p_JeVMqlc4Cs6a1wVlF77YdpWXoKbFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpXnIbj7-Ul4Mn1Slv7bXRIg5brARtSCQX_VtowtJmNw&oe=6A99924F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRJxkwJmqvsQ7kNvwGEs-1V&_nc_oc=AdproBIzKVnvANpFu0P4ue48G90UPCXc-48lQowz-JlKMnSlIGU2JdvvQkwVTsH0xVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH5nAUBNfXCByg9c9BJWwFJkPaFgalfcI8WroyMUT4CA&oe=6A998198"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
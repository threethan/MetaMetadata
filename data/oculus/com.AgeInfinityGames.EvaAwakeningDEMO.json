12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcwNirberOgQ7kNvwGk1o8M&_nc_oc=AdotjeIDW_smeJAG1wB_HgS0pnJvZ8mH983wMRyKitIM3-N9Zd2ybrCKNu0Zm-f5ZiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtAQOwtD7IBiYwbBoglYsvZNOwRQe1Nc-YtMni-mQ4Gw&oe=6AEE01B5"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox790BXDDHIQ7kNvwFmTIot&_nc_oc=Adp8HikihuqJZZYUFsSnbk_Me0A8jZP3g4-IG7lDL8zJoOWWDx8SQrnQnE-TIJ2HqoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDGQGpEV41sZdIz6PPgEj_VDv_G9AIwZ7uCqDwPXkTvw&oe=6AEDDA69"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhJUmsrxB8wQ7kNvwFRsJeg&_nc_oc=AdphMQVluQCedCa8eDYdO4gB1gDus9yzgjfonnUf1NSZC_z1T6yp-IMF3Z7XV3CcYQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnP2C7J605pcJAquoF_FVw0dQcz-HrXZrZ0c5Yxpvexg&oe=6AEDD457"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULtv7nLy8TEQ7kNvwFM435U&_nc_oc=AdpTBHNrs9TX5s35f0az76cT5fVlboiLIWGcZZk8vhwXMMG51utRRmuwcp60GaMxfEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT99qUW8bJeOuOhJytip-GD-wUP89OdoOgoAvdaHpMokg&oe=6AEDFCBC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssQCq2jhbuQQ7kNvwHJHDbi&_nc_oc=Adqp4Fs67qUNPcDOt5oI_5XFeLy0zDwZgyJfR2Ohfw6xP7_HCkGlWLQq6qmSDl_4otY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGg3WofwtWlYxrtvpcMziJy1s3zzyh-BmoqeWdz-Mlog&oe=6AEDE457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4X1AcPnYXIQ7kNvwFRUwI-&_nc_oc=AdqSXd4iHunz47y_l6qjz1kBH9bNI8_Wq7tPJNpdJOtikTzHXGarCrjlFTkJQpaiHOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCe7JzkeJyPDczwXbxDC_zCZ3AaleQvSFbMwZydTzQzw&oe=6AEDF24F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvZAksPx4WwQ7kNvwG33nIU&_nc_oc=AdrpCASHfqam9-wNZZdGZ6Sr0Dpzma_reE7kqvxTiG9TGn6YK589K2wWv_N3ESuRKGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1woX8zJdh7QokPcMenjNnbYhp4WFpZUD_EDHMIt1pbg&oe=6AEDE198"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
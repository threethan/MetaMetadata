12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpjlH4zMA1YQ7kNvwH0c4Yc&_nc_oc=AdpqNPytDN9WpiUnsQRYfKqkXWcNdTADxRXayA3izoPIy10Fp_0sli6GLumvK4xdG2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoZ-ioiG0hjTwaVJY4lanlBP82poIsLH_KSAGL-1zl6w&oe=6ABE8BB5"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbv9bXGOBFoQ7kNvwFntwe-&_nc_oc=Adpevjut1ogwyQobBZMXEEPDw43m4EFfHZBTBVrlYaOz9I2OlQMY-NJYoErlxl5TadM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKDWnEisV4NM820XM5peD41uJgh8nFVY_3xqw5Dix1xQ&oe=6ABE6469"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUD-Qjw6uEMQ7kNvwH7YLRE&_nc_oc=AdqqHR3Xg8iXyztfXbri5oqr-7frXX1veE96Xog_wa0ZArPXHghoAnH4B47dFvcmno4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCHkDG8oe7guLSlAGlT50GOhQ1GsFpkTL45J4NHMJoFg&oe=6ABE5E57"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pji4L27n6vcQ7kNvwEuqpM7&_nc_oc=AdqPxfcD5RIG7q6oEXVnMJaI6Ux5y93viApR5gCOc6iQA_kXE5w8I3XVCQQ6oJFI1PI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQx2GS5XhPo3pKJ34GRnUyuRNlpdRk-iUbFHCtllo06A&oe=6ABE86BC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuH0knCedcoQ7kNvwFaMZvE&_nc_oc=AdrzPLehSovAzHRV2sr_F-e4deyvVPYd_4wMqhtZGFGoLY6_9RBrm89sFS9kPTCMI0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICphDR3I-vYYaYsveO41GThVbYm34G7VPVP77MfPSjsQ&oe=6ABE6E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG6WjYOsSXQQ7kNvwEgApJ-&_nc_oc=AdqIkWXOcukldH5ifLfukG0bqP7_mCkkPPSNM-k4fUFpuEVbI2hDEPPdckHtzNFHv30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOoBOLYCEAgpu4mU3rZqx7TFTYDI7TkAyC4Klko6R2cA&oe=6ABE7C4F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUzTJU7bOzcQ7kNvwF9bjm4&_nc_oc=AdqW88ATfqqh4OzsKMDJYnFAlI3LWIlL5lYMmyX9z8KhQXAef9dF2bZ_XKhbuAbtT2A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl8ZcRYKXseC9R_TFm045V1gweiUqMBGeFcHiMWrzWsA&oe=6ABE6B98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
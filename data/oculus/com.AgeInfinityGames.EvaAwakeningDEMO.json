12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGY8nIGJlIIQ7kNvwH4k-uq&_nc_oc=AdoGOzGK0xpooFI3Idl-NwD-JDV-unrHdM8i4TcPaTuKL-9xh4BVuI6U_ocqFMnK_Hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwb3bPD3qBUs9tvYeB1MmThehCX0QKIWLbXvMFG73QxA&oe=6AE48EF5"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX9aVSEUqP0Q7kNvwHD-seB&_nc_oc=Adp-VB_82_K5CCW0Eu0gnK51kG_gZYGCMN7XRu8bWaa67ULi47U_IEWr8ZycDy3G3wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTUbwYr4o4LXnEb2RMLCoKkzoSWGxzAlUR7RtiAAyi_Q&oe=6AE49FE9"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I6HyE4o7ScQ7kNvwFVfQ5K&_nc_oc=Adp9bSGEqwpbGQXsYHZ4AEHDoF_6ornHzqF03ExW29DMwfb80azdWVr_NNYOOFUBeqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWOoLTGnO0UJY1ewLH8C9n7pI0pzClvfnRpB6HR8hsbQ&oe=6AE499D7"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YyTPN298XsQ7kNvwHvzYac&_nc_oc=Adqn7OjSinSIsVBp27P3SnJGzge_tdI2dub5VHH7wW_nxEObdWLd0F8SOKOGrGt3vQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMTh62AW2xN1nW3uKK3Kg0V_7sq6viSDv-9WukoyCQ-w&oe=6AE489FC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcfab_6WUhMQ7kNvwHA4G2u&_nc_oc=Adoh3ks1Mfj6SLUXewcDSni9bOf8N95uerKzxbOv_X2n3UxiSiD8-VcUXNSmyvzLRi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc_ElxTMBHvy828_TnhWUdEbjXWqFxNGj89dMzzDgfMw&oe=6AE4A9D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdMw9JDn5DwQ7kNvwEuSdUW&_nc_oc=AdqrLK9QBMRi1kNx_qYBfQXRW5ELZNJGacT4KsNh0DbhM5etwTa_tanPdnDDSqwz0-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEZLCaGI77CdI3Jte2iKEZSYSPQmWlIPeRntqehBeFJw&oe=6AE4B7CF"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO8lxtm5HKwQ7kNvwErWlsk&_nc_oc=AdrN3F1WKksW-MN25HEdmFF4PC-H2g-WE7lKqiUiUV5qXMHlEWhKV4E29cAM3F7ObGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm-src2YZKcWAMCuEIuR1Z1vu4luNZc1UfQIENCAQSFw&oe=6AE4A718"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI7672RkSjIQ7kNvwEIcahb&_nc_oc=AdofxwRQCBTwxmAxwhEVFazuwoUs3FeSMj60CDK5Htz0LJYVocp1Aviek1kkuWF3thI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSGqSjl-xd4j3yyFajaML5jM4ACmQwlFv4hFeWtuynOg&oe=6ACE5DB5"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRJPO3WLxykQ7kNvwFm83BR&_nc_oc=Adq_lQ7b2amPYFxfGSkZZJSxDg7tRaWAJZqBw8wSfQPN0ObrEcvPIyeZOK8mI-PQZ-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSj54XvdVBGcPIJ_v6tKWZc4XO-NyR4p4keHNzScOUcw&oe=6ACE3669"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y7Hs2Eq9V8Q7kNvwFRIFIY&_nc_oc=AdqsVTKMfcyaVQu5HW4m-hPt0kWtKUSYcxYeI0n2NMqTHKi_poEZARtTNjULANObIzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbxYRrcG9Ci8-mCy5cpcbu-EqmWuEgeu6P7O5EKPzu6A&oe=6ACE6897"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHC8LkANNBIQ7kNvwER9Z9r&_nc_oc=Adq04qkrCFDHedp1Cxy_NGkbQuqpjVeh59Gjt2JjKTdX7IHs74juBGIrc4Qw3P51BwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeJ4RiOB2Q4Tzf-RkafTsFBJBtU_bnjm1lJW43l5EOkg&oe=6ACE58BC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY0PeYUi4zYQ7kNvwF2yDbS&_nc_oc=AdrHTGCzGyQblPuqLs-Zl2v8KkO3HB19UmnNZjGcpEzD6yVjXAruKbL0YJM3Cot7CuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgBPAe_YR1kJpumodrCFK00iLJHYhDnEKMsiggHCAwHg&oe=6ACE4057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiuaVbNO8EsQ7kNvwFfS2Ry&_nc_oc=AdrLJr8rQ48mnxrIm69mKbZ2EAbIgqA6rv4T0m8l2XNhKsi1FnFBal6HZv5S53zKM0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB6Nxfi8CoADIvJrfYYOPt3C5uSGaeNTgZusqIeS0F1A&oe=6ACE4E4F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F5bmOmJdUYQ7kNvwHag9mT&_nc_oc=Adpi2_PHVbd4a33kPjLTc9_a6TD8cjbQhbGnmlAZTxPJ78oXObzbpdVQ8qzTTte4FE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAvNADpqP11td7ER64aK-M1UQ24XL9KD5DtS0HPzrVEg&oe=6ACE3D98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
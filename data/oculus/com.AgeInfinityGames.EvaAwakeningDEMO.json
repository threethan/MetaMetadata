12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kruikpRuuKAQ7kNvwFfY4Wi&_nc_oc=AdoWqnqpQACdOcnSBfgZINSw3tn2SggfNFFMfwGXzoCgymiSPdQrriTuw2-o2As-XQc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCvVF74WS9oXCD-b-G0CdtX-8oJjzp4APJmcWX8-_idA&oe=6A92D1F5"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwdgelnNG1AQ7kNvwHRZtTs&_nc_oc=AdrNJHQ9KVg9nv3bR2ghRBxJHE5qW49-_irm4W9sBg1Do-YW4hsSFZnUS7xQpt0i_WI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7DCcAl3oXaTEZOMmULxWFkk8Xc5AnuxmpBcXnFzc0CQ&oe=6A92E2E9"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TLzhXXIpowQ7kNvwESrcFQ&_nc_oc=AdrVUrF0oLSO7yn_AVdMYWlBAcqWYnRUJY1pkEOqBq7Qx5H2sB6BkajvpgoK82es7rk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBvMkuaUcKieawPhud6WaooODfCTe9SoFcVH41Na-IbA&oe=6A92DCD7"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnbbUYXa9IAQ7kNvwEx-hEx&_nc_oc=AdpHhg7X3R6d74XaqK-71mwVdFRYneFVpF1D6Yv6DVSwK19mpN2iBAwRJBkW5bBBVpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjQe7Q75lavYwujJVsMIZuXT9D3_fL-TG5Rnbg3unaEw&oe=6A92CCFC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qn6WsII7IgQ7kNvwGHYiDB&_nc_oc=AdrIK0_RixP1D_k7IJ7j2VHjYV1DIco86ma-1Cs7hL4ZKOlXxFUCD5KFpP5riWdDiNA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg105Epscf0UQ_TmzViYyS8yQmdNiIBZYBZFIXMy-olg&oe=6A92B497"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTK5CyMDfeMQ7kNvwGe3OER&_nc_oc=AdrJKpKeV7hiymj8865Bp_zWImy2TPMGo4Zn7O2AU4-OM5gU9JOJe7ocgQyX_X5aIsc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0dbYOaK43Uz0-_GvQAN-ky-PpkoTdVn6mAHFalYlQAA&oe=6A92C28F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7JMa_AaRMMQ7kNvwH0ohOI&_nc_oc=AdqEPooFofvNfIKjtXoJjfMWq5VgckmrzEbRt40t20MJsqDpphfp-z-DygieWlNqOLU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkI-usuQi3PePzAbSr7jl2m5CzSRCW-V0n9DzzGAU60g&oe=6A92B1D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
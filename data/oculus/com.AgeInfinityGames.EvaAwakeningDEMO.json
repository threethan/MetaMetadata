12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMKEDsrSVr0Q7kNvwFF8ELV&_nc_oc=Adprjhsfb3FbvwTeLBy97SCe2BrOwS5WLJL0grrrbez1IcF1lQW9tnMF2OsgiAKI-uI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-iPbR25hJBHYYQOZaI3gmqjRyqwG14JJU9MRk4oshOw&oe=6A9C0C75"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdYnBDN3Y40Q7kNvwG2G4_h&_nc_oc=Adq4gNJtXitA7ciwiUMylR7OdLF6ZkVT4Mjrh2liMbOQakBq7abmzd7Iby1dc2WwMtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5LkCAp7kkoGzmPQeIl2wCLh9ijjOS4xpx5d-SC8iRHA&oe=6A9C1D69"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gU3cqf3q4EsQ7kNvwGjX_UW&_nc_oc=AdrQGUVZArLUKnw-zdKSJFHmi_lHsxCAi-jtISbtYH1ZvoW1mnP1IHAk4TvPt-0RNqE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzJtE2HCfrxMoS4cm8o-7oByvL3gW5m03B7VKDOyQvQA&oe=6A9C1757"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObDXQBo9BCMQ7kNvwFrPm_m&_nc_oc=AdrVdRQtwHpoE2aW-4rBMkDfrCNNPDsBMJHo9qjc4ZfWMNgwKYpoEkXw1JtwxXudz08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLILrPtmb59Ns3aT_ttlWXcOyOubIqim2kRjrC7gUEBFA&oe=6A9C3FBC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHZJCZ4dc_MQ7kNvwE6C4LX&_nc_oc=AdqrJ_fiWfCWTHhGUigKBVoisGSaXnd3el-GZ0XeLd4XmxWFwPSJJLnCQJu6V--p3i4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuXmwIZWt-7JfkDIee5mEI33zAtsNWf7KV9rMri7Oyxw&oe=6A9C2757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvCLkOrGHLIQ7kNvwHe6tQP&_nc_oc=AdomPj7Bgairu6Ydkb9GEVetSyHsQ3XqZsPJ3_I5Dzto_pAaIt9imFJdTsMgvsvJgaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4uSG4cRo8Vd3GtRwg_iDAAzRZUx95ZWfnW6w5mV3ldg&oe=6A9C354F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRJxkwJmqvsQ7kNvwFsSCW9&_nc_oc=AdpnQpsT-GH199Dc2z2K9WJ1UiaZZ6p1k0zRQLEppW8dN_dxidxt4dIPoa_YC_Pp29g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9O1_MXGbSOHWdE9IxaLBcZvwXtzbR-xe25jkn7haclA&oe=6A9C2498"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
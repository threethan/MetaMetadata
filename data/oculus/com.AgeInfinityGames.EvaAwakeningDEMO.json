12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3aB6DUpwHEQ7kNvwGzl93P&_nc_oc=AdrTDM5GR_tVXIF1Mf8dr2lB0kZhBbXhinb-A7bNp1c_mgXX2uRTWdVzFtxvyCOU4OM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNFE8XVEtXJM5UDTnbGFMIJiWMELjZ-xdY_jx1NDTCJQ&oe=6AF9DF35"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPf6Tkw8rCYQ7kNvwGBffre&_nc_oc=AdouDU4BxZ1tcnvsDWmClpb0z4bYY0CXULOf_avv5oeXLXsx_aNivwTADS3lOHfrCHI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq9fejhu21gV6i-gvkQnDyNE_r5Fzs0W3PA0_k9OdrNQ&oe=6AF9B7E9"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c368Wvbs5IEQ7kNvwH-MiJA&_nc_oc=Adp--1qcofIGa6eHHrmjYaJZK7rCt-GJ5vZ-UCX2kF6IAg0fP6vW91bqxfFLQdpuIHs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeHjJd09zdxzL4B1P_erkLIOA8j48MM2lg8fjNUZQnqg&oe=6AF9EA17"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5gjIvewJFgQ7kNvwFhYeTI&_nc_oc=AdrcD-Ms7ndTxxeQVoUE_zDzarRBHXgaKsVTv_La1ybyAGgwPO5_G9zzvzn-wUzF1WY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdzs5C-t8PMa3GnTiEt06eqIY8DpmCFenWwqnY8UVd1A&oe=6AF9DA3C"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlTv4TS77tAQ7kNvwHQ9c0t&_nc_oc=Adq07JGR0M1e0NOIW8LJ0oJhmpu2Z9b1MIVqXFERkxO36atdr0XaOJim09eCbdK3OOs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd082F-lf7wFtn_qzk9Q_5MtbTNWwrZ63vzZmyzuMbbg&oe=6AF9C1D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ze01hsJebQgQ7kNvwESokKp&_nc_oc=AdoderOWGN1doONS0gYSxKkJhCmb7vNSefv1BpFwMSN_QGUEe5Vd3YQRdZFAyKhUZbw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyTcOjRfmV5AYYH292lUzYPpJE12rfTGarjUR-_SnPUg&oe=6AF9CFCF"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8lshyR2fh0Q7kNvwFAkt-9&_nc_oc=Adp5HTObzJbcZEhi1jgLhNEGuWKZuw0l70mhAY9bIQxVyoW17FQ_Ru8Cnoj3Ky-y59Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ16HcCxTzmD_iPVPZfmkhhFzwHm0H2tfmYmKF_W7g4iQ&oe=6AF9BF18"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
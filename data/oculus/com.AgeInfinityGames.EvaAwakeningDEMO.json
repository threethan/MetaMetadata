12236_4540374522917595_3359986563388324009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9fAHAGNENQQ7kNvwG_I3g4&_nc_oc=Adq-FK-mwR3QkFvs7fQphiaRWr9SvqLY7wRwqw24Va9t5I1CjuK1E5LpJmqxJ1lrj8A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBbLv5D3mTPAPgB4ZgC8gbnuV0GOOyPL4tFQLV6lcOJg&oe=6A902EF5"}, {"file_name": "SCREENSHOT2.png", "id": "1002091502577044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593723055_1002091505910377_2606350691393432196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhmL02GBkRMQ7kNvwF8aRe-&_nc_oc=AdoKoB51LaRqvF1oCMMln2vjMpxwB-L5o6tK_bjsObgN265uoa9hWK-LqxoWzQjjkhU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG01DgIoQC-CEfxoYgCuwRR2qGX3M_23SG2l7cPKPvO6g&oe=6A903FE9"}, {"file_name": "SCREENSHOT3.png", "id": "1507162731212721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_1507162734546054_4260331267881194815_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cFvtAh0qcYQ7kNvwGDLCni&_nc_oc=AdrT-VpbA_HCiuCCkpzScbjiOJ5-92LTl3dCw0L6JUY8gP1_2dUQ1O2eYPSv8SSouts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl6WfOOWfDNR_e8QVWkkmkf6duBYazpZMKPuZGlm6eGA&oe=6A9039D7"}, {"file_name": "SCREENSHOT1.png", "id": "1726187108832816", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310734_1726187112166149_635600136569578536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnbbUYXa9IAQ7kNvwFlmmKM&_nc_oc=Adq0F7LraKbzi4oUkuTE3WC0O_Hk7FZD41PKqNaVcsXZ17PxiWIDYZ6OHgeYmXIDckk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5-cg2lV1nHgbBXs0_zKcSnvQtRzPA5aeKa3qkKZzbxg&oe=6A9029FC"}, {"file_name": "SCREENSHOT.png", "id": "1563254918652416", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310646_1563254921985749_8910419709266613584_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg6k7khACCUQ7kNvwE5rL13&_nc_oc=AdpVHFHQ1FXkf1ZCNxidln92G_rwdwK7p3OVKHmUmpYLW2SsDJLX6ZA8uD04QoUqZxM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5VVSfSmgTvsjyoe79AR0xsLcJbbmDPmYN_jb-kunB8w&oe=6A901197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_RISORSA_UNIVERSALE.png", "id": "2414280332391078", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313072_2414280335724411_3358196128599980034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jZfPYRnJqYQ7kNvwH2s_bS&_nc_oc=AdrvyyB-Y5mkVcDLVfKkc2Mk6Mb15isLiarI0CCUu7ilZzJ2QPz3Nv4tdfQ6H0RVRho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ7gsAQAlji4oiKXUI_d2raxnKPMQtxiy9ql0XQjMtEQ&oe=6A901F8F"}, "display_name": "Eva Awakening Demo", "keywords": [], "long_description": "**Every choice reshapes your reality.**\n\nEVA Awakening is a cinematic VR psychological sci-fi experience \u2014 an immersive narrative journey into a world suspended between machine, dream, and consciousness. Built from the ground up for virtual reality, every dialogue, every environment and every choice slowly reshapes your perception of what is real.\n\n*\"My existence is not a mistake. It is a question.\"*\n\n**Descend into the mind**\n\nExplore psychological spaces shaped by memory and emotion. As you move deeper, human consciousness fragments surface within the system, and the line between creator and creation begins to disappear.\n\n**Features**\n\n- True VR immersion \u2014 designed from the ground up for presence and hands-on interaction\n- Layered psychological narrative with branching choices that change how you perceive reality\n- Environmental and physical puzzles woven directly into the story\n- Cinematic atmosphere with an original soundtrack by Gabriele Boschi\n- Dialogue-driven progression in a hand-crafted sci-fi world\n- Headphones strongly recommended for the full experience\n\n**About this demo**\n\nThis demo offers a self-contained slice of EVA Awakening's world and atmosphere ahead of the full release.\n", "short_description": "A cinematic VR psychological sci-fi journey into memory and consciousness. Solve environmental puzzles and make choices that reshape reality, as the line between creator and creation disappears. \"My existence is not a mistake. It is a question.\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ageinfinitygames.com/eva", "developer_terms_of_service_url": null, "publisher_name": "AGEInfinityGames", "support_website_url": null, "website_url": "https://www.ageinfinitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1142769375594280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507843239_1356945805885198_8596977330163161735_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGOGylkwSpsQ7kNvwHYwCVy&_nc_oc=AdpIuddlQykMcimpQ3vspPx_62Ctxthq7nm-bTGb6Wtb_gnXFxbG_AM_LyTcp9Kwn2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQbmuumQeW9Ay8XhIcx-0vGHQrF7zXCbW6M-yRgb5Vnw&oe=6A900ED8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Eva Awakening Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", 
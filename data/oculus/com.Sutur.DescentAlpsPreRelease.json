c_oc=Adr2XFSzzPkGwKoQWlkRhx-dCyzpC8Zebnn9Jj_VAciXMOH-ialFxFmVGfl9jtdyjR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR70FzDeXezQnxAVh_6VJfq2FOQwiXFvHOdRlrEt6a7dQ&oe=6AEF5A50"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiT_ruIpry4Q7kNvwEUoK5B&_nc_oc=AdqWm1RTTPbS1RET7HUTYH9un_vrZnp2dN0YhJhg154cWcuc4MdmIAQntLHoAwt1tVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu8UwmV00ZUZszQoi9RB4iA2jN7gSzHhNojpDFfMytMg&oe=6AEF4D66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS1ExadcVqUQ7kNvwFuhAye&_nc_oc=Adq9gar6_6tasgYi6PDuzIbRHPYwUeUbRO8FK_h2sKCKg0eYl_TW38CvLvsL0W4LIbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-FkE2dMsmbjsA5E9TLpteOgqrNSYnaj-h51UlzWYzRw&oe=6AEF508F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4gq0l8jdrcQ7kNvwEiTDIa&_nc_oc=AdpzeoNo1NnUIbZ1wlDrEd5PkDYGkKoBfS1e8OI8AxwShZaI-ghYG3wK6E36fy1LKuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpv7lkY7XPgKwJlJmyn0bM_yKMYMe0owWic1O0s0r-NA&oe=6AEF602A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqoaqjKUfLwQ7kNvwHBitj-&_nc_oc=AdpwWSJr8uiqgU6rsxCicCL_TI80wXQ3uTpCWerVR4rq8hLWKObtR4llyn4t2OKz6Sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtBXItJVhVyn6PGAL5iRCE54Yqr7xfOUsrEccs5kE3xQ&oe=6AEF4FE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
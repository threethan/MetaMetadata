c_oc=Adow5G52yJEsJ2GU4t787dZ5JI5SK3bq3_jFAHoGY-fE0GfImFwOOxr3Tz8BjavcGSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Ar0BfVCVC_BXqSfUR9WLGoQvRqfrxXpy8kDgaKtREA&oe=6AF1FD50"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px3tbn5cds4Q7kNvwE59U41&_nc_oc=Adon0htyOz5_Iykhiq2MqlzREn3KpXltEqdx-8WdXzJ65hZCVlRdFdT87r0EMaAaRwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa0sJyNrb2CkGaFVFNPcLUXXyZAmJDxdTtYIFYGJAGKw&oe=6AF1F066"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS1ExadcVqUQ7kNvwFvy9Vy&_nc_oc=AdqgYIU49HGWzcgj-rzhmwGMfFdKy-VnPyTx6V1wP1nQv0bpWVXZ-q7LPO6r3VEVxsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7E-QMXqX0z-Z1BKz764V5NmjGmpYtSUfnKKJuy7DXQg&oe=6AF1F38F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihb-BGo7DkIQ7kNvwHVL5Mc&_nc_oc=AdppKRFSy1hm0GZLqhSdDawB25WWvN9Yu2yrkS307brsp23ZiUas5DbO5jXxYKUtEJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLn34SX9neX0yAzBQ6M-E5CDr6TeffVp9lBEJ7i72nHQ&oe=6AF2032A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FQ5GJa6zMAQ7kNvwGNy52u&_nc_oc=AdrQV6CghY0VmCKzJkocr9KIDIZBUOu-SNuxmz21Cer6ZXcvZyHIJ0bQdCpc_8goR_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXsSZQNqNEHv4JY2DrP1M2CTKjCib20bVdAwlqZnmApg&oe=6AF1F2E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
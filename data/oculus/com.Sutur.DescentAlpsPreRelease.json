c_oc=AdpVCLoPAJayl5TTIbVMH7dNRFDXNV4JnEBkDC6nIC9WSLa0Gqfy5rcMZufKPRmINcQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Qbabxt2X1xBNllBvXT-UNhJJ48Ah82vIDmCQL-7zsvA&oe=69F5F690"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E76ms2eelpMQ7kNvwHfNQ2A&_nc_oc=Adq-r45xEAWxajanKc_f-6bcJb-0YgMd6E2yTYwzidVTxL5ZBG90ReyjKcDOAOO0QIc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cx9rf-CHbG-10YPY-SsTpk0LkAT4WhS8VGCqiCA9e7Q&oe=69F5E9A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t6niI8GSbgQ7kNvwHA4POL&_nc_oc=AdrfGiO5_Vwd2V80_7_N0Mf7TA8RNq4hz4LgjziMCbQPQSIJ83N-4b-u95_ncx3tAGg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CGrYpZDuWfxS_K4PL-27YQnzzJcazfRPHpC28zDCexg&oe=69F5ECCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5szCUSrwzQQ7kNvwFFFvpQ&_nc_oc=Adr7YBdunolG0f8BOTn6HUqKeMuGyUZbJMork4fjcOU6Tn3JgrFkGYRtlRJau4A_Aro&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wN6JJC-3seXYNdmyHGL13fOpMTHPzw-X1CcDD6AnRzQ&oe=69F5FC6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cahzi1FZjOQQ7kNvwHHK6sn&_nc_oc=AdqF8bEV9010CJNPr0e-a9zjzdCWXzOGFMC5ApIQLiT7yin8PY_vW1I4155uV23WJOE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3a-yt3j7_Qdc7jt9trjAPW8Iw3vKLOM78ZTvLCJhgkYw&oe=69F5EC22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
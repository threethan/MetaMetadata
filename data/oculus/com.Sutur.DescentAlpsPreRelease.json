c_oc=AdocukJqNKGcmYNOynZ5bWG1k9c42mkWJ9M1egtzHD4n72tBHMEKlH0JSpyeTGMYoVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzD7hqOvsBmzIbQZSlB7e4ddJG45gSA3WWwxkXxZz9QAA&oe=69CBC690"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVB2MRRrrrwQ7kNvwHJKZkq&_nc_oc=AdrlEmufDPBGeoUzbaR0SvV2b235SnTRhVDVBT3gDUCbyHmvwAXaGZBdAoy3exLDvrg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbQRT_OE2cL2scESi-FMG92W4Kro-EjTwWDZ64TzIFkQ&oe=69CBB9A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDgTTXOOmNgQ7kNvwExSvH2&_nc_oc=AdrsXtqy9_3zPUB0Ul3JxSqIgUrq0s2s504aVMzN4ou4VwH7ELTglbq0u60bXCVtaNY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKHycBzozgHA5JAGJjWXA-fG1FG_Fbed533SfbGW9ccQ&oe=69CBBCCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SamZxeK9kkQQ7kNvwE8Z01A&_nc_oc=Adr4YwxweMXdqaoNN-mHoo1POJDVNCJGN59TsgrHZ7xiDJZDt9t0dtBKDSgOy6KLlJY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjrXF4YNwSAUy6g5Bb0KKX9Ot4fOmalVKz7UBHq1k72A&oe=69CBCC6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aj4F8xSLzWYQ7kNvwH5Tb-3&_nc_oc=AdpszLq-wHCWSmZtR0kEvnbjfd3nA6YM7S1hf8f_WOmgvnQIahljUTJ3hvv1336srEw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXvtpm54yEy34hW2pA8ei3OxWtDbbdSIwXecQajnpvHw&oe=69CBBC22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdpdVmpy72qONxL0GxNRv2cmRw0vqXSi3W3hZ_VZNWgaJZv1My5xrvjD1bjkLExDsMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dzqEfYDYPEdPJh2okfE1TzCT_PKh_CdzKfZ-ADA8shw&oe=69F89990"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jffiHUR4nNcQ7kNvwGF8tIb&_nc_oc=AdoVnmfQVze-nIJALC891mIw4PGjJjE7vSLbBMEGZrvepJ4vgc0bAqd2OAcL2ROAMIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0p_2dypqRFu_ueF8AYJf51wzsdx8_mWnGM9JTyJdkiWQ&oe=69F88CA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t6niI8GSbgQ7kNvwG2vQBe&_nc_oc=AdqMP-gIQiPrbxsaX-bxN1Q8Nd4Vt3-pjL6y2vsonoEb5qc9O0bLCq5iGvxgc10k3O4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fEOY6fxg8ZM6aDyCTBM8Ty1CdommOwxkOz8_S5RrGCQ&oe=69F88FCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PugIiyjHZ7MQ7kNvwGyLt84&_nc_oc=Adr6xgh2ZdoMq2bLsHMVfhGfS4SL5I75Drs0IQ4GGhJcACMYLFScrW92oCI7r2MLS_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Zv-_g20lvqy9PctbJqqofQMjg-r4T25FQpEpwgeNXkQ&oe=69F89F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OicP28aC9VMQ7kNvwEbkl6r&_nc_oc=AdpbYzW9Pi5ZRWEB8GdXqRyWWZ7aUbksZHG2G16MgcUiVYrxS9HxfIFEU02jY15JGic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yaifZUD1AFhV2XUft62_YNusd_Y1nXpLny1YhUKtsfA&oe=69F88F22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
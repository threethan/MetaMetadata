c_oc=AdoQ98fHY3EVQOcac7_cLR2B7l9UEErU9EweE609QdfpgVhtqxNYTzA_OxFbXNVFi64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zJUACOxPKqyRT4_ufcT7iUv2gBAd0VDAzfV1uPB5P_Q&oe=69D25E10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpJLlAEEXJoQ7kNvwEhLe50&_nc_oc=Adq8T09CSfRImNwucZmYzsgkyrNo0Nid1nFME8ceDd9nREnqtITCUceqFntFiEQJ8eU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Rtc8HBs6XarBCR-JGsOznyaTepm9w2MJSj-4LGQCKTQ&oe=69D25126"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48I1uYMNlxYQ7kNvwGBFt37&_nc_oc=Adpggr9R-yNQwGeHTbNi6H7l77CZCd-kEgsDPk_dIH5SkU1gw7sDlABAjdxvEIfGznU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WQTZeCPn9NQuMAVrJtK88vhuEpo4HsD6HhJMxpML51Q&oe=69D2544F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osPFhiWAlOAQ7kNvwFpAIEw&_nc_oc=AdroIci6YHdRtveLoEHEnkekV-EcN2Vm1_xuzyhhb2JECDAU5rqV8Cs2_m7BUZMJ5h4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RrehiHmsPiv7Lmr_A6-V4ZlL17xL1C-bSQYMpA6Aidw&oe=69D263EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDulOrrEuTEQ7kNvwGZpjPY&_nc_oc=AdrLePFeXQMnqRwKLNzYXiwO-hVO6aHXQ7IwrGmLamhtH7R8VTDeiBFkT4L2OpkH_Gk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3beB2Kgd_ltCY8f2-lxeewjnwkAQz97xyG_60VW2xPrg&oe=69D253A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdreZ-K7uxNTwNGv2J4x4MEyrvxkhFIGNaS1m1nUyDSUocI4Ws6qLl8V2UYQPhnw2aw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dNg0kdFud-mDIFQteJeNWbZb7LPZ5wS9UE8sqeaG84w&oe=6A3576D0"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZARmNIbGnEQ7kNvwFDUxV-&_nc_oc=Adqe-CBa5Dgx7gyYO2wh0QSsfykq6v3BTcbZPXTwKOrlYlfnkGmbnJNqgALLY7t6aMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ngM3Maxu3PqvnW9fkBbbVcviY2fkE00tSi6xDAS-Gnw&oe=6A3569E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SjRWWQUDSsQ7kNvwH8JwNG&_nc_oc=Adq1nBrx67R2Bk0t8GBMbtznVp1SejWREoRgqjH6x6p-mOng5x-5g6inZRDCje3Kdho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__YTiWUe0-87zeIGkxoNC-NiYykfLc3oxs8Ih1-nLs_w&oe=6A356D0F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19GGIsDBV4cQ7kNvwGpXi_u&_nc_oc=AdqD0UrBGaFUB0L9D_e_5VGinEXb1--f9rj_R8r3lP_pFsCF6uJXI9hasGF5mrBClUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ij_b3TxNdT0AdsU2OjmAr5SUM1_u3pNKGUyh3MpOUYg&oe=6A35446A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukTWjd7jdeAQ7kNvwE2vNAu&_nc_oc=Adpxb5HPfD7kqTFl2MBQ_ZZY0JvgMXA58V1tDad1viaD_IrCyykY-3Sx5WzaD-USqhk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eHTh8WZRj2LYYfOshj2VD00lT_Ym9kvn1sCMBLJqPIQ&oe=6A356C62"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
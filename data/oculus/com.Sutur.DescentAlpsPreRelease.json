l&_nc_oc=AdqFXxaAE_Rbh97Uz2zBTK1SVqFEuFADmhN07NiV0399hwZZ5OqbrwPKzDHFUZxylfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIExHOLK5HVRuN1ZOAsbDcT8B_s9T6LBXXLVjlFb95-LQ&oe=6AA55548"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xDCNAqkF-EQ7kNvwHwezr7&_nc_oc=AdqFanDwzrED5iSGUzmbE_VtTwPeHpJoR_lVGO0sbD3dmg_b4MvcB8Ij76iCIgk-jx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtvNs8iZvj2iJ4Jyg8jv6Qzkcal5HkHvVM72IKdGp-6A&oe=6AA5469A"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gzfp_JdYnSEQ7kNvwG3umY4&_nc_oc=AdpYaLnd-hRiBlATxEbvi9Hzn_d3nI6EXVwzNf_WpRwmykgkz87_ZF6XM-luRH_TbGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3V2_piX-CR-ghAtewru7dNNNTdXsYgJblSrVdQeh71Q&oe=6AA54982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWJ5AnqmU88Q7kNvwEr_kgc&_nc_oc=AdrDiJVvGZS0ToPaopLU7ARt5VgbFMjx5qOQxbMrMOqaTZFOpDNm3hci8ncWNlCNJi4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5pTM7UtCHrEmFCgUbeTuyngxF3BevcK5G9om6NPUJHQ&oe=6AA54193"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359328815713034"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": 
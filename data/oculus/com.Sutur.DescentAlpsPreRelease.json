c_oc=Adp3YYEg44vERgIzQAlpn0OGQmLWcA43ICN6gUz6SbyXUg0uBhkXXHcAcIx9xCiGSQU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OCrmnepdbluP50_4kp0WZpFF5OsdiEbb0TL4gR-aXjA&oe=6A3D2790"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0dTa85dcrwQ7kNvwFTUrGm&_nc_oc=AdoTsVxxPKwxiVfe2yop2fuqd3Z7xR8nUjic7PRpTLOi9ZXEOYMU4BrBfrzsqBdCD0o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vJzmv5dC7grxl54Wmo8gs_LGLYJkwL9zjo5x7-DBOnQ&oe=6A3D52E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeOE0PwpPWwQ7kNvwHJ8T9d&_nc_oc=Ado_2lLv7UvUwg31Q7L1_gPVwijv77xLYPMZ-KfOIKRyApAjrxIhGDdXLnJvVFVe0Hg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z6CHbEgY9t1sWIRG3taKxFDktGMSfeAZSp92ibod90w&oe=6A3D560F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgMNJ17YgY4Q7kNvwEv7CwH&_nc_oc=Adpg80KbI2aqYw_OSoVC3RrAJKT2CM9vpRU9yGSwPgrj_VtlSVTGsx2rU24Nkj3602o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XIj8qdODl2qFQzE0CQpXK6KpjZvF7vZ2uHWrWNVwQog&oe=6A3D2D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIub2lGPxooQ7kNvwGFDEko&_nc_oc=AdooXltaQkQDhz4bPeK1mE5dVEqSk9Zww0OBnWOR8EmbPdYJlsv3VVb5em_3igVSOZc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jvSMcwnzJKpkTQU_OHI0rCe_GQ-SnMWEBP4M_6HnmFg&oe=6A3D5562"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
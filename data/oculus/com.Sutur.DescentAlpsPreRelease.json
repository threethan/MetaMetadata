c_oc=AdptUX7uOfXKodUf-skp-FZvU_LTa4pwd5-wCpGhx2QDMMLBElfo6rv8nsB4dtf3l-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNeUCgalRZTrI8YRP9o1FOjjMqnWL4YfwLwfHlE6mxAA&oe=69CA7510"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP5m0dbQtnoQ7kNvwFq5UCk&_nc_oc=Adrv3PTXwAlKRqf4yRK_HBYECyOupcDsO-mvp3d6HuiXuSQzAvNpLrVaaY40eRBOgpc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxId4pCpveOHW41DqQmgDY9iYTYY-P5ik2Q3ywTjXyItg&oe=69CA6826"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDgTTXOOmNgQ7kNvwHXcJvG&_nc_oc=Adp78U5B2TnM18RKO1SHMPSRy1ljJnMKAFTd5EukzhioA3CSq4P1_yN2KR4xcO1jfp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7AUrnoPWAmJjO4ltQ3RfDZrlgckOiwi0u4Cq11pw2nA&oe=69CA6B4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SamZxeK9kkQQ7kNvwG4FHt0&_nc_oc=Adp7L6yHOQnvvWajRcItTg6UHHlRbOxHe_XmbobdoRww9-_4Aq_-LeD_pz7yjKSml_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvlXKyiGaY-gsVQVQgG0Vfjmiz_V8eYHqtBAPK5y_4UQ&oe=69CA7AEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aj4F8xSLzWYQ7kNvwGY6bQU&_nc_oc=AdopWOCe3dKAZaeiej7481-Gm1jQrbcun1oVG73XxYIBDCpqMZN14nsQgITei6Jd0n8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwx5UOfT1XP8PDmVdP-v6fFzxW4UxSDetWTPpA7mAJI1A&oe=69CA6AA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
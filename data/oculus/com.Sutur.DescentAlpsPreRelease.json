c_oc=AdrYn1beQ0dSBCgFqw366RAixLSnnipTSjyab4DHgAPG5hCNsZi2R9lQ_yoyabBG608&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNgH8aLm-F99FgpheqD_rLFaPj3KOUQPd9ZssE3MmlIA&oe=6AE5E790"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OgXWrLzXAgQ7kNvwFCf1ma&_nc_oc=AdqjPzgKcJ4nSI2uXiQQ_L8biPCwiJ9IINxXI0puaWMdQAdSuogKsYhjOCBBVBCVcfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDjMGVuiajImO2lUZir2e3xrQcDq0S088eLJKFPYLqlQ&oe=6AE612E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60xh_kde3RwQ7kNvwHuwTA6&_nc_oc=Adq26IlDC0eVupJ4yKMCMQ1BWYLvKK6PICY8N96gDF3Ta3lNfepg_p29Xg7cFnGH8I0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0UmBt-ozxPjkrb41mYMkNPhuQeMMRcBpziYWgrhU85w&oe=6AE6160F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YSUrT2TBQ8Q7kNvwHtjvjX&_nc_oc=AdoJ_D0Me1A3Ko5Tk2zWxhuzTdZWlQzEIoJLJhT0EgbdKzo2c30WLgavgURC_G_8yYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdMQt7ahNve3oEpm5hv2y9Jlh2cbaBO9xKXH55lFy8xA&oe=6AE5ED6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGOKa9D7fhYQ7kNvwHWJ-Kv&_nc_oc=AdrHvUrDZmKCpHepu9UOgJLz-cAsN2-bkMPwTkjFr-h75SUeLNgtSmrpPRyI3QWWKS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjQpC-qMQjlcb1nNIKkQyFUOkD79HF9RETloHgtlfSFQ&oe=6AE61562"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
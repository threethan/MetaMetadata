c_oc=AdqBqt2ItEJOx5pmJ2w0oSPl0UmEUuch0ji1a6Lu0Wrbpv7XG3plUK78NKRaTixOi44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkvHBV6Syv_HVSPIVdmfdr9dLYRDzEPBUWKYwCsnPpEQ&oe=6A578590"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDPwtZSiytEQ7kNvwGmxh09&_nc_oc=AdrNtvLtF6GgcHKPUhTlyC8-mQXiUxd8OscpPU6o-zXbHEdwaF5ywpsYpbcPFNvMg14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY2MKz1u6dUXBA_oFmXomFg_qCPGZKlcaE0HR2x0owmA&oe=6A5778A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihcy0U_CWNAQ7kNvwEmXFPF&_nc_oc=AdpxS6TsAMRKQDDCKBAjDgw4sb38KvZQkPhgPh49itQ0uFlG5Pn90twBrDrnFaD3LuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4mJA2qG-fWTSBXJ_gwlapjJ6qdWCxd_4s1VyJs0DCaw&oe=6A577BCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptuvZ9-KqVMQ7kNvwEhgTnd&_nc_oc=AdrlSqtvV98_9oOT3g1Wwk8E00W0kKjAZYjYz1l_GXbYUGZmN_Fq4VQea1rfd71PYOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaqeA4irr7xTJ8nw3tB31Q7sOHNj4BMhQJ4riRGfzCNQ&oe=6A578B6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL-b3toXCYAQ7kNvwGS6Pk5&_nc_oc=Ado_5uDeJFydLbMkMFRfgpPFPXcO43ByXtA8szM5X6uq3qREreHw9REIefHeH9lscvE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARa1iEvUbtYOGA-UJDL_w75Ygo77QSyJJMaTfDR_qLGg&oe=6A577B22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdoBgUH5_ewD85bRYa5B9bmG6Tz3cYKi7auj88G3_JlWMnR6w0y6iIL8HTW9D-CA_5Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQoMQEtkqIdDLu_nWbSUQpDyC8zpc5iOIZSrMrKgbbKA&oe=6A563410"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDPwtZSiytEQ7kNvwHfwfE7&_nc_oc=AdraHPAKcOXS2R30qg2t11tU2VLq1NSVGd3Jazkw011Nwq5aY01w2xvGUZF0SecypY4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfiyn-zKprLV714wjbCP6-n-q_Vucus8he3gise5RJ7w&oe=6A562726"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihcy0U_CWNAQ7kNvwEr_wPo&_nc_oc=AdpLqlyjrHIQ2eI_jcP-gYP0sBxqYmrO1zkr7t3epHyKppqNKouv5jgI3H9GnooU9_Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ8Cx6BMSJnfmGhTsYIkiTCxbmICue3uUA3lx2G2PvEQ&oe=6A562A4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUi2_sywGCIQ7kNvwEEGq7U&_nc_oc=Adq0mfnQwgZqEgU8X076x0_zicV58Aym2lea2lkBhou0Ch5qpf90ATNSbtmx8dnfIbU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9eqAFN8YIGaPn_-G8nXSHM7TlhwxMzc4_fK5KMMyE6Q&oe=6A5639EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE6Ry_JgMj8Q7kNvwH84zPt&_nc_oc=AdrpySXqD_OC2bMyx2iYJIBPaME41ZedvNRM-F_91uGtmvhvfVeXsQEjQ9SY8z5DT_c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtYuHVx0BqtGOInPYs8yM_rCbH-Rr15Xuv1bH83urq9w&oe=6A5629A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
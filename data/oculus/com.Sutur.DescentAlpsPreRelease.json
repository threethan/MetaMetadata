c_oc=AdrGFr44_579FABIP_cVgWskm1IE8PQIh9fvCN072MPlqfpes77tufD8CI5ouQ1FXYs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi4ig7MN4m4sxWR6VbGgQDfmJfNrIxDsCLgE4zFi0KRQ&oe=6AD107D0"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POgWSJ60aQ4Q7kNvwEXRYbH&_nc_oc=Adph2UDhsuApRMbYdxNEcYsqUTxxmNcpXNMpySDDi6r7WxiyRvBIqATAAkX41jh2I64&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdR8e9ZUQBlRWP7GRCGh07cbL_z_yplLU8euNPgJqJVg&oe=6AD0FAE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fU6w7Tudq4Q7kNvwH5fzdj&_nc_oc=Adrz1wSPfPwd76vEV3wjn6j5CcraZttYgcZ2pt11vPw2YEIuJC9GPIm-1V1Z-0P51DA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3EHrbfbUobmP9X0x8f8eLQz3MJlrqAw_B4PnErXO7Gg&oe=6AD0FE0F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZlcTWsH0nsQ7kNvwFd2E3B&_nc_oc=AdrQJrsZrbMdNluDj44L7DZJGMk22qqFVnoPaWJ9cMRcatMQbeGktdL_5ee2BpzVh_8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoH8HHyIoE9SzlFDjtYPLwkcvajJGgk7Ng_aMvhuswig&oe=6AD0D56A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqvqEZYjgmoQ7kNvwGwLFgE&_nc_oc=AdpL1NoSrBnOqDo1P7ic12x7JsnO2y6NpmVcB2Bd9H1XzzIQ8gDDRUgwJ-6QAJDFMHk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6PBE0mhyvCPsydsNYMNDwOpwMuVpHuMYmFVlkdiVA8w&oe=6AD0FD62"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
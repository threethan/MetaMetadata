GD8D09&_nc_oc=AdpZK6y4c-QVuxfpIQcnxdDeWxMG8ruk3Jf76W0gO7smDxH98MMVTmMwliqTDoJNkeA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jjCE-nYYQiKAaSPrbramrbm3t6IwvCskBmMYkWb1WZA&oe=6A466210"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azXZ7B_3iNkQ7kNvwFtvXGF&_nc_oc=AdrXpw1pTa46ceZ0PMiquJInCa-HrGUbk5DOfSmvXvIanHb-LcL2MwVVSJRDyKg58R0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q6lECBMkeTohLqTLZ1JJ_m5ezeNxjZhOF7JpPHRnK-g&oe=6A468D66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5As_z_HDieYQ7kNvwHMvIZ6&_nc_oc=AdocQ3_LEX5kso7-zc4uk4tz3qr1ehdBUW73xl8fo7sakhK73UFFUYtPfWi7Eud0qUw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HHA0DyLJ5KqK8KgTacrcZ4hf-OboTa7Dp1hVSS2zf3g&oe=6A46584F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMDYXFmGZmcQ7kNvwEuyGZ_&_nc_oc=Adqi5qtiGNjVLjEvWuzvkep36VySf2zHgq2pJeyqugUaf1Ppw0WhRyWTBoKiaNKZJdQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lDPrO_X5tN7VKYu6ZWqlPslrM28Mcmq054eSQh2GQBQ&oe=6A4667EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiFJh_48c6UQ7kNvwEdr3eP&_nc_oc=AdoVWZnZFnzKd2KMi7NO8eS7xDjK0dTZCcmDVXxh0p0mm-ZHDvmnReBoQlIg-ef5pqA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r71pxQ68IDw80WAlqQX70KtHjCXVmQdNxtClaKgxlzA&oe=6A468FE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
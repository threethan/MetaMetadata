c_oc=Adr-L3rUc6Z6XoJMtyF-yb57EoA6QbYEP7Kww2WTAecg22clHF3htZTay59hvMVKlD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vRDyYeQGyiWgILenYb_9ZAtxS7mjnT058NNJNmZbXJg&oe=69EE0D90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sxqODhLw4UQ7kNvwH1Z5hi&_nc_oc=Adoy2ZRZsrFxd5J9qGBGcZu1JZf0sHyElszPsFolpvLOvoWIqsXgTpl-pyXTPmZOOJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DF8OF-i0chjPKb-9OyLvX9BJo-D0jnHrdWkKER0zQMA&oe=69EE00A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxgexBrdqLkQ7kNvwE7ekp4&_nc_oc=AdpGEBFAiV1SSAltA0ZDCP3Sc8lNs_8MYeOESrw-yk6Bi1NRqKJTMuzU51z4CK74bw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gU6lx5sWx7kz3u75vSVvWBgsvWGIP_Be8sIQXTbcZWg&oe=69EE03CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PhQEJwXL2gQ7kNvwF38FKA&_nc_oc=AdqYQx1TUpyKdlHLXuo0pVIWROIRUzj53Zv76EYKVfEDPH4iCz5BaBkxfeuyam_Ndac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Pv4jZUZVN_Fdc-GWwqRGhAAUHpfQTyghLI6FuGDXlcA&oe=69EE136A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGb7XYQHBxQQ7kNvwF5GAzm&_nc_oc=AdoaycxKHiBO4NJ5qEJnJE_K4qtJatw22mSYTBZQ9I4gU2bwtNvxBNsoXDqI9tR6f24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v4TZybnXsgZDp8KTQPYpue5viALcBQqSnwqtHLV3sXw&oe=69EE0322"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
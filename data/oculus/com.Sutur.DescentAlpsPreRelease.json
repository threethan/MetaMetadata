c_oc=AdpukB7YE-7vZdmR9Cx-FPcf6CLrkLhlUQuSr2UzcLFZu4JRUSZSfbebKSv0PBldYPQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xFSwJmf2nGnqC-8bIyWlVc3ZkFr3utKe8RTuafeLPeA&oe=6A1C3210"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOTiPXWGdRQQ7kNvwEOwalr&_nc_oc=AdoSYeudE5fsy9nOEM0qc6Kru6-ivqVnZfxX5EmazFSwccCUFoiMMQBLTQX93LImMjU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73x0b8y6XdCfrbzJPYKpMJOS-9wQpiQEUxBysH79HvaQ&oe=6A1C5D66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3UGYX3N930Q7kNvwHcXtTh&_nc_oc=AdrsKxt_f7Q5ip9T_aeLBbFq0ozizED5x-_VUnRCmwJqMnOYK3UaF6S6QZkMavHKTHE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bcTIbk0VupkfuI3O_9z7FjhewigrWL-CsEw0YeGV31A&oe=6A1C608F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sVSOj7AUgsQ7kNvwFefkcU&_nc_oc=AdqXaoVoLJw-Bg5SQ78uweRAo-7igmt2zw_1qSOOvCrd_cCjrxfSdzA6jXdTIG1X5Fc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4viI7FdSylVQ024pHW1UMk-enWhnz9cgIdSROpywxMlQ&oe=6A1C37EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhYwlh1-O6EQ7kNvwEpH7k8&_nc_oc=AdpHeeC4_Qs27D7uYiUzuUawFIMAHHUggeXM5f9frYe6qG44uQ7u7aPj6YvHuc97-Iw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GnfldCdhmAe0rxvyG4-EnUPXodYJf9Hkv0a3c4dWBCw&oe=6A1C5FE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
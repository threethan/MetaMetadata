c_oc=AdonQCnYpKCpyxEwa6xEBXrgbXVl5cH18DjpfYfSliYYjbnLImvTlUgzG3MzyWEimBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_uLFi3-EF0VH16PekqqGggp_I57M3HU3Z5J6q7T0D2w&oe=6AEE08D0"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiT_ruIpry4Q7kNvwE8x_UC&_nc_oc=Ado6QBG8VI4zm3SSN3jXHWkgpJryi92mIP3SV6kXsZazLAZR5xPYYfNW7yfmD26z-r8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJCT6V6LvsaeCWiHMMqD-M5neJze6B7iDLqeSiVa2vWA&oe=6AEDFBE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajBb13-NQTgQ7kNvwGg1Khh&_nc_oc=Adov4LDOKa5BH-zlXBgerK411aGIHtdPk469RsozIvAJ4Q6Nczq84eXkFfh5bNyBhDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6TMaLjMgF0Ad6q0OixqNYbERiyRDkMMU6acXN4DywFw&oe=6AEDFF0F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4gq0l8jdrcQ7kNvwFaHaCt&_nc_oc=Adrj6KVdy52kprxeBXzH_wZsN1qpLEbP3rOCBxq8d2mgCggj8MeyDKIAC5EH-kJmk8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9EyKneh-x-mcmrTSrDHgchjo3HVTT23t3ayvTx5swpQ&oe=6AEDD66A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqoaqjKUfLwQ7kNvwFDrT8e&_nc_oc=AdrtZNUivPumRnCdcvADTxrakhAg-D0KiErcyPbC6ovYFbRYxpACCT3UuTi9ZBbVxIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2AZIT_RQA-JAuJcqgFjJylz95vDyWjroIgj1e1nWkVg&oe=6AEDFE62"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
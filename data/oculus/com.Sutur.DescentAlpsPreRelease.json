c_oc=AdqOWq-B3xnPne-Y4wD9h5eMLcF9rDaqL2TW9Y0HqwvhyaKxhzGT4xrsXdhx4sDWnYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07KVszGRK5oglDL4HkN5VkAwbR5xYB0VRoiZTIGIU3pQ&oe=69DE3B90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Szvcl9VbiaQQ7kNvwFlin73&_nc_oc=AdoxS9J_aI6-TTwsEL6SlI8-6botHXW-bfBSVo_a73SdeoO9mwORV9Mr2WcbNX_IVnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0875XnlezpQvFWVuD5njsfEnb170lrfElhapbXL4-qFg&oe=69DE2EA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVqZ3NZCRUMQ7kNvwERu9-D&_nc_oc=AdqsQzDdgv_2wb1MXM87vh6BZNvWIGWPcnFQQLY70MSFGGNqB066sQ31-Sl7HzrIoG8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T5cCtiCS1RLqqwBbktDOeboNn-8OyqVMKLK4mFT3OAg&oe=69DE31CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BvlX2pAqK8Q7kNvwFK924D&_nc_oc=Ado3gxV1ZIgrVml_P-EPPm4xXoEHEX9pqBzbfTcOpay14G8nGUy8sNNq74nlhI3ndC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Dep989dRdHCCznsNmjYnVLH9hSdwQDkY9mgCiYIuGig&oe=69DE416A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjKpjqA4mKcQ7kNvwHq6--P&_nc_oc=Adq-1pDvh5exF4KLkVhrc9rF1v8P2V3iuEx1bJzBp3JlY-Dp-R2WHlCo58hPHkj_N2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MPl2mgdwf79Y39mTvg-f8FKLaMBDBF4AhCAk1-J71ew&oe=69DE3122"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
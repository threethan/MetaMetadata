c_oc=AdoozgbiMo6H62eMo8G_WqjISdF2I7PcMaM7s9LMIeto9sYUlv-8vC5BZ_i7sIqTKLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ups9U8ajRaylE5Q0LyTh9wKIkoC8xG4nRRrVkSiARAg&oe=69DCEA10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Szvcl9VbiaQQ7kNvwGVs3Cd&_nc_oc=AdpHB-CbpWIOgpexF005nMArio-8ItUu4SG17W_c-WkRv84ixYrL5OQiWRs9xyxuCoA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0caLpneerplLyOk9Jz31Pnvr1o1To7B_zPYXjcJKd1MQ&oe=69DCDD26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6tcO6Pa8A4Q7kNvwFz_zMT&_nc_oc=AdoAZipVq_tiUw10CbwGPBxiw3D6f_hj0yH0PtDot0XUIyqWDr4uTgTIIeC-L-uU5Ws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bnTtYJy5CNbROMf9t-dUvWBkGfswGbYyh2nKd25Ejww&oe=69DCE04F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BvlX2pAqK8Q7kNvwFSgqIP&_nc_oc=AdruqcEHOkmk-Fu4ZI6L_dpyxmY9Wj4Q6BV430vsB9pRnQ5XAYNHDODnfpBNCALMOEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P6Fizs9q8VFpOTO-cDn_23XwtWAzRiji4lKgcyjekYg&oe=69DCEFEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjKpjqA4mKcQ7kNvwGsWRgW&_nc_oc=AdrmAFELF4Y4J89s8yuOwJaFv8l-okZh2WpZn8w6omsuZeJjU3kyxl6ons6bxh28Pwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PicdsT9Ony4Zq0onhZiLoqJB21X_FR4F8H3YFY2jG3g&oe=69DCDFA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=Adqh8_6Cg0nwoH91_S2qdDvFJMItlAEz07m9RfUVOffJDWKpHULq3zt0Vw62r2NV2bA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-3LFMLdSL3QVaboTRZhkalkXkLDhkQrh_3xTXvfd7Hw&oe=6A144910"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdtlbjFzW2cQ7kNvwES8hEZ&_nc_oc=AdqvRNefzqDsbFwlzlduJr3mC2nifunOj6I_bsvVv1JJkf5dPWV_vo8JQQyw-NHDzOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FSczMaQSXf7yn-h8hhj5WRcTMXqpmo6zpU5ZBJamQvA&oe=6A147466"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biPAFv6DadQQ7kNvwEvnOI6&_nc_oc=Adrkk4bhEYc9Qveon7bxI6Eo92MxE4eg-js-9jk1Mi9dE1pJah8m--eMgog-ASRY6Gg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49YyV32vGu-rtwcTDBihSk-A0u-E1Re6Fj2L6XKk1vzA&oe=6A14778F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj7y4zg788QQ7kNvwG2SXBj&_nc_oc=AdpXkRzuaBES_qRKn9OD-yZeEASX8izRMuVHUF-Y57zhxu5Pbl5N63WZnFAph2u-31E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pV-qkT5CevH-IYCAM74GEFbNC6e6sBivq_SdUWRDTZg&oe=6A144EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMiH_VkqBtwQ7kNvwFivyre&_nc_oc=AdoT7io2oq3HVkGiiwXQj-CzvDWu7mtbnW558Lqvxa95uoIsZXPXD7g3lK4UqqBQYfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RU2L9n0xwNrCAYyFguO4LaqH-0hpb2Wae9gYFvCk_mA&oe=6A1476E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=Adovg0pHF0M4y1-ElD1I66WjUiPb5hUQb98svEVYGAaoEqxYIVd9D-EPGaI3L4F6YxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13aoD6KyjwwWsqbzBW3JcmYzDcbakmBLC5m1tjLV8KVA&oe=69DA4710"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij9mtEFVJ-wQ7kNvwHkPs04&_nc_oc=Adrbo3HIm41T598AEDk2bIqctz-hYpCBxCXtD-pMzo6F_g8T3laJl_7nWee-RkYVWis&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nX1EkBLT7ICXpXY7tpOEV_yAIa9Z4ZjrPIvReLGC4jQ&oe=69DA3A26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6tcO6Pa8A4Q7kNvwFqpWiE&_nc_oc=AdqZY1xNLbXuCNJUlfFgXSUDHQ8cTlb96PF6jNbakyEXlvE9eq0RcCIqujadodPpums&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25aSufq13Jj9VYuxoZ4pCsHQ5I2PmHaG7me8ead7w_1g&oe=69DA3D4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm3jgdZKwZQQ7kNvwHOr8h0&_nc_oc=AdpEn4wpUXIK36bsst7JhIjXEm4Gk9HM5UJsma8VtWmqSZMLN25Pi1E_ay6sWf3O32o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JyF2R8Z85jNKnie_uEwUkR1-Q_7QhUYU0kANmi892eA&oe=69DA4CEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qNEUCCHXrQQ7kNvwFiGoxh&_nc_oc=Adr8RYNjPHHzUZuetAZbAHzu12AkvZkj9V5SEnwZXRKg87urYIHwPU0C_AvfVmj4Da8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22hf6Tmc2owcHgUiAb8oOrPJD2DcTmdp_YNbuUseHKiQ&oe=69DA3CA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
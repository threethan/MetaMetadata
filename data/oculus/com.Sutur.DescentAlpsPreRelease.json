c_oc=AdrIisCReqHxiTLY9_5Yxx68iFqeZ3H1N0aWJsP8CEUzTztgiIABRncD2tLS4Ppq5ew&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ8TyUJVMmMCJvWcWkaQTlT9orhsJB82B5YQLylcPFSQ&oe=6A54E290"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqF5g-w-iE0Q7kNvwFUkHQL&_nc_oc=AdouH-5TGeQwD-0V1eBwIQvFJtKCgh0B_MraynkXvqecF6Re2EHacKffiglw7wh3xtQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5LzJMkC--2t9X-jq_JshQfMa4zymk8-Lu3HLwRSYaTw&oe=6A54D5A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihcy0U_CWNAQ7kNvwF2ajWi&_nc_oc=AdrxsOne4ANkb9ZJ2aEQ4zsat6fni-oQnUsyIvsoAsxMAfcsVB-Ud0KMVZTEoZT88bg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkoHTRmgB14y-rMMUHiSGzzr5nl9TC2Vs0eTF1uYg8lw&oe=6A54D8CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUi2_sywGCIQ7kNvwFGCr5X&_nc_oc=AdqkHrKDWFSZMG0hAF5wyTYFxzw0mgp-XfW7Yzt-nqSBvCGVoqB7Dcl_I1JQhJ-Qjqo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfswlu6V5wk-AEXcL3eAUQZEClgqQO2i44ah2U3hPtEg&oe=6A54E86A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE6Ry_JgMj8Q7kNvwEUTE5b&_nc_oc=AdoCE7LXEn1PV0swGlndYyaghG-TWYCKluSlq0zhoyu4vR_acZLvD155XR-88P3RFiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZKvRNEM-DMz4FY9uvXKGNJVJ039zAyT2hqlsXP1ZwkA&oe=6A54D822"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdrQ2jtZi-mNtYr2QR3yGDJCCxX1A_fbSE3j07VjUtHdzi9RZ13rpbbB0S6gNSeZ5sE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZJQMysiXXPDovM5uL8qBCTKBSkCMadpOr2Hf0hDVXLQ&oe=6A3FCA90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3ap17rV8NMQ7kNvwEQ-vm5&_nc_oc=Adq_hy4k1_Ajar7sP0YuZ1-pgmuWUEXLXY8VzxkRWdMnSlvBuBvX9c6WOkXxQlPPrCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Kl58AWvt1Yu2Q_nYYCjMxRba4emROD_XRMnuEYFKEBA&oe=6A3FBDA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeOE0PwpPWwQ7kNvwHDTBPA&_nc_oc=AdqPUoY7oV9YyUl2OgAOeVU4vQocULfW41cwM5Tmka7Zpj51ftS7AWa4w6wqAsHAfQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MQb8Qx-Pxdnc9Ab43PCeSf4O-ge24ILpe7bq2X9-U4w&oe=6A3FC0CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdgYd3NMTBEQ7kNvwHoTEbV&_nc_oc=AdoF5RSlz946QyvNGgDp8O99pfXe8qiuPkZn_JNSiOBf2H2Y6W-sbOFCfPiLxKNQbNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a1hWcs8Mbx-tyGgx5a8BjQV_T58TbNrsb1jpbuwnJpg&oe=6A3FD06A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdtQRF9RfCkQ7kNvwGOkYkm&_nc_oc=AdpQJQfw2aryVNUtwhFZv5XbgS0xCx9Je_AfqebXmrAtrjW3q4l7JeaVlqQHgkuMoJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZTCl2ZKOCmDCa9n7Zk1zQ1A9ZzqSmdvyIPGeFcr5k-Q&oe=6A3FC022"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
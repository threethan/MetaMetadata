c_oc=AdogIfRqXVkJO-j1aOxI2ECddCspG3TAGo-z2v1TaSctM9pxqCbl9Ep8u5Qx83ErOQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPWB5_ZB4W_cgh1G_aOozdVtemy2uJw-Zp-rZi7W3zCw&oe=6A7C6F90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHLxmc5FN1IQ7kNvwHNyfZ6&_nc_oc=AdrzzFMYZd5HAxXgkpHWtaD0xG4ds8EQYE-IsdHdVDlMIuUJCiXu37qZGEQEiC6R-Cw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6EkKhjRWOkCuoJ041Gfcm_Y0om5NaCaz9ZpPTpit6AQ&oe=6A7C62A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao3b_MF98g8Q7kNvwFxJioA&_nc_oc=AdrNyNrbo8eW7KDK6IEF7EDbRrFt7MctUL-dL0NdpLG7oLc8ZsjDnMxhfBTJ873-008&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsT1WkSArvZZo4UxUDXireiJKhdJQgp6DOCkcS3d9xxQ&oe=6A7C65CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7-C2ADpu94Q7kNvwEs5nue&_nc_oc=AdrU0nAUyRVlSdShfi6ywgLlwQ7zsdmzUDFhziL_Os9z1GmJkUvADN9FCZpZXAEQEsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2kyturo6cTXblZpRZ6FfQKS8QVou2piv_ZUm2V66RPw&oe=6A7C756A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txmdH-LTe4AQ7kNvwGN6o7A&_nc_oc=AdrGUS_eFn_p0yBDqEOXWMEW0Y5jO_lga5xFSGRdYvnwenhW-VLDlGkKnLx1r03fs1c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfncqq8JhRdEWhXFKfFucC5j2SJHJr4p1_YZzec8z7Zw&oe=6A7C6522"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
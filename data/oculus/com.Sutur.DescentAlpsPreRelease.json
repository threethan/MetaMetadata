c_oc=AdoK7tkaCMDi9e7rUSTV9R_sAcNEEuZseyXLX9ZYlrmsPZBF38Y3v0KQxwB0ACKiVE4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4FW4ab42K9Yo4DYcA5vtBmFrvnsTQroQxLh6gutBLWQ&oe=6A329B90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZARmNIbGnEQ7kNvwExrmJH&_nc_oc=AdqHJ-Omm-WXkXroV-FmFzP3gBXMO6rex-LoDJj6lYX5mwp2VsQFXckGkPgj9Iv0EvY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_By3myCTJDT_B7L9kyt3KKyBqlQ83p2iXwkpUmTLKuZw&oe=6A32C6E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlrMUD1l57gQ7kNvwFtipup&_nc_oc=Adq3hQsBmpEFT88Ldtg1aq7qNjLCpkL4kx8b4ZhnxBdl6oLKdcdUl7QNi_KbH65rASA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vuptwibpQ3T1-qxnRbrFTMbR1nV9SN-go1sT_Q22w8Q&oe=6A3291CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HODZV1wT6zUQ7kNvwH5McXd&_nc_oc=AdrqK7ZQk5u7z1rTNObvMcJkyTlL1M_oA_mVc_38Sq0484ZeGTxBTupyHbS7OT30MV8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ggHQXgdef3jimpaimxmmHpWBZtv2FwiQCn_SzlNm6gA&oe=6A32A16A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PQHo6WTnVUQ7kNvwEYIywk&_nc_oc=AdoB_vW44tqzMtmExY_Ld9QQfOyTaiJXy-zR5cMrxXdXbxa1pkduta11pLoMUCa_I5Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ysqzyh-MN44cWgMEnFykMfttHlgG3hgRYvnCoObnW9g&oe=6A32C962"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
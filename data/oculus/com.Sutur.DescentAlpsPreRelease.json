c_oc=AdpE-u0cwIvxzuRh9nfGwpXDMehjQB7RtXtemxt7erAOobOU_maaVxifAEk80amMnP0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyg-F7o0EDdwFbfif03D1lBkP-Y9aGKesS11qsB6gCuQ&oe=6A973E10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zJhCJEsq-EQ7kNvwFBKL9l&_nc_oc=AdoMgu9HBZ6QsVzOAq-jhb04ZjHqKAhrTUgTVk8CP2iUgEpBaUdzBH8rbeeNhVw6YH4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuwzN2vHCsqPbqECa6ESYUjg20TELKuR1xwFQ06OHBDQ&oe=6A973126"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z9kwuz9yB8Q7kNvwGTtPn5&_nc_oc=AdrRgzEDNoUg5HQngLrUFuaoFYTXFClJ6UQw8zyXWZny3fVsMjMT0h9XxMME7RpU0HM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOUq-bedgKjpFSqg-m-7rg4NmmGRjPDRNHl7_g4Ky-cA&oe=6A97344F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rL1EGUIIFoQ7kNvwFzZ8OD&_nc_oc=AdrMwPzh9fPA9cOmVLDAhDogWiyEkUDIWpPHz3r8wG6pB4ZgTsQ2CUwDXv-lqlYy0K4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpqf0C2shEwKdKKtTbKe9ay3lmBkRsUpMP9g2DDY6eqw&oe=6A9743EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz7-nQMx_bwQ7kNvwHol-Pu&_nc_oc=AdqXQQvWyuZ5GCRZyHuvvl99hw3pHpPjEEn-pPKFQo6oH8TYJ7-0KTiJJBJmtHFPlf4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUcBjc6LyKO920ejpdVFU4X5kZxQPiBd4ex_vU3SAQwA&oe=6A9733A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
FtcNkM&_nc_oc=Adp-zVRcgNPOdSEwI5StdpVqJAkRXbvN-Y5r2xvlPlcuHMRA92ceRwYZTVBRpmctb6o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kIF1XLhVAIu6OwI1sOecrFbrwd-jES-jNO3Ccab3sHQ&oe=6A22C990"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pjPiu4fAh0Q7kNvwHF4Leq&_nc_oc=AdrsbvFzQi9Awa9hravoUb_fgrykU66ajf09YaYYKCHqOyk9MFbtnAHXyjnogzKpEV0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ErjbYrYU64daGPiguZ_b2_vocVjhbBccrAYemWV7EVw&oe=6A22F4E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQGBQlBr1k0Q7kNvwHDd53L&_nc_oc=AdqC8rpW6nR66nnPL0XCFmSrqmdzi8y3Q9jmkKwmGhkeBMDZJaeCJwY6BbKAXDuFh1I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-poYkvPgob9OvtoxmBje7eFMwnZoFExFNo-z__bVrjSw&oe=6A22F80F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpuIlmDQ-4AQ7kNvwEgmeJn&_nc_oc=AdrNDlFDyFnEOTGlCE8zGfjH-E8CBxwpTDf9PzESdNJQSm9lQ3JmLjXQ4pxF-_nn3tw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2V4aMkxr9a4fuCi7wAEgiRbE9vpk3pDxlu33M2Cnj_Q&oe=6A22CF6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_19GzLlzSJAQ7kNvwHZesdk&_nc_oc=AdpMbePqxEr6r00bGS01OtT_OjHKTUNrCASILuCA-WUgoWjrp98CIWtv0ZutRSWVTeY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L_8aWx75iNjFmtWGax6FW4zph5cHg8GgZUEhPvsU-4A&oe=6A22F762"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
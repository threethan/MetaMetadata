c_oc=AdogBFFqrnJGK7RSBGuaenkMKxwbjFUGMmJ3c96TKy-p2GhJvFnExh2IYZPTZ61d7bY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn_hlNjrgXG1aZlSbdZEYXeDI63HlyGEeXDBYFCvGDjQ&oe=6A81B590"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtyTL6OOmeoQ7kNvwGU4fx3&_nc_oc=AdqGtexsV7r7imXqdIsfkIhAaSmiyNVv4B8pIOHGA49h2HsAVj738x5EPRWPsxoRW90&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyLiCGM_wjKIMFxh7qIIx0VH6guphdb7WrCT2k8FMTww&oe=6A81A8A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2TYz61fx28Q7kNvwEeYYL6&_nc_oc=AdowRXuMkaEpylUb7sf54Rr4Cu2EfuM9ugoOk8heOmhLBuucmr8lVDM9Fox_uuC_aDg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt106wnLbCHxuaxWOpYDxVpg_vlhwYBnSRmR7B39a3Bw&oe=6A81ABCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1Ko5c_-2oMQ7kNvwH76lf7&_nc_oc=Ado07rGmodsWj4EAz2GtCAEfrSYkyjF5xrgZ-8RAM4CfJZtxjIkMFsBV6YlhEf-HSR0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4AzbY6Ff_POo_aLJQMzmujzKD49n-zjxlNJ4HiHwmow&oe=6A81BB6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSBX3GZZS2IQ7kNvwEuMfds&_nc_oc=AdqdPHotsnZmQuO6s3deLo2HFpczK_pho4y9MEaJ9DGgtRzq9AmlBxbePbPbf0Rs_IQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-BRV5CYiaNXB6aFeI4Ab7lBvQtqoVW2BYD_YzKUqaqg&oe=6A81AB22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
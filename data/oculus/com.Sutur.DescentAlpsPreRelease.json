com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgb63rat_LgQ7kNvwFEMrmC&_nc_oc=AdoJ2sNN2v0zo_OFbyNmQItqOlu9HWhMLAgeIpgWLn5z4pa88Vd3dspygEUxSLRk85c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4sGN_-PrM6uKifcr1zI7St5nrlg8su2ZT2vyPpEJuQA&oe=6B0061A3"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Z1oohKKaCoQ7kNvwE_hxMW&_nc_oc=Adoli6hnmaQDHlBdOToZAu2YFuzZ5-4wrCztsP68cuwSa2WSy5ergxceEgYDm2K3maI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzGdu6wtmjVS6OvZArvMXqfAvKoI_q22OULwIA_vumSg&oe=6B008508"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlCBZ3UNwMAQ7kNvwHe7iIc&_nc_oc=Adp6CXUDaMR0CWDnFF7xB8AQayVdBRNSSodfIGdhkdzgCEU_xJ1clAqHoUEX7IMjLLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXEGKDfpw4p3635fai85SIuPYPgwFHHDv0Rr9ROsd-GA&oe=6B00765A"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg2qIgoaOtkQ7kNvwFkKce6&_nc_oc=Adp1RvN87-rAIjbWO1SgjiKBpvd_ZbmEs0rjoY0l_bdf-j8GdbsiyTksYZCDtaGZDFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRE92pTrCLCbztUVcS1OcDbMCa2vtvG-_jIupFxe9j-A&oe=6B007942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX8LEbCYivIQ7kNvwHcJPbz&_nc_oc=AdpyOQRXc512tYRNkZYyecf7pOs9slI_auLM03pozQBh7Nofjl4ncejBED0ZGmZ7mmo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQta6fEW4C2_PyGBcgpEnGRC37b0-SVLrs_8Y4rn95NGw&oe=6B007153"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
c_oc=AdqrbaygVcyZSBcQgx9OlEg-njb1GQF8QTsczNltEcWFRbSKezjn5G2oKVJ-y1P_K9g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-W27uR2huxs5eQlWHLsW0OvM9kky9ctXwhvN766Ef0A&oe=6A12F790"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdtlbjFzW2cQ7kNvwFPY1jZ&_nc_oc=AdrM6bbBKo2efUl3YSpeogMlc70DM9fmT4XuO-AW8XCcH-DiMBVUldHQueOtWQ8df94&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FNGjj7JYy3ijCwElGC9VWcQlWczJmEHaVLnqlSChatw&oe=6A12EAA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biPAFv6DadQQ7kNvwG7IKXN&_nc_oc=Adop6IIk3FrkGZmgp0FZhK7eoCNAZp0QSVcKC-JKle7MkgTlv8-eQfQ8egkL8d-tNPw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z7DBIZSTP5DSYA0fSqTKzDQ94-rMSxCQSzOAgi7pOWg&oe=6A12EDCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P2XA1AUotAQ7kNvwHhYodi&_nc_oc=Adp53igBSvQ6zdqTu8km4C8xnzhyXUrgL2HqhUCciVXtg3ocgLiGq4gdaaSN5pRJCrk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D21OxkMpjzTYvxHNeT0wVX6bVp5mAFipkyaFnQR4vAw&oe=6A12FD6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhHGZ7B8fQAQ7kNvwHGugsm&_nc_oc=Adox3e688Fd38iBoZ0JAj5Lq_-8c-s6MIi_Gi9zeXVmwNGwVxcOYkSG3LdDvvfGmqDc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IuHfGQIFr5zYfkXHm7Vbeb-qzEbLje4pxmCFFFsAbsA&oe=6A12ED22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
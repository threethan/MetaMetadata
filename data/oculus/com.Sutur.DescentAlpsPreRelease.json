c_oc=AdrFfOfUcrirz5Ud80HpR2JvHEHiWpe3XTu6Rdqd73JMMX15j3xcc9quNONfhUTPWhk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSO_-OIIIhNoV4NJBhJzQCketnK9L4UGEGKIoNgOrQHg&oe=6A71E390"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47cenzI_QHEQ7kNvwFUuwnB&_nc_oc=AdrE4lhRXNw5z6yIbPvbSmudngjpmdou9WBbYzKOJqYfki4p0q8CCH_o9r5mp6Jlr4Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLVFbwF1LB5kpikd1bqIEdrA5yVO2z5PwR-btc-p8Jbw&oe=6A71D6A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsFTGgqESVwQ7kNvwE8H6x4&_nc_oc=AdqCX9Ua4J35r48y08Qn47EQDmQDSXMd-RU9OwDsY0fYtJqNiziaDFf0b7N62qKgWPk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoxfDJH8H3sy68f8GKmUY95vfYwjfixv2FkOGtLF4oJA&oe=6A71D9CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJkc8GUZ0HMQ7kNvwEUmg9L&_nc_oc=Adpj2vOkKFqaZBd9_IJBOyZgGOU9cC4ds_1Yb23C6_mDgjzdirnsebBsNfs0Cf1-Alg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwIhJrZviQhKVZBfUGWlKPb4CUVBjxT87E-VulvJqR8g&oe=6A71E96A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL7YMEisq64Q7kNvwEMqCBd&_nc_oc=AdrlbSAhVPVBu1XqmH0eonBEt29A1_iit9qE8gub2i1gOtch1boZ3TIyeOIPJOppmXY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy6IFUwzPwYSl55_bYnuLwww3GOfQIxePfSwV3ECBVpw&oe=6A71D922"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
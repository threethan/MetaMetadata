c_oc=AdoHVyvCVrseMrv1ceQSLQPidW_AIqqurJKBDS1xr1zXdwlgjrly0_UORVTr7jo1SJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtx4v_DinFvwf5WAf3rV6AlLo0pBIQM5oio3b84Sad-g&oe=6A95B450"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zJhCJEsq-EQ7kNvwHm3k5v&_nc_oc=Ado6FwVe5RvzCqD4Z1EHUFoIUC_9YTE9klqxjAi9vA203dCmvUPhlkwpBMgncwLi1Xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcYJ7k_6l8Y9CI2f1bmsd2R_4xVItBSZ1Zl_9H44h3lA&oe=6A95DFA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z9kwuz9yB8Q7kNvwE3O4Jp&_nc_oc=AdqdBkqvxBz2yXTnQ3ZKvqtke4jv2E_IAMgshYfdTdaNtj2SLJl1Y135d_oa6ieV61U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRqxFTkKMGFE-pSxkFHHyslTZ2pTtpx6uHSWMdxQO_7Q&oe=6A95E2CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZivE0-_sZwQ7kNvwF5ynrk&_nc_oc=Adr4OtsKV1Iy_jJS5TDwHi3puu1kng_SUsZRMeYcV68NhQp78nGeJO_3a5xsmuDVXRU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdp0FNdMHv92_poFxoMGipWfQm-qEME0unBQwGtZDUyQ&oe=6A95BA2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOdb7t-3FWwQ7kNvwEKhc1m&_nc_oc=AdqG5sQ1TCenu3hAyfeSMB_WAVlhXkEvX5BWgSqtBH2awKSHahky-HqypPXQDQVUvi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvW8yAGEvrAU2HGX4LAZtiR3e5vqzRP9BUur09887PEA&oe=6A95E222"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
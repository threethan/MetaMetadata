c_oc=Adonb58bBBvs-iEyuHt1aZyq6oeZ2oPjEZJ3QMaPAbl8j-JBBbUk2YOH9XbCSVgS-fE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkMkxtImnSok7Z7RqX8Ii4dW15xBNLF8wyJGy7lwSyyQ&oe=6ABBB790"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnCyv71O6UEQ7kNvwH73lGy&_nc_oc=Adqx-zr8muctSW8ueASatps6PJVjsPLsR9kOlfPgkwZLSI09VODZWIBsVtqrP7DVRJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXBLh_Y0IqAia7ysI32i4TsrF_tWzxGXC9G9HuR_81rw&oe=6ABBE2E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2f94vJuspQQ7kNvwFSfGyJ&_nc_oc=AdqEdxp-hx7HufGJdL6Z-0yZPnI-nHMp2gHBl-qJFn3-RfpD0ba2JGL3BkePwBImUbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8y7ehqjMjywnipaxYx1Vcwv1F5Qb7TQbqGsNl7tGvXw&oe=6ABBE60F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R4fgPSx5d4Q7kNvwFWJPoB&_nc_oc=AdoHZeNwaU96NHUgGp13qZRDIEDNIesNqQQplH_rrGTTh52UWBXSrchyCqGQ-0OwXII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcmJa7OcE8qTZHvQIpTrsoscxd1tmv4KUgTmw2hDC_cA&oe=6ABBBD6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0TmyLBOMxwQ7kNvwGWoYSp&_nc_oc=AdoA6vlOwvRxUyXC2npljDWM57P6O9QGVP5zEgvasDedIN-EXpXTMcNyT6FaSn5ZsgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImYZTDL_NKkGsNXl6bwVX7hR5qUdkBF8QbauhyAe7xwQ&oe=6ABBE562"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
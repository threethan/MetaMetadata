c_oc=Adqlvs2JOuYCxsFArMi5mUCapN1hXGlTnIIPlyek81nbmkKwx-fmX6wCI45wu-slgoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe3ON56cV6OlX2W9AC_uXJq6aY-FOuTOYcjbkKHMH49w&oe=6A7B1E10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHLxmc5FN1IQ7kNvwGkBwOz&_nc_oc=Adqw1S7BFcas6lGTekg-YnKj89WsllF8x0OQNdhnTzpNC8wQXHmo6O2TKuyj2Sktmck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-fxISLH6qM5WCOM_Gs1HzK2vkJrN5w3QsNnv0xlLfBQ&oe=6A7B1126"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7sdA5ZoZJ4Q7kNvwG4aBaN&_nc_oc=AdrnbAtJBg-7mRr8KmXuuOOBPInumKPLZsjhRx04R216uvmWC1hqPoTAP8NncQo_7OI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7ADtS9jfyu6Yc9pC6l_TfRDv-FJwFAphn8hDl4Zr18A&oe=6A7B144F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7-C2ADpu94Q7kNvwFG8yV9&_nc_oc=Adq11Uy9HBKHO1-0Ma2kBLt_fPlMH0GpYrbLNhdKAu-Wi9PTxLi_zpssZtDXKrq_QeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6bPi8HDJIXHQV41ZszeXgUd1u21i20y_Kf3Kig9cKDg&oe=6A7B23EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txmdH-LTe4AQ7kNvwFufPDB&_nc_oc=AdoSgcOaKwXAZ8Xu5onwvjPvLlILdazVEfWfTecXtUKvSLnRRdFexElIyiSMVQyGrOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOpVkfhyzXmLD-U2SSOEnIekhEdMlkYVKVsHPjoRcOrg&oe=6A7B13A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
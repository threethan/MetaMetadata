c_oc=Adoha__o0p0lxo1wnFEpDqiPZL7durbOPme6dLELNtqkUwazqrLAO98dyEb2MviUZ_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7KYq0kskv4kmVYKuvGpXxgkA5QFv12t0rRnnHT3jBQQ&oe=6A748690"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47cenzI_QHEQ7kNvwGUefO8&_nc_oc=AdpJ5D6eZ5VjVYAyaLJqcPC4aHot0BiSWFGN5hJaCV6jti015oO3b0AUgGoRs1Pwz44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtbO03fwDBOuGW6YJd2zA1IzDHRzCwOY2CtsG4Rbhizg&oe=6A7479A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bsco_knbUWcQ7kNvwG9Ws80&_nc_oc=AdrgDqurpM-wpk4lGj541J9tT7_MAtkE-TSgl6-VV9XpyZdU5B1SfeKWlRRs3aXWvdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlV070G904DRBa2Fps0ERZl50NJDv_IDDc0P3SJdx12A&oe=6A747CCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqUDok8Va8IQ7kNvwEzEf7p&_nc_oc=AdqD6jAcxYijA8wb8kMqPqppF597TZfXvTMmlZcxvkKwXNVWjI0E6MRtKFRk-JenBnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzKDNuCKR_knGGfzdv52YSBW1WZFEy-VTW8xh0cFb_qg&oe=6A748C6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqrjcvCzUTQQ7kNvwEZ4Onq&_nc_oc=AdqV4SqBlIcuedibsL79colIstDxqvyhBegTR29wdRQxo9l-zcvbEvsGsp2mZ2LizPA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtCOGw_0yXFvreKEhgeo9qphTXrYpXie0RBh_qF9N9ng&oe=6A747C22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdpksMBkyIcy7ObstmxHzmGIpgEGeTo6l1WDzwPwzOzZ6Yl2lbN31JOt0Lu7tRscMEg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpIQLf9LRApYR_Oii9TJ0_G4QGJLdAhJ2tiGAStjzpQg&oe=6AF9E650"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTO51upNyCgQ7kNvwHjsu82&_nc_oc=AdrTtI4FBAWOgGyCcgHmYxY-x2HQimH_4EIs7ApPTOVUfugGJGfi3CGijSecCC_pXKE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvOVDAPrdQTCwxEub069hSY94FCqiOFwi8eFz7HTcgQg&oe=6AF9D966"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES0bDaPZdcsQ7kNvwF7aLze&_nc_oc=AdpDTmi96sovZJfDj7cR_zJB6kMpGhMeos2X2_Ectd75FaftaCkC_jKJuehrJPZn6EU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiqW5Be652XNiRe2mhWnjs2cIDLrWyOvyu1f3EslN1Zg&oe=6AF9DC8F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_90GM9t3jkMQ7kNvwEMN4bI&_nc_oc=Adqj_SjHVhPtHnejuNloFtms8ES-LUMNKefaVsqmQG99T-Bm9UpOAo-NTtak9aCwJwA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPBTW-Wblv7Hm_zY0QdOI2szJWTwlUQaqOc9XNumyZZw&oe=6AF9EC2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gZDhDzcooUQ7kNvwE91n_u&_nc_oc=AdqpL7eYHbE9_pUumA-rYZ2CgmrYHz5dIXcCVu4raH-qsKULFRnPdkINkAawGYlJqx0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMSm8E81n6C3z5I05eeyS1bBkn-TY2xVJzFGKWvzoEFA&oe=6AF9DBE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
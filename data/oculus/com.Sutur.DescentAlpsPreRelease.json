c_oc=AdooGpe9pyjTXFjNEtS2SIrfv4aXjySz7NitCy4LGdLAwT3s1AWPK7Wojdun-sdMsH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7L21eTHNdb93EyHOUkqEPUbU_Y3O6ZcM1WowqwORq3A&oe=6A5F6E90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWe0aWgFu60Q7kNvwFqfLYS&_nc_oc=Adogu4Z2KFrGvfi4Of59QR77ylLcJou9ce9av2_EsDmxv4IH1wf8keA_B5f7BRGhGM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL69IGaH3MJ4E_3MEh5Wfuz6KST8zt6c7CR3kcn7vUhg&oe=6A5F61A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUlVkbKYwE0Q7kNvwG7m1p9&_nc_oc=AdryqKtThHrzP2D8p5Xgi_kv7SyERAAYiGVBZh9IYO8lK9LYgDiE1aFnGudcEc4sWSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRJO5bsuCJO3JwH8o688kt673pRJQmMbKrceyT97dXQQ&oe=6A5F64CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMSLrDadFVwQ7kNvwE0oNAL&_nc_oc=AdrJWpi9GymaPgr41Hebsi07-xAhyHEP6nSMMYzsrxIu5MkKofvrNFb8P6UXLhTGPAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBayTfb9_yZrCWRJUiMbemnftGfZ3xve6lNnUAYfMessA&oe=6A5F746A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMUu8WSWmiAQ7kNvwEGDtmY&_nc_oc=Adrwaa53RN_Z8bwjZPdb9SFou5roNVNpOiRG1se-4uQ00EiiolpLXzd2O6IG16BFUNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjkbG4ZbbWuG2Xx_rF3Ch3zm_EreDWSwSvYuV65vMfdQ&oe=6A5F6422"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
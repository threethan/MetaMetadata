c_oc=Adr4dAbUljUXjB7QrOrf4k5vflCbqVpNjxfOVKDmedCDOeaGyvYdvTLUwS-KwFLmecU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrJ5mlR1QnBcdpYHFo1NISXEpv7NUNF9oztB0yA10fEg&oe=69C28C10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWkCngLVz3gQ7kNvwENkhdp&_nc_oc=Adpgy9atpu5pETeBnZ-zY8NKql2epIUYKu-YKq02oK2lGpAUEMmsslXG1CI1KdGOWXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwI0o4tAc_04oHeUuWbccqlGxLGpO_yzwj4--y1gCtWwg&oe=69C27F26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqMStU4s0hMQ7kNvwFexZms&_nc_oc=AdpY9KgSe4MjAKPeNYLYaLGlHZyrAxzEqcBxlu9cGOLv-Ixwk_RsMgkE-J537wDb0Mo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzT76j67shWMLhWE1fAq5IfiR9CbL7Au9Inxdiepb7Iw&oe=69C2824F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymv5awnK-bcQ7kNvwEsT4WG&_nc_oc=Adr7VRvUGXBkSBTfhiORQLHGcU8vRFWkqaSx8w0IckpumNR-Y3lJ8h2Tto1KZEvmaGo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzharII-yuw-BuP0Sj2jc6X6SES1UAbXRIm8SyfBycCCA&oe=69C291EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK2w4jfkJ7MQ7kNvwGRBb0P&_nc_oc=AdqVK0Jlv92qbH0-zLCduUuDdLNnO-j4dEOtNaJ4xZ4DA1lRuXr63eM2Q91ySADmaJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6CAJz881xZgm8vDoYS8k9aRGl_3FkfVrfqJL8avRZUQ&oe=69C281A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
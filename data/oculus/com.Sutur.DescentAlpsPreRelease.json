c_oc=AdoyCtl2dUbolz08Oz3EWi9jQh65FqmFxBDeINXJnq-9_VwhTSH7jBAvul9xeOKh6_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgro6aSX6ts4ro5k61dp29HPx3XgAenvQvdkQ9VAnYeA&oe=6ADF5010"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1LmBpj9hLkQ7kNvwF9yLg8&_nc_oc=AdrCMcYd0Vx4YfD7JZYV-a5lZqwdFJ4iHljht6hEzVqtR_gp91H3xbR9cpOuNVJxCXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAZwLBPeLwe29fEUY1yg2GDm3UQ3ZZas-pBAWvv9DgWw&oe=6ADF7B66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiQWtyvql0IQ7kNvwFiwyv9&_nc_oc=AdpOMgn_j4oNSIjU6Tqur5yDyHkQRh_Ar3Gu1B_xsEvXjeKVWPEO5JZVkB-yNWQkVs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV86YsckVJPXnxyxROq_V3FC2b37zRUuQMBx4VI_Ieaw&oe=6ADF464F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoVGoxoSn74Q7kNvwEnhsNR&_nc_oc=Adr0DUCG8X4Hr6pfwiSJ_OHdqg0SypJPdP9xmIpzDeevPzM5NP2wanEtdrBmgZui3lM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXuvm5Oqg2n0XuLEpVd7kjaGt-fKrzaAE-MHKmkZtnTg&oe=6ADF55EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW5eGpAvnR0Q7kNvwHwCWrz&_nc_oc=AdpbA-4NX8z6gqU8kEMbR4o7X3nz-uNVhS01MvPOgC195QoYxgUsk8LdEZjjB9lKhhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPizQ45Ss95ad4yPEYsWv7UWH_i8T5K3D0VGh6O10Vkcw&oe=6ADF45A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
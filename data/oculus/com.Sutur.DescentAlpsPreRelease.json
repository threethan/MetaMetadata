c_oc=AdqTVbSqwnVF-LQWjlWms34n_Jxn1StcYXn0wAO6Ks06CLD63lW_WGhYA4T91ry_Abo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6dbblW08e1mqxBG0m0_FV0EtuKWUgMKMcKuIaY08pbQ&oe=6AA15990"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBZfA4kK6v0Q7kNvwHKDSsi&_nc_oc=AdqCKfUANKN94GsuIP58UJfXPlntyOolQIgYHfB1J4r3Q2k_DDMwOjHPt7cnFbPa-ho&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU7yb7zZOnBhmtUUg1kYorGvAmxfH1LovCM2GXvjGfag&oe=6AA14CA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RH-bayVPBUQ7kNvwFZpS8A&_nc_oc=AdpfT58j0jZO0f-KN4CRfzPbMxWjWHlm1XI-Kj5GiJsOSjozUnuHWZvIBDw7qZeX574&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXk-xwY0RS2HP-0ZdKx2557qbV1OmHd7Eh-3Q0wdn_Yw&oe=6AA14FCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sggvMRqlJ-YQ7kNvwFK3gQ7&_nc_oc=AdowlbwxY_yYioVgbWHTPhLy0cIuRfnRUewYlE9bZIquNJn3utw5B58QjVESrkG0M4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAxGwB3835APn8ECLzw4VCcotEn80Nyam5N7s65tDGLw&oe=6AA15F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aljxhiJQJVUQ7kNvwHKqQ4p&_nc_oc=Adpm4pSTAzWMxWEnkP-R5vgwJ-j43OhajzOVBL8rX8ImgSwzGde-e2WM2chzCx9Bbkk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPi0-r77lssVAydgSEyGxgvwIfyDU-0kL_nSXcKCdIyA&oe=6AA14F22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
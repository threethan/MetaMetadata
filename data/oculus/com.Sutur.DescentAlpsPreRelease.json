F58mRs&_nc_oc=AdqcnYLSFIqi4hAwOMVDuTXCtbrMhYEN2gSGN7i5pbwi-XBSBx_tBcCZ89WXqeYNBoM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pdsuux0ZPzvSJHn5zcLpfrnGGQi0FB8cCunSYYkEoEQ&oe=6A369010"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_Vqq64Bj-AQ7kNvwF2otTC&_nc_oc=AdqhpHw-KIrAzoQMwP1lGOB1j15t3oY78iUPG_zTMEuGr3k7XRMh_-WhyMHucIXNmJs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mj3DPYHeh5VasK7loL47leWI97KjzKxCFcn7k4Q8TYw&oe=6A36BB66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SjRWWQUDSsQ7kNvwFwW8HV&_nc_oc=AdqComSZyzi-3Xvx0F8JrYxUmM65HUZsmZCGTrhafTqhdQ_twVb3-U-K_IO0R4Q3l90&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R3-zkYt-qAk1-sRWZgn23IQSi7g4NOwAJA7AsAQGJiA&oe=6A36BE8F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19GGIsDBV4cQ7kNvwFpEcg-&_nc_oc=AdoDv0DGVd-wznVGINCArs0hKnKQo0k19_Es4RbbZ4jdYmROcHcO307HFdW0YkXGH1E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lw6znYt0mDhE_WyYL8UYJbXUiPWrTikdgZlVF49iBMA&oe=6A3695EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukTWjd7jdeAQ7kNvwFEG0ic&_nc_oc=Adp3Bf5mE3Jz7d3KZ62QZuJwQYxiKABdpqd9rh1MC8J1Gh3W5Qc79WeerfxDbblBaYc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bw5TbLNIWJ6lfp8N7B_vy1fFWVYjzxIXAPYICoCqUnQ&oe=6A36BDE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
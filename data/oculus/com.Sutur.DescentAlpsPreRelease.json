c_oc=Adqe67uPbQAAFD2u5RrHGZTBnh5_42KvWmrFJRM_9NmQ1MMTN1tQJm_ZYfbA2ZCuhwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7w7MPQuWe4s8btj0TPth7jLTZ5MVMKEsPQ2bvuGyjpg&oe=6AF4A050"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsS6SVTRFCIQ7kNvwFujthI&_nc_oc=AdqqvTG7a3LsaFXr6i8uzBs91iPrWyKBFwjUSwN5nYljCoJ6gJumNgIKfNvF9UHT00g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-4tJDCw8O9FjrXw_ZgyERAnIVXMIfaEcyEs3y0XiO3Q&oe=6AF49366"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS_rp0BYinEQ7kNvwFe8LUe&_nc_oc=AdrYAPEyEp6VyX78sus7muicfjBJEPNTIRJWnhrepGLz_EyDGaqGN5KG43N6rMT9DrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfYfopkT9fpa-AV9K2cy9l0RvB0HHK1oKna1wh6T0lLA&oe=6AF4968F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihb-BGo7DkIQ7kNvwHWHWxU&_nc_oc=Ado1LmL16kmkyaFzQPyY6YUAGb8tCwtPBiERrt4xCp1I1nd0SuGiExtnvty12lRdzqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVgKsoTw_0GooC1XJopjf8cOy8kDJK4mKG6oe15sMp7g&oe=6AF46DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FQ5GJa6zMAQ7kNvwH1oHdP&_nc_oc=Adrh0Ny_gDnxfw1idapsXLPVDqC81C5C3hZTnMWm1tqxZcWYysuWLSoKeKwg8PgpxDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWLWH28LFFTFGdp6Rh1XIMgS3ToIEPjG2MQAHE4-oQ0A&oe=6AF495E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
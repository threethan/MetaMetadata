c_oc=Ado9sYTKJnvBG_bS5MNL23hZafVIUQoUAJ_rSEOOK_SQ7qffqVXolAwawa7kjLcbyFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40ye7vXDZLdPZCSXk7I-xVGUvw2Wv5AW1rdCBM-q9L4w&oe=6A0DB190"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbE_WR8fG54Q7kNvwEA9RcV&_nc_oc=AdqSMvhdXkkA7qq5lVNJamCQTvbQKHSI_R-ajCpmO1UymSF4IMj66nW_f_JOENEVlaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hYa5vLAhO1l0xiIbHEOSsayOL6h5l5qq4nfmU7KrloA&oe=6A0DA4A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0868io9sv6gQ7kNvwEVVwPM&_nc_oc=AdohX5mFUIffnt9e2V73SiGpBiZvyKjoMGCJBV8meekkMT86p_s4fJGHDLkvY5D5zcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OoRh75Saemt4LMs0eaF1oelz-ZYald9Rp1O1Vr97Rqg&oe=6A0DA7CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGlQIHnHWEkQ7kNvwHNz8Et&_nc_oc=Adr52mTUvV8fGL8fptnApCVKL3GXNHScpQgCZ54OHBXj1W4iFfVKm9xlhtByNwzogyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wm4qXYPvVzBC55FCL8EsgRsfIb_e3riCfLCkzi2cXyw&oe=6A0DB76A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3Ycx6WVHkUQ7kNvwHa-xBG&_nc_oc=Adr08JCt9DSNw82SVmjPUnujoIwI5wkQ92T-SfJRWPMdMbRrTtXJm-NwfLbUZw4xVec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dzOmfHwCeNR_JKwTsQ-lvRvCj3eRAkM71DSo3H5gMLw&oe=6A0DA722"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
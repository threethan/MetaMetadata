com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHvceMT-9tkQ7kNvwFl_Y1i&_nc_oc=Adpn6wfcSNuXvX26awWLRC4ss8VVAID_fcrKGTOvTmgoiCHdr32CAn-lbDD928kI8BQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfcFGU38wBWvDisCkBRk-hJDivvmn1i1m2tfUsyX4V5w&oe=6B05A7A3"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7o6hmpZTcsQ7kNvwEjVMEu&_nc_oc=AdqgA9Fh33xEhbkY3tF9CNAPijy-oulnfC_GwuSWFvdIpk7WLfiVVNEL00ifU_OqIjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCMBXJJmXB1q7mMzJqf2z3Lgvv7Eo_mIZAbFYOIavxdw&oe=6B05CB08"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfO6uzjCYhEQ7kNvwGxLVLA&_nc_oc=AdqShS92B8qJDDWSsxGW_0jp7aPImP563Bd6LvXVmmHBs9hp9EUPGCbJjbP61QL3Bb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7-4mcxYQ_P6ojfGeFm54lZ9v0P_LX0vAnCAeWk_MpSw&oe=6B05BC5A"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldSInei05vwQ7kNvwF1Drqx&_nc_oc=AdoTQIpPn3FCIS4zlksoQPC-5JfQ1hNnyeV0l66Q8lAfYYDYLex7bqtvPYSFaePZTmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREryr2o4tFh0UPdk8sHW8dfpLY0VF5t8PzrkQigVaemQ&oe=6B05BF42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrR0fyqerckQ7kNvwGZp0DL&_nc_oc=Adq8sQsqLKMfVtChXRdegtGVFihJLa64M3gusx3vAupKtp-BXWPEQMmojY6RgA4iaAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbI4-cjIl_2OeLS1a5XpMkkhEH8BIL9nmU5BFOdvavXw&oe=6B05B753"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
c_oc=AdruIYkzHqVvUaCooV4BkoNTH9i7Is3b_-uI3F60lsUSXpIH91hV8zOSw2y9u1o-TP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lJWWY4YvUJbNthXYRAO6J_T0KgWkHlko9kP3BIRQ7tA&oe=6A43BF10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-HFTKg73x4Q7kNvwHy8vHj&_nc_oc=AdoiSOxCn2ugftSsz_zIfiGM-Y7Qtr8tnczj_NEleNupjVSZAX8jwNfcyMyZH_-8Mks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yg1kD3u-x7-MNewe7AEIzXnOM3_KK_84IeaJXHPs1zQ&oe=6A43EA66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeehaxoYvpEQ7kNvwGSxV_F&_nc_oc=AdomG0_rSlhn0oTGdeeOos4H-UPWDI1jEbHEw52Nz8hevfqTvAccsm9F0hnilbK6nEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_33lqr0GJ21EE6_TCLSegPbYLwFxAjA0fwVVh8IjxYLA&oe=6A43ED8F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMDYXFmGZmcQ7kNvwGG3QWA&_nc_oc=Ado9wRTxyuFLVSK3j3DaAn6Qx3DUpmekgi-thKBpuK_-2iF23VpD29u4y0BMgS_oE6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tfcYKfw4BcTAZO9THDwcuwCqdEBONZ3Rwgpr_LafEhQ&oe=6A43C4EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiFJh_48c6UQ7kNvwGhxKfS&_nc_oc=AdrlCww4oxLvz5wKdoiMoAueJXppEevxtiFbHzffMPhdX57-rrOQgOjn779_9QfIxBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mq0-kx3PTpCnYmlIw1g4FEkDIizHL_JzF6Sj24AUvXw&oe=6A43ECE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
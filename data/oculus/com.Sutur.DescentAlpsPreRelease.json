c_oc=Ado3iAJ4FRuPBC3ymeCAYDKFwCBgB2JeKD1vfbENsOdIdRB8BL5LWiNUev52j0lf1xU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfQ2ZsZ_CLsQ3xbBRUvXZT-zGb08p0-JVqkJYUnXW4vA&oe=6A58D710"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDPwtZSiytEQ7kNvwGZmcb1&_nc_oc=Adrpx6zQl9k9RxBTishQS6dp2nr-DHbPKpv7eU3pSBtpJ3P5s4jxJCpQ3eoksAne1i8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8uCzu7wbAD73im0S5uwmUieKU7FgRhVWl0Dm6E3j01A&oe=6A58CA26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9pmHrashNkQ7kNvwH0Qxtk&_nc_oc=AdokvF0amqTFj12wMijGTnobrHnSNf-cTiGy57YF85a_As3zSSWRzeuWEq2eCe0Px_c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByfhZCOnIS7k0gsjp_op5vWUHwcB2_5ekg5o9D3k_QVw&oe=6A58CD4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptuvZ9-KqVMQ7kNvwHUJhN_&_nc_oc=AdpSKmTuUKxNyZyxumsrs4gLnRGxIyvLKB1Ib4QhMBxAFVVZCTmL-VoiTsGZpWxVuJo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwZ59V4g3u6Ml6aWVXpfqSScEK1F372rjD-goYpChlDA&oe=6A58DCEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL-b3toXCYAQ7kNvwHHPVLL&_nc_oc=AdpWMDZWT6LHNhH4H65xTCb5ZAEqxZli39xnIf2RyCzjgZYN-Pa_xOU6uMm448QCcvk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMdTc7bqW4CJumJKQqConnxfX1fzaWjWme0je1RUzjyw&oe=6A58CCA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
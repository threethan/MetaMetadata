c_oc=AdrGx7tN0YMmBBbTFV8tnnvR-f6Xjv7efZbwyQvz7y9mkp5GyOVew1_d7fm-Px_TXrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODvtzfASwXkWNU3wA_4wpg74nOrxFvRjT_h_-I2RU-Yg&oe=6AE0A190"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGNkrfddPu4Q7kNvwFfOG0Y&_nc_oc=Adp1Fp48pBla3kruD88VpKh42ygsQCWllxmpRQquqGTkWnkLh7u8Zs8cwXYcTUJLWu8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5FkIBj1w9bRW7yHnKfdSXjf2Vy2goSti4d_FmgRRsMg&oe=6AE0CCE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiQWtyvql0IQ7kNvwGyuiWA&_nc_oc=AdpvX2zdXG2qkxQsmgUU2v8qMxCwEKtKPsn_i6PcBpXla7k4JPA_vZY-jrkZyU1yo_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuqizhaWdF4pGJrULpLbI_4nqlWcQr552XjQjdS_aYUg&oe=6AE097CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoVGoxoSn74Q7kNvwFIQuzd&_nc_oc=AdqoxxTiCJT-bF9L-lIEsQULXbLPk0pWDaz6E-Qw1d_ZLS6OUqy_AmwWIkYInlwqIc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME6IhaNi2zUO0xNShE70Ud_CT7mtuO5d_LBDEunybTeg&oe=6AE0A76A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW5eGpAvnR0Q7kNvwGZFwDV&_nc_oc=AdqI3hL_1-wo1kxPuKziwRYSmI2iByZZ5qjCkHxjAQLjEcpL-tDBME1QiiyHWyjpqqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9k8HHUht1Y-uSN2cBSRjdrb2gj7nGLLNc_ez2bRyBvA&oe=6AE09722"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
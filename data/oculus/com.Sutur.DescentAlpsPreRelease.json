c_oc=AdoVgq4Q9QGqRG1IkqMtJBhYHLIt1s93f3UdT3TeKNqbE-DbiXZyL3CE3FS6DqVmrJ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IaZYF4SRIqP3rO2xpRXxvrBpt6Wyf5jythYldgGm-3A&oe=69FDDF90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39S4_P4h8JUQ7kNvwERfCFc&_nc_oc=AdqZT42xnvBOSqOLsiiEuhpGRYOO1kGwtcauA0JA3RCccIy6B_-OFD4DBgLizwKn3Ug&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42hyTBGHFlOH_2OomptHB34fYP5sJZeuBZkKTyHxFtTA&oe=69FDD2A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY0UGZE7D6gQ7kNvwGYVGKB&_nc_oc=Ado8atu9Bxj6BxNsejVXtltG6n_Ht0G8g4ADl56-d1nuL3ItR348UEeUEM3AbVuWx7s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ud4wquzQ70kekGzASqVaKPbnwdf_c7_Srhz3CyQISsQ&oe=69FDD5CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyrz_WYHdXoQ7kNvwEBgnd7&_nc_oc=AdpbTP_oJKw3kOsnakIDRwYrJ63LBY9I0FvL6ahiNlLWP9CxJxn1tVUuKF2x8q6e8N0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LA26RVdCWn0XXTedfmKlpUhUq1SmEUNJOXQSmIv-qLg&oe=69FDE56A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFrlYJbbzssQ7kNvwF1SmhK&_nc_oc=AdqtYaTUCOWrV88TvbuRGPO9mv3uIBTE0NRpAyvhvHqG7XSt16tskWkahDMSj0pkLY0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VNmK6Q9V0yDs32tSPxM0GDiLiTOPG3m9f0AtYUor57A&oe=69FDD522"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
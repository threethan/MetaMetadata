c_oc=AdrDUR6oP4nZVcIv5_rLrqYpys7ndzA7TcZTu8j1xdBW8EL0cYLxNP2QvvalEtL2OnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUoiIylYP6MACRiun0axg4EJT9tEHZTRztyN-TVunfcg&oe=6A830710"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtyTL6OOmeoQ7kNvwHXXT7P&_nc_oc=AdprF2WS2dCB8G1QvhZnoSdPpSTgAPNpDv2a36GeVHJrLFpHOuENNBf99LVxVafddqs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUZODxmnwil8lU401AJcsXz7aGRkDCyYmX_MrhMQVTTA&oe=6A82FA26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2TYz61fx28Q7kNvwF2OarD&_nc_oc=AdqXjRrQZz06MzdiNv3mqNGORgx_OsoHmbEIuXRBVgxK8SlGEqR4sYjZm-ozT4bNo2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjFNzuoCROT1fzWkCPtJ5Ybzu_D6Yx1WQKslJmUWcSeA&oe=6A82FD4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7Aizn_8jOIQ7kNvwFLS2do&_nc_oc=AdoVwYQDTPKNLNd4aXNwrQPnMpwJh5zkGeTh2FrNnopIPXdzFU15sJfYb1z1n_HfGKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXjFB3I3vkHhyxzq9rJnZzb55zU0Y9dMjRx2cZ-pDmGA&oe=6A830CEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqbgv14W1BsQ7kNvwFIM8vn&_nc_oc=AdpXx0c-_WgNh9o4LuUcfwbDvHAW3kLo9WCkIVFS6iCLt1BPRf8EX00EbE6ExrPMqJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRe8znQv02HDTuKpRlhB84XBhGtEYCZlUs8qzI_72qww&oe=6A82FCA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
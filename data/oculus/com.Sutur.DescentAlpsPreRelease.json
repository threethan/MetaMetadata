c_oc=AdqpOe8-sryUw1DVLb_IMEQI10eazwJ2r7Qf_InnlQqtNYeOu1rRTpHSPCMFm9xhcpA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcD7njt5BBzFIhMONX2fveIG-IoFgws1M1yP_dbOXsWA&oe=69D10C90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpJLlAEEXJoQ7kNvwEeAXPi&_nc_oc=AdpSNGlX3nXKfeumPxj2296XOtgofx_P-LYB7Gh_4XRPmM8gLE28xf2zB1ou5UHfEhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXZsQgp5gcjyXqR7H3hkCBFyT4MxZjUg8EU2EOy7H95Q&oe=69D0FFA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHkW-5HxJBgQ7kNvwF_chck&_nc_oc=Adr3601ENtZIQmR_bP8_DDzmTx-zt5O0NyXVbxJrhZCbX8LkJz1dJHzF5Zn6SEEgu8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxsbgGXIOpN-MstelDbOIxsT9OWP4pTMoyqZ6vIsQcJA&oe=69D102CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osPFhiWAlOAQ7kNvwF8Vl3-&_nc_oc=AdqnNKcvJ5-YgxigIWALXPZ9-jAdqLQQb7ZAFRKvBiaztpZkgW7GPRNl7wfgwpdKk0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEfd5u8uCB3gJML8rnHE_-gIqxm9wM4VapSbKKEkQemw&oe=69D1126A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDulOrrEuTEQ7kNvwEkkOZ7&_nc_oc=Adqo83Fr0x2tkAj54Qkz6azwCepD_4I-otIR_t4uKZfmSPQpuXpOo7dgmx54ISU5-Lg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afww0q1vVjoMyto-3ba_Xw51QlOhzSJ2CVnulvYT3NMWpA&oe=69D10222"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
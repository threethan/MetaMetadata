c_oc=AdrQV7nS2HQvvScV3Eur3vQjOlkA8lPOA2xN3rLUhe6yT6HADr7CDC-ZZ_60fOv6JFs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5eLh3d-lnAUpBb8vSyLqd5IO4zUgWfl-D_5VavBRqaA&oe=6A217810"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mo-R9AgzixAQ7kNvwHs3Yjn&_nc_oc=AdrilC12sfDhIL_Z8DnZfaFPVJ21BdYjnjAnIjgx3Y6ofGhS64ElIVK-SE93-qTJ3B8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sYT7kG4Fsq5fIdAnA_ljfXRXpenektStR055vgrOnKA&oe=6A21A366"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQGBQlBr1k0Q7kNvwGDWZ0H&_nc_oc=AdrghSvgkggC2qrpCVV0-SoVbOIh3DfSOk3hZ5v5nIqk857tmb7c1RfGMBHK7xNfsSA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vetAsKrZNu2frvy0kPtRr31HXKpuNGWWR7jZ9n2xVZg&oe=6A216E4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpuIlmDQ-4AQ7kNvwEFRWQ2&_nc_oc=AdpVOww7OMXYqPKCd3T7EAK-kA6Fb7vb8jCoEBpb558drbnfDH-8adPgew908KMwx8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EKdneNlPKLrUOrMcdpMHkKslokvsMlQUMGYMJN90MUw&oe=6A217DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_19GzLlzSJAQ7kNvwEqLg7T&_nc_oc=AdqxQUp8FAH7alvFYExz3tsSWUr8GtXeW6qh5jVTzCseqHePagz4EtYZEv1PSrWpVqU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RMACN2ME7TcSKS-ayX00ECSIMRS1n9eQtMujDixwQpg&oe=6A21A5E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdpRWLRPdN8io3ucf_1ScFdKKHlADQQAtukLoCg2-eVGnRYt8Nj5Xzmvzcbe4LeoIKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiIJLc6Z9Saweh3EermKjndaXr8oJyhbPgKylADu3wUw&oe=6AB27D10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KUyIg3TbGYQ7kNvwEMa0oG&_nc_oc=AdoOLBA18WY8FaQxgAMl_hYHw9XYmUBgg8kZweo01ZHoclx9KgbtIoyKTEIdk-Ow_TU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDtdOQV244lnnV9Mj7UiBxg4__c91RtR-JbfYN4nquzQ&oe=6AB2A866"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNF4MDJVZJ0Q7kNvwElXTI3&_nc_oc=AdrxCpTRyWZqNpKDzlMJj_GMxRjw9DPGQpIerjIMlcmNkrUTH0Zf_mjQxkmlrO2Riyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtWi8irCVElItV6Yno9HgIr8ZZbzCRRjOehrt3ouh-eA&oe=6AB2734F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtaX8snLVT8Q7kNvwEoC-m_&_nc_oc=Adq6Lk97_2n8XkVAQm0kfn0L57vq6Ky59FYezTD9XRfCa7YJ2dF1wpeaJ8JR31SPwjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTXUW2PNEi6dH_rqDznk5XL1fGsGgJQDQwMjQWyr6MNQ&oe=6AB282EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJHl_f_m-Y8Q7kNvwG5sSUB&_nc_oc=AdqPNpESIjEvQt-rZTPGOyaz-G9YFVjC42LdFW-s77qSaJrUZBzmD0ZB6SlX5KFeq4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFI-U69kts8vTblJVwJ_UT703GMd7u0QYoMLcrJJTIIA&oe=6AB272A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
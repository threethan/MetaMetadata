com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7e7rmxI8U4Q7kNvwE3s02z&_nc_oc=AdqxkqX9Bn6tP4Gkcu4CrhppHp06o7Ry0LFfJjeWnzOElvXAIaK0UBOgc7OWqn2sszw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXIdzYLSoHjnb1ZIGs_V3fCWiPysnWGVUZWTz2qwt8ttQ&oe=6B0F1A63"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqVyEESpxV0Q7kNvwFaHmDq&_nc_oc=Adrezm1dGkJbnTY6jM98n7-FcZZxo9za94FLih7LRExgkXXualAy0OGF3kBwMJ8-acU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeqAAs_QCB_oh2EkffYTLtBUpoqG7nHOljxPlZVuZ8Yw&oe=6B0F0588"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IfQ3FH-sGUQ7kNvwFxYujb&_nc_oc=AdpfSEgLu4-9zvu8_b171Ra_vc7-bn3dfktkjE-oEhBFXf2cw23YOnUXw28y3YARx9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVYr0f33t1VjNEoegzD56bj1gA2o5RT_YAlnZKsTFxhA&oe=6B0EF6DA"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDOLb870u7cQ7kNvwEQnzFF&_nc_oc=AdqMuSTd5jE61McA4cF1cyAljbnTmjlDYuPM-yKXn5Hagd7q1X675AbFBX621EXCaaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwIEGo02z_7jKuKnUiXLCqBNU29Vc7WcIxNglfLe7zeA&oe=6B0EF9C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njaMYvapOEgQ7kNvwFB33Dv&_nc_oc=Adq7QnO82RQav0oAWb-yL5J4pgMvMoOxlrrmvzXiaQ5ylgl-mmzTswZ1OsEGycQaSUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFUbSPFbJ9SyQO2cfLwkcJDcYoo5wiJkOxJmu19t3P0A&oe=6B0EF1D3"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
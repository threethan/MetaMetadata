c_oc=Adpj630hcuKyW_IY3b1amw8LQ3pmONhZ1LtGpsnOFpSGV0OAD5ao0ooXJjKz0YFxXo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwxL6MMwzywe1S_6bw1Z496V6qC8SVk3iSJCKYzRN7cQ&oe=69C92390"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP5m0dbQtnoQ7kNvwHOGXhw&_nc_oc=Adogk1TD21olYhObyO0mZjxpK-Vp5liVYMxKle-0dP0Lu5-QgvzWdmCM0NvRhBAUVKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2CNB3bk2CLLbVPEhD3XM05hKNbIhRp9ulqvyIuxvCig&oe=69C916A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R81e19ztdrMQ7kNvwEJjrzh&_nc_oc=Adqri1p8gHhjCUUj0cqwzqHS5kS4FmgsAufhFVVdfnqx0wyWfwej2yH_piZji7-nh9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzElCbF3-No1pKJDOyvyWSVhr2yXDilrVmJtufS5gfWkQ&oe=69C919CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SamZxeK9kkQQ7kNvwEYNCqy&_nc_oc=AdpqoYJa-c2_xvKL-bvKTt5tDcQW8GKWs7jlDMVNvRFRmRZriZ5RuNQq9--X8D4U0A8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTnQrF1pmp4end-YfOkxfE4Y71EICdg3hMG9cQtjWzuA&oe=69C9296A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aj4F8xSLzWYQ7kNvwGjfgWG&_nc_oc=Adozpt9RDKl4imqdBuFlgiEYN_nvKfSIBOXeVely0oE1ZDrXZd-VrwPhZN0SKVU-Rv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynGA3TvyReU895f47kaQCkxGE52opMxmxg8MDKfFfpJQ&oe=69C91922"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHvceMT-9tkQ7kNvwFnw01Z&_nc_oc=AdpE5gUO-kj0_fHbK3caToZd95cAkz0kWvNtjuHlrIZqMeOpgdg2OVLkqnVjkqCNr2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOLR3B_523EfxvUoc1yMBqN6Us6Dyje2KzFU_qts7LdQ&oe=6B045623"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBAsq7aj8-4Q7kNvwEUeSll&_nc_oc=Adp8W-at6L_QqZYRDUWtClBbzXs-4cw_NuBX-yFpP-Up43rF_WCzyPhIY9l1lWjgjBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo80oCYUbvf7K4qkPSUuzx5GZK9GmZ-ufe8qtgM8RwIA&oe=6B047988"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfO6uzjCYhEQ7kNvwHUEF_W&_nc_oc=AdqdYwT14srjlY_fs0OMM7vyXtbj5Y3Oon5BEpqBh-WfZDGK5Mqny4yuaXHmemPOf-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRauGspE8cytZJtUeoCQ5kKA03kVHVyKsxjVvIhM3UU1A&oe=6B046ADA"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldSInei05vwQ7kNvwEBRQe4&_nc_oc=AdoOH5CoW4FAaBR2HWyTP6rU_ovLnk_sbXU66dZlorOQF9f97DX3sIER8Upq6QCBnF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwh0x_YGOnmjCKrQMpcJ8skacGCNOhkkOkmuzzXFxnCA&oe=6B046DC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrR0fyqerckQ7kNvwH_OQ13&_nc_oc=Adrs-rq46cXeNhJ9okEKQmknOchj4KKLbkjPdXJOVgdMnN8kLhLVBhyFe4MkbmWtbrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROh5_vxU_abhNm6JBluULCqtoRgBjqgputVUR6ACP1hQ&oe=6B0465D3"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
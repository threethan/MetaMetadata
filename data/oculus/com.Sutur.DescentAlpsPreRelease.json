c_oc=Adp7SOS-5CtyXwxFeGEi4u9ubXlLwPNhYja4el-eyisH3izZ9HWk9bumysq_IzI4AG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w-M5xtuQGwQms-n40QUk5fXq15jVwvjYEasrSCuEmyA&oe=6A241B10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pjPiu4fAh0Q7kNvwEpkzbV&_nc_oc=Adrx06-9OOccNjUECspvFoTqi-fkhf5FRF0Ly_ETDz0IZNYCuxIw4mlTqrcOPahYd2s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HymWFMJG8ZAzeRKnNONeTAkNOKx2m0rLZQzMWo2_lXA&oe=6A244666"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQGBQlBr1k0Q7kNvwFM7mDk&_nc_oc=Adpk5Is5AnV7HhZhvfNUDogaWJrTKSZEjGX9jdclPm8-LgfkJf8hJFXYr82zj6Imd6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nK5Of_A2xBvFmLRjt_2y2tUgproiRj8hkimp5pn88hQ&oe=6A24498F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iS3oafNdV-gQ7kNvwHLmFsf&_nc_oc=AdpBR_LTKeCtbUtCWWC5vOKp_CZ246qySDQ7JoUMU3vU_dqZRwS_CoJoLBRCk1LMVqI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wkvZmdFQhsI8cxCjRWQfRk4Iv_r-MI49VE3iFAlhsSQ&oe=6A2420EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb_HzAyXWGkQ7kNvwExET-A&_nc_oc=AdoIvlHlGUVpLcYVSeFSgAHQ4lqSKzhzqfhJyjy10lge00Rwea2iCh4FmW-l-JHsP1M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E79W91Tkc04SW0SONYmdX6r9osX9oNXOhK3EdCK0NDQ&oe=6A2448E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdphXjQpaivLO5tjS1zkh98RB-Y_lspv6MbBO_IhApYt00Nqo58q6we76JhimbiqaUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37jyhMNoC4V3BZDKc-wgNlbbxF2ehZEyO4NUYLzeAfmg&oe=69D8F590"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij9mtEFVJ-wQ7kNvwFbSVUC&_nc_oc=Ado83quhWkuVp9n35vw7DB75BMqzhMs1Ob3MOUuja3PemaN7HiVdOFdbbyxbWTHNfns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e7j7poEZA9cUj1WZpdvjXGrUGpVqiJ1PrXGuGWuxLuw&oe=69D8E8A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyU9H4PrmRYQ7kNvwHIM9T1&_nc_oc=Adpo4dgHYslbWjHLtmJgeet8eAYNzswl4ZiRqR9iw_-0JAbTNxLkp2WmzGDRJM0Zh3c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zrAyemjK2LxDvJ0vg0ApbSLnYnoUw2rudY-V3AZjiuQ&oe=69D8EBCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm3jgdZKwZQQ7kNvwHS1ifB&_nc_oc=AdphCsIG_RJjdahWV4QiKDAFscSLHtxnHD9OXHTqwZAVRi1zd1tefOrmzpD8AOER5Kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZbZkpVXO8tONMKpUtO0cPRnU4Ib9A9y583oeCG4XH2Q&oe=69D8FB6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qNEUCCHXrQQ7kNvwGzETPV&_nc_oc=AdoagzuannC7fLWIg20BMZ3twMKzbIhPHiJPOXBS5pq0TWzftuSPWFkLwlTkBNBfQr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hiOz7_R3xrorFm-qZOyPMFLUXSc4SQgFBsYJdfWuhqw&oe=69D8EB22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
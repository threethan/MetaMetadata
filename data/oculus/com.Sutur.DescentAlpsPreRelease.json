c_oc=AdoYZj9ayCBsXSphwejFdxCqJp8GrZrA8QZooGFgY7r_2kwQgfkvp8tWhoWORxQCusI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m2RqJsUw-UEfw5PTza8u4hZWw11dbbja8bcSFKhL0YA&oe=6A1ED510"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mo-R9AgzixAQ7kNvwHUT_kP&_nc_oc=Ado9CCIn2G7iDX49p3zLhCQWaC3qEbvDM4TY3ogYGoY8G80ATmAgfAXZp10Ewkoo8zg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x4zLz7BdvJVyxAESWcIK8ePxNiGSdnOaIkTXJ0x66wg&oe=6A1F0066"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kr3y4FR34gMQ7kNvwHjR7fz&_nc_oc=Adrvvf_jstsETFEAjGE3XxjYCkNrE0G7OyxOPiEw-0dy4Jf1IhQQsBiWQDGneVwz9z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mM2tGC3n68eZCwlB7CO75dhjw9h-5ojAWOpL2z3dDWQ&oe=6A1ECB4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sVSOj7AUgsQ7kNvwHtmIj8&_nc_oc=AdoPaCHVdqhLQqj5VRaR_GvpDZzsgkmK-l4zbQWvJ7D9U7uqd9sCkOBvyiTqax_Edhw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uun-sI4gYB8nN_BDmWBpX3ZK__Gi5k6WTjRE209Yvjg&oe=6A1EDAEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhYwlh1-O6EQ7kNvwE-8xI7&_nc_oc=AdqI3UeSiTl9gtEwAQD9NN9ifZZXKoGAzVdn2-OkmhSXCOCaY0LB_sHyUpttZiyF2LI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I7DA5S-NhwFpI3QLONWSqwz69dbqThWRcTCgkLC0uEw&oe=6A1ECAA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
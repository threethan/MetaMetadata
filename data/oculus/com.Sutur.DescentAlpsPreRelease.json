c_oc=AdoUP-3P-qjm-S_i2zTuUciV_mGXomkustIxgQjAhq2fJS37f8onkxsZv8RqNkOp1yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8ZDOH5LsD_ucsf1lMEBs9UQmziCxXdXKiPQ9i-pPo3A&oe=6A50EE10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1PA4uKsnKsQ7kNvwEX7mUv&_nc_oc=AdomN5o-VXfhfxX9dwqAwqjZf8Tog2mkS5prjY_nTQJPet4ai72b9lNXktG1OHHBho0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWZNVO14PywYKGSZUrYls94BvpUcGFvZSAZDJ0MP6g-Q&oe=6A50E126"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5HHSc2cEAsQ7kNvwFK03-y&_nc_oc=AdrE8osUlGDav3k7wm3agMF2LvsQf7SHQvwNZicWOwxe49cSYqOo38aXOeqfkftd0lo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABL1kn78FelHsIpvHs6GaExevx8ttv2ZeTyvj7LvWiug&oe=6A50E44F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KwVQJ7DiYcQ7kNvwGTpxRc&_nc_oc=AdqMcffrWJpfUwPO6Z-bc3Cf_dAbSS2b3l-hQIgUtVhgRRRNGycMfAZ4xyTmHDEDc4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9er9iPZCAb6hNwvdgvSc8C4pR-n6DggTd3RgP-YCQ4g&oe=6A50F3EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHhCcMU74hYQ7kNvwG3MQXe&_nc_oc=AdpRa_03VOj-O2ahbgLBBIiw9c8dP-CpxguhBgkWZxa9eyH-tgiG2-j4aoZiO3XNSa8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFeH3KiLS2HI0eUBPzXrGh6DCoezZQ22GYvmkp7yjuYQ&oe=6A50E3A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
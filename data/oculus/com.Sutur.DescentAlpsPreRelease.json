c_oc=Adq5bE_QSIdFN7vwhlrgicMLPuBrbKUD8FNp9VFpCNVBl1RFQh5oMzamZZ-A_Mt4nrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OBt85wO3S_IQhqze0MH9elMXhY1XLsnr-hVOeAwqrqA&oe=69E4D310"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9WyC92G1XwQ7kNvwEZhENF&_nc_oc=AdrHVXN6oQ39hDBurp9feOTcqmGrqFmfFRs_IWgcGN7BfnyjduykWpbgD3SVJfm1iOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qrTfA3pW6GVmRtEVOn3T-W6NqAjICA6qnQSYQJVyitQ&oe=69E4C626"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyOcUzAtQioQ7kNvwFv3e7t&_nc_oc=AdomshBppYO-gvNYZPE948RzHtEAGHsw9CEBRCSD_VYFfRignPjkK_k--aJy4erm-8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Gj_gQodzaEcLJ9ziE-LwMCs4leTyJYOYvjOouEE0Tag&oe=69E4C94F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp3f99tw3YEQ7kNvwE8y5go&_nc_oc=Adph-p1pAEJFHFS_QCOdAwfZqfSn8QqD_YJqyr6NtuSKdd7AcY18aqkCTv9-sIStChI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pCOubSwE89u5iK5XQJ7f6Ip1jRZG6X5ipLIXVuMpWRw&oe=69E4D8EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGShHDxUkfUQ7kNvwGhgOI_&_nc_oc=Adq3PyA3KBw5xa3mr8FpqidGXxgmSB1UerC3kA1zMWFQSV6QfJC_nO8Biloa5pILnQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mYYkyZg0g8lL_fN6x5dsJ7b0ywU_4srKizvtXv-fmPQ&oe=69E4C8A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
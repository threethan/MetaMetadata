c_oc=AdqJzCc6x_FsY2PBqpaiboDl9y1PkzD8KpGb41fJDwHAiHQgjx7iRQJtUP0FgyUTPds&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaXPdnXgOrgouae5MmXDEsbm5vBOiFovzF4FxLsy6PLg&oe=6A903610"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqJWEv4NVBQQ7kNvwF1uL8C&_nc_oc=Adp_Q6zOMiajG_jOCB6CBHbe2Cx1hIPyAe1PAqsvsawAcf8LFVeYQQbZKh1CGIhWGB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoHDsu7gofKAD2Hc1cmBw7nxd4u7lIwBxYyA674yRexg&oe=6A902926"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LM2hUKH9XQQ7kNvwGsOR_V&_nc_oc=AdqMazl_S4Tdyp5AWntdjxinqbBM3Hu7bJsVxLWwPLTmlIbBE3pbDNuj0Tq6C2TigzA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxTP3P2KNEZ-DyZ8nQ6zKR8ISE5JdEcWu2EE1t9HjE2Q&oe=6A902C4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkO4Bx1dI_MQ7kNvwFc0AKL&_nc_oc=Adr3UM1yDsx3aggPE8RpzRSf0iINkPShBST0TipKUWncOOEYbJB1u4588J_iSzp-Qbk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVS0nIeZKUfCHb9FuQQB_b5o1XlCoyjd6-44Hp-zUnAw&oe=6A903BEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgBJZSUre3wQ7kNvwGKjzDZ&_nc_oc=AdrQgulBygTvhl2KhHzz9blOzn5lLVykpnfzijt7tQVre1tVsW4D0tnXmUbHUFXR1ME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHkjUK4aar3X_PCUON_QrEurdfHE2PjLAoaTBtsRcgow&oe=6A902BA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
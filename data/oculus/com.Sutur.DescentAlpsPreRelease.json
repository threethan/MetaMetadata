c_oc=AdqAw3vdMY_oVOaa9B6SwU6dceIu7ttsbLWpG50s6o2FZxVwnL_hwGbKGKfn8wCI8gA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22314i8yWW8GEFEaeMq7TnoFd3NaL0BX2st1KhAG_R_Q&oe=69D65290"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWqALgOiq6oQ7kNvwEIIq-i&_nc_oc=AdoKauj_MUGwHfyLjjlz0k-pPwqzS2DDfKJn_vYFhRLQJiOxyTPLTSV0FpbWk0m5tS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af392QXxMNokE0OoyI_0yg7utYAxacbA4UGuwA9LNodyrA&oe=69D645A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyU9H4PrmRYQ7kNvwHSpb6j&_nc_oc=AdqhziqC1CeEvRliN7Kt-Dlmszthcq3VTAJ_mmIAUHkuubwZI_HrevQKBsWgDeK6zaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1azj0GSW5iV8gyB5wK5BuktM2gQi2shHRy33ZKtUggWg&oe=69D648CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PflVtwhCl2AQ7kNvwEPyios&_nc_oc=Adq-rqAepxYMtC63P9M-sxlms2LfufvzxceyQn2-N-Uh-ej-LU6y1Y5rgkN8kDl-Edc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qs9ZsV9Wf3Hqbzl3tml9P5MkTO7yxGPAw1oycZ8A1Aw&oe=69D6586A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK60shAq7cQQ7kNvwE8uUPR&_nc_oc=AdqW5ZIJKW7cVctIeR6ysy6e9e7eZnsB7mY_5mynwnee8nG5LMuQqjS4POkk5o42lAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A4ufcRtChBo1f-Kf5fWBOzUYrBApD8VPXeFpQfHNRrA&oe=69D64822"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=Adp3rGkfsxx3JUZRXcv-tBykhZKc6O-F_6G-j5YjM2ffaxoss0rMG2D4vyzcK01dHXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgJajCJKU8OUNevESrATz74ldTcso9kwiaoLybveTGWA&oe=6ACD1350"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuO0XZCTa2sQ7kNvwHrG5bU&_nc_oc=AdqqRdcXhZ2aDBrDota_XVwudakBbqDJcV3ftwUZ6a2bYyq0wS6iD-VaJR6G8ljT9ik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxnChOnFxDdzNLrDcVjIoFjkiZhtPNfkoFGfEZmZG3uQ&oe=6ACD0666"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhq9zp3BuYcQ7kNvwF9pOFA&_nc_oc=AdpYvCM7U7KKJwCIoqlODw7KQt2dXasLc4d9EJy-pnxOqmaZIC59bJOhPHS0xu2b-rU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVuNdMDwaPlawnDOvjgzigzcB19CtG5P0RwgNpS9SuWg&oe=6ACD098F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHMX5DXZrHAQ7kNvwGFq2nZ&_nc_oc=AdqeYRFRfpRAKBJtoxfDBjsyGhluvCcRy8LdFeZFRxUl8BdEjLRM-WGvw8R5py5fc7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFAKHgcHt9GWOpzRqe1fqDCYBVLNNEB_lD2H82LUGvcQ&oe=6ACCE0EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnQmIfoEO9MQ7kNvwHKqF0j&_nc_oc=Adq1RR7okC6bBuP7uAYho22bPOP09T2RDMt1Ho9K2031yaM6hje310qzeusL2PwhwH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgcF2vkRaPqCsgsNAbAaRGo1KVnszOHK4aVScPrhrOBg&oe=6ACD08E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
a&_nc_oc=AdorrZucsh2qr35X3weOOcW5R4V4q2valAUH_lWO8xDoy9dBjYNlhVt1zcX3x3YM3bg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1k7vLlFxHi4QZK6WhPjAKW2ZlyHTSNRkP3XOV9I4iEA&oe=6A830E48"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imJxoMUVWA0Q7kNvwF0O9zI&_nc_oc=AdrVFmtasrkwLKyZIFsS-LeDAqEDNPRXTTlK8K8lvtVPY8q0hr_h1t2Y91U8J7Cx0S8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxdRbHM7xHGlqkhw_bW1Zmfq6PRYM3rN2fuz9HDUcCag&oe=6A82FF9A"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRsTy1F4c94Q7kNvwGwMPA7&_nc_oc=AdpkEnDjjCr3KDSxgcDwohgn-814JasxxaPJCG3SeT0MvgjgJrQfo5NCFj_qe7J8KYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP3yj5S6BqIoTQXpTuQ3xwJ65_u0n1xy9u9Q_1ty0s-w&oe=6A830282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSe-2ULSD5kQ7kNvwH_-4xh&_nc_oc=Adqpj-6AhOd8KfivkhjsT6Fcv3EjYqGfMnmvm13mTWfuzUXjt2jrKKnny4OHKI3qshU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2ztR-Ii8TMRQNXBsuOv3tFGJn8dgzMfKbSBVcXgxo5w&oe=6A82FA93"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359328815713034"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": 
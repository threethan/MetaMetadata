c_oc=AdrwP-ebz7fkccobi50n9g86uYIi9ecYNR3VN7TjJBAV3fefd0Zi7I06w_hF9zolznU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9vcSRG-syXDHKYAINz9GK-WZ-qHSQqzmojXZJCFGALw&oe=6A806410"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxriBjh9DeIQ7kNvwGMuS6Y&_nc_oc=AdrlYgQKjttayPyRVJnQvxfTtquLudeizxpMTX9fuJnu0LY_e4CAheGJxw7kHhHSWpk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8MTy43mArRpJhgu7oimtyA6NWbBW-MDhKbOceswKrNw&oe=6A805726"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2TYz61fx28Q7kNvwFLMMIs&_nc_oc=AdruMZxaDivdwgW8PLkw87jaz4FzTecbTQbOd5kYX9pcwgwrsUIPYgchz0h-I7tGoLk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxN6-XWXCaKYtXjKmxEwAacJqVD7vUgdysKu4av5FAUw&oe=6A805A4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1Ko5c_-2oMQ7kNvwEFj27v&_nc_oc=AdrbsNbRZ-J5S73Q61jtqa7AFeeziXTTo4MY9r5iN3UKLVvhnqi2Gj5d4JzOymNJbBU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP1q5T0CYEMEcIM7jxfVb6ZixDUS80CqD3y8lh5TKwvg&oe=6A8069EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSBX3GZZS2IQ7kNvwEwxYR_&_nc_oc=AdoRbzszcszbH-gGKPgSbfEN5h-XWt2RDhYU-cB5lELC_SGqNmo3r4gas1gHHyakiE4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUTbtMgKW7nys9VcXjGx89Nf7c9UU4n4W-gPd-dFoaRQ&oe=6A8059A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
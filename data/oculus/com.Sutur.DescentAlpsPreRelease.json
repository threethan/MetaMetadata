c_oc=AdqF5SM0kLUAP7vdDTm7zvre51Ehm2Om0tXlVCJzzZyCYi2eEu9kN1X6og4LVWADVpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAruijdvZ2vBqRdL_Bjyg1Jv2J_IHkqs5fheVoIouG1mA&oe=6A6B4C10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr0CQeGDoVEQ7kNvwENDj74&_nc_oc=Adpj5Uw9ADHcUkw9vLh2JjKoHQg9DsYWgjnZUAKZqCLbyvLHFcXX6c-r3v1YSQ0MTNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyuOcHut_MkZylfp6RImQCHJAxi2Z5SQ_LSxl2H1synw&oe=6A6B3F26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfdTmNclebQQ7kNvwHsHFB8&_nc_oc=Ado3gxH_3eTCZPqrtS3uHL7AOb7VsLIvEdpo2zUj4DHd7N3uI-dACbdpUgmjHC8-n1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKVvMhPJKIsQmBbmkqOsYaW3U5xUKNkm987zOSItMJyg&oe=6A6B424F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA8iHyHEHO0Q7kNvwGQxOo2&_nc_oc=AdruBW7iRuFLVGgqAwb-8_H8lWLI1z0ojslx1Xvnn_Wm6QuwwZi1UWzzpWxLmZpADUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwmzU4hwA6olnMUFl9-zRXHQvjCcTAtG10mugVTAyK6g&oe=6A6B51EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjyIO2tBubAQ7kNvwG2d4je&_nc_oc=Adpxb_KMW9DWU0WM4DdnRaAzp2GdJoxqyHcMYokPwWSfwcycHbEmykT5-KKKp0eRm4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7MGw_od4dkLGNeETZ_1tGxYnY064q0wZvW50nVuYExw&oe=6A6B41A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
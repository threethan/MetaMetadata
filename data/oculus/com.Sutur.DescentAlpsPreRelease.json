c_oc=Adqq5Vewt-jq6a_swcRLbw96zMO-dtHXI9JpsuHLGTtqQDwRIh9_G8U2VddTitTgM5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm1WkFQHK8IZxdOkRMc97-Gj7zCAOMYYyg-K8ZwDYfdg&oe=6A6C9D90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr0CQeGDoVEQ7kNvwFeKxE_&_nc_oc=AdrRkbGxMpU6Q2_HpVbLFDLAlDee0jIgX6-SyAMI9AUY2PNj7zJOT8m1BakvStCG6wo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4ePIyN3Sa4TmNVpZC8bJvOTJ3q28lEfAQ-j4FkrVVsw&oe=6A6C90A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHaGjfB8kecQ7kNvwFy15ni&_nc_oc=AdrNpCx0OI8T34k1RYwvhS-0TG1Rwh8T0M4FQVLXKxQ02HhAu_-Wx0wKuqzLkE0d9qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyhk0ToGAMBVdWYVARbhK_2u_hMOF1-doRE4CXxX2iMw&oe=6A6C93CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA8iHyHEHO0Q7kNvwF75g7E&_nc_oc=Adq5cK4BEDzo4vVTxBRlLVesYd7Wz4xskhT9sEzVyosuM2esmSp5kcTtEE-YT7dhBwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4yn8B6wUAL0EjyboaWcCJykDWacOAo-1prDycSVEoqA&oe=6A6CA36A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjyIO2tBubAQ7kNvwGWHkvU&_nc_oc=Adp2EJJkxApD6yZmcDa-_vhlQ6huiW_5lZIVryMq1RnsHyWUPPZ1Z-T5rBEZhGNIFao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPgtCv-ywqfk_5runRGT22oBN5vNBMyGZ_COOlOb20XQ&oe=6A6C9322"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
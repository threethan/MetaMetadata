c_oc=AdrAKWtOC9wWTYq7_0r8pBL2ZcB2I4ctOae0rV46BaTkx6ye5-c45ihr8QhLHqaIZZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2N4PaZ0nroPGX4HQ8rgWaa7H8Y-59GRGoYHayx2h514A&oe=69F74810"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jffiHUR4nNcQ7kNvwFOeUCy&_nc_oc=AdoUC7QLFEW5xEMofXNPf_xY_M4X9yil9dOFzMoXNWllMg-imhf8SG2zW_QtRbSDYTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RALfRrTKwo7jEflNZBlKYOvoEV5_kMdkDYOtkOLn5iQ&oe=69F73B26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t6niI8GSbgQ7kNvwGuE7u-&_nc_oc=Adp1GwWAlgUSejp37apv9in3Wqbh3NLGBq3voP5KQA_rxangEofytZq-xkoo3K9qluU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WzvzZfIdf9lJeLQ_43qWD131yTwJhyvKhnkd1wTmofQ&oe=69F73E4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5szCUSrwzQQ7kNvwGwqSaM&_nc_oc=Adpz0607TiIVodH9TSxL-vHqqqYYlYb2E6VkvsyvW83mDhiRH4sBBr1Jj4CS8p0hct8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2c3s1pCtjto95PT8PNufs1zDTxpCQFJ5EnBd0q-O2xvw&oe=69F74DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cahzi1FZjOQQ7kNvwHPpm2V&_nc_oc=AdoHIvTC5bM3fpv7-1AMiBErCQdpdvqdW2nVORFyy7TxIa_Grf_Io1kB47qtfk6s_Pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nnINN8NhgdaCrbNorm_z-24pvcHvjw6LbOmBCtcoTFw&oe=69F73DA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
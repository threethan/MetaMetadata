c_oc=Adp05z8xsLCBsOpbmFE9iXGIPiiQv8T-A3wes8iBp3qHiTkIC39GnIC5pzfhvYFwnMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rYVY9MVo4XeuEc8ugUXcxh0rhcBK2TAUrIHkFAGgb3w&oe=69D50110"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWqALgOiq6oQ7kNvwGn-n1j&_nc_oc=Adpw0BfmSRue6qqqj5dvIYLkQ9teubdXR2Um9AjLYdm2qFZOjpVg584Nup9tpTjovSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rgO_hhtgAOgZjD-YrbvmH1FbWwwlZ6oz-jVBi5gfO5Q&oe=69D4F426"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48I1uYMNlxYQ7kNvwEVfJIO&_nc_oc=AdpTf0FUmsGsze1YxpyDs7BQCAW_t7ZnjkmGFNGJoKpkKzf3_hI_3FFHsbKFB0XZhJg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oOGFTl-M2P5wKCKP5FuKFV_Z-H-d6UTNRflsLtzBsww&oe=69D4F74F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PflVtwhCl2AQ7kNvwFujNPm&_nc_oc=AdqIkxNbc-ZC-Ij95lHNqHNL16uCpHRBh8GYqIZC4b5x8Fx87VkUP0-x0iCehFt9UUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-lBh4VtII_MfeY63Qa63Da1ENkhvOaKxVMkUuLolLUA&oe=69D506EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK60shAq7cQQ7kNvwEG7pDN&_nc_oc=Adq99dGQfpPe_kHLjrmm261eU0arvM04Th-RjJa_rM1fI9k82FfdKE5EQYr-bmGcAQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JYo2GuwuEqQlR7aAPBMTPpY02Hd_4vD9nlEg4X2s_sA&oe=69D4F6A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
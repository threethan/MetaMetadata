com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkgSWagtgQwQ7kNvwGW78kH&_nc_oc=AdrwPzipsNvNzeVY5KVJ2TYeVhW-ROzu0hSamlisG3-RHfIl1M0kpJgO0pHRYBRRbh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaLw2aQ1nZRtQpWBam4gJUdIlENofNUMQH7mZpSrkOuQ&oe=6B0DC8E3"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqVyEESpxV0Q7kNvwEEsb_L&_nc_oc=AdooyAVYSt025frHDOUMwf3goSRpmBJGFclCBesoASgk2MsBv1TtbWrzNPEawbl8wG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6zZNlztL45KCQ2_drby2cl1PA5yIHTHU_aiuhabURng&oe=6B0DB408"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1x7x96eJocQ7kNvwFoXDgT&_nc_oc=AdrIRscPWFsNI4k2-gjcW7iVqlN7bAZdD4SOJ1lQRQNL2X_1-FZVcsaEBOWRbT-9vwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKIiaE2i4mR72ix5mkUokGl4Tf2olnYLXGChOzkENpTQ&oe=6B0DA55A"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iS5Z1SVb-IQ7kNvwG3MbCx&_nc_oc=Adoq0O7r-ilkTWUhMvDis2WekmqwxiVw-Lj4pk8sQWA04JY76DmAPguufCZbYrxxSoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpbrGuWuGoGjGmttYjOzXPrAEUKCOJskbsP-rg5h8QrA&oe=6B0DA842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyn-mizgMaMQ7kNvwH09NiZ&_nc_oc=AdpiqpJepLPKXkTWZ6mSSbi-YrYLfaKQGXzlpdrKtXBdBxlxjRufZgjxWIlPg4RQm7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNS72Xi_W_xo8Pmx1q1rWRtxoENKUOeSIa13O5GQkJ4g&oe=6B0DA053"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
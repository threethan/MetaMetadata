c_oc=AdokRCN8vgC4wK9j69BXxYfNeWJvsEPLfhAN_yNdQzSJUf0LUvnzhRktrg2BjXSWwhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sDSRd7UvxzX8LxgZHeLmSj16asMQ0VzbPLTpEcq_07w&oe=6A1D8390"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOTiPXWGdRQQ7kNvwFqQJ4x&_nc_oc=Adp3aZjvPdeXtDm-JxsGxAQcgkY9W2MIRfz1omj6uQq5JVthKVadaJLMEUGnLyomDM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JUGcwALXHMLiCQuFkTGvGHuE7YLUYGmWcMKdklpqYdw&oe=6A1DAEE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kr3y4FR34gMQ7kNvwFjgxh1&_nc_oc=AdqLl-E2tR2rkUc4LacZ0Z7edUDw6HrYxWjTYIidD2E1HhwMYNPTarN4vprbbJL3k6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79lSQcI3MAjz9Rqm2YlAEN94FfBiVlPEJJi0tuEao2ZA&oe=6A1D79CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sVSOj7AUgsQ7kNvwFx5zbm&_nc_oc=AdpxGoCVzJrMWhJuFYn_edZqBE0cqb3vi5KKuE_7JvDK1GhMdepsdcc86Set6WBgGWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GNbeqWfH2zYEsE-5r_s6KhgQRq4soJKDpk5a0t2ulfg&oe=6A1D896A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhYwlh1-O6EQ7kNvwGdSv6p&_nc_oc=Adq7J2dWLp2oGdMhmlvYIcK6CD8lJVhkHQK904LcIbMzM1e04qVS3VSv8BkLjEzfiLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bCAbCPPpE2Svo0kX-82n_vlT_6QIDSW0FRc3LXWiRjA&oe=6A1D7922"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
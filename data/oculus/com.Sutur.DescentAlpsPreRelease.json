com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkgSWagtgQwQ7kNvwFWoJO2&_nc_oc=AdoKyo_a36-OvyMb1fzBFQ5Nv7sSAnfgm6KhSc5_IGRBlhd8h5c2G14-pQzz-L5vhkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQaTzrH_s1xqrAn2hKjXCjpRYDaWsqdPkGrCsjMGWW6w&oe=6B0C7763"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7w4YGMz4KkQ7kNvwGN2aPe&_nc_oc=AdoJ8hW-xrb-dN-xB8lMv_xxsdXPVW5uPSKwqcybM0NgaExz0bRjXIA-3gMbl3kcJvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRq2CxjVnbPKQwcCUj5x6eeWYdNS7NDhDMT6kXwc41pSw&oe=6B0C6288"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1x7x96eJocQ7kNvwGY4wxW&_nc_oc=AdqMouzHRuv1kqgLjODodgGQQJP5-luHkTIrJEV09c5iV9NifIkGAq-QL9stC_YVa04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_SaEBmW32qbbW3-l1AoNYANJVYWKsDf24h2dK8tdtxA&oe=6B0C53DA"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iS5Z1SVb-IQ7kNvwFRxeKZ&_nc_oc=AdpEaxLr3a1AOqZhEQd5xKWzOPclk9QebjhbUeQPzHI-m0IX18SR81LLF2wOYjE7rsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWsTlg6DgzWGae_yq3DGus908uGlZEk8TOIYMFX03xpA&oe=6B0C56C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyn-mizgMaMQ7kNvwGiHXnI&_nc_oc=Adrgh8pevoOdIuafBzwduwJVy7kjnCZ5E7PVrnKbH5u-xq0lAmwsVehArZ-vd9XS3nw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQshqedWwLe1R26RheZKoxxZNaXxgJeHl_jaORoZxXUaA&oe=6B0C4ED3"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
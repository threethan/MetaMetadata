c_oc=AdrCLGCPvqkasgaeBOxxmFlAoqMr_cHJIZmzmSVdVQWk0MDX5REVe4XhEc26-BYJuLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i_EsJlB6Cu7IHw_VvSDu6G7PeF_h6GaOUcv3O6iWTug&oe=6A3ABCD0"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0dTa85dcrwQ7kNvwG6130_&_nc_oc=Adri3EPG20recSboOOveP0dEbTNsf5T11wEoNKVIMSzrHbqijjYXrenMLPZRvxfA2jY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xMW0c6evnkzeBEeYY2G8k2W-Ob_jTNi0IVk85hZjEXQ&oe=6A3AAFE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tcLEezqC2oQ7kNvwEZcSCx&_nc_oc=AdqflsdNUYRPMWST8zx0Y6eVwSZs5_jEMUHbVeYbAnU9gL2uLt0WWNnDm4Ki-SKN9ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BYZbw5mSmOzwYOrQTgFPbLf08TqptkzX3ny8KZedDnQ&oe=6A3AB30F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W37EeXelxUMQ7kNvwFMWSJZ&_nc_oc=AdpBUWwrvX3Z66s1yeqsQ-OTNSq0tYoembsuEikTrpr9HiCkm7H3sbmyp237cU4MrBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p2UL6GvSRInxyJ6KJQAnnunj2LfCXSNM9CyyuzZijaA&oe=6A3A8A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4YDfgJeUkoQ7kNvwHCm8v4&_nc_oc=AdoO45KYkMSgKIkhSmfNyojV5ogis3zqE8mAluFCwYmKnngbQ2ysILOO2mQK9mUI_6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RRqUUSBPS7pPsCXbZnnmyYxrZm-rdQNDvHlurt4kquw&oe=6A3AB262"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
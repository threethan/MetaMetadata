c_oc=Adpngr-qs6-yT2nN-UevUJRYW2ej9Pclr61YxsJNhQMDqjiBv8Y8zHkC4kDa2-22LFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79dXi2qztSJScvl5A9aXFZVGwwO_O5kRD45KBt72IW-w&oe=69FC8E10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39S4_P4h8JUQ7kNvwG9u7Iu&_nc_oc=AdpjzaabWsKM36TqCRgRfQgnRhBgFHY278SCrCKdqR_IuHJFpnIqdxTbLaOWWfVbzE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af542CcIaCQdNTa1vT45NBQ3R7V3l7aP7lhGVZUTFU8e9Q&oe=69FC8126"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eospx5h2wkgQ7kNvwE2iXz4&_nc_oc=AdrFZ7X3Wv6GahGa_PnLfaSzWTP6f2AU5HOuiybjUDm2wQnlX6zENupd4t_DTD8J6KY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uMOjnfIBRis3uUGF37q0EmE0owYrEFn7hZB8wsEbzgA&oe=69FC844F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyrz_WYHdXoQ7kNvwEfxoGu&_nc_oc=Adoho7yUt5WeP-9SHnRsJ8CEi8MKT6PI0vDjnYbdL-NrGVuqat9fWYmnHT-mbRh3Gd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64I5yqalvz1xCjlMX4YvHX0eUAjDhxN1Ln2KLf8KAgiQ&oe=69FC93EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFrlYJbbzssQ7kNvwE-0LHz&_nc_oc=AdrWhe0_ollgLnamQ9iruW87ivS6YCp_H5QPIxOw6DHber7whbwQVUpZtVaesFwkOVs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51Qo4eTqEtYZd3sRwow3lIf_thGjqoMNGQrXn1GE1lVA&oe=69FC83A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdrxPptiWbXTkr8XKNjQPvUsFFSokuTYMQ_cefA3Xc1n0NUZ1C2ABtHc90OjGzgjQnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N1wdGfjoJtaSCcKK_OgsuEKpNyp8Em5FuNMXufnfpTA&oe=69DB9890"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Szvcl9VbiaQQ7kNvwHjueoO&_nc_oc=Adqp4hlxwjcn8LoA_7vcQYEDx5IRXwvK9ifsYjpPj08A-fRBj3Z_-DWQNaITdXio2YA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bA-9VhqeoSKLTmOvMupozwFZSHU-7TCLcc89IKS2xfw&oe=69DB8BA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6tcO6Pa8A4Q7kNvwEnKN5O&_nc_oc=AdpIAWo3f3QzARVwSGATrip13VTxC_TvWoyifVWrV2uTishUiTzBWb5sTt0q52Rsqek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v_q6bgQ_89qyJoNOZxaHO5PvhFeN8UxwP_TwsTfNAvw&oe=69DB8ECF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm3jgdZKwZQQ7kNvwG9F1fP&_nc_oc=Adogp6e3JVpyRhfyLK3NC58ukLqsEKIPAeew2CatT5iHKtBawQjKfasFM-QFEW89aeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yI0yI6X3N1tMSi-3ITFr0nNttwGH1BHLIPIo48hhqGQ&oe=69DB9E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qNEUCCHXrQQ7kNvwHc0lqj&_nc_oc=AdqhILeWiz2jYdgoK8Sln0J76-Lb8EYHETJpReKglf_cJbYw1c4lEMwTkkcpfTz5Obo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xWslV_vWBOpDvouJF3Np8Ts7285RkxL5VL6YXL_cAzw&oe=69DB8E22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
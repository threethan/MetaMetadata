c_oc=Adoj9jERT0OZ7Ikunh7jghlAAGODFFfmd2czPjNRIqQO4iioGJrPQtE2dKSB1IUcrSg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6joZaeuUIIg-HU9p3P7mbTePvWCRJIThl7seHNyqsNgA&oe=6A1AE090"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOTiPXWGdRQQ7kNvwG4mGcn&_nc_oc=Adq4Ow90clsGlSJXGfYZYkJfyOBBr2shTaQC0vbnTgsTE0MKBTV1ANCHQ9MDJhrORMU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p8NKQJloMgsycFA722bt_sBkt5v2wRAwoaZCsMBCJKQ&oe=6A1B0BE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3UGYX3N930Q7kNvwHZmxCh&_nc_oc=AdoPqBXR9wTuzOukHaltN5CujbqXrwpgXEugqCuKNeMKsVLX23qGBnZOR-ggb1Hkkvk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HzCZiQ_cFmfJwhzo9D5jYPkXx6pNnYazJsNczz-EtLg&oe=6A1AD6CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkILCtoBRiQQ7kNvwEpbMT_&_nc_oc=AdpBixz5cdhXZjB6zBitJWKan-qDrfuh4CktzdUlYZC643uNGCQ0BV05eQnFvwoaEkc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ofX5OpwrFJtIRrT6e3Vi2ZLo2Nbn96RLscveKU8w3aQ&oe=6A1AE66A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDMoAbaht4QQ7kNvwFhrMc1&_nc_oc=Adovj2GzbppsJBOAEUyOQjDTd_cmp2kgCWK_v6BFuOJ7pLFR2GIiQdXO9WLxM3KbakU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AfVPrygykpkgs0aAoMyNzq-17CxgPFx0eRFhK72YzjA&oe=6A1AD622"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
GNwYnq&_nc_oc=AdqArwHQTgXnQtjJ09A-0hMJl9fOoq2DD7ZJNMVffwJvKSuXYlnvuqQFHhkeLsfH2lk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsKiBDWaaQjyElek57fiBK7pMfqCVYryyvuSRKljpFgQ&oe=6A7DC110"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxriBjh9DeIQ7kNvwEpbBxD&_nc_oc=AdqPoNzmSb0rcrgfIkcpd-00q778kCbZ4DDl9OTVjtBVDWstIx0H5SCxtOw7tG_i_e8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoJce6nIKoSax5xi3z3pgf0wjbciEu9di6DDvyy1mfFA&oe=6A7DB426"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao3b_MF98g8Q7kNvwGUFqXi&_nc_oc=AdoaUi8yWlhk7TbFg8kQjtAJp_pSZnfWm3mSihUEXvlRS3ZbEuvaLGmVdcoATVu7dJQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSkxEFtg9ie4bRqCGnN8FBKOEgAaqTE8cSzMXFOZuGCg&oe=6A7DB74F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7-C2ADpu94Q7kNvwEKWmw7&_nc_oc=AdpxOFyk-vHBp9m8mO38AOOkrvfmPLU2GFy0-i7oaYV34OxUmDovukRYAfKi0vF2F1g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi2BjhjdMf8EUH13X2I-twA3a5MCvGbtUcW88mXZEBFA&oe=6A7DC6EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txmdH-LTe4AQ7kNvwFii6ac&_nc_oc=AdqcvCw7yUnrtq6VEZm6qN0OcNhlAhiNJeOoV6ESv2M0XPhHe4qFzBqhLg0tb1JT3-s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEThgw_JIRvcU-o_PrXy04Vyuhap0YwcqzYRSsXA6ZlLQ&oe=6A7DB6A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
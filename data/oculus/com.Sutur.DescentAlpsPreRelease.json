c_oc=Adq0Z4YExhKRInoRsp-K_4RSaPXZFZV_whEzZELxtimeuKJV6qG2MuCIs2E1Q4AiREo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FmFeh9RhXidZA-BTD6Hiw2EN3SHz_WgcLxSCLmeeSRw&oe=6A451090"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-HFTKg73x4Q7kNvwE81GLh&_nc_oc=AdoCXH6Te1zsYeZq4dEAMd3Rw4JsT_P0Op4kdevMsXdgpliCvoaKcCBHXtELBOkdJGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rHDwNogW25STVUC3gqyovMRZsUuJBzofiPh3coHprpQ&oe=6A4503A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5As_z_HDieYQ7kNvwGVCj0e&_nc_oc=AdpynWfZkPa5cDN088bGjXPQ7OZM2LXi2f0Xp1H6R4GqW-w0HeD9eYrzo27BYm2ij98&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QVPFm1tdt7TSdfJipXabxJIfT4K1K0rw-lxMCvXls8w&oe=6A4506CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMDYXFmGZmcQ7kNvwHvxY5B&_nc_oc=AdpKFngVtn9ftLfD_XLAVCFPKlxf1-cSHKvh5i0cJXp4q8tzIBjxFXxLDIkmFRPnZsQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3N2Y8rW3oGd8ZVqjHRcAkELoXaWubUemKyYH3H8o3RQ&oe=6A45166A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiFJh_48c6UQ7kNvwEXKr_C&_nc_oc=AdpsvOsCO04re-fPFYUysMkhiKE7OQvUWHkEFIr16E-uKMDHBGvdaTJ-7qgU4H_V3gI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RBbCRkqCwg_T3yMWB8oirBN9bMmkVe3BXYM9QGsxDaA&oe=6A450622"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
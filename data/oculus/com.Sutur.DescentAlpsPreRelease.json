c_oc=AdqfmjTTdRoXaLE5t9vKWQIjj0HMNk_8y3o6B1ejO7H8U3Dbj8VdQ4LpThgbrFkEML4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_bYcXkrWi_ni-kTuKTGJqqV4wNX7Y1nsK6aTR_ZGRxQ&oe=6A9C1390"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9ODXOIdrTsQ7kNvwEObkpT&_nc_oc=AdqX5RURCyAsSseNmhcUZTgNyiuy17_ELyL1fQRv-T-fXESCTkFZxkvhdJFA_SiW7qU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEI93u1t_L2ERytc9EdGFA78gjERP5dXGMr-5klF4a3Q&oe=6A9C3EE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XKjuE3lUzsQ7kNvwEsUlyb&_nc_oc=AdqpTLwttumpQkVx_gxJRrrC7ZSGpMRulMM9Qy0N2tc4I7uoXe9Hd652o5gs9v-gKWM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXc1f4zY5KmQM0jOAHOv6ES-gTZ2fe8O9QPeMbFb2YBg&oe=6A9C420F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2_8Jbuff3sQ7kNvwFza-ee&_nc_oc=AdrChbkRCw5feJESNcHe0uRbq0EPLxcaNby5IZr5EXZZqsXAL2KENdeHBIDIjUzoflU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_PNaqNJqrd2fw6KK0RGqN647Q1WBogueCCSjE5I7Uog&oe=6A9C196A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99IizhXTG7EQ7kNvwFpJ3xp&_nc_oc=AdqT1fv3IZxmA6M_9olWV_M38JLk7z_Fam1CNLkAPCtEIZ2l3WhhiIaRpbUkGffEaSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlrcDb8feLfvfz91in4FPoIlnT7oNL0B4ozQQ95GTpiw&oe=6A9C4162"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
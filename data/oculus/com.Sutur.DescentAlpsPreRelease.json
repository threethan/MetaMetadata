c_oc=Adp-DnWqGgKSRsplyOC23JyywkH01XR5mHrN3vPlR1z5IYQ61ZNAMaXbcalUJO6Jn5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMMbq3YJNR9XpNoT2oJaS7DdkRWcgsaJhcB5SpbBwoZQ&oe=6AA2AB10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBZfA4kK6v0Q7kNvwEuFrsE&_nc_oc=AdqwoR4_8MTUBJQaGSymcl40mx9LV2Q9_u2SvIhtE6RkG9LELJX50nuQiC3nPZM15f8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi5obV5nuLyfsjqnG2Cat4PY8kUcITkJEWdvu1Bw03Gg&oe=6AA29E26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RH-bayVPBUQ7kNvwErLalH&_nc_oc=AdrNx224RpJkab_h6kFsQZZyOU9TLzGRlP8rsxPnpTXvUXjmk4O0Eikwi5rFYG-0w2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU_RuylNFmX-TdKA5pvKSU8LbZCVc0WUmpjrf0-ks8Nw&oe=6AA2A14F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DC4BJBbgyVUQ7kNvwGOQqlF&_nc_oc=AdoEz7TlgGcgSGrwQTSEEdLYy8pwOj9MRWgbemnSun20wDI3-baYZVlnDSygUa8HJes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl1knwZtIlg6ucPZFji5GnzN6XwSaCdpG8oLjfYtSkdA&oe=6AA2B0EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBOox9F4T_kQ7kNvwFhIBFO&_nc_oc=Ado0mgsYMwT4N69o69z7ljHYJRVxeIxi5M8fvb7MGZT0n3OAMAE6E2o3V4gY2AeNHrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxVki1kt5PvImcdxOFFSXNy_HQZg3PWm4tAfn-RHVe4g&oe=6AA2A0A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
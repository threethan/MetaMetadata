c_oc=AdrnQP6RwlDevEVZa-YzodCeWRNeqIHpc-St9GnkuoxXcIdjb2aXFlEEMs3RsnQ33EM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQDwE7bXfZNX4bYogqCifdZQvp_zm2Aw8LJ0o1G_MKKg&oe=6A918790"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1taJ7DHUSgsQ7kNvwFf2d1F&_nc_oc=AdoFNBeRbt0gOMQvu8ER0GsHNXnC6xSxkAkbFEdrHPXmgeAKzkWdfvLhW4ptrHwbGoY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKlVNVKwhDlQQ7wyBTxGF86ow6crX54ZFJ5qU8ez19kQ&oe=6A917AA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LM2hUKH9XQQ7kNvwFxJNxA&_nc_oc=Adqf6D3acgGS_a8mS_vWwgDkpqrbNqOsmLHUi6noIml6EU2KncMr4vfQP94ckRnbYxc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL_6PrKQ_B1lO55EX1WzUawK6UIQpdO383vVjJGjISwQ&oe=6A917DCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkO4Bx1dI_MQ7kNvwHFWeeT&_nc_oc=AdqIeMhpjmTco-ut12dC07pk3HiupdhVNDJ5sNVsmqVFm6tgt3BC5L9rxJyEbHb-0V4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6DTTQKoVrLInb6SOT0vunxeVikFifSoq6nbfQQBS6EA&oe=6A918D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgBJZSUre3wQ7kNvwHL5R7T&_nc_oc=AdrSNigHh3mPG2U1GhOq4tasWWi_ZKeDqzB8WOxwy3JKhzZB_dN0vwve9nph6LkQIGk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWFwOn0vz35HON2P_6nPqZZPiR8bz7bZn1kFWDEzJqzA&oe=6A917D22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdojFAXZjKBVkGTetSWCXXTXxQSVfC1yUAzvTyQjyBnPJQA7NijPgQxvwDOVozCXoHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLBKYaFc8fGJcIgLxJ4Hr50NGRA9P3sIRpkJrrVGw_1g&oe=6AA54E10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35XTma3iODMQ7kNvwH4ItvO&_nc_oc=AdqXgW0bHvOzdK2R4REtmiH0_G8UkQLTOAMgXYvhyo_mDdyFspCrUJmr_pVSnQXT3ys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe1DlNwCaQFkp5yDoSmn2kXP9bzHWBbhV3Wrp_VFEwUg&oe=6AA54126"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcAbllaFxfIQ7kNvwFXt2dt&_nc_oc=AdrBwmo23kG_Jq5UB6MxJ9O5mHD-slq-Q3JoT-2RxJ5S-vlZBM_WZjlYAouK725dZcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc_9bno-KgTJfJsA7vAMQS6HjHMbhOhcvZ4_H2c9U3tg&oe=6AA5444F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DC4BJBbgyVUQ7kNvwHL0SDc&_nc_oc=AdrDJHJ0h8ffeqKp5hzeAJWP2N_1Q2l8t7OmLDDyd8TuSRjcMUMsp1ihQGao8VSFXng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHImqf6thrB8Dsx2vqZ9wM7pdmJc-J98Vp0FsYSyS4bA&oe=6AA553EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBOox9F4T_kQ7kNvwHlUsoj&_nc_oc=Adr4WHxToIA8iz2Xr4IrlnBjkmz14h5cgmpewT9NVlWOIxpxVD4seysG9cRHXAbC-xA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRXO94g63rzEfU44PJ46fLW7Prh6yBgQcN1ulNfo1jqA&oe=6AA543A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdqSn1Ias-I4-LT4bCwRxE704JpKPeTQ3fFVi4t1dVbvxjUxu1-HLQnXbcmoo0YhOu8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mkPlzYj1Ex10RnvFDjKcWDwCaGpIAFm17YIL01ZAEZQ&oe=6A159A90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdtlbjFzW2cQ7kNvwEegnoh&_nc_oc=Adrw5AwGpEVVgFx2W2k2uxFq5TOvRLZxgJey3WbDLskr7L9QOXQKuZXHacxgnoRbzxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NgifYDH7zL643ba6W1lv_jeFGfb99vTSUqgs3XlrZPg&oe=6A158DA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0GtNQ1f9_cQ7kNvwETWHJE&_nc_oc=AdpP-pUsEqY8C3tdk7jfnkEv3RQXGypnN90DiLRtX-V4VObupPPD5cG811RBr67Xu1o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71meHBwexvstUEWIUYZ-BoSFlzI0f3o1e9vHbkg90BmQ&oe=6A1590CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj7y4zg788QQ7kNvwGMDUsq&_nc_oc=Adr5HeXEWdvx2b2NkpOjvXpwO-U3HD8HzAlrjQUkn8gW0m6784pKl327M0I5P5Q2s_o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NdKiKYZupuLx6yWI-tNOxWJaX-mVuBZ9TukU7jdi2cQ&oe=6A15A06A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMiH_VkqBtwQ7kNvwG_MRXi&_nc_oc=AdqYMw71_zi24jxuiThImlOLZWGT9rnj_QF6wUFKituOjzAvGwlE5l26ygv7BCoLkaE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MCozCOTfabQJrWYNhrUCdXtfLrVlk7fy_aXh00uB7KQ&oe=6A159022"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=Adp5lVT5XI0_VLzewsoLL7MmZvUCfqhi2-svOBNBs76sXlE3UHpMpBgSCFfvlWUh5AU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlYmAvXzRrUil1h0zRAWfDThn0ovDGxAXARDMuAFVIEg&oe=6A9EB690"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG6M94N8DlwQ7kNvwETytJv&_nc_oc=AdqiTnNpvQhzb_vPSRP18XOGA46obKvt6Wc3h5VKqSabt1Ux40fH6nDba1l390IhqDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxEOBy8GemsndcRHx5JsJeVHuw2mdbsYw-4VnKCegGaQ&oe=6A9EA9A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XKjuE3lUzsQ7kNvwEXkaIQ&_nc_oc=AdqPS_USVGKvnAT2EXSue5g2OWG_g_6RR-GyJo_rVZ2mrhYcoaDDSiFTJwHqEEK1x6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv7BSUC0LUXiq7HNJv50l170PXHGbudNoTiGhUpGpJLg&oe=6A9EACCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sggvMRqlJ-YQ7kNvwHqvLsl&_nc_oc=Adob5hnx9UipRYsaIj3jJyJHCk1Rq8dofFzYIbzZjyurnp-oL_P45T5zexZKruT-KSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDoOECiu0jw7gS-AInfdmELpcQRvXZuA2GVLE5EjVwnw&oe=6A9EBC6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aljxhiJQJVUQ7kNvwEs1EBX&_nc_oc=AdrimhnjQnV9bRpOX8NhBvDz6cg5hz5366nsMRN7zQIXI8LvGRX5mtSm93BgbLKpN3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWudZ6OVWpwmNEwFhLc9Vo-CIoEpuCYg6jALAPlaeuug&oe=6A9EAC22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
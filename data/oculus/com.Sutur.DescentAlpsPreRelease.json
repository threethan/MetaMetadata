com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-e4HbvHlQgQQ7kNvwEWIaQH&_nc_oc=AdpwtZI_tg4qYQMWgGWZmkXhiXOYjbwzRuyMQi69BcJ-7R_voLQorpYpDHvbKHvABqI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiTco2EUvmb9_cDBix6o-64i_oAVLcuuJI62VsHcv7Pg&oe=6AFDBEA3"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Z1oohKKaCoQ7kNvwFPo9Lb&_nc_oc=AdqSpvHnpMxCpRULYck99U3LVAE2SfYFHS7Sg-XkoXrHUeLZ2XWRlhuuS9Y5Ii-CD0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl23Vww2M1dXee4mS5sl8PZrzI9oVSrkX0t2c5YGDPLA&oe=6AFDE208"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3n5CmOKdyAQ7kNvwHRn-bt&_nc_oc=AdoFe-rngp9REvhWBq2Uu3fRH9JcoI8RfhSyWvsfDZamUJL2-Gf4ux1Lm2WOeYpyUsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUe6SlCszv7HwY-M0Js7-9nRV1_0fcbw2zib5n8Ra9dg&oe=6AFDD35A"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD-o7oGy9RYQ7kNvwENMoLV&_nc_oc=Ado5pOI2I2i6hRItz_CYGPAombqGMZupQOLJ_mWb5R6cUJnmRny9rQXsuDVsfs7Sf2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq7KhPaHWr9Iis74DkZotEjiB5zB-Hcupfjkv3rDUGsQ&oe=6AFDD642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooSx65qGlNIQ7kNvwHWdHro&_nc_oc=AdqpThc-Suvr7ndPARnzQ0rWOpUe4T5emD4nm8Dr9XRK2OM1c4TpG_i-nr4WerZtvzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3q6Fqru2lFYDZ8dAklU-H1F1XxEQUTkn1n5nrVHgoYA&oe=6AFDCE53"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
c_oc=Ado-JL2Oaz-jgVoHDGPyuSEWjEbPsVUrPu31IDaPrKHPnieRXbiglSyGGDO0Tuc5xxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4mnA7t9nhq1_FV5sw9678enCsTFZKFjmHoLJ8PyRoGA&oe=69CD1810"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVB2MRRrrrwQ7kNvwFO3RNe&_nc_oc=AdpR7RwXnBODvE7ZhKjlxajL9q3BDHtLZwqNlkktyqWAFzZKbmx3bgzJZkll5vnN4-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyws1Mm6Q7dM3lUSviJ9dBCAY8WlFAvc6Jqu17SGiQVUg&oe=69CD0B26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDgTTXOOmNgQ7kNvwE9Xy37&_nc_oc=AdobsnyDFpi8SXwj0VEXB05ISNsnswGktB-PBfV93sDytCK6icHyNV_PSZPhedG-3JE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzi2mSF3GCmxCwlEAmXpxsfXqeBNrNnIdxKf9whKnu1hg&oe=69CD0E4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xEi3w_WN7sQ7kNvwHnbFBx&_nc_oc=AdpFTMu-btoySrB7uhMvZZda01KHuc16oBkrqKQ8Bq0L3Lg3a_vF03XujJvmTkDeKBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5jf2fmF_dNTiSZ8GIrVvuatacDzMX1gstTR03gkrzZw&oe=69CD1DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeZDimP0n28Q7kNvwGIVds3&_nc_oc=AdoizmBVt05RcqX7ZfPqE8zGqrs0hU6Fra5UAsk-KCARC-k02WpqSFxE5aXlbUrXntY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx94LR9E8UK3v-9tT2iQzMqqGD_ALuR2mzc_eBIJG5-Mw&oe=69CD0DA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
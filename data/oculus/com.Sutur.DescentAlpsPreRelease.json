c_oc=Ado13G9Qt3XAj6Z1GSAh1JsyfWJG5Q63l40y_JwP-H7hmp7NLT5T-OnKMPIsHrU3GgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JAgmVQjyJwsSRSkopQJuLIvVEIdohDxMpBBTM67m3Sg&oe=69EA1910"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5TmR8W7U6cQ7kNvwHWi5ep&_nc_oc=AdpJNKQMLORSL6DsA8ppqiKtSHUw62wLnG4nuzXu958PK9ebHKQwLffcZdClzcZDhUI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wOtWvtc5AVt_0yt7MreyD8h3lkRmPtBs7kgJ3EoOqHQ&oe=69EA0C26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ-pVZq46vQQ7kNvwFeLU1f&_nc_oc=AdonEInzCunCoHo-vA9vKQa2w5AF49KKSWKF2nRuJ5eDTTHfQUyiXVOgJBUHd5zHygc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WcqLR_oW6aZO4taPhXpLqyvrdEqxPMEG5PlOzA12-PA&oe=69EA0F4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOC2BH-sg6kQ7kNvwHVLWR9&_nc_oc=Adoev36ZLvdDZvvYb-e04-8_zv5nV4qBpn5gxl_25zrdUA8m8m3raKgBF8xwfeajOxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0an6n6VEzEB41pDoRfPsH5I_DCeDKVbCmwMev2S-sFIg&oe=69EA1EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEzyhnvnt04Q7kNvwEybVIi&_nc_oc=AdrKPWBaSISCHUYxmroGD10zbSeXHpdy4M8P_7GwMG9EagkWhcvuPcrFzjSaOz7sNPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FWicJtQ_KIuFbmWcP6bdDAn-gKPW1FUwiLOw2yvkKdQ&oe=69EA0EA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
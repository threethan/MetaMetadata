c_oc=AdoADsdTiBUH_QTNdm-9bg5r1DV8ZlwQGUe1u54jVy6TLSIptlfRv0KzT0UtHzFHFQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jsia16ra2jgIZ6JnoDSu23zukLlck5i2N_M21Vv5qkQ&oe=6A2EA710"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgACCvtNkyYQ7kNvwE1kezJ&_nc_oc=AdpKoBZCqRKNcuo_1DuqiTChh_gYFBFOwsCLVnqUdLo4j2IV2HT2JVCcxMhrbno-_5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zcxOPsIC_mbd6TGe06waBXJn5SdPgCpf5LrRYSE79gw&oe=6A2ED266"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dOiQ8nTGkwQ7kNvwHDTZ9v&_nc_oc=Adp9_lWdXAoT9C9Sefw-e2ZQLw9hX1OqssVyZgJJv4KemnUAdvFOWMtz7hmL7l8CuSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rgHvQPmmqRkGJmz4ZLxnWdM2G52vxAP_rEIsuwfARlg&oe=6A2E9D4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cqoCIdiM1YQ7kNvwEgooXQ&_nc_oc=Adqq09CHsE-IEAVRDda-eO6zCFCnvDTJ6XiSrOQ_MrS8soGdhM49XmPNENKoqKww51E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hL854TRsJxf1Vxbz9kVh_GoLruAK6iC0OS5jIYbMJfA&oe=6A2EACEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE9g4Eq2MbcQ7kNvwGt00Dy&_nc_oc=AdoxpQjv7JsrqKzhV_ZHHmXlFwLKfj50eOZt5S2wKCbw9AtuU_yEbBeDkoMupeKP6IQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SSoQ4dp-V04__IX0-4X8YCBN4z3DSQeX89ZJxZ8263g&oe=6A2E9CA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
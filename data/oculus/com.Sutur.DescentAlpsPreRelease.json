c_oc=Adom0Sm_EiEZ3-aNHqAI6s1zFuyotelDOSLBWn64-PJ4orWsuPQHgj8VQ96Lb2iM6lY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af915uPn8dE10OEOoxYkfFX2HbM7tXQsDBnafX6KfRloJw&oe=6A33ED10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZARmNIbGnEQ7kNvwEPK-AO&_nc_oc=Adr54WT0dsPfkA3M4J-S7uz1q_Vc9VMZ7munNw7kd_n-k_h6wL9o9W7mYE7bVbNBvPM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tD5B2xlKb08Q03_5PVKUFZKobB772VDemeDG1hfc5TQ&oe=6A341866"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlrMUD1l57gQ7kNvwEn6Pbr&_nc_oc=Adphq-idhcJjrKlJFg-S4yY67HEJhqAYaKjO8Lcrr_RPCP93L0pwUiCvHhh9TEZjI2c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cS2q1F6u6DjTTSvtlE1gkDat9j1zg8dgO-2WmVXeJPw&oe=6A341B8F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19GGIsDBV4cQ7kNvwGuipwX&_nc_oc=AdptyIxOFqZZTC0zjNcxQ49_lfq_BKO_emNGMUFWYgVwpor0EtUd0rEWffmVEdjTNcA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hvrPuYvFx8sMc4jVv_qtGdCULXk6_lA5PPLwWi-N7Ww&oe=6A33F2EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukTWjd7jdeAQ7kNvwGErr5a&_nc_oc=AdrL06gwB7p2WfEw6EsjJksHCff4j06BSKvw8htfLfP_kws-qQ2lRRuInZIJsMCeDUQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Hhc-V20tSRklAIumtgEFBA7CuuxvsTgsSukuwu87nlw&oe=6A341AE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
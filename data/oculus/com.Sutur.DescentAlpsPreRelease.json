c_oc=AdoeE8l_b6gCqRK7dJzdw_BFnfO-M9DjEDr5yLdhhySaiVdUGytKinSIqzszI_pFJ4M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXFMrVO4aiq2exRxAnOUYCGWcpXuKt8ZCQ62v9rJk13w&oe=6A6F4090"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1tGXvffXL0Q7kNvwG6esWZ&_nc_oc=AdqWFx1HTo028jclM6t3BkriBGzSsORJkaMxD1JaUhKrHlSoKzRPisp9Nyv7kJ8gKJI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjVrYt9PAjcZ50-MM27k1Gg7-8qBx4E3vB-ImyDQMDvw&oe=6A6F33A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHaGjfB8kecQ7kNvwGuHefb&_nc_oc=AdqsqRjlSmBZEmEaLLgI2UUwJhyPs6Y_N6vYQFPmwi4CanFCQYW7VnhVr9mPXVj_u9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASjdlos9Icj3VV63GsV-4pYk2BAEX_ueMKXako4VC5jA&oe=6A6F36CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJkc8GUZ0HMQ7kNvwFe2Y6n&_nc_oc=AdoHz8x5ansAGFtkt1U-8GzbE55idVTkGc9VndVisM-XAIy5Cw1zVrOC6R7N3j1Wb_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGKjlOIttjmZyrP6sBVoY1p7x4wyGWJwIj5pkWy0kQkg&oe=6A6F466A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL7YMEisq64Q7kNvwFaMJKH&_nc_oc=AdpLDxLJR49l_jWnTB1yDCdx1n2hbOHin3nxNRiaiuk5ba6pAnxi6tVpScJZz57IQJ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2FdpwZCN2r4ATDMbtbQE1CQl3Xgey2gBsS1Op7kcpgg&oe=6A6F3622"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdpCG-5zaHoukDPxVEonber056oB6SzvRGL8Dqlx-95uvWko9FouiBoGakpc3fNxeD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvzgzNhMTKiAGVBV22R4D2-hOQYK3lrtz8SX3uqNlLHg&oe=6AE1F310"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGNkrfddPu4Q7kNvwEPiz57&_nc_oc=AdqUbtk4TeqU4ySm7coF3MYSqgMmrnAHacMKhFWAT_f8775X6VL3wo2PeToJgLzBujA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPieDUvdXaSV1ePB1aJFsxOgSuEOFdpDqxPEx4dFdCXdQ&oe=6AE1E626"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiQWtyvql0IQ7kNvwEMuKvF&_nc_oc=AdoVY5nKaDhwyTqNZ66tPDZUc0qMKePE3nRYvGlg50BLJysnIA0UYEcNTfTSSQBfK3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmuNeMTVWWjYm6BjcGZy07HNZwa00J6TVSOXXISX7jeQ&oe=6AE1E94F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp9JlraQXdMQ7kNvwHbc7ti&_nc_oc=Adq7G_isKdWNr5xpVgisV5_7UWVd0JmAqRvi6vNnA0EOpNndEiLU68taU4j-_OpsasA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrASdYTkqaEjJEHdmNHVIcl_p-dlZ_7UQDD5oTJwCYbA&oe=6AE1F8EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSv5p27d02QQ7kNvwFl-2tq&_nc_oc=Ado7jy6EDQktFx246ODZhTE_kDcJsA2G_J-Gqap8-xZxUteD4W0ndT-XJ8CxVVF7tCA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMY5IxyIyg0r_jc7_wiSYe2Jcs4BuY8VSTZcqbqEwZ6vg&oe=6AE1E8A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
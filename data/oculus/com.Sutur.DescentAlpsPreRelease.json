c_oc=Adp6nN5FDaqzAA6Q4fHqBnsyA8wwN8YJxFXs9qG31MewxemIuxZMBcYdXfE6HZLhYXw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB1qoWShxDEDOQHqtz9wrk-U9Y_ZasBnEneBw57JzZnQ&oe=6ADCAD10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1LmBpj9hLkQ7kNvwH0fgX2&_nc_oc=AdovDJgt9l0FJOpw3JL-e62nWdpfoITEyjRNrT7b3fBybbQ9fKDi62wbxHoNNGHScfk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNScp5ktGFfjIQ4MmIFaGl8xC49NGTUeKuVeda5C5XSnw&oe=6ADCD866"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEwG1ZhdMO0Q7kNvwFzmX-o&_nc_oc=AdqWSXEVR_FnEYTcIJBJoDQjbTvLqut4-qdZF94ssUZjWKN4QDzdSGxCbZCkiLoAsl0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0WFlE6RfkTq3URFO4rHEnkHV-y5UIzz4FZF2Sau5qeg&oe=6ADCA34F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBgNl949i2EQ7kNvwHi6ys3&_nc_oc=AdoMSWY15Rz_Orv_h6a52_gs1P0nGQjSRg-7j-AkKncLSMZWa5yhxuRB9XuTqGSed_4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIeK0LgkZN21kLnyAuyG_YYyv4xTaaSAy0zgf03KRdQQ&oe=6ADCB2EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRmVb1nKytAQ7kNvwEIdr8s&_nc_oc=Ado6AvUglJKxs2XYhZl3e71O9DFVioFcZWyflID11_ZjiX5zFkgFBxQiTfbmzQIqheE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9kU0L-k56_r0xBcunQSspsPRukb95m4yIj1J3-PYXgQ&oe=6ADCDAE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdqyREwJQbF-NXYYNdrR0A80XorYXIIgYU7_Hcz-ioFeduHTD32IP95Oq-Jr7QP4oGg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s87gJ7bzhpT2AbaV6Lk73GwSR67rzWvXLgFcm9txCAA&oe=69DF8D10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeIbvDJpQj8Q7kNvwFDT-HM&_nc_oc=Adp2ZEy8TnT69q08vlb4DMBvHZh4R5ze92rVFez0rySTpEimumByFjH1ZZW2WwLIu9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aBNIYRpFu-lxvfGIijajQn-aiNGgSU96aILspNxYZnQ&oe=69DF8026"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVqZ3NZCRUMQ7kNvwH9lHj8&_nc_oc=AdolwYEVxbDViyeqS-cBH_gxqCFcx5AR0XK8-5jBUJkC8kkb9JvrE-L7b_R2CUSudYc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nRq53OhAizPP7KPynb-fMa2RwL7HarjldMN13Cg9r4Q&oe=69DF834F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BvlX2pAqK8Q7kNvwFnUVI7&_nc_oc=AdoVJBgFdrv6mwDj8LHc33jBhf5qN4WBqWO0U61-KgJrZ3V-xBOSvGoWsM8MLAbtT44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0af-2BklG_A6tiONxwtW-P79J-ZqtICxj2EH06Z_qNcw&oe=69DF92EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjKpjqA4mKcQ7kNvwHeyFiH&_nc_oc=AdphmdYvNhk98l3qSr8AB-_YSCfA8QHV4rKyZWCYcVPB0JfsB9B-UocNf0l1xnFdIic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YzMuktsuJNJ1Z606uapFBfRCJDaRBNvXeH_CoV-a0vQ&oe=69DF82A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
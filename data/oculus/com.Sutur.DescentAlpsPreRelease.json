c_oc=Adrj_U6Okgxx6M9JYq7y-5rtD7w4rOAo6aYY53Wcm_rtT7lt-SsVzxQY5ybAjvC0YnQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO95IBht2Udrgb7uLLUBApmQmsTT6nHRK1_C0rj7jxCA&oe=6AD3AAD0"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POgWSJ60aQ4Q7kNvwE988F-&_nc_oc=Adqp3Fby7bzS8h-tgmeYtTBLYpqXNPPNko8LJxZ3EFbudZ8SaZAIv4PLs4fVW1o4p28&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEz9aIIRMWOZer-nSIE9OkuMGAJgn8qVNVNXdimQeoZw&oe=6AD39DE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLjCXtua5QgQ7kNvwHajQcZ&_nc_oc=Adob531DkjPRewj_OlBK5eQ8xObdtTJrqRnokBR5ikdRwmTNw_pD60nIoDdrLBYySCo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHW6siCKoo1e0HK1TZOg0WXpIADdQYdwSaW7yOcLAXyg&oe=6AD3A10F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDhAlGKXtgUQ7kNvwFmhv2I&_nc_oc=AdoBAhpQMB_vXFaMB_6xRhsJBmdFlPRe_R5pVQmw0YiYv92EdGm-uhCa122kLOmPkyk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEA0CX4ODQXPz8rzX7VI8PSt5GqQDVESd-Znq_acj5sw&oe=6AD3B0AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmtURwWWoeUQ7kNvwF9vgc2&_nc_oc=AdqHXShwS0AatWZ7S0wHUBeIfzqkg8ZTJeUNmMaw-bdOwZokHnx8lJk0xBI-6GB59mM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrG-Bwhcl7DFKRVaKZiEfNs7yu5nmTiYs3Y2uijV8JuQ&oe=6AD3A062"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
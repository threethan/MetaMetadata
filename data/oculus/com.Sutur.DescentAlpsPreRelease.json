c_oc=Adoi8MSDZf8Rq5ZSobGfu4byqfaT79T42_olxfqoS5p_rFGTP_NO4CbkWxE1CDqaCbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2lsTc2c7DsB5mszDoRTu_CEZA3Xxqlg8Naz7ErBPN_g&oe=6AAFDA10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm9E8ug1Ax4Q7kNvwFq4Fe_&_nc_oc=AdriPbOmOahqLIEQ6nJ3v5cu_M-gLTQnNxuT8fDJ_95jkoX4YTaPx-_FUu-UJr6bmcI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdh06FNF2oJvDO1-Rz_zQJlZxnAtjxGkLxiOtYvU2Unw&oe=6AB00566"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNF4MDJVZJ0Q7kNvwHkeFbm&_nc_oc=AdpBBFAwGwCXC5W9nOJXEzNnJlC92JS49FBVH9TurDXF8n31C0KEmBuOQ-1SmPaqBDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8KWyST3YKJ0ByVPIFBUCSdBs0D5nY-RWGDHBRYv6qqQ&oe=6AB0088F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ffjRDX8G1gQ7kNvwExJVpZ&_nc_oc=Adqvo4LJ3w138_TwxSytukH5LMFrfCTfdkk2y427k1Ci3UVOAGDzE_p2Fb_cw6pyYH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIkmqm3PC9XwdL8S-KC2_yqxFxV60i9XDnnc_eUd4Qzg&oe=6AAFDFEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_rPCZ0CYHEQ7kNvwEPKX3y&_nc_oc=Adr_-TFCke_Pu2iWplkTNeuaRVZNmv7XwmAcW1EqqhgybdiFm-A7rKN8ZFAsNygwg5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEamDOjgl4zQxahANOtNXkHo9pySOqKbbzvZynOMpXrg&oe=6AB007E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
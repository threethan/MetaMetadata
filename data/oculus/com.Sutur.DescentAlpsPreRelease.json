vwGqVhAz&_nc_oc=AdpYTg6CUmdACt3gaRdTOGfRKMnYD2wAoEa19rX4QZOi-7DtL-69LJq0oC797m-Jk4g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5vnMz7zPwLEUTtNmaMM4lDOjVAxM25P25mPVA38pRwg&oe=6A8D9310"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqJWEv4NVBQQ7kNvwHh3npp&_nc_oc=Adr0GmrjbdHQSPY6m0ZPjQVe0KJqzEmdGSCLBHIi9UnDRSD6KTzX4Hn0cop4epwkOaI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6aqqXTShb0CAXSN6eHLTuX5spGNsVPqG9IE4m9-uUyQ&oe=6A8D8626"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrAO7Curr_UQ7kNvwEbox2b&_nc_oc=AdoDkSLIuuSki_hibOtjwD5OrPSICMIYWPBCPfAQ2WaWW-wJxksIAsUQtdENWPFfFCA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeGGBviDctWXv7TXrkYJF8DMzo-CRQ_se9qajRjxzDjA&oe=6A8D894F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWIoKmoMY1UQ7kNvwEhMmGR&_nc_oc=AdrIg8ctWeE_P_uoJDT5BA7qclULFyMLQKHADWHwfVOKWC6_CFA9-Y0ZpuQ_2aNXoJo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA4S2_R20lARJIszVnCLS5CwWw0mYW3JaprlHXXITVRQ&oe=6A8D98EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEVT-vTFuk8Q7kNvwFrZpwM&_nc_oc=AdqRMb3QaAHigzz1MysZ0MjlFI30wm6iZG5ikhVv9FpR89Hl7xcPMymxlmFkdSixyl4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMcA9HRuQsN_viynVo11Mq8ocfUepaxmQkRPlvNRR1vw&oe=6A8D88A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
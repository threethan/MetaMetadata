com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS8fW7p1QNoQ7kNvwEuaVVO&_nc_oc=AdrGBc7qIJ5fECGXjNyZrFdeVgHrdwgyADXbbCCokLSQznHxZH7igGp-kTH63KaUNu0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq7LXEywxQZwtuTkgCJGkeh7mI9YR8b6yRju5XeST5WA&oe=6B084AA3"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7o6hmpZTcsQ7kNvwF3b9GW&_nc_oc=AdpdHLIQVZaaawoDPJa2fYCK_TOWqmP09jbVfMQXs1ziA61rickySN_Byk1hGm_9by4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI8yzKBFEFLVhLPujGlIq7ssUegK4g0_J4xcPTUIjAww&oe=6B086E08"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEpjC2hQl7sQ7kNvwH6GaVX&_nc_oc=AdoToJmggUmn30AiAtGLgiZDjRPD6PQFIT8mfaCpMjaSryDFBm6osV21IfZf7s1pfxU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiwGIc8Hstf3LehAaL_2fw11gQOcKH2nsabygOPSGpbA&oe=6B085F5A"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvbDmgk63xwQ7kNvwFnWESR&_nc_oc=Adr2J345AgSDjh-JRf9JfAKbYBWhBtte29QO-tGM2M5eFnjufXLPt1dQxfZFal_Oktw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZi3tyPavpkniyFcxr5o95-AqGEcZly9WD9DDYcs0oEw&oe=6B086242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xw2AG2deAE8Q7kNvwH6LFl6&_nc_oc=AdqjkW50Ql8dW1jgZcZuPz_1fRCWq6yPgp9g3tJgAce7_rjNhV4-Ghax8X-rQzdENSE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI8zq8KysucTMQQEPwWAQBmwilPLwqrOQzOznQEwd79g&oe=6B085A53"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
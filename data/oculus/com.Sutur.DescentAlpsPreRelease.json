c_oc=AdrCMlU4BdC9vWFXc5EjVEEcNYlfrzrMgXNLY6oUdsSbNNOTtE-8eYT5qyuMNY7zx0M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZeko2x652H6yQGbdB7TQZuhaMiF8a3uquVY2tFqwnHg&oe=6AC52A50"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbhQ_6XgN8gQ7kNvwFHstrj&_nc_oc=AdqZpLOppXedFRwYwHCgMjPdgUGsxfy_6a3WwJMj6jpVnzT_lAH4mwHBUlEzdzf60Vc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsOL6dPZ055Ubqesw3CYE9XZdoDUKNMCzanWD7ZIKTHw&oe=6AC51D66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMjUz8riUfYQ7kNvwFXkkwZ&_nc_oc=Ado6wbvAhDRMtPVrr1PB6tW7L-fKiMkuUL4S5BhNwKm7ALvR6Z4SGSk4WECIyIgk7LA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsXpBS936lRP3OYtEh9zgoJWVRa6ZKmA16iQ2fdNxVnw&oe=6AC5208F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYGrFzyYrBcQ7kNvwF68J6u&_nc_oc=Ado9vRLSY5SnkBJz7H33uuG_6mPGDWpf8FgqdbJs1qUJjpvJQEybCI5iH_iP3nXGj1c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUNROgGQmH-pVnLormem4aXEBR3HX6hlzKu4VdWHa6qA&oe=6AC4F7EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUhdjKGLwjIQ7kNvwG09G3o&_nc_oc=AdpnSnDNWaZA8So3dYMUKmg5tCX8xjFId2CKZ1VGFRbQEMPXS1mCF95xq3yddE3KuKg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCNXVVGyhiaiE7vBOieX4kO73ZU9FSldzSsQG114_HdA&oe=6AC51FE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
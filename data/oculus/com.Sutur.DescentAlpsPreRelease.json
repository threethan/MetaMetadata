c_oc=AdoBgpbg-scKs1dFzfSg5_5vci3GQuZIbrwevyQ9Xn9e26cZSKm1SiXaQa_N_J76eHI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06ux63B2VUSkko5UTsU5S_H0aVKZCLkSfGFqQ9x0Fufg&oe=69E62490"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9WyC92G1XwQ7kNvwF7xzWQ&_nc_oc=Adrf5WbMsEBXFwMCAhuUxLOsg7FEuDpy8exrSUBjfoCDeG6BVHBarCVg8F-vWovt-Gc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15PUZ3k71QTS31aTYwdrPOspFN6KYR7zVKuuFtTdKN5Q&oe=69E617A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdaZ6NSM4UUQ7kNvwGmfEcM&_nc_oc=AdphCDP7KM8JRalovr4JOtN420ATyCQfmMQ_krSz6BYo_x2gph29r5PXkID7tFUYHcU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bdNb5endMm5mHIHUFHH0Q54uY64P8E6qNUMthudUihg&oe=69E61ACF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp3f99tw3YEQ7kNvwEdMkJF&_nc_oc=AdpJ-SSFt3IPBg_P9Si6dnHwaSI58GxpvPp9nTtI-3LXde_yLJ7xL_sfZsWUNdjqW0U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Hx2rtM_NNgmcjoanjY-jMlbltzJdyU2jWb7ckitmGjw&oe=69E62A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGShHDxUkfUQ7kNvwFt_Kj4&_nc_oc=AdqNI_THvQivQ2nUC7XbRwrU7B-upKtme6ge0AU0DJtZIUgDVDzMRY9N6aq5bhjxhcE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CSpeAmGFWzTQL_wTP8ByLpJrvZmdd1Jqz4lQnRlxKyA&oe=69E61A22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
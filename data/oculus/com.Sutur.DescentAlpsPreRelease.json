c_oc=AdowKpkpxJpg-tGq_4MM7TEH6FaqiKeThbsMjoF-gYQwDKjIQJ9Oc_qF-lCTfuQ9d1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CCDLkQAlw_JS938X3YGz_dowMjl4IbTubwOSINj04Vw&oe=6A05C890"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0CiATREutMQ7kNvwEIyPbS&_nc_oc=AdqC4PBZPJO4Ecp6hoad9sudJH369JNtGM7KfnVa5YoCOrfQ3sHfCIOR6O66msC0ZoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JfWnOGADyLkHcqfTMEDhUNI_zG5Vbd1kWlm1cm_siHQ&oe=6A05BBA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PheCkvI_0EQ7kNvwHL8_K6&_nc_oc=AdqfC4gNNPpUI-vnA_-N9jj0VASzNycvx2h6ETJu1X178rliektYzfnOj9Zfn84MS4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af670UsYdxsnATP9VWkmfKNCvcHoMklgXh5537pO8sUNRg&oe=6A05BECF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9j29V7ZZJoQ7kNvwFY9fxF&_nc_oc=AdrOc25GlQJvMau6mrE-tyHfpOHgev11g38wJCwz-5vTfr4H9Q7K__ecoNuvWgl3Gwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pew3DFuCRuzkRXovlAhAFkOUXsMwMpHkZO3rdSb5Ikw&oe=6A05CE6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW700NY0kNYQ7kNvwGVo6p5&_nc_oc=AdrB6a28VDkDZ5JZ3FZrI59_-HsgSGmfM0L7DQ0Ic49326XAX5uR2W0BUdGBHdwKdIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X9NQqd7-EOQnvRSFuRNL7dBLM-TUcFGN0vmYLjdq5Fw&oe=6A05BE22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
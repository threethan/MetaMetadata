c_oc=Adp8Ap0nUI8R3plr97E66WhxZf2ekDt0kUO9JZsUDR3KF1KNNlRj7MWYeZcq75FolSg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AxpJh9cOKKg8sxy1PWXi0VPgRpydLlhGBVvDuWLBNbA&oe=69E77610"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5TmR8W7U6cQ7kNvwGGw8tx&_nc_oc=AdrB-zwM_N4vcS2LYCNBtDsbCzG9MOuu6SgyRC5-8Om--UYuDbbQWPTExDsdOrEB3IM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13fhmQK56aGuKpq2VGVIEn-SqpwAU4FRw6DyxtgQrbfg&oe=69E76926"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdaZ6NSM4UUQ7kNvwE6mkcU&_nc_oc=AdojWRGO0uz4ZL8uxPsuLbU_HA-x-ZmFRQaer3Ddi_Lx5yyEmK-g7pxTLuQVFErEhBk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z5ZEdJyz66DokGCKIJm3yFDPJHRXRmudcEJasoiAH0w&oe=69E76C4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp3f99tw3YEQ7kNvwG8xQyC&_nc_oc=Ado3GJ4EIfwFj0XNKj_4muJX4hKwpVwY5-7bzlTfd4wJ3I4uQXwpMFKdd0znpdax9cw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q72muGDu2x_wJG_gtLcygXFKpVIr30EZfqap78FPCkg&oe=69E77BEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGShHDxUkfUQ7kNvwFdvn1P&_nc_oc=Adqb1zKCzIc-suylgACpc9U5ZVyKvXv-VpGAJyvZfwJCdgUuuVNrkj-J-RzCr0xQVJ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Tmxz9L7k_dsc9Rdni_WNLJmqAZRNVnwoZqycOJVbD-w&oe=69E76BA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
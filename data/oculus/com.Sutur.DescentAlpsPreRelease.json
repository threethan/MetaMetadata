c_oc=AdpUcrIoF2uL3yzWlFwmNMd1SPKh5f8oUpxTpA6uBZ3iC3MWpJZuY0eo2WnepYEyqWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JJ2MMUdu_KHIxFF0TiXH4PhfHvkmTLJtZngnjoQxQAg&oe=6A01D410"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb29eomvwoQQ7kNvwEz46Yg&_nc_oc=Adr8XkiD6rG2PDk1bzefEUQTiunbwcduk1ADF0FWp5txGS2WXliiqmhpA5ob2KKV0qw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F3HXjpXYgmLMAp0eP0o8eEF1iBXrasHuCEadT3sjUow&oe=6A01C726"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OCBLK_H2tAQ7kNvwE_JQ7W&_nc_oc=AdpQgOZY1fUN-D4FpsFG9SfsxFLRH8aaPkObJjAb4dRP8Xq-KXHgy0eALRVsqQcnlk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e3CW5GkeicRUKVUICUyioh9rAJEVKlIkILdM6tdBwXg&oe=6A01CA4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC6lb2auOBAQ7kNvwEJT9o1&_nc_oc=Adr4isMnN5n-bLHENuZuepeWk0eu8twqqMnUZBRKGWMAdqzYb7cy0bCLa4_bx0SoxRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ir5CwNIJLuEwjvoFcGec6VXIMmt2rf8jsNjYlconyRQ&oe=6A01D9EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LzRCGVdQs4Q7kNvwGt2h14&_nc_oc=AdpOTnywmnS0cHbMlYAaO0dL67ocML_dP9ravzG_5GTHT_7QK3YP2A1eMYpP9oyDl2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FUzc7_GkSjn8d909-l0LJDdYaPrhvwGjZ4QSSeA1F-g&oe=6A01C9A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdoXjJmN9ZqG0axp84qkr5eKBPY9BVCIh8hBZR1BnRkNa3tC6slvuGLi3qUoMBQk-0E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41uGoA8fD4VcMGyIYNFihQIlahBXh5oxcTd0e9IIvoVA&oe=6A105490"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxaXKopA0fMQ7kNvwF4TUwB&_nc_oc=AdrMZK1dxQtE3w5Ej1ALdvkH72tAv3c-00_XhE69FzoINY3JYfByZiVxVkh8ve-2EL8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4npIVBfssYd8WBly3zAhV2eWQqV62qOzUvMJr90BFP0Q&oe=6A107FE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0868io9sv6gQ7kNvwGRspfC&_nc_oc=Adp8_2VlNJMapOeWiPNl-nTHOQK58Cueon7RoHEcjO0MJanm06UlWQ1Q4GVVlS4FTBE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vrfeE3LnkaOdHCcaMBRlsuRx-IfNasxlCgCy3jK7ITw&oe=6A104ACF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P2XA1AUotAQ7kNvwGRTcqp&_nc_oc=AdpQDVFEQvb0RTDamY8m6guFZ75FoF1lha8N4ipXdddIoXTd5xWewELcxgckwDkCJjQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jGHEcOEVbnrr43us6l0YSto1kCag1g7gdUx9xhP-9mw&oe=6A105A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhHGZ7B8fQAQ7kNvwFJd-BJ&_nc_oc=AdpLMUSbNg0sYdZNOd7pd8n9r-pZvIQg-61D1rFYdXD8UpWqmaunI3x52-zdICics7U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55Wemkd0yiGckXZK1tfSbSc9hmTnwg5pgvSvvkyg1SdA&oe=6A104A22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
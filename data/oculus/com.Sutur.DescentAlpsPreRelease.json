com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-e4HbvHlQgQQ7kNvwF6VcGU&_nc_oc=AdqV14MCXXA-sHCrCNlWCUvWufjIVOLwKEtMhybv4Qm2bAwPWYEmh0UXLIEHOlnhdc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROxSRTr_bb8_2i-Fb_D_LJSEZ17sELAT7dTMC7E9LNmg&oe=6AFC6D23"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2MfyKjeNiAQ7kNvwH4ukGX&_nc_oc=AdqeaBzgQDDj1wFqPWaaFsOe2vXWlsHO0btWptMlGHFQqsEC7J21eJ8G_3U7IlVuTDY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZW-AsJu4yxY0PJNqlH9BuX62caDomXGIPgJI22vDJSg&oe=6AFC9088"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3n5CmOKdyAQ7kNvwEuEgA4&_nc_oc=AdrJ8AZeSQ5XZPE1l4QAtUh4BY2fdot2XpSa68JSFnBA4V_Uzec827pbLISxLIYI4aw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0BkFRhBpSUyQ6yQcMoZMoJkexvelJ73iotDfh-2p6Kw&oe=6AFC81DA"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD-o7oGy9RYQ7kNvwHpqf_q&_nc_oc=Adolxf_nzlWOyJeBNdYzh58PIx9eYzity7PPdDbTeTSpDMnIS7zMDHTR19mECOMZuTM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrbgr48oKljQ66gqimpfnBZlpLM-V30XOq_aZpjAWgKw&oe=6AFC84C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooSx65qGlNIQ7kNvwEFD8Sc&_nc_oc=AdqrIn1-4GJZXYnygtIzmw9xBvGOqYQDQvv2teyZkRszVygH65hg1_YrbJuJcoMxzIQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDoAhvbbJLw_ng6E4tNwXYOiRL8crB2OLYOc2kbf9E1Q&oe=6AFC7CD3"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
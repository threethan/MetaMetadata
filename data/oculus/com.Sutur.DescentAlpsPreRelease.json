c_oc=AdqW2kVO4JQUqXLhRiY0DwIut5XPf932uEvm3wP-gYnjZgWO3pNywUmXzNySXzoHt5I&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWIFA9tIht8dD-eSCqU9lD67z9n-6b8CV_KuaqYZdPzg&oe=6A942A90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1taJ7DHUSgsQ7kNvwESRjV2&_nc_oc=AdrrjZCWcF16kFF3yIVbhHcqNJ7GWN-mfNo2JhL9MAmTJ1bQOCyFOj20TvqnWSQSvN0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCpvL2bJoKmzUi162g7UYztmGyOkzcf_0OO3IZzAgB3Q&oe=6A941DA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z9kwuz9yB8Q7kNvwEDd5CT&_nc_oc=AdqN1KB1OfbFx-OHPaggFemYcBKL9WPKEqMlrXsGpv8QVMh_mb4oOokmdqSNiXDDNPA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWupd_X6joi_A4UK7iqW1uFr5BgftRyweyM1f6r48I5Q&oe=6A9420CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZivE0-_sZwQ7kNvwH9y_vW&_nc_oc=AdpfACvDjbp_PBXtXB1b2Mcvo2QxWl9YDpaR-Yyb4xt4BtxQAdsc14g1dMICJuIv41U&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHudRayD2iENSGwlsMNCDqxFpmXGisM_whOWDH7futjFA&oe=6A94306A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOdb7t-3FWwQ7kNvwE0A05N&_nc_oc=Ado4xhBNsvprL63JomgL-I2E0gxzI2uISrvbGtekmU_5R52V-Tdr7XiK_VPMO0NAmh8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrXlJjNEtOfWKWE591tLV0yDhTf3Q-pb0bdGCtQKhebw&oe=6A942022"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdoflCCv8tU4fgZXUVj6zYD4qxk-zRFjIe-6M7iekh1-sE8lbf2hTXR68Ggx1bDS3aA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhH4gFfpzjQKwsiuJhmA-SU0M4copY5e4PFRdEyuM6jA&oe=6AD25950"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POgWSJ60aQ4Q7kNvwExQYY6&_nc_oc=AdqJlR-9o_sIlDj5GA7_5N4NRuue5wm98u7QZU9lj1GdlT0LvoP2GRwbFnIxvYMfT0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnLlvoh6ctlsXRBTz46EvbTTdtjcca3RavoXGS3hupCw&oe=6AD24C66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fU6w7Tudq4Q7kNvwG23q6b&_nc_oc=AdrnTdk9pIAGuyDt8l_D_7PvT2ImAyQlF7BO1Fn4Fhe5jZ5fPLXsDOza4aXkQmkSEMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM91wjJO7vjChCrXvqtKsaKZ2yD5MK6DSsm8shg26oQBg&oe=6AD24F8F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDhAlGKXtgUQ7kNvwFh8xmb&_nc_oc=AdpDTBiI3A1LfydFZdD3d4r76o1QGL715vkkyWCv5yV4E1NfhxFPHil2dORWBJC0jq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP3IgbZvldBtBlxiidbS6YCyMRJadF3wLIm8_pW9dhVw&oe=6AD226EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmtURwWWoeUQ7kNvwEzHi3S&_nc_oc=AdoVlCU0iZK7tKH4Fdp3NbR9dFBtk449MvsBzfIXC7TccMhBzOJ2Y0erIMAjbWZ19T8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeiw0oMzoxWG-kBLzmcb_jaKQiAtD7328sA4NZLU_hwA&oe=6AD24EE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
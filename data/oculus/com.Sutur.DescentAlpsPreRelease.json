c_oc=Adr0IRk6gV8vdYsMxUHG4sUTBNvGoLUCVvbrZqN-afjRkmBi9Qw4j0YRjN7xB1ohkgg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuTJpvG9pNH0G65d-VTuIxpibMBwhfZBzaxUpsvPFQQA&oe=6AAD3710"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm9E8ug1Ax4Q7kNvwEaGBRz&_nc_oc=AdqP-TiLL_S7uKDAghkXQBKT6RmivHjYZd8ucqdSIGDBDLCGc2VhSbfgLs4n5Dlwp3g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuBbfFvXqJfQRmwQXgnVL2CDa2PQadMWwtPV-QjH_TZA&oe=6AAD6266"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1J0TlH-IqIQ7kNvwGRbFxL&_nc_oc=AdrmYwXkECJI-F98td7D6Y8qxtkvV6XLhzF1uZFXMR-fzUW84z9NK319TYjkTdfWuWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcYZjY8KWpJt4dCL-zLTolY6lJG-GPkuOV19IHpgtosA&oe=6AAD2D4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw1f8VwGV2gQ7kNvwEHEBuX&_nc_oc=AdoCJc8-L9ylYSS_GKsXo8N09LCz9tcbLq5J0ianLDoydbZprYGsz9-iY_llAJQ4t14&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS6gNPJMM1uw0IYdA7p-ZR5Z7C3cILPmWg-ONbE2tnrA&oe=6AAD3CEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkZvM4iDCpwQ7kNvwFtkgpL&_nc_oc=Adqh43lV6aTOxV95dsTcCjSTpEyK_E48BjP_2hed0XRGTJ-PQdE4AfHG-F4zoT8RyZc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6H2EVCdbDrgCTvh1Lsaoo6jtPe8Kjpz8whjsSmL73kw&oe=6AAD2CA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdqPkWN4dzWiKmo8Ao0-2kxKXpRMljQRoME-owr-pnOz0Zuce2l7Kv54uQA6WS1IfUc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIw6WKzR0kxgClSsa3ws58wh4DaYASCuUcDEq4okOPAg&oe=6A86FB90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6fW2RbLLD4Q7kNvwEoSqEJ&_nc_oc=AdokMpq1Vfhf1O76vL4y4w2jQWyIuFcZ4bUMlhIEjFMEyhFM2zAgw3qMD8-7sPbfF_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-OwkEaoJ0potQgLd_5cnHdEI7-Bi5tKc2aC9aidik8A&oe=6A86EEA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDCE7YWQ9uwQ7kNvwGOQyB7&_nc_oc=AdoX8ZMu2V4bIRVLJdHLKjD52sTlDn5Hs2UXgInG1ab7LqFEz6THFEM3desnzn2XP7I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtPzqgxJkmVfm2WeaFs720ePnTG9Iu_Pr4bwWyvpp30Q&oe=6A86F1CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFptQBE-jYwQ7kNvwF0y9PV&_nc_oc=AdpwwoO4GieuJ5hvZFIrma48VRFiytJlDK2UMmpTaCqcsq3P9MoZ4WBCZTm-Yiev0Po&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ3_QOjZrlh4FO9rcYwCWYzUZeAcEQqV2AXzM19qXOjA&oe=6A87016A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNba8Rs87o8Q7kNvwGeQ0xD&_nc_oc=AdryUPBqeUpTA1dyeik95Oz-efDPYOYYt5eJU5epzQuHnyXUmFdGvE0TY3L6KP8A9kE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlZWqbbQwY1NqaQY2cpgCOUcuKOvDEq4Rulp3thPyPYQ&oe=6A86F122"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdrEYsfr3joLAD-M8A-PJeE-j0vmoXvZSO9w__wwPuCy_KIinqB3jSUslIKWLzhQ4dE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSp4_pxJZVBx_yiH-IEj0it37XQ62TXN8DLD1qv-1SdQ&oe=6A675790"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlkSPxsyyK0Q7kNvwFHB_NO&_nc_oc=Adqobb6vdeehpdCgO9CQeME4FTw9dAuZfNQi6S4lBGofXmjiLu2UjWSRPF85ZtsD4PI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQkNaUZJ7NPuKReLoEjG5CPpus10PibkKcfDCX1wYLqg&oe=6A674AA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c8ulRmlqEgQ7kNvwFFNacs&_nc_oc=AdotyNJ0d1JsQyQFOs6EoasAVObxJt7DKA4FVqNRSwlqAxtCf_bL-IaOq312L652ogM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVtcvlQXn0iwsjf1iZeJaU1E8-pvOmZ1HgX3QT0JwnOg&oe=6A674DCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEkcPobTVuoQ7kNvwGRN7uG&_nc_oc=AdqTCe3ggzdeTPaz4xoxOmGZeFVXFXV6o0XTXfMIi74uMgN0buGgYeal3dwDSKz80r8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFKYbMpg3AcJ9uX3G8vjmxwuEr-zTIkwUPk0npxVuSuQ&oe=6A675D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INMTbg9QjWcQ7kNvwFPIgxO&_nc_oc=AdrHBDgLNUzpuxELdJpcNMaUherdPV3_KmJk2ZFlxGO0lKQ7Y7uBwLcvsyZ64sigQRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCfcvK5C5SYilz0Qx8TgtvkIQnna5ZpvnhmHd7a5t01w&oe=6A674D22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
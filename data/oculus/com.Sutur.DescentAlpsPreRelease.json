c_oc=Adog5sTeAx4-018gUaivBn7iIpWRk8QrEzfveTtP2rmTlGgDmQ9qBUhrnayLlzUXibU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI5Kuyx-qDzp4bc7FISKlK5kiyXRgEvLh91d6mpAH1GQ&oe=6A79CC90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHLxmc5FN1IQ7kNvwH2JlHr&_nc_oc=Adokf0CwHbn7W6zMoZ0124VTPe-8Zd2hSNyNGWjXGcqUMEZzHgcjqBqwWknlPRkKJPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtgh9TsfO-ZrRZBFXzD9zdZUF2TmyITtkgBby0IU8vYA&oe=6A79BFA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7sdA5ZoZJ4Q7kNvwFrNwGD&_nc_oc=AdpxR2eZEm93LoT7wlQSf32eKo4c47Njw2f4KRXcdvPl7k9JfsX_fFEFlgPXznUVtJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwBAQKL3uAriOEYMVq6V0PpepXnr-XwvXYLJqTaeX9eg&oe=6A79C2CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kuAw-mD09QQ7kNvwFoqacg&_nc_oc=Adr_F8WZfGSYWbshVGY-T2GvxsabOMLOMNtg60am3fmmxRXBCrSfRMlqTr1Z9wOZlp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8q6T6IuCbMLFdl0nd-K_RojV610GBLj3b8RrJ-Y0Wlg&oe=6A79D26A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJC1rpw8y80Q7kNvwHsN_bZ&_nc_oc=AdqGHBgha593S8H1zcYpzOvHE7th5uVeimNSedkXQLOJ0GKOa6eEIioqsE2_OUPblzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSG1x5Mlqic_D7_KGz-m67HixcoZnzv_TQvctQAL5b7A&oe=6A79C222"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdpqPUEHz01rTSjFGIssaNP9x3r9Z9o7uYRMhotz2qlFnzj_allITqIOt1DT63ictgU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjYOtZM_3h5WwVGa70Nfrx8h7is9xelb8CZ8TvIoA4YA&oe=6A8AF010"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-MiZPdjTrcQ7kNvwHXXFgN&_nc_oc=AdqeriD54klX4FEdjQ2y0NL5EM9qs4Z0pQqt5npGmfs_df9hkNP3S7JJGdKXiVdt-v4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmIulafVVcqkqvxKaXGV9KOqEuhimbH18Aij8ubQNEJA&oe=6A8AE326"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tf4gVolQt3QQ7kNvwFUt4HD&_nc_oc=Adr2OUmAoN4nwQsxVul2hZ0wXmDTGR_-L7KxmLJAx4sBRQ4wodXko-Kv0oKgdfNzyVo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxGqukloGj3Bje9V4-AmDYaEZoWGknaIYZqWrDC3g04A&oe=6A8AE64F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWIoKmoMY1UQ7kNvwFzMORj&_nc_oc=AdrZqqyLB9gV_h0_sniVEHmqOGpZlkcu7pqbSvuvAoWlGkRu4q8f6pJJ9Z5XEM62EL4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcK9hfroaSqQcWTliL7hCvCCzbGAStGxg_2ZD3wE0XsA&oe=6A8AF5EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEVT-vTFuk8Q7kNvwFcbV46&_nc_oc=AdquzRmpGG7fbDx1N4LC4Lv7ZqYkJtPqYfSnmk3UDXBOgOCouTRo-j72h3MBqQliYpo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT8SMDXK1DGdeT36I8JKTAM-pw3IgKEeLTahVz9eKfaw&oe=6A8AE5A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
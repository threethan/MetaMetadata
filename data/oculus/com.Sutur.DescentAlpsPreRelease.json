c_oc=AdqUR64_3kJthIOyzy2Ht1o_JI61P4LOf1bIvbuf7n6-U9mJvBHqA_0lcS_CP_R_eok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J8ruKtiMvO810JSSPhUQZf6s_ncnOfeNhNbN3QTjXcQ&oe=6A3E7910"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3ap17rV8NMQ7kNvwFVSfrS&_nc_oc=Adpo0nRb3IRRcIelLpFC-ZWGoHrkG52khtEZYTVk6T6LZN7tVlCr95L974I21v1FTiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eqBXrnDGYMTrL-0TlHemSmq4k2Bvuum43AkgyeEsFgQ&oe=6A3EA466"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeOE0PwpPWwQ7kNvwH5z1r-&_nc_oc=Adqe6xMM6jtN5mZmJB5xATuArZlHOAQqLTv3K7zdZ3jAJ_i3ii5Xo_z8bW20qOSGuVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hmv4GunOZ_wPWUdmW_JgZw7IBvIYywZF07M6X5bRhMQ&oe=6A3EA78F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgMNJ17YgY4Q7kNvwH9unex&_nc_oc=AdpP52K7-8r-Y6w6ffCCPoFudDvXzjrUrAttbbel6OD7HoT7jlMxIrsojz5ig4MOqC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KuGBdVc5btw-dB2_sZot-6pLgBJ9RcJzecgHmB4mUXQ&oe=6A3E7EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIub2lGPxooQ7kNvwG33JDp&_nc_oc=AdrACOCudZka6YzXTmEgAKiF0WWb01_NAMH_x_E1DI9lVUzE8xvtXCPiFTQKvVUGt_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82KE8O4gCQOearzKuFfsxSaFtWDtNpttV5qA4KJ0frFw&oe=6A3EA6E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
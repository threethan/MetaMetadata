c_oc=Adoc7zhfSAt8VC_0sxMkF1nWHOPxh9nixFkf-q7uTVqEZZDd4G1ua-E42U9kr_5msys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vBFUtGfAQqCY2NXc1wIu0QZ6fMOVzdVWLGLb99__94w&oe=69FF3110"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb29eomvwoQQ7kNvwEzjqEz&_nc_oc=Adpi0RDD90CidM2zu0Kq8JAWBoNdCZ8M5Ctp4a3C2x2fs8PHUxUwiIpV2WKBYTJi4ls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kVXrurXhY-Z7ptdo0a6I5GLjdPodfYuXYwsVXyrGnfA&oe=69FF2426"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY0UGZE7D6gQ7kNvwHcUP0u&_nc_oc=AdoQ3ckJ53owLEb53aU6uflin0ZhmHsi2SkxFfE1eresm2oGpB6oi0tqrwsMYeWp0KM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qEpZZGM1dF66HVjb0L2Fcnr1KDBMODw_VRh6o5kUaEg&oe=69FF274F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyrz_WYHdXoQ7kNvwFGdI50&_nc_oc=AdpaShvEYw-4SiKocbuNmri2ll1t2mdzQsYj7KMgRI4T1rwlrdEy3JDQql0F0MwXxtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53CfRjo7KEbGwyKcAgLkbKtwopGOcETaYkTDU6Bp68Nw&oe=69FF36EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFrlYJbbzssQ7kNvwHngQiv&_nc_oc=Adrfc74f5eHnuE0H67hP0kx8cuVVli6pqNpd1tynrEGdJJseiQMPXFZsXVNZzBfAZYo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h4oxaBVoYj0zDRNxkr3KaYH2adcVruYeMFBI0Rcseww&oe=69FF26A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
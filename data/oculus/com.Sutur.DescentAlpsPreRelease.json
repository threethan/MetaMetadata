c_oc=Adr_k8hPp6_2o6JDs5CDLQmHO1DZDdRRVmjnMGZZ36QwxkadsJW5YkbYYi4mK7O-QQg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Sff7jrgIKiWO9Z5Nxn3l619FDp7lNclk6UzYUT_29g&oe=6AF34ED0"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px3tbn5cds4Q7kNvwGMzR7n&_nc_oc=AdoDUsldjoxjI1euO_T8eYwQ3_5zHR30xF9CAO_51luvrhrEShKHkWHY-9dkJjC60MQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEQUsi_Quw1WL7UJGQ_kKuqK5oB5oSpPJlBbG6QFSC5g&oe=6AF341E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS_rp0BYinEQ7kNvwH7W9Md&_nc_oc=AdoH6BnjRGrh_bRlhNEPdE4H2VxFuylSRZpifq3t4kP3aqW__COpiIeRgeDN4eM_Frk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSetARTBgGujXtAt_IK0l1kSf-Z6yphq-ygyyHOzc65MA&oe=6AF3450F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihb-BGo7DkIQ7kNvwHwUQZe&_nc_oc=Adq-67DsHUlJrOKA3fjbLTMmIX25jBVpqB0Gpwnp_eP5yHuLO12fRhxuXvs3yEQ5jtA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAe0Km2_iT2KFpQ33xMGDdLTU5z_fisVMI8kJo1fgkpA&oe=6AF354AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FQ5GJa6zMAQ7kNvwFIHKtb&_nc_oc=AdrX2K8yButxJat0lLhHw7--mj44lVLzNDclFfnsor-XJq6vjwgzTmT-T1NvGKt2_Rk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl31itxR1Boss3IjDLahQwZzOcg14daG4W_9idti3RDA&oe=6AF34462"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
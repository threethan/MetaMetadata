c_oc=Adr-XHAuCBRcMB5ToSMCdQ3e0T7k0sb5Q7lCnXjIPm9b7ytmm1ow9UmM2JxBh0vLA-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ne_16g3KYSgvCZyCri9N9fUrwYdPphCVw0v-noCyLIw&oe=6A47B390"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azXZ7B_3iNkQ7kNvwEpTRHK&_nc_oc=AdqancRHNJMbO7mSvoyOhr2I4_QEInkzaC_B30C3sTXlEBKaaleKLYdVyXYFBe_rtno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1AHhAWleLc8bAewa_854IneHkOE_6Fc7XuZ_CWQ4S8g&oe=6A47DEE6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5As_z_HDieYQ7kNvwE_hYfn&_nc_oc=AdrLE25ReFj2dmCnEtov3kiQk6boz3a7RH5GOlPkB6NqeqUK5zNOUrkIUdyhV4I4Tjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K2RRIGeGG1ujKCF_V1KG2q51uDVdYs63iBdhzcR3dPw&oe=6A47E20F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBA0_5MV52kQ7kNvwFRv9SZ&_nc_oc=AdpcHXOhxdcMR2udjQN86PcivbJyh7G24dBlVY-cLbcZRWpmgt6j8-ymI-DVTvGDcc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r-LswP5UOtp_suseSg5JwKhmYZ9xRSQomf7UQiMcIMg&oe=6A47B96A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52VZphGju2gQ7kNvwFwpBTP&_nc_oc=AdoDWhU6aOKX2UI4C1Q_Ysjn2bto7wimGgBkqxIq2sBbkgt9PENzv356UlWtaqfht5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gi9wzl-yzYTm3c1VOVhqPQsfT03szffyRj3z_6hqbpw&oe=6A47E162"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
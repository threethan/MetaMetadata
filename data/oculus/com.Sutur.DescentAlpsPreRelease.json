c_oc=AdpQI1ty157Rd8EfS8J0LzaN27-R-FSc-Hsa13GdzaTxJn8BHriB1eqtD73f0MAXq8o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNxr84TKZbxvFMm_qOdxE_TmUhQLC8uVasYhqsnnfNfg&oe=69C7D210"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP5m0dbQtnoQ7kNvwHp-aCS&_nc_oc=AdohID27op_AFGF898Vj0aHoCqUTwyXiUEAP4cmvPDRzpWP4lXNOv-wyZFlZcxiistA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyxp3_HDq5I26WpDivtT5EP99CHVhmipGu90Zg4DS6JJg&oe=69C7C526"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R81e19ztdrMQ7kNvwEX5mS2&_nc_oc=Adoa_EdkNCJ8ip7OxLUozvBU3b4Vzgc_VkPcA5v47v3QWKLlZ9W4abe1H3F791wCvNc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwP-AcCxBj4jDyR2wuhwx1fWnarOXNs2Nb1T4zXDbk4eg&oe=69C7C84F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyqG-zfZrPkQ7kNvwEOoZy_&_nc_oc=AdoPLOYR9MK8UXmoiY07q14zMWAN4AP0kWIuHsdAlwwmQ-bdo0gXeG5mXi4W21XGLgQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCUPonx3bGmGaPvx2BXnH2Tg1Ghb-sndfDCwYpGNAVKA&oe=69C7D7EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUKKd19OBg4Q7kNvwGJepWV&_nc_oc=AdrDPYI6Akz_McmgL_QyUTFaaBNxSvMFKWg3qvGJHGa84H_za-IZN85YO2weiRtYYwA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyMBqOB1agS472cSuI6o83PlBRz9jYgI-M9qVSJhOURg&oe=69C7C7A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdqWEx7kPT6jwHg0o0MKZLx3QYwmGcNVhgT2LlrDBR0nFBvrBq5x-jaXcV9tbchvjXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_34ypWXDRtlWkvSlPg438BsbVPfshEcquBw3Ca_glvg&oe=6AEA1450"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm4TtNWi-8gQ7kNvwEpTuYl&_nc_oc=Adrm1EPSWDpGFk_PIKp4cEPo6xfI-_s_hh5m-_9hDAdQXu6f-cu_X4TzZ7V9EZQtoL4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-L45ATgdGLOPS2H3YLiCRNb-WLRC1MKKcyG4RwWS0tA&oe=6AEA0766"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtoolZReAe0Q7kNvwGZo9d-&_nc_oc=Adp9Jb-PPkDltzFU-SwgPi1GXjXSVjgxaKk6kVEmnw1wmDMDCEPpyM3Ewk0mHSP8Vvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpJJRRpFEjNRiTnSzut2dhbQoyhbB7sSdMjzBCIlm0ag&oe=6AEA0A8F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBc04ys6-1IQ7kNvwFXYd0O&_nc_oc=Adr0Bz_cj4MSFHyTHRKOkEGHKmSl8YmyEpKTkncU45NSyErSbZRYc7CfcM_yYqlh-6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ00U_0B-tpwOUj05Ux0B2of78at65nqgFDV84Jotd_uw&oe=6AE9E1EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEYxsnMeyyUQ7kNvwF_rfWE&_nc_oc=AdqW4hR7eRo-Gy5yBCsFla0KP69aglPmIeE8kI39ZR7M1sEz1Y50dMS8R4iFZSG7-SE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdP0y3HTgrJl5BhvQ_qiOZ7FIC-pCpKvyilup3BugqBg&oe=6AEA09E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=Adpt3FjlOBuA6Vu7vlFu1RjqeE2wgpy7gCDFGedzKHm1AKJG2fb_NJmBETzkBNBWluw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmnnKTfY7QU0UtgqCXA1zZlc9SjOYoR4I5o0WRa1glZQ&oe=6A539110"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqF5g-w-iE0Q7kNvwGuI6T-&_nc_oc=AdqQGuoMC-hFpTOBynee63XoO2-DfCSnXcb2pEM_zNvJrVZKol7QwIL6vAYNf8WXjok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl09FrtCHDAzPpnldkmgU5YYML-q--VPglYt2Sq-j3Xw&oe=6A538426"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5HHSc2cEAsQ7kNvwEgQX2S&_nc_oc=AdpTNrQ4vqnHdTMJbCVjnrorNlZI_Mcjj2dfx_3i34hBBwA-JvgLC-LxZESxYOD2FUY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa2nJ7NWUOUwA5_if0u-XsAKFx1tu8O0dEaLh9xXVkYQ&oe=6A53874F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUi2_sywGCIQ7kNvwGKnnXu&_nc_oc=AdrG_keGtTznhYm5-tgcybY96LbWT_uNF45dkpPXb4IGfcgpHyrB4pCFeDRKNqocb9E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGz-U-DthUAdG4PuU6YENcrEOo3wmkrQTjOFMg08Fupw&oe=6A5396EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE6Ry_JgMj8Q7kNvwEPV_0J&_nc_oc=AdryjvI9_yEIvRU0H1KTIoU7IHHQTqo5jspYpG-JjS03VA-UVOCz344FsjbP7iBKyhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYg0XlMB_K5CfC47hu-mYXPFsj-SguzKOL7x1vNJr5hA&oe=6A5386A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdoiqseDjRCFyu3TFcBRMwoS6Rqb6nCGB7CwkjTW6EmfDReHLlgWsN05fHLlFZV8ihA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOl8j-0uMljOHsev0nBPP03YugRX_GrEpEMZaZJNZiew&oe=6A5A2890"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLRlGt4q9iUQ7kNvwHj-sQq&_nc_oc=Adrt3ceK_DbLD81q8hV7hAZNu5fQJymFM5Dy5UFZtLOwWtJJJAlSkO9gBIle0IqDmcY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlUSaFtEZ_rjL6wGZL20CbN9lDCq-HejYZQXCI0lv_YQ&oe=6A5A1BA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9pmHrashNkQ7kNvwFc0gB1&_nc_oc=AdqTNJ_2Mj_xeza15fzQJIAZ8fG7nvlo5FyOO2wqavFjIZocKEr8Za5xdMu9aqMdzw0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK3DCzHl1rEIL6HMXHxPME9UXocLQL0sTp9MKTDGtbLw&oe=6A5A1ECF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptuvZ9-KqVMQ7kNvwG36LG9&_nc_oc=AdqKmIdZWxtOA9ezYcKWJ0r12Jh57tNkHA-Q4YjlCMoSdvJtfByuSrQ42JCARf4GVJs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-4FZJ_craFwRkTnh7_87S3PQAWID3NxFS5zEK2zsrrw&oe=6A5A2E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL-b3toXCYAQ7kNvwHLB62I&_nc_oc=AdrS7BhKkeW8SfzE8bAUEEn23xPAhzwkVo6veRB_yhOvaLTSiuP45KWH_103BjTAJHk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN1l0fmSJIlqc9GqHI9xul3ieZbMIPy_q-VxsvG2ESxA&oe=6A5A1E22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
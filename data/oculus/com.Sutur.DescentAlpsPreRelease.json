c_oc=AdoD2igaOiqAaHF-vJ6hx29kRaVMN8NFiTOlqwfdpu5dMDgaULEju6ByLhCC9LsXASw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPJ0IkgzuOcLDKcG3exYe_LcDkwHgvrPq3D7bwkDVppQ&oe=6A660610"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlkSPxsyyK0Q7kNvwHt2Kb5&_nc_oc=Adq_HeO0P9Loln2XgQbA8ZarEgpSsulWV3UyxPbf0I9IZJufxJnLsJJN0uRmnV-PF6c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXqGLR63YhpqOXJmjwrJQENUSh3GsThIEzERdY9Y-Vjw&oe=6A65F926"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c8ulRmlqEgQ7kNvwFDJJqK&_nc_oc=AdrJkY6V5-saCw0O-OhFORVY3txdhSGnsExmKDJ_C2irTb7x5yypqn1aPMyapPxKJCg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD4m026zcpcHsFrScJymkkspYvV01Ny65AUxLe5Y_VJg&oe=6A65FC4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACOVXxhLzugQ7kNvwF6Zuy5&_nc_oc=Adr2KBKvLtSNbQqvIPtYrIgTo0E7THz0dX2wHCjauBWqM6I2Fnr3AUUN2NHg9DQhBdU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABT5AR7Uw-PPuXqP1CkPznh2ENFaKYxWjYpSzXJJ0IvA&oe=6A660BEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlHZ8ISrIbAQ7kNvwGW0H58&_nc_oc=AdrqPPzi2VZmh0IrqvyARDQGoSxucMqr1ZyPxs5ORF61e3AwM--HXIe9X3HPDWfw8rY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQHU7w_zhMRfc2WiN-a0z7C-w9mHO_hi_7AhvFFH_Pqw&oe=6A65FBA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
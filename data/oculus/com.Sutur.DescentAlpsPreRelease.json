c_oc=AdrtY3eqXH3gZXUYeL1B7aXlSHpaip0a6XfFgR0qoNgpO_a4HNy8hg5hQpoZGckZn08&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9banqz5SdgxGP4UG59BEn_jpvWnnEsRdQahkg1ft1bZA&oe=6A2FF890"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgACCvtNkyYQ7kNvwHARMNF&_nc_oc=AdoDxtZFK9h2nGSjwZfbRN98Tbt2voiINQi2Kae3wtA2NYWPDw41lGHv8f51tOAAgRM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OW2RUlf2toJu9pRO1-jna_l-sMLZDic2m5GgNX1U-FA&oe=6A3023E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dOiQ8nTGkwQ7kNvwHUfCn3&_nc_oc=Adp1rWOGESE-kzx_OteuLJNfUXY4ggy1BcUNtDa4wG3_N8QN9GMGnXChncPaqVv4ftw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mPf-m-alrpefUdVmYQsiZOc4LOdwrSFINXjbTCw8cWQ&oe=6A30270F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HODZV1wT6zUQ7kNvwG9RCIP&_nc_oc=AdqfZOsEl9WopTuVgQUF9rZpxBxvUtsshHvNpV2s8wVYHIsnZ0H1ocZBUzYoS2GA50A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YthVQk26etpLv7WH0llYIEziJtj98FwxVYYSumtIEKw&oe=6A2FFE6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PQHo6WTnVUQ7kNvwE_vXgY&_nc_oc=AdojGUQBQMmICAFbTVd9Eu9Dxov4dBDgxs2pZ386x1BQJjhrGy7J0jhKAr0-QdhA5V4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sxRMHx9eWmQj19bejbCXc1Qige6Yte1ikZV2N91kLwg&oe=6A302662"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
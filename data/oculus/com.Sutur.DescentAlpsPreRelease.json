c_oc=AdqeBu1rFvSLE2Ti9-XwCfeTXli7mXrcEbi0saigDwT1KpOcykcaPTv8Jk1p8QxMa6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU3JaJF8ZUoP4-A1vs8eUAMqVqMgTnL1S97BRCgODciQ&oe=6ACA7050"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gqoX_xr9u0Q7kNvwGIDyFe&_nc_oc=Adqdg8rXedyfNlhBZazwvzVjvw7RNM4ECWHmCSyFa7iiLMrNM8GMG8uDjY8YYiQ40kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1K76zukOgwbVPPocf81bU3nB82pVdD55y2eY9oYfZsg&oe=6ACA6366"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8Ouf-qD_xgQ7kNvwF27G5w&_nc_oc=Ado9vPKRZnUP2e5AyGVxofMLgfpjlv8mk4H5_rzlz7WnBzxDFOUaZmY1Nhbx85Xft2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuLv_SrN4ORZisWYihxqiQTfYNSrBRD2eSOn6f0kDmBQ&oe=6ACA668F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHMX5DXZrHAQ7kNvwGHPxxf&_nc_oc=AdpCopcBlW2f9Y2cjW14JyoQOh4ujte_mw20hr9stbCexxgW-MzgV5OwlhkSPp--sxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-za64OGH5aDywRCEHxL7W0wKJF9_aPEVvVWbemWRqHA&oe=6ACA762A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnQmIfoEO9MQ7kNvwEQqAC_&_nc_oc=Adqb2fheUBYtbj0_cjEue4fMvF1noxWBGj3hx4nFim74GgML2YD95Sf7Dfg5m5qqmCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU8DPhOV1YwulFC9VrGmiHfKhLtqyE5Bln6CC_96RMGA&oe=6ACA65E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
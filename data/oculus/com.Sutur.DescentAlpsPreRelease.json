c_oc=AdqXeMdnxnnQWmf2b7fB7qr72ZEoxUibPht5EFF9W6Q_ZZim5uMJd2rdzRxPw4LTnTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6wWa7M4sJThGnVBU3gJtgIXhuKqHBa3_dCJ33AQOo8Q&oe=6A4F9C90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1PA4uKsnKsQ7kNvwFnF5FW&_nc_oc=Adp0wtmdSCQKmFkIncYJH71F0mOP6xR7WHK6JQYIA9wEBdnXsZdkW60UM8SqmcP0h5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsMgcZkhKG6hNqvhTJjybTCw_vOpGoZ3vejZEp23k2Pw&oe=6A4F8FA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR35e5Flp7IQ7kNvwF1yqcn&_nc_oc=AdpYX1btICMoCM1dmvxSU3dFjPwqrRZwcYUTvZAdEBY2N4QKu5LlzvFnc0ODQj09qvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBQfz_6Dm0H03QT0P_CObMxAes2ZwXCzUmEZOpzIf97A&oe=6A4F92CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KwVQJ7DiYcQ7kNvwFmDvLy&_nc_oc=AdpKNPQh6p8XA-OwjSsx2r0-AiE2hSL0SdBX9Y6UJ2di_JDazj802ZOp-1TZI1Dvl4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH5U1v0iQ2Ayu0l7NFxs0Yy8xh5yuG_GVtNOcCteVSJQ&oe=6A4FA26A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHhCcMU74hYQ7kNvwHNLR8k&_nc_oc=Adrscckm1Y2aOWygOSPu1cy5IB5MeTEG5K7y7mj-NOhvA3U76CN56MUAehrVP0DIxfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAryuaF9mhRhrVEfQsQ8Hts2KTvldPFpM97wm86KZo6eg&oe=6A4F9222"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
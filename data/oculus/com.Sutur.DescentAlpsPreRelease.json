c_oc=AdqanG2fL4RBa-48Phj82iu2hHk7EXKqWqwGHO_sFlFbTlcGLpB4tKXksHE91FoXXD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H2IBSDV7HUdDZGBidNt2GS8ouR611xrN5677joM0dDQ&oe=69FB3C90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39S4_P4h8JUQ7kNvwHqQmc_&_nc_oc=AdrJEryV0vFiCQaapxRoSMGpyoozVV-FbNq8yILItSC82ci8FQvVhY83ZFShTeHriBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f8nkkgSb63c1LK-8tJo5KxJPRGdZin7sz0fTHP96DVw&oe=69FB2FA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eospx5h2wkgQ7kNvwF7PtVI&_nc_oc=Adr095tQ3gDlJ-b7NsKo468B5NvVlv8BZzjskHLDc9lm2PTXC2FbaprsMZyeGra_4iw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lxsSmLhOwhlvOTFxKPKKwMHtHbUUHGuZ5Z3V_iMdQbw&oe=69FB32CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PugIiyjHZ7MQ7kNvwEJssOB&_nc_oc=Ado-2-umKT1PboeFdksKiCYeBZdDMWHsyNhT9B4tzJwMmY4OHN4FYjKFjTsCVAGJ1C0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P2Sc0p673DUSdxtyvgKm1035wX0_WsW1MMCaXpDisAA&oe=69FB426A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OicP28aC9VMQ7kNvwFoYWLk&_nc_oc=AdpGHarvjHysoGawNFmjgL2LX-aCBHF3OLNSwY55X-a6pgWB_43w926PQ0HLoZqpJZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hWRz40SxK-1nXBFrUh-VfzBrrucL3GjguVISEWgB0LA&oe=69FB3222"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
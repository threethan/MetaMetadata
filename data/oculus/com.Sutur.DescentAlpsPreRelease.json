c_oc=AdpGBAfal-vqLGzWEa4KEU6i97gTPyiClRvFN-r-DM0IIlTnM4e58pA0rgz3i0YYQkg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr7CtMe3xNqHlzwkss96fM7lonNnm3fneBvv4cs_aA_Q&oe=6A985750"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zJhCJEsq-EQ7kNvwG_3b7I&_nc_oc=AdqTUjBzB6SVcJimHshuD8it_HCNEMj_7S0r_PEYUrXsi5rHKtlGNAoByqBeTzeqNAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKzJ_gUG7MdFpB87wnxHbHxgnzct23xKNWGyUm_EVx-w&oe=6A984A66"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pl_YhhUNK4Q7kNvwHOHp3I&_nc_oc=Adoh-8AVDjR8rIqarx7JwXiVzwU-V1wftklb6LJRtxatzPcPfyPbi-VQ3oN7BTfeppM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgXa5UD6OiAPewVU1k_EYo6lFlbE3wl9YcNCCBE-pM7A&oe=6A984D8F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rL1EGUIIFoQ7kNvwFbbTq7&_nc_oc=Ado2vm0uR-rM5Aw1sI2ZKfMrBIGFpKDRDI-fS85ZKco_CuQ_NwgT5Q_wwfl2nDZxDxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeO99ZGmJ4uwqqHd2QXOKiklGlbXnqvIIRkQgYryOJMw&oe=6A985D2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz7-nQMx_bwQ7kNvwHHd9xA&_nc_oc=AdrKrruc80tc_4hA7t_t9SQJ-iHRSzqQvgjt6fNyHu4TEhRzooDiKJ2kgUoh_hFvvQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKiXTaYe-i38GxYq300d6wEHyZJQbt_DJ-qeFaX4ebQg&oe=6A984CE2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=Ado3-5dJ3zdx5847E92Ev6Jg-kCUo9J5EDT-ijEVPfoIyLZUo_404V0dD9s_zjn5LF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A905yOvvRBtuaWYzKFe78btK7tA9Hur-0LMyfmV7nbg&oe=69ECBC10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sxqODhLw4UQ7kNvwEbNHwc&_nc_oc=AdrmaGaZ30_wURdIApGjmGCNMFpzD9vXeFnGPFdExxBbUH_mAC2w-L8tCjrN9X7J5bo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-SxnpfO9KpKqWF8JG_-Z0j12OI7EfUgEnnLKyIMg5Pg&oe=69ECAF26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ-pVZq46vQQ7kNvwExQ4QH&_nc_oc=AdoTPpBq-0fJ0qvVCm3odqji7E5VR_xvEzu-Dwqygj5wIfDJzSAprXPEwAXwh_0Zc54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M2-eiU2yWq9knYmvgcTUV4nijG1qzVkcCy2jmGfWs-Q&oe=69ECB24F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PhQEJwXL2gQ7kNvwHdsGoj&_nc_oc=Adp5IjVkTEIRn7uaQvC_EbuHtBaRZpHT5wSdIyi8OWo-BibIL_RvRcG-5XaUPigu-GY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xmLjynzE6qMcd6HUCLbEsVCTOmZQuxGGPi2-eHfqXDw&oe=69ECC1EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGb7XYQHBxQQ7kNvwEg2AHh&_nc_oc=AdqWJhes2O30GJLN_1h_jnElDgYQnXuNuTBNFqtoTH-lnSHqTnLwhgu8W6XOYiwV4f0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xC1T4_6c4L8J0aody1dbJmFaNx-0lEXaAqTtbAe09jw&oe=69ECB1A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
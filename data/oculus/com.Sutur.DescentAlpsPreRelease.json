c_oc=AdrFgFRxhQpEQ84SY3UQddHt4qNTBvYGRX1iyypuY3l93tLE0qtOsrvYuLsytsIX0to&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpAOJzzT7jwVwP7pRVQdcLggKZgHAbJX0j7biD6MzfQQ&oe=6ABD0910"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNcwVRL99tgQ7kNvwHuMuDi&_nc_oc=AdoTWSWpEaTd1DiTTeo7n5AjTmeZRGz1S2c0IeD4VbFZ_4NdAY9X9Q0C-8HvzizdNwY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKsHy7A48bsZo-hhFLGoscb39DD4OM_9Z_aaw3aJf5dg&oe=6ABD3466"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2f94vJuspQQ7kNvwEMBFI7&_nc_oc=AdpPkMZ1b7dFzIOJUGxWEBv-_jiN8qFrC-uBSdxAGqmlq_VFfDWFXzauFkFNFQESsTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9MHHeu6K0tZNIjKo0x0f-gv6ZZPmIOyvOJRyIP8Iwtg&oe=6ABD378F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R4fgPSx5d4Q7kNvwGtUGCe&_nc_oc=Ado2P1vBlZiWjSApu85tPY9Gw5wZUsaGEJffkKZ6Cz-GNjY-ylxflazUMghCsfSjoj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-BOP5q5XHg22oYCnRRZBMz9hk9xgzkgRa_MyUb4Cayg&oe=6ABD0EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0TmyLBOMxwQ7kNvwHqM0sX&_nc_oc=Adqng6v8hzwxHX69eaclWIarMIvX-zPaR0p9Oknisr-TL3hzUkSu-upBPOO1kNnF-gs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTwwQMtaYlcmCWhCEiOXHIl21hEGt5u-X22W1rF9c7Kg&oe=6ABD36E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
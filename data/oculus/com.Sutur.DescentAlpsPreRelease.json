c_oc=AdpehNOpw8QXoADrHZDnh_6aTjkEhLjuzHiljb2x24eid_8HiJo0bd8IDq2Jx8FkgAU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wmfKsiQtwFJjMFFruhm62W3QeTTfuKM-ZOUDZZ-k4oA&oe=69D7A410"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij9mtEFVJ-wQ7kNvwGD2bvy&_nc_oc=AdoCcmKE8Zm-WUhCQOZf4MjY7q6k65fcRxfrIaxRAhkZI75gOKlkKVqmIPmXy61Azr8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kUvET4WQ56p1bsrQ2ho2KDEirpNUV6s9qk5xIvSmyhg&oe=69D79726"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyU9H4PrmRYQ7kNvwGAEw9R&_nc_oc=AdrcmUCi4ijFB6wSvFOGBqFJlo1kIOY7kxQQhfVSTIuGFwzmZG8JW4063sBmk1K_wvo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VGHt6DORxlyBCeyoSG5SyDP5hXzsNhv1fJmJkgSyuyg&oe=69D79A4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PflVtwhCl2AQ7kNvwEY1W2w&_nc_oc=AdrhxioS4I2FrE6fHPEpjeJpIukJJ1BRFNyRSX9TmaC1Sbcp6pGyUXdgHQUfvxbO6H0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hdWNBsR4Pjg5Dle4KaYTQPyBtuqvC97W1BTKqbIcjDg&oe=69D7A9EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK60shAq7cQQ7kNvwHgFyNE&_nc_oc=AdrzWM75iPsOj3iohiI2cSdF4ACwcpyBKw7DL_oTf-iwn_akUAGisrut_YBVsE_H5SQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BC8pGnnU_J0JYp4sEPBOpggtkb91gdvXlQlAVJpKMJA&oe=69D799A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
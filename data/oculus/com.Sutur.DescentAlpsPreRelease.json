c_oc=Adp7XCgDKsqWOBNtRz6W2eAiJgKvfR9-fxWgZNrBsbkY2cTXhbo7U2sdgqDJguyONhI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z-nn2y6XjmN3NPncNp9aGA5IggLiZfRniFcTczJaFzw&oe=6A16EC10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYu4uga1jZcQ7kNvwE-evbV&_nc_oc=AdrH-OKz6L8U0-WT8BVMVX6F69zPf0N8JcBHsaZGw_UCF2YxbzpRJ60sf60fCMEisrE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tR-CD0fZSJ0Ixiu3_Bvy0gjoeharWrlHgGQltxue3Bw&oe=6A16DF26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0GtNQ1f9_cQ7kNvwGKM0lR&_nc_oc=AdqroDLvznvqSxZo4D0i6zInjZa5MzVNxq6Nn1kYypp-MF0zaoCSYt4Mlmze_qQz-Dc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oiIAi3BHr7gRjJ914sJHQtrGI0NicmHvAlCS56hcD9g&oe=6A16E24F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj7y4zg788QQ7kNvwF_pxU-&_nc_oc=AdqT2pBDChX7kGd7SZvmBwyZ2HNTEsGvT8NsaOJqbeFcztk5zPAf01DK94-8JCz3t2c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-gPv92hIEIl2yA1to1lgZusEK28UjyBtY_EHDS_x9TA&oe=6A16F1EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMiH_VkqBtwQ7kNvwFZB7We&_nc_oc=AdrjZ7uU2R9lyNRy4AoZa8GoUQTzGl_yOvjrHIbdeavNycZR9RSQLob361oLA4V5Wt8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66hRakddjRunHXYBVRtuz6_D01tLNgf6W0ppOH_GI4fQ&oe=6A16E1A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
c_oc=AdrbAAzog0uIRgeyv-aSxqLizpDQzidQUGXLYNNtF7Y6bogQijwgVQcQJ9Mbvj2e_NQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2VqI37Gp1GyO_pAg13nYpc5Mva6O7DMsGYbNozD8v6w&oe=69C52F10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=922588mczOgQ7kNvwHgc7sy&_nc_oc=AdonaUUo09BTgO3jm9r2MPFxnQaJ5FSPfrMsnn_k-T59L_4EKW_xn8TMx4p9YQqKCGA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzB0xqaxpP0Q-HoMae2JHHbbx4R9b45TbPZ-SfiXyafJQ&oe=69C52226"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqMStU4s0hMQ7kNvwH7Yb6F&_nc_oc=Adot38UlG7IcVklXsvAui7Op-3y7Evn-cEdzf1UP6EPinbYxqtjJEMw-3GBIsYWOiUk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDcj5NlTAs_7LoiGEpiH5zmUvWxGY4l6K0EnEHKKhA7g&oe=69C5254F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyqG-zfZrPkQ7kNvwFXh5NA&_nc_oc=AdqVndn6gkMuHzUzqnQD7izVPGURTdADi5pi72yNPBLKKZq-5BeMjfow8TnAAmg5V6Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjXeL96gjx6UFPSYNJ9kfXhpSc8N0izwSda0CLpg77Sw&oe=69C534EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUKKd19OBg4Q7kNvwGlnv-e&_nc_oc=AdpgGBLEecU6p13ee2RUqzg5EjFa4eEfiCIDUBSnIHpaKcLoNVN5_0rEmz_Z5uZyGm8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8b8AYSSdh_sQafbAzadIA4dzF4tAhOi2kVkdxd1VVrw&oe=69C524A2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
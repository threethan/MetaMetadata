vwEJef0s&_nc_oc=Adq69OMQ1GLswWKc-1_l-KqDZk-LKY69lpPA7VH4wb1DF0-lPy7vINxpEFByzDhMPMQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsv9EPzcFx_L4It8kQSl_l7axowKbkvSiwWOgxneuqtA&oe=6A85AA10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6fW2RbLLD4Q7kNvwGse1Uz&_nc_oc=Ado4t_Xa1ohstpIHGiYCXXSsIN2Jj-WRbHGUboDX8HuoKAoffx7P8C2fO-6fDTMMf58&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIusr7FP9oVoYPs7n_20JdHRYjnCM9PF-yzkHiHj93Ag&oe=6A859D26"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDCE7YWQ9uwQ7kNvwEc7zPM&_nc_oc=AdqSq1lPlyTeeJDf6M6FKpWvrDLHuffVem73seGopT1E8EmpzmMBsn1zfz8UjUA-byY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESsQpYNx2372VRRKB2AkvBAYshhHYXgrUxrOxmX-aXBw&oe=6A85A04F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7Aizn_8jOIQ7kNvwFLK88Q&_nc_oc=Adq9-lz6YPOxQitcmz-wMioQheiwqDITmXkQgkvU6D_H2KUbGY5QIwSxnFi3_25DChI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTr-CBB3FLTGkmzUX-aE_z7tAtRLaj81r3clWbKK7e4g&oe=6A8577AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqbgv14W1BsQ7kNvwG-a9Ir&_nc_oc=Adr3PYtbslHUrb1i2ghqLqPLm2upV8jLWem7nGg8VOWS_FEFcEx6bqLS_Z8c6x-ktF4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRQKrxMbGw9qUxSpBT1uphYlohU1QJeYBaJHfakic-Yg&oe=6A859FA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recom
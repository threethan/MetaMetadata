c_oc=AdprIF3dcso9mojZgww1fad8PRdBQE-dOVzQyVvuYZ2je7vCqSdJG5NfBWtPJzkm8Pg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sp2FzvhpzSjvYlJZUHJztSiBR4VYUes8wlbzmXku5vQ&oe=6A2D5590"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKhMTBPZ40sQ7kNvwEH2m0F&_nc_oc=Adrf97h2elNOk2n6MPVJhOiBMIuBndnnKQyTpm6mGU8Cq70FZgDudbrFhCxqvk0kSDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tkE1KuKebABLFdxwAQwltOvXlOVQ8P-7St3NjgMJIOQ&oe=6A2D80E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dOiQ8nTGkwQ7kNvwFXXJlg&_nc_oc=AdrkhnCUdmvkHAsekaQiRzLgtaFscwZiiaJhREE62ULcGcLdDGuk2ztfsSOlwe22XxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jNg6CZdmxpGTpg6LLMKak3fS_IzCymw1cVXb7mlX4Zw&oe=6A2D4BCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cqoCIdiM1YQ7kNvwF5Ekp5&_nc_oc=AdqAQRVZ8p2OJVSfDp20QqMCfzQ5Kb3Lv-RD7ux2lsy3gZO9UVRbBdgvOcFEEgxiixg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vzEj8TC-TeTNCht8dmz1E2PlaiE3v__A98wWwx-BohA&oe=6A2D5B6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE9g4Eq2MbcQ7kNvwF4Brvo&_nc_oc=Adq0qBgxEXrUfivso9sitKARX1HcQJU7KaGonT5l6hnD8dGJ4dm6pocLu74OaZIje6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lUWrYwIDWW4qNiI47scdKrUaizYWLcfyprOSmKZ5RBQ&oe=6A2D4B22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
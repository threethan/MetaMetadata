E1Eq-M&_nc_oc=AdpBYTVknbPvjuWH5fmRdiA2NwdoZYdzuWtIQO9vXLAf-uOXuU5hXQw8lhcieC1uJ_4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_bPMagPMDpWSkGbG8lAUJe2HxH7o8QBtoH581PahxfQ&oe=6AA94290"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XptB1SSkoq0Q7kNvwF-J9hI&_nc_oc=AdpypoPEhuA6ESyFy9ezo9DaW0DHV_mcbrDVDxuF0J7Q1C54s1rDl0vZitBSGneKezE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjgIAy5GBT6vdZ2L9rW9sHkwVzeIcoJ5L3Jl4iYsM4cQ&oe=6AA935A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMW97fMw8SIQ7kNvwGH7vef&_nc_oc=AdpgAu_LJcGLGE0BqJkDxxSECuKX9OScbwZl07NaJJtOT6RPgnNJM0dAlCQ4Bqs3xmU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg9Nz87CV-XdEjGBal064PwxZRH2wWU0Mjtr29BfP7Fg&oe=6AA938CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_FbpVZlAFMQ7kNvwFbGcBP&_nc_oc=Adr_mEd6EZ4aNQ34GSOI05XO3iw4d3hF_AZjbZTAU5mMAFEdc_xB-CKHtl2bmJH9wJs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN44dW8szIph_44sZ_wp3AI0lCO_rF5tAmjQasp688Hw&oe=6AA9486A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8af2VwfkAJEQ7kNvwF-lu_8&_nc_oc=AdrWAScLT4-YCvdS8l5Fg6gxUNVSu3Fq59wJ2NVfpKyRH6Fpqv2itXq0xD1QC9WCcYY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv9BtuSYm8ADyARVQ5AR6FrVvYJPVqPl4HnZGBxsQ3jQ&oe=6AA93822"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
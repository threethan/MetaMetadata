c_oc=AdqWU_7fpQalMkQkXi4rwZGnjl9IlbqV4rHRnn-bj5zM2hupqw95r2qk8Y4h-8C06FI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqfjQ2BF_srnC3-LTZ2sY-c98MjoLy4YhBm6YTc02pjw&oe=6A523F90"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqF5g-w-iE0Q7kNvwFjvFTa&_nc_oc=AdoI8AkPY5YLeoC_cBppwz18bx9iv2PNFl6dV8A914WLQ9wEt9bCn05ajFXqdAiFJK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdTjeoQisTNkAVFjF6bQv-eGWwoClCsSsI2a0xQswJFw&oe=6A5232A6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5HHSc2cEAsQ7kNvwFZuamJ&_nc_oc=Ado4lmlukpfUfeHjIqWrNYAySSqpg67FDct-J_QKjEHxR_zknhcnfq6cfgaTOmKQwzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyPqOfS7PieZTbnRpYdADaSVDkyLKw6uJnCFCAElouRg&oe=6A5235CF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KwVQJ7DiYcQ7kNvwGid4iB&_nc_oc=AdqMSBk5ays2HZ4BgO5-P2oWnV105rXCI2MXxW8l-V0zq8Qutoa-CJCX-TAM0upmrIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmRatogbxqKENjvVBUZ1LQAMm3GOv3TL9r4I3ouWbF3w&oe=6A52456A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHhCcMU74hYQ7kNvwHdjm-o&_nc_oc=AdqmTIIgBqNQ4mBjdPhB0_maHh2D8jtmx9iRD20uW8FtRt1gIfaOKGQhTaIwM06yH5k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQYyiCn8HGmk6925vr654JIQ6kexJSOPTQWt3R1g7O8w&oe=6A523522"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
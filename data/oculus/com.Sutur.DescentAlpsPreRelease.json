FbmBfk&_nc_oc=Adq2r2yXJHhlJ02-o09x2x2QidKHrM19LBRgNT5J2iwStC5MoLKdtLqwMy52xcfQRpM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DDKdmngUNi-pMgyZ20UC4graXbUVpjEQvlEdxBopsLg&oe=6A11A610"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxaXKopA0fMQ7kNvwGdHL2A&_nc_oc=Ado9am37tAbIms1qCYyD0nWAznB8zmnhqVkq301bZZaW5IxjizCn7p_3JcAWRrjO0rY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kZl9XvNgpb7JCkVJqwYjHRyqbNfiUfgO7T0RhA69lJw&oe=6A119926"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biPAFv6DadQQ7kNvwHaphmK&_nc_oc=AdoLqydZduSol6_HBgU2-HvdvLGhWJ9-xSCzgbOOKCG-qdw19r4SIYv4QCHGyEOy4ho&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Iz0_WzxrGu8rozGSAsu0rry7wE2NEu_Dyo4Pqa12YDg&oe=6A119C4F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P2XA1AUotAQ7kNvwGZCx9s&_nc_oc=Adq8a_MOaj591fYxOEmaMy_rBWyLIoyOgwT7v5UH6Njv-38UBVXsjn9p8uFM8rGhjuQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cWEjNEW9xPPXz0Rl-K44DCxNL_IElPd9zcep-RXPYOA&oe=6A11ABEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhHGZ7B8fQAQ7kNvwGxDYyc&_nc_oc=AdpHt0KCjilwveTpFDOI8c6eUjcWf9jJS2CKWwIiGM8URzhd6u9ZMSbZ3S8HlMZPV2Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af674hp5qXpouptSCl0EYWu1XV_ZBNWcaXOXO822XeNx9A&oe=6A119BA2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
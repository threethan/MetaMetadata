c_oc=AdpUsZfskum3kr_fEgEX6TEHonFSXiEfcD-c4YGx_3Gce9dXiBTuVOWEqixFKBpsalk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkaHKt7BzNWk8EUJpZd6OqWd8SYbtMggD3412VSLLe4Q&oe=6ACBC1D0"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gqoX_xr9u0Q7kNvwHRHLQE&_nc_oc=AdqvMfuBApwyAmHiajodQIAjgLiD30zemaaoWI5H08_i1_QQ4byF1CfUv89ABl1hGjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKdH81mm1vYNf5jMi7tU1G6IyOaeAShsl7jyyhhf5AIQ&oe=6ACBB4E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhq9zp3BuYcQ7kNvwH3r3mt&_nc_oc=AdqZlYCg1I23m2PJng_DJglHhEoGtaMeBQ1yuF1S3Bm6fhVQI2LSEFcS01-aa9lYvEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKhlYJtv3EumnzintpEHsWdihOOmsKC3Q5epBvZIej7g&oe=6ACBB80F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHMX5DXZrHAQ7kNvwHakajB&_nc_oc=AdqZNc-bKuaq7Jny_GDtnxahlnc26Q-iIccuN5ZtntCK3zfwCNh__DNIgzo3PifuA88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd30JYVHfeGvVcj0zTlSE3wICvgAGOZkSQZHSX0PYNLA&oe=6ACB8F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnQmIfoEO9MQ7kNvwGKfIhW&_nc_oc=Ado5JbRkEMgRQ27dLrPxgfTx50IXBzmXsj8OrYjREof3C4NIlxcWXz4-0TByY6PQNzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUKUuEdWkRAhwT_4ajP1I-zfyDWPdg9k8ZgcDsC-uesg&oe=6ACBB762"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
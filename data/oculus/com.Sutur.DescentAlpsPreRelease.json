c_oc=AdraRdK67B5KzN20G_tRe6F0KI5DSqSbiPmEccl5NIeykY3syY68PZBLPoHEMOhifKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm7w6sregmU-J-a-gaxzTulzhI35OzUIsjmUE2IhrHdw&oe=6A772990"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRButdAiBuAQ7kNvwH30GSn&_nc_oc=Adr0cE6GyjqfWkhouv6k_uAH6KJRAzx5OMXDb_nHpo0feSl_x_1UssE8_9CtjPINLC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgzv-nJh892BjaFewZRT3gN6qAKvtdhkYJ7fbDMOWzPw&oe=6A771CA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bsco_knbUWcQ7kNvwEIj-Cy&_nc_oc=AdrEVCdpNAnEPp7jhuotosyAAyvGHWk-8SsX7Pm8BBXgqrFpSkhVoQc2F3GlX8teHME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHomgKIChq2_LsQGOvSr_E41zQzENTHS8GN3rfglITzmQ&oe=6A771FCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kuAw-mD09QQ7kNvwHtl1Eg&_nc_oc=AdrZrDJMj3CDiPSeKyHzP5Ak5KjdBMN2dz6zF-0LeOKBLDkonF67WlBGqy9izliTNeM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpYgXcHjgXFPtOmMGsOEo2d494xyYmQtgihEpxM51V9w&oe=6A772F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJC1rpw8y80Q7kNvwEhuzK2&_nc_oc=AdoMCfu-HKhx80bdFpIpOYOLFPI7yVmyux-XBH4_ABCWq-UFLl_NWZCsaYVLeUOvcdE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9lfyzK_OE4nLPO_BSZ2M8PB0nzpmYWRC8CCjBriU9tw&oe=6A771F22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
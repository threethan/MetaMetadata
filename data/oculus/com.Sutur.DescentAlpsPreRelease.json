GtzpVh&_nc_oc=AdoWq8e7CA3kVXzHaxLboahgx-qT1PoQNv2DrhnkNhQSyVrPZnfRXtAS63cV_WQq-c8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc_HQMkW5N6vnrGF36BAvCyQ6Toigt27fN0CeSOvQWkQ&oe=6AAE8890"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm9E8ug1Ax4Q7kNvwGgYxTp&_nc_oc=Adp466LHWn4Cgp4XP9yh9JHk1Je611beFZeol4ce1XEMQ1Ye6qO1KxRUeoCD4tQ39Is&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgERX1MqRt3rqb--7H4BInj617EfBtzJse1prvHstnVQ&oe=6AAEB3E6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1J0TlH-IqIQ7kNvwE6G3Xx&_nc_oc=AdqlyM7H76oxjNbM9QpGmS2aTVNWH60EuA_yRHPeWvI6DrTOKJvkqwUYjsreoBi5sbM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1CCqdf-L2OzyKxiom5Vmkoy32kOlOwlK7fPOoUtxh-A&oe=6AAE7ECF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ffjRDX8G1gQ7kNvwFcNyL2&_nc_oc=AdrXr5vh_QsFHC3l96xreUWPx3p0O8IfaUVxRrux687De4BXzUuyJpYCDcmllUOl_80&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0SwN5VAKcUbzQb6ekzX4mBXMShvVtsaCm0X-7SA_Utg&oe=6AAE8E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_rPCZ0CYHEQ7kNvwFNyb9B&_nc_oc=AdrMbAs_ovCRJq1QLy-XmjtQQmLUv4ktfXT2ercOS3e08VckasbXduiUGR4h-DCZldI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKigyZSIcOa1IMEwAUdjO02mEM12N5Vjv0qFp8AGW5ftQ&oe=6AAE7E22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
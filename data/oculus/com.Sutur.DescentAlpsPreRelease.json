com/v/t64.5771-25/75262745_415009943175531_261584921022526698_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHvceMT-9tkQ7kNvwEIdqEt&_nc_oc=Adpat17eZ-vGNBJjLHdjmR5qaIT5Ky4XYFburkZ8NNx6-VJVrFQW04t5-M-VaJB3n1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwLh2CRkeUojG3qX9xOdRowETwzlI2HECICFqHdNxX4g&oe=6B0304A3"}, {"file_name": "screenshot14.png", "id": "211776550563419", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75411997_211776553896752_8125568799413366561_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBAsq7aj8-4Q7kNvwE9EEHC&_nc_oc=AdqMWDrj2JSbvPWppCZkbNRgYRuM9qKzWU-hk-U_JhQgR4BN8eFBK4GYsFDXbU8ev_8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSyEXjGEp77mVoSYEj4Te93Z-gSN7_S-YrQ-ADeYZKSg&oe=6B032808"}, {"file_name": "screenshot20.png", "id": "525751175049591", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75439601_525751178382924_5902601660414911108_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfO6uzjCYhEQ7kNvwFGbmqs&_nc_oc=AdqrU_RT8Kgsvbyx4gUG88XBlqX1z3_4W6snn2DnQuBdy2lO44-CfrHBtKse18fbAPk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCgQJafWN4tjwPxUi5LXkx_w_u-qLZOJuVPDPm1McTFg&oe=6B03195A"}, {"file_name": "screenshot15.png", "id": "2503713219934619", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_2503713223267952_3960585105298242446_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldSInei05vwQ7kNvwEvzvKd&_nc_oc=AdpdA3ZtxWs6886CQB2fy32RMAOUnJYt6MYeI7qUUVkO2U8hCW4mhp0RIjDY9vl1VCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzxeqSrQ7nV-AfxaR-CMhWNeonIeoG3FQhYXFCt2xvmQ&oe=6B031C42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail16_9.png", "id": "1593588850835357", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254875_1593588854168690_2305263911116617904_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrR0fyqerckQ7kNvwF7msds&_nc_oc=AdpF1Hm9aIKxqEZyYuWA8lmvEAH44zhSRXlqatwovNMEPbZCRWlYf-Lb336FJarrrRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx1BYSd6ExQBJnc5FVy22CfWu4Wy_8jWBGIzB9JUQo_g&oe=6B031453"}, "display_name": "Descent Alps", "keywords": [], "long_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nThe path down the slope and challenges along the way are\ngenerated from music. Music-based randomization keeps the\nreplay value high and adds another layer for the skilled player to\nenjoy. Matching your motion to the rhythm of music not only\nfeels great, it makes you a better skier.\n\nThe layered mechanics make Descent Alps enjoyable and\ncomfortable for people new to VR as well as rewarding for the\ndedicated player.", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
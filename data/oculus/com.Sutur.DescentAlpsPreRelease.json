c_oc=AdrKqc60dCV1Lj-2kKwiLYMjAa7biTZAgP2BBvT1CT3YtcmWA0D04Q7DOLpeKRQE6-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM9k91SNV292knZm9UwtHfg90PjQuDSBDV_RV3Ba6rvw&oe=6ABFAC10"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNcwVRL99tgQ7kNvwGIzP7l&_nc_oc=AdqxRkc0-7e7Wekbi7X5ecGOQ4NNtfmaZ0dPhqj4DjLs-ajE1PesDcK7XMpq8yYVJC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCR5LhUVsKxqTrf4vnB-ncbnv2P4_3HDbyl7hHrpa_Ew&oe=6ABFD766"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gkpz1fZTM_UQ7kNvwHoGFyw&_nc_oc=AdoIHP6Q3Aw_OXGKyP-qS7JL0EisG68Y-XYC6bhccaKLKGWQYDIZPbh_FYFMf_dnCxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMliLIdcrA9iCU6h0f8m9h6Yv5Cf1ip7oN79uWGbimhyg&oe=6ABFDA8F"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MHEkA6pM48Q7kNvwF8GxK4&_nc_oc=AdoOLf71zeES7-uFBzYrgybwiL1rKc_EWOfbK9vKGJktoY1WXqyCg8OUD2Hp4_ldOWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlm9-r8fWRZu0UZC48LQnolXYCFCEeKwDSxDnY--jhRA&oe=6ABFB1EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss5h0wP3zGMQ7kNvwGJ-u-l&_nc_oc=AdrpwInB5I82l9WfFc4Y08pPe59-u7iV5uNk4SpTApfBWX0WhMpin_anATOw5WLyB7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlePDQmmDiwJh0N1Df7C9TUoluHysICuKV357Y5jThyA&oe=6ABFD9E2"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
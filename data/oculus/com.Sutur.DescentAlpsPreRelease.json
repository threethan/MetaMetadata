c_oc=AdozRuDgoqYkFnJDzyNASa8T6WXWHg3hl9IjljLg2l0nLxv9Cs_gtluzVDWsKKdFj-0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw69Zuucn2oQvBvpJFm1BFd4CV-0McYrjhJjMfm_kkqxg&oe=69CE6990"}, {"file_name": "screenshot4.png", "id": "303526101407572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_303526104740905_6443583858140849389_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVB2MRRrrrwQ7kNvwG-10Gu&_nc_oc=Adrxd_fkEZrALZzPykkkq6uCeTDUl06L_XPPmGDNJNyGAmsZHswfI1Ydmt8BAy8APE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz21iigflg4_WoaCa19hCrmaPi09uq_HP7vkX1ds6S7Mg&oe=69CE5CA6"}, {"file_name": "screenshot3.png", "id": "3923246851077043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_3923246857743709_4160032992077581009_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHkW-5HxJBgQ7kNvwHsufjC&_nc_oc=Adoj0YZ0xphrl-prw35h-qd2kBs8sl-nCrFprSxOeqU9o16jWJSbNhZO5h-LYIyFXcw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1BtgTWbRU01iFH6dZmrBj1bEMeE8jPMLbil2t8KWHrw&oe=69CE5FCF"}, {"file_name": "screenshot2.png", "id": "271926438003426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_271926441336759_8728748861262911714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xEi3w_WN7sQ7kNvwG2C4ac&_nc_oc=AdpSpS8va1AGPPv7ulDUQnNg0XnLY0Yy_ye7zfmddOwZ322StX6Jg6l_Ylmd-z_PfoA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlC1QBI2qoyzzDrk4jOSnD9_COttHC3TuiQANYpXZ1dA&oe=69CE6F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launchTrailerLogo.png", "id": "6074050192620032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031653_6074050199286698_2652278825252298082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeZDimP0n28Q7kNvwH-oXWQ&_nc_oc=AdpNzWUYCwFkTSfxht3nZ-S5_EyjoB3UsDQT8FmtxBtdFUZGoi4gUdCgmNhsuj2RUAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhaBFlbBHQV47uOWSptHL61JjTfCmkX24eOoCHG117Ag&oe=69CE5F22"}, "display_name": "Descent Alps - Demo", "keywords": [], "long_description": "In Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nDescent Alps have been available for one year in various pre-release versions. The game has been downloaded close to 100k times and the slopes have been worn down by pre-release skiers. All feedback and knowledge gathered during the first year of Descent Alps have evolved the game into its first full release. The core remains the same, but the experience has been refined and is now faster, better, bigger, and easier accessible!\n\nNote: This is the DEMO version of Descent Alps. The full game is available on App Lab.\n", "short_description": "Looking down the slopes of a steep mountain with a pair of skies\nstrapped to your feet is exhilarating. You will learn to overcome even\nthe most challenging of descents and emerge a daring skier.\n\nIn Descent Alps, skiing is controlled by moving the whole body.\nYou shift your body weight and lean into the curve. You hunch\ndown to carve the skies and make quick turns.\n\nMusic-based randomization keeps the replay value high and adds another layer for the skilled player to enjoy."}]}, "developer_name": "Sutur", "developer_privacy_policy_url": "https://www.sutur.io/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Things3D", "support_website_url": null, "website_url": "https://www.sutur.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
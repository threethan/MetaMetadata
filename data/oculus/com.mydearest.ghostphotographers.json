3_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbzBPzKiH7cQ7kNvwHQ7FVW&_nc_oc=AdphllGcNo1G-XsCDQ5KbYjperCwN6IDByPqQhasoIZznXMNN0EPoAgvWv5e3VXM0DE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyI3zSUAUi5atsorX3HxjP4Ey8s86xCRgEaRCxgUW32Q&oe=6A5F7547"}, "display_name": "Ghost Photographers", "keywords": ["Horror", "Bazooka"], "long_description": "Ghost Photographers is a multiplayer horror game where you must escape while fleeing from terrifying enemies. Use voice chat and communicate with your friends to make it out of this despair-filled nine-story building!\n\nPeer through the screen of your smartphone camera, and you\u2019ll see things invisible to the naked eye. Invite your friends, enjoy a variety of eerie sights, solve puzzles, and ride the elevators from floor to floor as you aim for the ninth floor.\n\nIf you sense something nearby...\nWill you call for help from your friends? Run for your life? Or hold your breath and hide?\nThere\u2019s only one thing you can do: pray to God.", "short_description": "Ghost Photographers is a multiplayer horror game where you must escape while fleeing from terrifying enemies. Use voice chat and communicate with your friends to make it out of this despair-filled nine-story building!"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/products/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
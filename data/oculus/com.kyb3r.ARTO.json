_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2aG0-uCAmoQ7kNvwE6UR69&_nc_oc=AdlF_NRV6PxZtFVCC01ZWSyIS6Moe0NgtiQUdlUdBFYsnA2k0SiP4iiwL-xnZXF1_hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrALRMuWGpDthOYl0l7GVA6m4AToRDYH_FHRD2C_S9ag&oe=69A6DDBC"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xga8QoFkHT4Q7kNvwHdR_XW&_nc_oc=AdlBauPTGAyZmO4ycrN25J-ke8eMzEQZSr0fA1lYb241iTjpRnlWl_CrEvYc58i9foY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyT21N0mp9ihHwLnG0ZKE-WZQEMiSuv4SA0poLDqnIww&oe=69A6E573"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DibDlGtj6coQ7kNvwF1RdRi&_nc_oc=AdmjLEGlItEdvk2P0FOq55taNlifb5odvNZ0tePB1wDM1lmmCwLJXKnCJNHg5tVNqMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6H4eqLMlYzE25YOteHzGJflLwsjpwcS-DRkBm-4DEzQ&oe=69A6E5EB"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZvQqVZlV8YQ7kNvwEogmzL&_nc_oc=AdlBi-iSc65SEjiFbWnU2ZsVm_wI2rKAPjxTMYp8QXFeEhQ0F8PoAbhE1gzqFOsw9x4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvlUnrZHJrlL6v07XD6Uf2oGE3infHPNCr6t61q4iW04Q&oe=69A6E1C1"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_IezBkifVMQ7kNvwFdX2Qk&_nc_oc=AdmdGxKAzsLspMccdHqzdSF20aeggby4zZFuQj5ejGrqevGEyODFMUV_Fr_RAI-8160&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvWPVm3C4iyQnCQkpKoddHJdaFllsm3JXqY-pqS2hshEA&oe=69A6C6E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgCiMbR8qn8Q7kNvwGK-aRW&_nc_oc=AdnCGAMx8tKgfJw6Q_cNhcwC6SHJM6wMpDaQUDBooc7NQYdmx2b_iVVCqLXN1kOJmhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuodftIpoj-pXKtyRyyaPsYi69VJGw2h-Wr6bHcsw6Cxg&oe=69A6DFC3"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
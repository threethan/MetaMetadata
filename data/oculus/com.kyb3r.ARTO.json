_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztOnKCUpjVYQ7kNvwEhPXuT&_nc_oc=Adno7H1Rw-pEiLPag0FYv261GklVCuhJGKghop4it-MF46haB1JEU3li3LdDBBJKCBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuz38SRZFvAo9zA0COxnKTzwpr3trq2yjSxpcdWzWDUMA&oe=69985D3C"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLPpzT85ptMQ7kNvwEcwmlF&_nc_oc=AdmyM_J0LYyh5NixtALBdbTykkqYHcSEFzfjW-aB4iJFq1meI7TOdVetMMhN2UCgcTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuZ7T9TNdxF1D6BSss02gqQ7Rc-uKFlfU-xksJxx8TEXQ&oe=699864F3"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibGIdHzerjoQ7kNvwFQ4gHf&_nc_oc=AdnHF_gg8uWhJnxvwXHkLF3ltR5RG6qfA-6EbXQ-rUYKVPtSTZc934hJ7vbi1hQ8iHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv9efaQfd5HO2DygjEZi0fvq1UYVkZhWBcWROf6QOE4WQ&oe=6998656B"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYeh_G04Y_wQ7kNvwG5yPwK&_nc_oc=AdlFFyTAXg2L2mwe2BR7sJqm0vNU-GuTkX3euOPFpQPkTO0DZWdAxmX_UC81BDha7HA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afugju1WLKYWNIkGtX8pHAuELQQcSGjYCy1ACUVU3SJHoQ&oe=69986141"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyRfNwqLzfEQ7kNvwGOWOvy&_nc_oc=Admhlxnb4NWsdLLZlJKNLRohrezbJ1s7o8Qe273FRnb6iruYHIaKRlBcp66R5FLiVnQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs7B6sA_zmCElWYIM49Ro4cttpXIE8W7X61FBFoRHUaHw&oe=69984660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZrVf-pZKf8Q7kNvwEXc3L-&_nc_oc=Adnkbb9OXfEVSjx3AUgPzOO6eQGp8vODkuddav_fpr4Rr6_jld3aLjHgNDdk6GaxJ-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuejYSsXmF2pPvRzd0tfPg82oatRowkDJExyuUffS-EmQ&oe=69985F43"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
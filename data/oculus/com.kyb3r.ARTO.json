_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiBxfgbIcOgQ7kNvwGhtY3J&_nc_oc=Adm8SkWhGMMStRARVVw_PA6dNy8mTnN3T5R5zuhcKmsEsfhcdmVTV9opbUka_irXy5s&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs9So1dFaYSRTg6y3dNmWzbl65y3eoEOI6WhRVyMQTdYA&oe=69A197BC"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TJw5yTXjSkQ7kNvwGhip8s&_nc_oc=AdmqXpWLz9KZe68Alu3u8UOT2GAd6bTZaWop1mJqs2_eru82fqrQQEN9Ouw-hA4P9y4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftUxU7hv7FO1eASs7MB03aPu0Xej5AmVCm_iT0FlBouSw&oe=69A19F73"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-KoanBaFL8Q7kNvwEFMTFB&_nc_oc=AdluRtnkYelsfQgKhrFDCUlK_92im8rV_tguLDGbaxBWZNEhE9-jLXROnrPx6W6k7vY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvREWUmU9ka4j20tT_AW-tDpvE3rBJwY2D5_sePjlfV-w&oe=69A19FEB"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4gkGiblrIUQ7kNvwEurnZD&_nc_oc=AdmegmEGcaFRz_03sswEQMOWSsOJNrTZzjVvQKjrT0yd5oFYbJ_kysUxytsxc3GfR9I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsWLtGcCeIr95qNsO7HZuX21WPCxlAUxVKDME6qt8eZtg&oe=69A19BC1"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM5KW4En_GkQ7kNvwGR4FOz&_nc_oc=AdmXjUyAgJ6onH8YP347DgqzjaaAUFjRaguP17O3pR3FGWRKW-TUAGIvQuGWQayY1EU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfukgAGdPHnMm3Wwt590HGLR3TJauymauX6ALpFKfz8OWw&oe=69A180E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUaA7iatLx0Q7kNvwHKou99&_nc_oc=AdlaQWcnx8zyCyhNlj1aWha1DGcZb6RBUsBEs24LXK4l_M_fV3aUHSL9Iq3OYTfhUVc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afso7vN7TzogN978QojdzcjKyVJZCqGp94HOYjDhddYPlQ&oe=69A199C3"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
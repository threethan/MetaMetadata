e_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG098nZSc5wQ7kNvwGMXXyL&_nc_oc=AdpZD-dSEGJOT_5ofTTQo9oytHQaAgbhdTArGY_1mlJYbFDta-DiOwBOMagP16doqVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqswFPSJ9W4IFnzQz5CLFCR1BgpfGvQ5JkD9dfL93uyg&oe=6B01D481"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFA2Grf7Oo8Q7kNvwEKrdqc&_nc_oc=AdpnDBtbDLxFlHAC4C1kl3Vloahel_zfB2fCjMXqtfXXi27h28zQ1_JatuCRXNKkHVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwg-UbODo1tBdZtSeZTy2vo2r2pzusg-LW3qzk8KokwA&oe=6B01B9A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myw2V_HVckQQ7kNvwGyZFZ5&_nc_oc=AdqJOHXykLd_rcWIIrpcumt6jGo38nPEm5xt6MZt3p3A_hFmmO3K7UFvI9Q-tcYmZu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVED0HLC1M4816OXOQrsNvRlM-gOiBFFA4uq-Mics8Pg&oe=6B01D283"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1177398046477776"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id": "1355043166618082"}, {"status": "CANCELLED", "id": "27767424449586954"}, {"status": "CANCELLED", "id": "2079775859644002"}, {"status": "CANCELLED", "id": "1765255287983784"}, {"status": "CANCELLED", "id": "1727701181708594"}, {"status": "CANCELLED", "id": "1695599324887049"}, {"status": "CANCELLED", "id": "1667771357819395"}, {"status": "CANCELLED", "id": 
86533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUFNs69BqPQQ7kNvwG3NzVG&_nc_oc=AdpYvd-tuJMVeEHSKdrzULOkHsC9c1WdtiFmg6kJcdl2hG2NbUqazPUofdoGhFol6Hw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW1cJxQqD-MdLtzR48tF4NQHmjCUAwvVEvVvBte2bjiQ&oe=6A81AA82"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEn2JeLLG5EQ7kNvwECSu_o&_nc_oc=Adot6g8JXKKK8BU9cnB-cAe8OtOv6_9ht0wVcJ6pg5KF2a3PsnSpjfAcI70l53hJpqs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7nzMjzqpwJISjfwiirSmzgYRw2gdgF-7u_0F-t8ePfg&oe=6A81BA82"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayPsCzFL8zMQ7kNvwGqQJv-&_nc_oc=AdoXVOJsELa5H0fJu1rz7QtwZvOpWDf3bAVtepfNS2MM6wLGSBhc-lcR_2LoET4BfSY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkSWKomqYpEf5FiX3upyPe77vmFvz1ZGA5YhUBtt7g8A&oe=6A81BEAB"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYASf1QRWooQ7kNvwG4zm-N&_nc_oc=AdqjLRxeKSTQ0b0py6xzx0UDR9p4w5m93BU2N8Iga7WaVaoHV4BjXriy8v42KyA_UJA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzlUbDG8XpPZUWu7yU98m3L8EeqqC7qfpngM71B05MqA&oe=6A81A807"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz9qx38OmrAQ7kNvwEKGQ-d&_nc_oc=AdrmaH3Lz2snbiMz1R4cKqCzONhS1x2kvjsfT4qUxN6BqNkcOcCQap7_PeBuPCwc1Cs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHDga7MI5L0wDQoF-oMegBqZiO_nZYQjhcEHS0b89e9g&oe=6A819568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUR1ZekVsHAQ7kNvwG9PZ40&_nc_oc=Adpu01IEAy09gng3YHSoLh3DYuS-kdFJFKJobW0VaCX3Ed0NHbpgbqzEL3dK6OIbYm8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaAUSgBcN8dpO9sXCtrqtY-CBzjcV465MWh6zuK0an4A&oe=6A81B03C"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZygQcnjxhsQ7kNvwEsa1TW&_nc_oc=AdqO0JvXRoxdS0PIgoZhNQBNtj1GYeL94PNPQzJKtpJjDfvhQy4MDh2N8j7GMpMf1o0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET43pTf3v3Z3ZDRWPBtIcCGwfMqJkpWUpMqaILQvQsMA&oe=6A819F87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTO", "platform": 
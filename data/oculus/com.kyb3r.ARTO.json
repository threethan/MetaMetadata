86533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUagjZEruTIQ7kNvwGhK9XD&_nc_oc=Adqm69ydxh4ikgH1zxd6rJ62riBIdYMoyQyFr2R68pA-xbYiHsoXt7Ai5nbEGMMJ9Hk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO0h9TumrsHLfVg1NRKkRbkSPKU_3M2BgQpiLr_EycDw&oe=6ABBE4C2"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa9Tg1WZKrIQ7kNvwEg7BwR&_nc_oc=AdpNiz6QhnzIUAZ7pHEBKyzM76idsKTjl7EPcga1ZGYyX1XlpvySUrDeAex4SEPAXX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKohYQF6feM9VkySMHMPnlpjGbOaBXDOUHPnfi6CnVKgA&oe=6ABBBC82"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKzjzE7GqQQQ7kNvwEzPaeT&_nc_oc=Adq3bec7KiYTDbKXhi8sAsfrSOozQ4UaqgPuMU9vnwDMdoIVMnIF2qVL-CTYy1YPFPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJikdq-LWCgtVdW1269wXTi_075VaA-mlsPobfuetEK_A&oe=6ABBC0AB"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVcFiAQLKQUQ7kNvwFkWa_k&_nc_oc=AdryN1yyqqkGUOhPRJRXJM7GXJ6qLlPB8HHw46mzLot2A6JTo7rpYK1Tha3oev1-vf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIny-UrARGrQUNG9Rnv2MDVa3lt2EioLOHkGXGqbYdIg&oe=6ABBE247"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOGutmqJLBwQ7kNvwGC5t63&_nc_oc=Adp79X2b7MK7mxXpvMi1DdOEcK9Kmzi827dS5BQM9btU_vycHgQ0sOf6bvzniS3RU0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjRhfcNV_SKV1kYoOTCCNPGr84VT_6JigQwZwa-W_CjQ&oe=6ABBCFA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JCLMHpTN3gQ7kNvwGRvMXl&_nc_oc=Adr9bzmMCNOAqsmP4NMqLH_zlu-swL4ttxtou3VQcPYllzZIKrUGWu_mwvasmOCiwPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0OJqfZSrmBxB7ovyH8xpk_R3-0HG3IlGK-IhRKcI8XA&oe=6ABBB23C"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgXR0arZRPMQ7kNvwEAaSy8&_nc_oc=Adpwyz6MosYT9pynePUnG0XxDviTcJFCHRJtlUl3yDGtXSfnrzt74HB6OTpk7GB0j_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcWaVL-3-GDtOpT0_TKWuKo5eoVSLikRstDxpJZq8SLQ&oe=6ABBD9C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTO", "platform": 
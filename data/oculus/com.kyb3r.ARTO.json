97_8661288463946194_2389593190841913167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPa1bHisPp8Q7kNvwFIujzS&_nc_oc=AdrUlmozYUm0vwzgv-C0d4WKjEwaJh_MJi4NLBVu_YPqwNEG9q9YB8ox2pY194gfMFE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2mW-Miu6KM-843lhSnaU-PMrjPt_br0kxLz4PmQ3Cj7g&oe=69F2033C"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5myfXLRdFk0Q7kNvwHYslJP&_nc_oc=AdqOHgo5_uohg0qOutdejdDq6VR0toU6VPqSHxQ6TeXv-FBg5-8OLpktyMBCrkHZrQQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ySkDb6GYy95sw_BwXefCFXxywRfpdpXjcPwUeZod7dw&oe=69F20AF3"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHbUOIjONdIQ7kNvwH9oW2a&_nc_oc=AdpG2frcD7IUzbbR6VVd154jwxG4bwSnV2H_AlPTUJBV_7CRF9fvpD7teh8LV_qcvXM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1rJO3mac_P_2E5cqd3YTpKkBKdC82nx661bM773qw0wg&oe=69F20B6B"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2Bkq6nUW2IQ7kNvwEQSvIA&_nc_oc=AdrBFjiv65hQDhIJG5z3tOKk9ajhMoljXswC9fex9LJfL-WSS_oyPafUY5BRNwe7w5M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3ci2Oa4o6RTTcR3XmyH1X4_IMHiBeCz2o-IwldzHfjlQ&oe=69F20741"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdE9CcePSR8Q7kNvwF9sI7D&_nc_oc=AdpGQKtwRIdlPk7O88Q06lwMpgtRdcH7qMCNabbTH3puIhkKvnoD-rQejzhFW2PPoOs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0Vxawixjv4JRzx-9BUYgo0jqsuOrhL41TgP0GyTm9q4w&oe=69F1EC60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G595fvk0W8Q7kNvwFM9dLD&_nc_oc=AdrEVdJmwhwdJ91HBGBkwTFPpk2W2SDVviGfAOZFFc6n-SEzQ4ykg079p_n6A2q-9zg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EGKpREPznehpEYbmtpBvPUL1Zf__V6qxF-YdlJn0RmA&oe=69F20543"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED"
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiBxfgbIcOgQ7kNvwHNpMlw&_nc_oc=Adl6Pej71xBjksS5ZdpRJtIcnDNdvhp_iNG0FhkPcvaVfeU0rbnHW4RLhXk7XqtumQU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuL4E6Mf_DTUtw75ND4EFkNYoWrzCpqjAZfT7oUMSsPkQ&oe=69A43ABC"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TJw5yTXjSkQ7kNvwFdiVbw&_nc_oc=Adk1DRgvsIlR72wW6rcj9RykNrglYM58y5RV16j2ImqQud3lnwDOWauP-h0Rwo63bh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvmlJSyImyFRgNfcWI3Fas4KobQ8avGQMotjcmyp3eUGQ&oe=69A44273"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-KoanBaFL8Q7kNvwEA5nB5&_nc_oc=AdmEd-KLnV1d_BMB01R1zsQCJQgOG_DcOIZNDKqq1TRCM38ZAGnZLjY7i8uSB2vMk-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftbXvcdqiB3U3w7WzCU0on6c8w7q8xF_tkjqYbvqNi05g&oe=69A442EB"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbctH7EsXY4Q7kNvwH9cSxQ&_nc_oc=AdkFqhOMjM8gwTeKx43NG4TCTbdIjHjJXRbUZk8qUyT_AqnSYwxblFt1Q8mR5dopaR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvo0Eyc1CQ6p1pToJUlrLsf9Twjel-yZNQoZubbmK3MEw&oe=69A43EC1"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM5KW4En_GkQ7kNvwF7cLYI&_nc_oc=AdnABDWmgDlLmN4F-62uQtax2i1_km0PMmskQ3QW3qfUEzDGDEWm-3klVqK0RM-5-00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu6B7zkaf4jP7zBwPA1oau0rpyW7cAOj7Hl6c8sZy4asA&oe=69A423E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUaA7iatLx0Q7kNvwFh3D3_&_nc_oc=AdkaTE1PBfDfOQxWiCaUJkT29u4-vRwGGbL8hEEXYpAaOHjLjBg4zIxqvI2pkj1FTtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsbhd22KsW2HEDKmXxVJ258bzNTGw4Jzbfrv33J2tYSjw&oe=69A43CC3"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
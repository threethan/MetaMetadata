40161786533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3uVxSdFnfAQ7kNvwELO6dB&_nc_oc=AdrsZMdsbbodizPbjkznUI3_MXCgrKFlVMWsRZ2PqOwDsNyV6HZVpUqR1edsGWc_K4M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJClI5tABqE4xEW4boZL-cIIo-QXNC9RF-IPVlx_1X_wA&oe=6AA3F182"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lspYc-pE3LUQ7kNvwE9quUb&_nc_oc=Adpxg3APqAV1Y7odyCUDa8elrHiS8JWfRtOOzK4BIPkoK89KV6R8s-O4es49vPp97ic&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2mCLeS-oE1S2W1rSjVELje0gRPjB9qqNtzuo9eMD2OQ&oe=6AA40182"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVa0mS_eeBYQ7kNvwHin3zl&_nc_oc=AdpUWIJZBFzp4fdjSp6bNF4xGUWzlGU5udi00_wefnz5csWfxYYzO5IZMem07n20wUw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi5oTdtsqq4-QSq8fWBjp-NCoO3t9bqIny0zbnqKrEuA&oe=6AA405AB"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8CcKtVuoCkQ7kNvwFG2DM7&_nc_oc=AdrH-jM4ZP9UCwZWUionpyeaVyCw93-mPoUnfzVRLOSq-fXZDaNPM6IE6fgPvDRACq4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiFOgJc03J3egIofYdv7mso3y_lLGivPNMKk02mIyvkQ&oe=6AA3EF07"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8Vo0IRJQHUQ7kNvwGPePke&_nc_oc=AdqjBdTEJseKKWKh7w8ZXQ7XbBOLUeSA58Bs0XayqegTAKYW5RWg7RitQ4iQrYD6LDM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuWaWMaOmZ1ITQXJq1tDx7xYPUL2CfLiJaDeIz_IU2Kg&oe=6AA414A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1dnCvhJLCoQ7kNvwHNAExG&_nc_oc=AdozolIauxu7oz9sAjf1KPnTnLJknvkpYchom5JJfJf8Xm5-5FKbeZ1T7dPO66nA7fM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLAci68YgOPW1VYtsZm8ccmhYaUb3-_1zq4xkT9xkpHw&oe=6AA3F73C"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwMUC03uEO4Q7kNvwFLpy-V&_nc_oc=AdoXr2mhR775815Lfqo1RECyQ7lgPR2g7lfij1D02qVtZw-ZsH28crAqnX3pBmpBLwQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLutwjst8_wdY6uesTTvjNNKop6JxJ0xfSaSyVoABQh8A&oe=6AA41EC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTO"
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPa1bHisPp8Q7kNvwE7WaTN&_nc_oc=AdoCBYSGLMGPr7yvhA_52y_HD6F3GzIUIq5VYxHk5V4ctbrOw2PEUE8-8HIdMiV_qr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af22KRuIi2PTRaoh-D-EhR9NP13tVGPlcnxEHaxSIkOJ9Q&oe=69F0B1BC"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5myfXLRdFk0Q7kNvwGivs-2&_nc_oc=AdosnYe1Vv_phh0-a3k_JxVtF90ae8oJa__FRvIWDtOwRPOORE8m2p4fmbD_ctfl6ZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1HFICezOdHnDncARhtLG5uGVUUgIvvfxRpZtoAkSozYg&oe=69F0B973"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHbUOIjONdIQ7kNvwH9y14R&_nc_oc=AdrIR_YfWJoiMHI5Bv4in0SCrp8DPTWGnXR0zibWwnrDtJeaNaARPi0YjKX-Bo26XJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0ptPURJxpfWwiw7ToNgJUrT2vkf962cOG-oYJ75Ybzxw&oe=69F0B9EB"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4To3YQYpF9sQ7kNvwETciVN&_nc_oc=Adp_QnxmtrIn4-2IGQUzYuIcub770bauV83CtFaZEuPo9JJ7NZQ80vwBw8WtZlVbDU0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af25WAUlJzKW_9306Mb2wCH0FdUn_VT0f1UnbF90W2DYeA&oe=69F0B5C1"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdE9CcePSR8Q7kNvwH4BM1y&_nc_oc=AdqEKvkmaTCyoU2vHeaUehUfNj0nvPDogQ8LfKClQeMmQjqMxCIbJFV_yg92p6BsDUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0yNyYAHllHk89hVF1X81jYuzzr8HjmGDz87FSsJdna5Q&oe=69F0D320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G595fvk0W8Q7kNvwF5z1cK&_nc_oc=AdpqOorBjmxgZX5bLEyP2btoXHt-BBM9Sb2tnZORhnq1REEQFE6s-1yHEaSn15Cq8bU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2DDarp8GVSrKg3f1BxDZkPlLMqHdQ8fRPlSvbgcJIA-g&oe=69F0B3C3"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
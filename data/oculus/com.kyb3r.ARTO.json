ri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982497_8661288463946194_2389593190841913167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnQlLF_e91gQ7kNvwE51gIy&_nc_oc=Adq9O6H2I16zHWWvhUdriuPF1st7n6_9Wj60kpIGVG_hhrwvRBIx24ykP9eBDCgtxCQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmPmjhtRxZVn6fYChYelcl9AcP3B0k_KmaZg9P3qKzDw&oe=6A66073C"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUpx3eGezikQ7kNvwGyD9gq&_nc_oc=AdrDu4IWvukab1yal-VvVsnm-QgrnmUiWO7LHT_UKifeaf9ak-0-foT2CFCZJPEhrIo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJGWkNyuhrBzRGRolzxzXVqXP7W7l49FbaBZnqmBoVLg&oe=6A660EF3"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEcljZNLqVEQ7kNvwFipuz6&_nc_oc=Adqx-bupc-qheggyTJ1MpmTNm9eA78fznwP0fD8B6-vGTOk-Gw0_4ndfsm4T_nxASEs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-s8kqlrbxWzO8HjkAdGY7xWsqPnheuX0O4JiYJCpGmg&oe=6A660F6B"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhIrBUMcXiUQ7kNvwE07RQE&_nc_oc=AdpgNBCccMA5_OJxGsPMNBxE_Rh3p0ubdNtm73SLQlL9n2V-klnn0knhfbiHv-WR6VQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8uLfdxMZOK44Ep1atLIjwIbei_f6BnWhORcTnpH5Hbg&oe=6A660B41"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcKIEVfSpH8Q7kNvwFitIwo&_nc_oc=Adr3An9oEC6WMoGZ6b0-MFm_ldaKO2dblg9CpJWEKOV_iz8QkNF-zd1g7144uzxXoic&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAstFR8IApp4BfhXD0Oawqiy575FrxPFvUdG8eKe-nsVg&oe=6A65F060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuKIytonMPsQ7kNvwEUjtUc&_nc_oc=Adp6lcrIrmx1XuT_MbB4N5FRF4fs8im5zFgwNucy983rWxSdjbY-Qrb-tH0_RzOWgOY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVsk0MwK_BBp5QzjLmL80vd8_5-3ir41iYC9ePw2FkkA&oe=6A660943"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https:/
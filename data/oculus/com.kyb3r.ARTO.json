40161786533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg9ZsQffdMgQ7kNvwHqIiU5&_nc_oc=AdoYio6HzJVKCpwDPh1QohV4JzNv2l2dV57v5U9Bkl5SY2RsCRIV5sdwCP5W52DhcXI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx8y08xdrTuCyFgSEM-x7A916SwbxcqYGXHoQv7O_kDQ&oe=6AAE7D82"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-etcaYRsfsQ7kNvwGSQ71P&_nc_oc=Adpd6p6iCtusuqUvb6W1ixMUrJM_zbyIbAKGjEL2yLn8CETkMJfxVFwRx0eBoFXMfqU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB6SIzAvPCJ37hBI5C_jg5q2E_oeH8Z8JNvrZ1_VpLKQ&oe=6AAE8D82"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MILqdosvioQQ7kNvwEvshIq&_nc_oc=AdqYAlmTO3VoyYp-qHdF8UcpBb1PoQ_APXAgYWt01CsqX2X5yUX2NRoBqNfcrwhys7A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7AQgJqEeaGdH-s1zuxHRti_3aNiSNL_QCWI34PKHFrw&oe=6AAE91AB"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSMtOMypqikQ7kNvwGVHXdV&_nc_oc=AdrG-000q5NtXS0kpZzit4IBOqT8NB45-W-WCqgYfPuNxgyNjtXHVZOlvDGrWFSt5wE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId9uxeXNuS8NvkyFBmmgHLLeGfpgySqldgcZH7T5eGKA&oe=6AAEB347"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rH1yCsNHZ0Q7kNvwHyINcC&_nc_oc=Adp0dcmra7dPwNCl9b-bUJg9XBv3gMjXA9ibRdaPpKsBTa1OMoMvZDUYRE18qZpd7zQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ9gr0VeuHndWxeOAcSCyZAzNZOjFV2yX_nJf3_0DgbA&oe=6AAEA0A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKhq6LSg7FgQ7kNvwGUgX1o&_nc_oc=AdqhaXim455dlLQdt3ftyoS0Y8kp0Q9BrpoHsdqkga0wNprBfMl7iPcK48xHrIvEgEE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeANgoGr0tmC_UfG3ffn2iyfHR46L7es4KZLury2tNZA&oe=6AAE833C"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwsREkeuSBMQ7kNvwHY59Xk&_nc_oc=AdqkEEsI11T4C7ewvTkx5BFrAfOSopUr4jzzjsx-cqijsTY1IHUFdP8nJp1CH6QXj3I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3mwEZvlB0ti3FIo1l8nX23Z_2WK5Qp7-NaR7AqWf2mA&oe=6AAEAAC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTO"
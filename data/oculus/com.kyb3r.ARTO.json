_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MnjM8jyBQwQ7kNvwFFT6Tq&_nc_oc=AdmCwSY6_BYIr8wiU1TOdGq4CpmMEraPAhXNnMuXWq_y7y0wT6NlY0_8Af1hNirrgOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBnVEYtqkIPdbswCkhj8QREt12Yxk08WV83QWg7O-vJg&oe=699DA33C"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4sHKKGcDX8Q7kNvwE1iQ7r&_nc_oc=AdklKh8V2L8f09sCpLfbhN69ERukkZDbKOVuGt3r8lFwlyMkZ3MG1qzJokVSUPWjJlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMxYGxuM8VFtUPxBr-x3MiSOG-iql8HV0D2Sa0HwRGKw&oe=699DAAF3"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unsj_DINdCUQ7kNvwHbKypz&_nc_oc=AdnKBcieEyGbDMudhqQESswdgV03kUgAEkwBxwzacl_AS54jZyFJdGbQ5RFdzbcE5-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_52RDemRtK7avVtAJdrbaUFIGe-7uWd4PFhXV3WOmLQ&oe=699DAB6B"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRAUGzZABe0Q7kNvwEY622I&_nc_oc=Adk_UXTVfZv37R_8pszH8b7HPJHUiMCKiOnkZ1ZvXM9eHks0aQIBBoBn-no5Ab5djyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBDr-Wy0oMHxOTd1uJtFsLetMGmAijBTfZoHJoucIGug&oe=699DA741"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yTeRMhxxHgQ7kNvwEUIl7H&_nc_oc=AdlNiP-h6nXq2ZWcaTufpuyLLUDL8OaW_wp2zsql0-7EIaCNdSMurbjuSIAwm9xwYOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuNoUmi3lJxlE-Qjcc1mkGNtTyTEhNwLx9g3kyBhoKVjQ&oe=699D8C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2en35cTohUQ7kNvwEg6iMT&_nc_oc=Adl3N4pTwTEdplj2mkHRyG0fZEQK2vnsyQKv2sdQq3naIofSK68mpQzjxsALGGLmHiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftUbZU-ymPeKhQSW9fmhf_mIqHqzhVAPEll8h2Ki5l1BA&oe=699DA543"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
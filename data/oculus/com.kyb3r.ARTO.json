5&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdWnNP6Rb6sQ7kNvwF6ySVn&_nc_oc=AdqiwoonPgZUaxuHuu-gjzgz1wxpDVboqyd4ShXCXldu5jJrGGucCafAJsJc0KUq2E0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx8wHhuK7tgCVVFAb7yhyB1zpuroZZcW3Th5M0smcx0A&oe=6AE35CA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO5s10K453MQ7kNvwFhqitZ&_nc_oc=AdrthXnW72FNJohK3l3awPHJqFHa0CIYtlwSNLPKBKg9ziOI7wtgITu97324oqbEqPY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBxpbXOjxR45DBqavxHmQaZ_XM0CizX4BUArG7kxuiEA&oe=6AE33F3C"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XsMPkDdTIEQ7kNvwHqHLyS&_nc_oc=AdovS_BHWnPRhw42JdE3MupSrtRFHHpSSDVBf1IAKbel6I3ZbGF7aLsnmU2DtmehwDA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4MKOtemT3JMAGLQgAWsGIQRuj5fQsWYEXnPmIduXMzg&oe=6AE366C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTO", "platform": 
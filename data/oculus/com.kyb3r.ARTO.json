86533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JgndIKkvd4Q7kNvwGSxoh1&_nc_oc=AdoDk3yAW2jvCBVZ17OwlBzlYWysGlqi4EDPLLRxJbz1NycOIdEcpHgRZFtEg2932n0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeeoI4AiCBMWfwE1y-sktWDkhx1UhgqraL13aH6CMlCg&oe=6AC12AC2"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETXykMhEriEQ7kNvwFaQKLh&_nc_oc=Adrc88c1NZqQryRcSsAc-LKaUh01PH3Wse1YIQmfMS0ElwmCRsmxQk1Ut1AljQ4nFt0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg0lxTFu4BvHNPgd-h2Qn67aPhWU53Gu4SXJGNaJ6bMg&oe=6AC10282"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggF87e7pgxAQ7kNvwGYuL-U&_nc_oc=Adpk3HCNwErE6xYcFW9J4wqKq9ZlSHhZdmHPu-GVP34XtdHHQn9J64KvCDZaXIjOG5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX8Be_hFIJAq58G2WEAiCqKDrXSiAMH3ew2EF3_kuA5A&oe=6AC106AB"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9HO9YIQHqQQ7kNvwG-fVWI&_nc_oc=AdrX64BP--zVW7AGMfRvcD8YnIy0pMZh_nigPSh1ptvgoohxXIJ4IQOsmvJRYOwf_S4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP53lGXc_t9BM_qLyxTxWPVINIaUF4kjWY0LP5U9fRJFw&oe=6AC12847"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x69Zehe81bAQ7kNvwEXui7Y&_nc_oc=AdrlvFteKH582aKNs8Mb5yrxyjCMFvbfYN687qfdlOkWZjq70fKxWKQrkuzTw3FeSzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP80AL9OylmBQpju1WARyN2DBPIfYIT7bpIqUc9pPVzXg&oe=6AC115A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22YCsGQMvZUQ7kNvwHnY1_H&_nc_oc=AdpS01gkHRmQeVoY7gnDIMaVYFGnCcZ_pMapIJ6ZBLaGiokAlAa1FDjQHMLy5T8XcuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-9BaXAucKUukmeZ6gMsIDRhfb3QtuBdtZS5bUpDV1LQ&oe=6AC1307C"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URClSgm5xesQ7kNvwG_xsbl&_nc_oc=Ado0H4PPk5Zr0-fjgqD_Y7plnbRkTnyhC0Jhgk1XRqfbCJwtM15kGw_7jcrS5c8tFT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp4tYn1vM2UK0tMwAbCWVCekx3KvFiRLsMRqa2Y0UdWQ&oe=6AC11FC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTO", "platform": 
uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982497_8661288463946194_2389593190841913167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h-9vF0wrGMQ7kNvwHJKIib&_nc_oc=Adp5JU7a8TJDd9n0vU2SgvmflCg_w8qJmGbwyf7le2hyH-fNVi9fsOkqQxOMA9MmlTs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cuk4VfRVpJrd5C2hzO7my4aViEgCmf3fediTrCbOJ9Q&oe=6A3FCBBC"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbPqyofb-7QQ7kNvwFXVcNA&_nc_oc=Adqj24A7xaraLSPyoPij1s4YrFBzS-ntxmCAmnSgNyMY7fW-Koq52_sGIDv67dkEhO4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_azYGdPrGsR8ElA5KEIxah0oi3bR5t7Z6_d4l8QSMJWw&oe=6A3FD373"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrMRSA1LJ9gQ7kNvwF9k7Hv&_nc_oc=AdrDmG_Q6tztqDjDLZUiUYmfxKfn8LPzvSLHrcwIKXK9KaLdsgLT5Ew7b-RBT6FTzyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X1Ocd8Zu3H5e4775EKPfp_7W9acWw6f-K0OeU3ouvYQ&oe=6A3FD3EB"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5hKW58fc-oQ7kNvwEuuRLn&_nc_oc=AdpM1eVU837RlTvZv-ENj5MsyHcu7AxD4StmZP-E4aT78sRMhPPhFbkzACI7v2pGLw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uJJtYaW6dL6UCFCzWGJ1XKPNZyMeNk2Y5hB8PtoW9zA&oe=6A3FCFC1"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LB1gyEH6eOIQ7kNvwHSQVxX&_nc_oc=Adq47leK-cl-DXkL_clYNe_spfanUtNQjbgjIkxRbbiHHtTgHPiVrYm7ExPFZx4jJIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1CyVJA9gUKJZXWAv3It7y2o99rKI9jayUKnFurdxNcA&oe=6A3FED20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_t_Xz5wrY0Q7kNvwGsldQ3&_nc_oc=AdoNjTYUK9irMHPUdC_0HX2xGWUdGdT4NSe00Hb6C8fp9ij9AZ4AZb7mHx2TWlxYepo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N3jcn9lihjr22l43GBVslCtUi8rvt9Eg1VrdD9TDcUA&oe=6A3FCDC3"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https:
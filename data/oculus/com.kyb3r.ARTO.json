6533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkSasUt9B_gQ7kNvwEJvnpv&_nc_oc=AdqCTfjVAaFfwfnewVB3Cp-3g8WAENGoMs-z62WkLO__l6ALDh7XvldJpN5c-64YRQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpU0LkwLlB3tiRB5oh4mWBJo4hHM8Rq_0lfrYcQSd_rg&oe=6A9C40C2"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MoaXB2alw4Q7kNvwEWWorr&_nc_oc=AdpsjQSGqZwoRInVW1PbC_qCTsV8d0lExtzgZilpWYmy-fRpt2bsj4kRAbhGeU1zxj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGem2mFPXuF5cqJDYfM0YSaIheDyCR0lYqe_48eA1A8w&oe=6A9C1882"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb0UpFL3hioQ7kNvwEbd13k&_nc_oc=AdqBvyAEceX7EiG6Nx1bEvPXIfdQiOoC5-BYk2OHFXwbYCoS-6ZUs5WwuQf9VCfu1qA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj9398XXbZZhrHY3lx6Bxs6zJkBrWmNnRafmdrdwcX8A&oe=6A9C1CAB"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsN1ILCCl-sQ7kNvwHSu7tx&_nc_oc=AdrnA2Ue_d_OpikrU3_dOvwd3KsCNlYXByMYxGyOT8EOr-KY0K4-U-RAG2_8BkoLr2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbKbNljA6K6RXVls2j9MW_dkBgqCFkcFZBobJx-xC_wg&oe=6A9C3E47"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JibtTwutDXEQ7kNvwGGB0DB&_nc_oc=AdrDvxyQCk4ck371POMPJ5TkVa5xt8gpNNzFq-nlL7LjbE6l9tuoeTB1_a25gCVCFg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzTU9po2Vh-y8Zf1HV7Zv9HFhSpnGD2UnNgjOS8D18Wg&oe=6A9C2BA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJp8cS6s7woQ7kNvwEd8DAs&_nc_oc=Adraijy3kBERn50GbHm9N_a_8_UtnH80TfXQBa7P9pL-5wRSKLw-LlSwrBAUVO9mEbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIlQmfW3wDhDSgAKgAFhbKZccZSYHS28z1g7dfBeDHAQ&oe=6A9C0E3C"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HZUGdvNH-IQ7kNvwEgFWh3&_nc_oc=Adq1YeXHMC8UfUidhNmby65EXBJywXylnpUSahiPbS84C96jihdg--zytpHINr7PiPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH6zBMTwRviNvM9nIQMxO8n14pexMIRWPqes19f2izZA&oe=6A9C35C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTO", "platform": "
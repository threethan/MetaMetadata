culuscdn.com/v/t64.5771-25/38982497_8661288463946194_2389593190841913167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hn5Yv7KUu-oQ7kNvwEtJM5P&_nc_oc=AdmIPoBpm01FNPWG0NVqV5YFMmqO711oWG-dXKnGoNgphLR-9a1nc768fq2i4DcRc8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx436VYAQV8dd6gR83__RynaUEwtInT6JykW5yf8mb8Rg&oe=69B8013C"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv-j7q6c_OwQ7kNvwGQ9ypa&_nc_oc=AdmIzZrEJjJKc2oCC8J7BV9o4x_TM7GDs1X-SwxeJP5JkC6wigoYcjsmK54f9-vb4Os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt9MCdtWEmhL4uaaYwZ65Fbwtkbo48PneAh9NfPmkJ1Q&oe=69B808F3"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c0_xKEwnn8Q7kNvwFFzxuS&_nc_oc=AdnKqIB3SCcM9zXOHl7A3x1sWvXSt2hEJx-Tjl_DSIgw3_PC9SBFdge9IZDkF3U2fT0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOId3DHA2CZU-sX7TVnd5QVrNNSczOshoSAkHcmSmfYQ&oe=69B8096B"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDuvCPfN4YsQ7kNvwFWUu-g&_nc_oc=AdldPHCxGLUg-5SVaoefaIolF_j2_MpTWSzoDUCWCKe9fjo2ArEO8LqEAssbF435b00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3v3fOQvKSfKy_iXtt2JFMvjQ90AWsciLpujyW1g_LBA&oe=69B80541"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0QWiiBIrPMQ7kNvwHMIo30&_nc_oc=AdmTESZ37YCJ6kPbZYwB9VefqmEQA-RZkyutmBLKdfivfQ3HcVlZEVLqaojyKOlC880&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKzA4DCh9HdKiWxW8exqFsE4uSw1y9arAb185yq4u7LA&oe=69B7EA60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM7I1rQt60MQ7kNvwEypTAy&_nc_oc=Adkjz_j5MWGDtfs0Zltt0JbPXV5-lw6aq_SVaRzYmR_UL09ZjbNTGk7qbsPVvzBxy1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCpIekpDLBNwD0RBFjTgWhObHZhJ35kHiRSxa1wCbSAQ&oe=69B80343"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.arto
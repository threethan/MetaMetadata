"1567340161786533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4r4EB2DkQHoQ7kNvwHN4uxC&_nc_oc=AdobdECVGatzwut2zfQ-MiXDw91VUcjNhX7zZyyBYP1tIX-LEBQDqukYrFGXt1uTL_A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg4hAwcLWVSlhSHjTeuNYvqvbn3pquWu4eYK1fKOoMuA&oe=6A8D8802"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCaRdatHE74Q7kNvwE9ArSA&_nc_oc=AdoUU-ZSsuYDq9s1iTelj9L4DPZKtguncw_6urALLsk5I9aiQBFw9zgFGizB_2m0Olk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFushqOkzAKYqmoP4-SnwdFEdUWJQSJLh-X794fXwnOeQ&oe=6A8D9802"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QKRnpUu1nQQ7kNvwHxSjo1&_nc_oc=AdrYmdqpoWJWg9Ln8mAvLDE8105_ku8Yq_0vhzprpHVVsFF_tzVjo88tNpKDSmhSV98&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQAaTHK-B0i6uqrEvBd_I44HNTnkR5A5siMJXwLMLVLw&oe=6A8D9C2B"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wABMo73WpSEQ7kNvwHEVuFB&_nc_oc=Adqem-BB-QgT7H20zhfZuaorgr8i-u-iHqma9L4TgB28PDJDIKxq48qIeux5Ao2Kp5A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOoGUi-M-VvvK5wPvQoeD_gFhTGtOKQHEMqcUqym3H2Q&oe=6A8D8587"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJvVzAuNo-MQ7kNvwHn3NdU&_nc_oc=Adr_Dt2rPZ7943hsYcYLp8CpNzSLVcieFwTjbURawQ_cUnoA4-FSdXB_-g25Wiyc3Sw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4qJh5JAhZaZdAvVnDfxmKj5GF5EF-Q1myTGyP6DzLGQ&oe=6A8D72E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxkvC7Bg_94Q7kNvwFEK9Oa&_nc_oc=AdrqT682oBrHGhO1bcwCk_gGvko03S7xfSTcqU6H1nFB4q7mJsVOg6pI6gHZ5VayPqg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpgbfINhZG78eDY_hCM5ji9ZBKKL4lZ-xES2S20uRr8w&oe=6A8D8DBC"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAtyp2rUxpgQ7kNvwFdBuI7&_nc_oc=AdppxjoV11T286sipRzvlb6viRO_NB59DMnqYDwvcALQCICF9M60eKyrEaldUzx_xGI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGhC7oKlFG9YvpxwROa7xAM8CEuOIev7ECG9iwNo0haQ&oe=6A8D7D07"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ART
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MnjM8jyBQwQ7kNvwEQ0467&_nc_oc=AdmGbfSfWzvQ8bFDHqrh9aNMz7KU3bvoeY-yH3hfYyk82abvquBX_qlZ1f7_u53ZK-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPkqmf3_L1LvT2q9gOizGm94f-08CxGIA8UxHYqamM2Q&oe=69A0463C"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4sHKKGcDX8Q7kNvwE2DgaQ&_nc_oc=Adnsuq9eAPpKB33EtaxqsvBUgEE466HlWYmM4Sf4HBHVIfeEyfTbBjK2uzFnpFDFBoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfupiP4xzpnHPuqp6NtDNHdt2GnAy2AiJpQIBC7XH8H-XA&oe=69A04DF3"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unsj_DINdCUQ7kNvwEgu0tL&_nc_oc=AdnEiZdM1-yWyO_EeWFikkH6wfFcd61jdsqwrnJvIvda9xAiOymb-rRpm027wXlII0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_EKSDKQ0WGAPx-2jWo6jKAjsnHTzyV-HMVpKiDtbA4w&oe=69A04E6B"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4gkGiblrIUQ7kNvwFjMLRN&_nc_oc=Adl_aVF_rJTGg6hohLEwLl4VM1sq3ADraQgqQlpGg7c_hKw2rsHyBZ7WNGzxJ_jvEIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afulj4BrMgwaUReOQEy7AscQZTV7-6Vh0GorCMq7vmtdfQ&oe=69A04A41"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yTeRMhxxHgQ7kNvwG6rPTH&_nc_oc=AdlzdSmuNVnwM8fPEAj9-8Dzm73Wxzo6Dhpjb4Bzxi4nJrK7fhv0Vvr0K2--1fE5X5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvWJSjTR7vX9sD5w6YwmYAfVPDp4ChvoQlrFXpd_Fkuyw&oe=69A02F60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2en35cTohUQ7kNvwEG7obM&_nc_oc=AdlmfwOXqibGf1BPtCNV9q5Go55UHygFT3k5PFTw7P4D87rvndllHdJl3qpeThfyfUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuZevtSkr_LTQj8Gx5VvrgfJSuNaeK4ABvlgJDEiHBWow&oe=69A04843"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982497_8661288463946194_2389593190841913167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JOD7WGqml8Q7kNvwG2DXHh&_nc_oc=AdoPjnaDDCDvv5PrD4XB_SfVvpzpJKFpiMwneAU4BnPZdeCwxlAgnU0Y2MsRgT676n0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bk-4ctwpcX0pW649kSFTWrndl6b6Ps0C0W_OXbGSd-A&oe=69D3B0BC"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o0agWqG_7MQ7kNvwEm2e26&_nc_oc=AdrqGhtbHSp5q-E3YmNVTMrAYZfJUYb1FbY6obDhyJzQTAJHr9OzYvXoJA5fE2hNFT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FLkvoVTVQDL-qt1gTpz-xr3zaKCmxUu-f0N5ADjsdMQ&oe=69D3B873"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRHSow0WS0YQ7kNvwHJlXwH&_nc_oc=AdoGEdGja7bt-qtPq_XbpKk5P5eMx8a_0o5qYbEvn8uBowGf8_nFTpOl0OUG9KHo3ls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZSYaeoMZmdoufDeoCoGc8EMwdL0rVqPnPccO_c57tbQ&oe=69D3B8EB"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6XugwifzIgQ7kNvwHX_XlV&_nc_oc=AdpDaBZpLCD6uwraE80HP-MZv4OXfBCaTtapL6e0Vd1DQgXhCioOnI13fztHEEFrQhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zhxGjej78bNtv6UOvJVg5PlF2ohwGTdtaooEQ2MUB4g&oe=69D3B4C1"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyYUFuPk8fQQ7kNvwE0t0oD&_nc_oc=AdovyaS3z3W9Bbv1l2Jn5XfI2BCm4_Jd2DL7rHi1uctCJd-FMBPYlzfcWBfnD3jUbVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dXz0-kkSzqR0c68tpj03LR5rr7uRboJAYJ9CxQlUgCQ&oe=69D399E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbevsDPXjqAQ7kNvwHjHWQA&_nc_oc=Adpe9GWU1qT_LA89av-AOwfqwjVkSpnLlxSc1fpPMJy5hI8EAVaL72w6tYdkQFQAw8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OoBR6UPAX72N76S-BIYKzBnOdQ3urrviXLInA9J6abA&oe=69D3B2C3"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https:
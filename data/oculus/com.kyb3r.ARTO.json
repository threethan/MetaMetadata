40161786533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff2tmgE3NJgQ7kNvwGEpk1W&_nc_oc=AdqpEvz683B5u-i8MFMDlx_EdCUcBeWvC2CxPDEv19FwXEyHCvm1M7n-qPuaYYwAdZQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq5pbcfmRxF0F0ILyylwg1EMw-fPGLCFwhF20VLUVkrA&oe=6A7DB602"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJDcv7K4d_MQ7kNvwFRL0px&_nc_oc=AdrhJcCPRFG04ohdm38N6osasz86dWruuFabauMtO8LvQJOeu-3IGURTczJ5P7mcVlg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjNRQUU4TUR6nhCu5CgkftPUA-Q0PboP1PtJ3demvIVQ&oe=6A7DC602"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etzhqU_Aj6QQ7kNvwGx8sdM&_nc_oc=Adq8f3mb-M5bNts6sD8ZzXH9Mwhq71WLPIssOhkha4maG1WTVC4XwX04CnWt87voisY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1aLDezXufybQAZVoq6ru74Kf2Nwswnz0NkERfnyeAKg&oe=6A7DCA2B"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIWllj4wYuMQ7kNvwH5T13a&_nc_oc=AdpPkKTeISE96r5VN_QuKK_hbhGyGIvsqpJPTokV_8Ss-X4f8cmCyj65mvt0gTVkDYA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-Evb2QRC6h84VSh4HSv1clc_DOGIAKXaBzTmEPxZEXQ&oe=6A7DB387"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3h7eY27bIMQ7kNvwGWLb-E&_nc_oc=Ado5p_jKggerEaA4FLXRKv7QKdMHKSvxjtNzMYMeqP5y9EzlY2P4e8WqciZNzkXLFW8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0rhUbQGxeDpZi1CgtP4OfrEG1VCNQgiCkYHdwZhx_Gw&oe=6A7DA0E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d84JszGEGZcQ7kNvwGamMmH&_nc_oc=AdrBJZ0ceu5d5Y9RZksKZnVpLSPY7PEtAZNbhf97BAW8dYL6Be4apqsbaiNqvtOxja8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVMiFF7_4tAvPX_HIjbXqPZ5r5nvk2KBWzRZ6ZN0gT6Q&oe=6A7DBBBC"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTKp_bmmQs4Q7kNvwHcb6u3&_nc_oc=AdqwnAldCEKJ0wUVg1DnWGElRBcL0Kg2KceSG4o2yLRnPmg5Zd0pDGEIHQULsDbf_Cw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfQRlUB9WZCvpByQTkAur0_jxgUQzOSPATtUkT5P6PQg&oe=6A7DAB07"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTO"
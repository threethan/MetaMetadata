"1567340161786533", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3 (1).png", "id": "24410807805233606", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75540503_24410807811900272_21223129551823705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4r4EB2DkQHoQ7kNvwH57fvx&_nc_oc=Adr8P04-UbAfWD3n8eSXU_8D8cexjuXBNqrqqpy7BFTJ4uKoba4SYhFYMqZwJMAjhqo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtPo_Bp5uj9359pu__iwiPsAaX9fr76xYIUJZNIh-R5g&oe=6A8ED982"}, {"file_name": "Screenshot2 (1).png", "id": "6704065426358190", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982553_6704065433024856_4658720680093138322_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCaRdatHE74Q7kNvwHV7cxD&_nc_oc=AdoeFqUEHMw90W_J7mKaGW0VQHOr1FRdK0zeg6HmLrTHFeXwE6UTerjXWFaRo8wEuxw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiTReQZwST1G99lzMFC9IIu6MasIR4STHWq4iYDdcuPg&oe=6A8EE982"}, {"file_name": "Screenshot4 (1).png", "id": "1013464639946322", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974606_1013464643279655_7619077339166074210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCY1b8zP7FMQ7kNvwGTk4eq&_nc_oc=Ado1pLlKAOgrgUpH1v2-zFaKriblwV45DpBlcRkTPaTg-AP9e5K-gifZbEsN_S9zxto&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3JulMsodMlbvZlrfqyddnlNccutgJUBquE0Kt4opyGw&oe=6A8EEDAB"}, {"file_name": "Screenshot1 (2).png", "id": "303284516021762", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982724_303284519355095_1684776979322995058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtGSHdhClBsQ7kNvwEHPc8L&_nc_oc=AdresQpBfxGb5CCFsT04rWcPYukmKNhZAU6peD6w1dN8NyNeQKqLCA8kD4ERlNmf7GI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwSuL_I_2Ai4yveKNHlfkc8DmceuXn6CkXo1VbLhceEg&oe=6A8ED707"}, {"file_name": "Screenshot5 (1).png", "id": "198127680034492", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031588_198127683367825_3189931512949804892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlDgiHJ53UMQ7kNvwEltPsc&_nc_oc=AdpmnAdzzDCwI_e0NF2yentzXkirZAp92fysFc5xZoYR3vwQyibE2Fcsjai9QIWdLb4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxx0oiktJtF-PtSP27Hn0h2_rEsN8Lm5NC7lyLXQqrwA&oe=6A8EC468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1867534794091710", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827727_1867534797425043_4184481799538442618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxkvC7Bg_94Q7kNvwH9hI3i&_nc_oc=AdoE54FRweHVV6KgTmApHWnrub_Rd78DU5RjO3HzcZemyMIZJxtV8kagij1Gf3aH-ts&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-ni-xpL3rtd8pD7JeSNWW6_kDu9ny1Ca4f66yOTypvg&oe=6A8EDF3C"}, "display_name": "ARTO", "keywords": ["creative", "art", "drawing", "creation", "relax"], "long_description": "\n# Welcome to **ARTO** \n\u2013 a creative VR playground that blends **art, relaxation, and fun**.  \nWhether you're here to relax or to create like a pro, **ARTO** gives you the tools to express yourself.\n\nExplore **10 unique, themed scenes** and use **over 1200 templates** and **500 decals** to bring your ideas to life.  \nRelax with **mandalas**, try **mirror drawing**, or shoot colorful decals in vibrant worlds. It's intuitive, playful, and made for everyone.\n\n{9078475455591860}\n\nSave your creations with ease and share them with just a few taps.  \nFrom **360\u00b0 screenshots** to **full canvas exports**, **ARTO** makes it simple to show your work to the world.\n\n---\n\n**Key Features:**  \n\u2022 **Drawing crayon** and **line tool**  \n\u2022 **1200+ templates** and **500+ decals**  \n\u2022 **Mirror drawing**, **mandalas**, and **drawing spheres**  \n\u2022 **Undo/redo** (25 steps), **save/load system**  \n\u2022 **Standing** & **seated** play modes  \n\u2022 **Movable ladders** and **stepladders**  \n\u2022 **10 stylized scenes** and **8 curated music playlists**  \n\u2022 **Gallery scene** to present your work  \n\u2022 **Canvas export**, **scene screenshot**, and **360\u00b0 screenshot**  \n\u2022 **Easy sharing options**\n\n{1020447672997468}\n\n**Create. Explore. Inspire.**  \n\u2014 *The ARTO Team*\n\n\n\n", "short_description": "Unleash your creativity in ARTO!\nDraw, paint, and play in 10 unique scenes using 1200+ templates and 500+ decals.\nWhether you're doodling mandalas or making mirrored art, it's all about relaxing fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "de", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28303220972597339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391911_1189313909596724_2374404301183739052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAtyp2rUxpgQ7kNvwFh-coc&_nc_oc=AdqXCIWiq2oJpvaadKGF-Sg_vwSfh8EtKbm-NdmTViSibHuRdTGpdRphmETNtKKIq0I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKYGyAEGFP1OlSoWbNYucpF2Vzx3KILmO-bie8CaeWdg&oe=6A8ECE87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ART
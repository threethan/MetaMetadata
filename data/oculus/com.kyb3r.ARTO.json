_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4u6uk5IDM0Q7kNvwGFtuh3&_nc_oc=Adkhq95iE1REZT7ac1ES9X8kmAkkAEEvxuI8F_ix0e5yKlIZhbjWP5FP7Df9j4iu9pE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvX4g6bpU-Pyqj-15w78h-ZmyXdYCyxIdqA6jiJsWRsJQ&oe=699B003C"}, {"file_name": "Screenshot3.png", "id": "3556639627902613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_3556639631235946_3578311492812010349_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH_n5Z2z8jUQ7kNvwF2Bbl5&_nc_oc=AdmtA_kBHzGsM4wNF7iofrf11uW5trlI_L-ds3e7jGt57rmWwCwmezybNIfgKXp6XJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsgX_EWTBsv0mn7ChZHVkUXPJ8EZbho_0qYNJPdudrj7Q&oe=699B07F3"}, {"file_name": "Screenshot5.png", "id": "3385263531718848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_3385263535052181_2595174362799100845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haqXE21AM7IQ7kNvwE5kxQi&_nc_oc=AdmCFCmzvCCkQLG8poq3ZR2GD4gW4UKcAHUESzGp2cvun4SA6rfC7ni6HPT4YvTcl6U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afui6PPcEMP0yLidUg4yyhglCd98ne1iFuDdTY_mmFIn6A&oe=699B086B"}, {"file_name": "Screenshot1.png", "id": "743081367238279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75308615_743081377238278_5386387825930894357_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRAUGzZABe0Q7kNvwHwaWOW&_nc_oc=AdkzktSDb0E7D58Ve8e1GzsQDgtuOhrqiOOFK89He4rgDW7O5C9txpvpzn_u6NYvQds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsou2qYlkpMSqEfpinu5aUE9vxFmujlI9v3zI2KupsLRw&oe=699B0441"}, {"file_name": "Screenshot2.png", "id": "728436718635178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556802_728436721968511_4835184316948889422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh5_pEJ_puEQ7kNvwG_nSSm&_nc_oc=Adn8TgpMAIaIp4-sFb-rCgL8V5TKWEGzT5vlYjWtqi8lu_BWkCzmJ_4PvK8N4pCwM58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsSTEkUoIKWO-ZzpS7lz8jUYDXxjWQi-T1NgmJ80XXcLw&oe=699AE960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1148036655906006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031467_1148036659239339_5306817357012458880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1m8VmIY6GsQ7kNvwG1wUNX&_nc_oc=Adnp6jHuNZlq-r_8RvOrEOXI7oIvf_BwA7MPBmaKJJvTTVfFJpPgGbXqzrAa_cZdqgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftd5iUslJapy-ervC2uXM0nt0n3g3bZvJOVjxwFTHXYNQ&oe=699B0243"}, "display_name": "ARTO", "keywords": [], "long_description": "Don't know how to draw a body, a camel, a car...?\nNever mind! \n\nARTO is a drawing game for everyone who likes to be creative. Everyone from beginners to professional graphic artists will enjoy drawing. In ARTO you will find everything you need to create your own great creations. The game contains nine themed scenes and more than 1200 templates that you can freely place and combine. In the relaxing scenes, there are canvases for creating beautiful mandalas and mirror drawings.\nYou can instantly share each of your creations using several saving methods.\nEnjoy ARTO and we look forward to seeing your creations.\n\nFeatures:\n- drawing crayon\n- drawing extender\n- many color palettes\n- standing / sitting mode\n- line tool\n- load/save\n- undo/redo 25 steps\n- mirror drawing\n- mandalas\n- movable ladders and stepladders\n- hundreds of posable stencils\n- 8 thematic scenes\n- 8 themed music playlists\n- gallery scene (YOUR presentation)\n- screenshot from eyes\n- canvas screenshot \n- easy share\n\nBest regards,\nARTO Team", "short_description": "Be creative, draw and share. But above all, relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artovrgame.com/pp", "developer_terms_of_service_url": null, "publisher_name": "kyb3r s.r.o.", "support_website_url": "https://www.artovrgame.com/", "website_url": "https://www.artovrgame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
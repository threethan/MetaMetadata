rt_Square.png", "id": "662281063597520", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpEQUFJUDZ4Q7kNvwHycMkB&_nc_oc=AdpabOHD_F92tpLHJUj9s-n-wiAD7l4Z4jyYqel2JPk52Ywxq0MMcRKemJVXiL_WVX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCgS6WTWAdK2c7Vgf9ZYccaHueE2zwfzDuNf0DH7jrkw&oe=6A844310"}]}, "id": "1418990259714843", "locale": "en_US", "screenshots": [{"file_name": "InGame_FortuneDrums16-9.png", "id": "1104089048570207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299139_1104089051903540_6133809805911234443_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SczAiTISuoMQ7kNvwHTBAOL&_nc_oc=Adq9nH_A1dBJRwr1HLmWS6NBorHlKIbNCpFqRL2TlDrzgROpFCiuqZGYyPPNLiG2jeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlQKtKDSRxk_aZbXAuunJlzohxh_iz7Z1yDPHGNRJOuw&oe=6A843D90"}, {"file_name": "Lobby16-9.png", "id": "1117004779993498", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628876_1117004783326831_8190941059277750743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xyg-C8XZOJ4Q7kNvwEVkO3k&_nc_oc=AdqGH3GLPEiT42T0_vDQy4pq_8mdhQXArKHKlpHDdCBA3nFoZV43D__Y2p4glKygr_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuVKOY2oHplysg1ksEp2AtRVaxvCnbzUoz4bEBoW6XIg&oe=6A8468EB"}, {"file_name": "Jackpot18-9.png", "id": "800787459125126", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313086_800787462458459_6930032991117516883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f73gkvKGqbYQ7kNvwEUvaei&_nc_oc=Adq6Dkqt3yaqr7SIv9OMMUc5SYqhApB3xKRExbfYMTcDrGcla-dIw_Z1i853_zrb12w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3rw34_LKBJdujTw366FjJgCunbKwqq7II49UCyHE3sg&oe=6A843C5E"}, {"file_name": "InGame_JokerSpark16-9.png", "id": "640251362471745", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308961_640251365805078_11192827138929440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxfNMquc2L8Q7kNvwFAtiLH&_nc_oc=AdrIeNXYVHJjsbKvRla43r3I8SgznykXK5O4Uizv8Ft_kKmbvjX8Ah8f8DSRKmlD-is&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvdqA8sHwrSwKXqv3vqUmjnZ8YbOnSADkwmkEncK7YiQ&oe=6A84514C"}, {"file_name": "Bingo16-9.png", "id": "1434116907874356", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820574_1434116911207689_8961654679034847196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNv5gRl5i6cQ7kNvwF50iEL&_nc_oc=AdrIj5LN3yLt2w8oxrDO7o-1zeHxWzR5QqDGGeJu7mRKixcVSmG-eWM7seV3ndJxCfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9ynecbh2ePuMwD5K1VdgF2g1cUmsCkGJSr3-i50znIQ&oe=6A845CC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jackpot VR: Vegas Slots", "keywords": ["casino", "slots", "vegas", "jackpot", "machine"], "long_description": "\ud83c\udfb0 Step up to the slot machine in VR!\n\nJackpot VR: Vegas Slots brings the lights, reels, sounds, and virtual jackpot moments of a casino floor to Meta Quest. Pull the lever, spin themed machines, collect daily free coins, and unlock new slot worlds as you level up.\n\n\ud83d\udc8e Key Features:\n\n\ud83c\udfa1 Immersive VR Slots: Feel the reels spin, lights flash, and jackpots explode all around you!\n\n\ud83d\udcb0 Massive Wins & Daily Rewards: Log in daily for free coins, bonus spins, and mega jackpots.\n\n\ud83c\udfc6 Level Up & Unlock More: The higher you climb, the bigger the prizes - unlock premium slot worlds and special events.\n\n\ud83c\udf87 Epic Themes, Endless Thrills: From fiery phoenixes to cosmic reels, every machine is a new adventure.\n\nSoar into the spotlight, chase your dream jackpot, and make every spin count.\n\n\u2728 Jackpot VR - Spin. Win. Live the thrill. \u2728\n\nBuilt for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nJackpot VR is designed for entertainment and uses simulated gambling. It does not offer real-money gambling or cash prizes.", "short_description": "Spin Vegas-style slot machines in VR on Meta Quest. Pull the lever, claim daily free coins, unlock themed reels, and chase huge jackpots in a comfortable seated or standing casino experience. Free to play. Simulated gambling only \u2014 no real-money gambling or cash prizes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playbonkers.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Bonkers LLC", "support_website_url": null, "website_url": "https://www.playbonkers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513561708336840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpEQUFJUDZ4Q7kNvwHycMkB&_nc_oc=AdpabOHD_F92tpLHJUj9s-n-wiAD7l4Z4jyYqel2JPk52Ywxq0MMcRKemJVXiL_WVX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmFyue32xs565WxTJMvQV0Qgr5usEXGVxjyP361viH2A&oe=6A844310"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jackpot VR: Vegas Slots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
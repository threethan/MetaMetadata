rt_Square.png", "id": "662281063597520", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmWBk2-MiuoQ7kNvwFcUcoH&_nc_oc=AdpOXoNLed1jSR0-3VKHL3dxk8CvTfdPAq-Xwi3empakDHba6Rk1kY7AAWUzbQUehps&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4Ahoe8hKBG08xuWiaRmoNRhOQclCBALbkDAsOZPThzw&oe=6A6628D0"}]}, "id": "1418990259714843", "locale": "en_US", "screenshots": [{"file_name": "InGame_FortuneDrums16-9.png", "id": "1104089048570207", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299139_1104089051903540_6133809805911234443_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=356XgVK9uoUQ7kNvwHrp1NU&_nc_oc=Adr6o0o010RzF86MJI4O4Xv9NMjIrRC5F4U2SbTSN_l7BSKjVeYJUZ9qEq-LBEo3s4s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5n4G9baPWuYwCAHW6xB0ycECMf6A6mkqf0kgJYW4-KA&oe=6A662350"}, {"file_name": "Lobby16-9.png", "id": "1117004779993498", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499628876_1117004783326831_8190941059277750743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbC92HQx058Q7kNvwFxDYMm&_nc_oc=Adpovwrrp9721mQu8APhyGjI7edesfOTQmia-b7s4tIXx3Emb92c2roP8HqsZXQlYTY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqgZbZwm_nchO2ayBNQrhanQNJs1ZyD9o_MfCPnZFmMg&oe=6A66166B"}, {"file_name": "Jackpot18-9.png", "id": "800787459125126", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499313086_800787462458459_6930032991117516883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05uXvj5Px4UQ7kNvwFjB3yl&_nc_oc=Adr6YM986PcX3OX91tPdtzKbq9INJiFNimAYbikfeTFXmssR8Ktj6ogbDOvvhUt42ts&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNiDVO1G4YG9tkvnGClvPl7wMNYcxnKaAhdYscICmwvw&oe=6A66221E"}, {"file_name": "InGame_JokerSpark16-9.png", "id": "640251362471745", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308961_640251365805078_11192827138929440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qmon_wIgYQQ7kNvwEPYpAO&_nc_oc=Adpxu8698K3EfruZ6GBQuWXcVPZtgBcXbj6SGsG82-CgcgTELoVQJ09UOxlkBsmZ7pw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUnKRpOY7-1DrBNGT_PF5mcGdzQIS0waq6ngRBhP1LpQ&oe=6A65FECC"}, {"file_name": "Bingo16-9.png", "id": "1434116907874356", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820574_1434116911207689_8961654679034847196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xNDVCEHySwQ7kNvwH82LwP&_nc_oc=AdphZN7aA8skzLozveXE8b_XnznUTvPM9c1v8XgLDmfPw5sLzueXAI0iGHtykHcjHYA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrwplBf1w2Hc--GUeTpV84VKySMIMVGYJ15u7O5_fYUg&oe=6A660A43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jackpot VR: Vegas Slots", "keywords": ["casino", "slots", "vegas", "jackpot", "machine"], "long_description": "\ud83c\udfb0 Step up to the slot machine in VR!\n\nJackpot VR: Vegas Slots brings the lights, reels, sounds, and virtual jackpot moments of a casino floor to Meta Quest. Pull the lever, spin themed machines, collect daily free coins, and unlock new slot worlds as you level up.\n\n\ud83d\udc8e Key Features:\n\n\ud83c\udfa1 Immersive VR Slots: Feel the reels spin, lights flash, and jackpots explode all around you!\n\n\ud83d\udcb0 Massive Wins & Daily Rewards: Log in daily for free coins, bonus spins, and mega jackpots.\n\n\ud83c\udfc6 Level Up & Unlock More: The higher you climb, the bigger the prizes - unlock premium slot worlds and special events.\n\n\ud83c\udf87 Epic Themes, Endless Thrills: From fiery phoenixes to cosmic reels, every machine is a new adventure.\n\nSoar into the spotlight, chase your dream jackpot, and make every spin count.\n\n\u2728 Jackpot VR - Spin. Win. Live the thrill. \u2728\n\nBuilt for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nJackpot VR is designed for entertainment and uses simulated gambling. It does not offer real-money gambling or cash prizes.", "short_description": "Spin Vegas-style slot machines in VR on Meta Quest. Pull the lever, claim daily free coins, unlock themed reels, and chase huge jackpots in a comfortable seated or standing casino experience. Free to play. Simulated gambling only \u2014 no real-money gambling or cash prizes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playbonkers.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Bonkers LLC", "support_website_url": null, "website_url": "https://www.playbonkers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513561708336840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmWBk2-MiuoQ7kNvwFcUcoH&_nc_oc=AdpOXoNLed1jSR0-3VKHL3dxk8CvTfdPAq-Xwi3empakDHba6Rk1kY7AAWUzbQUehps&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcRE9HACmrXzdOz6C8qBRqGJpXFcxBxGDx5a9Hnlxg6A&oe=6A6628D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jackpot VR: Vegas Slots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
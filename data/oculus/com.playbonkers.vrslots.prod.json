rt_Square.png", "id": "662281063597520", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6k4a-sAnpUQ7kNvwEvLw3D&_nc_oc=Ado3k__DmLg6gnUwVvtu9KP0ZveK5-qROuR5lGoxtmQU16sRWxLosoR8EGhwOqQ7tuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3YgKmViCOShEE4Yi_ZurV6mZBNRFalPjivZhgXFbXxQ&oe=6AC3C350"}]}, "id": "1418990259714843", "locale": "en_US", "screenshots": [{"file_name": "InGame_FortuneDrums16-9.png", "id": "1104089048570207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299139_1104089051903540_6133809805911234443_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2PMieKye8sQ7kNvwGczqgH&_nc_oc=Ado9e237nnPhD5TtkH4QL9lmTLEnc8bzXHHuAZ5oYZTutIWQQ4R0TArQlxqUqE0dIM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxtQwgZAx6ZkPtoPQtmmkZYNRGSzB4umQ0cXZvuq5OFQ&oe=6AC3BDD0"}, {"file_name": "Lobby16-9.png", "id": "1117004779993498", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628876_1117004783326831_8190941059277750743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGFu9k8KDH8Q7kNvwFQprZd&_nc_oc=AdpHopwL9HPUWCNsQE3JfRKY8ktJc3v5viZfOFuSSjbTKOv4We5PDoUJjNC2_Ex8zfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK05XoAGRPohmsoQJ6Z7NURgJCWfNka4T0YhBxC0_CpA&oe=6AC3B0EB"}, {"file_name": "Jackpot18-9.png", "id": "800787459125126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313086_800787462458459_6930032991117516883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iphp66z0OmYQ7kNvwH9hi15&_nc_oc=AdrPo-0NrcJUkAGyHqom_vLv-8IcqxTujppUHF6Puwef6PrcqnDQGI8ndnHT6PbOndE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9OkiXnX7FkNVU66Bpg52LGnXIo-imkBsK0rAYw2Lm6Q&oe=6AC3BC9E"}, {"file_name": "InGame_JokerSpark16-9.png", "id": "640251362471745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308961_640251365805078_11192827138929440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3vCcsq-7CQQ7kNvwEcdxx9&_nc_oc=Adr4ErmC2BYSV20EH8olSrznZenHzZSdRMyNS4UFBWLAcIbXZLB75Lhqitt8ULGL5ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOry7qhnmscIEYNc6aNac2W0QEYr9I39ocGemrwW7ChWg&oe=6AC3D18C"}, {"file_name": "Bingo16-9.png", "id": "1434116907874356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820574_1434116911207689_8961654679034847196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCjf6AWzNm0Q7kNvwE2qZta&_nc_oc=AdqLznaIqqaU9A6PQ_1JvyfMEBiMhlYtC7VkfSXcYxNMuXzPn3VxCAjGhAQV0EvCIdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeeZvvX3pDTQUQzDqbf8oC3ftPwokTJSlmQ3q9JXZJ4Q&oe=6AC3A4C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jackpot VR: Vegas Slots", "keywords": ["casino", "slots", "vegas", "jackpot", "machine"], "long_description": "\ud83c\udfb0 Step up to the slot machine in VR!\n\nJackpot VR: Vegas Slots brings the lights, reels, sounds, and virtual jackpot moments of a casino floor to Meta Quest. Pull the lever, spin themed machines, collect daily free coins, and unlock new slot worlds as you level up.\n\n\ud83d\udc8e Key Features:\n\n\ud83c\udfa1 Immersive VR Slots: Feel the reels spin, lights flash, and jackpots explode all around you!\n\n\ud83d\udcb0 Massive Wins & Daily Rewards: Log in daily for free coins, bonus spins, and mega jackpots.\n\n\ud83c\udfc6 Level Up & Unlock More: The higher you climb, the bigger the prizes - unlock premium slot worlds and special events.\n\n\ud83c\udf87 Epic Themes, Endless Thrills: From fiery phoenixes to cosmic reels, every machine is a new adventure.\n\nSoar into the spotlight, chase your dream jackpot, and make every spin count.\n\n\u2728 Jackpot VR - Spin. Win. Live the thrill. \u2728\n\nBuilt for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nJackpot VR is designed for entertainment and uses simulated gambling. It does not offer real-money gambling or cash prizes.", "short_description": "Spin Vegas-style slot machines in VR on Meta Quest. Pull the lever, claim daily free coins, unlock themed reels, and chase huge jackpots in a comfortable seated or standing casino experience. Free to play. Simulated gambling only \u2014 no real-money gambling or cash prizes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playbonkers.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Bonkers LLC", "support_website_url": null, "website_url": "https://www.playbonkers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513561708336840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6k4a-sAnpUQ7kNvwEvLw3D&_nc_oc=Ado3k__DmLg6gnUwVvtu9KP0ZveK5-qROuR5lGoxtmQU16sRWxLosoR8EGhwOqQ7tuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwOal-tvUi0gxJRuXN69EyCciYdJzAr5GbDpiJwHB1HA&oe=6AC3C350"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jackpot VR: Vegas Slots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
rt_Square.png", "id": "662281063597520", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAkovcz2AGUQ7kNvwED3dId&_nc_oc=Adq7MHPfkLBaPQooK3-ucuL1ZADZwy01kV4APBB5ef5850FiDxmM-BasQOzeHJZIngs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvpRvakvNqOJOBZiat94odUNpmXm90XKQ0LGZ1VoAEqw&oe=6A4927D0"}]}, "id": "1418990259714843", "locale": "en_US", "screenshots": [{"file_name": "InGame_FortuneDrums16-9.png", "id": "1104089048570207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299139_1104089051903540_6133809805911234443_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onxytSa22WsQ7kNvwGtnIYN&_nc_oc=AdpuJ6bzpzz_CQd-8KY1t8Cy0a_NpHU_u_jz1heY8lfGer2kIm3DiqwfFpbd_AaGvnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG017PCidEOMJIaAsIJBjO44Vx441FAijz3sSJK7qLWw&oe=6A492250"}, {"file_name": "Lobby16-9.png", "id": "1117004779993498", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628876_1117004783326831_8190941059277750743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afZDlO05TbwQ7kNvwGmTV8T&_nc_oc=Adoe77AVS9egxfynmmckBq65YGItjwzPnfmfeTD2R4KPgWUb0dGuroLaoYb6SqLdEwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsttXtu7QdZBbwRsKZsCUeBCRJIFHOnKi1ue4oasNH_g&oe=6A49156B"}, {"file_name": "Jackpot18-9.png", "id": "800787459125126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313086_800787462458459_6930032991117516883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUVQQLbzdNAQ7kNvwGG8EHq&_nc_oc=Adp68xzJWTzJ_OOPQaO6DMuOuUcsxU19tL214Lnl8QRH2dMGmU7Zej15xzJcnj3IhEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR0vUKrvxH7-NvaN3hvAVRWRtw_rFJZ_S9Qp7tTVFg0w&oe=6A49211E"}, {"file_name": "InGame_JokerSpark16-9.png", "id": "640251362471745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308961_640251365805078_11192827138929440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGNFMVvlMBsQ7kNvwHP_s5s&_nc_oc=Adok6bJ8DlbLE4c6KxeuKjj_G6D8GE4j1w5fyxoLIi0XK40qHcqku5RKzDy-7ga_uTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClqZxSQw57rGzEi7k7Dm3QPDEWYDUN_OeEGpilTIkw1g&oe=6A48FDCC"}, {"file_name": "Bingo16-9.png", "id": "1434116907874356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820574_1434116911207689_8961654679034847196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWM4edjNIg4Q7kNvwElBucB&_nc_oc=Adrz5FoOKNBnrLCYGuSL6PV-Z1N3Fzw9r4m7T-UgFhvaH-Vg6xKKt2k_0BsO3herjpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFgFbzE1wMhGFZ0feMValuTdg_ke6FdhUtmSd6amc8Ag&oe=6A490943"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jackpot VR: Vegas Slots", "keywords": ["casino", "slots", "vegas", "jackpot", "machine"], "long_description": "\ud83c\udfb0 Step up to the slot machine in VR!\n\nJackpot VR: Vegas Slots brings the lights, reels, sounds, and virtual jackpot moments of a casino floor to Meta Quest. Pull the lever, spin themed machines, collect daily free coins, and unlock new slot worlds as you level up.\n\n\ud83d\udc8e Key Features:\n\n\ud83c\udfa1 Immersive VR Slots: Feel the reels spin, lights flash, and jackpots explode all around you!\n\n\ud83d\udcb0 Massive Wins & Daily Rewards: Log in daily for free coins, bonus spins, and mega jackpots.\n\n\ud83c\udfc6 Level Up & Unlock More: The higher you climb, the bigger the prizes - unlock premium slot worlds and special events.\n\n\ud83c\udf87 Epic Themes, Endless Thrills: From fiery phoenixes to cosmic reels, every machine is a new adventure.\n\nSoar into the spotlight, chase your dream jackpot, and make every spin count.\n\n\u2728 Jackpot VR - Spin. Win. Live the thrill. \u2728\n\nBuilt for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nJackpot VR is designed for entertainment and uses simulated gambling. It does not offer real-money gambling or cash prizes.", "short_description": "Spin Vegas-style slot machines in VR on Meta Quest. Pull the lever, claim daily free coins, unlock themed reels, and chase huge jackpots in a comfortable seated or standing casino experience. Free to play. Simulated gambling only \u2014 no real-money gambling or cash prizes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playbonkers.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Bonkers LLC", "support_website_url": null, "website_url": "https://www.playbonkers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513561708336840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAkovcz2AGUQ7kNvwED3dId&_nc_oc=Adq7MHPfkLBaPQooK3-ucuL1ZADZwy01kV4APBB5ef5850FiDxmM-BasQOzeHJZIngs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBpZaUdCzbOXl5SZ854AD_BRl4F-GIWZ2Gs3u48zavAQ&oe=6A4927D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jackpot VR: Vegas Slots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
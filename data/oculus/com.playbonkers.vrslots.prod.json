5805078_11192827138929440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=az98O8gJz30Q7kNvwGv0A5B&_nc_oc=Adp3ann3oiaKSIExlMbAbCJ0l9FLGMvt-7PtY4Jkq2bQRLpTbJse6bHm8BdZ1PA_jS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD5jmpAFZisq9Wk8gglPNCgOmFhZUBJiiOHcPdRNoxMw&oe=6AEB5E8C"}, {"file_name": "Bingo16-9.png", "id": "1434116907874356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820574_1434116911207689_8961654679034847196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIBg3nyDqUsQ7kNvwHCN9Yo&_nc_oc=AdqNiWfK9Wel7i_jBiCCUZjwTsSGDscTVaQuVMjHZ0OpVPYE-1kThGbCiz6aRa0Bi2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSho4Ve-Ke-27jEfY5x-j9NrsjmmdcU1aDPvI6MfaWMYg&oe=6AEB31C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jackpot VR: Vegas Slots", "keywords": ["casino", "slots", "vegas", "jackpot", "machine"], "long_description": "\ud83c\udfb0 Step up to the slot machine in VR!\n\nJackpot VR: Vegas Slots brings the lights, reels, sounds, and virtual jackpot moments of a casino floor to Meta Quest. Pull the lever, spin themed machines, collect daily free coins, and unlock new slot worlds as you level up.\n\n\ud83d\udc8e Key Features:\n\n\ud83c\udfa1 Immersive VR Slots: Feel the reels spin, lights flash, and jackpots explode all around you!\n\n\ud83d\udcb0 Massive Wins & Daily Rewards: Log in daily for free coins, bonus spins, and mega jackpots.\n\n\ud83c\udfc6 Level Up & Unlock More: The higher you climb, the bigger the prizes - unlock premium slot worlds and special events.\n\n\ud83c\udf87 Epic Themes, Endless Thrills: From fiery phoenixes to cosmic reels, every machine is a new adventure.\n\nSoar into the spotlight, chase your dream jackpot, and make every spin count.\n\n\u2728 Jackpot VR - Spin. Win. Live the thrill. \u2728\n\nBuilt for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nJackpot VR is designed for entertainment and uses simulated gambling. It does not offer real-money gambling or cash prizes.", "short_description": "Spin Vegas-style slot machines in VR on Meta Quest. Pull the lever, claim daily free coins, unlock themed reels, and chase huge jackpots in a comfortable seated or standing casino experience. Free to play. Simulated gambling only \u2014 no real-money gambling or cash prizes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playbonkers.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Bonkers LLC", "support_website_url": null, "website_url": "https://www.playbonkers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513561708336840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ1dqXqj4R8Q7kNvwGY9FTn&_nc_oc=AdrvyxjOHszB6lUQrYDI0cGb-RqFvx1EH0XS6lAGWdkx8-rmw9MP19OVKP38JpSmWIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyhz1-amNGQSYHQ0uKiaLbm2hi7wn4M9tyuYpB62HXRA&oe=6AEB5050"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jackpot VR: Vegas Slots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
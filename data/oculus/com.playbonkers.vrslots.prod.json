rt_Square.png", "id": "662281063597520", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQEDOJEeQgUQ7kNvwFJiE1P&_nc_oc=Adpg5rrk1zyvkm4hz0cU1NIg_xVyjbnUHx1YKT5jiyrs8I4CzZoqn0KzJRSnMP7Ayy4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoCQMw7eP-0qtXsMGNcxY46RnBy38R-hRzWxT2tNWWmg&oe=6A5A4B50"}]}, "id": "1418990259714843", "locale": "en_US", "screenshots": [{"file_name": "InGame_FortuneDrums16-9.png", "id": "1104089048570207", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299139_1104089051903540_6133809805911234443_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBNj4Jy4h6oQ7kNvwE4ibWq&_nc_oc=AdosDN55UVFruu5O53Kx9PA0pyqg51Jx_SKBKyySAPFyFdp2Z7HvkySvw2rBZaW3zHU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoqragj4UImivjAoFM0NzGjNkmG_FpVHnUg-UKTJ9E8Q&oe=6A5A45D0"}, {"file_name": "Lobby16-9.png", "id": "1117004779993498", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499628876_1117004783326831_8190941059277750743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmfNMmAWrkIQ7kNvwHs1KKG&_nc_oc=AdqQrL3SDz0HQMyzcc__bfvRKc4X2UxDPYKkncD3NPz99SZV12D41kFqWVW0vRPRnGU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUbaeUE9s-8Rlx20Re9XGQFB3BAf8z45Ge8C3ftM8fbA&oe=6A5A38EB"}, {"file_name": "Jackpot18-9.png", "id": "800787459125126", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499313086_800787462458459_6930032991117516883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZhnC6kj8T4Q7kNvwHGETfq&_nc_oc=AdrYS_qbcK4RV2-gOeKPrJvX-qI1uMpaFeM_uc1F-YKfrinKPp_5q6eZxHZf8iit_ek&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASYsewboLxdKm9lprm8GJBN1se-rQ-K-3pF3ArMBw4dg&oe=6A5A449E"}, {"file_name": "InGame_JokerSpark16-9.png", "id": "640251362471745", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308961_640251365805078_11192827138929440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mrh5rd9_Gi0Q7kNvwHmrNUY&_nc_oc=AdqvRFjGUDbpw1047JaQZn0aMSvt584u6oQ5DzCO4K5ZCiMEXIuo8QeLdfNj49t9JyY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVfyAxjl83p_yWlpzOylS5Wo51XpWSpcxwbQUxrjz4GQ&oe=6A5A214C"}, {"file_name": "Bingo16-9.png", "id": "1434116907874356", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820574_1434116911207689_8961654679034847196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIN1DwvtvugQ7kNvwEsUy_e&_nc_oc=AdpZ9O9wvVA_LAY7T77z9F4_MQZVIEoO7Lxof95Sgx4X2mP0P8lu9HjkEvFOXAHCQ5g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgEGVaUKZ3pMIdxinX9j2hKLJVPrH93Sut9Qq0d4CSMQ&oe=6A5A2CC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jackpot VR: Vegas Slots", "keywords": ["casino", "slots", "vegas", "jackpot", "machine"], "long_description": "\ud83c\udfb0 Step up to the slot machine in VR!\n\nJackpot VR: Vegas Slots brings the lights, reels, sounds, and virtual jackpot moments of a casino floor to Meta Quest. Pull the lever, spin themed machines, collect daily free coins, and unlock new slot worlds as you level up.\n\n\ud83d\udc8e Key Features:\n\n\ud83c\udfa1 Immersive VR Slots: Feel the reels spin, lights flash, and jackpots explode all around you!\n\n\ud83d\udcb0 Massive Wins & Daily Rewards: Log in daily for free coins, bonus spins, and mega jackpots.\n\n\ud83c\udfc6 Level Up & Unlock More: The higher you climb, the bigger the prizes - unlock premium slot worlds and special events.\n\n\ud83c\udf87 Epic Themes, Endless Thrills: From fiery phoenixes to cosmic reels, every machine is a new adventure.\n\nSoar into the spotlight, chase your dream jackpot, and make every spin count.\n\n\u2728 Jackpot VR - Spin. Win. Live the thrill. \u2728\n\nBuilt for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nJackpot VR is designed for entertainment and uses simulated gambling. It does not offer real-money gambling or cash prizes.", "short_description": "Spin Vegas-style slot machines in VR on Meta Quest. Pull the lever, claim daily free coins, unlock themed reels, and chase huge jackpots in a comfortable seated or standing casino experience. Free to play. Simulated gambling only \u2014 no real-money gambling or cash prizes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playbonkers.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Bonkers LLC", "support_website_url": null, "website_url": "https://www.playbonkers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513561708336840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQEDOJEeQgUQ7kNvwFJiE1P&_nc_oc=Adpg5rrk1zyvkm4hz0cU1NIg_xVyjbnUHx1YKT5jiyrs8I4CzZoqn0KzJRSnMP7Ayy4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYSaJlgAxUQvLnqPfufop57ZZY6ugcUUHTr5MgSnSd3g&oe=6A5A4B50"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jackpot VR: Vegas Slots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
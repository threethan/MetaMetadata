5805078_11192827138929440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzjCqKBRYXEQ7kNvwF7Fc6N&_nc_oc=AdrAlP0EXvw2iCyeunYki0CUxZtpZWEV15ttq7AQMMrhjr9qZ7jxCBd-jIPJNi3L2bM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWaAPBIH0L_PszbZxhr6f20S7-33R2byNfhUncD20E-w&oe=6AF88D8C"}, {"file_name": "Bingo16-9.png", "id": "1434116907874356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820574_1434116911207689_8961654679034847196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1g-snYyCUIQ7kNvwF90Skq&_nc_oc=Adrg_5f3Y1ahd0Xz2UoAaa6Ka0ChjGGV26bWrNRyOMgvpl1qVH396Wq9m8bGRRBl0Zc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz1cY4pA6oVSpSPNnBEJqVJHLXMHHGe_xqMwbugTTs9Q&oe=6AF89903"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jackpot VR: Vegas Slots", "keywords": ["casino", "slots", "vegas", "jackpot", "machine"], "long_description": "\ud83c\udfb0 Step up to the slot machine in VR!\n\nJackpot VR: Vegas Slots brings the lights, reels, sounds, and virtual jackpot moments of a casino floor to Meta Quest. Pull the lever, spin themed machines, collect daily free coins, and unlock new slot worlds as you level up.\n\n\ud83d\udc8e Key Features:\n\n\ud83c\udfa1 Immersive VR Slots: Feel the reels spin, lights flash, and jackpots explode all around you!\n\n\ud83d\udcb0 Massive Wins & Daily Rewards: Log in daily for free coins, bonus spins, and mega jackpots.\n\n\ud83c\udfc6 Level Up & Unlock More: The higher you climb, the bigger the prizes - unlock premium slot worlds and special events.\n\n\ud83c\udf87 Epic Themes, Endless Thrills: From fiery phoenixes to cosmic reels, every machine is a new adventure.\n\nSoar into the spotlight, chase your dream jackpot, and make every spin count.\n\n\u2728 Jackpot VR - Spin. Win. Live the thrill. \u2728\n\nBuilt for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nJackpot VR is designed for entertainment and uses simulated gambling. It does not offer real-money gambling or cash prizes.", "short_description": "Spin Vegas-style slot machines in VR on Meta Quest. Pull the lever, claim daily free coins, unlock themed reels, and chase huge jackpots in a comfortable seated or standing casino experience. Free to play. Simulated gambling only \u2014 no real-money gambling or cash prizes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playbonkers.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Bonkers LLC", "support_website_url": null, "website_url": "https://www.playbonkers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513561708336840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7CSY53t9CgQ7kNvwGHtkLV&_nc_oc=AdokRIcs7dt2QugY5eV6OPid9p3telHeG3B8JCUpYU6tp5DXy3RwOlhuEPMpx0wnKew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH3Vwjee4_0bvYB1bqYRslrjTq8ZPfsCXBxXRauOxPKA&oe=6AF87F50"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jackpot VR: Vegas Slots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
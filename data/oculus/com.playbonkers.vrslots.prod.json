rt_Square.png", "id": "662281063597520", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7zK207FPqcQ7kNvwHzDTwg&_nc_oc=Adr6J6OGKfVAgW2dc4CrLH_C4F33wf01Z0dlqZ_j-Z8OJXlUA4IrQaDUmMwzIDzgpe8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUDEtgp1hu7_w_Sfob7EpNx4pu-2Lm9VFDf_dJoQNVOQ&oe=6AF9D0D0"}]}, "id": "1418990259714843", "locale": "en_US", "screenshots": [{"file_name": "InGame_FortuneDrums16-9.png", "id": "1104089048570207", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299139_1104089051903540_6133809805911234443_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhGY1IgWNdcQ7kNvwFrKNVk&_nc_oc=Adqot0GpS8a_g-PJquEF04sotknOyfJINocr5tgqR_FXJoDReHD4E4Cxd3OtFklCYuA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUpgQmgd3hbbeEcsGY6ixZenZZYmqmsNa04kvXseKajw&oe=6AF9CB50"}, {"file_name": "Lobby16-9.png", "id": "1117004779993498", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499628876_1117004783326831_8190941059277750743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3z2h0_0zlMQ7kNvwED5oWr&_nc_oc=AdqQeHOmiYQ_1ftf-DfVmxIWYv_exUqgc8xeUAK15Ku_v7IqKUv-_wvVRdYcGDbFgTc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTodFSzLhy_m5U2A78qPuEma2j4BtPpCgWHo9_4oP9t_w&oe=6AF9BE6B"}, {"file_name": "Jackpot18-9.png", "id": "800787459125126", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499313086_800787462458459_6930032991117516883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuYlEk0EJTEQ7kNvwG44oS4&_nc_oc=AdrPx4w9SMsZdU-eCCRl3XJfV66i3tSyXjEXk-kckr76DO20J3HhFQHBjl98inyjxcE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ4dGpin_kSKrav8w7aNhf4wOoTEblF4F08ewcHVG6BA&oe=6AF9CA1E"}, {"file_name": "InGame_JokerSpark16-9.png", "id": "640251362471745", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308961_640251365805078_11192827138929440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iyhb_iEr6O8Q7kNvwG59Bzz&_nc_oc=Adq74xFVueEoOVQiyxdMkC2Ixarc6l985_Vj3GfS-Co8LQcEvPwj44JEcLLSaHtrhkg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVQ8cX7euUMb4l_9Ye_uEou36Km7cmp628IqF3XqZqZw&oe=6AF9DF0C"}, {"file_name": "Bingo16-9.png", "id": "1434116907874356", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820574_1434116911207689_8961654679034847196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1g-snYyCUIQ7kNvwGCt4tK&_nc_oc=AdrOvLPJjnQYTkw2QDkKLW_2JrxfQDIfynCmqIs_nb2E4wiuEKMAfy62NJcTZjd2tNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2KoDw2TmHVs9gU6ZftWFYxnYh6_TMC0gBVt0Rz-BxOA&oe=6AF9EA83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jackpot VR: Vegas Slots", "keywords": ["casino", "slots", "vegas", "jackpot", "machine"], "long_description": "\ud83c\udfb0 Step up to the slot machine in VR!\n\nJackpot VR: Vegas Slots brings the lights, reels, sounds, and virtual jackpot moments of a casino floor to Meta Quest. Pull the lever, spin themed machines, collect daily free coins, and unlock new slot worlds as you level up.\n\n\ud83d\udc8e Key Features:\n\n\ud83c\udfa1 Immersive VR Slots: Feel the reels spin, lights flash, and jackpots explode all around you!\n\n\ud83d\udcb0 Massive Wins & Daily Rewards: Log in daily for free coins, bonus spins, and mega jackpots.\n\n\ud83c\udfc6 Level Up & Unlock More: The higher you climb, the bigger the prizes - unlock premium slot worlds and special events.\n\n\ud83c\udf87 Epic Themes, Endless Thrills: From fiery phoenixes to cosmic reels, every machine is a new adventure.\n\nSoar into the spotlight, chase your dream jackpot, and make every spin count.\n\n\u2728 Jackpot VR - Spin. Win. Live the thrill. \u2728\n\nBuilt for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nJackpot VR is designed for entertainment and uses simulated gambling. It does not offer real-money gambling or cash prizes.", "short_description": "Spin Vegas-style slot machines in VR on Meta Quest. Pull the lever, claim daily free coins, unlock themed reels, and chase huge jackpots in a comfortable seated or standing casino experience. Free to play. Simulated gambling only \u2014 no real-money gambling or cash prizes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playbonkers.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Bonkers LLC", "support_website_url": null, "website_url": "https://www.playbonkers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25513561708336840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824213_662281066930853_8018887166360367741_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7zK207FPqcQ7kNvwHzDTwg&_nc_oc=Adr6J6OGKfVAgW2dc4CrLH_C4F33wf01Z0dlqZ_j-Z8OJXlUA4IrQaDUmMwzIDzgpe8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3vxTLyeR8NCdZ_8cKNNg8m5GNk5hpJRvp-9ExQ9_INQ&oe=6AF9D0D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jackpot VR: Vegas Slots", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name"
p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJpCATRFkzwQ7kNvwG87PEs&_nc_oc=AdrucgESmIQ6zmni0LU3UNrrGSdw1e_q1giQnl_v_EsitySmQ8v95ME7TK3jMLOBpHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_dI35T9ycofzghz3gTZRd5HjhayFE7ybD-cyk9tw3Ow&oe=6B103CAA"}, {"file_name": "vr_Monster_none_3.png", "id": "1458802265760678", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842257_1458802269094011_7337825035607310380_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcgi-IlLWlsQ7kNvwGI2XCJ&_nc_oc=AdrHjGTYjySesEF5ZbFB0YHXJ9bG9hYGG6n5TlCTulh_3zLzVTPGbB5iOkz42FDsNco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXuxvPDozCLe8I72uxaM3uSoxiPo6pfF8HAIMJGgz0nzQ&oe=6B1047F4"}, {"file_name": "vr_Ghost_boss_1.png", "id": "1534439268521748", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842223_1534439275188414_5342622214350318867_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0LKK9PMTswQ7kNvwHELz2j&_nc_oc=AdrVS0rpO-H046FPLe3_67h7gS1cg-Q2yYEG-dJPIf0IbDkizazjZEbBcFNyPOu7lYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHnnPxUNMxgcV13FbHzMnqiPt2JpWw6prLIUdeZjtI4A&oe=6B105236"}, {"file_name": "vr_Monster_boss_3.png", "id": "2501760057320921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842285_2501760060654254_8136096701812896569_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cK_2kiFzz1AQ7kNvwF7P8n4&_nc_oc=AdopeJwUdvXFegd3zUGqIR4bFjANVZ7h9wenv8kB8uv1-iUL8Pd8P1Ie4tB3-zgswkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW84xwW4rza9764ncnzGXff8TB3u4_NTPVdsiCj2_B2Nw&oe=6B1040C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr_Ghost_boss_2.png", "id": "1138463238588547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842183_1138463241921880_4161258710430212541_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldBQlg3RkwgQ7kNvwHbgx_C&_nc_oc=AdrRz-yQJl_cb3RUjSK_EsDYRgs4rY7nw-DQCJW3i6wNRRhLcdPdRxm8zWUlRSvnCic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9mKjlznHV6CcP629Zi-l8Ev5TIlS0kzdVWtQfWsdcVg&oe=6B105C20"}, "display_name": "Beyond Hunters", "keywords": ["horror", "ghost", "monsters", "MR", "hunt"], "long_description": "# Beyond Hunter: VR Ghost Hunter\n\nThe walls are thin, and something is on the other side.\n\n**Beyond Hunter** is a first-person VR horror shooter for Meta Quest. Ghosts, monsters and a ghostly king haunt every corridor. You have one tool to fight them: the **Ghost Catcher Gun**.\n\n## Features\n- **Immersive VR horror.** Dark halls, eerie sounds and ghosts that come through the walls.\n- **Ghost Catcher Gun.** Aim, lock on and capture ghosts instead of shooting them.\n- **Hand tracking and controllers.** Reach, grab and aim with your own hands or with Quest controllers.\n- **Varied enemies.** Fight shadow ghosts, big dark specters, monsters, zombies and the Ghost King boss.\n- **3D spatial audio.** Footsteps, whispers and growls tell you which wall a ghost is behind.\n- **Built for Quest.** Smooth, comfortable VR on Meta Quest 2, 3 and 3S.\n\n## How to play\n1. Put on your headset and pick up the Ghost Catcher Gun.\n2. Listen for ghosts moving behind the thin walls.\n3. Aim, capture and survive each wave.\n4. Take down the Ghost King.", "short_description": "Beyond Hunter is a VR horror ghost-hunting game. Grab your Ghost Catcher gun, hear the haunting through the walls, and capture ghosts before they get you.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://therationalstudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Rational Studio", "support_website_url": "https://therationalstudio.com/support", "website_url": "https://therationalstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
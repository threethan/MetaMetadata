luscdn.com/v/t64.5771-25/473391904_962809935813930_9194112112782676097_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Mlx-VblqKEQ7kNvwFshsTm&_nc_oc=AdqjPnwpnDDb6UVaMUDPJ01J-olsPHucaBZZLwekpJz_bZIOeFRhqG5B7r0RVN8BR3A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6PIE9SU0d5l_D3cHKh_c7L8mi7lyhmMDhjJ11oOXKpw&oe=6A34160A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "984708910298642", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391781_984708916965308_7727732313108669421_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RxI73ooOwQQ7kNvwFihf_G&_nc_oc=Adph7CSrWyigLi-fUVvcio31K1cciuhEw3_zXMWyDSSTPMLE5rTEpOFM9Cn1RgU5zmg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xrWOtJnsnNB2tLNTlhecPiLDZwn7i8GSDVSQ3wur0YA&oe=6A33E9EB"}, "display_name": "drift online", "keywords": ["drift", "online", "car", "multiplayer", "race"], "long_description": "# \ud83d\ude97 drift online: The Ultimate Drifting Experience\nGet behind the wheel and unleash your inner drifter! **drift online** offers:\n\n- **\u2699\ufe0f Realistic Physics:** Feel every slide, turn, and drift with precision.\n{517629961359536}\n- **\ud83c\udf0d Diverse Maps:** Stunning, challenging tracks designed for adrenaline junkies.\n{1153987482429038}\n- **\ud83d\ude97 Customizable Cars:** Choose from a variety of vehicles and make them your own.\n{1005073348211869}\n- \ud83c\udfae **Multiplayer & Singleplayer Modes:** Compete against friends or test your skills solo.\n{1140268610895551}\n\n|---------------------------|---------------------------|---------------------------|\n\n# \ud83c\udf1f Why Choose drift online?\n\n- \ud83c\udfc6 Compete with others and beat them.\n\n- \ud83d\udd13 Unlock new cars and upgrades as you progress.\n\n- \ud83c\udfa8 Immerse yourself in stunning visuals and heart-pounding action.\n\n|---------------------------|---------------------------|---------------------------|\n\n\ud83d\udc4b Join our Discord Server! : scnWY5m3Mk\n\n\ud83d\udd79\ufe0f Find friends to play with, share modifications with other players and give us feedback to make the game better!\n\n|---------------------------|---------------------------|---------------------------|\n\n\n**\ud83d\udd25 Ready to burn rubber and leave your mark? Start your engines and drift like a pro! \ud83d\ude80**\n\n# COMING SOON, WISHLIST NOW!", "short_description": "\ud83d\ude97 Experience the thrill of drifting in drift online!\n\n\ud83c\udfc1 Master challenging tracks\n\ud83d\udee0\ufe0f Customize unique cars\n\ud83c\udfae Compete in multiplayer or singleplayer modes\n\ud83c\udf0d Stunning maps and realistic physics\n\ud83d\udd25 Are you ready to slide into action?"}]}, "developer_name": "An\u0131l Ta\u015f", "developer_privacy_policy_url": "https://www.basit.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "basit games", "support_website_url": null, "website_url": "https://www.basit.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9448215801973745"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "979319438344064"}, {"status": "PUBLISHED", "id": "1116976803929308"}, {"status": "PUBLISHED", "id": "676341612146795"}, {"status": "PUBLISHED", "id": "172201
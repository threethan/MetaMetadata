|---------------------------|---------------------------|---------------------------|\n\n\n**\ud83d\udd25 Ready to burn rubber and leave your mark? Start your engines and drift like a pro! \ud83d\ude80**\n\n# COMING SOON, WISHLIST NOW!", "short_description": "\ud83d\ude97 Experience the thrill of drifting in drift online!\n\n\ud83c\udfc1 Master challenging tracks\n\ud83d\udee0\ufe0f Customize unique cars\n\ud83c\udfae Compete in multiplayer or singleplayer modes\n\ud83c\udf0d Stunning maps and realistic physics\n\ud83d\udd25 Are you ready to slide into action?"}]}, "developer_name": "An\u0131l Ta\u015f", "developer_privacy_policy_url": "https://www.basit.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "basit games", "support_website_url": null, "website_url": "https://www.basit.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9448215801973745"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1116976803929308"}, {"status": "PUBLISHED", "id": "676341612146795"}, {"status": "PUBLISHED", "id": "1722017818707100"}, {"status": "PUBLISHED", "id": "563000086828133"}, {"status": "PUBLISHED", "id": "1031923098850074"}, {"status": "PUBLISHED", "id": "1393165021675250"}]}, "baseline_offer": {"id": "1393165021675250"}, "is_a
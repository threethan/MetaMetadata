-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHkk2LIS7BJ-4z6E1f1chB5v81MrPU4sYc2QjLeKK3JQ&oe=6B0478B2"}, {"file_name": "SS_4.png", "id": "28440780898870062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_28440780908870061_2660213938725282058_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYy6ArQu42sQ7kNvwHi5t98&_nc_oc=AdovkJn4JMtgO-JE9clJgH-b5_EnLwa5BbxdZOjgyXGZbWtIHW4b_v8zXPlKO0v43zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvis_5Asz8TO38NwGeWDtYnh1i3CoTKxTaknQ0Uz6YBw&oe=6B0471FF"}, {"file_name": "SS_5.png", "id": "962809932480597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391904_962809935813930_9194112112782676097_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iDof8Wrp9UQ7kNvwFMV1XX&_nc_oc=AdqH5Nd-GM6MQmssTskcPMuMjde-mXf3CT7cGhjiLcRnoahbgBVM7pNVqTx-CNT9bjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWltZMUxes8pW6n933G4wqpdBEe22vHUKstO_ea-dSQA&oe=6B04630A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "984708910298642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_984708916965308_7727732313108669421_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OqYcTAnOYIQ7kNvwF5Syp3&_nc_oc=Adof6kREkKZjva8m38rOTF4srVSAgPiTVhWLDlLQZ_oCxxte0ZAJC0G8XbFUN4xL9O8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa05t4a-Qb5uurRQXiPVj0m2NVoEAkoQvzLhJiuyNEpA&oe=6B046F2B"}, "display_name": "drift online", "keywords": ["drift", "online", "car", "multiplayer", "race"], "long_description": "# \ud83d\ude97 drift online: The Ultimate Drifting Experience\nGet behind the wheel and unleash your inner drifter! **drift online** offers:\n\n- **\u2699\ufe0f Realistic Physics:** Feel every slide, turn, and drift with precision.\n{517629961359536}\n- **\ud83c\udf0d Diverse Maps:** Stunning, challenging tracks designed for adrenaline junkies.\n{1153987482429038}\n- **\ud83d\ude97 Customizable Cars:** Choose from a variety of vehicles and make them your own.\n{1005073348211869}\n- \ud83c\udfae **Multiplayer & Singleplayer Modes:** Compete against friends or test your skills solo.\n{1140268610895551}\n\n|---------------------------|---------------------------|---------------------------|\n\n# \ud83c\udf1f Why Choose drift online?\n\n- \ud83c\udfc6 Compete with others and beat them.\n\n- \ud83d\udd13 Unlock new cars and upgrades as you progress.\n\n- \ud83c\udfa8 Immerse yourself in stunning visuals and heart-pounding action.\n\n|---------------------------|---------------------------|---------------------------|\n\n\ud83d\udc4b Join our Discord Server! : scnWY5m3Mk\n\n\ud83d\udd79\ufe0f Find friends to play with, share modifications with other players and give us feedback to make the game better!\n\n|---------------------------|---------------------------|---------------------------|\n\n\n**\ud83d\udd25 Ready to burn rubber and leave your mark? Start your engines and drift like a pro! \ud83d\ude80**\n\n# COMING SOON, WISHLIST NOW!", "short_description": "\ud83d\ude97 Experience the thrill of drifting in drift online!\n\n\ud83c\udfc1 Master challenging tracks\n\ud83d\udee0\ufe0f Customize unique cars\n\ud83c\udfae Compete in multiplayer or singleplayer modes\n\ud83c\udf0d Stunning maps and realistic physics\n\ud83d\udd25 Are you ready to slide into action?"}]}, "developer_name": "An\u0131l Ta\u015f", "developer_privacy_policy_url": "https://www.basit.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "basit games", "support_website_url": null, "website_url": "https://www.basit.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQ
71-25/75258663_1276534363400925_3618444521516028275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4NoEFgaVXoQ7kNvwFnnbMu&_nc_oc=Adlyy-H4sKAapQUmoueZaLUBTueDh6fY79Fxxu0BMBcrkIHK4SUswOMwx4OtS9AvMN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftkParLco7rO1oYOkE4xvM0b8gI5jZ9Pnl6bHS2tWWprQ&oe=699EDE83"}, {"file_name": "Open_Loot_Launcher_Images_Game_Screenshot_1.png", "id": "1304271617144608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_1304271620477941_8715421094877542743_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWTu1zssR8IQ7kNvwE6CGRS&_nc_oc=Admqd-wT5Mwg4RwoWzmTe8Bo_2-vq-OkF_slnLFBSRwkoUi2PkfnzUf590Ssnl50dJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsInfB3hFw5hslf_5zD4f55KGWBkkBg1a2CgV4lLPm8zA&oe=699EFF49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Epic_Store_Images_1440.png", "id": "612536001100311", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75330721_612536004433644_4335221421975648104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YurNsh8oUAkQ7kNvwF3-aYH&_nc_oc=Adlv0tl0By2ttrkGBTKbb5QRC_97TnZFnLzH9xge5HBwYQXjVz9rwQ8Ygyw0GDqCv4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuWuRbZsqtlS_i0niqlW7ZyTsNsOADsty9jmeSS6W42cw&oe=699ED5A7"}, "display_name": "BOSS FIGHTERS", "keywords": ["pvp", "fps", "shooter", "coop", "action"], "long_description": "BOSS FIGHTERS is not just another VR game\u2014it's where chaos, creativity, and competitive spirit collide! Step into the massive shoes of the Boss, a VR-powered giant with one mission: wreak havoc! Meanwhile, real PC players, the nimble Fighters, are out to take you down in this wild, cross-platform showdown.\n\nIn the world of BOSS FIGHTERS, strategy meets pure mayhem. Toss Fighters into pits of bubbling toxic lava, slam them with oversized rubber ducks, or create your own path to victory with out-of-the-box tactics! Your playground, your rules.\n\n\ud83d\udd25 What Makes BOSS FIGHTERS Unstoppable?\n\nVR vs. PC Chaos: Play as the towering Boss in VR, or join as a Fighter on PC\u2014two worlds clashing in epic arena battles!\n\nWacky Weapons & Insane Arenas: Toxic lava pools? Check. Giant rubber ducks? Double check. In BOSS FIGHTERS, creativity is your best weapon.\n\nFree-to-Play & Early Access: Dive in for free and be part of shaping the game from the ground up!\n\nWhether you're crushing everything in sight as the Boss or scheming with your team as a Fighter, BOSS FIGHTERS is the ultimate test of strategy, skill, and a little bit of crazy. Are you ready to play big? \ud83c\udf0b\ud83e\udd86", "short_description": "Join BOSS FIGHTERS, a thrilling gaming show where VR bosses and PC fighters lock horns in futuristic battles. Showcase your skills in an arena where every fight is a spectacle for glory and fame. Compete for loot and ranks in this high-octane gladiator challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://telegra.ph/Privacy-Policy-for-Boss-Fighters-10-08", "developer_terms_of_service_url": null, "publisher_name": "Pixward Games", "support_website_url": null, "website_url": "https://bossfighters.game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8713519858761479"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1858837154874081"}, {"status": "PENDI
ri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258663_1276534363400925_3618444521516028275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqw7U2QfEM4Q7kNvwFMZwzh&_nc_oc=Adobdqd3LB0kERqh0L9EqoXedbwnNZmnoSLv_AeZIX3ATsAU1MTDXTygA0PllLuzgvc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06WQMFruxUwMwjKBFTOSiw2PLtV5JYCRORO8_PyiGF1w&oe=69F1ED03"}, {"file_name": "Open_Loot_Launcher_Images_Game_Screenshot_1.png", "id": "1304271617144608", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974469_1304271620477941_8715421094877542743_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUCxtqAZsbAQ7kNvwGNx5OR&_nc_oc=AdopojYdNXRUSv0KY79isHTgVlp-hMaW3Pmio8IOyZlTzgHYhQ2uWOhTTu7feokAD_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3z_BTRsYlx1cmYc58LOlQfVN0qkZ35BpeIxycpxXBKuA&oe=69F20DC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Epic_Store_Images_1440.png", "id": "612536001100311", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75330721_612536004433644_4335221421975648104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nM0me91lp6kQ7kNvwGYLZ0x&_nc_oc=Adoaa5qkXQAGkphevmfi0cpNCOXD4MOkwKrAT5P2ZFm_DL65RIWI4HueSMFxbYzoK2k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Q_LcHDO7OEjNN7vnGmDVEZ84Vi59NyT5hZhuozHEILQ&oe=69F1E427"}, "display_name": "BOSS FIGHTERS", "keywords": ["pvp", "fps", "shooter", "coop", "action"], "long_description": "BOSS FIGHTERS is not just another VR game\u2014it's where chaos, creativity, and competitive spirit collide! Step into the massive shoes of the Boss, a VR-powered giant with one mission: wreak havoc! Meanwhile, real PC players, the nimble Fighters, are out to take you down in this wild, cross-platform showdown.\n\nIn the world of BOSS FIGHTERS, strategy meets pure mayhem. Toss Fighters into pits of bubbling toxic lava, slam them with oversized rubber ducks, or create your own path to victory with out-of-the-box tactics! Your playground, your rules.\n\n\ud83d\udd25 What Makes BOSS FIGHTERS Unstoppable?\n\nVR vs. PC Chaos: Play as the towering Boss in VR, or join as a Fighter on PC\u2014two worlds clashing in epic arena battles!\n\nWacky Weapons & Insane Arenas: Toxic lava pools? Check. Giant rubber ducks? Double check. In BOSS FIGHTERS, creativity is your best weapon.\n\nFree-to-Play & Early Access: Dive in for free and be part of shaping the game from the ground up!\n\nWhether you're crushing everything in sight as the Boss or scheming with your team as a Fighter, BOSS FIGHTERS is the ultimate test of strategy, skill, and a little bit of crazy. Are you ready to play big? \ud83c\udf0b\ud83e\udd86", "short_description": "Join BOSS FIGHTERS, a thrilling gaming show where VR bosses and PC fighters lock horns in futuristic battles. Showcase your skills in an arena where every fight is a spectacle for glory and fame. Compete for loot and ranks in this high-octane gladiator challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://telegra.ph/Privacy-Policy-for-Boss-Fighters-10-08", "developer_terms_of_service_url": null, "publisher_name": "Pixward Games", "support_website_url": null, "website_url": "https://bossfighters.game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8713519858761479"}}]}, "scheduled_offers": 
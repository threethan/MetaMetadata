e_name": "Open_Loot_Launcher_Images_Game_Screenshot_3_bl.png", "id": "1276534360067592", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75258663_1276534363400925_3618444521516028275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkJw71lk9DQQ7kNvwHUgAXT&_nc_oc=AdoMYcO6P6u6VH8QtxFuaIxJd1z4Lk-uZ7B9j1pdIzFsfVnl-YC1Tamv3TZ7JUqI9J0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65vdPUZX3VzJb18AVAl-09DEZ_c2C_AbvSygSJaAWzTA&oe=6A1DA6C3"}, {"file_name": "Open_Loot_Launcher_Images_Game_Screenshot_1.png", "id": "1304271617144608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_1304271620477941_8715421094877542743_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smqykYojv5cQ7kNvwHjNK8p&_nc_oc=AdrDFA5EooFKjqkF4RTBxs9dQIFYL-CkC-QqqgY56W9ENqTI4PAFrFT_4TDg7TiyEaM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q2aZPVxEmvaafRbTjgFSnQeqZ2VixVhZxZ5NX2Qcmvg&oe=6A1D8F49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Epic_Store_Images_1440.png", "id": "612536001100311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75330721_612536004433644_4335221421975648104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQy8ibHhg0YQ7kNvwEWvo0r&_nc_oc=AdrzOMbDzCFu33PMt5LVKcgIr4dpdL8mnPrJ_NimwJrHsCrMxjBh3K4W6m-08pXmZr8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F4zb9wp2LertEm0wIbM7VI-Woj1ld9KRdB-WNl3QHyg&oe=6A1D9DE7"}, "display_name": "BOSS FIGHTERS", "keywords": ["pvp", "fps", "shooter", "coop", "action"], "long_description": "BOSS FIGHTERS is not just another VR game\u2014it's where chaos, creativity, and competitive spirit collide! Step into the massive shoes of the Boss, a VR-powered giant with one mission: wreak havoc! Meanwhile, real PC players, the nimble Fighters, are out to take you down in this wild, cross-platform showdown.\n\nIn the world of BOSS FIGHTERS, strategy meets pure mayhem. Toss Fighters into pits of bubbling toxic lava, slam them with oversized rubber ducks, or create your own path to victory with out-of-the-box tactics! Your playground, your rules.\n\n\ud83d\udd25 What Makes BOSS FIGHTERS Unstoppable?\n\nVR vs. PC Chaos: Play as the towering Boss in VR, or join as a Fighter on PC\u2014two worlds clashing in epic arena battles!\n\nWacky Weapons & Insane Arenas: Toxic lava pools? Check. Giant rubber ducks? Double check. In BOSS FIGHTERS, creativity is your best weapon.\n\nFree-to-Play & Early Access: Dive in for free and be part of shaping the game from the ground up!\n\nWhether you're crushing everything in sight as the Boss or scheming with your team as a Fighter, BOSS FIGHTERS is the ultimate test of strategy, skill, and a little bit of crazy. Are you ready to play big? \ud83c\udf0b\ud83e\udd86", "short_description": "Join BOSS FIGHTERS, a thrilling gaming show where VR bosses and PC fighters lock horns in futuristic battles. Showcase your skills in an arena where every fight is a spectacle for glory and fame. Compete for loot and ranks in this high-octane gladiator challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://telegra.ph/Privacy-Policy-for-Boss-Fighters-10-08", "developer_terms_of_service_url": null, "publisher_name": "Pixward Games", "support_website_url": null, "website_url": "https://bossfighters.game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
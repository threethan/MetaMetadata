le_name": "Screenshot4.png", "id": "738271468788422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299808_738271472121755_2227204298694124742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3XQMtxin1MQ7kNvwHXNaHu&_nc_oc=Adq2W_3Ace9zYMMLzoq7_TZfmPQwpFRUaWiUP1MlPBJbsoF237JWibKTD1wYBUHKaPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn6T6e5bxKiF-jmeBsRE5tcjefNSnMjGdomReQ56OUHA&oe=6A8468F4"}, {"file_name": "MovementChallengesScreenshot.png", "id": "1341221197778569", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820387_1341221201111902_2240034557384987294_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3vPOKEQ0JsQ7kNvwGJUcG_&_nc_oc=Adp-x8fj2deZYzttViu37JaJ1gow9zvAtG1Q9rmzfE-4P4aGjbXmbXihkT8JCu6McR0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF974QcwAE1bYOuv15fPOSCp0255IXEMVUyAL5IFI-fOA&oe=6A84634E"}, {"file_name": "Screenshot2.png", "id": "2070341763492140", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818938_2070341766825473_5597481281868549590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBmlxBdagxwQ7kNvwHhkeSr&_nc_oc=Adp9tKQbnmJnJIYFOu-0WUqsllbuW1eUr2jzdM9QmEzZuXyoZqgemVjpM65BuSysqmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe3x4PPhxCwCZyAhy8y8GI76_Av69umY8sB_ey4AZlAg&oe=6A8461F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape16-9.png", "id": "1031230112392360", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819396_1031230115725693_652739831860027248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMUBLfwPk7YQ7kNvwF84P32&_nc_oc=AdqI01RMJOI8E0wFKUAVnntisL_xo1JT8Sn6ujmsomxqpxbE2Misyosr94yOVICYXiM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExtzT963qBKyJOj0HAn0Vo20PHKjxMbjFdOMtyphYiYQ&oe=6A84390D"}, "display_name": "Walkaaos", "keywords": ["Action", "Intense", "Roguelite", "Arena", "Chaos"], "long_description": "# \ud83d\udfe8 Dominate the arena! \ud83d\udfe8\n\nWalkaaos ['val'k\u0251:os] is a tower where each floor is procedurally generated from unique drone combinations, traps and over 200 arena layouts.\n\nEnemies and arenas become tougher as you climb towards the final challenge at the top.\n\n{1584476446091855}\n\n# \ud83d\udfe7 Method to this madness! \ud83d\udfe7\n\nWalkaaos balances high-intensity action with approachable gameplay mechanics. Challenges are intentionally compact, letting you make real progress in just a few minutes of play.\n\nPermanent progression lets you keep new equipment, checkpoints and perks. Future runs give you more control on where you start in the tower and which perk builds you'll bring.\n\nThe whole experience is seamless. You can go from the lobby all the way to the end of the tower, fighting through every arena without any loading screens or noticeable hitches.\n\n{1571979600521285}\n\n# \ud83d\udfeb Play your way! \ud83d\udfeb\n\n20+ weapons and gadgets for all ranges, dealing status effects, boosting movement etc. Equipment is designed to feel intuitive and simple to use, yet each piece still brings its own functional twist to the game.\n\nMultiple perks like damage up, movement enhance, faster bullets, faster charging, bigger explosions, counter damage, health and healing to support various playstyles.\n\nExtra game modes to have fun, gain progression and learn mechanics in. Arena-based game modes switch up rules and break limits of the main arena, while movement challenges focus on using movement to get through time-trials.\n\n{2051922118920156}\n\n\ud83d\udc9b More coming with a steady stream of content updates. \ud83d\udc9b", "short_description": "Fast and chaotic shooter with roguelite elements. Fight drones in procedurally generated challenges. Play your way with various equipment and perk combinations. Explore other game modes that bend the rules of the main arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/immortalpiginteractive/privacy-policies/walkaaos-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immortal Pig Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/immortalpiginteractive/walkaaos", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27175614325383234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308131_2240364389731964_7593436664303353108_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4QZ757iFNQQ7kNvwGQe8Pm&_nc_oc=AdoYPfzkxfEZi2aA707pWyliGjyw92Q4VpOECPyvWzFSTAEI8Z2lekJPdQXExQME5Lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4JAGdrTM71x4pDHKrH53-avXU-sH6EJSHrCD1pg-Ytg&oe=6A843D67"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Walkaaos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1752854220, "lastRevision": {"nodes": [{"id": "7996741887030432", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7996741850363769", "is_first_party": false
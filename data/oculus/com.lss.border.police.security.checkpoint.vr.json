491766927_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtQVHqJwDqUQ7kNvwFjH5Md&_nc_oc=Adq51Iulcw9XBMR7wT6bHJIw8QiGZs1WPH7vsvcfXk3VylNa6YFsxvvxE7u56beaj6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPCnqmhlAYqT4Q8_yXGQjrbC69EbENM3PtB8QAIkwnWg&oe=6AF89ADA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Border Police Security Checkpoint VR", "keywords": ["BorderPolice", "PoliceSecurity", "BorderPoliceSecurity", "BorderPoliceCheckpoint", "BorderPoliceVR"], "long_description": "Border Police Security Checkpoint VR puts you in the role of a border police officer working at a busy security checkpoint. Inspect vehicles, check travelers, verify documents, and stay alert for suspicious activity.\n\nIn Border Police Security Checkpoint VR, you will complete three different border police levels, each featuring different security situations and objectives. Carefully inspect vehicles and travelers before deciding who can safely pass through the checkpoint.\n\nBorder Police Security Checkpoint VR challenges your observation and decision-making skills. Check documents, investigate suspicious behavior, and make the right decisions while keeping the border secure.\n\nAs you progress through Border Police Security Checkpoint VR, each level introduces new situations and challenges. Pay attention to every detail and complete your assigned security missions.\n\nThe game also includes a dedicated Shooting Level, where the situation changes from security checking to action. Stay alert, respond to threats, and complete the shooting mission successfully.\n\nBorder Police Security Checkpoint VR combines police simulation, border security, vehicle inspection, document checking, investigation, and action gameplay into an immersive VR experience.\n\nWith Border Police Security Checkpoint VR, every vehicle and traveler can bring a new challenge. Inspect carefully, identify suspicious activity, and make quick decisions to complete your missions.\n\nThe three border police levels provide di", "short_description": "Border Police Security Checkpoint VR puts you in the role of a border police officer. Inspect vehicles, check documents and travelers, identify suspicious activity, complete three security levels, and take on an intense shooting mission."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lightspeedstudio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Light Speed Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/lightspeedstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1267540033119964"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1407420317775400"}, {"status": "PUBLISHED", "id": "1107287615132182"}]}, "baseline_offer": {"id": "1407420317775400"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792357080, "status": "PUBLISHED", "id": "1407420317775400"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1279077221966245", "version": "1.1"}, "id": "2879249545792912", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application":
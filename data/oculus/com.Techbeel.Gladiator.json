=1-7&_nc_sid=6e7a0a&_nc_ohc=nwyu8HH_y3wQ7kNvwGFD8cz&_nc_oc=AdoE7Vjv5hATTNKhnQivHk0FBu4lrzzRW3JNvX0eWWcV4w_YclQCRIulFzK_6Ho-Cr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpkyXDVICaRFvq2qlS0rOUdhOMUxN76SluN7FL4j-Z8A&oe=6AF89392"}, {"file_name": "6.png", "id": "1424432226493697", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1424432229827030_3169906440777974698_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuKGrD48OhAQ7kNvwEatDal&_nc_oc=Adr0yJuPd90VJfxWPu6nm1fQ-LeB2KeUCrSFvG15L9M0V03ZwBrif1zaApIzlO3PrNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRal1zeOt5b3kNXJj6qeuxiS3tDxV30CeZ0BFS3q2ihKQ&oe=6AF8AB65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arena of Titans", "keywords": ["VRGladiator", "VRSwordFighting", "GladiatorCombat", "VRArenaBattle", "SwordCombat"], "long_description": "Step into the arena and fight for glory in Arena of Titans, a virtual reality gladiator game built for Meta Quest.\n\nYou are a gladiator. The crowd is roaring, the sand is hot and your opponent is waiting. Every fight is a one-on-one duel where your own movements become your attacks and defence. Swing your sword, raise your shield and read your rival's moves to find the opening that wins the fight.\n\nCLIMB THE ARENA\nArena of Titans is played across multiple levels. Each level brings a new opponent, and every opponent is stronger, faster and more aggressive than the last. Win to advance, learn from every defeat and keep pushing until you stand as the champion of the arena.\n\nFIGHT WITH YOUR WHOLE BODY\nCombat is fully physical. Attack, block and defend in real time with your controllers. Timing and awareness matter more than button mashing, so every victory feels earned.\n\nFEATURES\n- Gladiator combat built for virtual reality on Meta Quest\n- One-on-one sword and shield duels in an immersive colosseum\n- Multiple levels with a stronger opponent at every stage\n- Motion-driven fighting that rewards timing and defence\n- Quick fights for short sessions or long runs through the levels\n\nDo you have what it takes to defeat every challenger and become a Titan?\n\nArena of Titans is intended for players aged 13 and older.", "short_description": "Step into the arena as a gladiator. Fight one-on-one VR duels with sword and shield, defeat each rival and face a stronger opponent every level until you become a Titan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.techbeel.com/games/arena-of-titans/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Techbeel", "support_website_url": null, "website_url": "http://techbeel.com/games/arena-of-titans", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1426149590571250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628875_1484152780477803_491577193348054011_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRdAtozbFasQ7kNvwHGu7_J&_nc_oc=AdqvGG7lA3CPHWaqwHdx8TT9Zb8F1j4dp_RS4nRglCzhToFJOc7whYSLPhp9esvvM0w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD5Gz-LZZ2kMGu_0aU75rvQD_T4b1LptKqQwtduBEi0Q&oe=6AF8801F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
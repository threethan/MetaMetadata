csvn5AQ7kNvwGdZ7Rv&_nc_oc=AdlDoghTxogR18bRpRSj_1sdU2SIRQpcJDL7c-zD0Pf9c7ejM0e08j8Fpqccy_Y4ftY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs2FJe10bMGX0C5j9-0ByZ6bnBvDeN0W2Q_iY2dxpNZWQ&oe=69A5A097"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "anatomyXR", "keywords": ["anatomyXR", "Anatomy"], "long_description": "AnatomyXR is an immersive 3D human anatomy learning experience built for Meta Quest. Designed for students, educators, and medical professionals, AnatomyXR allows users to explore the human body in stunning detail\u2014from skeletal structure to organs, muscles, and beyond.\nNavigate through anatomically accurate systems, isolate body parts, and interact with models using hand tracking or controllers. Whether you're studying for exams, teaching in a classroom, or conducting advanced surgical planning, AnatomyXR offers a powerful and intuitive way to understand the complexity of human anatomy.\n\nFeatures include:\n* Fully interactive 3D anatomical models\n* Multiple body systems (skeletal, muscular, nervous, etc.)\n* Explode view, labeling, and fade-in/fade-out effects\n* Support for both controllers and hand tracking\n* Compatible with Quest 2, Quest Pro, and Quest 3\nStep inside the human body and experience learning like never before.", "short_description": "Explore the human body in immersive 3D with AnatomyXR on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://metamix.tech/anatomyxr/terms-conditions", "developer_terms_of_service_url": null, "publisher_name": "Metamix Technologies", "support_website_url": null, "website_url": "http://metamix.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEME
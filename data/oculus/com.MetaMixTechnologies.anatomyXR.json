ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwfmyNHbOAsQ7kNvwFnn2xY&_nc_oc=Adr3WCCukG5n56lgDDUoJykPVRL3oLsodpYNbF62aszNl5tSvZy5gSwmhJyCV0HAEhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz_ydNCNi6p6DohMlIZslh-xkT67vItVK0isKhqvdfwg&oe=6B09AF55"}, {"file_name": "5.png", "id": "568697222934730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296397_568697226268063_3035396994909559095_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9ZhEPeJSIIQ7kNvwG4cxxo&_nc_oc=AdrrQ2_xL3iX2lk3p_N3kMJRmJ1df3LkLheiaHCixrJN-u3Dp6kDYsMaH4zBCZbCuQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKUstr6ZGUnIDhlcK5xQU9WkBNW-eGKi33HQyi25dSig&oe=6B09CDD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "anatomyXR", "keywords": ["anatomyXR", "Anatomy"], "long_description": "AnatomyXR is an immersive 3D human anatomy learning experience built for Meta Quest. Designed for students, educators, and medical professionals, AnatomyXR allows users to explore the human body in stunning detail\u2014from skeletal structure to organs, muscles, and beyond.\nNavigate through anatomically accurate systems, isolate body parts, and interact with models using hand tracking or controllers. Whether you're studying for exams, teaching in a classroom, or conducting advanced surgical planning, AnatomyXR offers a powerful and intuitive way to understand the complexity of human anatomy.\n\nFeatures include:\n* Fully interactive 3D anatomical models\n* Multiple body systems (skeletal, muscular, nervous, etc.)\n* Explode view, labeling, and fade-in/fade-out effects\n* Support for both controllers and hand tracking\n* Compatible with Quest 2, Quest Pro, and Quest 3\nStep inside the human body and experience learning like never before.", "short_description": "Explore the human body in immersive 3D with AnatomyXR on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://metamix.tech/anatomyxr/te
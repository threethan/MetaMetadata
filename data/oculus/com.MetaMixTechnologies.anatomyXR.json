": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296397_568697226268063_3035396994909559095_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLgStzKzmb8Q7kNvwGajcPr&_nc_oc=AdqG_fkJG6X4JbQ0kl7wnLKuadR3u5Q9546_QLqD86eCLhCsoWK96Hqcx58_4CeKgEM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAyG29svWGyZBIW6T0e_zBMle8q_ltWVBtlvQy6PA9KA&oe=6A71F917"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "anatomyXR", "keywords": ["anatomyXR", "Anatomy"], "long_description": "AnatomyXR is an immersive 3D human anatomy learning experience built for Meta Quest. Designed for students, educators, and medical professionals, AnatomyXR allows users to explore the human body in stunning detail\u2014from skeletal structure to organs, muscles, and beyond.\nNavigate through anatomically accurate systems, isolate body parts, and interact with models using hand tracking or controllers. Whether you're studying for exams, teaching in a classroom, or conducting advanced surgical planning, AnatomyXR offers a powerful and intuitive way to understand the complexity of human anatomy.\n\nFeatures include:\n* Fully interactive 3D anatomical models\n* Multiple body systems (skeletal, muscular, nervous, etc.)\n* Explode view, labeling, and fade-in/fade-out effects\n* Support for both controllers and hand tracking\n* Compatible with Quest 2, Quest Pro, and Quest 3\nStep inside the human body and experience learning like never before.", "short_description": "Explore the human body in immersive 3D with AnatomyXR on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://metamix.tech/anatomyxr/terms-conditions", "developer_terms_of_service_url": null, "publisher_name": "Metamix Technologies", "support_website_url": null, "website_url": "http://metamix.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics"
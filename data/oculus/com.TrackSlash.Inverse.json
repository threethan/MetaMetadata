20f&oh=00_AQJC8J48NDXcNjQq5csB41e7KAEXFUOPTPWcFGDjsiXEnw&oe=6AA95B8E"}, {"file_name": "migrated_image.png", "id": "550105845627277", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974599_2677787642447200_5763789529332842496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j17pA1D1HQYQ7kNvwHFVeKK&_nc_oc=AdoMYnGF_hLxXgNR3pTsHbIpuoGOVrQLLBUpQxjqoU2uj4bxSn9xcW1AwGub92Dl51A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrfKjL2BxAybpBSSa7nc5PS7ZquLTfRkrYiWT0kVStVA&oe=6AA94278"}, {"file_name": "migrated_image.png", "id": "207081050395661", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001695_229810127889961_8360857172623491072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDfeSpSryqkQ7kNvwFHJu6Z&_nc_oc=Adp13b0TTXRLCeuPgH7oz0U_HE6dBrU2cBkFhrfThEmxT2z_A9JBLwqGo7XQeQbRUuw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwKKOzgwwEAAEFZZc-Q_BSfqbXY8IObVXJpSRQGVWkxw&oe=6AA944BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZvTBYu", "id": "480592289121588", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974596_480592292454921_742367174215073792_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o02rE7vqWRwQ7kNvwGgTBLF&_nc_oc=AdogzTTymLPXJDB4ezAqAwh6xGjfHVaD9dhOtcRrOxl_okPMWEMy8Ds7q7-z9qZMA2E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPx9LfYx9XSXYE1stgIcXQWOZCzvFx29Vq0yPexCoUfA&oe=6AA93638"}, "display_name": "Track Slash", "keywords": ["rhythm", "beat", "audio", "music", "sword"], "long_description": "Track Slash is a rhythm game built for virtual reality. Use your motion controller to swing your blade and slash the incoming cubes to the rhythm of numerous different songs and three distinct difficulties. \n\nFeatures:\n    - Precise Blade Control: Actually swing your motion controller to swing your Track Slash blade instead of simply pressing buttons.\n    - Handmade Levels: No automatically generated levels here. Each track and difficulty has been handmade to deliver the ultimate rhythmic experience.  \n    - Leaderboards: Fight your way to the top and become the best Track Slasher in the world. Higher difficulties provide higher scores, so get your practice in. \n    - Growing Library Of Songs: Track Slash's already diverse library of songs is updated and added to on a regular basis - keep a look out for new levels!", "short_description": "Track Slash is a rhythm game built from the ground up for mobile virtual reality. Use your motion controller to swing your blade and slash the incoming cubes to the rhythm of numerous different songs and three distinct difficulties. \n\nWith worldwide leaderboards, an ever-growing library of songs, and immersive, motion-controlled blade swinging, Track Slash delivers the ultimate VR rhythm game experience."}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Inverse Games", "support_website_url": null, "website_url": "https://twitter.com/TrackSlash", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3199919006918189"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1963591900374681", "version": "1.2.9"}, "id": "2291630950881953", "channel_name": "LIVE"}]}
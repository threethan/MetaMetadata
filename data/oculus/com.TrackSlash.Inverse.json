20f&oh=00_Af8ID692JxRfBJzPXSxG0v8WnWBja-AukJtJJ11itbhzVw&oe=6A394C0E"}, {"file_name": "migrated_image.png", "id": "550105845627277", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974599_2677787642447200_5763789529332842496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg1HJewntDcQ7kNvwEGS-YN&_nc_oc=AdrnGTTVxP6cgSlpp5J-X3je7RfjvIaavpExHMMzYIPjiPeDQQJ4r7C3FljJEIlm1ps&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h5IXTTalnyN1NUjTFgWTmYM3rFz2qRv4ON_Wed9gjMQ&oe=6A3932F8"}, {"file_name": "migrated_image.png", "id": "207081050395661", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001695_229810127889961_8360857172623491072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jQ00JwaikEQ7kNvwFDF5cL&_nc_oc=AdoLPkb9oIEcKJ92rWUMg_jiyRKzW_66RdfvbXZF69pNWrezEe-lbVr3BTcw26h5bOc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--oIOxF54g9rtwQzTLwE5eDu4PHYGZnErAOHvUsQr93Q&oe=6A39353F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZvTBYu", "id": "480592289121588", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974596_480592292454921_742367174215073792_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIXxu1MynEgQ7kNvwEgcJ2U&_nc_oc=AdrmXMgwacQ2C4IkUjDW3uHIYO1llrUbve8irCLCraI7vUxUJh9b_cght4Fcf5LOSFA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EOlovp_xJ7XewPXto5x5p71yminV4pAr0FG1HYN-BqQ&oe=6A395EF8"}, "display_name": "Track Slash", "keywords": ["rhythm", "beat", "audio", "music", "sword"], "long_description": "Track Slash is a rhythm game built for virtual reality. Use your motion controller to swing your blade and slash the incoming cubes to the rhythm of numerous different songs and three distinct difficulties. \n\nFeatures:\n    - Precise Blade Control: Actually swing your motion controller to swing your Track Slash blade instead of simply pressing buttons.\n    - Handmade Levels: No automatically generated levels here. Each track and difficulty has been handmade to deliver the ultimate rhythmic experience.  \n    - Leaderboards: Fight your way to the top and become the best Track Slasher in the world. Higher difficulties provide higher scores, so get your practice in. \n    - Growing Library Of Songs: Track Slash's already diverse library of songs is updated and added to on a regular basis - keep a look out for new levels!", "short_description": "Track Slash is a rhythm game built from the ground up for mobile virtual reality. Use your motion controller to swing your blade and slash the incoming cubes to the rhythm of numerous different songs and three distinct difficulties. \n\nWith worldwide leaderboards, an ever-growing library of songs, and immersive, motion-controlled blade swinging, Track Slash delivers the ultimate VR rhythm game experience."}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Inverse Games", "support_website_url": null, "website_url": "https://twitter.com/TrackSlash", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3199919006918189"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1963591900374681", "version": "1.2.9"}, "id": "2291630950881953", "channel_name": "LIVE"}]}
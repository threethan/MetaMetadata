3aSoDXdkdMRwrZjEnl2Ar2RAWC4KtttaEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDva2OvuyhOiSc2-FphRW1_Ls1EeN_R5ow6KH5D5P5Fw&oe=6A9EB0A8"}, "display_name": "Candy Lane Ride VR", "keywords": [], "long_description": "Hop aboard this sweet adventure on a candy-themed VR train ride and experience eleven and a half minutes of fun through a vibrant 3D world of candies, playful architecture, and animated surprises.\n\nThe train takes flight, gliding through rooms of playful bouncing balls, passing through Candy Lane air traffic, and plunging into a breathtaking drop to the third level.\n\nFeatures\n\nCandy-themed VR ride with three unique maps\nColorful environments, sweets, and animated surprises\nA gentle, scenic train ride through a candy world\n\nTake a break and enjoy a magical ride full of candies, colors, and fun.", "short_description": "Candy\u2011themed vr train ride through a scenic colorful world with animated surprises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/landraysstudio/home", "developer_terms_of_service_url": null, "publisher_name": "Land Rays Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/landraysstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34947218791593233"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2
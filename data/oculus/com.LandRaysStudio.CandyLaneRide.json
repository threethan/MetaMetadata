n.com&_nc_ss=7f20f&oh=00_AQI5D8nvo1hqfP-cV9ZGrx7Z_PbIp5wgJJfWSbllFQt1fg&oe=6AAE8573"}, {"file_name": "Image Sequence_028_0000.png", "id": "1006487605382268", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619159_1006487608715601_6804733247972693860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQxxotcHS1wQ7kNvwFcXLN1&_nc_oc=Adrw8t4P49PyeJfy0o_5Q47y8wXVHpxT2wMyw0UUGTZfuA7bZWjvYIBJ0WDm_vyPBpk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5uIudTZi3PlugyKf4SRhxR7xMvNmEl7EhERfP0797jw&oe=6AAEAA1D"}, {"file_name": "Image Sequence_009_0000.png", "id": "3164002907094325", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618277_3164002910427658_3513372802288820753_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otEmDuR98pMQ7kNvwGM-PmH&_nc_oc=Adq3NMZt9KMAzLUO_MZvTu9aTlXzFcLNQGQqVun0e-TgwK5hjjO5YuqXXSrolINXguk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZraeqNlJxxi_vDfxGgdUsJ7euNRzpRO5M7eAr0mTDfg&oe=6AAE82BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1482823333226914", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619685_1482823336560247_7617575161657771703_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIlnuGqHfc4Q7kNvwFkeY7a&_nc_oc=Ado2dR-gYUfYmKfwjHw0-fejp9LGd0Wa-0aeXHFnTWvFuG05dWb_UPbJOLpL2Tf8oM8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuym1kwjDx8hV6In4zCNLM0EXT2XsoGN4bM22YBRYxIw&oe=6AAE82A8"}, "display_name": "Candy Lane Ride VR", "keywords": [], "long_description": "Hop aboard this sweet adventure on a candy-themed VR train ride and experience eleven and a half minutes of fun through a vibrant 3D world of candies, playful architecture, and animated surprises.\n\nThe train takes flight, gliding through rooms of playful bouncing balls, passing through Candy Lane air traffic, and plunging into a breathtaking drop to the third level.\n\nFeatures\n\nCandy-themed VR ride with three unique maps\nColorfu
uZzAt&_nc_oc=AdqdEuF_-fhSJrQvo_ahFzZL8Rvtqwfp3ST06H29A7agccYKMGPM7EwWcFLJ8L2wafo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVBh2dLfeg996GNYXWfo8AML0rnD5depII0JZekYIkcg&oe=6AE2149D"}, {"file_name": "Image Sequence_009_0000.png", "id": "3164002907094325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618277_3164002910427658_3513372802288820753_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5C0QpC-tA4Q7kNvwEJ8Bmt&_nc_oc=AdrgP8JOuJFtCRARvEYPi9Iz39_1KvOGLdsiOSgg87IvznvfwwpHio8V2HIeJjAlwrs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO61YARE9M-FGRLluEkI1EgLgKh3rv33KMGxRPzVaucFA&oe=6AE1ED3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1482823333226914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619685_1482823336560247_7617575161657771703_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAd6vJN19esQ7kNvwH1QsCN&_nc_oc=AdqWVn0ilx7oslQpAc0e_3G5yLAxduLXkKwnAZJe_Q2zxTBPrZjJ3EFCyejdhUis_CM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxjhCbFnifmPon1Q9nRTFyGHZo6tgx51BLFqcgT5Yxhg&oe=6AE1ED28"}, "display_name": "Candy Lane Ride VR", "keywords": [], "long_description": "Hop aboard this sweet adventure on a candy-themed VR train ride and experience eleven and a half minutes of fun through a vibrant 3D world of candies, playful architecture, and animated surprises.\n\nThe train takes flight, gliding through rooms of playful bouncing balls, passing through Candy Lane air traffic, and plunging into a breathtaking drop to the third level.\n\nFeatures\n\nCandy-themed VR ride with three unique maps\nColorful environments, sweets, and animated surprises\nA gentle, scenic train ride through a candy world\n\nTake a break and enjoy a magical ride full of candies, colors, and fun.", "short_description": "Candy\u2011themed vr train ride through a scenic colorful world with animated surprises."}]}, "developer_name": null, "developer_privacy_po
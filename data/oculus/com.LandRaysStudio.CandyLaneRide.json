i8XWq&_nc_oc=Ado-PGaIshphwO74fm8sJwiMcVx54jODr_tKoJBgrKOBziX_5r5zfC6VKpzEnQLuaaw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV-lWrmMwYyt9J_LgZpATPk7C1ZKZFW7PntmEhIFYrxA&oe=6AE0C31D"}, {"file_name": "Image Sequence_009_0000.png", "id": "3164002907094325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618277_3164002910427658_3513372802288820753_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5C0QpC-tA4Q7kNvwFEgn0Y&_nc_oc=Adoyvprz9PNTTB0Dt5rFRvcqk2aFgWKtd_CxZoqMsT3M95MG7oVN2-5FemQ2ooFXz38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3nwhM71rvT-KERIP3_J4osEI_k7bVtuA14GDmt445yw&oe=6AE09BBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1482823333226914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619685_1482823336560247_7617575161657771703_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAd6vJN19esQ7kNvwFp34_1&_nc_oc=AdpH6PTrq4OXbyo3FsespCqy_GBf9oQWb9yfkYZKnN2sN1cwxipJeDqS2Sfnfw0kbk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnHYk0HQQacQmmyixNHN2rnXUFJMA9q2dJGWUMzcXIXA&oe=6AE09BA8"}, "display_name": "Candy Lane Ride VR", "keywords": [], "long_description": "Hop aboard this sweet adventure on a candy-themed VR train ride and experience eleven and a half minutes of fun through a vibrant 3D world of candies, playful architecture, and animated surprises.\n\nThe train takes flight, gliding through rooms of playful bouncing balls, passing through Candy Lane air traffic, and plunging into a breathtaking drop to the third level.\n\nFeatures\n\nCandy-themed VR ride with three unique maps\nColorful environments, sweets, and animated surprises\nA gentle, scenic train ride through a candy world\n\nTake a break and enjoy a magical ride full of candies, colors, and fun.", "short_description": "Candy\u2011themed vr train ride through a scenic colorful world with animated surprises."}]}, "developer_name": null, "developer_privacy_po
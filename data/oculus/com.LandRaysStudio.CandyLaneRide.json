": "A gentle Theme\u2011park\u2011style VR coaster train ride that takes you on a scenic  journey through a colorful world filled with candies, animations, playful architecture, and fun surprises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/landraysstudio/home", "developer_terms_of_service_url": null, "publisher_name": " Land Rays Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/landraysstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38430586756589735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624851_1503251171836602_2872979866931920509_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx4cfpmime4Q7kNvwHdkTpI&_nc_oc=AdqqzQuQW-RHu3TOdYyYxxZPwJ1g4c2CPInVEXMYlWVGQysClv--FJD8dGhCw9nNuk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0t44kHFKjZ3BzGsb9C2VVXFeHbBlCZEg7ae7RsnPpiQ&oe=6AB52BE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ride: Fun Line Express", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1783360980, "lastRevision": {"nodes": [{"id": "34947218894926556", "release_type"
Z5bLT&_nc_oc=AdqKTa0DLDOGYR7HMiC0Pgru1ZxGB94XXmi4LLYrcxhJ9RMQP8moVy8m3fxFogGy0RY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGrVHuHid3pkjTu8dk60rDR41FpjO7cb7El0_Gp24UeA&oe=6ADF719D"}, {"file_name": "Image Sequence_009_0000.png", "id": "3164002907094325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618277_3164002910427658_3513372802288820753_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hI49JROVokQ7kNvwHme0uV&_nc_oc=AdoePWYDbvwof82IBZUKYDk4DxfqFEjtuTKh0JijOzrbE-0jj7UOsJ3IgehGcdEbVPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8Ya6hX5ieOkGUWTz8dSsivEKSykJmGD-GRrFGl53MFw&oe=6ADF4A3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1482823333226914", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_1482823336560247_7617575161657771703_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAd6vJN19esQ7kNvwH-YeSC&_nc_oc=Adq_ERvMMRur_BFJbzMbvz29BBIA5kLdd4pSe1F3lIkM0wdvduDA37OFPb6LqtxMA4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWav-CwXvr-HMlNS-ARhXWtLjFMfzP-MAifBHr32JEdw&oe=6ADF4A28"}, "display_name": "Candy Lane Ride VR", "keywords": [], "long_description": "Hop aboard this sweet adventure on a candy-themed VR train ride and experience eleven and a half minutes of fun through a vibrant 3D world of candies, playful architecture, and animated surprises.\n\nThe train takes flight, gliding through rooms of playful bouncing balls, passing through Candy Lane air traffic, and plunging into a breathtaking drop to the third level.\n\nFeatures\n\nCandy-themed VR ride with three unique maps\nColorful environments, sweets, and animated surprises\nA gentle, scenic train ride through a candy world\n\nTake a break and enjoy a magical ride full of candies, colors, and fun.", "short_description": "Candy\u2011themed vr train ride through a scenic colorful world with animated surprises."}]}, "developer_name": null, "developer_privacy_po
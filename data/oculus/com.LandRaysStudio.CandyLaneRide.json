n.com&_nc_ss=7f20f&oh=00_AQKyrp64ldzUQjC_PylzM0-zP2NMrWGAVtM2dvTP54-u5g&oe=6AA93F73"}, {"file_name": "Image Sequence_028_0000.png", "id": "1006487605382268", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619159_1006487608715601_6804733247972693860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-4oc5JCH9oQ7kNvwFozwAq&_nc_oc=AdplvrrvAmMURGv8ik5U6Ha3m78mC62uM7tO6dlEo7-ts1i9w_KXjXTT0aIQS1Jm7QA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaEPBGg-biOSP6q8ojjLOqZmgo_05KEzrmd_y2M_Pq7w&oe=6AA9641D"}, {"file_name": "Image Sequence_009_0000.png", "id": "3164002907094325", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618277_3164002910427658_3513372802288820753_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsEmqGPWfukQ7kNvwFn7-u_&_nc_oc=AdoK45Rg6PfRMfOuRbfzTEZLtBWCJCgmvEfu_gs87RhCj6WZEkl_o5E8f2FeSXUxdHo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUgzcoRsIATP8H9tCI1LOu6EhEkSqpnJn6xCmwO1x1XQ&oe=6AA93CBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1482823333226914", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619685_1482823336560247_7617575161657771703_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9O5AkSN0BkQ7kNvwE5jVRb&_nc_oc=AdqxCiyxFh9KKe83wSumlPImywT6adbV2TNg7PbVbNKWhTHpqp1MDanPu_ni7Qr2iCE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC60Hdx35t8TTzVQne7zCpJZ-7eSO1jiqZAiDgL3SC9g&oe=6AA93CA8"}, "display_name": "Candy Lane Ride VR", "keywords": [], "long_description": "Hop aboard this sweet adventure on a candy-themed VR train ride and experience eleven and a half minutes of fun through a vibrant 3D world of candies, playful architecture, and animated surprises.\n\nThe train takes flight, gliding through rooms of playful bouncing balls, passing through Candy Lane air traffic, and plunging into a breathtaking drop to the third level.\n\nFeatures\n\nCandy-themed VR ride with three unique maps\nColorfu
_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND_5OD-TfKoQ7kNvwGB8lJx&_nc_oc=AdoLOJse9JQQjye7hcCcMLmlI73ck55WcRD8DPvLyTD-X_DDV_zivRBMKBaDJO1ibIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98jwru6JcUYELfKKMy6v6G9DntSp1REC6N3SNSuPhOsA&oe=6A3D4CA8"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJJVtnP6cY8Q7kNvwFO_6UM&_nc_oc=Adqc5NIHTt9zIAc6Xu0qP6A6j8yGwvZ11u4DtUD6fiBh0ngqkpTi0J6jhL4C6OYlF9s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AM25k01AddjZVLCT5rEKjyirCOIfG1_N9lhHXPE8vBg&oe=6A3D3681"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPHal8f_y_4Q7kNvwEPAeA3&_nc_oc=Adqf4qC5jtIDtQFUfwB4TNhCgfViXzdJcRDCGeH9Kx9757S9fi0u1ZRGU8jbeLpwg6c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HZGX0eCWY7llR5XxagpW-xiiahE01aEZeASrWQok0rQ&oe=6A3D58E4"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY7B-nkIW_cQ7kNvwHOtUhr&_nc_oc=AdpGFsu3XhANQi_OjCEMQbiPPDXl0bDHn8PlZxLzdWG0Hyd94bXn-qKc1fameRs1lZs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Kt0wHF0DuOdazIKViFrSNoQOPTTvC9aAeZL2pAta-uQ&oe=6A3D448D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGmkdRzolfYQ7kNvwFVALPo&_nc_oc=AdrrLKoTbFT5ytizpunTpvHVEDv5grSFmYr_kVFsoHcBsF-jdlvoFEk9RlQPYYOEAa4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SHRW02ohudKRw6yj1fZZmeJAIu9boM_fGVvekHaQLDg&oe=6A3D3DE3"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mceLaBhmxTgQ7kNvwG-F6Vv&_nc_oc=Adq-GfO2YaGLDEVIDvFm4FcR6mVAXdrX2WgXG7kwMx30T6ay-jFUhnM7wkERBbUhA74&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8USzarUr1CdjoRcR_IFrt74ZpxyFQBegAIOUgum1qJmg&oe=6A3D3D4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-6Ufm_2PjsQ7kNvwGprseB&_nc_oc=AdoWQJlFLFUmJU7bGTlT-460cb8oyaWWE3AtoZb97I3szdivFz9kg91wC3XXsA_sIDU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NPfBW-eHxdGCrYhEfk7sT9vWGHovqe8FPPdPlqCKEEA&oe=6A3D3697"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
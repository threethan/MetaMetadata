_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPTfXIwFMNwQ7kNvwGmbaWL&_nc_oc=Adqs1yYCdL61Sj4JZ6gOkMuAV-ufn6RG7XhH-GZb64MBxZvW61YBrit00aNSR1ER1M8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sV5SVeH_RYKN8GNjuzyoRDmbtJBXYmngP2TSzOXRMIA&oe=6A298628"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLDxjzbpemkQ7kNvwFMjmnU&_nc_oc=Adpfwe5KJuWuEKG-JmBn7ZayZFXSp69tbQQJX86-WAEtJC1UXCGMW-AGa2rARltNRf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DnmyQQfBN70gMy5IElIThC4ot050gQ78ujFI7fxuxww&oe=6A297001"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF5_ZmIyJXMQ7kNvwFcocUi&_nc_oc=AdonBizMbEWNrGuYy6d3W13lcKCUlydSehXQU7sMecFPyHQjeJ-NGC2nxp4FENuRQFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fceI3JYytjA8KspqG6j2HXT4Ma_JKNf8d_M2kSqPCdw&oe=6A295A24"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vev7OvAPq3gQ7kNvwGqlGGC&_nc_oc=Ado8ZxHz7XHE2v__SeUZPDMZ3nY5b1QrTFa25Vdd-sX_rKCgqpYrGB6Mi9kJ-lfdJCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JvzglckH37nhP1GBQUxHZIfqf1peXYGJIHy4U34oOtA&oe=6A297E0D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faFIHt6tKb0Q7kNvwFCcnmm&_nc_oc=AdoVkgjpe8Z-UWKxNenvzPM4Jgu7jJmU3dfQwqpDwQMx2rrtBeoZN_oklNB0wdbY-ac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90tEUdMsPbURPxzEccZg7esWruotZzNDl3nrwEHqVD-w&oe=6A297763"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d16FTRcQKBYQ7kNvwGk2hm7&_nc_oc=AdqrFVr4lZIPsiTd8awQpc0C5wQDQMmiT5xLqGyLgDYjzT4-f6BsXMaRsXImbW0m4Ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VXMMltdjQIig3bL10RNBaLE5xtBRlOQ0uBC1upzgXYg&oe=6A2976CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOPm-_eE9CkQ7kNvwGxQv8y&_nc_oc=AdqhA01SE4mgPFHte92hCMLqBI3DN07NjNEFVkqy3O8VnHpNz401Q6tP6i-9xIRZ96Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yzYbxj-P9kt0nH0UktH34NvFTZaBkDa0yE3P3QG5PsQ&oe=6A297017"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTF7y3TP0YAQ7kNvwELsyyG&_nc_oc=AdrNUsZ1Xr85vYQ7xNJtCKEN4UrPTveTgDw6PLLKwsaAzLOLxfohBmaCHBr4Gcv0ri4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCvkj4Cp5NlfXtMJfdPfRRewgWtautK7129WKtWY2MSw&oe=6A4D1EA8"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaBz0Ezn3NQQ7kNvwFSGxSd&_nc_oc=AdotIGyKt7HGG3zfsvkC_d59CD7adqPYYpfdRSb3OnY6aK-9vomj-Zc8SNsq9vbyt6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRiwEVC_qagc2APcLLk0WOLGe6EeWX8L4yLqyK4lQatw&oe=6A4D0881"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiooLFuYa6wQ7kNvwHP9mmP&_nc_oc=Adov1ltpZc_DX2EkV3BOgGVV2enp3WKzLdTRbDLk5vmCi0PCIEVFUduHV7F47X9NRPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQDlX_zvub-XsvG-PQ5cPxvQUj8F8gLbCbZmndB8VdmQ&oe=6A4CF2A4"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtO8uzRnUoIQ7kNvwG8pEcW&_nc_oc=AdpfpKaC8Y-6epoP-T7SC_QsOC78GNiB7UQ9CY38yA7P0A39rmd1GwFyybu2ePwWJd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlznQEwY6hpE285Am5-cvgRcjYXtra4jV9CmCNSV7Riw&oe=6A4D168D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNncFoHMkaUQ7kNvwGucch_&_nc_oc=AdpvUf1tvn3PVNgG-A2wpI0km39-oFVk5wIikrOA6ndA3tPToGs5Z11UXgzF9uXprUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6WrPXoNEQqMfVobXrcRAoBw0yI5dwCAwiGpavuomzNQ&oe=6A4D0FE3"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wO3IvYU2A8Q7kNvwGnGVc_&_nc_oc=AdrZJBCbOoMvH0dfcKpoN60e1itD0zP1C98SSGYyprrrG_JaknaV9vFDt6A0r2ArG0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCGh0oHXGhlJ12GYgONvsRE6v0rcOhyjORUpZIOxkRVA&oe=6A4D0F4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lRC-gX30G4Q7kNvwEW8Qmi&_nc_oc=AdoeXlGQTUjKs205cFslLr3bx4SIdxxDG-TKX5k2omATqMEOlTCoXHQRVjq3QUz2fek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL_yPapfujryrH_9z-lg8smBRWd3ILb1NcAhggsQrE_g&oe=6A4D0897"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmSyvaYe--sQ7kNvwH9ya50&_nc_oc=Adrdlu8ae80-_NqaNRwpqDGu6pEx7grZS--dnR-30z3xCFuo8AnVVWEFoBkwBUkthq8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KqCGx875RB0mrlYLJrXO0qL2GmjV44C9quvgW6xME-w&oe=6A4535A8"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6j9rHYTszMQ7kNvwGQldwN&_nc_oc=Adrjp--gbLGO8Kf5xXYHDQNDSioZMIw0halsI1tET0QO5Uv24o1vBWeXpSah-ENaIVU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85YgVgv2rC1OuU-Ef8nM0I7X8m81RpFZmZ2RsJioeLXw&oe=6A451F81"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Buof9NeOSqgQ7kNvwHP9RY5&_nc_oc=AdoKC-gAV9wQCKjhYQsSAxvTgVYcgkGTEDKGdc9m9Ij4Y5Wgs0HZJJ6B7x2I83tbp4s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c1TmEQshfpPnZ6wUPI297NKqYXH7Ori9-f7dLEPxcGw&oe=6A4509A4"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfftUGeUy2kQ7kNvwGvuPjZ&_nc_oc=AdrXKD9dZb8TZ27-PNi_VBzvRZz3Y167o-0D7BUYufFWOANv3LdlRsUosVAQceGR9d4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hBF4NsxkiotQCEFP8aA5X6qqethLUpisAGhNW2G7TxQ&oe=6A452D8D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2au4Ic7A38Q7kNvwGzaoVF&_nc_oc=AdqDMfIPo9KrAgMWkt6Ybupph0lZn6KLayApTg-GLD-I8MjRYBmBFa9zXmageyK9bfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y6pXarEbdMmQKAWgpe5qXHlS5jqpEST_BMM8qYHUhhw&oe=6A4526E3"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThFuagXH6q8Q7kNvwEwPf_K&_nc_oc=AdpD2xPr0Jl-dcf9AUm1LUsPWEe5sKhrRmOBOqPv0Zx4vx_EPtBhuIiLEHojq07An28&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0ixUINmgypxMpDS-XBCNWcaSxzQdFmlPY7C-aGACyTw&oe=6A45264C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leyPhSa5sloQ7kNvwHNqkmJ&_nc_oc=AdrpsxMpzH5yDjz2Nr2aQBgEETID7CAHJOA1K0EOtN7Xxq0pRn04QX-oExUimFCYXsg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e2QQwFbOzyNXqmq2MTAKlE_CiTxOk6JzB5-0biqNo3g&oe=6A451F97"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
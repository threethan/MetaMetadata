16_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GZW0rqZ81oQ7kNvwEGlETU&_nc_oc=AdqkiV372aSZ3WJ9WfpcaH1VNAJok_fS35zvz5v3WnFqsqZA0XbglVNOYyITAG_YzdE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rmQHSDUi0MlyRAPgayFroWQ0Mf1ke3OZraK6XHiKgew&oe=6A394963"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b375mLoyT4Q7kNvwFv1Ija&_nc_oc=Adp48m70Lb0-100ZgCogIStOqBFnmpKV4XRHb6gtpyQ61tYjE35SessZFiEE91Rpvn8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9relK2FZ5-YRx6N-ExMq_x7u3YKemXZq-lEjGLrLT8kg&oe=6A3948CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZZ3TKrJmVwQ7kNvwGrQwLJ&_nc_oc=AdoPcBXKXA_5b4u_9XYib-ga3KFSa5tIooTnT5LDPBPTTr0KbtpNuvCp1J2o4qbtrx4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RUdW32TqnWHHtGD5coQO6eMpvY5j4HnZlf-eknjPbjA&oe=6A394217"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
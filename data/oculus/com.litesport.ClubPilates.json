_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL-ek0LBi5cQ7kNvwGMWlKc&_nc_oc=Adpjqqa-3Y2PGeLPbiu2k6a5EXPnj7w28kOPBI9ne6FtSrrNrCvtEkwKuBpAfeqsFYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2JkTSkTG4CMTvq3RapVfLdEoEF__OqS1JOmk7j48lrA&oe=6A6B38E8"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9hBqoYMdvMQ7kNvwHvQQHi&_nc_oc=AdqXxFPsllzJAXtdRvIxWtM-un64U_EpYZsT72ZkDV27dUQ0QpWndyBulTzfKlsCGUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSXSM347TMDtqX-uPvGv0UAxgw1xpCrsR0fZgWnnTfRg&oe=6A6B5B01"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VMMsY0YbKUQ7kNvwFPi08j&_nc_oc=AdomyAhlAaWBjclnj3Tot7YUyhSDc_2qdRpfQzezC68bBnWYYGthzRbMmnAmvVFXKEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh05quowYejtxTvr0Ity9DGXvmmqjmrtiteF74o1ETtw&oe=6A6B4524"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTr_rqWTJeMQ7kNvwHZa7Yz&_nc_oc=Ado84LFnfy143Mzbrq9hzOCtTViyxdiFsUQ6u7b0O0xCJrPrAdj8Mu586MlsA3ZBY3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTi86_PUonH-RdFLSTCkBSLRbXOK7kUhu-T7dw4s4Izw&oe=6A6B690D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv-mb_wEDysQ7kNvwGrtcdV&_nc_oc=Adq3uQRUcYi3BbFpVnNIaoaYpy7opo2HCNJD2ItEqhSZQKjbZ1BEmtHvSLPrXNPr9cg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiz_njckYwrtbircLWrdavxXMM5mt1wNEDXIadgSNmlw&oe=6A6B6263"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZzYlr36nW8Q7kNvwFAkSEp&_nc_oc=AdreCxNGuG8C6QfsUsoC7WNbV85l0Wg1pbq_fLrFxiT1JXYE0psfA9h7pr_flIzqdB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2ug9Fc8yPe6afQek8u2ypO-du2izdtfZkzUtFwUTeBA&oe=6A6B61CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwmYgU4WdXoQ7kNvwH5cY9e&_nc_oc=Adrl5WGrGL6GByTmzNeM2LuNBE5PIeLcUzDx9Fa0Vep007xRjs1fC-puhW3usIyVDV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrNP8LeeHG_HfwsMKemIRv242NSYnCb_G_x6vKbiEHMg&oe=6A6B5B17"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
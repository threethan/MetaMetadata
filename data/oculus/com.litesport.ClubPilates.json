_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnO5FvUT6EIQ7kNvwHMykQs&_nc_oc=AdqANEnTJJUFESmMykfR8V9SFtZJWJt2uxTghnUE8Ekk0h_8GmjpnsRkwEeZCsJ88Qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aGBawZTC6-2S9ksGbdlf_Gsipm_oDQwnN8RNPKRI9-A&oe=6A3FEFA8"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcP3H6GLLbwQ7kNvwEV8svt&_nc_oc=Adroox54ZHHOwi0n4g11wAHCgOvXo1SBrUwPBUoAJ6rJDtyv775WjDvurnjLztUtQNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wZr3V66SUUfdxzutl1vRxaD6xp5oUO6Hae927PAKKhA&oe=6A3FD981"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrGSKHJpNpYQ7kNvwGOrvaD&_nc_oc=AdqABd54zmDLOQ4LEkvvVS2OGlQA2znYc_--ePX6ODG92r3DJI3wPof-kWmnNq0-saI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84IGlrb3DgiVeIpnFJKIt80L1MqefpyClaFPR8x65Xag&oe=6A3FC3A4"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Lt1aEQdq8Q7kNvwEnVR11&_nc_oc=Adod7eGBBcOomZ9RZP1zsXVrUhOqSlHP62lgE9NSAITqC54J7kcjSGdVqCmI2KhmAxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XVsSkKvqNVc7fXGWpdfmOLHIqTg4xTo-c2BMkSFp-Fg&oe=6A3FE78D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGmkdRzolfYQ7kNvwFr05_Z&_nc_oc=AdotNS3-Xz5lSLtDGDt_DgdNCO3AVHxEuPyrQBMO5BXnAcuJIE58cPjJjSzzdY44Ka0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sy5BRKQFS56aL_EVoZBv-lQV4ivSBQJlJCXuFGNM-rQ&oe=6A3FE0E3"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mceLaBhmxTgQ7kNvwEuTpmK&_nc_oc=AdqxkaN_Gk384Y5_YOnp8nRhrfLVCFpN7qIaVQZcrlgvsHlOSvqstgRmAYP33xqvnqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mC8WvORsd4L_inhku6W6TnilzfwnOw6qEQASULEAsrw&oe=6A3FE04C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld4AxtY36UAQ7kNvwHHlb-q&_nc_oc=Adp6ADZthtXxGn5n2oyZbqbz3vFZ7JHPnTy9t5ArXyd-76KjQIks44UYFexLd1VWm7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CqmHMtQYgd3HSKilE_Q1oBUONa6FIVZgvV5h-wgUy9Q&oe=6A3FD997"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uabd6HqNQVcQ7kNvwFFkQIJ&_nc_oc=Adov_haERYPSr_fvVBlXpR_vEBRygv1wukyyuvT2q6FN9bSpHBtljnkllj4hJIP6FRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiwL9kTWEaw325kfvkORnHOiA_tVfzGoPW9ftojkqhDg&oe=6A4A7BA8"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOVXj3A4CasQ7kNvwF1LXnD&_nc_oc=Adr5_xC5eqwqgNoWlXjuitJJIZBZoB2GqbiGWV7Y-qDMk9v2KB2ubqy5j--zt0BQaNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsJIsVaa3aB9pAxxOe__1zJVJiqeLqihWaZAYYFKtKVg&oe=6A4A6581"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw7e7loMfD8Q7kNvwF36vBg&_nc_oc=AdoOcg_DmdCo-Dy8_iJFz8uIZ_ZCs_mWPqgUHgqXokf_E6l_n6D42rmn-PE7LeF_0i4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwdSetec2DkqLQqq_LJneY09qF0QYgfs_wqKx2iQ6qow&oe=6A4A4FA4"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tucTkBse6_QQ7kNvwF0wFpT&_nc_oc=AdrOQrH3N2FldwEAm91OZ1w70QiSfn5ZoqIFfAa3GNW0bOM63Nmwjm8hL87X8Ay2V-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj7N7Vbq2czd36mW2udUj5tStOentBN4IqWi7saCedNg&oe=6A4A738D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYdw5enz3UQQ7kNvwGtuvTJ&_nc_oc=Adr1e9CCXhguN0KAf93EtZ5jtjRaSBXlWFPnELKteLFuxtimNAI2e42RSOmP3UzGzbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6kBWWdQyL81mG41wpxR8Eig9G0ay7ecTw8IIvO4HdCQ&oe=6A4A6CE3"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcYotpfbEjYQ7kNvwFkTViB&_nc_oc=AdrWDzswp8e8MtEKUc_rD7a3SzvcdI4NtoTL5BrfSWAxlCrHC49e6zqFn7SY5gMh3Yg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4PFZeIeu4XCXHzhdVQgAR5y8nQfuBrptlBJV6MiLFQw&oe=6A4A6C4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lRC-gX30G4Q7kNvwHbuHqz&_nc_oc=Adq4rJ8ycSRlylhClDk0qEVQCfMV5MRh0IoZFg_rihd4ULyYHEDy5aW_CHuy1m-Qk2Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeC4q9fcMaJxWQL_LUHqU1KWk2jD2qFVob6-4kBmRhEA&oe=6A4A6597"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
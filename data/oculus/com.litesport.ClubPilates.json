_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h49o5BspwdEQ7kNvwHe732E&_nc_oc=AdqIQbpAMjhmUmufw8ucdneYYnOkRuNiB_pkOo5KxyFmOQDY1os-T8xszzjGHtzBeTM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VUTeAlG17RF9Qn-pHpV_rcU1ZQ-5yFZ1DitIqkLOmow&oe=69F34068"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpGVGvnqf7wQ7kNvwFcpFkF&_nc_oc=AdpGx-URPiF1bGHTm9n74q8xPXY4UhLz3qN51uJJ-fe57Hzfx33db6G2DdfaWkMTqUo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NgDLWZZeNGythesof7yHdp5aPRbX_JxZBhVCjk8E5rA&oe=69F36281"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qivdmQe-4JUQ7kNvwEWTwMf&_nc_oc=Adrf6nC85BcQwvi2HJ9fgqi8NKzEjUu15d8mq5gDGeyYLJB-F3-rcDYvCxxAWMIH1zs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VHZShDWWo3q_LOB_XHmrhZ7wG1bMbkB1NtTAhx9SGsg&oe=69F34CA4"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-lFxb7xERsQ7kNvwGNFy_K&_nc_oc=Ado4h1OkwzJCGxG4p_tMGNr0PX0eu0HZl7TLm4de0JHZsyL4O-xg29ka-1mxdcEksu0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xompXys9hl4mLbS3ThmGm__bsaPLKJh-nz7Evi-UrNQ&oe=69F3708D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI643JZHNpAQ7kNvwHwcg76&_nc_oc=AdoDM1nMkfZVeNiiWyEP-DuPOgOaJEt58Pelq2Qa5oRKKP6DLfg_JOAi3rAR-n3MeeI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BXGvno6pPjP7zyrBd3krgrhqjyNKHwd_02m_JH9quwQ&oe=69F369E3"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRHC9Ta4Q1YQ7kNvwFsg4TW&_nc_oc=AdrXbRdcYOQUD7BmSB4DQNwja7rqj1ipw65ysO7V0kkd3tvZF-Mc3s14keWomQkS1c4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NqZeA3JCOpFmAokElD0JHmxd5BUlHL9PR-lzuDeP1HA&oe=69F3694C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AjFk06hMy4Q7kNvwHlGnmX&_nc_oc=AdozDMkvDy2d4cCcOR7pS00qxNCJZxMzK7XhUajhr3ge5f_K_Aji6wmJNRxkNjZRS3U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Xs8uRPNPLr4GrxMiPCklhEaqiG1uf2kT4V3_z1ngSJQ&oe=69F36297"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
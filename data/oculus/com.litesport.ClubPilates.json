_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrqNA5jZC2QQ7kNvwEQlvxg&_nc_oc=Adp5x3xyPbd3qQHZKBqc1LdbHMHLsSGeR3CgGNOjFKjj8ICyLNrs4IpZzPBDVxpA0YY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vR-QqlBLGATu8nSK0BKkVB8PykpV1G34oAT_r0P5YbA&oe=6A341228"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nmves5RRLCUQ7kNvwEfHd_-&_nc_oc=AdosxBDqfBHDd8u8Vz1RVcfO10125COrMjdBdsJyRRzoSaAtyAB5tr7L5QhoLup2jW4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QsrWZRuP7cnT5iam9WLoIvIQwOfyZbzVNO310lAhD4A&oe=6A33FC01"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9lFKmhD5p0Q7kNvwHv5A3Z&_nc_oc=AdqJplAtEBGVzio1OKcLAk2uKVVV5omIrRrTySZlEuo88-pv3-yfSk6e1XoKV9vBOpY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wZCTQJwWwQfeBYd-vKT3Hs5eNV-RDo-4T4JKqW33s4A&oe=6A341E64"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCYecbdilQMQ7kNvwGIq-dq&_nc_oc=AdoEmC79stxnrPN4nVeXs9tMa8999xo65pYYBqfebodUMnz8iRtOGRIgTeCRmBbDBUI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9elsnr1WiQIrycrWmQUMQ-j_xcj1oiyQmOkvDlwbjPvQ&oe=6A340A0D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuhwStoAbUIQ7kNvwH8j0qm&_nc_oc=Adq0y0dGWZ9y4vlnpX6ZfonLTeiaZUneYU4xj8Zr-ew4s_5iAfmTKFycj9WqZ_yboqo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pbsyblen9jUS95Gt5QsunxpmxROppX12We1kRK9ybuw&oe=6A340363"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vNA5DTQSKMQ7kNvwGBDio3&_nc_oc=AdrUWDRnsFZiNDNm2quWGOY0WgK1wHxq39TFZ5D8cHvtFHsoPEe6m7VNW4UJPK5NhVo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KTbuZw7dB8iHomPFqA9_TFUYmsu9Wd6n6ejQLRnoU6g&oe=6A3402CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwbDw6B2tB4Q7kNvwGa4C3G&_nc_oc=Adq4RzVWuKMW4LL_e0RH1JpF9rylmvbEDLEqG4yI4Wg6HjXEMe0xiPUnAsKqoNOMpHE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z-Dxnoj9mOVVx_cLr8A14_iB-mDyBYmvq2vLI-EvQbw&oe=6A33FC17"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFoqo2QO62sQ7kNvwFONCp9&_nc_oc=Adqto3exzN1SpW8ycgqyYYnBLUQ4TULukhl_QfAUbQWMCyCy0T4ydknH-w5kQutIyzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BcmZjof2fTRg-BX90k9vBYDKKUlwz47Fyqq1F_DaPOQ&oe=6A2591A8"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMt1A4v5RcwQ7kNvwHoMOmF&_nc_oc=AdpIu0ZMQs19fuSj8-VcBEmTj0IleP6hJ8dn6qSbKvhdrkYA38qmthCvVozh9vqCZCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hIeNFapeyV5WUIe42_2F-Xy07ro4PHdITHpPd-ZzFuw&oe=6A257B81"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxTsrKzUMgMQ7kNvwHydTAV&_nc_oc=AdqlUmP6pg_ZRockqj5_D_1B6U4tqE_Ms4TYPHFZsuL2_Ldyq9ejl9dfQNIyvu_1HQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6IcPFxjviJlvB9TFD53HJSlsVgfsD91PeoDr1ktdVJg&oe=6A259DE4"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEEOlEyH1rAQ7kNvwHgVkbU&_nc_oc=Adp1Ol5b6PQX1Nh5NYxr3Bs4W7OLN4xRk2Vp8un61S1uDs6ZUbCSQla_MkotEd9DEJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MOR9MwjwAyQLKjJ9Yrj58Gn93rmY09u_-EUW2vUn7Mw&oe=6A25898D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSqE9Wh-xx4Q7kNvwHMs7LY&_nc_oc=Adq9rcEASczwxQWKr1iWEvqPdPcNqxqo1i3Dzg0X1Ceu_8T6AjA4OVjssPDyyZpGbgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w3kMVDwHpcHMkEDoc4VpL1gaEG5Lv3Yf0_rSgxYT-7A&oe=6A2582E3"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2s0Nmm2ZvdgQ7kNvwHUiGQI&_nc_oc=Adq01OiKe_BXv6C5ke08awOosl-LaZB_vOOPjab_EiobgKQhsi_bdwR1R6zqpO_Vh_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hfUb_I8E-NyGXKPuKaSPaMERQ6WajZxM0YbBKlLnaFA&oe=6A25824C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_W9f0LPsgRUQ7kNvwFNkJUa&_nc_oc=AdpeMDsplX8SeQMCpvotRq82d4m0vEzSRiOw-P9Rqka_2-haiiiUXSUybH_HKp0zFoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M0tTgNemMKqO8MP_feZesZP6BgyMSpjwOQfrp0y8ltg&oe=6A257B97"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
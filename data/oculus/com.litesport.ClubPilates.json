_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_359913273834951_1650520460310594588_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDyA8ljbT14Q7kNvwFx4-yA&_nc_oc=AdoZxdlBvMLCcV7T-RYQpxPjA4gxHHRg_k1Zxr8KTLfb8kf6USFQAIFKZ4tb0bHwceA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUZmsiEyo5T61M3EeuOOO56DzYEZnWhe8UENsLA6VeeQ&oe=6A7EFF68"}]}, "id": "1577526316513025", "locale": "en_US", "screenshots": [{"file_name": "CP Screenshot 5.png", "id": "1035574571507281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974643_1035574574840614_762154027460375286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LERhTXjI440Q7kNvwEJwT_O&_nc_oc=AdqPoykNfPHjQiVNBNLQ6V_2u_jfm6bkSYalygEFWSmG2HSNiW_X9ex1biQvJYp8xLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHMP0x5WVkT_ZoiaHdo56n97o7Zc_pHR1nBA1FqjVV5g&oe=6A7F2181"}, {"file_name": "Club Pilates - Home.png", "id": "7984451821624259", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036673_7984451824957592_7470140895996142367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVF0VGbEwxoQ7kNvwGlxz0O&_nc_oc=AdoXbb8VWVjwUo0J3xlHU-goc96O05aok__isMXCAdhPxhXNaOz0cIKUneNMk6UJzzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5OIQOOBQXqoK2O8LiCz-G3PBhMTU9FOWX8ZKRhjIBpw&oe=6A7F0BA4"}, {"file_name": "CP Screenshot 2.png", "id": "1155080112454016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031403_1155080115787349_3716017007470299754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfE5ZnuNe30Q7kNvwFyb7W1&_nc_oc=Adq_NTRD085uklQslOWpwlK9Jb9WppzDOSlT9NyvjCxDa2pE8B5Xy_CR72IQmxVsfWg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-nKwwUGKpI5KIHPAiN3X2Mb43LNMqn-x6zKn4kSexVQ&oe=6A7EF74D"}, {"file_name": "Club Pilates - Pass Through.png", "id": "1648552502662151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974702_1648552512662150_3829023883266058816_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyIN6f7Ksi8Q7kNvwF3h0Un&_nc_oc=AdqIj-cI8KZIMDcpXjyHJ_AjW_T7BAikWLJpOZhOU_8TrtQgyr4Q0tyjkwSduP0FIGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHho8asrZgkDiCP37h-d178S2bVPY24czf983w4S26mPw&oe=6A7F28E3"}, {"file_name": "Club Pilates - Classes.png", "id": "1582240485833105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974549_1582240489166438_5726005787176239963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1GwcXnsQCUQ7kNvwFsEhLw&_nc_oc=AdqHHIQ68UNcjBBfpPeckdNmveq77D93MtC07ZRI_SIGKIJ4Dh3e2cLVJhvX_949iJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ3pZ5IU8OEKBRMXEWU7UXTBlrgufWeKlaobLlm8E5ww&oe=6A7F284C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CP - Cover - Landscape - V2.png", "id": "1959495167808803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036648_1959495171142136_2560600486666633881_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVPrqObSKPIQ7kNvwHvTqp3&_nc_oc=Adq-rUz-QjGMwqzioagLl9ZaPYiE50C73G3MURa-VYyksuA81DdNv10RX0c3tfQpqPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnZ51Xa8njCzXn92bq1Xpdu1nn8KQX35n3MSI5Czj5kg&oe=6A7F2197"}, "display_name": "Club Pilates", "keywords": ["fitness", "movement", "health", "pilates"], "long_description": "Discover a new dimension of fitness with the Club Pilates app on Meta Quest! Immerse yourself in the transformative world of Pilates, where cutting-edge VR technology meets expert-led classes. Whether you're a seasoned practitioner or a curious beginner, our app offers a personalized and engaging experience designed to enhance your strength, flexibility, and mindfulness. Join a thriving community dedicated to health and wellness and take your fitness journey to the next level.\n\n**Key Features:**\n\n- **Immersive VR Experience:** Step into a virtual studio and feel like you're right there with the instructor, experiencing Pilates in a whole new way.\n\n- **Expert-Led Classes:** Follow along with certified Pilates instructors who guide you through every move, ensuring proper form and technique.\n\n- **Customizable Workouts:** Choose from a variety of class lengths and difficulty levels to suit your fitness goals and schedule.\n\n- **Real-Time Feedback:** Receive instant feedback on your performance, helping you improve and stay motivated.\n\nTransform your routine, embrace the power of movement, and explore the future of fitness with Club Pilates on Meta Quest. Your journey to wellness begins here!\n{1220770585475575}", "short_description": "Elevate your fitness journey with Club Pilates on Meta Quest! Immerse yourself in a world where movement meets innovation. Experience dynamic Pilates classes led by expert instructors, designed to enhance strength, flexibility, and mindfulness. Whether you're a VR enthusiast or a fitness lover, our app offers an engaging, interactive experience that fits your lifestyle. Transform your workout routine and join a vibrant community committed to health and wellness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_mode
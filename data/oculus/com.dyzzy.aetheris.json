.5771-25/596168449_917730687622342_2494771395859254817_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIMF8t16KdgQ7kNvwHocCP1&_nc_oc=Adp80TjW0ZLsfarZoCBO5Yp7yDM4a1B6M9P8fsZPLm1Vb5-5EQiiY2l3rSWtGj5v_aQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmWEMc3EWLA7EPuYMUq8HdfrH-wfLXfPGCzHINwJV7pA&oe=6AA811B8"}, {"file_name": "Aetheris_02.png", "id": "906827585490260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831393_906827588823593_5032296704417610243_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxMt0x_zyiIQ7kNvwELXl5G&_nc_oc=AdqBbaB30FsVMXl66_Aa7nNofg5N5osnk-jnYAS72wN8hdQRVrkipIsMZe_RD27qk28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItcBVhPkuDuPYro4LfQY1B1M9gNBdNkvHvDJfh6qnrVw&oe=6AA7FBF1"}, {"file_name": "Aetheris_03.png", "id": "4534355933550781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_4534355936884114_1997678409197845777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jQRikTBF6EQ7kNvwEJwF4U&_nc_oc=AdoLWcZ43_6gOcioWe37e4YUnkm4j3TOxbexQsJR3EdqLr7bHYy3g0Vr-4uFo_f2L08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRT5IaNoBLfWC-M4RUiCk_8eznit0_ZvTWt7WeFynfjw&oe=6AA7EE5D"}, {"file_name": "Aetheris_04.png", "id": "4564953557057379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_4564953560390712_936440801340857919_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WGveYA6xTMQ7kNvwFahJvA&_nc_oc=Ado4o3jZA23UoQbX6HEFUdhJKm1F3XutDWTL8fVN84rTyp7BUcxROaWi32UgD9gT1k8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfWwBZoFtSLJUfVFOsPDdA5YntV2tHbuNdpgFazh_-1w&oe=6AA7E6E8"}, {"file_name": "Aetheris_06.png", "id": "1727068585188547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_1727068588521880_2647529108814399433_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo7x6OEzB-gQ7kNvwHjOPLw&_nc_oc=AdryHpeHvMjMcFRC48A5FYEUADNQeN5SUXiGHhOGftNhfoB7Q55MqOdysfi2F7SOu7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLocNEAL77N9ckIEQBf2-pMMq0L9W_uUMRhaW2GMK9Tbg&oe=6AA7E5B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aetheris", "keywords": ["Tarot", "Meditation", "Astrology", "Journal", "Astronomy"], "long_description": "Aetheris is a companion space for astrology, tarot, and meditation \u2014 built for practitioners who want their practice to feel considered, not gimmicky.\n\nInside a calm dual-pane HUD, you can:\n\nAstrology \u2014 Track planetary alignments and explore your natal chart in an interface designed to make the data legible, not overwhelming.\n\nA Window Into Space \u2014 Look through a stereographic window rendering a live solar system view, so the movement of the planets feels present rather than abstract.\n\nTarot \u2014 Draw cards for reflection and guidance, presented with the respect the practice deserves.\n\nMeditation & Mantra \u2014 Guided meditation sessions paired with mantras, along with context on what they mean and why they're used, for newcomers and experienced practitioners alike.\n\nGrimoire & Journal \u2014 A private, local journal space to record readings, reflections, and your own notes over time.\n\nAetheris was built by developers who spent real time with the esoteric and spiritual communities it serves, aiming for a tool that feels like it was made with care rather than mass-produced. Whether you're deep into your practice or just starting to explore astrology and tarot, Aetheris gives you a quiet space to return to.\n\nMore features are planned as the app grows beyond its initial release.", "short_description": "Aetheris brings astrology, tarot, and meditation into a living space you can return to daily. Track planetary alignments and your natal chart, draw tarot for guidance, meditate with mantras designed to center you, and journal your reflections \u2014 all inside a calm, immersive HUD. A stereographic window into space lets you watch the cosmos move in real time. Built respectfully for practitioners, by people who take the craft seriously."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/CoachDergie/Aetheris_Alpha_Portfolio/blob/main/docs/aetheris-store-listing.md", "developer_terms_of_service_url": null, "publisher_name": "Michael Shawn Kelley II", "support_website_url": null, "website_url": "https://github.com/CoachDergie/Aetheris_Alpha_Portfolio/tree/main", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1288280007703665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595129854_1379173523792284_8615027327316415835_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNRN7jLwzSAQ7kNvwEhgNtv&_nc_oc=Adp8goo_mZ_S3cDfbNyTHBFYUagikQsXUafs6VGh--04iTi7CNCW7KiJ3-8VPyWYL-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrvJuhj6Bw_eNAeZjJldMp4hYGrT7f2oyYVk6uZ8ozJg&oe=6AA81769"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aetheris", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1788629160, "lastRevision": 
v/t64.5771-25/75240098_724945605627531_8164801072838808211_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2172irfngYQ7kNvwGdy3v4&_nc_oc=AdrdJoNdwN-m4LE2ci3I7E7nDHPSbAV0tUXkrBYra6f7SMDqdPm8Ns5BQlq9MhyF6lM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OyXD3F2jid4sllR1MZ-1oK8wY_lHeo86vu3SUHPL4ZQ&oe=6A18629B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "536441694593618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75557061_536441697926951_179573195380979877_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUrqp8jNMPAQ7kNvwEBb02H&_nc_oc=AdrUU_IzuL7D8NuewigiZBB1XNgBCiIAz_mOlKB1-9NgeHuF46i1NBMJHeJUn8vGm0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cuSh7ae2nFFEyxBSZg44Te6WcnEfEpOVK_vIjSLMG4A&oe=6A185FF0"}, "display_name": "Awake ECG", "keywords": [], "long_description": "Awake ECG takes you on an immersive journey through inner workings of the human heart. Discover the mysterious world of the natural pacemakers which can produce electrical signals and contract the heart's muscles. Find out the meaning of individual segments of the ECG curve and discover which electrical activities of the heart they represent. Challenge yourself periodically by solving engaging puzzles to test your knowledge of covered material. Awake ECG is suitable for anyone who wants to learn more about how ECG measurements are performed.", "short_description": "Immersive journey through the process of ECG measurement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://awakematerials.blob.core.windows.net/%24web/Legal/APP_Awake_%20PP_20210707.pdf", "developer_terms_of_service_url": null, "publisher_name": "Awake Health", "support_website_url": null, "website_url": "https://awake.health/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
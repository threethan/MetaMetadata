=AdpcGCwHZObbyqoLFSNEBFB0IKVOjBAlN8ITl8sZV_vwMQdVf_OzwbldqfGmp_cQqMc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSgzVhcyVvN3oLtzCK1gGLT1lN4eG0YiFCdMpSrf-0qg&oe=6AFB15AC"}, {"file_name": "screenshot-6-experiment.png", "id": "724945602294198", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75240098_724945605627531_8164801072838808211_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSyTIacbtIgQ7kNvwEryX4D&_nc_oc=Adq1qEQB2ElIUBIdt9K5_AFK1UUXuvHjSWXiO_5KclpBgQXlLht6f48lAPdwN-47jWg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkYTxNEwdvMJbwfOUz3NuKiKMNoC8iH_U8LFaOm9cwHQ&oe=6AFB249B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "536441694593618", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75557061_536441697926951_179573195380979877_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j95dK-hq0GoQ7kNvwFI9B1j&_nc_oc=Adod8Ao_psnIuRq_h6oBRP33VucWxxIstWqsCb-XsAh9iAfqSaVYMOZmVB1_SqmBoAg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSehpaHmVd2u4GMSuPSOJtOCxymcKPDX9RGn_DuhhBM8A&oe=6AFB21F0"}, "display_name": "Awake ECG", "keywords": [], "long_description": "Awake ECG takes you on an immersive journey through inner workings of the human heart. Discover the mysterious world of the natural pacemakers which can produce electrical signals and contract the heart's muscles. Find out the meaning of individual segments of the ECG curve and discover which electrical activities of the heart they represent. Challenge yourself periodically by solving engaging puzzles to test your knowledge of covered material. Awake ECG is suitable for anyone who wants to learn more about how ECG measurements are performed.", "short_description": "Immersive journey through the process of ECG measurement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://awakematerials.blob.core.window
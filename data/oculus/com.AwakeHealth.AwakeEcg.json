=AdqLFO9MYJZ_mzPvLHhP4rTb3m0X6vrx27NpQIan813T2ZH1UyUmZPlgC8zftmFcxkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWd4Il2hSwXoaGRxPu7VMuFXTA36eLXSWcJGVLvsHdQA&oe=6B0DC2EC"}, {"file_name": "screenshot-6-experiment.png", "id": "724945602294198", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240098_724945605627531_8164801072838808211_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lakrA6ZCRCIQ7kNvwE3RZOw&_nc_oc=AdrC_2PJdAs24IQ3QHbyf-HjEXCL-VQ1dP_MWI-KjK5Mgcu_aPs0ggTEKtyKKMly_gQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7LZT--8DAwwGb-q-y2K09PN87j4ldksoSV71HWLrADg&oe=6B0DD1DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "536441694593618", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75557061_536441697926951_179573195380979877_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ils56_aXiLcQ7kNvwGFInfn&_nc_oc=AdpK4RqGv3KGXr-EU-pepWZNyP1HhvMPcyvjbambB_WML1zYpRuVnpY24FtmbxcjotA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkg38cNgkcFipsglKo9iSpBPm_oH5zBHHIupsytSD-YQ&oe=6B0DCF30"}, "display_name": "Awake ECG", "keywords": [], "long_description": "Awake ECG takes you on an immersive journey through inner workings of the human heart. Discover the mysterious world of the natural pacemakers which can produce electrical signals and contract the heart's muscles. Find out the meaning of individual segments of the ECG curve and discover which electrical activities of the heart they represent. Challenge yourself periodically by solving engaging puzzles to test your knowledge of covered material. Awake ECG is suitable for anyone who wants to learn more about how ECG measurements are performed.", "short_description": "Immersive journey through the process of ECG measurement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://awakematerials.blob.core.window
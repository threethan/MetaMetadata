v/t64.5771-25/75240098_724945605627531_8164801072838808211_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7OL7RdOQzQQ7kNvwFGtE6s&_nc_oc=Adrh0u1jwKchcz2Che5k2_SLEGIM6ytaGiC-8Pga3nfvnLoBqIJ7drAaQoQeV_y7huA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMS9qrqdM5-ihBTeAirBojnafS8Xtp-eS4xf6HdUri0Q&oe=6A5B66DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "536441694593618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75557061_536441697926951_179573195380979877_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8dzsRMkwkYQ7kNvwH6GZZF&_nc_oc=Adru5nxZiN_MNA-fqCyZeI3ai7_Br4Ehxxq1XC2g9YK2-CsYKr4DAicy64ceFuPDoMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH4cHv0ykTwDYMyjpYVuEUHxbkyJRNthsrTIVYCvDjWA&oe=6A5B6430"}, "display_name": "Awake ECG", "keywords": [], "long_description": "Awake ECG takes you on an immersive journey through inner workings of the human heart. Discover the mysterious world of the natural pacemakers which can produce electrical signals and contract the heart's muscles. Find out the meaning of individual segments of the ECG curve and discover which electrical activities of the heart they represent. Challenge yourself periodically by solving engaging puzzles to test your knowledge of covered material. Awake ECG is suitable for anyone who wants to learn more about how ECG measurements are performed.", "short_description": "Immersive journey through the process of ECG measurement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://awakematerials.blob.core.windows.net/%24web/Legal/APP_Awake_%20PP_20210707.pdf", "developer_terms_of_service_url": null, "publisher_name": "Awake Health", "support_website_url": null, "website_url": "https://awake.health/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
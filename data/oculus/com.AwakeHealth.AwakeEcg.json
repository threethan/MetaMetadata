=AdqnTpSSV8ANExZBeroJF2J06vBBtmvBm2zx38YwV9CRfXon-aC-3c2QjLmcTOw2Hss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVIpcDWXcPzFqbDHg83RMI5dZXIri8ulEPmiRwfzyYgA&oe=6B0C716C"}, {"file_name": "screenshot-6-experiment.png", "id": "724945602294198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240098_724945605627531_8164801072838808211_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lakrA6ZCRCIQ7kNvwHu84mE&_nc_oc=Ado-6HlCjO-vfNqrTW-YBvPTXWBgT6-SpPn2vNx8PwS5wdtVBzTZyeoGX-_uBYbwPdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGlt9dt6VqZgCDaWmoNkAgGxYHuaY9OhVIZ-4i-jgd9Q&oe=6B0C805B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "536441694593618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75557061_536441697926951_179573195380979877_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ils56_aXiLcQ7kNvwFmIV7I&_nc_oc=Adrsnnp580MDuj-Mg7BlTWbi4wNJV1Eh83gkDczX3O_JEGoYY_QyjqytduMYm2ngL7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQt5Lg-p4GYAysF0MMhTIQ2fuzCfRzSREJBJE6b5Z2Ylg&oe=6B0C7DB0"}, "display_name": "Awake ECG", "keywords": [], "long_description": "Awake ECG takes you on an immersive journey through inner workings of the human heart. Discover the mysterious world of the natural pacemakers which can produce electrical signals and contract the heart's muscles. Find out the meaning of individual segments of the ECG curve and discover which electrical activities of the heart they represent. Challenge yourself periodically by solving engaging puzzles to test your knowledge of covered material. Awake ECG is suitable for anyone who wants to learn more about how ECG measurements are performed.", "short_description": "Immersive journey through the process of ECG measurement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://awakematerials.blob.core.window
v/t64.5771-25/75240098_724945605627531_8164801072838808211_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2172irfngYQ7kNvwFLQrIW&_nc_oc=AdqTHGDNmHfEO0IdBLAr67twQSY304Jxhifz8JnnzasRg7p6ZJGzVjHGVSPTJb2X4NQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65rDtshGSTKGncEh3iCaW8Hk_ZROgg-Y6kO3H0ZfGdHA&oe=6A19B41B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "536441694593618", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75557061_536441697926951_179573195380979877_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PilLxxtYY6MQ7kNvwEdq4_A&_nc_oc=Adojw4C4ikIDN_R0wQ6uDpmdO8E_a-1ddb81oGSApqnPdAWgRbeDq-lYX0X3x3nOhNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5810M7JSjIR0D-yKE-cJ5bxSQIxRxQ1UIN6RpOfCTjtQ&oe=6A19B170"}, "display_name": "Awake ECG", "keywords": [], "long_description": "Awake ECG takes you on an immersive journey through inner workings of the human heart. Discover the mysterious world of the natural pacemakers which can produce electrical signals and contract the heart's muscles. Find out the meaning of individual segments of the ECG curve and discover which electrical activities of the heart they represent. Challenge yourself periodically by solving engaging puzzles to test your knowledge of covered material. Awake ECG is suitable for anyone who wants to learn more about how ECG measurements are performed.", "short_description": "Immersive journey through the process of ECG measurement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://awakematerials.blob.core.windows.net/%24web/Legal/APP_Awake_%20PP_20210707.pdf", "developer_terms_of_service_url": null, "publisher_name": "Awake Health", "support_website_url": null, "website_url": "https://awake.health/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
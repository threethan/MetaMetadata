v/t64.5771-25/75240098_724945605627531_8164801072838808211_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui3-Lvp_N1gQ7kNvwEhykqq&_nc_oc=AdrprB_4T9BUoFGpdpJ3B9uPQa_o1EAsEVa1Hnkm8lY89PEEOehwVXCZoYBbR4W7OzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gh86UOOFThvZsPcjuN7X4ZcDU3oo1sChsESL4dAkh2g&oe=69E36E5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "536441694593618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75557061_536441697926951_179573195380979877_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDdIuFuP7MQQ7kNvwE5bAFp&_nc_oc=AdrZj9AirjjYRq7VJ-V3OFlboxYKzTe0oV_PQK64EqbMSMQ4_WJH7Ge370u1Tvw_mdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ukznwMDjTKRYQbgTk1t0uzp6vYs104YsBxEPjbLr0Ow&oe=69E36BB0"}, "display_name": "Awake ECG", "keywords": [], "long_description": "Awake ECG takes you on an immersive journey through inner workings of the human heart. Discover the mysterious world of the natural pacemakers which can produce electrical signals and contract the heart's muscles. Find out the meaning of individual segments of the ECG curve and discover which electrical activities of the heart they represent. Challenge yourself periodically by solving engaging puzzles to test your knowledge of covered material. Awake ECG is suitable for anyone who wants to learn more about how ECG measurements are performed.", "short_description": "Immersive journey through the process of ECG measurement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://awakematerials.blob.core.windows.net/%24web/Legal/APP_Awake_%20PP_20210707.pdf", "developer_terms_of_service_url": null, "publisher_name": "Awake Health", "support_website_url": null, "website_url": "https://awake.health/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
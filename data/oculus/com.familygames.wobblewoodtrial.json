l, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3338250066372359", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130 \ubb34\ub8cc \uccb4\ud5d8\ud310", "keywords": [], "long_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\ub97c \ubb34\ub8cc\ub85c \uba3c\uc800 \ub180\uc544\ubcf4\uc138\uc694!\n\n\ud83c\udfc1 \uc0c8\ub85c \ub098\uc654\uc5b4\uc694: \uce74\ud2b8 \ub808\uc774\uc2f1 \ub9db\ubcf4\uae30\n\u300c\uacf5\uc6d0 \ud55c \ubc14\ud034\u300d \ucf54\uc2a4\uc5d0\uc11c \ub3d9\ubb3c \uc6b4\uc804\uc790 \ub458\uacfc \ud55c \ubc14\ud034\ub97c \ub2ec\ub824\uc694. \uc624\ub978\ucabd \ubc29\uc544\uc1e0\ub85c \ub2ec\ub9ac\uace0 \uc67c\ucabd \ubc29\uc544\uc1e0\ub85c \uba48\ucd94\uace0, \ud578\ub4e4\uc744 \uaebe\uc73c\uba74\uc11c \uc67c\ucabd \ubc29\uc544\uc1e0\ub97c \uc0b4\uc9dd \ub2f9\uae30\uba74 \ub4dc\ub9ac\ud504\ud2b8! \ub180\uc774\ud130\uc758 \u300c\ub180\uc774\uacf5\uc6d0 \uc9c0\ub3c4\u300d\uc5d0\uc11c \uc5f0\ub450\uc0c9 \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uac00\uc694.\n\n\uccb4\ud5d8\ud310\uc5d0\uc11c \ub180 \uc218 \uc788\ub294 \uac83:\n\ud83c\udfc1 \uce74\ud2b8 \ub808\uc774\uc2f1 (\ucf54\uc2a4 \ud558\ub098, 20km/h, \uc2a4\ud53c\ub4dc\uc804) \u00b7 \ud83c\udfa1 \uad00\ub78c\ucc28 \u00b7 \ud83d\udedd \ubbf8\ub044\ub7fc\ud2c0 (\uae30\ubcf8 \ud06c\uae30) \u00b7 \u2696\ufe0f \uc2dc\uc18c (\uacf0\ub3cc\uc774 \uce5c\uad6c\uac00 \uac19\uc774 \ud0c0\uc694) \u00b7 \ud83c\udf3f \uadf8\ub124 \u00b7 \ud83c\udfa8 \uadf8\ub9bc \uce5c\uad6c (\uc804\ubd80)\n\n\uc815\uc2dd\ud310\uc5d0\uc11c \uc5f4\ub9ac\ub294 \uac83:\n\ud83c\udfc1 \uce74\ud2b8 \ucf54\uc2a4 \uc5ec\ub35f, \ucd5c\uace0 80km/h, \uc544\uc774\ud15c\uc804, \uc0c1\ub300 6\ub300 \u00b7\n\u26a1 \ubc88\uac1c \uc5f4\ucc28 \u00b7 \ud83d\ude97 \ubc94\ud37c\uce74 \u00b7 \ud83c\udfaa \ud68c\uc804\uadf8\ub124 \u00b7 \ud83e\ude82 \uc9da\ub77c\uc778 \u00b7 \ud83c\udf88 \uc5f4\uae30\uad6c \u00b7 \ud83d\uddfc \uc790\uc774\ub85c\ub4dc\ub86d \u00b7\n\ud83c\udfa0 \ud68c\uc804\ubaa9\ub9c8 \u00b7 \ud83e\uddd7 \ud074\ub77c\uc774\ubc0d \ubcbd \u00b7 \ud83c\udf2a\ufe0f \ud68c\uc624\ub9ac \uc810\ud504 \ud0c0\uc6cc \u00b7\n\ud83d\udccf \ub808\ubc84\ub85c \uae30\uad6c \ud0a4\uc6b0\uae30 (\uad00\ub78c\ucc28 100m, \ubbf8\ub044\ub7fc\ud2c0 160m, \uadf8\ub124 48m\u2026)\n\n\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67 \uc628 \uac00\uc871\uc774 \ud568\uaed8\n\uc628 \uac00\uc871\uc774 \ud568\uaed8 \uc990\uae30\ub3c4\ub85d \uc544\ube60\uac00 \uc9c1\uc811 \ub9cc\ub4e0 \uac8c\uc784\uc774\uc5d0\uc694.\n- \uad11\uace0 \uc5c6\uc74c, \uacb0\uc81c \uc5c6\uc74c, \uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4 \uc5c6\uc74c (\uc644\uc804 \uc624\ud504\ub77c\uc778)\n- \uba40\ubbf8 \ubc29\uc9c0 \uc635\uc158\uacfc \ubcf4\ud638\uc790 \uc124\uc815 \ud328\ub110\n- \ud55c\uad6d\uc5b4 \ud3ec\ud568 13\uac1c \uc5b8\uc5b4 \uc9c0\uc6d0", "short_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\ub97c \ubb34\ub8cc\ub85c \uba3c\uc800 \ub180\uc544\ubcf4\uc138\uc694 \u2014 \uc0c8\ub85c \ub098\uc628 \uce74\ud2b8 \ub808\uc774\uc2f1 \ub9db\ubcf4\uae30\uc640 \uad00\ub78c\ucc28, \uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ubbf8\ub044\ub7fc\ud2c0\u00b7\uadf8\ub9bc \uce5c\uad6c, \uc628 \uac00\uc871\uc774 \ud568\uaed8 \uc990\uae30\ub294 \ub180\uc774\ud130"}, {"images": {"nodes": [{"file_name": "hero_3000x900.png", "id": "2123903658491432", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839660_2123903661824765_2798206174647234245_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qgY4srOKXEQ7kNvwFvDU0a&_nc_oc=Ador6_LQLepKWahca7SzpWVrQydqfr72vdhgUzC6jzcAUgxS6O_26BQvf8Xq4ymd1ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStVy3XGWp2En0X2FMZfowEPM-UJuh86QdJYegngkeAtw&oe=6B0C63C0"}, {"file_name": "logo_transparent_3000x1000.png", "id": "1905249557114186", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://sconten
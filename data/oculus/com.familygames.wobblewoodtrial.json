l, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1907716303549716", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130 \ubb34\ub8cc \uccb4\ud5d8\ud310", "keywords": [], "long_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\ub97c \ubb34\ub8cc\ub85c \uba3c\uc800 \ub180\uc544\ubcf4\uc138\uc694!\n\n\ud83c\udfa1 \uc0c8\ub85c \uc5f4\ub9b0 \ub180\uc774\uacf5\uc6d0\n\uccb4\ud5d8\ud310\uc5d0\uc11c\ub3c4 \uad00\ub78c\ucc28\ub97c \ud0c8 \uc218 \uc788\uc5b4\uc694. \ub180\uc774\ud130\uc758 \u300c\ub180\uc774\uacf5\uc6d0 \uc9c0\ub3c4\u300d\uc5d0\uc11c \ubd84\ud64d \ubc84\ud2bc\uc744 \ub204\ub974\uace0, \ub192\uc774 \uc62c\ub77c\uac00 \ub180\uc774\ud130\ub97c \ub0b4\ub824\ub2e4\ubcf4\uc138\uc694.\n\n\uccb4\ud5d8\ud310\uc5d0\uc11c \ub180 \uc218 \uc788\ub294 \uac83:\n\ud83c\udfa1 \uad00\ub78c\ucc28 (\uc0c8\ub85c \ub098\uc654\uc5b4\uc694) \u00b7 \ud83d\udedd \ubbf8\ub044\ub7fc\ud2c0 (\uae30\ubcf8 \ud06c\uae30) \u00b7 \u2696\ufe0f \uc2dc\uc18c (\uacf0\ub3cc\uc774 \uce5c\uad6c\uac00 \uac19\uc774 \ud0c0\uc694) \u00b7 \ud83c\udf3f \uadf8\ub124 \u00b7 \ud83c\udfa8 \uadf8\ub9bc \uce5c\uad6c (\uc804\ubd80)\n\n\uc815\uc2dd\ud310\uc5d0\uc11c \uc5f4\ub9ac\ub294 \uac83:\n\u26a1 \ubc88\uac1c \uc5f4\ucc28 \u00b7 \ud83d\ude97 \ubc94\ud37c\uce74 \u00b7 \ud83c\udfaa \ud68c\uc804\uadf8\ub124 \u00b7 \ud83e\ude82 \uc9da\ub77c\uc778 \u00b7 \ud83c\udf88 \uc5f4\uae30\uad6c \u00b7 \ud83d\uddfc \uc790\uc774\ub85c\ub4dc\ub86d \u00b7\n\ud83c\udfa0 \ud68c\uc804\ubaa9\ub9c8 \u00b7 \ud83e\uddd7 \ud074\ub77c\uc774\ubc0d \ubcbd \u00b7 \ud83c\udf2a\ufe0f \ud68c\uc624\ub9ac \uc810\ud504 \ud0c0\uc6cc \u00b7\n\ud83d\udccf \ub808\ubc84\ub85c \uae30\uad6c \ud0a4\uc6b0\uae30 (\uad00\ub78c\ucc28 100m, \ubbf8\ub044\ub7fc\ud2c0 160m, \uadf8\ub124 48m\u2026)\n\n\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67 \uc628 \uac00\uc871\uc774 \ud568\uaed8\n\uc628 \uac00\uc871\uc774 \ud568\uaed8 \uc990\uae30\ub3c4\ub85d \uc544\ube60\uac00 \uc9c1\uc811 \ub9cc\ub4e0 \uac8c\uc784\uc774\uc5d0\uc694.\n- \uad11\uace0 \uc5c6\uc74c, \uacb0\uc81c \uc5c6\uc74c, \uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4 \uc5c6\uc74c (\uc644\uc804 \uc624\ud504\ub77c\uc778)\n- \uba40\ubbf8 \ubc29\uc9c0 \uc635\uc158\uacfc \ubcf4\ud638\uc790 \uc124\uc815 \ud328\ub110\n- \ud55c\uad6d\uc5b4 \ud3ec\ud568 13\uac1c \uc5b8\uc5b4 \uc9c0\uc6d0", "short_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\ub97c \ubb34\ub8cc\ub85c \uba3c\uc800 \ub180\uc544\ubcf4\uc138\uc694 \u2014 \uc0c8\ub85c \ub098\uc628 \uad00\ub78c\ucc28\uc640 \uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ubbf8\ub044\ub7fc\ud2c0\u00b7\uadf8\ub9bc \uce5c\uad6c, \uc628 \uac00\uc871\uc774 \ud568\uaed8 \uc990\uae30\ub294 \ub180\uc774\ud130"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "1848123279895377", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593878539_1848123283228710_3802180669940030494_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNLGJm_J8C8Q7kNvwEDRoDy&_nc_oc=AdqhzqGaST1ab7jeJ2VDI1PhYDxxK3mpGsINYStEWdKjia3rYqsoUnSVA_30K2pXYps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdbdQGd1ZhQNXvcy5OjKkjbuWnygtip-tTbKR01tkC6Q&oe=6B09C5BA"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1378585075333549", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623185_1378585078666882_5313667995153298401_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bArZjbt3gzwQ7kNvwF2N-3J&_nc_oc=AdqUX6eCn08y0oDN2GewnsrIC9j6bg41yYjI6ma9rCKRmYrihUFOoA4ORoaDWXimKK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ96JS1n0SLNP9S94v8k_4NyGfzLR_4YZI0T0bfhThAQ&oe=6B09C051"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1111141531330788", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-2
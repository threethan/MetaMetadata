with levers (100 m Ferris wheel, 160 m slide, 48 m swing\u2026)\n\n\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67 Fun for the whole family\nA dad built this game for the whole family to enjoy.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Try Wobblewood Park for free \u2014 a taste of the new Kart Racing and the Ferris wheel, plus swing, seesaw, slide and drawing friends, fun for the whole family"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "zh_CN", "zh_HK", "zh_TW", "fr", "es", "de", "pt", "pt_BR", "it", "ru", "tr", "pl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1449284574932156"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839697_1014520795047236_5814816546602703665_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2D9XT65jV8Q7kNvwEymPyU&_nc_oc=Adqi-Wiu9Sx2_hGCw4UjeZbSNjHOXfhxa-nv10jJ2gp14fGfl_Y8MkvqYRaopTeVXs8&_nc_zt=3&_nc_ht=scontent-iad6-
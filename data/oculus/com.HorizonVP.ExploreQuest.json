atl3-1.oculuscdn.com/v/t64.5771-25/38982439_440990064335744_4302072382811777682_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9RjwKAwO1AQ7kNvwFwsbeS&_nc_oc=Adoqi9WVUs-L3mlI84_TuruzQ656MOnpQorZhWn_WrxdB0sJZy_Fo28BRAMMKFnArIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuf8xHR8EKaL_HDVmnHHurtprwjacsJ7inJsl3fo86VQ&oe=6B0B1BBE"}, {"file_name": "Screenshot3.png", "id": "297565462324916", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_297565465658249_6922862324687013877_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7otbsOlsIEoQ7kNvwFvBPpP&_nc_oc=AdooU9j1pSSTuxJX9ObrPeUbsVoJou1YMtbXlwAq1sW8B-yXP2QQMXYow7Vs09E2oq4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQivc2bNDP8qCTvB9vg56pmmWnf_tBy_xhtw30N4KIdaw&oe=6B0B233C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hydrous presents: EXPLORE", "keywords": [], "long_description": "\u201cExplore\u201d is an educational, interactive VR dive on the coral reefs of Palau where you will undergo training to become a marine biologist. You will tag manta rays, monitor ocean health from space, and measure coral reef biodiversity. \u201cExplore\u201d combines underwater 360 video and CGI animation to create a fully interactive ocean environment.\n\nThis experience is presented by The Hydrous, a 501c3 nonprofit organization on a mission to create  equitable access to ocean exploration.  The Hydrous uses engaging, science-based experiences and scalable technologies like VR/AR, with the goal of inspiring ocean connection and marine stewardship. \n\nFor more information or to inquire about supporting our efforts, please visit www.thehydrous.com.", "short_description": "\u201cExplore\u201d is an educational VR dive on the coral reefs of Palau where you will undergo training to become a marine biologist. Tag manta rays, monitor ocean health, and measure coral reef biodiversity."}]}, "develo
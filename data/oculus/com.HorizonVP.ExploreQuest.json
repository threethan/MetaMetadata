iad3-2.oculuscdn.com/v/t64.5771-25/38982439_440990064335744_4302072382811777682_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCiZpXsEjSgQ7kNvwHnq4nX&_nc_oc=Adq2QtS6iuC7tQBRUy3wM7UG50zTklQYevT8cwYO3hcIqG2jLJP0LU_ffA-8jd22LX0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUACbrMOpqXlhImnJ7G3zSvg1F8Iy3ZDc7ww_DUYZWc1w&oe=6B0F103E"}, {"file_name": "Screenshot3.png", "id": "297565462324916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_297565465658249_6922862324687013877_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icnDFQ9pKDIQ7kNvwFPMBVx&_nc_oc=AdoGjvQLvWEcguqkT68N0Z-u5U1UuJUXzkMoUzKA-rQLKgpIGkouKOJ8W5qaOXsTEKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXh678VbRegJuEAgME6L8-iMdaSfEcahwym8lFpYmLO-w&oe=6B0F17BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hydrous presents: EXPLORE", "keywords": [], "long_description": "\u201cExplore\u201d is an educational, interactive VR dive on the coral reefs of Palau where you will undergo training to become a marine biologist. You will tag manta rays, monitor ocean health from space, and measure coral reef biodiversity. \u201cExplore\u201d combines underwater 360 video and CGI animation to create a fully interactive ocean environment.\n\nThis experience is presented by The Hydrous, a 501c3 nonprofit organization on a mission to create  equitable access to ocean exploration.  The Hydrous uses engaging, science-based experiences and scalable technologies like VR/AR, with the goal of inspiring ocean connection and marine stewardship. \n\nFor more information or to inquire about supporting our efforts, please visit www.thehydrous.com.", "short_description": "\u201cExplore\u201d is an educational VR dive on the coral reefs of Palau where you will undergo training to become a marine biologist. Tag manta rays, monitor ocean health, and measure coral reef biodiversity."}]}, "develo
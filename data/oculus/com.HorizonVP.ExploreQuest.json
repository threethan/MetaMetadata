&oh=00_AQJ6MjEFcSm0k6ld2JpXesHXjjSxgAOGGmj5hM8aQ4RD7g&oe=6A98693E"}, {"file_name": "Screenshot3.png", "id": "297565462324916", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974526_297565465658249_6922862324687013877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iezJFWb22EQ7kNvwH5RxLS&_nc_oc=AdpBiNnGsaYYJKv50FHN3rcKPB_IYIBHeXS7XlETeOiepyAP3FoWJ8J8uRR1Afr0UJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOlvcCvExIoHBohCVR7ytqT-M68tlGTNuzwQwHhawDVA&oe=6A98387C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hydrous presents: EXPLORE", "keywords": [], "long_description": "\u201cExplore\u201d is an educational, interactive VR dive on the coral reefs of Palau where you will undergo training to become a marine biologist. You will tag manta rays, monitor ocean health from space, and measure coral reef biodiversity. \u201cExplore\u201d combines underwater 360 video and CGI animation to create a fully interactive ocean environment.\n\nThis experience is presented by The Hydrous, a 501c3 nonprofit organization on a mission to create  equitable access to ocean exploration.  The Hydrous uses engaging, science-based experiences and scalable technologies like VR/AR, with the goal of inspiring ocean connection and marine stewardship. \n\nFor more information or to inquire about supporting our efforts, please visit www.thehydrous.com.", "short_description": "\u201cExplore\u201d is an educational VR dive on the coral reefs of Palau where you will undergo training to become a marine biologist. Tag manta rays, monitor ocean health, and measure coral reef biodiversity."}]}, "developer_name": "Horizon Productions", "developer_privacy_policy_url": "http://horizonvp.com/privacy-policy-hydrous", "developer_terms_of_service_url": null, "publisher_name": "The Hydrous", "support_website_url": null, "website_url": "https://thehydro.us/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cat
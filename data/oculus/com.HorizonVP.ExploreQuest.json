&oh=00_AQA2GQ1sKiStSZmChG32EDMNClVItmXe1Dzut07DjRJ-Vw&oe=6A67697E"}, {"file_name": "Screenshot3.png", "id": "297565462324916", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974526_297565465658249_6922862324687013877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxGyMAoWGU8Q7kNvwF_WOVY&_nc_oc=AdopOc-tg-vPkUnpXxxMkFAEHq9uAZKslfUPYKwUbYBm0TUr8TIjdWoF__x8ZXMQ2_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABwyBvkDSnzfPimB_LcmVtOOHf7s7jJz94DYf9K-Rdkw&oe=6A6770FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hydrous presents: EXPLORE", "keywords": [], "long_description": "\u201cExplore\u201d is an educational, interactive VR dive on the coral reefs of Palau where you will undergo training to become a marine biologist. You will tag manta rays, monitor ocean health from space, and measure coral reef biodiversity. \u201cExplore\u201d combines underwater 360 video and CGI animation to create a fully interactive ocean environment.\n\nThis experience is presented by The Hydrous, a 501c3 nonprofit organization on a mission to create  equitable access to ocean exploration.  The Hydrous uses engaging, science-based experiences and scalable technologies like VR/AR, with the goal of inspiring ocean connection and marine stewardship. \n\nFor more information or to inquire about supporting our efforts, please visit www.thehydrous.com.", "short_description": "\u201cExplore\u201d is an educational VR dive on the coral reefs of Palau where you will undergo training to become a marine biologist. Tag manta rays, monitor ocean health, and measure coral reef biodiversity."}]}, "developer_name": "Horizon Productions", "developer_privacy_policy_url": "http://horizonvp.com/privacy-policy-hydrous", "developer_terms_of_service_url": null, "publisher_name": "The Hydrous", "support_website_url": null, "website_url": "https://thehydro.us/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_cat
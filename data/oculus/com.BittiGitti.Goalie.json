=6e7a0a&_nc_ohc=zqNtsOZdPjwQ7kNvwEUh7HP&_nc_oc=AdqYxRoOA63YzhcVGDKnRXBc0ufNrmbwmdNYDHLZJNQXzbd9ZCLPd1MiXn2nL9F6Sf4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_5mVKGMVnvXAzULklWlPZmVvZTqaZ9AuBIRFuQBjMng&oe=6A8598CF"}, {"file_name": "SS-5.png", "id": "1077630013634443", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75196229_1077630016967776_186279786779265448_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKzscDbiVVAQ7kNvwEmcygT&_nc_oc=AdpqDt1V0A_IoNTc3iFsInI6TljjyevoJ2fAOwfOhMIbWMRteRd1V0mYRfnM2gN-PJc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCUIIeu31c3B_2SRDhyMRGPhVrizkTTWgrTluFJRWTnQ&oe=6A85A0A9"}, {"file_name": "SS-4.png", "id": "497580265813913", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57570299_497580269147246_6336026914640517244_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEojIbB3cgUQ7kNvwHmErEI&_nc_oc=Adq9M53I-kP4NGOFlf6m_d0RiXhNSEd6PkXi0l9r9bMwvz-p1B67Et6cfEgXms2FUsA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHztOdJmB5gJ144SWI4ityowzP9KYYi6Q1f-_3u3L72aQ&oe=6A8593BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Goalie-Cover.png", "id": "581489990460005", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566689_581489993793338_3745997121238122501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQvv1DdqnDIQ7kNvwFD7H9c&_nc_oc=AdofyWHFfOw7Uoq42mDgIiu7F9VNHrQBVTOlbWeGYCxPwh6f06opEREGfren1jn5zwM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBYD0apOYVjdtm9GhHZ7mEQATGFZR2WvKfGjRBcSTaLQ&oe=6A858A34"}, "display_name": "Goalie", "keywords": [], "long_description": "Goalie is a virtual reality game that puts you in the shoes of a goalkeeper. The game is suitable for all ages and offers a calming, minimalistic design that is easy on the eyes. It is great for daily exercise and helps improve your goalkeeping skills. With Goalie, you'll be able to practice your reflexes and hand-eye coordination in a fun and immersive environment. The game features intuitive controls and realistic physics, making it easy to jump right in and start playing. Whether you're a seasoned goalkeeper or just looking for a new way to get active, Goalie is a great choice. So why wait? Put on your VR headset and get ready to defend your goal!", "short_description": "Goalie is a VR game that puts you in the goalkeeper role. Suitable for all ages and featuring a calming design, it's great for daily exercise and improving goalkeeping skills. With realistic physics and intuitive controls, it's easy to jump right in and start playing. Whether you're a seasoned pro or just looking for a fun way to get active, Goalie is a great choice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bitti-gitti.com/vr/goalie#privacy", "developer_terms_of_service_url": null, "publisher_name": "Bitti Gitti", "support_website_url": "https://www.bitti-gitti.com/vr/goalie", "website_url": "https://www.bitti-gitti.com/vr/goalie", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6934337466691492"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569450_1323035118490770_1821920816650141820_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p7ejfz-0z0Q7kNvwHMD76W&_nc_oc=Adr7
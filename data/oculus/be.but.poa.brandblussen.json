1551VoRTcvbw4XjDfsA_B98kA&oe=6AFF044B"}, {"file_name": "Screen5.png", "id": "3998590336868375", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422384_3998590346868374_8839963138820204581_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7GOPyvq5hQQ7kNvwH0ywZo&_nc_oc=Adq02TTWQWJDFSJrt85oo8HGNAWXj7J004n1pxKkHeerUUGKpHaOuUlVDBThHgnGNmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYYXwH5D1HHHqtYNUSgF91QlLzcDmjJdkiEx649570jw&oe=6AFF379E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen5.png", "id": "263876015309815", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036657_263876021976481_59518497031404759_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6wEcOG6nyUQ7kNvwHGtULF&_nc_oc=Ado0xnEE9WkePyJtiBifcO11Grl5lm0wtmlRWvppYKNyt-UcSZ4rdUouB_1xbaePcDE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj1AVZnhRdEXN1rwZvB6dLK9X9fyTIxAVl4LpQD6tJZg&oe=6AFF2C46"}, "display_name": "Fire Extinguishing Training", "keywords": [], "long_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher.\n \nStep into this virtual environment and start with a hands-on tutorial on how to use the controllers and how to interact with the elements around you. Next up are the basics on how to safely check and enter an area with a fire hazard. It's all up to the choice of the correct fire extinguisher after that, so you can eliminate the fire before it's too late. The immersive experience is enhanced with sound effects and with a timer you should beat, to avoid the fire going out of control. ", "short_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url
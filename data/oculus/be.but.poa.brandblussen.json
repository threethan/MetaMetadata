-whRQa5TuQW6zsS4I8IdBDk6D1Lyu5a-KkEuo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QxfRLEFrk2MWVK-rFsGWbGeWdlbKOLjfgZ6_RK4CJZA&oe=69D900DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen5.png", "id": "263876015309815", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036657_263876021976481_59518497031404759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fFC9WBZ3zQQ7kNvwFce4JK&_nc_oc=AdoIEXDRA_Rr88sr860wHlULxIZcTdI14xLE-0Tg4wv6hTOCVdbn9Kt2fJzqXwHK1s4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YtD0256Cxmc0-ZvYRKWO6bRusp2dwWs-3AeYpcfhvgw&oe=69D8F586"}, "display_name": "Fire Extinguishing Training", "keywords": [], "long_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher.\n \nStep into this virtual environment and start with a hands-on tutorial on how to use the controllers and how to interact with the elements around you. Next up are the basics on how to safely check and enter an area with a fire hazard. It's all up to the choice of the correct fire extinguisher after that, so you can eliminate the fire before it's too late. The immersive experience is enhanced with sound effects and with a timer you should beat, to avoid the fire going out of control. ", "short_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url": "https://poa-vr-training.butweb.com/", "developer_terms_of_service_url": null, "publisher_name": "B\u00b7U\u00b7T", "support_website_url": null, "website_url": "https://poa-vr-training.butweb.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics"
deo_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen5.png", "id": "263876015309815", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036657_263876021976481_59518497031404759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQM8hOiHCaAQ7kNvwG_x2Z8&_nc_oc=AdngBvn7uheGw6UtHgxx3IbgHhrsT8i7Da3LronFIakAM1JLIbtZE9cT1dYjGKkf_Qg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuFsn0z2ZbLAWAiPmZHcS8ij-aiEM0It4e5ToQ2-BYbbA&oe=69A19686"}, "display_name": "Fire Extinguishing Training", "keywords": [], "long_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher.\n \nStep into this virtual environment and start with a hands-on tutorial on how to use the controllers and how to interact with the elements around you. Next up are the basics on how to safely check and enter an area with a fire hazard. It's all up to the choice of the correct fire extinguisher after that, so you can eliminate the fire before it's too late. The immersive experience is enhanced with sound effects and with a timer you should beat, to avoid the fire going out of control. ", "short_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url": "https://poa-vr-training.butweb.com/", "developer_terms_of_service_url": null, "publisher_name": "B\u00b7U\u00b7T", "support_website_url": null, "website_url": "https://poa-vr-training.butweb.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MO
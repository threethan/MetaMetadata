VyiVk6AM5XJH-pqdsS55a99nw&oe=6B05D40B"}, {"file_name": "Screen5.png", "id": "3998590336868375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422384_3998590346868374_8839963138820204581_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVwwwAlzD_QQ7kNvwFBuA5C&_nc_oc=AdqW6xIVW4Z18WEDJhRMdVW_4jVaQMkQlBg0lU50OZTVdlRyhKF9hRto5vbzUeO5_ME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzUJ-kFgdy5pPmHjUl6nfKUzbTFUGte7oOr8_kTbsc2g&oe=6B05CF1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen5.png", "id": "263876015309815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036657_263876021976481_59518497031404759_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r4gKuqbMlAQ7kNvwGcnz6x&_nc_oc=AdqlRst5ssEp1AYNsUHXtTVomwfPHxQD07PZG0QI7IhGCW9oFqhZo4K81yoYmBx8I5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQno1YGeeFxugAF_Pb9M8vxm2yIAIWvSINMSlZUEqae9A&oe=6B05C3C6"}, "display_name": "Fire Extinguishing Training", "keywords": [], "long_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher.\n \nStep into this virtual environment and start with a hands-on tutorial on how to use the controllers and how to interact with the elements around you. Next up are the basics on how to safely check and enter an area with a fire hazard. It's all up to the choice of the correct fire extinguisher after that, so you can eliminate the fire before it's too late. The immersive experience is enhanced with sound effects and with a timer you should beat, to avoid the fire going out of control. ", "short_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url
zGlVJYd_tXpiN3ZfknHUStaBORdNZjsPgGnNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIkSBUq30UrGQLEraRQjFrfKqRhXg30liph_T8txSDWA&oe=6A4D04DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen5.png", "id": "263876015309815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036657_263876021976481_59518497031404759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOywm3GejlsQ7kNvwEsbICJ&_nc_oc=AdrmvxQPGVjMmG1rrQ0gvTzNqI4OEKf-gVJcuhvD38soxEsvO3rm_YZOtkJpB0S3kd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjdn-lOiOX1iDuwo6DiqN07hEN3E2msl9ejnyHiAUGAQ&oe=6A4CF986"}, "display_name": "Fire Extinguishing Training", "keywords": [], "long_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher.\n \nStep into this virtual environment and start with a hands-on tutorial on how to use the controllers and how to interact with the elements around you. Next up are the basics on how to safely check and enter an area with a fire hazard. It's all up to the choice of the correct fire extinguisher after that, so you can eliminate the fire before it's too late. The immersive experience is enhanced with sound effects and with a timer you should beat, to avoid the fire going out of control. ", "short_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url": "https://poa-vr-training.butweb.com/", "developer_terms_of_service_url": null, "publisher_name": "B\u00b7U\u00b7T", "support_website_url": null, "website_url": "https://poa-vr-training.butweb.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics"
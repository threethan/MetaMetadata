5K6Lc0wJuDFkb-fGXfalfP8gQ&oe=6B07258B"}, {"file_name": "Screen5.png", "id": "3998590336868375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422384_3998590346868374_8839963138820204581_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVwwwAlzD_QQ7kNvwFIR8V9&_nc_oc=AdoWilwc_P2mIg0Qv7BAYdJ5ZQ48YUIRRhby2t3yNW5J74WFiMFDUWInMHw5gWhizw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgkF4j2tX3EmyVHTXrgOPWlIfJzOXDTcrA-tDLv7CCJQ&oe=6B07209E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen5.png", "id": "263876015309815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036657_263876021976481_59518497031404759_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r4gKuqbMlAQ7kNvwFHrD6V&_nc_oc=AdoJWvnUe71vcvem2FJB7PGJzfZ8Q-s5QAJ5l69y1EA1IWjD4TxA1CIOwAcFvPvELAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOOOU_SwNdGUZ4X2PtlDoRA6uMSnTwEKUdfKC7ozfeLA&oe=6B071546"}, "display_name": "Fire Extinguishing Training", "keywords": [], "long_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher.\n \nStep into this virtual environment and start with a hands-on tutorial on how to use the controllers and how to interact with the elements around you. Next up are the basics on how to safely check and enter an area with a fire hazard. It's all up to the choice of the correct fire extinguisher after that, so you can eliminate the fire before it's too late. The immersive experience is enhanced with sound effects and with a timer you should beat, to avoid the fire going out of control. ", "short_description": "Immersive fire extinguishing training, educating users on the basics of door inspection, fire hazard identification and the choice of the correct fire extinguisher."}]}, "developer_name": null, "developer_privacy_policy_url
RmTTYubBLgcRW5vMNQIH8ltxJoFlm1FCP1U0t5uiQ&oe=6A25A186"}, {"file_name": "image_057_0000.png", "id": "1079793563491605", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982637_1079793566824938_4687295994691129773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNqhxMYTUv8Q7kNvwEMLnBp&_nc_oc=AdoGufp06-jO2b99qD4krA-R9vQo_d9NO4T4pT_JpVDSOmcTlYGU7gqByUTsFA5JAGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pF0ClhPR93XD7OkThDTH3XUhMp8JxzZ4Rn3g9HLyrcA&oe=6A257A01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_022_0000.png", "id": "1692054088022372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036686_1692054091355705_1201669671307665498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D10_V7Ouzr4Q7kNvwFaYhHy&_nc_oc=Adr6ELZzcgM0uOhuMrem-gQC8CxagW01qLOOvi8Lp0Fzo1VVPT5Y9iiTDhrNcF7vUgk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c8l4XDi00TsJ6VxVAgsBkJ2cUN98MAKQGMvlvOT-ViQ&oe=6A2571E6"}, "display_name": "sky4u", "keywords": ["Flying", "Drone", "Island", "Photo", "Camera"], "long_description": "sky4u is a VR adventure game. The action of the game takes place in various exotic locations. As a metaphor for the extinction of endangered animal species, we have created totems dedicated to them, which are currently in ruins. The player\u2019s task is to find and reconstruct them. As a search tool, the player employs an RC drone, which must be utilized to locate and repair broken totems on the islands. Each location is dedicated to one endangered animal species. Let's start with penguins! The user must develop their drone control, dashboard monitoring, and photography skills. The aim of the game is to teach players how to operate RC drones so that he can focus more on the quality of the photographs. The most important thing to get good photos is to follow the basic principles of frame composition. Let's start with the simplest - rule of thirds.", "short_description": "sky4u is a VR adventure game. The action of the game takes place in various exotic locations. As a metaphor for the extinction of endangered animal species, we have created totems dedicated to them, which are currently in ruins. The player\u2019s task is to find and reconstruct them. As a search tool, the player employs an RC drone, which must be utilized to locate and repair broken totems on the islands. Each location is dedicated to one endangered animal species. Let's start with penguins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://marisputns.wixsite.com/sky4u/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Studio Perspective & TAPP", "support_website_url": null, "website_url": "https://marisputns.wixsite.com/sky4u", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8424402384307832"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1383401179611909"}, {"status": "PUBLISHED", "id": "1641580163154931"}, {"status": "PUBLISHED", "id": "896657788631389"}]}, "baseline_offer": {"id": "896657788631389"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "1383401179611909"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8
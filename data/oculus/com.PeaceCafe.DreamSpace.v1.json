0CFE"}, {"file_name": "DreamSpace (5).png", "id": "672208938544421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830597_672208941877754_2547278003341131403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iHhvMjWkI0Q7kNvwFRJWQ0&_nc_oc=Ado7Ba4TrH3xvbTZBmgSCIk4n1aJQgmam_SjBeXrN9inH_F2zPrzSYrZsFfcxKOQuqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHux-X74lOqiBXRBGcqTMW76uk3qUabbxof-mDwBPlAQ&oe=6ABD0CE3"}, {"file_name": "DreamSpace (7).png", "id": "689980760369167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830811_689980763702500_433972693049023991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4Bj2fa3ExEQ7kNvwHLFTy2&_nc_oc=Ado3c2xLHrmSYrgqjRjLeGmPKsrDWBtb1Zvh62j0uyzwfZe1kcXDdEMoCfirSUwyYgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsMuLhyBIf1v3U21mm_yM2a8EVoKgiNuG2kHomlOL5KA&oe=6ABD2A9C"}, {"file_name": "DreamSpace (1).png", "id": "720018570348258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830803_720018573681591_4516636917793306379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQECCCqsGPkQ7kNvwESspzU&_nc_oc=AdqzUaqwi2XmwspSrcR4tRuN8zvjhkyKS9ctQKEfvKTO8I5ilp9aif52bAL04JJhQc4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgFyrYS01RW4uHwdjGYY2jOy2dJYs2bAn6FAqg5IlU2g&oe=6ABD0FCD"}, {"file_name": "DreamSpace (6).png", "id": "2144210432710267", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830914_2144210436043600_2350162647404380904_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgkqtjQ2tDUQ7kNvwGpi_Tc&_nc_oc=AdpBvzBI4RFmPhLnA3OtHxalNCzwmKdtSqsLhwvgYOTT6qTmvcbDSgVTVpywn2YQRTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuiHT6DaflLwN99Y_J4I1znl9ts-ogUbZ6VKeGfScqIg&oe=6ABD306A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtDreamSpace2 (5).png", "id": "976976174634786", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391782_976976177968119_5144212182338076633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWuxUye7-fkQ7kNvwEDbVdM&_nc_oc=AdqDYOjX2QdoQMvMELE63hY0ibZHmgo-dhQ5D-bt6U0Q_35kZlmGQKEgBSp2mTc4UlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaox5Mq858kpDtQBu0bFafz1DpuSLfEXia6Bi325DWlg&oe=6ABD2131"}, "display_name": "DreamSpace: The Ceiling Edition", "keywords": ["sky", "opensky", "ceiling", "space", "dream"], "long_description": "What if your ceiling wasn\u2019t the limit? \n\nLook up \u2014 the ceiling opens, and the sky takes over. \n\n**DreamSpace: The Ceiling Edition** transforms your room into a tranquil sky haven. Watch **slow-moving clouds** drift overhead in stunning **mixed reality**. It\u2019s a peaceful glimpse into a world beyond \u2014 and this is just the beginning. \n\n**Soon, you\u2019ll be able to open windows too.**\n\n# \ud83c\udf24\ufe0f Gesture to Reveal the Sky\nUse your hands to perform the sequence: Rock \u2192 Rock \u2192 Paper.\nWatch as the ceiling opens and DreamSpace transforms your room into a sky-lit space.\n\n**Tip**: If the second \"Rock\" isn't recognized, momentarily switch to a different pose before trying again. This helps with detection.\n\n{1888173781975134}\n\n# \ud83c\udfa5 Beautiful Clouds, Captured on Meta Quest\nEverything you see \u2014 from the soft, moving sky to the ceiling reveal \u2014 was **recorded directly in VR** using the Meta Quest headset.\nThis is real footage from inside the headset. No effects, no mockups \u2014 just DreamSpace as it truly looks.\n\n{684465380784702}\n\n# \ud83e\udded Designed to Work with Everything You Do\n\nDreamSpace is made to enhance your everyday VR use.\n**Browse the web, read books, listen to music, connect to your remote desktop, or watch YouTube and movies** \u2014 all while enjoying beautiful clouds above you.\n\nPress the Home button on your Meta Quest to open any app like Instagram, Spotify, or Netflix.\nDreamSpace continues running in the background, adding atmosphere to your space.\n\n\n\n{466320606502574}", "short_description": "What if your ceiling wasn\u2019t the limit?\nLook up \u2014 the ceiling opens, and the sky takes over.\nDreamSpace: The Ceiling Edition transforms your room into a tranquil sky haven. Watch slow-moving clouds drift overhead in stunning mixed reality. It\u2019s a peaceful glimpse into a world beyond \u2014 and this is just the beginning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pranay-garg.github.io/DreamSpace/", "developer_terms_of_service_url": null, "publisher_name": "VR Tales", "support_website_url": null, "website_url": "https://linktr.ee/VR_Tales", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9449316751845651"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1539026914596095"}, {"status": "PUBLISHED", "id": "1839129650124221"}, {"status": "PUBLISHED", "id": "1802283207834887"}, {"status": "PUBLISHED", "id": "1442544040456980"}]}, "baseline_offer": {"id": "1802283207834887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781892000, "status": "PUBLISHED", "id": "1539026914596095"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27850824104601636", "version": "0.6.9"}, "id": "9363033383795268", "channel
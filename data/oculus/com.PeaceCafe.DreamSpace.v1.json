dpH8SabnZMzVebjCbT020YzQ-rCKgcjF06wzeIP6xGf3ElvLd3XS_B2mFD_XZFKSRI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJznD0tdfWNCUUaFgjYkLo2nv9Y7TJrT7PcPDZny6Yj_w&oe=6AAE9BC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewCoverArt.png", "id": "2097588864311493", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619465_2097588867644826_6625601443708388754_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8f4zj6J5zM0Q7kNvwHgWQg0&_nc_oc=AdpptWM1xTERoPi5VjXxZwb1BJD3ARxHGOVOR17hileDevrG1Qi1vfNCMVaVObSi6Wk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHkE70LtUq4C_Po0wjP6tuYa5JxYgR-XplhdQ-pznlYA&oe=6AAEA70F"}, "display_name": "DreamSpace: Mixed Reality Home", "keywords": ["environment", "relax", "rain", "space", "experience"], "long_description": "Step into DreamSpace, where your room becomes something extraordinary.\nTransform your physical space into breathtaking mixed reality worlds that blend seamlessly with your surroundings. \n# \ud83c\udf0d Explore High-Resolution Living Environments\n\n{1976847403168819}\n\n# \ud83d\udc26 Interactive elements in each environment\n\n{2196095474476157}\n\n{991361476787878}\n\n# \ud83d\udc40 Try new Full VR Mode with Smart Passthrough \ud83d\udc46\ud83c\udffb\n\n# \ud83d\uddbc\ufe0f Place Virtual Windows in Your Space\n\n{1154762246762858}\n\n# \ud83e\udded Use as Ambient Background for Anything You Do\n\n{1592226745177729}\n\n# \u2699\ufe0f Customize Your Environments\n\n{1006012488542533}\n\n# \ud83d\ude80 Unique Room Transformations\n\n{1727034698710008}", "short_description": "Turn your room into a living world.\nDreamSpace transforms your space into immersive mixed reality environments, from peaceful courtyards to stormy seas and skies above the clouds, while you browse, watch, work, or play."}]}, "developer_name": "VR Tales", "developer_privacy_policy_url": "https://pranay-garg.github.io/DreamSpace/", "developer_terms_of_service_url": null, "publisher_nam
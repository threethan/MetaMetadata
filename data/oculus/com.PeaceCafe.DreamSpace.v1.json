F4FE"}, {"file_name": "DreamSpace (5).png", "id": "672208938544421", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830597_672208941877754_2547278003341131403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGPt9GdnQnwQ7kNvwHYpjbF&_nc_oc=AdrZOe0RgdmuvGoVWFIq30_NVskB_rUpSb4MjTY18J820-e-Tp6NsTDB9uaY4BRcSW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK6KF9cj3Pfmd6zEUrTNHsmYbabKx1dCeHQvVodTCYGg&oe=6AA7F4E3"}, {"file_name": "DreamSpace (7).png", "id": "689980760369167", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830811_689980763702500_433972693049023991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aICJ3AqK-BMQ7kNvwGXKihc&_nc_oc=Adpa9XyFyNr1hq2n2Yw_C5dVk0ZHQ1NN1qB3uHH20WfL5Fyr-PXgXCHl6f_OHZM9pYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxA1g4NG_kpfP-6bNq3n9ro0SptkOOnc_xPMOPKJhL8A&oe=6AA8129C"}, {"file_name": "DreamSpace (1).png", "id": "720018570348258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830803_720018573681591_4516636917793306379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDWWZdCHNJAQ7kNvwEEAekX&_nc_oc=AdqPV6Kik_cKsx7JxgL3zaT-X3x3U78lG3OU0xx4ClZc_WnHLevDpzV0ygoBQsl1x7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfFo3DuyssS-c1q6lQ5LSJOzCyrvsZUVsGet_cULnOEg&oe=6AA7F7CD"}, {"file_name": "DreamSpace (6).png", "id": "2144210432710267", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830914_2144210436043600_2350162647404380904_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hcofl0jxykQ7kNvwFAoQTY&_nc_oc=AdoNpDjHns4ZBJdB7VWvDdF4D76PXUy1C2tO8CdA8RtU78ShrohBtJFBtQ306aUr7-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAirvuBpkERrQoIDb5P4Ief0c5Qk6JhRjcvnt0cQvfIw&oe=6AA8186A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtDreamSpace2 (5).png", "id": "976976174634786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391782_976976177968119_5144212182338076633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDYan9xsHJQQ7kNvwE5KtCt&_nc_oc=AdrF7vQoMjZj_j0-qy-_2HzLMe6lq2x_INJ4oZ0ZB5YR7l5dUu_HgYWLStwFO9XORds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyN4HGpfN8Lev_5_-yMywSuwShebUcWDLSyam-zuOQSQ&oe=6AA80931"}, "display_name": "DreamSpace: The Ceiling Edition", "keywords": ["sky", "opensky", "ceiling", "space", "dream"], "long_description": "What if your ceiling wasn\u2019t the limit? \n\nLook up \u2014 the ceiling opens, and the sky takes over. \n\n**DreamSpace: The Ceiling Edition** transforms your room into a tranquil sky haven. Watch **slow-moving clouds** drift overhead in stunning **mixed reality**. It\u2019s a peaceful glimpse into a world beyond \u2014 and this is just the beginning. \n\n**Soon, you\u2019ll be able to open windows too.**\n\n# \ud83c\udf24\ufe0f Gesture to Reveal the Sky\nUse your hands to perform the sequence: Rock \u2192 Rock \u2192 Paper.\nWatch as the ceiling opens and DreamSpace transforms your room into a sky-lit space.\n\n**Tip**: If the second \"Rock\" isn't recognized, momentarily switch to a different pose before trying again. This helps with detection.\n\n{1888173781975134}\n\n# \ud83c\udfa5 Beautiful Clouds, Captured on Meta Quest\nEverything you see \u2014 from the soft, moving sky to the ceiling reveal \u2014 was **recorded directly in VR** using the Meta Quest headset.\nThis is real footage from inside the headset. No effects, no mockups \u2014 just DreamSpace as it truly looks.\n\n{684465380784702}\n\n# \ud83e\udded Designed to Work with Everything You Do\n\nDreamSpace is made to enhance your everyday VR use.\n**Browse the web, read books, listen to music, connect to your remote desktop, or watch YouTube and movies** \u2014 all while enjoying beautiful clouds above you.\n\nPress the Home button on your Meta Quest to open any app like Instagram, Spotify, or Netflix.\nDreamSpace continues running in the background, adding atmosphere to your space.\n\n\n\n{466320606502574}", "short_description": "What if your ceiling wasn\u2019t the limit?\nLook up \u2014 the ceiling opens, and the sky takes over.\nDreamSpace: The Ceiling Edition transforms your room into a tranquil sky haven. Watch slow-moving clouds drift overhead in stunning mixed reality. It\u2019s a peaceful glimpse into a world beyond \u2014 and this is just the beginning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pranay-garg.github.io/DreamSpace/", "developer_terms_of_service_url": null, "publisher_name": "VR Tales", "support_website_url": null, "website_url": "https://linktr.ee/VR_Tales", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9449316751845651"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1539026914596095"}, {"status": "PUBLISHED", "id": "1839129650124221"}, {"status": "PUBLISHED", "id": "1802283207834887"}, {"status": "PUBLISHED", "id": "1442544040456980"}]}, "baseline_offer": {"id": "1802283207834887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781892000, "status": "PUBLISHED", "id": "1539026914596095"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27850824104601636", "version": "0.6.9"}, "id": "9363033383795268", "channel
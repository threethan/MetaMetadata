G4zr6khCrZz6nCHtmgw&oe=6AFDE18D"}, {"file_name": "DreamSpace (6).png", "id": "2144210432710267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830914_2144210436043600_2350162647404380904_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CI7tijmadcQ7kNvwFRies4&_nc_oc=AdpbxfbWo37b53GjSd3oK0UggdQYyFRRaD9lUqfJM6Zb37Ei3iiCLWMoRYoAWlfqMi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6ayXBlEVhYwuvhaT559ISeZ-DYsLr5Kn8jQ394ZkGuw&oe=6AFDC9EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtDreamSpace2 (5).png", "id": "976976174634786", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391782_976976177968119_5144212182338076633_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxMbUHSEHgwQ7kNvwHj-D_y&_nc_oc=AdrL3TL_EUEjwPhiaVgrQKhRcqdeL92PwJL-r85uvTVV0QsqYpP5SWDJ-cr1YXYQW4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUEmUZ2pVEzQRFaF5s0bn9l5I-j-X9CNKzBLo5GpP_HA&oe=6AFDBAB1"}, "display_name": "DreamSpace: The Ceiling Edition", "keywords": ["sky", "opensky", "ceiling", "space", "dream"], "long_description": "What if your ceiling wasn\u2019t the limit? \n\nLook up \u2014 the ceiling opens, and the sky takes over. \n\n**DreamSpace: The Ceiling Edition** transforms your room into a tranquil sky haven. Watch **slow-moving clouds** drift overhead in stunning **mixed reality**. It\u2019s a peaceful glimpse into a world beyond \u2014 and this is just the beginning. \n\n**Soon, you\u2019ll be able to open windows too.**\n\n# \ud83c\udf24\ufe0f Gesture to Reveal the Sky\nUse your hands to perform the sequence: Rock \u2192 Rock \u2192 Paper.\nWatch as the ceiling opens and DreamSpace transforms your room into a sky-lit space.\n\n**Tip**: If the second \"Rock\" isn't recognized, momentarily switch to a different pose before trying again. This helps with detection.\n\n{1888173781975134}\n\n# \ud83c\udfa5 Beautiful Clouds, Captured on Meta Quest\nEverything you see \u2014 from the soft, moving sky to the ceiling reveal \u2014 was **recorded directly in VR** using the Meta Quest headset.\nThis is real footage from inside the headset. No effects, no mockups \u2014 just DreamSpace as it truly looks.\n\n{684465380784702}\n\n# \ud83e\udded Designed to Work with Everything You Do\n\nDreamSpace is made to enhance your everyday VR use.\n**Browse the web, read books, listen to music, connect to your remote desktop, or watch YouTube and movies** \u2014 all while enjoying beautiful clouds above you.\n\nPress the Home button on your Meta Quest to open any app like Instagram, Spotify, or Netflix.\nDreamSpace continues running in the background, adding atmosphere to your space.\n\n\n\n{466320606502574}", "short_description": "What if your ceiling wasn\u2019t the limit?\nLook up \u2014 the ceiling opens, and the sky takes over.\nDreamSpace: The Ceiling Edition transforms your room into a tranquil sky haven. Watch slow-moving clouds drift overhead in stunning mixed reality. It\u2019s a peaceful glimpse into a world beyond \u2014 and this is just the beginning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pranay-garg.github.io/DreamSpace/", "developer_terms_of_service_url": null, "publisher_name": "VR Tales", "support_website_url": null, "website_url": "https://linktr.ee/VR_Tales", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "
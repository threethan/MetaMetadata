age.png", "id": "3676731005950095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391930_3676731009283428_1629259966996928805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZQuv5k_m3gQ7kNvwG4-28J&_nc_oc=Adrx42e8uRH9ulF03Hmq7bqRRt3Xxt3L_8fryt04pIRc7hrTjOjpCy6PCWHuTXVt8n0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wWkXI6LMvsg8W0lEFp4tbJUQLZ61B4Me1ePtuKOv4Dw&oe=69FF2C2D"}, {"file_name": "Skelly_Screenshot_3.png", "id": "1688657872068761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392027_1688657878735427_8260935711103247800_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfTlb_cE0NwQ7kNvwHm5yfc&_nc_oc=Adpe0k_mP5dCqD5WIw3BXQgBBXKpwS_Io0GgEQcrDw7ePPHwmzGlkF66POFMXhb-k-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a-rUniiuXhutUZ6GVpgY2EqYPkVKztzQPRb2VN7OdCg&oe=69FF211B"}, {"file_name": "Skelly_Screenshot_4.png", "id": "2747505128779360", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393846_2747505132112693_1788608673590821066_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq4vIG5uVu4Q7kNvwHeb1ha&_nc_oc=AdqWBDzzh8_zsT9S46gdzN2lGCE3uX9vvmC1ErgWZ9f4qbUuJKp7md34pu7sQNjjdEE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UewUNUZtkZHBK0qOm69RMQ1SFz4tms9mSGUFIXYyrtw&oe=69FF518B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rage Ball 2.0 Update 2560x1440 Store Image.png", "id": "1593148028434241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619465_1593148031767574_8735979540957746822_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAAQjaPnFo4Q7kNvwFVejmN&_nc_oc=Adomso-frIXTONlbwCr8nl7hIx-XMiBgerHbgQ4339dp1kPoIQADpctrsbMmE69b38Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_ZiAH3xB2F7p0WQnmO_GzE4u1BSomJY-9SCOWcxMZ2Q&oe=69FF4A06"}, "display_name": "Skelly", "keywords": [], "long_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes and check out our rotating shop with many items to wear and hold to be the coolest Skelly!\n\nGame Modes:\nKnockout - Knockout is a fast paced, action packed game mode where the last person alive wins! Punch people, use baseball bats, grenades, smoke bombs and blasters to knock people off the map to claim your crown as the winner of Knockout!\n\nCapture the Bone - Up to 14 players go head to head in a blue vs red capture the bone match! Play defense and punch people away from your bone, play offense and grab the bone at the enemy base and bring the bone back to get the ultimate reward of scoring a point for your team! \n\nFreeze Tag - Don't let the freezers freeze you... RUN!! If a fellow runner gets frozen into an ice cube, grab a bone and crack them out! \n\nJoin the Skelly Discord - https://discord.gg/skellygame", "short_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes, Knockout, Capture the Bone and Freeze Tag! Check out our rotating shop with many items to wear and hold to be the coolest Skelly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skellystudios.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skelly Studios", "support_website_url": null, "website_url": "https://skellystudios.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommend
ot_3.png", "id": "1688657872068761", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392027_1688657878735427_8260935711103247800_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWtA0Qj5xdYQ7kNvwGglhp7&_nc_oc=AdqAKNQxjHMFjJiy1kP5uv5UDs7IvyGhsqikwKbI07Dvp6QPmIC5R0fIyx8I_Fz8uFU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vs0Fb-ndnEgOc_X22zHali5_rRNrbc8BeT6LhjUjD_w&oe=6A3020DB"}, {"file_name": "Skelly_Screenshot_4.png", "id": "2747505128779360", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393846_2747505132112693_1788608673590821066_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXVk84Sa_-oQ7kNvwHrcddD&_nc_oc=AdrI1sg8HTeyCK4p2aScLvuwoH2RhVmwfSFtPNZXthcTEA00iFrS3V50hUOCeAN6zcU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8awNlw5731XPuKrrPPIXDD3ctNC-tAwz6Xi0iJs6SX1Q&oe=6A30190B"}, {"file_name": "Rage_Ball_Store_Image_2.png", "id": "1444268063672375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620504_1444268067005708_7158309849859262616_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doEtMzRcr5gQ7kNvwH9pqkS&_nc_oc=Adrmyoyy0q6Z0q9bptS5Yk-JWeWMnB5bOpCk6VHodQFA9ruSV_feZsGXVP0bcPTG5u8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DBCiTaJ9hRsBiUZ1XRHyl6m7JD_GZKFH0AUuGqus3Tw&oe=6A301690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rage Ball 2.0 Update 2560x1440 Store Image.png", "id": "1593148028434241", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619465_1593148031767574_8735979540957746822_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpzElMHY138Q7kNvwHQuk6r&_nc_oc=Adocn1VWZ8nZfV6KPlYmjTsUbpwjsxWHY5bWx5duw3-x8YHXAM-O-RqzQQecPMoo_k4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yumr3KisdshKS1Qv2SgjjByDrD9lcYe7Z-IQsa5Q-MQ&oe=6A301186"}, "display_name": "Skelly", "keywords": [], "long_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes and check out our rotating shop with many items to wear and hold to be the coolest Skelly!\n\nGame Modes:\nKnockout - Knockout is a fast paced, action packed game mode where the last person alive wins! Punch people, use baseball bats, grenades, smoke bombs and blasters to knock people off the map to claim your crown as the winner of Knockout!\n\nCapture the Bone - Up to 14 players go head to head in a blue vs red capture the bone match! Play defense and punch people away from your bone, play offense and grab the bone at the enemy base and bring the bone back to get the ultimate reward of scoring a point for your team! \n\nFreeze Tag - Don't let the freezers freeze you... RUN!! If a fellow runner gets frozen into an ice cube, grab a bone and crack them out! \n\nJoin the Skelly Discord - https://discord.gg/skellygame", "short_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes, Knockout, Capture the Bone and Freeze Tag! Check out our rotating shop with many items to wear and hold to be the coolest Skelly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skellystudios.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skelly Studios", "support_website_url": null, "website_url": "https://skellystudios.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
T5fN8g&oe=6B0D9CDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "1824634575247886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303445_1824634578581219_8374288286135805212_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRjoWNxyAb8Q7kNvwEDNRAe&_nc_oc=Adqr4z-izOtM-zUWRoqYFUEqgRtx-Jy8YiOckZeM_7vHrDdEDrOG49BQihed7BgzqOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyZe9GxoBZKMNQgTf7jVm_mMinAXRqsRi4EIsZgGvL6w&oe=6B0DBC5D"}, "display_name": "Skelly", "keywords": ["minigames", "ball", "tag", "obby", "social"], "long_description": "**Secret roles. Freeze Tag. A red ball of death.**\n\nWelcome to **Skelly**, the free VR multiplayer game originally created by popular YouTuber **Fiizy**. You are Skelly a friendly skeleton living a world of minigames \u2013 jump into **Murder Mystery, Freeze Tag, and Rage Ball** with friends.\n\n# Murder Mystery\n**Who\u2019s the killer?** Play as the Murderer, an Innocent, or the Sheriff.  Find the who's the murderer or die.\n\n{2180325982895344}\n\n# Freeze Tag\n**Run. Rescue. Repeat.** Stay out of the freezers\u2019 reach! If a fellow runner gets trapped in an ice cube, grab a bone and crack them free. Your next rescue could put you in the freezers\u2019 path.\n\n{2144639826423959}\n\n# Rage Ball\n**Stay focused. Time your deflection.** A homing ball is hunting players\u2014and it keeps getting faster. Put your timing and strategy to the test as the pressure builds. How long can you handle the heat?\n\n{1922490485824255}\n\n# Hang out and make friends!\nCatch up with friends and fellow Skellys in the lobby between games. Explore the rotating shop for items to wear and hold, and put together a look of your own.\n\n{1536925968277495}\n\n**Download Skelly for free and jump into your next round of VR mayhem!**", "short_description": "Secret roles. Freeze Tag. A red ball of death.\n\nWelcome to Skelly, the free VR multiplayer game originally created by popular YouTuber Fiizy. You are Skelly a friendly skeleton living a world of minigames \u2013 jump into Murder Mystery, Freeze Tag, Rage Ball and much more making friends along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skellystudios.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skelly Studios", "support_website_url": null, "website_url": "https://skellystudios.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28887091687598903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_1493532482632308_1144804224191448184_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVarT9XThIoQ7kNvwGV7_qs&_nc_oc=Adp-YsU7R2rKUJKMd4rXgEx8DPVLDOxYjxq-7mL-EGheWg1fInS1OoF4MNhsc2nPqdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3pTs6OMzOBywQYAmZEPYQopCXWJspZVPoENT5ftjFNQ&oe=6B0DA40A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skelly", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Party Game", "id": "1700921480735423"}, 
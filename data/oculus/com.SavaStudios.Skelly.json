ot_3.png", "id": "1688657872068761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392027_1688657878735427_8260935711103247800_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a93swaGirwQ7kNvwHzCKCR&_nc_oc=Adrc-2EDEJgA_EX5TzLEneIhfUluT2emr1fuzeLGlaL7MH3irxXN1ZlJKk6spUX--GM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i7tXFtc0tuPtycPLsFdUPKCDE4tRaRccceXOdxC88NQ&oe=6A01C41B"}, {"file_name": "Skelly_Screenshot_4.png", "id": "2747505128779360", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393846_2747505132112693_1788608673590821066_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq4vIG5uVu4Q7kNvwFJ85mI&_nc_oc=AdqqY-Kn62R3C8sLfOXntASkPh7CEjH87SUN7EMOBn9k_B5O5SI5YOpOmeYUI__aWR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ORc5hAwqZiynDJtrNTD0CZ_ukY5JM1AF7QPUUY0i3cg&oe=6A01F48B"}, {"file_name": "Rage_Ball_Store_Image_2.png", "id": "1444268063672375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620504_1444268067005708_7158309849859262616_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoQFUccm458Q7kNvwFkNPgS&_nc_oc=AdrmzzGeIvd4YwdXJn46VQR0s7rz8j39Y6YEFiiqQd0gV0d0Rh6_dimzeSg-nCWtNV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IVVZT_hn4TRhq0EHltg0f_2Vyx2VQ74hkX7Hc5hm-Kw&oe=6A01F210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rage Ball 2.0 Update 2560x1440 Store Image.png", "id": "1593148028434241", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619465_1593148031767574_8735979540957746822_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmuU3Xc1AIQQ7kNvwE-U4jq&_nc_oc=AdrcrZrAWM07KITQJktFxD6gvxDsvwQFj_WhoXHFnTLYXdrsr8DLkOhCXm6dpbve_Bw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OIUbP9DmgI22ETYENe8XnZ2cd5k2rAuqv2nhimiHfPQ&oe=6A01ED06"}, "display_name": "Skelly", "keywords": [], "long_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes and check out our rotating shop with many items to wear and hold to be the coolest Skelly!\n\nGame Modes:\nKnockout - Knockout is a fast paced, action packed game mode where the last person alive wins! Punch people, use baseball bats, grenades, smoke bombs and blasters to knock people off the map to claim your crown as the winner of Knockout!\n\nCapture the Bone - Up to 14 players go head to head in a blue vs red capture the bone match! Play defense and punch people away from your bone, play offense and grab the bone at the enemy base and bring the bone back to get the ultimate reward of scoring a point for your team! \n\nFreeze Tag - Don't let the freezers freeze you... RUN!! If a fellow runner gets frozen into an ice cube, grab a bone and crack them out! \n\nJoin the Skelly Discord - https://discord.gg/skellygame", "short_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes, Knockout, Capture the Bone and Freeze Tag! Check out our rotating shop with many items to wear and hold to be the coolest Skelly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skellystudios.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skelly Studios", "support_website_url": null, "website_url": "https://skellystudios.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
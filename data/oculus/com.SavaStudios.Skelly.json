6731005950095", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391930_3676731009283428_1629259966996928805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8O-oYwUiMEQ7kNvwHhq868&_nc_oc=AdppzRhzfyFLBBVAMvb_gHmP4dldY0wiIiV0c07KS28tYhvl1nQ3MFFMOmlb7VhSpmg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bMyOWBTPu_iYJ66KiOMZQg4UCtn2KeHlQ7euNojTSIg&oe=69E22B2D"}, {"file_name": "Skelly_Screenshot_3.png", "id": "1688657872068761", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392027_1688657878735427_8260935711103247800_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjtE8zP4gegQ7kNvwFxVYuq&_nc_oc=AdpxmRDRug1XOAhtNDqfdZB2w8ZX7PkYvulrH5ObJPfRe8AWNH8bfIIPj7T2UZG3eC8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UH-26xjJZGlvm8o06wylTRPUTs_y6zAXT9JdbutPiHQ&oe=69E2201B"}, {"file_name": "Skelly_Screenshot_4.png", "id": "2747505128779360", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393846_2747505132112693_1788608673590821066_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHESscQSiMoQ7kNvwFBLxN6&_nc_oc=AdrwQhHJh4PtNKIt_-JtgO52ytVpVpcK-lz04cHAA1E0nExqj9WeY_iwBRJoIcage0E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37D2O4eF3qC9VvLIafvQHg6RK1tU8TGPiEm7j46SPGRQ&oe=69E2508B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Skelly_Lava_Update_Keyart.png", "id": "1666434854372714", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499622211_1666434861039380_3906247714889569266_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KPyzYiONNkQ7kNvwEuBvvQ&_nc_oc=Adq5nBWAdOJ0ZkFksrOFG1I0wo04O3Mia6_eWrx0owrZz1SjthJOF7Sw3MJasP-rq4w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rA_awWWqbRaACh6MqWyvQ_fQ5lwZb0MEfbyecEqNggA&oe=69E22385"}, "display_name": "Skelly", "keywords": [], "long_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes and check out our rotating shop with many items to wear and hold to be the coolest Skelly!\n\nGame Modes:\nKnockout - Knockout is a fast paced, action packed game mode where the last person alive wins! Punch people, use baseball bats, grenades, smoke bombs and blasters to knock people off the map to claim your crown as the winner of Knockout!\n\nCapture the Bone - Up to 14 players go head to head in a blue vs red capture the bone match! Play defense and punch people away from your bone, play offense and grab the bone at the enemy base and bring the bone back to get the ultimate reward of scoring a point for your team! \n\nFreeze Tag - Don't let the freezers freeze you... RUN!! If a fellow runner gets frozen into an ice cube, grab a bone and crack them out! \n\nJoin the Skelly Discord - https://discord.gg/skellygame", "short_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes, Knockout, Capture the Bone and Freeze Tag! Check out our rotating shop with many items to wear and hold to be the coolest Skelly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skellystudios.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skelly Studios", "support_website_url": null, "website_url": "https://skellystudios.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
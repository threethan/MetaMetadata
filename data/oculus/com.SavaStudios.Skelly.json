g", "id": "3676731005950095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391930_3676731009283428_1629259966996928805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcQGyjFaVMkQ7kNvwF93AbV&_nc_oc=AdrMvO519L-c362UjwBfm98Nnxtq_zXE4o-ReRLHIUcW9nuIwsfH5pYLnrupv5ZZsmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aIYNWOn7IylFwLGbSaq6RdDgF7IPx7Sgy-aj0tmwqNg&oe=69FC892D"}, {"file_name": "Skelly_Screenshot_3.png", "id": "1688657872068761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392027_1688657878735427_8260935711103247800_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAZN5aDI6wcQ7kNvwGOLXMN&_nc_oc=AdrjCw5tR2qN6pmscr8PFOVv-DYvb09nv_Y4S_2z9yvZhIBYj6fctpAMkveAhHSAm3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AENKCb6654_Hn2_mu3ZnvrIu5sBp2EQnhDlZ0Nhrhtw&oe=69FC7E1B"}, {"file_name": "Skelly_Screenshot_4.png", "id": "2747505128779360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393846_2747505132112693_1788608673590821066_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laR-4kXw-KkQ7kNvwHc09w-&_nc_oc=Adpi0Npk6zTmJaYI205qSlubZdTfPGBuEljxkZW5SFyw9KmvBUeaz-fvfOP0ee-enoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v5vtSpYRCDwTPFHjzm9--gF3an3R_GJQZJcYlroRKyg&oe=69FCAE8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rage Ball 2.0 Update 2560x1440 Store Image.png", "id": "1593148028434241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_1593148031767574_8735979540957746822_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAAQjaPnFo4Q7kNvwHxMEdx&_nc_oc=Adpn77r5K-q_LaIpBvmzJD8IM7MfMj_mjNfNBjy3ys8ouYvOSS_Dcci4G9pqbAq0HWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-t36fhTCqEw1AIBXafNsTbv-cflxThRVm1Oc5hRmTRw&oe=69FCA706"}, "display_name": "Skelly", "keywords": [], "long_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes and check out our rotating shop with many items to wear and hold to be the coolest Skelly!\n\nGame Modes:\nKnockout - Knockout is a fast paced, action packed game mode where the last person alive wins! Punch people, use baseball bats, grenades, smoke bombs and blasters to knock people off the map to claim your crown as the winner of Knockout!\n\nCapture the Bone - Up to 14 players go head to head in a blue vs red capture the bone match! Play defense and punch people away from your bone, play offense and grab the bone at the enemy base and bring the bone back to get the ultimate reward of scoring a point for your team! \n\nFreeze Tag - Don't let the freezers freeze you... RUN!! If a fellow runner gets frozen into an ice cube, grab a bone and crack them out! \n\nJoin the Skelly Discord - https://discord.gg/skellygame", "short_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes, Knockout, Capture the Bone and Freeze Tag! Check out our rotating shop with many items to wear and hold to be the coolest Skelly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skellystudios.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skelly Studios", "support_website_url": null, "website_url": "https://skellystudios.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
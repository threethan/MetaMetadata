0sDqWTXO_jM3tqGNl9dt8DsnqdZvxDDLKs0EYh7U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyZYr83eGglLPp0j8Ha1kISpchHwFzOkVfWuGlzFXD5A&oe=6B046D6D"}, {"file_name": "Skelly_Screenshot_4.png", "id": "2747505128779360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393846_2747505132112693_1788608673590821066_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE3h5sa-9n0Q7kNvwEvKvuy&_nc_oc=AdrRGhFkm9CykZ2Z7xkPwSta2uRUnkVbr573wPBlEa6035uTEQCZxdjYDJggM6rFb8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSj3L1poIQgog7VkTq51NIHoLFeqCnCD4v0y6U7O22_A&oe=6B045A8B"}, {"file_name": "Skelly_Screenshot_2.png", "id": "2013092032531829", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392067_2013092035865162_298270481993592188_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9bargeRB3YQ7kNvwElvogl&_nc_oc=AdrwerDxDx8_JJW--Gw_ZlSwJemwO2lBpaSpg_DjGSRBnoqpTNT52ypxqCF49X3qTRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRINWnVGdIQQ_TMIv4M4ITcs5MUad-PISvLyN20vub3bA&oe=6B047099"}, {"file_name": "Skelly_Screenshot_3.png", "id": "1688657872068761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392027_1688657878735427_8260935711103247800_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6pfEEtNe3oQ7kNvwEmZLqB&_nc_oc=Ado7kYmc5gTsKhJNLBBKGijFOcJnWJX-1FyKziC3Pq_AdgqzZV8l1c66H1M26-ugQjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfPpsZPOznNBlcZ1WSti68UsWbWM12ylTBtjol_MK78A&oe=6B04625B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "1824634575247886", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303445_1824634578581219_8374288286135805212_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZYVyqSzOR0Q7kNvwFZLC5I&_nc_oc=AdqVaRTYdlgRvBTu5qEQIwgYKlsS-7NokLl-eNqjteOC9YlAi8tjnGZvVuR2Qq8_sHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0krpGWJG6cgmizg-T23kwyJdiK-IWTTivioEEfPsCFw&oe=6B0481DD"}, "display_name": "Skelly", "keywords": ["minigames", "ball", "tag", "obby", "social"], "long_description": "**Secret roles. Freeze Tag. A red ball of death.**\n\nWelcome to **Skelly**, the free VR multiplayer game originally created by popular YouTuber **Fiizy**. You are Skelly a friendly skeleton living a world of minigames \u2013 jump into **Murder Mystery, Freeze Tag, and Rage Ball** with friends.\n\n# Murder Mystery\n**Who\u2019s the killer?** Play as the Murderer, an Innocent, or the Sheriff.  Find the who's the murderer or die.\n\n{2180325982895344}\n\n# Freeze Tag\n**Run. Rescue. Repeat.** Stay out of the freezers\u2019 reach! If a fellow runner gets trapped in an ice cube, grab a bone and crack them free. Your next rescue could put you in the freezers\u2019 path.\n\n{2144639826423959}\n\n# Rage Ball\n**Stay focused. Time your deflection.** A homing ball is hunting players\u2014and it keeps getting faster. Put your timing and strategy to the test as the pressure builds. How long can you handle the heat?\n\n{1922490485824255}\n\n# Hang out and make friends!\nCatch up with friends and fellow Skellys in the lobby between games. Explore the rotating shop for items to wear and hold, and put together a look of your own.\n\n{1536925968277495}\n\n**Download Skelly for free and jump into your next round of VR mayhem!**", "short_description": "Secret roles. Freeze Tag. A red ball of death.\n\nWelcome to Skelly, the free VR multiplayer game originally created by popular YouTuber Fiizy. You are Skelly a friendly skeleton living a world of minigames \u2013 jump into Murder Mystery, Freeze Tag, Rage Ball and much more making friends along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skellystudios.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skelly Studios", "support_website_url": null, "website_url": "ht
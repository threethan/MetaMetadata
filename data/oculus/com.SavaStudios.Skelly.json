ot_3.png", "id": "1688657872068761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392027_1688657878735427_8260935711103247800_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OZKp_a5UhIQ7kNvwEm6q8A&_nc_oc=Adq69QhutVA2hXemJfXooOGWn1QcjkrcNZxZd9sY1VrHvNXv76mD9Ezd-rJ-_i_mp1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_YB7s23zR3x2gq8Y1LhG8Y6Lx1G70i3dXHNXNfhmpIA&oe=6AAC0DDB"}, {"file_name": "Skelly_Screenshot_4.png", "id": "2747505128779360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393846_2747505132112693_1788608673590821066_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y75zAofZMXQQ7kNvwFHVlL7&_nc_oc=AdpqpzIg3ciFtYwuLoOoEk4PfPEQc1ZP4t2iTVBiXVKNWnE7on7YxWPfA-sgw0eN01c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrLiuSoSnchDJ0i76My62Un3MtxilafmAfSJq6RzFM0w&oe=6AAC060B"}, {"file_name": "Rage_Ball_Store_Image_2.png", "id": "1444268063672375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620504_1444268067005708_7158309849859262616_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IztPCYlmgfcQ7kNvwFtLm-l&_nc_oc=Ado4NWz0eGKwKZF31HQRoma6-Buc8NvjV1hwqBuejT9uG6ikJan7AP1VZZHuggFnp_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnB-RiX_ejX_CbXgj8jULKG6zmFKhcnL3AgKVkqMTqfg&oe=6AAC0390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rage Ball 2.0 Update 2560x1440 Store Image.png", "id": "1593148028434241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_1593148031767574_8735979540957746822_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIsCe7bo9iUQ7kNvwHmZy5J&_nc_oc=AdrqPbX7644oFra8jsT0lFF8YXDdj81aKdEKs6fhvZfSNw9oe2VrttFmpcPboraD_LA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx3cgm0ne8NcuzGMj7WdT8aYWSypJlBWxkYTFSMi3Njg&oe=6AABFE86"}, "display_name": "Skelly", "keywords": [], "long_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes and check out our rotating shop with many items to wear and hold to be the coolest Skelly!\n\nGame Modes:\nKnockout - Knockout is a fast paced, action packed game mode where the last person alive wins! Punch people, use baseball bats, grenades, smoke bombs and blasters to knock people off the map to claim your crown as the winner of Knockout!\n\nCapture the Bone - Up to 14 players go head to head in a blue vs red capture the bone match! Play defense and punch people away from your bone, play offense and grab the bone at the enemy base and bring the bone back to get the ultimate reward of scoring a point for your team! \n\nFreeze Tag - Don't let the freezers freeze you... RUN!! If a fellow runner gets frozen into an ice cube, grab a bone and crack them out! \n\nJoin the Skelly Discord - https://discord.gg/skellygame", "short_description": "Hop in with your friends and play around as a skeleton in a bright and colorful world that we call Skelly! Hangout in the lobby with fellow Skelly's, play any of our 3 action packed game modes, Knockout, Capture the Bone and Freeze Tag! Check out our rotating shop with many items to wear and hold to be the coolest Skelly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skellystudios.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skelly Studios", "support_website_url": null, "website_url": "https://skellystudios.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
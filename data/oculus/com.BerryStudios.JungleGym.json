07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSUU46jlDWAQ7kNvwE3nc1H&_nc_oc=AdpshIYoWjz5khLj0tE7_hKMkfzvqiG6RVsCeQFFHES9bMcDPO2ZGO4vM7fSkCdb_Vg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pNOX-YvOjldDc2m6mqHHt743HBxoBHk1AZ8kD9F3cNw&oe=6A43D406"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3ue_oePEucQ7kNvwFS3Rs2&_nc_oc=AdqV09r3Rh1f3XsK_tKMuC9KpBXQfY64oK-2CGNxFqrhXZtK1WBkDhKwd6t3hLPdzsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v6MdhVReD9VV7LhFqgc2ODtlGamgGxca_4NdblxH2Fw&oe=6A43E2F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6naXt7CjRc0Q7kNvwHszrtW&_nc_oc=Adr0XG0f6n5DKDF0urEaod_5a0ypnsDBgnT37juZjUs4a1tZpSlS4yU4i4-z-qzaFEY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jOaLNiWPAdU23lMCOXr89I_enoILRYT3OqfNwwCkRew&oe=6A43E093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVsRWMGu5P0Q7kNvwGlY2tB&_nc_oc=AdrZywN6xKEchoO_etM_ZBMfAGEAynvqLgydnngUhWaF4XHUAAluMNRtfeFK7WpWpBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R-IOIHaHLlz2vNWiqk7rPxrJqJTqOFm6z6SHeh9K3gw&oe=6A43D51D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLu1yjLzuJwQ7kNvwHdDlmL&_nc_oc=Adqf-Vh3gRjW1PedmVn31P2ruQ_7M1wR10HQkNdIFuzVHalsyiLjURRz-5LGJv652bY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eLwaHm638L_PLGmLf0PCAauC3mPUgQFAKQ0yHtqsADA&oe=6A43E
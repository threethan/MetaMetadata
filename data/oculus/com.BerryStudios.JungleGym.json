07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lCbXlIG_i0Q7kNvwEqfniF&_nc_oc=AdonbWBcMLV-c3L3lOcfQhxzIyLe8dNakPgbCT_Oy_Cwwcqb7VQLPIxdfZyqVLgdqkg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9sMyJR4hi-C1dnDfZK3-SZJGZVmEAhcPmsH-5L793Bw&oe=6AE20806"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e1GPsqZmqMQ7kNvwFjt04Q&_nc_oc=Adq-AonYNtuynB5NESeR7gS1Ml2CoqAXq900S4VPU4q8Cu2cOZEKEruiUwZ3xNp7UV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMmLLnDmr-S2AWEYhh-IX2FhCwCmNBuJPPwz0uAAN_hQ&oe=6AE216F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDBknDl08IIQ7kNvwF1rb4_&_nc_oc=Adpx1BOvzKEw3NFUE43jsInowtDUYrFVRfnNahTpyNHNZcn1dMzBGOoyXSgjXiyqNv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlTZTD-WoH-pBDT3X_ZLi6App2VbnqxJ8PTs9cBiL_mA&oe=6AE21493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqWITk-ZzicQ7kNvwEoQNBD&_nc_oc=AdoZ0M-HROG3CKRe5gjPeu59BXdUzzmq8XRztGh_OiMblfagvoLmC540TzXzPQiKqCs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiLLew0OJoV_U0vP8yPWsIK5686fDy4gamQFfDvGlr0A&oe=6AE2091D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqTe0atr3a8Q7kNvwGtFYSV&_nc_oc=AdoiQT_MN_1rC6qoI7BlhrpJuE4iMweVeGKoeE-cX-w6-QrBrqwdcLTs_QpJhK-S-Bs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-HCJ0ZW9b7vuROAUVROYzxkrVUCmhdVjp737JtY0QyA&oe=6AE21
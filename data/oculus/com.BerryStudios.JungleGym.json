07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsF_V4twsuAQ7kNvwF_rC9d&_nc_oc=AdoK8X6sutCnqT7DZXWPY_2d2Ja60en_vtNOyMfHvs8mrs00NPQEJuQZtMovw35Xx6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5FZzfQnrKvP51rUmtGE4pcjORZDy4t9FEASY0b0bPQw&oe=6A5E3206"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKrcHwon_LQQ7kNvwH65Zb9&_nc_oc=Adp0_yGFHoRgfbf0WTzkpaGQS3fyGH2Rc8lMbNxSLnPWho_hczSUueEwolu2ExFnUoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOCsfBexcZ0_w2yogMjbgDbXEPgigrrWFbcONIAC83_g&oe=6A5E08B3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aZoj-tom6UQ7kNvwGh-OOa&_nc_oc=AdoKFzj6GXBOX1l-rH55nb2rhsnzwt93xNWEuV7at7Bb9zAb1BkIw0FGJQ9lHgjSfcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU7YrnYPU4ODVPp5qirW1q4KoWO0R5p192vuZtAP9z3Q&oe=6A5E0653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zTMzATAlY0Q7kNvwHR48of&_nc_oc=AdouXadL98X3q-XPtIGNPQ7_0ilh6gXnGM6CRo8PgXFxWXuVP8S-2N-Hk7vKG7kxlfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKPn-7YNYZLgV0HSBALSsSqo8TfyOtL_6L5LKJZyWozQ&oe=6A5E331D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-7n7mKqlnUQ7kNvwGyR8UQ&_nc_oc=AdpMtQSJY4x5VR9TjhaKA-Ybb4rgxvsQWlrPZNBR4AtWwIe_Ky8c89vqW2M58VUc1GA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy6zcinI5C4JNsUV2GakHp6b0DiOwghLnukB5-YIC7Sg&oe=6A5E0
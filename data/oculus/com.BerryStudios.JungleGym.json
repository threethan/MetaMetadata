07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euDP1Qn82yMQ7kNvwGScjar&_nc_oc=AdoxfBdbuM9uTw-Z2TiwPsMTYGTjRhp0WsGN5tVq78LAVUsvw3Sl1fcxThIoAF38TfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nvpreTgku60ssNocTs5lNk3tO6xhSYQ2iaQBA1JUE9g&oe=6A1D9886"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnJtTO9sQDcQ7kNvwEdDcnS&_nc_oc=AdqD6yvd4P_uRrirAcTCInGihMZP1Akpb3Kybl14lJ2sirXgUNYXn3LaW_9IamY1S9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kA5-LPnuyW7os_vRLWsvzKr3eLAr7hsjXDODmkBY_SA&oe=6A1DA773"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqFHJ-g3lLMQ7kNvwGeLJH2&_nc_oc=AdoszUO8vuRXAs8MrdcYGO9X2nb6RWt1M-xTwnNI9vnOil6J5gHrSCBhgUKNy3-NsTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FQ_lOeQzKD_HFX3fB-oE-sKNIQ6ujWRz6J77sFrnlnA&oe=6A1DA513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18Qfuw6P4H4Q7kNvwFy4WLY&_nc_oc=Adr7-eX64lZtY7eOqyO1Hp0PwdH4GJqpHi-3C2kwCPElqwhlCZQXLOA3hxMLfS3GRjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QeVz3ABp-aViqdTTesQ_zB5i0YMgD4VmB7WVPpCtkFw&oe=6A1D999D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAbjIl77Ow4Q7kNvwFTsNOG&_nc_oc=AdoWs3x46AQVRNIVOgnBE04gzKoOGpw_QbODtaqokQcXe6DcFoks05i2aUUCc_bOdMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FDxwGXRJ2rAyg5hEM0Sj3T78tXQQZlbViGgAIC-ivFQ&oe=6A1DA
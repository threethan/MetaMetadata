06803007353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8yNkbm2KMIQ7kNvwE_jb9m&_nc_oc=AdqzFqw2wyULpm8Vr6rT9aOXroIi9ziaCVAyZL3cFTkb6Qy7PcWhVZuEsDxKoPQooHI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvHaEpECqMo5xapP_fMrSgqbLz3_2odK4wsX4H9SmQYA&oe=6AA95786"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbEIwiNU1BAQ7kNvwED9JMp&_nc_oc=Adq9-yHU9072rO_P9oTrI5jZYR8a2RWL1GmnylSQlKEt94thCKuy-bjtMwI-vVnaS-Y&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0oZoZi_O7hnu7tYBL--lu2pSGyrfJPazW3P252oPnHw&oe=6AA96673"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjuVG5oL58MQ7kNvwHCUIYc&_nc_oc=Adp3EHji09mD7xAu4X-y_8ThKCKN77EVe6ksEfTPxNK8UcfGwgXh209gJo-Jx6StRmI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcw5njfA-1WfptoQ2kk4dAHOvrgp2_K8Ac5VR2xaOIew&oe=6AA96413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-Iu4PYAb0IQ7kNvwEDn0RN&_nc_oc=AdphjToCRaw17vrHA19yF8NJSEUa2yg16d2OcAqy4JVMFEGH3QAI8BKTeSdSDYYpZ0c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId1ujDHsSk186xzqF0yAwAuRyPFBV3zsA612TgmIMFGw&oe=6AA9589D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jy8on4UbXLsQ7kNvwFn5PZE&_nc_oc=AdrlGzkXFtGyGqI6x4aZNgxEee3mKaq4ykXzbdtAd17NpnC3IIdW_5Dp_j0_9WnmGZc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlHdEYjPHcJF4nF-3ThiHM_fv2lez7rbmGB2g6Urk
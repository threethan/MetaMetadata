07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJOm276snKQQ7kNvwHVPeUM&_nc_oc=AdquhrnQ97Yif7vUxn_c8bUb4edDlHk27QMqOGlj-Htgm6Kp29soTbbc0rCkSM8wnyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BhhvXqvUT7BBg7-2LR723fRbRMVJrcygV3BrT1EJJrw&oe=6A19A406"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP7iiFOSCr0Q7kNvwGB2o1f&_nc_oc=Adqg6uFiBR6f6G5abl6uwhK2FE5yqjQuTRgkivWyxQLt5BZH-w43ivSxm9NCHh24Xtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CYovJjT8ZBkWm-_S3OeQjMAdOcVCIdxzW6PHZIVVFUA&oe=6A19B2F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1ZSLLoH5I8Q7kNvwETlg-S&_nc_oc=AdoG7VTZVO8RxpFWQ-DB-eVpPfJ_K9Xg7CVbBWISKxjLoY6-F5Kp-DSvQ35EcWOcUcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DTT0B8g_3O5OHucUhisn4mkDXH3VUEJ1sWAk3reEpbQ&oe=6A19B093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4AYbi8JeZQQ7kNvwHJyKTr&_nc_oc=AdrRoT1su4Heu4q21_nMMhBh1ZhpC30ligc6eGyk8_lna7zpMZJ9QC4_fpHkXYCBFHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mR3dmmktUlDuVYsaVzjiUzM4U-5U6q_qE6UlzL52A_A&oe=6A19A51D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSi8N2518MIQ7kNvwGDaXg8&_nc_oc=Adp6wUHiTDuX563fCub7aJ0zCxt0p5W8X_2KmEXEqSCc1QzFOsvgjJ-jHfnhnzsq1uQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CHXa59ZHW0oRxGTIohHfXoq-o3UjAQ-BkfRkOYjR0vw&oe=6A19B
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5Yczpv5CYQQ7kNvwHx-2yL&_nc_oc=Adp5ZRxoUcybowU8g_Unmcz30O9-nCQnvs0UMPcvhvFSt09dg2E0VjdLPnaApgEJAxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALawRGHXZ-1wHjqtyJuFlL7j_TrXBF_s5Aw71mYx-zeA&oe=6A4BBD06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjzUZdf0JC0Q7kNvwH0qNl4&_nc_oc=Adq-aDuZoWzhLVrVlpfdgrALAdL4tikZbGlYFxQ6EVesBfzp3c_5ggiUlrirXwzcGhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC34L_dF6zZkeHPPy-OqGnO3xPE7KRhv4eUq4bhqK_k7g&oe=6A4BCBF3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgWjAGgMY-IQ7kNvwFo_Uct&_nc_oc=AdoR4ZsRn1vEXCMDV2xTvOEpAksSiV71CWu2pgiLxqBDfGpfc8BXuamQIimMY8F-5VA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD1OYTWGL5i690984yLOShA2sWQI8TbMukD_T2kz1bAA&oe=6A4BC993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu2T3Wt6QKQQ7kNvwH2Vygy&_nc_oc=Ado6FHGt8fK2gc4AKai1VefnXOGRb-ou8FSIy_MJ0cQyhd9RQWM0ai3WsyAqZXf2Gnk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8GZYPlv_6bBPKVhkyaTXo82uTpQ4xpPh8BqfaZQZfgg&oe=6A4BBE1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE4PSWHESp8Q7kNvwHprR_4&_nc_oc=AdqmgJEms7yaAGLB91AwTxpHd_7OuQrJ-ppI7y9cE3oMIShF0tM-qCbz_zo9-gYN1rg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANmIyZuYYxGghhigGBqRlV-I_B_9ejoCfkRjhNW2vWYA&oe=6A4BC
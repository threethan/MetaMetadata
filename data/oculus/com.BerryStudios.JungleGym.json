PItV4BKzEp6iyeWAI30BzP4G9cvuyA&oe=699D9904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry4CmQLzCR4Q7kNvwEtROtb&_nc_oc=AdmVo1BqYp0x03CZpbQJ_e_WsktatzX7RJMzgcijx_D9W14RdejuELdLxw_XORXLyeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVvq5ZTY_skrya4QXeUTIVGkb0AdvrJOpVTXX3QB0k4w&oe=699D7FDD"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello Fellow Monkeys! \n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a multiplayer social game that uses the Gorilla Tag locomotion system for unique mobility and gameplay!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connecti
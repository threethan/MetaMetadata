246706803007353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nDqWc1RPh4Q7kNvwEA08vw&_nc_oc=AdpzahDN7S0oyv4YICjnmshjYSPZDfmWPCt3KPp4J28REwBmS17aRoMY_RRfh5jDoFg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyuyLE8QZbOER4npjsFXRouMndcGMnkRMW8Z_cBGftTg&oe=6A8586C6"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6yWsuN6dk0Q7kNvwFP641G&_nc_oc=AdpMuRVXrWEFLENA4sgLj5juww8PKM9lePnShrqPJZU2MvGvgRcEVZOtW7jedENJtfQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYe13wRAmdg85MpSQ-d54B2iDypBlbO5Nlftet5L2AmQ&oe=6A8595B3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gClnAxIAIHMQ7kNvwHJzdOg&_nc_oc=AdqGrtGNAAXisJSVPvujB50zP9Xcfirylzs5kvDcNlXzsVuH-MW4FM6yf3DCBAJW4L8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ4q_rcgNJSaARryLC_ArI14ASCzIqNpDJgo4CApnQAg&oe=6A859353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw6Xthita4UQ7kNvwH3dhde&_nc_oc=AdpcF3OwKWA6XSYCI1_0TiDsVMB9abo64NpJSVFQp69FnTKHLHG-QkWH6W4B9ciL_3U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2hLMxmun47Hn-mrbjYVMlaEGM0bUB_TOFdQ4GNbhz3w&oe=6A8587DD"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8bU3UoUO_wQ7kNvwFMSaFH&_nc_oc=AdpxAj7HxZfIR6woIzSP_g-9G7_UioHxJwMloEAvj1J3vZmwTKCEKcxWf9ZfifAPhpA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFTCz7lgxLhScItqnnOCXAO0kW2c0MKK_RTL1NB
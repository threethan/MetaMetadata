07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQK6R4fEoUgQ7kNvwFxEYiE&_nc_oc=AdpMMXKoGbra2Pe1RfuEgDAquSi_K797F4ME204XVbpjK-VtWCh6hkbOdfaFZ6WMrCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CDL3ZRy5ONpLeub5-uIffKxRzs_ly4pqxjySD5BD7yA&oe=6A3A9986"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSCwJ4k01eIQ7kNvwHKXtCl&_nc_oc=AdpgDJ2pBJ4q5Q6-bEzt5nei4cpMj7I9mlXk1rveiW8ch0tlqHYuSQOO_0U-o7fFerY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--diG6WlkoM5CEB4w7Hpug75uVBjujzuLxjzad4Uf4dQ&oe=6A3AA873"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avOYKU3QlU0Q7kNvwHd1sZJ&_nc_oc=AdoJ2ZXPyjPlDygu2kMCoKnnl2A_gwBByJ_M-29t8MADShniqjJ9wSUORL5RRCukmkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DtE6SIJfIsb7UE5fT_i6YnL-GH9me5jw6BQX3SP5G_A&oe=6A3AA613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxj_evVdCKcQ7kNvwFzdAjS&_nc_oc=AdqIPzLHgJqkvjax_uAHhA26PxteW7F0VJmkVDwfV8PPUj_kMCcFikDg16sEAS1bDmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XdsLm0Y3IORc-HTmj8jztD_C5AWbTZ2t5IvZbxjp-Sg&oe=6A3A9A9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5Is7OxAWtwQ7kNvwG5hdBt&_nc_oc=AdozNBZZFv0iN7zQEm8Ybv8RU58COL-eEQE71kRfjMisGlizmZluL5E60HZTd1YMlf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HdipCFw4ZVe1LssM58JLvIEeNfpFUFgG_etmcqOj6ZQ&oe=6A3AA
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsF_V4twsuAQ7kNvwGj0YcN&_nc_oc=AdrSQEDcfiytaF_vevZYkCS-q_gYz9yMLjckTpiVHPT3-tHjH-ZFh2duyYVO09-yksw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgg7h2vO1LkBqIDFESsDglFCKguj1xKZbiyMMICu30Pw&oe=6A5CE086"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BPi3hFjQ4wQ7kNvwHL1xE7&_nc_oc=AdpyWm9Wg8iqW_11Waubt8xNTG-cH-8szkH2wGxd6xDzF0cvMbLDPSdftOfhI8s8Z_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMuoCFZPVvL2uf-g01iaQi-pPsmaBl_Lz795XInbinog&oe=6A5CB733"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aZoj-tom6UQ7kNvwHILx4O&_nc_oc=Adr4XkNWjzYZxeFxjQ3j4CdqPsY33MH28HQZMecgOrJMHh1m9tzwnl5ty8K4Cf6nJtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCLBM0u454r7z7-ZLnV6hnrGZNX3DVeY6Z2XbrCnxRFQ&oe=6A5CB4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zTMzATAlY0Q7kNvwEGIm94&_nc_oc=AdrtQSYeRTfI7pmRbVedmYav7nAZwx9nb9RzpGASJ716765xc8pRTZWCwiEblVeYuTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9kFECn0nEKuUMA4MRYI_08S7xKptywjiS5xznX04QXg&oe=6A5CE19D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsG2XhrG62QQ7kNvwEiS8lz&_nc_oc=AdrOm33_jcGFykxdhyunwGMXaCjHq7cEva2psbJJu_scfZ8O7AwwTWIm_rYVLX5oqD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCjMn1E5J3yOMfzPLG5yIjxcGjoBu1TdRJY82zJPoUHw&oe=6A5CB
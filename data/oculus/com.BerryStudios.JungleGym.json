xaw2-C1O71E7qU4E-IVaoJp1Q6waoVOAPM-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsm4U1gwSzyWnVZ_T7fFWPsJMFET7G5uhHLo0gLmZJKsw&oe=69A6F186"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0_plJcGdvIQ7kNvwGQS_Q6&_nc_oc=Adn4z3bARexXnjZ4X8CWP5NtRrlA28j_-ppHgEv6GJcACX7FH8Ogl095vLknYRXIIkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuFKTo5qq4dQC6JkzVoqgaKfgApwrlY-YaGoTjxkqNk7w&oe=69A6C833"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHAQsWOq9cAQ7kNvwFLkO23&_nc_oc=AdkbDO7Ajz75qTwHmXLZYwIov0TvElWuDGJJjAF0uzmhhXThVLVYuIXAy71iyu8LYn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNuoWqiMvXFzD-LN2Wraft5SYFtgWN8DRcKVAeHnxztw&oe=69A6C5D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97vUlsM741gQ7kNvwEsFNmb&_nc_oc=AdkB5y3oBYG2J4UJM08w-s9uxz9rxTDWMBGegyZ8K0A601J6Ly3iwdI5TFvb0LOLOjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv2D__lH-w5T0Dc3FXTX5_b19tBu_GVYiNcfMvq5m1s9Q&oe=69A6BA5D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ik9qySaLmscQ7kNvwEn8QOz&_nc_oc=Adm7Hy_rqYgWIh-Z9K8IRspVEvwePBu1iBqQDvbtcUV-F207aQiZMOwxKrZnYkWKqrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2RCNycS6mvYEaPXrijJgDa79Rctfu_SgJnC5kt-LWwQ&oe=69A6CB69"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jungle Gym", "platform": "ANDROID_6DOF", "context_category": {"context_category
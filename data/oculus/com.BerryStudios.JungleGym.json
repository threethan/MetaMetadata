07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2zFPqymZrgQ7kNvwEsvuMl&_nc_oc=AdodjmgtUry_3nQ4KRyZa0wO_EO6xNkaT-GWEL1_CmNFrQEJWRNo7rMHwiH8SU_Qqns&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwgAuVZLNhs9lvppqxMlrd5L2FaYcWv9kv65AJJxIlqw&oe=6A564906"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seqYADOxSQAQ7kNvwE5RGSD&_nc_oc=AdqsVJXWV-Ns72fQOd6Bb1yYtvRctuUlXoCtgMawIF1Xnm2ml-wLsO4d6EojD0V6qak&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChY8DmsssEQNQZtDEUM3CMTCwtlHZ-0qTW8zGtYcMNtg&oe=6A5657F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_Rfxo5CO-oQ7kNvwE97kny&_nc_oc=AdqBOugH25KKxKzp9WD6wGaFVLFP-SFp6gJOmgw0NlraIx0Z8qEXMazh2eBRYTy24TM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7myb2-BHyOF5qc3gBMu3W9frQKJXrcKLsxKrqXajPZg&oe=6A565593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szh_BRUrcPQQ7kNvwFP7qxl&_nc_oc=AdovBYbY-VfVYzFhaEFuSbJAoNBAM7R0757co8c0qgX84akrMKuzQmpnrKXNYSdPOUE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD61Cq7wML-S063wsEBczCQFuFwKd90IoHH5t7Fa8fcQ&oe=6A564A1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z8-xKYH6z8Q7kNvwGMG3Uy&_nc_oc=AdrjMXyYxcX2_KGNb2NZfyXwhVQhGfIYt6j6iIqniRpiF3c8FryV_3wntUXnWHA4GF8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5A483VbADrU-VWy9qUMkXHKkdgnkn86sqRyeJ4aytNA&oe=6A562
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdsOjJTikOcQ7kNvwE1LHuF&_nc_oc=AdqIQ5_JcbzJzWiPNkl3TG2mk4uPHxYOzD-fl8cF_nyyEt6CpaIJuf8mSRRtGbqF6Sg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nv_EVW2BtKLBH06Y-28JgG6l_REoulwf01lGQR5racw&oe=6A130C86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MP4Lo0WK49YQ7kNvwFhxTA5&_nc_oc=Adq_0RUeQ-AnjkXlA2yd8_nhk1Bv0s7EdSfvG45ttNWQ5wj9i6ze7BjHYEXxYHsSu84&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ijxu1D0Qchy_gictuUQnQw7J6u1VJvy5SwztqKGYBMA&oe=6A131B73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u1oEuO-lGMQ7kNvwHeLJks&_nc_oc=AdpsU6ct6veTwGq5GC0Qr1POtY6XbU1EvCEFbyn8Ki7COKvjmMwRiqA6eMP_p0hMJyA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af425OBQvbxPdnD7PP7GP9JOgGu0z_UQ249kWsSZfL1urQ&oe=6A131913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKleiDQbWcMQ7kNvwHjZFP4&_nc_oc=AdqwLOZB6Z-GPDzZf98ZvnevsrPmup2CEgwsW5YYCryy4TUvlydDKqunlSfkVbXf8mg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lfYUJLwXUUobT7XdBzT04xzU6qYMpGLMMd5LwP5cr6g&oe=6A130D9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5NdLf71OncQ7kNvwEGiScr&_nc_oc=Ado4duuKe_q7l_HOXx53tHLlaxRlqZlkWdogxJJ82HEnodIiJwM-sS1SZjhEJypb_8s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YeqCafZ6htAd-VpM0pVOzsFURRoy3XyNsWFg-T_ZC1g&oe=6A131
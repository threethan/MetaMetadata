07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30Tm8HNMupIQ7kNvwEsi_oF&_nc_oc=AdrW5yYnuHxuSMRIr8IqCW3AWkd3KB2-VktPCqsiosLdNMknYd4fUZcX7EHN_RD1Jz0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o8QNRY8SRa_rlhmL-3mromm50Htq-ebuc2hc7riGhoQ&oe=69F36886"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5GDQK5exXEQ7kNvwGvkRCW&_nc_oc=AdqAQQW2xX_soevgavFUicAYlublWGniCAzl6v0xIl3l_z2iFHb6q-XFJ0QuF851NiY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3X4e7r3Z_GQxgZyF6EhYuQS-TGVN6E5DJwKAGVZaWCAQ&oe=69F33F33"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV7sywY_-H4Q7kNvwG5Jnjd&_nc_oc=AdoYh8ZRtpkprKoFfOOvtet06k4Bb68-s575SZ4Ed3N4btk2EEYXuViMUPbq-zJIARg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HOZKBJgw1d86AhQlv7mTy53bD2NoUot9x0aDRJRkU-A&oe=69F37513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K6kVyM1amQQ7kNvwGOF_AO&_nc_oc=AdoBz4ZvKgo-l4XpIQtb7ZXS0So4IGJRl3vOn4VuuyBL9IINA3Q8qa5aiqPbCpiKXOM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mzOO85l8iuuth1-WIRAONM-mTMkH8SzEEhFDnz4YxWQ&oe=69F3699D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cHSOOvwhagQ7kNvwE6R_hx&_nc_oc=AdrBfEBXP8SG0E1GD21wfj3XwASTgxO64ROGTTOc5ICTwAOjxrTk_fccqMB-5bYFZfQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mj2p5teU2byUT9q0id-EqFWkJF7vJQgal0lVFvbKTQw&oe=69F34
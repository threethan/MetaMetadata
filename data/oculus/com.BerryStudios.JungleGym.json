07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBNkswEJpEoQ7kNvwHk-OP3&_nc_oc=AdodfQSViDXW3OBtPgm2Sr_bOukdIWFQvbL_DM5q5s1ikBjgwkpWUdN50InTBo-m4tQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWWzwxwPHh_aUftAt4Rkt63pOX0dVCjlYjTIjScHg2fA&oe=6AF9C306"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKxUEJBJQdIQ7kNvwG8djxs&_nc_oc=AdpsaCDqilJri-ZeszRedCcgshMFQulBaqKFIrOSsuQKx3QxjyQrBHip2kk-7EdHwfs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRxjO2cghlCATgxNYIJUsWR2Ak8JTOQqsC_I5PFxWCEg&oe=6AF9D1F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXjLEBMWjW0Q7kNvwGNgDYA&_nc_oc=Adob1bROQqd7HgZroCUI4hhj5cepGyn9eht2RxMNBDwRV_D12jGnx-JhDx5dHeFbV6w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIwaDptszSq7fkWz5mX89dbCNkKuf2jtL1qVZGrz0k2Q&oe=6AF9CF93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1R1lBYdbkkQ7kNvwHlOGL_&_nc_oc=AdqQ3dvtWLZ6Mn4xVnH0-hG9fTc1EwW1qWih8IBduvdVbpNvgEiHkUJuvq0cJws_xps&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFSg9ZK7HOyQffAaEf0UCvK5Nr89MYtNE1U4vTsEFLyA&oe=6AF9C41D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCHuqFu-TD0Q7kNvwGKMH0M&_nc_oc=AdrJUqir11oHz8oZ1gcG1SCdWajyIOb_pog7_3L3CrKbJMC9E7UccToRWWVMNQPEcD0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRudC-JW0_gn_gX0BvTc5bsCwog44Vq6ADA4fD13EGRFA&oe=6AF9D
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AHoxX6m7vsQ7kNvwG0VS_k&_nc_oc=AdowbUgo2SL259vMgyHjQ5nRoj47kK3dQ0RhtQdLy6rRLLjz5kR01INAhSZ6gHLRiM4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-76pmMcx1S0SOtXPNRRSh86jkEwSCW83dhmFNUtIZiyg&oe=6A32B086"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2svF-mdj-4Q7kNvwG-h4_M&_nc_oc=AdqKayy-gYz2OnvpSSSYyotRmUOSZc2heDNtu0ilZIqQkPxegvIONYN9jFyGVYOmIC0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87mTE8i1F0lhkf-2JnK3Fa2_bk4EzaRojAX85vRJrMOA&oe=6A32BF73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC1rWT_q1IIQ7kNvwH_rfeM&_nc_oc=AdqznzqYf7MLsn37W_25eQQ9DsQZ9zJ8szl7sMlvP05XZGGL_CAiur2uxUvW95r7ecU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WGUiJ0usizOovXgA19i4Ol0Y3OW11pWn-cbIDnXL9Bg&oe=6A32BD13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz909CccK48Q7kNvwEwCutT&_nc_oc=AdoqzH6AObxnESbV479im1FTF39Damz-2-kzE7m0yrTNLGPs_oFdk_FAdAnuKoBeu-M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XWILnhxcgEfs1Nj_0X19AMb6WpzB8YxvyqCErAOxCBA&oe=6A32B19D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQEXoIAzvXMQ7kNvwHzDK7b&_nc_oc=AdrOqx_O0UZBUO4la50A1kEUAL_In9aSF0sCO5_4-ytboG68PsuoT24w6WB8TQzXmAM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-0RDag0-PMFrQG_X5h7QNggZ6hxV42s6e-LyYni3OCw&oe=6A32C
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsoJyQkOZOgQ7kNvwF_WaFU&_nc_oc=AdoxCqXd-oSvi_iuDIoP9xkR0dSIekfHKRmkITtSBZFSTR6ZgImm5Fl6Vdg1Ij2pPnk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr8J5Xy865xudLFOjv-lrAcISVRw8Fc_cPSnPDgq6sBA&oe=6AC7AA06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUVnQ3bCu1AQ7kNvwGpgF6A&_nc_oc=AdrEZoIJSgijQCHcUBF9Os1nVSWu7sS2h6_FGNXcIFCwAX6yeXmzBAbDnpxkEnRbGRU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX0b_1Y-HP0-C79JhbcPbUOd-2TOre4uOCkw7Aj2dSJg&oe=6AC7B8F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Cn1e_d0i0wQ7kNvwGI9Mwj&_nc_oc=AdpbrYZNhsdf87ZnKtVN9-Wt7PLbmZaKtSdUkK2eDTfjt_HnKj4Kx-OK2gmG9uWfqNk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSpBdvYipzWB-PcX_4clOAkEe5YGXHGb5-benDvAIhIg&oe=6AC7B693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7azpDIqMefUQ7kNvwGREHy1&_nc_oc=AdoaStQRa-B0lQEB5GAktIsJzHMYjU1JDz_59sfzD31VK6baFUmPHc5aYOWhkMxqhbA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA9_jbC3k6DQJ5aQYRnkNCzMv2CiaGJc1FBSw2D2o4NQ&oe=6AC7AB1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK9mE_T1racQ7kNvwGZy0MW&_nc_oc=AdorvWqaizg0pu2HBR4VoY4-6ESCq_JZtErODyoM8-Ik-5d-yo9cDniXffFj4OACXKY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxLWx892Rz5K5TYTkpczXnm7ZOYt_1Wz3ElAYKJmDu1A&oe=6AC7B
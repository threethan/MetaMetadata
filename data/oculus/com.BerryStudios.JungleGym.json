07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyXWNk68ArEQ7kNvwF63Qny&_nc_oc=AdoCvTjvpWQdxcC-NiV94_KS_aZ0wInQfVvATqpr2MNsYEWObshnAwtFEZE6AmtPhcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EK_j8ahZsbMEfnFKnkluSe84jD-1Vhp8knB_LBNVo3Q&oe=6A2AC786"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONenxOpNOG8Q7kNvwHzFpPN&_nc_oc=AdrEsM08h6UXdy9OFIZKynJx9_AhSKnVdIu1EmuhWD70DVvaWCCngHRHuBXgVPe6bJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZxFFGilBOkiIZ4ZfcwF8HImTJt9pj4Jc-ZLQIenWqnQ&oe=6A2AD673"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUgJLlrCZ_cQ7kNvwGDzrL0&_nc_oc=AdoIEdbYOZQuEtOxBzOmJJc8XhMDQSevZF1YcGTABJFJHjFM7Xqb1Adw2FWZPfvQJ6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mgAP7bbjLHXlc9OJ-ZmDDSY2Ot6g_h-UG3S1GQULjJQ&oe=6A2AD413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8Yuo59RjUYQ7kNvwFgvvyh&_nc_oc=AdpT8Gu3OcLqFYFhwowiBcKp8FxVk37s4xkiXxLUeMksDP-ISvyLlqg0DiS9pFPtI5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_rcjN8xKuz3T8u0GxYC3IVCLij4pr600PZPDIkYrOOQ&oe=6A2AC89D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z2_JCmENm8Q7kNvwHlupcG&_nc_oc=Adru9jWkcmbsnetclkhfvmIwSqdLDkBLRUZNB3Y4e60WM_8TxTVR2uV6in0eL18UCyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d3-1Oxw3g_bhDPbFzM1S0KZ3OpUBzuRdILGIjN7luig&oe=6A2AD
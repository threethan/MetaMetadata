07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lCbXlIG_i0Q7kNvwHXhGPC&_nc_oc=Adr9kX8-S07T0iS4Ps9-sexMXAPHfBqj6u4rcaAit6z5bamJHrWyRJQ9bVddyymWmbI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgRUEFpk5mBLSVeEJPksq-KD-yHEbJSjw7588PHwWRNA&oe=6AE35986"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e1GPsqZmqMQ7kNvwH9ospI&_nc_oc=AdpwMz0zJnv813f6HTju2Go9pUFSrVQVVV2EDc1J7gsyVhH6SgS3NGNqpGQiDib8ldQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ6wpeACsSWq8TTWkMe5XJaPgT4CCtusMyMOp1oT97nQ&oe=6AE36873"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDBknDl08IIQ7kNvwFiiT0K&_nc_oc=AdpLyDZd8nX1wMe1oRvoU0TGoiolDvVJOycZ_oLd8hZyDCqNtbHS_l9AZXFIr2HeVSM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAOGjE103d_cuEqZ0x-vqdEaOsoIUT3AgwYfCwCBXt3g&oe=6AE36613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqWITk-ZzicQ7kNvwFvzzxX&_nc_oc=AdqsmHLn9e2DoGh34sISvZePkzuY-NBKOOBmHOEf0GPll9ZdoxFk2rLGxm8gQzERQPw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkNHmNwbpP5iXtN2QiD5bMji_Wtw1YUIPKAgqEUi4nxw&oe=6AE35A9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqTe0atr3a8Q7kNvwGHk4M2&_nc_oc=AdoSnn6yx9tFbJgwZVDYW5I_aWCUuNmlRwizskCuBu7eMI7P2fsJwRwK_exzqAiSkjY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu34lzbDpVw306sN65-sarn3W29etafoZCVaveqyi2-Q&oe=6AE36
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=honK_fSwhwQQ7kNvwHU2K5R&_nc_oc=Adr8XMOjSK4EpPQwcFYGXuXDtu_VZK7q5AjIIQzDT0lthqNTj_fiAYWL4-MqQRd6rK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmsf47V6t1q81s7O2XoNL4DYSi7a7lX2iXwc8q9BESWg&oe=6ACF9306"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTJhCE2RsA8Q7kNvwFiEPcx&_nc_oc=Adp28UgQrYViTcBZs2TbG_7md6vz8Cd0jvQp6O-eZsBnsGLu82UvN92HRZw-XzoIi0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9XIEitPgbiUwXdZzhyLPqwu3HIZofdpJgMyrGtZqPiw&oe=6ACFA1F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lrz0RQxpcpIQ7kNvwEpbuHX&_nc_oc=Adq_Fk3tNSlj1CPx3k_p3rmS1HZtoGjbQs8B0j69-L5iHVoXhBOtho4JbAU9Gc3e1Ls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfEzaX7YfKC-rowCXETyeTDfrXw_bLyntjCRA2yRY_dg&oe=6ACF9F93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BpCeFhILnkQ7kNvwEk3Crg&_nc_oc=AdqWjmAT0c5z7RSdZp4_3R7IL9I_W3eeKz-j0gxvpOjCXhnBQ88sFqyB2KJz6y4aub4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpCjTqaC85nVDIM4S0P1ZOtD4xvNAe89pjEuAAozqjuA&oe=6ACF941D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNdsSoR4YFIQ7kNvwE8-HMI&_nc_oc=Adq7G6rmpv3G6tyqdoCUVYDlRps7-FfiILt3Tlh-ZDyf8YCRaTV01XVx4Y5tBucNQ8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9EDxfFETHlARnL7PZgF3GFkaeYSRoeXRmsLovjruOVw&oe=6ACFA
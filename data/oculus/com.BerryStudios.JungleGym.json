06803007353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScEmch77B9AQ7kNvwEtfr_e&_nc_oc=Adrrz0AmOVUcja4r5e6YY0KC4pVQm6ogOAqIojxokcyTueqH5Wc_m8pOQKWRFOW7PaQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHesAZ395rcB7WzK-QbfJTZ-PZvfNlqRuXkzjAyiL_iw&oe=6A7D9DC6"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cINGZeIMhEAQ7kNvwFOuFYv&_nc_oc=AdoN8IlTHo1FgiHdn1GbnAmL9zY9jpmR_SiV0MnpheCsDlU3uLEAJPxfZdCQdPMjnCs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6QI-hTyQwLuQQp52CSZynwfhRcZYKksN7-Fx6v-5yQg&oe=6A7DACB3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKJUaLuVgIAQ7kNvwE8rKB-&_nc_oc=Adr26s6Lp3kog0ligMX1HG8ZtgV50ZPL2yNa690fMefbdtQMshPIDXzDGY67i6H2uNY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeF9pyaNQKVtu5LFU7CQsqlmHt1wkQkIKgAFxWDxiiwQ&oe=6A7DAA53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyH1f3llNicQ7kNvwGTy9G4&_nc_oc=AdrhoOsZ7wOd7pU3-X1ytPk2K9Cn6_NZ45Yk0y2Bg3eLALXfckgfFqsJdPALQX6yYyI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiEL51Q0ZnpwepiObgVCtU0vDc8qEEYukPe2-s1ObW6A&oe=6A7D9EDD"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvmQX_OOGqUQ7kNvwHC_VTF&_nc_oc=AdqEsHZ6-Jd1uBWphOU8hAl06RiZZ9T6FwIFke1aTKzTyn7YrxCscijyEcC8jiXNPaM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh0_Bcv7_NVoyHF_whLhCWGf5VSlcBILi0kA8Ry8K
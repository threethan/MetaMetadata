07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=honK_fSwhwQQ7kNvwEl4n9k&_nc_oc=AdrGQhAv6tX3wuLDflZAFFhWKmR4S4VdVJoOfYWhnZRC1NVbyWMtCyJvDDpJXvLsyZI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLcplN_5pAtJf3trc80pE0M6qhTG77HRoccdA2dVNUhg&oe=6AD0E486"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBYDEFwNOYcQ7kNvwH9MxW-&_nc_oc=AdoCsnqjP_QsCx952-Y53jF0M3wdItEeTI-GA5VlIIjwN3y7X_CwTCz76lB2qUr5B0Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBkRtZNs4jlUvgcxIk4GR1xf_JO5uOc1GVz5gGl0XJ6g&oe=6AD0F373"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lrz0RQxpcpIQ7kNvwHDB09l&_nc_oc=AdqtMsE5HhSwriG0u3V56xcA1c-IOH72gacphHQX0xCcYvAG-1yXWA8g7ikeWe5RRVY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8Yl7yNRfa8VEQE8B8zZvgrbSKa-3yX0JFRUopnKk_oA&oe=6AD0F113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BpCeFhILnkQ7kNvwGomTaB&_nc_oc=AdoFukJKcS4H-xmKFtnHSjtKy6ONqSdE63JGSZ85SvcxqvhrUnc6q7mkRNI5WjnuiLw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3t5Ri_v6YBeQmp_tqeaQq040qWTfYHYt2yY8qkXaCqg&oe=6AD0E59D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxnqC6WOhKIQ7kNvwE9R-eL&_nc_oc=Ado2isQQTse-oQV1XKshA_MM4g5MkLDYyHrm5KTEB4xnAROF6qdbrEpnVb-F-oGbbl4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNFW8JkgD1gn-Q6GLUYlCMw8dXCKF9W8uvBOatZV_5_w&oe=6AD0F
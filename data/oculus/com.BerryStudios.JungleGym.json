07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jknxherORfIQ7kNvwFcYahX&_nc_oc=AdomaMxMplwdT-tUbH8Di3cPpfxH5eLGISd3nQmA5DOsJx2FGAm3kiCuvrrFTPQxrQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qtsiYGo_0AU5APTPyCPHWudfI22XAe92gX7Jc2ZAimA&oe=6A033A86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX4nlSPwCVMQ7kNvwGTdZoR&_nc_oc=Adr7VyaN-PI93FRDWhalLkO65RL7y3bjpDqrxMH3RCCt5ZW-8C7u6AKQ8NpofJ6X8n8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oTo2nkaOU7t6lljXZ_CpgWXHRfggIxG8MDHyxt0rUAA&oe=6A031133"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkVBqoOL3K0Q7kNvwHob-d0&_nc_oc=AdpAvGIyLVSh6NejVOYUbx7hF6JqsflkLgUmGK0CsfbLpWp1nwEL4fEB2keUBDxX1RU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OKC4sWUULV4i1RN0u0X0SfD8sHaqttmI2ylw7giHs4Q&oe=6A034713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SapvP40QSXYQ7kNvwG1aojl&_nc_oc=AdoKWmm3Vgt3hpR8K6w_c0S7Y0OTmVCrmmh1-h6Kcjx8qQhaWQk_a0eJOtx51L0ynTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c5LafZyOZ5mE1-SttjyegvejFggUb0H6JxGIAulemhA&oe=6A033B9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhC5e_hFJ58Q7kNvwHDBdAA&_nc_oc=AdoAkfcC_4Rs5QXt-QSDE04ktenfNr9tmF3ie1uORhciTMXxVpjfJ7hvWkiKBuurV50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e4brwfxRY4PCXl3rdx5nEfyCPw4eynevT1ceAugSS3Q&oe=6A031
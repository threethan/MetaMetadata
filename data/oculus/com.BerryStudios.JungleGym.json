07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScEmch77B9AQ7kNvwE2HwcT&_nc_oc=Adq5ayzNBSi1X0XN8sUTYvJ1yeLvuPMBP7nzUB4-24RzvTptJeAr6jjVdH79DyyfCSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnej-IPu3cmJRvZi2ZLsEfYO9BboJvjXmN9MJkcirVPQ&oe=6A7C4C46"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeQ3e-kjgv8Q7kNvwEv5oZv&_nc_oc=AdqAXOCnvFPy2G2VTgZ5T29N6_JWyT2gs3VezRlsOQ10rB5BSm0dEWv3MkgBRFbtTTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0fJZjrPk5b2baJ1QJ8ksxJOiL2jnNkzHwWd7X8OOwNA&oe=6A7C5B33"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKJUaLuVgIAQ7kNvwGWMdQS&_nc_oc=AdrdEqtdtlFVFhpdoO2DIWngF0VlhwW_0XjxKBakJdggo_B4Ppe9jB7-e2j4ogf1vTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs68ceE4HMPjFGdfUIBWUAIAtohVDNklRrT71olUlzcg&oe=6A7C58D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyH1f3llNicQ7kNvwGmr8KD&_nc_oc=AdrZ8NEqOBGFzW8VZAVX6Wc97g-B1p4J-khQjPUp3_Ss4aAkPjBez6_GityfM-IjXls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzP-HTIgenvJq-75Rhg1tK_o73ErRDBy5MxNrH5xqryA&oe=6A7C4D5D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k3GyyRXMeQQ7kNvwGw_aRN&_nc_oc=AdpeOy-WnI7AEU7cyUTQmaM29jCSOVG7egipk4HjPNuvJIMXswh3DAp2NkjZgp-Ms1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfGAWNCbsBru2HKQu-O10WfaUdTYEc5xcB2j2SpPZBzA&oe=6A7C5
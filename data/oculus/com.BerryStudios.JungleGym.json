07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOjoh3tz29MQ7kNvwE7HnVv&_nc_oc=Ado_cXRjcy_kK-mFw22jxdwefsIaGlDT72G3WKpWMGfGDyF-t_Ebvy9KO49LEuRB-Jk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwq0IkWgfarGLNSy4a72e2hE-K4oZ2dPzQNl5T-bvvL5g&oe=69CE7E86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=todCI8AsiwgQ7kNvwHL-Laa&_nc_oc=AdrRTxULGZp8NFqhs26QQ94_KnywhXO-bzl-qGHuV7S180M8v4mvrG67T2Jl3tEWZH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycwDMz_bY-cCCBodnV9fosAPHVfHwEUIUg44mCxsWVJA&oe=69CE5533"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BH0_kyd9mkQ7kNvwFuFEml&_nc_oc=AdqV9IUb2o9UjGWJUF6gThGdpEA9znq2ubtyCCyDx_FKLR6CZq1Rvoajya-aX3qSsgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBZV7smDIUNcBN3CWFsV4tP9A0ASGt-sfVjdkoME9ESw&oe=69CE52D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8D456Wjp6wQ7kNvwFAJ2z9&_nc_oc=AdrehdtClAX4aXG6oOhtdZM4h75_G456NrJ94ZErYpAX2MX-_4QBxyZ-nRZI7whXegs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxuh_tB7LruOXefkSBnz6CfR0BIa2Q7JfNAusLr8ZnQoA&oe=69CE7F9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4tT3zFXXdAQ7kNvwEtzoIE&_nc_oc=AdqYnNl6pPF3LWVk29rCCu66uPFEpR9BVI0Q1VhIhLX_emE7M21zdRZ8PgeGtEYXkSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIFt-VjJCZ2xn0Hsgatw8petaxnDN_cw5LlZ7kVHpDeA&oe=69CE5
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdsOjJTikOcQ7kNvwFgWXVn&_nc_oc=AdrbyngaPUgHe-IbcM4N-gAz2d1dnJL6tVLdrB1WDAae3pawXCvmru7_mK2KjrCzaYs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BOLOiBbBlIWYif-4aaTuRYJ0sXo8N9Mnne_t2jE9--g&oe=6A106986"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koKDQRazCsIQ7kNvwGMf0gR&_nc_oc=Adojo3Zy3mg0cRrJesLRxTEk-nxJ8N4Al8f7q966nUoqfLYI8sbEPl9NwRM7-PpFCy4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zT0pwe62zU5T1Ka9O0-JrCHw7dh1tSU1t6OcI4EvLmw&oe=6A107873"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u1oEuO-lGMQ7kNvwGvkDTm&_nc_oc=AdpY2Q1EvjwK27rtuNzRp9_WS-9tW3bHTG-zWUWQfc0Rey4i1DRhYTbol2VZpls-JaY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iivefsYUSDGog1R2eUUbreq2EkpI_4o4OtolbKS8_8w&oe=6A107613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKleiDQbWcMQ7kNvwEnuUnF&_nc_oc=AdqT-RPBDEMMw2t7XKVPUMPLUtxBNSOf4y3k1eV0V8k-nbEqlyTq2DMWARL5rLOUKQQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6avdVL9WxHZ2dtiLmqXA9hXwsNCmoyEmNfT5TOSDUXsQ&oe=6A106A9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhBdB_s7sIAQ7kNvwHYdKpB&_nc_oc=Adpd1MS3q0GcNN6NniERY4VdHBlkuoOXkQAjxJ-0ElOTUD7XsERRzrch1D4C2ZuHEsc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y13sB5sXzTOHxVaH0SIz0sfdP7a399e566qWWHUe5AA&oe=6A107
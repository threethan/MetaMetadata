07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA871HmtHhwQ7kNvwEey-XQ&_nc_oc=AdqvbWN4TQHHD7ANe0nMwD2_--RKCD55gSXRbxO4JgUVKDK8VZL5QL1ylkjBjjCZLTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81IREi_3qvWMUlzMrKbkNdE2DJY3iq_A3fF_8E1RvjNw&oe=6A47C886"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CK4J1ZPNnoQ7kNvwHAZr6H&_nc_oc=AdqbQuJ3vXCUHGjvF56mtf15PXd3CVN4HURNNf9Yurv2XGcW1MIKT75njArYd6k0Q3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cuGMtskz3Tr0K9RPWqLQLFiuRIwoCRqnMc0TUVnjoKw&oe=6A47D773"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MvK9s8_6LQQ7kNvwGg8APX&_nc_oc=Ado7UMcUPnhtgL9jZkfzPjTJmGWQLkiRNorqmHg3lt3Kv7YL3hHcbxbVg0Dkf8hHeT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8obupDT5fWuh7J5KTVietFeGXdgNxBeVhFjHMQhoedhA&oe=6A47D513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJvOID7q_zMQ7kNvwGnUW-k&_nc_oc=Adpk51hZ3Itpkht4kpBV6e0GTcUwBsgYFpuXIRJkoD-4GH6--46uAmQ3jYV1t2bVnKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wY7vaFjoK9WGx6SMOtpZE7K0l-hL--GMBdZFihKsp6w&oe=6A47C99D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp9jQf4b7dUQ7kNvwFKyQbZ&_nc_oc=AdpxnP2Ey4Q8w7-2fAiUdgFVtzpNkRy-DYo7hS8I3BbA1DMPE0UEMSXMOrx8GDL93Lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ArDK4XE6dtXWDHihcYEjfkJX3xDfhnyawoT8_g7ngQ&oe=6A47D
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Ig-Gu-T5cQ7kNvwEEVKVj&_nc_oc=AdqYKpySYklm5VE_aezfln_IuZ6aqQNOEnZxYukdRZl4s9sOWfF7gSnkzqI6lxh01dA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVDGezx62eoqpukiuFP7lNOxf2djmSeQ8hYV0LPbb_SA&oe=6A916446"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYphWY-UJvoQ7kNvwGA4csZ&_nc_oc=Adrf84IRSxj4rdSAfW0QJdqz9Xm6o-0dFgBCvlLxu3c7QtaX7QO2aT0x2wV_rHOek4I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnN1rp2DdBV7HSHqwTwjZ1Dv5AieU7OPcwC0xYompGrg&oe=6A917333"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh1dacaTS3gQ7kNvwHWl3Bw&_nc_oc=AdpvPwUDVRVKR8b_N9Tw5MfngrG5e12U9sb5aAChyOGXoEviZ0mYElIa493oVcHIw7o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfuIlBfq01AEW0wjinzYmQYiCOx4SN3KUuW67Y5nOkCQ&oe=6A9170D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FtHQdeFysoQ7kNvwGgNA7p&_nc_oc=AdrDidSAQVY9lbqyeGw4NfQ3GmIBvJHY8yPk70k3-M7NAuMhTcrEUZrCQg-ex5niWDA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRl384CoX-BWaqy7NB4B4CqENZEDuPTpkpA1XElPK8pQ&oe=6A91655D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_fNV0oVE8kQ7kNvwFRkAem&_nc_oc=AdpZ_PkuGIhwHaVxfnyfGzKX6tcXmDXCMkfjyNf-sj4T2I7LAtoieblQSdRSzbwSo1A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES1lWnidSFQugd7i-b7JodA2kKooRicu40VsCRU_i4ww&oe=6A917
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IOxDx1ec6QQ7kNvwGKYXUm&_nc_oc=AdoSzrKYCA22w91kkwgtZD_f9baFVIJmXKPUq6iCMj3B1KWtx2N9K8W7t-G8IqH-qCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUAmGG11IM3jnUTini72zEBkJMvFNNBDX942EvauEqqQ&oe=6A70A706"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7S830szTlQQ7kNvwGzsNoQ&_nc_oc=AdorKXC5GNkrl4zJauPDGCs1lfqExo0wTMT1FNjKpd4vE6-QXu26B4rai3ZpO6UYfbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBfpfYOcv-_4vvwX70jlih4fORkLAib_ra3emHIq9BQw&oe=6A707DB3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQRe18plqtcQ7kNvwFPhBZ4&_nc_oc=Adqu8IgF6mQC_JzqV40Exk3k93BKeSxP2fQTHdCb6ccjA83EAfim4-b2dsO0rrt88ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZyMQzvKDyywZ80ymPO12koV4d6RZdR-W0vWG-lyKrXw&oe=6A707B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZoe8mTMO9cQ7kNvwGQ31ru&_nc_oc=AdoplKKtqRT5vbSTedFzP6c6nR7T3ND701gFrD2VtzQi8S5Bgcaqem_t_mchYEgBdME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwu7HyNuQyLRHvS4lGq9ZfblWdRyudEhVbczacC7kg9Q&oe=6A70A81D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9y4VzdC0DYQ7kNvwFXtkb2&_nc_oc=AdpR--YNAltXrE70mQ8LnJjBHkXBs29pVwyko7LmwFVZ7lsWb5fYTNWBRp4uUHnHlcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2x8b7oWzHZi-zA-ZMWl5o68AcWOFEQnHm5sKDJGQ-Mg&oe=6A708
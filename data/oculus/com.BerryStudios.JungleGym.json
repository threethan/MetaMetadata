07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKLnjE-WhIQQ7kNvwEY6EOT&_nc_oc=AdouUd0WYIk_w4TwAb4-gkIWyBG_vhLIbIxohgMAgK2JymITybf-M_7ZLrcVy2A2l8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y9zfIUmJkkOCcW_2EmNmRE7PAwHALVIIzZKF-OAldbA&oe=69FB5186"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A5Ne3kl0cMQ7kNvwFTSbsk&_nc_oc=Adrv9CftmrgMWZ0NSIqfD4SBJhP3jFNNqlzxAYlfuybCW0q85exiPO3AovUGdBUyPe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uJK4hwIE2rWAVu0ZhuPXWoaYufE_7FdjZ1Rp6exNcxw&oe=69FB2833"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgTk5NgRb9oQ7kNvwFkUdgu&_nc_oc=AdrehUxh7b0YNqNqSnEe98I4yvjMi-N2b4a078JaEKvLGHeh9_85-ibSx93vfLkWsns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-20ifm7L-dlINNUpcm4BKwtG1gJxDQclMfDDeIdSk4w&oe=69FB5E13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYlhvHRXsToQ7kNvwEvR-k-&_nc_oc=AdrhdxHH-vRY73GEglacB7-8-ZZ3RB9BUG29xhvDJj5A5KsLMtQK37co53IBzrtRpb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i6lI1HSv2BxDkH5Am1xcoORe8jHgn4uqnCzO3ojz0zQ&oe=69FB529D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DpssCYALssQ7kNvwEsatIS&_nc_oc=AdpFocueJ_jeR_eE6JjhQBmvdbFT3NVCYSUSjU5ZLpT0BTXf4hjYXGHINigolsDBny8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xCJUo6uy6bVXma6e3qTY75Pn0c1raNT_zJTyMtXwReA&oe=69FB2
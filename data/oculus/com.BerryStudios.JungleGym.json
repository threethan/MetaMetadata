JzQ8gdPG504KcKdzngHF9TD1xbv8MTrJ6Was&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvLouewPFYnFpUDCgTwrWucT-X6ZJd8DSHojxz53vxxwg&oe=699B1406"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz3H1bwyTDcQ7kNvwEBn8-l&_nc_oc=Adn55wA86X22LMhuWmVH7TFQ5WNqXBt2u7kH_SZJVlINcMmM3du8d3JXgwxXEJ3RZxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfshFanIuRGiNOw-vQZ5bWfQ7ztl1QtPD4b22kKQkpVQAg&oe=699AEAB3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keVSpjodZJYQ7kNvwF_BvZT&_nc_oc=AdlJpoz6GHAJ3xDMIzjaXA6b9m7cPdwfWnRHlkHZ8Zu20nkxOHt60VvxTHeRarW79t8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsdJ3cYr_8-jzn4RiXcCCWm4rLCFbJLTCePuLPAnz28qg&oe=699AE853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv4Bb0Tevr4Q7kNvwGdCPlR&_nc_oc=AdkUlHH_oonT1clMRCCozmwpRgzrp4HinfyrwrXL5ZSlvzqatChDL9vsXyfk8Kz6rws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftwBJZM5fzQTHP0CIRHlFmR8A2sbQ57GPBMTDVzIyq7CA&oe=699B151D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sTw24VfLP0Q7kNvwHS0A_g&_nc_oc=AdlY5vHGhRGuookQIatKEKE-sGC3WUR5RI6NIWKURq0dHRPYdRB7ttvEnisAM4qH2kI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsra1vtUKGqLiyM6JDRy7SYZJCxpirMFFPr1atvzIWFRg&oe=699AEDE9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jungle Gym", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES
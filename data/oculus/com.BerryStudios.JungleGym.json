07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN9KuAMVro0Q7kNvwGwN1YR&_nc_oc=AdqM5Bg-JPlAEwAIMPrgTpQHO-LZiXVHEH_TujKXMa8SvebtyHGzYIGu024RkcU5i9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqx3eD3Kpwrm0bkBz2ePDu2tXQSfuDp2h6HcNM_Zk5bQ&oe=6A64C986"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdWv3rDhGyEQ7kNvwG7oC6s&_nc_oc=Adrfdokq1dUcLuMXejwnCTgUAktHKOBdpezxrjoWu3caIywn7BoWIXAVfBiH6bgzcvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYPjDxgdAHZkEQD0x6fx89Ao4ajM67kZbn9tiLlEaKhw&oe=6A64A033"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KskMjOKodcwQ7kNvwF9_vDJ&_nc_oc=Adq77vWkw_7ZdTTM_e66RZvHTH1GLQN5JSgreDol632NYDoyZgCQMK0PnodrYHP3S58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0wiNGEuFoOhxcQsv6DfewyryldQp-Ms1pcMSHctWP7Q&oe=6A649DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRzm4vlgoPQQ7kNvwHkUmLd&_nc_oc=AdrCMk2NgaeIG3k8wNPtgQadAxI86XqgITpsq_y5Z1F1dmOCZQfv8PuRYVESYG0i3NQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR7bJ3e2y0__biRegdx0F_EXq9_PnfpriORyEXBywaWw&oe=6A64CA9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZAvd4sm8-oQ7kNvwFGwoiq&_nc_oc=Ado7CEvAJx6-vYPCgogUg2iDjnM0r71jFPvZBGnF5IUmNzSVUaj3BIEcRrkEdb6MQRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcY0EEEBpya9yl4XDJ5OsewHJmjjfsFPYqEWJIAumrUw&oe=6A64A
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuV4Fh2Tla8Q7kNvwHf-NNT&_nc_oc=AdoN77EWJleF471dyHBSe9lMzTKGYCx6zLwG11OFvFSsBHexokoO6RehJTinUuynqQ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ga4p2_uRHJ4e2IfDazVTvzdnzJiHF3bjtwhbXMkJfSg&oe=69EF7406"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVTM5FsfRckQ7kNvwETfwvt&_nc_oc=AdqLEH0BoLE_oR0uJro64qRWrkKYZisnpm0-HpA_-Jmg5Wp51yU2xCj56X9cW3HoiUw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0L9oMp_lhGGws8-fBIwb1CqPaUobPXi0MmrkRD9SmLNw&oe=69EF82F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqMaxbu_l6QQ7kNvwF3L4Cr&_nc_oc=Adq5MCSZ3qnSDdHCC7ts0uzD0ehkQwBwL_znDcxMPgEDEJ-TW3Fzj6dtGXDi2zo4KXc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RV53hKJcWFNI0XmwKgg8RPeMibIuTNjghmlALtbRpFw&oe=69EF8093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkZttcET0qQQ7kNvwF1Lx-S&_nc_oc=AdpWzuAKywYsPj3nYW0eZTspyjLJvDtqKqnGI0nrhzFi6n4acHaXxxdnHRFfLYJYsGE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c84ZZd8pSzoqP8WDtfTlshuk1RWO2np4zdvpenjAldQ&oe=69EF751D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6pYbyaq9xMQ7kNvwG9svDH&_nc_oc=Adq4xrPk6cpu3npu4PoQivAXlecWYk2LN94Sj7b4rufB7ZJKJOPoKQWrv9WW5CNIoeA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xKBDmX6HYcQkszpI3Q_uU1BpHZkW_ju6uVytsqn6DCg&oe=69EF4
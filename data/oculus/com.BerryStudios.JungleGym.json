07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYzdMTMCk88Q7kNvwEnommD&_nc_oc=Adru82g6b7m79_omUp0NOt5cWMnutCZod11pFBMSXTwh-ghAwakvloY5XRXDCk6pxjY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuth5FZQTm5JJwiBfLj85ckI4ea0iwwmwbHz5lzgVOzw&oe=6AB68686"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuH0GPCkJ8AQ7kNvwFKwmoK&_nc_oc=Adqy-16pgrqHBwgNStIh_8BqdMSaO_gV5ZLu_JJH7dr12iHm3U7sVoCsrISB1JI06j8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqambatf9AAIBn09qRxaKJjYndhzSUqWIlOMSMxcyCQg&oe=6AB69573"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8bKnf0PcKsQ7kNvwFUAE5o&_nc_oc=AdoHFAGtElRgOk2-FI0XCZ4uGsxq5FliJlyyrubEPI_VwiKYpdPCGV4_kuORNWGjXpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh4d2rAmnVN6I3WQMzvEvftBPwN4SedYv8E-1URMVLkw&oe=6AB69313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiLfX-mi3PcQ7kNvwEUTetN&_nc_oc=AdrfjrFcP1Hiaok5HNb6E7HUOsHLtO28zJ8P5Yt3XTCV4PpaPj7E1pPJ7HnI4uwVM60&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISougGKpPqzuhB1HrqhZBI2hmBBoIia14h8jo9-n5Acg&oe=6AB6879D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRC6DKi0yVEQ7kNvwEa-Nj2&_nc_oc=AdqjGJf_eRKxFjijeb8UYF8TFg4n8gLUk9yUpWJqZ2rzw3qIaM_5DhxiSsM96kvUyMU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrfZKfAdl8YuUVXn2cptfsEFFN12sBrFWV_jZIpogSyQ&oe=6AB69
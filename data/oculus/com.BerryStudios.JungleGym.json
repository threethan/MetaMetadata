07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3rb-MsAdicQ7kNvwEleDNT&_nc_oc=Adp1flDUUbOVvM8yiT6AvA5V4--dP7FIFFr-P26KKy_ORhBhOyBPTUFs1Q8-hnc1iYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1coHKCHxS-3rppaniHKiN1I3aXMcE9-fvXV55mFX_Rg&oe=6ABBCC86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np_HPG2FtmoQ7kNvwEL6uKe&_nc_oc=AdpUZXThZyBVnzP9VRRTXVzZcY_OUkXh9OUdB3sid1jAosqiFC0qRZNksXP-W1Fm0S4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1f3s_lTjdksc8Hd4KIReTF5NdSQMVsoRBd9vwjJbmZQ&oe=6ABBDB73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekyRZgptjiYQ7kNvwFkT9K2&_nc_oc=AdrSHKBjR3wmAtH5r93DKFADDhgJh1Tp0hwHDtuv4Rui00ydsP-nf4PQsYfLEuGJItk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxJabC3sa4YUiDHnpNCXTgFsVH0auxWbqTajBDyJqV7w&oe=6ABBD913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isoL4XRpaWcQ7kNvwGZ_Qbj&_nc_oc=AdpVFIdMsYoffXBNvPlvseQjjFjyAez1IEP_fJ3i6uISyEs8iy0oSNGh3CMI1GrrVjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSQ4u4pIGp7teTM2uHwKwSuKayBggHJPLYNJn2pk82gg&oe=6ABBCD9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBzKH2_ygu8Q7kNvwEsQ5uz&_nc_oc=AdpRoXHyxE8oB5UmWz-J0Xz87RmxCEGKKr9a7OvYlXtod1hWSmpi3PUUVgMkqOFQZZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJThgEeRBSh84h8Ldc5coGkYmkN8Y3BjAXATgf80_TwpQ&oe=6ABBD
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN6otXIyDEsQ7kNvwEmfQQr&_nc_oc=Adr_ohrXPy1Pf4YCtyOujxqgKOh__BZLUlgl-Af7kt1gmVM215nnBsrhelXR20pe-fY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q7vXdpcPug9tfKO_X_R3lW__Gtwn8eZL9jSSU2-6UnQ&oe=6A243006"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTJeLsyEZIAQ7kNvwHkAsoJ&_nc_oc=AdpG_5IJUeKPKMehHnMHAN_dw5EnEYJN8_x58t2h_Dijindo4N--QXWc6cUUYC2U2w4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HqcQEb7VfPXnblc40vQNZSGvLmbAvJ2Y_RiiRsM4JPw&oe=6A243EF3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh-NX27dkUEQ7kNvwGkxzIs&_nc_oc=AdoLQkSJxx76mOfrU8-aNy0ZqHRWd6tg57LEji5G-BvQrzd_jtF8AHbeoVvhvIT35M0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9racpPRWvLt44UFeOL5HI1hcSSLqmOqasTtLQAQxBCFA&oe=6A243C93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgDbvPE5_aMQ7kNvwF-DLKR&_nc_oc=AdoihusoRfUF-SBOwOQHqnqO3le5ZOKti8b7RdQOPdxFExNGKAxqIPDPdCr9DLAFFu8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k7BdROTny8sbJIY1CkCC9UDmTiTNrb4CeMuOBRJiHAA&oe=6A24311D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QScxGCkd9uQQ7kNvwHbZbZQ&_nc_oc=AdqGnuU7lPrXEbaRPxYHnVNUG4Eu4tUr3pO3SkfJmnXcD1FFeAsNTo9hnirqeRelv84&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qHo6zWJFmrosYrBuQ9ctvGvDNiQUBYUusMDx1eWZ9mA&oe=6A244
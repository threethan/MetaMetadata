07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKLnjE-WhIQQ7kNvwHg-VSE&_nc_oc=Adq1KIFrl7D5jKBJqi_TiMOLGqPSHKCD7tc4LXWsoDmZtDuy-nQ9XxhMtPDP4q-52Wk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30HMpPuce06shLIt4YHNF0EjUKkDfRCRtFKZ01oUmbMA&oe=69F8AE86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWK32-KMUBcQ7kNvwFzCdEX&_nc_oc=AdpQf2EeAmWAcBpC6n4YA1ed319g9ZAIxtFoarTIk7re9ygavhfpEKxh_4HkYbGfhCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZcG6Oy8fu2txp27ixSre_Z-pLi3hfEZZodp-eIVcmKg&oe=69F8BD73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgTk5NgRb9oQ7kNvwEXcae-&_nc_oc=AdoKAZVSL1DHhaNgBwant5lIyRIzifM-kLZVw8q-6_Bm2Iri-nEgwEju3nEm68RIRwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pmUaS54eQnB2momLIbqJGASQcwNSToBC9Z9_ltdeSAw&oe=69F8BB13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYlhvHRXsToQ7kNvwFivEOv&_nc_oc=Ado1uASjNgXB9AMCVrhdpWtGTmh0MGqqeoX7LyAz8OAfSKrvERQ-i12WN5Vm0_KFowE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cQ9v9GEoDoL8hgBEHdNf5pxJuMCTNHLR7K1ZRPV5MiQ&oe=69F8AF9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-F3cCDWJ6w8Q7kNvwFBH80n&_nc_oc=AdotMFwYKz92JjSEd9JR6x2mJ5rrSukowiV6DXvbXGIvzLg-mJNGSr-r5mXOoHcbmWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pTPY8nvgID--hKKFlboKOgdl1_5XWHrvyS_1GG0-G4w&oe=69F8C
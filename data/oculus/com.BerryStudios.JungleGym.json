07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vccD70QJGWwQ7kNvwE4uflw&_nc_oc=AdrUg8GhECwCkQgvEHD33GovqNok4glfpF-DcyQq038-WL84TqW5OUfMZX9sHcEQVU8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z2x1iO1BLB89ZiYI3qNzZ6EqAVxPqegvkmeLgMND_Og&oe=69E24506"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjAmO35mDJYQ7kNvwED2PLn&_nc_oc=AdpK6TuR-T4Y3Q-npXd5u0nMIlfwuFtw6n7rGDIOUdBkjW5aBEIBfxP7yvBysd3T5lE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R8nvVSNJ1B7d7B8xZboPJbftLeVBz8sVNaBWqA0ERhw&oe=69E21BB3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2EOxo3ijrwQ7kNvwFXl9c7&_nc_oc=AdqkBPxWuuuValfC4u38Zr58VGEWTo50FEZCAQro4JfNxQH38ZtMfNPiwPCVfRPTCx4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07DNntXVf0wAEPSqhz1Y35yH51UW7LkgLkktdqcQKkaA&oe=69E21953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bkd4_YQ_HkQ7kNvwH64kZH&_nc_oc=AdoEsKRfAqvgaYwhgA6d80pq9kt5M-9na018wOf45OI4AOxniZhthehjXTMMA-FDj3o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xjeiy83biFNocmwKZI5LeDYwobTukxNJ2uTn-KIVeMQ&oe=69E2461D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr4kT2ecRE0Q7kNvwEOXU7Y&_nc_oc=AdoWpAbOgdTBgYQ8Gxupg6ppCm_7Z53imUdfQ4t4Cxn-Bk2zWakt374wKLTCBZJOaps&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yeBJQQEZNWZSDgKO0d4s-2kEuD6XPWan1D_8vl37ggw&oe=69E21
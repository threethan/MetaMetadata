06803007353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZ2jbDIR8loQ7kNvwETZhVY&_nc_oc=AdqEQL4yqkbuu4cmS5Gi54OBlrppdiJm8F5v4B1aL2lFdAGHIyn_tBqkx-hVXnKlygY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KfTLNHvXyqUr3LfZuezASllmgXHuchldVQjinvkFVCw&oe=6A36A506"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n7xkm2p0pgQ7kNvwHBqryg&_nc_oc=AdrUvLDFVplhAQhvWHaZMEWq_uc3TBNk5vggFozPnp7ZpHkE7O30oJvasohRr5yw6XE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1b7NXtvOt1vW7O_G_DnipuOc0-j7w-_lVY9ozaiSwcA&oe=6A36B3F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bn4HfD77uFQQ7kNvwFqsQ5T&_nc_oc=AdrEKGWQ7vjZaNMK32qvHquECJIKX5SJPr56FHMYusR3k_tkwrMR35GHPm-cm87E76c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Vbfc8tz19URzA1aAQ0e5rH3LWzmryOpdUI35kDkpbw&oe=6A36B193"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8Zp3aQMbecQ7kNvwEK45OY&_nc_oc=AdpqamNExnk657w3qUP2RKL4RQ7kMVfDK14GYKpszhZAvnH6JV7H3qV3OSGzWiGC5jY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bet-C8atMsFkfvb8P1LnftC6XiJIwnHtZhdzQOrxWQA&oe=6A36A61D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM-BYEVavJ8Q7kNvwGCqOg2&_nc_oc=AdpewXeHltDDJhj5qx-b92MxB27gOhquJNURzS64pXXkzm4vy5MMy1seF79iYiO3n5o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Czd1GecsLlIyvB7u-oZWlmvLn-BgeyQj5osD--Dy
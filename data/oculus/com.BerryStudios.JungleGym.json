07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-npi4Ke3z8Q7kNvwEaDweu&_nc_oc=Adr_UxZhTZ4KyzgOV9JNqVzeV0f6O5UXLzqEyikGtNY-5qJ3YsBarTN5XHDrNPBnEMw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cfo4GKiuKzhfKbrO6iHi4XDPWkXpMFxpPh8a38F2M_g&oe=6A15AF86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MP4Lo0WK49YQ7kNvwHQc_Ug&_nc_oc=AdrF86hfV5nSG2UHQIQiIaG1EFs7q7W2wMVlXFA0gCVLUsqrbGIAwniCprpFLE57WvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q9pV9yodmW7rC4-5SNEhSphOZ2iMF5ghcVLZdojRV1w&oe=6A15BE73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V3lsjCnPbIQ7kNvwFL_rly&_nc_oc=AdpnrYnZKp-rLvFhxQrJAXqGsrLQNXVq4eKphuXz2XykUhii-5BPCjyn14N0sshR0SQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58aahemv5Rjb_0vkV2kgH3bOuK9FvwdatXUTw2Y2vM7A&oe=6A15BC13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49UAyq3Bz3oQ7kNvwGYH1_Z&_nc_oc=Ado00IhDHFfqEdS4WZyX60DOkhznb28fZrPnoJZam2EO_fmIFNhxG--7-LDUAtkfENg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A3FEfM-dEX2ReOJmnXJt1wYn1ya9m1uaEtdZxJ1_Gtw&oe=6A15B09D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5NdLf71OncQ7kNvwHEJ5kY&_nc_oc=Adq8-Q0dFkaCsReyaAet9BNGcMQX8W7LwT_CMtBrlIfN6ZJ0Vs4BqU13YlnizuwZTCU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zK_F1XjirHTDbqYfxH4pZAvjGLIDJ401A8gfppeOb6A&oe=6A15C
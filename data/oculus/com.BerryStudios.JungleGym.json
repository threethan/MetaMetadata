07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuV4Fh2Tla8Q7kNvwEYKBDn&_nc_oc=AdrY3W8xQ4I8ltFKKSEEi7DV_bwqkUUhByzbc3rnDJVBaO5rTI8O0-N4P3R48SDFcqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af287JBhR1K_A9SY7RpTbSrHmFljWhNV-IpBkf2fkQoIHQ&oe=69ECD106"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kevv4eU_Dw8Q7kNvwGw7BNB&_nc_oc=AdqtCemmLLagKlDPoUf2sqjlGl9BELp8Bsr0Cr-UERIKDzWDoZhZ6mws-OUSxQ0L1Is&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12spYtURVmJLV7oRLwo-s3HznaFKUNIrkcIuAqulvy0w&oe=69ECA7B3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqMaxbu_l6QQ7kNvwEJDwRc&_nc_oc=Ado7zBV_e_T8zUvg-0frmBTpWp4JJpiOqSN2_pBLLvspalwePSb8J6NoQqeoU93WlWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HePx69j0C8xXbO0JpAqFUuEb3b6sBFAGaqXnM9QQSyQ&oe=69ECA553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkZttcET0qQQ7kNvwH14EnM&_nc_oc=AdprYNZ_nyREMyNcU_rhW3ULrWsj8thLwASxtVplc_oSTg_TYLyCaPe6L8o_6Jpp-VI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C8lNC2qxe5ZWJbw_49pRg2jQE4P4n3WT3dXngvrXQEA&oe=69ECD21D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imCnIABxDksQ7kNvwFHJfrN&_nc_oc=Adqu1p4u-h63bQKI_wyMjubSp356RNEjCiSXym3lpG8NaydO2faNRd8mq3ms8KMjZX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DrED9MwAW9mAb_R7mKAc34MPzQ6FIGQLEdLrEkHAh-A&oe=69ECA
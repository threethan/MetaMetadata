07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN6otXIyDEsQ7kNvwGnl7W1&_nc_oc=Adr59tvDvcU45vWy8ZTRVkXPNVa0Eg0WUzItGEiJ7koTip2SAKjCTEA6Or8RIIl7TvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ShXVEDbR_sj_M_lZ7eUBGmPX6yrdqxcOcBXGXyES66A&oe=6A258186"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTJeLsyEZIAQ7kNvwFv1V_O&_nc_oc=AdpXn2qq4HTotkZH34G1QsKrND4MjDUeRHvvt48yz2K80_fACQNCvRDQY-_SOwV2vkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-1UdAT0x1se3x5dgzPCsNQgpZhRIMIoMZOZmMQ44lFg&oe=6A259073"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh-NX27dkUEQ7kNvwGSPuAP&_nc_oc=Adp5RLy3ULMyL1_Xu83wF7jMkNk3FT4O1FnQxPX7Uj3uiMb7O3O_Vpdj09gL81IaBlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XdKVISVjqOSXouUKutlP2Yvb97pSEmc1Y86dcv24x6Q&oe=6A258E13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgDbvPE5_aMQ7kNvwHq13eq&_nc_oc=AdpYuDeHf0xcWAmRcvrUbDj4_QXuNMe7SwQCliavyqmYokL6RB76Jm_lNLYyhROw9v0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rBBWPUwiAPzef6ZYVgTLfstbc8KlLvQjUtodfJ9zgjQ&oe=6A25829D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QScxGCkd9uQQ7kNvwEspC4B&_nc_oc=Adr3OvOfbEaGfsKA1EeWEf9fWrlgg1qQ6eOXWolq6wIalMzyWt1VMoQ4Dli9Hi6QPno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zqu1bXvE26Gm2ZVOY4V1Qp7BoTskp8cvRiLyYokRAeQ&oe=6A259
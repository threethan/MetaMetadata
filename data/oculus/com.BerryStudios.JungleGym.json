06803007353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PanoxgNlcNgQ7kNvwFQZMt3&_nc_oc=AdpVfeMvRAg8JbXtcOYkUpkQfZ6OuUhmqRJUeh53svjIQOYV9n5SaqzNLM3Bb4bY7DQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_GCuqqsZduKvx5Hff-eM4UJtxdkRC5TakC_nsnmdu8g&oe=6A22DE86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTJeLsyEZIAQ7kNvwGZpUzD&_nc_oc=Adr6RwLq47lAaCDk875B4p2sYCmb8-l3ZAHH0WPOnkyhClp3RqpEbylJmZrc-fNJ7dI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zxbRa0XRv19gLgiN2NpKgtOJ-mbMTcQbl21WP12wgHA&oe=6A22ED73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNiNjJ1hqNcQ7kNvwGYjmss&_nc_oc=AdqbqkzeDQpHe2c3UMvBzBeDvV4sExXsWvgAcfI_Vv2i5hZ7GzYGfJO2HosKwNWqMo0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89kUeXpAJXNxDvVtp3iNlJsnF7CgsZsCkzAAu56rQ1rg&oe=6A22EB13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l79H1e_bjJAQ7kNvwH9m2ds&_nc_oc=Adoef6SdfPSqjjfwTbgveGzDW752oDwgx5mKGmKtOe6k9_1oVB-YsaTyFcda9ojIr8U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kHXTI1zEIKSNN3pd7zz4uXYWz_xu6NfDCW4ERc7T-sw&oe=6A22DF9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QScxGCkd9uQQ7kNvwFePgSs&_nc_oc=AdoZH6cjaY7F8fHd0Z508YeP3oRit7ttV6Gw10rLbhbDO2HPCh_ZvjxMwDhuhcTlGrc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kHVQKGBw5wZ26sCmffROxNqTZoCfnIYc_OYzaaiD
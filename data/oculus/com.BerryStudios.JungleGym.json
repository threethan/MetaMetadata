06803007353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UytCWvnI4OUQ7kNvwGxx5Sk&_nc_oc=Ado2xmRfXIAZ2OZ4TTkbzOlGWFn11tnBSHqm3ZXbECK0qgWYgTA6W4F-vESd_UsvcjA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3K2XIei0PA_pe3EEzkbs-MjtpIHBONCM7r_GfYc8EsQ&oe=6AAE9D86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ima0rSJaZm4Q7kNvwG2WEv0&_nc_oc=AdrVo5QpgPEFdPcHAjqiJOMFkz5IwaPutu7aQfQNt1qEdFhtMa8Ui5g7ZE7SpoSJZZU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTIPxJ3kNRfJfdueZOJRMwtvVA_D6JJdO8TzJrek0abQ&oe=6AAEAC73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQ7Y7G7lu9EQ7kNvwGjXPAm&_nc_oc=AdrpEMMdBnh8P1pgpR75Y-tXSfEGI9LRkl2n-8nxtPoVKKWI5tllW661nM0nKhA2-DI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0jfYnYo9eUEJ-Rpg8gQG0m5tyrvOsNvAAx2X66VuONQ&oe=6AAEAA13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlqzfaJ0JZkQ7kNvwGcqVgK&_nc_oc=AdoacfD26Nf8o8IKouZO7bwFKY4rBwq-CTWHq7iAHV-W1KHjwfTav-jfi9WvZKQTxKs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMxLzu_ArqAs2kQVed_ayxT9mqNixQK_3zuGLhbhJsBg&oe=6AAE9E9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOx0zJL9ECsQ7kNvwGetLs5&_nc_oc=AdrRb75FFM-FUB3LWBqoporUTYM9FVcsnD_LlQB6O-OmTHN8ouTxWG5YT5kH2Z6otpM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXT22xPfeYxfRQeL_RfK1DLgQde-WeI-jVVNQT3JR
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-EcpuoL4OYQ7kNvwF9Ao7e&_nc_oc=AdqhFv9jYN-4Ak_T02ily2czl_RaF1BTRFKdNUvCMxXXx7lBM1-zzWVRs5NOvbLd_ZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aUZU9z3_bYuCSSP96vkfW99si03pmnC7PjUya-A5oZg&oe=69DE5086"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=narY1iMj8UMQ7kNvwGMSinc&_nc_oc=Adq-V2dERZ52sdeNkplfLTuI8h-U0r85bkR-DA-0u752SxjxK-7XpJNk2qp56Wwcd04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nuU1azlw1Vhv31j3p5IL5RvL85mxnnt8elFXWRsI5jQ&oe=69DE2733"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyYXqNhd0sYQ7kNvwHv1851&_nc_oc=Adru4TPnBfaE23VvzJTMwVlYcb3BmNemmIZp9ObDJT7YFr-TS7khn9eLwKu5NUw25AU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05kxsEh9sTHB7VdFz3Y327H8rtC5Wu0FDB8fCKxh8iog&oe=69DE24D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ektNfWN_9AgQ7kNvwFWTlgS&_nc_oc=Adp7l1l73WZ-v9wx4jmnexCbfGJLMkyhWhcDUSyNryjCC0Dwn8o9zWxsB3luc1FzyOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IWlm1aMb5MbW7PQIYnQoh1UgqM1GRtbW-6EfJ7RpicA&oe=69DE519D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG5SFsDEhNEQ7kNvwHrtcAm&_nc_oc=AdpfJ2A8UpmktwAA9RJ7NRKx2-aUIZnzE6y4i2cRnLtt7HhzaXsP-02bQi12krC1KBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GQpK0IBxZ3cD-y9JwsAZEMGP2oMXJklhMLZoYOMllCQ&oe=69DE2
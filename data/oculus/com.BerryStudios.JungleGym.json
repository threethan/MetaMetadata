07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_9sSdEtl0wQ7kNvwFWa2-J&_nc_oc=Adow8NcVpWDLw6z6QkTCRaf1Zqu9wBXEPkFhhLbNoXVpGfXbEDTxNYEgbdZ6ARxW2gQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT09xE9Zy-7TlWaGVTGfYhALrUn1cKYBB6Z9YI1H5ezmw&oe=6AE89F86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kxN3YYrUdsQ7kNvwEDqJiT&_nc_oc=AdqYl6X1ez1tGog2Jq7M1nU-qAuv5XHo7IyjmU89gAqqA0FiRtFkeOcFB0EkuvLEHwM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG4dtmwEo_Dd_zfoSYofD2pqZ0QZyYCWgGOjRLqX7wdw&oe=6AE8AE73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYCsuF2P67oQ7kNvwGXOh5R&_nc_oc=AdrVq5o92Zhb1TAKz0XprTWclZ9t62PDxvtuj_VjXBsB7FwlDl4FOQEyNoKGzvNC_rM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHMpFh74Rsw_EYDWCOG2wx75eULUTIxPYpEIuYf_NOjA&oe=6AE8AC13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYZTB4WrfoUQ7kNvwFtBUig&_nc_oc=Adrwz3T8dsZyNX92uaPeCg-1DKdhoh3ca743Sfzv4bpjJwDzgNysngXzAe8VLeTR7eA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2B4Q5oVDpQD5utc9u9QjhlUyDBQ7zcw6Y7WHgNpVJow&oe=6AE8A09D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKgy1UabyJgQ7kNvwFPwP8z&_nc_oc=Adp9RspnD0fPhxJl4X8kXK1x5U4Kw9IR0VIoiZXY3XJ56Z66ssEkoBHeGPW5rkMm0K4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5oH3LarzqeMrhaYSgo86jpZmMu5XAaC8ZpgT2BwnPTw&oe=6AE8B
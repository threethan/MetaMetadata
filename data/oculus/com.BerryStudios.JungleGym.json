07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnVWqU3GJ1MQ7kNvwGVp788&_nc_oc=AdrEL_O8o6kOu8PEUQXQfp2bkTs1_R3FI_Q5sQhj7muK4JkEFdqgzH6Eff9rEl1KE3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJphEDzySilUnapV3GAkofNCG4jmyO9k8m3xMoxGVAjFw&oe=6A998586"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s21cUH0ysgQ7kNvwHYN1_2&_nc_oc=AdpjVFNwAehrFS3bisHv_Vc41_CXMtGzMsRZVw-0tEupvw_zoDwksBBa_LEfjAr-IXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKX5JrAFrDiVWIrLX0V9PxzFipqY9nbFENX75ba-v-BQ&oe=6A999473"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yJIqoYR4hgQ7kNvwEIe9CW&_nc_oc=Adp_5EzUJJrM7MUEygZMDG8nsE5MV_Ud_vAdc3I75C2RucrWYBKfl9_pzx3oFxFfF1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4FjU2nM0qXj0eQJq7gjHy__x30-Q05mlGAoBmjExXJA&oe=6A999213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVmKADead3kQ7kNvwGU7sTf&_nc_oc=AdpQg4CoFAvvhKt1_r-Nefk4_L1aLgUoKtKvG9_HRYBqeyKi_FMuWp85dgJ4blgrraM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPlbrwhejJ29brlzaZAFhycTp8VB5Q4Ltdl8l5s1Rvvg&oe=6A99869D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI7SW89EeNAQ7kNvwHUUjMu&_nc_oc=AdrtPrIIy1d9vSoUz7fkfre7MRwt2XVm1dh8gKukz-xEb7a4Far4YUTybHPZJrlUUF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5V0mS8EbTn0yJpZbYGUDIn8OlCUFmytMoVoqzn3tmNg&oe=6A999
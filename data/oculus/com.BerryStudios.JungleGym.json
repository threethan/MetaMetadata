07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_H3GfUa_5lMQ7kNvwGas_rY&_nc_oc=Adrfy_ma4sy-YwfNNO08bA1rEjbNv5ac9GNtYXrfwZwff68X71dtZ6nWONl0X6TTWKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ywEIuWcQ65u34OgHoPuYs2UBQitvOIImpYqH1bekBOQ&oe=69DA5C06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxwx8l7yQDkQ7kNvwFx4JRE&_nc_oc=AdquTpdSgut79EGNvgNsoHEMnhwLpL53lmVGE-LEorruJbrHphcj-MZFlbDw4W4YMHE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-SLTL0hKcJSuAaSsd7BM4t2NJrWepv1pJrMgeEoMYxA&oe=69DA32B3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4uWOBmH1mQQ7kNvwH-4Tyz&_nc_oc=Adr2K8XWYnvuOZkrApBkO2-myWNSIVGhXbTv7D6sb5Op6wGuI8NiaAIFy6wzB3xuoBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oinCmMc2smHtE5yk_elkJUhPs6tZx0XoosDASip52hQ&oe=69DA3053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b-UowpUu7cQ7kNvwG2hjs1&_nc_oc=AdqJTkJD0-cKdBIIkVOuIadlQg7j5twCi8alZH_1YZWm4X-R7pAXtuxtX6D3y4T02bc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jKC1zkesO3hmWhVrdJTMR-B5L_ApXpBtPV-XKmuEprA&oe=69DA5D1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eb-tqzSBAMQ7kNvwFs6cyV&_nc_oc=AdoyQSF73NWc_x9N__30ChtShq2x5IeVm0jGjuw4tFk9V9qh8gXTGKgEKskebgVrbjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AAM_TZHZmAi0juq_thSnI78EFW2sPNhvL22p97_mOaA&oe=69DA3
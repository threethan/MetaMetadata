07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYzdMTMCk88Q7kNvwFfE4e9&_nc_oc=AdrD52Bs0wZ8h_i3Aq1AZDoQt_8bFb7J4Bno2k5iGYI2SwqhUT_q4mDbyk0EMzUDuNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyKvK14p6jYgKOAGFfD93vT28UpxsF6lpKW_MTP2Q0OA&oe=6AB7D806"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuH0GPCkJ8AQ7kNvwGt4mrg&_nc_oc=AdpaVJLEskiDeEzq5lr2A5IyhHTawH9PobIpBSzNdfniJO0DETUdYnvUDwjD95YU4ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPhZAHCKsyXOkcBGNYGGpKp6nEltVD1OTbeBbpWxgs5w&oe=6AB7E6F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8bKnf0PcKsQ7kNvwFPuJRj&_nc_oc=AdpE0LsQMH6l3AyCi1L33ev8pn9ru9mKAqTxD50MTVDmBbJqhQ_WOkodJzdm2NlO2QQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrJQjn-iXZNHNVqj-eAxY66AGJGbn_C0kpAEzMSZ_iMw&oe=6AB7E493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiLfX-mi3PcQ7kNvwErdFx4&_nc_oc=AdpRJuQwylcRHFne13fXXDHYrjzGyKSwlZMGwR68BOfa4ttbTTPTa-iaYSMmu_bYFvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId3RPqlSctJuziDzmTFYuGsXaFEamtkyB9A8DUCWWXBg&oe=6AB7D91D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRC6DKi0yVEQ7kNvwFD4pe4&_nc_oc=AdoD2wiv2zCWz8bsUEWfK50f1OBAvsMUwpsiu4KnIdk4oJnYCn38YQ3cgeed2FS7PkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvj-iw_EfyvqnEE5-E-3kM-hcNvCl4XMfq3uYvkvbR1A&oe=6AB7E
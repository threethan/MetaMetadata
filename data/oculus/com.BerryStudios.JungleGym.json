246706803007353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgYdfpSYlRoQ7kNvwFVI-UM&_nc_oc=AdrnIq2I4R4EZf10nwZWGuP2-Xl0od22C7cYOIrgd13TR-oAIbEjWxvdVVAVj-nOjac&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIPP2dskVpW_O3wdZ7MddyjtNP2byTI3zRN7pUAzrz1A&oe=6A8D6FC6"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7yl3px1ou4Q7kNvwHWknwM&_nc_oc=AdpQiF7qs6vnXFfjRXyTs6cKE5mTHMkg0g8eoT7vu16Qmbps_hvQCc-Uy5ygg1bNynw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3God_ZsN6CJpmX3hCq3Rz-nTr6kZX7AWzxwEQLHVzGw&oe=6A8D7EB3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhpImPU82asQ7kNvwELzZAI&_nc_oc=AdrEmUI1T7OUirHNL_TYYDO0_KDo4SMC3nKlaLrkkF41xA5A8rhVeQYi2h4N416rb5E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqbcddOVAiUV-y4bBioTTwhsuoA5wt5VBTy7-S8GzUlQ&oe=6A8D7C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_orXZVC2vkQ7kNvwEO52B8&_nc_oc=Adp4PFoqVlNbGLa2If1T7UJlhix8oYNNphFikyamFoJ79kKVkEaq7uLkNO5JQfzQHvs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTLGgjsRZ8trObuNOzBy19wKxwGfN6R9Qxo9n9AF865Q&oe=6A8D70DD"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7QdKVrnlVsQ7kNvwGHTT7f&_nc_oc=AdqnNL4o5MmlWqt2chJEQgJ0wBqsn_MyPsUX5Y5WBvi3cGzsNCqvxGDrtQmMaTlT-kI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYXOMFpiiH4bOnoKFqT5S0RE-DYY0VCgZdhPsYE
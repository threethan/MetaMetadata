07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=honK_fSwhwQQ7kNvwHjOKEU&_nc_oc=AdpSvNxSLWzCkZY_h8ZJxepRzBxQcqWeaWfWD_ObuqOr3RIliXfnfR66GTeRoUWwhWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7t0nMgqF-yAfNvHJy1_ytJJi7nGqiXCzCTABmDBDu0A&oe=6ACE4186"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTJhCE2RsA8Q7kNvwFBJV-6&_nc_oc=AdqzxJVB6ASu-eEJo8PauYf2a9V1cpZ8Hzb9key83kwmgpId--YPWP3Dwq46rYS_Efg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLThk07CZLCaYmh9uCw8Ql74KDKfBeuE9faHFhdEBF9w&oe=6ACE5073"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lrz0RQxpcpIQ7kNvwH6qKPe&_nc_oc=Adqk4qJ23VSq1liqVqiRRH8HI2a2bijzXbOKcoPGn-Hm49f98-vmW5nInYVf4wug1XY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML0gXDjUJzpfhaCJNjrylIf2pOgUzcMTUHagN5uHktiw&oe=6ACE4E13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BpCeFhILnkQ7kNvwHo_p_M&_nc_oc=Adofrvj9ribJffT-WXUH4HoBQwhQZJX_ANkEkvCMldhnpSE0T0pqmdYVGx6amShImfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLDhLPsWrc3T81s7IeX8K2eXYQI-c1OfineFfQWt3TZw&oe=6ACE429D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNdsSoR4YFIQ7kNvwHSVnEh&_nc_oc=AdqiIMIr1HIk3EtkhKJrNqVbM6DnEDXiomLZDy0qFHJ1P6-_H4y71PJcH994TUzpN-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9Hgl5tk5JOQIEMenX_9w18dWixa7Yd9VhRWTcOOnKag&oe=6ACE5
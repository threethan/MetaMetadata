07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AHoxX6m7vsQ7kNvwGfl4r5&_nc_oc=AdqktjhtBO_UTUQagVvfewgHiSTjrJ0Qy6d97eNvT-Sj5Ywbjq6FShcq5Pn_hpY1k1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3dScPKoCxNN23_WBV7GShcvGBE88djrpYxxHdcex01Q&oe=6A315F06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWMHgriMd_sQ7kNvwFj_3cr&_nc_oc=AdoqBokVCaXl6caiYtAzHvM0BNDd90B4d0PpA7RXViSuQvhA-ku1VD40t11z0gk2ntw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IWG049J7s6V-a3M-EW0JR8zUMAgmf-3P0yfA7_d7u6A&oe=6A316DF3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC1rWT_q1IIQ7kNvwGinf68&_nc_oc=Adoc3oRP9dj60ZJE4FTxYs5nPI4eVtKFt2e76qL9KTgHpDJQaBEHAwQg_CYRTZUQH0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a9O6PVPBm9ex2Dek-G5gKgOq3vGXwkHnFfDV3IPWcBQ&oe=6A316B93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz909CccK48Q7kNvwHxwQCH&_nc_oc=Adrkt0IVB_K_Kg2pff3j1_h30Dd9X_5wmmseeGs12Y2V2Okd-qsFZaVz1BVBnjGw_UY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hHXtxaIg3n3iDwqyuMDswvQzz9GHUr1jgCxa4FiZv0A&oe=6A31601D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wT9baRYW_kQ7kNvwEB_byP&_nc_oc=Adq2xrNRubVB2yJzwVkmxr2Fjbo9PpR8tYe0E9_1GdsG8Wq-YMn-pSB-ly1WUpPfzUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wGWH6XSrUr69UU6cd343njKOlmbTjv4V_Z8cqA7UGKA&oe=6A317
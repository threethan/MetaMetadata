07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOjoh3tz29MQ7kNvwEdeJCQ&_nc_oc=Ados9NRs7AyoQc6RzPhriOHA8rmO_b435O4DMInzqNqHdkEg4i6F_UG-e3ASu4VnQwk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0acbQldccRiasuzXaXsj3KsfPW0f0A9LnYAQ4C4-Nyw&oe=69CFD006"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_h3jT4MHv0Q7kNvwGe9V5r&_nc_oc=AdqibDAQhkN6GN9TjhYqLKvWP7cPauqn18rUjs2hOKz9ifyd7V5BHtwpYVJUbKg32Uo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9-oFXkSJYDRIVi0hyVJl66A59RlnRzjdnhzErWXjKBA&oe=69CFA6B3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BH0_kyd9mkQ7kNvwFBvatb&_nc_oc=AdpEnPHL3qXX-DxeDpOWoDz6K0djGzblog3QvlTMqM2KvB9063gbWPr54HtvSodPR7s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyB6hQ_WgEpia3jKuT8EsYeIxHPxDa4MSviWVWKgOWqmQ&oe=69CFA453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8D456Wjp6wQ7kNvwG0qZ9i&_nc_oc=AdqVNoTygpNHmaE9fmFwEBrbFrB-ZvB3ctvmIeVKvPj3R7GLmPVkk-7tTvM0fVp7_bU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxgaq5jXU8M4h-Fsvjokwwcm-KomIaNy-e1nusLzAjSQQ&oe=69CFD11D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dvTBTmVkR8Q7kNvwHjlgi6&_nc_oc=AdqpnYTuyF6uhqVSiVkhgsy9x-tVirymYGeGOM3lvWzVa8rX2zcs2Cz-EuaLFO4M53g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8Fj2b23jOwmsoDuk4twVgUKqQQmRzJKAY6-2WcmvnGQ&oe=69CFA
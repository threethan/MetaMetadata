a1pouLjG-I9LK9igxJ1EC9I6TJBFRdNbot_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvL6uPFZ09wFec_wn-wsdJ6UPwaQ2xrx2MgXVWK4OoCtQ&oe=6999C286"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz3H1bwyTDcQ7kNvwHFDqvi&_nc_oc=AdmV0G9pYnAQ8pXkNVCLiSdmh5i10OAMI0lRgEGsIs1v6LvNSyOeLrklRm643i9BrmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvw6-D5DjomkVQYHLYX0fcl9r2oQUrt3XO6Hbk_viwT8A&oe=69999933"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keVSpjodZJYQ7kNvwGYZxme&_nc_oc=Adn_vuyRSkD6cFkCgIQsOLuguG_x053Q9AIAk64bd5hzVFuUAOMbSpzjrTW9PAwZovY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZHaKZ0XqafbCoxSdgNfGafR-VDpNDSxy52u2_7IbZAQ&oe=699996D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv4Bb0Tevr4Q7kNvwEGBDEJ&_nc_oc=AdkesjOTErbzdGjGNLY_4sBjQ4kx_33LfWQudrWsDNQSLZcM1FyxhaWJMNzrv9htOSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvtvzt9uiR4lOF81sO5Ko9KTJ4wpW6OfXEnHM_kt2Ur-Q&oe=6999C39D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sTw24VfLP0Q7kNvwGx0QFp&_nc_oc=AdkpXEU-R1Pi7UTK8KZYmMmTwxi5hhviVYdKuIXJJIYTBqOSZOM0yB7FHdGbmLixYPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7YD2VfG7D3jJoCFcIt6zqtzeHUbSsSsxJuL9at8IhZw&oe=69999C69"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jungle Gym", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES
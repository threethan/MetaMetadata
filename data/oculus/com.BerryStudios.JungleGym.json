07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsoJyQkOZOgQ7kNvwF3NuhD&_nc_oc=AdpibJtFy512mEb72Ouxkx4ngsuZtN6ot0gFP7NPU2LC3T2pYd1UJtHs3fupZDmW1VI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbyc4gyD_3TsmzHMxj0HYuk567SKjxeIwFSvdFRqGGyw&oe=6AC8FB86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nHJebMAVrkQ7kNvwGgaG6I&_nc_oc=Adph9e06n9G8pLzoIBQXXQ_5jfg5h_QVLZACWnSQOH9WqQ-6tZLyqYlDexFXzV0G9TY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRkV2CyGk0IA3DUoOzjz_PH7wHZ997j7hXp8ruaQb69Q&oe=6AC90A73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Cn1e_d0i0wQ7kNvwFsS8Qq&_nc_oc=Adop9zNFg6RAEP_O7s-3swjfBcfkmj6eGFtZxbTrbGqBOPMkgREbdDFR8M0Q-TQ8O6Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLLXisD6TBMQJiGMjXP_46BYxgAq4ETYk51NTAGQ9Hpw&oe=6AC90813"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7azpDIqMefUQ7kNvwHVf3aQ&_nc_oc=AdrG0Trwr6POZ1sd5N5PRwuDCJv5nqyugWaofwohLyBOTk0DjaRarrjfgGy0x1LNeuI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOfArRJEjUYWZkfot7dR8U6BbTbH_G9MMAAot8cc9vkA&oe=6AC8FC9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mze7cQ2OV_wQ7kNvwFJE1J_&_nc_oc=AdoR-5-r764S4IdCHP7dYkhvr56j7SFJefCEbZB-M9tzQ3vcDu5VqsJcgJvfvC1TICw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs4tz7kU3m2BNaX8uC6y5sZ_0Y1C7JRW9aqTn9nnFaOQ&oe=6AC90
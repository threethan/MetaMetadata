01864004_4096440949267540551_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A8th9k9v9IQ7kNvwFIxaCj&_nc_oc=Adn6vR6TPJUTDD98z2TtKHy2ZCM9TD1ry0H7nGeLptjjMUESrEuXQwWdXWDTxYMnsD0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOix3qY0OzG53ZzwUI89ujdtlng7nJEekEkkw1EoSoTw&oe=69AAC804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esJdvSexjhQQ7kNvwFtF4a9&_nc_oc=AdmWW1AXz3kKS2R8G4EbX-16b7l9Hy1slx4S0zlCgavcICnnORVCpCBcmvBxmrkOpIU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmVhYb090e_UqeYce4nKTwRKCxACpWunFiGolnbsB4HQ&oe=69AAAEDD"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello Fellow Monkeys! \n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a multiplayer social game that uses the Gorilla Tag locomotion system for unique mobility and gameplay!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rat
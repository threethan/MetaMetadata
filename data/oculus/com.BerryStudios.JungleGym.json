07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HcgnbpJsaYQ7kNvwEmjYkQ&_nc_oc=Adrphlhw5Xysz1sDxvcKWbxE7mXeYdgl0a1B82Btm0ladnL4l68PAQSid6c9T1vlrnE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iTvBjgpa4DJYLUmffLIgFER-E0S16f610-O7ieDoSjg&oe=69E78B06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtNpllVWp1EQ7kNvwGAIPbr&_nc_oc=AdpsN4yH8IQ2JKqhqT8Qq3ch9gvCHCuvitbmGx21HopsqSc82qDenlibXWE24iCll7E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rl7LtLRt6ZQrux_7GkBtafUREXP2ZXMjhJk2tXOQXLA&oe=69E761B3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztNwgRbmx-sQ7kNvwEH0PYX&_nc_oc=AdrO4WK56ccIZZ6WojoXWFG66Uk1jqQGnjNj0LUN_klhb_L5KX4GYiEoJ-byaj-sfsc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-OhPmlO2ZGR36Ns1r-6-6_EteyWQYu7bmYa8iJJw9ng&oe=69E75F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1tf3i35pZMQ7kNvwGlojDQ&_nc_oc=AdqUxZhG2SFtLGzR4_Rq9o4JFef8oSVTw9OTFLsTQnNacJD59LxkBIQIeTodGa6e49s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I7S_dDnXko3Kf7I6dpTykek1IcAD_hjRgF8ged06Z2Q&oe=69E78C1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc6TCtMftAUQ7kNvwG4IPrS&_nc_oc=AdrH0PIrHHjPWQWDeWaWfojLVAbT1G-dinDPCiAhucBqpxh82Zcn646pMB0VWJydBfg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nZzHsulxjSSCNuFpYNJjGx6gbWjYHGSNL3oeVAwfyNw&oe=69E76
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lCbXlIG_i0Q7kNvwEv6Y3K&_nc_oc=Adp8I0gndTF2VBhVnWGcm1JvPt92a1DHQtaN3ZAorkle_ug9UU221IBEiDFVAE2sMRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNQCer1JWjxU7X9uW-bYkFp83DAL-Es9Ssd5wrERgpXg&oe=6AE4AB06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNpORPbleLQQ7kNvwEa4N6i&_nc_oc=AdrY9y0V4hItsJKVN3KqSp6TIj0hLWa5hpk0sgcM2DxRyc96svjuu_oegLgGM4esw2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUmrkw2K8AHFtnfMwq7r0Q--LXq0GneZVq8RqhNBBxyw&oe=6AE4B9F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDBknDl08IIQ7kNvwEXfc0_&_nc_oc=AdpJqCeJFdILctSlXJWiyxLjuWrPAhyv7BaM_13BE5U96V6FAQ81UefW_z1O_56NN0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFnyCyCWiCSUryGRcS6KBk4NQqHkX4cAj5UGG_4fqzDQ&oe=6AE4B793"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqWITk-ZzicQ7kNvwGEELcq&_nc_oc=Adr2E77O91Uc5HLHHd3g3xuTD2lDnDTQLg2dvMKj4cXuj3jty4v6NkWLwU4vhZU8zWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYaJiv_K-JwTV-GAvvXH3etFvg8Q4UiVHTo_7JDgf4oA&oe=6AE4AC1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX__s0nCJnkQ7kNvwF7qASz&_nc_oc=AdpaEBREbYVfTS5l7bqOdME5Vq3P2h_1UWaAuKiTFFW-HaoDWpDZB6cKDTu_ntJYcd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpjUDBePpCoJLXU4OnuXmwygjJjBH_rOHbcHS5Ab_BJQ&oe=6AE4B
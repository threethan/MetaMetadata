07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVZgTr95MQ4Q7kNvwFBLyvw&_nc_oc=AdqC6K6FJAzf6d76T1lPYdLTAgA_jVF0l-OIaJA7PmJANs9pjy8ekGJv_BK1ySVyYE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnL4jNVJqTLFLyZhkyT4luICtN35Wci9D02QQ4ZmDigA&oe=6A9ECB86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZGwb00qP-8Q7kNvwF8bTdh&_nc_oc=AdoBaFOyMi7oUsjrxPaiz8qLGYJ3l9c0NnTu9PS59xmfwtCQgP7rVB_LDtkF54GJ3c4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaYNoalPu-DNwSP0cygGSaFth65YVRhu8PRAtEHzjTDg&oe=6A9EDA73"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-YJlAqd_PcQ7kNvwFebXbx&_nc_oc=AdrsssvKE1OC6KXJgKL4qYs2h-nSIjIe0Q3Gh7lg63rMn9k_e-rmxpGEnbn_Fd-iG-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwMI729S3RQjWOHvZ0SpoUBDEnh0fpJBBKF8AAYALE-g&oe=6A9ED813"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QmQw_7-_mQQ7kNvwGgx-aU&_nc_oc=AdrB40ff2B75CIpd9mx1nXb9XGmHHUU--VUt1MSQPh1ZcUjXYiU9XSOtxqTdHF9RqP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXWecKatQ-wmZnTF73nyNIsjEwzjY1B_QNzv40EcgQaw&oe=6A9ECC9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mXZh0VQEm8Q7kNvwEVI6nB&_nc_oc=AdpluyD5R-Ok2w6Z2XEZfU7pCbOyJnn6YHRkBQBZ9gtjNjjM2YcceBimwYa0H1mYtsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmvRuddt2FblW3U9_86KDHgdvNivo5MRXuU8BMX9csag&oe=6A9ED
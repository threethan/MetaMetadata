07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PRA6Xn79jsQ7kNvwGodbOI&_nc_oc=AdoAY4nAl8Y8u6-VjRrdk9sX5Za2a8DP3SQurS_WzqScgb6BajY1Xyd8_VzcBY0kMWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXm1D5-0Z-uEBqF9k4JM_9-WQ6So5yFUmhqxdwaunSpA&oe=6AEDE586"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE78YTL8xwoQ7kNvwEW_og8&_nc_oc=AdoG5FDv9Qro5CL8RBATvIISMuat-Sk-BGEvobIpQ72BJv3jtVQKjAD7C1SaP2RYySU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9C_ZG9348I8x3HsdXN1R7ZLoiulz6xPpUseiei58Pgg&oe=6AEDF473"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0S9JQKPX-wQ7kNvwG4H3ne&_nc_oc=Adpl2nTfakONvXd2JHJU1F1fkDbg0kgvSRHLC7M0GVFwLSKgHJ5gB8fm1hQ3jZZzRIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOImrsNpYi3MP9nA9YaVVOuhXbkbHQcYg5lObnbV_gVQ&oe=6AEDF213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOm8VGBvXJ8Q7kNvwFdeAEE&_nc_oc=AdqxUboWHBOeCNbtms9f6MfqcGSTGzNCFJNVFc2nVthO9V8Z4kni-VRyX7rVttjBDII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2ngE6gb-Htv7Ej_qg55VkidQMK0zdJjV5K9ZezDOt3w&oe=6AEDE69D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMBYBWZEHNoQ7kNvwFZkJAl&_nc_oc=Adq_vLXZ-c2QYvW7gzQVMLCIHJcG34DwpYMCrzqCevs1vTa0TCmwpCLW2-hE1t12ME4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmoVRTht4H4iRVzB9kAggk7sE1mll5uwovEzW0B_7-3A&oe=6AEDF
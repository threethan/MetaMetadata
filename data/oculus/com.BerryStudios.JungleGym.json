07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzoamHMSxHsQ7kNvwEpxCni&_nc_oc=AdoIbX7nq6ZVdL9kYUTkdelO7lEKWlXV1KxDNaVzV2ObJs-ee8vLIEraFZeXmnarKg0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WxE0v4N92xZMGfLKCs7Jrq1T33U-AK1BcIEKg4RPIlg&oe=6A0F1806"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koKDQRazCsIQ7kNvwEO8cBQ&_nc_oc=Adr8hWM10u5UaaqyyJk6IAsPCj8iCWbURdzT4kUpAeidOh6_AEX0lgcn7KuQNzAIFzQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nB3BfGA2SpXr9nmkpQqLPWRQBtWfbeM6devD4ZyMYmQ&oe=6A0F26F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9O2a2fxvAEQ7kNvwFE1-iH&_nc_oc=AdpafyNGy7b_FeUaQalcQVyHZosjar31BtFSVTsfgH6tY7xWFdZhZyoqp_wPC7y3QXk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gtjFIQyOrykQ-BMRtBfS103dvMNDPeol38PQGv1TpVA&oe=6A0F2493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dER_GoySvJsQ7kNvwF-0bKj&_nc_oc=AdpqWVZ5cQsqVVTinze53gPclvXB_R3-fTp_HuQ-Rq_aAzk8O6_mIpCOJs4k3H8MqoY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wgvAM2mQ449nld5_j0BscT4z9SPj1PJr5pQrCpQL-Ug&oe=6A0F191D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhBdB_s7sIAQ7kNvwFvYHeP&_nc_oc=Adq7WzDFA5TJo_TBsvShBvKbkjp1XFEXrl8NZMtwgqSv-28phd4xWGWM3kO9RoneQ_M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qnAwtksxZeCAM5LOu7cH20tmlQuslWzTkny1p6J2S9g&oe=6A0F2
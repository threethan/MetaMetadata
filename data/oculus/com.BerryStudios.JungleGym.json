07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpCL0uSWXC4Q7kNvwHASiUO&_nc_oc=AdooNCSme1ZKloNG7DMmRWet8yjDd9GMcCwlbZxhN-nzXU9d341PixgH3ulgTL66K2U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBivD6RM_CAQVPDWak0JIBJ5hJQlIu0S4VrhjivjA3TKQ&oe=6A58EC06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seqYADOxSQAQ7kNvwFRdr8n&_nc_oc=AdpQKowXLmNEWXRo_DY_sH3ykx3t_rDGQc91wcdUWvBEKeBQkLWnfl5g_5e3W3AuyZA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANR65veo8MaOoQvjU_B8PW8Qxqaj_hmR1XwCO4dr8vfg&oe=6A58C2B3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDupgK3nB0gQ7kNvwFT0nwO&_nc_oc=AdqQiC6BJskbRUG66OGTw-xhhrryI5JjMBo77ykVVf7aGlkP9X2tCXtME9GWveDSTdk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm_IMHXyc4N3uS0HONUmZMo2LeStZCRQhQy7CoUoHVyA&oe=6A58C053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eov0xuh8FQEQ7kNvwFMHCxi&_nc_oc=Adp7Psuit9klqA87uQHy_vNaE5ij97sBI7vaU-0_Cgd8Z9vikuMgZFXTiPTRK3oyz7Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIATbGlhZACTGrz7bBuevjjh1GrKaT_l9ocOqMYazt_A&oe=6A58ED1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z8-xKYH6z8Q7kNvwE9zHjw&_nc_oc=Adp6pOV4gMHHAAGo_AOWVPykyTCdRDS58r3Qs6EZ2PMoG16NXulYrVPfyOweAcspt5k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2Cj2ZaqAm9Er5tumnb77ljkrPgh_mhAJL_mo9zC5fOg&oe=6A58C
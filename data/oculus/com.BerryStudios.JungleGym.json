06803007353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQK6R4fEoUgQ7kNvwGnL9bV&_nc_oc=AdoiGxfpj_flAeEKOZV0K5Pi19qYNQN5PTqRJK0lFDE83Ye0EJzN1cszfF_3598PH_E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MXUGhpIYRJvPvYffZbjem19QmBOTdXgFuJBbdD5GJdQ&oe=6A394806"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n7xkm2p0pgQ7kNvwG9WZLo&_nc_oc=Adrb1KUdtk6H7FFoSeu6_nOj3WoOsu7dx5_MljnsDm7eRXWR5-2PdJ2BWlCuO5XOj90&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_FM4Ffds-DtjqIUAUrXQY6MXKyHGU270GdtGJoHFnmA&oe=6A3956F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avOYKU3QlU0Q7kNvwEJkKIb&_nc_oc=AdpdI4J4NRr1A_ETDa9XQoBaEd9tn8xiT0eUePNIzcWBhDJEflprvhX1I6wOcMQ2LFU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QaK5bvnl9LBQARfgzBftha4CRaChRDbjEADEZDRNEnw&oe=6A395493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxj_evVdCKcQ7kNvwHTEDoF&_nc_oc=AdpRqdhvsURA281p48FKIEg7FBKJ7BtWLXhW6HOqfxvrK_2XDW7gnRlDt3SPJCxMh8M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A2WH7avwDcSTbEGuNZ88fKkHNakdn6ukXWfHcYsN2wA&oe=6A39491D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM-BYEVavJ8Q7kNvwE_HbKJ&_nc_oc=AdqczuLv_i-D1GTc0MMG5GgDC3hA38yXXfXplxVtcG1UFeUOLB1t60F6aF07tSIyzBE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LPwpakPIRZIRdQjSzRMZ8SRCE_tU3gm-TgzmiS03
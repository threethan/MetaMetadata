07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mnonn8h3bIQ7kNvwGSj0FM&_nc_oc=AdrdQVi7TIkQFI2VvoHzO6TMXR584T_9KGOKsapQmiMIJnb7vLE2y59gkXWI9IGXIZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVnz_UHs1nY0t0WBg1GBFpHqvEsL0Y_dhmMo3IOFrsNw&oe=6AF1DA06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91wnCVxQqKoQ7kNvwFtcrB7&_nc_oc=Ado2TnTa5Q7x3ueJFdlOAA2LID71awu09gUYETMPISUY0I_X5iZFfTjfdmuM0UdVoso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkdocFpf27m_cphe4TRTD-l9rBG_IGjpHSXwRxJXm1XA&oe=6AF1E8F3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7UCa19x4VUQ7kNvwG3FAkP&_nc_oc=Ado9QDlsemAFFjP2ujVJ0loKBc3uI6gX0ddcRqQOexB152TpreGNEzsrrR8QMHGYGFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR42taSkA2T6y5mVJURwq7TiP6pgCvZTaKFJGzrlwOB8A&oe=6AF1E693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgpc6F2jjuEQ7kNvwGoKErQ&_nc_oc=Adq7RsCjkCrRGSulgpp-Il0ZmXuzEdrhA8UCXlcjQJ-IzDAtPl2mWGjWAQSMii3p4Do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNxlXLKdWEmt0DDgjn86YB-A0BNB3RuMf8MYNeocPjxg&oe=6AF1DB1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5n5FN76jGcQ7kNvwGvrDXq&_nc_oc=AdoG_k_rNm4SZAFMzUIF753Hq0GtA591QTD8vTLOO63hgtLIEsd9zyPg4xOAUCUIiPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwikLMuDp52csLIb3v0UrjvX3_SJUFHoFBIx9dj6oyig&oe=6AF1E
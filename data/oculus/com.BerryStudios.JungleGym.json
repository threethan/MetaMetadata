07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnmwczohZE4Q7kNvwGCVAAU&_nc_oc=AdpZ2O-2nRkqmHKcM6XHpTglOrKMkXCl9Sbrb36WrM1i7_WvShXRJJdNxYCuQhUSsX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CoD3sDmpEsh4P7g8AezgOY5ha3WV3RQOrKphjbdXybQ&oe=69E8DC86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtNpllVWp1EQ7kNvwH1ewCt&_nc_oc=AdqM35EyW0vYX-zy6hPcNVMEn7rgWm2prWP-rMaSDvEXYhWF_4J6qsGfd2-A6_qCEtk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pyyJ3YHigk3m5nCVjKQ7thPQr_MRIzfmy5lopzuvxuQ&oe=69E8B333"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brolTH6vls4Q7kNvwG_ljOH&_nc_oc=AdqAX9vFu8TIMaaysHxz_fVF_njsdypzYD3JfSwUAvb9y3tfP-xzn6h1JR-XJhmxYqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23n6_ohGXCYYNzpmKOXRmzrMVImk_eNk1HIsAo6ITy4A&oe=69E8B0D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW1DOyeOcZYQ7kNvwFGAbfS&_nc_oc=Adr0ui1nCqSj1YrYg_5Heip4fDu4Fo_IR8KDUsbRE79LVJAcs7JGoMx24svxcifKSbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XRY5JogeUcD5IfMI1JCyaAQZKtxMVgslNolNcR9pwGA&oe=69E8DD9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc6TCtMftAUQ7kNvwFL71yh&_nc_oc=AdoYEY0o4zYzZbERDCUm4z-rMYrjPFOnGYp4OvFYMQ7KO0xOFTQ-vntw_QWlj8tOzNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30pUkbrCYEtiEvCoIy7sgakea5HeohZhA6fc3SJ5sngA&oe=69E8B
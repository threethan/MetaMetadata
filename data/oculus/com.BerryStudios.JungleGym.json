07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbMGoM_fgoEQ7kNvwEpAUiZ&_nc_oc=AdpFR35trGNe6rElUXV3YgP23noR1h0_LQeUwjhbDB30yAeJecjRHhWJcOJ9txEsnGs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfdUn6Y9eOKmQq9fpUvFDArktagPkpZG6BZo39QrnL6Q&oe=69CBDB86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=todCI8AsiwgQ7kNvwGvm5Si&_nc_oc=Adpv0TH5QbJzBaIK6daqPMiuFhak_9YpVVg-zg274XXbwRHrUCXv_C6jlekxafN4-Eg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdYJ7VCJ4nmXq5lvjHeoscYJeRD1pIbJxlaK1hvHdnvw&oe=69CBB233"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8vB_s4j-Z0Q7kNvwGY68Fr&_nc_oc=AdrGE5qqDoJDRtCPBvtSX9p-56e7jY4aw-4w5AzgmzyVAYK3ch4LzpMjaeq2onFxTN8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxG7eMrvXmfsyDN7RHZD0Z90mj44B6Ph_Y0226PYmpr0Q&oe=69CBAFD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwx3bYRWzIgQ7kNvwGYAMba&_nc_oc=AdqF8hFdm4ADKlJZw0taGmucu539elY_FxtqNfm9_gUZ0PErwjhllJZ0uFVg2OPq6Ww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-UHm0P5eKoGQitmr4XAZWyY6pvy_ghLxn7OtHrDWzWA&oe=69CBDC9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4tT3zFXXdAQ7kNvwEAOJYn&_nc_oc=AdqAuPsNEjNmL46bRi39_-k-lFqZBOSxTB_kF3F6lHPwfCv8EwQ0kwgPEvf1jUfhtXU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxL5CRLbBrV-0yr3CGZt4o869BY5oPzs3FHZ18I0JZKHQ&oe=69CBB
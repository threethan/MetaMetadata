"Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771
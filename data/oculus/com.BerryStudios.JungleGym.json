07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScaJxmHV33kQ7kNvwFvsJTb&_nc_oc=AdpiLy42U8pWYmyRkqWS6rYawWiUAczyhs7dW6sntruy0l5i2KHz3Tvu8a4ddRHZ7fc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fAWDVCheHPp7RiTIYJgwZ1SlTDCK4R-SoXVjDz2q7_w&oe=6A2D6A86"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONenxOpNOG8Q7kNvwEIxZTn&_nc_oc=Adr_n_5-7ti4w9E7dLtXR-RYuIqVwSG6ipi2_EZKV8ubU-tFjbn5mTL_T251JSsw7LQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DFv9rY_31tDVUVRH9BucpJreURqCUiF-42_40bmnknQ&oe=6A2D7973"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDT4AIcFcn4Q7kNvwFJlnTD&_nc_oc=AdrerXn7EX0o89C5mNc67v9L61zHhPt_dsGZAVGJNicJ7ZRymWYyiqmH51aA4tDfk8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TKSX-2jU6op2P5QrAIpc2LHQTzhpyYgB0J8b6BIlBAQ&oe=6A2D7713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrAF4N5TzkIQ7kNvwEbUaty&_nc_oc=AdrRz_GZRGsoYoGaPaE77Yy-GdtzxUAPVT0Rk7W8ETpcjW75ACKdUP6MRoNIITlsw1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-K7AqdcmRB8hSSxjRGMEFXAsH8YoJ4LKJkrbg8ReWCw&oe=6A2D6B9D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z2_JCmENm8Q7kNvwHfjvl1&_nc_oc=AdpEy7nfoYfebvSpQXjfO0WbaZvcdp3_t7OgGMLU86W1G4GQnIjeV-WywfmeWlrd7do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PCYO_enrlGyt2PG_c8_rOz8nQqjZIk8ztoOQ_YYTPkw&oe=6A2D7
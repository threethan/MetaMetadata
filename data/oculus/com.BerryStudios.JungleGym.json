07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOVafvkqO4gQ7kNvwFwUY12&_nc_oc=AdoKxure2-GBzaqExKNComIf3DsxN_EdZaQSHnIPOGAv-8B2WyXXiSIx0adYEG1UGYU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iO4HDX9TGy2HXYe8FzyKNONvLVCgJXxv_mnQO6cn_Xg&oe=69FDF486"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A5Ne3kl0cMQ7kNvwEB3Yvw&_nc_oc=AdoQixZhBX894tjEsn7r6AsitbNmP_Vqo8xRwnbUTK0HhUdCeSGuhFhrjf-XA6AXmnU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MTcFKY6vJ2a4-aUeJ7jRM1OIhCVXc0JqmPY-EILK2wQ&oe=69FE0373"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYLhJnXXzHYQ7kNvwELsS6B&_nc_oc=AdrXOXLwhscAWS-mxfLURhRFmH04D54SsMbVM1njpCYQAPDK5cGREcjm39LjNSiHccs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KpV2Z7SLAbbZx3UAlPqFC_ROn1iR9AOSWjvZWabpUeg&oe=69FE0113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bnto7L7y83oQ7kNvwExYoX0&_nc_oc=AdotWaRQHOH02ujY2Jx5ber9j0-vGh8MZ8KiQ3GOCPwpKTwRfzcs2YDwvGsgcpB3zO4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dcKUPnePSO50LMk7WCr1ZCQeHEi4bZle7yfbV3tZb9Q&oe=69FDF59D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DpssCYALssQ7kNvwGQnL3N&_nc_oc=AdpWa6bBR-cEXfJtO4EZlXsYEwTC0A2YGVH96Yx_LQTdWaux0pl_yJYRO4VDNMSwLx0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mgXkPw2yvVczNXco4PafqTAqIbt1PY-F4OjdNIJD-wg&oe=69FE0
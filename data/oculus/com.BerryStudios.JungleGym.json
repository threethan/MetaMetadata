07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnVWqU3GJ1MQ7kNvwE7knQn&_nc_oc=AdrZO4m2nki5ltuxmIG7Urybq0Zfo_H__soQn7y6Az17tcgoazFvqzh4N5yecyoN3VQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3FFOLYW70E6nqeCPptipvOj4TI-HoCAatZhubkx6-WQ&oe=6A971AC6"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEtyy6deLCEQ7kNvwE0GHLt&_nc_oc=Adqi8cwJjt54RLx71J2oOiRQE3ZObXUKOJpBliT8uQyqamvLqcawO80W_U7aFdbl9Ig&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIjrzjuSNsHgxeSEc_hd_I6o1pntag2nn3eSHJOW-3sg&oe=6A9729B3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yJIqoYR4hgQ7kNvwFMtLT8&_nc_oc=AdptWogNGBUhYT1-26zb9efQwFdhq2Pe3J10lPJ9Xn2C-6CZDQyXn_XZ8_bIfQ5FI3w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKO3inBnyjtUrmyqKuvierH4DtLbmqC131dvN5KtHtyQ&oe=6A972753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVmKADead3kQ7kNvwEKDYyo&_nc_oc=AdoHG7_ctIZNuwfrSfnDoh5XoLlfiPHa2ZJj_YWEFx2huElYnaY1g4hP9Tamda9CJSM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECztKFmMkJthuYj3PvvFzIa1cro2troaSfzHUQ69BmYQ&oe=6A971BDD"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkU8ejzWDRoQ7kNvwG5egDx&_nc_oc=Adqb8Jx0_MeD7slmzdLG8EgL5vHU741YugRDOa8sGecmILmd03G8F7sBJqt6fGE1DB0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPzBRzKqdWpvsdHsX1ui4fseDvhv6R3zaj7LvNoX9vqQ&oe=6A972
7ylxD2bI7D8aE1YaUzewQEw0CXSyEvd76uVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3bkUk2OKyKyMr_6kDbY6jNG49ZgIuVcyrfhZgU4IWWcg&oe=69F0C586"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVTM5FsfRckQ7kNvwE86CoZ&_nc_oc=AdqrkA6cr5aveBzapVjb5HWKwF9as2I4VMsroAAqyROqhDyT2bV-wJb0WK3qL4OC-yQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1o-Hbdpv7QtToirAaX5IXAiIdcqRrBcn9taBROn4MpYA&oe=69F09C33"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV7sywY_-H4Q7kNvwG8b5_N&_nc_oc=AdqRqbw_sMRoXNYnm3yosQRldTCyWjqBHnf9m-K6AzYaK2BeQwcC3mGit2kZmiqeWio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0xUOIL2ZfvlHNftjP8IuESaPTTGlDKZm40iEJyrnNaOw&oe=69F099D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K6kVyM1amQQ7kNvwFd4WD4&_nc_oc=AdoFlHF1kQfEwUKqM7RLILc5zxOj3OVCqKxdTafGBPniouyXjx3XAhJbK1uKD3IBIGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2EvIa9zQQNdIEfIH_b8b9BPeAy-S7y6Uf1l9KMW6dR5g&oe=69F0C69D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6pYbyaq9xMQ7kNvwEEyBXj&_nc_oc=Adr9BmjjxXJ-UyriFEdERWSfufDW2WxvUBsLDcVKP7GMB15H-m5h8s8O_-Gx8z3VJ6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3VY3Hz8SeJPqi2Z5lhRjME-8dAv_Zq6Bmk0_XqqObgyA&oe=69F09F69"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jungle Gym", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES
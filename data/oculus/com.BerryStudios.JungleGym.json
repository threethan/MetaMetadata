07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_9sSdEtl0wQ7kNvwGnOXGi&_nc_oc=AdomgE9_xrGWgKvxHH4MSFrWpuCxQHObqE2TjOq3PQ2x-deqlZtOuqtt9yxqUThlClE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvYonN4ZbQ4nToZ1x-K7bYgdCxkWZNlGRWKZxQwMx8Bg&oe=6AE74E06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNpORPbleLQQ7kNvwHxiEcE&_nc_oc=AdreJMNHC_EBX5gCkfu2GyCpY8atX6Z-yb-pNaNg191L3gFWbXLDVkhjqG0r4voKrJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8X_8d3-BVebruKeI-ZkbeXRwLigeWoR4jY_TXVMxeYw&oe=6AE75CF3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYCsuF2P67oQ7kNvwGPyyby&_nc_oc=Adp7lCRuGhI4tcwDxEoiIFEa3uKPOzUNJayzow1yKI25X-ffAr4rLnfOGfrtfWmg1qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKmdnpCZooDPlquxOddQMqUsQmoh4M7R6Joxtb5vx0FA&oe=6AE75A93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYZTB4WrfoUQ7kNvwEeq5Ye&_nc_oc=Adr_YNA8g87j9L-UV_pz-CIC1jDb2tLzmMSE2IFQpvUlD4dbWh7PRrFRm2GgLzukpW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFpX-zA_F2Ut4zgngPYAP2vD04vuM9iVa8oH6PCCRxJQ&oe=6AE74F1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX__s0nCJnkQ7kNvwGX9n--&_nc_oc=AdokA4288MJXcLjrjGmNHCKwsZ14wRK_8mXrdactg2LYmvE1DzI0MjlgR_ZCv4gFkK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjNJHYa8yvbHhM756utogKnmrDJROjHYdACDmHvfpiRA&oe=6AE76
Q7kNvwHLm7lv&_nc_oc=AdqlgK1NcxuiZVeGACL134TMYRvP_WTB-vCG4jy2kzADOLQ8FpuqZ7bZn8e3p_f-DMQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WOeHew7Gw5GnKzPAQW8UJQRi2baXZWFfNZv45j2EegA&oe=69F1F904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K6kVyM1amQQ7kNvwGGr-Dv&_nc_oc=AdpMRKDFYwfgCC2dyASoXw25EhT5nUG8dJi_LocURt86W5oKqlD569ei9FVlYE-fGgc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LtblfHLnppuD9CxoSCKI4p4FRuVu1xSfhnAqPMF1PQQ&oe=69F2181D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello Fellow Monkeys! \n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a multiplayer social game that uses the Gorilla Tag locomotion system for unique mobility and gameplay!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534
07353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EioC1isA8w0Q7kNvwFuoZWX&_nc_oc=AdqH7HGPjCjRuaXlh0WgdGYj3f3TC6xk5QjYliiBZXvW0frIPg5-91MXeStG91EduqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HXESqdGPDA3cKwHfFahSD7XKa6LWDOkVasxjv-U0pig&oe=6A3E8E06"}, {"file_name": "New Project (7).png", "id": "938268324114325", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75588062_938268327447658_8690952681388133056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L_Zsevk30QQ7kNvwEL2A67&_nc_oc=AdrPUr9IDv1ZkZ6lim5YtCcgr7DGPf2BNPtr44zTPCICuUTmbadya2hSqj-5_tuOvGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--HQvzPXuaHnQOZcaveSqjySWL3F1s3uCwFJAw8nfciQ&oe=6A3E9CF3"}, {"file_name": "New Project (5).png", "id": "130717230002082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375762_130717233335415_5758205054171523657_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-1eRJP8xyQQ7kNvwFMZHwF&_nc_oc=AdolAsVUvV2odTYEkdZdVErT31S5Ky1PqeCNa0KPOOKrioPvgJUOTZPyJN2JJmt-Y7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__S5kTxIzm4MqpWoi_PhzhvheQDELkgPFKZurOpOnUvw&oe=6A3E9A93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "123.png", "id": "218658094250242", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_218658097583575_6278038260660202689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma69NUXMU9wQ7kNvwEvQq7_&_nc_oc=AdonYxM4mEDfo65ZHpP1dR8iFw29yTLbZyVC-DIvq7Idqu06QyrexSwkMx31RVeJPpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nx6KptWJ1tg3dbsaCNpAIcW0BmJKEQTWruh0DzsXwlg&oe=6A3E8F1D"}, "display_name": "Jungle Gym", "keywords": [], "long_description": "Hello, and welcome to Jungle Gym!\n\nJungle Gym is a online multiplayer social hangout game with unique minigames and gameplay! Using the Gorilla Tag locomotion, traverse your way through our large array of maps and talk to friends and even make some new ones! \n\nWe have social gamemodes, fun gamemodes to play with friends such as Floor is Lava, Tag, and more!\n\nWhat sets us apart from all the other games like this one, is our unique non-toxic community with a strong fanbase and community. We're accepting of all groups and will enforce rules to make sure everyone is having fun and feels welcome!\n\nDeveloped by Blocksify, the game is well optimized which assures maximum enjoyment and mobility!", "short_description": "Jungle Gym is a unique game, where you play as a monkey in a vast multiplayer map, where you can socialize, play minigames and unlock new cosmetics!"}]}, "developer_name": "Blocksify", "developer_privacy_policy_url": "https://sites.google.com/view/jjungle-gym/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jungle Gym Games", "support_website_url": null, "website_url": "https://sites.google.com/view/jjungle-gym", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6245429258838696"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_575664471111184_6515293772888172033_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLqCEkFcoTMQ7kNvwGxXKj5&_nc_oc=AdrQfBCKPdMLBG1M6jIOmSYHs1b38tPdgJRRQeROekUMmlWVGPIz32UExcvn7VbDJAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2mJSbLMZZ8oKWrhbxhvVPIroYDbtPpnBhXOrnRusMGw&oe=6A3EA
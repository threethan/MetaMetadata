e=69C3ED46"}, {"file_name": "Image Sequence_011_0000.png", "id": "900654169488665", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824671_900654172821998_3820070328754947710_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnOmi2eJOmMQ7kNvwHdrIlA&_nc_oc=AdrGMcr3t9RwPa5Sp-NO5GRwQ0xW1Uu_J43wO1Hc7GzjBD2dy0cONGxmzGk7uwZ5dKM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2-MpATO3BRTSDfGpcnk0XT6fOI8rkMF2aLkJlahsU8Q&oe=69C3E54A"}, {"file_name": "Image Sequence_010_0000.png", "id": "927974199611767", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823296_927974206278433_8447464809348764624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4MyeQv3WkQQ7kNvwGJMgju&_nc_oc=AdocwCNRUkNzN3T_bxgfXb13BYHVDnpaCY4L-9VqaxNLZQ5_tw-EucbA5aZsK9MAvx4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsRfdXcbi0Lp5LsmvgSyM7cqOiQa5vpBazj0iqrHcqEg&oe=69C3EAF5"}, {"file_name": "Image Sequence_005_0000.png", "id": "1420161626573669", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_1420161629907002_1200447846203570750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9cIlFtZbhUQ7kNvwGlJfVg&_nc_oc=AdrBx5XOQj2nNORKVCxEyI2ocCP12rtzSq3iFPtsPDKw23i4-bNTUuvqbTSpUqMop6g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwg4a8MNdTu47QbF-Bsd3OHPqAY2Je8WkTU_gG7VaD14A&oe=69C3CE82"}, {"file_name": "Image Sequence_002_0000.png", "id": "925411363299560", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820496_925411366632893_381066018409985234_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyeVG3p3w3wQ7kNvwG4X7WA&_nc_oc=AdotYTyPTKKxfafCHty9UgWWQszvEJXY-umXEyprj2HsyhRrXbwB_yuIcdU10U4yrcU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5Y5NT0jMurTHP2L-td-dLDIHJI730u3MgJQLXl9xw6Q&oe=69C3C43F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Training With 3D Girls", "keywords": ["girls", "fitness", "gym", "fitxr", "supernatural"], "long_description": "\ud83d\udd25 Transform Your Body with the Ultimate VR Fitness Experience! \ud83d\udd25\nReady to crush your fitness goals like never before? Welcome to the most immersive workout simulator in virtual reality! Step into a stunning, high-end VR Gym where your training sessions are powered by motivation, sweat, and the company of beautiful fitness models. \ud83c\udfcb\ufe0f\u200d\u2640\ufe0f\u2728\nWhy train alone when you can have the perfect gym buddy?\nIn this VR Fitness revolution, you aren\u2019t just playing a game\u2014you\u2019re building a better version of yourself. Whether you are into bodybuilding, weightlifting, or high-intensity cardio, our gorgeous AI personal trainers are here to guide you, push your limits, and cheer for every rep you complete! \ud83c\udf51\ud83d\udcaa\nKey Features:\n\u2022 \ud83d\udc5f Realistic Workout Mechanics: Experience true-to-life physics in every lift and movement.\n\u2022 \ud83d\udc71\u200d\u2640\ufe0f Stunning Training Partners: Work out alongside beautiful, highly-detailed girls who keep you motivated 24/7.\n\u2022 \ud83c\udfc6 Progression & Rewards: Level up your strength, track your progress, and unlock exclusive outfits for your trainers.\n\u2022 \ud83c\udf34 Elite Gym Environments: From luxury rooftops to hardcore underground gyms, choose your vibe.\n\u2022 \ud83c\udfb6 Pumping Soundtrack: High-energy beats to keep your heart rate up and the adrenaline flowing.\nStop making excuses and start seeing real gains. This is more than a fitness app; it\u2019s an addictive gym simulation designed to make working out the highlight of your day. Perfect for fans of active VR games and anyone looking for a fun way to stay in shape!", "short_description": "Experience the ultimate VR Fitness revolution! Enter a high-end Workout Simulator where you train alongside stunning AI fitness models in a fully immersive gym environment. Whether you're focused on weightlifting, cardio, or bodybuilding, these beautiful personal trainers provide the perfect motivation to hit your fitness goals. Enjoy realistic physics and rewarding gameplay that turns sweat into fun. Level up your strength, unlock new gorgeous partners, and transform your physique!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26019557781071054"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820887_2423463951417011_7719257630594647897_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVAMQ0C_uDEQ7kNvwFS-JWV&_nc_oc=Adqr5VJRPsX_U_5XYjwDfsU2V48Yp3CjnlQC_7N_8F7ZafoY3nSc5kNmXp1HkhLgv_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_8x6lplfe3xo7wojM02JYGax3TAoQWliVjQRuL3IyuQ&oe=69C3D813"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Training With 3D Girls", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1772031180, "lastRevision": {"nodes": [{"id": "26019557791071053", "re
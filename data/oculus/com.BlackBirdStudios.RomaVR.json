1163832011306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_1531163835344639_1080769354243855492_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do7r1ekMx6gQ7kNvwF1Sokb&_nc_oc=AdoC2tu7nA-G4rXTcb1UsMa0i24eOpiAq9zO6HSl1m6xEmyV3VBcy0Wd5Ngq7deDGF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBBNVjHhLeHlEWuhsJ86PKf3LF3VKVndMSMup8LB68ag&oe=6AF73C7D"}, {"file_name": "historyExperienceRoma_05.png", "id": "4458060664521943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_4458060671188609_297246986900919732_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQQK9p-vpGwQ7kNvwGdLGtB&_nc_oc=AdriB40jssczl6fIYpfzZh5Tbi8ajMf5hmUR7nAryV8W67q9UUbr48-KLToQI1XB6Vw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXtLkvErw1TdUYkzw39Iun9AdMg0AJKLIHrK9lJsbvvw&oe=6AF71FC2"}, {"file_name": "historyExperienceRoma_04.png", "id": "4499896230332367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_4499896233665700_2743215651652370476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxlSJ9aUfbYQ7kNvwGRlCtJ&_nc_oc=AdqoFog9eboiJjD1diVMmcXOKJ2HokPOuDb3L4KQpas1z7VreQW49irN-2SA6_sEB7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2mv9qUtKRSqRFUuDI-mhJJkFXEnX4UnpEL3Qe4cg0xA&oe=6AF734CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "historyExperienceRoma_Miniatura.png", "id": "26595436650150151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_26595436660150150_3570176259270798429_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5nV7rxUYDMQ7kNvwFMlTJ_&_nc_oc=AdpnLYQN6y9Kw3wY9rT_GDOvLzrKz5JWKGE_u0T6aa3GtsKuJC3-TzJWue7nju16ltA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhsIpVnbqJzo42QA3j0fVTdRiBx86BpxHEPYxYUFApBA&oe=6AF73783"}, "display_name": "History Experience: Roma", "keywords": [], "long_description": "Explora la vida cotidiana en la Roma hist\u00f3rica con un nivel de detalle y realismo impresionante. Gracias a gr\u00e1ficos de \u00faltima generaci\u00f3n, cada espacio ha sido recreado con fidelidad, desde la arquitectura cl\u00e1sica de una domus romana hasta la atm\u00f3sfera marcial de un castrum.\n\nLa aplicaci\u00f3n ofrece dos modos de experiencia para adaptarse a todo tipo de usuarios:\n\n\ud83d\udd39 Modo Tour\n Recorre la Roma antigua siguiendo una ruta cuidadosamente dise\u00f1ada. A medida que avanzas, audios explicativos te acompa\u00f1an y narran la historia, la funci\u00f3n social y la vida diaria en espacios representativos como un templo o una tabernae, convirtiendo la visita en una experiencia educativa y envolvente, ideal para aprender y dejarte llevar por la historia.\n\n\ud83d\udd39 Modo Libre\nExplora sin l\u00edmites. Mu\u00e9vete libremente por los escenarios, detente donde quieras y descubre cada rinc\u00f3n a tu propio ritmo. Este modo est\u00e1 pensado para quienes quieren disfrutar del entorno, observar los detalles arquitect\u00f3nicos o simplemente perderse en la belleza del lugar.\n\nYa sea como herramienta educativa, visita cultural o experiencia inmersiva, esta app transforma la Roma antigua en un viaje interactivo en el tiempo, accesible desde cualquier lugar del mundo.\n\nUna forma \u00fanica de descubrir la vida diaria en una de las civilizaciones m\u00e1s influyentes de la historia, combinando tecnolog\u00eda, cultura y emoci\u00f3n en una experiencia VR inolvidable.\n", "short_description": "Explora la vida cotidiana en la Roma hist\u00f3rica con un nivel de detalle y realismo impresionante. Gracias a gr\u00e1ficos de \u00faltima generaci\u00f3n, cada espacio ha sido recreado con fidelidad, desde la arquitectura cl\u00e1sica de una domus romana hasta la atm\u00f3sfera marcial de un castrum."}, {"images": {"nodes": [{"file_name": "historyExperienceRoma_Icono.png", "id": "2857530227919558", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827585_2857530231252891_6142932716299513273_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2J8c7-qpLTAQ7kNvwErYqDd&_nc_oc=AdrCVeF0m5Pyy03-nJjWgPXB8d9I_aynBc8wCwcp3dc3g0DPil4u6sZVwJQPF3G91sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKv3l5nVf2frAT1ULIIeQHyP8ntiBiYxtz1k8eBvDVdA&oe=6AF74930"}, {"file_name": "historyExperienceRoma_MiniaturaCuadrado.png", "id": "2081603882453998", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619594_2081603885787331_8781477275917702722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKnVfDvdHqsQ7kNvwGJcJYc&_nc_oc=AdrRow3YhQLU46qMW5SNoFxhJJk5hsLl16PdtodbheZLOXadL5zAHzy8loqXOChWSBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-rRN_RX1yvLWq3z-VEbnX2-rNo_HDCzEb0wC_G1ohwQ&oe=6AF71D49"}, {"file_name": "historyExperienceRoma_PortadaVertical.png", "id": "1546836493714600", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1546836497047933_4863072208925606280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLyV2Qp7KpwQ7kNvwHXRwUW&_nc_oc=Adr9xJ7Y5cV40IKNQjC5O7RXyxEJyFIFSIaZF7228IYLCJbwzUDsN0YnUDUOriCbjQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP8RnU2gv-8v9njIxeJAxQhjKHVEO5Ed8ljcoIeYHmOw&oe=6AF742C8"}, {"file_name": "historyExperienceRoma_Portada.png", "id": "1492162008954369", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_1492162012287702_5993034504400450669_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmtYeJ8Kf-kQ7kNvwHQITyu&_nc_oc=AdrbxqNHG7YEpEJsnBqGTF8cBa6xh9dGWjsp5GLL_KnpG2TElmrf5joK-WlO3nik3Jo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJye6Tjl5KyI-Nz8RfT5tS3p9meS8AV2js2cROQWJj2g&oe=6AF721E0"}, {"file_name": "historyExperienceRoma_Miniatura.png", "id": "1008427001563759", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_1008427004897092_7973086351349103
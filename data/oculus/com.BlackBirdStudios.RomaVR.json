&_nc_oc=AdqkCGFoIKC3rfMGpwHDLp6E1T0VsxrgucmyJ0G0qH-RwlC9kE_zkX0NFtbfO0k6uNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXe6i6x1U5tX_zwRark9XenF3Nvbp2u1r29f-K5yZgBg&oe=6AF73170"}, {"file_name": "historyExperienceRoma_02.png", "id": "1557823092853975", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_1557823106187307_6527559360322754438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIAFlMN6--gQ7kNvwEqBfCZ&_nc_oc=AdqpT3zDy_y4uponH_4LfTJrGzJzs3JxDie0_sO2ARlWqr1PDy9iBsxBigL-iZZVVmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr-XHAwoSopL1jVujXWj_EjcHfYOV_4u-Ouyb8wfdDow&oe=6AF73806"}, {"file_name": "historyExperienceRoma_01.png", "id": "1667048527753959", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819859_1667048531087292_2023966725262490691_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNUCYsPk0rMQ7kNvwG2IOML&_nc_oc=AdqOxTjcaXUZ2OtpWbbV8CK4yzCvVTjH6tuhCXOEqxdQsVV9tq7S0DabVWmGDPg20bo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVsLuqcJDTRXa_xS-qEcZxNR9pZ3gR4SPZn3BwVkbiQg&oe=6AF731E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "historyExperienceRoma_Miniatura.png", "id": "921086330997044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_921086334330377_4126677225788272490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgdGvmcZO9QQ7kNvwH7fAiH&_nc_oc=AdrEMzSx-oBC8pgLo9-IdwZN3k6trI9UoClIYIO_Ds5ZOjMFBDOXtwox8hOl3n0eAjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE1MA49co47myE5jAVRruTjjlhUC0o-L8wv_Iy4YScEw&oe=6AF739F4"}, "display_name": "History Experience: Roma", "keywords": [], "long_description": "Explore the daily life of historical Rome with an impressive level of detail and realism. Thanks to next-generation graphics, each space has been faithfully recreated, from the classical architecture of a Roman domus to the martial atmosphere of a castrum.\n\nThe application offers two experience modes to suit all types of users:\n\n\ud83d\udd39 Tour Mode\n Explore ancient Rome following a carefully designed route. As you move forward, audio guides accompany you and narrate the history, social function, and daily life in representative spaces such as a temple or a tabernae, turning the visit into an educational and immersive experience, ideal for learning and becoming fully absorbed in history.\n\n\ud83d\udd39 Free Mode\n Explore without limits. Move freely through the environments, stop wherever you like, and discover every corner at your own pace. This mode is designed for those who want to enjoy the surroundings, observe architectural details, or simply get lost in the beauty of the setting.\n\nWhether as an educational tool, a cultural visit, or an immersive experience, this app transforms ancient Rome into an interactive journey through time, accessible from anywhere in the world.\n\nA unique way to discover daily life in one of the most influential civilizations in history, combining technology, culture, and emotion in an unforgettable VR experience.\n", "short_description": "Explore the daily life of historical Rome with an impressive level of detail and realism. Thanks to next-generation graphics, each space has been faithfully recreated, from the classical architecture of a Roman domus to the martial atmosphere of a castrum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackbirdstudios-es.github.io/BlackBirdStudios-Privaty-Policy-Roma/", "developer_terms_of_service_url": null, "publisher_name": "BlackBird Studios SL", "support_website_url": null, "website_url": "https://history-experience.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
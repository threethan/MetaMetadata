t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVdi3oPi9nN24gPnqdLp6xyBKaniUt3dMjVUU3EC6uEQ&oe=6A4E47BA"}, {"file_name": "4.png", "id": "1302701944574064", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499297170_1302701947907397_817510389711185874_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TmrQaicvesQ7kNvwH77q6V&_nc_oc=AdqyXPg0sV5jH6zMknrkZENTmuEHpPF5qjpV9FDL3a0aZ8RjvRYYBnVOMrbihwODA7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOefvkvrVKguPKJYa70F32STYk-47qz1m57S6AgybeOQ&oe=6A4E623B"}, {"file_name": "2.png", "id": "771096758662185", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296157_771096761995518_1818502162458001092_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXfFvSbvGU4Q7kNvwGP9DCG&_nc_oc=Ado0x99HNSAAul_SNHPw2zcE5GMd5c3fgDzDFuFKL9TeRme7kl03faU2Y6rlmIc0moE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmqj8P8dl5aQHfP5CNfo4Dg5EXFGysYaqtio1bCQPzCQ&oe=6A4E403A"}, {"file_name": "1.png", "id": "547096868429256", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304084_547096871762589_2950998219767811738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEyic79Jtt4Q7kNvwELDtyD&_nc_oc=AdrJLHh4ik0peRwZ3BB54clMzsuCAYo06amaVm5WY3c0unrcOrvM7AHGHakwZ0MTJQc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZLIoL0_25-WhQR3qKvy8eLCBkjaerzVCcuXhN7B6-HA&oe=6A4E5AC3"}, {"file_name": "5.png", "id": "1264363535164634", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296157_1264363538497967_7305160351951501357_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhEKRKSvMXcQ7kNvwGHWNL7&_nc_oc=Adq4NGLNwSKxsNBILtyyOeJrzIrSzZrnvU3Dlr2uyQctkTsKbFt4v-1SA3LxqFD9x74&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7ggd227jwGrO17w_-xei3qZ5w9Qkl5IGMvekXV1rVDw&oe=6A4E3ABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2K key art.png", "id": "4240303539549833", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499311572_4240303542883166_7216181366772819640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ub40GuZ1sYQ7kNvwEZ48Wb&_nc_oc=Adr_hZsYMAsF3D4DZK7uC0-ih8XK5yoFXdiwAkdkdED_RKj2VIO5ndrWHfG7WE_8kuM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaRj9UjqZ4THq-FXavnAdhm_6zWJOOmB2gmaPg1udM0w&oe=6A4E430B"}, "display_name": "Birdseed", "keywords": ["cozy", "photography", "relaxing"], "long_description": "**Is it a bird? A plane?! It\u2019s a bird. A really, really cute one though.**\n\nImmortalize the chunkiest, cutest birds you\u2019ve ever seen with Birdseed\u2019s in-game camera, meant to feel just like you\u2019re holding the real thing. Aim, shoot, print and record the birds you\u2019ve found in your Journal and work on getting that 5 star shot! Binoculars help you zero in on your subject and plan the right lens for the shot - just like a real birdwatcher.\n\n**Get cozy and enjoy the immersive sounds of the forest around you.**\n\nThe birds and bird sounds of Birdseed are all based on their real life counterparts. Step into a cozy forest setting and let the nature sounds wrap you up in a warm hug!\n\n**Bird watching is better spent with some friends!**\n\nWish you could share that perfect shot with your friends? The social multiplayer in Birdseed is designed for maximum coziness - share photos, track your best scores, and chat while you enjoy the simple act of birdwatching together.\n\nFeatures:\n- Cozy social multiplayer - play online with a friend, share photos, and enjoy nature together\n- Take on daily quests - check your Journal every day for new missions to embark on\n- Get the perfect shot - track your shots in your Journal and aim for higher star ratings \n- Immerse yourself in nature - enjoy spatial audio design that transports you into the forest, with unique bird calls for each bird you spot\n- Suitable for seated play - even this VR experience is cozy!\n", "short_description": "Snap pics of the chunkiest, cutest birds in VR! Relax in lush forests, complete quirky daily quests, and fill your Journal. Whether you\u2019re birding alone or together with friends, get cozy and escape to nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.buffalobuffalo.ca/privacy", "developer_terms_of_service_url": null, "publisher_name": "Buffalo Buffalo", "support_website_url": null, "website_url": "https://www.buffalobuffalo.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24119488501079224"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1315617433251172"}]}, "baseline_offer": {"id": "1315617433251172"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759291200, "status": "PUBLISHED", "id": "1315617433251172"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27054319817596063", "version": "1.0.3.1"}, "id": "715353181184327", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9304462806341704", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27054319817596063"}, "release_status": "RELEASED"},
HruwGA8wbtkNswg0bHppB8QVvUAGkYvMGEHbNc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwumgBpC3IATcNHkIADPbf0CVGjzat4xnhi4TTDbdbeQ&oe=6A4E4EA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2K key art.png", "id": "4240303539549833", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499311572_4240303542883166_7216181366772819640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ub40GuZ1sYQ7kNvwEZ48Wb&_nc_oc=Adr_hZsYMAsF3D4DZK7uC0-ih8XK5yoFXdiwAkdkdED_RKj2VIO5ndrWHfG7WE_8kuM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaRj9UjqZ4THq-FXavnAdhm_6zWJOOmB2gmaPg1udM0w&oe=6A4E430B"}, "display_name": "Birdseed", "keywords": ["cozy", "photography", "relaxing"], "long_description": "Immortalize the chunkiest, cutest birds you\u2019ve ever seen with Birdseed\u2019s in-game camera, meant to feel just like you\u2019re holding the real thing. **Aim, shoot, print and record** the birds you\u2019ve found in your Journal and work on getting that perfect 3 star shot!\n\n{1440601943686782}\n\nThe birds and bird sounds of Birdseed are all based on their real life counterparts. Step into a **cozy forest setting** and let the nature sounds wrap you up in a warm hug!\n\n{828994926477646}\n\nWish you could share that perfect shot with your friends? The **social multiplayer** in Birdseed is designed for maximum coziness - share photos, track your best scores, and chat while you enjoy the simple act of birdwatching together.\n\n{1855705815139740}\n\n**Features**\n- **Cozy social multiplayer** - play online with friends, share photos, and enjoy nature together\n- **Take on daily quests** - check your Journal every day for new missions to embark on\n- **Get the perfect shot** - track your shots in your Journal and aim for higher star ratings\n- **Immerse yourself in nature** - enjoy spatial audio design that transports you into the forest, with unique bird calls for each bird you spot\n- **Suitable for seated play** - even this VR experience is cozy! No need to move around - get the perfect shot even from the comfort of your couch\n\n\n\"Birdseed has been a lovely experience that will surely only become more endearing\" - UploadVR, Early Access Review\n\n{1568729621156336}\n\n", "short_description": "Snap pics of the chunkiest, cutest birds in VR! Relax in lush forests, complete quirky daily quests, and fill your Journal. Whether you\u2019re birding alone or together with friends, get cozy and escape to nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.buffalobuffalo.ca/privacy", "developer_terms_of_service_url": null, "publisher_name": "Buffalo Buffalo", "support_website_url": null, "website_url": "https://www.buffalobuffalo.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27018865497808162"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619450_1022538060286390_1944693864036250208_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tf4eHvStoMMQ7kNvwFsoz9W&_nc_oc=Adq7RONKOgy-GgUXYWAh9wYag7O-pXD6YyMV08idUBCLjqJglx6rm70Pr_ta6pXAFmw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2w6uD7Y27OO5mqeMWGQzff9nakxrCz2weIpudKRe1ow&oe=6A4E60E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid"
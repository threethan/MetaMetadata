e": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_905639165624180_744396841853348917_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLmpt7GUHMQ7kNvwFjsGF4&_nc_oc=AdrcGhrzyD0WbBLayTCqa9yc9QTrU1dRzKkTUjrXxSPcAn2bOSspR_8_oxDVssLLB5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C_olw7uTEtxJLmSNPe1lp0u8olBa_NnAFOKjuDe-AKQ&oe=69DF9292"}]}, "id": "909930408345980", "locale": "en_US", "screenshots": [{"file_name": "NC_Screenshot_1.png", "id": "1621883575778368", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1621883579111701_5366238070273630236_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83ePLn4wqIAQ7kNvwFOERvN&_nc_oc=AdqyR-fn1SXf8Q4_x89LSggFr8FDRQheAKMUDtzF8LBJ_zYPAQDN6d-S9fviJtqv7Fw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BRPFDJsGtGJ7bRE3Ol4tGsI_9g_zr_Rw2QolViKwi9Q&oe=69DF9F69"}, {"file_name": "NC_Screenshot_2.png", "id": "1460665905712434", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_1460665909045767_1112714324381987893_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SDaXk5lu0MQ7kNvwG9VhDE&_nc_oc=AdrKoDt-1TUwtc6nn9Jv2lYq9R7G1P3t7R7naz7tnOYJ-n759OPhyFWFsenJJlemHd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27hw6tld0Wz_Fc9aSzA0DvRBerA51sL67emRzXhJuI6g&oe=69DF8A3E"}, {"file_name": "NC_Screenshot_3.png", "id": "1577247693574645", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1577247696907978_3679538576006574794_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTcZcbeJ4woQ7kNvwFQ2Vo7&_nc_oc=AdpdbNK60Yj1NithZqi861LBbhyze-7HZQ8lqSgV8YvihAUnzt9vyZyTl0jHhL-PuuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mWwxmu83Ye83zW7toFXY49RNRkk_FaEEn4TxVM02-sQ&oe=69DF8024"}, {"file_name": "NC_Screenshot_4.png", "id": "1472623307987166", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827601_1472623311320499_6730857519883046892_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBsLZj8aTN0Q7kNvwHWsaUz&_nc_oc=AdokHxeJnhXK6vfFqtbcG98AxjrOXwdquVsdtx_nOVKTaP7CNotwZGxFzAMgEYk5g84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-lTOwvczK0tckZ7wFb2uzRJMPZYh7za1yCAQt0vk8GQ&oe=69DF73A8"}, {"file_name": "NC_Screenshot_5.png", "id": "2077180292854992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_2077180296188325_1541835177238961221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwiiQxqs02sQ7kNvwEARHby&_nc_oc=Ado_9oOWGahzQ8ZBaBTKxxPkqlziFWImYrOMeJPiewELPlWQuZ_5T3X7HM1elblSaRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xRbGQ7aZQ2-oxmGHp8KrSvj86GRAPVf4eKYazz6mv-A&oe=69DF8338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NexusCalibration_MetaXR_SystemSplash.png", "id": "912975087886289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821704_912975091219622_2607471327440046147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhjG97hiM8cQ7kNvwG2-hN7&_nc_oc=AdoNryihdUqwDfHIHaIHCDSJ973lVr006QzNBkpH_424jvmzXbzncrtD0rA8PIpRvWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hMqpZmfT4rbGJ2-qhkTLWH1t5LdX1oJch_fiiZQ9QJQ&oe=69DF9AD4"}, "display_name": "Nexus Calibration", "keywords": ["shooter", "scifi", "action", "score", "arcade"], "long_description": "A solo-developed sci-fi wave shooter for Meta Quest. Laser Handgun in one hand, holo-shield in the other. Fight drone waves. Chase the score.\n\n# Handgun\n- **Skill venting** \u2014 gun overheats instead of reloading. Flick it at the right moment to cool fast.\n- **Canting** \u2014 holding the gun non tilted builds heat faster. Aim properly.\n- **Amplify** \u2014 aim behind your own shield to boost your damage. Costs shield health. Worth it.\n\n# Shield\n- **Glancing deflection** \u2014 keep it moving, shots glance off harmlessly.\n- **Kinetic cushioning** \u2014 pull against  an incoming shot to absorb impact.\n- **Parry & reflect** \u2014 swing fast and face it right \u2014 projectiles fire back at enemies.\n- **Vulnerable state** \u2014 Amplify leaves the shield exposed. Incoming hits land harder.\n\n# Dodge\nPhysically dodge with your body.  Get close. Stay mobile.\n\n# Score\n- **Style Rank (D \u2192 S)** \u2014 decays over time. Reflects and dodges push it up. Damage drops it.\n- **Combo Multiplier (\u00d71 \u2192 \u00d75)** \u2014 stack it. Every hit multiplies.\n- **Distance scaling** \u2014 closer enemies are worth more.\n\n# Early Access v0.5 \u2014 3 levels \u00b7 3 difficulties \u00b7 3 loadouts\nPlay the build, push the mechanics to the breaking point, and leave your raw feedback in the reviews. Your input will directly dictate the development roadmap and the future of the game!\n\nMake sure to join the Discord server!\nhttps://discord.com/invite/fra3CwHyx8", "short_description": "A skill-based sci-fi VR shooter built for score chasing, precision, and physical combat. Use a handgun and holo-shield to destroy drones, hit weakpoints, reflect projectiles, vent heat, dodge attacks, master advanced mechanics, and climb the leaderboard in this Early Access release."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexus-calibration.netlify.app/privacy", "developer_terms_of_service_url": "https://nexus-calibration.netlify.app/terms", "publisher_name": "Arigrad", "support_website_url": "https://nexus-calibration.netlify.app/support", "website_url": "https://nexus-calibration.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
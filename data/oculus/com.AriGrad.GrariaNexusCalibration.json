859178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_889782137192511_3208280521748122547_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWQaESnAg5UQ7kNvwHdz1PL&_nc_oc=Adr3aToKUVWBNGBmkT-uUkS8jE7GCcILKAUrTecbIeRodtsS4uEICCw_z__UnYVo8Jg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EZwOz0ZGR72brAH_mRM6HXsjVyAQtkzZQutNL-q4R_Q&oe=69DF93D1"}, {"file_name": "NC_Screenshot_5.png", "id": "2124537351674027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_2124537355007360_5343553262709774232_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGWkTmpMgFwQ7kNvwEA-6VI&_nc_oc=AdoSLyVok7WXzY-e12qfWMAVVhSjEav_bIE7cMrNSdtmko9M9eayMkl0rBBvqaBTSyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AYH8UPd7WXs3XPEI00GhcD2GrKpCfHSAmJpLASJp11Q&oe=69DF938A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NexusCalibration_MetaXR_SystemSplash.png", "id": "912975087886289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821704_912975091219622_2607471327440046147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhjG97hiM8cQ7kNvwG2-hN7&_nc_oc=AdoNryihdUqwDfHIHaIHCDSJ973lVr006QzNBkpH_424jvmzXbzncrtD0rA8PIpRvWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hMqpZmfT4rbGJ2-qhkTLWH1t5LdX1oJch_fiiZQ9QJQ&oe=69DF9AD4"}, "display_name": "Nexus Calibration", "keywords": ["shooter", "tactical", "scifi", "drones", "action"], "long_description": "The mainframe is compromised, and you are the ultimate countermeasure. Welcome to NEXUS CALIBRATION, a physical VR shooter where your body is your best weapon. Set in a high-contrast metallic world, you must eradicate a rogue drone network.\n\nSurvival isn't enough; perfection is required. Our unique scoring system demands extreme accuracy. \n\nPhysical Combat Mastery:\n\nSnap your wrist downward to cool your weapon instantly.\n\nPunch your shield forward to parry incoming fire.\n\nPhysically grab your gun hand to eliminate recoil for sniper-like precision.\n\nEarly Access Protocol:\nWe are launching this polished Vertical Slice to validate our precision-based gameplay loop. This initial deployment includes:\n\n1 fully polished environment\n3 active difficulty settings to test your reflexes.\n\nYour Mission:\nPlay the game and provide vital feedback to help us  shape the game's future. Join the calibration process and help shape the roadmap!", "short_description": "Welcome to NEXUS CALIBRATION, an Early Access VR tactical shooter where precision is everything. Step into the physical Armory, grab your gear, and face off against relentless robotic drones. Master physical mechanics like wrist-flick weapon cooling, shield parrying, and braced aiming. Help us shape the ultimate VR combat experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexus-calibration.netlify.app/privacy", "developer_terms_of_service_url": "https://nexus-calibration.netlify.app/terms", "publisher_name": "Arigrad", "support_website_url": "https://nexus-calibration.netlify.app/support", "website_url": "https://nexus-calibration.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25875734145388955"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHE
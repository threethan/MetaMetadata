-7&_nc_sid=6e7a0a&_nc_ohc=DxHkFNOIeS8Q7kNvwHVDMGS&_nc_oc=AdpQPKeLJQR4XikDmXR8lL6txi-Ws7O7FBQCQ1xCCNKuEVNzfa_r-jRBjmEA3Gr2wsc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YMRQZYU4WVNruJcdE1DHUTYG1JQVeH-CLZQh3dEb2IA&oe=6A15B968"}, {"file_name": "NC_Screenshot_5.png", "id": "2077180292854992", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_2077180296188325_1541835177238961221_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPathkV7Lc8Q7kNvwFquoix&_nc_oc=Adp7wj-p6Q1URh7CWJ3f6yihBA9-SeIQN5wZhv83kaq1M4MOMwBY9go5jakpbNMhdKY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IBPvGzzXyxrgTKUJ2CtIBVYMPCMK1kdjTmcjk2MOV5g&oe=6A1590B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NexusCalibration_MetaXR_SystemSplash.png", "id": "912975087886289", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821704_912975091219622_2607471327440046147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHX3c4mczHwQ7kNvwEm0Wis&_nc_oc=Adokb6Glshaa4SeXbmab3qpZj4qKLt5LBjUbMJeUQ3W1SjCaYZuTiZxiL8lYEAVX0is&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nnw2Ag6ACBejIzPrmWqn_Qps9KZlRN_CK_H86c9S7aQ&oe=6A15A854"}, "display_name": "Nexus Calibration", "keywords": ["shooter", "scifi", "action", "score", "arcade"], "long_description": "A solo-developed sci-fi wave shooter for Meta Quest. Laser Handgun in one hand, holo-shield in the other. Fight drone waves. Chase the score.\n\n# Handgun\n- **Skill venting** \u2014 gun overheats instead of reloading. Flick it at the right moment to cool fast.\n- **Canting** \u2014 holding the gun non tilted builds heat faster. Aim properly.\n- **Amplify** \u2014 aim behind your own shield to boost your damage. Costs shield health. Worth it.\n\n# Shield\n- **Glancing deflection** \u2014 keep it moving, shots glance off harmlessly.\n- **Kinetic cushioning** \u2014 pull against  an incoming shot to absorb impact.\n- **Parry & reflect** \u2014 swing fast and face it right \u2014 projectiles fire back at enemies.\n- **Vulnerable state** \u2014 Amplify leaves the shield exposed. Incoming hits land harder.\n\n# Dodge\nPhysically dodge with your body.  Get close. Stay mobile.\n\n# Score\n- **Style Rank (D \u2192 S)** \u2014 decays over time. Reflects and dodges push it up. Damage drops it.\n- **Combo Multiplier (\u00d71 \u2192 \u00d75)** \u2014 stack it. Every hit multiplies.\n- **Distance scaling** \u2014 closer enemies are worth more.\n\n# Early Access v0.5 \u2014 3 levels \u00b7 3 difficulties \u00b7 3 loadouts\nPlay the build, push the mechanics to the breaking point, and leave your raw feedback in the reviews. Your input will directly dictate the development roadmap and the future of the game!\n\nMake sure to join the Discord server!\nhttps://discord.com/invite/fra3CwHyx8", "short_description": "A skill-based sci-fi VR shooter built for score chasing, precision, and physical combat. Use a handgun and holo-shield to destroy drones, hit weakpoints, reflect projectiles, vent heat, dodge attacks, master advanced mechanics, and climb the leaderboard in this Early Access release."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexus-calibration.netlify.app/privacy", "developer_terms_of_service_url": "https://nexus-calibration.netlify.app/terms", "publisher_name": "Arigrad", "support_website_url": "https://nexus-calibration.netlify.app/support", "website_url": "https://nexus-calibration.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
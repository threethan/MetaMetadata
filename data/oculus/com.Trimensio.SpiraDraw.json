_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO_8fj74NnsQ7kNvwFG00Ip&_nc_oc=Adrqkg8sEKDDIVZJ_8SgsW0DfKt14P7OpU4uIuZFUARkhJKSwM9M6sIej0r7A6yZGuw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bO-9tlrfybUW9A7ePonrowWmm0Ali0f78yuknCKy3KQ&oe=6A2184C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXdKLePuagMQ7kNvwGDeX2Y&_nc_oc=Adpce-8G_CIBdXi8PkPks9OZQ7P59vVGVSc-ZQC7SB_XvDB26_gfJcxV4BGds24xv34&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qfDl6nZRgBowWYPssnvvfBCy79lKfYo4J63WUrnjrxA&oe=6A218812"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwCClBE73uMQ7kNvwFeUQVu&_nc_oc=Adp57K2UWdEjpD3sRYmENPBSBgbCLd8tJXfSlJenE1RFqQnzw4TqJ3dDX_QEByEp_vY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sTLD40PI2A59dh56-Fw8TdL-gmglIftVPLNay7g-E5w&oe=6A21726C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkFNW51ssuMQ7kNvwEirgH9&_nc_oc=AdqSjTq71U65p3ZVCdoBAUsxI3Iv_Ink4-Wpjm6j0YI0oTqLfmOEfNYyeumO1-vKPZ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v2f1EydDSpeB2uAeIVSwpAuzor4cVBvfhEGioY6PrBQ&oe=6A219BD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB7qfoGD8-0Q7kNvwF7AkEn&_nc_oc=AdrxjMkj1m0URDs8sG8vrTWIbOjDZ3aQ9lUM5AlLTb7lZC3Zta2zlURsMHzY-FIaVso&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hZK6hQ9PdZTYmuGVy4uvv4NpQ08bINnhSdg7uLk6N5g&oe=6A218CEC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGILKYwu0lYQ7kNvwFdZVhH&_nc_oc=AdobD06cKwTDGxwYek9_i8dW0mIbJ6veiOQlfzK_eTTIv98_uiy-yv2Js56NH-lPX1w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t09m1c6xNRjGDR-MKRCTuztrBCthUVv2332rH4GXEJQ&oe=6A4128C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ean29TLpgC8Q7kNvwF4TzHV&_nc_oc=AdrbFaOJyJOItGY389s4DCXD39ouByIjJVzmob2REtayWEUt3UUL3se6mPWwFk7g_64&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Snv6SpNaxuSsYJJhXcLpPn4yFseJt9ostWelGGgcddA&oe=6A412C12"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWAm5-J7v5UQ7kNvwHiWKxo&_nc_oc=AdrqbG-3opd7A5Y85XVHG8GrfCswqklkEPaH07CPDvRTx_o7sCkjIXy2P2EpvzjLrag&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k_NapV4s9pxYOKtgd68-2YfG4bSWt5lgtdLObrpJbZw&oe=6A41166C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG3gfZ980PAQ7kNvwFOI0Qx&_nc_oc=AdpvMbM7lksnyigsugOjjqz0scxxvxE_dhfTNdlMndqb9WA5OuPCi7mUT2I4nkLe9rU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Al-q89ICXSMBlQ-mwrA-pGlwaM5We1FW-UGymzLvh6A&oe=6A413FD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHNrwLjjnZAQ7kNvwFDst6A&_nc_oc=Adr77qz7W7JLgKAviJ8yOMDgF90Ga7Od_hKTN2j5oeu9mAMvfb41blw_5NiLztq-28c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zmT6IrFVHwUTo7vJwfYz7wLW8iSXdnu5S8XECBnSIVg&oe=6A4130EC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtZcP1LIXqcQ7kNvwFyKjMB&_nc_oc=Adr1l2y57IxzSutn4tbiVsv6ll-fjR7ot163lsIZQcZuXkRVX0fcR_1SA2H91fXwJ4w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S0rPaVNCe7GHzgPhXPbGvb1vsSizR2Cl9EhfIe_zTIw&oe=6A106148"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQiOAk2sj94Q7kNvwF5nqpB&_nc_oc=Adp4xCk4P7FJXjNYUme5IRCQv9OvAfczXHtoHYht2nB99oG2mEelCg58v-E9InFA4R8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pgl3g87LLlx2Df1nlUj42YsQ77pujDco7gm9bouHdrg&oe=6A106492"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TUMaw4Fk6wQ7kNvwHs-Vgg&_nc_oc=AdrmIxdFHT97shFjiXmvK5iPVc69ZtYs4UfyKPZp8BCxPB_KwPzoB0vvZCr6VY1nw0Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X8IvX8OiEO_MTaq2pmv6WIqX5Q_bs9D5HJJla-jA8cQ&oe=6A104EEC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4zwWfDuf8kQ7kNvwHI8_Wh&_nc_oc=AdrZfnbKRJa7aO4qteSwFq4vRx5mNAnY7SQhNsThX9RdmFkTUlBdq-BGsbciA9kAVPE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Jl5oXJQWWntsBjISrdvFdbdtMtHUqT0D0dVXw3yi6Lg&oe=6A107854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbJgAEDDRVYQ7kNvwG75uzx&_nc_oc=Adr8LLHAIUJfjOf3ycmqrP3SGq-Brc6Jl3nuHZBfjAp6OKyWxOkIpZbk5-3tRM8PvJ0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fdUmAf6lVy0TK6MoR5yrKUzRLHZzgoXSbHT4gVqwNsg&oe=6A10696C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
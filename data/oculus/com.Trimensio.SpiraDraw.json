uscdn.com&oh=00_Af1huFoQz9mB4OFOPtiue-POs3z-jOJZYnJsd9C-v2cn-g&oe=69F0C092"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAd85VKrzl0Q7kNvwEJcmOp&_nc_oc=Adr8-K9L6dc20edP0usCaYoha6kb4vHe9wwism8z_2iwrDWglP0d00RObvgog6myJt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3nTMxkRQknxHX84dQcql9ngB2eMFNYYgfk75Vu3Yk50Q&oe=69F0AAEC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1vOrR0ScvcQ7kNvwGoyF1e&_nc_oc=AdrPoISFKxqXoz2hPGHzLi-K3SZFceQH29CgAjDpBhdPkG33d4bWmzPhZiXS4ndvQXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0LcNzFMYIo2SXqwsoY0JABfly1gSelr4KLGaxmq9Cf9w&oe=69F09C14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4plTBZaWfYQ7kNvwHZQUzx&_nc_oc=AdpEq_IOwfDovUSCNlvnN_rpY9SX5AzWe1bj2vdehmDWQiGUCcBaDrqq87Xa0JbByNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0r3QgoLJcZZ-EsnUO3FLDkD_th-s2pAJsWuP5uCW_HsA&oe=69F0C56C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26366875609641263"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_1297829629112091_929297648610956424_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pP0_ECikXAQ7kNvwHylNdB&_nc_oc=AdphUy3F
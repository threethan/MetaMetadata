_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rddLP-nQqwQQ7kNvwEGKw1X&_nc_oc=Adqh8Eu8qSOTWlnnZsjyyYo7usmXwugRx70qxMPmDO3LsXuBkGyzvne05AZj4u3cGeY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jTzlX-sqVb4vu-nzqPqe50lCZdhHmIncdGTV240HTPg&oe=6A1C3EC8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UunIJrcddHQQ7kNvwGF2RqO&_nc_oc=Adr_6PIU_HQsJJFApzUd1OskBs6bsMCxlXpd-__gNDBI_jmcgZm1UthU9drC62nDBO4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xb7njft8qkzQrCB340Tf-rhEhPbWlRp5q2EPgWT3MCw&oe=6A1C4212"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD1HwaN_ywEQ7kNvwHmqmGu&_nc_oc=AdpQE72ePF0Y4sRRk8QCROqnEGsywZm39mYF5QorW2__Q5ERZLMOeRfefzWC7fbYjvU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sf6Wj_AWdPZGhWqwKkEDbbCriIsM5ojQXDeOkzqxB5A&oe=6A1C2C6C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29zJe7NesbMQ7kNvwE5jwqy&_nc_oc=AdpNfbykTk-czr-u8lZFfMsr4UfPwFJUdV4oXlzaqv32s5pAhJu7Q5tGG33laNA9gr4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WRblTeX4wXxxXJ6F-sqLbPF8jMa3uVqsdN5TkGcqkvw&oe=6A1C55D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6IjAFYTwOIQ7kNvwGrrqdN&_nc_oc=Adq1AXMHzHq__ZQJyXd03LfnLeeJ_sV7Trsb_Si0DmhJ_X8BvGnUQyNSW9tKn4X6Yko&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ubx2Vj3WKhuGRVsU5xx9DHRBconDSXLtpn9hq2g4pBg&oe=6A1C46EC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
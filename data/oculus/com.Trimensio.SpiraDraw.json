0", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824741_986883374417296_9002098493914564230_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIxIt-pcZ04Q7kNvwHEzxjz&_nc_oc=AdrrjeP07LtWnjtx0-fFUl1RwcONhMXSLz6e0x1OB3HGccXRGi_fua7R_ScSIgVDc7w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpL56HieqpQwB9aZ03ms2LAxyvvd4EUOdYffm3DMfDjg&oe=6AAE8B83"}]}, "id": "1807251624033856", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1005967388878616", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823279_1005967395545282_4327035178922328815_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvO4n7qamYEQ7kNvwG0XmRl&_nc_oc=Adrz9RY-3qIfGQYBrhbY0PEbTa6cfMmiRw0U69VdzvwDNiL5QTAtpZoxFMBWkseYxxE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyH0ZRlYxQElGUD1TXaln8_uTJLpRYnqbg7NmKCGHLdw&oe=6AAE7DC3"}, {"file_name": "2.png", "id": "909551425535562", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824741_909551428868895_7367013805662684382_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjWkY75KPeQQ7kNvwE-p6lx&_nc_oc=AdrhTk47m3fO06U1KBTebK__qv_SmpNGCeT01SfZPr1XVZksX9YywFzrWLMKubbW3Fw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSmmZRe20KrCGwEd0f7eae7XQ4w9ZKTt83ALr4I-nK5A&oe=6AAE7FE0"}, {"file_name": "3.png", "id": "1733527704502555", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491825575_1733527707835888_4621695288253998452_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljzi2481bk4Q7kNvwEXbtF2&_nc_oc=AdpJwUuf0-gYnGcLR4TT5eq270cIjJx_ppJaxL2B14mE5bM0W8C0Rq_33DbBe34Oy40&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPZ_UAbp7H0uRSmLurZGChScIC8SMn3kEQwJggFstMFQ&oe=6AAE8A0F"}, {"file_name": "4.png", "id": "1011255411517181", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491825257_1011255414850514_6058744882736677454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bInl3zIvmYQ7kNvwGjtqnM&_nc_oc=AdpdRaqZmoUaF7urv1UXoJdxK5fV2GeLSBbrUXJzk-umBrxCFOn-wuTR6TfoE4mkm8g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPgfBHk3UYGnwzC8mqP8nq-wm-nC2HXFzFd3GFQComdg&oe=6AAEA217"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c98CI00bRcMQ7kNvwHBSsPA&_nc_oc=AdpCJ1phcEv83dvG46Fvq_eRv5TOMPTqzK8Z_nS1SejxmmdIlpu7YXN87I1AyTY2bT8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7E56aXyhXf1YfAf6uvC5RaU5YNDbPGrDwnlj4uKYYOA&oe=6AAE9892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zIRXQrS_msQ7kNvwE3ZkUk&_nc_oc=AdogvG2xwpRI4yFS0pmRIpLbkKhW2hGwrQHOalqos1_Of69wjdPZzHHfPHQvNAyGQpk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlFTkrec5gDbqOn4aK0mk6BDZmVWADa95omuutR0U4mQ&oe=6AAE9D6C"}, "display_name": "Spira: Paint & Color with Fingers!", "keywords": ["paint", "draw", "create", "color", "cozy"], "long_description": "**Spira \u2014 Playful 3D painting, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & color models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D coloring, painting & drawing app for mixed reality, designed to work also with travel mode! \u2708\ufe0f\ud83d\ude85\n\nColor and paint cozy 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28474729728855830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823757_1408553824143714_2581138530884520979_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYGs3rOh61wQ7kNvwF4n2RP&_nc_oc=AdqFHew7AAEUGShgioQWvzd9XYaXGdoqKwSPD3aNf7MUKUKYXbRWh1wjbfB-GcelsNU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUSbwrJn1CTCjUrLKSdXkvzXpKE_q21JgQY8Jlp0XyjQ&oe=6AAE9C7F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "di
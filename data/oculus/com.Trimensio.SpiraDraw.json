_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2McFrE_tK8Q7kNvwE1k7J5&_nc_oc=Adruq8qQTQ1mXyghJpBMU0OsDRW9RchiR-MuSKMd7NNt5JBRpNy-IU4-RTBNm_rWnXs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CUYSqbEClvODs_ax8zWiCWx5cFFb7t-XihfUXzXCCWw&oe=6A1455C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oF0fjn7yBYQ7kNvwF4boQS&_nc_oc=AdpCq-t3Y5IZ4HbjQd05esmE4kE_yc3Z2WC1EhQKqZ14-1QRIUsFB6FePW9rE5tiEb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cR0yR25uvLrgjPmywgmvVglS-Sx_YVJr8kVQ9qxKRLg&oe=6A145912"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FipxO3gNGewQ7kNvwEWkQYR&_nc_oc=Adpkgsia86DDh3odMeSe6og3ukqCqqn9u0M84Vdi9CP6Z-oRstvuizmP9M3DaQEZBRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46FuJr8tZoVdPZk9ghDQbxn1jsMXIr6zBz9IGLjwN86Q&oe=6A14436C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxnkRccb1LUQ7kNvwFpuZDK&_nc_oc=AdqSw8tMpC3aySKoNKn7I4Mbogs4_VQi3XC40yUBwHYV9oi22AoSHyEQAJawtAMWNZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tgkwuYMh1jv7P0C4jgR1jA_R74GnF9ks3y3b7-hhHYQ&oe=6A146CD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTLoluaYUjcQ7kNvwGffgQP&_nc_oc=AdrDuDe2MU2Z0qv_Mj_Kh5DjkUSCLV8pEFt3Fzb6XTpgwiggocLNUXKBi1x94iLP_cE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xb1qYFlQkQM20ZkHkq20EiRaFy35Oxh2FHtWCTNGh3g&oe=6A145DEC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05OceFZoKwwQ7kNvwFbN5Ik&_nc_oc=Ado0cjmRxmF-aZk3ib6XXzdwpxd1oG-1Fr_8SYnVOoUvgBG1t7PqLTsQPs0YBXOt3GY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BsAFboXQ0vxl37A2TsEbRGtbFqwM_lONmFUcEcAsqrg&oe=6A3A9148"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpthOaHZ_RcQ7kNvwFAxOWX&_nc_oc=Adq9TDz53i5QGau1JPQ4Uye3DMyADaT57bX82ZDgcctUcF19CHPHYjdBr_yL9tUPPHc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ik9c7BvxzBT4DE1JJ-a9SZidp6iSTwW4e1kc9YRKbxw&oe=6A3A9492"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_fVsVmmvkEQ7kNvwH7M6l-&_nc_oc=Ado3uDS1bMXkERbXQmmb0sHzIxtof5b2RJBHJ4uF-pGOOZRL-1kiG9bsP6abm131pIM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WrgHALWMi6Wi0cbLBYVkEXtlMgBENIHbQXIOUPCLZUw&oe=6A3AB72C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9DUaKPGNZ0Q7kNvwEioTmi&_nc_oc=AdpR8LzGoHDss2DynlVD37nz6N9wz5srOVmfuISDTfw25k-MIUUWHMYx5K_9sTr3ick&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7BdJq5GrONtiKyT7ySvcOHXM5l8vapmt6n_7StcLf-w&oe=6A3AA854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hghq7c1ENvwQ7kNvwF67p-o&_nc_oc=AdqyI9gTQnuT_dVJLzXTmoG9e1PbRDEUo46vq8TxiByc9S5dzJAsHiFFvDJ7XJxdYsY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JwQzgDvmAEZJh3VbwNuAf9Gxj3nbtVmmSpohXDPwuuQ&oe=6A3A996C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
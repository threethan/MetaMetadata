_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOFYzm4Ue6MQ7kNvwHbrRIe&_nc_oc=AdoWXyEuoJ0Orb1Xexjzl-kEnYgqiVpOzLdifJgDSjJJKxmIegRbuxp8EgoXuaoUUdg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpPJB0-jCNl5-QtwLnLqxCPyE-_Nh04mRXBYMBdhJiYg&oe=6A8070C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4jqGiqLrdAQ7kNvwEHoMqJ&_nc_oc=AdpuxE-bLd9ZyoG7_nOBfcCRC57092G1yB7-8gTadpVEGVlvuLCSIM55zct2keBS6iE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAFpHosF8wODFh6hCH1DhTu9IJLC3x9_ngQdD8zsVPFg&oe=6A803BD2"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww-_9HBnjoAQ7kNvwGk8oET&_nc_oc=AdopNccHny7qwHgB4A46XcupvRzjFYiDKm2zcvHLRYGkveTCc_6fF1P4yUb8mczhp0k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJfj8j_ID9xtCLMzTFwHLWwbRCZWFsLyk9-D3o9W0t9A&oe=6A805E6C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAqXEh8dA1MQ7kNvwFo3j7j&_nc_oc=AdrlJhm-378eGIwB_Ri0fEjW0W8hQouCbFE1vK-2TrbW0MbSKf6UwHYbH_v2bhejkQk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ_HqUtM7DpX1VuHbFYtBP9YZYUxZOeI-VRmfAavKLYA&oe=6A804F94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo1qe_NctfAQ7kNvwHVGBzh&_nc_oc=AdoCi0g8KAgQD9BwHixm9_jMhkmkGq2AoVyEyJXraHir5JAPhPnGgtCtXvIuNws67bk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAIxdovNdk63ia82yA97XIKalV68E6b4uhx_vUsk3yJw&oe=6A8040AC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
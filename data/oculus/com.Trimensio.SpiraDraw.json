_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io5FTe_XztkQ7kNvwG3hqN_&_nc_oc=Adp8DT7i_ks-F4UH8XPtQyRSPnrfobbj8UnSAgWve3vn_y2vKY_Ro44JGl7eW3vnSlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbN4qeouNjZ1ALLqQ8VUIc7CAS0LLdtkfV7n2GFTWNDA&oe=6A7F1F48"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4jqGiqLrdAQ7kNvwFm0_10&_nc_oc=AdrFRFnFyC10LVAUShNyFf4KA-f0Qgmn47zmvEL_1-dzFTCHbmKf3uLpQiutIEitOtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPly7RxL18Dmgy_xBKsSX4VYrWFs-Ri3RvwhJq-6Q8iQ&oe=6A7EEA52"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww-_9HBnjoAQ7kNvwFeg_3q&_nc_oc=Adqr0G6-PNFtRbL8bLj2rJluLY8cK58UiNdjBUDSvvfT9OIva5tcc0ykmz_0UBcBJXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXLSRqzeWkkiu9VK5jLA-I62Y98fDuSOI3f9brxo6diQ&oe=6A7F0CEC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcPUTCFtAbMQ7kNvwEbXQxX&_nc_oc=AdqSUuqc6VcgehVdijwaNhbosnQk5d59g-QQpz0l4TBNjgfN9XsFG4i5In9MSh_OULk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiHIfEX6O8n3MkwFvctarqqJmiTpteSrJg_EkobAQjdA&oe=6A7EFE14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo1qe_NctfAQ7kNvwE9Igfa&_nc_oc=AdqfVgN5Kl1ctnSgcwL8EQL987_8IsT-iLK7VBhBERv7ICC44qE-HuEBqj88F4h463c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6HReSTdIIGSt0SgjrunlNbN-u-csq5inIcNxej65kaw&oe=6A7EEF2C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
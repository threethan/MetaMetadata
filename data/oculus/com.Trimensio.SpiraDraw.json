NvwG5pJYr&_nc_oc=AdovN3q5ItvVns2dOROvcJm39SRHOptZp5hgzStktr9wDONMCLaYHy8tEK5jqyvIhJU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNXMe25B3lg9m5HIyTpFgAKu-FxTp4BQPM1Dnm7yPxzg&oe=6AA95C17"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caad334sOFYQ7kNvwGWQGeb&_nc_oc=AdqVDiYUSSjaYIRSgZGt6WaHi1bwj9lGuIUjCt8KvPi2MTX-_03OmdeFxqOxLxrfw-I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl0iUtlyxIy2lzzM-AXdMft5VMIO13wvA0b11nKpiNcg&oe=6AA95292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kh1fYWC4liIQ7kNvwHElG1h&_nc_oc=AdpDkV9Z2DrB7HoNHW-Om2Kh4z47ofJ-T2LxiXp2zHNEGiWAlss5SXTbcQ-LmrEdl2M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCCq5xsPfdVU_KhcRpPik3SbwPQaE8IZFuqcbtnsFYkg&oe=6AA9576C"}, "display_name": "Spira: Paint & Color with Fingers!", "keywords": ["paint", "draw", "create", "color", "cozy"], "long_description": "**Spira \u2014 Playful 3D painting, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & color models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D coloring, painting & drawing app for mixed reality, designed to work also with travel mode! \u2708\ufe0f\ud83d\ude85\n\nColor and paint cozy 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27868135439515265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824318_1040516825237454_6275376937303799310_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noZpYdTyfoEQ7kNvwH_Srjo&_nc_oc=AdplaCE1t6XKZwrr94Stui6PUMMMr4toM3QW52pkjYqTah67DZQVPliMYUeuyVdyURo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvgVJIHgnwQSJSD2wWi-UlF7yHykSbGs6dL2FedJy3CQ&oe=6AA965EC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
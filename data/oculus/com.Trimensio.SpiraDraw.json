_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi7XeUMpgcAQ7kNvwGziWFH&_nc_oc=Adqu_sQUzjBAr1Aqb7QsGsv7agA4K4xlyF0IqXPKVVp4s6B1BNULuqEJitp4el2MV9c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB8-MhjZahiXj66RHVDWSkY_nfJRKLsejg-ExORMQWPA&oe=6A4A6348"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wGPTe2Ao5QQ7kNvwG_sXlb&_nc_oc=AdqmI6xHJ4ihXihva9TDrI93zuA8WwJ2klBv8boY9JEP6-L0irjib_ve4N97GzYYANI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsOk2s9kWglUVVEywVlB3JgjZt42Dq8KkZXvi2-x6jMg&oe=6A4A6692"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_yW8RPwQkkQ7kNvwHljc2x&_nc_oc=AdqcEYg81YiFsNpwZ_ZKKI6x2pBdZVshHbk0lt__E7Osxtb-QF-1WGChPQ77ULsgguM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtJlbZl0yxHWxdP6kPUs-n2b8l9BncvIlyN08C-xugKA&oe=6A4A50EC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBFRfiXuzCIQ7kNvwEp9UIq&_nc_oc=AdouGlYu1mY6pFg5wUj6-ybCqDfoih1IDM8E5P5gahimr7ZeDYJOmUZkqjsl_At6s6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoqGlQAw0jALTMIMUPaJOD4thYH79UdvCGFcTT8tp18Q&oe=6A4A7A54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lJrrHGjRS0Q7kNvwGQ4tw6&_nc_oc=AdrEDBCD_pK-zZHqbfndv2KV63ziQ-NmQwOk79PYdJ8S7A58X8kUaqFrgpzhDTvTcWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm9FFvneJRpk1fVD5rapEJunIODL3qPFHgD9mFGQJVSA&oe=6A4A6B6C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
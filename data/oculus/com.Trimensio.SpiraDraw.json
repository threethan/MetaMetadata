_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_Bvq-OsKUsQ7kNvwF__82Q&_nc_oc=Adro41auY60NYMzK1hAN_E8nh_5iReG8n7ATn2eFrblOFcPdFF-_fY9vJqUwvWfO_QU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LXL1nU7h88TKAA5_yBdedDycG6zhomzIKrlsL69Xr9Q&oe=6A2EB3C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5MynEm2k1oQ7kNvwF7SYuo&_nc_oc=AdqIRhG68w_Q8eElrEFek8XPSmYNWPytCsUf_APZTY20FgTzYy5gYnL4j2-xjkWahRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LLTkzRL6CHFbD5SaosvP2BTubszyQlzyOtjCt-6e2kw&oe=6A2EB712"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1h2NI7VDlYQ7kNvwHhNTvr&_nc_oc=AdqX4qOCKHEugTFUGatb-AuSwtwB10yVxlBLGmBbbgHmU0zjhcYYtvkaPKeSQACq7eM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EAGosp4kw38hqzm7IVtVUCLfgiuP-AShb5c7VKWwtDg&oe=6A2EA16C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QT2ORCNsLUQ7kNvwHPXdvc&_nc_oc=AdqGjreCSlIYERjb1H6TkxGXArc7cIqWMQqLOp4ds-q1UESHSe5Yx7QBNc50E_OWat0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K_e-kNVcLqQyjnlmQhMNLpHFLmjWXcJf7_7nSt-Mz7w&oe=6A2ECAD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1A_qVrMlHgQ7kNvwGGAHPl&_nc_oc=AdqrUW9cut8k5JzUcu45BmZ8pAIN-cEuZNiTJLMleAxyjWQJ0IfbXh_0xYXKQIV2EUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K8XI9bolrOir-aDRoTT-rE7VU-_uCezJ7C5GgkwhQNA&oe=6A2EBBEC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
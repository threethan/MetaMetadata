_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrUvf1VWI0EQ7kNvwGUQeZC&_nc_oc=Adqv9JKyFvY_1J-3e0umvgDYmmajdTuf9igSWNhsGBr1Og8vrUqoQdSo0LfrZx0AWT0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMiu2WE1CrzZjobk0eZ24Ld7hX-f_yifn5QvHzauEKag&oe=6A5A3548"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yO1Dw0Lm6oQ7kNvwGo7OII&_nc_oc=Adq0jpGBVQVhM0lZ9dBSnt2tO-bBpfwMJEKu0BdR1Ln8iFKhARsfNNx6VoRlFX663_I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB85QRSKzd7eH-vYeNqOfYdm-8P1p5mbuQYo3h1IueOw&oe=6A5A3892"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNg3Ipk31NsQ7kNvwE94d-t&_nc_oc=AdpEM6Ylv7Xncad_XxoET5jVpHqzC7MjJ5ZRCMpaTpnh6rUx8I1uBW_zL7ksatgz63E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR2uW7VSv9ShCk1ksOR6gyvhqatP-lFl5FYkEIGaynSQ&oe=6A5A22EC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQRRld_7GuAQ7kNvwHzOf_m&_nc_oc=Adr9lu_hIqP9CbPg1NlwaRVcl36IMr3hU0JDdzev6n7QPjlLXVW88wO3xBwUITl_i9w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmZSXCOX4Q5dyppUl2SPsa_osaByYNiQSYmglYTneWqw&oe=6A5A1414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCSvpO2BbzgQ7kNvwHXklta&_nc_oc=AdpLp_zRhCxUyIYTGNenjWAQ2CJJKkoKvuFHohBm8ESD3G_jaC8Reu7SoiRPULq8UIY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAo2rt2Nw51omEKgpNNH2ozc_gyuDb0_i0ZYNH2AA_WQ&oe=6A5A3D6C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdJq5T_bZ_4Q7kNvwESFjZO&_nc_oc=AdomRC9TZtjs_RNn0TCLkos6bshgtVI_b0fVxxsukSWNPefR7lJsCdjQ8tVS1qlbl1M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VGFi6AhNyBaVN81nA-pQ850cUwxFic2DiBp-8OOVi7A&oe=6A2C10C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5MynEm2k1oQ7kNvwFqZQoG&_nc_oc=AdqOOol2jczmFehDjHDdKXKpa2Ytp3EWnFTjypiTiXAvHbj5H9pfA8_mHW_pLF_ZXUw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AHdqH_O5d632gVvSYq_nE3icXnQEdPUs2upSgnjO4sA&oe=6A2C1412"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-KCLScC1U8Q7kNvwHBzkYc&_nc_oc=AdogStruzSyohj5NILkqP9BDyiFo04mqvwaS2qtZerHtKrhbuapujuZeYLoIJCsJUmk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IcPcWzq2Rbst1Fq-lajTqwDZqa-_TGXTiazfRn2Iadw&oe=6A2BFE6C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xKVUuqfc8MQ7kNvwGOxhk0&_nc_oc=Adr1C-95tzYbx5mNVp7y-PT-96V78e9NMDdRRG-EbZ7VSeSqTvK7XDCplQmukGrjwoY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OSfWs9Ku9HOTPB-ZP_UNrQvNoNj_QyafgoEK_D-UNOw&oe=6A2C27D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3Jyy5AGu-QQ7kNvwFrqdnX&_nc_oc=AdquHewStwaXrNxu9eKdNEJuzoClOFEWMgajHuhsyo2YIjbEwfJFN0PRhN-ouz_agqM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pU9nws8kEPyJY8yBRMXilowZmz295-ZX-F4E4UaWlFw&oe=6A2C18EC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
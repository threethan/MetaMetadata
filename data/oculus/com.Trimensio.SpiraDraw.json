_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sINWI-rZlHYQ7kNvwGbWwLL&_nc_oc=Adp_BGuXlc8gv6JVjfzu7KNmn5weJAasBFRrdcmLaox8CdYBAcVc6Knshu7gWrOw0iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKuPfx_HAHTCxXgFlkARGaIZN5PtBGhzuY9XjbaQ3_5A&oe=6A4D0648"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUnp2JiPBi0Q7kNvwHJr513&_nc_oc=Ado5Ws78oNoCgShUU-m-ak7jx8GE9McfgCAxjBFbFVhu8ISqtFLVx5eE7KHJvXIw9rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeA6e0h-Go-3PAdSXUeB9c8yS8S-NhdYkEHI07fM9PWw&oe=6A4D0992"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_yW8RPwQkkQ7kNvwE-UZaJ&_nc_oc=AdoBECA_FPNYXGnWj8-eX_t6A0oS3_ajNBq6pcx2of3p9cy0IpOf4-7l5pvU7y5DvEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAISHCPl9scGx3ydNeZJZoILFGcSyMKUUmmtViNzo4AZg&oe=6A4CF3EC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRMse1DiX68Q7kNvwFVUmJ4&_nc_oc=AdqKfaHG-dg2cBzJp6Ao8OsAAAjKDbgWmW1gp1RPl8Xf7Bo0OWeFJbJNcpEmFS7Ul3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHKEqyZ2grhrTsO2uuX9XC5lcEXlsQlpvUjZQagPaaKw&oe=6A4D1D54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lJrrHGjRS0Q7kNvwGZBoKw&_nc_oc=AdoE5MB9S2EWNeV6M3uvX0e59KSyTW5yt1KIYihc20RYFrBOzGCJqoSYAqZAmCulfCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKHyOB8DBRR9EPHAmKN2_bWFjADXngnh1b0mkZ78BCCA&oe=6A4D0E6C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLkDlGEOhLcQ7kNvwHzdHyF&_nc_oc=AdoGOBfqpIXOe9TunqikHQVC_CdVlZgHNZuTl0PngZv3j-yGmwyhWOv-gOyiQG-ueRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RdHCDYWbjWgcK7yM5AmqzJMmhnaQDOifig4f_VKQuzQ&oe=6A281C48"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYDuSCcg6dYQ7kNvwExCAi9&_nc_oc=AdpJUDCROV-JSvPf5E3ZmcsyjR9p8Oc6qcwu2oZJ9K4NMUIAIvHzXo2Tqj-dIeS-sDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ijYYhHCvxa8vFHHuc811TUBI7odxd5ydPdK75quBCbQ&oe=6A281F92"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTcNJ7JpcO4Q7kNvwEoGRvW&_nc_oc=AdpIchyyoetG-tnzMIk1ik2xD9qtsyf85dz1VsMnuesXg4Ku_o30L8GQhGYUh3epASg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JgWhAKpu5G-n9kpEflnFiQWRWIUahKwJjMaLKBeNqTQ&oe=6A2809EC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ua0V2lUPnw8Q7kNvwGE-4lp&_nc_oc=AdrGLXKGX6U0wuGriHDlkEuCDvVfZWuKrQTWZZLeboyNZPv2wYMAT2Ds4LRI1RxiGgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af850o3P3Xm0p7fmUL8fLkuDcxBDHfIML9vJm0Si2L-SUA&oe=6A283354"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5oTk1E2d4wQ7kNvwEXGuHI&_nc_oc=AdptQ6xKdmpcTl5hj4W9CDYrc7KmFehE9NxZb2tKUnwZT5OciwmBaFijRpyG46sMwNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ayJqBtrX8GiN-1LnEsVoVTdoSVcyr_fG81bJSRBcvLQ&oe=6A28246C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
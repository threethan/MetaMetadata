_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkDFxRh-anwQ7kNvwH4GlZQ&_nc_oc=AdpPet__hyV6B8p_nOvgx3iFsRvoGDgFEXRNCdT3SciQv1dQhnThGO6fAXsIFy3yxnQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2pTq-oX_nTMqa4PBZ55nChDbtxST_7Ozmf-u8W9A8yQ&oe=6A636FC8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIlMtjFJPU0Q7kNvwFiZvE1&_nc_oc=AdpRD7kMEsmyWIjXqswg9eVDFTp-kUiSR_Ial3PtIqVolkWvV8886V9d-w14Exs3xcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa3Gk7m8RXBcM1XWmOfM12kDgPylKDtkI-wxoHBZU2vw&oe=6A637312"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPQ-RZFpgAkQ7kNvwFcrL57&_nc_oc=AdrfTEpZoHHV1Q_yfbqDzjdB6x6ILPIu5qeX2GeVUwW8zXhS5CDo_okzyg2txk4R7fE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi3fq_528cI7V8b99hRSAUXByxJdEaJlX3SQnqSr6UEw&oe=6A635D6C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m1_dUoGysUQ7kNvwGbSJEC&_nc_oc=AdrHzn5THpF43i6GLgE_7XUMYW2fvmPVnsYmOs5JPhEJDgLTp5RmuRUexx7ATlTBaZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDyp83u8hyjjbMmjlWWrYXlvEm0j8dviglF4A4qGmpaA&oe=6A6386D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti01UtxqEvoQ7kNvwESpjIT&_nc_oc=AdqR8zfZFnRXe59PRftDTnf6k4ZL9yQdBcT9R2HvIWYf4R7WpE0x99pymcsGnyENhuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR_ia7snu0DJJ9WAOyQtyFtEwXW0LtKdcjp5EcCO3KKA&oe=6A6377EC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
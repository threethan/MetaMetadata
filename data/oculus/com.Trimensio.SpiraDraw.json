_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9AVSib7DfUQ7kNvwHfglmD&_nc_oc=AdovCG1Oni_jvEmLqaxRHD5w6TVNNLuUKKGYkQS73Ws_nctdz26mOLO_GXtMLBtPuH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkZpZHuorHw_NIMWES9ntvZsjoDGFn4DOxz9CAIV1L0g&oe=6A5E29C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXraSl5sVSMQ7kNvwFaAVim&_nc_oc=AdqdufdVGLNFlYgzDqJJhP6OGvDQreVMiMTzSDc-ghEw9ELmoZ-vi8RcIgJpjOYJglU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDakc39rp-sgc1SmaLmO0YSxk5Hge58OOxNOFOOBqryjw&oe=6A5E2D12"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTkOc6ZT44IQ7kNvwHHaDKV&_nc_oc=AdquB3N_Z_o4XAgdickn97HYOlFP9R1hw3Vyqi3jkf9Yqq6XXFQotkJN2T9O_uPPGbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3jM_zHE-7ZbMNcZkwIwBrWVSW7GxOlIzO1j3QqFNi-w&oe=6A5E176C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYy7jcapsHcQ7kNvwGaNHz_&_nc_oc=Adpou1lfpRJZBWGc1ZYut1anKYXJE3gSkGEFLmXIdfjMd36e2WSDLa9Jy-1REuxGpCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA39bDAvP55nRb8O43nE6o0X7Z8nzvJgNLGvUJCdPghow&oe=6A5E0894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y39L_7igN6cQ7kNvwF3qxsW&_nc_oc=Ados8ZRI9Dsj4-ebyFFce33D6j0cVmEYXW2qnd9p7ubd9Cy-fnVcHv9kiED0yx03Uzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB6_xgLJiFzU7ipGD7QGDVZx-twSPj_tMSpSZrxTKoZA&oe=6A5E31EC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCzQPnSiFNcQ7kNvwHVSI6a&_nc_oc=Adrytv95nHtd0LvKPTWB4m9D2aAyRXvTNGcdH_OQfk2jB0be87ZTcm5M6cSRpNMn2l0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkuofwpkQBUwZanYIsu2ORRJ6bHvM8NS4gvoFaMS6tUQ&oe=6A71F048"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TP2KKWG0oIQ7kNvwHrq9EJ&_nc_oc=Ado_-IApZ9YvsDELhjmx-VJSr_DKd-LHbiFEm6kbOKZur4KSYs1ofREtyd7PiKh4FVA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpRnkMdwTHzvIGFNeTWuS5ZVEmEIR5V62Vo0iqVGel6Q&oe=6A71F392"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20rl3gQQ0osQ7kNvwHCxuTV&_nc_oc=AdrSgnvF573c5N0IHgK8LFb9sjwjK1yCq9gFK-XLqgefGsjIhkDyMmY3dq5BWwOA5Fg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdYLA22i0iaf26OzyPkyVPhB-Yw4z05evVjFPSFyHdeA&oe=6A71DDEC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN0I8nL4ZLsQ7kNvwGjwFFg&_nc_oc=AdpfEl7TmR25cTaru2zGHVB0HBDxiANSArpokB1aRcdMJ_ZvXPMzlmG646dvJpx_JhU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN7aS9tKuDrlKjlA0baCfvuv9NTowBQxlTfoJu4LJkBw&oe=6A71CF14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxZNAkvQYFQQ7kNvwFB1ZUF&_nc_oc=AdptQ_5QNSpLpj_Zmvi_k-3Ax_i9gr_iRN4Ec-oQQWmV9C545PsTIiczmMSY-rTBAJo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmRzJu_eglXQsezEyBM5tNjZMNF_CubtAAyF2eaiKlQA&oe=6A71F86C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCzQPnSiFNcQ7kNvwGKyBeG&_nc_oc=Ado_VGNe7dEs5Kw8bne8P569C3uOZxpUl9XdQqXULBEMb4ruRf-CZlVra9ItMuWsl_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlhZiN1ETpCOXDQIOTf0MkgGRBaCV0hIdWMDkrzld-Ag&oe=6A7341C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp-4HNV3kwIQ7kNvwG5ij9D&_nc_oc=Ado3-d0m4WKE_xdtg4L9yOX6c6SE2OixfxA6-i9KzvOKcacGR2AiSeeDNX1NcLcvja4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFSup8eKvlR6_q2Eky7h3lLzOIo4ftQPi2BQ5sfvb5bg&oe=6A734512"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20rl3gQQ0osQ7kNvwFjg0V2&_nc_oc=Adr5J5UOGgWJzNWmaxrNrpcgTgTY_98Kk-80WQtxhNB_SpgJ3jQR_z9HEOgVONvbtHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsPR3J-mWHSkgQR5m2yywkoEa6M--b9kFYNpZcYRVeRg&oe=6A732F6C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN0I8nL4ZLsQ7kNvwEVDe3b&_nc_oc=AdrkZn3L_I9_CPPZZMDzFIiEA3dhU783Fi3MecEwaubGwX0t6cCWY5bF22Cqjm9vK-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVUhSCFFsxOxkkzHTelOKQai0tFOMvanh5BQFXGH9vGw&oe=6A732094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxZNAkvQYFQQ7kNvwH-clW5&_nc_oc=AdqtCeOY8don0VLs8kem6nTv88SC8Q6v4pgkeBEZGWo6gFoBbCe9fXun4-7dRdSItE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaqHADrCbGLtTvPAUq3ZKFblWTC2XC3xwWgPOxSi7WnA&oe=6A7349EC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io5FTe_XztkQ7kNvwHbqQfg&_nc_oc=AdrU5wsMS5y3T-dNN5FJMpz-H-sJAz8K7GhWQIu2mmfzE527Z1Nvk4RHDhNKrR2wxFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyoOwdZSVy1ieMO8m-CuTT3rSw_TzkDVvtGDYMSqkteQ&oe=6A7C7C48"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_kRgAqUEFgQ7kNvwHWT5fC&_nc_oc=AdrMJcLnu4kvBFiprQZCG5viXlKykgvYkorKcUm0En74MI0XeOH9rFaJVC_mKqAsvlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6eOkaZAwFIDUFR8Qv6RyJfpZO6BMHCSCmOEpfrjf9QQ&oe=6A7C4752"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcUjsJ_gUfIQ7kNvwEjJ6MS&_nc_oc=AdrjByOyYdvytb3qhmHBC1M-wNmy6NDTrAMLgMgVapLU6jae_rowqYnCUfHut_IWlcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZpfRDwfCna9Fk8Xt-VSMBl4lI6IlBMv3Rs3dKDlEzIw&oe=6A7C69EC"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcPUTCFtAbMQ7kNvwF9f6-E&_nc_oc=Adp7JOmwAFjUnBgnLlNcnLuATSfPjiCCFMsN1jMVli58KQ5hOyYq2Z9QuO1oEuWIBUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW3fxXuj3FZuucaB1tt7t_GBn3_hirjAKYghqb9IfMPA&oe=6A7C5B14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xc0E2rz3_K8Q7kNvwHlDFNC&_nc_oc=AdolIeBi1N8k9rpC4HS1gYwhb82U2wMcveUesGgz3R_P0v0_0H7KVe_GwZ7Ah8Dtd_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiZ-iiz2gc569YGIw8ARbnElcXL0U3NeEnMeNzeifa7A&oe=6A7C4C2C"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
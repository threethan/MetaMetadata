_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sINWI-rZlHYQ7kNvwHTDgpF&_nc_oc=Adp9bsbW5RYedoRg5_4oi_nArSnpBK6OSqptXa2cB_hkNGKyQFppQJo_G3lfy4ixPmE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFH93MsTw2i7mvjBsjcp_zyGzAR5fYJXBDA4xgTeQXTw&oe=6A4E57C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUnp2JiPBi0Q7kNvwEXnn7d&_nc_oc=AdpXqqQQOU-F3i0liAeqjyELP4ty8C9s9gsh9UdbJxHQnFTHMNqa9Hy6bOHpgqVsrJ8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPsvFiAgYqLKV-UcOZ3XcbxG4_yP5tSBKC15K3M__Yug&oe=6A4E5B12"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUdZt3bWWLQQ7kNvwEbHlBT&_nc_oc=Adpp7QR4UD6KVeAhRoldfXyNqcTlJpr8SBMAGcGRex1DaSzXyesdBqVQZz3nr8-aVSE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiySmNaNtj2JQekmdTbXC7E8BAGYAbJyXmWHo_739jNA&oe=6A4E456C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRMse1DiX68Q7kNvwH4dHzz&_nc_oc=AdonA1bJgSZ3XRjKhuUa-xO4IDa_jUXuKwR45ByAdR955ViHOUygXdDl90WakjAHlQc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDitpRNJ2SeLNKnGkW0_gA1wtSRQ2_tR1iBDQFQyayp7Q&oe=6A4E3694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5OWDF7HfZIQ7kNvwHt0u2j&_nc_oc=AdopRC9JmbIFIblBDk_mI4HNiYx8jbhW9wNe1tkqfMLD5mlMYitO4qXusDReLiLonNo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBvv7EYlm4nXkXZtAvn2_Jpex7BNJ9pQvGUQVpSmkROw&oe=6A4E5FEC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrUvf1VWI0EQ7kNvwFktjnQ&_nc_oc=AdpAnp4pi5fvGCAp-xIe4_vA780ZjjU799MXTziSyTMHc9eGbjcxlUaw2P5gwoXXhWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJsbB_BJBdaF79Kd9fZgtfWoV0woWsByfT8ZE800dbCw&oe=6A5B86C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXraSl5sVSMQ7kNvwE7w-24&_nc_oc=AdrMnXXw1jEw4FADactznoDjRsEZJVw220pxn_rfRuB_6o0hMynzz3z9JOxHm02T7w0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXl5tCkPcPCDTbtI0YwF2LVMG4ARMk0OydWT-8Gxo6fA&oe=6A5B8A12"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNg3Ipk31NsQ7kNvwGqA9k_&_nc_oc=AdpCLdAzfmJlN1c1SBMzhABgFDHSDLiDGGcWjDR_yRI7q1D5hwUQEfhenkMannpJnLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuxtrw7eYYwqY14YyLwQ58kdUdQ1eA_wBQiRI1SIhNvw&oe=6A5B746C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQRRld_7GuAQ7kNvwHPNudR&_nc_oc=AdrMNmS8cfsBgHSh4wCu4tECR8hQYflEbiuxS84TAOBzpQexWK6bcwQUB1XySQMtSYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtSZrvT4UpY-xSGW8xhxEn8IFQxIkID95eKPOK6qQfmw&oe=6A5B6594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCSvpO2BbzgQ7kNvwHR0LEQ&_nc_oc=Adp5blub5MUO1Kz_E_KJBHgh3w8hSAAtYCC9-0huQp5t5rgX9phzuZ8n0_7BFXME_Ec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdFaP_QBAg_USopXO3MrUTLaGb5xHShKWn5cttxAMSFw&oe=6A5B8EEC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh2wYsZ3_RoQ7kNvwFIVNRE&_nc_oc=Adq4EvvW_I8Yia5LGb4hQiOpfw5orVIfk0khhQ1f7wIi2uonNkMWwKt_5L056z1DKd0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADAC9kKRix_yia4zOrCs4jio7oZ17onl3Dfi1T1uPq9g&oe=6A5640C8"}, {"file_name": "Screenshots-doll.png", "id": "931216783159691", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825462_931216786493024_1696696786246521807_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7m3yIBaRH4Q7kNvwGdY_6T&_nc_oc=Ado85pU-IHL_FTRNVVJeCQu4FLMtr0CTRAfgsyt7nPA8K-GpkHROKKxsUCvXgEX2I7A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd6_lbtWr5e_-juJQmG6HKygb3qR74IlF93HuJFlAHyQ&oe=6A564412"}, {"file_name": "Screenshot-tree.png", "id": "1301647655148571", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819845_1301647665148570_3803739469752378298_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVSgr1rpCEkQ7kNvwE8HRyS&_nc_oc=AdpZqkLpLZYXiaI3jDWNZGPyo_NPMHjFrPQOa6biy9JJOXg4YUY7DDX0oE3v312cd_4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfQ3DkmHrcmzTuwWGGxnLtEgcvNBa5hQ5kHEy8D49Vjw&oe=6A562E6C"}, {"file_name": "Screenshot-dress.png", "id": "1669664397363180", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820887_1669664404029846_6080114071306461622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6jcVzRSkKIQ7kNvwFTg27V&_nc_oc=AdrGTpxlt3ovFl7NTVRywgzzZus-XGqdoxV9On7tCo05xluknBQazRfuayVO-FO50nk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe6Bexg6hHLvrlMU0B7gsYKrSmVVgK5CpF9bIKNeERDQ&oe=6A5657D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2.png", "id": "1313132757323567", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824665_1313132763990233_8517341453773247130_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G1wQOxSPd8Q7kNvwE4zJo4&_nc_oc=Adp1KZmmAJ8-HZTlL9yUbc5UsQN_9u2euCZslr90jvN5afvDMXrhHzAc-gySAkaOhgA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiozw08t8S3eBUqN4adVCyYFyUkyZ7kGBYfu2tOP7FKQ&oe=6A5648EC"}, "display_name": "Spira: Paint with Fingers!", "keywords": ["paint", "draw", "create", "cake", "color"], "long_description": "**Spira \u2014 Playful 3D drawing, wherever you are!** \ud83c\udf66\n\nBring 3D creations to life with intuitive hand controls. Pick from a library of charming templates\u2014cupcakes, cozy room, characters\u2014and enjoy creativity, anywhere you are. Spira is travel mode compatible on trains and airplanes! \u2708\ufe0f\n\n{2403735053455340}\n\n**Designed for Hands** \ud83d\udc4c\n\nUse your hands to draw & paint models! Intuitive gestures make the app instant to pick up and get going. \n\n{4318315151769762}\n\n**Tasty color palettes and patterns!** \ud83c\udfa8\n\nSpira comes with ready-made color palettes, patterns and a metallic / matte \nselection.\n\n{930330233088478}\n\n**Draw & color anywhere** \u2708\ufe0f\n\nWorks with travel mode on trains and planes.\n\n{4005458899751620}", "short_description": "Spira is playful 3D painting & drawing app for mixed reality, designed to also work with travel mode! \ud83d\ude85\u2708\ufe0f\ud83d\ude97\n\nDraw and paint on 3D objects using hand-tracking, expressive brushes, and intuitive gestures. Everything happens on a turntable, so you can paint comfortably while seated \u2014 at home, in a hotel, or even on planes and trains while travelling."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trimensio.com/spira/privacy", "developer_terms_of_service_url": "https://trimensio.com/spira/termsandconditions", "publisher_name": "Trimensio Ltd", "support_website_url": null, "website_url": "https://trimensio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
_1364579731821299_1285236263478267064_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcBSIqe4j9AQ7kNvwGIzN2K&_nc_oc=AdmMjElCBRJGzDLHTjw-zP09aPEOkuNXCAoHP66goqTl6SEroJj_8azfwYn4lZDLqiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftJBMkMtOsnJ_QvIDYSFxf4IoizLkeCx3CQrGVRFz4gIA&oe=69A96A65"}, {"file_name": "s5.png", "id": "1179766687618002", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823431_1179766690951335_8216196286202422678_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IWv0b0ulzMQ7kNvwEkI5LS&_nc_oc=AdnBaM7a5ZXNMu9rX7bSWZPmDjTgPrIUNTtssaHbYY1XVW_UXVnE61NwNIDk4kRZBSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvOJjRSfMHVdvbvm2NFalG4-EWrpl19S6JVucG6BDJfkw&oe=69A98E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560s2.png", "id": "741848575608323", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_741848578941656_8791438996106424249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg_ImTAw_vYQ7kNvwFXf4Kh&_nc_oc=Adno3ZhjcyKAmileLD5RyqKqJtUQ3Gj_ns_9SCpznUXJZhoAt5OitLUE8gSHPaDDQFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftkKfYdy8rVJrWEUNjaupoz12UkmU91mDOg2pao-O-k5Q&oe=69A966F1"}, "display_name": "Squat Game VR", "keywords": ["Game", "Simulation", "Survive", "BattleRoyale"], "long_description": "Squat Game VR is an intense and immersive virtual reality experience where teams face off in a deadly competition. Players must work together to navigate a series of thrilling challenges that test their strategy, speed, and endurance. Only the last team standing will emerge victorious in this high-stakes, adrenaline-pumping game.\n\n{3667302130236949}\n", "short_description": "Squat Game VR is an immersive virtual reality experience that immerses players in a deadly game. Played in teams, this exciting game challenges players to a variety of challenges while testing strategy, speed and endurance. The last team standing wins."}]}, "developer_name": null, "de
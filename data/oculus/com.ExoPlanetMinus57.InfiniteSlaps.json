LMzFunh_ttUsJuJg7a9SUcSB3uOOF9mn0tcpmTe3D1ZoXyxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfDJELQRjfubla-rsM6TkOZD76qbNvxE4iqFPZvSVMcg&oe=6AF5D920"}, {"file_name": "image-2560x1440.png", "id": "1820026049171690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593909648_1820026052505023_7512749698901708163_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIhX3MsDtjMQ7kNvwFi0x8Y&_nc_oc=Adrr0u59Sfg8iSF3jewDAHdq7ePfI0oykfGVMyeaIEGjeiG1pItil7Jr8UTJ7PXTkuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR455jYQoDmE48wwHwsTXq6ARZyaN4l0pG0ILpglmjL1g&oe=6AF5D9C0"}, {"file_name": "image-2560x1440 (4).png", "id": "3956250024517245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628454_3956250027850578_3064910039406950071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FImKarsoh8Q7kNvwH20UHw&_nc_oc=Adqcq7EX1IQmmkyyNOMvHSO6_6-SBfoS68HEQY4EKFSllEBM60T9rvOClkwWU9Xtbp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyKdzxEbhuIH2iiF9WQlat84gZFhqpLn58XD_uArTmRw&oe=6AF5CAB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Infinite Slaps!", "keywords": ["slap", "battle", "pvp", "fight", "action"], "long_description": "# \ud83d\udc4b Infinite Slaps\n\n**Infinite Slaps** is a multiplayer VR slap battle on a floating arena. Knock other players off the map, earn Coins, and unlock new gloves from the shop.\n\n# \ud83c\udfae Game Modes\n- **Free-For-All:** Everyone for themselves. Keep slapping and try to be the last one standing.\n\n{1107844338276305}\n\n- **King of the Hill:** Hold the middle zone by yourself to earn time. Most solo time after 180 seconds wins!\n- **Capture the Flag:** Red vs. Blue. Grab the other team's flag and bring it back to yours.\n- **Sudden Death:** A storm closes in on the arena. Get caught in it too many times and you're out!\n\n# \ud83c\udf0e Maps & Random Events\nVote on maps between rounds, use launch pads to get around, and deal with random events like **Moon Gravity, Meteor Shower, Ice Rink, Mega Slaps,** and **Double Coins**.\n\n{2251021059123997}\n\n# \ud83e\udde4 Unlock New Gloves\n\n{1044434938612668}\n\n- **Offense:** Send players flying with Titan, Vortex, and Repulse, or risk it with Dice and Rage.\n\n{1517097993578918}\n\n- **Control:** Freeze players with Frost, mess with their vision using Disease, drop them through the floor with No Clip, or turn them into a Skeleton.\n\n{2002992244410073}\n\n- **Defense & Movement:** Resist knockback with Aegis, stop mid-air with Anchor, remove effects with Purity, or move fast with Volt, Comet, and Surge.\n- **Positioning:** Pull players in with Magnet or Black Hole, steal momentum with Siphon, or swap places with Swap.\n\n**Grab a glove, jump in, and try not to get launched!**", "short_description": "\ud83d\udc4b Infinite Slaps\n\nJump into Infinite Slaps, a multiplayer VR slap battle on a floating island! Equip different gloves, knock players into the abyss, earn Coins, and unlock even more gloves.\n\n\ud83c\udfae Play Free-For-All, King of the Hill, Capture the Flag, or Sudden Death, where a storm closes in around you.\n\nVote for maps between rounds and watch out for random events like Moon Gravity, Meteor Showers, Mega Slaps, and Double Coins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/19W7ih6QaDrOWqvFay7w4ZfLcwatqakxn1tQJMrJLccM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Duh_Beast and RomanEmpire22", "support_website_url": null, "website_url": "https://exoplanetminus57.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
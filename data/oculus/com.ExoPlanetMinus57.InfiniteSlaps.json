gWpw8Gq2jBJsLtvXoO5JoWmf37SubNo56NCMYY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdQ8A3i4EN0CJSuNFxayMXFPmqB4RMuplgd61QV_QGrA&oe=6B084CA3"}, {"file_name": "image-2560x1440 (1).png", "id": "967999356320826", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623534_967999362987492_5920005843757488592_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51RVq82l4U4Q7kNvwG2bja-&_nc_oc=AdoQK_KqTXWg_bziWP-TwXthUJNe_PxwjzNRU0l1l20okX7FEEhBD7LT8YALkrnYLmg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp7zIuZgkHrBe6BCONvB0UjimWpcou1ec-X2m7FSwspQ&oe=6B084E20"}, {"file_name": "image-2560x1440.png", "id": "1820026049171690", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593909648_1820026052505023_7512749698901708163_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ3Up6TAwvgQ7kNvwF0MqWs&_nc_oc=Adrq7-ukFWAfQ_PClqubBeb0WJizMe59Dc2qXvN2Nb5Pdr9J8mi4LH8T49jeTqLvgyo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVKhhPtXCrRILaFgA0y3_aUvBNtwjc-V9TvaW4IjPppQ&oe=6B084EC0"}, {"file_name": "image-2560x1440 (4).png", "id": "3956250024517245", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499628454_3956250027850578_3064910039406950071_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejOqKszr4gUQ7kNvwH9fDix&_nc_oc=AdrQLHzH9ntF6ZBXQsUgPfR4F5vLjYBayA-9hvZIV70daqtM9ewZlLnY2Bajpxr0GI8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRepV7q5RqflD-xAgoBlNNfs0MYPAuYOdAPOEQmApl7aA&oe=6B083FB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Infinite Slaps!", "keywords": ["slap", "battle", "pvp", "fight", "action"], "long_description": "# \ud83d\udc4b Infinite Slaps\n\n**Infinite Slaps** is a multiplayer VR slap battle on a floating arena. Knock other players off the map, earn Coins, and unlock new gloves from the shop.\n\n# \ud83c\udfae Game Modes\n- **Free-For-All:** Everyone for themselves. Keep slapping and try to be the last one standing.\n\n{1107844338276305}\n\n- **King of the Hill:** Hold the middle zone by yourself to earn time. Most solo time after 180 seconds wins!\n- **Capture the Flag:** Red vs. Blue. Grab the other team's flag and bring it back to yours.\n- **Sudden Death:** A storm closes in on the arena. Get caught in it too many times and you're out!\n\n# \ud83c\udf0e Maps & Random Events\nVote on maps between rounds, use launch pads to get around, and deal with random events like **Moon Gravity, Meteor Shower, Ice Rink, Mega Slaps,** and **Double Coins**.\n\n{2251021059123997}\n\n# \ud83e\udde4 Unlock New Gloves\n\n{1044434938612668}\n\n- **Offense:** Send players flying with Titan, Vortex, and Repulse, or risk it with Dice and Rage.\n\n{1517097993578918}\n\n- **Control:** Freeze players with Frost, mess with their vision using Disease, drop them through the floor with No Clip, or turn them into a Skeleton.\n\n{2002992244410073}\n\n- **Defense & Movement:** Resist knockback with Aegis, stop mid-air with Anchor, remove effects with Purity, or move fast with Volt, Comet, and Surge.\n- **Positioning:** Pull players in with Magnet or Black Hole, steal momentum with Siphon, or swap places with Swap.\n\n**Grab a glove, jump in, and try not to get launched!**", "short_description": "\ud83d\udc4b Infinite Slaps\n\nJump into Infinite Slaps, a multiplayer VR slap battle on a floating island! Equip different gloves, knock players into the abyss, earn Coins, and unlock even more gloves.\n\n\ud83c\udfae Play Free-For-All, King of the Hill, Capture the Flag, or Sudden Death, where a storm closes in around you.\n\nVote for maps between rounds and watch out for random events like Moon Gravity, Meteor Showers, Mega Slaps, and Double Coins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/19W7ih6QaDrOWqvFay7w4ZfLcwatqakxn1tQJMrJLccM/edit?usp=sharing", "developer_terms_of_service_url": null,
987492_5920005843757488592_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51RVq82l4U4Q7kNvwG2bja-&_nc_oc=AdoQK_KqTXWg_bziWP-TwXthUJNe_PxwjzNRU0l1l20okX7FEEhBD7LT8YALkrnYLmg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp7zIuZgkHrBe6BCONvB0UjimWpcou1ec-X2m7FSwspQ&oe=6B084E20"}, {"file_name": "image-2560x1440.png", "id": "1820026049171690", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593909648_1820026052505023_7512749698901708163_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ3Up6TAwvgQ7kNvwF0MqWs&_nc_oc=Adrq7-ukFWAfQ_PClqubBeb0WJizMe59Dc2qXvN2Nb5Pdr9J8mi4LH8T49jeTqLvgyo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVKhhPtXCrRILaFgA0y3_aUvBNtwjc-V9TvaW4IjPppQ&oe=6B084EC0"}, {"file_name": "image-2560x1440 (4).png", "id": "3956250024517245", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499628454_3956250027850578_3064910039406950071_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejOqKszr4gUQ7kNvwH9fDix&_nc_oc=AdrQLHzH9ntF6ZBXQsUgPfR4F5vLjYBayA-9hvZIV70daqtM9ewZlLnY2Bajpxr0GI8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRepV7q5RqflD-xAgoBlNNfs0MYPAuYOdAPOEQmApl7aA&oe=6B083FB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Infinite Slaps!", "keywords": ["slap", "battle", "pvp", "fight", "action"], "long_description": "Infinite Slaps is a chaotic multiplayer VR brawl where you battle to stay on a floating arena. Your goal: slap rivals into the abyss, earn Coins, and unlock powerful \"slappers\" from the shop.\n\nGame Modes\n\nFree-For-All: Complete arena chaos where everyone fights to be the last one standing.\n\nKing of the Hill: Battle to control the central zone. Hold the circle alone to build up your time\u2014whoever racks up the most solo time when the 180-second clock expires wins!\n\nUnlockable Hands & Gear\nEarn Coins to buy unique hands that completely change your playstyle:\n\nOffense & Knockback: Launch rivals sky-high with Titan, send them sideways with Vortex, push them back using Repulse, or risk it all with Dice and Rage for random power multipliers.\n\nControl & Status: Freeze foes in place for 2.75s with Frost, disorient their screens with Disease, or force them straight through solid ground with No Clip.\n\nDefense & Mobility: Use Aegis to tank incoming knockback, Anchor to stop mid-air momentum, or Purity to cleanse crowd control. Dash across gaps with Volt and Comet, or jump-start your speed using Surge.\n\nPosition Manipulation: Pull enemies into danger with Magnet or Black Hole, steal momentum with Siphon, or instantly trade places with nearby players using Swap to turn the tables.", "short_description": "Infinite Slaps is a chaotic multiplayer VR brawl where you battle opponents to dominate a floating island. Armed with unique \"slappers,\" your main goal is simple: launch rivals into the abyss, earn Coins, and unlock stronger, crazier gear.\n\nKing of the Hill Mode\nBattle for dominance alongside Free-For-All mode. Hold the central zone completely alone to tick down your timer. Survive the mayhem and claim the most solo time inside the circle when the 180-second clock hits zero to secure victory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/19W7ih6QaDrOWqvFay7w4ZfLcwatqakxn1tQJMrJLccM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Duh_Beast and RomanEmpire22", "support_website_url": null, "website_url": "https://exoplanetminus57.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
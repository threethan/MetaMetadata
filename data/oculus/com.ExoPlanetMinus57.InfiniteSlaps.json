442679_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4ukrP7G874Q7kNvwEq5twW&_nc_oc=AdrFAegzsW5T15iEuX3scRnsbd7MGQmcbhpGBDEqapPs55HaokTWSF8oC190XVWhBdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgaYHutoDjLn3jIhrWzIa7vIMCT2qTcEYL1Hk0iP9JkA&oe=6AF89A4B"}, {"file_name": "image-2560x1440.png", "id": "1044434938612668", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619382_1044434945279334_4067020398473002627_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwxdbf55NsUQ7kNvwEbhnoB&_nc_oc=AdrNBcfrSTLSvSTpD4demKMDcpndtpNVloOs-PkT2ArX9leii1ICQGa33ozxuA1iynU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJwzr-GSrL6MBGCxIgmfdVy83QeHULMOE_moYjbDRmhw&oe=6AF87BFB"}]}, "id": "1498540778863593", "locale": "en_US", "screenshots": [{"file_name": "image-2560x1440 (2).png", "id": "1420375033405675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593727470_1420375036739008_7046910728055165547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i4QQaCllSkQ7kNvwF1pzXV&_nc_oc=Adqhbso8-KAJ7PW-pSC5u5e5iqbg6M_ben7vUQkdqF5sTlUYhz2JkEtVA2MdGxs9w2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXk8WsaiK29R9mK98cpoFWflfoAYZcdhHkUhhp_qHrwQ&oe=6AF8900B"}, {"file_name": "image-2560x1440 (3).png", "id": "1117554047388139", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628411_1117554050721472_1631895359809664356_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up0VksOdEdYQ7kNvwG4rkPz&_nc_oc=Adq7RNYQX5dAVOgkN2Ev1HQTMDNObeecGJdnx9ukKs1DyGUc73A6YMS0hUicamMRw8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlWuD-vtmZk2TBWBCANLGwd9ZFrFhMSQ5uF5edbTToRw&oe=6AF87AA3"}, {"file_name": "image-2560x1440 (1).png", "id": "967999356320826", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623534_967999362987492_5920005843757488592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I23r0EibGQ8Q7kNvwEj47pa&_nc_oc=AdoKU4Zp9i2WiAALiSCC9zFaFtTLgygT1jeVBEUj9l7AZIz4oPyJ-yuzF6fF1p4Aw94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSdyc5qUtr0F0dveYkJNKPXmV0qtuwlFCk7MqXLPacAQ&oe=6AF87C20"}, {"file_name": "image-2560x1440.png", "id": "1820026049171690", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593909648_1820026052505023_7512749698901708163_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyWy9sQiE3cQ7kNvwED_Ojd&_nc_oc=AdpCoG0LggI1tLCwJcAgqYVdrUQ_cS90FxnPB7a9CQZOqaRLR-A50gYdpnQcXjo9tYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_xBWXAJAXCncxHA1hi6OXP84A9UcQuS3TYm2q7VMjZQ&oe=6AF87CC0"}, {"file_name": "image-2560x1440 (4).png", "id": "3956250024517245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628454_3956250027850578_3064910039406950071_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04TyfrooNPIQ7kNvwHGg75W&_nc_oc=Adr2OVCKPu8oNNIVb2DBtErbU441P0PlhCkBoEwKomebKcW5McUY3GgAL0ZNgfAqm7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYTtMEa4oOiW4-5fuheNjUIBjqe2bIwbin-quOEOo-qQ&oe=6AF8A5F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Infinite Slaps!", "keywords": ["slap", "battle", "pvp", "fight", "action"], "long_description": "# \ud83d\udc4b Infinite Slaps\n\n**Infinite Slaps** is a multiplayer VR slap battle on a floating arena. Knock other players off the map, earn Coins, and unlock new gloves from the shop.\n\n# \ud83c\udfae Game Modes\n- **Free-For-All:** Everyone for themselves. Keep slapping and try to be the last one standing.\n\n{1107844338276305}\n\n- **King of the Hill:** Hold the middle zone by yourself to earn time. Most solo time after 180 seconds wins!\n- **Capture the Flag:** Red vs. Blue. Grab the other team's flag and bring it back to yours.\n- **Sudden Death:** A storm closes in on the arena. Get caught in it too many times and you're out!\n\n# \ud83c\udf0e Maps & Random Events\nVote on maps between rounds, use launch pads to get around, and deal with random events like **Moon Gravity, Meteor Shower, Ice Rink, Mega Slaps,** and **Double Coins**.\n\n{2251021059123997}\n\n# \ud83e\udde4 Unlock New Gloves\n\n{1044434938612668}\n\n- **Offense:** Send players flying with Titan, Vortex, and Repulse, or risk it with Dice and Rage.\n\n{1517097993578918}\n\n- **Control:** Freeze players with Frost, mess with their vision using Disease, drop them through the floor with No Clip, or turn them into a Skeleton.\n\n{2002992244410073}\n\n- **Defense & Movement:** Resist knockback with Aegis, stop mid-air with Anchor, remove effects with Purity, or move fast with Volt, Comet, and Surge.\n- **Positioning:** Pull players in with Magnet or Black Hole, steal momentum with Siphon, or swap places with Swap.\n\n**Grab a glove, jump in, and try not to get launched!**", "short_description": "\ud83d\udc4b Infinite Slaps\n\nJump into Infinite Slaps, a multiplayer VR slap battle on a floating island! Equip different gloves, knock players into the abyss, earn Coins, and unlock even more gloves.\n\n\ud83c\udfae Play Free-For-All, King of the Hill, Capture the Flag, or Sudden Death, where a storm closes in around you.\n\nVote for maps between rounds and watch out for random events like Moon Gravity, Meteor Showers, Mega Slaps, and Double Coins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/19W7ih6QaDrOWqvFay7w4ZfLcwatqakxn1tQJMrJLccM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Duh_Beast and RomanEmpire22", "support_website_url": null, "website_url": "https://exoplanetminus57.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
//scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824560_1379170847160859_8361431554603010367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0N9qBAxR4sUQ7kNvwEdJtc2&_nc_oc=Adqy1TsodBZM2N36oBjMpmHx_0ZGvlw3nMp0BLbOIQsvvStkKh5eScQdxc0qO3LyQY8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m1Bs8YfkeSCKq6y4fo4mih_39ncINJCaag5q0gF953g&oe=6A11BFF2"}, {"file_name": "vlcsnap-2025-11-21-23h55m31s836.png", "id": "867947609028129", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823905_867947612361462_4368899613814278154_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-5QcHit-VwQ7kNvwEjhsjH&_nc_oc=AdoYMHftKy5Diqw5fapKjYDC6QRDWl7hBJCGW1IOtqIa0VZ8cn8EeDV1SbaoBXscdvI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af409uuzK7hAul-LC16awTrdHaTsUG6gsNpMBmbCa2Z93A&oe=6A11B11C"}, {"file_name": "vlcsnap-2025-11-21-23h48m14s951.png", "id": "771036769322017", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821682_771036772655350_2365248303990898417_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDYEqgsjhVMQ7kNvwFGwENQ&_nc_oc=AdqQTRK9AcKniNEnXwwx8IVySpS4GiHWCr4B3Ava6qFlB1aL1VgFETKhLHyTwUEllNg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YdXDfTJI-JRG3nFFFkkANnkFKMnhfd0QxFRgBWWYtEg&oe=6A11CDA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-update-header.png", "id": "804058618254459", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75223485_804058621587792_7836461228791862435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEgp4tsHq4kQ7kNvwEbaI4Z&_nc_oc=Adolz2cMfizklnrSixv7M3XYclP4usiMs5hrL8yUErp9xMcaclWv3cNJkaHzmiqG3sI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CdW4biAw_kBJ6Rco6lF1cMp8SPKgnUUxNCxPyJbkdqA&oe=6A11ABDB"}, "display_name": "Dart Racer Demo", "keywords": ["scifi", "hover", "antigravity", "racing", "flight"], "long_description": "Dart Racer Demo is an arcade racing game set in a futuristic galaxy obsessed with speed! Master the controls, fine-tune your dart, and compete in races across a variety of curious environments. \n\nRace in Galactic Cup!\n\nJoin the intense championship races of the Galactic Cup, propelling your career forward and unlocking new races and darts. These thrilling interstellar competitions test your skills and push you to outperform rivals, offering a competitive environment for aspiring racers.\n\nTune Up Your Dart!\n\nUpgrade your dart to meet the challenges ahead. Enhance its speed, acceleration, boost and handling by upgrading its components. Continuously optimizing your dart's performance is essential to stay competitive in the Galactic Cup.\n\nCustomize Your Dart!\n\nExpress your style by customizing your dart. Choose from a variety of darts and freely change colors to make it stand out on the racetrack. Personalize your dart to reflect your racing identity and showcase your creativity.\n\nMaster the Controls!\n\nBecome proficient in the unique VR controls of the dart or use more familiar flat like controls. Master the intricacies of managing thrust, boosting, and executing advanced maneuvers. By honing your control skills, you can navigate challenging tracks, overtake opponents, and maintain optimal path throughout the races.", "short_description": "Dart Racer is an immersive arcade racing game set in a futuristic galaxy obsessed with speed. Master the controls, fine-tune your dart, and compete in races across a variety of alien environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.piotrjastrzebski.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LubSoft Games", "support_website_url": null, "website_url": "https://www.piotrjastrzebski.io/project/dart-racer/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "4
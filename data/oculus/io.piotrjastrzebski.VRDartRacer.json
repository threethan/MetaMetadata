c_sid=6e7a0a&_nc_ohc=DfiLMPR8HdEQ7kNvwE70Hpd&_nc_oc=AdnNsYag2Siq08ie-9gYU0Pr-e7qGvNV5Nv3NKvsr7KzPmECjYOF8VTseIMQaf4h7S0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsezjzq_pfhrHXstHD3wAUnYrNRUXxHVn6KvipL5Sbkzg&oe=69A6BE32"}, {"file_name": "vlcsnap-2025-11-21-23h55m31s836.png", "id": "867947609028129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823905_867947612361462_4368899613814278154_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8v_zuDCmogQ7kNvwFU9Piu&_nc_oc=Adn8R38qxXXX8kdDywkTgR_2i9hIkcRei2shvVBqVRHPZjBu3wC_TWk6yO5M1cSAnLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHxUsTsiO_QvyRpdUYoAh7qI57cNg5axSi7wz1iSr3Ow&oe=69A6E79C"}, {"file_name": "vlcsnap-2025-11-21-23h48m14s951.png", "id": "771036769322017", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_771036772655350_2365248303990898417_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXWE7T6FipAQ7kNvwHQlc-F&_nc_oc=AdkDEXebykpQOGJq9G3S2PDSZ2EZGXtcv3kUBA5kPgjPM7yTc9wW2gAe7-OmuMbI4Eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu1gizMfzafKgGdm9El4uej1Wd1l7DKg4-iZTDg-lRSrA&oe=69A6CBE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-update-header.png", "id": "804058618254459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223485_804058621587792_7836461228791862435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luNx1yjkKyMQ7kNvwEX6rwI&_nc_oc=AdkU0PIKBcEa81Z_P5pd7MmGJTDzR--6NU6kKkiTQw7--YBW0PYT486d52h_Bnya6PQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvKO2PEGt7Zcs6WwS0cPV_2ZSKVYxp5cKsLDUOsoe5rWw&oe=69A6E25B"}, "display_name": "Dart Racer Demo", "keywords": ["scifi", "hover", "antigravity", "racing", "flight"], "long_description": "Dart Racer Demo is an arcade racing game set in a futuristic galaxy obsessed with speed! Master the controls, fine-tune your dart, and compete in races across a variety of curious environments. \n\nRace in Galactic Cup!\n\nJoin the intense championship races of the Galactic Cup, propelling your career forward and unlocking new races and darts. These thrilling interstellar competitions test your skills and push you to outperform rivals, offering a competitive environment for aspiring racers.\n\nTune Up Your Dart!\n\nUpgrade your dart to meet the challenges ahead. Enhance its speed, acceleration, boost and handling by upgrading its components. Continuously optimizing your dart's performance is essential to stay competitive in the Galactic Cup.\n\nCustomize Your Dart!\n\nExpress your style by customizing your dart. Choose from a variety of darts and freely change colors to make it stand out on the racetrack. Personalize your dart to reflect your racing identity and showcase your creativity.\n\nMaster the Controls!\n\nBecome proficient in the unique VR controls of the dart or use more familiar flat like controls. Master the intricacies of managing thrust, boosting, and executing advanced maneuvers. By honing your control skills, you can navigate challenging tracks, overtake opponents, and maintain optimal path throughout the races.", "short_description": "Dart Racer is an immersive arcade racing game set in a futuristic galaxy obsessed with speed. Master the controls, fine-tune your dart, and compete in races across a variety of alien environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.piotrjastrzebski.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LubSoft Games", "support_website_url": null, "website_url": "https://www.piotrjastrzebski.io/project/dart-racer/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING"], "has_in_app_ads": null, "inter
ontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824560_1379170847160859_8361431554603010367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baV47hLWKj8Q7kNvwFelKMp&_nc_oc=AdrLhuZK8dkUXolZYx-8FZ6BEfParc_lrv2zy685piLvtf_7loohh30oQIu1gZPA3H0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgQzs_ACPBEsd3qXiCGgDnFrCZolPHt2TCaDaThDoZMQ&oe=6AF481F2"}, {"file_name": "vlcsnap-2025-11-21-23h55m31s836.png", "id": "867947609028129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_867947612361462_4368899613814278154_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZUvVXxtipkQ7kNvwHS0PEr&_nc_oc=AdrLz2flrOAODRiwsEGMMPy2IKXPj-Ool8LEsW2hZGfFJBfBuhCt-Svi1WfryNNIW2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5vOodykaQbgZ39afXbvm0bHkz_Zc6hWRTud7H7TISgg&oe=6AF4731C"}, {"file_name": "vlcsnap-2025-11-21-23h48m14s951.png", "id": "771036769322017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_771036772655350_2365248303990898417_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4BV48M2eigQ7kNvwFNF9cm&_nc_oc=AdpitABizAn13fX99xDd6bhhLk543joEpJYoEi1ElWS-Ta8iicNimn8vL0I0_Mc8f5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSErtSOUjBBCLSToYD06j8wVjFoEmVUfv-rko0pyD5z1w&oe=6AF48FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-update-header.png", "id": "804058618254459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223485_804058621587792_7836461228791862435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K7QwqutSF0Q7kNvwGNBivg&_nc_oc=AdoODDWv03_PxoTpyaxpShhfAfBED_OfINT2kCRaQF_eR6Uzuu1JI7Tc74q_mpkM_ak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3NO-gdDefr9RwhQBuC1fG695cKSXiJReHSlW5hKxsig&oe=6AF46DDB"}, "display_name": "Dart Racer Demo", "keywords": ["scifi", "hover", "antigravity", "racing", "flight"], "long_description": "Dart Racer Demo is an arcade racing game set in a futuristic galaxy obsessed with speed! Master the controls, fine-tune your dart, and compete in races across a variety of curious environments. \n\nRace in Galactic Cup!\n\nJoin the intense championship races of the Galactic Cup, propelling your career forward and unlocking new races and darts. These thrilling interstellar competitions test your skills and push you to outperform rivals, offering a competitive environment for aspiring racers.\n\nTune Up Your Dart!\n\nUpgrade your dart to meet the challenges ahead. Enhance its speed, acceleration, boost and handling by upgrading its components. Continuously optimizing your dart's performance is essential to stay competitive in the Galactic Cup.\n\nCustomize Your Dart!\n\nExpress your style by customizing your dart. Choose from a variety of darts and freely change colors to make it stand out on the racetrack. Personalize your dart to reflect your racing identity and showcase your creativity.\n\nMaster the Controls!\n\nBecome proficient in the unique VR controls of the dart or use more familiar flat like controls. Master the intricacies of managing thrust, boosting, and executing advanced maneuvers. By honing your control skills, you can navigate challenging tracks, overtake opponents, and maintain optimal path throughout the races.", "short_description": "Dart Racer is an immersive arcade racing game set in a futuristic galaxy obsessed with speed. Master the controls, fine-tune your dart, and compete in races across a variety of alien environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.piotrjastrzebski.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LubSoft Games", "support_website_url": null, "website_url": "https://www.piotrjastrzebski.io/project/dart-racer/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "45978
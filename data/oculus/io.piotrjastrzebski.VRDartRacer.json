ontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824560_1379170847160859_8361431554603010367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPtTztiz1ukQ7kNvwH5MYIF&_nc_oc=AdrRsP2DwWk0tmGgkjEEzy4tPGr3fY_q0xTm_9D6GWqM90pvZyd5jzOBi4jje2RPLUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGosrzYiE3-AxN4EBU0FTcniTPWOnElGMRnMVp-Ef8Zg&oe=6A677172"}, {"file_name": "vlcsnap-2025-11-21-23h55m31s836.png", "id": "867947609028129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_867947612361462_4368899613814278154_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFfaP4rtdXoQ7kNvwH7xQkK&_nc_oc=AdrVt8WLtwl3LREGHc147yotPDydMBpGcZUXtU55jvc-_AkIfNbDmjA887rn_fjxuSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAT9MdhJICery62Xrg6TdsUiaAt7ltUGjKSvMnb6LnBg&oe=6A67629C"}, {"file_name": "vlcsnap-2025-11-21-23h48m14s951.png", "id": "771036769322017", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_771036772655350_2365248303990898417_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp8i-j2Ma1IQ7kNvwFW1q9p&_nc_oc=Adqmkx7cx3sfJDq4ZbF6MqJiz3Sx2NsktgFLbhcYG_jKVjAMjOydG_i3xpG5LHRtt-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpmCF20Q4LYPGp7bmkCF4pzKkFnIvJBQVk0F6xtLfWYw&oe=6A6746E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-update-header.png", "id": "804058618254459", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223485_804058621587792_7836461228791862435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h233Z0YwnvkQ7kNvwF83HBq&_nc_oc=Ado0YBUQyYFIAm-wBWBGq5w2f_mBnxsUrs9Xt5cW1IxoHxIxTzhI0YaZDjRbWMOa7Kw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1ME7mCEJHxVX1HTd2t46i38aBN3CyqbWH-aj85dl5fA&oe=6A675D5B"}, "display_name": "Dart Racer Demo", "keywords": ["scifi", "hover", "antigravity", "racing", "flight"], "long_description": "Dart Racer Demo is an arcade racing game set in a futuristic galaxy obsessed with speed! Master the controls, fine-tune your dart, and compete in races across a variety of curious environments. \n\nRace in Galactic Cup!\n\nJoin the intense championship races of the Galactic Cup, propelling your career forward and unlocking new races and darts. These thrilling interstellar competitions test your skills and push you to outperform rivals, offering a competitive environment for aspiring racers.\n\nTune Up Your Dart!\n\nUpgrade your dart to meet the challenges ahead. Enhance its speed, acceleration, boost and handling by upgrading its components. Continuously optimizing your dart's performance is essential to stay competitive in the Galactic Cup.\n\nCustomize Your Dart!\n\nExpress your style by customizing your dart. Choose from a variety of darts and freely change colors to make it stand out on the racetrack. Personalize your dart to reflect your racing identity and showcase your creativity.\n\nMaster the Controls!\n\nBecome proficient in the unique VR controls of the dart or use more familiar flat like controls. Master the intricacies of managing thrust, boosting, and executing advanced maneuvers. By honing your control skills, you can navigate challenging tracks, overtake opponents, and maintain optimal path throughout the races.", "short_description": "Dart Racer is an immersive arcade racing game set in a futuristic galaxy obsessed with speed. Master the controls, fine-tune your dart, and compete in races across a variety of alien environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.piotrjastrzebski.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LubSoft Games", "support_website_url": null, "website_url": "https://www.piotrjastrzebski.io/project/dart-racer/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "45978
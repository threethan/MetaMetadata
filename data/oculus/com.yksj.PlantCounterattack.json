pJZEp9qiQLzAI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi6YTt5TVGrbyH4p65VP-RkfEZ-7E35gV-9zlE9TtvQw&oe=6AF9C09A"}, {"file_name": "\u641c\u56fe\u795e\u5668_1765378138523.png", "id": "1548665146447426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618093_1548665149780759_5077362879917091309_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CazAhhIAqscQ7kNvwFT82fx&_nc_oc=AdpSRYJqSg4S13L7IFpy9fOuOVoseXD8i8u-sdmSg2xKlLsoOO5oaR39hnFVgVuuqvk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg761RL4QHRrRzHjRZxxpUlbcYr0j3blcrQjhONMNFRQ&oe=6AF9D2F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762-\u6a2a\u5411.png", "id": "1350111279744544", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_1350111283077877_4625953140292731673_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYUYMpUrtmEQ7kNvwHvtWaa&_nc_oc=Adqh_1VtmaTT-Cszg2QQVVErC7wJkLt5attUjiRniKFHd9agPaLo9UcaIg3e_09qShg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHzPWJUFGCBp7jOeQwIYzzX_npt9RBPKX01Lag0glO_g&oe=6AF9CFA7"}, "display_name": "Plant Counter Attack", "keywords": ["Strategy", "Zombies", "Casual", "Plants", "TowerDefense"], "long_description": "\"Picture this for a second:\n\nYou\u2019re not just staring at a screen watching plants fight zombies anymore. You are actually standing right there, inside the garden.\n\nThat is exactly what our new game on Meta VR is all about.\n{1660212814946052}\n\nIn this world, you\u2019re done being a distant 'mouse clicker.' YOU are the last line of defense. You have to physically reach out, grab seeds, and bend down to plant them in the dirt. You\u2019ve got to spin around to catch those energy orbs floating from your sunflowers.\n{866476565753993}\n\nAnd when that massive wave of zombies comes charging in? You might find yourself planting a Potato Mine with your left hand and a Peashooter with your right. It is pure, chaotic fun!\n\nThat intensity of having a zombie right in your face, and the sheer satisfaction of blasting them away\u2014that\u2019s an experience you can only get in VR.\n{1172875751604625}\n\nSo, strap on your headset, and get ready to defend your brains!\"", "short_description": "Stop commanding from behind a screen. This time, Plant Counter attack drops you straight into the garden.\n\nYou have to physically move: bend down to plant seeds and spin around to grab sun power. When a massive wave charges right in your face, you\u2019ll be frantically juggling Potato Mines and Peashooters with your own two hands. The chaotic immersion is absolutely addictive!\n\nThis is the ultimate stress relief only VR can deliver. Strap on your headset and defend your brains\u2014in person!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.yunkevision.top/", "developer_terms_of_service_url": null, "publisher_name": "Yunke Vision", "support_website_url": null, "website_url": "https://plantcounterattack.yunkevision.top/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25387836150874429"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "4681829358807274"}, {"status": "PUBLISHED", "id": "972840052042015"}, {"status": "PUBLISHED", "id": "3978746402426421"}, {"status": "PUBLISHED", "id": "1672786927057978"}, {"sta
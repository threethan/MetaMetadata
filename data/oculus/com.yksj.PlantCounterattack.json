ri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618910_874172775477219_5949800747729815628_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_doU7xM_FkQ7kNvwG7fBn6&_nc_oc=Adoge3BZQyV--z5cbPJB0zTss9U2eHCJfdVWaVSimke2qX2B2sTcl0pJZEp9qiQLzAI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi6YTt5TVGrbyH4p65VP-RkfEZ-7E35gV-9zlE9TtvQw&oe=6AF9C09A"}, {"file_name": "\u641c\u56fe\u795e\u5668_1765378138523.png", "id": "1548665146447426", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618093_1548665149780759_5077362879917091309_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CazAhhIAqscQ7kNvwFT82fx&_nc_oc=AdpSRYJqSg4S13L7IFpy9fOuOVoseXD8i8u-sdmSg2xKlLsoOO5oaR39hnFVgVuuqvk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg761RL4QHRrRzHjRZxxpUlbcYr0j3blcrQjhONMNFRQ&oe=6AF9D2F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762-\u6a2a\u5411.png", "id": "939427545263168", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619098_939427548596501_2953133012592337894_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oD3ztJ5ExygQ7kNvwGJzgdt&_nc_oc=AdoxZ5oBoqgiLoKhh83V5CchX1zwEFFnBGsEKN0gNUOGQxiuoUfKv_t2k2XpLr2pIXU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXKLU-06nqCApCWt42qxwZuyKbrNcAUUtNN3doKFKxPQ&oe=6AF9E307"}, "display_name": "Plant Counter Attack", "keywords": ["Strategy", "Zombies", "Casual", "Plants", "TowerDefense"], "long_description": "\"Picture this for a second:\n\nYou\u2019re not just staring at a screen watching plants fight zombies anymore. You are actually standing right there, inside the garden.\n\nThat is exactly what our new game on Meta VR is all about.\n{1660212814946052}\n\nIn this world, you\u2019re done being a distant 'mouse clicker.' YOU are the last line of defense. You have to physically reach out, grab seeds, and bend down to plant them in the dirt. You\u2019ve got to spin around to catch those energy orbs floating from your sunflowers.\n{866476565753993}\n\nAnd when that massive wave of zombies comes charging in? You might find yourself planting a Potato Mine with your left hand and a Peashooter with your right. It is pure, chaotic fun!\n\nThat intensity of having a zombie right in your face, and the sheer satisfaction of blasting them away\u2014that\u2019s an experience you can only get in VR.\n{1172875751604625}\n\nSo, strap on your headset, and get ready to defend your brains!\"", "short_description": "Stop commanding from behind a screen. This time, Plant Counter attack drops you straight into the garden.\n\nYou have to physically move: bend down to plant seeds and spin around to grab sun power. When a massive wave charges right in your face, you\u2019ll be frantically juggling Potato Mines and Peashooters with your own two hands. The chaotic immersion is absolutely addictive!\n\nThis is the ultimate stress relief only VR can deliver. Strap on your headset and defend your brains\u2014in person!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.yunkevision.top/", "developer_terms_of_service_url": null, "publisher_name": "Yunke Vision", "support_website_url": null, "website_url": "https://plantcounterattack.yunkevision.top/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "258434854319
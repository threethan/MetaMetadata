cdn.com&_nc_ss=7a30f&oh=00_Af0FFuq8D0rVPTgTwOWpGL5AkgKFqMbe1X1UqHKaKiThLw&oe=69EB641E"}, {"file_name": "Screenshot2.png", "id": "563867240000917", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_563867246667583_8964408090017840408_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qe-nw-mevfsQ7kNvwGhvUoq&_nc_oc=AdrDdX4yKL7IuvqbvjbagiY1xbDBBAnrDcSsoaUEfWsasRb_FM1O9hh5KNAfpxBjxBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KbGfCc6EX_uLnj0WuB7FXNFR2uqpU6HEFaxlSzZDClw&oe=69EB65E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ground Taggering", "keywords": [], "long_description": "\"Ground Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of \"Ground Taggering\" is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "Ground Taggering is a game where u use gorillalocomotion"}]}, "developer_name": "Asteroid", "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZDLcebNAZSWR3SdpqsRvUWCCJ3OrSIba2l_D0vJRNKA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Asteroid LLC", "support_website_url": null, "website_url": "https://html.cafe/x87d87776", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
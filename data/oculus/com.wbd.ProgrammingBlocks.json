680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsS9AOPiF50Q7kNvwF0J1Mk&_nc_oc=Ado0Cq3djJrDdzGwVayFjSXmqHKdumpt354jYQgFEup2RPzqopwnx3KNKt6G_WqLbbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B0_8HJQ9G-tbOG9hgLb-sWAonOzeLEQhSf6T5qHKWXg&oe=69E0F452"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxKDDH5rZboQ7kNvwF-lXQZ&_nc_oc=AdpCzMJNjCIQfZIJjfIkcQxXOreS9-wl8wW22LRA1vIy3z8ZT9gdJNWDSOpSOs4FLzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rgOqqbgHh4PlOaT5sTkjzq-HBNTmlczkK_FdS2wLpVA&oe=69E0EE6F"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt2bix4GGlMQ7kNvwFG270T&_nc_oc=Adrf4CmygJtgM2i2q-x6FTXrhO7M30hhCy1MO8QhMPDNy-YQZf-CBD8he3M8hzLr8_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S2llbqmtYOkbceu6RfQJku5R8m3Di1JgCMVemGeVHNg&oe=69E0F9BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o7cZHqcpk0Q7kNvwF0rYXQ&_nc_oc=AdqoF65rcAWccfW6EocZp5WtIf49yCLudHkSsN-5dNyLh6vd1SFyIlIzD1GTTEfSWe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bZa5FTEsHy_Go_BLUADBo1toxoWtMACOO903AXuH4YQ&oe=69E0E67A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PfM2pIZ2WAQ7kNvwHoMvS6&_nc_oc=AdqeNaR0VQMiOHmpPUautNXFOHnhWG87lllNVHaLWKrEacHDKT9PVmCa2G247leNdLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7
320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR7UKJC_jBkQ7kNvwHO9MB3&_nc_oc=AdnoEMdsl97Ow53FCo-EtOuvaZW2xVx--BbsCeIJxXswyVY4GsFfz2p4-2psBVqmzn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3dTyqyh-VRZ2rHsCcxt-FHaLYS8byNFO-kwczdxRh7A&oe=69BC0A52"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UveS_r2tWkQ7kNvwGofbse&_nc_oc=AdnsSx8D6Bi7X_Xo_LlD-Re2qS1Blxxiy0L05grGXEI9i8D1p4DBMJyhx6oJQMV48WU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwAuGH-JBQHjZtjAxfK39ISvceFQyt7e9AINme7zdsH7g&oe=69BC046F"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feiGurrJ2UUQ7kNvwHx45uk&_nc_oc=AdmeAb9jiUTyrMLKfZdlvO0m3FDRnfs2el8ZW2zKlitKlwaHH054LTNXwCGAitRo-cY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBoatUGDO5mOXRRlna2LF7_-R23pCPimyNtQYwdzMf9g&oe=69BBD77F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7l4q5i3ingQ7kNvwFcGwFw&_nc_oc=AdkbfcB_k1NzB8wmRslLOnssnxglEe5VTbqbQ7_d8UmD8ijER0pESP4cDUboWS7Nf4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQzmctX-Y2PISbj7QwF8SmpHshPsIqlamXaalM4wIgyw&oe=69BBFC7A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxQt7-kqUi8Q7kNvwEPxRx5&_nc_oc=Adkozx8TzT71QDcMmEp7gr5rRGr8qOx26YUlPSCZDfcGoiRJ-7a48UVCUqpocN5fk-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyziCw03qvtmjhCOKzUa1-6szY6BqLefMmt95CVmGisT
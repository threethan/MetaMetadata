680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-2RxgouFTAQ7kNvwFz-yWC&_nc_oc=AdoS27uTiZfSuU4inUDwuSJaaszsdwIgwhQZACkakRbbVCZtxD5VjPGX_QgIUuTO3KQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDBRD4wMVI9mVtwARjYXko31GMdejYQbUopK394pJJRg&oe=6A940812"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91td1Hg_x6oQ7kNvwGtzk6A&_nc_oc=Adq1-8sA2EYsDLG1y2ma0wsb8yxLLk9TLgnkeq4bmWl_YLFge0CwAwNKzhk6tHCN0h0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm5xXn2WuUzylKiPCnlskzXApcANisQGQ5G5-ppSsrIw&oe=6A94022F"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-h4515dPigQ7kNvwEEoVeb&_nc_oc=AdowHi-ajBb5jmacqGoebOLf0PZz_n7a5G-VciTVhsc4PRCr5ui5Bt1aODJZnytutjs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC2Wf4MSH38qYSR3Fv43OUFwi5LfR41srQfX028bThlg&oe=6A940D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL5QNDlwSooQ7kNvwHGtDD8&_nc_oc=AdqgmgIis3fFiKgXyiopcfTfH2PE0cORWEPq3gh9c3jUqvwX4hfrLCE8zNv_KRtma3Y&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRhrv6qVANt87c3KsNewCGcevgmvRDKPal-rlubv7cew&oe=6A94327A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn22tv-U8j0Q7kNvwHFPCK4&_nc_oc=AdqpacP7LVSnAvfbJ89z4ZvB0DZ9zsvOA1zCBOS7CbR_L4C_Cn3kjVRtealyc05FGfA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7
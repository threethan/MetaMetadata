25/57566680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIkuE6MH4qQQ7kNvwF3MLwy&_nc_oc=AdqxCFpIP8UO67PDGBpOVnNd5oINEExO5T38JoNeibVFelXpRxbBMW_B1TCqe_6R93A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtuOPS0_i9LiHEA5XDa5lSUJAIsjN5aLcZjoy-OM03qQ&oe=6A7D9E92"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJjMuVWH2z8Q7kNvwGosxGK&_nc_oc=AdqRmGnxHQhbk9OE_7HjPEbRsTbpx2xw3sqWhqzp23QVQ9MI2NTNcje2z4XtpitJ6Jk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz09a2cgNIyLlg2LbidOMT20BwFoyBXJlRZVsxeTDgYg&oe=6A7DD0EF"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsaFmLe_RywQ7kNvwGMIWLE&_nc_oc=Adp0PER6xIHr7-aFVm_EX4wnhesmP8uta_zRPNRUvZey57ih311Ga7V528O8RmJzX5M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo3siYoI_FLdqGEG5pB5NDtwtJb1jMvbHeN0aktBJakQ&oe=6A7DA3FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1NrQEbxcbIQ7kNvwGBmdS9&_nc_oc=AdoHICsxNPGkJ5x2LQk87E6RQOAJW1j1QJ6w97P6UIfZK1cdrm4kD4ZO_Fsm6lvUlmk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErUMv_4MXOD_VaNoWSkA0CHfXA-82t4JCUlraDsvX0Lg&oe=6A7DC8FA"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29rNQ13ynCwQ7kNvwGpdNu2&_nc_oc=Adqe-lvD2RJ_bEtHZ-HN1TnRrzYttbLGHB0fOT6puo9f3g4fagmLVR02_P-rHJQ42g0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.co
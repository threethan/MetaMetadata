680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhQcjxDwOIAQ7kNvwE7B_om&_nc_oc=Adpr0DMxFFHiFmvtvgWcpFRqB7mLEvm-5S_JmMl3JKi58jlT0RSh1c5keYv0pkimDk4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zS1v5I6PH3pcxrQv3Y2vM_iKw3hCbL4vbw8rCpYZWXg&oe=6A32B152"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ntb2Y8d5oIQ7kNvwGQl_v8&_nc_oc=AdoD5-Phl3lZUwoRllE_yxJKB6txeYEiwFCFII7Crj3wNiFDvnDs5o9wrnlNFwy2p0Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U2wvgoo4G9E6NhBjTJNGI7uWR8YS_DloN-6z0kQlj9g&oe=6A32AB6F"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TujWKf-fPoQ7kNvwHqije2&_nc_oc=Adr1TIwYR_1C0nUcIr9N8CjhIS3x4-ExfMKAGtWjDsQsplberXrSJcOOKEyLEP2_jsM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mai8i4vQRLIBwRMkLA-aaNzQAGnB4xnd2tLV12Zl2Bw&oe=6A32B6BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6xUQpkxzvMQ7kNvwH_GBLx&_nc_oc=AdpetHLylmzP_Kw_zjwtSpfO6CTr798TKdtfrxh6L2ELkH9yPWiEUtIN8XHdsjm1LmE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BNaOSPiw6dvpIGYlFT12UfONiqDM0Ch8T_BTN7bcy8g&oe=6A32A37A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1vOU31siLsQ7kNvwEYeMCG&_nc_oc=Adrx_Hu-2KqhKdieINWmEUvEZSEGLi4pImGrNq0XPD3Ct9xuvU_w4bCEYEyx2qZopt4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7
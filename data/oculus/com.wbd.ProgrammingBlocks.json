320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMfLEWGAcG0Q7kNvwH_GgAM&_nc_oc=AdqYb6QDS4AtnR-H2ImFr7_J2gbvkTFBvUnyFemcK2GY8K5yw_UpMqCzBxNS7ShkKNg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy1mI9VArqo6WgVaxBdVqQ2Vde80WHK6BNWSJHKY4AJ4g&oe=69C15052"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O5qw9Uli64Q7kNvwGSVugr&_nc_oc=AdrLq4kghCJGGbMjmnRvEz6uw15pA9wv2gX_2_SNleD573Yee8Qhw9CY7C1Brc5avs8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCv6WFg9YfdAWPe__Wx-0Ea6HvwSmmcxRyFctMb1OLAQ&oe=69C14A6F"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUVwUWCEE0IQ7kNvwEA5skM&_nc_oc=Adq-6-TGHXXAIPPciPsiDYhW0Xj0QGdvMPLO5gzCDxXB1dnawlOWwtb9Wjj-V8fXcgE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEZY4M0d0V4lh_BqXktgwTaYJL7nmNpi7l6vBOQdE2TA&oe=69C11D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NgYl9adtGwQ7kNvwFU2jyr&_nc_oc=AdrfZisdnMzMXiQ-j4HXj97hVtDDjpIVG3Uc0_ZbpGgpicpTJflw1IFIMz_dXQNe-T4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfySxGZfTgzEYtcYIVmrDHtBkz0sjXYwyDMoGJq1Mbne5g&oe=69C1427A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq1DHSbTdhcQ7kNvwFCLmAa&_nc_oc=AdopukS6-VjQAkiPFnItuOCWxu-7xHCFM0yiVL65_u-7hHpDFGV51ft-S1huezOzfrE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKoo05qgDrVzfiFE3RVmPzNO6yMNI7PsdAQG2bCenlv
680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PNDV2g0SJEQ7kNvwEBgVeS&_nc_oc=Adq2rTmbY3FlBgR655rAAOcPa0IcFMYJECAoo-QYDWRsReK--bcIWBlBUSKzH4qM6yc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmIZBHZCciJLPJon1uboeJjabQgYm24PxTXS2Mm9RejQ&oe=6AE9F1D2"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvMF7XBBBIoQ7kNvwHPToCt&_nc_oc=Adqs9WGn8QXzJ4I_wkBaUHV7oBfnQ2WXQWXJIoFrPbT3JahpZbjg2kqOjnu479J4wEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRisxCFMD-GteoTYZzlrigQIkZr7h9zzfubQ47qNRT70w&oe=6AE9EBEF"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFFlhBoZFhEQ7kNvwGsC2xT&_nc_oc=Adrq7mJFJNgf9GJrw-CN-akzxyJVu5yXNnfrA9tsv6UcyJlIC0CKEEYPclO4kQE0eVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdzVFF7y8NwuxSp0JcKnO8o96iJ0lgVkmxb5WSFIuSDw&oe=6AE9F73F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03pA7R7dBT4Q7kNvwF1t91U&_nc_oc=Adp7wAZBAEgp3Yy5EmvU9SjnihFhHdyMXKbU8UNeWk0XmQovjZBxfEVjOMLeajmDoyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRoGutPl1Jj1Ub23rWuJc1o3SfdFfDDhzcD_xajDR3Ig&oe=6AE9E3FA"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFNvJPD46hsQ7kNvwHESzbd&_nc_oc=AdojNxAOSX6jE_D9O5sOCtCiI9KSP0fo37QwskiFusDzMNc8dnmI1loBhw4732SmQEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7
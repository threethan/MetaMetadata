680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY6kwnMPiMsQ7kNvwGIStwb&_nc_oc=Adobj8vlf1MogzZjSfODmytuzpf9PF2hPJ4wkOPox4XY4S1Nsz6sBmYcSd_e86oR9sc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi79UBbovUPL9cc1-DWJoPLjsRd7dtttP2w4mzCMbIlg&oe=69D12252"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWAJWJ9LDsYQ7kNvwFUX3-z&_nc_oc=AdrXNM89X0Im5pz5eeRmJSdh9bBImc6b6P72QcOWtyzz_DnwnqCkzKbpk_0REd8F5xY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxH_t1z-pQzUAbHdpSklqPeapzuiYsjVho72mNym5550w&oe=69D11C6F"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJRH828H_GcQ7kNvwE_cvGm&_nc_oc=Adocz9VqaC-LXJuhgPlmK-tv6AKRpW0jpwJJKKQxXSvepimJ0bhK6acQtqh_xakKEuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwbBYhAcBhhMSRPURpUHnU15doqX_HW61f6DrsAAFKoA&oe=69D0EF7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzwXFg8c1T4Q7kNvwFuwuS0&_nc_oc=AdpzPP9350OaPf2LyQLAb_I6HXbC10pNjs5HV2EtDXjhj4-KnFGrE2QpZbM9ez1w7D0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8L88YVxDquzn4oJ3ulv9jplxnDqXra_SQZKL8riz0mg&oe=69D1147A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJ-jf3eLIB8Q7kNvwGOzIRk&_nc_oc=AdrM9v1hd1yIGPO8upONopekKwI7kM_SFND8Xsv1Z_-lrsdEGZYxeJCIrbJOOsVhKas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7
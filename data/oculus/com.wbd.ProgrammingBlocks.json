3043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsIKZVbIXNQQ7kNvwGgpLd5&_nc_oc=AdpxbnyJZMqelJbaUQ5rh9ZjmCRIMby6LdtQMecYCfllAD7dRGY_VeBitZj7bvEJNFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2JOFfkdAZJoQRT0oVf217Q_RX0hjqbCnnmzYOgYZp3xw&oe=69F0CBBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4Kgqqo52lEQ7kNvwG4KE-1&_nc_oc=AdqR4_6tmy1xFWpbnsyKEenH8pD_wXwnAE2AJ76BRV1NT8i7Xoa5o5xNO5Nbfkpj0M8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3gPAghIdrGV7gWogdGhgrvztbBRE9thH-jTO-LAxving&oe=69F0B87A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "co
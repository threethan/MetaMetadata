680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ9d1jjhEvEQ7kNvwEJqg9C&_nc_oc=Adotqx9iKU8bhtjqYLFDmR0W0fiEmqoOAy_9V-7pAVyK99eM2kNcJmhVz_ZI6Zmet6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkI7i61tgvQwtx2Y2d6bqnxclA_N2VaqW8ysRneBKjkw&oe=69CA8AD2"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUdJSKZAhJ8Q7kNvwFLB2KM&_nc_oc=Ado6pG6SgHZHmhSEyqYZ0d0Erv52yywigY5ACX9Sm-tCfHYE6CD36IOh9AZDorwmJr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4NiGpb0YBMcCjHPcEWrHsQEhb1oOgwMrhj5KqdEjc6A&oe=69CA84EF"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QdvhnerBJIQ7kNvwFqQNXc&_nc_oc=Adqf5FklZ91cJB8Mi5H8lEYJPpYNSS_Mlc_9kQxtlGsz17Bow12QxHDqtdrsQlLCeww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQujtVHtIL6aK5NMKZIMB80SVyq-bqGLG4k4uKdGwrgg&oe=69CA57FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVxhXRnW9DoQ7kNvwG79ukR&_nc_oc=AdpzczQjLqH2wmHM84WuQXwsNbXD6sl15An7e3oxmw5_P0hwOe3-xNO5CLYQxm7PrRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycT5jDd2HUnM_39ZiO7sGitF7QJmrYedYLAAz8GxxySQ&oe=69CA7CFA"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMkFTW_GU64Q7kNvwGrNvcc&_nc_oc=AdpLqpGk1T_yyjzKS5PLL1QCmaEy75QG6IRcjCGlIVrTotxiX5fr0tg2kjF1n0q4sNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7
320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXAW3idmWqYQ7kNvwFBbMc4&_nc_oc=AdnrXWYSkPqSbPKNzm2LQpcSo-ku5TOu2KgP9EsPUuSnw3RMu4RMTh-J_Rwc8JDddeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxgHQjUVKRA0PllBYMlCnju2jfAN-wz1QKw5JnEbBEZg&oe=69AD89D2"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o49ki4jVHT0Q7kNvwF2uxm6&_nc_oc=AdngcLpkNe71Qlk1lsibZSkUZ-n6BOE-ewahPndbNfg_R06WBHUKBm3x_NfMr1V56jc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0kCcVjGoUukJCWd-qtKNKGRJBgA9IVMBXT9j5ocJk2g&oe=69AD83EF"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWEYaV6_ix0Q7kNvwGqagHS&_nc_oc=AdmaIk3cDSrL3JUbNg4aPHZa-5HLxdhjB3ANFncfYziamWYn-5R0j0FSsTjvHZLvle4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykwVq40iItAqjbylZPV6tZlxg-Jtf8o24HSvj79U_gxA&oe=69AD56FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mnx6F5J53sQ7kNvwElQ54B&_nc_oc=AdnavC2HV7do7Z6OBWD_HiDlD-EzSCkQawnkzmuGY2hZHQn8LTqvNCU03Q-yVHOJEqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3NIcfM3DkyntaWL_Hff5wKfLjGiTqWfM7DMdkFZsZQQ&oe=69AD7BFA"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZDqYcoxWAQQ7kNvwFlCOwr&_nc_oc=AdkpiHM9RnkosOj1nuRyCX70OGTbiqSclUCbxtEsvcxqwHbZVDkQMnNliVzjQukpcZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMemzhoNwCJ9riqMDt7cOYOMKxWhECzbxq2MUCvrRT-
3043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdmbg11T1fMQ7kNvwH0xrIL&_nc_oc=AdlzMqFYivWmBR8MyorZGsIRTHSQrr7HQIukAZulVpnIq9zRcC4TVp__EMfY1KB_0xE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvu9VpKFSAdo8BVWnqK7k5nnFg6VpZF8hyDMbAqOzT7zg&oe=699C337F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H50kNMYcMfYQ7kNvwF_qxEM&_nc_oc=AdnkGfQtn-lRA9u7_k1AP3FGLf-nTzLZDjBT8xwcyH5Ml9tHNL_XXIGfXXyc1PQ2qA8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvj2g6SEoC3Zv1KQd0engeawJ-0ri7AcXzjjpz2ybXGKg&oe=699C587A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "co
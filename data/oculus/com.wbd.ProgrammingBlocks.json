320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyuxqm36qEMQ7kNvwFFSs6L&_nc_oc=AdnUb3w9kPS9H5n0Tzk7DDYj9PPo7kPboozbjQhydnAJ2MacQ3YtESoVkiOljLEWWQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRccUWFKwH8hHiO1FbDZtWc_icnu-r7fFuximMOU1HTA&oe=69AC3852"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o49ki4jVHT0Q7kNvwGk9GpX&_nc_oc=AdlmGC5wluT2bQfiGlxicUu0mUj4XDRbfKphOE_fv_lE3niztl-DXNBBJRe-QWos3WY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afys6PbxPCgXc_lRwQrgkrqp3D8rWLT3BtiY02XHDV2XnA&oe=69AC326F"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAGTYXP3l1wQ7kNvwH_Tw6B&_nc_oc=Adnfm7VJi_5Fsd_wakxOiLdzVgoK7hy6cQjWW5YJQuylygnDdhrwC2m2zUJ_qBHS_GA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoA-gQ6cQQ8qy2NVtYoI3fug5FbVLsHNIX7sR92gS5iQ&oe=69AC057F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mnx6F5J53sQ7kNvwGcvdmK&_nc_oc=Adl5d5gNDRfheUV4pqmg93QpEcFoPR7AHgRcly9ZYErpKU6Ta-Ktd4KFS_ijmNa0XJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afym1TzDr3sjiSy4Gp6HEh1xv38VUhTPsItC6AXB_OSQpA&oe=69AC2A7A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZDqYcoxWAQQ7kNvwHGdlgp&_nc_oc=Adkw1GOzfC7k3P7EuwXkpxuEbi_CHVvbcxmLZSX_Fd9_8PMoE2uGpNRYWp4uc1oEvbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKIIX6ktM8p27MtFUASHlGy9wiJ_uiNgwjMAwHAUNeg
680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Fp8qEdFVbwQ7kNvwFJ-O1F&_nc_oc=Adp95jMIZl1paZddo3YddsOlHbmChE3DvRoNjnUTY4Kztdj_S7eIwesrb4kWDqcSBDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIGhYAlLL7iE7_1BXy7BAVqbj-PmaBiuNCJOwgYptCpA&oe=6A8C1F12"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DwZ2K80pqMQ7kNvwEYv7XX&_nc_oc=AdrCXW5aARTw51BvcgPViudX-WCOdcRuHROquZpg1ThWx7mQ01hfD_Nk9d_wWbK-ARo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSlVrmNGzV8VolngE7qVQnjUxMeBPJAxLNdSyrk15qZw&oe=6A8C192F"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fut8aYBPNyMQ7kNvwFQCkMr&_nc_oc=Adp8jwtSCGj6Oikk5OMqy30cNThJcxYYcwomJUdy-6pDNovUouVJr62c8QMhGuFWts8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZhGTAt2RC5kBchoEwnS8momVs4Kdg8Cg-bJ12wvsBNA&oe=6A8C247F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLXWrOwDDusQ7kNvwHCyVVy&_nc_oc=AdoQkFXOZOvLF6pyxokqlMX6vQdZo7kmcPPAzA4C9C9QU_IXnFrbhQVUHXrTCfXtYbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfrBur7ozKpV47HhLhE86TYv1ltArc3Xsevdu71pzGFQ&oe=6A8C113A"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOFn_vXZx78Q7kNvwHk0tSz&_nc_oc=AdqPTHeLbf9bgj3sXGYPnG_9nS-NukyfEXow55DEOx-sXWD8jMAOiKe0eEbAbaGnp6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7
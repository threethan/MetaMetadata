Qyzhj8WvCmGgFBTLePr49VNmM3zoToI_KTvw9h5ygA&oe=69BD55EF"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDyf4k51yagQ7kNvwEKDnol&_nc_oc=Adk7GF33Jve1yvLgBwPqTTc1jct9H-5yMVocqSFm-BhtoXQY0j_fjdxOVpXvyM8DiQo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyn6Y5Tt4CY-lRDtNzRoh2YvQpc1yO7SuJ0aGgabO0orw&oe=69BD613F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7l4q5i3ingQ7kNvwHmkjyz&_nc_oc=AdniMBEnfu8w2nicjM08dAc868128sIPR1bWQK4XiEDULS6Xzi2Z9Rf0FyoErCptI-Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYJsFIIbDWmV8UYAQ2-nx1vpmr3zumzetZL0WtaFrDHQ&oe=69BD4DFA"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "p
25/57566680_491930737200506_5899742456741554320_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYSMThyQZbkQ7kNvwHfvAQ8&_nc_oc=Adp9yiowsUcJ5To-jmUSzmIMtPd9eDo7bTgTD6YZK_pAMlzUg_nvChtSJH8RI-YRmV4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LGFd3O3f0eREgD_VbFUtYUMyb5pNMb6DXEYvabJrtmg&oe=6A11BBD2"}, {"file_name": "Screenshot Grab Puzzle.png", "id": "1234624671195060", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974796_1234624677861726_2130454897462651062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HPIOa-mNtAQ7kNvwEVR0o2&_nc_oc=AdqgQnRujdbXzt-fRdG_GyT-MWgYJATEJJN89B0wqwKBmKCSqbEx_mv5zGBU8_sT32c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z-GYpF8t4VM4e0Uu8Tegt-NByexo_OQ9PD_P-43qckw&oe=6A11B5EF"}, {"file_name": "Screenshot Celebrate Clock.png", "id": "879519094355279", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982619_879519097688612_7810319093043780939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqptkJjgvgsQ7kNvwEdIbpX&_nc_oc=AdpnTwDdu2o9bNENC4ugInuI79DtwLH-VWFlMEEYIQGzESoWbI6OgfEoYk7Z7P61pJM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46ztLtddMq-uoeyNAoGYS_55GANOdr4YH9MigMyYinqg&oe=6A11C13F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art landscape.png", "id": "1250967939506360", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974786_1250967942839693_999329934183947626_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WWD0LILsXoQ7kNvwGO65CX&_nc_oc=Adp2RlxKKQlv11SbtVKZe3m_8uPXOshFVXRhnFWn8ma4NNBEkxGVZgp7ulNM7i1Bkqc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Aapi10nHFoFWvAZstqT5gcSG1IHbRFNlkOT5dM6JLKA&oe=6A11ADFA"}, "display_name": "Programming Blocks", "keywords": ["Coding", "Education", "Programming"], "long_description": "Programming Blocks uses an innovative block-based system where players solve real-world-inspired puzzles by coding in a playful and intuitive manner via hand tracking.\n\nThe app leverages cutting-edge Meta Presence Platform features:\n- Passthrough\n- Spatial Anchors\n- Scene Understanding\n- Hand Tracking\n- Spatial Audio\n\nProgramming Blocks transforms the way programming is taught, seamlessly blending the physical and digital worlds to create an engaging and practical learning experience.", "short_description": "Programming Blocks is an educational app that introduces users to real programming concepts through engaging and interactive spatial puzzles in mixed reality using hand tracking. Designed for learners, it makes coding fun and intuitive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wonderment.nl/programming-blocks-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wonderment by Design", "support_website_url": null, "website_url": "https://www.wonderment.nl/programming-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9231069666956737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75334058_3448193225487221_23543387683321961_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S2URWHiX28Q7kNvwFPZlGd&_nc_oc=AdoJJIyKVLsxVxdwMXBaaLm6o9dhWyesN7PgNy9kTCAXy1IY_xOaE67LBzWgTBKe8rs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.co
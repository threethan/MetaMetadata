merse yourself in the world of ElmonX on Meta Quest and experience the future of art firsthand.", "short_description": "Discover the future of art with ElmonX on Meta Quest! Explore our VR demo showcasing licensed digital collectibles. Whether a seasoned collector or new, be inspired. Immerse in ElmonX on Meta Quest for the art of tomorrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://elmonx.com/privacy", "developer_terms_of_service_url": "https://elmonx.com/tos", "publisher_name": "ElmonX", "support_website_url": null, "website_url": "https://elmonx.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24874673758844362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974548_1131511211354336_1456583880120457770_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggS_La80YlcQ7kNvwF6QatO&_nc_oc=Adq5nVWH893YiDR5jaknmwI20kjtBxb_HjwJBaS40M9Ue0PLqof0JDyTe5z346W2_UE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zr3DLWFJHO488zOySvssP2Lz4ci4n4XbgX7BmVfQ8Sg&oe=6A0C5E45"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ElmonX VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id
nc_ohc=pN4NMEfuaVQQ7kNvwG3nTl3&_nc_oc=AdnI9s1UkXUArahTvyIxjvlxJ6RVj4oCuEyL1z_T3uSadaxTL_kOxRc-G-WTLSE5mVw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoPiNB5dKVT_cZ4n80od72tOUrmxsstZZ6gVN1cA1aVg&oe=69BE8F62"}, {"file_name": "Applab6.png", "id": "4154744024802528", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392301_4154744028135861_9129005692679187276_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6xK_A9uZBIQ7kNvwGcRL5F&_nc_oc=Adl19hBLsvveHBjHDDYytRPjRBXTNNJvnC2xZhcOCstkyZl2JIUeu7_6v2LROUIolcU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_bqeXlyhOrqNxEV31Zgc4u6K0vKDoGoqzJrxdbcE-kA&oe=69BE967A"}, {"file_name": "Applab7.png", "id": "3508565082611358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394196_3508565085944691_2561939136513594266_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF348DgRJLEQ7kNvwHx7Gy4&_nc_oc=AdnCajr5Y9o0YMmrw_PRyKqwhTi9fXPBf909stgswrNScluUGc2dbbgC4JN0A3mWsis&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ24i1JKo4OYSrWAk_FTrEfyYkCjxWVIcBSqU52u3CsA&oe=69BEAC9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ApplabCoverNew.png", "id": "699102282568942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392129_699102285902275_481439372369507666_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2fKtgzi6ewQ7kNvwHD8ZNV&_nc_oc=Adko6jkopYeagfPd47N2tjabLgLxRoIGHxghpzCnp4kruXMminBLj3wDUPd_VYinhig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxL7HC5l4WCxKC-OK3zhkFQSbdjhZ7mkE4EynV-8dix9g&oe=69BEAC96"}, "display_name": "Rampage VR", "keywords": [], "long_description": "RAMPAGE\n\nA VR horror game where you fling yourself into pure chaos.\n\nSomething's gone very wrong in this abandoned facility. You don\u2019t know what happened, you don\u2019t know where you are, and worst of all... you don\u2019t know what's hunting you.\n\n**Rampage** is a terrifying, silly, chaotic horror experience where you move like an unhinged gorilla\u2014literally. Use your hands to launch yourself through vents, hallways, and pitch-black nightmares. It\u2019s just you, your wobbly arms, and whatever that thing is in the dark.\n\n---\n\nWhat to Expect:\n\n- **Hand-powered movement** \u2013 Fling yourself around with full Gorilla Tag-style locomotion. Who needs legs anyway?\n\n- **A monster. A very angry one.** \u2013 It knows you\u2019re here. It does *not* like you.\n\n- **Creepy abandoned facility** \u2013 Classic horror vibes with a twist: now you're the idiot who keeps going deeper.\n\n- **Tools, puzzles, and panic** \u2013 Use your big brain (or don\u2019t) to survive long enough to ask: \u201cWhy am I even here?\u201d\n\n- **Atmosphere so thick, you could punch it** \u2013 Spoiler: you can\u2019t. We tried.\n\n---\n\nYou\u2019ll scream. You\u2019ll laugh. You\u2019ll accidentally punch your wall in real life.  \nWelcome to **Rampage**.  \nNow go cause one.\n\nthose who know \ud83d\udc80\ud83d\udc80", "short_description": "RAMPAGE is a VR horror game where you fling yourself through a creepy, SILLY. very. silly facility using Gorilla-style locomotion. Something\u2019s loose in here\u2014and it\u2019s not friendly. Crawl, climb, panic, and maybe survive as you uncover what went horribly wrong. No weapons. No legs. Just your hands, your instincts, and a whole lot of screaming. Welcome to chaos. Welcome to RAMPAGE."}]}, "developer_name": "RStudio's", "developer_privacy_policy_url": "https://sites.google.com/view/rampagevrpp/home", "developer_terms_of_service_url": null, "publisher_name": "REALZ", "support_website_url": null, "website_url": "https://sites.google.com/view/official-rampagevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "
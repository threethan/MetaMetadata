.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMi41-c-iEfeh_mzh_LfHMtjgW44CfCeQh3-zn3xGfvw&oe=6AFB4329"}, {"file_name": "Applab5.png", "id": "1075460687754809", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825061_1075460691088142_5902356794825774467_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0Gffmrx3m0Q7kNvwEJGCpX&_nc_oc=AdrZyid8PQ8nSk5hYmkIZo0DhaoerKznj_yWBNxfFsZQp01CVBAvcHgLHvXBgtBSvhE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK5xofkZxi69RNy8CSCJ7_LwTBKnloVQFgifKPn6K8zQ&oe=6AFB2FA2"}, {"file_name": "Applab6.png", "id": "4154744024802528", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392301_4154744028135861_9129005692679187276_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxyS7YrtMcMQ7kNvwFdI0bx&_nc_oc=AdqkGMukzobVuf_4P9LScaAKEputJRoSEn_DQgPz4jbTqEHfY5X0hJNPJtcTAKc6G8E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1c6o7ldLPCkv239nFELh959c0nM2e4ajOt2eoT5zNZA&oe=6AFB36BA"}, {"file_name": "Applab7.png", "id": "3508565082611358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473394196_3508565085944691_2561939136513594266_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMbVaUYZD0UQ7kNvwFY42sM&_nc_oc=AdoR-BHhlePopWBLqr6K2u3QwnDKAdz3fcy_cslg7SDSp1ggMAz7bzssgH9YSRZ28UY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwjlMkciDhdNV9uaJCIdwRiCt3bfLf5O3tQi1W82rhzQ&oe=6AFB149F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ApplabCoverNew.png", "id": "699102282568942", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392129_699102285902275_481439372369507666_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Nvb6VbDkDoQ7kNvwFsYizi&_nc_oc=AdrJtNLXfVOg3RJHAv3ImwD_k8xE6OZ4SmV7AAdZW8xEp92KdbOB563-dBKJEcd7Nq4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpvk745alUyHmVAyoZsKE1bYmHA7KEKq8NC6CN-Mg1ug&oe=6AFB1496"}, "display_name": "Rampage VR", "keywords": [], "long_description": "RAMPAGE\n\nA VR horror game where you fling yourself into pure chaos.\n\nSomething's gone very wrong in this abandoned facility. You don\u2019t know what happened, you don\u2019t know where you are, and worst of all... you don\u2019t know what's hunting you.\n\n**Rampage** is a terrifying, silly, chaotic horror experience where you move like an unhinged gorilla\u2014literally. Use your hands to launch yourself through vents, hallways, and pitch-black nightmares. It\u2019s just you, your wobbly arms, and whatever that thing is in the dark.\n\n---\n\nWhat to Expect:\n\n- **Hand-powered movement** \u2013 Fling yourself around with full Gorilla Tag-style locomotion. Who needs legs anyway?\n\n- **A monster. A very angry one.** \u2013 It knows you\u2019re here. It does *not* like you.\n\n- **Creepy abandoned facility** \u2013 Classic horror vibes with a twist: now you're the idiot who keeps going deeper.\n\n- **Tools, puzzles, and panic** \u2013 Use your big brain (or don\u2019t) to survive long enough to ask: \u201cWhy am I even here?\u201d\n\n- **Atmosphere so thick, you could punch it** \u2013 Spoiler: you can\u2019t. We tried.\n\n---\n\nYou\u2019ll scream. You\u2019ll laugh. You\u2019ll accidentally punch your wall in real life.  \nWelcome to **Rampage**.  \nNow go cause one.\n\nthose who know \ud83d\udc80\ud83d\udc80", "short_description": "RAMPAGE is a VR horror game where you fling yourself through a creepy, SILLY. very. silly facility using Gorilla-style locomotion. Something\u2019s loose in here\u2014and it\u2019s not friendly. Crawl, climb, panic, and maybe survive as you uncover what went horribly wrong. No weapons. No legs. Just your hands, your instincts, and a whole lot of screaming. Welcome to chaos. Welcome to RAMPAGE."}]}, "developer_name": "RStudio's", "developer_privacy_policy_url": "https://sites.google.com/view/rampagevrpp/home", "developer_terms_of_service_url": null, "publisher_na
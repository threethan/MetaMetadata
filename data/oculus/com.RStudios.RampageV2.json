.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSPi6ZVA6piiREPUkWVmwQNG9wAki18ShmZF5kD8So2Q&oe=6B032C29"}, {"file_name": "Applab5.png", "id": "1075460687754809", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825061_1075460691088142_5902356794825774467_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvo32Tq-RDEQ7kNvwE4RjO-&_nc_oc=AdrdHHO4m7jUh8wZjA52zlA85PKqEn5eKMartdTfh_UI59P7-HVJQhN_-UgWdIGX8OQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvxiOrj84GWipPVnhql-39pX7AR5yc0xqj-5tbrRvGYA&oe=6B0318A2"}, {"file_name": "Applab6.png", "id": "4154744024802528", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392301_4154744028135861_9129005692679187276_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1t5AqW_5TEQ7kNvwHZgiiW&_nc_oc=AdpLVI0nJNtHnhrCmxRcbbpIyEbCpP9_VuswahEt9YRxHTOsTMCRSN0xPtG5kUKa8z0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBguIF_fKAO66FgHtwL-OuHnv1VbQhph9GRhjh7AlHdg&oe=6B031FBA"}, {"file_name": "Applab7.png", "id": "3508565082611358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394196_3508565085944691_2561939136513594266_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiHAFt6wTE4Q7kNvwEIjH5I&_nc_oc=Adr_YPee-AhGXvDYCm887NXuGQArv-Vimc3eymWD7lx79nNAzHyvRfnN2blk8q85F9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjWXjn-EexV719yjsZ_yYLgyzJfiVaLoXKqvdoqRvY3g&oe=6B0335DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ApplabCoverNew.png", "id": "699102282568942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392129_699102285902275_481439372369507666_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z27xzXjRld4Q7kNvwFcIsxb&_nc_oc=Ado3E03HItcyzBSrF0stQKxzVwFkYbpAhT5O-vCOakt4_sPsSvh-K29oFm4R3gOLq1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Ys1tcZoy-dV2RaZdfx2do02hrmop1x69NuAjX16t2w&oe=6B0335D6"}, "display_name": "Rampage VR", "keywords": [], "long_description": "RAMPAGE\n\nA VR horror game where you fling yourself into pure chaos.\n\nSomething's gone very wrong in this abandoned facility. You don\u2019t know what happened, you don\u2019t know where you are, and worst of all... you don\u2019t know what's hunting you.\n\n**Rampage** is a terrifying, silly, chaotic horror experience where you move like an unhinged gorilla\u2014literally. Use your hands to launch yourself through vents, hallways, and pitch-black nightmares. It\u2019s just you, your wobbly arms, and whatever that thing is in the dark.\n\n---\n\nWhat to Expect:\n\n- **Hand-powered movement** \u2013 Fling yourself around with full Gorilla Tag-style locomotion. Who needs legs anyway?\n\n- **A monster. A very angry one.** \u2013 It knows you\u2019re here. It does *not* like you.\n\n- **Creepy abandoned facility** \u2013 Classic horror vibes with a twist: now you're the idiot who keeps going deeper.\n\n- **Tools, puzzles, and panic** \u2013 Use your big brain (or don\u2019t) to survive long enough to ask: \u201cWhy am I even here?\u201d\n\n- **Atmosphere so thick, you could punch it** \u2013 Spoiler: you can\u2019t. We tried.\n\n---\n\nYou\u2019ll scream. You\u2019ll laugh. You\u2019ll accidentally punch your wall in real life.  \nWelcome to **Rampage**.  \nNow go cause one.\n\nthose who know \ud83d\udc80\ud83d\udc80", "short_description": "RAMPAGE is a VR horror game where you fling yourself through a creepy, SILLY. very. silly facility using Gorilla-style locomotion. Something\u2019s loose in here\u2014and it\u2019s not friendly. Crawl, climb, panic, and maybe survive as you uncover what went horribly wrong. No weapons. No legs. Just your hands, your instincts, and a whole lot of screaming. Welcome to chaos. Welcome to RAMPAGE."}]}, "developer_name": "RStudio's", "developer_privacy_policy_url": "https://sites.google.com/view/rampagevrpp/home", "developer_terms_of_service_url": null, "publisher_na
li1TYMcFBH27vN4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuaeDfZQ977kYGkCT_dpLAbWyX3GofJ7ifswHox6EZ4Qw&oe=69A582E2"}, {"file_name": "Applab6.png", "id": "4154744024802528", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392301_4154744028135861_9129005692679187276_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eL0A9yMXLoQ7kNvwF8W5sE&_nc_oc=AdnIBo1s2PGYF5mQ1BPsQedARvAGuc9vh9WhN85YQeG4uKV3aPBosM7CgOm3xjgK87Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuAR4aRZZyw3HvDcjtgu1awWaThq0CFtE6AVfxbCAPujA&oe=69A589FA"}, {"file_name": "Applab7.png", "id": "3508565082611358", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394196_3508565085944691_2561939136513594266_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71CNP2W7Yq8Q7kNvwHfzNc2&_nc_oc=Admo4Zrk8oSHISKndnb2I4bZXhFLmwuTyqUkG_C3qqVZR8iWYdFYoL_xP2IpDy3ijZg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsp4lA4rNJjUlr68pQ1Rrb0fuP3_fRtIC5p-UX9VGm65w&oe=69A5A01F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ApplabCoverNew.png", "id": "699102282568942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392129_699102285902275_481439372369507666_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDTz-zmDI-IQ7kNvwFqWpTx&_nc_oc=AdkVE0Txa0wYAs4C1lJv2i3cMa23-Fi4JmSwteNtL-x5Kqy5n36fFqvwwrMCHkJOE4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftqyI6qvrElGd_0G-wxIY5Js50kcE3x6NTeORxFuZnMgA&oe=69A5A016"}, "display_name": "Rampage VR", "keywords": [], "long_description": "RAMPAGE\n\nA VR horror game where you fling yourself into pure chaos.\n\nSomething's gone very wrong in this abandoned facility. You don\u2019t know what happened, you don\u2019t know where you are, and worst of all... you don\u2019t know what's hunting you.\n\n**Rampage** is a terrifying, silly, chaotic horror experience where you move like an unhinged gorilla\u2014literally. Use your hands to launch yourself through vents, hallways, and pitch-black nightmares. It\u2019s just you, your wobbly arms, and whatever that thing is in the dark.\n\n---\n\nWhat to Expect:\n\n- **Hand-powered movement** \u2013 Fling yourself around with full Gorilla Tag-style locomotion. Who needs legs anyway?\n\n- **A monster. A very angry one.** \u2013 It knows you\u2019re here. It does *not* like you.\n\n- **Creepy abandoned facility** \u2013 Classic horror vibes with a twist: now you're the idiot who keeps going deeper.\n\n- **Tools, puzzles, and panic** \u2013 Use your big brain (or don\u2019t) to survive long enough to ask: \u201cWhy am I even here?\u201d\n\n- **Atmosphere so thick, you could punch it** \u2013 Spoiler: you can\u2019t. We tried.\n\n---\n\nYou\u2019ll scream. You\u2019ll laugh. You\u2019ll accidentally punch your wall in real life.  \nWelcome to **Rampage**.  \nNow go cause one.\n\nthose who know \ud83d\udc80\ud83d\udc80", "short_description": "RAMPAGE is a VR horror game where you fling yourself through a creepy, SILLY. very. silly facility using Gorilla-style locomotion. Something\u2019s loose in here\u2014and it\u2019s not friendly. Crawl, climb, panic, and maybe survive as you uncover what went horribly wrong. No weapons. No legs. Just your hands, your instincts, and a whole lot of screaming. Welcome to chaos. Welcome to RAMPAGE."}]}, "developer_name": "RStudio's", "developer_privacy_policy_url": "https://sites.google.com/view/rampagevrpp/home", "developer_terms_of_service_url": null, "publisher_name": "REALZ", "support_website_url": null, "website_url": "https://sites.google.com/view/official-rampagevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null,
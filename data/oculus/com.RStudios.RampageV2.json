.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEpfJV1ZBbEoWIE6mXFbUQw4wPB3FFD7d7JbYKyzPhrA&oe=6B09C3A9"}, {"file_name": "Applab5.png", "id": "1075460687754809", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825061_1075460691088142_5902356794825774467_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEA65G2MWgEQ7kNvwEFPYM-&_nc_oc=AdpyWpnmZssQPpsv9B561nS41_m0BaAxvP57FE2o274qdJcMckGPd-moz_alkFPf6lE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2XHVndrUyrHln6NDrHsAc2a6p7hW_D05MnJCy4xaORw&oe=6B09B022"}, {"file_name": "Applab6.png", "id": "4154744024802528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392301_4154744028135861_9129005692679187276_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYi4ibEAwKEQ7kNvwGMXXqz&_nc_oc=AdpxvS6Ecw6vd2XAMvqJrC0pxyGhCKE1gPGy5zXs57GgGwCffkCL8OEPfY3qICMI2Hc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGlvkJCTcJSC1X32KBrU72wf_KcYU34Gckftmw5lkgog&oe=6B09B73A"}, {"file_name": "Applab7.png", "id": "3508565082611358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394196_3508565085944691_2561939136513594266_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fiaZiMhrQ4Q7kNvwFylZUh&_nc_oc=AdoLfOu7J2Xzr8wbMVuLEYLhoHXtTqMXTP0JPvxSPjZZOgLjPUwSB7mb7BHUHQw9MIQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Gy8GCKJO2_jyXMaMtPGJQQBPYN16HzSabZJlMrIiDw&oe=6B09CD5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ApplabCoverNew.png", "id": "699102282568942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392129_699102285902275_481439372369507666_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WD3vL9m4MtoQ7kNvwGhEcD9&_nc_oc=AdpmybUlVFSKVON43q16hRkhiWC59hvXZV338qoemEOmY4QbjxMGRkeSvGPsBye5Zbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_O8-d_UslF_hOSXx2RGgtt9dlNn3qk-ZGbYfImsY5hw&oe=6B09CD56"}, "display_name": "Rampage VR", "keywords": [], "long_description": "RAMPAGE\n\nA VR horror game where you fling yourself into pure chaos.\n\nSomething's gone very wrong in this abandoned facility. You don\u2019t know what happened, you don\u2019t know where you are, and worst of all... you don\u2019t know what's hunting you.\n\n**Rampage** is a terrifying, silly, chaotic horror experience where you move like an unhinged gorilla\u2014literally. Use your hands to launch yourself through vents, hallways, and pitch-black nightmares. It\u2019s just you, your wobbly arms, and whatever that thing is in the dark.\n\n---\n\nWhat to Expect:\n\n- **Hand-powered movement** \u2013 Fling yourself around with full Gorilla Tag-style locomotion. Who needs legs anyway?\n\n- **A monster. A very angry one.** \u2013 It knows you\u2019re here. It does *not* like you.\n\n- **Creepy abandoned facility** \u2013 Classic horror vibes with a twist: now you're the idiot who keeps going deeper.\n\n- **Tools, puzzles, and panic** \u2013 Use your big brain (or don\u2019t) to survive long enough to ask: \u201cWhy am I even here?\u201d\n\n- **Atmosphere so thick, you could punch it** \u2013 Spoiler: you can\u2019t. We tried.\n\n---\n\nYou\u2019ll scream. You\u2019ll laugh. You\u2019ll accidentally punch your wall in real life.  \nWelcome to **Rampage**.  \nNow go cause one.\n\nthose who know \ud83d\udc80\ud83d\udc80", "short_description": "RAMPAGE is a VR horror game where you fling yourself through a creepy, SILLY. very. silly facility using Gorilla-style locomotion. Something\u2019s loose in here\u2014and it\u2019s not friendly. Crawl, climb, panic, and maybe survive as you uncover what went horribly wrong. No weapons. No legs. Just your hands, your instincts, and a whole lot of screaming. Welcome to chaos. Welcome to RAMPAGE."}]}, "developer_name": "RStudio's", "developer_privacy_policy_url": "https://sites.google.com/view/rampagevrpp/home", "developer_terms_of_service_url": null, "publisher_na
lRQ6h1kT8X9erdm-_nJPq3gQvSZixYPZIxtVXHLeFH-a4ld1svKk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKzIP586g3gd-1P2BkrGcTw-zYzRl47kr-3WGo2cC0bA&oe=6AFB1FB3"}, "display_name": "Night of the Wendigo", "keywords": ["Horror", "Survival", "Action", "Shooter", "Fighting"], "long_description": "NIGHT OF THE WENDIGO is a Virtual Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo.\n\n- 10 to 20-minute playthrough.\n- Endless Survival Mode!\n- Simple, easy-to-understand gameplay.\n- Scary, scripted sequences and potential threats from any direction.\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "NIGHT OF THE WENDIGO is a Virtual Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": n
02&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qPmGSPhwX0Q7kNvwGOSSIp&_nc_oc=AdrRnSABh5W4Stz11lYeV6KsV3L2U1fY51jGHheBImuQr18HwY551hV8KpEkG8QtC4k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gf6k-3Ci96RUgajMnSDe_ZAALkiKfHtr2I-Ikgr5xdg&oe=6A22F1E4"}, {"file_name": "Wendigo_Screenshots_2560x1440_04.png", "id": "891821636364650", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86653846_891821639697983_545608362698545588_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaL8dwz8WTwQ7kNvwG-6X62&_nc_oc=AdpEvZfnzMnU3743LRk69JN603I6TLcKPXTT5B57LExs9DEaqqUXOdMyRdGq4N8cWZQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_50xs4r5VxaBBLUNZ9fW0knta0eRZO663PFHoUPipWpg&oe=6A22CF15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Meta_2560x1440.png", "id": "1137164114710385", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974832_1137164118043718_6558116818934484823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pO3tUgBxlF4Q7kNvwHYUypL&_nc_oc=Adr0CouVdu43lF9B0Ykioy6Z2o4ozhshCpdNn-3ctXOQuhZr523yw-QZGnCNy_eYb6A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YOJjWZdWTFRL_EgLMhxXzjrAL42wgZo7K7xus_9eb_A&oe=6A22E9B3"}, "display_name": "Night of the Wendigo", "keywords": ["Horror", "Survival", "Action", "Shooter", "Fighting"], "long_description": "NIGHT OF THE WENDIGO is a Virtual Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo.\n\n- 10 to 20-minute playthrough.\n- Endless Survival Mode!\n- Simple, easy-to-understand gameplay.\n- Scary, scripted sequences and potential threats from any direction.\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "NIGHT OF THE WENDIGO is a Virtual Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9264071156995801"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974649_995227472427846_8774397662530023203_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiFya3zLQ5IQ7kNvwEs21LQ&_nc_oc=AdoKJvs3g21y66h3wgapZ-RB-DelSlbRmXl5SmsTG2fhQe9KUciVEezUncDA8P5ekE4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x5kDg3pMdCL4FUMFjNX6m1LFIGK9hkSn7MUGek6TzaQ&oe=6A22F66D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Night of the Wendigo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "
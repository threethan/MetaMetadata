al Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9264071156995801"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974649_995227472427846_8774397662530023203_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dt9aVrODKNAQ7kNvwHdElm5&_nc_oc=AdqgWf9jd4e7Y82nvY-TpShb7FLXBGQM5ll_0LoYR87UWTphjER8v5xjWZ0CvoBhyKc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-v1-iUe3klePLZSliNbDilcY8mo9bPLen6azpmVnlXA&oe=6A9AEEED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Night of the Wendigo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332
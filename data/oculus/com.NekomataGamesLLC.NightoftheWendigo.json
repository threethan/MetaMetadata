om/v/t64.5771-25/38974617_1636971253567573_9064841830285703881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6G4EXDlw81EQ7kNvwHQhHtS&_nc_oc=AdprQ6TcMkuGXEYsxRC30vP6loS1gzcHpRCFTGaxysC2Uoc1Td7mBC3Cmrrwmh_G68c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdg1y0Ak_I1whNcIk5ur4rEIRaKXWZdXaZEv54ugxSgw&oe=6A511664"}, {"file_name": "Wendigo_Screenshots_2560x1440_04.png", "id": "891821636364650", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86653846_891821639697983_545608362698545588_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LreNhCth7b4Q7kNvwGwO-tR&_nc_oc=Adp4CEfLiWfOUE2v-NtaTRF5HNOd83igUCF7pYDy0NXDMArqdXMri2QBdUSHLd9k5IU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0fsxi75L_FQZXbifNcbFcYTBuQPTfxWEcyNS7CbuO2w&oe=6A50F395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Meta_2560x1440.png", "id": "1137164114710385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974832_1137164118043718_6558116818934484823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58hGSBVqfoEQ7kNvwHIJXA9&_nc_oc=Adom0hB89nEKIIphEm86rAjX__dk86mkOhgZYyC4EJSTG8d8-uF8FLMMjLOkKDwT1xs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPCd9Pn_0_HXVopoDHyUrrZf2qfZmZR5MTkCYb2qNPpg&oe=6A510E33"}, "display_name": "Night of the Wendigo", "keywords": ["Horror", "Survival", "Action", "Shooter", "Fighting"], "long_description": "NIGHT OF THE WENDIGO is a Virtual Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo.\n\n- 10 to 20-minute playthrough.\n- Endless Survival Mode!\n- Simple, easy-to-understand gameplay.\n- Scary, scripted sequences and potential threats from any direction.\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "NIGHT OF THE WENDIGO is a Virtual Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9087232074679711"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1328059681653208"}, {"status": "PUBLISHED", "id": "1350185639734273"}]}, "baseline_offer": {"id": "1350185639734273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744995600, "status": "PUBLISHED", "id": "1328059681653208"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9998002120269364", "version": "1.0.4"}, "id": "1361755541857391", "channel_name": "LIVE"}]}, "is_for_oculus_key
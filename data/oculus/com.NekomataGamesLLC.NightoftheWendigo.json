om/v/t64.5771-25/38974617_1636971253567573_9064841830285703881_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6huwAACN30IQ7kNvwHR1U2Z&_nc_oc=AdoE5fs03lOLUPMDVx7A-3_mVsD6WZIf7Q9Tr6x58Ro0J_sjL8zLKQFxtq-WnGqHQC4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP13jXLDDPXllJ01dXxSlBvCyTyfhnZgSg8flFqC5QYsA&oe=6AC51A64"}, {"file_name": "Wendigo_Screenshots_2560x1440_04.png", "id": "891821636364650", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86653846_891821639697983_545608362698545588_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52iahPl_EX8Q7kNvwFet6iY&_nc_oc=Adqicg_8u-u0fVr_J6VrZLNVzvkzFAL6hyLKtLsIG4xLFgdxVBx-Mo25rSgzDdvk0to&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj1tyf9vj5mlDXRNb5BRhJJFr225KPb5L2uW56yhAJug&oe=6AC4F795"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Meta_2560x1440.png", "id": "1137164114710385", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974832_1137164118043718_6558116818934484823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y5K1ESVtUQQ7kNvwFkR0A9&_nc_oc=Adq_V5QaN9V0Xnafm_7gVn-k8LgwmsK2ZxAhRDLW15-KQU1vWznOsjmwXSU52aP-l5c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgSeSKk_d_WGc3W-HFPoTe9PkRWYa8KpBCqJYdj_GxuQ&oe=6AC51233"}, "display_name": "Night of the Wendigo", "keywords": ["Horror", "Survival", "Action", "Shooter", "Fighting"], "long_description": "NIGHT OF THE WENDIGO is a Virtual Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo.\n\n- 10 to 20-minute playthrough.\n- Endless Survival Mode!\n- Simple, easy-to-understand gameplay.\n- Scary, scripted sequences and potential threats from any direction.\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "NIGHT OF THE WENDIGO is a Virtual Reality horror experience in which a peaceful day of hiking becomes a night of survival! The game is a very simple VR experience that is best enjoyed by taking turns with friends.\n\nThe player must survive the night using their rechargeable flashlight to fend against forest animals such as deer, wolves, and the legendary Wendigo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9087232074679711"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1328059681653208"}, {"status": "PUBLISHED", "id": "1350185639734273"}]}, "baseline_offer": {"id": "1350185639734273"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744995600, "status": "PUBLISHED", "id": "1328059681653208"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9998002120269364", "version": "1.0.4"}, "id": "1361755541857391", "channel_name": "LIVE"}]}, "is_for_oculus_key
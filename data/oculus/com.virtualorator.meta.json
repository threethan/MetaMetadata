5-15.png", "id": "1301973571823587", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822550_1301973575156920_7372953481294568874_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PpdvLFDLZ0Q7kNvwFHKhs7&_nc_oc=AdrF9h_Byl2TvntpGKv8Ybs44UGYf8hFlPnGsymWGnhtM9pEnmEmpsYsNqqF1MGCHGI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rF8O7gCfkbOCXjeUuN8BWO9K7YBQYDDByoJLWhlnt5Q&oe=6A26DF39"}, {"file_name": "screen_2560x1440_2022-12-01_09-12-46.png", "id": "3038194693044789", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825415_3038194696378122_1959125543747148842_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhz4rmQcy2kQ7kNvwFQ7z5h&_nc_oc=AdqVvLpJygg7CYDw5GiCl2ZBT71oCMNZUraeFzXQ90-3RIqIMb0irV3YwnJYtes7L3w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d2BfRsONb6DBr7OQxEulyRDSPLdKbS70DFaI7g-JhFA&oe=6A26D392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VO_Quest Trailer Cover.png", "id": "1423332506179517", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303198_1423332509512850_2032938320805380769_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRrcpqyNjfIQ7kNvwFCf-Us&_nc_oc=AdpHKbtImlAnOkH7H38-oBJ8Qd2M6iuWgRuCXHyKCa4bgcjme6tQ0JKe6nwBk7PCCSY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LozkPKRo0J9pppl3923BVWkSGvzYDJfHqYAf-ggyMnw&oe=6A26BC73"}, "display_name": "Virtual Orator", "keywords": ["PublicSpeaking", "PresentationSkills", "Confidence", "Communication", "VRtraining"], "long_description": "Virtual Orator is an immersive VR public speaking trainer designed to help you build confidence, sharpen communication skills, and rehearse presentations in realistic audience environments.\n\nStep in front of a virtual audience and practice delivering talks, pitches, lectures, or meetings in a safe and controlled setting. Adjust the venue, audience size, and audience behavior to match your needs \u2014 from small supportive groups to large formal settings.\n\nKey features:\n* multiple realistic venues and presentation spaces\n* adjustable audience size and responsiveness\n* support for your own presentation slides\n* speaker notes for structured rehearsal\n* remote and hybrid presentation practice modes\n* dynamic audience behavior powered by AI\n* session feedback to support skill development\n\nWhether you're preparing for a big presentation, overcoming stage nerves, or refining professional communication skills, Virtual Orator gives you the freedom to practice anytime.", "short_description": "Practice public speaking in realistic VR audiences. The right audience at a button click to help build confidence, refine presentations, and improve communication skills with immersive, customizable speaking scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualorator.com/app-privacy/", "developer_terms_of_service_url": "http://virtualorator.com/EULA/", "publisher_name": "Virtual Human Technologies s.r.o", "support_website_url": null, "website_url": "https://virtualorator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25880906068229888"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823366_1403246117796407_8166319264303507211_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-
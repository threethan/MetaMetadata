, and chase your friends through unique maps and thrilling game modes. Pure movement-based fun\u2014no sticks, no buttons, just you and your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/92ae50d7-e900-4055-a3e0-c8303bf443dd", "developer_terms_of_service_url": null, "publisher_name": "Solace", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1rCvWSnXSLx7S6l5MGDtEUKyF64QrHnNTFy_AwWiJDoE/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9749280568506507"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "536110246227965"}]}, "baseline_offer": {"id": "536110246227965"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755709440, "status": "PUBLISHED", "id": "536110246227965"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9766741563427074", "version": "1.1.4"}, "id": "756295380352387", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9749280548506509", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
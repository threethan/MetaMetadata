zvKK5vOqde_Pf2KHtk-w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9zwW7fylFR26jRIO6PXGroK265UFTCETj6eLEeLwzZA&oe=6AFB37F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "huddle.PNG", "id": "440964834222824", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974584_440964837556157_3753674114270376978_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6rqtIKweWEQ7kNvwGEiDGI&_nc_oc=Adqbl6OW3-XymyAq44PdTjV1mehU6_Jim_Kind_0psd3ds2MKN080m1YON2uHwaJuAM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmFdlVLOl57iCiovg60VJJ20jKtA2PNffYotRxaJg1VQ&oe=6AFB1C77"}, "display_name": "GoArmy Edge Football VR", "keywords": [], "long_description": "NOTE: This application is not a game, but a football training application that requires existing playbooks created in GoArmy Edge Football.\n\nGoArmy Edge Football VR is a free football training application created by the U.S. Army that lets players step onto a virtual field and practice their real-life plays. Select any player on the field to watch plays develop from their eyes.\n\t\n* View existing GoArmy Edge content created by your coaching staff, or start with our example playbook.\n* Review plays, formations, and drills.\n* Customize your view - turn path diagrams on and off, select your position on the field, or select a player and run through a play.\n* Change the jersey colors to match your team and your upcoming opponent.", "short_description": "GoArmy Edge Football VR is a free football training application created by the U.S. Army that lets players step onto a virtual field and practice their real-life plays. Select any player on the field to watch plays develop from their eyes. Review plays, formations, and drills created by your coach or from our example playbook."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.goarmyedge.com/privacy-policy", "developer_terms_of_service_url": "https://www.goarmyedge.com
s-side.png", "id": "1147086774427508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613034358_1147086777760841_7461239965405844426_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjAj3HCNaqwQ7kNvwHq2vuE&_nc_oc=AdpmBCnTPz4NDekt0LjtuFQmALg-vj14LfaCvEnL_2iPTXqve5gzW1A1AeZHqjdLlYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXk_wqtalzwVNn9SHEkEd0EAwgcAIREd0rcPRFzVuRIaw&oe=6B104286"}, {"file_name": "05-room.png", "id": "1673928644089530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673780696_1673928650756196_6450506143117002998_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPx2CWnvMAYQ7kNvwERksGd&_nc_oc=AdpOHiN1fFXi4zezTXY7UMqtyFJfVM1g5XlGQ3NZMvcsob87KwKEwzX1NOcEwiHYGVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWq1LgvF2m2PVMBqbwaOq6_LGu95OY93Wzu2_hgY87HFA&oe=6B1064D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1102907149403602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_1102907152736935_176763580943623859_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcD1nMGIAIIQ7kNvwH9lmW7&_nc_oc=Adpx5lKpWgmwCVTZIDu8OVRbLojkBsMYwUAgrC-5Z1Rt349y48ngvt3FU4rheJiZWVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVfsLZ4SfqFsJZEJ56GxD6KFvfTWu9sAoXIUXxlmTN3hA&oe=6B1044F4"}, "display_name": "MedSim", "keywords": ["medical", "doctor", "anatomy", "CPR", "simulation"], "long_description": "**A hospital in your headset.** Walk into the Residents' Room, choose a patient from the board, and Amal, your nurse, takes you to them.\n\n**Talk to your patients.** Ask anything in your own words. Each patient answers in character, in English or Egyptian, Saudi or Iraqi Arabic.\n\n**Examine with your hands.** Look at the eyes and mouth, listen to the heart and lungs, and read the monitor.\n\n**See inside.** Open a window on the chest onto the beating heart and breathing lungs, and see what the illness has done.\n\n**Order, treat, decide.** Read the ECG, bloods and X-ray in the room. Treat, and watch the patient respond or deteriorate. Make your diagnosis and get a debrief scored like an exam.\n\n**The Body Lab.** Hold the heart and lungs, grow them with both hands, name every part, and step inside the left ventricle.\n\n**Resus.** Run a cardiac arrest: compressions measured from your hands, the defibrillator, rhythm checks and drugs, scored against the guideline.\n\nFor students, interns, residents, fellows and consultants. Hand tracking or controllers, seated or standing.\n\nIncludes 100 credits and a month of MedSim Plus. A minute talking with a patient uses 3 credits; more are available in the app. The Body Lab and Resus are free. Internet required. For training only, not for patient care.\n\nAnatomy from the HuBMAP Human Reference Atlas (NIH), CC BY 4.0.", "short_description": "Practise medicine on patients who talk back. Take a history in your own voice, examine with your hands, see inside the body, order tests and treat, then run a cardiac arrest in Resus. A hospital in your headset for medical students, residents and doctors, in English and Arabic. Includes 100 credits and a month of MedSim Plus."}]}, "developer_name": "VirtualVerse Studio", "developer_privacy_policy_url": "https://medsim.virtualverse.studio/en/privacy#meta-quest", "developer_terms_of_service_url": "https://medsim.virtualverse.studio/en/terms", "publisher_name": "VirtualVerse Studio", "support_website_url": "https://medsim.virtualverse.studio/en/support", "website_url": "https://medsim.virtualverse.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads":
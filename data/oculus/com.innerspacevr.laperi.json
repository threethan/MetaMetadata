KBqIFV4OGl14byv5TA6tIzy6HyZ-icgO9drO2OvwGDwA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqPobtwrNix5h2YV6cbWuUvWCvN10v3t-5HVlMToNsWQ&oe=6AC8ED31"}, {"file_name": "Screen-03.png", "id": "1531945494538223", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825497_1531945501204889_6517700810314575458_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1jcGLUR9g4Q7kNvwF-hQty&_nc_oc=AdqrKeTz3aYU74SJN_sY3nTZqzLg0_Bn6eEr5RFPp1-afXrB1iaCcBU6YRd4vuyk9dM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLx-mwC48lgwvT5y2CttQP5Jqi8eiUSbzptIg1O3wDuw&oe=6AC8E865"}, {"file_name": "Screen-04.png", "id": "1339460011129337", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx0JWaEJ0z4Q7kNvwFzL6UY&_nc_oc=AdrWjnDyrM147XVFHC-KIUu0IAdC3mCqX-OYqFw6KjL4eFJC_2y6AAxx55ZU7xidwNQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFp_NPIwBUXoT12LnehncSsxlWbeaLbSqbX97WKrQFyA&oe=6AC8F093"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHqCM72eW0QQ7kNvwGD79Xy&_nc_oc=AdrX5BpMTLulOX9lhL-GJs4byvfwxn7Na13jrziMpHHvKds14xVQSABXfXZsyXE5rhc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8Jvmf8ao6HzQmyRv2CQPngiOV1RmxZdH17lKPLXTb5Q&oe=6AC907FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVukBmSx4HwQ7kNvwFHswSj&_nc_oc=AdrHDEmEfl2KhrT1pujh_TALLcwpesDnLeXRg2sd88jFCKNjDBMsd6EiKC2Vhu-H_Sw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkgXPWvM08KT9KuxD0LnunXu7gIrYWWhSF0hB-7RQL5g&oe=6AC9081D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "story", "music"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa Peri\u201d is a visually stunning experience based on classical music and ballet by composer Paul Dukas and produced by the award-winning french VR studio Innerspace. It relies heavily on the touch hand controllers, and will enable you to interact directly with the characters and creatures which populate this world.\n\nDuration : approx. 15min", "short_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La Peri, and witness a magical and poetic encounter as one of the characters... "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innerspacevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.innerspacevr.com/terms", "publisher_name": "InnerspaceVR", "support_website_url": null, "website_url": "https://www.innerspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
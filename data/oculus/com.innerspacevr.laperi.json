3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vnfJYCBK0wQ7kNvwGpNRZ1&_nc_oc=AdpR7n9tbbiP9Odo3e3UQw_hgcsjVwGucUxFb2HVxEHNZRsK3gih32XqnPgP3i4mfRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhbGSdJ7TFDgDHSYamPc_4RKexlRSRlp6n_hvwwpe3Fg&oe=6A92E313"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7r_06vnJRAQ7kNvwE7zz1g&_nc_oc=AdrsBtnEF_sy4dStQqqpNokUyjkKKniSbNHa1f537ViKYUQNqDU8qgI46DvHoDiuInY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkrsoGgVKHfBPohFo_quuxzMQoYm9TsohVrBhz51PCiA&oe=6A92C23C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPHfbft-Rs0Q7kNvwHDgDZ4&_nc_oc=Adr1P9HBEq3Js_VIJzjYIJ9O-dFUiWSeZ--HG25vWn7-SEkGi_D4cAwqyWlIgbRqSb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJZZcevCHheGQS0eWN1nL4YNFSqmAiPaOJ3PQGwEr-mA&oe=6A92C25D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spledJbpVeMQ7kNvwHzWeqe&_nc_oc=AdqXJzdZGNhdnWja2ZICp5HWGuRNj7UCpaHlQ3HYWjAKno7K-zEHq-TGoMON1FB7Q5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKJafVW61O-e5-IOtsAlJ1JvmPLZF-NND4HH8e3Ya5OA&oe=6AB13593"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf9eX2-dDTcQ7kNvwFJ7c5o&_nc_oc=AdpldpvUomg3FQqIVHcnBm0PahDusIgEdvxiI7ZJCgz_EhVeRFboaMaI4qaXit9icYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj3lTECUUpIbi1a18JtNAzwEkBFzvQyfxYfR47IDr1dQ&oe=6AB14CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=138qZHVOhT0Q7kNvwEwx4yv&_nc_oc=AdpNYEY5I0BH1FKuTkrivcwm0B3-FAmXguI5MBdQ4o4yr0BgUTgU6R2CsGSkBkLEe6g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ67_09za-sNHgyfG2Cjd1jK8PhBQpM7V74Jn_Nel_1yQ&oe=6AB14D1D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
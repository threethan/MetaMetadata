3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spledJbpVeMQ7kNvwGzEvn9&_nc_oc=Adoo9THb-nN6Zq9C0buzS8MlQYAZK7avwJvbLg_zjyQMtF0ftOI13hV2_p6IFvicSQs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzKgUGbjLgIL1eUupbmdn1Q9oX45T-bJc6xLkPwHGuxQ&oe=6AB28713"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf9eX2-dDTcQ7kNvwGm17-C&_nc_oc=AdqNBNXxtqxL3osFWIO0Kzpf0X_Ur1JB5N2yPhMv_Mig5648SRI2csrehmSAskVfZrk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbxDunt0VakWR4vTkih7XgcXffrQxEDg67yAoR458c-A&oe=6AB29E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=138qZHVOhT0Q7kNvwH8yKxe&_nc_oc=AdqHL3-yYIZW7XD9XMizTKmncKGSTsD7SPCBSV-j_F3eylrB4gg-0mMvnbVf2QfFWTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS2xRdgS6tkThqupDZvga52dkheBtkTfIBRl8nDQikeg&oe=6AB29E9D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
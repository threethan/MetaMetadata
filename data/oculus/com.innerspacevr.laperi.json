OveD24v5HoSDtuB1gB7gTxsRYxY3EGt1VCVsBV_S2oiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCRrK4SULPgGscAO-DD9jtZFpr5rJXPCXZd5FsRsp2Lg&oe=6A9EBD31"}, {"file_name": "Screen-03.png", "id": "1531945494538223", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825497_1531945501204889_6517700810314575458_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c07nNGvjJD8Q7kNvwFQ79b8&_nc_oc=AdruKXN_qvsVx4mt2lDyBf9vmvxWhv-jxWeScCBVPrj3ecv4QMZbBIPD_CZqq7cs0OE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9BVWHRjP4TquMyWRAO7PTWOqzZuJ3aS_TdzX_mrr3dA&oe=6A9EB865"}, {"file_name": "Screen-04.png", "id": "1339460011129337", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p-zClqGwKQQ7kNvwHLPGBl&_nc_oc=AdoSXNSxYGOqUFPrAiSYfYdy5lTcN9EnNJ57xrp0ghq5Mlebw8-V0G8wRHLRrHKEBzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ7F6LMjV29wYjbBAkKe2Kz-o-O8fukqxtpox73wN2eQ&oe=6A9EC093"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QnTnVaWtAkQ7kNvwF7V0th&_nc_oc=AdroQATaR-gzu9ikdFUjR90GWM590buzWwckXlXnan8e6eIZozmR56Q4zRmp12D0n_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdPlMHlXol2_b1cz9aJivZ-k21c56q2It0nsthkLdRqA&oe=6A9ED7FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2dP6nNSF1YQ7kNvwEmNT3o&_nc_oc=AdpzIdLWx0eXW9KMXyT2gPsermfITm7UR9FjZiDV22yRTxxDx2bsGe4Mo9OEjz4K7-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4untrKTgbTEJUwEJsIpOKT_unYkMXXyM3-zTlX-l_4Q&oe=6A9ED81D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "story", "music"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa Peri\u201d is a visually stunning experience based on classical music and ballet by composer Paul Dukas and produced by the award-winning french VR studio Innerspace. It relies heavily on the touch hand controllers, and will enable you to interact directly with the characters and creatures which populate this world.\n\nDuration : approx. 15min", "short_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La Peri, and witness a magical and poetic encounter as one of the characters... "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innerspacevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.innerspacevr.com/terms", "publisher_name": "InnerspaceVR", "support_website_url": null, "website_url": "https://www.innerspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx0JWaEJ0z4Q7kNvwHh5peW&_nc_oc=AdqGek1GRDY8PmvX2mvXbs-MMtzFqdrBhbK-t1SvYYAzSA5sHTH_7A7gAQG2OEXJJBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgT3cmhCYb0jm6HHj1pF_-JWfQYloneHqE7aHbEjaqMA&oe=6ACA4213"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHqCM72eW0QQ7kNvwFSlOA7&_nc_oc=AdpXqnL0EfL5U09xO5y2tjIfP6EFbdUFY_8dFIt9x8bEu4m0aHsVwy3mFL-V0v_H_7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH2wq-8CnX6WBiIHP-lNr6yikizD3wHcM22Osqgy-kzQ&oe=6ACA597C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVukBmSx4HwQ7kNvwFShxhT&_nc_oc=AdpDOB-Xv6q6VirGk5wO3QQ7mQGXEu9zWDND_GoO5PPaaHsMqgXTDNbSl09Sh-KiFtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBiFX7lHJ2VONnV1--a7X8FN3ntqURO9mpHbcB_E_8WQ&oe=6ACA599D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa Peri\u201d is a visually stunning experience based on classical music and ballet by composer Paul Dukas and produced by the award-winning french VR studio Innerspace. It relies heavily on the touch hand controllers, and will enable you to interact directly with the characters and creatures which populate this world.\n\nDuration : approx. 15min", "short_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La Peri, and witness a magical and poetic encounter as one of the characters..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innerspacevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.innerspacevr.com/terms", "publisher_name": "InnerspaceVR", "support_website_url": null, "website_url": "https://www.innerspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27536705399273489"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1395529289111100"}]}, "baseline_offer": {"id": "1395529289111100"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785141180, "status": "PUBLISHED", "id": "1395529289111100"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_t
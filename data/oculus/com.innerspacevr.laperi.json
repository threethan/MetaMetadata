3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxibAbIpB1AQ7kNvwFBicgC&_nc_oc=AdoTHLWEQ5J2rNqsRAs1-sNLFtswFvcTwNtG936t5UFj3NPYEjbb0ir1Pwvv4d6jJOE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvHoGY1B9UbxnsMnTqNJufGxu6tfiYoZVsI-7uK-TIKg&oe=6A9ACC13"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENf4vUxaJiEQ7kNvwEGUX7r&_nc_oc=Adp_okSB0faObByNeRE5gSy2ShiQBHukZIudPMQLSsnElF6nFEbiGelZMYj4VCChVwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeo1TlHOd18MpOBbFIq0rx_RaGtBI3knbHwUhCjgCFAQ&oe=6A9AE37C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh2eYk1eHJoQ7kNvwHM1J2V&_nc_oc=AdoFtls085Xv0ueDd7F2g9EO1Oe8sdJXtMbmAcY_bJl01_2vTHp9Bhj5aEP3bThYVpw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW3TxB5IYNU2K7y1LPhHqkVF_DufpqK-edtLos9-cH4g&oe=6A9AE39D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
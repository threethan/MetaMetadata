3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCpNMq64ruoQ7kNvwE13jgZ&_nc_oc=Adp95N8ehZnSYiM7H-DHYYyj6wfbPxY3kyYF2-K1IPrsWPS8fnpLY4HAv6n7hVadQoc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnFqzbHT33H2DyQCr8qjb20tCAa84ySYmsidP189kc_Q&oe=6AB67B93"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X5qFVrJnHgQ7kNvwGf3gP0&_nc_oc=AdrWAsfZb6FntS7_nWi7sRSZnHBZ4LC5BgP3Q2ET9LOYpBaeHymw5DENMXy-WVJvU38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtCQ6vERrChIrwAJzDV-Wbn-_gw7VRVam80Ml3frlIxA&oe=6AB692FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CxX8guF6YQQ7kNvwH-WET0&_nc_oc=AdpqtLvOqqUvxxbh3QFjLPWP1IXz7m3JaH-_wtJ-Bc4kuVS15c3-AXPCJ_4a7SdAQV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZT-ZsCPGLFyChtIgp2-NQRU4ZnKPkm4PkAyXtE8TLow&oe=6AB6931D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
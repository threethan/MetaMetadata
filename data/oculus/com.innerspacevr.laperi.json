3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIsU-R80ZyQQ7kNvwHp20NF&_nc_oc=AdpCAOCeJL-9qRHqFVBQeAXBWXWAjv-7RltorwiCSP4aymxexlvZhYBKdfMbBV3F8NQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHykRA_WoWuyx7GdbLtT3scPrKd4I1agWa5mLq3fqp9g&oe=6AA16393"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yccmS6lh8rgQ7kNvwEQ0Mxx&_nc_oc=AdoRV0snppU3uYfja9YM-K9v2V3eo3W2UiCD1noFLxDyrloQGJabeNgLJNbXQ3cEMu4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJX3Eu7WWRS3kxGbF8nAqlUJkSzA8p1Mp34iAkZRZ13w&oe=6AA17AFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd9ebiaIUSoQ7kNvwEsa5ib&_nc_oc=Adoz2pNhMh84jpvc_sRI2sFFPTY3eZbIx7T0mwv4oQby4NWhp9txhJb7fRD-f2M5p8w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk1K2xh-6qA5exdr-InVFncHeEQZl9SGM8CHbWTMTuWw&oe=6AA17B1D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
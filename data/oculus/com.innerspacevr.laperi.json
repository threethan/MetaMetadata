3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYwMV7r1uGAQ7kNvwHJnt8t&_nc_oc=Adr3deeM4YxHE-u3wz6sJSoHu2vViFX9m4T5wgbj_IKorceLNP7b_ZwMdPEwwH6mU-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp8U18davmTSTVCFXxxteNLbYsZzU5wiwf9G-zbzD6Wg&oe=6AF89ED3"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhZWwIZVPsUQ7kNvwG1vw2F&_nc_oc=Adpphv4gSQZ3Ceri9bdiScVq7Ay22D4TI9sTNSRjBmY0ySukinUpMKw_uiUOCy3XJVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcGorQXC5uI9rp8lO-6AZO3h2RCdTHhKsy5g18LciXIg&oe=6AF87DFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB7rdZUhphcQ7kNvwGDXSms&_nc_oc=AdrudImNk7yZ1Swz6vAfuJzHB35AAALtn_epDSgYQu-FQAg7v9iiDeofFVpnkaYPqIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzidUq4Yg6FdbYC01fvSxY1gCAtiUFvwjL64oCURhjlQ&oe=6AF87E1D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sKEdP1gfg4Q7kNvwFlM2BY&_nc_oc=Adp2NwAB3meNMX5vKSQRDTmUp6Oiw5CMUGlWNjrXvjSwt3z6AyBoKLXWqiepVxmap2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0HtfUWclVpKesv2GdATipQEHsE3owuI05uu9esiRndA&oe=6AC64D93"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW4d2VFUhLoQ7kNvwGOh0r8&_nc_oc=AdonTkLlkgAer_Ogt-IG-NsahfigixdpMOKu9sG-gBbinvv2L8jPtXAqpaqV8UUfd8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEG5uweARrLzca78K4lcKHZQ7PzHJvPgXDdbyer3ke9g&oe=6AC664FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F6B0CHFZAMQ7kNvwG7PBDW&_nc_oc=AdrQOHZt2qkQD7LcC3RytmsP6-dvvw2u-oKUGP16w6gIHlkvGjLgD0UkTmDfQZlW9ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBRucj1kCQTMQ-6eofWYQ_XumrEZzOF_uQ9OqCL7quJQ&oe=6AC6651D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
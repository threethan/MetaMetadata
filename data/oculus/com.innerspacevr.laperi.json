F6ROUlrfWmxiCeec98kkWbKXgA_rtByJML1K-hP3tnsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4iC1xMJGktN_o2GAjWctJ4HhbLO3umz7k8ZcMhZ6QLA&oe=6ABD0FB1"}, {"file_name": "Screen-03.png", "id": "1531945494538223", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825497_1531945501204889_6517700810314575458_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2pCCgybLAUQ7kNvwGnKsf6&_nc_oc=Adq6JxPrHNkR3DlpZKANANNi15tqW8mm1WCzYtDmQ-ukXg-h0SAamvSMOsPSxYM72BA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSvBd4tqxiHyyoxBj9EjDT-Dyq1RXbQEUrVzM2poAvfg&oe=6ABD0AE5"}, {"file_name": "Screen-04.png", "id": "1339460011129337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_wXktgEdMUQ7kNvwH-Unyf&_nc_oc=AdpJm4Zc3_6ADePV6viggCZLW16OEU92RUSiqAa10s8Vu3A2hBB6vAphZC4OtYw1EhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRFU0gKV9IdNv6vykpOS_t-C-XTCx0sCmoiACUyz9YoA&oe=6ABD1313"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NdiGmx8pR4Q7kNvwGOxj4b&_nc_oc=AdoqQfrDPQgQaXfM_FBCRGIgDevBUbfCe-L6uj_YkqLM-6ChJGMhAqBQtGjPUA3_evs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3yZkeO-5dWSjcrou2bhWthgbmqHccFd2_qVtHGvjPSw&oe=6ABD2A7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAvZJ-QICMoQ7kNvwHrw7_G&_nc_oc=AdrIQ1zRg2Xg9wellza-zbVz1YTT37ZQ1r_YIqKyU6XmQvDFbSKRBd6iIrqiWvKzV58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSufnuFVjp46KkvEuUxzYaI7grOWIcOe1Ku6ChrVvRHQ&oe=6ABD2A9D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "story", "music"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa Peri\u201d is a visually stunning experience based on classical music and ballet by composer Paul Dukas and produced by the award-winning french VR studio Innerspace. It relies heavily on the touch hand controllers, and will enable you to interact directly with the characters and creatures which populate this world.\n\nDuration : approx. 15min", "short_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La Peri, and witness a magical and poetic encounter as one of the characters... "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innerspacevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.innerspacevr.com/terms", "publisher_name": "InnerspaceVR", "support_website_url": null, "website_url": "https://www.innerspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
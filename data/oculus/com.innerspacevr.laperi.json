iT7IjTfKxrqPPO-lkGoqj1Ot_jQzNQwApteHu6ZWg_cI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiIW_4tMHsMAsKxwfttS2DCleBeTtz9AuzZcBLEClnpQ&oe=6A943131"}, {"file_name": "Screen-03.png", "id": "1531945494538223", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491825497_1531945501204889_6517700810314575458_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzOPyYb280sQ7kNvwEhBo3L&_nc_oc=AdpRRCfjZS4PcB1NjcYInU8w1x6_ZtUqVSm9pbo16WhwWmz395TxGZ_TY2qe5nq69f8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2YnZ17GqO31qfF1cVNTFl7TLSYaMIX1LiIiPclHD0Og&oe=6A942C65"}, {"file_name": "Screen-04.png", "id": "1339460011129337", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vnfJYCBK0wQ7kNvwFTgpzB&_nc_oc=AdpBkTYlltjXpxLE7EHwy5Q-een9sTVNfYiUPKufAUMrv4HZlyaYUus5lkDNQFLKkVY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCRIvXwWUVEt5I5vmDTXk46PGo3QLqy4Uvc6qRwc3Ggg&oe=6A93FC53"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78Kd2IVF-7QQ7kNvwHlUOft&_nc_oc=Adpy67tmLo_BC3yEnP26sX5NE2O1S5KUVo_zRg9DSo1yCvD4j8TJVKUYm_35Sha1ew8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBf1ieJ5hWll7IbV20lm94NUELqE0Vw26G_KSB9D1lWw&oe=6A9413BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lWyNC7CgmcQ7kNvwFR046h&_nc_oc=AdoG8igBPKW_oh7IeFhP6zk6mkKDFH_v81U7UM95dvFGREqHHoElGrlpzRwTzuz-7vs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnGIcnaQVsNqKfqlUGqilW9c_w0oBlOozh9JV7BvRBsQ&oe=6A9413DD"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "story", "music"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa Peri\u201d is a visually stunning experience based on classical music and ballet by composer Paul Dukas and produced by the award-winning french VR studio Innerspace. It relies heavily on the touch hand controllers, and will enable you to interact directly with the characters and creatures which populate this world.\n\nDuration : approx. 15min", "short_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La Peri, and witness a magical and poetic encounter as one of the characters... "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innerspacevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.innerspacevr.com/terms", "publisher_name": "InnerspaceVR", "support_website_url": null, "website_url": "https://www.innerspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
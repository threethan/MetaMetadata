3746_1339460014462670_5588141636791046472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIsU-R80ZyQQ7kNvwEnP2ZL&_nc_oc=AdoyMMeMa1ikUrGIC7Pnh0IoUGAHWZ84obaYhca5eh8fbE-Lp2FB0new0NXEewpHhDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFr1KiXGxMWsj971l27koMt0sFeyA5CQTzAykeojtG6w&oe=6AA2B513"}, {"file_name": "Screen-05 (1).png", "id": "1345724764344008", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827601_1345724771010674_7336701805348910475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yccmS6lh8rgQ7kNvwH9n6K4&_nc_oc=AdrgqIvWc7EvMCM3EqRJhfRCLlXT-OV8aPehiLaVdWG3jPSBOH0x70NF_dkGm-jNDOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_pQphC8x9g2JyRlcjthKgw7f5fOKlCa8qaEQ-zoN2lg&oe=6AA2CC7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_video_oculus.png", "id": "1742889413495715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829120_1742889416829048_5765222117369477615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd9ebiaIUSoQ7kNvwGnCu_g&_nc_oc=AdrfY6AaG2Z9HVj9NbdksiA_-6mG8_o1nRSuKIVrMJ6xtj3omGYavjwMW4t5gIovHoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1gS6HkWeYTGw0Grynoq3oSr-s3tQXUww_gHAhLWfWQA&oe=6AA2CC9D"}, "display_name": "FIREBIRD - La Peri", "keywords": ["dance", "character", "narrative", "roomscale", "disney"], "long_description": "Enter a realm of enchantment with \"FIREBIRD - La Peri\", and play the role of Iskender, a prince seeking the \"flower of immortality\". You will appear on the stage, visit the ethereal world of La P\u00e9ri, and witness a magical and poetic encounter as one of the characters... As you try to take possession of the precious flower, guardian spirits will gradually appear. Strive to get the petals of the flower from them and awaken La Peri, a mesmerizing feminine silhouette covered in light. Her dance will dazzle you, but will you be moved enough to give up immortality and let the Peri live ?\n\n\u201cLa 
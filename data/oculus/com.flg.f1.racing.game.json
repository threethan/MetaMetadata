om&_nc_ss=7f20f&oh=00_AQSv8DGkvLxtHF1bd0iY1vewN-wj_b6OnwAUgofCusYonw&oe=6AFDD29E"}, {"file_name": "f3.png", "id": "1066428419070234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1066428422403567_2732555184158754781_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3Mb9VWq9soQ7kNvwFDsaZm&_nc_oc=AdrngimZsI_VuRf8B_PWhv1iXKnU-LeTpLGNCxrKRLOrjmprQDChmWmTBaMCMOnh0Y8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8fGInnYvEtAYoXYuA2TYFKI2V14Bgecr7IY6AXZ8QHA&oe=6AFDCBA6"}, {"file_name": "f2.png", "id": "1732684611087288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_1732684617753954_8358954878826562698_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4MLB1BzOVgQ7kNvwGdt9aM&_nc_oc=AdpKGWfFpSReC8Tt6y1Jc_hN2w42EPMP7G3LE-hs24Pv6KnBU6166dn0dwJpOcIZbzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdw_P1wqL2GsOGg67SX3AeWiYYkPhhLperbJDm4bc3eQ&oe=6AFDB996"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Formula Racing Grand Prix", "keywords": [], "long_description": "**Formula Racing Grand Prix** is an exciting high-speed racing game that puts you behind the wheel of powerful formula race cars. Experience the thrill of competing on a variety of challenging tracks filled with sharp corners, long straightaways, and intense competition. Test your driving skills as you race against skilled opponents, improve your lap times, and fight for first place in every championship event.\n\nEnjoy smooth controls, realistic racing action, and fast-paced gameplay designed for both casual players and racing enthusiasts. Each race requires quick reflexes, precise steering, and smart racing strategies to overtake rivals and avoid mistakes. As you progress, you'll unlock new challenges, compete on different circuits, and prove that you have what it takes to become the ultimate Grand Prix champion.\n\nWhether you're chasing the fastest lap, battling for the podium, or simply enjoying the excitement of professional-style formula racing, **Formula Racing Grand Prix** delivers an action-packed motorsport experience full of speed, competition, and adrenaline. Start your engine, push your limits, and race your way to victory!\n", "short_description": "Formula Racing Grand Prix is a fast-paced racing game where you drive high-speed formula cars on exciting tracks. Compete against skilled opponents, master sharp turns, and race to the finish line. Improve your driving skills, enjoy smooth controls, and experience the thrill of becoming the ultimate Grand Prix champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fun-land-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fun Land Games", "support_website_url": null, "website_url": "https://sites.google.com/view/fun-land-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1248008805066659"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507840145_2356324618235797_1547251004752799933_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mo_KUjvd7gAQ7kNvwFQOdyX&_nc_oc=Adq0Osq-KoKw1CxacpgfMFDRe8UB3ksmaWQdXcGm-FjRwtYI6SBlaLOvtE3qEASt5LI&_nc_z
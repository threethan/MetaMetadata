ag", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28536658549313477"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391974_562583806809260_8615287452100216975_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ONSjaT9aDEQ7kNvwFk2JS7&_nc_oc=Adn0I_Zs1I3u388BRsoa7_NpkY9Hs7jEd33bQ_uSADaGU4AI6L5wHFopXJ6bl2UANGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afub-u7RhyCibMCdeEdaJXr6fa9-0yOJvySsv2BOqdKRrg&oe=699B0721"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fortnite Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1741444620, "lastRevision": {"nodes": [{"id": "28536658595980139", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28536658535980145", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "943344263978611"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images"
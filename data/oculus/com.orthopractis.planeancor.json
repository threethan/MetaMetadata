g?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boXongcjencQ7kNvwHTVbvp&_nc_oc=AdrSsLBMHfKXwlnwchPDRy8N3WSebWRkSCxQVDpE0rL8vhQcSuraj9kB1sUsjd14u_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhRRiXE3qeuvReYNJu02OIgQwj7yliVLtIViMJvCGV6A&oe=6B104402"}, {"file_name": "04_Model_Scale_Controls.png", "id": "1201940805505139", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842248_1201940812171805_3186134582892964530_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyu-LZw68rUQ7kNvwGyQlS7&_nc_oc=AdqZFIuaNHG9qpOYQYp9f1-VwHLEdxv702hFgBGJFfBltDzSnONKnQfVnWiiG0qa-jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX46G0iU_hLXxcFuEYGyCA5Of2VUL9RmyrWz19OZjraig&oe=6B105C37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PlaneAncor_Trailer_Cover_2560x1440.png", "id": "1170659198996747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842201_1170659202330080_4365009644655217035_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IS1GJBwcfQQ7kNvwE4Zw2m&_nc_oc=AdqRsDdU9vsZwX-FPgB5af2Pwsj_9RCOcRN_1PZpaZcxAKZoZEFue6xi6VLldxPX8qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTe2zg4m1rTNJfG1xqdxL5l52lx-veItb-zUytOwwa6w&oe=6B1068A1"}, "display_name": "PlaneAncor", "keywords": ["planes", "registration", "models", "spatial"], "long_description": "Bring 3D models into your room with PlaneAncor for Meta Quest. Select a floor and two walls from Meta's saved room map to create a visible coordinate frame. Review models in stereo over passthrough, with clear plane outlines and optional sparse grids.\n\nImport FBX, USD, USDA, USDC, USDZ, glTF, GLB, OBJ, STL and PLY. Folder import includes related files and textures. Models appear in front at their source scale. Use hands or Touch controllers to grab, move and rotate models; use two hands to rotate and scale. Move and resize the floating window, or use exact transforms, movement constraints, opacity and wireframe.\n\nMeasure distances on room planes and model surfaces. Review supported uncompressed grayscale CT/MR DICOM series with window/level controls. Save and restore scenes; export measurement CSV, scene JSON, originals and portable scene ZIPs.\n\nOptional encrypted local-network collaboration shares scene data and files with trusted Android/Quest participants. Core tools work offline without an app account or subscription. Includes a 100 mm test cube.\n\nRoom surfaces come from Meta Space Setup; this is not live camera scanning. Large or unsupported files may need conversion. Independently verify alignment and measurements. For visualization, engineering review, education and research; not certified surveying, metrology, diagnostic software or surgical navigation.\n\nSupport: info@orthopractis.com", "short_description": "Place, transform and measure 3D models in your room. Use hands or controllers, transparent plane guides and movable windows for immersive mixed-reality review."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.orthopractis.com/privacy", "developer_terms_of_service_url": "https://www.orthopractis.com/terms-of-use", "publisher_name": "ORTHOPRACTIS.COM SINGLE MEMBER P.C.", "support_website_url": "https://www.orthopractis.com/planeancor", "website_url": "https://www.orthopractis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "s
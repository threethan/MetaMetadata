&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5hL2MGvXOAQ7kNvwFRevJv&_nc_oc=Ado9NtQIXe2_-WndOeI8BSlkzKAFe2oSY9K2dlcZ6KdW_3yfkzQBSoD1G-lgDXnr6a8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc49ciI7ZQl873x7-uNavfQ1hzV1QWZcaFG7L8iIM_KQ&oe=6B01E835"}, "display_name": "Hyper Run - VR Fitness Games 3D : SciFi Race Game", "keywords": [], "long_description": "This 3D virtual reality game will help you exercise. Using the movements of jumping, squatting, raising left and right hands to control, will help you both play games and practice sports at home.\nHow to play.\nThe player stands upright on the floor and uses 2 touch controller.\nJump high to avoid obstacles.\nSit down to go through the tunnel.\nRaise your left hand over your head to go left.\nRaise your right hand over your head to go right.", "short_description": "This 3D virtual reality game will help you exercise. Using the movements of jumping, squatting, raising left and right hands to control, will help you both play games and practice sports at home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sachanhviet.com/privacy/", "developer_terms_of_service_url": "https://sachanhviet.com/terms/", "publisher_name": "Le Son", "support_website_url": null, "website_url": "https://sachanhviet.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1092351965047501"}, "review_mess
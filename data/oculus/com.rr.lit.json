5Uuqfy52VJUJc9_NRubuwuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8f5cgbwHQw0ETcJnjBR08bIcdGKqJFiLaPJlp6PQI2A&oe=6B0F1FB8"}, {"file_name": "screen5.png", "id": "547814163935384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269593_547814167268717_5127817127143993804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDeTpcEq5rYQ7kNvwEUnIG7&_nc_oc=Adr1a9_3gTlv6K0N0pspoNZOaGlODDFQcyEaUqwvmGPtZLIfwW_Cqmys9BDqvQDOBlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLaQ8MKmVCzTNa8agj8OnptihnXbt0AvLsWzPMPgF-UA&oe=6B0F060E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbb3TJQKx2UQ7kNvwFBzkuk&_nc_oc=AdqMo8t16bbIAMeetgCKv4QShF1x4iK0yQom9iTEiCUSAj6GLTwP8qnmOJ1L-7CFges&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWsxsPd1nUHaT_pibo3j8_RpLPR7v7TyJQfpnV5HMdT8w&oe=6B0EFAE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
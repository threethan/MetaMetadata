717_5127817127143993804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sw-FG1PmkuQQ7kNvwFLt_yC&_nc_oc=AdrE_-zLDzBOs6P_qS5XVdVF73Yxqi2ypqAUDHti2XsxcvkViZ5d7TjAYIfsF2DUTQM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMphTdPn87zsLqMYZdqqr2ITbxz4ceLdK3NwAzLlxzauA&oe=6AC8EE4E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHoLTYLIzvoQ7kNvwGG3mV8&_nc_oc=Adrsc6IjkGl-QgfHdhhjXgc3cWIQkcojzNC7xx-ZSPbxTP9GvKMAnDYI3_839R8Qxik&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4-gSZW03cqtlB5meFdM9KMAeI5NTnAItAXxWCQgzykQ&oe=6AC91B66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.refinereality.com/lit_privacypolicy.html", "developer_terms_of_service_url": "https://www.refinereality.com/RefineRealityEULA.pdf", "publisher_name": "Refine Reality Ltd.", "support_website_url": null, "website_url": "http://www.refinereality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_c
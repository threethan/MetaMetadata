uzyJNHyX6tYhMgkyx1CQZUw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTusy6UnYoTRAeEN-De9ZsnyyHaYYcrb8LrqKIjm6oo2g&oe=6AFF1578"}, {"file_name": "screen5.png", "id": "547814163935384", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75269593_547814167268717_5127817127143993804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRlP1yyTB9IQ7kNvwFs74aI&_nc_oc=AdprS-AnRn5mEDXfIg4AMSY5Pt2ReoepjwCTy8FGNXId89Ycnk1IANKQhTtT8jeiAeM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-wZgpcIzPt__7sudBkbm72kL_N8npJ5Re3HGRheqyuA&oe=6AFF340E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fV_AiXN7zkQ7kNvwHRF4-k&_nc_oc=AdrJB8jF92oDAmEvuRwyQRRVsWc4d44nmZ19USoRw_QReEy0FvJDXVQSRK0gyaS2HiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0E_W6Eb8nkomHIiCPMOwZo1OM-U_tQmsVQjgmw3CKIQ&oe=6AFF28E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
717_5127817127143993804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDpb9vvtdyUQ7kNvwH65cZB&_nc_oc=AdqHMTJfusT7iw7nh-KRUBJNH2CAY_7ts063cHnODv03Z7jzv36IJhQPFAQ--OtV9N0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w9_e32WeQq3OKRcwgLvMLBzoZhyVC7bTTjOhYHiZ4-Q&oe=6A32A34E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9v7my4VtpgQ7kNvwFD5fQE&_nc_oc=AdolMQQxYM2h3GUozvPxGBet1wyX71RslkJVPp8WYI0sSuEUu3-YUWaMXJP2gltW53k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88fXE31dS_8flTQ3aRx880DPrZIvtU-_QzbDqHbgPmxA&oe=6A329826"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.refinereality.com/lit_privacypolicy.html", "developer_terms_of_service_url": "https://www.refinereality.com/RefineRealityEULA.pdf", "publisher_name": "Refine Reality Ltd.", "support_website_url": null, "website_url": "http://www.refinereality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_c
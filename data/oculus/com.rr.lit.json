717_5127817127143993804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMOS7UH3v8cQ7kNvwGDSAop&_nc_oc=Adqz5ntx1NX522782Z2Qb9PA5qPrG8_WLaQMiVG1e2wiV-lMqsSaC1l_usAko_-gQ4U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b3LRA3LQR9rxTUQpA24ncuU-egBwJOLd9YEOPtWFhKg&oe=6A202E4E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ao8NlO_ETy0Q7kNvwF6E9jY&_nc_oc=Adp_BxTE-Bk5sUftWKeC5iVmmCCnk5NilX2aovdOFjuyilgq5_JXdkP8-8X31ziGrak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vlop-FTTo2sOMNF6U8JOpjR-7GL0vP17vBKVnExi_fA&oe=6A202326"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.refinereality.com/lit_privacypolicy.html", "developer_terms_of_service_url": "https://www.refinereality.com/RefineRealityEULA.pdf", "publisher_name": "Refine Reality Ltd.", "support_website_url": null, "website_url": "http://www.refinereality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_c
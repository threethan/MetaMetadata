q9sht4-j5QroX03CLb4kwWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0JVW8yxS4kM8HSXkuYpzEstpkBeZoqyHBfRYCjUgpkg&oe=6B0DCE38"}, {"file_name": "screen5.png", "id": "547814163935384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269593_547814167268717_5127817127143993804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDeTpcEq5rYQ7kNvwEPtq0p&_nc_oc=AdoDgqGI5oWw8RgHSdSI0q_qsCE-zt7_oPUBfQy_ch4zhDszfntb0_Lg-2pnH_1cD74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRseZNsQ2lcd5fMbCNgyVOf1cDNiP6lxqNz5D03EFdxQ&oe=6B0DB48E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbb3TJQKx2UQ7kNvwH_g--2&_nc_oc=AdqbJCna_l1mno4n4anJZxJ8p3Wthf-qTgxFpcZvJs1PP9EiQinA0XdgBZcv6LSOepM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdnESSsa6Qc9SEULVoHSIWL1a4B5SUSf-He8R3QehsaA&oe=6B0DA966"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
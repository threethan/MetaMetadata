5EwbUFpfD23jGD6QbJ4bwYA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDR5iqbN6wWRDhgrbeFKFrmpWRkuRK2XDGnkJD99yPiw&oe=6B0309F8"}, {"file_name": "screen5.png", "id": "547814163935384", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269593_547814167268717_5127817127143993804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czIgrd9d1gUQ7kNvwFEX2b4&_nc_oc=AdqEVZBzDOyPC_U80Uizs9mVE0euRebB_AilBSZ9N-SyUiokonorht418HuDPu0tNmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe94yiSQ5brcDVdeEqwi42d7raplPJ-_urNGTzfaX2vQ&oe=6B03288E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvGNi_XzYSQQ7kNvwGR44Is&_nc_oc=AdrpqTalVF2nCPSoVpXkmrXF1HWU3b1xZyX5BuHY3WwY3qUt2I56qZiqHNnHfQfqx3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbiYzfGtQGSzu4M-ufNFlABaw3eNccWOjAfZ0nXtzNGQ&oe=6B031D66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
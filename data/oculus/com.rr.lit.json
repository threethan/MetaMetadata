xT8022770UD2juI2jFto7jM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFO5V4-bd_7jUdXfQDq4Dr0_3rv3OhSt8Zrdphegn5_A&oe=6B045B78"}, {"file_name": "screen5.png", "id": "547814163935384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269593_547814167268717_5127817127143993804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXM2zXt0NyYQ7kNvwEjzNm9&_nc_oc=Adouub_ZKbKmcGVl5rvSeTlh9zdkAX2sNKdAPpn81QLbEg599Q_HknMVaqJRiq-6wk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsPnlHqLpoAG4AnEFwXEIzQU84klvb6o10b_3jLQ9JCQ&oe=6B047A0E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvGNi_XzYSQQ7kNvwFXtZCW&_nc_oc=Ado-b6V74PVDKlR1Pp5z6lgvCU2pN3lG4ciwrBo0-S5rgGBMKPf2sHHJQr6yurPmcls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4NijUVpRrgFtOfzUNC6-jA-Kgokd98NjhQGmyMuCBPQ&oe=6B046EE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
pqyP1pJP_4WM0BLQuNnM6Ps&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR6HwjYphCjJb06lGybyI4UHrIiBfFSo3OPx2DAI7F5g&oe=6AFC7278"}, {"file_name": "screen5.png", "id": "547814163935384", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75269593_547814167268717_5127817127143993804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRlP1yyTB9IQ7kNvwEmZIZe&_nc_oc=Adr4jJUZRmEi3lpCd-n0zbwfUXxTH0RgXtsZIiSAjHWZLM1XranXjdp0HY-asD6cUYY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsfFaerssAfLTxo4XtJxj77RXGtNM05pqlDRZsiyDs_g&oe=6AFC910E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJe9clEeHNAQ7kNvwGLfvzW&_nc_oc=AdppYqszwYOYVjbhFBZlmOzhK6tlqVxBcHxJM4Undzou0BxtMvDU0fEcFFB0cMr7Tpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtgp62AL6wll_uasc4DOZaCTP1QWpAG2dueZeoWPS64w&oe=6AFC85E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
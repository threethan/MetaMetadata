7814167268717_5127817127143993804_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK1XNZ-55s0Q7kNvwHUeDjE&_nc_oc=Adq83wMjbRZrCr_OUu4EUs2VOZlWpSLsT4bP77O9M9wpMT6dn5-UJmF9M3IlJQIdsPM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RLa6SChjjm_ZIJeSC5iwRJBwsy-88SrOeol89hNVXPQ&oe=6A3697CE"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCrKOQreOo0Q7kNvwGwzz1K&_nc_oc=Adr--Fu5KqCcxNIruk3JLxQaP5zpMDZU4JxZDCrO0DikmEMkc0_sRSLssLLVD9aogVE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_atrW5P3k-53PAJebE9K-1PrCJ6IKWgrIK-QDMQl1PPw&oe=6A36C4E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.refinereality.com/lit_privacypolicy.html", "developer_terms_of_service_url": "https://www.refinereality.com/RefineRealityEULA.pdf", "publisher_name": "Refine Reality Ltd.", "support_website_url": null, "website_url": "http://www.refinereality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], 
HwMbMsa8jTob5Rfjz93R2H4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3edQ7tHiGqB7cKLy6IOkarwLZKfA9zQPhUOFb7nWqLg&oe=6AFB20F8"}, {"file_name": "screen5.png", "id": "547814163935384", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75269593_547814167268717_5127817127143993804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt1PmRggXB0Q7kNvwGp3rKe&_nc_oc=Adr1niz0rfLsK-B53LrOMDW3oM4nFslMCwaz5AQiAfLh5_qdkHRDuDiiQ1KvdiI-_CU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm_EIZrwFM60-z__69fFF1ROyhH62OyXbFyTRh_GqExg&oe=6AFB3F8E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJe9clEeHNAQ7kNvwGrqXxC&_nc_oc=Adrk42G2GCDFl_9t-_D3xlellPTe6tuKzALurQ266IE1OQvehWXotpJViNXYu_wYySQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIUQJBgwzIHTdDimU6p0Zn1il4gF2I3HKKoSciDg135A&oe=6AFB3466"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
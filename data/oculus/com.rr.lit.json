uNj9aVuXti9DDjiu7R7Fmus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWqKXjInS2q0A9Yu8TUMQ79XEbDTc4494pMdcdOugH1JQ&oe=6B1038F8"}, {"file_name": "screen5.png", "id": "547814163935384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269593_547814167268717_5127817127143993804_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N87nSM7G7DkQ7kNvwESWQUB&_nc_oc=AdrBNfR5MnT_SGyCaBpz67sODjhLvw2omOMSy1ipVIZVQau0tvEVlBsMQ92c1mUqVlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTcZE5laNGeCe9U7lhhIoxqB3GZF1-MzKHm0gWNVyXTw&oe=6B10578E"}, {"file_name": "screen1.png", "id": "538182551362583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_538182561362582_6388165844880813054_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbb3TJQKx2UQ7kNvwG19guL&_nc_oc=AdpQw91R-qmJ7CQPzWejQVCZ5cch5Iz7n7Orm732UJvzBQYwOEt5Bxo3YSvgkkUmSms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUsO34gZM_ysnMU4tsIUT1aYP4uv9k5nSRijZ-qyzwilw&oe=6B104C66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIT", "keywords": [], "long_description": "Bayre City at night is known for it\u00b4s roaring street-racing scene and network of fast open roads. If you are willing to risk your good night\u00b4s sleep, you are in for a ride. Starting from the bottom with your classic whip, you build reputation, wealth and speed as you go. Just remember you are not alone with your dream of more than 30 highly detailed, customizable vehicles and apparel. Get ready to light up the city together.\n", "short_description": "Take the driver\u00b4s seat and zoom into the night. Lit provides an impressive immersive racing experience from the garage drawing board to high-speed rivalry on the streets of Bayre City. When you see cars gathering around and ready to go, it could be your next time to shine."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
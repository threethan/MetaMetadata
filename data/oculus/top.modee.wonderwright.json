?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3hnnhhduasQ7kNvwFHrUB_&_nc_oc=Adoh6MDJdP2a_Ll3lkFZGCh38OxcN0o8tniLJdmIvhE4wLv044decqypMDuI0eilrPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXq8vYqrY9h9LAx53QWSSkxFRTDRv3q6Y29xULKcXdBDg&oe=6B0EF2FB"}]}, "id": "1671270067733315", "locale": "en_US", "screenshots": [{"file_name": "10-3 \u622a\u56fe 13-desk-cards.png", "id": "2605667473285362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624583_2605667476618695_2348290727179242389_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aChkbVYZoHMQ7kNvwEmsWb4&_nc_oc=AdrycvloPvWlbku5hqAAb5Hx8AjhhAd04NDW1EtqmtexPtZkRPf_lI2B6NTIncwX6CQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGWaMaeYIan8Bg0ofh1lFcLie5stNoT9KWrfaggNwrBg&oe=6B0EFEBB"}, {"file_name": "10-1 \u622a\u56fe 03-desk-colosseum-model.png", "id": "1663411518908930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620403_1663411525575596_4914259998482724599_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_LqktmnkxIQ7kNvwFghwDQ&_nc_oc=Ado-jfABzQ3iYiEh4hqYjZLznVt6j2p3YMf00S7l7iVOcVLhIkws1YmVMAmBvJYsrv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWT-R1Hu5EDcsdBsaBL5q--cwCe4Nq2unp4ZROfqZ5Tog&oe=6B0F1DD5"}, {"file_name": "10-2 \u622a\u56fe 04-colosseum-arena.png", "id": "1549264467006787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628446_1549264470340120_6108141318154304929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gd6vczRwgr8Q7kNvwGDiiQt&_nc_oc=Adq831njuGkMMu1ayjUoO_982xkaFTK9a2aKCebAMrAe6q1a9caH_xVl_NR1wHhURns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUx7v9SDeNtP-bNStz3u0zrTBQ7oKl_aUAsNeHyvix0EQ&oe=6B0F0BD4"}, {"file_name": "10-5 \u622a\u56fe 12-machupicchu.png", "id": "1178175228219884", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620599_1178175231553217_738260115116245992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GsZD7n_lb0Q7kNvwFDH46O&_nc_oc=AdpaxrfhAB5VNyu4YnlSmpTB1KFbtUNzfXbX0TdSvK1UJqNBip10clOy6aW0gM5nLaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVoihKvSXoD4pyZQFN52JbOhmY7ukLf0p2d-Ene6x0kXQ&oe=6B0F0EB5"}, {"file_name": "10-4 \u622a\u56fe 11-hagiasophia-dome.png", "id": "1145773241170253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1145773247836919_495373952477332768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oTXdYnQq4QQ7kNvwESpzoF&_nc_oc=Adoj0_SVtqSIqLhM-7eksqBGhcCb07kQ1kLEFNptVfXY1m5_yMTDpn1XsXsHabRkfiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgT5yh6AsLgLtNcNAyrPah25qIcipjZnuOtALxp8vHUQ&oe=6B0F0E64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "9b \u5ba3\u4f20\u7247\u5c01\u9762 trailer-cover.png", "id": "2233359904729297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593815290_2233359908062630_1260340172266701096_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KTTmiZEgPQQ7kNvwGMZyCP&_nc_oc=Adqv_V-5yO1b_9InwNVpnQZKPo69D8Oow_h04TUp9d__f9gWjLv-lNXUbuvotApcPGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwY8zJP8gc2xVBVNxQwvY_DMWt7h0PyvBe3w50lAR_dQ&oe=6B0F0EE5"}, "display_name": "Wonderwright", "keywords": ["architecture", "history", "building", "wonders", "travel"], "long_description": "Open a treasure chest on your desk and a wonder of the world tumbles out in pieces. Pick them up, turn them in your hands and build it the way it was really built: arches before the keystone, buttresses before the vaults, the central pillar before the pagoda roofs.\n\nWhen the last piece clicks in, your model rises on its walnut plinth. Then step through and stand inside the real thing, at life size, under a real sky, with a guide who tells you what you are looking at.\n\n- 15 wonders: the Colosseum, the Great Pyramid, the Great Wall, the Taj Mahal, the Parthenon, the Pantheon, Hagia Sophia, Notre-Dame de Paris, the Leaning Tower of Pisa, the Arc de Triomphe, the Temple of Heaven, Angkor Wat, Machu Picchu, Chich\u00e9n Itz\u00e1 and H\u014dry\u016b-ji\n- Real construction logic: every building comes apart into its true parts and goes back together in a sensible order\n- Step inside at life size: walk the arena floor of the Colosseum on its opening day, stand under the Pantheon's dome, look out from the Great Wall\n- Narrated guided tours and a short film for every wonder\n- Hand tracking or controllers; a cosy explorer's study, a sea view or passthrough on your own table\n- Relaxed and untimed\n- English and Simplified Chinese, with full voice narration in both\n\nMusic: Kevin MacLeod (incompetech.com), licensed under Creative Commons: By Attribution 4.0.", "short_description": "Build the world's great wonders piece by piece with your own hands, then step inside them."}, {"images": {"nodes": []}, "id": "1092588390271465", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wonderwright \u4e07\u56fd\u8425\u9020", "keywords": [], "long_description": "\u684c\u4e0a\u6253\u5f00\u4e00\u53ea\u5b9d\u7bb1\uff0c\u4e00\u5ea7\u4e16\u754c\u5947\u89c2\u6563\u6210\u4e00\u5806\u6784\u4ef6\u843d\u51fa\u6765\u3002\u62ff\u8d77\u6765\u3001\u5728\u624b\u91cc\u8f6c\u4e00\u8f6c\uff0c\u6309\u5b83\u771f\u5b9e\u7684\u5efa\u9020\u65b9\u5f0f\u62fc\u56de\u53bb\uff1a\u5148\u7acb\u62f1\u3001\u518d\u653e\u62f1\u5fc3\u77f3\uff1b\u5148\u6709\u98de\u6276\u58c1\uff0c\u624d\u6709\u62f1\u9876\uff1b\u5148\u7ad6\u5fc3\u67f1\uff0c\u518d\u4e00\u5c42\u5c42\u76d6\u5854\u9876\u3002\n\n\u653e\u4e0a\u6700\u540e\u4e00\u4ef6\uff0c\u4f60\u7684\u6a21\u578b\u5728\u80e1\u6843\u6728\u5e95\u5ea7\u4e0a\u843d\u6210\u3002\u7136\u540e\u7a7f\u8fc7\u4e91\u6d77\uff0c\u6309\u771f\u5b9e\u5c3a\u5bf8\u7ad9\u8fdb\u5b83\u91cc\u9762\uff0c\u5934\u9876\u662f\u771f\u5b9e\u7
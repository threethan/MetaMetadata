?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3hnnhhduasQ7kNvwH71nsz&_nc_oc=Adr-mOCV23zX3_r7zo4MzfgmfZ31eDnrEojlQ0CRaTAKcmQ6K1V2O5qI6x9A0EkKOi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmOh6Dc8bP1k6IJNVs-VvJElV9qcxHDlOiA6PP8k11nA&oe=6B10447B"}]}, "id": "1671270067733315", "locale": "en_US", "screenshots": [{"file_name": "10-3 \u622a\u56fe 13-desk-cards.png", "id": "2605667473285362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624583_2605667476618695_2348290727179242389_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aChkbVYZoHMQ7kNvwGJeg-0&_nc_oc=AdqgxEn70Wee4hqHolQCde5n0or5rEQFoUV8DyAxrXwzN1T2Q_BrvSrt9UOByqsbEFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUTBAkWvQNEFLFv6sF-CEWp48TAXGMfwqLxTXswrMV1GA&oe=6B10503B"}, {"file_name": "10-1 \u622a\u56fe 03-desk-colosseum-model.png", "id": "1663411518908930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620403_1663411525575596_4914259998482724599_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_LqktmnkxIQ7kNvwGn3q4u&_nc_oc=AdoUm6AkyOcNA2c_Cy70VNgMt9zXvx3xKdAVYDH_VzZGXUQW8tINoOd-Y0AMGRd7rBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXx011elu-Ggj7xOL32WWBzIu8f8rsNt5wlfY_Yw389g&oe=6B103715"}, {"file_name": "10-2 \u622a\u56fe 04-colosseum-arena.png", "id": "1549264467006787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628446_1549264470340120_6108141318154304929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gd6vczRwgr8Q7kNvwGwrl9t&_nc_oc=AdrTaVlBmwdOkggoFi2OQMm3RS_Tk-Bn17d4Ux2HrcCPlH1P27wT5yHPkZEGQ1Cy8L0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0PsDTuGDD0cA1FybN0HK1lhmYLgNNso0FH05qGK7NUA&oe=6B105D54"}, {"file_name": "10-5 \u622a\u56fe 12-machupicchu.png", "id": "1178175228219884", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620599_1178175231553217_738260115116245992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GsZD7n_lb0Q7kNvwHHz9vE&_nc_oc=AdpdcO2P7GcH0o9Xe2GKKPUyxFBVShhVvI6uEvww8Ris_v5ULtp_-mjgPErwJaXtuu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQfgX_hCZoRG27N3WOxA8rPcVcbe0oOD7kIykJUP4P9Q&oe=6B106035"}, {"file_name": "10-4 \u622a\u56fe 11-hagiasophia-dome.png", "id": "1145773241170253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593942860_1145773247836919_495373952477332768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oTXdYnQq4QQ7kNvwHVYpfJ&_nc_oc=Ado_9RLM1Ee5RGxrZ1tfdFBa5BVNjpE4mFe2RuK_tH-6mP3lxhHtJz3YE7K6sgw-W44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdxEirlUcjMa21giIhNzr69idD6-eZ19VDjrOWdGHNSg&oe=6B105FE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "9b \u5ba3\u4f20\u7247\u5c01\u9762 trailer-cover.png", "id": "2233359904729297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593815290_2233359908062630_1260340172266701096_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBtEqDZmdrcQ7kNvwE3Llbh&_nc_oc=AdrnKqJZqSh9c-ixYs7JkeLa5VelTnDpTaa_f4YnO1dfHYQq-UwpDzWhQ0VGvils3KQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVyodEOend4keWxhdjSooMT0dzdlCkMdlBZScFp_y9CZA&oe=6B106065"}, "display_name": "Wonderwright", "keywords": ["architecture", "history", "building", "wonders", "travel"], "long_description": "Open a treasure chest on your desk and a wonder of the world tumbles out in pieces. Pick them up, turn them in your hands and build it the way it was really built: arches before the keystone, buttresses before the vaults, the central pillar before the pagoda roofs.\n\nWhen the last piece clicks in, your model rises on its walnut plinth. Then step through and stand inside the real thing, at life size, under a real sky, with a guide who tells you what you are looking at.\n\n- 15 wonders: the Colosseum, the Great Pyramid, the Great Wall, the Taj Mahal, the Parthenon, the Pantheon, Hagia Sophia, Notre-Dame de Paris, the Leaning Tower of Pisa, the Arc de Triomphe, the Temple of Heaven, Angkor Wat, Machu Picchu, Chich\u00e9n Itz\u00e1 and H\u014dry\u016b-ji\n- Real construction logic: every building comes apart into its true parts and goes back together in a sensible order\n- Step inside at life size: walk the arena floor of the Colosseum on its opening day, stand under the Pantheon's dome, look out from the Great Wall\n- Narrated guided tours and a short film for every wonder\n- Hand tracking or controllers; a cosy explorer's study, a sea view or passthrough on your own table\n- Relaxed and untimed\n- English and Simplified Chinese, with full voice narration in both\n\nMusic: Kevin MacLeod (incompetech.com), licensed under Creative Commons: By Attribution 4.0.", "short_description": "Build the world's great wonders piece by piece with your own hands, then step inside them."}, {"images": {"nodes": []}, "id": "1092588390271465", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wonderwright \u4e07\u56fd\u8425\u9020", "keywords": [], "long_description": "\u684c\u4e0a\u6253\u5f00\u4e00\u53ea\u5b9d\u7bb1\uff0c\u4e00\u5ea7\u4e16\u754c\u5947\u89c2\u6563\u6210\u4e00\u5806\u6784\u4ef6\u843d\u51fa\u6765\u3002\u62ff\u8d77\u6765\u3001\u5728\u624b\u91cc\u8f6c\u4e00\u8f6c\uff0c\u6309\u5b83\u771f\u5b9e\u7684\u5efa\u9020\u65b9\u5f0f\u62fc\u56de\u53bb\uff1a\u5148\u7acb\u62f1\u3001\u518d\u653e\u62f1\u5fc3\u77f3\uff1b\u5148\u6709\u98de\u6276\u58c1\uff0c\u624d\u6709\u62f1\u9876\uff1b\u5148\u7ad6\u5fc3\u67f1\uff0c\u518d\u4e00\u5c42\u5c42\u76d6\u5854\u9876\u3002\n\n\u653e\u4e0a\u6700\u540e\u4e00\u4ef6\uff0c\u4f60\u7684\u6a21\u578b\u5728\u80e1\u6843\u6728\u5e95\u5ea7\u4e0a\u843d\u6210\u3002\u7136\u540e\u7a7f\u8fc7\u4e91\u6d77\uff0c\u6309\u771f\u5b9e\u5c3a\u5bf8\u7ad9\u8fdb\u5b83\u91cc\u9762\uff0c\u5934\u9876\u662f\u771f\u5b9e\u7684\u5929\u7a7a\uff0c\u8bb2\u89e3\u5458\u544a\u8bc9\u4f60\u773c\u524d\u770b\u5230\u7684\u662f\u4ec0\u4e48\u3002\n\n- 15 \u5ea7\u5947\u89c2\uff1a\u6597\u517d\u573a\u3001\u80e1\u592b\u91d1\u5b57\u5854\u3001\u957f\u57ce\u3001\u6cf0\u59ec\u9675\u3001\u5e15\u7279\u519c\u795e\u5e99\u3001\u4e07\u795e\u6bbf\u3001\u5723\u7d22\u83f2\u4e9a\u5927\u6559\u5802\u3001\u5df4\u9ece\u5723\u6bcd\u9662\u3001\u6bd4\u8428\u659c\u5854\u3001\u51ef\u65cb\u95e8\u3001\u5929\u575b\u3001\u5434\u54e5\u7a9f\u3001\u9a6c\u4e18\u6bd4\u4e18\u3001\u5947\u7434\u4f0a\u5bdf\u5e93\u5e93\u5c14\u574e\u91d1\u5b57\u5854\u3001\u6cd5\u9686\u5bfa\n- \u771f\u5b9e\u7684\u5efa\u9020\u903b\u8f91\uff1a\u6bcf\u5ea7\u90fd\u62c6\u6210\u5b83\u771f\u6b63\u7684\u7ec4\u6210\u90e8\u5206\uff0c\u6309\u5408\u7406\u7684\u987a\u5e8f\u62fc\u56de\u53bb\n- \u6309\u771f\u5b9e\u5c3a\u5bf8\u8d70\u8fdb\u53bb\uff1a\u5f00\u5e55\u90a3\u5929\u7ad9\u5728\u6597\u517d\u573a\u7684\u6c99\u5730\u4e0a\u3001\u7ad9\u5230\u4e07\u795e\u6bbf\u7684\u7a79\u9876\u4e0b\u3001\u5728\u957f\u57ce\u4e0a\u8fdc\u773a\n- \u6bcf\u5ea7\u90fd\u6709\u8bb2\u89e3\u5bfc\u89c8\u548c\u4e00\u6bb5\u5f00\u573a\u77ed\u7247\n- \u624b\u52bf\u8ffd\u8e2a\u6216\u624b\u67c4\u90fd\u80fd\u73a9\uff1b\u63a2\u9669\u5bb6\u4e66\u623f\u3001\u6d77\u666f\uff0c\u6216\u7528\u900f\u89c6\u76f4\u63a5\u6446\u5728\u4f60\u81ea\u5df1\u7684\u684c\u4e0a\n- \u8f7b\u677e\uff0c\u4e0d\u8ba1\u65f6\n- \u82f1\u6587\u548c\u7b80\u4f53\u4e2d\u6587\uff0c\u4e24\u79cd\u8bed\u8a00\u90fd\u6709\u5b8c\u6574\u914d\u97f3\n\n\u97f3\u4e50\uff1aKevin MacLeod (incompetech.com)\uff0c\u6309 Creative Commons: By Attribution 4.0 \u6388\u6743\u4f7f\u7528\u3002", "short_description": "\u4eb2\u624b\u4e00\u4ef6\u4ef6\u62fc\u8d77\u4e16\u754c\u540d\u5efa\u7b51\uff0c\u518d\u8d70\u8fdb\u53bb\u770b\u770b\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wonderwright.modee.top/privacy", "developer_terms_of_service_url": null, "publisher_name": "JiehuaVR", "support_website_url": null, "website_url": "https://wonderw
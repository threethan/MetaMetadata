.com&_nc_ss=7f20f&oh=00_AQHZ7nyO9z3stiffJUJ4TQtvh7y-q6PPkDzalxKXwEJQnA&oe=6A8D7007"}, {"file_name": "Image Sequence_018_0000.png", "id": "1615490569494976", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825503_1615490572828309_4601331734869982877_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdTIY3l4PmYQ7kNvwEjW76-&_nc_oc=Adov2X4Dw0m8MpdPo0QuI16C2yEQRtweRpKWKFCtfv27S-4v_WqzG0WIBEsIjIkk4-M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWuI3vETuKcPzhJN5ZdouDogsb21KH69eqFzXZ-jko1Q&oe=6A8D9CD3"}, {"file_name": "Image Sequence_020_0000.png", "id": "1267359398089313", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820923_1267359401422646_6465771449544083849_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N31Z8wVcV_YQ7kNvwGZ4FDi&_nc_oc=AdphptwoCq1wCBTcVzAocA92LiPBgAlLJ8DapAmXyBL8F1py2xreQ95G19cTJb648b0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaXj_kAIHb_-ITd2k1jTk3mKn2WZGdC14nZwM345kl_g&oe=6A8D8531"}, {"file_name": "0305(1).png", "id": "2303120903544578", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821725_2303120906877911_3979693475796294133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmfuEkXpJvUQ7kNvwEksV2c&_nc_oc=AdqEAg1hhO02mvAoIMUDpdPJqwPyfw5Y3_pc-jdSoQYgJjlPO9w_nxHEuk95A_z1uM4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAmyg_goI5k9FaoSBYcA0knLFm0UVm2bM7c7n1XIuA0Q&oe=6A8D92E4"}, {"file_name": "Image Sequence_024_0000.png", "id": "1484780869737517", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825345_1484780873070850_925172048862199685_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhFi9MiQ6iYQ7kNvwFxHlC0&_nc_oc=Adr6vrl2jacQtIRRkRG2vc_HLuN3qo0sUSgOMz6pS6d2ToaYfp5FpLXjjCltzuxx8M4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER02NJ8gSwS23gWbxipKZ7S299qJ3rbjhdGtBr4dGdOQ&oe=6A8D7381"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goof", "keywords": ["Sandbox", "Multiplayer", "Social", "Funny", "Goof"], "long_description": "Welcome to Goof VR, the ultimate family-friendly multiplayer VR sandbox packed with creativity, mini-games, and hilarious fun.\n\nStep into vibrant, interactive worlds where you can explore, experiment, and create your own goofy adventures \u2014 together. Whether you're competing in multiplayer mini-games, discovering hidden surprises, or just causing harmless chaos online with friends, Goof VR is built for nonstop social fun.\n{912218251594670}\n\ud83c\udfae What You Can Do in Goof VR:\n\u2022 Explore colorful open environments\n\u2022 Play multiplayer mini-games\n\u2022 Hang out online with friends\n\u2022 Customize your character\n\u2022 Interact with playful physics-based objects\n\u2022 Unlock new cosmetics and items\n{1188123300783973}\nGoof VR is designed to be welcoming, energetic, and safe for all ages. With smooth VR controls, immersive environments, and social multiplayer experiences, every session feels alive and unpredictable.\n{925649376991183}\nNo stress. No pressure. Just pure goofy fun.\n\nJump in, get silly, and create your own adventure \u2014 together \u2014 in Goof VR.\n", "short_description": "Jump into Goof VR \u2014 a colorful multiplayer sandbox where creativity, mini-games, and goofy fun collide. Explore interactive worlds, play online with friends, customize your character, and discover surprises around every corner in this family-friendly VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://GoofVR.com/PrivacyPolicy", "developer_terms_of_service_url": "https://GoofVR.com/TOS", "publisher_name": "SupErWin Studios", "support_website_url": null, "website_url": "https://goofvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "15921929743
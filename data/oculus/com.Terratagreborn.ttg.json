flFngMOXEv1h18C6DH2YGLvYoCoVz7EwJxoIgw&oe=6B09A68A"}, {"file_name": "705908175_27227532026933391_7122319269848194527_n.png", "id": "1005972378655431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312454_1005972381988764_1074933600282345284_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lI2EGyOiDMQ7kNvwGXB10Y&_nc_oc=AdpJZL9Q1ThMceOTOjcoon7b_lxGcx5LoQ24yi-6Bqag3XNOOJQAMBBRnJ-ntK61X-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuN_DnY091hMt0vcypJY1Km76JtdbhqVC8nRBZjLQGlg&oe=6B09AC51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Tag Reborn", "keywords": [], "long_description": "Echo Tag Reborn is the ultimate physics-based VR game where your hands are your feet! Brought to you by the creator of Terra Tag, this project is built from the ground up to give you that classic, fast-paced momentum movement you love, packed with a ton of brand-new twists.\n\nForget teleporting or using joysticks to move around. In this game, if you want to move, you have to actually push off the ground, bounce off walls, and swing from objects using your own two hands. It takes split-second timing to master, but once you get the hang of it, you'll be flying through maps like a pro.", "short_description": "This is the app published by the owner and developer of Terra Tag. Bringing a massive game developer\u2019s vision back to VR, this isn\u2019t just an update\u2014it's Terra Tag Reborn. Experience all-new features and the original intensity. Get ready to swing, jump, and tag like never before in Echo Tag Reborn!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/echo-tag-reborn-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "RVX/AIDENVR/GORILLASTUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/websiteforechotagreborn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfo
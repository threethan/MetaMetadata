ll, "display_name": "Echo Tag Reborn", "keywords": [], "long_description": "Echo Tag Reborn is the ultimate physics-based VR game where your hands are your feet! Brought to you by the creator of Terra Tag, this project is built from the ground up to give you that classic, fast-paced momentum movement you love, packed with a ton of brand-new twists.\n\nForget teleporting or using joysticks to move around. In this game, if you want to move, you have to actually push off the ground, bounce off walls, and swing from objects using your own two hands. It takes split-second timing to master, but once you get the hang of it, you'll be flying through maps like a pro.", "short_description": "This is the app published by the owner and developer of Terra Tag. Bringing a massive game developer\u2019s vision back to VR, this isn\u2019t just an update\u2014it's Terra Tag Reborn. Experience all-new features and the original intensity. Get ready to swing, jump, and tag like never before in Echo Tag Reborn!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/echo-tag-reborn-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "RVX/AIDENVR/GORILLASTUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/websiteforechotagreborn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"
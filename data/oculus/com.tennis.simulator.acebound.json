uluscdn.com&_nc_ss=7f20f&oh=00_AQRZXyR-Fd-q2bCoXQ-miAM4jpzW0PuDZlLw472kqRntBg&oe=6AFC8CA7"}, {"file_name": "02_clay_sprint_backhand.png", "id": "984221684071612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628882_984221687404945_8817110933703903968_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9z3K0HsoxEQ7kNvwFFYvMk&_nc_oc=AdrTorxd2Ab70MaF8mFdJUVTv3TAY-L-8of8mmaQgXi8fWN8lfmOgQZFzwoq268Mic4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR89ERdt_JF_jjUjZPB3wcqIVobk9M9_JYJwAOzyzVPhQ&oe=6AFC7B55"}, {"file_name": "03_grass_net_volley.png", "id": "1089370903712268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_1089370907045601_1711189180082359272_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q97AgzzXl0Q7kNvwE7MncP&_nc_oc=AdrLJHad0oW7sNsLbKcYzMHyuC4VFXutzFKGIeR_arGmd_aNkQSUW98o0OTH-Mvf_nM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHPD5-NvX6dgA6qdXdPob70z_H9tMqEa7A-Hm3Ylp5ug&oe=6AFC931B"}, {"file_name": "05_training_jump_smash.png", "id": "2141752299772789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623558_2141752303106122_5042445819134938910_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq3H72WB0WIQ7kNvwFX9YGU&_nc_oc=AdoOFYK_nFl6kSCpaNOWbe-zybS58GZ5Nh2AOPjnrNOFQ3pClN1XiG28gd7w1EHTH_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWXyI28mc7yYmhMxGUXwfMCp4_rXfrzSIheAGv3fQ-EA&oe=6AFC9268"}, {"file_name": "01_hard_power_forehand.png", "id": "977154368199838", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593832569_977154371533171_7961900896561674837_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUnfTl-o77YQ7kNvwHFxSkk&_nc_oc=Adrwt3hyQMHzEb3Wn9_X5TKqOtG4OHas3y0dInS7dzZ0YGWwPMrVfXeZQ_SiMMoVBrg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvYdfdYGqofQlylllPlLgyeNHHVRqvXByQXvlkHeTS9w&oe=6AFC78C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tennis Simulator: Acebound", "keywords": ["tennis", "racket", "sports", "career", "simulator"], "long_description": "Step onto the court in a realistic tennis simulator built around your swing. Feel the difference between a clean sweet-spot winner, a sliced return and a mistimed frame hit. Every serve, rally and match is yours to play\u2014fully offline.\n\nREALISTIC TENNIS, REAL CONTROL\n\u2022 Swing naturally to hit topspin, slice, flat shots, lobs, volleys and smashes\u2014no shot-selection combos.\n\u2022 Physics-driven ball flight, spin and surface-specific bounces on hard, clay and grass courts.\n\u2022 Responsive contact haptics, real ball-toss serves and adjustable Beginner-to-Simulation assists.\n\nBUILD YOUR TENNIS CAREER\n\u2022 Compete in a 12-event World Tour with seeded draws, rankings and Elo ratings.\n\u2022 Face six AI play styles across 10 difficulty levels.\n\u2022 Play Quick Match, six knockout cups or doubles with an AI partner.\n\nTRAIN, IMPROVE, MASTER\n\u2022 Seven ball-machine drill types, challenges and adaptive coaching.\n\u2022 Swing Lab analyzes racket speed, swing path, impact and spin.\n\u2022 Target practice, survival and serve-speed arcade challenges.\n\u2022 Practice against a mixed reality wall in your room.\n\nYOUR GAME, YOUR WAY\n\u2022 Choose standing or seated play with five movement modes and personalized grip options.\n\u2022 Challenge line calls, enjoy point replays and unlock six rackets by playing.\n\nA complete single-player tennis game for Meta Quest. No internet, account, ads, in-app purchases or subscriptions.", "short_description": "Play realistic VR tennis with physics-driven swings, authentic spin and responsive racket hits. Build your career in an offline World Tour, challenge AI opponents in singles or doubles, and improve with drills and swing analysis. One purchase. No ads or subscriptions."}]}, "developer_name": null, "developer_privacy_po
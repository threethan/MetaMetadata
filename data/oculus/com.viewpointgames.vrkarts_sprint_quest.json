 is a fun and approachable Virtual Reality racing game.\nLet\u2019s race! \n\nFeatures: \nSingle Player racing experience \nChampionship Trophy Mode \nOnline multiplayer mode \nKart customization \nA host of different weapons to slow down your opponents \nSpeed pickups to boost you to the finish line", "short_description": "VR Karts is an adrenaline-fuelled arcade racing game designed for Virtual Reality"}]}, "developer_name": "Viewpoint Games Ltd", "developer_privacy_policy_url": "https://www.viewpointgames.co.uk/privacy", "developer_terms_of_service_url": "https://www.viewpointgames.co.uk/terms", "publisher_name": "Viewpoint Games Ltd", "support_website_url": "https://www.viewpointgames.co.uk/contact", "website_url": "http://www.vrkarts.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33374193898894331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974815_1863273573791742_3631817821442277376_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVXvLO0AMVsQ7kNvwHm5KCj&_nc_oc=AdocA_K66YONAqAt92myTkcpszV5tV5ESR5wm-SEZ4xzIQbAeClC-reiuWpqhSp_XTc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3fDm3VLzHyHDDNjgEV1Y6zV68byKSZA9O7fY0GTihzAg&oe=69F20241"}, "is_concept": false, "is_test": false, "is_trial_offer_valid"
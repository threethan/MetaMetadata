nCTIQ7kNvwGs7bQX&_nc_oc=AdpzBaHV-QVdym00I7Xw3q_NGGBsu6xu_Gqagu534z-jYd7wv3i5i3tLdSJa5A8oA2Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9LLm8pfegK8FcOUetrzR3wn9254GD6PHFEA3niawszg&oe=6A369805"}, "display_name": "Surge", "keywords": ["pvp", "fight", "parkour", "speed", "run"], "long_description": "Chain together movement and attacks to keep your momentum and make it through the level. Over time, unlock new abilities and discover new areas, fight new enemies and conquer bosses.\n\nFeatures:\n\nCampaign\n- Break out of the sci-fi facility you're trapped in, go up floor by floor fighting new enemies along the way. Every 5 levels there's a new big boss for you to defeat. Play alone or with friends.\n\nIn-Game Level Creator\n- Create your own levels and share them with the world, or browse the levels that other players have made! Infinite content!\n\n- Online Multiplayer & Proximity Chat\nPlay with your friends or meet random strangers!\n", "short_description": "Sci-Fi High Intensity Parkour + Combat Game Inspired by games like Karlson. Go solo or play with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
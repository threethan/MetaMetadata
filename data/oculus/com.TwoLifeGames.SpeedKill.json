rwQ7kNvwEecCho&_nc_oc=Adluv-w2hMEBC0tLj3TvMeGbjp52q-W-NGATOPg08LWih9dPVFbb5F5mta_Ef_YWhZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsxZBUdyM9jkrnrtNG8mOM88ZFinvf1r-SgZAtWHgh3VQ&oe=699C377F"}, {"file_name": "3.png", "id": "523147957457281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_523147960790614_5982412188310612492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqC75krhXbgQ7kNvwGES2Wl&_nc_oc=Adk2CAuW4O1HvVhqERwdhG3MSsWTH7GofHnTXrlVwROWZHsQW4Bt7j6VVmKtIjKUJV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu0la0kMN366rI6w6CPxk5sBqo13YyMNjJUGirn6qaoRA&oe=699C493E"}, {"file_name": "4.png", "id": "601775139160878", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393584_601775142494211_1430892947767204581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9PSPnhpEd0Q7kNvwFBwjKs&_nc_oc=Adm_LlORPgbn9dG_YjjB4s2jtaZKPx4AaJTDHGZVRPgt0cLg5uF4AWIIlxW-oXo1wpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftP760_Vc_dYwkl0OWBkt4FR-FCZUbWWfwe5dW63YTEhA&oe=699C5A26"}, {"file_name": "5.png", "id": "646545058036199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393758_646545061369532_8590711515563709722_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjpzovAyFMgQ7kNvwH6gB7J&_nc_oc=AdmrIenjr-ZvnsMe1cHT5R9xDy4XsSBWFhSuDmZIUpCBVcbzydQXjL17BscJQ1cYbCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuPr0E4nrnSCEBCBsG8tP0EtjWt-HTEri0obRd3i_is4A&oe=699C53D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2295513274254444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622172_2295513277587777_8519648171826565208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3fJCGh6jOAQ7kNvwHf4nIg&_nc_oc=Adnm8NXzFFXhhZD76ucuTHTL8QF1k6cqOvJfrbnBwDO-RdwSndMVHLDTz-RYmbUEs_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuiiLJJHecRWcJF6rmN6QqcQyJ_IDXK8rnx2py3jrbrKg&oe=699C5885"}, "display_name": "Surge", "keywords": ["pvp", "fight", "parkour", "speed", "run"], "long_description": "Chain together movement and attacks to keep your momentum and make it through the level. Over time, unlock new abilities and discover new areas, fight new enemies and conquer bosses.\n\nFeatures:\n\nCampaign\n- Break out of the sci-fi facility you're trapped in, go up floor by floor fighting new enemies along the way. Every 5 levels there's a new big boss for you to defeat. Play alone or with friends.\n\nIn-Game Level Creator\n- Create your own levels and share them with the world, or browse the levels that other players have made! Infinite content!\n\n- Online Multiplayer & Proximity Chat\nPlay with your friends or meet random strangers!\n", "short_description": "Sci-Fi High Intensity Parkour + Combat Game Inspired by games like Karlson. Go solo or play with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "25140331098903106"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619014_2640327272977814_17
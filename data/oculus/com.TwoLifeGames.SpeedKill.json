rwQ7kNvwHWq5vE&_nc_oc=AdnjMtq19oud3aPpBWMQVakzhrxPG_YnN6w_e45ppxbhcKPQvi9ubyd8y2E2YrsY4E8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftmdj3Wjovp14RJMssMkpnnUQJkfRxyNxxeBqPK7sV58w&oe=699AE5FF"}, {"file_name": "3.png", "id": "523147957457281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391872_523147960790614_5982412188310612492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqC75krhXbgQ7kNvwFbCu5t&_nc_oc=AdloeC-wv9xpKdDBKC_i3gZG5L4211EfGds65WumGA5l2fLN3hlI4cMZmK9r74_LpEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvVwRXsxPdQ6gIyoIYZyLQ3qKN0AWQ0RIfYCkkkyAEMcw&oe=699AF7BE"}, {"file_name": "4.png", "id": "601775139160878", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393584_601775142494211_1430892947767204581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9PSPnhpEd0Q7kNvwHMPBXn&_nc_oc=AdkeqvvIyuQ-lYRBifPhe_hcOX5FFQKDU6fvbjvfbickXbH8owEIS0T82I07WDx_I98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuMMwhlTpMN3yI4YrK80U1Oxs7YpfRbmxLK5OKItkav7Q&oe=699B08A6"}, {"file_name": "5.png", "id": "646545058036199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393758_646545061369532_8590711515563709722_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjpzovAyFMgQ7kNvwFEHoCU&_nc_oc=AdkBeLMjA0MUaAlQibvzIuFLgBSET1x3tYld2nFbnxmVCsiXuzosohgWp1J_2I-ENtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftuYYCDtZAgC4D4w6oMkkub0jTUqWztEhInh2Sb1xK4Pw&oe=699B0257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2295513274254444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622172_2295513277587777_8519648171826565208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgF-bjWBIboQ7kNvwGLjMbD&_nc_oc=AdnAK4soFBFyxOw29y_Hh3bG56Wgh9uEF5D3FZTjDEHGtyaYRROI2We73PxKb8CHFuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvd6-rJ7qUTmUbweonwG3VdMeO5HCpFrXnhKZfhDciluw&oe=699B0705"}, "display_name": "Surge", "keywords": ["pvp", "fight", "parkour", "speed", "run"], "long_description": "Chain together movement and attacks to keep your momentum and make it through the level. Over time, unlock new abilities and discover new areas, fight new enemies and conquer bosses.\n\nFeatures:\n\nCampaign\n- Break out of the sci-fi facility you're trapped in, go up floor by floor fighting new enemies along the way. Every 5 levels there's a new big boss for you to defeat. Play alone or with friends.\n\nIn-Game Level Creator\n- Create your own levels and share them with the world, or browse the levels that other players have made! Infinite content!\n\n- Online Multiplayer & Proximity Chat\nPlay with your friends or meet random strangers!\n", "short_description": "Sci-Fi High Intensity Parkour + Combat Game Inspired by games like Karlson. Go solo or play with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://desmondlorenzini.github.io/TwoLifeGames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "25140331098903106"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619014_2640327272977814_17
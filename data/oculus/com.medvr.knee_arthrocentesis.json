0XOFwltoe8qs6CBEt8oH4HmALnxxzzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_Ur_lDIl2b-Q5BbqidRjAt0lQ-ucVijEY1QsmzF-OWQ&oe=6A5B6D07"}, {"file_name": "com.medvr.knee_arthrocentesis-20260302-190552.png", "id": "896205093401847", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618284_896205096735180_9156784960023436714_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RE0wZSNP2VEQ7kNvwG-u1H1&_nc_oc=AdpwMMwhkGUIvkqnqbv4y4smYalJ9ttpGTtcJazBDsW8Hvu4-fZJ_yhOxeRfHYP7EkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmFklbEab8IAM2IfupCod-Qhojii8kbT_UO4DYkF-l1A&oe=6A5B7E84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Knee Arthrocentesis", "keywords": ["Medvr", "VR", "Medical", "education"], "long_description": "Knee Arthrocentesis is a hands-on VR simulation designed to train healthcare learners in performing knee joint aspiration safely and effectively. Users are guided through patient assessment, consent, positioning, anatomical landmark identification, sterile preparation, needle insertion, synovial fluid aspiration, and post-procedure management. The realistic clinical setting reinforces proper aseptic technique, procedural accuracy, and patient safety. This immersive experience allows repeated practice without patient risk, helping build confidence and competency in musculoskeletal procedures. Ideal for medical students, nursing learners, and clinical professionals seeking practical, skills-based training in a controlled virtual environment.", "short_description": "Knee Arthrocentesis is an immersive VR training simulation that guides learners through the step-by-step procedure of joint aspiration. Practice patient positioning, landmark identification, aseptic technique, needle insertion, fluid aspiration, and post-procedure care in a realistic, risk-free virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_ter
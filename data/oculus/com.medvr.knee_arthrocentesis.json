4781232_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjX-isKEd6YQ7kNvwE0AC3g&_nc_oc=AdrgHd92diS3wqcTM4QVsGZjI2JCbXt54WIgcfRj2yrZ7sr5_gHjiHGnvwASAkwXrBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm3R5BYW-4vDmKSoKsP8yqQcQjLRRDXlwPYAMi5qRgBQ&oe=6AEB58C7"}, {"file_name": "com.medvr.knee_arthrocentesis-20260302-190552.png", "id": "896205093401847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618284_896205096735180_9156784960023436714_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Cfkq-wca_0Q7kNvwGvuWjg&_nc_oc=Adpg1Zx82MsSzOf7XIh4f7nvJQ_pwxgKdEZ3UT4JbuGH39nlV0Q7tEfwWlFWbKONC7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIrLpDCxecvtaqw42fSNHdL8RLM_GbrB3jCw335VO7IA&oe=6AEB3204"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Knee Arthrocentesis", "keywords": ["Medvr", "VR", "Medical", "education"], "long_description": "Knee Arthrocentesis is a hands-on VR simulation designed to train healthcare learners in performing knee joint aspiration safely and effectively. Users are guided through patient assessment, consent, positioning, anatomical landmark identification, sterile preparation, needle insertion, synovial fluid aspiration, and post-procedure management. The realistic clinical setting reinforces proper aseptic technique, procedural accuracy, and patient safety. This immersive experience allows repeated practice without patient risk, helping build confidence and competency in musculoskeletal procedures. Ideal for medical students, nursing learners, and clinical professionals seeking practical, skills-based training in a controlled virtual environment.", "short_description": "Knee Arthrocentesis is an immersive VR training simulation that guides learners through the step-by-step procedure of joint aspiration. Practice patient positioning, landmark identification, aseptic technique, needle insertion, fluid aspiration, and post-procedure care in a realistic, risk-free virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "34016622361318057"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618069_910219401975382_5644723715821510353_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHvRKE2U6roQ7kNvwHgREZy&_nc_oc=AdqISD3Xyy0tYY2KM4iiHabuQ_6VbNfOuQ8JUmN72R6Syzn3Zp9MUaHdkVvUbuVlzb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6j-_Agl9UgaZlZz9lHGgYiZTThq7_aD6zd6bQpjMkdQ&oe=6AEB3890"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Knee Arthrocentesis", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1777289460, "lastRevision": {"nodes": [{"id": "34016622421318051", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3401662234798
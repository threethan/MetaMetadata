KFornpGdCMjeU8GqlCzGLbvTF6OPhPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbSTMjxwNncoe2dBtWbi_8Hg7lg4d79PO-kq2PNsbw-Q&oe=6A48F807"}, {"file_name": "com.medvr.knee_arthrocentesis-20260302-190552.png", "id": "896205093401847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618284_896205096735180_9156784960023436714_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHiPvr_giXwQ7kNvwHDMJr0&_nc_oc=AdohtkYNZpM9sUiD3jxua7ub7MhH-ScKpTRutYzY4asKy_8OlLw_VUNkoPo6zTcEeXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5lEYbeewXpiXZFjJ3t1EFmMVnhZ6DLzlZmFRAXVreAQ&oe=6A490984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Knee Arthrocentesis", "keywords": ["Medvr", "VR", "Medical", "education"], "long_description": "Knee Arthrocentesis is a hands-on VR simulation designed to train healthcare learners in performing knee joint aspiration safely and effectively. Users are guided through patient assessment, consent, positioning, anatomical landmark identification, sterile preparation, needle insertion, synovial fluid aspiration, and post-procedure management. The realistic clinical setting reinforces proper aseptic technique, procedural accuracy, and patient safety. This immersive experience allows repeated practice without patient risk, helping build confidence and competency in musculoskeletal procedures. Ideal for medical students, nursing learners, and clinical professionals seeking practical, skills-based training in a controlled virtual environment.", "short_description": "Knee Arthrocentesis is an immersive VR training simulation that guides learners through the step-by-step procedure of joint aspiration. Practice patient positioning, landmark identification, aseptic technique, needle insertion, fluid aspiration, and post-procedure care in a realistic, risk-free virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_ter
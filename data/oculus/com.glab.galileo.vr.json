.png", "id": "3941819069445079", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298329_3941819072778412_1936469620409278601_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F1QvNcDnQ4Q7kNvwEeRc6-&_nc_oc=AdotejOPMBLlsGzlZHdl81BTa4lPDv6BfSG2DVkBCBgikSnJ9npRMoYkDcATSHOuCHQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK6F8CHbwe9cJijJsEkyZynmvj7JfmQdfTkEFx2zGZOA&oe=6A8D68DF"}, {"file_name": "Screen4.png", "id": "3916472041823057", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818885_3916472045156390_4412032461613854654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1evE9B9m84YQ7kNvwEdesEm&_nc_oc=AdozzU61iRQ0jhLSKqYB8AyTLbk_qZJSRBH6XO2r-DdyakEIcp6TqruT8ECtepWqa2w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrsXgMdPn_fnZ-TmNHvu_6dxvLfMfMUgoVL6IKMuTsJQ&oe=6A8D8851"}, {"file_name": "Screen5.png", "id": "1482718970221229", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821099_1482718976887895_3035360596069581502_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-cYKHG94D4Q7kNvwFO_ZS7&_nc_oc=Adpz0h8NGt4pAJsdcn52VXJOk3AVXilZZS7VITGVTHG-Hv-ZWqX0X9p8g3SZo6GYAZI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEglwnKI-o7Zh2hRT8EMwNH-6BN0tF3DO_9alYsOeH9g&oe=6A8D98EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Museo Galileo VR Experience", "keywords": ["Galileo", "galileomuseum", "Renaissance"], "long_description": "Discover some of the most fascinating instruments in the Museo Galileo\u2019s collection through virtual reality.\nPlace them in the space around you, view them from every angle, and interact with them to understand\ntheir use, structure, and how they work. An engaging and innovative way to explore the history of\nscience right from your device.\nThis project is co-funded by the TIM Foundation.", "short_description": "Explore three extraordinary scientific instruments from the Museo Galileo in virtual reality and discover how they were\nmade and how they were used."}, {"images": {"nodes": []}, "id": "1039204568434385", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Museo Galileo VR Experience", "keywords": ["galileo", "museo", "museogalileo", "rinascimento", "cannocchiale"], "long_description": "Scopri con la Realt\u00e0 Virtuale alcuni degli strumenti pi\u00f9 affascinanti della collezione del Museo Galileo.\nPosizionali nello spazio intorno a te, osservali da ogni angolazione e interagisci con loro per comprenderne\nl\u2019utilizzo, la struttura e il funzionamento. Un modo coinvolgente e innovativo per esplorare la storia della\nscienza direttamente dal tuo dispositivo.\n\u00c8 un progetto co-finanziato da Fondazione TIM.", "short_description": "Esplora in realt\u00e0 virtuale tre straordinari strumenti scientifici del Museo Galileo e scopri come erano\nfatti e come venivano utilizzati."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.museogalileo.it/it/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Museo Galileo", "support_website_url": null, "website_url": "https://museogalileo.it/it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26316244401388670"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED
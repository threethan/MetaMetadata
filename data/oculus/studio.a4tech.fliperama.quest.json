NaMNFzPZy62SQ-G3vpM-VbxqS1IkO0BddfUAgRAItIDyuTo43h8c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvPz-gq0YiVOc7EijeDo_N_Dc1dkFWgBOTBO9cCYc5hQ&oe=6AC8FAAE"}, {"file_name": "03-room-detail.png", "id": "2558453144631800", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604385997_2558453147965133_2485392018328878897_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjA7Y-2Hhj8Q7kNvwH_gfgF&_nc_oc=AdrvVMCSd8wJxdJrqfQj01U_7rVHchVoQjAh8yl-vctD0DXiGRuKXC7z1aulZsF_wFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO01SHRKPcHldbQfVJLqdgZ_SkcBNgoN6eJjG8kzHQaAg&oe=6AC8F1A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Good Times: Retro Game Emulator", "keywords": [], "long_description": "Step into a cozy room inspired by the 1980s and 1990s, choose your console and play on a CRT TV.\n\n\u2022 Five systems: Super Nintendo, Mega Drive, Master System, NES and Atari 2600.\n\u2022 Import compatible games you are authorized to use or explore the built-in catalog.\n\u2022 Customize cartridge names and covers. Start a game and its cartridge appears in the console.\n\u2022 Keep your collection and progress on the headset, ready to resume later.\n\u2022 Play with Touch controllers or a compatible gamepad; use hand tracking for menus.\n\u2022 Move windows, adjust height, screen and volume, and back up your collection.\n\u2022 English and Portuguese menus.\n\nImported games work offline. Downloads and web searches require internet. Compatibility varies by game and file.\n\nNo commercial ROMs are included. Only import authorized files. Trademarks belong to their respective owners; no affiliation with or endorsement by console manufacturers.", "short_description": "Your retro room in VR. Import compatible games, personalize cartridges and pick up where you left off."}]}, "developer_name": null, "developer_privacy_policy_url": "https://a4tech.ai/a4retro/quest/privacy/", "developer_terms_of_service_url": null, 
6361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75322600_688683155433027_2415699815487021507_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tBnlhjkaZcQ7kNvwHSZ6_q&_nc_oc=AdmtMkaX6_RhUivb62blZCtF_GZwHAVhd4VUPJ4pvDr2ZIv5aN8OghpgtOrI3wtNVVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3TbTwbv8d-8bX7nwVn5YP2S--apAvfpOzm_2kxDaYSw&oe=69BE7FF4"}, "display_name": "Falcon9 Landing Simulator", "keywords": [], "long_description": "This Application does include 2 Scenes of Falcon9 Landing Simulations. These Landings are entirley physics based. The Falcon9's implementations does include Grid-Fins, Gas-Thrusters and a gimbal Engine that are PID regulated.\n\nAdditionally, there is a Playground where you can control a falcon9 rocket with your joysticks. The controls are as following.\n\nRight Trigger - Fire Engines Left Trigger - Deploy Legs\n", "short_description": "Watch a real-scale Falcon9 landing in front of your eyes as if you where there!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yue-beifong.jimdosite.com/privacy-policy-falcon9-sim/", "developer_terms_of_service_url": null, "publisher_name": "Yue Beifong", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491579292614948"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-
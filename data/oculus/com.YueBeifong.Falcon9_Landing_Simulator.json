_565701831200078_9127399130887093173_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BztOi5A6LU0Q7kNvwF0ePD8&_nc_oc=AdqVD4Sgysr-eESa7bj6yd1t5tP79ug4Yy9ByZG6dHikXMmzeTRrruW2YJAhuYYdyZM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CpKi61DjXKoVwjtvDNosxiTAWGTRqyRxY8PykdgC0ow&oe=6A395A00"}, {"file_name": "Screen4.png", "id": "575376590419192", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031425_575376593752525_5634703654092484179_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrWL1M_ZqQEQ7kNvwF4nBHb&_nc_oc=AdouCpTYaF4KZ1TgbylTPKwx0CS0lYz15k4NaPEr5G7uxu0SVcXIBMkU7FEn1YtQD_g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UW514aQlZeTT_B9hczl6vtVIwfL8anGE3p5QkRxrfHg&oe=6A393B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail2.png", "id": "688683148766361", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75322600_688683155433027_2415699815487021507_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaf3N6mVEK4Q7kNvwGORrpc&_nc_oc=AdqBuPX7s0o0GLthXgc3eqD1Fz_vzLgpess8fsW9m76KktGNHecvyNK_gpHIQkNKvyc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mm08Rb-SvB4JnnhnBe-hEV-bK4yrPsyAInfzp-8V9bA&oe=6A3953B4"}, "display_name": "Falcon9 Landing Simulator", "keywords": [], "long_description": "This Application does include 2 Scenes of Falcon9 Landing Simulations. These Landings are entirley physics based. The Falcon9's implementations does include Grid-Fins, Gas-Thrusters and a gimbal Engine that are PID regulated.\n\nAdditionally, there is a Playground where you can control a falcon9 rocket with your joysticks. The controls are as following.\n\nRight Trigger - Fire Engines Left Trigger - Deploy Legs\n", "short_description": "Watch a real-scale Falcon9 landing in front of your eyes as if you where there!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yue-beifong.jimdosite.com/privacy-policy-falcon9-sim/", "developer_terms_of_service_url": n
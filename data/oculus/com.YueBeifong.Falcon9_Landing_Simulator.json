507_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4xLUwxJS9YQ7kNvwHwwPJS&_nc_oc=AdncVlXsb-M9aHrSDLG6BbrUX1BnKvAfhOJVwQMh6lTPs0dWUPdRIq3ZQJkz5lJ_eUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afufe5l_XpOQZFkAM5Bgh04wmOTezqZTwwTBelwSN-QQ7A&oe=69A02D74"}, "display_name": "Falcon9 Landing Simulator", "keywords": [], "long_description": "This Application does include 2 Scenes of Falcon9 Landing Simulations. These Landings are entirley physics based. The Falcon9's implementations does include Grid-Fins, Gas-Thrusters and a gimbal Engine that are PID regulated.\n\nAdditionally, there is a Playground where you can control a falcon9 rocket with your joysticks. The controls are as following.\n\nRight Trigger - Fire Engines Left Trigger - Deploy Legs\n", "short_description": "Watch a real-scale Falcon9 landing in front of your eyes as if you where there!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yue-beifong.jimdosite.com/privacy-policy-falcon9-sim/", "developer_terms_of_service_url": null, "publisher_name": "Yue Beifong", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491579292614948"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43931338_637276011013537_3201525201822052006_n.png?stp=dst-png_s360x360&_nc_cat=10
_565701831200078_9127399130887093173_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZBppm0KMe0Q7kNvwFQG_jL&_nc_oc=AdqjCyu8SzLdnQyoq_sMN19xNOGjKztwCb5NxhP1VRNk2t9XHYU1X15aCP3S2Zzh7nQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YJkV_l_Ps3vWCqkgZjOYvYRaTzEPxNfXdizmU1sMTqg&oe=6A36B700"}, {"file_name": "Screen4.png", "id": "575376590419192", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031425_575376593752525_5634703654092484179_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrWL1M_ZqQEQ7kNvwH6wdyV&_nc_oc=Ado6O1t3Vfl2h8ogXO45saWo5hbTSQSctaIPCloORzSZaUhD4PXyJqxFVQjGy6OdqS8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NTgw_WB2i7ClTAAT1auvzj9vUfYjjX0IKTES94HydJA&oe=6A36986D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail2.png", "id": "688683148766361", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75322600_688683155433027_2415699815487021507_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glPuGr7U618Q7kNvwFjrCe8&_nc_oc=AdqGhx7tgU0JIjiotSN5SC_AUgVRxUDbVtEU0qSS8hp1ebaC5TeiyGP6vM9w6GM5HVg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DBO4QvGpSfkViUx8qEYUNl8TqbyXWhkdaCRzr1T2eYw&oe=6A36B0B4"}, "display_name": "Falcon9 Landing Simulator", "keywords": [], "long_description": "This Application does include 2 Scenes of Falcon9 Landing Simulations. These Landings are entirley physics based. The Falcon9's implementations does include Grid-Fins, Gas-Thrusters and a gimbal Engine that are PID regulated.\n\nAdditionally, there is a Playground where you can control a falcon9 rocket with your joysticks. The controls are as following.\n\nRight Trigger - Fire Engines Left Trigger - Deploy Legs\n", "short_description": "Watch a real-scale Falcon9 landing in front of your eyes as if you where there!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yue-beifong.jimdosite.com/privacy-policy-falcon9-sim/", "developer_terms_of_service_url": n
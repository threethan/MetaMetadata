6lw&oe=6A58F3B6"}, {"file_name": "migrated_image.png", "id": "529502821324293", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031555_528605850876405_541850355349061632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdl7f0pGXaIQ7kNvwElzSc9&_nc_oc=AdqZE1tAZrOMLjYoVFNDuyi9pGiBtlmtgEQWVGEQhLEvsfdDdkMQdyQqt3dY-0qutgM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDusOOSQHjhKlPafStWAtKeezIWOznW8Y3AGva60jaS0A&oe=6A58DFEA"}, {"file_name": "migrated_image.png", "id": "2543879829193150", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974525_1147190902108007_3658820401091313664_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_syBWTBjoV4Q7kNvwFqEpyR&_nc_oc=Adps3RT45qGQ13btd4-9oX9V17UPWIFAPRyWhLJ9Min43BiJGEPI3OVOKcovl2qCCrw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaOSN7-d20bOsuJ0TQJ9Nl_BLZu5HzGeqRLpIMHiGYeg&oe=6A58D92C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1697066014005239", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75443242_1697066020671905_8136264921352309251_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4AGZrY0r-UQ7kNvwGuR7a-&_nc_oc=AdrppzlRXetPa0RtQMIWPbbOsvz93epiOaEqROBPDaL188N-20-g6H2voTIFW0jS5bE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwc6SYbV6TiHs2ANyLpazT23niKKGTSTpvY8TdK07oZA&oe=6A58E608"}, "display_name": "Racket: Nx", "keywords": ["racket", "sports", "arcade", "space", "action"], "long_description": "Racquetball meets Breakout inside a giant pinball machine! \n\nRacket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game features:\n- 2 single player modes - a campaign and an endless runner.\n- Competitive multiplayer supporting cross platform.\n- A sick OST and the option to play your own music in game!\n- Cross Buy with the Rift.\n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\nBut this is no ordinary ball. \nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path. \nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nTargets appear in Waves, and your goal is to destroy them all before your energy runs out. But targets aren't the only thing in the arena. \n\nSo be quick, accurate and smart. Plan your shots well. Learn to control the ball to perfection.", "short_description": "Racquetball meets Breakout inside a giant pinball machine! Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://racketnx-public.s3.us-west-1.amazonaws.com/racket-nx-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9258981627479120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75443238_1248907115824700_8132931946413987600_n.png?stp=dst-png_s360x360&_nc_ca
061632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhX3CSotjEUQ7kNvwH9hJeW&_nc_oc=AdqlW7QGRoNyB6g1JGAf5tmo9lVnTA9AI3vFX8POgjEiAZOHdogBW83N4grxAHBnx3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7vsLAu2D1zwpXo1dK8gVkkkziJK50NKx3IcFGC7vI8A&oe=6ABD11EA"}, {"file_name": "migrated_image.png", "id": "939446689806922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974525_1147190902108007_3658820401091313664_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx9vcok5pWwQ7kNvwFyG0wD&_nc_oc=AdqsET3nlAW1He9QQZltzCz-KQcAwchEo529ONmgC5qT0d4A9JRBJEeqAMcuq9EcuWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgFUxSYxrU5CCTFNp-MO1HBtJgAbWkUOXz2EU8ee8I8A&oe=6ABD0B2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/0pEXF2", "id": "348908762445652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974522_348908765778985_6388749069522567168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRwI4Pt1IM8Q7kNvwF_8mc_&_nc_oc=AdpKMaGMyEzM7fhlJ8uGAxvo1YNWHr_S57ELbev90Fyhe3fH3mBYIr3yMqSW8mA_VNw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9MrZN6GO8Fyeo7mWqUqb84Sd4XVbDeWSLQyPHAjVduw&oe=6ABD1289"}, "display_name": "Racket: Nx", "keywords": ["racket", "sports", "arcade", "space", "action"], "long_description": "Racquetball meets Breakout inside a giant pinball machine! \n\nRacket: Nx is a new kind of game that challenges the limits of what you can do with a racket and ball in VR. \n\nThe game is played inside a giant glass dome, the walls of which light up with targets you must destroy with the ball.\nBut this is no ordinary ball. \nHit it with force and it will slam into the wall, rolling across it and bulldozing everything in its path. \nUse your racket's tractor beam to pull it back, or simply to line up your next shot exactly where you want it. \n\nTargets appear in Waves, and your goal is to destroy them all before your energy runs out. But targets aren't the only thing in the arena. \n\nSo be quick, accurate and smart. Plan your shots well. Learn to control the ball to perfection.", "short_description": "Racquetball meets Breakout inside a giant pinball machine! Racket: Nx is new kind of game that challenges the limits of what you can do with a racket and ball in VR."}]}, "developer_name": "One Hamsa", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://onehamsa.com/", "publisher_name": "One Hamsa", "support_website_url": null, "website_url": "https://racketnx.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ARCADE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1012032726059508"}}]}, "scheduled_offers": {"count": 51, "nodes": [{"status": "PUBLISHED", "id": "2857386104641299"}, {"status": "PUBLISHED", "id": "1221030409572625"}, {"status": "PUBLISHED", "id": "757994643578043"}, {"status": "PUBLISHED", "id": "1615393919349485"}, {"status": "PUBLISHED", "id": "449461158170782"}, {"status": "PUBLISHED", "id": "822538190088413"}, {"status": "PUBLISHED", "id": "524085436638244"}, {"status": "PUBLISHED", "id": "571384771346101"}, {"status": "PENDING", "id": "1303431080534435"}, {"status": "PENDING", "id": "1188865072046499"}, {"status": "PUBLISHED", "id": "625206486350219"}, {"status": "PENDING", "id": "3419524228276934"}, {"status": "PUBLISHED", "id"
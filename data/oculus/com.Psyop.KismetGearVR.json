.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02pjFSDAp3wQ7kNvwEWCM7r&_nc_oc=AdrCocn3fvZUrNLEIGEz6FsWr2GU1jOeaQZJtx-DHKckQQ7R79LW_VL55gZrleSLn1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB06uU-BJSzLt6DA4ygmYs_QV5_Oz4Jcn0B0GAdWARJkA&oe=6A6DD2FB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKZfl2ysGyEQ7kNvwEvcZKd&_nc_oc=AdoYXThbR6sq5v7nQKp_wddIZAK0EEkHIDnD_dris8aW8fSjnrg1L175PyFgDSa76iI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAegpXPot-UnDOZ9JyDSMROF64JLQ1w88JdzKu5A6bHw&oe=6A6DFF3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zzqIqWnX_UQ7kNvwGZN6E4&_nc_oc=Adpt61a9ylpLjmjY4cdoQCfUh5rY01Kc5Mjk3pcjCrcmUzFj-_1CZ1PcNnjOd_LzA5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkMbJSYY1Fv8mhfuFq92OhuI6BbU8dXi_AC7gPVfd8xw&oe=6A6DECD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ticiXerGA6YQ7kNvwFrAlFM&_nc_oc=AdpEb4drXyQ24Fnb85CoaTx_4envdcE8CepMCb6pVfpAl56AdCnqh32RYli6L83ml4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwOiqmdt6HVwl4MgRaR2ssuF1lDgZgoa7Q00wRfj3Rgg&oe=6A6DED8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCeyzzxGEAIQ7kNvwH3M9-e&_nc_oc=AdrJhjO5lkRPrNhnfWWVigZiZER1dF2WNJ8WWx2hD0EE_p6iK2huJUMBPDkBoIX4wMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_
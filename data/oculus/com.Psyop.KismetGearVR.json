.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WSK06Ed_7wQ7kNvwE1H5bf&_nc_oc=AdqiQFKqUHiEZ6gN54q6nl7DG_CwANCMz2InAYqAee3gLnR-jn6aGFowjfuOoxMYXCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afynkdexhld4QRq2vXqZ7xjNNUyK39xq_BW7w3yuHZbvfw&oe=69CA58FB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCKHdMN020AQ7kNvwHfHfow&_nc_oc=Adr1ZKqROFsx5dAM0Tu7dfIjVPFY_-BPs6dYBe_V4Ts-1c2hgXv_bmvnJflwc7t-luo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afydrr5e8lh8GbUsSiW7jOKyPUTL5spPPZ4Z2yy157x2tA&oe=69CA853B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Mt3jXG2JOYQ7kNvwGPaaBG&_nc_oc=Adoc_gxCBXEU9oUwoaRFQmiiBiEW7MjyO8WSvX6sVyxl_CXdmq0HjAY5ycFgs_2bDnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNc4kzt6yxntMnp4TNCk3UbjtlKsnTso7YklzRjqe0JQ&oe=69CA72D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UephQIBNgxgQ7kNvwFs8vUj&_nc_oc=Adplu0ilecFGUyuP-lyQ-R9ceAWGCocHoM10Na-7jHFMeweiKHBOvwI0OBLt2P-tSH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNjenkuLoK2bZq9PDrWfgC3WdZYGVFtiD_D0y8cXvEtA&oe=69CA738C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX4Ng1E4ySQQ7kNvwHbxP70&_nc_oc=AdqRteWpuaFd0zh61jMqgEfVKP5kkN_s7f9DcN6O_MglySinOXH6YQhPYc9Gn1b_ouo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
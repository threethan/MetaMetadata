NEg&oe=6B0DAB4C"}, {"file_name": "migrated_image.png", "id": "272538353741140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oEryNvPi4AQ7kNvwGWJkcG&_nc_oc=AdpZNo8f_GTXtZvISl8z9OWvYC48dMRTpGfFOpcNKSx3iiGmmBzpKTsKaKYleUlEgx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNl6roE5jUgHEqX3hRDxqr62ERSjFzYMCxHRva3wiaxw&oe=6B0DBCFB"}, {"file_name": "migrated_image.png", "id": "205852637349546", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-9QHp3W2kkQ7kNvwFm9tYv&_nc_oc=Ado34Q2pdAyZ2Kd1-xj4ui6JpRYJZkwxF49Szex8pqxrOrZ2Fx2ly4CbGVr35FDuSQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5dotb3YBqki1xet7h5B1UxtfV4acVERm04QEmSTB0tg&oe=6B0DAA96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet Mobile VR", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life i
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJHPS3GtX70Q7kNvwFECd80&_nc_oc=Adpt_tzyLgwourB5RpXSWjkFzTYcB3jBxFkywi_0P0-iU92HGO6UjO3WH53GAGngcHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ATbYyiwTXx3tg4TSLFgIH4CpLwwWWVJ2dnc6E8ZFzDw&oe=69EB86BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipqs4QPZASgQ7kNvwFFsnXr&_nc_oc=Adro-KpFlZfz8r8BE0BQ__cf23GOmbZd2_PrQqefTANI6cCmQWN5N9r4NIQTtbktVsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SHNQc4be9HVkXCUwey77MEcBSAdiIePqyYwdWFy81IQ&oe=69EB7ABB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcKhQ1kX8kIQ7kNvwHj6SPy&_nc_oc=AdrdIXd53WHV5KMe3TtetRane7aXbmA70ueLnCaKhe7c3vIj6z2LZXb5CiExt96aahw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39Bmqy1hGNzw9lsRCNtd_OSF1ue5JHn5IbaZI2ZwGIjw&oe=69EB6856"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB87rtfm3VMQ7kNvwG8jjML&_nc_oc=Adq-ailWzPymCrkM4VuEu2AeSfyTa-SbYe05kzPq0rzlFtcb_j1xm4AbzVvT9BD0wzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07lOf2_fi1BPMz6KrwBwFkPRJOeTQNu_P1oSEwbjlfXg&oe=69EB690C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rixCa2d7BsEQ7kNvwGy6Su5&_nc_oc=AdrGbsLcv5Y31OPwUFKT4_agtcEPkp-qmcAWLyTQ_gUPimbBERdcX05s1t8QIcrd_eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-PSBIS1R68Q7kNvwGEf_Ai&_nc_oc=AdonuxtGFslM17ur212ayOzXPZ2LAu6nnJFoqj2pG1qhAErd01Cv1gA02zcoPlbRmaU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAHBXvHganzdxo2MbtJWALAib0ljxKfmcTGDMEzF_liQ&oe=6AE20F3B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbqjPg4JVn8Q7kNvwGTIwWC&_nc_oc=Adr0NKwrikUjCmtLGJVFnWk4NTE2cp2yDxxgJ4bhWeX30AtYonwKo3fZTP_4XUTAJoA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPodaKYDu6baSU7LMaEBMWLLUkQPm83EiGHQ2qsfo6R6Q&oe=6AE2033B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woYAOqxcF58Q7kNvwHlZn-P&_nc_oc=AdrI2ssF7JtP9mGJQv6f6VwdEbIqJbt0OTx_V1Kw9-4tGdPH_3jEYohaVMK1HcVtHqw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhdXT-m12Mb1sc36On7K2TsXYg9-OiYmYJ2A6qoZqvzg&oe=6AE1F0D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cOqLO66ZhoQ7kNvwFYDYB1&_nc_oc=Adp9Sh0MgNayq9EQ7LFQcz_rV0xQ3SrWkwI1Rm89kFjuBQP77N2EDx83RY3DndZHeJ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7sCqruiXZz43lExG-q90xdgkV0EVb5tXp5EQRBUpgTA&oe=6AE1F18C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOg8RoKb3i8Q7kNvwGxASkG&_nc_oc=Adq-0Azxy-5Fdo-t4OxMWvFzIYFefH6O72MOOkAx85478zJUyt4lqcs2xjxAy8jU6H4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0E8TvbcPKIQ7kNvwEwaAIu&_nc_oc=AdrtmJUAvdJoMPVPb28dfCiH5WVWd1yv1neQH8L9nR6jJKH7FCZymOE82DaRhCk5yO8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt0mOog3GX301LJpRVCZjMjB7eKqaBO2qQlh67oH5xOw&oe=6A9019FB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2SJrKduBtQQ7kNvwH92gfh&_nc_oc=AdrKY5O64D2qdEr0DpkKBIWYI5sj2phCkB1qg1Gykm4GnBNNG8-2NiIyV_ZJ-utbIoQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpZo7ic_pg15BuU2WnaD4Hrf97iVIxr5g8YGGrzvLDVw&oe=6A900DFB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LAuzsIssgoQ7kNvwFJmwNM&_nc_oc=Adq9ui6o9IqksX8HF4RtBcbXTS3s2hlcjCsJIhMd8mYs-zziPdz8Zs-Y5TaSt599btM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6w8MlSvKbe8VInpo3cjPWH12GpWl2UtR8djgm6Tu_3g&oe=6A9033D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHQoBihaPr8Q7kNvwFjW_5U&_nc_oc=AdqUmYaDOFVOU9_i669SW163la2wv3M7ct6ny3cJEA_1TnrPXii57cCVYT5HX60HRkc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6YkAdVwZon_d-YpaiGZ4eo7fPCuNm7mT805mufUhjRw&oe=6A90348C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwViZ9AA6ZsQ7kNvwHL3DFo&_nc_oc=Adop5HoWpgJksZ30TLreYfpbJsxFfDaBA2Cos6P0nCpLPTc5l5WZwdocyo6JFq6hwlg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_
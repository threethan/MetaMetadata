content-lhr11-1.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0E8TvbcPKIQ7kNvwEL_-KH&_nc_oc=Adp3ZSC1LGCVtEIb2vzBobe3IqkMnPWQSn7JFdSgNCZPnDMxFa7gBP43xhs0UleCW8c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExseJE2G39QiHmJBr7S6nI8vG-DBXWgZRAfoFnsap34g&oe=6A8EC87B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2SJrKduBtQQ7kNvwGwEln4&_nc_oc=AdqftO5JE2t661fSNrJa44MJnyR9dCRD4MHqggrbPiZgLpPtoOWcrrZmdqqHFTTQOh4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVaFl14ZcUlerklyo9rWf37Udm9HIZB-ZgJEdLJQnlCg&oe=6A8EF4BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LAuzsIssgoQ7kNvwEmf-y5&_nc_oc=AdoZcLe7nof8CgrIw58qdGraNZd6O24BFbLqNMcX1DIGn4kAXceikvHD2VXnRP1MwHQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8PQrk2p4ukV9nWH9yXWGqsHzI4fkBJVQ-u4pwTvSCnQ&oe=6A8EE256"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHQoBihaPr8Q7kNvwFmRpfR&_nc_oc=Adqjku2S8PP40TWkn-PfkuKt2MW4vSL4mgjLNAslUBjJX3BND4NDrr1MDv5Sl_eKen4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrOrARSaARPdwEgPu6ZRI8CTU8D3LqHOSg7ZBHD4dJdw&oe=6A8EE30C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwViZ9AA6ZsQ7kNvwGibRMf&_nc_oc=Adq1s_MVCKNwHbiUClfY0UEJOwxLo_TJEUmmO08NM-Ay7HnnfwAv0ot3MI5ix3wKWKI&_nc_zt=3&_nc_ht=scontent-lhr11-
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4rElXpC35MQ7kNvwExxac9&_nc_oc=AdoQxPgWpJAU-9fG6_LbcdSOz6n7Q6HaJJFNtaElx8qUJlVhJo3oa1cGvUnzQaT2FYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTNyAOVOv0PUK40uosk1raupzcJeGBi2-iZzzjzjnHdw&oe=6AC119BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evhp5YMG1h0Q7kNvwGSRqm4&_nc_oc=Adqa7Uh8oHNZAAZNednenO13qLYDnYr9MpLTX2vb-ia_hO5H3piYxPmgQtzC5ZWMIog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH3MCNAMovJ5EntG8cJKDpmisFgpjUeROxsgBosRBbTw&oe=6AC10DBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnzyLUEM6-0Q7kNvwEyKnNR&_nc_oc=Adr1G046_vwkYev6Sf5FrnJCoMIvHFAN1p06fsVMklZIH1u9sFKuRcPeq5OBiVx9oFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5iwgUKSd4zz_ItEOT9cAelQgKaHZMkEOVm9fHln6ROw&oe=6AC13396"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdYSFQfKwdQQ7kNvwGB_C8p&_nc_oc=Ado2T1Hn_Xj2Qg3Ga1D-q_cah3wJ0NmvFzTwQnm96qRhA0Wd9ElMrhzW-Tg97bITCL4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHmp3U-h4PxQ632Hk93YWx0jujcInGbL1pxZEvg0yiNw&oe=6AC1344C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3lNysIJBGcQ7kNvwG3nwbx&_nc_oc=Adp1sXKyEG3NRHIqrYYzXE2bRyPY9csLcILVMPkw0zVHblTzFjuBSTG2LYlN_tVRsBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
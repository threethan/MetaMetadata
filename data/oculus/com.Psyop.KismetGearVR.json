.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VitiZ88jjrcQ7kNvwGOXio7&_nc_oc=AdrLaMkzEJ-fOgaaMVBf2B9Es3AKdoHIQ5OnOHNBYZZJ3DFmHWUsCk_06a9Cp5vXRNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0-VJAImOtHLRWlt8-laotk7mpzXohvDpaiVpktNotlQ&oe=6ABBD3BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21cWEaUj8GwQ7kNvwFbfJYI&_nc_oc=Adr8absS8vd4UxnlsqCFfYUbXrou3k_YPaVBrehZefnPETnN6LV-4fygLzASPTSWp_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPSHg4R0CApgm719vF9MZ-K-sSl7mzOmTje4RxpJ52Cg&oe=6ABBC7BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnkXLNNRbH4Q7kNvwGgKmNn&_nc_oc=AdpM0bEGmSCP2HOkvBT_Vw3IT_uhTUbE86RAGGUOwXJQ2zne4PHL8Z2ejMUYEymGy6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYLVc5HFHfi5qurv9wLtdnp6Nqkfk3tOnPCcRGqsYrtw&oe=6ABBB556"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dcuzhjg5OwwQ7kNvwFXvpiK&_nc_oc=AdrS40laE7balo57Nh7OlCczIS7H_uJMAOAwyVp5wd1CZMuwb1f5RuZpBfm9VI0fd_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPS0D5kD28jJR6_RB_fcekYF1gzVJF5TQtH9O9RCUs3w&oe=6ABBB60C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5F9vQAzTAoQ7kNvwHY8CQj&_nc_oc=AdpE2UkC7-plm5hwrolK_mVFi8zNl06K3Q0RWBoRWdZJ7wHkVTbQ9dfdBmMMIrDfsvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
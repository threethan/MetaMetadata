.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0TuuJM0Sg8Q7kNvwGjugz_&_nc_oc=AdrjOpvyUfqvAvu8AgI-gu3rl1PfpzKyCYAanbC7_ZzqueTTXGNPIRc9x6_Hy-ULu2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06hV82vfONxU8DdTjoBex1hMUDx0SHc2riQf-Nl4WpOg&oe=69D4E4FB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiHDjW5GjQ0Q7kNvwFQ3UnR&_nc_oc=AdooBsgLrN3z-osvbnv19paLUEcJ7gXFJeC70aY9DbIebUJkH4KeZc7HRBTrvOCNe0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2quO2hnqs04EGipqsXS_iWAtPVZm4T2nLI_GFuXP-p-w&oe=69D5113B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8uWY7MBCKwQ7kNvwEwFO9w&_nc_oc=AdqKvOAn80JxclawGgxh7-yGaIX-jBw4PZZbCgqCq6oyEw2SImBoburD9BCA7K_u_dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kP9sTs0Gh53Jzfg5S0xnqRLDHDta10ta5nqbCwpqgeQ&oe=69D4FED6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9agumXscmecQ7kNvwFNdWH-&_nc_oc=Adpan9TFNe9t1_wn4OzRxubfk8Y5Rw5YB-zuXaU5wd9ugcXK7Z97qkAPMMQIvrNwA5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qdidLABwWDjRP1_Teg8_ulHU-kmMdJvj8CazrlJW6-A&oe=69D4FF8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xFeiUpV5_4Q7kNvwEkuThB&_nc_oc=AdoGvoqQXkwaIPrEHyFGV0xQKSIO54WN0rGdJWe2czMcBtMA1VaP2Hd_j0s5wfTb5CY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
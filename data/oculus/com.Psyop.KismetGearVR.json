.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeAYo5J1FCsQ7kNvwGPebKj&_nc_oc=AdrN1R9AN4YNaRjtvKkeuFnQb_el9OnIaPAMLJCf2a-5G7JXOoSlA09XO3y48WKZuuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClZ9noBJ_7Yp6qIpaidC-y9ZMo1cnOAW5NexJprhTHMA&oe=6A622DBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXd1mF1k_zMQ7kNvwFe52Ap&_nc_oc=AdomshtI3Xc-9HSjqd3uZracCYrRusoiN2BqCqThOEGK1_9T7LukUY5AhHmjGQqy1G8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClAV2aTKLkPkLNpsZ2r1u-b3q6XGUAozMBe4Vgk8C__w&oe=6A6221BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHlQUlI73QQQ7kNvwH9oNgj&_nc_oc=AdrBObzj8N9jpsBWoh2qc2RH4FMNFAeCSRyr6UiKtMPt62Wlhm3fRCA0GxYrapfx5f8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3ryNPUrbpZO_z2X5pTKmiy1eIk5SAHXH3ltxUmqCr2A&oe=6A620F56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF8PADhWR4oQ7kNvwHlg1Ve&_nc_oc=AdrMCP3sS9RTbH7hSxb8f_fSvwOPDhtMkNi6nkfhpBrMjYMNI6L8ZV7GyHgMnalIQjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPq9iHO2rhp63MotRzTQ7n10D4AqoiMocytI3CtSVH7Q&oe=6A62100C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73MBP_CrY1AQ7kNvwFb2EzW&_nc_oc=AdqjRJS4BANhE57xLklczqBUoXMFou-lTlbT0il0wvP6eWdHieeybJXY7DPr3NrMNTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBIE2WJkeYgQ7kNvwHAlbwf&_nc_oc=AdpgLzcmezpFrfTcYMid1UYghC8wtBC1RcS1ejzcGW_FcccuNsM36Iww3WqZFybVAzM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02AzXG_pf9JwI25Ts4cH7S6jL7rjG-p8rzZOWjKZYYjA&oe=69E640BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3sWE4FgWAEQ7kNvwH6HgrY&_nc_oc=AdpDLn27Ou_FOrzax5xkdMUJGimls_yI3nfjQhalOcBSP02jpA8eF4UBvdFh-9QZPsc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dEDKl8D94-DfFNg0iyd6QcsSfcv0uywynA5MR9jivwg&oe=69E634BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmYMsL5BstgQ7kNvwFOn6Ba&_nc_oc=Adq7KilS3n9QVH8VqtD493-j2TsjXGnnhDyiqovYw0hB99Dx5DmWQamYh1WM34qyE4g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uiVGYrr0RU2-O3eaUHvvdo56CR27j4cYozWMibD9kjQ&oe=69E62256"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pt1OM2bJoFkQ7kNvwFS4kkg&_nc_oc=AdroGENQ2OpeJb7laeZueKxd1WJr1r1u2fAoZe-MD0PQNiepal9TW9mGvAKNYQJx2cY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01qUgr1G_0bdEiHVsYDLhi_cA9l8zN8SSeOY6jbSezRA&oe=69E6230C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=707nGGNJalUQ7kNvwEyU7Wd&_nc_oc=Adp9JuYAzuoMDUK-GRzsW3PJRHD8PDnxGmfswQWhGsynC5cNzbcZKMajstsrk3h_YyU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_
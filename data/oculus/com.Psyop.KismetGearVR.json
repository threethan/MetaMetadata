.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7kxkNFN1gcQ7kNvwHgAzLH&_nc_oc=AdohRz_JKLL1fk64wQnD60qi4UeH2ld4j2u8_8tq4GSgCVPUsRCkRS4M3OeUXbGTfI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6amfz0_l9nsS6GajoxergJdfwgn8vuNQb2XALz5csZQ&oe=6A7075FB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFb23foVKiIQ7kNvwGBDyt5&_nc_oc=Adr7jWKqSQS012_GFOmEX2G9YF4PO125sIFunZU6unQrPQIzfUZ72G8hc1ObFZtnd_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaSTtec4ow88guwIrFkLd6HNOtqbiYT3pbmR9uKZFh0g&oe=6A70A23B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zzqIqWnX_UQ7kNvwE3oyfJ&_nc_oc=AdpxETBGhOdHlb8KBgx0K_0r7Jq_Ro7uLEI_qRNY2c0XqSFniA5cbs3HNWoe4uDSB-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnAskqWeInDo2t2kwDOmA8aF13wEmsFF_hxvoqJP0Mwg&oe=6A708FD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyrVULGeU30Q7kNvwG7-_n0&_nc_oc=Adoi4oNscXNndyBhxYCtHbgFdqw1fPkkE52VXxGqUqudhnXSkkkcBOJ6GvX7J3dwkqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVmwMGgit6j_cwF96iAdTzQ5Cso2MnoPczM30lQBlRiA&oe=6A70908C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCeyzzxGEAIQ7kNvwH6-OTw&_nc_oc=Adqm2lTFdgGPnaKpamTF6jWNcTvmgCBHmsZmJZZtpT-i110ywyb_EbH1rfK8IHdsfk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0kL4ff_zMYQ7kNvwGc27iq&_nc_oc=Ado-mdiO7nkAkv2lWK_3VBOo3ySk0PqERg-USa6Jumtr6i4fID8zAay7Bg0wYv7npwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM1vpy-T0idAsmaI3pABhpFlampAtCk7vz-7uKf3EpmA&oe=6A6A16BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR-zfhu2pQkQ7kNvwHqI8hp&_nc_oc=Adq-RLZzhjXQ5hZkBdmFXX_DdodZnKRovFMUj6q5F4RJnpFZzWF-gj_FIulyZVQPmhE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnmcNq-ckecRUcWbJ9mzO-ZSa21VT5-K_nWqMOfvb1mg&oe=6A6A0ABB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6r1T0rlYu5IQ7kNvwEoQVcF&_nc_oc=AdqPfTepxKlFDQn0S1ID2wnqOK_6lbmTCAq4wZFBM2g8PrI5kDkoJDkyy1CfQTBtI4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQZjCUMSdQ9aJhjxcCutCP648-n9LEbJqjr5J4FG2HcA&oe=6A69F856"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACQXLW2auqUQ7kNvwGOBGxB&_nc_oc=AdpV1liUy61Xy1ZMCJC8Q1LvEX88eVnu9KU3TSdYJH1CaDv7tYgKJvCzxHUhFHYJ_0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQndcpkyxtBmeS3yS0Fa-GylR3W_tbxg2d0qUa_xUivA&oe=6A69F90C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX9XgIiVOlsQ7kNvwHDMTJ3&_nc_oc=Adq9bEFKaULby7UT5WvaAULQro53EAYVa7K27-s5ndhG9x5lG_X46BCVwCdhV2Zhm1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
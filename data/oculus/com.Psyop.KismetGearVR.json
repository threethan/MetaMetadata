.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02pjFSDAp3wQ7kNvwH7-qpp&_nc_oc=AdqZX4lXuX-l42vvM13jSrGtV_N5in3nn1gLPIA0l9XqSHw-bJbC9Gxj7nQvEEu97H0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF3UliMhVvFUrF2BCChq2DoWEQkR0XTK2xFhJOFb726Q&oe=6A6B683B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKZfl2ysGyEQ7kNvwEa5EOQ&_nc_oc=AdonGjuMz0d9k-PVS_mVJafF7Wrci1-u7WJKYSoLugapE8AxG4uxUeJg5_0qZQamr1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBLax6vvMn4QpiShQ-Y9WpRPF0R2qVetnH3rzMMBWtTA&oe=6A6B5C3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6r1T0rlYu5IQ7kNvwEj2fPZ&_nc_oc=Adrb7qmIc6w2P5kgdDn_VG3ecNJvVk41FOdYSXMPzAKFLKescTChQEOqwjtm35PT6_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApgM4z8yYz2EE_KugBthmA523EsTGBXsVpQdPvM8t7pg&oe=6A6B49D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ticiXerGA6YQ7kNvwGLMZcx&_nc_oc=AdqwamweImaGD1zLFRo3nv_7psCt2rEWsf4Djb-xpEwq5GpCLfmh8ynwtIbNe5FIfBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYRBNcAw88zr2qX6Vx_V43AwBYQbKKwSNj3QL2g2y7NQ&oe=6A6B4A8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX9XgIiVOlsQ7kNvwE1-pXf&_nc_oc=AdoL2DF9gPmtJ1819Ad1HRv7bED0TeR6kva0QV8SkdbqtylCIZpKt1nxC5Jn307uP7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
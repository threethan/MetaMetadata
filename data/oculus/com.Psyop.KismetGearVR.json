.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex79B76L654Q7kNvwEvqLCy&_nc_oc=AdrW5_ovbHNybSvMuI1TK39X23PHXM4NGY5bt-E_mJAt-EbveXiLzdsKFU56bU-hR8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMrUF1pGPHab7Ot-o3JQBidKCcb0icoznWb372qLC28g&oe=6AF4843B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDyackcTk1IQ7kNvwEoZH6D&_nc_oc=AdpC_vIT_iuWUsiLp0Y4D9fZlp2TOCWXscfNxdsJXmTDKxhNGOJEdR6URNZmWpi1OEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgL3lXdUAFmbo6VTyN6RotGIP8k8EYfX_6PnjlPTv5hQ&oe=6AF4783B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OvtAQm9hlgQ7kNvwFo_abe&_nc_oc=AdqR7bJeNdu2fcQK6T9csj66HGIJas-UOiWFNjWfAYRkBd1iRPTLJonmfyz32-dVToc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNAjjS_SRIWNpZAo_qcAbaI0tam-5ShS3a5WVV0M0Oaw&oe=6AF49E16"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCQoXqoDmh4Q7kNvwEC4y8L&_nc_oc=Adq69HcbN_CaO7KL15bhkD0bH37uG6-GmLgBuouK9Z4TBY69Dl7zhnCHsmGbYk1rfVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU6f2EdaueaPuHk-3NOsQ53XNIolCA6-dU_ITpv0TKsA&oe=6AF49ECC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukM4hJm4ynIQ7kNvwEN29GN&_nc_oc=Adol-JYP59tcPZ1xg1VPxFUXGWYEtjhHLwkpPi9iLmTqEcdlLiYWbfHZmRZTEPqhdl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
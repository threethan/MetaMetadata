.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOsLadubn2oQ7kNvwF07juU&_nc_oc=Adq1h0m0G2MpYEBjeJpDH6DPhk8wuIKydQLjst-qUfU71B_VUGolsnti_KV0n7DaTkw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr1aKqco8yUJSzG-2ICOUM48Vdqc4DHwCuC2bvqzjaIg&oe=69CE4D7B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MUXX6Hm4ioQ7kNvwE-1GzQ&_nc_oc=AdqAT7tKlNEW4LPpnZcgBlfPglZFRa4PUKwBZaE107c8f8yTaKxKqDL6JP1ohZwG4xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVFcTydgI6di4zcYn-8QbdTt62rYKLMlSM90Cms_bsQw&oe=69CE79BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWgW7MFcYEgQ7kNvwEAxzZj&_nc_oc=AdrLdVDxx0J6eo9bFb4CVKe-8h1E1BloFbiQEl2NZGKL3qN6iXkjU_uV4RkSYknLnJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzY0uM-wbjI6WTlbdxK3I32Y4XOZ_Sgd0JBiNJ8jCyYQ&oe=69CE6756"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wWN8BG8weAQ7kNvwGxldqF&_nc_oc=AdqpiMcHR93o1k9LvT0GDXDFg2f_qvgW4J9bAsq9Ft2TwtQakHDwP6gmQAWnIk66pt8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmaqGo0k2AF-QXHcRu3ve-P_a2Ias4bcuLIJVjQ2mJqQ&oe=69CE680C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbbVdkQ9XicQ7kNvwH669oO&_nc_oc=Adq77eW0rzqRAELrjFX3KmsOtMXfBrWk_61FL_YhpcuFRCkwMc6XvROL-xI3XrefYRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
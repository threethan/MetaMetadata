.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewhmf_r6dD4Q7kNvwE0QJL6&_nc_oc=Adr3weH3z8AbbJlBrJ5zBwcvpzMphhS5r9wF8pPgDv0Uu4kTf9tzUQW9FH7AWoj3OhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6xOuIr4KkZhoyf_6m_8T3NSgL2rreLv4cyb2bij5IlA&oe=6A4FB8BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcLc1MQpAY4Q7kNvwFmu-Z9&_nc_oc=AdqcPGHyqiWc122XRri5m2Hvvl_vMdiaCRcuyz0s-_PQZ9J0MsJ7G357wMl2hyzcJW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcfI2MWC8EAy7hkcxEVXXvATWcKAjjB_SVFo-VNZ321A&oe=6A4FACBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGHmL4jvJXUQ7kNvwHj6Xs1&_nc_oc=AdqtnMCfqCZkwUwd480RkM8ZSuEx4FYym-UoZAu2dEw87Q-LEZWf21NpTEBPYbShxSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNg_WzF3WnAmHjpPqhPORNAnX1S5MLHhErxyhXJLnjfg&oe=6A4F9A56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrHVfjHQIkQQ7kNvwEAiTQB&_nc_oc=AdqMMc0QowzK6Q8WhhdNNTbuAUSbcMhWnu4oV_cJ1WpRteCIkgAnIyCV4R8_AWQQwrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpHFcyzR2EN6QE95pWOSkOWFCBCCUNZeS6taki5qbduQ&oe=6A4F9B0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byq-ETdbjzMQ7kNvwFpCRUh&_nc_oc=Adp8yD6Vc_5TlpGArxkrlcZ94RZIoRDG5vGUpMc-tmI6s1X7oAz5etas9vvBDeM5Ygw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
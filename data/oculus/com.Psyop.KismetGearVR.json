content-lhr11-1.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeyCyA14rTsQ7kNvwFeQYOh&_nc_oc=AdpwVuzPPyOLHvAKRhzC1UREBrEoIIRNeXmDrmO4kFOtJNQB1B4O011VQIGyZ0Y5VhM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd4HmcOCja5YCurbI3GV_oxGFIejdi3WTxPWcRkmOwfw&oe=6A858DFB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbR70sA3JQkQ7kNvwEabgKS&_nc_oc=AdoNuvn9kw2DoW3A_S0Enp3NQOZP6i130zsfasIzVDeSNc1-nu0A9outk_jSfg3xVGY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSxgL5NhPkr99At3GdtMdrPbRGsko1UGnBRYOnw22tBA&oe=6A8581FB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyKMHAQENuwQ7kNvwFUtCid&_nc_oc=AdqxtnB5S3XjnAB8nL2FCd3tGdl09tKyhpGQujU3WzVxeUxNww-yssqOqnZRVKgWNeY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgylrCxaMY9IT2kNv_ooPdZP5oWGk2186sIR4r0_4YoQ&oe=6A85A7D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoseE1tk4DsQ7kNvwFTTH1i&_nc_oc=AdoBORfYl-Qtr98KhrZcz3XKP8MhUyvm1sofVHH8_YuLrJJ_UPdzgmoZmp-VSX6-rvs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoxmnn4BCHNh5KGhMRqSMltRBTgZeRN3j18L1ZOA3eEA&oe=6A85A88C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5sGQjS4avsQ7kNvwHwBITh&_nc_oc=AdpffIIYVpfv5ZArPwId-Pewh5BBWGGmGc1q4GA6JK9bqz9ES0zZ0LlaLRmyNNXDezI&_nc_zt=3&_nc_ht=scontent-lhr11-
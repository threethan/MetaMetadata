.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81KQQ3Zx0GsQ7kNvwEOs8Af&_nc_oc=AdqUkCiUAUMVosv9l0T9NUklHwiSCEKhKVXE5OYRXVTOvuh_V5_I3OKzmOmFuXjQy3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHFq2lh71x6NowzpzbICdlQJSdOxpCIrvPcA5tVXpucg&oe=6AB3EABB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqs7pOlPwhUQ7kNvwG9c7-t&_nc_oc=AdqRsFnLeMfBtsWh79LPV9pfZkuZ702gieER_EASm4xF4V9yME1QkOsa8x4mrjpHuSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGBqYBH5jX96H2dz7377OEOlHvjOkmiS_8ql1ZWBl9yw&oe=6AB3DEBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOisvsYvi_4Q7kNvwEBoQ71&_nc_oc=AdpIQEIcnFkCsRKj-_z5h0QS08ADzPLVIJwIlQWT8sF1Oao0ngXKgShvlZyV1tXk8ko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdxfsBSpylyK25XAnmjDFUzdn-s3vLJfw324bMjTvuIw&oe=6AB3CC56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCeyV51bgS4Q7kNvwE0FKvK&_nc_oc=AdpRCq3QteVkE__p7xY1ghvN12UNUaeTK3LgGVVtkR4qy7dojV7mUVQmZ8xuUhHE6cI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXhiqG4SzRdCMgdA0RX1r63ATj0cwkOPJjo-yZv_05kQ&oe=6AB3CD0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvGAkjRkN9UQ7kNvwHpIL-i&_nc_oc=AdoToKWqsv1MjC6cYCBrLTKyJTl7ka4uwzSdepAwWmmPJ4GQXogfHalVg8Ekll5ZtE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
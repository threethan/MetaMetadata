.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auKAwK0c6gsQ7kNvwEvVzL6&_nc_oc=AdrsX-RITnGCHnde1y5ZOscVbtj55I4lcCUBSf2uJvogtbqodxmVpdZSHn_y5qTtS70&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lJFhS7R5HTv9Gj9_zXMZ__GoCF6NLUlyG6iHHArTadA&oe=6A32B7BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhAHBqg4thQQ7kNvwGsk3hf&_nc_oc=AdpxQn6_-tcRExR1ubZN0P7PHJK_WK0W2KMqSc0u62pMYKsAVUtSqAz75frozDJGzkc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n_DECvZ-tFU6HAU_Is9i08Y42EnGb035RDKjTVMxgwA&oe=6A32ABBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTAhoCi-WVQQ7kNvwFsI2Tk&_nc_oc=AdqlSsUx7XLAaWIaVkEH4v4f-tfo2pgz5Oy9AEG_wgvmX_4ht1TnuaV9KFN9-v0GxhQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S2q3B6EpTrUjjtWXNknlJ_RcoG1BbuHasH6Kv6tokCg&oe=6A329956"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlRj9BgIcSMQ7kNvwEXVkiR&_nc_oc=AdonxV5H-46tpkYTmlaW2MmyH0eDOIU4Hp0OSlK2FnvH7Qev60-Tx1MK5rvup9xupPs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XnsZl7QyCnNxVgqfcA7D7bpQpkNVkij090LFmrna6IQ&oe=6A329A0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kp1hh44ZcHUQ7kNvwEZpXaD&_nc_oc=AdoQtti7XT5P6JZelz2aehD3e9vFQ4v4Ou1Fx4Jmzh-YdStau5wEINesgs6E9BnG1qA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_
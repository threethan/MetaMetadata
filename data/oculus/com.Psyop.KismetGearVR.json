.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIMQ9B26KLAQ7kNvwFt8_5z&_nc_oc=Adq_lp-j4p3jd1qzBpfp5GEdRWynVE6g8Mf6HkeCF8YkxypOUyq1BkcAe7345tCr26Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUDk5kpdP938WU9oVz_MTTjrfzLPkOCiaquq-e0sfohg&oe=6AE9F83B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcdciSucpoUQ7kNvwHpL5D7&_nc_oc=AdoW4L3qpsyAnG0fWECt70zUlOHygySVDhkcvaIobyalFrBPbrHo0oawIqlwxnj-Fdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrDlDPEaC9Az1cEhY1M-6WWzewRpcBjeKS-ZxDdiIOTw&oe=6AE9EC3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hStpE2weP9AQ7kNvwH5rUaz&_nc_oc=AdrJ8B5PI4N87ZAXFrLdhfXllsY95DGfxpq_5T4qPPFiFMY4XOhPnWiRQticZ3_PNnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDiMY280RFiOLM60V1wXG0bwK_sOL6ZZDxR3VWasJl4g&oe=6AEA1216"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgTudoZBxtQQ7kNvwHg_GYp&_nc_oc=Ado0soUxUfqVoAABXvSf-SS-cb0RtJD_AQrcPDG6j5K5jpCDccyZjfvZidb_Eqx5GS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgs36GEoTZ4M2VWdaY1ObXEU5_ZlQM0XLaB5WCvvcnCA&oe=6AEA12CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwLm9ZnQ8bUQ7kNvwFVA4k4&_nc_oc=AdokQgF8IBwLgH9BIXHrtNyl0a_9IxUeoy6SMzxtr2kTuvbxU4FZQu0TI60gD6IdI68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
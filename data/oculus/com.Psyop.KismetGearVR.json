.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI4cvYkUfO8Q7kNvwGWRFdf&_nc_oc=Adr3IbCDfFPpH-KjnVI0TVGEC3XcazAIhdQq07gdhrA7C8i7C3xf1YzQav-k6qilFCI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUadyuT68GzeEg2GXYLhj4jDjorKpeDqzz_YnDIj6KJQ&oe=69C26FFB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ9R40Sv5N4Q7kNvwG_epAk&_nc_oc=Adrr6vUrm2oteowy_OvLi1Sz7h66MBg-3hVewEnr9hyNjyAKd7_BeTB0YmAEPFAY36U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1drS-5mM_6C2mh11PROop6AQuXHm_hH6IZMuspRhR7A&oe=69C29C3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l37Gp5PcavwQ7kNvwEYt-eN&_nc_oc=AdoYQy7ELVNRylnYzjeAJmnsjhbgF9qcRhGWIrTqZ8PYrdgZQpTvTgvAxJ_QUa4t9Jc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBl1RWiFyTwJE93gkhuWdACYdpt_zKstfVpAXckl2KrA&oe=69C289D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVsdXmbiLFMQ7kNvwEiHBp8&_nc_oc=Ado5Bwr5UvI-80BfU_jN6ZY3fVVHkzUFAuvRQpowNEp8N1ZPWNWRAgun74axBXQkOss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnDNK1hm4oNMUmSE9TCacgNj9q_zKqSheMJtHyA7jQ8g&oe=69C28A8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTWdOR0026EQ7kNvwGTJXcf&_nc_oc=AdqBhIpjwTZpwtyG8TkFCMHmukmQMTqseFYNUv3HOlwHV6xOPFrhKfPvyItS5JaeG0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_
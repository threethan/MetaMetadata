.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A02hoTCxdAsQ7kNvwEDR7ab&_nc_oc=AdrNmHaJaVNZXEwARz-D9kQai8u6kkS01jO7ZLY77a3ijkxlkVMTHJx3Y3yUAmpSX8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UmIcHDuPgY8B6ZNXNyX6pQqTg-f5ektEO0cSE7rPV7A&oe=6A31663B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhAHBqg4thQQ7kNvwH39zkJ&_nc_oc=AdouvsnLIj0r4-i2hhgqokB5kGDXOMMsCO6-Ws3lPZwDu30GXU1nCRzt0zeYskYp_w8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bIDMb3eZOqCPjGrOGkN30LcEAa6xhRf_P75MUxhhlpQ&oe=6A315A3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMG-hVqPvj4Q7kNvwGCb8Rk&_nc_oc=Adqv8Ut6sxECi1FHYtjV9eINPf7o3i4k7JPcB82AutJYhVcvIhv3t81cZ65DmPRQJsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CMOyZKjSVFGIMb-yo-ubwczmcbpSdKUOFxbju3m-6KA&oe=6A3147D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlRj9BgIcSMQ7kNvwHA4Fog&_nc_oc=AdqC-eqKVV2qqzzVCALi_O68eZfnUPdoi0mhZtjTvqWt2QRecghSVMkLw75haiMSZe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f7RbrUHPEnv0FLSAtkVA3unAXxR5e1Dt667DKJPVUuQ&oe=6A31488C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_RxSSg3VJgQ7kNvwENpEUB&_nc_oc=AdoHGc67zX97D6LVjOaRqjfJb-HC-PVNnX9hERDybhwDs5wBz6nfrqF0_1gVC_QHy7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewhmf_r6dD4Q7kNvwFFYMq9&_nc_oc=Adr-26LDKc44qnUE39fWKdIKOmoOKDQpNdOE0bgqt5bszt3CRj3cUgbhnX6a_82Xuf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYgbT0LUx21HP3QmXkfkkf9RiXLYm564kQTB6f75wifw&oe=6A525BBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcLc1MQpAY4Q7kNvwGj9usI&_nc_oc=Adrgu_GKCKZSaCROWxV9gRTC0laPPhPhUCvEWlJUv18DVs1hyqvOf6_Ay06-sYjl0GY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKKBTRa2iMvJDtuHmtm-A4o2M8ZpktELqHAqClSUtung&oe=6A524FBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt5jnwtALXwQ7kNvwGm0O92&_nc_oc=AdoHEOatk_JeHsC0djj6xQ4Wh4PCV19G7a9mi5DK49GNIueBhAMkdh8f_ueSVbZTqiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5DleDv3QmxtrybOJ3kxMjx0ZNWJv-Tlj1GreAtKZbUg&oe=6A523D56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrHVfjHQIkQQ7kNvwGoDyCe&_nc_oc=AdobBbR93bIlBLJTD36U_J4DDjObWcRqSo8RV2QAbLvTcC3mLrUuVPN7iW6qiJ0nO1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi5WobRSzns3B4iV9FrQjCEzwznLh4CrI22qITeavAjA&oe=6A523E0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzE5chnLkkgQ7kNvwEDVCpW&_nc_oc=AdorucMKXab6EDwEApkUP4Zc8BBGcZferzsB58ZufrKOjhCobZLvZ21gzRTuv2g46I0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_
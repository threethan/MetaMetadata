.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0nLWajOnc0Q7kNvwEiqZ__&_nc_oc=AdqVbmXHVoay6xEARASEotsX7DomNnC6hheQL_j0-0KWhD6j1cjpbqfe_agaHBZse1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Pw33l3aR8lIxX5BexpKEfj5aHmDIB4U29UfMHuOFlHw&oe=69EC9FFB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuH5xXglUGsQ7kNvwEYJ5kT&_nc_oc=AdrhLDk9sgs3RdHg9TZQgBb0vepijZ1aKDGsJfFQ2pCXz6c6Gx0d0Q8gzHftL10fZ3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31vXIPgMPULHMCDUsr4NiBRCmghwjLP1I14TAkGCBvvQ&oe=69ECCC3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcKhQ1kX8kIQ7kNvwGlmtbt&_nc_oc=Ado_z_GCc7koBgetMMO0MFeF-RDnk8VAdnw_bjE2fTIPX_v4aErrzU49ZcEw2LztFZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27ELnlJ74kru2XN3AN19wHePtexwxNi8pBVeUcamq35w&oe=69ECB9D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qMgUJ9RbowQ7kNvwEClT5w&_nc_oc=Adp1MgvC-1SD9-EKwAzJblv-pXy5TaM1EDNw8D1vQFtHHWomRmod3ZoPSgjqYUzi2fY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vFcwH5wUz0XXCvgDRXoM1yyVgJF7apl4na9_rAhwEaA&oe=69ECBA8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rixCa2d7BsEQ7kNvwFYfAXA&_nc_oc=Adrat1C7JWxznsSxesTG8OJtmavGpO0mk-Wn9jzToKWm0h-qeBenIhOBNFNSuaUz6rg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnLFKXrjsbcQ7kNvwGd5PFS&_nc_oc=AdptNe7zTFMwC3SkfGwJtLwyyWywisVwySIJPqNgVTDT4n1FJ5gsV9t6TTjV7-cAnAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ4cWCDsXR1LTQPTV0gmezbaTZ-J-UDW13L1cK8HB53g&oe=6AAFF63B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsf51OfLPicQ7kNvwHzQ9tx&_nc_oc=AdoVmc8QtZOMufDX9QK-DDt4ThH9qjCXx5zDsAzN8tjdugI1avkh7hX8uhpmni51ZQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7b5uI1Pa0K27rE3FxCTtwo1UZ80KnU77p6j_UhjSmHw&oe=6AAFEA3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FAAYGjG8TUQ7kNvwHbqNjN&_nc_oc=Adqww1vlgUPf8KG3xCV3sXzKI9RHNZihoblpQUfM3nfTSIeKNJoEiBR2vWNPcM4E5BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZlTjFgc89PKWa6OLLNOYSDj2hzk0XObeyJTwCryd-Ug&oe=6AAFD7D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XY8HDY4VSYQ7kNvwEx8vxT&_nc_oc=AdqhnW-fgjE98kC283bBhTNgMgDvNGmDBR6R5qy7OriGx0GfdKWWMQ1OqSQdqsD_LLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtneSN9tWk0DORY-stAYRDgy4A4TIdyB4LNHRUUQkeFw&oe=6AAFD88C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aELwxm1H348Q7kNvwG12OVo&_nc_oc=AdoNtxJEhjR3m49WnR91_Jk_JlHEWxT0yQpv7sHVbdjQQWGh82pwQAj0pN1lbT5t6lM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=201lQ6-786MQ7kNvwHY_CQg&_nc_oc=AdrxzyfmTs9LXBvc9D25gjMskCOKE-yIrneKPITe6zl_O_iN-cInqZ-iM9BtzDfMLcU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M5P6wsMRtEYGPxUaMZJXCCsjsX5GbLi7BbNhY2O8l-g&oe=6A452CBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkGf_UGHMXcQ7kNvwF-3qSo&_nc_oc=AdoaBXcJFzcZih5CDCHUWwSkpNV4b7dsyTPVY7wnftiVNBOSlJpJjZD7DfeM4EfpxoI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nP7pZcIURyTh7dS02dRNdF4a1QcOJ7GAoybgh4mmSYA&oe=6A4520BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9D-s-HMPrAQ7kNvwHWPEFb&_nc_oc=AdoMSmani-GAG15WXjPJpjweONkzEGcYOanxC1GkVwxKFdqhrH2sZrDwfYTws81CbpM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tFonQeEf46DsMEPH4nOwNzdIsp3sAmWcfs7QqKTOcxA&oe=6A450E56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQZ6mRT9rw8Q7kNvwEVYJdF&_nc_oc=AdqBvd6R9s5Lsg2XOKKXM2quZzPgvEN_IJRHYLLcO9WjxIJtd7B1jYSB3zDUiT7pDzk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tB43r3pnA7MUiDS13R_dteYRmJSgqmfbCDenjszbLvw&oe=6A450F0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYn6BxUpihwQ7kNvwF0Hvc-&_nc_oc=AdrfX-Ua3aqjnDnPitioxdMvas-FyTE6MQetV92kr0NoNaH_4BaH6iKvDKTyBC6Rigw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_
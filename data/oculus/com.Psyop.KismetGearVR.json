.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEKxPek2k7kQ7kNvwEdlKJq&_nc_oc=AdppyI_jjNQMN725d4gkTNK-WEnvoIcjzZ-Wm-sZhgCzuA2laybBeAGai75C60Wkanw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWmvkA2KW6hzIy3dHPrftw5lbmFivxoI7Uh4qacYXnQg&oe=6A86DF7B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enImvBvGT44Q7kNvwEdCmZb&_nc_oc=Adp73PxvVyIrZDcAD1Pb2kLbnPH-s4biJhtRTCQtMMajDj1yb9Gstee4luNZv3ft_pA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM4UHn3sYJXbEZ86KDuZQBbe6Hvk6MgXB0gcdH049jYA&oe=6A86D37B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyKMHAQENuwQ7kNvwEMxOpH&_nc_oc=AdpEufIjNqe38pZFIDEwb5UNP8UstG_XnGcj1GqJaTWUc42vkPOK0nUk__SD_ZG68hQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKI2Vyaku-1XdNUL_vn0oLDkrMxy9iqYwy9ybBg17Ahw&oe=6A86F956"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TtecNH_D1oQ7kNvwEetxpL&_nc_oc=AdptE2i1LR0BQ6v1OYNjJzto655iOFQwFN1rf7CVF7yfq1if7o-Vo8DtzJbwbu-qOwI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGoYKgD3erL-nHNOpVIAwqrJQvY4HHiGcdYv1hUiEfhA&oe=6A86FA0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5sGQjS4avsQ7kNvwF5T9VL&_nc_oc=Adod01OY0VV0bd_NOY7L55UwtKj2tp8GhRlB1Af-aq-ZKffL4V8wsKJXRf5X8HszAXc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5xm03Gqoi0Q7kNvwHXjLmU&_nc_oc=Ado_s0G5_03-UUug55Ztzh_zw-Vk8KeC0DjEw2YfacpE-ltoq2xH1ybHFPFEKRF4JJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSe5cw52BAWyAbBZvTAr62cz0hIt49SkTNWkih-93qmg&oe=6A5E393B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_msPtmErvgQ7kNvwH61xnJ&_nc_oc=AdpP014CpiDbtUM_z24_RRCIbXkwvlmj8IVNFQMZveKFFtylJ2FL94dCytBdmOm5yUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYFTvI2ZrPLqDIHvkwrrIIPKBuTU5l8u2NPJWNQYrSLw&oe=6A5E2D3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srSTwE0RbQ0Q7kNvwF6Stae&_nc_oc=Adqq8QLRgGDQ6MxiXg_soHywXZgggA35O9-XU079SKsqNIVwspGw01U5Z7legv9jHxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQJwnW-w0Fy6YbffGG4mkZpoSN3KVHn_7-9wF0oY7wPA&oe=6A5E1AD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeDb6V65234Q7kNvwHMqp3R&_nc_oc=Adqr8D4Ttbt0kNKDmJeLj-0lS37pGHeXWNoOd6t18gynV1ldb8Nr2StBJlfh2uVA_YY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmiPfXGe8mCxY8z7KoSCXdbHdNFA_t7MvZ8xVZbzMkig&oe=6A5E1B8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmQClB_3icMQ7kNvwFDjTRi&_nc_oc=AdrEKO3dIcf39bfk7agQ-gYKIIDa3a1ttCfrmBwJVyVnUkWmcqSCfTIxVFmEHTrOMKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
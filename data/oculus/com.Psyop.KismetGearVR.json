1.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnLFKXrjsbcQ7kNvwFe9aTV&_nc_oc=AdqACvCr5f4h6Lyzgay-MAauxPC2SpljbbDu5zTNn_EsxquUfyq8-7CJnLz2leCKRtA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDa6oomR1VPFmikmCk9O_IUhQrXKWdvkeCC1frMmgmBw&oe=6AAEA4BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsf51OfLPicQ7kNvwFw21Y1&_nc_oc=AdriNA3QzLx9AG9LUeVfLDq54hO21YeNLXB0YtwOjCHiKIjZYaWY1LrYhOwsZv5ksvc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdZOy-INgtqBJh4anSaJGu2nZD5HcDZJoUwT2NLlHTBg&oe=6AAE98BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FAAYGjG8TUQ7kNvwHOIRJ3&_nc_oc=AdoWiF4QNBmuMpVq5Z-Jo0oL0iDb5qP0G-gqmzM7aPpNOtRDw7X5b7lgdUCAN4R7Yu4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsCsc74UWjiv_KDZR7m3xOaPU3s0M24NyV8Gsa13skCA&oe=6AAE8656"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XY8HDY4VSYQ7kNvwF-JcMu&_nc_oc=AdposBbQtVhrv04G3PTR0a-9DtF05x0OE1u1PN2knNMPdT92_BW5lDt2l8heJ2XGAsE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkxpUJ_QTvtWOf8TzPEOjUhL63g4QjN_ajaWhwGRr3cA&oe=6AAE870C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aELwxm1H348Q7kNvwGcf0Uf&_nc_oc=AdpLMMv92L1U5efJuHxqzkpnRQ0DUh5_CQzvmvIwG6Sx3qRWRBd_NkKBZC1ydg242-w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.co
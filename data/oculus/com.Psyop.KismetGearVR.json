.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mJvBhUxmJMQ7kNvwEUJNcy&_nc_oc=AdrIm3YVn3msRqOl_UkNr99bjApJNSp_dv3UAmxtgfF-2IU7-dNaG3nYL_nx_cCjtEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ru20UNzxML_-JjMWYadWo5EzFK2u8XJNu_czPMnDoBw&oe=6A3BF23B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBfeRbko6pQQ7kNvwG2D-e2&_nc_oc=AdpSDBYiKENzKnyV8CId0WixyP-p5O3dY0gIhYUNgI4rk_dKJcRzbDitoPScw7KCArs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AopekeyVwQBs4J34pyMhyKqVUDytri6TQqNMFE-5dFA&oe=6A3BE63B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM2outBcfVsQ7kNvwE0Rf8w&_nc_oc=AdqTVzPsUVHEvs4ZvTE3u8G9AMhFwJjYGpNkYQfZx-OCU6Gx7HJ5t6B2sRWw80gkS7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qf-PgGGvd8rhfs6IkArU3s1f3mr5hSb1DcP6aWpjqoQ&oe=6A3BD3D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOpF6bv-cWUQ7kNvwGtBlWQ&_nc_oc=AdrxAXxpBK1g4zHiWnQWbggbBX79AcPTUyp-Plk-r5hELiXPnzJ7ZFWhYa58DtbrELE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xIZqf1yUl6M7RoOdWF3pyNzjML6DwBVHp8OoV75h2yw&oe=6A3BD48C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMQvfR9hSYYQ7kNvwFqXoYN&_nc_oc=AdoxTgK_LuFdKZVCuTnIsBADZ3G5QWAll9PNR7rLh_K-4LpXYOenCeSXWQuNx9FxnTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
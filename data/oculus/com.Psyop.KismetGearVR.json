.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WSK06Ed_7wQ7kNvwHRSN-A&_nc_oc=AdrKVvwFSiGEYc1gXk7NUnqyOXC6ube9xOBxYuDC2dt3t5ZlIoF1kg7jGFawDlvh3Hg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOYMH_nbtineVU0gZmN4_sFOKT2TI5t9QQQXdFoGMYgQ&oe=69CBAA7B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCKHdMN020AQ7kNvwGkTtBz&_nc_oc=Adq-y6-gn-eHuN9ptd9tI8f9KkSLAhrTHbCMQlflg8qny0y7w4w9gTHauP5ZeiqR7a4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmPSO5ERUs04xNgzT-C1d2WO4PufZkZkKPOnIpVIZTIw&oe=69CBD6BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWgW7MFcYEgQ7kNvwF60l0K&_nc_oc=AdpIwD1ieqXFL1kSe62iqK2JWZ55KjD365VapwaiE2lPy-PmeEEYzagBqE9l352UurM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuheSjresNT6bz0ECwFalTfC17w7qgtb0dAG_e8Q3Ieg&oe=69CBC456"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UephQIBNgxgQ7kNvwHiJINM&_nc_oc=AdqbQyzQtAwgE-rViiniu1a3BXmXFjwN3L8x1YXJj3z9fpKzD_tHWBl8SuiL4rx5t3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaMc00wJt9r3vw_yixaDEXgu8CyhLUyAkb0_puDUMUgw&oe=69CBC50C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbbVdkQ9XicQ7kNvwHjopFc&_nc_oc=Adr9gq4cDE4hV2ufG6EtOihIT_5PFRrFk4OvAQphS9uYbC6DRpZVt4uZPy5hmKuGw8E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_
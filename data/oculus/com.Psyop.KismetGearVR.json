.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw4-ngNkm9AQ7kNvwFwn2V8&_nc_oc=Ado6bpL-L2dz1tWF1fn0hXC2UTQ36h2PatGM4AW2yYwYmQXKr398DSC-7MUtPZrzk9M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx9ux1fy0dYiwmw4Tgcn76uTK62Gr_oNhLl_7P8aZ-Ag&oe=6A56503B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps4lnKWg7uoQ7kNvwHv5E-4&_nc_oc=AdpcUn6I0CJ7ZGbbpFzPq2uy33pXPkRZ1WqnbMG_6O_RzhmSWqE0Vci936yePm7HmXo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBCxq5HunBVnYAQfgDPe8QSxWHLo1d3zRWoV9yb0ixWg&oe=6A56443B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcNkaZ67THMQ7kNvwGYrGHi&_nc_oc=Adqu0RBYbupRLBkjbgqo3d0ICH12Y3FYM9cmTcr3cO68CWuK1oNPL19Iz2-qSWyjajw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNpsNDpwBTPknqrY0Wp7FYfYZbLzI_8gbWyday372X9w&oe=6A5631D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GlM_pIhpWIQ7kNvwEhrmeE&_nc_oc=AdocEWOG6z5I19DqE7s3ppbiEzUk6PNR-RiLmW-JOD4GKpVsSJIVh96cAYQWf5HqCHI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMKCK-AIM-3TrFrT8Dze7btVH-sTGFJSCdI6aKHkg9tA&oe=6A56328C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuptQTlIP6QQ7kNvwH2TSCk&_nc_oc=Adp14CmFrPzvez_q0st541hSFBm6Azow1xadwAja4aQJoUws6xLT-oYMKFo5tsJ70Rs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_
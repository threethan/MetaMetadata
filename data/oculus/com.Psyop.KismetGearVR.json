.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv4u_a01sEgQ7kNvwG257aZ&_nc_oc=AdrFqu_qTeY1GAWfNDHRTOfCv98niFy0IIDdrcHNswhRWE-qfJ4sDMc9L1bXie4ilLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfaOhNGS93vzkqh365-srrQJo3GXB5kVp5BkI8Ioxwyg&oe=6A9C2FBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDVKT8ddNhUQ7kNvwHvdQZp&_nc_oc=AdqqG43JH11XO6SCIYEXaBj9SWpSpETiVW3w2s1oXgm-_DWHzLzU3fp020ra77qNDjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPyT1-MH_tHoxltRmXmijbOLXv5QuByGTaO2uz1dMe7Q&oe=6A9C23BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh0foTlyPasQ7kNvwF7oOlf&_nc_oc=AdpmCwBkHs048n_weFXf16Y-0iXPeGYAhTip60bdxh95GCRI6SowRbzprmnSGu55qjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdW_NsTc42W6APRtWY5bvfiDeX_tFxEI37UFn1oJHPMQ&oe=6A9C1156"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llg3u636wEcQ7kNvwH6BAzn&_nc_oc=AdqXO2bAot-yZgDMxeqGTPd4ZVlYlyDtt4DrFaHg0e1gKuezErK9-byBVSJ_Vp08L84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL85Xcvnwyg_QpZNJncwDkdP3HVPc1JWAPkKysVpdoFgw&oe=6A9C120C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY7VDBNu-BMQ7kNvwGdQTUA&_nc_oc=Ado0Xn9KbHuxK7-3PPixfY-zAtjVHHB1afcruN24s3BTStMCsVjs_V3p6-kZTZAUlME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_
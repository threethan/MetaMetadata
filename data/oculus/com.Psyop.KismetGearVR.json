.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51nk5cb7X8cQ7kNvwFB_ppi&_nc_oc=AdqG5sdx3LvhMSgZCEQ3mp0Uj8kTFC3KLNzks_PZrfNl_lEgjTTKsDK2Tn2o5AvONcA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNXn03uiyAwusk-lpuk2J7rNR3dElT1y1VFuZo4kPHpQ&oe=6AA175BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5jE0n9R-IIQ7kNvwGwFeOZ&_nc_oc=AdpOM-oCcJ3ASkPET4fU1EC5yPajFLJjF7XY6r4S89vrcL-_6Oz42PHvgs8hFi4lEI4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmp_eeGNEGo9E22DUg0Cis00zerBxMeARVHdovS0FoMQ&oe=6AA169BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p88CTZ2oDw4Q7kNvwHdT3p2&_nc_oc=AdpDOEOBdoIMHtNfcU8RUk1O-6gNpEw4bvG47DlyrZXdVC1j84cDIiTjkxkCW6BUbls&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSlxoaqBAgnD1HqN8yKQExdHW8YaCOETeVp-PBaeYcwQ&oe=6AA15756"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB7J_IKfOI0Q7kNvwGUBCdJ&_nc_oc=AdrEY9GJWAoNNlXH7lsnjsr2nXmuHrgZ4y5ZQ2r2Ol3R9gZNLnbUW8myUmqN-cxKGQk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVh_fgseeNcYcafpfZX1MaT93OYj4D2UQ9Mqo-jzheGg&oe=6AA1580C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfanbkCEeCQQ7kNvwG3NnVi&_nc_oc=AdryFEDbl_1HKNZJ8gykJbahoJjJ-xuRAznqNyP3KVRhn0PNiDe32EzMa9CGrh5DgUc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_
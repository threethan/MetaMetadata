.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLYemn5s_BgQ7kNvwGyeLDb&_nc_oc=AdpsL3MRObdh4NpKoUhBODQ9tO4KfXO29FCzjC14H9SrIAAVAw5jxMW4JwcgPCWq36U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtF7q76kEjgdZPauhjMhGq6xemySfGoJ257nWmvpqL6A&oe=6A74A2BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQcY2EohqosQ7kNvwHPUP8H&_nc_oc=Adrj1eo7zN0yzxoOIjpe4jABdjhcbyo33AvrMN73NJKEjjp4HQFFu_dw9D0QkmmDwOQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfWQT-xRsFXRO6sSCmSspT8ehMRB1nOOyQN95S0QefJg&oe=6A7496BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3A6uZWtUJkQ7kNvwGCpJ_x&_nc_oc=Adp1oJrl4PdSm2lIimRud-u55NZDg2sgZ8f8G5ZkuWrVZutGGKh0R3lxlP7c2ZJY98E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyquo8qIi1CBy83t8UXqd9xeg0ZIdeU14tmgK7k7CswA&oe=6A748456"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqEupSBg0n8Q7kNvwFYoqGU&_nc_oc=AdrEJHXFE5YuPaKmNSeEMhFdRVIiEiU7q-wBLuVWN-p2ODauM6Ge6Q_vMTxaFCuqzf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP1cNgKoO4x9HGYNytnfwLlZlL2GBSh_Bm5hNZ97ttpQ&oe=6A74850C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCeuwJX_1DcQ7kNvwHaK9AW&_nc_oc=Adq8mxcfEfWg2kPpmbFzrb8pcUaymBLsffbCrelSLmSlKFmdWNIRvz5V3xjzBKXea10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02pjFSDAp3wQ7kNvwF6CH30&_nc_oc=AdqF3VaYvqX6SMzx7R_i_eXsSXM20XDkN305ul4rA4PB3niGpxTXPWzfvAajhk2np4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChibnd9AFKMGNMnbIujym9qKFRbO6PmU1L2HlVkk-8Ow&oe=6A6CB9BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKZfl2ysGyEQ7kNvwGJfaG-&_nc_oc=Ado6u1F6FPdV5JmXYDIe51M18K4x4OnYytHJPJGyAdhargaSeDqUoaLy-tTrqbg3CM8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAbWjxsqrd5U5gplNPG-xI949ws5_G0PV01FT30HcAuA&oe=6A6CADBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6r1T0rlYu5IQ7kNvwEUoIKb&_nc_oc=Adp4L7frqGUQ2PCkvuIf1TSwJNOffi-zFVVjVIRZ-3PhiGirzbeo1hO1sXKoA2bU4XI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGPfbOc2UFosVscUtTxSk1hkvmuxZ1Kit0XnULuQPYjQ&oe=6A6C9B56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ticiXerGA6YQ7kNvwHgbjxu&_nc_oc=AdqD83QvZvDNGgflehjOQ10rVpWc1RYKgD6F8JpNHe4Vm1L08UAuZ8jJxLkRjnS0myw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXQa3hUzwyQVruzORsVyqZ2nuR6gJG7Gt460O5JGDGgg&oe=6A6C9C0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX9XgIiVOlsQ7kNvwG2MCLD&_nc_oc=AdrRfpihuXbt5NYvSXPVzfdls0pDmpUt3DQRwPpHvKKkUTVh_4eg2gWPntMxtr5RE3I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_
1.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fFc8WN23xYQ7kNvwH40Qct&_nc_oc=AdovSBs9qdr79Tqbng9ZIAzjdh14lqgg9RisY8-RyefgX5h5DpFvjnjrzLmX3eoKna0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UvWWUuhNdhfogTpUnlvk0IMoznIdyLVJ7lNFrxaRafw&oe=6A467E3B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkGf_UGHMXcQ7kNvwFxIDCL&_nc_oc=AdokLHsLkOHQm9n8j8gyFYgjBGGWHACesGakTVOr3GKrdM2vJU7bhJBVyB5tnHKEILM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3s4JAar3eNZPjzLQ2Tn9peGovzVTMhaQo9IBL8tUumw&oe=6A46723B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC_rP2LXZsIQ7kNvwHpJ8f6&_nc_oc=AdqIr-2feZKSAlMQ-GF_MvBYVkJYB6V2VGlDW7WlrRybAxrcgpUiRbSaKVfLEt2qKRw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0O3RS1DtaAqbvVm23D2ekzlLaYEH-w9JZRdM0k2Q-3g&oe=6A465FD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQZ6mRT9rw8Q7kNvwECAk3a&_nc_oc=AdoTITdJq-CjsWDZhtqBBZ1qcXsZ787cFZ5qie-9g48PaWaME8XE8M6c_ZulTLZRBnE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l0xawdIJpk0jvPshWM6TL6JeWomAW-Z0vkBc_ChvNBA&oe=6A46608C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7e17V71KzcQ7kNvwFbgHaE&_nc_oc=AdpCa1gSjdqMFYzeTU9BJ_j9qE7nnTzC0KjWR5dj4_O9b3Cws51cnG0QlDw8eaImAk0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.co
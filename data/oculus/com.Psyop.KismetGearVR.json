.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHTY4RiAKn0Q7kNvwHSVRjC&_nc_oc=Adp0ksg_jLKovElsQZYa6qq8cmxzHC5kC6ApuUDPD5SRfB3HacdszkUIlz9A-WV1ioE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06GSQodukzbnDc83_gj4S7axYk3_wGRQ4ppNxJW6gkQg&oe=69DE1F7B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h8QWU_zE74Q7kNvwGSbQup&_nc_oc=AdqrucwfzlMwA94iO0LEmdCzw5BJH_YByG_wdRtXEXcZK91qJt8tlyfAmGUE97hKUkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pApDQnV_tCUEVu_ClOIqyjIzIOV6VKjPTk2mK63ti8Q&oe=69DE4BBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrDFP8uUdPUQ7kNvwFnGig_&_nc_oc=AdqeU8ADgFtgbkunaXLLNIMdMR7BOGiOubJeSIzZtwH0DDeGovOPHhq2pjNZ8X4zEcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2br084292eZLnBWjlGDHZ9X88f8Q9m-EGjJlUYpbjAWA&oe=69DE3956"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnesc_VGk08Q7kNvwH9KgjB&_nc_oc=AdoqY85XXHfeuoscsGdblqJcwq7gTH8OYpA5gQ-HjcDVWNWO-wggcuK6NVSvxW4j81g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hecds8ihK_oFjE_37FDRiha-9JJFN9UbtIiNOO-bPQg&oe=69DE3A0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tdiFXX4n04Q7kNvwGTzZ53&_nc_oc=AdqUNqaSB5CjfbPZBRpxQP2hJhN3L0dlrhNZQ2oqBWTRTtyicoqGuf6u2qzlRjkV-fg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_
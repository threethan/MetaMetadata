.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skrxSN9RneIQ7kNvwGKl3pI&_nc_oc=AdoIDvmAfdRf6TXrUqlrZue71j1r4uWJb6e4AzugsvQmbUq4DOr9osbjXGjj6OnN6AU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RfllWq2F0AalsCxLY2OcU4wCyGYFFgvGTeHo8uiHQhA&oe=69F612BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld32EGj-LsQQ7kNvwGWXvUq&_nc_oc=Adq02qn5ojZho2Gufz2qqRSxQ6sFiAKZYRnhdlFsJolg5Fow6BoVk8pOUcOsn0aMu9U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28zpZiWS290GTl_XyZO8xVIJusUbRFRmCdO84s2jPTMQ&oe=69F606BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLMEOdo2mE4Q7kNvwEaX1UL&_nc_oc=AdouuXBjgvjA0iIkC0P89PoMIHcNuaei20qZfQN6ovm9BaZiY9cRg4fId8gZtmB5XzY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cfWKMldoAzhOe0vGsMKGTtmhfXlOJjNFqjSnkgmWk6w&oe=69F5F456"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDN4RSmX2HwQ7kNvwFoVk9p&_nc_oc=AdrIvxX6Lik-z_47cvaVqoC_6reT70MxrRiase2oJlvFzzBduRZ_x5WYeZtAkGpHg1k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wS6VcCAifTX2ZPTBQCAHvUxi-w-6hPjreTZXqfR6ktg&oe=69F5F50C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCGixIxmV1MQ7kNvwHU7NIB&_nc_oc=AdoxUlCaZ7s01zy1zq5ln-m1SvGYBxkKF3ffNc1YDlGMT37A9haUjwvUM4sSNzO5CSY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFCxvFldfZcQ7kNvwGjq8_c&_nc_oc=Adqeh0VodqOr1mSrncZVekHgqcs1jT36-rlsH5ONUM-M9ajji3xYeUPoKM9DFkDDKD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yuMWDB-RWUUlyd0ayOPXAbqR-IVsVPF7xOFVFjKO8WA&oe=6A2ACEBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgPamUkCt9IQ7kNvwFMEUBN&_nc_oc=AdoB0O8HO_YE0TLZilWIjFCg_x1wyLhCaZVIGNL1UZPX3sgf1gKTDSJV37--iyKu4ZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91xp4l1JRv7_61Q885_jnx0QHWTLJWNdvOD4gCBgRurQ&oe=6A2AC2BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jryrvZwIquUQ7kNvwGkJLnF&_nc_oc=Ado3__tvIo1J33DgZCV6iLX5GGnILgJmw-cZOtONvUjHBVyAz0j2YL5TnpWGSG6M97w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80ax9Y8a-MCii9V6BOr25WnyFKB4JDhUEJi5F--95Z4A&oe=6A2AB056"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWnZLh-il80Q7kNvwE5zXVb&_nc_oc=AdoIc6U_ltJXCu8tPdNTNvlLIfln3g-XYyYL32hBHuZwqONWEp4Ob-b0j2gaHuZWhyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ca31VvXSN17jVY4dSxEffyICbrc5-mCL6gLcZDC66_w&oe=6A2AB10C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8zWXibVM9AQ7kNvwGbhoRV&_nc_oc=AdrOU7OTEizzOvcy7THaNc8WLNWaLqkN9GltZf3Ior4l3NS87kbz5IRl44b4NDMqVi0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_
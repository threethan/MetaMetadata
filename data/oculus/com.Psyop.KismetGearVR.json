.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHn2B12KonkQ7kNvwEGjr81&_nc_oc=AdqTPCvxVLGBFrrjMqfdS9k1kyCPsVuxa-wQYJr_UG3vN1GeTnET9775-zy-oVSHFks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r_g-S6_zrCdsxvkyitWlFh7Kc3Xwzc-VGWRG5S91Zyw&oe=69D27A3B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsHhL4jLSq0Q7kNvwED6UlJ&_nc_oc=AdqgNnvAj7V2EoHZNS_r_dv6MaS53VHkWpzbE5sS29uBGTpmaqeSDTKKVtBWkMpv9zY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XtcMWDgz7NtVktDKSyvgXTQBn3EisF41YjguR-vTBcw&oe=69D26E3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPM8xe_h-DEQ7kNvwGRdwZ6&_nc_oc=AdqA9mOqiVnxD--Yh_gJQj2QV3o6IjU4TsXcjkTfruV5cDW-kQk8LlyTCD_fzR50i5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ll7jWxjV6wM8wjc09azaQfRwuCnmHDk4J1lw1ixK0UA&oe=69D25BD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGlnTunOjQMQ7kNvwGWOnhx&_nc_oc=AdopaDdV3x3Cgq5xkVYWDxv_tbEx6m8cQchvsmK0RWxGzPdACovkxhUCm-9ajvQlQkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MLPyXJLXrSNdmNssKrQ1JsnuenOPo7pfm2o-rtIXt-Q&oe=69D25C8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgRINv8dfKUQ7kNvwHxqEum&_nc_oc=Adry5x851qmiVED_jSO1bM1hVWIHaP-EmpD0am53lI2X5rXrwV0-1fpC4DK67KPgNIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLOEQ4iv9rIQ7kNvwGq19kW&_nc_oc=AdpgyFQaOAiFvVyshJmTCisVRHZH6gx-Ijdx9Xpf8x90Q2TPg_gpIJ1Bj0VMznMIggU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLH0E7WYMNLZm2ISDeHfL3OMF7onn6b55dwa3CatJt-Q&oe=6AE603BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_2FIS1tG0IQ7kNvwEXJrZh&_nc_oc=Adra0YTtgQpG3rYMcgtGmW9_LWD3iOpCAfY8p5FkHEz2L7wcIh-Ig-7IcxYLVluLhSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjPH86-ku7lhY0Z3EGJ_2gCw123PsvTqy6Y_VvSOv4Vg&oe=6AE5F7BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mdo3LeLwSQQ7kNvwG0l8rS&_nc_oc=AdrKCdtFic07B_TlTZBG4uqKdzeIU9w33AynI1t4zPogirQLHirpjmRQeYTvzOmcVkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCxhurU32IZG2jprgxC4MAgFf9XXPQ2X1WmPWyyqiSTw&oe=6AE5E556"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KE1KoWFGu0Q7kNvwHSl3HV&_nc_oc=Adpfl-yJab3JDALLcmUSVucOl20E4zFVl6jPtR3V2W4KM9ymywAGul6VbmiltnGt7g4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9uhoJiX4uQJXCdSboQniGh2LoiabfbQ-ANuk8HBgqkQ&oe=6AE5E60C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIpk1a29Wc0Q7kNvwEFQqwD&_nc_oc=Ado1QKPk2msYh7HXpEdBUOIxA7dkcheozKOQ8fwAzF9uiBdkwKJ9pgH9HGCCHlJj104&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_
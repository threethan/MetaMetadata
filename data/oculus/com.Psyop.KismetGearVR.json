.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw4-ngNkm9AQ7kNvwE5ePQh&_nc_oc=AdqUfR5ZWSeR9yUDrKEcV_prRAK3xZnWcgtcU5jSbJOTQVNFmOIOVXwFD00u16LqbNY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-9r26MCuHQWQUTM8YWKjockd7BdyTC4h9gienBQkK7w&oe=6A54FEBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps4lnKWg7uoQ7kNvwHgNh7U&_nc_oc=AdpxUbj9CTa20Vm6u6g1ziw1YkG28n-ERR1gGxhEHBGfMGzUUins87uVoyQMKVJBoMU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9-ldhK6JLt_Yfzna538o3Wu3Bq6rAlF6Agq61RPiwQQ&oe=6A54F2BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt5jnwtALXwQ7kNvwG4IZze&_nc_oc=Adpkp-w26r_UI7UgtoYEBhBOybSosPo6e2fRgooF6gHgwo3zsuxCUGB04Dx5CoY8tB4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0jdwgqBMWixBkJAl3fbE5IC7g51Cw0nJ6Kzvw8jvAvg&oe=6A54E056"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GlM_pIhpWIQ7kNvwE08zX4&_nc_oc=AdrRVNrZkv9TH9I9FPhIKfxJb5X0WD5bX7eOgen3JQsAu9pm6Voz4YhW_xAxLLupx88&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE2OXy9dNe3vY_-acIelsy16QYrD9F0Szw7KqCsHvENQ&oe=6A54E10C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzE5chnLkkgQ7kNvwG1yvnx&_nc_oc=AdqqV8Ji0ZLEf_cVo_G8aKTNr9Srj1K5fgCVhXqGKaq0nNIBTzGlaVggUV8m85FCvxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y-FBc9eGzQQ7kNvwERk8yn&_nc_oc=AdrTFi-j3nKYNbAVvbZFWAJo3EIdQhShLADBLIH9br69Z2Ypn3BpwgJ14bg1b8otc5w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNf03JLYhs_rEQSVzhXpvXTjOLd-FYCndgCG5FmO5x3w&oe=6A8AD3FB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI9ogXo36QUQ7kNvwGo7CGX&_nc_oc=Adr7pg3Q9lpixEnaNWIqlUsAvJtoXe5pRK2zau0HgAYONIDoBJ_Q6mSwaUQ3udBmWoI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBftIpNNVfCr8qdUFjmD08ETFn5IdzmZ8Ds1Wphq9G_A&oe=6A8AC7FB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWmTDznrX7gQ7kNvwF6sfju&_nc_oc=AdqEyR8TB3eUTnn9TnLhvVn0NCxuj9-p26MmaE_iSP8vqddMMIflLMbxa5IFD5pGDSE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT9IgHvUy3BhJnLFoqbAlBjYlaVqtnU6v6vxeaDXKI8Q&oe=6A8AEDD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YoMyCW1hd4Q7kNvwGzO9Av&_nc_oc=AdptXj7WoUwTKsqOr8B2sIz_EA-27Da3ZuoViK-fUh-zSVAhp1PAMlNv5MCaFOwxXjY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMs2gazCpRdEz2N3A5N1A8Erh2Fn6chHgZw5H9ry7-eg&oe=6A8AEE8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEJUjPlwsHwQ7kNvwHxMbaC&_nc_oc=Adq3YhsDGjxLBhCIQWsEhX0VupAnCxrhc6vApmNZonRVieaJJx84N4G2SsTvmd_2m2E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_
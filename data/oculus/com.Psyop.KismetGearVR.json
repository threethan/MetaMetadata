.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP6eKWx00E8Q7kNvwH86AzD&_nc_oc=AdrSKTaZX3GWpOZJgiisz6bqL2cpZHkQDsegZZlpYqN1_QNKAK_BT32aTnBweJHyT9o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_8sXjRyMiCjLIx_Udx2EjHx6fQ5YYlNDjwQk9gOb_4g&oe=6AD38EBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70rFJ35GAGoQ7kNvwFPQ1tV&_nc_oc=Adoe1sKgb4jKxPUCA1R_hsbTDbO6HuxYdsubjyTafMWS0Bcn-QzfAQMAmCMRfuCgjSw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr3LSrdnM6INL1vYkxd3XAjRzVz8Y-ay-kUO0l0DJeow&oe=6AD3BAFB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSQmNq8hKL8Q7kNvwFLN1-k&_nc_oc=AdqZablhzaQRQ8T-Ivo_jJYATiS-55jXZ_tvO-0FGojZHdjg5JTT-oWdCE9_hrSOq9M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR1SsuzOcjuuDEQ1FDcv-sZvK9HxDx_OhXsRzXPvyTHw&oe=6AD3A896"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qx2n7HNlORcQ7kNvwFwLaFY&_nc_oc=AdqIBduezZT0Nnwb4ftqwxJAcPDImZFCtQ6Y0WZxJJKiGdY8712BvnHC68QbXEbi9h0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhoINPX-W9FTF-bJ6xWW8cHZg5g85JILIY3eaxrbAVBw&oe=6AD3A94C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddWFeQXwzv0Q7kNvwH5OMMn&_nc_oc=AdpOT0n66_LGmwAmV0dn5jOVOva_guu85H8R268vwxiHxWltFXgu7y7Z-4SwTuV-1TM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSG1t_aNyo8Q7kNvwETJVZa&_nc_oc=AdoH5VpT05QUA-j0CP0ro9OR8eqJbjzhgJE_hPUUkaukq8L-FHlDfywK4Ful8Ki1Ar8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GcmyubgNle81DvPRMuI6h3uAQzyDzB1tIkVN2plmrBw&oe=6A297D3B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgPamUkCt9IQ7kNvwGrhOKu&_nc_oc=Adq0CiPPm0vJZCjlHsp_zXrYphnSWBjRsWIoQ6TkF53vxW-rcS5KuPZC8kh7F_eA7GQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RGeLfdzr2uYnWfULIbOz-ELIdIIpbN6dnf4eKPFG7cg&oe=6A29713B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnTdZn2bwq4Q7kNvwGHeVic&_nc_oc=AdrFXJBEY60cy9z-sQPk9kKqYtZDWPzYQKBCQh_3xAqHRvE9EC91-VN_VRtLGyOL5ms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af968imW_3GPoynQ7xhVGmLY-LUrhdarJr62KcPJfjAsBg&oe=6A295ED6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWnZLh-il80Q7kNvwHqHzUW&_nc_oc=AdpmK0TOz1cpiSWEDBBnM7jnWpQeWLOmv1ryS2_l6Eho31144YH9hee_G5LokGHRbmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7vCml1fkWrxNhpi0tBrZZM-ADNNzlXSpS73Ml-OUXCA&oe=6A295F8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Txzgb3PDHbwQ7kNvwFj5FtY&_nc_oc=AdrY_RjZQx5dvU4k1xwKds0UCX3GmS6ZkkYxD5SEos3zrgevpfoOdO2s8FCH0exOiwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_
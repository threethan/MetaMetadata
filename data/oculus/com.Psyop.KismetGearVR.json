.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw4-ngNkm9AQ7kNvwFM1ysJ&_nc_oc=AdohIZuHd06R0OoEPwPhA1Zswp68kwK3yT-2BIIy9jDr-yYUihQ7iyriu4uFDlC5674&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChhCd-kavop5khvxcU8X2VvhblxEtj9Mwwk9hznOpZGg&oe=6A53AD3B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps4lnKWg7uoQ7kNvwEznxww&_nc_oc=Adq3XfPWsR57aWQvtV3pBaA3iN7RlljGg9aNeysVl5EgwAuKpsQCLJ6y5V2BKEGmohw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw8fpV1MnC5sGwMNw2Mp74j56sDeaUzlzizNwnCl6JKg&oe=6A53A13B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt5jnwtALXwQ7kNvwGN0rru&_nc_oc=AdoCEa-tau8SD2-CY6H8aoHkVCT1SAyDgeyP8PpHkKu83PBeUkXVDV8POQxsYhTIeuo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6Ts0v_aWMN9tr5-eytZy9VKKt82DSczL5WHlOLt-JkQ&oe=6A538ED6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GlM_pIhpWIQ7kNvwHOy_6u&_nc_oc=Adq3v79EJ_G2LSv9kQaMZTTso4pjNwdX2a8ExeeGg2whfj2WCapMOKwzc59ELc1Xgcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd0MKgp-jCrCzWL2vpdEo-XEGuQoCIc26MXBf06M5HTA&oe=6A538F8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzE5chnLkkgQ7kNvwG9UcPE&_nc_oc=Adob2VANmBvryE0xOPojSjfuynoXPMfpoOYL0H3vCwKorP8agOwUNqEp2Kh2hZygchQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv4u_a01sEgQ7kNvwF-BeMh&_nc_oc=AdohgJ-6IZ5D4yyDhBaQQsEgXGqX5J0mSs-LPMIoEGk30WWnJUCsPfhXmKJ8E7h0428&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-8hYp5ZssAtleUHnTfTb5wxZlp4OL76b7cULLrhD86g&oe=6A9D813B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDVKT8ddNhUQ7kNvwG7uNq4&_nc_oc=AdqsDkzT1rbfTY4-dnsogp-PIPikzdcoPZlHsuDgHAfr5BpuJ67xpEYQNd43U4Eokmc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd5q7-mjhLeR2WT0kYtU4MF6ffh10nCW273s_mq3EPKg&oe=6A9D753B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOiMHdlGlAcQ7kNvwGrlTST&_nc_oc=Adoacjggc1bGxqzAA124NuHTUtY7aVoh6vNoRbTc3IIgI7XRbbyqShLhse6nVjFCDAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINotQOFMXDRABcet6d-lweMlVg6_EpjTeXkoUld3FSMA&oe=6A9D62D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llg3u636wEcQ7kNvwGkEwFB&_nc_oc=Adq4sIleBy0_ekZRxtFA8DI8I5UjlibMMRoOIG5J8p7aO2EECiCBLvXiLeit1INtOf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK50tOuYaUaJ3NT3j6UiOca2gkun_10hlxDmmW6vJDGng&oe=6A9D638C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IWIfJOuNs8Q7kNvwEItADO&_nc_oc=AdqP8xCCPYZFMGTQYeYa3apxz7mLQBdqx_wLQ8oOLqY0fBr8vC2EIexjrZhqVcl7p5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_
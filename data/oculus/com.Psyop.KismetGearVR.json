.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Amwxd1X52vgQ7kNvwGpI7F8&_nc_oc=Adp6PcrRtga2FcPB3UnChs2tNwpCnwd4AfejxkGjXRa1Oo36RnvAvi85s2vbZdtYr8s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgj2N-zPQhZydWwEM7oeWkXnufWYRQtCbljMvYhoJXzQ&oe=6A66223B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOo6LGCUmmgQ7kNvwGOYB-J&_nc_oc=Adodnqp_QT1Z_01W0o4sHuf6e-YUzbgI7ktdnY1QBak6NH2mK0r3cR6d-uPpKJFAewY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWOZ2exJuiRAF14YaiUqksHFA0CfmRmgDaT-F_-4NF-A&oe=6A66163B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZsRhmAcs48Q7kNvwHzMfuL&_nc_oc=AdoKPTA5GRcliy4OhQZGH7umEH2SNvlTECra6e2GnymQaJUloHB70w5d68WjFu4FvQE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGaEoj5JByTq5-dgFAOUms9cNi8E6rkh9c13lpw7S_cg&oe=6A6603D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tizfkr8oTWUQ7kNvwGedZw4&_nc_oc=AdpaN6tZpNvEBLCX-3LqyUjQFN8YauMd2w2V-Mc19XTjs685gzadvQNSUOhrEVdBJFs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHYo3W8vbsImVN5lgCaN0Kdk_oOx1F7fQ0dXBfTs4nUQ&oe=6A66048C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnySLgoa1nIQ7kNvwHXidLS&_nc_oc=AdqRLMEelYtZBI1Ozo-cqTAeTzeQEZ0YdF6rMpkwsYfFl6hTwXMRtvTiI8-nayLj7sA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_
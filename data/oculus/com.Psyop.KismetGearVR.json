.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFCxvFldfZcQ7kNvwHlWVTy&_nc_oc=AdpfdDbicJUcuw1GaJbtIgiwCMViGBQq3THdehgfhOU_4tjY1RypYQ8XUmVzRAOsoQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yqiqhwzjEQZa4EXy4hAvF6zOtgFIqFjTmRyv1vSNlig&oe=6A2D71BB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mVk4-qDilwQ7kNvwGqztTR&_nc_oc=AdovZVo3J_-Q8LDPbdiEIY_gpZSZnCruIapCu8p0lpSwRL1CgC7-p-prSbiQhDrkIUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86_9qpxlZq6_tkST8x4Js8GwhlERjqVh7lAA8nTmr4Mg&oe=6A2D65BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jryrvZwIquUQ7kNvwGxaGG6&_nc_oc=AdpCAUz87rbR_-XFfQqiRc4WvN8myix-cV1SXB3fSFc3bkGyVCzhROGvEuuGx15smL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nmDCS7iEk1zrFalPms4olhLzPyyogRPX6tow1ofq_JA&oe=6A2D5356"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVBg5GSuZE0Q7kNvwEn8wCt&_nc_oc=AdrtFes7urtwmdKkIAVw_bCZN_Oy20KcClMEJNMpA8vL_LDeVG3q1lWZEaS2xHCZ-Wk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oRAMVtHklwEPPlj0_tWFfExMHVlAhsJUx8PpzEsi9zQ&oe=6A2D540C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8zWXibVM9AQ7kNvwHW9Mxc&_nc_oc=Ado7oelv__WMK4XxVp5ZvL55eBFxUojW5mOVpoGmrOUrZtgNxErEbnfSJNd9v9ZoPaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSG1t_aNyo8Q7kNvwE9ogL4&_nc_oc=AdplACbud2qqDTJMMYEs_aeGMf9NBruRnDJphWrFV3BX3HMK4LS-k1wh_hzNXJcTV7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80GKTFoe2kan3A8POmeOZaGDj_5TrPJD9OWuoE0pzG1A&oe=6A282BBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgPamUkCt9IQ7kNvwGjth1h&_nc_oc=AdpeM9XUrZIGkwRoG1IkdmAgWIZ4OUaKp_a0fxMuj4s0gl62DS8-SBheYLyMa0pu9AA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K22tekJtDIr9HyhsBXLJ_D9wwrP7tqXtI6sECbdz41Q&oe=6A281FBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnTdZn2bwq4Q7kNvwEil5o-&_nc_oc=AdrL3p5iWAEXVsx2K4tJoqP68gyGLehYr9jHnIWjvR6R6N8IXCKFXj2rstv9pw8y5GE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HrpFn0fNpjVf-e-OLlHmCdWZVgwmSCzQcQ7mKf0pcow&oe=6A280D56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWnZLh-il80Q7kNvwFsAC2I&_nc_oc=AdpBoL39Sfpl4OXfBYFTdqurny6jykuiXqTlpR6D2CxtJMGp2GpTFYapl12lEyVycBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JyOZWN7GJwnjJ1pTMn45T0Kf_HqeNW1TqWWqSBS_aEQ&oe=6A280E0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Txzgb3PDHbwQ7kNvwG1b92m&_nc_oc=AdpU5IYTzU4Q8KLq3-RfBcJyovSSjinoe-G4VYc-WHEh1xnZ1DWvwP7G_8yCoGIakcA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_
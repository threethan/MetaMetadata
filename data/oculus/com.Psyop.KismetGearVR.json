.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJh8DyncXK0Q7kNvwGupXoF&_nc_oc=AdpuhyzaWV3c5U2p5fXWKGWLN7TCv6lqOSDKqY7XpCyE3sfKzkdE4agA9WLnUPj0CJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VCM9YObK5Z0GN4HnbPZeaTCSKMvKnHyMxfllTaUS_Og&oe=6A0B2ABB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AHfOzVnvrUQ7kNvwH0V88K&_nc_oc=AdoIqF4gMwlAzqK8OkeKn2IQ-ioZkzW2roqqTqcjm-tmqBKg_VVsFscz408B7uIM8Kg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54CKZ4OmPB3Gc2XtXo2qJza40axks0vrccNeaH94ouCQ&oe=6A0B1EBB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72a9Hn4E99wQ7kNvwEiS7PL&_nc_oc=AdoaoWNDG_DfF21YGDhOiMLvW3PsG-38tzgCr6XRF1tOaVlKYk5pgbUypHzoTRqi4zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZbG2sTIvod0TnsQArPEjk-B9wCAHvwWjNCVYWgDbglg&oe=6A0B0C56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0Ld-GbRhncQ7kNvwE7iUvY&_nc_oc=AdrrjwYl6PPExUnvyy_-TfL6aCGZCOjDmb0HUCYPkk-XDWgyR1_rdh55b0OnVPRkAU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lE1ElRAi8zXOYYcTHNLNF4o4k0TpPT8IU5hBWDVJbMw&oe=6A0B0D0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUCgGIIr8EcQ7kNvwEb1y3v&_nc_oc=AdqXtuFuhlzqpHrl5izFKe_rNl7jWS9DqY0I0fxZhNeBMVf-hULInimxVIaj7ujctx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_
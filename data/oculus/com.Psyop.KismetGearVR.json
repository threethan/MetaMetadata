.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7s4ryAoea9gQ7kNvwHK6F6-&_nc_oc=AdrTWpVueNUoCIxH2IznCcT3aB4ykxexxwcPzbbmmThjNkqHbi78WkIaIAHDSVMx-xI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65hzZNRCnp1OXFqVCIZV9xoHhm24I9wtARKLsa2NVpjw&oe=6A009EBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMVIfULi5YcQ7kNvwGcfjgw&_nc_oc=AdpxFBGERCtbOD7rM7GXAkYvKIVPbqOuyI0pkbhF7GIXmpZeteH6EPt__kpk3dZbXmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qtWldOHO1wJjAGGHBJpGyqimFNg_oHKNTuQVbSw0QBw&oe=6A0092BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGpdgcNT9y4Q7kNvwFDWMfw&_nc_oc=AdrlRptq0Sf5gslgt1KsNan1QpRivd8CNcHV_-ilNl56SkeiXLo92FSgDgrfKJz8Hag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EbCqTik8_coSKWTNIqBXwTHO8_AuNxY7K5fBHSyqGKw&oe=6A008056"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1zbTkWAS_AQ7kNvwEO_6mj&_nc_oc=AdrukZEQxcb8fAEB2EsR2ZZKJmLdgcgY7Qc-Vft-PxhXQp7k6316QgwI9TS479csl5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UAiR3TPWG0mCXHNKxzMZ_lGIHqG9iIWXAOW84n9Hadw&oe=6A00810C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV4UVMRYH4MQ7kNvwFKY2AE&_nc_oc=AdoOv2M_IFucGDR_e1Z5Ivy05m3sUPBEokoc-eJHY_GmEpYKj-cd9EWiEuTNtCPytT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
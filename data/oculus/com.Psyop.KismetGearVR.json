.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0kL4ff_zMYQ7kNvwEQJEtd&_nc_oc=AdosTuhh5lQbpjyZ6PLTahoa0IRu6AxzlZTQojhYb1k3nPRnF0DG5w5XHMIJPOKm__g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANBLKwt4Br_1QIJy-P1Q_NgddC8HQwv8wYPCVsWlCbyw&oe=6A68C53B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR-zfhu2pQkQ7kNvwGoBQqY&_nc_oc=AdodpQXyB_-hNzsPWNl1BwRJqphXVnahStd4q3N6-hq1iGkGjiM2LJg0lG9c_q6pw4M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZMZu9RhHxFoUynEBU0yGOxf-f3g09a1GfXcl_k_yl9A&oe=6A68B93B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZsRhmAcs48Q7kNvwEWjYal&_nc_oc=AdrgjbqYZGFDiKAuG_u4MgL_zRbM4eALXfCTvrM69U3aKpPzyZhxTpcH7RFLQb8ssl8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF4TKm4Z_2UO9rVZoDuw8vH3jtb7pFfuYa81xlezgEew&oe=6A68A6D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACQXLW2auqUQ7kNvwGxCPCE&_nc_oc=AdqxpO3iha_I_O4cLOMl4s9eQ5D5P65QRvn6Zlv9trlEvfdIH3we1LR8h8i2sZZSMaI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRSWOdw9c_7avaZBUGMD_Cpf4-QSosf0H2BuLvkwaG0g&oe=6A68A78C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnySLgoa1nIQ7kNvwGfK-U0&_nc_oc=AdrrD7jBCYSYTl6t4roSU8dgi227U60kK8mZrtpOUX_GNXfqWt3doNeEf7G5Ei7kmjI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_
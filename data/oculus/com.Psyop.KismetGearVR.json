.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-PSBIS1R68Q7kNvwHA2Fbb&_nc_oc=AdqCGkFG7rsyvHqjuL7x_5MQlF1rtLKZXdhjQtTs9CYwkEo5MJ9oV9JDNYvyr6qG73w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9gJLzGHLwCQWW_8-jyM8xLG6sFHtq09ri-TJPq7TZaw&oe=6AE0BDBB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymdCsgBzawMQ7kNvwFrbugK&_nc_oc=AdpLIxL9BOG0alkqvWBbv_17nc_RLIfltHenqIP_TwkLPYk-KeTTNwC1-eOXlibZszg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMawxs6XfoEn2HvevGBfUvXnmD57f5uEGGRlpHim172Zw&oe=6AE0B1BB"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woYAOqxcF58Q7kNvwFVW4y8&_nc_oc=AdrPvKQvQEcB3jT4-aG5RrlOqpeL9316p1CvqScXsEEtrqwkps1lRVI23HxG5f9nhRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC_ee0k9pooTjQPMl5IG1lBWj0IAHaROSt-odQNgAU6Q&oe=6AE09F56"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZfE82bGzMUQ7kNvwHWOY0Y&_nc_oc=AdofKSfYtItI7jnnNy4wXLOGhYMyf2aXldJprQycpc1ojGLClvUdi4olCx0kq_BBA_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWW-0xoDfUExOns4-xW6vCxzt9lhVosGCB86AZtn9B6Q&oe=6AE0A00C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOg8RoKb3i8Q7kNvwFK5mmH&_nc_oc=AdrJShZMz5au0B9r60iIWTeQn6sAZSJwW81R7pn5bgJE5_UGpS18_xHJhXWD3iDGhOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_
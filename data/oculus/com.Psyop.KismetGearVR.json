.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSG1t_aNyo8Q7kNvwEJrYR9&_nc_oc=AdrlrUji6oLCTSs-y4BPeMZUOUGKdb8gSIuojMh-sQF8Gi-Voo9mS9_5W-jQ2zoLmpE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--lot8x3FSJ3xW8yAKDQ8IbqfmQGhKuCzouwizFGHn-w&oe=6A26DA3B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SybqXgIBJfQQ7kNvwGR1KdM&_nc_oc=Adp30u3yhIr56I2aU0ftuupw27nb4aVd3K2pxcmDyAqRR5FYJCtfVDOzwCGqbQRj534&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oSSiolzHeGsHLHOrTFXcnYVxKekf00bfuOHsxKFuOtw&oe=6A26CE3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnTdZn2bwq4Q7kNvwGuJYLA&_nc_oc=Adp-q1iBXTrKbTys_RMtiJqzqj7jQSf3WjtIPghuZ8oHNs7jk8fj8bIMb-hBP_8IYcg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FOCRvYDq8uI6noXxM0xls8iO7ld4KzMQgejGlukX_DA&oe=6A26BBD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0MCE8QWcx8Q7kNvwEIFcNN&_nc_oc=Ado-b1g0jFVICQjyf5977-B7S7JqG1-EA1Dn7BQUFiHJS4ypmpz6WBr9nUqQT6HyqHI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Byqh3-C_6JA_unErh-oUwrVHZAT3cifjFAIJ5PcLmAA&oe=6A26BC8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Txzgb3PDHbwQ7kNvwFLKH86&_nc_oc=AdoyG_kI_ncDQQtzO8ovBKSGW26YgjSlBT6GuOzanEo8qti4B54k1BZKAx5P87VPVZ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx3t9cbjnz0Q7kNvwHJKlL3&_nc_oc=AdoNBDj7aRTR-czRmpgFM2WR_ynK6JIwyhfT8d9iLbHgPSOcG4S72X8-VsBMlzIx6U8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKJKUKR6GBilOR-0buX_Vb8aE3FP6Hz7VhgrDGpyBp0g&oe=6A9721FB"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzidMM3cnp4Q7kNvwE_iJhw&_nc_oc=AdoAAM8ukesxb0Yo3Wi_VaEuezeu8FypgWLO2u_zuRxTckEES_Y5zinPo-eiI0z7B5Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-gci5V6YTp2zGM0w6xwGIHb7V1XHf-9dDwqKw4KNCEA&oe=6A974E3B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rx6MHVSzxJ4Q7kNvwHuDUOr&_nc_oc=AdrPm6QHG--Y9KZt4k3gl899vX0Wlji55go5n-LUrdCmVF2DX1x7PABZXk5TlfpBT00&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJyWMu8hwbpknpchk27zqH3OW9UaiDrCe9Q57shGM-jA&oe=6A973BD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FawbyQDhW8Q7kNvwFMT0UV&_nc_oc=Ado-AZVc-09LxaDlzZxFO4_o03jS_EeHO8oRlcqIAx9tLMnhB1xcDIDwPfK-wzBZMIw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8eto5rSTXsltqNaJU3PznLPuhwVlG1Fhu0Ojp0mxmAA&oe=6A973C8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7jzQIGVQFIQ7kNvwE0OLfc&_nc_oc=AdpHP7Vh9zSwpB1DGLh9G45rvVrjSExsc9UlKpzdJqPa_scs7FbXPb_kI3hHVUMb6TA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_
.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkqIKPxw0MQQ7kNvwGa_Jl6&_nc_oc=Adp2X3FuOl5jkpYcbztTXtAyah5dRzIEZbSKyGDBuQNzzXGAyDetZP_DH7Mvx4nbEt8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zq84K6Q_g65D2QFIVD-_O7cvmjY4bpaSWISlh4Nm9Kg&oe=69E24C3B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z-0rePHGhYQ7kNvwEZC-W-&_nc_oc=Adr4UvZ0t_3LvGrhMNHtPSokluSRkiQLDr0MBy13sDC4dAeFQJ5nra_Yq0FBI9yw-6I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Di7-Q71o-UXOaZNNDTXmqj8p1kQxDWRXqitEuTbuMgg&oe=69E2403B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwC7T2JioW8Q7kNvwHKGC6L&_nc_oc=AdpguQWDeFlzc8CiNac_QvM9hHgbgsW7MxmZyBA4zzI5_cq_QU9wgsj2rvh_RMkYMHU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AkHI6jH_MVJo8UEYwVTToQyZOXt6W9xu59JoJELOvnQ&oe=69E22DD6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHTJKgts-aYQ7kNvwGXzv2A&_nc_oc=AdpeTj2kLxBRqdn0NipSl3tR8F7oDDICsAjeRnFEGODWMbwryk8PiO9jo0yPXcjciRk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10DL88tYiWo3-4TpJ3koW0FVJcGUe9Y6MvkQy556UUVA&oe=69E22E8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2oVto7WFNgQ7kNvwGYGd2M&_nc_oc=AdrpOVi8Bhnl21DAesQ9CcC5ClcT1Q4JA8i38xLKHCPYs6ej-0Rk7Iwr4tGFfBTvU8c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_
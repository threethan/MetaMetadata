.oculuscdn.com/v/t64.5771-25/11162698_1863651707193045_7110219372416729088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ezop9Kn-cw0Q7kNvwE6DC90&_nc_oc=AdoEvHj8UrSMEooZ3kl0uzkMYpXdRRBPNT2h75tDZ_7lVzaji9MpCTHLcN5n9gTHxp8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x5Oy0n38KAZ-Z8sAiikfHG79dF4Kcwkt3aaWuu-v3CA&oe=6A21943B"}, {"file_name": "migrated_image.png", "id": "644088326413119", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162706_626089987589970_7996116365024952320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCVejQKd_UwQ7kNvwH1hcDX&_nc_oc=AdoKIVWjoOYyVgTjhQgUrsYyTWaovFxVrnLvaLBj6ULegKNq7UWSKY3HB2jE_jDhg9w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JUUCgmI-eqIgswzdEPGrBH6SWwzc8ew_Q_FKm9AEKew&oe=6A21883B"}, {"file_name": "migrated_image.png", "id": "251592735853170", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162679_131355520749874_300544837663326208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LGl1zeAMHQQ7kNvwFFU6V7&_nc_oc=AdoplSPxN6MXdHx9tHQ-J9dqrqKvNCHfbXZ3HezOTk9owuCulUMEW0OrWkEenyckSFg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gQUbfUWk_oi55WITvPn2O_kUaHomnHaLp1Z4edJ3tQg&oe=6A2175D6"}, {"file_name": "migrated_image.png", "id": "245821116575741", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162681_1359113674180123_2380436781439909888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIASDSKYGBgQ7kNvwFyWJo5&_nc_oc=Adom3tDbWJCJ34xxo1fF5aLDx41r8anY2_n5Ci9F6Whzc28gRyOqOh3ImSesPhSjx8M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4bBRFj0Si0lYRu830aaXjo8yavGEO3sdGJewtTctKew&oe=6A21768C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kismet", "keywords": ["fortune", "psychic", "astrology", "horoscope", "tarot"], "long_description": "Would you like to know what the future holds in store for you? Developed by award-winning creative studio Psyop, Kismet is a collection of three activities, including a past-present-future Tarot Card reading (the Cards), daily Astrology session (the Stars), and ancient board game, Ur (a game of Wit). Kismet is meant to be experienced daily, with unique outcomes every calendar day that are directly tied to not only the cards that you choose, but your individual birth date and the actual alignment of celestial bodies at the time of your reading. Named after the mysterious character at its core, Kismet is inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, Gothic style.", "short_description": "Kismet is a VR fortune-teller experience inspired by the mystic arts of tarot and astrology, brought to life in a beautifully detailed, handmade, gothic style."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kismetvr.com/privacy-policy", "developer_terms_of_service_url": "http://kismetvr.com/privacy-policy", "publisher_name": "Psyop", "support_website_url": null, "website_url": "https://www.kismetvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "664482911357020"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162722_1436543903034054_3033125631219990528_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvq15kHCV1AQ7kNvwFJzraZ&_nc_oc=AdpfR3_nf0PIGsb78EIFTzr3jq0uQClCGdTDyXWb1wxjKY-OZyEVICaMikruehBuJyg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_
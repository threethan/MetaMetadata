298_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbpZU0iVQ4cQ7kNvwEs1A30&_nc_oc=AdpNPP8XwujdZw3vJtozNLuF7AT392eVUZOMvEIXCFZLXEZ6dqILVFmAYjb6hSmsUKg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI2x0zmRPJsZfBNXKcF-ANKT1eWD4EbkgbWSQ-Cz0wPw&oe=6A6F2EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Newton's Room 3.png", "id": "1754689668345765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982588_1754689671679098_5813107245504553079_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZPrR-yLlgQQ7kNvwGCG_w1&_nc_oc=Adp2kmg_AwooBA-RYJysrX2yM1Kx74EqO8Y8fJ6hOIxkkMmxgjvtP5-JQtRHbJmpvlU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWY7RwmUIH-jkYaysesfrko-HLev2gJBvX19ZWzIE2nA&oe=6A6F4C19"}, "display_name": "Newton's Room", "keywords": [], "long_description": "Newton\u2019s Room is a mixed reality physics education experience where users apply Newton's laws of physics to solve challenging puzzles that adapt and respond to their physical environment.\n\nThe completion of each puzzle requires not only a conceptual understanding of these principles, but also the ability to creatively apply them in diverse scenarios.\n\nThe interactive and problem solving nature of the app encourages experiential learning, fostering a deep and intuitive understanding of Newtonian physics.", "short_description": "Newton's Room is a mixed reality physics education experience, where users have to apply Newton's laws of physics to solve challenging puzzles.\n"}]}, "developer_name": "Treeview Studio", "developer_privacy_policy_url": "https://treeview.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Treeview Studio", "support_website_url": "https://treeview.studio/newtons-room", "website_url": "https://treeview.studio/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "10431
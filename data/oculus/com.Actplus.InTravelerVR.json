0LufHcQ7kNvwGhEk2m&_nc_oc=AdkeoqNjfBTlmaHdN8OnlebLt0FW_tjocPbztMyMsjv3Ijz_q825ITrpxF0ZXTUgSAs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuReWQsc6zl7VUVbkySfvHcmw1wqnzp-RasIT6NLFtB1g&oe=69A5936C"}, {"file_name": "8 - Screenshots 5.png", "id": "370328769349564", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974756_370328772682897_2472159522260645793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9K97Cd4VU8Q7kNvwGVFdZb&_nc_oc=AdmmWLvkyGv3wzpWnBjjCFQ3PLF44auGn0sDlPhxXbl9afNg0WUdqngGV83xsKLh4-E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvo5sJIgoh88V16RbEXTgKW6RXa2_v8b2mO-yWV71sNMw&oe=69A580E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InTraveler VR", "keywords": ["Detective", "Intraveler", "Milo", "Mental", "Wellness"], "long_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\n\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape.\n\n**2 Game modes**\n\nStory mode \u2013 Experience the story of Intraveler VR.\n\nArcade mode \u2013 Choose and play chapter-specific minigames of your choice.\n", "short_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape."}, {"images": {"nodes": [{"file_name": "7 - PDP Art (product details page).png", "id": "8086078954778417", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031578_8086078958111750_6065740976657399250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yD74pyuwCUQ7kNvwHieSJd&_nc_oc=AdksUsTtwO_AFT3tI1fV2MIWAmUjrzg2yD5hemmEziIO-R9h9HWgGatPiku0caZz1T8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv9IFJ1bp9Fr0ryE4iu7PXZK2uxbObQ595RBCXJ4OE7zA&oe=69A56D50"}, {"file_name": "5 - Cover Art \u2013 Portrait.png", "id": "1196994604748735", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031639_1196994608082068_1180372112004557971_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tEWPpgavSoQ7kNvwHZc8eO&_nc_oc=AdluRMRNIu6pRxHt54josurBe-Wi7iBKbhz3y82dgBIERgo-hrM_are7SAE-En0JzpA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu0-cUOw4-I5U5Fxw1o_aWSqZshQfloIMoUBXzfQVgIWg&oe=69A58D0E"}, {"file_name": "3 - Cover Art \u2013 Landscape.png", "id": "1196806104922163", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_1196806108255496_4600979568657765668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cp6gD2tiM4Q7kNvwGyeK_U&_nc_oc=Adl3FyUD4glHGTBG7LagZr54FekJBYsjZ6QjPfD8vx12hQ6xRzsQYBzbTlR28L9JAo4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftFXrGuG0Swq5pVEq05tpu8YFD3FJOg0WwpXxdCYlTvaw&oe=69A59BCD"}, {"file_name": "2 - Icon 3.png", "id": "1037645074405423", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036671_1037645081072089_7472962019283868741_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcL1N8VUfT0Q7kNvwEa5YJV&_nc_oc=AdkmmdCjIk5KV7ju--dbX_eCdgHJFj7U-BrPzTI_2uGWy-QN5dnjkzgooqYBTnM-OOM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv2QSdTLHO1Ccf5Y5S50-h25N2BY_gKBTawyOLQ3hDM4Q&oe=69A587C8"}, {"file_name": "4 - Cover Art \u20
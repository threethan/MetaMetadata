dPZv-AQ7kNvwGVvqKw&_nc_oc=AdmlON8ODabCNKm-inuxOx-vsVgNXmkkIzZ1lHBM84JlNWi9m3ccqIGHdAcCgfchRw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftYTtQDnm_DBQErPGYCPIfdYrCZ02qTeZKKqm6LS757YQ&oe=69A441EC"}, {"file_name": "8 - Screenshots 5.png", "id": "370328769349564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974756_370328772682897_2472159522260645793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9K97Cd4VU8Q7kNvwF0SJXz&_nc_oc=AdlcztXsRmEOAZBBnybgVhFT7uXhu5cMpcJsC_oMvY0jzVjIUm302KCjcaigC6MuvGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftIBQnIxHkDn4x3Ub0JqHIlqmJz70CYiIVJR1tdAGdaeQ&oe=69A42F67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InTraveler VR", "keywords": ["Detective", "Intraveler", "Milo", "Mental", "Wellness"], "long_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\n\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape.\n\n**2 Game modes**\n\nStory mode \u2013 Experience the story of Intraveler VR.\n\nArcade mode \u2013 Choose and play chapter-specific minigames of your choice.\n", "short_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape."}, {"images": {"nodes": [{"file_name": "7 - PDP Art (product details page).png", "id": "8086078954778417", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031578_8086078958111750_6065740976657399250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4zq2rD9kYoQ7kNvwFs9zZd&_nc_oc=Adk6BkPOBytHieWAWkND2RDJIDhy4AcFWrt4a8eNNPCwE2o1zeIR2isVU2zKKeUVQc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvP_SYbqOs_m1TU1n9r_8gQWMr4clIfNOg435peJZmZDA&oe=69A41BD0"}, {"file_name": "5 - Cover Art \u2013 Portrait.png", "id": "1196994604748735", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031639_1196994608082068_1180372112004557971_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tEWPpgavSoQ7kNvwEbZ1Rv&_nc_oc=Adm18QbCY-R0vNA4TlyBS8Bfqn27Bn38tWARKx6Sh_yDIpH-U7CuIXpG8i-qPGa5_00&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu5THqRBi_sDLWlNoo3Dnb3lX0_sR-A4jGgBqu_QhJYKA&oe=69A43B8E"}, {"file_name": "3 - Cover Art \u2013 Landscape.png", "id": "1196806104922163", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982510_1196806108255496_4600979568657765668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cp6gD2tiM4Q7kNvwEDZKGp&_nc_oc=AdnOtUpRxvxSI11tAd75hNoEMN8XEmXwHt_R1IRpdBkz9T6xXJ0D3FYJldU_rBlwIII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftBGSRU5stv2YBwgM-TzSFq4CTJiyAieiZNEyNiVaedZg&oe=69A44A4D"}, {"file_name": "2 - Icon 3.png", "id": "1037645074405423", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036671_1037645081072089_7472962019283868741_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcL1N8VUfT0Q7kNvwEOr_3A&_nc_oc=AdnuRaaPdNrf-EZUBLJoxlyaMLvtTyQbTnL55ueMgfdQkT_iP-RI0TK8P9oRMUmO1xA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsfPDgGAt5WKVr-CBls8Pq1M0fLDm4-6UYqXiVDCAlsbw&oe=69A43648"}, {"file_name": "4 - Cover Art \u20
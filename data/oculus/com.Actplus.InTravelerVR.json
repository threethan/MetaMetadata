culuscdn.com/v/t64.5771-25/38974862_3950716541917525_3547774517994781167_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAHTQgeJMqUQ7kNvwGbHhGG&_nc_oc=Adp34vnUoAdf07XOn5Y8ATTuLCqKfNoowM4pphN3xIv7uIc1PbIYcZUGZL0vgBmVJe4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rctSebFBBwenFfQ7LyTYa_jkjSudLjcc-m2Ecr0X_uQ&oe=6A22D1EC"}, {"file_name": "8 - Screenshots 5.png", "id": "370328769349564", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974756_370328772682897_2472159522260645793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKnLxXxnrD0Q7kNvwFxo40f&_nc_oc=AdokhhCXPLzJbs6sKhjZCUD-_2e3glvGXbF0Fxd9dFEiG0MdUi0iXRq9EvT2fxCiMDE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H7MV9zdFuFK-c3ZKldfVDbsSTN2s952TumEUCzc_LVA&oe=6A22F7A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InTraveler VR", "keywords": ["Detective", "Intraveler", "Milo", "Mental", "Wellness"], "long_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\n\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape.\n\n**2 Game modes**\n\nStory mode \u2013 Experience the story of Intraveler VR.\n\nArcade mode \u2013 Choose and play chapter-specific minigames of your choice.\n", "short_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape."}, {"images": {"nodes": [{"file_name": "7 - PDP Art (product details page).png", "id": "8086078954778417", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031578_8086078958111750_6065740976657399250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3TeEToeX_YQ7kNvwHHQN0U&_nc_oc=AdraxeYbK0M0jBVH8lAJhW4LZwYGqFFD5vlngxwnxPINkGJRurqcTakBCNqJeq65AIg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dH_fTwH8yMa4WuKCH5Il0VdyCy-y5N8XunU8nvki-Jg&oe=6A22E410"}, {"file_name": "5 - Cover Art \u2013 Portrait.png", "id": "1196994604748735", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031639_1196994608082068_1180372112004557971_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFYs5vSQKDwQ7kNvwFS4Bkz&_nc_oc=Adqv6mkKY4dl8xK6slhS9ySluvbsYONMHxFSFDNHYocnwykqg70xAYdIhHRGxZO5ZoE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9adQ2N3O3nNhZh6rDJlqXpbEdt0tidx-E-CBjFSxld8A&oe=6A22CB8E"}, {"file_name": "3 - Cover Art \u2013 Landscape.png", "id": "1196806104922163", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982510_1196806108255496_4600979568657765668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8NxeBGreCgQ7kNvwG6_rY6&_nc_oc=AdoGp0nhZV8F_smXDYfNLTYeQh9NnYjvdAKKjEXslhVx4pJjYnnpqCtbPQfiJ317QQs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83XAOCCwaw3kuT6L9A88ISgNfoNjJmfamQIPO2cR3VQQ&oe=6A22DA4D"}, {"file_name": "2 - Icon 3.png", "id": "1037645074405423", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036671_1037645081072089_7472962019283868741_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fz0QhH7y3cQ7kNvwEzXBol&_nc_oc=AdrW49ksM88zhZUxs_o
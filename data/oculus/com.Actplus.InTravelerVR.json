C8FD99"}, {"file_name": "8 - Screenshots 4.png", "id": "3950716538584192", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974862_3950716541917525_3547774517994781167_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uezQ8U6u6UQ7kNvwFmfzgW&_nc_oc=AdrzFix9po0Ta6YYE_uXHqIz1TF3_kcC8FSv0bk5db14jh9jnxr1fCX1sbJA3IRXq80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgYNmdkrp4VnBUVxUj2ovY8S7Mn3ErbtKXPGl7kbuxag&oe=6AC8EEEC"}, {"file_name": "8 - Screenshots 5.png", "id": "370328769349564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974756_370328772682897_2472159522260645793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLKjjO1dFDEQ7kNvwF3tFaS&_nc_oc=Adpm61_KnsVH0cSgcPg5XMOyluREJcCo9YtetFsGs4Hwi9FH73kzmXMOW30kpWpUBr8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGY9Kk-F2gkJesihKtrU_KI9ONgRa1xNenBnpovSCU7g&oe=6AC914A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InTraveler VR", "keywords": ["Detective", "Intraveler", "Milo", "Mental", "Wellness"], "long_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\n\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape.\n\n**2 Game modes**\n\nStory mode \u2013 Experience the story of Intraveler VR.\n\nArcade mode \u2013 Choose and play chapter-specific minigames of your choice.\n", "short_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing
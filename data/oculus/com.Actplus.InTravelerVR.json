F08A99"}, {"file_name": "8 - Screenshots 4.png", "id": "3950716538584192", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974862_3950716541917525_3547774517994781167_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83PZaQHfnhUQ7kNvwEBoRE-&_nc_oc=AdpTYjf-NkV_4gKC4ybpmIGxpTFRi5tPSnGly3hbqvWJcosOnnt9CyJwD3jCnxDGzwo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGC6v0El7HsKysQznyuCQGALiZXmO63fHo1dI2E9-PkA&oe=6AF0B42C"}, {"file_name": "8 - Screenshots 5.png", "id": "370328769349564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974756_370328772682897_2472159522260645793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_nswp1RUBMQ7kNvwG3ki_p&_nc_oc=Adqnn26fwj9OKzyGT3-6U6g87kDD23aKDOf6fT2ZRNcBfg0lMIMI5n_uUGY4YhH5a_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2nVRO2WjDBLLkYlQAC2rELSgxYpwUINinWjyk5EGT4g&oe=6AF0A1A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InTraveler VR", "keywords": ["Detective", "Intraveler", "Milo", "Mental", "Wellness"], "long_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\n\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape.\n\n**2 Game modes**\n\nStory mode \u2013 Experience the story of Intraveler VR.\n\nArcade mode \u2013 Choose and play chapter-specific minigames of your choice.\n", "short_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing
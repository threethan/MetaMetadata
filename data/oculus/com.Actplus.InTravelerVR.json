B7DA19"}, {"file_name": "8 - Screenshots 4.png", "id": "3950716538584192", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974862_3950716541917525_3547774517994781167_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDBmI7LNkcAQ7kNvwEHoBGo&_nc_oc=Adqvpo-qi8fVjLGy9cCruwOqL6tqDTYF8clRXyO1BQK0yNmbKl-jEzEOd4ihaUML7wA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbHWOBP7jzkebdGVUdeY7wSd8yHkEqf6C_lgTAJZ4ffQ&oe=6AB7CB6C"}, {"file_name": "8 - Screenshots 5.png", "id": "370328769349564", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974756_370328772682897_2472159522260645793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tJlUODjlCEQ7kNvwHemAC9&_nc_oc=Adrg5xU8Tz4T4z_hWEd5Sy1XWX1vzk5zRQmwpd5a7E0sIdPFhW8qU_wPVOf9E706rXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkYg8c9NlUPiTrmWbJpwushJrttFpH8Av8_Rw-vb7vNA&oe=6AB7B8E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InTraveler VR", "keywords": ["Detective", "Intraveler", "Milo", "Mental", "Wellness"], "long_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\n\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape.\n\n**2 Game modes**\n\nStory mode \u2013 Experience the story of Intraveler VR.\n\nArcade mode \u2013 Choose and play chapter-specific minigames of your choice.\n", "short_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing
DF6719"}, {"file_name": "8 - Screenshots 4.png", "id": "3950716538584192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974862_3950716541917525_3547774517994781167_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLn7wkv00x8Q7kNvwG37V8P&_nc_oc=AdpXULnkMf6YBawuCxLoO-bMQgltKNPWEFGbMMVVkvvu0wIyFoX9O2ZxDMuaQ2cX0lk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNujSwoMq5QijtZh_CRpBt_fH3CBtweVzwizo9tLaJX8A&oe=6ADF586C"}, {"file_name": "8 - Screenshots 5.png", "id": "370328769349564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974756_370328772682897_2472159522260645793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EqBL49Cr2gQ7kNvwGVT0pN&_nc_oc=AdpdDbnT4hSAfdD9Yikazy5wGA6l4T_6OQ-ca3WYU5f9L0kMwQ5hKNxXa9Y9Hq2BW30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpqC3vjp8qoX-QLicM4J5VuV27qFrGeTdio-S9ANTgbg&oe=6ADF45E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InTraveler VR", "keywords": ["Detective", "Intraveler", "Milo", "Mental", "Wellness"], "long_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\n\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape.\n\n**2 Game modes**\n\nStory mode \u2013 Experience the story of Intraveler VR.\n\nArcade mode \u2013 Choose and play chapter-specific minigames of your choice.\n", "short_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.actplusstudio.hk/intravelervrpolicy", "developer_terms_of_service_url": null, "publisher_name": "Act Plus Education Foundation Limited", "support_website_url": null, "website_url": "https://www.actplusstudio.hk/intravelervr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_HK"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26628291566786060"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1488098285174474"}]}, "baseline_offer": {"id": "1488098285174474"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728860400, "status": "PUBLISHED", "id": "1488098285174474"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27155949860686892", "version": "1"}, "id": "2317662988573525", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26628291556786061", "is_concept": false, "latest_released_binary": {"__
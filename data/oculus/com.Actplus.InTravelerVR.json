ow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.actplusstudio.hk/intravelervrpolicy", "developer_terms_of_service_url": null, "publisher_name": "Act Plus Education Foundation Limited", "support_website_url": null, "website_url": "https://www.actplusstudio.hk/intravelervr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_HK"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26628291566786060"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1488098285174474"}]}, "baseline_offer": {"id": "1488098285174474"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1728860400, "status": "PUBLISHED", "id": "1488098285174474"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27155949860686892", "version": "1"}, "id": "2317662988573525", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26628291556786061", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27155949860686892"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2317
uluscdn.com&oh=00_Afvvo-ZCXF-RLiNmHFvWUA8Y03Qr2VM8IkWhrKOpFK34bw&oe=699EFBEC"}, {"file_name": "8 - Screenshots 5.png", "id": "370328769349564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974756_370328772682897_2472159522260645793_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvax9xGxij4Q7kNvwEzXX4v&_nc_oc=Adl9TP_YcoLgB7gN6g_ev5P3L7CJ8XX0MyuJBtu9rXhrwvnndF9Kki9oBnbXd1hDmws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvb8pbtAS9wSk6hsn4nJYuLaGI0181OGqvmaZEDsRh0HA&oe=699EE967"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InTraveler VR", "keywords": ["Detective", "Intraveler", "Milo", "Mental", "Wellness"], "long_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\n\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape.\n\n**2 Game modes**\n\nStory mode \u2013 Experience the story of Intraveler VR.\n\nArcade mode \u2013 Choose and play chapter-specific minigames of your choice.\n", "short_description": "InTraveler VR is a story-driven adventure game set in mind-bending worlds inside the minds of people suffering from mental weaknesses. Experiencing a new dimension of worlds from their perspectives, solving intriguing puzzles as you traverse their story.\nGuided by an InTraveler, detective Milo, to travel through Inner worlds saving those trapped inside their own worlds. Follow in Milo\u2019s footsteps as you discover clues and secrets of each unique character, untangle the mystery of one\u2019s mindscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.actplusstudio.hk/int
ich narrative full of mystery and intrigue. Are you ready to swing into action and leave your mark in the ultimate quest for glory and riches? Join the chase in \"Ape Chase\" today!", "short_description": "The hub for all gorilla movement games, horror, shop, fanart, forest, and many more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e0ZbCo8fEwMVjxsy-88dXX3HfZIu6Ix6eg7LQvZ2Nh4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://sites.google.com/view/ape-chase-vr/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8809759299041149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75287554_399087733147782_5631979305936320268_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G85pZ_iepnAQ7kNvwHt4884&_nc_oc=Adn6VQjIJltpz_HMAQW0OcFp9IownA6hei5tffkF7M3fgao4hrwYRZP56jo0R1Kjtkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftsG7HPwvIlfbC_jKQ8f2R4zs0QYjdqTTd8XGeKYl2dXg&oe=699EF666"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Chase", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
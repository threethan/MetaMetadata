ewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1198398913538154"}]}, "id": "1742294562652098"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "909363252496352"}]}, "id": "780948728672229"}]}}, "firstRevision": {"nodes": [{"application": {"id": "4504829629531931", "release_date": 1623436079, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7630703796944483"}, "id": "459203705156984"}]}}, "binary": null, "live_binary": null, "created_date": 1721363088, "id": "8657545364260316", "is_initial_release": false, "name_with_fallback": "v5", "pdp_metadata_with_fallback": {"version": 5, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "8657547910926728"}, "release_status": "RELEASED", "id": "4504829629531931"}, "id": "8657547910926728", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4504829629531931", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2965859823696457"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1442404123134174", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2076 Midway Multiverse", "keywords": [], "long_description": "LA SIMULACI\u00d3N DE COMBATE ESPACIAL DEFINITIVA\nRindiendo homenaje a los cl\u00e1sicos shooters de scroll lateral, \u201c2076: Midway Multiverse\u201d ofrece la experiencia de simulaci\u00f3n de combate espacial definitiva. Ponte a los mando de tu nave y enfr\u00e9ntate a oleadas de enemigos que te atacar\u00e1n -literalmente- desde todos los \u00e1ngulos posibles. Saca el m\u00e1ximo rendimiento a tu dispositivo de Realidad Virtual y explora los lugares m\u00e1s rec\u00f3nditos del multiverso mientras tratas de liberar a la galaxia de la tiran\u00eda del Imperio Gal\u00e1ctico Nazi.\n\nEl dr. Novichiva necesita nuestra ayuda. El multiverso entero necesita nuestra ayuda. \u00bfLograremos derrotar de nuevo a la tiran\u00eda nazi y devolver la paz a las infinitas realidades cu\u00e1nticas? S\u00f3lo hay un modo de averiguarlo\u2026", "short_description": "2076: Midway Multiverse es un juego de naves con desplazamiento lateral donde manipulas el entorno gracias al uso innovador de la tecnolog\u00eda VR. \u00a1Toma el control de tu nave de combate espacial y derrota al Imperio Gal\u00e1ctico Nazi de una vez por todas!"}, {"images": {"nodes": [{"file_name": "1008-x1440.png", "id": "4228753940567977", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974883_4228753943901310_4759042325989418806_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMWlS4StujwQ7kNvwE-BUHs&_nc_oc=Adqxfea_UX3ZdicizMnRzKvkoIUcOua338AXzSmLWUQ1Zw7CmVyNi6oqSPJGKMZS3wI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx1n1g6N3LUEnygsSzmGFyxE5t0KFUVWMWkBlODtO7xw&oe=6AFB1D17"}, {"file_name": "1440x1440.png", "id": "3022734654647406", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75441579_3022734657980739_192850840054205928_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oa7k4bHzZB8Q7kNvwHDfk2l&_nc_oc=Adrb60WXzoPVAtedHPW9gRtww7T8MpTA-nB1YjtvCRkZh3qmUefgJSHM0q1hhPhGSIQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj6i4JbFJ7g9euc-Wud8SlT0_W-6watarqCf3AH39y4w&oe=6AFB3A3A"}, {"file_name": "logo_2076_OCULUS.png", "id": "511804356807916", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscd
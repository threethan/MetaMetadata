7GtPyimQUywyovecqFr1oXlkYWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLnwLbeT6HqSpXBiYS3fMsdz9s7wtBIVPKSh0wHtEC-w&oe=6B09B175"}, {"file_name": "Screen3.png", "id": "245055157078949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNirXVHp0YsQ7kNvwEA8rLh&_nc_oc=Adpf4KcP8RZa79RxklxfHwxWi4vneIXsjP-7bX6gg7dL9a-fmZdE9x-pXxiomx1UE5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTjtRJjS3xJlCcEw0qNH1AAaMwrKRyzFci1NI-YPfF4g&oe=6B09AC9D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7zeZ58KD6MQ7kNvwHZz9CH&_nc_oc=AdojLV2WQbaBYRmiIQ9Ly6o0w7yjRXkcpAe5fQyLjm_o-Sj5Og_4C4uHyUhWsAA-llY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdssGiOuH3Xp9DqkVgumKjWJI3J3KbRzXGG-mDltTaGQ&oe=6B09AA80"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oXhQBZ1wscQ7kNvwGo87n9&_nc_oc=Adqf0WsWrRvkrC-eMb-jngNsfv0YHGT5pTGuD3-pdlVO8QP1dGqg4MeK9HUnVSGM4T0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqWChQyTdyB8OOIQynn7bFlK-mCJYrF5lTHN54DEet1w&oe=6B09C897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftCIkslJ83YQ7kNvwF0MU0c&_nc_oc=Ado7eArYfcUtTiyvPqqX5VWCjnycLw2xkcj27V7wwoiET_SxLiXl0wZiONWw0SGHHPs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStl6S9be9SJcqJ5gojDOpn2SshUPlxpO6qpblKRzgUFg&oe=6B09B384"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
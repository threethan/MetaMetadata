.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6fkaPXwo5IQ7kNvwFl1Bw2&_nc_oc=AdqZAidU9_mrtGurvr_cnB8cxtjJpOnYmpj1d2j5L0-pZq3mEtvz0JJL3NPBeZrtSe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XiKvZPjUnuDQMpBJIjCEhHanTS2cpoShaipA7eprxfg&oe=69FB30DD"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI9yQfXLQ50Q7kNvwE9dHpC&_nc_oc=AdrjlLH3CqQ5N2FGZh1CuaDCM6D7dJNmLRxjwcW4TzvsyAqiBxu6sg4MBUf5Z2biu4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lWsj1f0SiRyFepUPFnWrasVmLJzJX4GyaHTBIRFsurA&oe=69FB2EC0"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRtAW0_NM-kQ7kNvwE1gJaP&_nc_oc=Adr3K3O8PE6V1bK3815Z6IDfY3aoB6nnBk_75D-3q7DaSwL3DCooVhhPZdb3ZEr5PDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Sp7ZY_8hydz2nzStld5BkF9o56gCB3PQav3Bsa_X2Zg&oe=69FB4CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjaoOSqVn1sQ7kNvwGGBG7T&_nc_oc=Adr08TBkxClo_ZlDMfp6o7af5zoScBkuJckOLcwISWFZmBx-UHWBW3vnHCdGM5QIQco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bfqQEC66NJm3qcRZscjHqITfIYOTyOQCoeahEFyK45w&oe=69FB37C4"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1278083746045938"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1899801092
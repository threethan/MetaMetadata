VSP3MHVOWfVeqUfdfTnMoW67ThY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHIW0iz6mI4-Q62NK_LWVflOuX0tQAoDIBQTntSdvccw&oe=6B070E75"}, {"file_name": "Screen3.png", "id": "245055157078949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNirXVHp0YsQ7kNvwHIY23y&_nc_oc=AdrHb-yAh6YRwTv2KeABcHnHNJWbJlH3hH5DRiSFnNwJ0jAuuC1wEwTyuu27ES-cuDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStzEF9AtO6yHOo8ICfwcKC48dv265KXKQup7bq_5qpoA&oe=6B07099D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7zeZ58KD6MQ7kNvwHfGOMA&_nc_oc=AdruyY22B01Ywq9jd5Q8eGjsGaVZxqtzlt-h8DGjiyC0wh-U4v9Hg8AslyJVHwsKQW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0kmjwWT2HgHI97sw3_Jp3ugmoMJfVuCGPkYVeSK-vgA&oe=6B070780"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG7UP0opxIcQ7kNvwFaUyww&_nc_oc=AdqRn0g1L_Rss2SJ4SjiD7yCE0EfQMhlnn7s09k5Jb128oSTF-NKBsfPeUUeU2DY_AE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlMtOGjSVGYkcCrxsaLQykpv9mrNwRV04W_hzh4oAWcQ&oe=6B072597"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM280yiXSvcQ7kNvwG5YK_I&_nc_oc=AdrM-ifbztaTNXSU-rfQyJ_D7deM0HjHdJIM4bFQ4VbW9RT670zMbODvB3b1FyZriL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjm6rq6ozpdfbMpGH_f2HMX7h92AX3P9_hrSEnlCZI1A&oe=6B071084"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
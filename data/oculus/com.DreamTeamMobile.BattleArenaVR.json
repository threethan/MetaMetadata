3067454866465_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo3zbTQwBv8Q7kNvwGIEKgx&_nc_oc=AdlZSI2t-X5b0UeUykWFd2UbSjDZnc6njZRjV7sEBnejfaLaFj0JSSjs6hTwbme5DJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftarSsqWlhzvRrg4ULPxGNQ4om67iX6Lin2n3DH1kNpEw&oe=69A8225D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL-tfnMfJicQ7kNvwGmSFIN&_nc_oc=Adm56LneGUpo1igXhf7cDxxGWp1NMRSYiwkispZdSl6SBYVcZArcEePia4-x0hYoSoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvjTsZqGdC-lCrDwDNWqef9XXoM6Q_zEoiH3i0hCQASoA&oe=69A82040"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YxZZ5iCcOgQ7kNvwGAow55&_nc_oc=AdmmJPZvhVhY5ihl8gM5cEVqiPo--XgdefTXMYmtUYQYzw8IgyvrhyfGz5jfSQvnY9Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfstkzYoK-3axO6lMRBd4COQP9IDms0rcf9r1sN6TlGT8w&oe=69A83E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92-PoM1dQdAQ7kNvwFPfJSn&_nc_oc=AdnVfj5qV95ce7bpeEXkJSkzR2R1oktUI9EjxKh070k83i6ns9E2gboPGOlm8dltX2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfttF02D_H_A9HS093u-YEQa5h_Sud6tr_HPc6t9u5Z1uA&oe=69A82944"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1278083746045938"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "189980109228521"}]}, "baseline_offer": {"id": "189980109228521"}, 
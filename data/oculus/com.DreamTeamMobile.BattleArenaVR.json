g4BhsZNZmVjBK7yB9atVALJEPlc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU84EPaonsKpBhOiEkYE1FA2bAvmk4aEJhw9zZbz9GXCA&oe=6B1048F5"}, {"file_name": "Screen3.png", "id": "245055157078949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_TO82Ep5bsQ7kNvwEfc97k&_nc_oc=AdpVHYhoRObfqIB9Zshr8OhNQLm_uuGEOnoPs2cCwx1SKGY6yvMFTo0qH4kAUnJaGhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgrsKn8GaHR5J_Ec7x3a-6JkYnwXwKY767MI5RxNHECw&oe=6B10441D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLiTxka7nioQ7kNvwGQRdfv&_nc_oc=AdrYVA7OpByfmfIRKBEt4iOalziYObTw6YgSQ75fidXgowIP--xft1yEZ-dZlY_i9Ys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVubv1-Cvljoeaur5NcmmAIaZxNBNFY7Sc1lK9qyp8T1g&oe=6B104200"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHkUTlMutcUQ7kNvwFkLYXR&_nc_oc=AdoeKgcljVnnV1kgL9W6vihboGSetiYXRNMpMWcdWARaFQYqoFQFM6IMVmE4rrL5330&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVN2G-baa9ytR3DHID11vdHRrtKOghWs64j9RzX50DAcQ&oe=6B106017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6VxFP1QGZ0Q7kNvwEkLzPq&_nc_oc=AdrsG7dvpH1L1tgEj0xDUmBNjBuiQwFQ1wPR5KTl7BkMr6FcTcxy208bnLULRAvh52o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXr-biWs3fTnU9DAbrWsFiwFOc2SamCclcjUJoqWa9aOA&oe=6B104B04"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
p9OHtj52EVm69QVAN1Q_FAierMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK0ZPrZjcNHLCl8ZpsY6_hYZ1h_2hrBGLdUoXDXp1hCw&oe=6AFC8275"}, {"file_name": "Screen3.png", "id": "245055157078949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBmTyqkks8MQ7kNvwE-t5un&_nc_oc=Adpn0eY_7JRmZ9Z-yANn6_CJRVCD2m3Hsl5Om95CcB5J89QbnBIdQP34dVBBMK8wtE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjxGKLNtnCDaQqUk3IhXwitSeiIRxcCqIB7r-3sbJvog&oe=6AFC7D9D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gCkNLOxCFEQ7kNvwEQPfG7&_nc_oc=AdrFhuMzl0igaws3onKEnJCMcJeSgiH3CzsUwQ9AAYDA5rNLLYkIsmSVymGRnrH-CSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6oPD864MaR3eIeUC1VRqJKXXyKI_GNXkpTEcSVSdtHQ&oe=6AFC7B80"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-l4VDf-OoAQ7kNvwGVHO9A&_nc_oc=AdoJ14pLezbgFpYZVaS0VwLhmh0gKfTGTattKNnY6sm8VKd60cCuXk8mRQl-dibgG_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrHFPjvF0ZOlS2TzV9bzIS2xhXcFFsmj-yTWsZ7qanig&oe=6AFC6157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXS1SkL2JvEQ7kNvwH0Lgzw&_nc_oc=Adp7Y9LXhfV57nehG0KKf_o7BfcIsFGSs1vi_gnUlhlbhcmBClLJeh0biHn8OiwuqdE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc4Ydx0Gf5SFPCWEX7fhqOREKOCNVHLVa288WdGMMMCQ&oe=6AFC8484"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
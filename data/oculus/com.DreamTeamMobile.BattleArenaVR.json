2hK2pJ4i4lvI7ZKyNxDNOSlErJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_YIxtpVshaexzoX1z-cBOU6SQVX_aH9KdFPbPQYRsCA&oe=6B05BCF5"}, {"file_name": "Screen3.png", "id": "245055157078949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBgJa2Zd978Q7kNvwHfKWuH&_nc_oc=Adp51KfYtam4oju4B24z5CSMLlsTTJNGKi_M4asCjYw406FrPe2oIMqG5ulr6Nm8Dp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFyMQi-4_qrrtWdYjHU5aBI7dXN2oQSY2rXBTr5q5ymg&oe=6B05B81D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DE2FDvvIwaMQ7kNvwF82T7O&_nc_oc=AdpxJde7Ypc3JI20cDmncsiI4kQks7aQKr4Znz1f32SvRvSmPfQqOPZACmpox_CYI_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFH2hKOgQuK0k6UZMRR_y1iUAE7wg5ojhcpVjagt5afA&oe=6B05B600"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG7UP0opxIcQ7kNvwFbyHKa&_nc_oc=Adq0_SmBt0EB7hjUD43CJnvF6RecG1iO8ISM8-HpwfLJS_E3a2OYBfARodprruXaOFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeO6JnduTkYLyfNVLfYVgnlqvbN9r3ZHp6Z70wcL9bQQ&oe=6B05D417"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM280yiXSvcQ7kNvwG1c3Vp&_nc_oc=Adp8-BDEQC0tqt4NVCp8GPnp-5EFgIaMekBZqHlAmvMEpgvBLCAxQ0iWk3G6-khzYto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv-lB2dSfyAsfCbaclhOjqHCSpItoyVjpVlx0Vpe25yw&oe=6B05BF04"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
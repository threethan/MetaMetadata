/v/t64.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3--11jA6UcgQ7kNvwHK5Xri&_nc_oc=AdocxDY-pr9yN-zt8CmP_s0Q50pOfaqYkh5uo1-SSdWTP0ur-BSuMfDbuB0MG8fL0Pc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmbQgbbTuA5-MENx_Nv8nQqnt-VqNkxgb6LadwgvVF2Q&oe=6A7DB55D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ip8jIzX-NQgQ7kNvwE_9AS3&_nc_oc=AdrJlZ61_Ai3k0LIXhOHC4VT-sgPu4R_AcQnO1KSEjZmcwcKJiG-KU4ROL9bbJWFHTQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVlncHMpm5fRKA1SUfOOH2uzQz_5lg9BA19Mgf59Rtsw&oe=6A7DB340"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F1sYcGXdbAQ7kNvwE30t2M&_nc_oc=AdrWCamE-B229ARvExaPOl0XX3jeHuU9_tMu-zlGFkbOXYrkW88H8LXd00boI5L_goY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0RPLumofa7b-RLbhNPuhxuCMwLxgBZvaJHiCIevDamA&oe=6A7DD157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru9w_mNnaGIQ7kNvwFtbU2f&_nc_oc=Adqjj7hMtMZdrUnkUorgNXJoXHClJHigkEBfytBDJmMNqTnOHtSG2r0iFbVdSsbdow0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW96Ch27t_VgqBaC-7PyJjBCnjbzMWifk9D3vMDhgl8A&oe=6A7DBC44"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1278083746045938"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id":
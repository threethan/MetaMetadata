x3lsoDJa6akZcWlW3EQBv8lFi44&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLKBG1y8p8RIlZvodIcJqDDCnYoUNFe654Ik3zOUqAKg&oe=6B085FF5"}, {"file_name": "Screen3.png", "id": "245055157078949", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNirXVHp0YsQ7kNvwEc_8o5&_nc_oc=AdpetnCB6wQ2ejm2owF9zf8Vgb49ZlsVzhFDzBq5pJ59SNGhSfPXpzytWQ9M1EP8bZc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1zREikhqefYNzudSneTGQPLTWN_1lnqalMhnTauWn0g&oe=6B085B1D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7zeZ58KD6MQ7kNvwEb8XAv&_nc_oc=AdokvhzVGKIE2d0dkb1Q5c9zt6dJdk6apjf0hUpLmKGiSanlwGxvknnaXRl22mhOzpc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqqyz896JaVZHjdbMguBJQ2PVoH1MyMhFSr7Jkhekvmg&oe=6B085900"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG7UP0opxIcQ7kNvwHd3o_W&_nc_oc=AdoDgL7w1yf5gjTAITC4U6oZ9tyXd866_wCOLGwA0s2rIJGqeiKmw6H5kfmeV_owOSk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCRZtHp6SInRInvd025WsvJDTKiBCcdvSeGKuHD9oh4A&oe=6B083ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM280yiXSvcQ7kNvwHLEYI_&_nc_oc=Ado277-wgqOKt-1-LBP3HcOC72yZ8rn2ojJad98MD9UbMHMpwmG4xfLe_EvhhRPb5Hg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv_tGdZ7WObUll6KETYqOwoJT8WsfMiwrfyliTtgsrLA&oe=6B086204"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
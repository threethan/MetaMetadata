ajAqv4zV00SG9n5-vMRDBMVX-qg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5fiwcccygOEVacfCTiC1r7ECnsZPb2VvPa0Fi8c0JsQ&oe=6B01C875"}, {"file_name": "Screen3.png", "id": "245055157078949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348043_245055163745615_3924373067454866465_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT50CFtua_gQ7kNvwEpJeEy&_nc_oc=AdoK79F4plur5v0tTgDl1Fz9mOwfLnMzk5VxKC4uGpD2NzEh4zkM0M8Ho5pV_7uB9XA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8l1Bolpbx1jo5ImtD7LVjygCwVwKHHilRCl6q8S0KvA&oe=6B01C39D"}, {"file_name": "Screen4.png", "id": "2932674483636521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_2932674486969854_5078026231165140623_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIc8QmWiGh4Q7kNvwEkkLhl&_nc_oc=AdoPrL-zhU9Y3r7N7H5ZzwHha9EinUqI00LRJpH37oJxezTl9vD-hdr-uUbDxWS1tLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqjIMN8J60HLRVfTshpH1fy_ibhLK1vqXfil4b8kgjLw&oe=6B01C180"}, {"file_name": "Screen5.png", "id": "759389654958540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_759389658291873_9040706210688267977_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiwqSGvwtXIQ7kNvwH2KrI5&_nc_oc=AdoSwr69k8HbCKTydIZ0rHRfDo7SjLJXDkbwy1fK_N6dHv7LVgk9i8vi9Xa_m7nLhuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7NmGMWkVFXQq7cOY0L9yn0hxzBPUKIQD_83cjf5gKSQ&oe=6B01DF97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Background-Tournament-2560x1440px.png", "id": "878535942989656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974682_878535946322989_456871179866758300_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiAzBTn89WMQ7kNvwFuG0Ln&_nc_oc=AdpyF8K0GB8n0GJJL3fu3Rdpe0q30Msjwygj1pw7MoJfadXkMgPc4oqsNtz1Gn0oqVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9dzMLkfxFY_IMwYkPpmDrkHXzKnC0sFAyarNc62lpvA&oe=6B01CA84"}, "display_name": "Battle Arena VR", "keywords": [], "long_description": "Battle Arena VR is a multiplayer arena shooter, where you are automatically matched with opponents. Main features:\n\n- Multiplayer - best fit for 2-5 users on each map\n- Short sessions - to invoke emotions through sometimes intensive play and discuss it later using voice chat\n- Guided gameplay - warmup and cooldown stages to connect with other players, get familiar with landscape and physics\n- Voice chat during the game - use an open microphone to chat with other players in realtime to share your excitement\n- Multiple servers across the globe so everyone is included and can play with the local community and low latency (for now we have enabled 3 servers, which can be extended for worldwide coverage of 14 servers)\n- Complete tutorial - learn controls and capabilities to get the most from your cyborg\n- Every game gives you experience, level-ups, and change your position in the leaderboard, which is visible to all players\n\nPlease, join our Discord server: \nhttps://discord.gg/BEdWsry", "short_description": "Challenge yourself, challenge everyone in a deathmatch Battle Arena"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drmtm.blob.core.windows.net/policies/battlearenavr/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "DreamTeam Mobile", "support_website_url": "https://battlearenavr.net/feedback", "website_url": "https://battlearenavr.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
273_7807788661616792249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFnP-p16Zk4Q7kNvwEu32mZ&_nc_oc=AdrkL2VjVcqvhHFw3IJshX2NdVg9GlM3Oe69fgd6w_SCZYk4hMpznQE8uriGHBzBztw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtBVrFBlcap8m5qmW-aKKrX_q1BYXa8IdgpjxAMyHDZQ&oe=6B03139D"}, {"file_name": "Screenshot_4.png", "id": "2193230921080789", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822550_2193230927747455_3180140156832208193_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go2Fut-30ToQ7kNvwE1p5tM&_nc_oc=AdrLyocr9jUbVQrs8Gx8Q7gh3_YbUE-Ilb_nPc0pTQsWJScRnOg4sPEXlACrzs9qtrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXUy15E5kvrImiDr0Z-urEObgfUhEfzwLF9b_UUXzsEQ&oe=6B031BC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cozy Social Lounge: Meet & Talk", "keywords": ["voicechat", "socialspace", "meetfriends", "hangout", "relaxing"], "long_description": "Welcome to Cozy Social Lounge: Meet & Talk \u2014 a warm, relaxing social space designed for real conversations. Step into a cozy lounge filled with art and comfortable seating, then meet other people who are online at the same time.\n\nThis is not a fast-paced game. It\u2019s a place to hang out, talk, and enjoy the atmosphere. Join our daily meetup times, listen to music together, and spend time with friends \u2014 or make new ones. Whether you want a calm place to chat after a long day, or a friendly room to drop into for a few minutes, Cozy Social Lounge is made for simple, stress-free socializing.\n\nFeatures:\n\nCozy lounge environment with art and a relaxing vibe\n\nSocial space for conversation and meeting new people\n\nDaily meetup schedule to help the community gather\n\nEasy to jump in, look around, and hang out\n\nCome by anytime \u2014 and if the room is quiet, don\u2019t worry. The community grows when we show up together.", "short_description": "Cozy Social Lounge is a relaxing social space where you can meet new people, talk with others, and hang out in a warm lounge atmosphere. Join daily meetups, enjoy music together, and chat with friends or strangers in a cozy room made for conversation and good vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/8_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26495016223428803"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "26964595069897156"}, {"status": "PUBLISHED", "id": "26420636454305363"}, {"status": "PUBLISHED", "id": "804161896022833"}]}, "baseline_offer": {"id": "26420636454305363"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781290800, "status": "PUBLISHED", "id": "26964595069897156"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26515605604703198", "version": "0.3.0"}, "id": "23979079091789871", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2649501616
oe=6A465D06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cozy Social Lounge: Meet & Talk", "keywords": ["voicechat", "socialspace", "meetfriends", "hangout", "relaxing"], "long_description": "Welcome to Cozy Social Lounge: Meet & Talk \u2014 a warm, relaxing social space designed for real conversations. Step into a cozy lounge filled with art and comfortable seating, then meet other people who are online at the same time.\n\nThis is not a fast-paced game. It\u2019s a place to hang out, talk, and enjoy the atmosphere. Join our daily meetup times, listen to music together, and spend time with friends \u2014 or make new ones. Whether you want a calm place to chat after a long day, or a friendly room to drop into for a few minutes, Cozy Social Lounge is made for simple, stress-free socializing.\n\nFeatures:\n\nCozy lounge environment with art and a relaxing vibe\n\nSocial space for conversation and meeting new people\n\nDaily meetup schedule to help the community gather\n\nEasy to jump in, look around, and hang out\n\nCome by anytime \u2014 and if the room is quiet, don\u2019t worry. The community grows when we show up together.", "short_description": "Cozy Social Lounge is a relaxing social space where you can meet new people, talk with others, and hang out in a warm lounge atmosphere. Join daily meetups, enjoy music together, and chat with friends or strangers in a cozy room made for conversation and good vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/8_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres"
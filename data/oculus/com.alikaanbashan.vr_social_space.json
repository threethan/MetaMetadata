MdBPLXJ94daq8wnjLuun4o9XYQbS7NLHbamZgtcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3acB7xtXej1gAKth3q_RS2SABavlKoFHWHt8Yp5FmNaw&oe=69E8DE7D"}, {"file_name": "Screenshot_1.png", "id": "1418646303391607", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818860_1418646310058273_7807788661616792249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt_yCMyp3r8Q7kNvwGDT-va&_nc_oc=AdoOaBINy5_d8YJE6mffCRW9nJj4wQwceWNY3MMLCbNsw0cOXKUrLDvvpv3FV0YljOw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FZDCyR-XknF2vS9b86yqg-xnLGF7spq20rtmrkyjHtg&oe=69E8BA5D"}, {"file_name": "Screenshot_4.png", "id": "2193230921080789", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822550_2193230927747455_3180140156832208193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHaRLhD0V8EQ7kNvwGvsJOS&_nc_oc=AdonKxC5uObEBvk3EPWaO_qcQ9yolTfw-1swq7AhM7BmPQ9S2hw7ZU0bg5cK3MOClIw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OcJEhEXYN0Fl6OD4no9S-ZBGWQCIOxJPM9XFn56-_Jw&oe=69E8C286"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Social Music Lounge - Voice Chat", "keywords": ["socialvr", "voicechat", "musiclounge", "meetpeople", "relaxingchat"], "long_description": "Welcome to Social Music Lounge, a cozy VR social space where people can relax, talk, and listen together. Join other players in a calm lounge designed for real conversation, shared music, and stress-free evenings.\n\nMeet new people or spend time with friends in a warm social environment with live voice chat. Everyone in the room hears the same music at the same time, making it easy to hang out, talk, and enjoy the atmosphere together.\n\nThis is a relaxing social experience for players who want a quiet place to unwind after work, chat at night, and connect with others without pressure. Drop in for a few minutes or stay longer during meetup hours and enjoy a simple, cozy online space built for conversation.\n\nFeatures:\n\nLive social VR voice chat\nShared music for everyone in the room\nCozy lounge atmosphere\nEasy drop-in social experience\nGreat for relaxing evening hangouts\nMeet new people in a calm online space", "short_description": "Relax in a cozy online VR lounge where players meet, talk with live voice chat, and enjoy the same music together. Unwind after a long day, hang out with friends, or meet new people in a calm social space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/8_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27163377706592648"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619677_2021951312058164_2366273346695093499_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I85pQkZRRkIQ7kNvwFgO1Cx&_nc_oc=AdpP7M-OnrdXf75dcUsYeeebKBpjrJSKjF4C_xnmAzhpDMyH1BOHeAzGbaNEVpgYbg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pWZivlEGq7FpqTGaILN2A1aaRcc8TooKJVRDWhyg1jQ&oe=69E8D167"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Social Music Lounge - Voice Chat", "platform": "ANDROID_6DOF", "context_categor